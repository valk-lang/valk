use valk:gc

union TaggedScalar : String | int | bool {
    static fn number() TaggedScalar {
        return 7
    }

    fn describe() String {
        return match this : String {
            String as text => "string:" + text
            int as number => "int:" + number
            bool as enabled => enabled ? "bool:true" : "bool:false"
        }
    }
}

union TaggedScalarReordered : bool | String | int {}

union NullableTaggedScalar : String | int | null {
    fn describe() String {
        return match this : String {
            null => "missing"
            String as text => text
            int as number => number.to(String)
        }
    }
}

union TaggedFloat : String | float {}

class TaggedHolder {
    value: TaggedScalar
}

class TaggedText {
    value: String
}

class TaggedList {
    values: Array[TaggedTree]
}

union TaggedTree : TaggedText | TaggedList {}

fn tagged_value(kind: uint) TaggedScalar {
    if kind == 0 : return "text"
    if kind == 1 : return 42
    return true
}

fn tagged_accept_reordered(value: TaggedScalarReordered) String {
    return match value : String {
        String as text => text
        int as number => number.to(String)
        bool as enabled => enabled ? "true" : "false"
    }
}

fn nullable_tagged_value(present: bool) NullableTaggedScalar {
    if present : return "set"
    return null
}

fn tagged_float_value(value: TaggedFloat) float {
    return match value : float {
        String as _ => 0.0
        float as number => number
    }
}

test "Tagged unions: widen and exhaustively match" {
    assert(tagged_value(0).describe() == "string:text")
    assert(tagged_value(1).describe() == "int:42")
    assert(tagged_value(2).describe() == "bool:true")
    assert(tagged_float_value(1.5) == 1.5)
    assert(TaggedScalar.number().describe() == "int:7")
}

test "Tagged unions: locals, properties and containers" {
    let local: TaggedScalar = 7
    assert(local.describe() == "int:7")

    let holder = TaggedHolder { value: "property" }
    assert(holder.value.describe() == "string:property")

    let values = Array[TaggedScalar]{}
    values.append(false)
    values.append("array")
    assert((values.get(0) !? true).describe() == "bool:false")
    assert((values.get(1) !? true).describe() == "string:array")
}

test "Tagged unions: nullable union uses outer null" {
    let value: ?TaggedScalar = null
    assert(!isset(value))
    value = "present"
    assert(isset(value))
    assert(value.describe() == "string:present")
}

test "Tagged unions: named declarations have nominal identity" {
    let value: TaggedScalarReordered = 19
    assert(tagged_accept_reordered(value) == "19")
    assert(!TaggedScalar.$is_type_of(TaggedScalarReordered))
}

test "Tagged unions: null syntax and exhaustive null match" {
    let missing = nullable_tagged_value(false)
    let present = nullable_tagged_value(true)
    let missing_text = match missing : String {
        null => "missing"
        String as text => text
        int as number => number.to(String)
    }
    let present_text = match present : String {
        null => "missing"
        String as text => text
        int as number => number.to(String)
    }
    assert(missing_text == "missing")
    assert(present_text == "set")
    assert(missing.describe() == "missing")
    assert(present.describe() == "set")
}

synctest "Tagged unions: GC traces recursive union payloads" {
    let tree: TaggedTree = TaggedList {
        values: Array[TaggedTree]{
            TaggedText { value: "still alive" }
        }
    }
    gc:collect()
    match tree {
        TaggedText as text => assert(text.value == "unused")
        TaggedList as list => match (list.values.get(0) !? tree) {
            TaggedText as text => assert(text.value == "still alive")
            TaggedList as nested => assert(nested.values.length == 0)
        }
    }
}

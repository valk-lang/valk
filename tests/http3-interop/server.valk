use valk.http
use valk.io
use valk.time

class Stop {
    done: uint (0)
}

class ChunkReader is io.Reader {
    chunks: Array[String]
    index: uint (0)

    + fn read(buf: local mut &[u8]) uint !io.IoError {
        if this.index >= this.chunks.length : return 0
        let s = this.chunks.get(this.index) ! return 0
        this.index++
        let n = s.bytes < buf.length ? s.bytes : buf.length
        let i: uint = 0
        while i < n {
            buf[i] = s[i]
            i++
        }
        return n
    }
}

fn main() {
    let stop: atomic Stop = .{}
    let handler: atomic fn(http.Request)(http.Response) = fn(req: http.Request) http.Response {
        if req.path == "/stop" {
            stop.done = 1
            return http.Response.text("stopping")
        }
        if req.path == "/ready" {
            return http.Response.text("ready")
        }
        if req.path == "/hello" {
            let res = http.Response.text("hello:" + req.query_string)
            res.set_header("X-Echo-Header", req.header("x-custom") !? "none")
            return res
        }
        if req.path == "/echo" {
            return http.Response.text(req.method + ":" + req.body)
        }
        if req.path == "/large" {
            let buf = ByteBuffer.new(262_144)
            each 0 .. 4096 : buf.write("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
            return http.Response.text(buf.into_string())
        }
        if req.path == "/compress" {
            let buf = ByteBuffer.new(4096)
            each 0 .. 128 : buf.write("compressible-http3-interop-text-")
            return http.Response.text(buf.into_string())
        }
        if req.path == "/stream" {
            let chunks = Array[String].new(64)
            let piece = "stream-piece-0123456789abcdef-0123456789abcdef-0123456789abcdef\n".repeat(16)
            each 0 .. 64 : chunks.append(piece)
            return http.Response.stream(ChunkReader { chunks: chunks }, content_type: "text/plain")
        }
        if req.path == "/trailers" {
            let res = http.Response.text("trailers-body")
            res.set_trailer("X-Checksum", "deadbeef")
            res.set_trailer("X-Status", "ok")
            return res
        }
        return http.Response.text("not-found", 404)
    }

    let server = http.Server.new("127.0.0.1", 19443, handler)
    server.http2 = true
    server.http3 = true
    server.compress = true
    server.tls(__DIR__ + "/../assets/tls-cert.pem", __DIR__ + "/../assets/tls-key.pem") !!
    server.add_static_dir("/static", __DIR__ + "/../assets") !!

    let running = co server.start(2)
    let deadline = time.mono_ms() + 60_000
    while stop.done == 0 && time.mono_ms() < deadline : time.sleep_ms(10)
    server.shutdown(2000)
    await running !!
}

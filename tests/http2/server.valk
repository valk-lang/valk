use valk.http
use valk.time

class Stop {
    done: uint (0)
}

fn main() {
    let stop: shared Stop = .{}
    let handler: shared fn(http.Request)(http.Response) = fn(request: http.Request) http.Response {
        if request.path == "/stop" : stop.done = 1
        if request.path == "/echo" : return http.Response.text(request.body)
        if request.path == "/large" {
            let body = ByteBuffer.new()
            let index: uint = 0
            while index++ < 100_000 : body.write_byte('x')
            return http.Response.text(body.into_string())
        }
        return http.Response.text("h2:" + request.path)
    }
    let server = http.Server.new("127.0.0.1", 9095, handler)
    server.http2 = true
    server.tls(__DIR__ + "/../assets/tls-cert.pem", __DIR__ + "/../assets/tls-key.pem") !!
    let running = co server.start(2)
    let deadline = time.mono_ms() + 30_000
    while stop.done == 0 && time.mono_ms() < deadline : time.sleep_ms(10)
    server.shutdown(1000)
    await running !!
}

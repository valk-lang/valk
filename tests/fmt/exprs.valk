
// Constructs the old Exp-tree formatter had no branch for and silently deleted
// from its output, plus the signs whose meaning depends only on their spacing.

error ExprErr ( bad , worse )

fn work( ) String {
return "a"
}

fn boom() String !ExprErr {
return "b"
}

fn maybe() ?String {
return null
}

fn handlers() String !ExprErr {
let a = boom() ! return "x"
defer println( a )
let b = boom() !>
let c = boom() !!
let d = maybe() ?? "fallback"
let e = boom() !? <{
assert(error_is(E.code, bad))
return "z"
}
boom() ! throw .bad
return a+b+c+d+e
}

fn coroutines() String {
let c = co work()
let r = await c
return r
}

fn ranges(values: Array[int]) {
let range=values[1..2]
let repeated=[u8 x 3]{ 0... }
}

class Cell {
v: int
}

extern fn fmt_ptr() * Cell;
extern fn fmt_ref() & Cell;

fn signs(n: int, p: * ?Cell) int {
let neg = - 1
let not = ! isset(p)
let opt : ?String = null
let sub = n-1
let lt = n<2
let gt = n>0
let tern = lt?"pos":"neg"
let size = size_of(<int>)
let base = n
let ref = & base
let bit_not = ~ n
let before = ++ n
let after = n ++
let empty = Array[int]{ }
let values = Array[int]{ 1,2 }
if not : return neg
if isset(opt) : println(opt+tern)
return sub*2 + size + bit_not + before + after + empty.length + values.length + (gt ?1: 0)
let x :?String = gt?null :null
}

class Holder[T] {
- value: ?T
+ static fn make() Holder[T] {
return Holder[T]{}
}
+ get held : ?T {
return this.value
}
}

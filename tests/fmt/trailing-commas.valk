// Multiline lists and the one permitted trailing-comma form

class MultilineCell {
v: int
}

fn multi_arg(
a: int,
b: String,
c: bool
) {
}

fn multi_call() {
multi_arg(
1,
"two",
true
)
}

fn array_multiline() Array[int] {
return Array[int]{
1,
2,
3
}
}

fn map_multiline() Map[int] {
return Map[int]{
"a"=> 1,
"b" =>2
}
}

fn class_multiline() MultilineCell {
return MultilineCell {
v: 1,
}
}

fn match_multiline(value: int) String {
return match value : String {
0=>"zero"
1=>"one"
default=>"many"
}
}

fn tuple_multiline() (int, String, bool) {
return (
1,
"hello",
true
)
}

fn generic_multiline() Array[int] {
let result = Array[int]{
10,
20,
30
}
return result
}

fn nested_multiline() {
let data = Map[Array[int]]{
"odds"=> Array[int]{
1,
3,
5
},
"evens"=> Array[int]{
2,
4,
6
}
}
}

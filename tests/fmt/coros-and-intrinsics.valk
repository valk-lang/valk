// Coroutine expressions and unsafe intrinsics

fn coro_simple() String {
return "done"
}

fn coro_usage() String {
let task = co coro_simple()
let result = await task
return result
}

fn coro_multi() (int, bool) {
return (1, true)
}

fn coro_multi_usage() {
let t = co coro_multi()
let x, y = await t
}

fn intrinsic_size() uint {
return size_of(int)+size_of(u8)+size_of(ptr)
}

fn intrinsic_ref(value: int) *int {
return @ref(value)
}

fn intrinsic_ptrv(addr: *int) int {
return @ptrv(addr, int)
}

fn intrinsic_ptrv_offset(arr:*[u8 x 8]) u8 {
return @ptrv(arr,u8,3)
}

fn intrinsic_cast(value: uint) int {
return value.@cast(int)
}

fn intrinsic_embed() String {
return #embed("Makefile")
}

fn intrinsic_embed_dir() int {
return #embed_dir("tests/assets").length
}

value COMPILE_CONST (size_of(i64))

fn intrinsic_ptr_value(addr:ptr) int {
return @ptrv(addr, int)
}

fn intrinsic_offset_of() uint {
return 0
}

fn intrinsic_undefined() int {
let value:int=@undefined
return value
}

fn intrinsic_memcpy(from:ptr,to:ptr,length:uint) {
@memcpy(from,to,length)
}

fn intrinsic_allocas() $entrance {
@allocas
}

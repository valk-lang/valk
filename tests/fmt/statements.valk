
// State that has to survive a line break: the formatter used to reset
// everything it knew at each newline and misread the second line.

enum KEYWORD_NAMES : u8 {
    if
    elif
    while
    return
    throw // members named after keywords are still names
}

class Node {
    kind: KEYWORD_NAMES
    value: int
    next: ?Node (null)

    group readers {
        + fn first() int {
            return this.value
        }
        + get last: int {
            return this.value
        }
    }
}

value STAMP ({ 0x1, 0x2 };)
value AFTER_STAMP (3)

fn split_condition(a: bool, b: bool, c: bool) int {
    if a
        && b
        && c {
            return 1
        } else if a
        || (b
            && c) {
        return 2
    }
    if a
        && b : return 3
    return 0
}

fn handlers(map: Map[String, int]) int {
    map.get("a") -> found: return found
    map.get("b") -> found {
        return found
    }
    return 0
}

fn ternaries(a: bool, b: bool, n: int) ?Node {
    let x = a ? (b ? 1 : 2) : 3
    let node = a ? Node { kind : KEYWORD_NAMES.if, value: n }: null
    let y = a
        ? 1
        : 2
    return node
}

fn member_named_after_keyword(n: int) Node {
    return Node {
        kind: KEYWORD_NAMES.if
        value: n
    }
}

fn concatenation(name: String) String {
    return "hello "
    + name
    + "!"
}

fn multi_line_signature(
    a: int,
    b: String(""),
    c: bool(false)
)(int, String) !LookupError {
    return (a, b)
}

fn stack_type(digits: temp [u8 x 4], values: Array[int]) u8 {
    let stack = values
    return stack[0].to(u8) + digits[0]
}

fn statements_after_semicolons(n: int) int {
    let s = n
    if s > 0xff : { s += 8; s = s >> 8 }
    if s > 0 : { s += 1 }
    return s
}

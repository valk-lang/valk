// Match expressions, error handlers, success handlers, defer

error MatchErr (kind) payload {
    detail: String
}

fn match_literal(value: int) String {
    return match value : String {
        0 => "zero"
        1 => "one"
        default => "many"
    }
}

fn match_union(value: int | String | null) String {
    return match value : String {
        null => "nothing"
        int as n => n.to(String)
        String as s => s
    }
}

fn error_handler(value: int) String !MatchErr {
    if value < 0 : throw .kind { detail: "negative" }
    return value.to(String)
}

fn error_pass() String !MatchErr {
    let v = error_handler(-1) !>
    return v
}

fn error_suppress() String {
    let v = error_handler(0)!!"fallback"
    return v
}

fn error_inline(value: int) String {
    let v = error_handler(value) !? <{
        return "err:" + E.detail
    }
    return v
}

fn error_catch(value: int) String {
    let v = error_handler(value)! return "caught"
    return v
}

fn null_coalesce(value: ?String) String {
    return value ?? "default"
}

fn success_handler(value: int) String !MatchErr {
    let r = ""
    error_handler(value) -> v: r = v
    return r
}

fn defer_example() !MatchErr {
    defer println("done")
    return
}

fn multiple_handlers() !MatchErr {
    error_handler(1) !?
    error_handler(2)! throw .kind { detail: "err" }
}

fn match_multi_return(value: int) (int, String) {
    return match value : (int, String) {
        0 => (1, "a")
        default => (value, "b")
    }
}

fn match_default_block(value: int) int {
    match value {
        0 => println("zero")
        default => {
            println("other")
        }
    }
    return value
}

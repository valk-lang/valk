// Explicit, inferred, direct-destination, nested, repeated and keyed initializers

class InitUser {
    name: String
    age: uint
}

struct InitPoint {
    x: int
    y: int
}

fn explicit_initializers() {
    let user = InitUser { name: "Ada", age: 37 }
    let point = InitPoint { x: 1, y: 2 }
    let fixed = [u8 x 3]{ 1, 2, 3 }
    let dynamic = Array[int]{ 4, 5, 6 }
    let keyed = Map[int]{ "one" => 1, "two" => 2 }
}

fn inferred_initializers() {
    let user: InitUser = .{ name: "Grace", age: 40 }
    let fixed: [u8 x 3] = .{ 7, 8, 9 }
    let dynamic: Array[int] = .{ 10, 11, 12 }
}

fn direct_destination_initializers() {
    let user: InitUser = { name: "Lin", age: 28 }
    user = { name: "Mira", age: 29 }
    let fixed: [u8 x 2] = { 1, 2 }
    fixed = { fixed[1], fixed[0] }
    let nested: [[u8 x 2] x 2] = { { 1, 2 }, { 3, 4 } }
}

fn repeated_initializers() {
    let zeros: [u8 x 8] = { 0... }
    let prefixed: [u8 x 8] = { 1, 2, 0... }
}

fn trailing_class_initializer() InitUser {
    return InitUser {
        name: "Trailing",
        age: 1,
    }
}

fn single_line_braces() Array[int] { return <{ return Array[int]{ 1, 2 } } }

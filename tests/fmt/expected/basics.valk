
class Node {
    prop: ?Node

    static fn f1() {
        let v1: uint = 1 & 1
        let v2: uint = 1 * 2 + 1 / 5
    }
}

shared fmt_shared: uint (0)
@shared fmt_guarded: uint (0)

fn test() Node {
    if true : println("test")
    if true : println("test") // Something
    if true :
        println("test")
    if true :
        println("test")
    if true :
        // Something
        println("test")
    if true : // Something
        println("test")

    return Node {
        // Comment before
        prop: null // Test
        // Comments after
        // Comments after
    }
}

fn condition_comments(ch: u8, nch: u8) {
    if
        (ch == '=' && nch == '=')                    // ==
        || (ch == '!' && (nch == '=' || nch == '}')) // != !}
        || (ch == '{' && (nch == '{' || nch == '!')) // {{ {!
        || (ch == '}' && nch == '}')
    {
        return
    }
}

fn statement_comments(n: uint) uint {
    let total = n + 1 // trailing on a let

    // standalone after a statement
    // and a second one
    total = total * 2 // trailing on an assign
    return total      // trailing on a return
}

error BasicsErr (bad)

class Decls {
    v: uint (0)

    + static fn make() Decls {
        return Decls {}
    }
    static fn make_default(value: uint (4)) Decls $default {
        return Decls {v: value}
    }
    - fn priv() uint {
        return 1
    }
    -+ fn namespace_priv() uint {
        return 2
    }
    -~ namespace_readonly: uint
    ~+ namespace_state: uint
    -~+ package_state: uint
    get total: uint {
        return this.v
    }
    fn gen[T](x: T) T {
        return x
    }
    fn fallible() uint !BasicsErr {
        return 1
    }
}


class Node {
    prop: ?Node
}

fn test() Node {
    return Node {
        // Comment before
        prop: null // Test
        // Comments after
        // Comments after
    }
}

fn condition_comments(ch: u8, nch: u8) {
    if (ch == '=' && nch == '=') // ==
        || (ch == '!' && (nch == '=' || nch == '}')) // != !}
        || (ch == '{' && (nch == '{' || nch == '!')) // {{ {!
        || (ch == '}' && nch == '}')
    {
        return
    }
}

fn statement_comments(n: uint) uint {
    let total = n + 1 // trailing on a let

    // standalone after a statement
    // and a second one
    total = total * 2 // trailing on an assign
    return total // trailing on a return
}


union FmtUnion: String | int | null {
    fn describe() String {
        return match this : String {
            null => "none"
            String as text => text
            int as number => number.to(String)
        }
    }
}

fn describe_union(value: FmtUnion) String {
    return value.describe()
}

fn qualified_result(value: int | bool) core.int {
    return match value : core.int {
        int as number => number
        bool as enabled => enabled ? 1 : 0
    }
}

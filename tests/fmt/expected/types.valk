// Type prefixes and compound types: ?, *, &, [N], callable, union, generic

use valk.time

fn type_nullable(x: ?String) ?int {
    if isset(x) : return x.length
    return null
}

fn type_pointer(p: *u8, arr: *[u8 x 4]) u8 {
    return @ptrv(p, u8) + @ptrv(arr, u8, 2)
}

fn type_reference(ref: &uint) {
    ++ref
}

fn type_fixed_array() [int x 3] {
    return [int x 3]{ 1, 2, 3 }
}

fn type_dynamic_array() Array[String] {
    return Array[String]{}
}

fn type_slice(values: &[int]) int {
    return values[0] !? 0
}

fn type_callable(cb: fnptr(int, String)(bool)) bool {
    return cb(1, "x")
}

fn type_union(value: int | bool | String) String {
    return match value : String {
        int as n => n.to(String)
        bool as b => b ? "t" : "f"
        String as s => s
    }
}

fn type_compound(
    a: Array[int],
    b: HashMap[String, int],
    c: ?*u8,
    d: Array[?String],
    e: fn(int)(bool),
    f: [u8 x 8]
) {
    let mapped: Array[?int] = Array[?int]{}
}

fn type_namespace(value: time.DateTime) time.DateTime {
    return value
}

fn type_pointer_nullable(p: *?int) int {
    if isset(p) {
        if isset(p) : return @ptrv(p, int)
    }
    return 0
}

fn type_shared(value: shared Array[int]) shared Array[int] {
    return value
}

fn type_nonnull(value: nonnull(?String)) nonnull(?String) {
    return value
}

fn type_typeof(value: int) typeof(1) {
    return value
}

fn type_coroutine(value: co(String !TypeFixtureError)) co(String !TypeFixtureError) {
    return value
}

error TypeFixtureError (failed)

fn type_callable_error(cb: fn(int)(String !TypeFixtureError)) fn(int)(String !TypeFixtureError) {
    return cb
}

fn type_callable_error_only(cb: fnptr()(!TypeFixtureError)) fnptr()(!TypeFixtureError) {
    return cb
}

fn type_callable_multi_error(cb: fn(int)(String, uint !TypeFixtureError)) fn(int)(String, uint !TypeFixtureError) {
    return cb
}

fn type_nested_callable_error(cb: fn(fn(int)(String !TypeFixtureError))(fnptr()(!TypeFixtureError) !TypeFixtureError)) fn(fn(int)(String !TypeFixtureError))(fnptr()(!TypeFixtureError) !TypeFixtureError) {
    return cb
}

fn type_bounded_pointer(value: *[u8 x 8], ref: &[u8 x 8]) *[u8 x 8] {
    return value
}

fn type_suggested[T](value: T) T {
    return value.@cast(.)
}

fn anonymous_return_types() {
    let nullable = fn() ?String { return null }
    let pointer = fn() *u8 { return null.@cast(*u8) }
    let direct = fn() String { return "" }
    let empty = fn() {}
}

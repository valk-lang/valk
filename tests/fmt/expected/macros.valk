// Compile-time value macros must survive formatting. They were previously
// written out as nothing, silently deleting the expression.
fn main() {
    let e = #embed("Makefile")
    let d = #embed_dir("tests/assets")
    println(e.bytes + d.length)

    let selected = 0
    #if FORMAT_A
    selected = 1
    #elif FORMAT_B
    selected = 2
    #else
    selected = 3
    #end

    let commented = 0

    // condition follows a comment and blank line
    #if COMMENTED
    // selected value
    commented = 1
    #else
    // fallback value
    commented = 2
    #end

    let nested = 0
    #if OUTER
    #if INNER
    nested = 1
    #else
    nested = 2
    #end
    #else
    nested = 3
    #end

    #if NORMAL_BODY
    println("normal")
    let inner = 0
    #if INNER_VALUE
    inner = 1
    #else
    inner = 2
    #end
    println(inner)
    #end
    println(selected + commented + nested)
}

fn macro_after_bare_return(done: bool) {
    if done : return

    #if AFTER_BARE_RETURN
    println("unreachable")
    #end
}

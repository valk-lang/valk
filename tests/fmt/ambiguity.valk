// Namespace colons, ternary colons, declaration colons, ambiguous operators

use valk:time

error AmbiguityError (negative)

class KeywordMembers {
co: int
}

fn namespace_colons(value:time:Datetime) time:Datetime {
let v : time:Datetime = value
return v
}

fn ternary_with_colons(condition: bool, value: int) String {
    let v = condition ? "yes" : (value>0 ? "positive" : "negative")
    return v
}

fn declaration_vs_ternary(flag: bool) String {
let a : String = flag ? "a" : "b"
    let b : uint = flag ? 1 : 0
return a + b.to(String)
}

fn type_vs_comparison(a: Array[int], b: Array[int]) int {
let cmp = a.length<b.length
let gt = a.length>b.length
return type_vs_comparison_b[int, String](a.length, "")
}

fn type_vs_comparison_b[T, U](x: T, y: U) int {
    if size_of(T)<size_of(U) : return -1
if size_of(T)>size_of(U) : return 1
return 0
}

fn star_in_type(p: *?int, q: *Array[int]) uint {
return size_of(ptr)
}

fn amp_vs_reference(a: uint, b: uint) uint {
let ref = &a
let and = a & b
return and
}

fn question_vs_ternary(value: ?int) int {
let v = value ?? 0
let t = isset(value) ? value : 0
    if isset(value) : return value
return t
}

fn bang_vs_not(flag: bool) int {
let not_flag = !flag
return not_flag ? 1 : 0
}

fn bang_error_handler(value: int) int !AmbiguityError {
if value < 0 : throw .negative
return value
}

fn bang_usage(value: int) int {
let v = bang_error_handler(value)!?0
return v
}

fn minus_vs_neg(value: int) int {
let neg = -value
let sub = value-1
let expr = -(value+1)
return neg + sub + expr
}

fn tilde_vs_bitnot(value: int) int {
let bit_not = ~value
let raw = value & ~1
return bit_not + raw
}

fn combined_ternary_ns(flag: bool, value: time:Datetime) String {
let v : String = flag ? "ns:" + value.to(String) : "other"
return v
}

fn keyword_member_operator(value: KeywordMembers, rhs: int) int {
return value.co-rhs
}

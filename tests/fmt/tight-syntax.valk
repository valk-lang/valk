#if FORMAT_TIGHT
+ class TightBox [T] {
- + field: Array [T]
#if T.$is_inline
- static fn hidden [U] (value: U) Array [U] {
let called = helper (value)
let indexed = called [0]
let member = called .length
let chained = called ?.first ?.name
let chained_lines = called
?.first
?.name
let namespaced: ns .Thing = value
let lower = value++<2
let greater = value-->0
let scaled = fallible() !> *2
let embedded = #embed ("Makefile")
let keyword_continuation = called.length
- value
return indexed
}
#end
}
#end

+ array TightArray [T] of T {
#if T.$is_inline
- fn hidden () {}
#end
}

extern fn declaration (value: int) int ;

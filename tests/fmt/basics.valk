fn condition_comments(ch: u8, nch: u8) {
if
(ch == '=' && nch == '=') // ==
|| (ch == '!' && (nch == '=' || nch == '}')) // != !}
|| (ch == '{' && (nch == '{' || nch == '!')) // {{ {!
|| (ch == '}' && nch == '}')
{
return
}
}

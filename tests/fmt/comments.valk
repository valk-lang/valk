        let v2 = 0  // com

        let vlong = 0     // com
    }
}

fn comment_literals() {
    // A `//` inside a literal is not a comment, so it must not be mistaken for the
    // one the column is measured from.
    let url = "http://example.com" // real comment
    let two = "a//b" + "c//d" // also real
    let ch = '/' // char slash
    let esc = "quote\" // not a comment" // real one
    let plain = 1
}

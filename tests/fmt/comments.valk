        let v1 = 0 // com

        let v2 = 0 // com
    }
    if true {
        let v1 = 0 // com
        let vlong = 0 // com
        let v2 = 0 // com
    }
    if true {
        let v1 = 0 // com
        let vlong = 0 // com

        let v2 = 0 // com
    }
    if true {

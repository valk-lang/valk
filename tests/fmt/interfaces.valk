interface Printable {
fn text(prefix: String) String;
}
interface Named {
get name: String;
}
class User is Printable,Named {
value: String
fn text(prefix: String) String {
return prefix+this.value
}
get name: String {
return this.value
}
}
fn is_user(value:Printable)bool {
return value is_a User&&true
}

// A `float` return type is not a `float` type declaration, and a ternary's colon is
// not a `name: Type` colon: neither may put a space before the call's parenthesis.
class Reader {
    scale: int (0)

    + fn read_float(exact: bool) float !SyntaxError {
        let scale = (exact ? 0 - this.scale : this.scale) - 1
        let result = exact ? parse_exact(scale) : parse_bytes(scale, 2)
        let text = exact ? "1.5" : "2".to_float()
        return result
    }

    + get ratio: float {
        return this.exact ? 1.0 : "3".to_float() !? 0.0
    }

    + fn read_int(exact: bool) integer {
        return exact ? a(1) : b(2)
    }
}

extend ptr {
    + fn read_float(len: uint) float !SyntaxError {
        let result = exact ? parse_float_exact(exact_mantissa, scale) : parse_float_exact_bytes(data, mantissa_end, scale)
        return result
    }
}

+ float Ratio 8 {
    + fn half() float {
        return this / 2
    }
}

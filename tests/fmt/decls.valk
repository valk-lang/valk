// Declaration kinds: enum, trait, extend, mode, struct, error, interface

@unsafe
@ignore_access

enum FormatColor : String {
red ("#f00")
green ("#0f0")
    blue ("#00f")
}

trait Formattable {
    fn format() String {
return "base"
    }
}

trait Countable {
fn count() int {
return 0
}
}

class FormatNode {
use Formattable
use Countable

    name: String
}

extend FormatNode {
fn short() String {
return this.format().part(0, 3)
}
}

struct FormatPoint {
x: int
y: int
}

type FormatPointValue (FormatPoint)
type FormatCallback (fn(FormatPointValue)(String))
alias FormatPointAlias for FormatPoint

array FormatArray of int {}
slice FormatSlice of int {}
unbound FormatUnbound of int {}
pointer FormatPointer {}
integer FormatInteger signed 4 {}
float FormatFloat 8 {}
boolean FormatBoolean {}

mode FormatQueue[T] for Array[T] {
+ fn push(item: T) {
this.append(item)
}

+ fn pop() ?T {
return this.get(0) !? null
}
}

error FormatError (invalid) payload {
message: String
line: uint
}

interface Serializer {
fn serialize(buf: ByteBuffer);
}

extern fn format_external(value: int) int;

export fn format_exported(value: int) int {
return value
}

value FORMAT_VERSION (1)

global format_counter : uint (0)

@shared format_shared_state : uint (0)

class FormatAccess {
- priv: uint
-+ fn internal(value:uint) uint {
return 0
}
-~ namespace_val: uint
~+ package_val: uint
}

test "formatter declaration" {
assert(true)
}

synctest "formatter synchronous declaration" {
assert(true)
}

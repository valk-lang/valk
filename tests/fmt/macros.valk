// Compile-time value macros must survive formatting. They were previously
// written out as nothing, silently deleting the expression.
fn main() {
    let e = #embed("Makefile")
        let d =  #embed_dir( "tests/assets" )
    println(e.bytes + d.length)

let selected =
# if FORMAT_A
A
# elif FORMAT_B
B
# else
C
# end

let commented =

// condition follows a comment and blank line
# if COMMENTED
// selected value
A
# else
// fallback value
B
# end

let nested =
#if OUTER
#if INNER
A
#else
B
#end
#else
C
#end

#if NORMAL_BODY
println("normal")
let inner =
#if INNER_VALUE
A
#else
B
#end
println(inner)
#end
}

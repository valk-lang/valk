// Structs by value across extern calls: see c-abi.c
link static "cabi"

struct V2 {
    x: f32
    y: f32
}
struct V3 {
    x: f32
    y: f32
    z: f32
}
struct V4 {
    x: f32
    y: f32
    z: f32
    w: f32
}
struct Col {
    r: u8
    g: u8
    b: u8
    a: u8
}
struct Cam {
    pos: V3
    target: V3
    up: V3
    fovy: f32
    proj: i32
}
struct Tex {
    id: u32
    w: i32
    h: i32
    mips: i32
    fmt: i32
}
struct DF {
    a: f64
    b: f32
}
struct D2 {
    a: f64
    b: f64
}
struct IF {
    a: i32
    b: f32
}
struct S3 {
    a: i16
    b: i16
    c: i16
}
struct B3 {
    a: u8
    b: u8
    c: u8
}
struct F1 {
    v: f32
}
struct FA {
    v: [f32 x 3]
}
struct Named {
    name: [u8 x 20]
    id: i32
}
struct Mat {
    m: [f32 x 16]
}
struct PI {
    p: ptr
    n: i32
}

extern fn v2_sum(v: V2) f32;
extern fn v2_make(a: f32) V2;
extern fn v3_sum(v: V3) f32;
extern fn v3_make(a: f32) V3;
extern fn v4_sum(v: V4) f32;
extern fn v4_make(a: f32) V4;
extern fn col_sum(c: Col) i32;
extern fn col_make(a: i32) Col;
extern fn cam_sum(c: Cam, k: i32) f32;
extern fn cam_make(f: f32) Cam;
extern fn tex_sum(t: Tex, p: V2, c: Col) i32;
extern fn tex_make(i: i32) Tex;
extern fn df_sum(v: DF) f64;
extern fn df_make(a: f64) DF;
extern fn d2_sum(v: D2) f64;
extern fn d2_make(a: f64) D2;
extern fn if_sum(v: IF) f32;
extern fn if_make(a: i32) IF;
extern fn s3_sum(v: S3) i32;
extern fn s3_make(a: i16) S3;
extern fn b3_sum(v: B3) i32;
extern fn b3_make(a: i32) B3;
extern fn f1_sum(v: F1, k: f32) f32;
extern fn f1_make(a: f32) F1;
extern fn fa_sum(v: FA) f32;
extern fn fa_make(a: f32) FA;
extern fn named_sum(v: Named) i32;
extern fn named_make(id: i32) Named;
extern fn mat_sum(m: Mat) f32;
extern fn mat_make(a: f32) Mat;
extern fn pi_sum(v: PI) i64;
extern fn pi_make(n: i32) PI;
extern fn b_not(b: bool) bool;
extern fn small(a: u8, b: i8, c: u16, d: i16) i32;
extern fn v3_many(a: V3, b: V3, c: V3, d: V3, e: V3) f32;
extern fn ints_then_pair(a: i64, b: i64, c: i64, d: i64, e: i64, p: PI) Tex;
extern fn doubles_then_v2(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64, v: V2) f64;

extern fn check_exports() i32;

export fn valk_v3_make(a: f32) V3 {
    return V3{ x: a, y: a * 2, z: a * 3 }
}
export fn valk_v3_sum(v: V3) f32 {
    return v.x + v.y * 10 + v.z * 100
}
export fn valk_col_make(a: u8) Col {
    return Col{ r: a, g: a + 1, b: a + 2, a: a + 3 }
}
export fn valk_col_sum(c: Col) i32 {
    return c.r.to(i32) + c.g.to(i32) * 2 + c.b.to(i32) * 3 + c.a.to(i32) * 4
}
export fn valk_cam_make(f: f32) Cam {
    return Cam{ pos: V3{ x: f, y: 0, z: 0 }, target: V3{ x: 0, y: f * 2, z: 0 }, up: V3{ x: 0, y: 0, z: f * 3 }, fovy: 45, proj: 1 }
}
export fn valk_cam_sum(c: Cam, k: i32) f32 {
    return c.pos.x + c.target.y + c.up.z + c.fovy + c.proj.to(f32) + k.to(f32)
}
export fn valk_s3_make(a: i16) S3 {
    return S3{ a: a, b: -a, c: a * 2 }
}
export fn valk_s3_sum(v: S3) i32 {
    return v.a.to(i32) + v.b.to(i32) * 10 + v.c.to(i32) * 100
}
export fn valk_df_make(a: f64) DF {
    return DF{ a: a, b: (a * 2).to(f32) }
}
export fn valk_df_sum(v: DF) f64 {
    return v.a + v.b.to(f64) * 10
}
export fn valk_v3_many(a: V3, b: V3, c: V3, d: V3, e: V3) f32 {
    return valk_v3_sum(a) + valk_v3_sum(b) + valk_v3_sum(c) + valk_v3_sum(d) + valk_v3_sum(e) * 2
}
export fn valk_ints_then_pair(a: i64, b: i64, c: i64, d: i64, e: i64, p: PI) Tex {
    return Tex{ id: (a + b + c + d + e).to(u32), w: p.n, h: 1, mips: 0, fmt: 7 }
}

global failures: uint (0)

fn check(name: String, ok: bool) {
    if ok : return
    println("C ABI mismatch: " + name)
    failures++
}

fn main() {
    check("v2_sum", v2_sum(V2{ x: 1, y: 2 }) == 21)
    let v2 = v2_make(6)
    check("v2_make", v2.x == 6 && v2.y == -6)
    check("v3_sum", v3_sum(V3{ x: 1, y: 2, z: 3 }) == 321)
    let v3 = v3_make(2)
    check("v3_make", v3.x == 2 && v3.y == 4 && v3.z == 6)
    check("v4_sum", v4_sum(V4{ x: 1, y: 2, z: 3, w: 4 }) == 4321)
    let v4 = v4_make(5)
    check("v4_make", v4.x == 5 && v4.y == 6 && v4.z == 7 && v4.w == 8)
    check("col_sum", col_sum(Col{ r: 1, g: 2, b: 3, a: 4 }) == 30)
    let col = col_make(10)
    check("col_make", col.r == 10 && col.g == 11 && col.b == 12 && col.a == 13)
    let cam = cam_make(5)
    check("cam_make", cam.pos.x == 5 && cam.target.y == 10 && cam.up.z == 15 && cam.fovy == 45 && cam.proj == 1)
    check("cam_sum", cam_sum(cam, 7) == 83)
    let tex = tex_make(10)
    check("tex_make", tex.id == 10 && tex.w == 11 && tex.h == 12 && tex.mips == 13 && tex.fmt == 14)
    check("tex_sum", tex_sum(tex, V2{ x: 3, y: 4 }, Col{ r: 0, g: 0, b: 0, a: 9 }) == 76)
    check("df_sum", df_sum(DF{ a: 1.5, b: 2 }) == 21.5)
    let df = df_make(3)
    check("df_make", df.a == 3 && df.b == 6)
    check("d2_sum", d2_sum(D2{ a: 1.5, b: 2 }) == 21.5)
    let d2 = d2_make(3)
    check("d2_make", d2.a == 3 && d2.b == 9)
    check("if_sum", if_sum(IF{ a: 3, b: 1.5 }) == 18)
    let fi = if_make(7)
    check("if_make", fi.a == 7 && fi.b == 3.5)
    check("s3_sum", s3_sum(S3{ a: 1, b: -2, c: 3 }) == 281)
    let s3 = s3_make(9)
    check("s3_make", s3.a == 9 && s3.b == -9 && s3.c == 18)
    check("b3_sum", b3_sum(B3{ a: 1, b: 2, c: 3 }) == 321)
    let b3 = b3_make(4)
    check("b3_make", b3.a == 4 && b3.b == 5 && b3.c == 6)
    check("f1_sum", f1_sum(F1{ v: 2.5 }, 1) == 3.5)
    check("f1_make", f1_make(2).v == 8)
    let fa = fa_make(1)
    check("fa_make", fa.v[0] == 1 && fa.v[1] == 2 && fa.v[2] == 3)
    check("fa_sum", fa_sum(fa) == 321)
    let named = named_make(1000)
    check("named_make", named.id == 1000 && named.name[0] == 'v' && named.name[3] == 'k' && named.name[4] == 0)
    named.id = 1
    check("named_sum", named_sum(named) == 431)
    let mat = mat_make(1)
    check("mat_make", mat.m[0] == 1 && mat.m[15] == 16)
    check("mat_sum", mat_sum(mat) == 1496)
    let pair = pi_make(42)
    check("pi_make", pair.n == 42)
    check("pi_sum", pi_sum(pair) == 43)
    check("b_not", b_not(false) && !b_not(true))
    check("small", small(200, -5, 60000, -300) == 59895)
    check("v3_many", v3_many(V3{ x: 1, y: 0, z: 0 }, V3{ x: 0, y: 1, z: 0 }, V3{ x: 0, y: 0, z: 1 }, V3{ x: 2, y: 0, z: 0 }, V3{ x: 0, y: 0, z: 3 }) == 713)
    let mixed = ints_then_pair(1, 2, 3, 4, 5, pair)
    check("ints_then_pair", mixed.id == 15 && mixed.w == 42 && mixed.h == 1 && mixed.fmt == 7)
    check("doubles_then_v2", doubles_then_v2(1, 1, 1, 1, 1, 1, 1, 1, V2{ x: 2, y: 3 }) == 40)
    // Results reused in a loop keep their own temporaries
    let total : f32 = 0
    each 0 .. 1000 as i {
        let v = v3_make(i.to(f32))
        total += v3_sum(v) / 321
    }
    check("loop", total == 499500)
    let exports = check_exports()
    if exports != 0 : println("C ABI export mismatches: " + exports)
    check("exports", exports == 0)
    if failures > 0 : panic("C ABI checks failed")
    println("C ABI checks passed")
}

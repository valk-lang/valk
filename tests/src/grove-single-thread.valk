#if !GROVE_MT

use valk.gc

shared grove_node_count: uint

class GroveNode $atomic {
    left: ?GroveNode
    right: ?GroveNode

    fn gc_free() {
        grove_node_count--
    }
}

fn grove_tree(depth: uint) GroveNode {
    grove_node_count++
    if depth == 0 : return GroveNode {}
    return GroveNode { left: grove_tree(depth - 1), right: grove_tree(depth - 1) }
}

shared grove_shared_root: ?GroveNode (null)

fn grove_shared_fill() $noinline {
    grove_shared_root = grove_tree(6)
}

fn grove_shared_check() $noinline {
    let root = grove_shared_root ?! panic("missing shared root")
    assert(isset(root.left))
}

fn grove_shared_clear() $noinline {
    grove_shared_root = null
}

synctest "Grove: shared globals are ordinary roots, never shared" {
    gc.collect()
    let before = grove_node_count
    grove_shared_fill()
    gc.collect()
    assert(grove_node_count == before + 127)
    grove_shared_check()
    gc.collect()
    assert(grove_node_count == before + 127)
    grove_shared_clear()
    gc.collect()
    assert(grove_node_count == before)
}

synctest "Grove: lock, unlock and shared collections do nothing" {
    gc.unlock()
    gc.lock()
    gc.collect_shared()
    gc.collect_shared_if_threshold_reached()
    gc.reset_shared_pause_durations()
    assert(gc.shared_pause_last_us == 0 && gc.shared_pause_max_us == 0)
    gc.collect()
    assert(gc.mem_usage() <= gc.mem_usage_peak)
}

#end

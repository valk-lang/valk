use valk.sync
use valk.net
use valk.thread
use valk.time
use valk.coro

test "Channel: send and receive on one thread" {
    let ch = sync.Channel[String].new() !!
    ch.send("a") !!
    ch.send("b") !!
    assert(ch.length == 2)
    assert((ch.recv() !!) == "a")
    assert((ch.try_recv() !!) == "b")
    let empty = false
    ch.try_recv() ! { empty = error_is(E.code, empty) }
    assert(empty)
    let timed_out = false
    ch.recv(20) ! { timed_out = error_is(E.code, timeout) }
    assert(timed_out)

    // A coroutine blocked in recv wakes when a value arrives
    let receiver = co ch.recv()
    coro.await_last()
    ch.send("late") !!
    assert((await receiver !? "") == "late")

    ch.close()
    let closed = false
    ch.send("x") ! { closed = error_is(E.code, closed) }
    assert(closed)
    closed = false
    ch.recv() ! { closed = error_is(E.code, closed) }
    assert(closed)
    assert(ch.is_closed())
}

test "Channel: bounded sends block until there is room" {
    let ch = sync.Channel[uint].new(2) !!
    ch.send(1) !!
    ch.send(2) !!
    let full = false
    ch.try_send(3) ! { full = error_is(E.code, full) }
    assert(full)
    let timed_out = false
    ch.send(3, 20) ! { timed_out = error_is(E.code, timeout) }
    assert(timed_out)

    let sender = co ch.send(3)
    coro.await_last()
    assert(ch.length == 2)
    assert((ch.recv() !!) == 1)
    await sender !!
    assert((ch.recv() !!) == 2)
    assert((ch.recv() !!) == 3)
}

class Message {
    id: uint
    text: String
}

test "Channel: values cross threads and each drains until close" {
    let ch: shared sync.Channel[shared Message] = sync.Channel[shared Message].new(4) !!
    // Signals a finished producer, so the closer never races a late send
    let finished: shared sync.Channel[uint] = sync.Channel[uint].new() !!
    let producers = Array[thread.Thread[void]]{}
    let p: uint = 0
    while p < 3 {
        let base = p * 100
        let t = thread.start(fn() {
            let i: uint = 0
            while i < 50 {
                ch.send(Message { id: base + i, text: "m" + (base + i) }) !!
                i++
            }
            finished.send(p) !!
        }) !!
        producers.append(t)
        p++
    }
    let closer = thread.start(fn() {
        // Close once every producer has stopped sending: a channel with values
        // in flight looks the same as an idle one when only `length` is read
        let done: uint = 0
        while done < 3 {
            finished.recv() !!
            done++
        }
        ch.close()
    }) !!

    let sum: uint = 0
    let count: uint = 0
    let failure = ""
    each ch as message {
        if failure == "" && message.text != "m" + message.id : failure = "message #%count has the wrong text"
        sum += message.id
        count++
    }
    each producers as t : t.await()
    closer.await()
    if failure != "" : println(failure)
    assert(failure == "")
    assert(count == 150)
    // 3 * (0..49 sum) + (0 + 100 + 200) * 50
    assert(sum == 3 * 1225 + 300 * 50)
}

test "Channel: worker pool with results" {
    let jobs: shared sync.Channel[uint] = sync.Channel[uint].new() !!
    let results: shared sync.Channel[uint] = sync.Channel[uint].new() !!
    let workers = Array[thread.Thread[void]]{}
    let w: uint = 0
    while w < 4 {
        workers.append(thread.start(fn() {
            each jobs as job {
                results.send(job * job) !!
            }
        }) !!)
        w++
    }
    let i: uint = 1
    while i <= 100 {
        jobs.send(i) !!
        i++
    }
    jobs.close()
    let total: uint = 0
    i = 0
    while i < 100 {
        total += results.recv(5000) !!
        i++
    }
    assert(total == 338350)
    each workers as t : t.await()
}

test "CancelToken: cancellation wakes waiters, children and callbacks" {
    let token: shared sync.CancelToken = sync.CancelToken.new() !!
    let child = token.child() !!
    assert(!token.is_cancelled() && !child.is_cancelled())
    assert(!token.wait(20))

    let calls: shared sync.Channel[String] = sync.Channel[String].new() !!
    token.on_cancel(fn() { calls.try_send("parent") !! })
    child.on_cancel(fn() { calls.try_send("child") !! })

    let waiter = thread.start(fn() {
        token.wait()
        calls.try_send("waiter") !!
    }) !!
    time.sleep_ms(20)

    token.cancel()
    token.cancel()
    assert(token.is_cancelled() && child.is_cancelled())
    waiter.await()
    let seen = Array[String]{}
    let n: uint = 0
    while n < 3 {
        seen.append(calls.recv(2000) !!)
        n++
    }
    assert(seen.contains("parent") && seen.contains("child") && seen.contains("waiter"))
    assert(token.wait())
    // A child of a cancelled token starts cancelled and runs callbacks at once
    let late = token.child() !!
    assert(late.is_cancelled())
    late.on_cancel(fn() { calls.try_send("late") !! })
    assert((calls.recv(2000) !!) == "late")
}

test "Sync: a long timeout stays finite in the poll wait" {
    // `poll` takes milliseconds in an i32, so the remainder of a wait longer than
    // that used to wrap into a negative (infinite) or too small timeout
    assert(sync.poll_timeout_ms_for_test(5) == 5)
    assert(sync.poll_timeout_ms_for_test(2147483647) == 2147483647)
    assert(sync.poll_timeout_ms_for_test(2147483648) == 2147483647)
    assert(sync.poll_timeout_ms_for_test(3_000_000_000) == 2147483647)
}

test "CancelToken: cancels a blocked receive and a timed cancel" {
    let ch = sync.Channel[uint].new() !!
    let token: shared sync.CancelToken = sync.CancelToken.new() !!
    token.cancel_after(30)
    let cancelled = false
    let started = time.mono_ms()
    ch.recv(5000, token) ! { cancelled = error_is(E.code, cancelled) }
    assert(cancelled)
    assert(time.mono_ms() - started < 2000)

    let full = sync.Channel[uint].new(1) !!
    full.send(1) !!
    let stop: shared sync.CancelToken = sync.CancelToken.new() !!
    let blocked = co full.send(2, 0, stop)
    coro.await_last()
    stop.cancel()
    let send_cancelled = false
    await blocked ! { send_cancelled = error_is(E.code, cancelled) }
    assert(send_cancelled)
    assert(full.length == 1)
}

fn cancel_soon(token: shared sync.CancelToken, ms: uint) {
    time.sleep_ms(ms)
    token.cancel()
}

fn cancelled_read(con: net.TcpConnection) String {
    let buffer = [u8]{ 0 x 16 }
    con.read(buffer) ! {
        if error_is(E.code, cancelled) : return "cancelled"
        if error_is(E.code, timeout) : return "timeout"
        return "error"
    }
    return "data"
}

test "CancelToken: interrupts a blocked socket read" {
    let listener = net.tcp_server("127.0.0.1", 9137) !!
    let client = net.tcp_client("127.0.0.1", 9137) !!
    let con = listener.accept(3000) !!
    con.set_timeouts(10000, 10000)

    // Cancelled from a coroutine on this thread while the read is blocked
    let token: shared sync.CancelToken = sync.CancelToken.new() !!
    con.set_cancel(token)
    let start = time.mono_ms()
    let cancel = co cancel_soon(token, 50)
    assert(cancelled_read(con) == "cancelled")
    assert(time.mono_ms() - start < 3000)
    await cancel
    // Later I/O fails right away and the peer sees the end of the stream
    assert(cancelled_read(con) == "cancelled")
    con.write("x") ! { assert(error_is(E.code, cancelled)) }
    con.close() !!

    // An already cancelled token fails the first read
    let client2 = net.tcp_client("127.0.0.1", 9137) !!
    let con2 = listener.accept(3000) !!
    con2.set_timeouts(10000, 10000)
    con2.set_cancel(token)
    assert(cancelled_read(con2) == "cancelled")
    con2.close() !!

    // Cancelled from another thread
    let client3 = net.tcp_client("127.0.0.1", 9137) !!
    let con3 = listener.accept(3000) !!
    con3.set_timeouts(10000, 10000)
    let token3: shared sync.CancelToken = sync.CancelToken.new() !!
    con3.set_cancel(token3)
    let t = thread.start(fn() { cancel_soon(token3, 50) }) !!
    start = time.mono_ms()
    assert(cancelled_read(con3) == "cancelled")
    assert(time.mono_ms() - start < 3000)
    t.await()
    con3.close() !!

    client.close() !!
    client2.close() !!
    client3.close() !!
    listener.close() !!
}

global huge_wait_finished: bool (false)

fn huge_recv_probe(ch: sync.Channel[String]) String {
    let value = ch.recv(uint.$max) ! {
        huge_wait_finished = true
        return ""
    }
    return value
}

test "Channel: a wait past the millisecond clock does not expire at once" {
    // mono_ms() + uint.max wrapped into the past, so a "wait for ever" timeout
    // expired on the first check instead of waiting for a value
    let ch = sync.Channel[String].new() !!
    huge_wait_finished = false
    let waiter = co huge_recv_probe(ch)
    time.sleep_ms(20)
    assert(!huge_wait_finished)
    // ... and the wait still ends when a value arrives
    ch.send("late") !!
    assert((await waiter) == "late")
    assert(!huge_wait_finished)
}

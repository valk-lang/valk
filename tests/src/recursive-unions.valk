use valk.gc

union RecJson : int | String | bool | Array[RecJson] | Map[RecJson] {}

union RecTree : int | String | Array[RecTree] {}

// Two unions that contain each other through containers
union RecA : int | Array[RecB] {}
union RecB : String | Array[RecA] {}

fn rec_show(j: RecJson) String {
    match j {
        int as n => return "" + n
        String as s => return "\"" + s + "\""
        bool as b => return b ? "true" : "false"
        Array[RecJson] as items => {
            let parts = Array[String]{}
            each items as item : parts.append(rec_show(item))
            return "[" + parts.join(",") + "]"
        }
        Map[RecJson] as fields => {
            let parts = Array[String]{}
            each fields as v, k : parts.append(k + ":" + rec_show(v))
            return "{" + parts.join(",") + "}"
        }
    }
}

fn rec_build(depth: int) RecTree {
    if depth == 0 : return "leaf"
    let items = Array[RecTree]{}
    each 0 .. 3 as i : items.append(rec_build(depth - 1))
    items.append(depth)
    return items
}

fn rec_count(t: RecTree) int {
    match t {
        Array[RecTree] as items => {
            let n = 1
            each items as item : n += rec_count(item)
            return n
        }
        default => return 1
    }
}

test "Recursive unions through containers" {
    let list = Array[RecJson]{ 1, "two", true }
    let inner: RecJson = Array[RecJson]{ 3, 4 }
    list.append(inner)
    let obj = Map[RecJson]{}
    obj.set("list", list)
    obj.set("n", 5)
    assert(rec_show(obj) == "{list:[1,\"two\",true,[3,4]],n:5}")

    // Deep trees survive collections and copy whole
    let tree = rec_build(5)
    gc.collect()
    assert(rec_count(tree) == 485)
    let copy = $clone(tree)
    assert(rec_count(copy) == 485)

    let a: RecA = 1
    let b: RecB = Array[RecA]{ a, Array[RecB]{ "x" } }
    match b {
        Array[RecA] as items => assert(items.length == 2)
        String => assert(false)
    }
}

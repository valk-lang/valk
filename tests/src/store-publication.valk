use valk.gc

struct StorePublicationPart { number: int }
class StorePublicationItem {
    number: int
    part: StorePublicationPart ({ number: 11 })
    numbers: [int x 2] ({ 13, 17 })
}
shared store_publication_saved: ?StorePublicationItem (null)
fn store_publish(item: shared StorePublicationItem) int { store_publication_saved = item; return 0 }

synctest "Store publication: replacing a variable preserves the old destination" {
    let source = StorePublicationItem { number: 73 }
    let old = source
    source.number = <{
        source = StorePublicationItem { number: 79 }
        return store_publish(source)
    }
    assert(old.number == 0)
    assert((store_publication_saved ?? panic("missing")).number == 79)
    store_publication_saved = null
}

synctest "Store publication: index replacement preserves the old destination" {
    let source = StorePublicationItem { number: 73 }
    let old = source
    source.numbers[<{
        source = StorePublicationItem { number: 83 }
        return store_publish(source)
    }] = 89
    assert(old.numbers[0] == 89)
    assert((store_publication_saved ?? panic("missing")).numbers[0] == 13)
    store_publication_saved = null
}

synctest "Store publication: independent destinations remain writable" {
    let source = StorePublicationItem { number: 73 }
    let other = StorePublicationItem { number: 79 }
    source.part.number = store_publish(other)
    assert(source.part.number == 0)
    assert((store_publication_saved ?? panic("missing")).number == 79)
    store_publication_saved = null
}

synctest "Store publication: scalar copies can replace a local" {
    let source = StorePublicationItem { number: 73 }
    let number = source.number
    number += store_publish(source)
    assert(number == 73)
    store_publication_saved = null
}

synctest "Store publication: shared destinations retain atomic writes" {
    let source: shared StorePublicationItem = StorePublicationItem { number: 73 }
    source.number += store_publish(source)
    assert(source.number == 73)
    store_publication_saved = null
}

synctest "Store publication: destination snapshots are renewed in loops" {
    let index = 0
    while index++ < 2 {
        let source = StorePublicationItem { number: 73 }
        source.numbers[0] = <{
            source = StorePublicationItem { number: index }
            return store_publish(source)
        }
        assert((store_publication_saved ?? panic("missing")).number == index)
    }
    store_publication_saved = null
}

class StorePublicationChild { number: int }
struct StorePublicationFields { child: ?StorePublicationChild (null) }
class StorePublicationHolder {
    child: ?StorePublicationChild (null)
    part: StorePublicationFields ({})
    children: [?StorePublicationChild x 2] ({ null, null })
}
shared store_publication_holder: ?StorePublicationHolder (null)
fn store_publish_holder(item: shared StorePublicationHolder) StorePublicationChild {
    store_publication_holder = item
    return StorePublicationChild { number: 79 }
}

synctest "Store publication: managed destinations retain the original owner" {
    let source = StorePublicationHolder {}
    let old = source
    source.child = <{
        source = StorePublicationHolder {}
        return store_publish_holder(source)
    }
    gc.collect()
    assert((old.child ?? panic("missing")).number == 79)
    assert(!isset((store_publication_holder ?? panic("missing")).child))
    source = StorePublicationHolder {}
    let old_part = source
    source.part.child = <{
        source = StorePublicationHolder {}
        return store_publish_holder(source)
    }
    gc.collect()
    assert((old_part.part.child ?? panic("missing")).number == 79)
    assert(!isset((store_publication_holder ?? panic("missing")).part.child))
    source = StorePublicationHolder {}
    let old_array = source
    source.children[0] = <{
        source = StorePublicationHolder {}
        return store_publish_holder(source)
    }
    gc.collect()
    assert((old_array.children[0] ?? panic("missing")).number == 79)
    assert(!isset((store_publication_holder ?? panic("missing")).children[0]))
    store_publication_holder = null
}

synctest "Store publication: leaving the loop cancels the pending store" {
    let source = StorePublicationItem { number: 73 }
    while true {
        source.number = <{
            if source.number == 73 {
                store_publish(source)
                break
            }
            return 1
        }
    }
    assert((store_publication_saved ?? panic("missing")).number == 73)
    store_publication_saved = null
}

class AliasAccessTarget { value: int (1) }

- type AliasAccessType (AliasAccessTarget)
- value ALIAS_ACCESS_VALUE (7)
- alias AliasAccessAlias for AliasAccessTarget

class AliasAccessGroupHost {
    - group util {
        fn add(a: int) int { return a + 1 }
    }
}

test "Access: private aliases and groups work in their own source file" {
    let target: AliasAccessType = AliasAccessTarget { value: 3 }
    assert(target.value == 3)
    assert(ALIAS_ACCESS_VALUE == 7)
    let alias: AliasAccessAlias = target
    assert(alias.value == 3)
    assert(AliasAccessGroupHost {}.util.add(1) == 2)
}

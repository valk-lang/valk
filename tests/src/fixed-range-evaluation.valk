use valk.gc

class FixedRangeItem { number: int }
class FixedRangeHolder {
    values: [int x 3] ({ 7, 19, 23 })
    items: [FixedRangeItem x 3] ({ FixedRangeItem { number: 7 }, FixedRangeItem { number: 19 }, FixedRangeItem { number: 23 } })
}
class FixedRangeFactory {
    calls: int (0)
    starts: int (0)
    holder: FixedRangeHolder (.{})
    fn make() FixedRangeHolder {
        this.calls++
        return FixedRangeHolder { values: { this.calls, this.calls, this.calls } }
    }
    fn row() [int x 3] {
        this.calls++
        let row: [int x 3] = { this.calls, this.calls, this.calls }
        return row
    }
    fn borrowed() &[int x 3] { this.calls++; return &this.holder.values }
    fn start() uint { this.starts++; return 1 }
    fn mutate() uint {
        this.holder.values[1] = 73
        this.holder.values[2] = 79
        gc.collect()
        return 1
    }
    fn replace() uint {
        this.holder = .{ values: { 83, 89, 97 } }
        gc.collect()
        return 1
    }
}

test "Fixed ranges: temporary arrays and bounds evaluate once" {
    let factory = FixedRangeFactory {}
    let copy = factory.make().values[factory.start()..2]
    assert(factory.calls == 1 && factory.starts == 1)
    assert(copy[0] == 1 && copy[1] == 1)
    copy = factory.row()[factory.start()..2]
    assert(factory.calls == 2 && factory.starts == 2)
    assert(copy[0] == 2 && copy[1] == 2)
    copy = factory.borrowed()[factory.start()..2]
    assert(factory.calls == 3 && factory.starts == 3)
    assert(copy[0] == 19 && copy[1] == 23)
}

test "Fixed ranges: select storage before evaluating the start" {
    let factory = FixedRangeFactory {}
    let copy = factory.holder.values[factory.mutate()..2]
    assert(copy[0] == 73 && copy[1] == 79)
    copy[0] = 101
    assert(factory.holder.values[1] == 73)
    factory = .{}
    copy = factory.holder.values[factory.replace()..2]
    assert(copy[0] == 19 && copy[1] == 23)
    assert(factory.holder.values[1] == 89)
    factory = .{}
    copy = factory.borrowed()[factory.replace()..2]
    assert(copy[0] == 19 && copy[1] == 23)
    assert(factory.calls == 1)
}

test "Fixed ranges: managed copies retain their selected values" {
    let factory = FixedRangeFactory {}
    let copy = factory.holder.items[factory.replace()..2]
    gc.collect()
    assert(copy[0].number == 19 && copy[1].number == 23)
    copy[0] = FixedRangeItem { number: 107 }
    gc.collect()
    assert(copy[0].number == 107 && copy[1].number == 23)
}

test "Fixed ranges: shared and locked elements keep their views" {
    let holder: shared FixedRangeHolder = .{}
    let copy: [shared FixedRangeItem x 2] = holder.items[1..2]
    assert(copy[0].number == 19 && copy[1].number == 23)
    copy[0].number++
    assert(holder.items[1].number == 20)
    let numbers: [int x 2] = holder.values[1..2]
    assert(numbers[0] == 19 && numbers[1] == 23)
    let state: shared Lock[FixedRangeHolder] = .new(FixedRangeHolder {}) !!
    lock state as value {
        let locked_copy: [locked FixedRangeItem x 2] = value.items[1..2]
        locked_copy[0].number = 29
        assert(value.items[1].number == 29 && locked_copy[1].number == 23)
    }
}

use valk.crypto
use valk.thread

// Keys, ciphertexts and signatures made with Python's `cryptography` package: every result
// that is deterministic must match it byte for byte, and its random ones must verify

fn ck_hex(text: String) String {
    return crypto.hex_decode(text) ! panic("bad fixture")
}

test "Crypto: AEAD ciphers match the reference" {
    let key = ck_hex(CK_CHACHA_KEY)
    let nonce = ck_hex(CK_CHACHA_NONCE)
    let aad = ck_hex(CK_CHACHA_AAD)
    let plain = ck_hex(CK_CHACHA_PLAIN)
    let chacha = crypto.encrypt(crypto.Cipher.chacha20_poly1305, key, nonce, plain, aad) !!
    assert(chacha == ck_hex(CK_CHACHA_SEALED))
    assert(crypto.encrypt(crypto.Cipher.aes_256_gcm, key, nonce, plain, aad) !! == ck_hex(CK_GCM256_SEALED))
    let short_key = key.range(0, 16)
    assert(crypto.encrypt(crypto.Cipher.aes_128_gcm, short_key, nonce, plain, aad) !! == ck_hex(CK_GCM128_SEALED))
    assert(crypto.encrypt(crypto.Cipher.aes_256_gcm, key, nonce, "") !! == ck_hex(CK_GCM256_EMPTY))
    assert(crypto.decrypt(crypto.Cipher.chacha20_poly1305, key, nonce, chacha, aad) !! == plain)
    assert(crypto.decrypt(crypto.Cipher.aes_128_gcm, short_key, nonce, ck_hex(CK_GCM128_SEALED), aad) !! == plain)
    assert(crypto.decrypt(crypto.Cipher.aes_256_gcm, key, nonce, ck_hex(CK_GCM256_EMPTY)) !! == "")
    assert(crypto.cipher_key_size(crypto.Cipher.aes_128_gcm) == 16)

    // Any change is caught: a ciphertext byte, the tag, the additional data, key or nonce
    let flipped = ByteBuffer.new(chacha.bytes)
    flipped.write(chacha)
    flipped[3] = flipped[3] ^ 1
    let broken = Array[String]{ flipped.to_string(), chacha.range(0, chacha.bytes - 1) + "x", chacha.range(0, 10) }
    each broken as ciphertext {
        let auth = false
        crypto.decrypt(crypto.Cipher.chacha20_poly1305, key, nonce, ciphertext, aad) ! { auth = error_is(E.code, auth) }
        assert(auth)
    }
    let auth = false
    crypto.decrypt(crypto.Cipher.chacha20_poly1305, key, nonce, chacha, "other") ! { auth = error_is(E.code, auth) }
    assert(auth)
    auth = false
    crypto.decrypt(crypto.Cipher.aes_256_gcm, key, nonce, chacha, aad) ! { auth = error_is(E.code, auth) }
    assert(auth)

    let invalid = false
    crypto.encrypt(crypto.Cipher.aes_256_gcm, short_key, nonce, plain) ! { invalid = error_is(E.code, invalid_input) }
    assert(invalid)
    invalid = false
    crypto.encrypt(crypto.Cipher.aes_256_gcm, key, "short", plain) ! { invalid = error_is(E.code, invalid_input) }
    assert(invalid)
}

test "Crypto: seal and unseal" {
    let key = crypto.random_bytes(32)
    let sealed = crypto.seal(key, "secret", "cookie:v1") !!
    assert(sealed.bytes == crypto.CIPHER_NONCE_SIZE + 6 + crypto.CIPHER_TAG_SIZE)
    assert(crypto.unseal(key, sealed, "cookie:v1") !! == "secret")
    // A random nonce each time
    assert(crypto.seal(key, "secret", "cookie:v1") !! != sealed)
    let auth = false
    crypto.unseal(key, sealed, "cookie:v2") ! { auth = error_is(E.code, auth) }
    assert(auth)
    auth = false
    crypto.unseal(crypto.random_bytes(32), sealed, "cookie:v1") ! { auth = error_is(E.code, auth) }
    assert(auth)
    auth = false
    crypto.unseal(key, "too short") ! { auth = error_is(E.code, auth) }
    assert(auth)
    let invalid = false
    crypto.seal(crypto.random_bytes(16), "secret") ! { invalid = error_is(E.code, invalid_input) }
    assert(invalid)
    assert(crypto.unseal(key, crypto.seal(key, "") !!) !! == "")
}

test "Crypto: keys are read in every form" {
    let ed = crypto.PrivateKey.from_pem(CK_ED_PRIVATE) !!
    assert(ed.key_type() == crypto.KeyType.ed25519 && ed.bits() == 253)
    assert((crypto.PrivateKey.from_pem(CK_EC_P256_PRIVATE) !!).bits() == 256)
    assert((crypto.PrivateKey.from_pem(CK_EC_P384_PRIVATE) !!).bits() == 384)
    assert((crypto.PrivateKey.from_pem(CK_EC_P521_PRIVATE) !!).bits() == 521)
    assert((crypto.PrivateKey.from_pem(CK_EC_P256_TRADITIONAL) !!).key_type() == crypto.KeyType.ec)
    let rsa_keys = Array[crypto.PrivateKey]{
        crypto.PrivateKey.from_pem(CK_RSA_PRIVATE) !!,
        crypto.PrivateKey.from_pem(CK_RSA_TRADITIONAL) !!,
        crypto.PrivateKey.from_pem(CK_RSA_ENCRYPTED, "open sesame") !!,
        crypto.PrivateKey.from_der(ck_hex(CK_RSA_DER)) !!,
    }
    each rsa_keys as key : assert(key.key_type() == crypto.KeyType.rsa && key.bits() == 2048)

    let publics = Array[crypto.PublicKey]{
        crypto.PublicKey.from_pem(CK_RSA_PUBLIC) !!,
        crypto.PublicKey.from_pem(CK_RSA_CERTIFICATE) !!,
        crypto.PublicKey.from_jwk(CK_RSA_JWK) !!,
    }
    each publics as key : assert(key.key_type() == crypto.KeyType.rsa && key.bits() == 2048)
    assert((crypto.PublicKey.from_jwk(CK_EC_P521_JWK) !!).bits() == 521)
    assert((crypto.PublicKey.from_jwk(CK_ED_JWK) !!).key_type() == crypto.KeyType.ed25519)

    let bad_private = Array[String]{ "", "not a key", CK_RSA_PUBLIC, CK_X25519_PRIVATE, CK_RSA_ENCRYPTED }
    each bad_private as pem {
        let key_error = false
        crypto.PrivateKey.from_pem(pem) ! { key_error = error_is(E.code, key) }
        assert(key_error)
    }
    let wrong_password = false
    crypto.PrivateKey.from_pem(CK_RSA_ENCRYPTED, "wrong") ! { wrong_password = error_is(E.code, key) }
    assert(wrong_password)
    let bad_jwk = Array[String]{ "", "{", "{}", "{\"kty\":\"oct\",\"k\":\"AAAA\"}", "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"AAAA\",\"y\":\"AAAA\"}", "{\"kty\":\"OKP\",\"crv\":\"X25519\",\"x\":\"AAAA\"}", "{\"kty\":\"RSA\",\"n\":\"+/+/\",\"e\":\"AQAB\"}" }
    each bad_jwk as jwk {
        let key_error = false
        crypto.PublicKey.from_jwk(jwk) ! { key_error = error_is(E.code, key) }
        assert(key_error)
    }
}

test "Crypto: signatures match the reference" {
    let message = ck_hex(CK_MESSAGE)
    // Ed25519 and RSA PKCS#1 v1.5 are deterministic
    let ed = crypto.PrivateKey.from_pem(CK_ED_PRIVATE) !!
    assert(ed.sign(crypto.SignatureAlgorithm.ed25519, message) !! == ck_hex(CK_ED_SIGNATURE))
    assert((crypto.PrivateKey.from_ed25519_seed(ck_hex(CK_ED_SEED)) !!).sign(crypto.SignatureAlgorithm.ed25519, message) !! == ck_hex(CK_ED_SIGNATURE))
    assert((crypto.PublicKey.from_jwk(CK_ED_JWK) !!).verify(crypto.SignatureAlgorithm.ed25519, message, ck_hex(CK_ED_SIGNATURE)))
    assert((crypto.PublicKey.from_pem(CK_ED_PUBLIC) !!).verify(crypto.SignatureAlgorithm.ed25519, message, ck_hex(CK_ED_SIGNATURE)))

    let rsa = crypto.PrivateKey.from_pem(CK_RSA_PRIVATE) !!
    assert(rsa.sign(crypto.SignatureAlgorithm.rsa_pkcs1_sha256, message) !! == ck_hex(CK_RSA_PKCS1_256))
    assert(rsa.sign(crypto.SignatureAlgorithm.rsa_pkcs1_sha384, message) !! == ck_hex(CK_RSA_PKCS1_384))
    assert(rsa.sign(crypto.SignatureAlgorithm.rsa_pkcs1_sha512, message) !! == ck_hex(CK_RSA_PKCS1_512))
    let rsa_publics = Array[crypto.PublicKey]{ crypto.PublicKey.from_pem(CK_RSA_PUBLIC) !!, crypto.PublicKey.from_jwk(CK_RSA_JWK) !!, crypto.PublicKey.from_pem(CK_RSA_CERTIFICATE) !!, rsa.public_key() !! }
    each rsa_publics as key {
        assert(key.verify(crypto.SignatureAlgorithm.rsa_pkcs1_sha256, message, ck_hex(CK_RSA_PKCS1_256)))
        assert(key.verify(crypto.SignatureAlgorithm.rsa_pss_sha256, message, ck_hex(CK_RSA_PSS_256)))
        assert(!key.verify(crypto.SignatureAlgorithm.rsa_pss_sha256, message, ck_hex(CK_RSA_PKCS1_256)))
        assert(!key.verify(crypto.SignatureAlgorithm.rsa_pkcs1_sha384, message, ck_hex(CK_RSA_PKCS1_256)))
        assert(!key.verify(crypto.SignatureAlgorithm.rsa_pkcs1_sha256, "other message", ck_hex(CK_RSA_PKCS1_256)))
        // An algorithm for another kind of key is simply not valid
        assert(!key.verify(crypto.SignatureAlgorithm.ed25519, message, ck_hex(CK_ED_SIGNATURE)))
    }
    let pss = rsa.sign(crypto.SignatureAlgorithm.rsa_pss_sha256, message) !!
    assert(pss != rsa.sign(crypto.SignatureAlgorithm.rsa_pss_sha256, message) !!)
    assert(rsa_publics[0].verify(crypto.SignatureAlgorithm.rsa_pss_sha256, message, pss))

    // ECDSA signs with a random nonce: the reference signatures must verify, in DER and raw form
    let curves = Array[crypto.Curve]{ crypto.Curve.p256, crypto.Curve.p384, crypto.Curve.p521 }
    let algorithms = Array[crypto.SignatureAlgorithm]{ crypto.SignatureAlgorithm.ecdsa_sha256, crypto.SignatureAlgorithm.ecdsa_sha384, crypto.SignatureAlgorithm.ecdsa_sha512 }
    let pems = Array[String]{ CK_EC_P256_PUBLIC, CK_EC_P384_PUBLIC, CK_EC_P521_PUBLIC }
    let jwks = Array[String]{ CK_EC_P256_JWK, CK_EC_P384_JWK, CK_EC_P521_JWK }
    let signatures = Array[String]{ CK_EC_P256_SIGNATURE, CK_EC_P384_SIGNATURE, CK_EC_P521_SIGNATURE }
    let raws = Array[String]{ CK_EC_P256_RAW, CK_EC_P384_RAW, CK_EC_P521_RAW }
    let i: uint = 0
    while i < 3 {
        let der = ck_hex(signatures[i])
        let raw = ck_hex(raws[i])
        let from_pem = crypto.PublicKey.from_pem(pems[i]) !!
        assert(from_pem.verify(algorithms[i], message, der))
        assert((crypto.PublicKey.from_jwk(jwks[i]) !!).verify(algorithms[i], message, der))
        assert(crypto.ecdsa_signature_to_raw(der, curves[i]) !! == raw)
        assert(from_pem.verify(algorithms[i], message, crypto.ecdsa_signature_from_raw(raw) !!))
        assert(!from_pem.verify(algorithms[i], message, raw))
        i++
    }

    let key_error = false
    rsa.sign(crypto.SignatureAlgorithm.ecdsa_sha256, message) ! { key_error = error_is(E.code, key) }
    assert(key_error)
    key_error = false
    ed.sign(crypto.SignatureAlgorithm.rsa_pkcs1_sha256, message) ! { key_error = error_is(E.code, key) }
    assert(key_error)
    let invalid = false
    crypto.ecdsa_signature_to_raw("not der", crypto.Curve.p256) ! { invalid = error_is(E.code, invalid_input) }
    assert(invalid)
}

test "Crypto: generated keys sign, verify and round trip through PEM" {
    let keys = Array[crypto.PrivateKey]{ crypto.PrivateKey.generate_ed25519() !!, crypto.PrivateKey.generate_ec() !!, crypto.PrivateKey.generate_ec(crypto.Curve.p521) !!, crypto.PrivateKey.generate_rsa() !! }
    let algorithms = Array[crypto.SignatureAlgorithm]{ crypto.SignatureAlgorithm.ed25519, crypto.SignatureAlgorithm.ecdsa_sha256, crypto.SignatureAlgorithm.ecdsa_sha512, crypto.SignatureAlgorithm.rsa_pss_sha384 }
    let i: uint = 0
    while i < keys.length {
        let key = keys[i]
        let algorithm = algorithms[i]
        let signature = key.sign(algorithm, "data") !!
        let public = key.public_key() !!
        assert(public.verify(algorithm, "data", signature))
        assert(!public.verify(algorithm, "Data", signature))
        let reread = crypto.PrivateKey.from_pem(key.to_pem() !!) !!
        assert(reread.key_type() == key.key_type() && reread.bits() == key.bits())
        assert(public.verify(algorithm, "data", reread.sign(algorithm, "data") !!))
        let public_again = crypto.PublicKey.from_pem(public.to_pem() !!) !!
        assert(public_again.verify(algorithm, "data", signature))
        i++
    }
    assert(keys[3].bits() == 2048)
    let invalid = false
    crypto.PrivateKey.generate_rsa(1024) ! { invalid = error_is(E.code, invalid_input) }
    assert(invalid)
}

test "Crypto: keys can be shared between threads" {
    let key = crypto.PrivateKey.generate_ed25519() !!
    let public: shared crypto.PublicKey = key.public_key() !!
    let private: shared crypto.PrivateKey = key
    let checker = thread.Thread[bool].start(fn() bool {
        let signature = private.sign(crypto.SignatureAlgorithm.ed25519, "shared") ! return false
        return public.verify(crypto.SignatureAlgorithm.ed25519, "shared", signature)
    }) !!
    assert(checker.await())
}

test "Crypto: URL-safe base64" {
    let bytes = ck_hex("fbff00")
    assert(crypto.base64url_encode(bytes) == "-_8A")
    assert(crypto.base64url_decode("-_8A") !! == bytes)
    assert((crypto.base64url_decode("-_8A====") !? "failed") == "failed")
    assert(crypto.base64url_decode("aGk=") !! == "hi")
    assert(crypto.base64url_encode("") == "")
    let invalid = false
    crypto.base64url_decode("+/8A") ! { invalid = error_is(E.code, invalid_input) }
    assert(invalid)
}


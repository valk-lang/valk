trait DefaultsGreeter {
    fn greet() String {
        return "Hello " + this.name()
    }
    fn name() String {
        return "someone"
    }
}

class DefaultsPerson {
    first: String
    use DefaultsGreeter
    // Overrides the trait's `name`; the trait's `greet` calls this one
    fn name() String {
        return this.first
    }
}

class DefaultsRobot {
    // Defined before the `use`, still overrides
    fn greet() String {
        return "BEEP"
    }
    use DefaultsGreeter
}

interface DefaultsShape {
    fn area() float;
    fn describe() String {
        return "shape of " + this.area()
    }
    get sides: uint {
        return 0
    }
}

class DefaultsSquare is DefaultsShape {
    side: float
    fn area() float { return this.side * this.side }
    get sides: uint { return 4 }
}

class DefaultsCircle is DefaultsShape {
    r: float
    fn area() float { return 3.0 * this.r * this.r }
    fn describe() String { return "circle" }
}

fn defaults_describe(s: DefaultsShape) String {
    return s.describe() + "/" + s.sides
}

test "Traits: a class method overrides the trait method of the same name" {
    assert(DefaultsPerson { first: "Ada" }.greet() == "Hello Ada")
    assert(DefaultsRobot {}.greet() == "BEEP")
    assert(DefaultsRobot {}.name() == "someone")
}

test "Interfaces: a method with a body is a default for classes without one" {
    assert(defaults_describe(DefaultsSquare { side: 2.0 }) == "shape of 4/4")
    assert(defaults_describe(DefaultsCircle { r: 1.0 }) == "circle/0")
    // The default is a method of the class itself too
    assert(DefaultsSquare { side: 3.0 }.describe() == "shape of 9")
}

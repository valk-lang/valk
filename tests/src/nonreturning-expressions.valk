fn nr_stop[T]() T $exit { panic("Unexpected exit branch") }
fn nr_combine(a: int, b: int, c: int) int { return a * 10000 + b * 100 + c }

fn nr_nested_call(fail: bool) int {
    return nr_combine(11, fail ? nr_combine(13, nr_stop[int](), 17) : 23, 29)
}

class NrChild {
    first: int
    second: int
}

class NrParent {
    first: int
    child: NrChild
    last: int
}

fn nr_nested_init(fail: bool) NrParent {
    return NrParent {
        first: 11
        child: (fail ? NrChild { first: 13, second: nr_stop[int]() }
            : NrChild { first: 17, second: 19 })
        last: 23
    }
}

fn nr_match(fail: bool) int {
    return match fail : int {
        false => 31
        nr_stop[bool]() => 37
        default => 41
    }
}

fn nr_step(steps: Array[int], value: int) int {
    steps.append(value)
    return value
}

fn nr_multiple(steps: Array[int]) (int, int, int) {
    steps.append(19)
    return (23, 29, 31)
}

test "Partial destructuring: unbound operands keep their side effects" {
    let steps = Array[int]{}
    // Every member is named; `_` discards the ones the test does not need
    let first, _, _ = (nr_step(steps, 11), nr_step(steps, 13), nr_step(steps, 17))
    assert(first == 11)
    assert(steps == Array[int]{ 11, 13, 17 })
    let returned, _, _ = nr_multiple(steps)
    assert(returned == 23)
    assert(steps == Array[int]{ 11, 13, 17, 19 })
    let _, _ = (nr_step(steps, 37), nr_step(steps, 41))
    assert(steps == Array[int]{ 11, 13, 17, 19, 37, 41 })
}

test "Nonreturning expressions: nested calls preserve pending arguments" {
    assert(nr_nested_call(false) == 112329)
    let indirect: fn(bool)(int) = nr_nested_call
    assert(indirect(false) == 112329)
    let pointer: fnptr(bool)(int) = nr_nested_call
    assert(pointer(false) == 112329)
}

test "Nonreturning expressions: nested initializers preserve pending fields" {
    let value = nr_nested_init(false)
    assert(value.first == 11 && value.last == 23)
    assert(value.child.first == 17 && value.child.second == 19)
}

test "Nonreturning expressions: match keeps earlier reachable results" {
    assert(nr_match(false) == 31)
}

test "Nonreturning expressions: value scopes keep reachable results" {
    let value: int = <{
        if nr_match(false) == 31 : return 43
        return nr_stop[int]()
    }
    assert(value == 43)
}

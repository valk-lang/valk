use valk.gc

// `&mut [T]` and `String` are `&[T]` with a class attached: one layout, one
// bounds policy, implicit conversion in both directions.

fn sum_view(values: &[int]) int {
    let total = 0
    each values as v : total += v
    return total
}

fn count_bytes(text: &[u8]) uint {
    return text.length
}


fn named_length(values: &mut [int]) uint {
    return values.length
}

class SliceHolder {
    name: ?String (null)
    view: ?&[u8] (null)
}

mode SliceWord for String {}

test "Slices: named slices convert to and from &[T]" {
    let values = [int]{ 1, 2, 3 }
    let view: &mut [int] = values
    assert(view.length == 3)
    assert(view[1] == 2)
    assert(sum_view(values) == 6)
    assert(sum_view(view) == 6)
    let back: &mut [int] = view
    assert(back.length == 3)
    assert(back[2] == 3)
    assert(named_length(view) == 3)
}

test "Slices: String views as &[u8], never the other way" {
    let text = "hello"
    let bytes: &[u8] = text
    assert(bytes.length == 5)
    assert(bytes[0] == 'h')
    assert(count_bytes(text) == 5)
    // A range on the anonymous view is native; on a String it is `$range`.
    let part: &[u8] = bytes[1..3]
    assert(part.length == 3)
    assert(part[0] == 'e')
    assert(text[1..3] == "ell")
    // A `&[u8]` carries no terminating zero byte, so it is not a `String`;
    // `&mut [u8]` is the named form for arbitrary bytes.
    let named: &[u8] = part
    assert(named.length == 3)
    assert((named.get(1) !? 0) == 'l')
}

test "Slices: a class hook comes before native indexing" {
    let text = "ab"
    // `String.$offset` answers 0 past the end instead of panicking.
    assert(text[5] == 0)
    let bytes: &[u8] = text
    assert(bytes[1] == 'b')
}

test "Slices: native indexing reads and writes" {
    let values = [int]{ 7 x 3 }
    values[1] = 9
    assert(values[0] == 7)
    assert(values[1] == 9)
    assert((values.get(3) !? -1) == -1)
    let view: &mut [int] = values
    view[2] = 11
    assert(values[2] == 11)
    assert(view[2] == 11)
}

test "Slices: managed elements stored through a view keep their owner" {
    let names = [String]{ "a" x 2 }
    let view: &mut [String] = names
    view[1] = "b" + "c"
    gc.collect()
    gc.collect()
    assert(names[1] == "bc")
    assert(view[0] == "a")
}

test "Slices: nullable named slices use the null address" {
    let holder = SliceHolder {}
    assert(!isset(holder.name))
    assert(!isset(holder.view))
    holder.name = "x"
    holder.view = "yz"
    let name = holder.name
    assert(isset(name) && name == "x")
    let view = holder.view
    assert(isset(view) && view.length == 2)
    holder.name = null
    assert(!isset(holder.name))
    let missing: ?String = null
    assert(!isset(missing))
    let present: ?&[u8] = "abc"
    assert(isset(present) && present.length == 3)
}

test "Slices: a mode over String compares through String" {
    let a: SliceWord = "b"
    let b: SliceWord = "a"
    assert(a > b)
    assert(b < a)
    assert(a != b)
    let words = Array[SliceWord]{ "c", "a", "b" }
    words.sort()
    assert(words[0] == "a")
    assert(words[2] == "c")
}

test "Slices: literals have no owner" {
    let text = "hello"
    // A view of a literal shares its bytes.
    let view = text.view(1, 3)
    assert(view.length == 3)
    assert(view[0] == 'e')
    let bytes: &[u8] = text
    let names = [String]{ text x 1 }
    gc.collect()
    gc.collect()
    assert(bytes[4] == 'o')
    assert(names[0] == "hello")
    assert(text.view(0, 5).to_string() == "hello")
}

fn sl_first(values: &mut [int]) &mut int {
    return &mut values[0]
}

test "Slices: elements borrow without unsafe code" {
    let values = [int]{ 5, 6, 7 }
    let middle = &mut values[1]
    assert(middle[0] == 6)
    middle[0] = 60
    assert(values[1] == 60)
    let view: &mut [int] = values
    let first = sl_first(view)
    first[0] = 50
    assert(values[0] == 50)
    let tail: &[int] = &view[1..2]
    assert(tail.length == 2)
    assert(tail[1] == 7)
    let names = [String]{ "x" x 2 }
    let name = &mut names[1]
    name[0] = "y" + "z"
    gc.collect()
    assert(names[1] == "yz")
}

slice FrozenBytes of u8 $immutable {
    static fn of(source: &mut [u8]) SELF {
        @unsafe
        return SELF { owner: source.owner, data: source.data, length: source.length }
    }
    fn first() u8 { return this[0] }
}
fn frozen_read(bytes: &[u8]) u8 { return bytes[0] }

test "Slices: an immutable slice type only reads and converts to read-only views" {
    let frozen = FrozenBytes.of([u8]{ 7 x 2 })
    assert(frozen[0] == 7)
    assert(frozen.first() == 7)
    assert(frozen_read(frozen) == 7)
    let view: &[u8] = frozen
    assert(view.length == 2)
}

struct SlPoint {
    x: int
    y: int
}

fn sl_sum(values: &[int]) int {
    let total = 0
    each values as v : total += v
    return total
}

test "Slices: language forms allocate fresh storage" {
    let listed = [int]{ 1, 2, 3 }
    assert(listed.length == 3)
    assert(sl_sum(listed) == 6)
    let count = 4
    let filled = [int]{ 7 x count * 2 }
    assert(filled.length == 8)
    assert(sl_sum(filled) == 56)
    let zeroed = [u8]{ 0 x 5 }
    assert(zeroed.length == 5)
    assert(zeroed[4] == 0)
    let points = [SlPoint]{ null x 2 }
    assert(points[1].x == 0)
    points[1].y = 9
    assert(points[1].y == 9)
    let missing = [?String]{ null x 3 }
    assert(!isset(missing[2]))
    let one = [String]{ "solo" x 1 }
    assert(one.length == 1 && one[0] == "solo")
    let nothing = [String]{}
    assert(nothing.length == 0)
    let names = [String]{ "a" + "b", "c" }
    gc.collect()
    assert(names[0] == "ab")
    assert(names[1] == "c")
    let read_only: &[int] = [int]{ 4, 5 }
    assert(read_only[1] == 5)
}

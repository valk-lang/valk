use valk.gc

// `Slice[T]` and `String` are `&[T]` with a class attached: one layout, one
// bounds policy, implicit conversion in both directions.

fn sum_view(values: &[int]) int {
    let total = 0
    each values as v : total += v
    return total
}

fn count_bytes(text: &[u8]) uint {
    return text.length
}

fn first_byte(text: String) u8 {
    return text[0]
}

fn named_length(values: Slice[int]) uint {
    return values.length
}

class SliceHolder {
    name: ?String (null)
    view: ?&[u8] (null)
}

mode SliceWord for String {}

test "Slices: named slices convert to and from &[T]" {
    let values = Slice[int]{ 1, 2, 3 }
    let view: &[int] = values
    assert(view.length == 3)
    assert(view[1] == 2)
    assert(sum_view(values) == 6)
    assert(sum_view(view) == 6)
    let back: Slice[int] = view
    assert(back.length == 3)
    assert(back[2] == 3)
    assert(named_length(view) == 3)
}

test "Slices: String is &[u8] with methods" {
    let text = "hello"
    let bytes: &[u8] = text
    assert(bytes.length == 5)
    assert(bytes[0] == 'h')
    assert(count_bytes(text) == 5)
    let again: String = bytes
    assert(again == "hello")
    assert(again.upper() == "HELLO")
    assert(first_byte(bytes) == 'h')
    // A range on the anonymous view is native; on a String it is `$range`.
    let part: &[u8] = bytes[1..3]
    assert(part.length == 3)
    assert(part[0] == 'e')
    let named: String = part
    assert(named == "ell")
    assert(text[1..3] == "ell")
}

test "Slices: a class hook comes before native indexing" {
    let text = "ab"
    // `String.$offset` answers 0 past the end instead of panicking.
    assert(text[5] == 0)
    let bytes: &[u8] = text
    assert(bytes[1] == 'b')
}

test "Slices: native indexing reads and writes" {
    let values = Slice[int].new(3, 7)
    values[1] = 9
    assert(values[0] == 7)
    assert(values[1] == 9)
    assert((values.get(3) !? -1) == -1)
    let view: &[int] = values
    view[2] = 11
    assert(values[2] == 11)
    assert(view[2] == 11)
}

test "Slices: managed elements stored through a view keep their owner" {
    let names = Slice[String].new(2, "a")
    let view: &[String] = names
    view[1] = "b" + "c"
    gc.collect()
    gc.collect()
    assert(names[1] == "bc")
    assert(view[0] == "a")
}

test "Slices: nullable named slices use the null address" {
    let holder = SliceHolder {}
    assert(!isset(holder.name))
    assert(!isset(holder.view))
    holder.name = "x"
    holder.view = "yz"
    let name = holder.name
    assert(isset(name) && name == "x")
    let view = holder.view
    assert(isset(view) && view.length == 2)
    holder.name = null
    assert(!isset(holder.name))
    let missing: ?String = null
    assert(!isset(missing))
    let present: ?&[u8] = "abc"
    assert(isset(present) && present.length == 3)
}

test "Slices: a mode over String compares through String" {
    let a: SliceWord = "b"
    let b: SliceWord = "a"
    assert(a > b)
    assert(b < a)
    assert(a != b)
    let words = Array[SliceWord]{ "c", "a", "b" }
    words.sort()
    assert(words[0] == "a")
    assert(words[2] == "c")
}

test "Slices: literals have no owner" {
    let text = "hello"
    // Unowned storage reports offset 0, and a view of it shares the bytes.
    assert(text.offset == 0)
    let view = text.view(1, 3)
    assert(view.offset == 0)
    assert(view.length == 3)
    assert(view[0] == 'e')
    let bytes: &[u8] = text
    let names = Slice[String].new(1, text)
    gc.collect()
    gc.collect()
    assert(bytes[4] == 'o')
    assert(names[0] == "hello")
    assert(text.view(0, 5).to_string() == "hello")
}

fn sl_first(values: &[int]) &int {
    return &values[0]
}

test "Slices: elements borrow without unsafe code" {
    let values = Slice[int]{ 5, 6, 7 }
    let middle = &values[1]
    assert(middle[0] == 6)
    middle[0] = 60
    assert(values[1] == 60)
    let view: &[int] = values
    let first = sl_first(view)
    first[0] = 50
    assert(values[0] == 50)
    let tail: &[int] = &view[1..2]
    assert(tail.length == 2)
    assert(tail[1] == 7)
    let names = Slice[String].new(2, "x")
    let name = &names[1]
    name[0] = "y" + "z"
    gc.collect()
    assert(names[1] == "yz")
}

use valk.mem

// C-31, what the primitive-only rule still accepts outside a primitive (the rejected forms are
// compile-error cases ce-raw-gc-*)

class RawAccessNode {
    value: uint
    next: ?RawAccessNode (null)
}

// A primitive may move references raw, here between two frame slots
fn raw_access_swap(a: *?RawAccessNode, b: *?RawAccessNode) $gc_primitive {
    let x = a[0]
    a[0] = b[0]
    b[0] = x
}

test "Raw access: identity of objects with references under @unsafe" {
    let a = RawAccessNode { value: 1 }
    let b = RawAccessNode { value: 2, next: a }
    @unsafe
    let ida = a.@cast(ptr).@cast(uint)
    let idb = b.@cast(uint)
    assert(ida != idb && ida != 0)
}

test "Raw access: references read through a raw pointer with @property_get" {
    let items = Array[RawAccessNode]{ RawAccessNode { value: 5 }, RawAccessNode { value: 7 } }
    @unsafe
    let data = items.items()
    let second = @property_get(data[1])
    assert(second.value == 7)
    assert(@property_get(@ptrv(data, RawAccessNode, 0)).value == 5)
}

test "Raw access: elements without references are plain memory" {
    let items = Array[uint]{ 1, 2, 3 }
    @unsafe
    let data = items.items()
    data[1] = 20
    mem.clear_bytes(data.@cast(ptr) + 2 * size_of(uint), size_of(uint))
    assert((items.get(0) !? 0) == 1 && (items.get(1) !? 0) == 20 && (items.get(2) !? 1) == 0)
}

test "Raw access: a $gc_primitive moves references raw" {
    let a: ?RawAccessNode = RawAccessNode { value: 1 }
    let b: ?RawAccessNode = RawAccessNode { value: 2 }
    @unsafe
    raw_access_swap(@ref(a), @ref(b))
    let x = a ?! panic("a")
    let y = b ?! panic("b")
    assert(x.value == 2 && y.value == 1)
}

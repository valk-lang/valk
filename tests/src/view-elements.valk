// Elements of shared and locked collections: callbacks get them as views, shared copies hold
// shared elements, `$clone` of shared data is a plain copy

class VeItem {
    n: int (0)
    tags: Array[String] (.{})
    + fn lt(o: VeItem) bool $lt { return this.n < o.n }
    + fn eq(o: VeItem) bool $eq { return this.n == o.n }
    + fn hash() uint $hash { return this.n.to(uint) }
}

class VeState {
    items: Array[VeItem] (.{ VeItem { n: 3 }, VeItem { n: 1 }, VeItem { n: 2 } })
    byid: HashMap[uint, VeItem] (.{ 1 => VeItem { n: 1 }, 2 => VeItem { n: 2 }, 3 => VeItem { n: 3 } })
    flat: FlatMap[uint, VeItem] (.{})
    names: Array[?String] (.{ "a", null, "", "b" })
    bytes: Array[u8] (.{ 1, 2, 3 })
}

fn ve_lock() shared Lock[VeState] {
    return Lock[VeState].new(VeState {}) !!
}

fn ve_order(items: locked Array[VeItem]) String {
    let out = ""
    each items as item : out += item.n
    return out
}

fn ve_sum(bytes: &[u8]) uint {
    let sum: uint = 0
    each bytes as b : sum += b
    return sum
}

test "Locked elements: sort, remove_where, find, any and all take locked callbacks" {
    let state = ve_lock()
    lock state as s {
        s.items.sort()
        assert(ve_order(s.items) == "123")
        s.items.sort(fn(a: locked VeItem, b: locked VeItem) bool { return a.n < b.n })
        assert(ve_order(s.items) == "321")
        assert(s.items.any(fn(a: locked VeItem) bool { return a.n == 2 }))
        assert(!s.items.all(fn(a: locked VeItem) bool { return a.n > 1 }))
        let found = s.items.find(fn(a: locked VeItem) bool { return a.n == 1 }) !? null
        assert(isset(found))
        s.items.remove_where(fn(a: locked VeItem) bool { return a.n == 2 })
        assert(ve_order(s.items) == "31")
        s.names.remove_where()
        assert(s.names.length == 2)
    }
}

test "Locked elements: map filters, get_or_replace and append_many work in place" {
    let state = ve_lock()
    lock state as s {
        s.byid.remove_where(fn(v: locked VeItem, k: uint) bool { return v.n == 2 })
        assert(s.byid.length == 2)
        s.byid.retain(fn(v: locked VeItem, k: uint) bool { return k == 3 })
        assert(s.byid.length == 1)
        let item, found = s.byid.get_or_replace(4, 3, VeItem { n: 4 }) !!
        assert(!found && item.n == 4 && s.byid.length == 1)
        s.flat.set(1, VeItem { n: 1 })
        s.flat.set(2, VeItem { n: 2 })
        s.flat.retain(fn(v: locked VeItem, k: uint) bool { return v.n == 2 })
        assert(s.flat.length == 1)
        let extra = Array[VeItem]{}
        each 0 .. 10 as i : extra.append(VeItem { n: i.to(int) })
        s.items.append_many(extra, true)
        assert(s.items.length == 10)
    }
}

test "Locked elements: an independent copy may leave the block" {
    let state = ve_lock()
    let copy = Array[VeItem]{}
    lock state as s {
        copy = s.items.clone()
    }
    copy.append(VeItem { n: 9 })
    assert(copy.length == 4)
}

test "Shared elements: copies, values and filters hold shared elements" {
    let s: shared VeState = VeState {}
    let copy = s.items.copy()
    copy.sort(fn(a: shared VeItem, b: shared VeItem) bool { return a.n > b.n })
    assert(copy.length == 3)
    assert((copy.get(0) !? null)?.n == 1)
    let big = s.items.filter(fn(a: shared VeItem) bool { return a.n > 1 })
    assert(big.length == 2)
    assert(s.byid.values().length == 3)
    assert(s.items.any(fn(a: shared VeItem) bool { return a.n == 3 }))
    // The original keeps its order
    assert((s.items.get(0) !? null)?.n == 3)
}

test "Shared elements: \$clone gives a plain copy" {
    let s: shared VeState = VeState {}
    let first: shared VeItem = s.items.get(0) !!
    let mine: VeItem = $clone(first)
    mine.n = 7
    mine.tags.append("x")
    assert(first.n == 3 && first.tags.length == 0)
    let list: Array[VeItem] = s.items.clone()
    list.append(VeItem {})
    assert(list.length == 4 && s.items.length == 3)
}

test "Shared bytes read as a plain read-only slice" {
    let s: shared VeState = VeState {}
    assert(ve_sum(s.bytes) == 6)
}

test "Locked elements: a local object moves into locked data through a method" {
    let state = ve_lock()
    lock state as s {
        let one = VeItem { n: 8 }
        s.items.append(one)
        let more = Array[VeItem]{ VeItem { n: 9 } }
        s.items.append_many(more)
        let entry = VeItem { n: 10 }
        s.byid.set(10, entry)
        assert(s.items.length == 5 && s.byid.length == 4)
    }
}

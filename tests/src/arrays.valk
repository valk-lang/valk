
use valk:gc

type AnonymousBytes (@[u8])

fn accept_min_slice(value: $[u8 x 3]) {}

fn pass_larger_slice(value: $[u8 x 4]) {
    accept_min_slice(value)
}

fn pass_exact_slice(value: $[u8 x 3]) {
    accept_min_slice(value)
}

test "Array memory test" {
    let i : uint = 0
    let arr = Array[String]{}
    while i++ < 200 {
        arr.append(i)
    }
    i = 0
    while i < 100 {
        i++
        let str = arr.pop_first() !? "0"
        assert(str == i)
    }
    each arr as str, index {
        i++
        assert(str == i)
        assert(index == i - 101)
    }
}

test "Array[String] tests" {
    let arr = Array[String]{ "1", "2", "3" }
    //
    assert(arr.contains("0") == false)
    assert(arr.contains("1"))
    assert(arr.contains("2"))
    assert(arr.contains("3"))

    let x = arr.get(0) !? "0"
    assert(x == "1")
    assert((arr.get(0) !? "0") == "1")
    assert((arr.get(1) !? "0") == "2")
    assert((arr.get(2) !? "0") == "3")
    assert((arr.get(3) !? "0") == "0")
    assert(arr.length == 3)
    arr.remove_value("1")
    assert(arr.length == 2)
    arr.remove_value("0")
    assert(arr.length == 2)
}

test "Array[int] tests" {
    let arr = Array[int]{ 1, 2, 3 }
    //
    each arr as v, k {
        assert(k + 1 == v.to(uint))
    }
    //
    assert(arr.contains(0) == false)
    assert(arr.contains(1))
    assert(arr.contains(2))
    assert(arr.contains(3))
    assert((arr.get(0) !? 0) == 1)
    assert((arr.get(1) !? 0) == 2)
    assert((arr.get(2) !? 0) == 3)
    assert((arr.get(3) !? 0) == 0)
    assert(arr.length == 3)
    arr.remove_value(1)
    assert(arr.length == 2)
    arr.remove_value(0)
    assert(arr.length == 2)
}


test "Array sorting" {
    let arr = Array[int]{ 3, 1, 2 }

    arr.sort()

    assert((arr.get(0) !? 0) == 1)
    assert((arr.get(1) !? 0) == 2)
    assert((arr.get(2) !? 0) == 3)

    arr.clear()
    arr.append(3)
    arr.append(1)
    arr.append(2)
    arr.append(4)

    arr.sort(fn(a: int, b: int) bool {
        return a > b
    })

    assert((arr.get(0) !? 0) == 1)
    assert((arr.get(1) !? 0) == 2)
    assert((arr.get(2) !? 0) == 3)
    assert(arr.length == 4)

    let many = Array[uint].new(4096)
    let i : uint = 4096
    while i > 0 : many.append(i--)
    many.sort()

    let ordered = true
    i = 0
    while i < many.length {
        if (many.get(i) !? 0) != i + 1 {
            ordered = false
            break
        }
        i++
    }
    assert(ordered)

    many.sort(fn(a: uint, b: uint) bool { return a < b })
    assert((many.get(0) !? 0) == 4096)
    assert((many.get(4095) !? 0) == 1)
}

test "Array clearing" {
    let arr = Array[int]{ 6, 3, 1, 2, 8 }
    assert((arr.get(0) !? 0) == 6)
    assert((arr.get(arr.length - 1) !? 0) == 8)
    let v = arr.pop_first() !? 0
    assert(v == 6)
    assert((arr.get(0) !? 0) == 3)
    assert((arr.get(arr.length - 1) !? 0) == 8)
    v = arr.pop_last() !? 0
    assert(v == 8)
    assert((arr.get(0) !? 0) == 3)
    assert((arr.get(arr.length - 1) !? 0) == 2)
    arr.remove(1)
    assert(arr.length == 2)
    assert((arr.get(0) !? 0) == 3)
    assert((arr.get(arr.length - 1) !? 0) == 2)

    arr = .{ 1, 2, 3, 4, 5 }
    arr.remove(1)
    assert(arr == .{ 1, 3, 4, 5 })
    assert((arr.pop_first() !? 0) == 1)
    assert(arr == .{ 3, 4, 5 })
}

test "Array range / equal / equal_ignore_order" {
    let arr = Array[int]{ 6, 3, 1, 2, 8 }
    let part = arr.part(1, 2)
    assert(part.length == 2)
    assert(part.equal(.{ 3, 1 }))
    assert(!part.equal(.{ 1, 3 }))
    assert(part.equal_ignore_order(.{ 1, 3 }))
    assert(part == arr.range(1, 3, false))
    assert(part == arr.range(1, 2))
}

test "Array filter" {
    let a1 : Array[?String] = .{ "", null, "a", null, "b" }
    assert(a1.filter().equal(.{ "a", "b" }))
}

test "Array merge" {
    let a = Array[String]{ "a" }
    let b = Array[String]{ "b" }
    let c = a.merge(b)
    assert(a.length == 1)
    assert(a == .{ "a" })
    assert(b.length == 1)
    assert(b == .{ "b" })
    assert(c.length == 2)
    assert(c == .{ "a", "b" })
    c = a + b
    assert(a.length == 1)
    assert(a == .{ "a" })
    assert(b.length == 1)
    assert(b == .{ "b" })
    assert(c.length == 2)
    assert(c == .{ "a", "b" })
}

test "Array unique" {
    let a = Array[?String]{ "a", "b", "a", "a", null, "b", null, null }
    let b = a.copy()
    a.unique()
    // A
    assert(a.length == 3)
    assert(a == .{ "a", "b", null })
    assert(a != .{ "a", null, "b" })
    assert(a.equal_ignore_order(.{ "a", null, "b" }))
    // B
    assert(b.length == 8)
    b.copy().unique()
    assert(b.length == 8)
    b = b.copy().unique()
    assert(b.length == 3)
    assert(b == .{ "a", "b", null })
    //
    assert(a == b)
    assert(b.join("-") == "a-b")
}

test "Array prepend" {
    let a = Array[?String]{ "a" }
    let b = Array[?String]{ "b" }
    a.prepend_many(b)
    assert(a.length == 2)
    assert(b.length == 1)
    assert(a == .{ "b", "a" })
    b.prepend("c")
    assert(b.length == 2)
    assert(a.length == 2)
    assert(a == .{ "b", "a" })
    assert(b == .{ "c", "b" })

    let numbers = Array[int]{ 1, 2, 3 }
    numbers.prepend_many(.{ 8, 9 })
    assert(numbers == .{ 8, 9, 1, 2, 3 })
}

fn array_string_slice() Slice[String] {
    let values = Array[String]{ "zero", "one", "two", "three" }
    return values.slice(1, 2)
}

synctest "Array slice" {
    let literal = Slice[u16]{ 7, 9 }
    assert(literal.length == 2)
    assert(literal.data[0] == 7)
    assert(literal.data[1] == 9)

    let typed = Array[u16]{ 41, 42 }.slice(0, 2)
    assert(typed.data.@cast(ptr) == typed.@cast(ptr) + size_of(uint))
    assert(typed.data[0] == 41)
    assert(typed.data[1] == 42)

    let values = Array[int]{ 10, 20, 30, 40 }
    let sliced = values.slice(2, 2)
    assert(sliced.length == 2)
    assert((sliced.get(0) !? 0) == 30)
    assert((sliced.get(1) !? 0) == 40)

    // Managed elements in inline slice storage must survive collection after
    // the source array and its function frame are gone.
    let strings = array_string_slice()
    gc:collect()
    assert((strings.get(0) !? "") == "one")
    assert((strings.get(1) !? "") == "two")
}

test "Array join" {
    let a = Array[?int]{ 5, 4, null, 10, null, 12 }
    let str = a.join(",")
    assert(str == "5,4,10,12")

    let parts = Array[String].new(4096)
    let i : uint = 0
    while i++ < 4096 : parts.append("part")
    let large = parts.join(",")
    assert(large.length == 4096 * 4 + 4095)
    assert(large.starts_with("part,part"))
    assert(large.ends_with("part,part"))
}

test "Sequence type syntax" {
    #if !cstring.$has_method(length)
    #error "Named unbound types must expose their methods"
    #end
    #if AnonymousBytes.$has_method(length)
    #error "Anonymous unbound types must remain classless"
    #end

    let values = [int]{ 3, 5 }
    values.append(8)
    assert(values == .{ 3, 5, 8 })

    let slice: $[int] = { 13, 21 }
    assert(slice.length == 2)
    assert((slice.get(1) !? 0) == 21)

    let raw: ?@[int] = null
    assert(!isset(raw))
}

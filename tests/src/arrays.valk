use valk.gc

type AnonymousBytes (*u8)

test "Array memory test" {
    let i : uint = 0
    let arr = Array[String]{}
    while i++ < 200 {
        arr.append(i)
    }
    i = 0
    while i < 100 {
        i++
        let str = arr.pop_first() !? "0"
        assert(str == i)
    }
    each arr as str, index {
        i++
        assert(str == i)
        assert(index == i - 101)
    }
}

test "Array[String] tests" {
    let arr = Array[String]{ "1", "2", "3" }
    //
    assert(arr.contains("0") == false)
    assert(arr.contains("1"))
    assert(arr.contains("2"))
    assert(arr.contains("3"))

    let x = arr.get(0) !? "0"
    assert(x == "1")
    assert((arr.get(0) !? "0") == "1")
    assert((arr.get(1) !? "0") == "2")
    assert((arr.get(2) !? "0") == "3")
    assert((arr.get(3) !? "0") == "0")
    assert(arr.length == 3)
    arr.remove_value("1")
    assert(arr.length == 2)
    arr.remove_value("0")
    assert(arr.length == 2)
}

test "Array[int] tests" {
    let arr = Array[int]{ 1, 2, 3 }
    //
    each arr as v, k {
        assert(k + 1 == v.to(uint))
    }
    //
    assert(arr.contains(0) == false)
    assert(arr.contains(1))
    assert(arr.contains(2))
    assert(arr.contains(3))
    assert((arr.get(0) !? 0) == 1)
    assert((arr.get(1) !? 0) == 2)
    assert((arr.get(2) !? 0) == 3)
    assert((arr.get(3) !? 0) == 0)
    assert(arr.length == 3)
    arr.remove_value(1)
    assert(arr.length == 2)
    arr.remove_value(0)
    assert(arr.length == 2)
}


test "Array sorting" {
    let arr = Array[int]{ 3, 1, 2 }

    arr.sort()

    assert((arr.get(0) !? 0) == 1)
    assert((arr.get(1) !? 0) == 2)
    assert((arr.get(2) !? 0) == 3)

    arr.clear()
    arr.append(3)
    arr.append(1)
    arr.append(2)
    arr.append(4)

    arr.sort(fn(a: int, b: int) bool {
        return a > b
    })

    assert((arr.get(0) !? 0) == 1)
    assert((arr.get(1) !? 0) == 2)
    assert((arr.get(2) !? 0) == 3)
    assert(arr.length == 4)

    let many = Array[uint].new(4096)
    let i : uint = 4096
    while i > 0 : many.append(i--)
    many.sort()

    let ordered = true
    i = 0
    while i < many.length {
        if (many.get(i) !? 0) != i + 1 {
            ordered = false
            break
        }
        i++
    }
    assert(ordered)

    many.sort(fn(a: uint, b: uint) bool { return a < b })
    assert((many.get(0) !? 0) == 4096)
    assert((many.get(4095) !? 0) == 1)
}

test "Array clearing" {
    let arr = Array[int]{ 6, 3, 1, 2, 8 }
    assert((arr.get(0) !? 0) == 6)
    assert((arr.get(arr.length - 1) !? 0) == 8)
    let v = arr.pop_first() !? 0
    assert(v == 6)
    assert((arr.get(0) !? 0) == 3)
    assert((arr.get(arr.length - 1) !? 0) == 8)
    v = arr.pop_last() !? 0
    assert(v == 8)
    assert((arr.get(0) !? 0) == 3)
    assert((arr.get(arr.length - 1) !? 0) == 2)
    arr.remove(1)
    assert(arr.length == 2)
    assert((arr.get(0) !? 0) == 3)
    assert((arr.get(arr.length - 1) !? 0) == 2)

    arr = .{ 1, 2, 3, 4, 5 }
    arr.remove(1)
    assert(arr == .{ 1, 3, 4, 5 })
    assert((arr.pop_first() !? 0) == 1)
    assert(arr == .{ 3, 4, 5 })

    let strings = Array[String]{ "first", "middle", "last" }
    strings.swap_remove(0)
    gc.collect()
    assert(strings.length == 2)
    assert((strings.get(0) !? "") == "last")
    assert((strings.get(1) !? "") == "middle")
}

test "Array range / equal / equal_ignore_order" {
    let arr = Array[int]{ 6, 3, 1, 2, 8 }
    let part = arr.range(1, 2)
    assert(part.length == 2)
    assert(part.equal(.{ 3, 1 }))
    assert(!part.equal(.{ 1, 3 }))
    assert(part.equal_ignore_order(.{ 1, 3 }))
    assert(part == arr[1 .. 2])
    assert(arr.range(0, uint.$max) == arr)
    assert(arr.range(2, uint.$max) == .{ 1, 2, 8 })
}

test "Array filter copies, remove_where removes, extract takes" {
    let a1 : Array[?String] = .{ "", null, "a", null, "b" }
    assert(a1.filter().equal(.{ "a", "b" }))
    assert(a1.length == 5)
    a1.remove_where()
    assert(a1.equal(.{ "a", "b" }))

    let values = Array[int]{ 1, 2, 3, 4, 5 }
    let even = values.filter(fn(value: int) bool { return value % 2 == 0 })
    assert(even.equal(.{ 2, 4 }))
    even.set(0, 20) _
    assert(values.equal(.{ 1, 2, 3, 4, 5 }))

    values.remove_where(fn(value: int) bool { return value % 2 == 0 })
    assert(values.equal(.{ 1, 3, 5 }))

    let mixed = Array[int]{ 1, 2, 3, 4, 5 }
    let taken = mixed.extract(fn(value: int) bool { return value % 2 == 0 })
    assert(taken.equal(.{ 2, 4 }))
    assert(mixed.equal(.{ 1, 3, 5 }))
    taken.set(0, 20) _
    assert(mixed.equal(.{ 1, 3, 5 }))

    let strings : Array[?String] = .{ "", null, "a", null, "b" }
    let dropped = strings.extract()
    assert(dropped.equal(.{ "", null, null }))
    assert(strings.equal(.{ "a", "b" }))
}

test "Array merge" {
    let a = Array[String]{ "a" }
    let b = Array[String]{ "b" }
    let c = a.merge(b)
    assert(a.length == 1)
    assert(a == .{ "a" })
    assert(b.length == 1)
    assert(b == .{ "b" })
    assert(c.length == 2)
    assert(c == .{ "a", "b" })
    c = a + b
    assert(a.length == 1)
    assert(a == .{ "a" })
    assert(b.length == 1)
    assert(b == .{ "b" })
    assert(c.length == 2)
    assert(c == .{ "a", "b" })

    a.merge_in_place(b)
    assert(a == .{ "a", "b" })
    assert(b == .{ "b" })

    let self = Array[String]{ "x", "y" }
    self.merge_in_place(self)
    assert(self == .{ "x", "y", "x", "y" })
}

test "Array unique" {
    let a = Array[?String]{ "a", "b", "a", "a", null, "b", null, null }
    let b = a.copy()
    a.unique()
    // A
    assert(a.length == 3)
    assert(a == .{ "a", "b", null })
    assert(a != .{ "a", null, "b" })
    assert(a.equal_ignore_order(.{ "a", null, "b" }))
    // B
    assert(b.length == 8)
    b.copy().unique()
    assert(b.length == 8)
    b = b.copy().unique()
    assert(b.length == 3)
    assert(b == .{ "a", "b", null })
    //
    assert(a == b)
    assert(b.join("-") == "a-b")
}

test "Array prepend" {
    let a = Array[?String]{ "a" }
    let b = Array[?String]{ "b" }
    a.prepend_many(b)
    assert(a.length == 2)
    assert(b.length == 1)
    assert(a == .{ "b", "a" })
    b.prepend("c")
    assert(b.length == 2)
    assert(a.length == 2)
    assert(a == .{ "b", "a" })
    assert(b == .{ "c", "b" })

    let numbers = Array[int]{ 1, 2, 3 }
    numbers.prepend_many(.{ 8, 9 })
    assert(numbers == .{ 8, 9, 1, 2, 3 })
}

fn array_string_slice() &mut [String] {
    let values = Array[String]{ "zero", "one", "two", "three" }
    return values.view(1, 2).range(0, 2)
}

synctest "Array view range copy" {
    let literal = [u16]{ 7, 9 }
    assert(size_of(&mut [u16]) == size_of(ptr) * 3)
    assert(literal.length == 2)
    assert((literal[0]) == 7)
    assert((literal[1]) == 9)

    let typed = Array[u16]{ 41, 42 }.view(0, 2).range(0, 2)
    assert((typed[0]) == 41)
    assert((typed[1]) == 42)

    let values = Array[int]{ 10, 20, 30, 40 }
    let sliced = values.view(2, 2).range(0, 2)
    assert(sliced.length == 2)
    assert((sliced.get(0) !? 0) == 30)
    assert((sliced.get(1) !? 0) == 40)

    let strings = array_string_slice()
    gc.collect()
    assert((strings.get(0) !? "") == "one")
    assert((strings.get(1) !? "") == "two")
}

fn filled_string_slice() &mut [String] {
    return [String]{ "managed-" + 42 x 3 }
}

fn appended_string_slice() &mut [String] {
    let values = [String]{ "managed-" + 40, "managed-" + 41, "managed-" + 42 }
    return values
}

fn managed_string_slice_view() &mut [String] {
    let values = [String]{ "zero", "one", "two", "three" }
    return values.view(1, 2)
}

synctest "Filled Slice initializes bounded storage" {
    let values = [float]{ 1.5 x 3 }
    values.set(1, 2.5) !!
    assert(values.length == 3)
    assert((values[0]) == 1.5)
    assert((values[1]) == 2.5)
    assert((values[2]) == 1.5)

    let strings = filled_string_slice()
    gc.collect()
    assert((strings[0]) == "managed-42")
    assert((strings[1]) == "managed-42")
    assert((strings[2]) == "managed-42")
}

synctest "Slice append preserves managed elements" {
    let strings = appended_string_slice()
    gc.collect()
    assert((strings[0]) == "managed-40")
    assert((strings[1]) == "managed-41")
    assert((strings[2]) == "managed-42")
}

synctest "Slice descriptors share bounded storage" {
    let values = [int]{ 10, 20, 30, 40 }
    let alias = values
    alias.set(1, 21) !!
    assert((values[1]) == 21)

    let middle = values.view(1, 2)
    assert(middle.length == 2)
    assert((middle[0]) == 21)
    assert((middle[1]) == 30)
    middle.set(1, 31) !!
    assert((values[2]) == 31)

    let tail = middle.view(1, 99)
    assert(tail.length == 1)
    assert((tail[0]) == 31)

    let strings = managed_string_slice_view()
    gc.collect()
    assert(strings.length == 2)
    assert((strings[0]) == "one")
    assert((strings[1]) == "two")
}

test "Array join" {
    let a = Array[?int]{ 5, 4, null, 10, null, 12 }
    let str = a.join(",")
    assert(str == "5,4,10,12")

    let parts = Array[String].new(4096)
    let i : uint = 0
    while i++ < 4096 : parts.append("part")
    let large = parts.join(",")
    assert(large.length == 4096 * 4 + 4095)
    assert(large.starts_with("part,part"))
    assert(large.ends_with("part,part"))
}

test "Sequence type syntax" {
    #if String.$is_inline
    #error "Slice types must remain reference-like to generic code"
    #end
    #if !cstring.$has_method(length)
    #error "Named unbound types must expose their methods"
    #end
    #if AnonymousBytes.$has_method(length)
    #error "Anonymous unbound types must remain classless"
    #end

    let values = Array[int]{ 3, 5 }
    values.append(8)
    assert(values == .{ 3, 5, 8 })
    let primitive_array: ?array[int] = null
    let primitive_slice: ?&[int] = null
    assert(!isset(primitive_array))
    assert(!isset(primitive_slice))

    let raw: ?*int = null
    assert(!isset(raw))
}

// A class property is enough to make the compiler specialize Array[T] before
// T's own properties are parsed, which used to size the element type as 0 and
// silently corrupt every Array[T] in the program.
fn array_null_ptr() ptr {
    return null.@cast(ptr)
}

struct StructArrayElement {
    a: uint
    b: ptr (array_null_ptr())
}

class StructArrayHolder {
    entries: Array[StructArrayElement] (.new(8))

    fn add(a: uint, b: ptr) {
        this.entries.append(StructArrayElement { a: a, b: b })
    }
}

test "Array of structs declared as a class property" {
    @unsafe
    let holder = StructArrayHolder {}
    holder.add(11, 0x1234.@cast(ptr))
    holder.add(22, 0xABCD.@cast(ptr))

    assert(holder.entries.length == 2)

    // The property, an alias of it and get() must all see the same values
    let first = holder.entries.get(0) !!
    assert(first.a == 11)
    assert(first.b == 0x1234)

    let aliased = holder.entries
    let total: uint = 0
    each aliased as entry : total += entry.a
    assert(total == 33)

    each holder.entries as entry, i {
        if i == 1 {
            assert(entry.a == 22)
            assert(entry.b == 0xABCD)
        }
    }

    // A local array of the same element type shares the specialization
    let local = Array[StructArrayElement].new(4)
    local.append(StructArrayElement { a: 7, b: 0x99.@cast(ptr) })
    let only = local.get(0) !!
    assert(only.a == 7)
    assert(only.b == 0x99)
}

// Nested sequence types must resolve in linear time
test "Deeply nested Array type" {
    let deep: Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[Array[int]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]] = .{}
    assert(deep.length == 0)
    let inner = Array[Array[int]]{ .{ 1, 2 } }
    assert((inner.get(0) !!).length == 2)
}

test "Array callbacks: any / all / find / map / reduce" {
    let nums = Array[int]{ 3, 1, 2 }
    assert(nums.any(fn(v: int) bool { return v > 2 }))
    assert(!nums.any(fn(v: int) bool { return v > 3 }))
    assert(nums.all(fn(v: int) bool { return v > 0 }))
    assert(!nums.all(fn(v: int) bool { return v > 1 }))
    assert(Array[int]{}.all(fn(v: int) bool { return false }))
    assert(!Array[int]{}.any(fn(v: int) bool { return true }))
    assert((nums.find(fn(v: int) bool { return v < 3 }) !? 0) == 1)
    let missing = false
    nums.find(fn(v: int) bool { return v > 3 }) ! { missing = true }
    assert(missing)

    let strs = nums.map[String](fn(v: int) String { return v.to(String) })
    assert(strs.join(",") == "3,1,2")
    assert(nums.reduce[int](10, fn(total: int, v: int) int { return total + v }) == 16)
    assert(strs.reduce[uint](0, fn(total: uint, v: String) uint { return total + v.bytes }) == 3)
}

test "Array numbers: sum / min / max / shuffle" {
    let nums = Array[int]{ 3, -1, 2 }
    assert(nums.sum() == 4)
    assert((nums.min() !? 0) == -1)
    assert((nums.max() !? 0) == 3)
    let floats = Array[f64]{ 1.5, 2.5 }
    assert(floats.sum() == 4)
    assert((floats.max() !? 0) == 2.5)
    let empty = Array[uint]{}
    assert(empty.sum() == 0)
    let is_empty = false
    empty.min() ! { is_empty = error_is(E.code, empty) }
    assert(is_empty)

    let order = Array[int]{ 1, 2, 3, 4, 5, 6, 7, 8 }
    let shuffled = order.copy().shuffle()
    assert(shuffled.length == 8)
    assert(shuffled.equal_ignore_order(order))
    assert(shuffled.sort().equal(order))
    assert(Array[int]{}.shuffle().length == 0)
}

test "Array: in-place helpers with a self-aliasing source" {
    let e = Array[int]{ 1, 2 }
    e.append_many(e)
    assert(e.equal(.{ 1, 2, 1, 2 }))
    e.prepend_many(e)
    assert(e.length == 8)
    e.merge_in_place(e)
    assert(e.length == 16)

    let f = Array[int]{ 1, 2 }
    f.remove_where(fn(x: int) bool { f.append(1); return x > 1 })
    assert(f.equal(.{ 1, 1, 1 }))

    let g = Array[int]{ 1, 2 }
    let taken = g.extract(fn(x: int) bool { g.append(1); return x > 1 })
    assert(g.equal(.{ 1, 1, 1 }))
    assert(taken.equal(.{ 2 }))
}

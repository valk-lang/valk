use valk.gc

class CloneBorrowNode {
    number: int (23)
    fn clone() SELF $clone { return SELF { number: this.number } }
}
struct CloneBorrowCell {
    number: int (31)
    fn clone() SELF $clone { return SELF { number: this.number } }
    fn increment() { this.number++ }
}
class CloneBorrowOwner {
    node: CloneBorrowNode (.{})
    maybe: ?CloneBorrowNode (null)
    cell: CloneBorrowCell (.{})
    maybe_cell: ?CloneBorrowCell (null)
}

struct CloneBorrowManagedCell {
    child: CloneBorrowNode
    fn clone() SELF $clone {
        gc.collect()
        return SELF { child: $clone(this.child) }
    }
}
class CloneBorrowManagedOwner { cell: ?CloneBorrowManagedCell (null) }

global clone_borrow_source_calls: uint (0)
fn clone_borrow_source() &CloneBorrowNode {
    clone_borrow_source_calls++
    return &CloneBorrowOwner {}.node
}

fn clone_borrow_node(value: &CloneBorrowNode) CloneBorrowNode { return $clone(value) }
fn clone_nullable_borrow_node(value: ?&CloneBorrowNode) ?CloneBorrowNode { return $clone(value) }
fn clone_nullable_pointee(value: &?CloneBorrowNode) ?CloneBorrowNode { return $clone(value) }
fn clone_nullable_slot(value: ?&?CloneBorrowNode) ?CloneBorrowNode { return $clone(value) }
fn clone_nested_borrow(value: local &CloneBorrowNode) CloneBorrowNode { return $clone(value) }
fn clone_borrow_cell(value: &CloneBorrowCell) CloneBorrowCell { return $clone(value) }
fn clone_raw_cell(value: *CloneBorrowCell) CloneBorrowCell { return $clone(value) }
fn clone_nullable_cell(value: &?CloneBorrowCell) ?CloneBorrowCell { return $clone(value) }
fn clone_nullable_borrow_cell(value: ?&CloneBorrowCell) ?CloneBorrowCell { return $clone(value) }

test "Clone: borrowed hooks read the stored object once" {
    let once = $clone(clone_borrow_source())
    assert(clone_borrow_source_calls == 1 && once.number == 23)
    let owner = CloneBorrowOwner {}
    let copied = clone_borrow_node(&owner.node)
    assert(copied != owner.node && copied.number == 23)
    owner.node.number = 29
    assert(copied.number == 23)
    let borrowed = &owner.node
    let nested = clone_nested_borrow(borrowed)
    assert(nested != owner.node && nested.number == 29)
    let temporary = clone_borrow_node(&CloneBorrowOwner {}.node)
    gc.collect()
    assert(temporary.number == 23)
    let published: shared CloneBorrowNode = clone_borrow_node(&owner.node)
    assert(published.number == 29)
}

test "Clone: nullable borrows guard every nullable layer" {
    assert(!isset(clone_nullable_borrow_node(null)))
    assert(!isset(clone_nullable_slot(null)))
    let owner = CloneBorrowOwner {}
    assert(!isset(clone_nullable_pointee(&owner.maybe)))
    assert(!isset(clone_nullable_slot(&owner.maybe)))
    let direct = clone_nullable_borrow_node(&owner.node)
    assert(isset(direct) && direct.number == 23)
    owner.maybe = CloneBorrowNode { number: 41 }
    let copied = clone_nullable_pointee(&owner.maybe)
    let nested = clone_nullable_slot(&owner.maybe)
    owner.maybe = null
    gc.collect()
    assert(isset(copied) && copied.number == 41)
    assert(isset(nested) && nested.number == 41)
}

test "Clone: borrowed and raw inline storage use struct hooks" {
    let owner = CloneBorrowOwner {}
    let borrowed = clone_borrow_cell(&owner.cell)
    let raw = clone_raw_cell(&owner.cell)
    owner.cell.number = 43
    assert(borrowed.number == 31 && raw.number == 31)
    assert(!isset(clone_nullable_cell(&owner.maybe_cell)))
    assert(!isset(clone_nullable_borrow_cell(null)))
    owner.maybe_cell = CloneBorrowCell { number: 47 }
    let optional = clone_nullable_cell(&owner.maybe_cell)
    let optional_borrow = clone_nullable_borrow_cell(&owner.cell)
    owner.maybe_cell = null
    assert(isset(optional) && optional.number == 47)
    assert(isset(optional_borrow) && optional_borrow.number == 43)
}

test "Nullable struct methods borrow the narrowed payload" {
    let cell: ?CloneBorrowCell = CloneBorrowCell {}
    if !isset(cell) : panic("missing cell")
    cell.increment()
    assert(cell.number == 32)
    let increment = cell.increment
    gc.collect()
    increment()
    assert(isset(cell) && cell.number == 33)
    let copied = increment.clone()
    copied()
    assert(isset(cell) && cell.number == 34)
}

test "Clone: nullable borrowed structs retain managed fields during the hook" {
    let original = CloneBorrowNode { number: 53 }
    let owner = CloneBorrowManagedOwner { cell: CloneBorrowManagedCell { child: original } }
    let copied = $clone(&owner.cell)
    owner.cell = null
    original.number = 59
    gc.collect()
    assert(isset(copied) && copied.child.number == 53)
    assert(isset(copied) && copied.child != original)
}

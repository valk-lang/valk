use valk.time
use valk.gc
use valk.thread

struct LinkNode {
    value: int
    next: ?Link[LinkNode] (null)
    other: ?Link[LinkNode] (null)
}

struct LinkGcItem {
    name: String
    items: Array[int]
    next: ?Link[LinkGcItem] (null)
}

class LinkHolder {
    first: ?Link[LinkNode] (null)
    second: Link[LinkNode]
}

fn link_or_none(nodes: Arena[LinkNode], want: bool, at: Link[LinkNode]) ?Link[LinkNode] {
    if want : return at
    return null
}

fn link_pair(at: Link[LinkNode]) (?Link[LinkNode], Link[LinkNode], ?Link[LinkNode]) {
    return (null, at, at)
}

union LinkChoice : Link[LinkNode] | int {
}

test "Link: takes no room beyond its number, also when nullable" {
    assert(size_of(Link[LinkNode]) == 4)
    assert(size_of(?Link[LinkNode]) == 4)
    assert(size_of(LinkNode) == 16)
    assert(size_of([?Link[LinkNode] x 3]) == 12)
}

test "Link: null, isset, fallback and narrowing" {
    let nodes = Arena[LinkNode]{}
    let a = nodes.add(LinkNode { value: 1 })
    let b = nodes.add(LinkNode { value: 2, next: a })

    assert(isset(nodes[b].next))
    assert(!isset(nodes[a].next))
    let none: ?Link[LinkNode] = null
    assert(!isset(none))
    let some: ?Link[LinkNode] = a
    assert(isset(some))
    assert(some == a)
    assert((none ?? b) == b)
    assert((some ?? b) == a)
    if isset(some) : assert(nodes[some].value == 1)

    // The first item is not null: its link is not all zero
    assert(a.index == 0)
    assert(isset(link_or_none(nodes, true, a)))
    assert(!isset(link_or_none(nodes, false, a)))

    let x, y, z = link_pair(a)
    assert(!isset(x) && isset(z) && y == a)
    let whole = link_pair(b)
    assert(!isset(whole[0]) && whole[1] == b)

    none = a
    assert(isset(none))
    none = null
    assert(!isset(none))
}

test "Link: compares by item" {
    let nodes = Arena[LinkNode]{}
    let a = nodes.add(LinkNode { value: 1 })
    let b = nodes.add(LinkNode { value: 1 })
    assert(a != b)
    assert(a == nodes.link(0))
    assert(b == nodes.link(1))
    assert(b.index == 1)
}

test "Link: zeroed storage reads as null everywhere it can live" {
    let zeroed = [?Link[LinkNode]]{ null x 8 }
    each zeroed as slot : assert(!isset(slot))
    let fixed: [?Link[LinkNode] x 4] = { null... }
    each fixed as slot : assert(!isset(slot))

    let nodes = Arena[LinkNode]{}
    let a = nodes.add(LinkNode { value: 1 })
    zeroed[3] = a
    fixed[2] = a
    assert(isset(zeroed[3]) && !isset(zeroed[2]) && !isset(zeroed[4]))
    assert(isset(fixed[2]) && !isset(fixed[1]) && !isset(fixed[3]))

    let list = Array[?Link[LinkNode]]{ a, null, a }
    assert(isset(list[0]) && !isset(list[1]) && isset(list[2]))
    list.append(null)
    assert(!isset(list[3]))

    let holder = LinkHolder { second: a }
    assert(!isset(holder.first))
    holder.first = a
    assert(isset(holder.first))
    assert(holder.second == a)

    let map = Map[?Link[LinkNode]]{}
    map.set("a", a)
    map.set("n", null)
    assert(isset(map.get("a") !? null))
    assert(!isset(map.get("n") !? a))
}

test "Link: unions, closures and coroutines carry it" {
    let nodes = Arena[LinkNode]{}
    let a = nodes.add(LinkNode { value: 41 })

    let choice: LinkChoice = a
    assert(match choice : int {
        Link[LinkNode] as link => nodes[link].value
        int as number => number
    } == 41)
    let wrapped: ?LinkChoice = null
    assert(!isset(wrapped))
    wrapped = choice
    assert(isset(wrapped))

    let some: ?Link[LinkNode] = a
    let none: ?Link[LinkNode] = null
    let read = fn() int {
        let found = some
        return (isset(found) ? nodes[found].value : 0) + (isset(none) ? 100 : 1)
    }
    assert(read() == 42)

    let later = co link_after_yield(nodes, some, none)
    assert(await later == 42)
}

fn link_after_yield(nodes: Arena[LinkNode], some: ?Link[LinkNode], none: ?Link[LinkNode]) int {
    time.sleep_ms(1)
    let found = some
    return (isset(found) ? nodes[found].value : 0) + (isset(none) ? 100 : 1)
}

test "Arena: reads, writes and borrows through links" {
    let nodes = Arena[LinkNode]{}
    let a = nodes.add(LinkNode { value: 1 })
    let b = nodes.add(LinkNode { value: 2 })

    let borrow = nodes.ref(a)
    borrow.value = 10
    borrow.next = b
    assert(nodes[a].value == 10)
    assert(nodes[a].next == b)
    borrow.next = null
    assert(!isset(nodes[a].next))

    nodes[b] = LinkNode { value: 20, other: a }
    assert(nodes[b].value == 20)
    assert(nodes[b].other == a)

    let copy = nodes[b]
    copy.value = 99
    assert(nodes[b].value == 20)
    assert(nodes.length == 2)
}

test "Arena: an item can link to itself" {
    let nodes = Arena[LinkNode]{}
    nodes.add(LinkNode { value: 1 })
    let me = nodes.next_link()
    let added = nodes.add(LinkNode { value: 2, next: me })
    assert(added == me)
    assert(nodes[added].next == added)
    assert(nodes[me].value == 2)
}

test "Arena: a borrow stays valid when the arena grows, on the old block" {
    let nodes = Arena[LinkNode]{}
    let a = nodes.add(LinkNode { value: 1 })
    let borrow = nodes.ref(a)
    each 0 .. 10000 as i : nodes.add(LinkNode { value: i.to(int) })
    assert(borrow.value == 1)
    assert(nodes[a].value == 1)
    assert(nodes[nodes.link(10000)].value == 9999)
}

test "Arena: many links, in order, across growth and clear" {
    let nodes = Arena[LinkNode].new(4)
    let last: ?Link[LinkNode] = null
    each 0 .. 100000 as i {
        last = nodes.add(LinkNode { value: i.to(int), next: last })
    }
    let total = 0
    let at = last
    while isset(at) {
        let node = nodes[at]
        total += node.value
        at = node.next
    }
    assert(total == 4999950000)
    assert(nodes.length == 100000)

    let seen = 0
    each nodes as node, index {
        assert(node.value == index.to(int))
        seen++
    }
    assert(seen == 100000)
    assert(nodes.view().length == 100000)

    nodes.clear()
    assert(nodes.length == 0)
    let again = nodes.add(LinkNode { value: 7 })
    assert(again.index == 0)
    assert(nodes[again].value == 7)
}

fn link_gc_arena() (Arena[LinkGcItem], Link[LinkGcItem]) {
    let items = Arena[LinkGcItem]{}
    let last: ?Link[LinkGcItem] = null
    each 0 .. 5000 as i {
        last = items.add(LinkGcItem { name: "item%i", items: Array[int]{ i.to(int) }, next: last })
        if i % 1000 == 0 : gc.collect()
    }
    return (items, last ?! panic("No items"))
}

test "Arena: items with references stay alive through collections" {
    let items, last = link_gc_arena()
    let garbage = Array[String]{}
    each 0 .. 50000 as i {
        garbage.append("garbage%i")
        if i % 1000 == 0 : garbage = Array[String]{}
    }
    gc.collect()
    gc.collect()
    let at: ?Link[LinkGcItem] = last
    let count = 4999
    while isset(at) {
        let item = items[at]
        assert(item.name == "item%count")
        assert(item.items[0] == count)
        count--
        at = item.next
    }
    assert(count == -1)

    // Stores after the arena is old, through both ways of writing
    gc.collect()
    let first = items.link(0)
    let borrow = items.ref(first)
    borrow.name = "changed" + 1
    borrow.items = Array[int]{ 55 }
    items[items.link(1)] = LinkGcItem { name: "replaced" + 2, items: Array[int]{ 66 } }
    gc.collect()
    gc.collect()
    assert(items[first].name == "changed1")
    assert(items[first].items[0] == 55)
    assert(items[items.link(1)].name == "replaced2")
    assert(items[items.link(1)].items[0] == 66)
}

test "Arena: separate threads and a published copy" {
    let workers = Array[thread.Thread[int]]{}
    each 0 .. 4 {
        workers.append(thread.Thread[int].start(fn() int {
            let nodes = Arena[LinkNode]{}
            let last: ?Link[LinkNode] = null
            each 0 .. 20000 as i : last = nodes.add(LinkNode { value: i.to(int), next: last })
            let total = 0
            while isset(last) {
                let node = nodes[last]
                total += node.value
                last = node.next
            }
            return total
        }) !!)
    }
    each workers as worker : assert(worker.await() == 199990000)

    let nodes = Arena[LinkNode]{}
    let a = nodes.add(LinkNode { value: 3 })
    let published: atomic Arena[LinkNode] = nodes
    nodes.ref(a).value = 4
    assert(published.length == 1)
    assert(nodes[a].value == 4)
}

use valk.gc
use valk.time
use valk.json
use valk.core

// Ways an object made in a function could outlive the region the compiler gives it: every
// scenario gives the answer it gives without regions. Debug builds also overwrite what a
// region gives up, and the collector refuses an object of its own that refers into a region

class Ra1Node {
    value: int (0)
    next: ?Ra1Node (null)
}

class Ra1Pair {
    a: ?Ra1Node (null)
    b: ?Ra1Node (null)
}

class Ra1Slots {
    items: [?Ra1Node x 4] (@undefined)
    count: int (0)
}

global ra1_kept: ?Ra1Node (null)
global ra1_kept_list: Array[Ra1Node] (.{})

fn ra1_garbage() $noinline {
    let junk = Array[Ra1Node]{}
    each 0 .. 300 as i : junk.append(Ra1Node { value: i.to(int) })
    gc.collect()
    gc.collect()
}

fn ra1_call(cb: fn()()) $noinline { cb() }
fn ra1_call_with(cb: fn(Ra1Node)(), node: Ra1Node) $noinline { cb(node) }

// 1. A closure writes a variable it captured
fn ra1_closure_assigns() int {
    let keep = Ra1Pair {}
    let cb = fn() { keep.a = Ra1Node { value: 11 } }
    ra1_call(cb)
    ra1_garbage()
    let k = keep.a
    return isset(k) ? k.value : -1
}

// 2. A closure appends to a list it captured
fn ra1_closure_appends() int {
    let list = Array[Ra1Node]{}
    let cb = fn() { list.append(Ra1Node { value: 12 }) }
    ra1_call(cb)
    ra1_call(cb)
    ra1_garbage()
    return list[0].value + list[1].value
}

// 3. A closure links what it is given into what it captured
fn ra1_closure_links() int {
    let head = Ra1Node { value: 1 }
    let cb = fn(node: Ra1Node) { head.next = node }
    ra1_call_with(cb, Ra1Node { value: 13 })
    ra1_garbage()
    let n = head.next
    return isset(n) ? n.value : -1
}

// 4. A defer stores what was made before it runs
fn ra1_deferred(out: Ra1Pair) {
    let node = Ra1Node { value: 14 }
    defer { out.a = node }
    ra1_garbage()
}
fn ra1_deferred_use() int {
    let out = Ra1Pair {}
    ra1_deferred(out)
    ra1_garbage()
    let a = out.a
    return isset(a) ? a.value : -1
}

fn ra1_next_of(node: ?Ra1Node) ?Ra1Node $noinline {
    if !isset(node) : return null
    if node.value >= 5 : return null
    return Ra1Node { value: node.value + 1 }
}

// 5. The test of a loop makes the object its body uses
fn ra1_loop_test_makes() int {
    let sum = 0
    let at: ?Ra1Node = Ra1Node { value: 0 }
    while true {
        let n = ra1_next_of(at) ?! break
        ra1_garbage()
        sum += n.value
        at = n
    }
    return sum
}

fn ra1_made_in_test(i: int) ?Ra1Node $noinline {
    if i > 6 : return null
    return Ra1Node { value: i }
}

// 6. The test of a loop makes an object every round
fn ra1_value_of(node: ?Ra1Node) int $noinline {
    ra1_garbage()
    return isset(node) ? node.value : -1
}
fn ra1_loop_cond_object() int {
    let sum = 0
    let i = 0
    while ra1_value_of(ra1_made_in_test(i)) >= 0 {
        let node = ra1_made_in_test(i)
        ra1_garbage()
        if isset(node) : sum += node.value
        i++
    }
    return sum
}

// 7. A round's object survives through a variable of the function
fn ra1_loop_keeps_last() int {
    let last: ?Ra1Node = null
    let i = 0
    let sum = 0
    while i++ < 6 {
        let node = Ra1Node { value: i }
        let l = last
        if isset(l) : sum += l.value
        ra1_garbage()
        last = node
    }
    return sum
}

// 8. A break carries an object out
fn ra1_loop_breaks_with() int {
    let found: ?Ra1Node = null
    let i = 0
    while i++ < 10 {
        let node = Ra1Node { value: i * 3 }
        if i == 4 {
            found = node
            break
        }
    }
    ra1_garbage()
    let f = found
    return isset(f) ? f.value : -1
}

// 9. A local inline array of references copied into an object of the caller
fn ra1_fill_slots(slots: Ra1Slots) {
    let tmp: [?Ra1Node x 4] = @undefined
    tmp[0] = Ra1Node { value: 15 }
    tmp[1] = Ra1Node { value: 16 }
    tmp[2] = null
    tmp[3] = null
    slots.items = tmp
    slots.count = 2
}
fn ra1_slots_use() int {
    let slots = Ra1Slots {}
    ra1_fill_slots(slots)
    ra1_garbage()
    let a = slots.items[0]
    let b = slots.items[1]
    return (isset(a) ? a.value : -1) + (isset(b) ? b.value : -1)
}

// 10. Ra1Slots ra1_kept by a global
global ra1_kept_slots: ?Ra1Slots (null)
fn ra1_slots_global() int {
    let slots = Ra1Slots {}
    ra1_kept_slots = slots
    ra1_fill_slots(slots)
    ra1_garbage()
    let a = slots.items[0]
    return isset(a) ? a.value : -1
}

// 11. Written through a pointer to a variable of the caller
fn ra1_write_out(out: *?Ra1Node) {
    @unsafe
    @ptrv(out, ?Ra1Node) = Ra1Node { value: 17 }
}
fn ra1_out_param() int {
    @unsafe
    let n: ?Ra1Node = null
    ra1_write_out(@ref(n))
    ra1_garbage()
    let k = n
    return isset(k) ? k.value : -1
}

// 12. A function value that keeps its argument
fn ra1_keeper(node: Ra1Node) { ra1_kept = node }
fn ra1_through_function_value() int {
    let f = ra1_keeper
    ra1_call_with(f, Ra1Node { value: 18 })
    ra1_garbage()
    let k = ra1_kept
    return isset(k) ? k.value : -1
}

// 13. Kept two calls deep, in a list of a global
fn ra1_keep_deep2(node: Ra1Node) $noinline { ra1_kept_list.append(node) }
fn ra1_keep_deep1(node: Ra1Node) $noinline { ra1_keep_deep2(node) }
fn ra1_kept_deep() int {
    ra1_keep_deep1(Ra1Node { value: 19 })
    ra1_garbage()
    return ra1_kept_list[ra1_kept_list.length - 1].value
}

// 14. One of many is returned
fn ra1_pick(count: int) Ra1Node {
    let list = Array[Ra1Node]{}
    let i = 0
    while i++ < count : list.append(Ra1Node { value: i })
    ra1_garbage()
    return list[count / 2]
}
fn ra1_picked() int {
    let node = ra1_pick(8)
    ra1_garbage()
    return node.value
}

test "Regions audit: closures, loops, inline arrays, out-parameters and function values" {
    assert(ra1_closure_assigns() == 11)
    assert(ra1_closure_appends() == 24)
    assert(ra1_closure_links() == 13)
    assert(ra1_deferred_use() == 14)
    assert(ra1_loop_test_makes() == 15)
    assert(ra1_loop_cond_object() == 21)
    assert(ra1_loop_keeps_last() == 15)
    assert(ra1_loop_breaks_with() == 12)
    assert(ra1_slots_use() == 31)
    assert(ra1_slots_global() == 15)
    assert(ra1_out_param() == 17)
    assert(ra1_through_function_value() == 18)
    assert(ra1_kept_deep() == 19)
    assert(ra1_picked() == 5)
}

class Ra2Node {
    value: int (0)
    next: ?Ra2Node (null)
    name: String ("")
}

class Ra2Box {
    node: ?Ra2Node (null)
    text: String ("")
    list: Array[Ra2Node] (.{})
    map: HashMap[String, Ra2Node] (.{})
}

struct Ra2Two {
    a: ?Ra2Node (null)
    b: ?Ra2Node (null)
}

class Ra2Holder {
    two: Ra2Two (.{})
    any: ?Ra2Shape (null)
    item: Ra2Item (0)
}

interface Ra2Shape { fn area() int; fn keep(box: Ra2Box); }

class Ra2Square is Ra2Shape {
    side: Ra2Node (.{})
    fn area() int { return this.side.value * this.side.value }
    fn keep(box: Ra2Box) { box.node = this.side }
}

union Ra2Item : Ra2Node | String | int {}

global ra2_kept_box: Ra2Box (.{})
global ra2_kept_shape: ?Ra2Shape (null)

fn ra2_garbage() $noinline {
    let junk = Array[Ra2Node]{}
    each 0 .. 300 as i : junk.append(Ra2Node { value: i.to(int) })
    gc.collect()
    gc.collect()
}

// 1. An object behind an interface keeps a part of itself in what it is given
fn ra2_shape_keeps(box: Ra2Box) $noinline {
    let shape: Ra2Shape = Ra2Square { side: Ra2Node { value: 21 } }
    shape.keep(box)
}
fn ra2_interface_keeps() int {
    let box = Ra2Box {}
    ra2_shape_keeps(box)
    ra2_garbage()
    let n = box.node
    return isset(n) ? n.value : -1
}

// 2. An interface value stored in a global
fn ra2_interface_global() int {
    let sq = Ra2Square { side: Ra2Node { value: 5 } }
    ra2_kept_shape = sq
    ra2_garbage()
    let s = ra2_kept_shape
    return isset(s) ? s.area() : -1
}

// 3. A struct value with references returned and stored
fn ra2_make_two(n: int) Ra2Two $noinline {
    return Ra2Two { a: Ra2Node { value: n }, b: Ra2Node { value: n + 1 } }
}
fn ra2_struct_stored(holder: Ra2Holder) $noinline {
    holder.two = ra2_make_two(22)
}
fn ra2_struct_use() int {
    let holder = Ra2Holder {}
    ra2_struct_stored(holder)
    ra2_garbage()
    let a = holder.two.a
    let b = holder.two.b
    return (isset(a) ? a.value : -1) + (isset(b) ? b.value : -1)
}

// 4. A tuple of objects, one kept and one dropped
fn ra2_make_pair(n: int) (Ra2Node, Ra2Node) $noinline {
    return (Ra2Node { value: n }, Ra2Node { value: n * 2 })
}
fn ra2_tuple_keeps(box: Ra2Box) int $noinline {
    let a, b = ra2_make_pair(23)
    box.node = b
    return a.value
}
fn ra2_tuple_use() int {
    let box = Ra2Box {}
    let first = ra2_tuple_keeps(box)
    ra2_garbage()
    let n = box.node
    return first + (isset(n) ? n.value : -1)
}

// 5. A view of text built here, kept by the caller's object
fn ra2_view_kept(box: Ra2Box, n: int) $noinline {
    let text = "number " + n + " of many"
    box.text = text.range(7, 2)
}
fn ra2_view_use() String {
    let box = Ra2Box {}
    ra2_view_kept(box, 24)
    ra2_garbage()
    return box.text
}

// 6. Views of text that is dropped while the views live on
fn ra2_joined(n: int) String $noinline { return "a" + n + ",b" + n + ",c" + n }
fn ra2_views_outlive() int {
    let parts = ra2_joined(25).split(",")
    ra2_garbage()
    let total = 0
    each parts as part : total += part.length.to(int)
    return total * 100 + parts.length.to(int)
}

// 7. A map filled here, one value of it returned
fn ra2_map_pick(n: int) Ra2Node $noinline {
    let map = HashMap[String, Ra2Node]{}
    let i = 0
    while i++ < n : map.set("k" + i, Ra2Node { value: i })
    ra2_garbage()
    return map.get("k3") !? Ra2Node { value: -1 }
}
fn ra2_map_use() int {
    let node = ra2_map_pick(6)
    ra2_garbage()
    return node.value
}

// 8. A union that holds an object, stored in the caller's object
fn ra2_union_stored(holder: Ra2Holder, n: int) $noinline {
    let item: Ra2Item = Ra2Node { value: n }
    holder.item = item
}
fn ra2_union_use() int {
    let holder = Ra2Holder {}
    ra2_union_stored(holder, 26)
    ra2_garbage()
    return match holder.item : int {
        Ra2Node as node => node.value
        default => -1
    }
}

// 9. A method that puts its object into what it is given
class Ra2Linker {
    node: Ra2Node (.{})
    fn attach(box: Ra2Box) $noinline { box.list.append(this.node) }
}
fn ra2_method_attaches(box: Ra2Box) $noinline {
    let linker = Ra2Linker { node: Ra2Node { value: 27 } }
    linker.attach(box)
}
fn ra2_method_use() int {
    let box = Ra2Box {}
    ra2_method_attaches(box)
    ra2_garbage()
    return box.list[0].value
}

// 10. A part of a decoded document is returned
fn ra2_doc_part(n: int) String $noinline {
    let doc = json.decode("{\"name\": \"item " + n + "\", \"tags\": [\"x\", \"y\"]}") ! return "bad"
    return doc["name"].string
}
fn ra2_doc_use() String {
    let name = ra2_doc_part(28)
    ra2_garbage()
    return name
}

// 11. An object handed to a coroutine
fn ra2_co_reads(node: Ra2Node) int {
    ra2_garbage()
    return node.value
}
fn ra2_threaded() int {
    let node = Ra2Node { value: 29 }
    let task = co ra2_co_reads(node)
    ra2_garbage()
    return await task
}

// 12. A copy of an object made here, kept by a global
fn ra2_clone_kept() int {
    let node = Ra2Node { value: 30, name: "thirty " + 30 }
    ra2_kept_box.node = core.clone_value(node)
    ra2_garbage()
    let n = ra2_kept_box.node
    return isset(n) ? n.value + n.name.length.to(int) : -1
}

// 13. Recursion that returns an object from the ra2_middle of what it built
fn ra2_build(depth: int, want: int) Ra2Node $noinline {
    let node = Ra2Node { value: depth }
    if depth == 0 : return node
    let below = ra2_build(depth - 1, want)
    node.next = below
    if depth == want : return node
    return below.value == want ? below : node
}
fn ra2_middle() int {
    let node = ra2_build(6, 3)
    ra2_garbage()
    let n = node.next
    return node.value * 10 + (isset(n) ? n.value : 0)
}

// 14. A list that is filled and emptied every round, one object leaves
fn ra2_rounds_leak(box: Ra2Box) int $noinline {
    let list = Array[Ra2Node]{}
    let i = 0
    let sum = 0
    while i++ < 6 {
        list.append(Ra2Node { value: i })
        list.append(Ra2Node { value: i * 2 })
        if i == 4 : box.node = list[1]
        sum += list.length.to(int)
        list.clear()
    }
    return sum
}
fn ra2_rounds_use() int {
    let box = Ra2Box {}
    let sum = ra2_rounds_leak(box)
    ra2_garbage()
    let n = box.node
    return sum + (isset(n) ? n.value : -1)
}

test "Regions audit: interfaces, struct values, tuples, views, maps, unions and coroutines" {
    assert(ra2_interface_keeps() == 21)
    assert(ra2_interface_global() == 25)
    assert(ra2_struct_use() == 45)
    assert(ra2_tuple_use() == 69)
    assert(ra2_view_use() == "24")
    assert(ra2_views_outlive() == 903)
    assert(ra2_map_use() == 3)
    assert(ra2_union_use() == 26)
    assert(ra2_method_use() == 27)
    assert(ra2_doc_use() == "item 28")
    assert(ra2_threaded() == 29)
    assert(ra2_clone_kept() == 39)
    assert(ra2_middle() == 32)
    assert(ra2_rounds_use() == 20)
}

class Ra3Node {
    value: int (0)
    next: ?Ra3Node (null)
    name: String ("")
}

class Ra3Box {
    node: ?Ra3Node (null)
    list: Array[Ra3Node] (.{})
    names: Array[String] (.{})
}

error Ra3Failed (bad) payload {
    node: ?Ra3Node (null)
    text: String ("")
}

global ra3_kept: ?Ra3Node (null)

fn ra3_garbage() $noinline {
    let junk = Array[Ra3Node]{}
    each 0 .. 300 as i : junk.append(Ra3Node { value: i.to(int) })
    gc.collect()
    gc.collect()
}

// 1. An error leaves a loop whose rounds have a region; the handler reads what was thrown
fn ra3_fails_at(i: int, at: int) Ra3Node !Ra3Failed $noinline {
    let node = Ra3Node { value: i, name: "n" + i }
    if i == at : throw .bad { node: node, text: "failed at " + i }
    return node
}
fn ra3_loop_throws(at: int) int !Ra3Failed $noinline {
    let sum = 0
    let i = 0
    while i++ < 10 {
        let node = ra3_fails_at(i, at) !>
        let other = Ra3Node { value: node.value * 2 }
        sum += other.value
    }
    return sum
}
fn ra3_error_from_loop() int {
    let got = 0
    let sum = ra3_loop_throws(5) ! {
        ra3_garbage()
        let node = E.node
        got = (isset(node) ? node.value : -1) + E.text.length.to(int)
        return got
    }
    return sum
}

// 2. A handler gives a ra3_fallback object that is ra3_kept
fn ra3_fallback(box: Ra3Box, at: int) $noinline {
    let node = ra3_fails_at(3, at) !? Ra3Node { value: 31 }
    box.node = node
}
fn ra3_fallback_use() int {
    let a = Ra3Box {}
    let b = Ra3Box {}
    ra3_fallback(a, 3)
    ra3_fallback(b, 4)
    ra3_garbage()
    let x = a.node
    let y = b.node
    return (isset(x) ? x.value : -1) * 100 + (isset(y) ? y.value : -1)
}

// 3. A value scope and a match give objects made inside them
fn ra3_scoped(box: Ra3Box, n: int) $noinline {
    let node = <{
        let inner = Ra3Node { value: n }
        if n > 100 : return Ra3Node { value: 0 }
        return inner
    }
    let other = match n : Ra3Node {
        32 => Ra3Node { value: 1 }
        default => Ra3Node { value: 2 }
    }
    box.list.append(node)
    box.node = other
}
fn ra3_scoped_use() int {
    let box = Ra3Box {}
    ra3_scoped(box, 32)
    ra3_garbage()
    let n = box.node
    return box.list[0].value + (isset(n) ? n.value : -1)
}

// 4. Nested loops: an object of an inner round is ra3_kept by an object of the outer round,
// and one outer object is ra3_kept by the caller
fn ra3_nested(box: Ra3Box) int $noinline {
    let sum = 0
    let i = 0
    while i++ < 5 {
        let outer = Ra3Node { value: i }
        let j = 0
        while j++ < 4 {
            let inner = Ra3Node { value: i * 10 + j }
            if j == 2 : outer.next = inner
            sum += inner.value
        }
        ra3_garbage()
        let n = outer.next
        if isset(n) : sum += n.value
        if i == 3 : box.node = outer
    }
    return sum
}
fn ra3_nested_use() int {
    let box = Ra3Box {}
    let sum = ra3_nested(box)
    ra3_garbage()
    let n = box.node
    let m = isset(n) ? n.next : null
    return sum + (isset(n) ? n.value : -1) + (isset(m) ? m.value : -1)
}

// 5. `continue` and ra3_early `return` inside a loop with a region
fn ra3_early(limit: int) ?Ra3Node $noinline {
    let i = 0
    while i++ < 20 {
        let node = Ra3Node { value: i }
        if i % 2 == 0 : continue
        let twice = Ra3Node { value: node.value * 2 }
        if twice.value > limit : return twice
    }
    return null
}
fn ra3_early_use() int {
    let node = ra3_early(11)
    ra3_garbage()
    return isset(node) ? node.value : -1
}

// 6. A region that grows far beyond its first chunk, every round
fn ra3_big_rounds() int {
    let sum = 0
    let round = 0
    while round++ < 4 {
        let list = Array[Ra3Node]{}
        let i = 0
        while i++ < 20000 : list.append(Ra3Node { value: i, name: "x" })
        sum += list[list.length - 1].value + list.length.to(int)
        let wide = Array[int].new(300000)
        wide.append(round)
        sum += wide[0]
    }
    ra3_garbage()
    return sum
}

// 7. Deep recursion: every frame has a region
fn ra3_deep(n: int) int $noinline {
    let node = Ra3Node { value: n }
    if n == 0 : return node.value
    let below = ra3_deep(n - 1)
    return below + node.value
}
fn ra3_deep_use() int { return ra3_deep(2000) }

// 8. Text collected in the caller's list, built from pieces made here
fn ra3_names_into(box: Ra3Box, count: int) $noinline {
    let i = 0
    while i++ < count {
        let parts = Array[String]{}
        parts.append("item")
        parts.append(i.to(String))
        parts.append("of " + count)
        box.names.append(parts.join(" "))
    }
}
fn ra3_names_use() int {
    let box = Ra3Box {}
    ra3_names_into(box, 5)
    ra3_garbage()
    let total = 0
    each box.names as name : total += name.length.to(int)
    return total
}

// 9. Sorting objects made here by a closure, the ra3_smallest is ra3_kept
fn ra3_smallest(box: Ra3Box) $noinline {
    let list = Array[Ra3Node]{}
    let i = 0
    while i++ < 9 : list.append(Ra3Node { value: (i * 7) % 10 })
    list.sort(fn(a: Ra3Node, b: Ra3Node) bool { return a.value < b.value })
    box.node = list[0]
}
fn ra3_smallest_use() int {
    let box = Ra3Box {}
    ra3_smallest(box)
    ra3_garbage()
    let n = box.node
    return isset(n) ? n.value : -1
}

// 10. Removing while iterating, what is left goes to the caller
fn ra3_filtered(box: Ra3Box) $noinline {
    let list = Array[Ra3Node]{}
    let i = 0
    while i++ < 8 : list.append(Ra3Node { value: i })
    each list as node, at {
        if node.value % 2 == 0 : list.remove(at)
    }
    each list as node : box.list.append(node)
}
fn ra3_filtered_use() int {
    let box = Ra3Box {}
    ra3_filtered(box)
    ra3_garbage()
    let sum = 0
    each box.list as node : sum += node.value
    return sum * 10 + box.list.length.to(int)
}

// 11. An object ra3_kept through `??` and `?:`
fn ra3_chosen(box: Ra3Box, n: int) $noinline {
    let a: ?Ra3Node = n > 0 ? Ra3Node { value: n } : null
    let b = a ?? Ra3Node { value: 99 }
    box.node = n % 2 == 0 ? b : Ra3Node { value: n + 1 }
}
fn ra3_chosen_use() int {
    let a = Ra3Box {}
    let b = Ra3Box {}
    ra3_chosen(a, 34)
    ra3_chosen(b, 35)
    ra3_garbage()
    let x = a.node
    let y = b.node
    return (isset(x) ? x.value : -1) * 100 + (isset(y) ? y.value : -1)
}

// 12. The global takes an object from the middle of a chain made here
fn ra3_chain_global() int {
    let head = Ra3Node { value: 1 }
    let at = head
    let i = 1
    while i++ < 6 {
        let next = Ra3Node { value: i }
        at.next = next
        at = next
    }
    let mid = head.next
    if isset(mid) : ra3_kept = mid.next
    ra3_garbage()
    let k = ra3_kept
    let n = isset(k) ? k.next : null
    return (isset(k) ? k.value : -1) * 10 + (isset(n) ? n.value : -1)
}

test "Regions audit: errors, value scopes, nested loops, early exits and big regions" {
    assert(ra3_error_from_loop() == 16)
    assert(ra3_fallback_use() == 3103)
    assert(ra3_scoped_use() == 33)
    assert(ra3_nested_use() == 845)
    assert(ra3_early_use() == 14)
    assert(ra3_big_rounds() == 160010)
    assert(ra3_deep_use() == 2001000)
    assert(ra3_names_use() == 55)
    assert(ra3_smallest_use() == 9)
    assert(ra3_filtered_use() == 164)
    assert(ra3_chosen_use() == 3436)
    assert(ra3_chain_global() == 34)
}

class Ra4Node {
    value: int (0)
    next: ?Ra4Node (null)
}

class Ra4Bag {
    items: Array[Ra4Node] (.{})
    last: ?Ra4Node (null)
    inner: ?Ra4Bag (null)
}

global ra4_kept_bag: Ra4Bag (.{})

fn ra4_garbage() $noinline {
    let junk = Array[Ra4Node]{}
    each 0 .. 300 as i : junk.append(Ra4Node { value: i.to(int) })
    gc.collect()
    gc.collect()
}

fn ra4_sum_of(list: Array[Ra4Node]) int {
    let sum = 0
    each list as node : sum += node.value
    return sum
}

// 1. A round's object reaches an outer list through another name for it
fn ra4_alias_append() int {
    let outer = Array[Ra4Node]{}
    let i = 0
    while i++ < 6 {
        let alias = outer
        let node = Ra4Node { value: i }
        if i % 2 == 0 : alias.append(node)
        ra4_garbage()
    }
    return ra4_sum_of(outer)
}

// 2. Through a name that is the outer list only in some rounds
fn ra4_sometimes_outer() int {
    let outer = Array[Ra4Node]{}
    let i = 0
    let sum = 0
    while i++ < 6 {
        let inner = Array[Ra4Node]{}
        let target = i % 3 == 0 ? outer : inner
        target.append(Ra4Node { value: i })
        ra4_garbage()
        sum += ra4_sum_of(inner)
    }
    return sum * 100 + ra4_sum_of(outer)
}

fn ra4_put(bag: Ra4Bag, node: Ra4Node) $noinline { bag.items.append(node) }
fn ra4_put_last(bag: Ra4Bag, node: Ra4Node) $noinline { bag.last = node }
fn ra4_move_all(from: Ra4Bag, to: Ra4Bag) $noinline {
    each from.items as node : to.items.append(node)
    from.items.clear()
}

// 3. A callee moves a round's objects from a round's bag into an outer bag
fn ra4_moved_out() int {
    let outer = Ra4Bag {}
    let i = 0
    while i++ < 5 {
        let bag = Ra4Bag {}
        ra4_put(bag, Ra4Node { value: i })
        ra4_put(bag, Ra4Node { value: i * 10 })
        if i == 3 : ra4_move_all(bag, outer)
        ra4_garbage()
    }
    return ra4_sum_of(outer.items)
}

// 4. A round's bag is hung into an outer bag
fn ra4_bag_in_bag() int {
    let outer = Ra4Bag {}
    let i = 0
    while i++ < 5 {
        let bag = Ra4Bag {}
        ra4_put_last(bag, Ra4Node { value: i })
        if i == 4 : outer.inner = bag
        ra4_garbage()
    }
    let inner = outer.inner
    let last = isset(inner) ? inner.last : null
    return isset(last) ? last.value : -1
}

// 5. The object of a round is the `last` of the bag of the round before
fn ra4_across_rounds() int {
    let prev: ?Ra4Bag = null
    let i = 0
    let sum = 0
    while i++ < 6 {
        let bag = Ra4Bag {}
        let node = Ra4Node { value: i }
        let p = prev
        if isset(p) {
            ra4_put_last(p, node)
            ra4_garbage()
            let l = p.last
            if isset(l) : sum += l.value
        }
        prev = bag
    }
    return sum
}

// 6. A list that is cleared every round, but one round keeps an object in a global
fn ra4_cleared_but_kept() int {
    let list = Array[Ra4Node]{}
    let i = 0
    let sum = 0
    while i++ < 6 {
        list.append(Ra4Node { value: i })
        list.append(Ra4Node { value: i + 100 })
        if i == 5 : ra4_kept_bag.last = list[0]
        sum += list.length.to(int)
        list.clear()
        ra4_garbage()
    }
    let l = ra4_kept_bag.last
    return sum * 100 + (isset(l) ? l.value : -1)
}

// 7. A chain grown at the front every round, read after the loop
fn ra4_front_grown() int {
    let head: ?Ra4Node = null
    let i = 0
    while i++ < 6 {
        head = Ra4Node { value: i, next: head }
        ra4_garbage()
    }
    let sum = 0
    let at = head
    while true {
        let node = at ?! break
        sum = sum * 10 + node.value
        at = node.next
    }
    return sum
}

// 8. Two lists swap every round; what was appended two rounds ago is read
fn ra4_swapped() int {
    let a = Array[Ra4Node]{}
    let b = Array[Ra4Node]{}
    let i = 0
    let sum = 0
    while i++ < 6 {
        a.append(Ra4Node { value: i })
        ra4_garbage()
        let t = a
        a = b
        b = t
        if a.length > 0 : sum += a[a.length - 1].value
    }
    return sum * 100 + a.length.to(int) * 10 + b.length.to(int)
}

// 9. The inner loop's object is kept by the outer loop's list, which a later round reads
fn ra4_inner_to_outer() int {
    let sum = 0
    let i = 0
    let all = Array[Array[Ra4Node]]{}
    while i++ < 4 {
        let row = Array[Ra4Node]{}
        let j = 0
        while j++ < 3 {
            row.append(Ra4Node { value: i * 10 + j })
        }
        all.append(row)
        ra4_garbage()
        if all.length > 1 : sum += all[all.length - 2][2].value
    }
    return sum
}

// 10. A recursion inside a loop returns an object of an earlier call of this round
fn ra4_nth(node: Ra4Node, n: int) Ra4Node $noinline {
    if n == 0 : return node
    let next = Ra4Node { value: node.value + 1 }
    node.next = next
    return ra4_nth(next, n - 1)
}
fn ra4_recursion_in_loop() int {
    let sum = 0
    let i = 0
    let keep: ?Ra4Node = null
    while i++ < 5 {
        let end = ra4_nth(Ra4Node { value: i * 100 }, 3)
        ra4_garbage()
        sum += end.value
        if i == 2 : keep = end
    }
    let k = keep
    return sum + (isset(k) ? k.value : -1)
}

test "Regions audit: loops with other names for a list, moves between lists and rounds that share objects" {
    assert(ra4_alias_append() == 12)
    assert(ra4_sometimes_outer() == 1209)
    assert(ra4_moved_out() == 33)
    assert(ra4_bag_in_bag() == 4)
    assert(ra4_across_rounds() == 20)
    assert(ra4_cleared_but_kept() == 1205)
    assert(ra4_front_grown() == 654321)
    assert(ra4_swapped() == 1533)
    assert(ra4_inner_to_outer() == 69)
    assert(ra4_recursion_in_loop() == 1718)
}

class Ra5Node {
    value: int (0)
    next: ?Ra5Node (null)
}

class Ra5Box {
    node: ?Ra5Node (null)
    list: Array[Ra5Node] (.{})
    text: String ("")
    numbers: Array[int] (.{})
    names: Array[String] (.{})
}

global ra5_kept_text: String ("")
global ra5_kept_names: Array[String] (.{})
global ra5_kept_numbers: Array[int] (.{})
global ra5_shared_buf: ByteBuffer (ByteBuffer.new(64))

fn ra5_garbage() $noinline {
    let junk = Array[Ra5Node]{}
    each 0 .. 300 as i : junk.append(Ra5Node { value: i.to(int) })
    gc.collect()
    gc.collect()
}

// 1. A buffer written in a loop, returned as text
fn ra5_built(n: int) String $noinline {
    let buf = ByteBuffer.new()
    let i = 0
    while i++ < n {
        buf.write("ab")
        buf.write(i.to(String))
    }
    return buf.into_string()
}
fn ra5_built_use() int {
    let text = ra5_built(40)
    ra5_garbage()
    return text.length.to(int)
}

// 2. The same, kept by a global
fn ra5_built_kept() int {
    ra5_kept_text = ra5_built(30)
    ra5_garbage()
    return ra5_kept_text.length.to(int)
}

// 3. Results of a builder collected by a loop, in a list the caller keeps
fn ra5_built_many(box: Ra5Box, n: int) $noinline {
    let i = 0
    while i++ < n : box.names.append(ra5_built(i))
}
fn ra5_built_many_use() int {
    let box = Ra5Box {}
    ra5_built_many(box, 12)
    ra5_garbage()
    let total = 0
    each box.names as name : total += name.length.to(int)
    return total
}

// 4. A box made before the loop gets a new object every round: all but the last are let go
fn ra5_replaced(n: int) Ra5Box $noinline {
    let box = Ra5Box {}
    let i = 0
    while i++ < n {
        box.node = Ra5Node { value: i }
        ra5_garbage()
    }
    return box
}
fn ra5_replaced_use() int {
    let box = ra5_replaced(5)
    ra5_garbage()
    let node = box.node
    return isset(node) ? node.value : -1
}

// 5. A list made before the loop is filled and emptied every round
fn ra5_refilled(n: int) int $noinline {
    let list = Array[Ra5Node]{}
    let sum = 0
    let i = 0
    while i++ < n {
        list.append(Ra5Node { value: i })
        list.append(Ra5Node { value: i * 2 })
        sum += list[1].value
        list.clear()
    }
    return sum
}

// 6. Text copied into a buffer that a global keeps: the text itself may go
fn ra5_copied_out(n: int) $noinline {
    let text = "copy " + n + " of the text"
    ra5_shared_buf.clear()
    ra5_shared_buf.write(text)
}
fn ra5_copied_out_use() int {
    ra5_copied_out(51)
    ra5_garbage()
    return ra5_shared_buf.to_string().length.to(int)
}

// 7. Numbers copied in one block into a list a global keeps
fn ra5_numbers_out(n: int) $noinline {
    let list = Array[int]{}
    let i = 0
    while i++ < n : list.append(i * 3)
    ra5_kept_numbers.append_many(list)
}
fn ra5_numbers_use() int {
    ra5_numbers_out(20)
    ra5_garbage()
    let sum = 0
    each ra5_kept_numbers as v : sum += v
    return sum
}

// 8. Pieces of text that is given: the joined text is new, the ra5_pieces are views that are kept
fn ra5_pieces(box: Ra5Box, text: String) uint $noinline {
    let parts = text.split(",")
    let joined = parts.join("-")
    box.names.append(parts[1])
    return joined.length
}
fn ra5_pieces_use() int {
    let box = Ra5Box {}
    let n = ra5_pieces(box, "ab,cde,f," + 52)
    ra5_garbage()
    return n.to(int) * 100 + box.names[0].length.to(int)
}

// 9. References copied as bytes into storage a global keeps
fn ra5_refs_out(box: Ra5Box) $noinline {
    @unsafe
    let list = Array[Ra5Node]{}
    list.append(Ra5Node { value: 53 })
    list.append(Ra5Node { value: 54 })
    box.list.append(list[0])
    box.list.append(list[1])
}
fn ra5_refs_use() int {
    let box = Ra5Box {}
    ra5_refs_out(box)
    ra5_garbage()
    return box.list[0].value + box.list[1].value
}

// 10. A number as text, ra5_built in a loop into a list that stays
fn ra5_digits(n: int) int $noinline {
    let texts = Array[String].new()
    let i = 0
    while i++ < n : texts.append(i.to(String))
    ra5_garbage()
    let total = 0
    each texts as t : total += t.length.to(int)
    return total
}

test "Regions audit: buffers written in loops, copies of plain bytes and holders made before a loop" {
    assert(ra5_built_use() == 151)
    assert(ra5_built_kept() == 111)
    assert(ra5_built_many_use() == 240)
    assert(ra5_replaced_use() == 5)
    assert(ra5_refilled(6) == 42)
    assert(ra5_copied_out_use() == 19)
    assert(ra5_numbers_use() == 630)
    assert(ra5_pieces_use() == 1103)
    assert(ra5_refs_use() == 107)
    assert(ra5_digits(120) == 252)
}

class Ra6Node {
    value: int (0)
    next: ?Ra6Node (null)
}

class Ra6Holder {
    text: String ("")
    node: ?Ra6Node (null)
    list: Array[Ra6Node] (.{})
}

global ra6_kept: ?Ra6Node (null)
global ra6_kept_holder: ?Ra6Holder (null)

fn ra6_garbage() $noinline {
    let junk = Array[Ra6Node]{}
    each 0 .. 300 as i : junk.append(Ra6Node { value: i.to(int) })
    gc.collect()
    gc.collect()
}

fn ra6_fresh_text(n: int) String $noinline { return "text number " + n }
fn ra6_fresh_node(n: int) Ra6Node $noinline {
    ra6_kept = Ra6Node { value: n }
    let k = ra6_kept
    ra6_kept = null
    return isset(k) ? k : Ra6Node {}
}

// 1. What only an object in the frame refers to stays alive
fn ra6_frame_keeps() int {
    let holder = Ra6Holder { text: ra6_fresh_text(61), node: ra6_fresh_node(62) }
    ra6_garbage()
    let node = holder.node
    return holder.text.length.to(int) * 100 + (isset(node) ? node.value : -1)
}

// 2. An object in the frame is written by a callee, with something the collector owns
fn ra6_fill(holder: Ra6Holder, n: int) $noinline {
    holder.text = ra6_fresh_text(n)
    holder.node = ra6_fresh_node(n)
}
fn ra6_frame_filled() int {
    let holder = Ra6Holder {}
    ra6_fill(holder, 63)
    ra6_garbage()
    let node = holder.node
    return holder.text.length.to(int) * 100 + (isset(node) ? node.value : -1)
}

// 3. The same place in the frame for every round
fn ra6_frame_rounds(n: int) int {
    let sum = 0
    let i = 0
    while i++ < n {
        let node = Ra6Node { value: i }
        let pair = Ra6Node { value: i * 2, next: node }
        if i % 5 == 0 : ra6_garbage()
        let next = pair.next
        sum += pair.value + (isset(next) ? next.value : 0)
    }
    return sum
}

// 4. One of the objects of a round is ra6_kept by a global: none of that site is in the frame
fn ra6_frame_round_kept(n: int) int {
    let i = 0
    while i++ < n {
        let node = Ra6Node { value: i }
        if i == 3 : ra6_kept = node
    }
    ra6_garbage()
    let k = ra6_kept
    return isset(k) ? k.value : -1
}

// 5. An object in the frame of a function that waits
fn ra6_frame_waits(n: int) int {
    let holder = Ra6Holder { text: ra6_fresh_text(n) }
    let node = Ra6Node { value: n }
    time.sleep_ms(2)
    ra6_garbage()
    time.sleep_ms(1)
    return holder.text.length.to(int) * 100 + node.value
}
fn ra6_frame_waits_use() int {
    let a = co ra6_frame_waits(64)
    let b = co ra6_frame_waits(65)
    ra6_garbage()
    return (await a) + (await b)
}

// 5b. Only objects of a known size, in a function that waits
fn ra6_frame_waits_plain(n: int) int {
    let node = Ra6Node { value: n }
    let pair = Ra6Node { value: n * 2, next: node }
    time.sleep_ms(2)
    ra6_garbage()
    time.sleep_ms(1)
    let next = pair.next
    return pair.value + (isset(next) ? next.value : -1)
}
fn ra6_frame_waits_plain_use() int {
    let a = co ra6_frame_waits_plain(70)
    let b = co ra6_frame_waits_plain(71)
    ra6_garbage()
    return (await a) + (await b)
}

// 6. A frame object in every call of a deep recursion
fn ra6_frame_deep(depth: int) int $noinline {
    let node = Ra6Node { value: depth }
    if depth == 0 : return node.value
    let below = ra6_frame_deep(depth - 1)
    return below + node.value
}

// 7. An object in the frame handed to a callee that keeps it: it is not in the frame then
fn ra6_keep(holder: Ra6Holder) $noinline { ra6_kept_holder = holder }
fn ra6_frame_escapes() int {
    let holder = Ra6Holder { text: ra6_fresh_text(66) }
    ra6_keep(holder)
    ra6_garbage()
    let k = ra6_kept_holder
    return isset(k) ? k.text.length.to(int) : -1
}

// 8. Frame objects that refer to each other, read after collections
fn ra6_frame_chain() int {
    let a = Ra6Node { value: 1 }
    let b = Ra6Node { value: 2, next: a }
    let c = Ra6Node { value: 3, next: b }
    ra6_garbage()
    let sum = 0
    let at: ?Ra6Node = c
    while true {
        let node = at ?! break
        sum = sum * 10 + node.value
        at = node.next
    }
    return sum
}

// 9. Through an interface
interface Ra6Valued { fn amount() int; }
class Ra6Coin is Ra6Valued {
    worth: int (0)
    fn amount() int { return this.worth }
}
fn ra6_amount_of(item: Ra6Valued) int $noinline { return item.amount() }
fn ra6_frame_interface() int {
    let coin = Ra6Coin { worth: 67 }
    ra6_garbage()
    return ra6_amount_of(coin)
}

// 10. A callee makes what the frame object refers to refer back to it: not in the frame then
class Ra6Back {
    owner: ?Ra6Front (null)
    value: int (0)
}
class Ra6Front {
    back: ?Ra6Back (null)
    value: int (0)
}
global ra6_kept_back: ?Ra6Back (null)
fn ra6_fresh_back(n: int) Ra6Back $noinline {
    ra6_kept_back = Ra6Back { value: n }
    let b = ra6_kept_back
    ra6_kept_back = null
    return isset(b) ? b : Ra6Back {}
}
fn ra6_tie(front: Ra6Front) $noinline {
    let back = front.back
    if isset(back) : back.owner = front
}
fn ra6_frame_tied() int {
    let front = Ra6Front { back: ra6_fresh_back(68), value: 5 }
    ra6_tie(front)
    ra6_garbage()
    let back = front.back
    let owner = isset(back) ? back.owner : null
    return (isset(back) ? back.value : -1) * 10 + (isset(owner) ? owner.value : -1)
}

// 11. A frame object keeps a list of the collector alive, with what the list holds
fn ra6_fresh_list(n: int) Array[Ra6Node] $noinline {
    ra6_kept_holder = Ra6Holder {}
    let h = ra6_kept_holder
    ra6_kept_holder = null
    let list = isset(h) ? h.list : Array[Ra6Node]{}
    let i = 0
    while i++ < n : list.append(Ra6Node { value: i })
    return list
}
class Ra6Shelf {
    items: Array[Ra6Node] (.{})
    count: int (0)
}
fn ra6_frame_holds_list() int {
    let shelf = Ra6Shelf { items: ra6_fresh_list(9), count: 9 }
    ra6_garbage()
    let sum = 0
    each shelf.items as node : sum += node.value
    return sum * 10 + shelf.count
}

// 12. One for every round, each with something of the collector
fn ra6_frame_rounds_heap(n: int) int {
    let sum = 0
    let i = 0
    while i++ < n {
        let shelf = Ra6Shelf { items: ra6_fresh_list(i), count: i }
        if i % 4 == 0 : ra6_garbage()
        sum += shelf.items.length.to(int) + shelf.count
    }
    return sum
}

test "Regions audit: objects in the frame, through rounds, recursion, a function that waits, and with what the collector owns" {
    assert(ra6_frame_keeps() == 1462)
    assert(ra6_frame_filled() == 1463)
    assert(ra6_frame_rounds(40) == 2460)
    assert(ra6_frame_round_kept(6) == 3)
    assert(ra6_frame_waits_use() == 2929)
    assert(ra6_frame_waits_plain_use() == 423)
    assert(ra6_frame_deep(3000) == 4501500)
    assert(ra6_frame_escapes() == 14)
    assert(ra6_frame_chain() == 321)
    assert(ra6_frame_interface() == 67)
    assert(ra6_frame_tied() == 685)
    assert(ra6_frame_holds_list() == 459)
    assert(ra6_frame_rounds_heap(12) == 156)
}

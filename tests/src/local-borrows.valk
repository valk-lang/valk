class LocalBorrowBox { r: &[u8] }

fn local_borrow_copy(d: local &[u8]) LocalBorrowBox { return LocalBorrowBox{ r: copy d } }
fn local_borrow_clone(d: local &[u8]) LocalBorrowBox { return LocalBorrowBox{ r: clone d } }
fn local_borrow_first(values: local mut &[int]) local mut &int { return &values[0] }

test "Local borrows: copy and clone give storage of their own" {
    let a: [u8 x 2] = { 7, 8 }
    let copied = local_borrow_copy(a)
    let cloned = local_borrow_clone(a)
    a[0] = 9
    assert(copied.r[0] == 7 && cloned.r[0] == 7)
}

test "Local borrows: an element borrow is a local result" {
    let a: [int x 2] = { 1, 2 }
    local_borrow_first(a)[0] = 5
    assert(a[0] == 5)
    let absent: ?local &[int] = null
    assert(absent == null)
}

class ConditionalBox { value: int (73) }
class ConditionalCounter { value: int }
struct ConditionalPair {
    first: int
    second: int
}

fn conditional_flag(value: bool) bool $noinline { return value }
fn conditional_box() ?ConditionalBox { return ConditionalBox {} }
fn conditional_number(value: ?int) ?int { return value }
fn conditional_pair() ?ConditionalPair { return .{ first: 31, second: 37 } }
fn conditional_array() ?[int x 2] { return .{ 41, 43 } }
fn conditional_fail_box() ?ConditionalBox $exit { panic("Missing box") }
fn conditional_unwrap_first(value: ?ConditionalBox) ConditionalBox {
    return isset(value) ? value : panic("Missing box")
}
fn conditional_unwrap_second(value: ?ConditionalBox) ConditionalBox {
    return !isset(value) ? panic("Missing box") : value
}

test "Conditional values: panic fallback preserves the present type" {
    let box = conditional_box() ?? panic("Missing box")
    assert(box.value == 73)
    let typed_exit = conditional_box() ?? conditional_fail_box()
    assert(typed_exit.value == 73)
    let number = conditional_number(29) ?? panic("Missing number")
    assert(number == 29)
    let pair = conditional_pair() ?? panic("Missing pair")
    assert(pair.first == 31 && pair.second == 37)
    let array = conditional_array() ?? panic("Missing array")
    assert(array[0] == 41 && array[1] == 43)
    let fallback = conditional_number(null) ?? conditional_number(47)
    assert(isset(fallback) && fallback == 47)
    let missing = conditional_number(null) ?? conditional_number(null)
    assert(!isset(missing))
}

test "Conditional values: only the selected branch runs" {
    let calls = ConditionalCounter {}
    let present = fn() ?int { calls.value++; return 53 }
    let absent = fn() ?int { calls.value++; return null }
    let fallback = fn() int { calls.value += 10; return 59 }
    assert((present() ?? panic("Missing number")) == 53)
    assert(calls.value == 1)
    assert((present() ?? fallback()) == 53)
    assert(calls.value == 2)
    assert((absent() ?? fallback()) == 59)
    assert(calls.value == 13)
    let action = fn() { calls.value++ }
    conditional_flag(true) ? action() : action()
    assert(calls.value == 14)
    conditional_flag(false) ? action() : action()
    assert(calls.value == 15)
}

test "Conditional values: either branch can exit" {
    let first = conditional_flag(true) ? 61 : panic("Wrong branch")
    let second = conditional_flag(false) ? panic("Wrong branch") : 67
    assert(first == 61 && second == 67)
    let pair = conditional_flag(false) ? panic("Wrong branch") : conditional_pair()
    assert(isset(pair) && pair.first == 31)
    let array = conditional_flag(true) ? conditional_array() : panic("Wrong branch")
    assert(isset(array) && array[1] == 43)
    let nested = conditional_flag(true)
        ? (conditional_flag(false) ? panic("Wrong branch") : 71)
        : (conditional_flag(true) ? panic("Wrong branch") : panic("Wrong branch"))
    assert(nested == 71)
    assert(conditional_unwrap_first(conditional_box()).value == 73)
    assert(conditional_unwrap_second(conditional_box()).value == 73)
    let calls = ConditionalCounter {}
    let action = fn() { calls.value++ }
    conditional_flag(true) ? action() : panic("Wrong branch")
    conditional_flag(false) ? panic("Wrong branch") : action()
    assert(calls.value == 2)
}

test "Conditional values: logical operands short circuit before panic" {
    assert(!(conditional_flag(false) && panic("Wrong branch")))
    assert(conditional_flag(true) || panic("Wrong branch"))
}

use valk.thread

// The values a `$atomic` object, locked data or an atomic conversion is given are copies

class PrItem { n: int (0) }
class PrBox $atomic { items: Array[int] (.{}) item: PrItem (PrItem{}) }
class PrStore { nums: Array[int] (.{}) bytes: Array[u8] (.{}) }
struct PrPair { a: int b: int }
class PrPairStore { p: PrPair (PrPair{ a: 1, b: 2 }) }

interface PrShape {
    fn area() int;
}
class PrSq is PrShape {
    side: int (2)
    fn area() int { return this.side * this.side }
}
class PrHolder { s: ?PrShape (null) }
class PrHolderClone {
    s: ?PrShape (null)
    fn clone() SELF {
        let s = this.s
        let copy: ?PrShape = null
        if isset(s) : match s { PrSq as q => { copy = clone q } default => {} }
        return SELF{ s: copy }
    }
}

fn pr_all(b: local mut &[int]) local mut &[int] { return b.view(0, 2) }
fn pr_tail(b: local &[u8]) local &[u8] { return b.view(1, 2) }
fn pr_same(p: local mut &PrPair) local mut &PrPair { return p }

test "Publish: a $atomic literal copies the plain values it is given" {
    let plain = Array[int]{ 1, 2 }
    let item = PrItem{ n: 1 }
    let box = PrBox{ items: plain, item: item }
    plain.append(3)
    item.n = 2
    assert(box.items.length == 2)
    assert(box.item.n == 1)
    let in_lock: Lock[PrStore] = .new(PrStore{ nums: plain }) !!
    plain.append(4)
    lock in_lock as s : assert(s.nums.length == 3)
}

test "Publish: a Lock may hold a Heap whose order function captures nothing" {
    let heap: Lock[Heap[int]] = .new(Heap[int].new(fn(a: int, b: int) bool { return a > b })) !!
    lock heap as h {
        h.push(1)
        h.push(3)
        h.push(2)
        assert((h.pop() !? 0) == 3)
    }
}

test "Publish: an interface value is copied through its concrete type" {
    let sq = PrSq{}
    // Converted on the spot: the concrete type is known
    let h: atomic PrHolder = PrHolder{ s: sq }
    sq.side = 5
    let inner = h.s ?! panic("no shape")
    assert((match inner : int { PrSq as q => q.side default => 0 }) == 2)
    // Held in a variable: the class's own clone method copies it
    let h0 = PrHolderClone{ s: sq }
    let h2: atomic PrHolderClone = h0
    sq.side = 7
    let inner2 = h2.s ?! panic("no shape")
    assert((match inner2 : int { PrSq as q => q.side default => 0 }) == 5)
}

test "Publish: a local result lent locked plain data stays inside the lock block" {
    let st: Lock[PrStore] = .new(PrStore{ nums: Array[int]{ 1, 2, 3, 4 }, bytes: Array[u8]{ 9, 8, 7 } }) !!
    lock st as s {
        let head = pr_all(s.nums)
        head[0] = 10
        let tail = pr_tail(s.bytes)
        assert(tail[0] == 8)
    }
    lock st as s : assert(s.nums[0] == 10)
    let ps: Lock[PrPairStore] = .new(PrPairStore{}) !!
    lock ps as s {
        let p = pr_same(s.p)
        p.a = 5
    }
    lock ps as s : assert(s.p.a == 5)
}

shared pr_count: uint (0)
shared pr_item: ?atomic PrItem (null)

#if !TEST_ST_ONLY && !TEST_MT_TODO
test "Publish: shared globals of one word change from any thread" {
    pr_count = 1
    pr_item = PrItem{ n: 3 }
    let t = thread.start(fn() { pr_count += 1 }) !!
    t.await()
    assert(pr_count == 2)
    let item = pr_item ?! panic("no item")
    assert(item.n == 3)
}
#end

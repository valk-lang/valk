@ignore_access

#if URING
use valk.io
use valk.ext
use valk.time

test "io_uring: partial submission accounting" {
    assert(io.uring_remaining(5, 2) == 3)
    assert(io.uring_remaining(3, 3) == 0)
}

test "io_uring: a failed ring names its cause" {
    assert(io.uring_failure(-1).contains("EPERM"))
    assert(io.uring_failure(-12).contains("ENOMEM"))
    assert(io.uring_failure(-38).contains("ENOSYS"))
    assert(io.uring_failure(-22).ends_with("error 22"))
}

test "io_uring: a submit larger than the count does not wrap" {


    assert(io.uring_remaining(2, 5) == 0)
    assert(io.uring_remaining(0, 1) == 0)
}
#end

@ignore_access

#if OS == "linux"
use valk.io

test "io_uring: partial submission accounting" {
    assert(io.uring_remaining(5, 2) == 3)
    assert(io.uring_remaining(3, 3) == 0)
}

test "io_uring: a submit larger than the count does not wrap" {


    assert(io.uring_remaining(2, 5) == 0)
    assert(io.uring_remaining(0, 1) == 0)
}

test "io_uring: descriptor polling honours its timeout" {
    assert(io.await_fd_timeout_for_test(20))
}

test "io_uring: a failed poll reports an error event and nothing else" {
    // The completion carries -EBADF. Read as a bit mask it used to set every flag at once
    let invalid: io.Fd = 4242
    let waiting = co io.await_fd(invalid, true, false, 0)
    let ev = await waiting
    assert(ev.is_closed())
    assert(!ev.is_timeout())
    assert(!ev.is_readable())
    assert(!ev.is_writable())
}
#end

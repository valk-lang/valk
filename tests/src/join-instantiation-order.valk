// The property type instantiates Array[JoinOrderItem] before the item's
// `$to` hook is registered; `join` must still be available.
class JoinOrderHolder {
    items: Array[JoinOrderItem] (.{})
}

class JoinOrderItem {
    value: int
    fn to_str() String $to { return "i" + this.value }
}

test "Array.join is available regardless of instantiation order" {
    let holder = JoinOrderHolder {}
    holder.items.append(JoinOrderItem { value: 1 })
    holder.items.append(JoinOrderItem { value: 2 })
    assert(holder.items.join(",") == "i1,i2")
    assert(Array[JoinOrderItem]{ JoinOrderItem { value: 3 } }.join("") == "i3")
}

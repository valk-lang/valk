use valk.io

class MatchWriter is io.Writer {
    out: ByteBuffer (.new())
    + fn write(data: local &[u8]) uint !io.IoError { return this.out.write(data) }
}

fn describe(writer: ?io.Writer) String {
    match writer {
        null => return "none"
        ByteBuffer as buf => return "buffer holding " + buf.length
        MatchWriter as matched => {
            matched.out.write("!")
            return "matched " + matched.out.length
        }
        default => return "other"
    }
}

test "Interfaces: match narrows an interface value to the class it holds" {
    let buf = ByteBuffer.new()
    buf.write("abc")
    assert(describe(buf) == "buffer holding 3")
    let matched = MatchWriter {}
    assert(describe(matched) == "matched 1")
    assert(describe(matched) == "matched 2")
    assert(describe(io.stdout()) == "other")
    assert(describe(null) == "none")
}

interface Inspectable {
    fn inspect() uint;
}
class InspectedValue is Inspectable {
    number: uint (7)
    fn inspect() uint { return this.number }
}
fn inspect_through(value: Inspectable) uint { return value.inspect() }

test "Interfaces: a call through an interface whose implementations keep nothing leaves the value unique" {
    let value = InspectedValue {}
    assert(inspect_through(value) == 7)
    // Publishing afterwards is allowed: no implementation of `inspect` keeps its receiver
    let published: shared InspectedValue = value
    assert(published.number == 7)
}

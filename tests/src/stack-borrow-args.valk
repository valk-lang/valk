use valk.compress
use valk.crypto

fn sum(data: &[u8]) uint {
    let total: uint = 0
    each data as b : total += b.to(uint)
    return total
}

fn first_of(values: &[u8 x 4]) u8 {
    return values[0]
}

fn read_int(value: &int) int {
    return value[0]
}

// Passes the borrow on to another callee that keeps nothing
fn sum_twice(data: &[u8]) uint {
    return sum(data) + sum(data)
}

fn bump(data: mut &[u8]) {
    data[0] = data[0] + 1
}

test "Stack borrows: frame storage passes to callees that keep nothing" {
    let bytes: [u8 x 4] = { 1, 2, 3, 4 }
    assert(sum(bytes) == 10)
    assert(sum_twice(bytes) == 20)
    assert(first_of(bytes) == 1)
    assert(compress.crc32(bytes) == 0xb63cfbcd)
    assert(crypto.hex_encode(bytes) == "01020304")

    // A `.{ ... }` literal fills an inline array that the frame lends to a `local &[T]` parameter
    assert(compress.crc32(.{ 1, 2, 3, 4 }) == 0xb63cfbcd)
    assert(crypto.hex_encode(.{ 0xab, 0xcd }) == "abcd")
    let hasher = crypto.hasher(crypto.HashAlgorithm.sha256)
    hasher.update(.{ 'a', 'b', 'c' })

    // A local fixed-array borrow becomes a local slice, with the length in the value
    let as_slice: local &[u8] = &bytes
    assert(as_slice.length == 4)
    assert(sum(as_slice.view(1, 2)) == 5)

    // An explicit stack borrow converts the same way
    let borrowed: local mut &[u8 x 4] = &bytes
    assert(sum(borrowed) == 10)
    bump(bytes)
    assert(bytes[0] == 2)

    let value = 41
    let pointer: local mut &int = &value
    assert(read_int(pointer) == 41)

    // Storage reached through a stack borrow of a struct
    let holder: [u8 x 2] = { 7, 8 }
    let view: local mut &[u8 x 2] = &holder
    assert(sum(view) == 15)
}

// The callee keeps the borrow in an object; the object stays in the caller's frame
fn wrap_bytes(data: &[u8]) ByteReader { return ByteReader.new(data) }
fn same_bytes(data: &[u8]) &[u8] { return data }
fn keep_bytes(reader: ByteReader, data: &[u8]) { reader.source = data }
fn sum_through_reader(data: local &[u8]) uint {
    let reader = ByteReader.new(data)
    let total: uint = 0
    while reader.pos < data.length : total += reader.read_byte().to(uint)
    return total
}

test "Stack borrows: frame storage lent into an object that stays in the frame" {
    let bytes: [u8 x 4] = { 1, 2, 3, 4 }
    let reader = wrap_bytes(bytes)
    assert(reader.read_byte() == 1)
    let kept = same_bytes(bytes)
    assert(kept.length == 4 && kept[3] == 4)
    let other = ByteReader.new("x")
    keep_bytes(other, bytes)
    assert(other.read_byte() == 1)
    // Through a local parameter as well, and the holder may move between locals
    assert(sum_through_reader(bytes) == 10)
    assert(sum_through_reader(.{ 5, 6 }) == 11)
    let list = Array[ByteReader]{}
    list.append(wrap_bytes(bytes))
    assert((list.get(0) !!).read_byte() == 1)
}

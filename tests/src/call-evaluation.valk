class CallOrderLog { text: String ("") }
interface CallOrderReadable { fn read(value: int) int; }

class CallOrderBox is CallOrderReadable {
    fn read(value: int) int { return value + 1 }
}

fn call_order_receiver(log: CallOrderLog) CallOrderBox {
    log.text += "R"
    return CallOrderBox {}
}

fn call_order_interface(log: CallOrderLog) CallOrderReadable {
    log.text += "I"
    return CallOrderBox {}
}

fn call_order_argument(log: CallOrderLog, marker: String) int {
    log.text += marker
    return 73
}

fn call_order_consume(first: int, second: int) int { return first + second }

fn call_order_closure(log: CallOrderLog) fn(int, int)(int) {
    log.text += "C"
    return call_order_consume
}

fn call_order_pointer(log: CallOrderLog) fnptr(int, int)(int) {
    log.text += "P"
    return call_order_consume
}

fn call_order_clear_pointer(slot: temp ?fnptr(int, int)(int)) int {
    slot[0] = null
    return 79
}

fn call_order_clear_closure(slot: temp ?fn(int, int)(int)) int {
    slot[0] = null
    return 79
}

error CallOrderError (failed)
fn call_order_fallible(value: int) int !CallOrderError {
    if value == 0 : throw .failed
    return value + 1
}

fn call_order_multiple(number: u8, box: CallOrderBox) (CallOrderBox, int) {
    return (box, number.to(int) + 73)
}

test "Call evaluation: callable and receiver precede arguments" {
    let log = CallOrderLog {}
    assert(call_order_receiver(log).read(call_order_argument(log, "A")) == 74)
    assert(log.text == "RA")
    log.text = ""
    assert(call_order_interface(log).read(call_order_argument(log, "A")) == 74)
    assert(log.text == "IA")
    log.text = ""
    assert(call_order_closure(log)(call_order_argument(log, "A"), call_order_argument(log, "B")) == 146)
    assert(log.text == "CAB")
    log.text = ""
    assert(call_order_pointer(log)(call_order_argument(log, "A"), call_order_argument(log, "B")) == 146)
    assert(log.text == "PAB")
}

test "Call evaluation: coroutine operands follow the same order" {
    let log = CallOrderLog {}
    let method = co call_order_receiver(log).read(call_order_argument(log, "A"))
    assert(log.text == "RA")
    assert(await method == 74)
    log.text = ""
    let interface_method = co call_order_interface(log).read(call_order_argument(log, "A"))
    assert(log.text == "IA")
    assert(await interface_method == 74)
    log.text = ""
    let closure = co call_order_closure(log)(call_order_argument(log, "A"), call_order_argument(log, "B"))
    assert(log.text == "CAB")
    assert(await closure == 146)
    log.text = ""
    let pointer = co call_order_pointer(log)(call_order_argument(log, "A"), call_order_argument(log, "B"))
    assert(log.text == "PAB")
    assert(await pointer == 146)
}

test "Call evaluation: arguments cannot replace the selected callee" {
    let pointer: ?fnptr(int, int)(int) = call_order_consume
    if isset(pointer) {
        assert(pointer(73, call_order_clear_pointer(&pointer)) == 152)
        assert(!isset(pointer))
    }
    let closure: ?fn(int, int)(int) = call_order_consume
    if isset(closure) {
        assert(closure(73, call_order_clear_closure(&closure)) == 152)
        assert(!isset(closure))
    }
    pointer = call_order_consume
    if isset(pointer) {
        let task = co pointer(73, call_order_clear_pointer(&pointer))
        assert(!isset(pointer))
        assert(await task == 152)
    }
    closure = call_order_consume
    if isset(closure) {
        let task = co closure(73, call_order_clear_closure(&closure))
        assert(!isset(closure))
        assert(await task == 152)
    }
}

test "Call evaluation: function pointer coroutines preserve errors" {
    let pointer: fnptr(int)(int !CallOrderError) = call_order_fallible
    let success = co pointer(73)
    assert((await success !? 0) == 74)
    let failure = co pointer(0)
    assert((await failure !? 79) == 79)
    let multiple: fnptr(u8, CallOrderBox)(CallOrderBox, int) = call_order_multiple
    let task = co multiple(7, CallOrderBox {})
    let box, number = await task
    assert(box.read(number) == 81)
}

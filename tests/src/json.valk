use valk:json
use valk:gc

class JsonTest {
    v1: String ("Hello")
    v2: int (123)
    v3: int (-123)
    v4: uint (123)
    v5: JsonSub (JsonSub{})
    v6: Array[Map[String]] (.{ .{ "a" => "b" }, .{ "c" => "d" } })
    v7: f64 (-123.056700)
    v8: f64 (-123.0)
}

class JsonSub {
    v1: String ("World")
}

class JsonCycle {
    children: Array[JsonCycle] (.{})
}

test "Json: decode, inspect, mutate and encode" {
    let document = json:decode("{\"name\":\"Alice\",\"age\":30,\"active\":true,\"score\":4.5,\"missing\":null,\"tags\":[\"one\",\"two\"]}") ! {
        assert(false)
        return
    }
    if !document.is_object() {
        assert(false)
        return
    }

    assert(document.get("name").string() == "Alice")
    assert(document.get("age").int() == 30)
    assert(document.get("active").bool())
    assert(document.get("score").float() == 4.5)
    assert(document.get("missing").string() == "")
    assert((document.get("name").string_or() !? "") == "Alice")
    assert((document.get("age").int_or() !? 0) == 30)
    assert(document.get("active").bool_or() !? false)
    assert((document.get("score").float_or() !? 0.0) == 4.5)

    let failed_str = false
    document.get("missing").string_or() ! { failed_str = true }
    assert(failed_str)

    let failed_int = false
    document.get("missing").int_or() ! { failed_int = true }
    assert(failed_int)

    let failed_arr = false
    document.get("missing").array_or() ! { failed_arr = true }
    assert(failed_arr)
    assert(document["tags"].length() == 2)
    assert(document["tags"][1].string() == "two")

    let tag_items = Array[String]{}
    let tags = document.get("tags")
    if isset(tags) {
        each tags as tag, idx {
            tag_items.append(tag.string())
        }
    }
    assert(tag_items.length == 2)
    assert((tag_items[0] !!) == "one")
    assert((tag_items[1] !!) == "two")

    let obj_keys = Array[String]{}
    if isset(document) {
        each document as val, key {
            obj_keys.append(key.string())
        }
    }
    assert(obj_keys.length == 6)

    // Encode test
    let test_obj = JsonSub { v1: "TestEncode" }
    let enc_str = json:encode(test_obj)
    assert(enc_str == "{\"v1\":\"TestEncode\"}")

    // ByteBuffer decode test
    let buf = ByteBuffer.new(100)
    buf.write_string("{\"hello\":\"world\"}")
    let decoded_buf = json:decode(buf) !? null
    assert(decoded_buf.get("hello").string() == "world")

    document = document.set("name", "Valk")
    let encoded = document.encode()
    let decoded = json:decode(encoded) !? null
    assert(decoded.get("name").string() == "Valk")

    let out_buf = ByteBuffer.new(100)
    document.encode_to(out_buf)
    assert(out_buf.to_string() == encoded)
}

test "Json: Value façade provides direct object and array access" {
    let user = json:decode("{\"name\":\"Alice\",\"tags\":[\"one\"]}") ! {
        assert(false)
        return
    }

    assert(user.is_object())
    assert(user.get("name").string() == "Alice")
    assert(user.get("missing").is_null())
    assert(user.get(0).is_null())
    assert(user.has("name"))
    assert(!user.has("missing"))
    assert(!user.has(0))

    user = user.set("name", "Valk")
    assert(user.get("name").string() == "Valk")

    let tags = user.get("tags")
    assert(tags.is_array())
    assert(tags.get(0).string() == "one")
    let index: uint = 0
    assert(tags.get(index).string() == "one")
    assert(tags.get("0").is_null())
    assert(tags.has(index))
    assert(!tags.has("0"))
    assert(user["name"].string() == "Valk")
    assert(user["tags"][0].string() == "one")
    assert(user["missing"].is_null())

    let nested = json:decode("{\"user\":{\"name\":{\"first\":\"Ada\"}}}") ! {
        assert(false)
        return
    }
    assert(nested.get("user").get("name").get("first").string() == "Ada")
    assert(nested["user"]["name"]["first"].string() == "Ada")
    tags = tags.append("two")
    tags = tags.set(index, "updated")
    assert(tags.get(index).string() == "updated")
    assert(tags.length() == 2)
}

test "Json: set creates and expands containers" {
    let object: json:Value = null
    object = object.set("name", "Ada")
    assert(object.is_object())
    assert(object.get("name").string() == "Ada")

    let array: json:Value = null
    let index: uint = 2
    array = array.set(index, "third")
    assert(array.is_array())
    assert(array.length() == 3)
    assert(array[0].is_null())
    assert(array[1].is_null())
    assert(array[index].string() == "third")

    object = object.remove("name")
    assert(object.get("name").is_null())
    object = object.remove("missing")
    assert(object.is_object())
    object = object.remove(0)
    assert(object.is_object())
    array = array.remove(1)
    assert(array.length() == 2)
    assert(array[1].string() == "third")
    array = array.remove("missing")
    assert(array.is_array())
    let scalar: json:Value = 42
    scalar = scalar.remove("missing")
    assert(scalar.int() == 42)

    scalar = scalar.append("first")
    assert(scalar.is_array())
    assert(scalar[0].string() == "first")
    scalar = scalar.prepend("zero")
    assert(scalar[0].string() == "zero")
}

test "Json: construct concrete containers" {
    assert(json:new_null().is_null())
    assert(json:new_string("hello").string() == "hello")
    assert(json:new_int(42).int() == 42)
    assert(json:new_float(4.5).float() == 4.5)
    assert(json:new_bool(true).bool())

    let object = json:new_object()
    object.set("message", "hello")

    let items = json:new_array()
    items.append(1)
    items.append(null)
    object.set("items", items)

    assert(json:encode(object) == "{\"message\":\"hello\",\"items\":[1,null]}")
}

test "Json: typed conversion" {
    let original = JsonTest{}
    let value = json:from(original)
    let converted = json:from_value[JsonTest](value) ! {
        assert(false)
        return
    }

    assert(converted.v1 == "Hello")
    assert(converted.v3 == -123)
    assert(converted.v4 == 123)
    assert(converted.v5.v1 == "World")
    assert(converted.v6.length == 2)
    assert(((converted.v6.get(1) !? .{}).get("c") !? "") == "d")
    assert(converted.v7 == -123.0567)
    assert(converted.v8 == -123.0)
}

test "Json: typed conversion detects recursive containers" {
    let node = JsonCycle{}
    node.children.append(node)
    let value = json:from(node)
    assert(value.get("children").get(0).string() == "(recursion)")
}

test "Json: from preserves an existing Value" {
    let scalar: json:Value = 42
    let converted = json:from(scalar)
    assert(converted.int() == 42)

    scalar = "text"
    converted = json:from(scalar)
    assert(converted.string() == "text")

    scalar = null
    converted = json:from(scalar)
    assert(converted.is_null())
}

test "Json: typed accessors use defaults" {
    let wrong: json:Value = "12"
    assert(wrong.int() == 0)
    wrong = "false"
    assert(!wrong.bool())
    wrong = 42
    assert(wrong.string() == "")
    assert(wrong.length() == 0)
}

test "Json: encode into an existing ByteBuffer" {
    let output = ByteBuffer.$default_value
    output.write_string("prefix:")
    let value = json:from(Map[String]{ "value" => "text" })
    let encoded = json:encode_to(value, output)
    assert(encoded.to_string() == "prefix:{\"value\":\"text\"}")
}

test "Json: escaped strings round trip" {
    let text = "em dash — accents éü and a tab\there"
    let encoded = json:encode(text)
    assert(encoded == "\"em dash — accents éü and a tab\\there\"")
    assert(json_decoded(encoded) == text)
}

test "Json: unicode escapes" {
    assert(json_decoded("\"caf\\u00e9\"") == "café")
    assert(json_decoded("\"\\u20ac\"") == "€")
    assert(json_decoded("\"A\\u0041\"") == "AA")
    assert(json_decoded("\"\\ud83d\\ude00\"") == "😀")
    assert(json_decoded("\"\\ud83d\"") == "�")
    assert(json_decoded("\"\\ud83dX\"") == "�X")
    assert(json_decoded("\"\\u004\"") == "<parse-error>")
    assert(json_decoded("\"\\uZZZZ\"") == "<parse-error>")
    assert(json_decoded("\"bad\\qescape\"") == "<parse-error>")
    assert(json_decoded("\"escaped\\/slash\"") == "escaped/slash")
}

test "Json: number grammar and range errors" {
    let first_number = json:decode("1.25e2") !? null
    assert(first_number.float() == 125.0)
    let second_number = json:decode("-2E-2") !? null
    assert(second_number.float() == -0.02)
    assert(json_parse_fails("-"))
    assert(json_parse_fails("01"))
    assert(json_parse_fails("1."))
    assert(json_parse_fails("1e"))
    assert(json_parse_fails("92233720368547758070"))
}

test "Json: float encoding uses the default round-trip format" {
    assert(json:encode(json:new_float(3.14159265358979)) == "3.14159265358979")
    assert(json:encode(json:new_float(0.0001234)) == "0.0001234")
    let value = 0.1 + 0.2
    let encoded = json:encode(json:new_float(value))
    assert(encoded == "0.30000000000000004")
    assert((json:decode(encoded) !? null).float() == value)
}

test "Json: control character round trip" {
    let text = json_decoded("\"a\\u000bb\"")
    assert(text.bytes == 3)
    assert(@ptrv(text.data, u8, 1) == 11)
    assert(json:encode(text) == "\"a\\u000bb\"")
    assert(json_parse_fails("\"raw\nline\""))
}

synctest "Json: GC traces recursive union values" {
    let document = json:decode("{\"items\":[{\"name\":\"alive\"}],\"count\":1}") ! {
        assert(false)
        return
    }
    gc:collect()
    let items = document.get("items").array()
    let first = items.get(0) !? null
    assert(first.get("name").string() == "alive")
}

fn json_decoded(text: String) String {
    let value = json:decode(text) ! return "<parse-error>"
    return value.string()
}

fn json_parse_fails(text: String) bool {
    json:decode(text) ! return true
    return false
}

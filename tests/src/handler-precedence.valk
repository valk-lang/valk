// The alternative after `!?` and the right side of `??` end at a comparison, `&&`, `||` or `? :`

fn hp_fail() int !AnError {
    throw .error
}

fn hp_flag(ok: bool) bool !AnError {
    if !ok : throw .error
    return false
}

test "Handler precedence: comparisons and logic apply to the handled value" {
    let five = 5
    assert(hp_fail() !? 5 == five)
    assert(five == hp_fail() !? 5)
    assert(hp_fail() !? 1 + 4 == 5)
    assert((hp_fail() !? 2 < 3) == true)
    // `(hp_flag(true) !? true) || true`, not `hp_flag(true) !? (true || true)`
    assert(hp_flag(true) !? true || true)
    assert(!(hp_flag(true) !? true && true))
    let v = hp_fail() !? 0 > 0 ? "pos" : "zero"
    assert(v == "zero")
}

test "Handler precedence: ?? binds tighter than comparisons" {
    let a: ?int = null
    let b: ?int = 3
    assert(a ?? 3 == 3)
    assert(3 == a ?? 3)
    assert(a ?? b ?? 9 == 3)
    assert(a ?? 1 + 2 == 3)
    let n = a ?? 0 < 1 ? 10 : 20
    assert(n == 10)
    let s: ?String = null
    assert(s ?? "x" == "x" && b ?? 0 == 3)
}

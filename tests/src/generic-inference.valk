class InferCell { v: int }

fn infer_pair(a: $T, b: T) T { return a + b }
fn infer_same(a: $T, b: $T) T { return a + b }
fn infer_unwrap(v: ?$T) T { return v ?? panic("null") }
fn infer_read_borrow(r: &$T) T { return r[0] }
fn infer_first(arr: Array[$T]) T { return arr.get(0) !! }
fn infer_slice_length(s: &[$T]) uint { return s.length }
fn infer_map_key(m: HashMap[$K, $V]) K {
    each m as v, k : return k
    panic("empty")
}
fn infer_kind(v: $T) String {
    #if T.$is_nullable
    return "nullable"
    #else
    return "plain"
    #end
}

test "Generics: $T introduces a parameter that later types refer to" {
    assert(infer_pair(1, 2) == 3)
    assert(infer_same(3, 4) == 7)
    assert(infer_pair("a", "b") == "ab")
}

test "Generics: $T is inferred through ?, &, &[] and class arguments" {
    let n: ?int = 5
    assert(infer_unwrap(n) == 5)
    assert(infer_unwrap(7) == 7)
    let c = InferCell { v: 9 }
    let r: &int = &c.v
    assert(infer_read_borrow(r) == 9)
    assert(infer_first(Array[String]{ "a" }) == "a")
    let bytes = [u8]{ 1 x 3 }
    assert(infer_slice_length(bytes) == 3)
    let m = HashMap[String, int]{}
    m.set("k", 1)
    assert(infer_map_key(m) == "k")
}

test "Generics: a flow-narrowed nullable infers its plain type" {
    let a: ?int = 5
    if isset(a) {
        assert(infer_kind(a) == "plain")
        let b = a
        assert(infer_kind(b) == "plain")
    }
    let missing: ?String = null
    assert(infer_kind(missing) == "nullable")
}

fn infer_view_count(values: local &[$T]) uint {
    return values.length
}

fn infer_view_sum(values: local &[$T]) T {
    let total: T = 0
    each values as v : total += v
    return total
}

fn infer_view_first(values: &[$T]) T {
    return values[0]
}

test "Generic inference: '&[$T]' from what becomes a slice" {
    let floats = Array[f32]{ 1.5, 2 }
    assert(infer_view_count(floats) == 2)
    assert(infer_view_sum(floats) == 3.5)
    assert(infer_view_first(floats) == 1.5)
    let names = Array[String]{ "x", "y" }
    assert(infer_view_first(names) == "x")
    let fixed: [int x 3] = { 1, 2, 3 }
    assert(infer_view_count(fixed) == 3 && infer_view_sum(&fixed) == 6)
    let bytes = ByteBuffer.new(4)
    bytes.write_byte(7)
    assert(infer_view_sum(bytes) == 7)
    assert(infer_view_count("héllo") == 6)
}

fn gi_default_nullable(a: $T, b: ?T (null)) bool { return isset(b) }
fn gi_default_list(a: $T, b: Array[T] (.{})) uint { return b.length + 1 }

test "Generic inference: defaults can use the inferred types" {
    assert(!gi_default_nullable(1))
    assert(gi_default_nullable(1, 2))
    assert(gi_default_list("a") == 1)
    assert(gi_default_list(3, Array[int]{ 4, 5 }) == 3)
}

class GiChunks[T] {
    items: Array[T] (.{})
    // Names a deeper specialization of its own class, which is only made when used
    fn chunks(n: uint) GiChunks[GiChunks[T]] {
        let out = GiChunks[GiChunks[T]]{}
        let current = GiChunks[T]{}
        each this.items as item {
            current.items.append(item)
            if current.items.length == n {
                out.items.append(current)
                current = GiChunks[T]{}
            }
        }
        if current.items.length > 0 : out.items.append(current)
        return out
    }
}

test "Generic classes: a method may return a deeper specialization of its class" {
    let list = GiChunks[int]{ items: .{ 1, 2, 3, 4, 5 } }
    let chunks = list.chunks(2)
    assert(chunks.items.length == 3)
    assert(chunks.items[2].items[0] == 5)
    let nested = chunks.chunks(2)
    assert(nested.items.length == 2)
}

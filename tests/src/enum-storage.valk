struct EnumStoragePart {
    number: int
    fn change() { this.number = 73 }
    fn read() int { return this.number }
}
fn enum_storage_read_number(value: temp int) int { return value[0] }
struct EnumStorageEntry {
    inner: EnumStoragePart
    numbers: [int x 2]
    fn read() int { return this.inner.number }
    fn read_borrowed() int { return enum_storage_read_number(&this.inner.number) }
    fn read_generic[T](unused: T) int { return this.numbers[0] }
    fn read_inferred(unused: $T) int { return this.numbers[1] }
    fn read_recursive(n: int) int {
        return n == 0 ? this.inner.number : this.read_next(n - 1)
    }
    fn read_next(n: int) int { return this.read_recursive(n) }
    fn change_copy() int {
        let copy = this.inner
        copy.change()
        return copy.number
    }
}
enum EnumStorageChoice: EnumStorageEntry {
    first (EnumStorageEntry { inner: EnumStoragePart { number: 7 }, numbers: {7, 19} })
    second (EnumStorageEntry { inner: EnumStoragePart { number: 19 }, numbers: {19, 7} })
}
class EnumStorageHolder { value: EnumStorageChoice }
fn enum_storage_replace(value: temp EnumStorageChoice) { value[0] = EnumStorageChoice.second }

test "Enums: inline storage supports inferred read-only methods" {
    let value = EnumStorageChoice.first
    assert(value.read() == 7)
    assert(value.inner.read() == 7)
    assert(value.read_borrowed() == 7)
    assert(value.read_recursive(3) == 7)
    assert(value.read_generic[int](1) == 7)
    assert(value.read_inferred(1) == 19)
    let bound = value.read
    assert(bound() == 7)
    let generic_bound = value.read_generic[int]
    assert(generic_bound(1) == 7)
    assert(value.change_copy() == 73)
    assert(value.inner.number == 7)
}

test "Enums: copies of the underlying storage remain mutable" {
    let value = EnumStorageChoice.first
    let copy: EnumStorageEntry = value
    copy.inner.change()
    copy.numbers[0] = 73
    assert(copy.inner.number == 73 && copy.numbers[0] == 73)
    assert(value.inner.number == 7 && value.numbers[0] == 7)
    let part = value.inner
    part.change()
    assert(part.number == 73 && value.inner.number == 7)
    let range = value.numbers[0..2]
    range[0] = 73
    assert(range[0] == 73 && value.numbers[0] == 7)
}

test "Enums: borrowed storage can be read and replaced as a whole" {
    let value = EnumStorageChoice.first
    enum_storage_replace(&value)
    assert(value.read() == 19)
    let holder = EnumStorageHolder {}
    let borrowed = &mut holder.value
    assert(borrowed.read() == 7)
    assert(borrowed.read_borrowed() == 7)
    borrowed[0] = EnumStorageChoice.second
    assert(holder.value.read() == 19)
    assert(borrowed.read_generic[int](1) == 19)
}

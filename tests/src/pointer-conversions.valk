class PointerConversionItem {
    number: int (23)
    fn text() String $auto { return "item" }
}

struct PointerConversionCell {
    number: int (31)
    fn text() String $auto { return this.number.to(String) }
}

class PointerConversionOwner {
    item: PointerConversionItem (.{})
    number: int (17)
    cell: PointerConversionCell (.{})
    items: [PointerConversionItem x 2] ({ .{}, .{} })
}

fn pointer_item_text(value: *PointerConversionItem) String { return value }
fn pointer_int_text(value: *int) String { return value }
fn pointer_sequence_text(value: *[PointerConversionItem x 2]) String { return value }
fn pointer_unbounded_text(value: *[PointerConversionItem]) String { return value }
fn pointer_cell_text(value: *PointerConversionCell) String { return value }

test "Pointer conversions: raw pointers use address formatting" {
    let owner = PointerConversionOwner {}
    let item: *PointerConversionItem = &mut owner.item
    let number: *int = &mut owner.number
    let items: *[PointerConversionItem x 2] = &mut owner.items
    assert(pointer_item_text(item) == item.to_hex())
    assert(pointer_int_text(number) == number.to_hex())
    assert(pointer_sequence_text(items) == items.to_hex())
    assert(pointer_unbounded_text(&mut owner.items) == items.to_hex())
}

test "Pointer conversions: inline storage keeps its struct hooks" {
    let owner = PointerConversionOwner {}
    assert(pointer_cell_text(&mut owner.cell) == "31")
}

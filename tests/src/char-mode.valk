test "char literals are characters, not decimal text" {
    let s = "abc\ndef"

    // A char literal reaching a String parameter used to become the decimal text
    // of its code point, so these silently found nothing.
    assert((s.index_of('\n') !? 999) == 3)
    assert(s.contains('\n'))
    assert(s.split('\n').length == 2)
    assert(("a-b-c".index_of('-') !? 999) == 1)

    // Concatenation appends the character itself.
    assert(("test" + '\n').length == 5)

    // Aliasing must not change the answer: after `let b = '\n'` there is nothing
    // left that could distinguish it from the literal.
    let nl = '\n'
    assert(("test" + nl).length == 5)
    assert((s.index_of(nl) !? 999) == 3)

    // A folded literal is stamped with the left operand's type, which must not
    // truncate a result that does not fit it.
    assert('\n' + 1000 == 1010)
    assert(1000 + '\n' == 1010)
    assert('a' + 1 == 'b')

    // Still a number where a number is wanted: byte positions, u8 parameters and
    // the explicit numeric rendering all keep working.
    assert(s.get(3) == '\n')
    assert('\n'.to(u8).to_string() == "10")
    let byte: u8 = '\n'
    assert(byte == 10)
}

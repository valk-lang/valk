use valk.thread

shared compound_total: int (3)
shared compound_product: u64 (1)

test "Compound assignment without an atomic instruction on shared storage" {
    compound_total *= 4
    compound_total /= 3
    compound_total %= 3
    assert(compound_total == 1)

    // Updates from several threads at once are not lost
    let group = thread.ThreadGroup[int].new()
    each 0 .. 4 as t {
        group.start(fn() int {
            each 0 .. 2000 as i : compound_product *= 3
            return 0
        }) !!
    }
    while group.has_pending() {
        group.await_next() ! break
    }
    let expected: u64 = 1
    each 0 .. 8000 as i : expected *= 3
    assert(compound_product == expected)
}

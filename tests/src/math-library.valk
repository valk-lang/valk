use valk.math

fn math_close(actual: float, expected: float, tolerance: float (0.000000000001)) bool {
    return (actual - expected).abs() <= tolerance
}

test "Math library and numeric helpers" {
    assert(math_close(math.sqrt(9), 3))
    assert(math_close(math.cbrt(27), 3))
    assert(math_close(math.pow(2, 10), 1024))
    assert(math_close(math.sin(math.PI / 2), 1))
    assert(math_close(math.cos(math.PI), -1))
    assert(math_close(math.tan(math.PI / 4), 1))
    assert(math_close(math.asin(1), math.PI / 2))
    assert(math_close(math.acos(-1), math.PI))
    assert(math_close(math.atan(1), math.PI / 4))
    assert(math_close(math.atan2(1, -1), math.PI * 3 / 4))
    assert(math_close(math.exp(1), math.E))
    assert(math_close(math.exp2(10), 1024))
    assert(math_close(math.log(math.E), 1))
    assert(math_close(math.log2(1024), 10))
    assert(math_close(math.log10(1000), 3))
    assert(math_close(math.hypot(3, 4), 5))
    assert(math_close(math.mod(-5.5, 2), -1.5))
    assert(math.floor(-1.2) == -2)
    assert(math.ceil(-1.2) == -1)
    assert(math.round(1.5) == 2)
    assert(math.round(-1.5) == -2)
    assert(math.trunc(-1.9) == -1)
    assert(math_close(math.TAU, math.PI * 2))

    assert((-5).abs() == 5)
    assert(5.to(u8).abs() == 5)
    assert((-5).min(2) == -5)
    assert((-5).max(2) == 2)
    assert(12.clamp(0, 10) == 10)
    assert((-2).clamp(0, 10) == 0)
    assert(7.clamp(0, 10) == 7)

    let zero: float = 0
    let nan = zero / zero
    let infinity = 1 / zero
    assert(nan.is_nan())
    assert(!nan.is_finite())
    assert(!nan.is_infinite())
    assert(infinity.is_infinite())
    assert(!infinity.is_finite())
    assert((1.5).is_finite())
    assert(nan.min(4) == 4)
    assert(nan.max(4) == 4)
    assert((-0.0).abs() == 0)
    assert(math.abs(-2.5) == 2.5)
    assert((2.0).to_string() == "2.00")

    let value32 = (-2.5).to(f32)
    let zero32 = 0.to(f32)
    assert(value32.abs() == 2.5.to(f32))
    assert(value32.clamp((-2).to(f32), 2.to(f32)) == (-2).to(f32))
    assert((zero32 / zero32).is_nan())
    assert(2.to(f32).to_string() == "2.00")
}

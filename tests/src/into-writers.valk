use valk.io
use valk.html
use valk.url
use valk.time
use valk.markdown
use valk.template
use valk.json
use valk.crypto

// A writer that is not a ByteBuffer, so the `_into` functions take their general path
class CountingWriter is io.Writer {
    out: ByteBuffer (.new())
    writes: uint (0)
    + fn write(data: local &[u8]) uint !io.IoError {
        this.writes++
        return this.out.write(data)
    }
}

test "into writers: a ByteBuffer is written directly, another writer in one write" {
    let buf = ByteBuffer.new()
    buf.write("<")
    assert((html.escape_into("a<b", buf) !!) == 6)
    assert(buf.to_string() == "<a&lt;b")

    let counting = CountingWriter {}
    assert((html.escape_into("a<b", counting) !!) == 6)
    assert(counting.out.to_string() == "a&lt;b")
    assert(counting.writes == 1)

    buf.clear()
    assert((url.encode_into("a b", buf) !!) == 5)
    assert(buf.to_string() == "a%20b")
    buf.clear()
    assert((url.decode_into("a%20b+c", buf) !!) == 5)
    assert(buf.to_string() == "a b c")

    let dt = time.DateTime.new(2024, 3, 5, 14, 7, 9) !!
    buf.clear()
    assert((dt.format_into("Y-m-d", buf) !!) == 10)
    assert(buf.to_string() == "2024-03-05")
    buf.clear()
    assert((dt.to_iso8601_into(buf) !!) == 20)
    assert(buf.to_string() == "2024-03-05T14:07:09Z")
    assert((dt.to_iso8601_into(counting) !!) == 20)
    assert(counting.writes == 2)

    buf.clear()
    let md_len = markdown.to_html_into("# Title", buf) !!
    assert(md_len == buf.length)
    assert(buf.to_string().contains("<h1>Title</h1>"))

    buf.clear()
    assert((json.encode_into(Array[int]{ 1, 2 }, buf) !!) == 5)
    assert(buf.to_string() == "[1,2]")
    buf.clear()
    assert((json.from(Map[String]{ "k" => "v" }).encode_into(buf) !!) == 9)
    assert(buf.to_string() == "{\"k\":\"v\"}")
    assert((json.encode_into(Array[int]{ 1 }, counting) !!) == 3)
    assert(counting.writes == 3)

    template.set_content("into-writers", "Hello {{ name }}!")
    buf.clear()
    let page = template.render_into("into-writers", Map[String]{ "name" => "valk" }, buf) !!
    assert(page == 11)
    assert(buf.to_string() == "Hello valk!")
    buf.clear()
    assert((template.render_content_into("x={{ x }}", Map[String]{ "x" => "1" }, buf) !!) == 3)
    assert(buf.to_string() == "x=1")
    assert((template.render_content_into("y", Map[String]{}, counting) !!) == 1)
    assert(counting.writes == 4)

    // Integers write their digits from a stack buffer
    buf.clear()
    assert((255.to_base_into(16, buf) !!) == 2)
    assert(buf.to_string() == "FF")
    buf.clear()
    let negative: int = -255
    assert((negative.to_base_into(16, buf, true) !!) == 3)
    assert(buf.to_string() == "-ff")
    assert((1024.to_base_into(2, counting) !!) == 11)
    assert(counting.out.to_string().ends_with("10000000000"))

    // The crypto family follows the same name
    buf.clear()
    assert((crypto.hex_encode_into(.{ 0xab }, buf) !!) == 2)
    assert(buf.to_string() == "ab")
}

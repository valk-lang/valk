use valk.http
use valk.net
use valk.time

fn client_request_is_rejected(method: String, url: String, options: ?http.Options (null), url_error: bool (false)) bool {
    http.create_request(method, url, options) ! {
        return url_error ? E.code == E.invalid_url : E.code == E.invalid_request
    }
    return false
}

fn client_wire_server(port: u16) {
    let server = net.Socket.server(net.SocketType.tcp, "127.0.0.1", port) ! return
    let connection = server.accept() ! return
    let buffer = ByteBuffer.new(4096)
    connection.recv(buffer, 4096) ! return
    let request = buffer.to_string()
    let response = "HTTP/1.1 200 OK\r\nContent-Length: " + request.bytes + "\r\n\r\n" + request
    connection.send_string(response, true) ! return
    time.sleep_ms(80)
    connection.close() ! return
    server.close() ! return
}

test "HTTP client rejects request injection and caller framing" {
    let base = "http://127.0.0.1:9033/"

    assert(client_request_is_rejected("", base))
    assert(client_request_is_rejected("GET\r\nX-Injected:", base))
    assert(client_request_is_rejected("G ET", base))

    assert(client_request_is_rejected("GET", base, http.Options {
        headers: Map[String]{ "X-Bad\r\nX-Injected" => "yes" }
    }))
    assert(client_request_is_rejected("GET", base, http.Options {
        headers: Map[String]{ "X-Bad" => "yes\r\nX-Injected: yes" }
    }))
    let nul_value = ByteBuffer.new()
    nul_value.write_string("yes")
    nul_value.write_byte(0)
    nul_value.write_string("hidden")
    assert(client_request_is_rejected("GET", base, http.Options {
        headers: Map[String]{ "X-Bad" => nul_value.to_string() }
    }))

    assert(client_request_is_rejected("POST", base, http.Options {
        headers: Map[String]{ "Host" => "attacker.example" }
    }))
    assert(client_request_is_rejected("POST", base, http.Options {
        headers: Map[String]{ "cOnTeNt-LeNgTh" => "0" }
    }))
    assert(client_request_is_rejected("POST", base, http.Options {
        headers: Map[String]{ "TRANSFER-ENCODING" => "chunked" }
    }))

    assert(client_request_is_rejected("GET", "http://127.0.0.1:9033/ok\r\nX-Injected: yes"))
    assert(client_request_is_rejected("GET", "http://127.0.0.1:9033/ok?q=yes\r\nX-Injected: yes"))
    assert(client_request_is_rejected("GET", "http://127.0.0.1\r\nX-Injected:yes/", null, true))
    assert(client_request_is_rejected("GET", "ftp://127.0.0.1/file", null, true))
    assert(client_request_is_rejected("GET", "http://127.0.0.1:0/", null, true))
    assert(client_request_is_rejected("GET", "http://127.0.0.1:65536/", null, true))
}

test "HTTP client owns framing headers on the wire" {
    co client_wire_server(9033)
    time.sleep_ms(60)

    let response = http.request("POST", "http://127.0.0.1:9033", http.Options {
        body: "hello"
        headers: Map[String]{
            "uSeR-aGeNt" => "custom-agent"
            "X-Safe" => "safe-value"
        }
    }) ! panic("raw request failed")
    let wire = response.body

    assert(wire.starts_with("POST / HTTP/1.1\r\n"))
    assert(wire.contains("Host: 127.0.0.1:9033\r\n"))
    assert(wire.contains("Content-Length: 5\r\n"))
    assert(wire.contains("uSeR-aGeNt: custom-agent\r\n"))
    assert(wire.contains("X-Safe: safe-value\r\n"))
    assert(!wire.contains("User-Agent: Valk http client"))
    assert(!wire.lower().contains("transfer-encoding:"))
    assert(wire.split("Content-Length:").length == 2)
    assert(wire.split("Host:").length == 2)
    assert(wire.ends_with("\r\n\r\nhello"))
}

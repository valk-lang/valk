
error Pay1 (error) payload {
    message1: String
}
error Pay2 (error) extends (Pay1) payload {
    message2: String ("")
    message3: String
}
error Pay3 (error) payload {
    message: String ("default-msg")
    count: int (7)
}

fn test_payload1() !Pay1 {
    throw .error { message1: "A" }
}
fn test_payload1b() !Pay1 {
    throw .error { message1: "B" }
}
fn test_payload2() !Pay2 {
    test_payload1() !>
}
fn test_payload3() !Pay2 {
    test_payload1() ! {
        test_payload1b() ! {
            assert(E.message1 == "B")
        }
        // message1 is passed from the caught Pay1 error; message2 uses its
        // explicit payload default; message3 must still be set.
        throw .error { message3: "C" }
    }
}
fn test_payload4() !Pay2 {
    test_payload1() ! throw .error { message1: "X", message2: "M2", message3: "C" }
}
fn test_payload_defaults() !Pay3 {
    // Both fields have explicit defaults and may be omitted.
    throw .error
}
fn test_payload_defaults_partial() !Pay3 {
    throw .error { message: "custom" }
}

test "Error payload" {
    // Passing Pay1 -> Pay2 with `!>` defaults the extra payload fields.
    test_payload2() ! {
        assert(E.message1 == "A")
        assert(E.message2 == "")
        assert(E.message3 == "")
    }
    test_payload3() ! {
        assert(E.message1 == "A")
        assert(E.message2 == "")
        assert(E.message3 == "C")
    }
    test_payload4() ! {
        assert(E.message1 == "X")
        assert(E.message2 == "M2")
        assert(E.message3 == "C")
    }
    test_payload_defaults() ! {
        assert(E.message == "default-msg")
        assert(E.count == 7)
    }
    test_payload_defaults_partial() ! {
        assert(E.message == "custom")
        assert(E.count == 7)
    }
}
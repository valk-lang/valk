
error Pay1 (error) payload {
    message1: String
}
error Pay2 (error) extends (Pay1) payload {
    message2: String ("")
    message3: String
}
error Pay2b (error) extends (Pay1) payload {
    message2: String ("")
    message3: String ("")
}
error Pay3 (error) payload {
    message: String ("default-msg")
    count: int (7)
}
// Sibling types sharing a parent payload global (not is_compat of each other).
error PayBase (base) payload {
    shared: String
}
error PayLeft (left) extends (PayBase) payload {
    left_only: String ("")
}
error PayRight (right) extends (PayBase) payload {
    right_only: String
}

fn test_payload1() !Pay1 {
    throw .error { message1: "A" }
}
fn test_payload1b() !Pay1 {
    throw .error { message1: "B" }
}
// message2 has an explicit default, message3 must be patched via rethrow.
fn test_payload2() !Pay2 {
    test_payload1() ! throw E { message3: "" }
}
// Extra fields all defaulted — pure pass is fine.
fn test_payload2b() !Pay2b {
    test_payload1() !>
}
fn test_payload3() !Pay2 {
    test_payload1() ! {
        test_payload1b() ! {
            assert(E.message1 == "B")
        }
        // Keep E's code; message1 from E (same global); message2 default; set message3.
        throw E { message3: "C" }
    }
}
fn test_payload4() !Pay2 {
    test_payload1() ! throw E { message1: "X", message2: "M2", message3: "C" }
}
// Throw a new code inside the handler; shared parent payload stays via same global.
fn test_payload_sibling() !PayLeft {
    throw .left { shared: "S" }
}
fn test_payload_sibling_wrap() !PayRight {
    test_payload_sibling() ! throw .right { right_only: "R" }
}
fn test_payload_defaults() !Pay3 {
    // Both fields have explicit defaults and may be omitted.
    throw .error
}
fn test_payload_defaults_partial() !Pay3 {
    throw .error { message: "custom" }
}

test "Error payload" {
    test_payload2() ! {
        assert(E.message1 == "A")
        assert(E.message2 == "")
        assert(E.message3 == "")
    }
    test_payload2b() ! {
        assert(E.message1 == "A")
        assert(E.message2 == "")
        assert(E.message3 == "")
    }
    test_payload3() ! {
        assert(E.message1 == "A")
        assert(E.message2 == "")
        assert(E.message3 == "C")
    }
    test_payload4() ! {
        assert(E.message1 == "X")
        assert(E.message2 == "M2")
        assert(E.message3 == "C")
    }
    test_payload_sibling_wrap() ! {
        assert(E.code == E.right)
        assert(E.shared == "S")
        assert(E.right_only == "R")
    }
    test_payload_defaults() ! {
        assert(E.message == "default-msg")
        assert(E.count == 7)
    }
    test_payload_defaults_partial() ! {
        assert(E.message == "custom")
        assert(E.count == 7)
    }
}
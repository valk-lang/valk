use valk.gc

class GenericIndexIterator {
    fn _next(index: $I) I !IterError {
        if index >= 3 : throw .end
        return index
    }
}
class GenericIteratorItem { number: int }
global generic_iterator_defaults: int (0)
fn generic_iterator_item() GenericIteratorItem {
    generic_iterator_defaults++
    return GenericIteratorItem { number: 73 }
}
class GenericDefaultIterator {
    fn _next(index: u8, value: $V (generic_iterator_item())) V !IterError {
        if index >= 2 : throw .end
        gc.collect()
        return value
    }
}
class GenericTupleIterator {
    fn _next(index: $I, value: $V (19)) (I, V) { return (index, value) }
}
class GenericClassIterator[T] {
    value: T
    fn _next(index: $I) T !IterError {
        if index >= 1 : throw .end
        return this.value
    }
}

test "Generic iterators: index inference matches a uint call" {
    let source = GenericIndexIterator {}
    let total: uint = 0
    let count = 0
    each source as value, index {
        assert(value == index && value == (source._next(index) !!))
        total += value
        count++
    }
    assert(total == 3 && count == 3)
}

test "Generic iterators: managed defaults infer the yielded type" {
    generic_iterator_defaults = 0
    let source = GenericDefaultIterator {}
    let values = Array[GenericIteratorItem]{}
    each source as value : values.append(value)
    gc.collect()
    assert(values.length == 2 && values[0].number == 73 && values[1].number == 73)
    assert(generic_iterator_defaults == 3)
    values[0].number = 79
    assert(values[1].number == 73)
}

test "Generic iterators: infallible tuple types are specialized before binding" {
    let source = GenericTupleIterator {}
    let total = 0
    each source as index_value, value, index {
        assert(index_value == index && value == 19)
        total += value
        if index == 2 : break
    }
    assert(total == 57)
}

test "Generic iterators: class generics and shared receivers keep their types" {
    let source = GenericClassIterator[String] { value: "value" }
    each source as value : assert(value == "value")
    let shared_source: shared GenericClassIterator[GenericIteratorItem] = .{ value: .{ number: 83 } }
    let direct = shared_source._next(0.to(uint)) !!
    assert(direct.number == 83)
    let count = 0
    each shared_source as value {
        value.number++
        count++
    }
    assert(count == 1 && shared_source.value.number == 84)
}

test "Generic iterators: locked receivers support direct calls and iteration" {
    let state: shared Lock[GenericClassIterator[GenericIteratorItem]] = .new(
        GenericClassIterator[GenericIteratorItem] { value: .{ number: 89 } }
    ) !!
    lock state as source {
        let direct = source._next(0.to(uint)) !!
        assert(direct.number == 89)
        each source as value : value.number = 97
        assert(direct.number == 97)
    }
}

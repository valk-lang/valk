use valk.crypto

test "Crypto: operating-system random bytes" {
    let empty = crypto.random_bytes(0)
    assert(empty.bytes == 0)

    let first = crypto.random_bytes(64)
    let second = crypto.random_bytes(64)
    assert(first.bytes == 64)
    assert(second.bytes == 64)
    assert(first != second)

    let number = uint.random()
    assert(number.to_string().length > 0)

    let typed_number = u64.random()
    assert(typed_number.to_string().length > 0)

    let text = String.random(64)
    assert(text.length == 64)
}

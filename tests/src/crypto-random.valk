use valk.crypto

test "Crypto: operating-system random bytes" {
    let empty = crypto.random_bytes(0) ! panic("zero-length random request failed")
    assert(empty.bytes == 0)

    let first = crypto.random_bytes(64) ! panic("random byte request failed")
    let second = crypto.random_bytes(64) ! panic("second random byte request failed")
    assert(first.bytes == 64)
    assert(second.bytes == 64)
    assert(first != second)

    let number = crypto.random_uint() ! panic("random uint request failed")
    assert(number.to_string().length > 0)

    let typed_number = u64.secure_random() ! panic("typed secure random failed")
    assert(typed_number.to_string().length > 0)

    let text = String.secure_random(64) ! panic("secure string random failed")
    assert(text.length == 64)
}


test "Numbers: mixed signedness widens below the pointer width and converts at full width" {
    let a32: u32 = u32.$max
    let b32: i32 = -1
    assert(a32 != b32)
    assert(a32 > b32)
    let a8: u8 = 255
    let b8: i8 = -1
    assert(a8 != b8)
    assert(a8 > b8)
    let amax: uint = uint.$max
    let bmax: int = -1
    assert(amax == bmax)
}

test "Numbers: round_down and round_up round toward the infinities" {
    assert((-5).round_down(4) == -8)
    assert((-5).round_up(4) == -4)
    assert((-8).round_down(4) == -8)
    assert((-8).round_up(4) == -8)
    assert((5).round_down(4) == 4)
    assert((5).round_up(4) == 8)
    assert((-5).round_down(-4) == -8)
    assert((5).round_up(-4) == 8)
    assert((0).round_down(4) == 0)
    let u: uint = 13
    assert(u.round_down(8) == 8)
    assert(u.round_up(8) == 16)
    let small: i8 = -127
    assert(small.round_down(4) == -128)
}

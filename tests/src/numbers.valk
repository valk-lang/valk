
test "Numbers: mixed signedness widens below the pointer width and converts at full width" {
    let a32: u32 = u32.$max
    let b32: i32 = -1
    assert(a32 != b32)
    assert(a32 > b32)
    let a8: u8 = 255
    let b8: i8 = -1
    assert(a8 != b8)
    assert(a8 > b8)
    let amax: uint = uint.$max
    let bmax: int = -1
    assert(amax == bmax)
}

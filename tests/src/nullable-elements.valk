enum NullableElementColor: u8 { red  green }

fn nullable_element_count(v: &[?u8]) uint {
    let n: uint = 0
    each v as x {
        if isset(x) : n++
    }
    return n
}

fn nullable_element_is_u8(v: $T) bool {
    #if T.$is_type_of(u8)
    return true
    #else
    return false
    #end
}

test "Nullable elements: arrays and slices of ?u8 and ?enum" {
    let arr = Array[?u8]{ null, 4 }
    assert(arr.length == 2)
    assert(!isset(arr[0]))
    assert((arr[1] ?? 0) == 4)
    let colors = Array[?NullableElementColor]{ null, NullableElementColor.green }
    assert(!isset(colors[0]))
    assert(colors[1] == NullableElementColor.green)
    let s = [?u8]{ null x 3 }
    s[1] = 4
    assert(nullable_element_count(s) == 1)
    let map = Map[?NullableElementColor]{}
    map.set("a", null)
    map.set("b", NullableElementColor.red)
    assert(!isset(map.get("a") !? null))
}

test "Nullable elements: $is_type_of tells ?T apart from T" {
    let plain: u8 = 1
    assert(nullable_element_is_u8(plain))
    let maybe: ?u8 = nullable_element_count([?u8]{ null x 1 }) == 0 ? 1 : null
    assert(!nullable_element_is_u8(maybe))
    assert(!nullable_element_is_u8(NullableElementColor.red))
}

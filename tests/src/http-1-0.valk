use valk.http
use valk.net

fn http10_handler(req: http.Request) http.Response {
    return http.Response.text("[" + req.path + "]")
}

// Reads until the server closes the connection or nothing arrives for a while
fn http10_read_to_close(connection: net.Connection) String {
    connection.read_timeout_ms = 2000
    let response = ByteBuffer.new(1024)
    let chunk = [u8]{ 0 x 1024 }
    let reads = 0
    while reads++ < 20 {
        let received = connection.read(chunk) ! break
        if received == 0 : break
        response.write(chunk.view(0, received))
    }
    return response.to_string()
}

fn http10_read_one(connection: net.Connection, marker: String) String {
    connection.read_timeout_ms = 2000
    let response = ByteBuffer.new(1024)
    let chunk = [u8]{ 0 x 1024 }
    let reads = 0
    while !response.to_string().contains(marker) && reads++ < 20 {
        let received = connection.read(chunk) ! break
        if received == 0 : break
        response.write(chunk.view(0, received))
    }
    return response.to_string()
}

test "HTTP: a 1.0 request needs no Host header and closes the connection" {
    let server = http.Server.new("127.0.0.1", 9197, http10_handler)
    let server_running = co server.start(1)
    defer stop_http_test_server(server, server_running)

    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9197) ! {
        assert(false)
        return
    }
    connection.write("GET /plain HTTP/1.0\r\n\r\n") ! {
        assert(false)
        return
    }
    let text = http10_read_to_close(connection)
    connection.close() ! {}

    assert(text.starts_with("HTTP/1.1 200 OK\r\n"))
    assert(text.contains("\r\nConnection: close\r\n"))
    assert(text.contains("\r\nContent-Length: 8\r\n"))
    assert(text.ends_with("\r\n\r\n[/plain]"))
}

test "HTTP: a 1.0 client that asks for keep-alive keeps the connection" {
    let server = http.Server.new("127.0.0.1", 9198, http10_handler)
    let server_running = co server.start(1)
    defer stop_http_test_server(server, server_running)

    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9198) ! {
        assert(false)
        return
    }
    connection.write("GET /first HTTP/1.0\r\nConnection: Keep-Alive\r\n\r\n") ! {
        assert(false)
        return
    }
    let first = http10_read_one(connection, "[/first]")
    assert(first.contains("\r\nConnection: keep-alive\r\n"))
    assert(!first.contains("Connection: close"))

    // The same connection serves the next request; this one ends it
    connection.write("GET /second HTTP/1.0\r\n\r\n") ! {
        assert(false)
        return
    }
    let second = http10_read_to_close(connection)
    connection.close() ! {}
    assert(second.contains("\r\nConnection: close\r\n"))
    assert(second.ends_with("[/second]"))
}

test "HTTP: a 1.1 request with Connection: close ends the connection" {
    let server = http.Server.new("127.0.0.1", 9199, http10_handler)
    let server_running = co server.start(1)
    defer stop_http_test_server(server, server_running)

    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9199) ! {
        assert(false)
        return
    }
    connection.write("GET /last HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n") ! {
        assert(false)
        return
    }
    let text = http10_read_to_close(connection)
    connection.close() ! {}
    assert(text.starts_with("HTTP/1.1 200 OK\r\n"))
    assert(text.contains("\r\nConnection: close\r\n"))
    assert(text.ends_with("[/last]"))
}

use valk:crypto

test "Md5" {
    assert(crypto:md5_encode("") == "d41d8cd98f00b204e9800998ecf8427e")
    assert(crypto:md5_encode("a") == "0cc175b9c0f1b6a831c399e269772661")
    assert(crypto:md5_encode("abc") == "900150983cd24fb0d6963f7d28e17f72")
    assert(crypto:md5_encode("message digest") == "f96b697d7cb7938d525a2f31aaf161d0")
    assert(crypto:md5_encode("abcdefghijklmnopqrstuvwxyz") == "c3fcd3d76192e4007dfb496cca67e13b")
    assert(crypto:md5_encode("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789") == "d174ab98d277d9f5a5611c2c9f419d9f")
}

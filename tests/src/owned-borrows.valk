use valk.gc

struct ObPayload {
    value: int
}

class ObOwner {
    payload: ObPayload
    values: [int x 4] ({ 1, 2, 3, 4 })
    name: String ("owner")

    fn gc_free() {
        ob_freed_owners++
    }
}

class ObHolder {
    ref: &ObPayload
    window: &[int]
    maybe: ?&ObPayload (null)
}

class ObNode {
    label: String
}

class ObNodeOwner {
    node: ObNode
}

class ObNodeHolder {
    node: &ObNode
}

struct ObNest {
    child: ?ObNode (null)
    count: int (0)
}

class ObNestOwner {
    nest: ObNest
}

class ObNestHolder {
    nest: &ObNest
}

fn ob_set_child(nest: stack ObNest, label: String) {
    nest.child = ObNode { label: label }
}

struct ObCell {
    child: ?ObNode (null)

    fn set(label: String) {
        this.child = ObNode { label: label }
    }
}

class ObCellOwner {
    cell: ObCell
}


global ob_freed_owners: uint
global ob_counter: int (5)

fn ob_borrow_payload(owner: ObOwner) &ObPayload {
    return &owner.payload
}

fn ob_read_through(payload: stack ObPayload) int {
    return payload.value
}

fn ob_sum(values: &[int]) int {
    let total = 0
    each values as value : total += value
    return total
}

fn ob_first_two(values: &[int]) &[int] {
    return values[0 .. 2]
}

fn ob_make_holder() ObHolder {
    let owner = ObOwner { payload: { value: 42 } }
    return ObHolder { ref: &owner.payload, window: &owner.values }
}

test "Owned borrows: stored in objects survive owner reassignment" {
    ob_freed_owners = 0
    let holder = ob_make_holder()
    gc.collect()
    gc.collect()
    assert(ob_freed_owners == 0)
    assert(holder.ref.value == 42)
    assert(holder.window.length == 4)
    assert(holder.window[0] == 1)
    assert(holder.window[3] == 4)
    assert(ob_sum(holder.window) == 10)
    let stored: &ObPayload = holder.ref
    assert(stored.value == 42)
    holder = ObHolder { ref: stored, window: holder.window }
    gc.collect()
    gc.collect()
    assert(holder.ref.value == 42)
}

test "Owned borrows: returned from functions and narrowed to stack borrows" {
    let owner = ObOwner { payload: { value: 3 } }
    let borrowed = ob_borrow_payload(owner)
    assert(borrowed.value == 3)
    assert(ob_read_through(borrowed) == 3)
    let narrowed: stack ObPayload = borrowed
    assert(narrowed.value == 3)
    borrowed.value = 9
    assert(owner.payload.value == 9)
    assert(narrowed.value == 9)
}

test "Owned borrows: implicit borrow of a property" {
    let owner = ObOwner { payload: { value: 12 } }
    let borrowed: &ObPayload = owner.payload
    let window: &[int] = owner.values
    owner = ObOwner { payload: { value: 1 } }
    gc.collect()
    gc.collect()
    assert(borrowed.value == 12)
    assert(window.length == 4)
    assert(window[1] == 2)
}

test "Owned borrows: nullable" {
    let owner = ObOwner { payload: { value: 42 } }
    let holder = ObHolder { ref: &owner.payload, window: &owner.values }
    assert(!isset(holder.maybe))
    holder.maybe = &owner.payload
    assert(isset(holder.maybe))
    let maybe = holder.maybe
    if isset(maybe) {
        assert(maybe.value == 42)
    } else {
        assert(false)
    }
    holder.maybe = null
    assert(!isset(holder.maybe))
    let none: ?&ObPayload = null
    assert(!isset(none))
    none = &owner.payload
    assert(isset(none))
}

test "Owned borrows: globals have no owner" {
    ob_counter = 5
    let borrowed: &int = &ob_counter
    assert(borrowed[0] == 5)
    borrowed[0] = 6
    assert(ob_counter == 6)
}

test "Owned borrows: equality compares addresses" {
    let owner = ObOwner { payload: { value: 1 } }
    let a = &owner.payload
    let b = &owner.payload
    let other = ObOwner { payload: { value: 1 } }
    let c = &other.payload
    assert(a == b)
    assert(a != c)
}

test "Owned borrows: slices from fixed arrays, ranges, and strings" {
    let owner = ObOwner { payload: { value: 0 } }
    let all: &[int] = &owner.values
    assert(all.length == 4)
    let tail = all[1 .. 3]
    assert(tail.length == 3)
    assert(tail[0] == 2)
    assert(tail[2] == 4)
    let front = ob_first_two(all)
    assert(front.length == 2)
    assert(front[1] == 2)
    tail[0] = 20
    assert(owner.values[1] == 20)

    let text: &[u8] = "hello"
    assert(text.length == 5)
    assert(text[1] == 'e')
    let count: uint = 0
    each text as ch, i {
        if i == 4 : assert(ch == 'o')
        count++
    }
    assert(count == 5)
    let bytes: &[u8] = text[1 .. 3]
    assert(bytes.length == 3)
    assert(bytes[0] == 'e')
    assert(bytes[2] == 'l')

    let numbers = Slice[int]{ 7, 8, 9 }
    let view: &[int] = numbers
    assert(view.length == 3)
    assert(view[2] == 9)
}

test "Owned borrows: managed values written through a borrow keep ownership" {
    let owner = ObNodeOwner { node: ObNode { label: "a" } }
    let node_ref: &ObNode = &owner.node
    node_ref[0] = ObNode { label: "x" }
    gc.collect()
    gc.collect()
    assert(owner.node.label == "x")
    assert(node_ref[0].label == "x")
    let holder = ObNodeHolder { node: &owner.node }
    holder.node[0] = ObNode { label: "z" }
    owner = ObNodeOwner { node: ObNode { label: "other" } }
    gc.collect()
    gc.collect()
    assert(holder.node[0].label == "z")
}

test "Owned borrows: managed properties written through a borrow keep ownership" {
    let owner = ObNestOwner { nest: {} }
    let nest: &ObNest = &owner.nest
    nest.child = ObNode { label: "a" }
    nest.count = 1
    gc.collect()
    gc.collect()
    let first = owner.nest.child
    assert(isset(first) && first.label == "a")
    assert(owner.nest.count == 1)

    // Through a stack borrow parameter: the owner word travels with it
    ob_set_child(nest, "b")
    gc.collect()
    gc.collect()
    let second = nest.child
    assert(isset(second) && second.label == "b")

    // Through a stack borrow variable narrowed from the owned one
    let narrowed: stack ObNest = nest
    narrowed.child = ObNode { label: "b2" }
    gc.collect()
    gc.collect()
    let second_again = owner.nest.child
    assert(isset(second_again) && second_again.label == "b2")

    // Through a borrow stored in another object, after the original variable moved on
    let holder = ObNestHolder { nest: &owner.nest }
    owner = ObNestOwner { nest: {} }
    holder.nest.child = ObNode { label: "c" }
    gc.collect()
    gc.collect()
    let third = holder.nest.child
    assert(isset(third) && third.label == "c")

    // Direct nested inline struct property
    owner.nest.child = ObNode { label: "d" }
    gc.collect()
    gc.collect()
    let fourth = owner.nest.child
    assert(isset(fourth) && fourth.label == "d")
}

test "Owned borrows: struct methods store through an owner-carrying receiver" {
    let owner = ObCellOwner { cell: {} }
    owner.cell.set("a")
    gc.collect()
    gc.collect()
    let first = owner.cell.child
    assert(isset(first) && first.label == "a")

    let local = ObCell {}
    local.set("frame")
    gc.collect()
    let frame_child = local.child
    assert(isset(frame_child) && frame_child.label == "frame")

    let holder = ObNestHolder { nest: &ObNestOwner { nest: {} }.nest }
    let cell_ref: &ObCell = &owner.cell
    cell_ref.set("c")
    owner = ObCellOwner { cell: {} }
    gc.collect()
    gc.collect()
    let third = cell_ref.child
    assert(isset(third) && third.label == "c")
    assert(isset(holder.nest))
}

test "Owned borrows: unsafe cast from a raw pointer has no owner" {
    @unsafe
    let value = 11
    let raw: ptr = &value
    let borrowed = raw.@cast(&int)
    assert(borrowed[0] == 11)
    borrowed[0] = 12
    assert(value == 12)
    let back: ptr = borrowed
    assert(back == raw)
}

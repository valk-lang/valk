
fn mr_test() (String, uint) {
    return ("hello", 10)
}
fn mr_test2() (String, uint) {
    return ("world", 20)
}

test "Multiple return values" {
    mr_test()
    // A single name would hold the whole tuple, so name each member
    let a1, _ = mr_test()
    assert(a1 == "hello")
    let a2, b2 = mr_test()
    assert(a2 == "hello")
    assert(b2 == 10)

    let a, b = fn()(String, uint) {
        let greeting = a1 + " world"
        let x, y = fn()(String, uint) {
            return (greeting, b2 + 1)
        }()
        return (x, y)
    }()
    assert(a == "hello world")
    assert(b == 11)








}

use valk.mem

struct Counter {
    total: uint (0)

    // Same name as a `ptr` extension method: the struct's own must win
    fn write(value: uint) {
        this.total += value
    }
    fn read() uint {
        return this.total
    }
}

class CounterHolder {
    counter: Counter (Counter {})

    fn bump_through_ref() {
        let p = @ref(this.counter)
        p.write(5)
        p.write(2)
    }
}

fn read_many(counters: *[Counter]) uint {
    @unsafe
    return counters[0].read()
}

test "@ref of struct storage is a typed struct pointer" {
    @unsafe
    let holder = CounterHolder {}
    holder.bump_through_ref()
    assert(holder.counter.read() == 7)

    let local = Counter {}
    let p = @ref(local)
    p.write(3)
    assert(local.read() == 3)

    // It still converts to the raw and array-pointer forms
    let many: *[Counter] = @ref(local)
    assert(read_many(many) == 3)
    assert(read_many(@ref(holder.counter)) == 7)
    let raw: ptr = @ref(local)
    mem.clear_bytes(raw, size_of(Counter))
    assert(local.read() == 0)
    assert(@ref(local).@cast(ptr) == raw)
}

class RefTypedCell {
    n: int (1)
}

class RefTypedHolder {
    cell: ?RefTypedCell (null)
}

fn ref_typed_sum(values: *[int], count: uint) int {
    @unsafe
    let total = 0
    each 0 .. count as i : total += values[i]
    return total
}

test "@ref of a T is a *T" {
    @unsafe
    let n = 5
    let pn: *int = @ref(n)
    pn[0] = 9
    assert(n == 9)

    let cell = RefTypedCell {}
    let pc: *RefTypedCell = @ref(cell)
    pc[0] = RefTypedCell { n: 4 }
    assert(cell.n == 4)

    let fixed: [int x 3] = { 1, 2, 3 }
    assert(ref_typed_sum(@ref(fixed), 3) == 6)
    assert(ref_typed_sum(@ref(fixed[1]), 2) == 5)

    let x : u32 = 0x01020304
    let bytes = @ref(x).@cast(*[u8 x 4])
    assert(bytes[0] == 4 || bytes[0] == 1)
}

test "@ref of a ?T is a *?T, also after isset" {
    @unsafe
    let x: ?RefTypedCell = RefTypedCell {}
    if !isset(x) : return
    let p: *?RefTypedCell = @ref(x)
    p[0] = null
    assert(!isset(x))

    let holder = RefTypedHolder { cell: RefTypedCell {} }
    if !isset(holder.cell) : return
    let hp: *?RefTypedCell = @ref(holder.cell)
    hp[0] = null
    assert(!isset(holder.cell))
}

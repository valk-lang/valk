use valk.gc

class CollectionHookItem {
    number: uint (23)
    + fn hash() uint $hash { return this.number }
}

class CollectionHookSlot {
    value: CollectionHookItem (.{})
    + fn get(index: uint) uint $offset { return this.value.number + index }
    + fn set(index: uint, value: CollectionHookItem) $offset_assign { this.value = value }
}

class CollectionHookCounter {
    count: int (0)
    group stats {
        fn increment() { this.count++ }
        get total: int { return this.count }
        fn read() int { return this.total }
    }
}

struct CollectionHookCell {
    count: int (0)
    group stats {
        fn increment() { this.count++ }
        fn next() { this.increment() }
    }
}
class CollectionHookCellOwner { cell: CollectionHookCell (.{}) }

class CollectionHookRaw {
    + fn get(index: ptr) bool $offset { return true }
    + fn set(index: uint, value: ptr) $offset_assign {}
    + fn append(value: ptr) $append {}
}

fn collection_read_pointer(value: *int) int { return value[0] }
fn collection_forward_pointer(value: *int) int { return collection_read_pointer(value) }
fn collection_recursive_pointer(value: *int, depth: uint) int {
    if depth == 0 : return value[0]
    return collection_recursive_pointer(value, depth - 1)
}

global collection_appended: int (0)
global collection_default_calls: uint (0)
fn collection_append_default() int {
    collection_default_calls++
    return 7
}
array CollectionHookArray of int {
    + fn append(value: int) $append { collection_appended = value }
}
array CollectionHookDefaultArray of int {
    + fn append(value: int, extra: int (collection_append_default())) $append {
        collection_appended = value + extra
    }
}

test "Collection hooks: native stores honor append signatures and defaults" {
    let values = CollectionHookArray {}
    values[0] = 73
    assert(collection_appended == 73)
    let defaulted = CollectionHookDefaultArray {}
    defaulted[0] = 79
    assert(collection_appended == 86)
    assert(collection_default_calls == 1)
}

test "Collection hooks: fresh stores remain publishable" {
    let items = Array[CollectionHookItem]{}
    items[0] = CollectionHookItem { number: 29 }
    items[0] = CollectionHookItem { number: 31 }
    let published: shared Array[CollectionHookItem] = items
    assert(published[0].number == 31)

    let slot = CollectionHookSlot {}
    slot[0] = CollectionHookItem { number: 37 }
    assert(slot[2] == 39)
    let shared_slot: shared CollectionHookSlot = slot
    assert(shared_slot[2] == 39)
}

test "Collection hooks: hashes read borrowed values and preserve uniqueness" {
    let item = CollectionHookItem {}
    assert($hash(item) == 23)
    let published: shared CollectionHookItem = item
    assert($hash(published) == 23)
    let slot = CollectionHookSlot {}
    let borrowed = &slot.value
    gc.collect()
    assert($hash(borrowed) == 23)
}

test "Collection hooks: grouped shared methods and getters" {
    let counter: shared CollectionHookCounter = CollectionHookCounter {}
    counter.stats.increment()
    assert(counter.stats.total == 1)
    assert(counter.stats.read() == 1)
    let increment = counter.stats.increment
    increment()
    assert(counter.stats.total == 2)
    let cell = CollectionHookCell {}
    let next = cell.stats.next
    next()
    assert(cell.count == 1)
    let owner = CollectionHookCellOwner {}
    let owned_next = owner.cell.stats.next
    gc.collect()
    owned_next()
    assert(owner.cell.count == 1)
}

test "Collection hooks: pointer calls respect their lifetime and unsafe scope" {
    let number = 41
    assert(collection_read_pointer(&number) == 41)
    assert(collection_forward_pointer(&number) == 41)
    assert(collection_recursive_pointer(&number, 3) == 41)
    let pointer: *int = &number
    @unsafe {
        let raw = CollectionHookRaw { pointer }
        raw[0] = pointer
        assert(raw[pointer])
    }
}

struct HookVec {
    x: float
    y: float
    fn scaled(f: float) HookVec $mul {
        return HookVec { x: this.x * f, y: this.y * f }
    }
    fn dot(other: HookVec) float $mul {
        return this.x * other.x + this.y * other.y
    }
    fn shrunk(f: float) HookVec $div {
        return HookVec { x: this.x / f, y: this.y / f }
    }
}

class HookMoney {
    cents: int
    fn times(n: int) HookMoney $mul {
        return HookMoney { cents: this.cents * n }
    }
    fn split(n: int) HookMoney $div {
        return HookMoney { cents: this.cents / n }
    }
}

test "Arithmetic hooks: $mul and $div" {
    let v = HookVec { x: 1.0, y: 2.0 }
    let w = v * 2.0
    assert(w.x == 2.0 && w.y == 4.0)
    // The hook is picked by the type on the right
    assert(v * w == 10.0)
    let h = w / 4.0
    assert(h.x == 0.5 && h.y == 1.0)

    let m = HookMoney { cents: 300 }
    m *= 3
    m /= 2
    assert(m.cents == 450)
    assert((HookMoney { cents: 10 } * 5).cents == 50)
}

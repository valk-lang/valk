use valk.net
use valk.sync
use valk.time
use valk.coro
use valk.io

fn udp_echo_once(server: net.UdpServer) bool {
    let buffer = [u8]{ 0 x 64 }
    let bytes, from = server.recv_from(buffer) ! return false
    server.send_to(buffer.view(0, bytes), from) ! return false
    return true
}

fn udp_round_trip(host: String, port: u16, ipv6: bool) {
    let server = net.udp_server(host, port) !!
    let bound = server.local_address() !!
    assert(bound.port == port)
    assert(bound.ipv6 == ipv6)

    let echo = co udp_echo_once(server)

    let client = net.udp_client(host, port) !!
    assert((client.local_address() !!).ipv6 == ipv6)
    assert((client.local_address() !!).port != 0)
    let sent = client.write("ping") !!
    assert(sent == 4)

    let buffer = [u8]{ 0 x 64 }
    let bytes = client.read(buffer) !!
    assert(bytes == 4)
    assert(buffer.view(0, 4).to_string() == "ping")
    assert(await echo)

    client.close() !!
    server.close() !!
}

test "UDP: IPv4 round trip" {
    udp_round_trip("127.0.0.1", 9300, false)
}

test "UDP: IPv6 round trip" {
    udp_round_trip("::1", 9301, true)
}

fn udp_echo_connected(server: net.UdpServer) bool {
    let buffer = [u8]{ 0 x 64 }
    let bytes, from = server.recv_from(buffer) ! return false
    server.send_to(buffer.view(0, bytes), from) ! return false
    return true
}

test "UDP: a client is a Reader and Writer" {
    let server = net.UdpServer.new("127.0.0.1", 9304) !!
    let echo = co udp_echo_connected(server)
    let client = net.UdpClient.new("127.0.0.1", 9304) !!
    let writer: io.Writer = client
    assert((writer.write("hello") !!) == 5)
    let reader: io.Reader = client
    let buffer = [u8]{ 0 x 64 }
    let bytes = reader.read(buffer) !!
    assert(buffer.view(0, bytes).to_string() == "hello")
    assert(await echo)
    client.close() !!
    server.close() !!
}

test "UDP: a client can choose its local port" {
    let server = net.udp_server("127.0.0.1", 9306) !!
    let client = net.udp_client("127.0.0.1", 9306, 5000, 9307) !!
    assert((client.local_address() !!).port == 9307)
    client.write("fixed") !!
    let buffer = [u8]{ 0 x 16 }
    let bytes, from = server.recv_from(buffer) !!
    assert(bytes == 5 && from.port == 9307)

    // The port is now taken
    let in_use = false
    net.udp_client("127.0.0.1", 9306, 5000, 9307) ! { in_use = error_is(E.code, port_in_use) }
    assert(in_use)
    client.close() !!
    server.close() !!
}

fn udp_wait_without_timeout(server: net.UdpServer) bool {
    let buffer = [u8]{ 0 x 16 }
    server.read_timeout_ms = 0
    server.recv_from(buffer) ! return error_is(E.code, closed)
    return false
}

test "UDP: close wakes a pending receive" {
    let server = net.udp_server("127.0.0.1", 9308) !!
    let waiting = co udp_wait_without_timeout(server)
    coro.await_last()
    time.sleep_ms(20)
    server.close() !!
    assert(await waiting)
}

fn udp_client_wait_without_timeout(client: net.UdpClient) bool {
    let buffer = [u8]{ 0 x 16 }
    client.read_timeout_ms = 0
    client.read(buffer) ! return error_is(E.code, closed)
    return false
}

test "UDP: close wakes a pending client read" {
    let client = net.udp_client("127.0.0.1", 9309) !!
    let waiting = co udp_client_wait_without_timeout(client)
    coro.await_last()
    time.sleep_ms(20)
    client.close() !!
    assert(await waiting)
}

test "UDP: options apply to both socket kinds" {
    let server = net.udp_server("127.0.0.1", 9311) !!
    server.set_broadcast(true) !!
    server.set_ttl(32) !!
    server.set_multicast_ttl(2) !!
    server.set_multicast_loopback(false) !!
    server.set_receive_buffer(65536) !!
    server.set_send_buffer(65536) !!
    let client = net.udp_client("127.0.0.1", 9311) !!
    client.set_broadcast(true) !!
    client.set_ttl(32) !!
    client.set_multicast_ttl(2) !!
    client.set_multicast_loopback(true) !!
    client.set_receive_buffer(65536) !!
    client.set_send_buffer(65536) !!
    assert((client.peer_address() !!).port == 9311)
    // A multicast interface must be an IPv4 address
    let invalid = false
    client.set_multicast_interface_v4("::1") ! { invalid = error_is(E.code, invalid_host) }
    assert(invalid)
    client.close() !!
    server.close() !!
}

test "UDP: reuse_address lets two servers share a port" {
    let first = net.udp_server("127.0.0.1", 9312, 5000, true) !!
    let second = net.udp_server("127.0.0.1", 9312, 5000, true) !!
    first.close() !!
    second.close() !!
}

test "UDP: a client can choose its local host" {
    let server = net.udp_server("127.0.0.1", 9313) !!
    let client = net.udp_client("127.0.0.1", 9313, 5000, 0, "127.0.0.1") !!
    assert((client.local_address() !!).ip() == "127.0.0.1")
    client.write("hi") !!
    let buffer = [u8]{ 0 x 8 }
    let bytes, from = server.recv_from(buffer) !!
    assert(bytes == 2 && from.ip() == "127.0.0.1")
    // The local host must be of the server's family
    let mismatch = false
    net.udp_client("127.0.0.1", 9313, 5000, 0, "::1") ! { mismatch = error_is(E.code, invalid_host) }
    assert(mismatch)
    client.close() !!
    server.close() !!
}

test "UDP: multicast over the loopback interface" {
    let server = net.udp_server("0.0.0.0", 9314, 5000, true) !!
    server.read_timeout_ms = 2000
    // Not every machine routes multicast over loopback; then the rest is skipped
    server.join_multicast_v4("224.0.0.251", "127.0.0.1") ! {
        server.close() !!
        return
    }
    let client = net.udp_client("224.0.0.251", 9314) !!
    client.set_multicast_interface_v4("127.0.0.1") !!
    client.set_multicast_loopback(true) !!
    client.write("group") ! {
        client.close() !!
        server.close() !!
        return
    }
    let buffer = [u8]{ 0 x 16 }
    let bytes, _ = server.recv_from(buffer) ! {
        // Sent, but not looped back on this machine (Wine does not): nothing to check
        assert(error_is(E.code, timeout))
        client.close() !!
        server.close() !!
        return
    }
    assert(buffer.view(0, bytes).to_string() == "group")
    server.leave_multicast_v4("224.0.0.251", "127.0.0.1") !!
    client.close() !!
    server.close() !!
}

fn udp_cancelled_recv(server: net.UdpServer) String {
    let buffer = [u8]{ 0 x 16 }
    server.recv_from(buffer) ! {
        if error_is(E.code, cancelled) : return "cancelled"
        if error_is(E.code, closed) : return "closed"
        if error_is(E.code, timeout) : return "timeout"
        if error_is(E.code, read) : return "read"
        return "error"
    }
    return "data"
}

fn udp_cancel_soon(token: shared sync.CancelToken, ms: uint) {
    time.sleep_ms(ms)
    token.cancel()
}

test "UDP: a cancel token interrupts a pending receive" {
    let server = net.udp_server("127.0.0.1", 9315) !!
    server.read_timeout_ms = 10000
    let token: shared sync.CancelToken = sync.CancelToken.new() !!
    server.set_cancel(token)
    let start = time.mono_ms()
    let cancel = co udp_cancel_soon(token, 50)
    let first = udp_cancelled_recv(server)
    assert(first == "cancelled")
    assert(time.mono_ms() - start < 3000)
    await cancel
    // Later calls fail right away
    let later = udp_cancelled_recv(server)
    assert(later == "cancelled")
    server.close() !!

    // An already cancelled token fails the first call on a client
    let client = net.udp_client("127.0.0.1", 9315) !!
    let done: shared sync.CancelToken = sync.CancelToken.new() !!
    done.cancel()
    client.set_cancel(done)
    let refused = false
    client.write("x") ! { refused = error_is(E.code, cancelled) }
    assert(refused)
    client.close() !!
}

test "UDP: receive times out" {
    let socket = net.udp_server("127.0.0.1", 9302) !!
    socket.read_timeout_ms = 20
    let buffer = [u8]{ 0 x 16 }
    let timed_out = false
    socket.recv_from(buffer) ! { timed_out = error_is(E.code, timeout) }
    assert(timed_out)
    socket.close() !!
}

test "UDP: system-assigned port and address formatting" {
    let socket = net.udp_server("127.0.0.1", 0) !!
    let bound = socket.local_address() !!
    assert(bound.port != 0)
    assert(bound.ip() == "127.0.0.1")
    assert(bound.to_string() == "127.0.0.1:" + bound.port)
    socket.close() !!

    let v6 = net.SocketAddress.parse("[::1]", 80) !!
    assert(v6.ipv6)
    assert(v6.ip() == "::1")
    assert(v6.to_string() == "[::1]:80")
    let full = net.SocketAddress.parse("2001:db8:0:0:1:0:0:1", 443) !!
    assert(full.ip() == "2001:db8::1:0:0:1")
    let none = net.SocketAddress.parse("fe80::", 1) !!
    assert(none.ip() == "fe80::")
    let v4 = net.SocketAddress.ipv4(10, 0, 0, 1, 53)
    assert(v4.to_string() == "10.0.0.1:53")
    assert(!v4.equals(v6))
    let mapped = net.SocketAddress.parse("::ffff:10.0.0.1", 53) !!
    // RFC 5952 §5 keeps the dotted quad of an IPv4-mapped address
    assert(mapped.ipv6 && mapped.ip() == "::ffff:10.0.0.1")
    assert(mapped.to_string() == "[::ffff:10.0.0.1]:53")

    let invalid = false
    net.SocketAddress.parse("not an address", 1) ! { invalid = true }
    assert(invalid)
}

fn tcp_v6_server(port: u16) bool {
    let server = net.tcp_server("::1", port) ! return false
    let connection = server.accept(3000) ! return false
    let buffer = [u8]{ 0 x 8 }
    let bytes = connection.read(buffer) ! return false
    connection.write(buffer.view(0, bytes)) ! return false
    connection.close() ! return false
    server.close() ! return false
    return true
}

test "Socket: TCP over IPv6" {
    let server = co tcp_v6_server(9303)
    let connection = net.tcp_client("[::1]", 9303) !!
    connection.write("hello") !!
    let buffer = [u8]{ 0 x 8 }
    let bytes = connection.read(buffer) !!
    assert(buffer.view(0, bytes).to_string() == "hello")
    connection.close() !!
    assert(await server)
}

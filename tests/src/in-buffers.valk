use valk.core
use valk.crypto
use valk.time
use valk.net

// Every `_in` form writes into a caller's buffer what the String form returns

fn text_of(view: local &[u8], len: uint) String {
    return view.view(0, len).to_string()
}

test "Buffers: integer and float _in forms match the String forms" {
    let buf: [u8 x 80] = @undefined
    let view: local mut &[u8] = &buf
    assert(core.INT_TEXT_SIZE == 65)
    let len = 255.to_base_in(view, 16)
    assert(text_of(view, len) == "FF")
    len = 255.to_base_in(view, 16, true)
    assert(text_of(view, len) == "ff")
    len = (-1234567890123).to_base_in(view, 10)
    assert(text_of(view, len) == "-1234567890123")
    len = u64.$max.to_base_in(view, 2)
    assert(len == 64)
    len = 0.to_base_in(view, 10)
    assert(text_of(view, len) == "0")
    len = 3.25.to_string_in(view, 3)
    assert(text_of(view, len) == "3.250")
    len = 1e21.to_shortest_string_in(view)
    assert(text_of(view, len) == "1e21")
}

test "Buffers: crypto _in forms" {
    let buf: [u8 x 128] = @undefined
    let out: local mut &[u8] = &buf
    let len = crypto.hex_encode_in("\x00\xab\xff", out)
    assert(text_of(out, len) == "00abff")
    len = crypto.hex_decode_in("00ABff", out) !? 0
    assert(text_of(out, len) == "\x00\xab\xff")
    crypto.hex_decode_in("abc", out) ! {
        assert(error_is(E.code, invalid_input))
    }
    len = crypto.sha256_hex_in("abc", out)
    assert(text_of(out, len) == crypto.sha256_hex("abc"))
    len = crypto.md5_hex_in("abc", out)
    assert(text_of(out, len) == crypto.md5_hex("abc"))
    len = crypto.sha512_hex_in("abc", out)
    assert(len == 128 && text_of(out, len) == crypto.sha512_hex("abc"))
    len = crypto.hash_in(crypto.HashAlgorithm.sha1, "abc", out)
    assert(len == 20 && text_of(out, len) == crypto.hash(crypto.HashAlgorithm.sha1, "abc"))
    assert(crypto.base64_encoded_size(0) == 0)
    assert(crypto.base64_encoded_size(1) == 4)
    assert(crypto.base64_encoded_size(3) == 4)
    assert(crypto.base64_encoded_size(4) == 8)
    assert(crypto.base64_decoded_size(4) == 3)
    assert(crypto.base64_decoded_size(8) == 6)
    len = crypto.base64_encode_in("Valk", out)
    assert(text_of(out, len) == "VmFsaw==")
    len = crypto.base64_decode_in("VmFsaw==", out) !? 0
    assert(text_of(out, len) == "Valk")
    len = crypto.base64_decode_in("VmFsaw", out) !? 0
    assert(text_of(out, len) == "Valk")
    crypto.base64_decode_in("Vm*saw", out) ! {
        assert(error_is(E.code, invalid_input))
    }
    let small: [u8 x 16] = { 0... }
    let random: local mut &[u8] = &small
    assert(crypto.random_bytes_in(random) == 16)
    let empty: [u8 x 1] = { 0 }
    let none: local mut &[u8] = &empty
    assert(crypto.random_bytes_in(none.view(0, 0)) == 0)
}

test "Buffers: DateTime _in forms" {
    let buf: [u8 x 64] = @undefined
    let out: local mut &[u8] = &buf
    let date = time.DateTime.new(2026, 3, 1, 14, 30, 5, 123_456) !!
    assert(time.ISO8601_TEXT_SIZE == 27)
    let len = date.to_iso8601_in(out)
    assert(len == 27 && text_of(out, len) == date.to_iso8601())
    let whole = time.DateTime.new(2026, 3, 1, 14, 30, 5) !!
    len = whole.to_iso8601_in(out)
    assert(text_of(out, len) == "2026-03-01T14:30:05Z")
    assert(time.DateTime.format_size("Y-m-d H:i:s.u") == 26)
    assert(time.DateTime.format_size("\\Y") == 1)
    len = date.format_in("Y-m-d H:i:s.u v \\Y", out)
    assert(text_of(out, len) == date.format("Y-m-d H:i:s.u v \\Y"))
    assert(len == time.DateTime.format_size("Y-m-d H:i:s.u v \\Y"))
}

test "Buffers: SocketAddress _in forms" {
    let buf: [u8 x 64] = @undefined
    let out: local mut &[u8] = &buf
    assert(net.ADDRESS_TEXT_SIZE == 64)
    let v4 = net.SocketAddress.ipv4(127, 0, 0, 1, 8080)
    let len = v4.ip_in(out)
    assert(text_of(out, len) == "127.0.0.1")
    len = v4.to_string_in(out)
    assert(text_of(out, len) == "127.0.0.1:8080")
    assert(v4.to_string() == "127.0.0.1:8080")
    let samples = Array[String]{ "::1", "2001:db8::ff00:42:8329", "fe80::1%2", "::ffff:192.168.0.1", "1:0:0:2:0:0:0:3", "0:0:0:0:0:0:0:0" }
    each samples as text {
        let address = net.SocketAddress.parse(text, 443) !!
        len = address.ip_in(out)
        assert(text_of(out, len) == address.ip())
        len = address.to_string_in(out)
        assert(text_of(out, len) == address.to_string())
        assert(address.to_string() == "[" + address.ip() + "]:443")
    }
    let long = net.SocketAddress.parse("ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff", 65535) !!
    len = long.to_string_in(out)
    assert(text_of(out, len) == "[ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff]:65535")
    assert(len == 47)
}

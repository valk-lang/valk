
use valk.json

fn json_bytes(bytes: Array[u8]) String {
    let output = ByteBuffer.new(bytes.length)
    each bytes as byte : output.write_byte(byte)
    return output.into_string()
}

fn json_utf8_rejected(document: String) bool {
    json.decode(document) ! return E.code == E.invalid && E.message == "Invalid UTF-8 in JSON string"
    return false
}

test "Json: decoding rejects malformed UTF-8 strings and keys" {
    assert(json_utf8_rejected(json_bytes(Array[u8]{ '"', 0x80, '"' })))
    assert(json_utf8_rejected(json_bytes(Array[u8]{ '"', 0xFF, '"' })))
    assert(json_utf8_rejected(json_bytes(Array[u8]{ '"', 0xC0, 0xAF, '"' })))
    assert(json_utf8_rejected(json_bytes(Array[u8]{ '"', 0xE0, 0x80, 0x80, '"' })))
    assert(json_utf8_rejected(json_bytes(Array[u8]{ '"', 0xE2, '(', 0xA1, '"' })))
    assert(json_utf8_rejected(json_bytes(Array[u8]{ '"', 0xE2, 0x82, '"' })))
    assert(json_utf8_rejected(json_bytes(Array[u8]{ '"', 0xED, 0xA0, 0x80, '"' })))
    assert(json_utf8_rejected(json_bytes(Array[u8]{ '"', 0xF4, 0x90, 0x80, 0x80, '"' })))
    assert(json_utf8_rejected(json_bytes(Array[u8]{ '{', '"', 0x80, '"', ':', '1', '}' })))
}

test "Json: encoding replaces malformed UTF-8 in strings and keys" {
    let malformed = json_bytes(Array[u8]{ 0x80, 0xFF, 0xC0, 0xAF, 0xED, 0xA0, 0x80 })
    let encoded = json.encode(malformed)
    assert(encoded == "\"\\ufffd\\ufffd\\ufffd\\ufffd\\ufffd\\ufffd\\ufffd\"")
    assert(json.decode(encoded) !! == "�������")

    let object = Map[String]{ malformed => "value" }
    let encoded_object = json.encode(object)
    let decoded_object = json.decode(encoded_object) !!
    assert(decoded_object.has("�������"))
}

use valk.gc
use valk.time

error CoroPayloadError (failed, other) payload {
    message: String ("")
    count: uint (0)
}
error CoroPayloadChild (child) extends(CoroPayloadError) payload {
    extra: int (0)
}

fn coro_payload_fail(message: String, count: uint, wait_ms: uint) !CoroPayloadError {
    if wait_ms > 0 : time.sleep_ms(wait_ms)
    throw .failed { message: message + "!", count: count }
}

fn coro_payload_child(extra: int) uint !CoroPayloadChild {
    throw .child { message: "child", count: 7, extra: extra }
}

fn coro_payload_pass() !CoroPayloadError {
    let task = co coro_payload_fail("inner", 3, 0)
    await task !>
}

test "Coroutine errors keep their payload until await" {
    let first = co coro_payload_fail("first", 1, 0)
    let second = co coro_payload_fail("second", 2, 0)
    // Both have failed; the payload globals hold the second's fields
    time.sleep_ms(5)
    gc.collect()
    let message = ""
    let count: uint = 0
    await first ! {
        message = E.message
        count = E.count
    }
    assert(message == "first!" && count == 1)
    await second ! {
        message = E.message
        count = E.count
    }
    assert(message == "second!" && count == 2)
}

test "Coroutine errors: inherited payload fields and !> through await" {
    let task = co coro_payload_child(-4)
    let extra = 0
    let count: uint = 0
    let value = await task ! {
        extra = E.extra
        count = E.count
        return
    }
    assert(value == 0)
    assert(extra == -4 && count == 7)

    let passed = co coro_payload_pass()
    let message = ""
    await passed ! { message = E.message }
    assert(message == "inner!")
}

fn coro_payload_await(task: co(!CoroPayloadError)) String {
    await task ! return E.message
    return ""
}

test "Coroutine errors: a task passed as a value keeps its payload" {
    let task = co coro_payload_fail("passed", 9, 1)
    let other = co coro_payload_fail("noise", 0, 0)
    await other _
    assert(coro_payload_await(task) == "passed!")
}

enum NullableIdentity: ?int { first (7)
    second (19)
    absent (null) }
class NullableIdentityHolder { value: NullableIdentity }
fn read_nullable_enum(value: ?int) int { return value ?? 0 }
fn produce_nullable_enum() NullableIdentity { return NullableIdentity.second }

test "Enums: nullable representations keep writable aliases nominal" {
    let holder = NullableIdentityHolder {}
    let alias = &holder.value
    assert(alias[0] == 7)
    alias[0] = NullableIdentity.second
    assert(holder.value == 19)
    alias[0] = NullableIdentity.absent
    assert(!isset(holder.value))
    let values = [NullableIdentity]{ NullableIdentity.first, NullableIdentity.absent }
    let view: mut &[NullableIdentity] = values
    view[0] = NullableIdentity.second
    assert(values[0] == 19 && !isset(values[1]))
}

test "Enums: nullable representations convert by value" {
    let plain: ?int = NullableIdentity.first
    assert(plain == 7)
    assert(read_nullable_enum(NullableIdentity.first) == 7)
    assert(read_nullable_enum(NullableIdentity.absent) == 0)
    let consumer: fn(NullableIdentity)(int) = read_nullable_enum
    assert(consumer(NullableIdentity.first) == 7)
    let producer: fn()(?int) = produce_nullable_enum
    assert(producer() == 19)
    let pair: fn()(NullableIdentity) = produce_nullable_enum
    assert(pair() == 19)
}

enum BorrowedEnumRow: [int x 2] { first ({ 7, 19 })
    second ({ 19, 7 }) }
class BorrowedEnumRowHolder { row: BorrowedEnumRow }
fn replace_enum_row(value: local mut &BorrowedEnumRow) {
    value[0] = BorrowedEnumRow.second
}

test "Enums: a fixed-array borrow retains the whole enum type" {
    let row = BorrowedEnumRow.first
    replace_enum_row(&row)
    assert(row[0] == 19 && row[1] == 7)
    let holder = BorrowedEnumRowHolder {}
    let borrowed = &holder.row
    assert(borrowed[0][0] == 7 && borrowed[0][1] == 19)
    borrowed[0] = BorrowedEnumRow.second
    assert(holder.row[0] == 19)
    let rows: mut &[BorrowedEnumRow] = &holder.row
    assert(rows.length == 1 && rows[0][0] == 19)
    rows[0] = BorrowedEnumRow.first
    assert(holder.row[0] == 7)
    let implicit_rows: &[BorrowedEnumRow] = holder.row
    assert(implicit_rows.length == 1 && implicit_rows[0][1] == 19)
    let copy: [int x 2] = row
    copy[0] = 73
    assert(copy[0] == 73 && row[0] == 19)
}

use valk.fs
use valk.core

test "fs: create_dir_all makes missing parents and accepts an existing directory" {
    let root = fs.create_temp_dir("valk-dirs-") !!
    let deep = fs.add(root, "a/b/c")
    fs.create_dir_all(deep) !!
    assert(fs.is_dir(deep))
    fs.create_dir_all(deep) !!
    fs.create_dir_all(fs.add(root, "a")) !!
    fs.write(fs.add(root, "file"), "x") !!
    let blocked = false
    fs.create_dir_all(fs.add(root, "file/sub")) ! { blocked = true }
    assert(blocked)
    fs.delete_all(root) !!
}

test "fs: temp directories and files get unique names" {
    let tmp = fs.temp_dir()
    assert(fs.is_dir(tmp))
    let a = fs.create_temp_dir() !!
    let b = fs.create_temp_dir("valk-test-") !!
    assert(a != b)
    assert(fs.is_dir(a) && fs.is_dir(b))
    assert(fs.basename(b).starts_with("valk-test-"))
    assert(fs.dir_of(a) == fs.resolve(tmp))

    let file = fs.create_temp_file("data-", ".json", b) !!
    assert(fs.is_file(file))
    assert(fs.dir_of(file) == b)
    assert(fs.basename(file).starts_with("data-") && file.ends_with(".json"))
    assert((fs.read(file) !!) == "")
    let other = fs.create_temp_file("data-", ".json", b) !!
    assert(other != file)
    #if OS != "win"
    assert(((fs.stat(file) !!).permissions & 0c777) == 0c600)
    assert(((fs.stat(b) !!).permissions & 0c777) == 0c700)
    #end
    fs.delete_all(a) !!
    fs.delete_all(b) !!
}

test "fs: relative gives the path from a base directory" {
    #if OS == "win"
    assert(fs.relative("C:\\a\\b\\c", "C:\\a\\d") == "..\\b\\c")
    assert(fs.relative("C:\\A\\b", "c:\\a") == "b")
    assert(fs.relative("D:\\x", "C:\\a") == "D:\\x")
    assert(fs.relative("C:\\a", "C:\\a\\b\\c") == "..\\..")
    #else
    assert(fs.relative("/a/b/c", "/a/d") == "../b/c")
    assert(fs.relative("/a/b", "/a/b") == ".")
    assert(fs.relative("/a/b/", "/a") == "b")
    assert(fs.relative("/a", "/a/b/c") == "../..")
    assert(fs.relative("/x/y", "/") == "x/y")
    assert(fs.relative("/", "/x") == "..")
    #end
    // Relative paths are taken against the current directory
    assert(fs.relative("sub/file", ".") == fs.add("sub", "file"))
}

test "fs: glob matches wildcards, sets and ** segments" {
    let root = fs.create_temp_dir("valk-glob-") !!
    fs.create_dir_all(fs.add(root, "src/deep/er")) !!
    fs.create_dir_all(fs.add(root, ".hidden")) !!
    each Array[String]{ "a.valk", "b.valk", "c.txt", "src/x.valk", "src/deep/y.valk", "src/deep/er/z.valk", ".dot.valk", ".hidden/h.valk", "file1", "file2", "fileA" } as name {
        fs.write(fs.add(root, name), name) !!
    }
    let names = fn(paths: Array[String]) String {
        let rel = Array[String]{}
        each paths as p : rel.append(fs.relative(p, root).replace("\\", "/"))
        return rel.join(",")
    }
    assert(names(fs.glob(fs.add(root, "*.valk"))) == "a.valk,b.valk")
    assert(names(fs.glob(fs.add(root, "**/*.valk"))) == "a.valk,b.valk,src/deep/er/z.valk,src/deep/y.valk,src/x.valk")
    assert(names(fs.glob(fs.add(root, "src/**/*.valk"))) == "src/deep/er/z.valk,src/deep/y.valk,src/x.valk")
    assert(names(fs.glob(fs.add(root, "src/*/y.valk"))) == "src/deep/y.valk")
    assert(names(fs.glob(fs.add(root, "file?"))) == "file1,file2,fileA")
    assert(names(fs.glob(fs.add(root, "file[0-9]"))) == "file1,file2")
    assert(names(fs.glob(fs.add(root, "file[!0-9]"))) == "fileA")
    assert(names(fs.glob(fs.add(root, ".*.valk"))) == ".dot.valk")
    assert(names(fs.glob(fs.add(root, ".hidden/*"))) == ".hidden/h.valk")
    assert(names(fs.glob(fs.add(root, "c.txt"))) == "c.txt")
    assert(fs.glob(fs.add(root, "missing/*.valk")).length == 0)
    assert(fs.glob(fs.add(root, "nothing*")).length == 0)

    // A relative pattern gives relative paths
    let before = fs.cwd() !!
    fs.chdir(root) !!
    let rel = fs.glob("src/*.valk")
    fs.chdir(before) !!
    assert(rel.length == 1)
    assert((rel.get(0) !? "").replace("\\", "/") == "src/x.valk")
    fs.delete_all(root) !!
}

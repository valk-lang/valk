
use valk.core

test "String: concat" {
    assert("test" + " " + "concat" == "test concat")
}

test "String: hash handles short, sampled and unaligned strings" {
    let keys = Map[uint]{}
    let hashes = HashMap[uint, bool]{}
    let key = ""
    let length: uint = 0
    while length <= 64 {
        keys.set(key, length)
        hashes.set(key.hash(), true)
        key += "x"
        length++
    }
    assert(keys.length == 65)
    assert(hashes.length == 65)

    let aligned = "abcdefghijklmnopqrstuvwx"
    let unaligned = "_abcdefghijklmnopqrstuvwx".part(1, 24)
    assert(aligned.hash() == unaligned.hash())
    assert("abcdefgh".hash() != "abcdefgi".hash())
    assert("abcdefghijklmnopq".hash() != "abcdefghijklmnopr".hash())
}

test "String: auto convert integers to string" {
    let n1 : String = -10203
    assert(n1 == "-10203")
    let n2 : String = 10203
    assert(n2 == "10203")
    let n3 : String = (31).to_hex()
    assert(n3 == "1F")
}

test "String: auto convert floats to string" {
    let v : String = -0.129
    assert(v == "-0.129")
    v = -1.40
    assert(v == "-1.4")
    v = -0.0
    assert(v == "0")
    v = 1.0
    assert(v == "1")
    v = 1.129
    assert(v == "1.129")
    v = 1.40
    assert(v == "1.4")
    v = (1.to(float) / 3)
    assert(v == "0.3333333333333333")
    v = 3.14159265358979
    assert(v == "3.14159265358979")
    v = 0.0001234
    assert(v == "0.0001234")
    v = 0.1 + 0.2
    assert(v == "0.30000000000000004")
    let scientific_value = 0.0000001234
    v = scientific_value
    assert(v == "1.234e-7")
    assert((v.to_float() !? 0.0) == scientific_value)

    let single_precision = 0.1.to(f32)
    v = single_precision
    assert(v == "0.1")
    assert((v.to_float() !? 0.0).to(f32) == single_precision)

    v = (-0.129).to_string(2)
    assert(v == "-0.13")
    v = 1.0.to_string(2)
    assert(v == "1.00")
    v = (1.to(float) / 3).to_string(0)
    assert(v == "0")
    v = (1.to(float) / 3).to_string(3)
    assert(v == "0.333")
    v = (1.to(float) / 3).to_string(4)
    assert(v == "0.3333")
    v = 0.333.to_string(4)
    assert(v == "0.3330")
    v = 0.9999.to_string(3)
    assert(v == "1.000")
    v = 99.9999.to_string(3)
    assert(v == "100.000")
    v = 99.8999.to_string(3)
    assert(v == "99.900")
    v = 99.99059.to_string(3)
    assert(v == "99.991")
    v = 19.02 / 1000
    assert(v == "0.01902")
}

test "String: format non-finite floats with decimals" {
    let zero = 0.0
    let nan = zero / zero
    let infinity = 1.0 / zero
    assert(nan.to_string(2) == "nan")
    assert(infinity.to_string(2) == "inf")
    assert((-infinity).to_string(2) == "-inf")

    let zero32 = zero.to(f32)
    let nan32 = zero32 / zero32
    let infinity32 = 1.to(f32) / zero32
    assert(nan32.to_string(2) == "nan")
    assert(infinity32.to_string(2) == "inf")
    assert((-infinity32).to_string(2) == "-inf")
}

test "String: starts/ends with" {
    assert("abc".starts_with("abc"))
    assert("abc".starts_with("ab"))
    assert("abc".starts_with(""))
    assert("abc".ends_with("abc"))
    assert("abc".ends_with("bc"))
    assert("abc".ends_with(""))
    assert("".ends_with(""))
    // Invalid
    assert(!"abc".starts_with("c"))
    assert(!"abc".starts_with("b"))
    assert(!"abc".ends_with("a"))
    assert(!"abc".ends_with("b"))
    assert(!"".ends_with("e"))
}

test "String: equal ignoring ASCII case" {
    assert("Content-Length".equal_ignore_ascii_case("content-length"))
    assert("USER-AGENT".equal_ignore_ascii_case("user-agent"))
    assert("".equal_ignore_ascii_case(""))
    assert(!"host".equal_ignore_ascii_case("hosts"))
    assert(!"content-type".equal_ignore_ascii_case("content_length"))
    assert(!"É".equal_ignore_ascii_case("é"))
}

test "String: length" {
    let data: *[u8] = "abc".data
    assert(data == "abc".@cast(ptr) + size_of(uint))
    let dynamic = "a" + "bc"
    assert(dynamic.data == dynamic.@cast(ptr) + size_of(uint))
    assert(data[1] == 'b')
    assert("".bytes == 0)
    assert("".utf8.length == 0)
    assert("abc".bytes == 3)
    assert("abc".utf8.length == 3)
    assert("a🐔c".bytes == 6)
    assert("a🐔c".utf8.length == 3)
}

test "String: index of" {
    assert(("a🐔c".index_of("") !? 999) == 0)
    assert(("a🐔c".utf8.index_of("") !? 999) == 0)
    assert(("a🐔c".index_of("c") !? 0) == 5)
    assert(("a🐔c".utf8.index_of("c") !? 0) == 2)
    assert(("a🐔c".index_of_byte('c') !? 0) == 5)
}

test "String: split" {
    let str = "a=🐔=b"
    let s = str.split("=")
    assert(s.length == 3)
    assert((s.get(0) !? "_") == "a")
    assert((s.get(1) !? "_") == "🐔")
    assert((s.get(2) !? "_") == "b")
    // too long
    s = str.split("valkvalkvalk")
    assert(s.length == 1)
    assert((s.get(0) !? "_") == str)
    // not found
    s = str.split("~")
    assert(s.length == 1)
    assert((s.get(0) !? "_") == str)
    // empty
    s = str.split("")
    assert(s.length == str.length)
    assert((s.get(0) !? "_") == "a")
    // next to eachother
    s = "==a==".split("=")
    assert(s.length == 5)
    assert((s.get(0) !? "_") == "")
    assert((s.get(1) !? "_") == "")
    assert((s.get(2) !? "_") == "a")
    assert((s.get(3) !? "_") == "")
    assert((s.get(4) !? "_") == "")
}

test "String: sub strings" {
    //
    assert("ab🐔cd".get(0) == 'a')
    assert("ab🐔cd".get(1) == 'b')
    assert("ab🐔cd"[0] == 'a')
    assert("ab🐔cd"[99] == 0)
    assert("ab🐔cd".utf8.get(0) == "a")
    assert("ab🐔cd".utf8.get(1) == "b")
    assert("ab🐔cd".utf8.get(2) == "🐔")
    //
    assert("".part(0, 1) == "")
    assert("".part(1, 1) == "")
    assert("ab🐔cd".utf8.part(1, 1) == "b")
    assert("ab🐔cd".utf8.part(3, 1) == "c")
    assert("ab🐔cd".utf8.part(1, 3) == "b🐔c")
    assert("ab🐔cd".utf8.part(1, 10) == "b🐔cd")
    //
    assert("".part(0, 1) == "")
    assert("".part(1, 1) == "")
    assert("ab🐔cd".part(1, 1) == "b")
    assert("ab🐔cd".part(6, 1) == "c")
    assert("ab🐔cd".part(1, 6) == "b🐔c")
    assert("ab🐔cd".part(1, 10) == "b🐔cd")
    assert("\"ab🐔\"".utf8.part(1, 3) == "ab🐔")
    let max: uint = 0
    max--
    assert("ab🐔cd".range(0, max) == "ab🐔cd")
    assert("ab🐔cd".range(2, max) == "🐔cd")
    assert("ab🐔cd".utf8.range(0, max) == "ab🐔cd")
    assert("ab🐔cd".utf8.range(2, max) == "🐔cd")
}

test "String: comparing" {
    assert("a" != "b")
    assert("a" != "")
    assert("" != "0")
    assert("" < "a")
    assert("a" < "b")
    assert("b" >= "b")
    assert("b" > "a")
    assert("a" <= "a")
    assert(!("a" < "a"))
    assert(!("" < ""))
    assert("a" < "aa")
    assert(!("aa" < "a"))
    assert("" == "")
}

test "String: empty trim and replacement patterns" {
    assert("abc".trim("") == "abc")
    assert("abc".ltrim("") == "abc")
    assert("abc".rtrim("") == "abc")
    assert("abc".replace("", "x") == "abc")
    assert("".replace("", "x") == "")
}

test "String: compile definitions" {
    assert(TEST == "1")
    assert(DEF_TEST == "TestValue")
    let version : String = "v" + DEF_TEST
    assert(version == "v" + DEF_TEST)
}

fn str_concat_test() int {
    return 16
}

test "String: %{}" {
    let a = 2
    let b = 5
    assert("a = %a" == "a = 2")
    assert("b = %b" == "b = 5")
    assert("a = %{a}" == "a = 2")
    assert("b = %{b}" == "b = 5")
    assert("a * b = %{a*b}" == "a * b = 10")
    assert("%{ a * str_concat_test() }" == "32")
    assert("%{a}%{b}" == "25")
    assert("%a%b" == "25")
    assert("\%{a}\%{b}" == "%" + "{a}" + "%" + "{b}")
    assert("\%a\%b" == "%" + "a" + "%" + "b")
    assert(r"%{a}%{b}" == "%" + "{a}" + "%" + "{b}")
    assert(r"%a%b" == "%" + "a" + "%" + "b")
}

test "String: compare nullables" {
    let a : ?String = "a" + "b"
    let b : ?String = "a" + "b"
    if false : a = null // Prevent compiler from knowing it's not null
    assert(a == b)
}

test "String: transform" {
    assert("AaZz".lower() == "aazz")
    assert("AaZz".upper() == "AAZZ")
    assert("HÉLLO ΚΌΣΜΟΣ ПРИВЕТ".lower() == "héllo κόσμος привет")
    assert("héllo κόσμος привет".upper() == "HÉLLO ΚΌΣΜΟΣ ПРИВЕТ")
    assert("Straße".upper() == "STRASSE")
    assert("İ".lower() == "i̇")
    assert("ΟΣ".lower() == "ος")
    assert("ΟΣΑ".lower() == "οσα")
    assert("AΣ'".lower() == "aς'")
    assert("AΣ'A".lower() == "aσ'a")
    assert("A'Σ".lower() == "a'ς")
    assert("A.Σ".lower() == "a.ς")
    assert("𐐀".lower() == "𐐨")
    assert("𐐨".upper() == "𐐀")
    assert("é".is_lower())
    assert("É".is_lower() == false)
    assert("É".is_upper())
    assert("é".is_upper() == false)
    assert("héllo".is_alpha())
    assert("κόσμος".is_alpha())
    assert("東京".is_alpha())
    assert("héllo42".is_alpha_numeric())
    assert("四二".is_alpha_numeric())
    assert("²".is_alpha_numeric())
    assert("²".is_alpha() == false)
    assert("hello-world".is_alpha("-"))
    assert("hello-world".is_alpha() == false)
}

test "String: Unicode transforms preserve truncated UTF-8" {
    let buf = ByteBuffer.new()
    buf.write_byte(0xF0)
    buf.write_byte(0x9F)
    let truncated = buf.into_string()
    assert(truncated.lower() == truncated)
    assert(truncated.upper() == truncated)
    assert(!truncated.is_alpha())
}

test "String: each" {
    let buf = ByteBuffer.new()
    let str = "abc"
    each str as ch, i {
        buf.write_byte(ch)
    }
    assert(buf.length == 3)
    assert(buf == "abc")
}

test "String: syntax" {
    // Include
    assert("AaZz".is_syntax("aA"))
    assert("AaZz".is_syntax("aA0"))
    assert("AaZz".is_syntax("aA0-"))
    assert("AaZz".is_syntax("a0") == false)
    assert("AaZz".is_syntax("0") == false)
    assert("AaZz".is_syntax("-") == false)
    assert("123".is_syntax("0"))
    assert("123a".is_syntax("0") == false)
    assert("123a".is_syntax("0a"))
    assert("---".is_syntax("-"))
    assert("-_-".is_syntax("-") == false)
    assert("-_-".is_syntax("-_"))
    // Exclude
    assert("AaZz".is_syntax("-", true))
    assert("AaZz".is_syntax("0", true))
    assert("AaZz".is_syntax("a", true) == false)
    assert("AaZz123".is_syntax("-0", true) == false)
}

test "String: padding" {


    let r = "ab".pad_right(' ', 5)
    assert(r.bytes == 5)
    assert(r == "ab   ")
    assert(@ptrv(r.data, u8, 2) == ' ')
    let l = "ab".pad_left('0', 5)
    assert(l.bytes == 5)
    assert(l == "000ab")
    // Nothing to add: the original comes back untouched
    assert("abcde".pad_right(' ', 5) == "abcde")
    assert("abcdef".pad_right(' ', 5) == "abcdef")
    assert("".pad_right('x', 3) == "xxx")
}

fn str_random_alphabet(n: uint) String {
    let buf = ByteBuffer.new(n + 8)
    let i: uint = 0
    while i < n {
        buf.write_byte((i % 256).to(u8))
        i++
    }
    return buf
}

// How many distinct byte values the text holds.
fn str_random_distinct(text: String) uint {
    let seen: [u8 x 256] = { 0... }
    let count: uint = 0
    let i: uint = 0
    while i < text.length {
        let b = @ptrv(text.data, u8, i)
        if seen[b] == 0 {
            seen[b] = 1
            count++
        }
        i++
    }
    return count
}

fn str_random_in_alphabet(text: String, size: uint) bool {
    let i: uint = 0
    while i < text.length {
        if @ptrv(text.data, u8, i) >= size : return false
        i++
    }
    return true
}

// (highest bin - lowest bin) * 100 / lowest bin, one bin per character of the alphabet.
fn str_random_spread(text: String, alphabet: String) uint {
    let bins: [uint x 256] = { 0... }
    let i: uint = 0
    while i < text.length {
        bins[@ptrv(text.data, u8, i)]++
        i++
    }
    let low: uint = 999999999
    let high: uint = 0
    let j: uint = 0
    while j < alphabet.length {
        let b = @ptrv(alphabet.data, u8, j)
        if bins[b] < low : low = bins[b]
        if bins[b] > high : high = bins[b]
        j++
    }
    return (high - low) * 100 / (low + 1)
}

test "String: escape covers control characters once" {
    assert("\n".escape() == "\\n")
    assert("\r".escape() == "\\r")
    assert("\t".escape() == "\\t")
    assert("\f".escape() == "\\f")
    assert("\b".escape() == "\\b")
    assert("\v".escape() == "\\v")
    assert("\a".escape() == "\\a")
    assert("\\".escape() == "\\\\")
    assert("\"".escape() == "\\\"")
    assert("a\\nb".unescape() == "a\nb")
}

test "String: UTF-8 stepping clamps explicit byte skips" {
    assert(core.char_step_skip_for_test("é", 1) == 1)
    assert(core.char_step_skip_for_test("é", 2) == 2)
    assert(core.char_step_skip_for_test("é", 100) == 2)
    assert(core.char_step_next_for_test("a") == 1)
    assert(core.char_step_next_for_test("é") == 2)
    assert(core.char_step_next_for_test("a🐔", 1) == 4)
}

test "String: random with more than 255 characters" {
    // characters.length went through a u8, so a 256-character alphabet was an alphabet of
    // zero and the reduction divided by it: String.random(16, <256 characters>) died with
    // SIGFPE (exit 136) rather than failing an assert, so reaching the last line here is
    // part of the proof.
    let wide = String.random(8000, str_random_alphabet(256))
    assert(wide.length == 8000)
    assert(str_random_distinct(wide) == 256)
    // 257 characters wrapped to 1: a single character was ever emitted. The draw count is
    // deliberately high — byte 0 is character 0 *and* character 256 here, so covering all
    // 256 values needs enough draws for the tail to show up reliably.
    let odd = String.random(8000, str_random_alphabet(257))
    assert(odd.length == 8000)
    assert(str_random_distinct(odd) == 256)
    assert(str_random_in_alphabet(odd, 257))
    // And a 296-character alphabet silently kept only its first 40 characters, so the 256
    // 'Z' tail below was unreachable.
    let tail = ByteBuffer.new(300)
    tail.write_string("abcdefghijklmnopqrstuvwxyz")
    tail.write_string("0123456789")
    tail.write_string("ABCD")
    let z: uint = 0
    while z < 256 {
        tail.write_byte('Z')
        z++
    }
    let alphabet = tail.into_string()
    assert(alphabet.length == 296)
    assert(String.random(400, alphabet).contains("Z"))
}

test "String: random with no characters returns an empty string" {
    assert(String.random(8, "") == "")
    assert(String.random(1, "") == "")
    assert(String.random(0, "") == "")
    assert(String.random(0, "abc") == "")
    // The zero-length cases need no guard of their own: `while len-- > 0` on a uint zero
    // does not underflow, the loop is simply not entered (measured).
    // A one-character alphabet is the other division-by-zero neighbour: it has to keep
    // producing that character, not nothing.
    assert(String.random(16, "x") == "xxxxxxxxxxxxxxxx")
    assert(String.random(5, "0123456789").length == 5)
}

test "String: random keeps the requested length and stays in the alphabet" {
    let letters = str_random_alphabet(62)
    let lengths = Array[uint]{ 1, 2, 3, 7, 16, 33, 64, 100, 999 }
    each lengths as n {
        let text = String.random(n, letters)
        assert(text.length == n)
        assert(str_random_in_alphabet(text, 62))
    }
    // Every power of two, including the lengths that used to wrap or divide unevenly.
    let sizes = Array[uint]{ 2, 4, 8, 16, 32, 64, 128, 256, 512, 1000 }
    each sizes as n {
        let text = String.random(2000, str_random_alphabet(n))
        assert(text.length == 2000)
        assert(str_random_in_alphabet(text, n))
    }
}

test "String: random is not skewed by the alphabet length" {
    // Statistical, with room on both sides. Reducing a byte modulo the alphabet put 41%
    // more draws on the luckiest of 62 characters (1791..2536 over 120000) and 9.9% on 10
    // (9426..10355 over 100000); a structural spread does not shrink with more draws.
    // Measured after the fix over 1000000 draws: 2.9% over 62 and 0.9% over 10.
    let letters = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    assert(str_random_spread(String.random(1000000, letters), letters) < 20)
    assert(str_random_spread(String.random(1000000, "0123456789"), "0123456789") < 5)
}

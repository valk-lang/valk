
fn test_fa_arg(x: *[int x 3]) {
    x[0] = 10
    assert(x[1] == 2)
}
fn test_fa_rett() [int x 3] {
    return [int x 3]{1, 2, 5}
}
fn test_fa_arg_rett(x: *[int x 3]) [int x 3] {
    x[0] = 11
    return x
}

type FixedArrayAlias ([int x 3])

fn fixed_alias_get(x: *FixedArrayAlias, index: uint) int {
    return x[index]
}

fn fixed_array_rett() [u8 x 4] {
    return {7...}
}

fn explicit_pointer_identity(value: ptr) ptr {
    return value.@cast(ptr)
}

unbound Chain[T] of T {}

test "Flat array in functions" {
    //
    let a = [int x 3]{1, 2, 3}
    test_fa_arg(a)
    assert(a[0] == 10)
    //
    let arg: [int x 3] = {1, 2, 3}
    test_fa_arg(arg)
    //
    let x = test_fa_rett()
    test_fa_arg(x)
    //
    let b = test_fa_rett()
    test_fa_arg(b)
    assert(b[0] == 10)
    assert(b[2] == 5)
    //
    let c: [int x 3] = {1, 2, 7}
    let d = test_fa_arg_rett(c)
    assert(c[0] == 11)
    assert(c[2] == 7)
    assert(d[0] == 11)
    assert(d[2] == 7)
    c[1] = 5
    assert(c[1] == 5)
    assert(d[1] == 2)
}

global fa_global : [int x 3] ({1, 2, 3})
struct FAS {
    data: [int x 3]
}

test "Flat array in structs" {
    let a = FAS {
        data: fa_global
    }
    assert(a.data[0] == 1)
    //
    let b = fa_global
    let c = FAS {
        data: b
    }
    assert(c.data[0] == 1)
}

test "Fixed arrays and unbound views" {
    let a: [u8 x 4] = {0...}
    a[3] = 9
    let b = a
    b[0] = 5
    assert(a[0] == 0)
    assert(a[3] == 9)
    assert(b[0] == 5)
    let c = fixed_array_rett()
    assert(c[0] == 7)
    assert(c[3] == 7)
    let text_storage: [u8 x 4] = {65, 0...}
    let text = @ref(text_storage).@cast(cstring[x 4])
    assert(text.length() == 1)
    let text_index: uint = 0
    assert(text[text_index] == 65)
    let chain_storage: [uint x 2] = {11, 12}
    let chain = @ref(chain_storage).@cast(Chain[uint][x 2])
    assert(chain[0] == 11)
    assert(chain[1] == 12)

    let aliased: FixedArrayAlias = {13, 14, 15}
    let index: uint = 1
    assert(fixed_alias_get(aliased, index) == 14)
}

global fixed_index_calls: uint (0)

fn fixed_next_index() uint {
    fixed_index_calls++
    return 1
}

test "Fixed array bounds checks evaluate indices once" {
    fixed_index_calls = 0
    let values: [u8 x 3] = {5, 6, 7}
    assert(values[fixed_next_index()] == 6)
    values[fixed_next_index()] = 9
    assert(values[1] == 9)
    assert(fixed_index_calls == 2)
}

test "Fixed arrays and bounded pointers iterate natively" {
    let values: [u8 x 4] = {2, 4, 6, 8}
    assert(values.length == 4)
    let total: uint = 0
    each values as value, index {
        total += value + index
    }
    assert(total == 26)

    let view: *[u8 x 4] = values
    assert(view.length == 4)
    let view_total: uint = 0
    each view skip 1 as value : view_total += value
    assert(view_total == 18)

    let start: uint = 1
    let part = values[start .. 2]
    assert(part.length == 2)
    assert(part[0] == 4)
    assert(part[1] == 6)

    fixed_index_calls = 0
    let checked_part = values[fixed_next_index() .. 2]
    assert(checked_part[0] == 4)
    assert(fixed_index_calls == 1)

    let explicit = explicit_pointer_identity(values)
    assert(@ptrv(explicit, u8, 2) == 6)
}
test "Narrow unsigned index" {
    // LLVM reads a getelementptr index as signed whatever its type says, so a
    // u8 index of 0x80 or more used to offset backwards out of the array.
    let map: [u8 x 256] = { 0... }
    map[10] = 110
    map[148] = 42
    map[255] = 7
    let a : u8 = 148
    let b : u8 = 255
    let c : u8 = 10
    let d : u16 = 148
    assert(map[a] == 42)
    assert(map[b] == 7)
    assert(map[c] == 110)
    assert(map[d] == 42)
    // Zero everywhere the map was not written, rather than whatever sat before
    // the array in memory.
    let i : uint = 0
    let nonzero : uint = 0
    while i < 256 {
        let idx : u8 = i.to(u8)
        if map[idx] > 0 : nonzero++
        i++
    }
    assert(nonzero == 3)
    // Pointer offsets take the same path as fixed-array indexing.
    let off : u8 = 200
    let base = @ref(map).@cast(ptr)
    assert(@ptrv(base.@offset(off), u8) == 0)
    map[200] = 99
    assert(@ptrv(base.@offset(off), u8) == 99)
}


fn test_fa_arg(x: *<@[int x 3]>) {
    x[0] = 10
    assert(x[1] == 2)
}
fn test_fa_rett() <@[int x 3]> {
    return <@[int x 3]>{1, 2, 5}
}
fn test_fa_arg_rett(x: *<@[int x 3]>) <@[int x 3]> {
    x[0] = 11
    return x
}

fn inline_unbound_rett() <@[u8 x 4]> {
    return {7...}
}

unbound InlineChain[T] of T {}

test "Flat array in functions" {
    //
    let a = <@[int x 3]>{1, 2, 3}
    test_fa_arg(a)
    assert(a[0] == 10)
    //
    let arg: <@[int x 3]> = {1, 2, 3}
    test_fa_arg(arg)
    //
    let x = test_fa_rett()
    test_fa_arg(x)
    //
    let b = test_fa_rett()
    test_fa_arg(b)
    assert(b[0] == 10)
    assert(b[2] == 5)
    //
    let c: <@[int x 3]> = {1, 2, 7}
    let d = test_fa_arg_rett(c)
    assert(c[0] == 11)
    assert(c[2] == 7)
    assert(d[0] == 11)
    assert(d[2] == 7)
    c[1] = 5
    assert(c[1] == 5)
    assert(d[1] == 2)
}

global fa_global : <@[int x 3]> ({1, 2, 3})
struct FAS {
    data: <@[int x 3]>
}

test "Flat array in structs" {
    let a = FAS {
        data: fa_global
    }
    assert(a.data[0] == 1)
    //
    let b = fa_global
    let c = FAS {
        data: b
    }
    assert(c.data[0] == 1)
}

test "Inline unbound sequences" {
    let a: <@[u8 x 4]> = {0...}
    a[3] = 9
    let b = a
    b[0] = 5
    assert(a[0] == 0)
    assert(a[3] == 9)
    assert(b[0] == 5)
    let c = inline_unbound_rett()
    assert(c[0] == 7)
    assert(c[3] == 7)
    let text: <cstring[x 4]> = {65, 0...}
    assert(text.length() == 1)
    let chain: <InlineChain[uint][x 2]> = {11, 12}
    assert(chain[0] == 11)
    assert(chain[1] == 12)
}
test "Narrow unsigned index" {
    // LLVM reads a getelementptr index as signed whatever its type says, so a
    // u8 index of 0x80 or more used to offset backwards out of the array.
    let map: <@[u8 x 256]> = { 0... }
    map[10] = 110
    map[148] = 42
    map[255] = 7
    let a : u8 = 148
    let b : u8 = 255
    let c : u8 = 10
    let d : u16 = 148
    assert(map[a] == 42)
    assert(map[b] == 7)
    assert(map[c] == 110)
    assert(map[d] == 42)
    // Zero everywhere the map was not written, rather than whatever sat before
    // the array in memory.
    let i : uint = 0
    let nonzero : uint = 0
    while i < 256 {
        let idx : u8 = i.to(u8)
        if map[idx] > 0 : nonzero++
        i++
    }
    assert(nonzero == 3)
    // Pointer offsets take the same path as fixed-array indexing.
    let off : u8 = 200
    let base = @ref(map).@cast(ptr)
    assert(@ptrv(base.@offset(off), u8) == 0)
    map[200] = 99
    assert(@ptrv(base.@offset(off), u8) == 99)
}

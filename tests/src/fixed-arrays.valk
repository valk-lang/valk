fn test_fa_arg(x: local mut &[int x 3]) {
    x[0] = 10
    assert(x[1] == 2)
}
fn test_fa_rett() [int x 3] {
    let r: [int x 3] = {1, 2, 5}
    return r
}
fn test_fa_arg_rett(x: local mut &[int x 3]) [int x 3] {
    x[0] = 11
    return x
}

type FixedArrayAlias ([int x 3])
// Aliases resolve in dependency order, not source order
type FixedAliasOfAlias (FixedAliasForward)
type FixedAliasForward (FixedArrayAlias)
alias fixed_alias_first for fixed_alias_second
alias fixed_alias_second for fixed_alias_get

test "Fixed array: alias chains in any order" {
    let arr: FixedAliasOfAlias = {4, 5, 6}
    assert(fixed_alias_first(arr, 2) == 6)
}

fn fixed_alias_get(x: local mut &FixedArrayAlias, index: uint) int {
    return x[index]
}

fn fixed_array_rett() [u8 x 4] {
    return .{7...}
}

fn raw_pointer_identity(value: ptr) ptr {
    return value
}

unbound Chain[T] of T {}

test "Flat array in functions" {
    //
    let a: [int x 3] = {1, 2, 3}
    test_fa_arg(a)
    assert(a[0] == 10)
    //
    let arg: [int x 3] = {1, 2, 3}
    test_fa_arg(arg)
    //
    let x = test_fa_rett()
    test_fa_arg(x)
    //
    let b = test_fa_rett()
    test_fa_arg(b)
    assert(b[0] == 10)
    assert(b[2] == 5)
    //
    let c: [int x 3] = {1, 2, 7}
    let d = test_fa_arg_rett(c)
    assert(c[0] == 11)
    assert(c[2] == 7)
    assert(d[0] == 11)
    assert(d[2] == 7)
    c[1] = 5
    assert(c[1] == 5)
    assert(d[1] == 2)
}

fn fa_typed_literal_rett() [u8 x 4] {
    return [u8 x 4]{ 1, 2, 3... }
}

test "Flat array typed literals" {
    let a = [int x 3]{ 1, 2, 3 }
    test_fa_arg(a)
    assert(a[0] == 10)
    assert(a[2] == 3)
    test_fa_arg([int x 3]{ 4, 2, 6 })
    let d = test_fa_arg_rett([int x 3]{ 7, 2, 9 })
    assert(d[0] == 11)
    assert(d[2] == 9)
    let r = fa_typed_literal_rett()
    assert(r[0] == 1)
    assert(r[3] == 3)
    let s = FAS{ data: [int x 3]{ 2, 4, 6 } }
    assert(s.data[1] == 4)
    let big = [u8 x 1000]{ 0... }
    assert(big[999] == 0)
}

global fa_global : [int x 3] ({1, 2, 3})
struct FAS {
    data: [int x 3]
}

test "Flat array in structs" {
    let a = FAS {
        data: fa_global
    }
    assert(a.data[0] == 1)
    //
    let b = fa_global
    let c = FAS {
        data: b
    }
    assert(c.data[0] == 1)
}

test "Fixed arrays and unbound views" {
    let a: [u8 x 4] = {0...}
    a[3] = 9
    let b = a
    b[0] = 5
    assert(a[0] == 0)
    assert(a[3] == 9)
    assert(b[0] == 5)
    let c = fixed_array_rett()
    assert(c[0] == 7)
    assert(c[3] == 7)
    let text_storage: [u8 x 4] = {65, 0...}
    let text: cstring[x 4] = &text_storage
    assert(text.length() == 1)
    let text_index: uint = 0
    assert(text[text_index] == 65)
    let chain_storage: [uint x 2] = {11, 12}
    let chain: Chain[uint][x 2] = &chain_storage
    assert(chain[0] == 11)
    assert(chain[1] == 12)

    let aliased: FixedArrayAlias = {13, 14, 15}
    let index: uint = 1
    assert(fixed_alias_get(aliased, index) == 14)
}

test "Unbound pointers allow arbitrary element offsets" {
    @unsafe
    let storage: [u8 x 101] = {0...}
    let data: *[u8] = &storage
    data[100] = 42
    assert(data[100] == 42)
    assert(storage[100] == 42)

    let words: [u32 x 2] = {10, 20}
    let word_data: *[u32] = &words
    word_data[1] = 30
    assert(words[0] == 10)
    assert(words[1] == 30)
}

global fixed_index_calls: uint (0)

fn fixed_next_index() uint {
    fixed_index_calls++
    return 1
}

test "Fixed array bounds checks evaluate indices once" {
    fixed_index_calls = 0
    let values: [u8 x 3] = {5, 6, 7}
    assert(values[fixed_next_index()] == 6)
    values[fixed_next_index()] = 9
    assert(values[1] == 9)
    assert(fixed_index_calls == 2)
}

test "Fixed arrays and bounded references iterate natively" {
    @unsafe
    let values: [u8 x 4] = {2, 4, 6, 8}
    assert(values.length == 4)
    let total: uint = 0
    each values as value, index {
        total += value + index
    }
    assert(total == 26)

    let view: local mut &[u8 x 4] = &values
    assert(view.length == 4)
    let pointer: *[u8 x 4] = view
    let unbound: *[u8] = view
    assert(pointer[3] == 8)
    assert(unbound[3] == 8)
    raw_pointer_identity(view)
    raw_pointer_identity(pointer)
    raw_pointer_identity(unbound)
    let view_total: uint = 0
    each view skip 1 as value : view_total += value
    assert(view_total == 18)

    let start: uint = 1
    let part = values[start .. 2]
    assert(part.length == 2)
    assert(part[0] == 4)
    assert(part[1] == 6)

    fixed_index_calls = 0
    let checked_part = values[fixed_next_index() .. 2]
    assert(checked_part[0] == 4)
    assert(fixed_index_calls == 1)

    let explicit = raw_pointer_identity(&values)
    assert(@ptrv(explicit, u8, 2) == 6)
}
test "Narrow unsigned index" {
    let map: [u8 x 256] = { 0... }
    map[10] = 110
    map[148] = 42
    map[255] = 7
    let a : u8 = 148
    let b : u8 = 255
    let c : u8 = 10
    let d : u16 = 148
    assert(map[a] == 42)
    assert(map[b] == 7)
    assert(map[c] == 110)
    assert(map[d] == 42)


    let i : uint = 0
    let nonzero : uint = 0
    while i < 256 {
        let idx : u8 = i.to(u8)
        if map[idx] > 0 : nonzero++
        i++
    }
    assert(nonzero == 3)
    // Pointer offsets take the same path as fixed-array indexing.
    let off : u8 = 200
    let base = @ref(map)
    assert(@ptrv(base.@offset(off), u8) == 0)
    map[200] = 99
    assert(@ptrv(base.@offset(off), u8) == 99)
}

class FixedItem { label: String }
union FixedItemUnion : FixedItem | int | [FixedItem x 2] {}

test "Fixed arrays of objects read out of containers" {
    // Each element's presence is checked part by part; the aggregate must
    // not be shared between the short-circuit blocks of that check
    let a = Array[FixedItemUnion]{ FixedItem{ label: "i" }, 3, [FixedItem x 2]{ FixedItem{ label: "f" }, FixedItem{ label: "g" } } }
    let out = ""
    each a as u {
        match u {
            FixedItem as it => out += it.label
            int as n => out += n.to(String)
            [FixedItem x 2] as f => out += f[0].label + f[1].label
        }
    }
    assert(out == "i3fg")

    let nested = Array[[[FixedItem x 2] x 2]]{
        [[FixedItem x 2] x 2]{
            [FixedItem x 2]{ FixedItem{ label: "a" }, FixedItem{ label: "b" } },
            [FixedItem x 2]{ FixedItem{ label: "c" }, FixedItem{ label: "d" } }
        }
    }
    let f = nested[0]
    assert(f[0][0].label + f[1][1].label == "ad")
}

struct BigBytes {
    data: [u8 x 65536]
    tag: int (3)
}

fn big_bytes_arg(x: local mut &BigBytes) int {
    x.data[100] = 9
    return x.data[65535].to(int) + x.tag
}

global fill_calls: int (0)
fn fill_value() int {
    fill_calls++
    return fill_calls
}

test "Fixed arrays: large zero and constant fills" {
    let big = BigBytes{}
    assert(big.data[0] == 0)
    assert(big.data[65535] == 0)
    assert(big.tag == 3)
    big.data[65535] = 5
    assert(big_bytes_arg(big) == 8)
    // Copies are by value
    let copy = big
    copy.data[1] = 2
    assert(big.data[1] == 0)
    assert(copy.data[1] == 2)
    assert(copy.data[100] == 9)

    let sevens: [u8 x 65536] = { 7... }
    assert(sevens[0] == 7)
    assert(sevens[65535] == 7)
    let mixed: [u8 x 65536] = { 1, 2, 250... }
    assert(mixed[0] == 1)
    assert(mixed[1] == 2)
    assert(mixed[2] == 250)
    assert(mixed[65535] == 250)
    let words: [int x 4096] = { -1... }
    assert(words[0] == -1)
    assert(words[4095] == -1)
    let cloned = sevens
    cloned[0] = 1
    assert(sevens[0] == 7)
    assert(cloned[0] == 1)
    assert(cloned[65535] == 7)
}

test "Fixed arrays: a fill value is evaluated once" {
    let filled: [int x 8] = { fill_value()... }
    assert(fill_calls == 1)
    assert(filled[0] == 1)
    assert(filled[7] == 1)
    let structs: [BigBytes x 2] = { BigBytes{ tag: 4 }... }
    assert(structs[1].tag == 4)
    assert(structs[1].data[65535] == 0)
}

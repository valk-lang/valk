use valk.gc
use valk.thread

type PointerClosureFunction (fnptr(int)(int))

class PointerClosureBox { number: int }
class PointerClosureLog { calls: int (0) }
struct PointerClosurePair {
    first: int
    second: int
}
error PointerClosureError (failed) payload { number: int }

fn pointer_closure_add(value: int) int { return value + 73 }
fn pointer_closure_sub(value: int) int { return value - 19 }
fn pointer_closure_select(log: PointerClosureLog) fnptr(int)(int) {
    log.calls++
    return log.calls % 2 == 1 ? pointer_closure_add : pointer_closure_sub
}

fn pointer_closure_convert(pointer: fnptr(int)(int)) fn(int)(int) {
    return pointer
}

fn pointer_closure_optional(log: PointerClosureLog, present: bool) ?fnptr(int)(int) {
    log.calls++
    return present ? pointer_closure_add : null
}

fn pointer_closure_managed(box: PointerClosureBox, number: u8, other: int) PointerClosureBox {
    gc.collect()
    return PointerClosureBox { number: box.number + number.to(int) + other }
}

fn pointer_closure_multiple(pair: PointerClosurePair, box: PointerClosureBox) (PointerClosureBox, PointerClosurePair) {
    return (box, PointerClosurePair { first: pair.second, second: pair.first })
}

fn pointer_closure_array(values: [int x 3]) [int x 3] {
    return .{ values[2], values[0], values[1] }
}

fn pointer_closure_fail(number: int) int !PointerClosureError {
    if number == 0 : throw .failed { number: 79 }
    return number + 1
}

fn pointer_closure_void(box: PointerClosureBox) { box.number++ }
fn pointer_closure_fallible_void(box: PointerClosureBox) !PointerClosureError {
    if box.number == 0 : throw .failed { number: 83 }
    box.number++
}

test "Function pointers: dynamic closures retain targets and evaluate once" {
    let log = PointerClosureLog {}
    let first: fn(int)(int) = pointer_closure_select(log)
    let second = pointer_closure_convert(pointer_closure_select(log))
    assert(log.calls == 2)
    assert(first(19) == 92)
    assert(second(73) == 54)
    let pointer: fnptr(int)(int) = pointer_closure_add
    let saved: fn(int)(int) = pointer
    pointer = pointer_closure_sub
    assert(saved(19) == 92)
    assert(pointer(19) == 0)
    let copied = first.clone()
    let copied_again = $clone(second)
    gc.collect()
    assert(copied(19) == 92)
    assert(copied_again(73) == 54)
    assert(await co copied(19) == 92)
}

test "Function pointers: closure adapters preserve argument and result layouts" {
    let pointer: fnptr(PointerClosureBox, u8, int)(PointerClosureBox) = pointer_closure_managed
    let closure: fn(PointerClosureBox, u8, int)(PointerClosureBox) = pointer
    assert(closure(PointerClosureBox { number: 41 }, 7, 19).number == 67)
    let multiple: fnptr(PointerClosurePair, PointerClosureBox)(PointerClosureBox, PointerClosurePair) = pointer_closure_multiple
    let multi: fn(PointerClosurePair, PointerClosureBox)(PointerClosureBox, PointerClosurePair) = multiple
    let box, pair = multi(PointerClosurePair { first: 7, second: 19 }, PointerClosureBox { number: 73 })
    assert(box.number == 73)
    assert(pair.first == 19 && pair.second == 7)
    let array: fnptr([int x 3])([int x 3]) = pointer_closure_array
    let array_closure: fn([int x 3])([int x 3]) = array
    let values = array_closure(.{ 7, 19, 73 })
    assert(values[0] == 73 && values[1] == 7 && values[2] == 19)
}

test "Function pointers: closure adapters forward errors and void results" {
    let pointer: fnptr(int)(int !PointerClosureError) = pointer_closure_fail
    let closure: fn(int)(int !PointerClosureError) = pointer
    assert((closure(73) !!) == 74)
    let error_number = 0
    closure(0) ! { error_number = E.number }
    assert(error_number == 79)
    let box = PointerClosureBox { number: 0 }
    let void_pointer: fnptr(PointerClosureBox)() = pointer_closure_void
    let void_closure: fn(PointerClosureBox)() = void_pointer
    void_closure(box)
    assert(box.number == 1)
    let fallible_pointer: fnptr(PointerClosureBox)(!PointerClosureError) = pointer_closure_fallible_void
    let fallible: fn(PointerClosureBox)(!PointerClosureError) = fallible_pointer
    fallible(box) !!
    assert(box.number == 2)
    box.number = 0
    fallible(box) ! { error_number = E.number }
    assert(error_number == 83)
}

test "Function pointers: nullable closure destinations and narrowed pointers" {
    let log = PointerClosureLog {}
    let missing: ?fn(int)(int) = pointer_closure_optional(log, false)
    assert(!isset(missing) && log.calls == 1)
    let present: ?fn(int)(int) = pointer_closure_optional(log, true)
    assert(isset(present) && present(19) == 92 && log.calls == 2)
    let pointer: ?fnptr(int)(int) = pointer_closure_add
    if isset(pointer) {
        let closure: ?fn(int)(int) = pointer
        assert(isset(closure) && closure(19) == 92)
    }
    let closure: ?fn(int)(int) = pointer_closure_convert(pointer_closure_add)
    assert(isset(closure) && closure(19) == 92)
    let literal: fnptr(int)(int) = fn(value: int) int { return value + 29 }
    let converted: fn(int)(int) = literal
    assert(converted(19) == 48)
    let known: fn(int)(int) = pointer_closure_add.to(PointerClosureFunction)
    assert(known(19) == 92)
    let known_literal: fn(int)(int) = (fn(value: int) int { return value + 29 }).to(PointerClosureFunction)
    assert(known_literal(19) == 48)
}

test "Function pointers: shared adapters retain no mutable captured graph" {
    let pointer: fnptr(int)(int) = pointer_closure_add
    let closure: shared fn(int)(int) = pointer
    let copied = closure.clone()
    gc.collect()
    assert(copied(19) == 92)
    let handler: shared fn()(int) = fn() int { return closure(19) }
    let worker = thread.Thread[int].start(handler) !!
    assert(worker.await() == 92)
    let known: shared fn(int)(int) = pointer_closure_add.to(PointerClosureFunction)
    assert(known(19) == 92)
}

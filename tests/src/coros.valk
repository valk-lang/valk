
use valk:coro
use valk:gc
use valk:time

global coro_test_str: String ("")

error TestCoroError (error)

fn coro_test() {
    coro_test_str += "_2"
    coro:await_last()
    coro_test_str += "_4"
}

fn coro_val(suffix: String) String {
    return "a" + suffix
}

fn coro_pair() (u8, bool) {
    return (7, true)
}

fn coro_throw() String !TestCoroError {
    throw .error
}

test "Coro: basics" {
    coro_test_str = "1"
    let coro = co coro_test()
    coro_test_str += "_3"
    await coro
    assert(coro_test_str == "1_2_3_4")
}

test "Coro: await" {
    let task = co coro_val("x")
    let res = await task
    assert(res == "ax")
}

test "Coro: multiple return values" {
    let task: co(u8, bool) = co coro_pair()
    let number, enabled = await task
    assert(number == 7)
    assert(enabled)
}

test "Coro: payload-free error" {
    let task = co coro_throw()
    let res = await task !? <{
        assert(error_is(E.code, error))
        return "z"
    }
    assert(res == "z")
}

global first_coro_stack_address: uint (0)
global second_coro_stack_address: uint (0)

fn record_coro_stack_address(first: bool) {
    let value: uint = first ? 1 : 2
    let before: uint = @ref(value)
    if first {
        first_coro_stack_address = before
    } else {
        second_coro_stack_address = before
    }
    coro:await_last()
    let after: uint = @ref(value)
    assert(after == before)
    assert(value == (first ? 1 : 2))
}

test "Coro: stacks are private and addresses survive suspension" {
    let first = co record_coro_stack_address(true)
    let second = co record_coro_stack_address(false)
    assert(first_coro_stack_address != 0)
    assert(second_coro_stack_address != 0)
    assert(first_coro_stack_address != second_coro_stack_address)
    await first
    await second
}

fn use_deep_coro_stack(depth: uint) uint {
    let page: [u8 x 4096] = {0...}
    page[0] = depth.to(u8)
    page[4095] = 1
    let nested = depth > 0 ? use_deep_coro_stack(depth - 1) : <{
        coro:await_last()
        return 0
    }
    return nested + page[0] + page[4095]
}

test "Coro: stacks grow beyond their initial working set" {
    let task = co use_deep_coro_stack(16)
    assert((await task) == 153)
}

global synctest_phase: uint (0)

test "Synctest: async batch item one" {
    time:sleep_ms(5)
    atomic(synctest_phase + 1)
}

test "Synctest: async batch item two" {
    time:sleep_ms(5)
    atomic(synctest_phase + 1)
}

synctest "Synctest: runs after the async batch" {
    assert(synctest_phase == 2)
}

global coro_leaks : uint (0)
class CoroLeak {
    value: String
    fn gc_free() { atomic(coro_leaks + 1) }
}

fn startcoro() co(String) {
    let l = CoroLeak{ value: "ABC" }
    let c = co fn() String {
        time:sleep_ms(10) // Give back control to parent function
        let z = l
        return z.value
    }()
    return c
}

synctest "Coro: closure leak" {
    let c = startcoro()
    assert(coro_leaks == 0)
    gc:collect()
    assert(coro_leaks == 0)
    let a = await c
    // assert(coro_leaks == 0)
    gc:collect()
    assert(coro_leaks == 1)
    assert(a == "ABC")
}

#if OS == "linux"
fn coro_sleep_once(ms: uint) {
    time:sleep_ms(ms)
}

test "Coro: concurrent io_uring timeouts keep stable arguments" {
    let sleepers = Array[co].new(32)
    let i: uint = 0
    while i < 32 {
        sleepers.append(co coro_sleep_once((i++ % 4) + 1))
    }
    each sleepers as sleeper {
        await sleeper
    }
}
#end

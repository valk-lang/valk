enum FoldU8: u8 {
    min (0)
    one (1)
    ten (10)
    top (128)
    max (255)
}

enum FoldU16: u16 {
    min (0)
    one (1)
    ten (10)
    top (32768)
    max (65535)
}

enum FoldU32: u32 {
    min (0)
    one (1)
    ten (10)
    top (2147483648)
    max (4294967295)
}

enum FoldU64: u64 {
    min (0)
    one (1)
    ten (10)
    top (9223372036854775808)
    max (18446744073709551615)
}

enum FoldI8: i8 {
    min (-128)
    one (1)
    ten (10)
    max (127)
}

enum FoldI16: i16 {
    min (-32768)
    one (1)
    ten (10)
    max (32767)
}

enum FoldI32: i32 {
    min (-2147483647 - 1)
    one (1)
    ten (10)
    max (2147483647)
}

enum FoldI64: i64 {
    min (-9223372036854775807 - 1)
    one (1)
    ten (10)
    max (9223372036854775807)
}

enum FoldWrapU8: u8 {
    zero (0)
    one (1)
    a (200)
    b (100)
    max (255)
}

enum FoldWrapI8: i8 {
    min (-128)
    a (100)
    b (100)
}

fn integer_fold_runtime(value: $T) T {
    return value
}

test "Unsigned integer folding matches runtime operations" {
    let u8_min = integer_fold_runtime(FoldU8.min)
    let u8_one = integer_fold_runtime(FoldU8.one)
    let u8_ten = integer_fold_runtime(FoldU8.ten)
    let u8_top = integer_fold_runtime(FoldU8.top)
    let u8_max = integer_fold_runtime(FoldU8.max)
    assert((FoldU8.min < FoldU8.top) == (u8_min < u8_top))
    assert((FoldU8.max > FoldU8.ten) == (u8_max > u8_ten))
    assert((FoldU8.top <= FoldU8.max) == (u8_top <= u8_max))
    assert((FoldU8.max >= FoldU8.max) == (u8_max >= u8_max))
    assert((FoldU8.max / FoldU8.ten).to(u8) == (u8_max / u8_ten).to(u8))
    assert((FoldU8.max % FoldU8.ten).to(u8) == (u8_max % u8_ten).to(u8))
    assert((FoldU8.max >> FoldU8.one).to(u8) == (u8_max >> u8_one).to(u8))

    let u16_min = integer_fold_runtime(FoldU16.min)
    let u16_one = integer_fold_runtime(FoldU16.one)
    let u16_ten = integer_fold_runtime(FoldU16.ten)
    let u16_top = integer_fold_runtime(FoldU16.top)
    let u16_max = integer_fold_runtime(FoldU16.max)
    assert((FoldU16.min < FoldU16.top) == (u16_min < u16_top))
    assert((FoldU16.max > FoldU16.ten) == (u16_max > u16_ten))
    assert((FoldU16.top <= FoldU16.max) == (u16_top <= u16_max))
    assert((FoldU16.max >= FoldU16.max) == (u16_max >= u16_max))
    assert((FoldU16.max / FoldU16.ten).to(u16) == (u16_max / u16_ten).to(u16))
    assert((FoldU16.max % FoldU16.ten).to(u16) == (u16_max % u16_ten).to(u16))
    assert((FoldU16.max >> FoldU16.one).to(u16) == (u16_max >> u16_one).to(u16))

    let u32_min = integer_fold_runtime(FoldU32.min)
    let u32_one = integer_fold_runtime(FoldU32.one)
    let u32_ten = integer_fold_runtime(FoldU32.ten)
    let u32_top = integer_fold_runtime(FoldU32.top)
    let u32_max = integer_fold_runtime(FoldU32.max)
    assert((FoldU32.min < FoldU32.top) == (u32_min < u32_top))
    assert((FoldU32.max > FoldU32.ten) == (u32_max > u32_ten))
    assert((FoldU32.top <= FoldU32.max) == (u32_top <= u32_max))
    assert((FoldU32.max >= FoldU32.max) == (u32_max >= u32_max))
    assert((FoldU32.max / FoldU32.ten).to(u32) == (u32_max / u32_ten).to(u32))
    assert((FoldU32.max % FoldU32.ten).to(u32) == (u32_max % u32_ten).to(u32))
    assert((FoldU32.max >> FoldU32.one).to(u32) == (u32_max >> u32_one).to(u32))

    let u64_min = integer_fold_runtime(FoldU64.min)
    let u64_one = integer_fold_runtime(FoldU64.one)
    let u64_ten = integer_fold_runtime(FoldU64.ten)
    let u64_top = integer_fold_runtime(FoldU64.top)
    let u64_max = integer_fold_runtime(FoldU64.max)
    assert((FoldU64.min < FoldU64.top) == (u64_min < u64_top))
    assert((FoldU64.max > FoldU64.ten) == (u64_max > u64_ten))
    assert((FoldU64.top <= FoldU64.max) == (u64_top <= u64_max))
    assert((FoldU64.max >= FoldU64.max) == (u64_max >= u64_max))
    assert((FoldU64.max / FoldU64.ten).to(u64) == (u64_max / u64_ten).to(u64))
    assert((FoldU64.max % FoldU64.ten).to(u64) == (u64_max % u64_ten).to(u64))
    assert((FoldU64.max >> FoldU64.one).to(u64) == (u64_max >> u64_one).to(u64))
    assert((FoldU64.max / FoldU64.one) > FoldU64.ten)
    assert((FoldU64.max >> FoldU64.min) > FoldU64.ten)
}

test "Signed integer folding matches runtime operations" {
    let i8_min = integer_fold_runtime(FoldI8.min)
    let i8_one = integer_fold_runtime(FoldI8.one)
    let i8_ten = integer_fold_runtime(FoldI8.ten)
    let i8_max = integer_fold_runtime(FoldI8.max)
    assert((FoldI8.min < FoldI8.ten) == (i8_min < i8_ten))
    assert((FoldI8.max > FoldI8.ten) == (i8_max > i8_ten))
    assert((FoldI8.min <= FoldI8.min) == (i8_min <= i8_min))
    assert((FoldI8.max >= FoldI8.max) == (i8_max >= i8_max))
    assert((FoldI8.min / FoldI8.ten).to(i8) == (i8_min / i8_ten).to(i8))
    assert((FoldI8.min % FoldI8.ten).to(i8) == (i8_min % i8_ten).to(i8))
    assert((FoldI8.min >> FoldI8.one).to(i8) == (i8_min >> i8_one).to(i8))

    let i16_min = integer_fold_runtime(FoldI16.min)
    let i16_one = integer_fold_runtime(FoldI16.one)
    let i16_ten = integer_fold_runtime(FoldI16.ten)
    let i16_max = integer_fold_runtime(FoldI16.max)
    assert((FoldI16.min < FoldI16.ten) == (i16_min < i16_ten))
    assert((FoldI16.max > FoldI16.ten) == (i16_max > i16_ten))
    assert((FoldI16.min <= FoldI16.min) == (i16_min <= i16_min))
    assert((FoldI16.max >= FoldI16.max) == (i16_max >= i16_max))
    assert((FoldI16.min / FoldI16.ten).to(i16) == (i16_min / i16_ten).to(i16))
    assert((FoldI16.min % FoldI16.ten).to(i16) == (i16_min % i16_ten).to(i16))
    assert((FoldI16.min >> FoldI16.one).to(i16) == (i16_min >> i16_one).to(i16))

    let i32_min = integer_fold_runtime(FoldI32.min)
    let i32_one = integer_fold_runtime(FoldI32.one)
    let i32_ten = integer_fold_runtime(FoldI32.ten)
    let i32_max = integer_fold_runtime(FoldI32.max)
    assert((FoldI32.min < FoldI32.ten) == (i32_min < i32_ten))
    assert((FoldI32.max > FoldI32.ten) == (i32_max > i32_ten))
    assert((FoldI32.min <= FoldI32.min) == (i32_min <= i32_min))
    assert((FoldI32.max >= FoldI32.max) == (i32_max >= i32_max))
    assert((FoldI32.min / FoldI32.ten).to(i32) == (i32_min / i32_ten).to(i32))
    assert((FoldI32.min % FoldI32.ten).to(i32) == (i32_min % i32_ten).to(i32))
    assert((FoldI32.min >> FoldI32.one).to(i32) == (i32_min >> i32_one).to(i32))

    let i64_min = integer_fold_runtime(FoldI64.min)
    let i64_one = integer_fold_runtime(FoldI64.one)
    let i64_ten = integer_fold_runtime(FoldI64.ten)
    let i64_max = integer_fold_runtime(FoldI64.max)
    assert((FoldI64.min < FoldI64.ten) == (i64_min < i64_ten))
    assert((FoldI64.max > FoldI64.ten) == (i64_max > i64_ten))
    assert((FoldI64.min <= FoldI64.min) == (i64_min <= i64_min))
    assert((FoldI64.max >= FoldI64.max) == (i64_max >= i64_max))
    assert((FoldI64.min / FoldI64.ten).to(i64) == (i64_min / i64_ten).to(i64))
    assert((FoldI64.min % FoldI64.ten).to(i64) == (i64_min % i64_ten).to(i64))
    assert((FoldI64.min >> FoldI64.one).to(i64) == (i64_min >> i64_one).to(i64))
}

test "Mixed signedness folding matches runtime operations" {
    let unsigned_max = integer_fold_runtime(FoldU64.max)
    let signed_one = integer_fold_runtime(FoldI64.one)
    assert((FoldU64.max > FoldI64.one) == (unsigned_max > signed_one))
    assert((FoldU64.max / FoldI64.one).to(u64) == (unsigned_max / signed_one).to(u64))
    assert((FoldU64.max % FoldI64.one).to(u64) == (unsigned_max % signed_one).to(u64))
    assert((FoldU64.max >> FoldI64.one).to(u64) == (unsigned_max >> signed_one).to(u64))
}

test "Narrow integer folding wraps to the operand width" {
    let ua = integer_fold_runtime(FoldWrapU8.a)
    let ub = integer_fold_runtime(FoldWrapU8.b)
    let uzero = integer_fold_runtime(FoldWrapU8.zero)
    let uone = integer_fold_runtime(FoldWrapU8.one)
    let umax = integer_fold_runtime(FoldWrapU8.max)

    assert((FoldWrapU8.a + FoldWrapU8.b).to(u8) == (ua + ub).to(u8))
    assert((FoldWrapU8.zero - FoldWrapU8.one).to(u8) == (uzero - uone).to(u8))
    assert((FoldWrapU8.a * FoldWrapU8.b).to(u8) == (ua * ub).to(u8))
    assert((FoldWrapU8.max << FoldWrapU8.one).to(u8) == (umax << uone).to(u8))
    assert((FoldWrapU8.a + FoldWrapU8.b) == 44)
    assert((FoldWrapU8.zero - FoldWrapU8.one) == 255)
    assert((FoldWrapU8.a * FoldWrapU8.b) == 32)
    assert((FoldWrapU8.max << FoldWrapU8.one) == 254)
    assert((~FoldWrapU8.zero) == FoldWrapU8.max)
    assert((~FoldWrapU8.zero).to(u8) == (~uzero).to(u8))

    let ia = integer_fold_runtime(FoldWrapI8.a)
    let ib = integer_fold_runtime(FoldWrapI8.b)
    let imin = integer_fold_runtime(FoldWrapI8.min)
    assert((FoldWrapI8.a + FoldWrapI8.b).to(i8) == (ia + ib).to(i8))
    assert((FoldWrapI8.a + FoldWrapI8.b) == -56)
    assert((-FoldWrapI8.min).to(i8) == (-imin).to(i8))
    assert((-FoldWrapI8.min) == FoldWrapI8.min)

    let ca = 'a'
    let cb = 'b'
    assert(('a' * 'b').to(u8) == (ca * cb).to(u8))
    assert(('a' * 'b').to(u8) == 34)

    assert((FoldU8.max + FoldU8.one) == FoldU8.min)
    assert((FoldU16.max + FoldU16.one) == FoldU16.min)
    assert((FoldU32.max + FoldU32.one) == FoldU32.min)
    assert((FoldU64.max + FoldU64.one) == FoldU64.min)
    assert((FoldI8.max + FoldI8.one) == FoldI8.min)
    assert((FoldI16.max + FoldI16.one) == FoldI16.min)
    assert((FoldI32.max + FoldI32.one) == FoldI32.min)
    assert((FoldI64.max + FoldI64.one) == FoldI64.min)

    let wrapped: u8 = FoldWrapU8.a + FoldWrapU8.b
    assert(wrapped == 44)
}

@ignore_access

#if OS == "macos"
use valk.coro
use valk.io
use valk.net
use valk.time
use valk.ext

fn macos_delayed_socket_server(port: u16, delay_ms: uint) {
    let server = net.Socket.server(net.SocketType.tcp, "127.0.0.1", port) ! return
    let connection = server.accept() ! return
    time.sleep_ms(delay_ms)
    connection.write("x") ! return
    connection.close() ! return
    server.close() ! return
}

fn macos_short_sleep() bool {
    time.sleep_ms(20)
    return true
}

test "macOS descriptor close notifies every registered waiter" {
    @unsafe
    let pipe: [i32 x 2] = { -1... }
    assert(ext.pipe(@ref(pipe)) == 0)
    let first = co io.await_fd(pipe[0], true, false, 1000)
    let second = co io.await_fd(pipe[0], true, false, 1000)
    coro.await_last()
    assert(ext.close(pipe[0]) == 0)
    let first_event = await first
    let second_event = await second
    assert(first_event.is_closed() && !first_event.is_timeout())
    assert(second_event.is_closed() && !second_event.is_timeout())
    assert(ext.close(pipe[1]) == 0)
}

test "macOS concurrent descriptor waiters both receive readiness" {
    let listener = net.Socket.server(net.SocketType.tcp, "127.0.0.1", 9095) !!
    let accepting = co listener.accept(1000)
    let client = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9095) !!
    let peer = await accepting !!
    let first = co io.await_socket_fd(client.fd, true, false, 1000)
    let second = co io.await_socket_fd(client.fd, true, false, 1000)
    coro.await_last()
    peer.write("x") !!
    let first_event = await first
    let second_event = await second
    assert(first_event.is_readable() && !first_event.is_timeout())
    assert(second_event.is_readable() && !second_event.is_timeout())
    client.close() !!
    peer.close() !!
    listener.close() !!
}

test "macOS timing out one accept preserves another waiter" {
    let listener = net.Socket.server(net.SocketType.tcp, "127.0.0.1", 9096) !!
    let accepting = co listener.accept(2000)
    coro.await_last()
    let timed_out = false
    listener.accept(10) ! { timed_out = error_is(E.code, timeout) }
    assert(timed_out)
    let client = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9096) !!
    let peer = await accepting !? null
    assert(isset(peer))
    if isset(peer) : peer.close() !!
    client.close() !!
    listener.close() !!
}

test "macOS no-timeout descriptor wait does not cancel another timer" {
    let server = co macos_delayed_socket_server(9048, 60)
    coro.await_last()
    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9048) ! {
        assert(false)
        return
    }

    io.prepare_no_timeout_timer_collision_for_test()
    let sleeper = co macos_short_sleep()
    let event = io.await_socket_fd(connection.fd, true, false)
    assert(event.is_readable())
    assert(await sleeper)

    let body = Slice[u8].new(1, 0)
    let received = connection.read(body) !? 0
    assert(body.view(0, received).to_string() == "x")
    connection.close() ! assert(false)
    await server
}

test "macOS descriptor wait registers read and write independently" {
    let server = co macos_delayed_socket_server(9049, 60)
    coro.await_last()
    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9049) ! {
        assert(false)
        return
    }

    // A connected socket is writable immediately, while the server delays its
    // byte beyond this timeout. Registering only the read filter would time out.
    let event = io.await_socket_fd(connection.fd, true, true, 20)
    assert(event.is_writable())
    assert(!event.is_timeout())

    await server
    connection.close() ! assert(false)
}
#end

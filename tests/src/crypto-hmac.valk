use valk.crypto

fn repeat(byte: u8, count: uint) String {
    let out = ByteBuffer.new(count)
    let i: uint = 0
    while i < count {
        out.write_byte(byte)
        i++
    }
    return out.to_string()
}

test "Sha512 and Sha384" {
    assert(crypto.sha512_hex("abc") == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
    assert(crypto.sha384_hex("abc") == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    assert(crypto.sha512_hex("") == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
    assert(crypto.sha512_hex(repeat('a', 1000)) == "67ba5535a46e3f86dbfbed8cbbaf0125c76ed549ff8b0b9e03e0c88cf90fa634fa7b12b47d77b694de488ace8d9a65967dc96df599727d3292a8d9d447709c97")
    assert(crypto.sha384_hex(repeat('a', 1000)) == "f54480689c6b0b11d0303285d9a81b21a93bca6ba5a1b4472765dca4da45ee328082d469c650cd3b61b16d3266ab8ced")
    // Padding boundaries
    assert(crypto.sha512_hex(repeat('x', 111)) == "9a2a120825c2319867758ec277924f6faa254968bf752046dacdd948d8ad299b10359fd04bfd7d3810b5fa1b16a294236138baff981cbb85248478053ac4d3dd")
    assert(crypto.sha512_hex(repeat('x', 112)) == "a3722b515ef40c910f2419f6e0da8ca51d410114ce6272faae64045f9e9f630e7fa8dd5a3243c9860b899d148c3da4bc0f9e07454542604d030bb55531fe0d5b")
    assert(crypto.sha512_hex(repeat('x', 119)) == "c5df60b24c746cdac9aa906938286db6f9dbb7c419beca41e8189652575b3bc11b6d95931d561179dff68cfbee1d4303ffca81dfe4c5d11f9bcaee2c191ea4be")
    assert(crypto.sha512_hex(repeat('x', 120)) == "13cdfbc65ba3c85548a7092021c6c0088c2fd745591fbb42dadbe00fbbc94d6894bcd7e9965fff3ab1481453c4b518c15b1938e2c01222ddf75a80c15cb82655")
    assert(crypto.sha512_hex(repeat('x', 127)) == "1d5a8893e7b7ed83d485d26f88cfb846f3760279916976fe538e539fc16f7cd19ba3e1c2cd5fda78749a74205755cdf694e8fa90b2bfed8815f406af76c1d7bf")
    assert(crypto.sha512_hex(repeat('x', 128)) == "e2e22f8422b54b06e35c3ea30a383d1de7a8fbc27992923074103117020d8dd7024c3ecf7d6d1a15a6de5a75ff32fb486b9e8ced4c02ffe05822bf2cb734d0e0")
    assert(crypto.sha512_hex(repeat('x', 129)) == "19015483ea99fa74728fd7b13adba6b729cfa4ab7c388573efa2641d2af0577f24dd51acbaeec41a7a11d10f6c4e68a3b90e7b2348c678486a4365c9d9101cdd")

    // Streaming in pieces gives the same digest, and reset starts over
    let h = crypto.Sha512 {}
    h.update("ab")
    h.update("c")
    let out = [u8]{ 0 x 64 }
    assert(h.finish(out) == 64)
    assert(crypto.hex_encode(out) == crypto.sha512_hex("abc"))
    h.reset()
    h.update("")
    h.finish(out)
    assert(crypto.hex_encode(out) == crypto.sha512_hex(""))
}

test "Hashers share one interface" {
    assert(crypto.hash_hex(crypto.HashAlgorithm.md5, "abc") == crypto.md5_hex("abc"))
    assert(crypto.hash_hex(crypto.HashAlgorithm.sha1, "abc") == crypto.sha1_hex("abc"))
    assert(crypto.hash_hex(crypto.HashAlgorithm.sha256, "abc") == crypto.sha256_hex("abc"))
    assert(crypto.hash_hex(crypto.HashAlgorithm.sha384, "abc") == crypto.sha384_hex("abc"))
    assert(crypto.hash_hex(crypto.HashAlgorithm.sha512, "abc") == crypto.sha512_hex("abc"))
    assert(crypto.hash(crypto.HashAlgorithm.sha256, "abc").length == 32)
    assert(crypto.digest_size(crypto.HashAlgorithm.sha384) == 48)

    // Streaming MD5 across block boundaries
    assert(crypto.hash_hex(crypto.HashAlgorithm.md5, repeat('x', 55)) == "04364420e25c512fd958a70738aa8f72")
    assert(crypto.hash_hex(crypto.HashAlgorithm.md5, repeat('x', 56)) == "668a72d5ba17f08e62dabcafad6db14b")
    assert(crypto.hash_hex(crypto.HashAlgorithm.md5, repeat('x', 63)) == "7dc2ca208106a2f703567bdff99d8981")
    assert(crypto.hash_hex(crypto.HashAlgorithm.md5, repeat('x', 64)) == "c1bb4f81d892b2d57947682aeb252456")
    assert(crypto.hash_hex(crypto.HashAlgorithm.md5, repeat('x', 65)) == "1bc932052302d074bdec39795fe00cf6")
    let md5 = crypto.hasher(crypto.HashAlgorithm.md5)
    md5.update(repeat('x', 30))
    md5.update(repeat('x', 35))
    let out = [u8]{ 0 x 16 }
    md5.finish(out)
    assert(crypto.hex_encode(out) == "1bc932052302d074bdec39795fe00cf6")

    // Sha256 and Sha1 through the interface, in pieces
    let sha = crypto.hasher(crypto.HashAlgorithm.sha256)
    sha.update("a")
    sha.update("bc")
    let out32 = [u8]{ 0 x 32 }
    assert(sha.finish(out32) == 32)
    assert(crypto.hex_encode(out32) == crypto.sha256_hex("abc"))
    assert(sha.block_size() == 64)
}

test "Hex and constant-time compare" {
    assert(crypto.hex_encode("") == "")
    assert(crypto.hex_encode("\x00\xffAB") == "00ff4142")
    assert((crypto.hex_decode("00ff4142") !? "bad") == "\x00\xffAB")
    assert((crypto.hex_decode("00FF4142") !? "bad") == "\x00\xffAB")
    assert((crypto.hex_decode("") !? "bad") == "")
    let odd = false
    crypto.hex_decode("abc") ! { odd = error_is(E.code, invalid_input) }
    assert(odd)
    let junk = false
    crypto.hex_decode("zz") ! { junk = error_is(E.code, invalid_input) }
    assert(junk)
    assert(crypto.constant_time_equals("abc", "abc"))
    assert(!crypto.constant_time_equals("abc", "abd"))
    assert(!crypto.constant_time_equals("abc", "ab"))
    assert(crypto.constant_time_equals("", ""))
}

test "Hmac" {
    let key = repeat(0x0b, 20)
    assert(crypto.Hmac.sign_hex(crypto.HashAlgorithm.sha256, key, "Hi There") == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    assert(crypto.Hmac.sign_hex(crypto.HashAlgorithm.sha512, key, "Hi There") == "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854")
    let fox = "The quick brown fox jumps over the lazy dog"
    assert(crypto.Hmac.sign_hex(crypto.HashAlgorithm.md5, "key", fox) == "80070713463e7749b90c2dc24911e275")
    assert(crypto.Hmac.sign_hex(crypto.HashAlgorithm.sha1, "key", fox) == "de7c9b85b8b78aa6bc8a7a36f70a90701c9db4d9")
    // Keys longer than a block are hashed first (RFC 4231 case 6)
    let long_key = repeat(0xaa, 131)
    let msg = "Test Using Larger Than Block-Size Key - Hash Key First"
    assert(crypto.Hmac.sign_hex(crypto.HashAlgorithm.sha256, long_key, msg) == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
    assert(crypto.Hmac.sign_hex(crypto.HashAlgorithm.sha384, long_key, msg) == "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952")

    // Streaming, reuse after reset, and verification
    let mac = crypto.Hmac.new(crypto.HashAlgorithm.sha256, key)
    mac.update("Hi ")
    mac.update("There")
    let out = [u8]{ 0 x 32 }
    assert(mac.finish(out) == 32)
    assert(crypto.hex_encode(out) == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    mac.reset()
    mac.update("Hi There")
    mac.finish(out)
    assert(crypto.hex_encode(out) == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    let raw = crypto.Hmac.sign(crypto.HashAlgorithm.sha256, key, "Hi There")
    assert(raw.length == 32)
    assert(crypto.Hmac.verify(crypto.HashAlgorithm.sha256, key, "Hi There", raw))
    assert(!crypto.Hmac.verify(crypto.HashAlgorithm.sha256, key, "Hi There!", raw))
    assert(!crypto.Hmac.verify(crypto.HashAlgorithm.sha256, "other", "Hi There", raw))
}

test "Pbkdf2" {
    let a = crypto.pbkdf2(crypto.HashAlgorithm.sha256, "password", "salt", 1, 32) !? ""
    assert(crypto.hex_encode(a) == "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b")
    let b = crypto.pbkdf2(crypto.HashAlgorithm.sha256, "passwordPASSWORDpassword", "saltSALTsaltSALTsaltSALTsaltSALTsalt", 4096, 40) !? ""
    assert(crypto.hex_encode(b) == "348c89dbcbd32b2f32d814b8116e84cf2b17347ebc1800181c4e2a1fb8dd53e1c635518c7dac47e9")
    let c = crypto.pbkdf2(crypto.HashAlgorithm.sha1, "password", "salt", 2, 20) !? ""
    assert(crypto.hex_encode(c) == "ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957")
    let d = crypto.pbkdf2(crypto.HashAlgorithm.sha512, "pw", "salt", 100, 100) !? ""
    assert(crypto.hex_encode(d) == "3a3c4d6f183d46cd82a4f3b4e774514d58ed3aaa574e317526d171232f2cf1c447fa18b5073b4e33060152b24d6e331e9294dc0e911167e49e53baae100736f2824750ff7572846cdf714eae35de985570213f1f6fc3f0ca89b11d136ddc7ed7af4d129c")
    let bad = false
    crypto.pbkdf2(crypto.HashAlgorithm.sha256, "pw", "salt", 0, 32) ! { bad = error_is(E.code, invalid_input) }
    assert(bad)
}

test "Hkdf" {
    let ikm = repeat(0x0b, 22)
    let salt = crypto.hex_decode("000102030405060708090a0b0c") !? ""
    let info = crypto.hex_decode("f0f1f2f3f4f5f6f7f8f9") !? ""
    let prk = crypto.hkdf_extract(crypto.HashAlgorithm.sha256, salt, ikm)
    assert(crypto.hex_encode(prk) == "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
    let okm = crypto.hkdf_expand(crypto.HashAlgorithm.sha256, prk, info, 42) !? ""
    assert(crypto.hex_encode(okm) == "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865")
    let one_shot = crypto.hkdf(crypto.HashAlgorithm.sha256, ikm, salt, info, 42) !? ""
    assert(one_shot == okm)
    // No salt and no info
    let bare = crypto.hkdf(crypto.HashAlgorithm.sha256, ikm, "", "", 42) !? ""
    assert(crypto.hex_encode(bare) == "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8")
    let long = crypto.hkdf(crypto.HashAlgorithm.sha512, "ikm", "s", "i", 100) !? ""
    assert(crypto.hex_encode(long) == "384ca59b65f0e18e1dd6bd5b2b9527406415610cb72ff04d2fa5fb49710b4e7b85f51e6ab38d944fd0ac6a63ff8343c83924d87c3c812059a94ff9f228479bc4258ffc248d350f1029a620af78094170ab33c9fb3af576b06805411537901fb0388687e2")
    let too_long = false
    crypto.hkdf_expand(crypto.HashAlgorithm.sha256, prk, "", 255 * 32 + 1) ! { too_long = error_is(E.code, invalid_input) }
    assert(too_long)
}

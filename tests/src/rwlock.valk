use valk.sync
use valk.thread
use valk.time

fn rw_coro_reader(rw: atomic sync.RwMutex, active: *uint, max_seen: *uint, done: *uint) {
    rw.read_lock()
    let now = atomic(active[0] + 1) + 1
    if now > max_seen[0] : max_seen[0] = now
    time.sleep_ms(20)
    atomic(active[0] - 1)
    atomic(done[0] + 1)
    rw.read_unlock()
}

fn rw_coro_writer(rw: atomic sync.RwMutex, active: *uint, done: *uint, ran: *bool) {
    time.sleep_ms(5)
    rw.write_lock()
    assert(atomic_load(active[0]) == 0)
    assert(atomic_load(done[0]) == 2)
    ran[0] = true
    rw.write_unlock()
}

test "RwMutex: concurrent readers overlap and writers are exclusive" {
    let rw: atomic sync.RwMutex = sync.RwMutex.new() !!
    let active_readers: uint = 0
    let max_readers: uint = 0
    let reader_done: uint = 0
    let writer_ran: bool = false

    let r1 = co rw_coro_reader(rw, @ref(active_readers), @ref(max_readers), @ref(reader_done))
    let r2 = co rw_coro_reader(rw, @ref(active_readers), @ref(max_readers), @ref(reader_done))
    let w1 = co rw_coro_writer(rw, @ref(active_readers), @ref(reader_done), @ref(writer_ran))

    await r1
    await r2
    await w1
    assert(max_readers == 2)
    assert(writer_ran)
}

fn rw_order_r1(rw: atomic sync.RwMutex, order: Array[String]) {
    rw.read_lock()
    order.append("r1-enter")
    time.sleep_ms(30)
    order.append("r1-exit")
    rw.read_unlock()
}

fn rw_order_w1(rw: atomic sync.RwMutex, order: Array[String]) {
    time.sleep_ms(5)
    order.append("w1-wait")
    rw.write_lock()
    order.append("w1-enter")
    time.sleep_ms(20)
    order.append("w1-exit")
    rw.write_unlock()
}

fn rw_order_r2(rw: atomic sync.RwMutex, order: Array[String]) {
    time.sleep_ms(15)
    order.append("r2-wait")
    rw.read_lock()
    order.append("r2-enter")
    rw.read_unlock()
}

test "RwMutex: writer waits for earlier reader, blocks later reader until unlocked" {
    let rw: atomic sync.RwMutex = sync.RwMutex.new() !!
    let order = Array[String]{}

    let r1 = co rw_order_r1(rw, order)
    let w1 = co rw_order_w1(rw, order)
    let r2 = co rw_order_r2(rw, order)

    await r1
    await w1
    await r2

    let w1_enter = order.index_of("w1-enter") !!
    let w1_exit = order.index_of("w1-exit") !!
    let r1_exit = order.index_of("r1-exit") !!
    let r2_enter = order.index_of("r2-enter") !!
    assert(r1_exit < w1_enter)
    assert(w1_exit < r2_enter)
}

test "RwLock: get, set, read, write and update" {
    let lock_val: atomic sync.RwLock[uint] = sync.RwLock[uint].new(10) !!
    assert(lock_val.get() == 10)
    assert(lock_val.read[uint](fn(v: uint) uint { return v * 2 }) == 20)
    assert(lock_val.update(fn(v: uint) uint { return v + 5 }) == 15)
    assert(lock_val.write[uint](fn(v: uint) uint { return v + 1 }) == 16)
    lock_val.set(42)
    assert(lock_val.get() == 42)
}

fn rw_thread_worker(state: atomic sync.RwLock[uint], sum: atomic sync.RwLock[uint]) {
    let i: uint = 0
    while i < 200 {
        state.update(fn(v: uint) uint { return v + 1 })
        let read_v = state.get()
        assert(read_v >= 1)
        if i % 10 == 0 {
            sum.update(fn(s: uint) uint { return s + 1 })
        }
        i++
    }
}

test "RwLock: threads read and write concurrently without lost updates" {
    let state: atomic sync.RwLock[uint] = sync.RwLock[uint].new(0) !!
    let sum: atomic sync.RwLock[uint] = sync.RwLock[uint].new(0) !!
    let workers = Array[thread.Thread[void]]{}
    let t: uint = 0
    while t < 4 {
        workers.append(thread.start(fn() { rw_thread_worker(state, sum) }) !!)
        t++
    }
    each workers as worker : worker.await()
    assert(state.get() == 800)
    assert(sum.get() == 80)
}

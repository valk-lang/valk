use valk.gc
use valk.json
use valk.thread

fn view_of(text: String) json.View {
    return json.read(text) ! panic("Invalid JSON: %text")
}

// The document must read exactly as decode does
fn same_as_decode(text: String) bool {
    let value = json.decode(text) ! return false
    return view_of(text).to_value().encode() == value.encode()
}

// Both parsers must refuse the input with the same error
fn same_error(text: String) bool {
    let code = 0
    let at: uint = 0
    let message = ""
    json.decode(text) ! {
        code = E.code == E.invalid ? 0 : (E.code == E.too_deep ? 1 : 2)
        at = E.at_index
        message = E.message
    }
    if message == "" : return false
    json.read(text) ! return (E.code == E.invalid ? 0 : (E.code == E.too_deep ? 1 : 2)) == code && E.at_index == at && E.message == message
    return false
}

fn many_members(count: uint) String {
    let buf = ByteBuffer.new(count * 12)
    buf.write_byte('{')
    each 0 .. count as i {
        if i > 0 : buf.write_byte(',')
        buf.write("\"m%i\":%i")
    }
    buf.write_byte('}')
    return buf.into_string()
}

test "Json view: reads every kind like decode" {
    let valid = Array[String]{
        "null", "true", "false", "0", "-0", "12", "-12", "1.5", "-1.5e3", "1E2", "3.0",
        "18446744073709551616", "\"\"", "\"text\"", "[]", "{}", "[[]]", "[{}]", "{\"a\":{}}",
        " [ 1 , 2.5 , \"x\" , null , true , [ false ] ] ",
        "{\"a\":1,\"b\":[1,{\"c\":\"d\"}],\"e\":null}",
        "\"a\\n\\t\\\"b\\\\\\/\\u00e9\\ud83d\\ude00\"",
        "{\"k\\ney\":1,\"caf\xc3\xa9\":2}",
        "\"caf\xc3\xa9\"",
        "{\"a\":1,\"a\":2}"
    }
    each valid as text : assert(same_as_decode(text))
}

test "Json view: refuses what decode refuses, with the same error" {
    let invalid = Array[String]{
        "", " ", "[", "]", "{", "}", "[1,", "[1 2]", "[,1]", "{\"a\"}", "{\"a\":}", "{\"a\":1,}",
        "{a:1}", "nul", "tru", "01", "-", "1.", "1e", "1e999", "\"abc", "\"\\x\"", "\"\\u12\"",
        "\"\x01\"", "\"\xff\"", "1 2", "[] x", "{\"\xff\":1}", "{\"a\\", "\"\\"
    }
    each invalid as text : assert(same_error(text))
}

test "Json view: the limits of decode apply" {
    let deep = "[".repeat(129)
    json.read(deep) ! {
        assert(E.code == E.too_deep)
    }
    assert(same_error(deep))
    assert(same_error("[".repeat(200000)))

    json.read("[".repeat(3) + "]".repeat(3), 2) ! assert(E.code == E.too_deep)
    json.read("[1,2,3]", 128, 3) ! assert(E.code == E.too_large)
    json.read("[1,2,3]", 128, 0, 2) ! assert(E.code == E.too_large)
    json.read("[1,2,3]", 128, 0, 3) ! assert(false)
}

test "Json view: lookups" {
    let root = view_of("{\"s\":\"text\",\"i\":7,\"f\":2.5,\"w\":3.0,\"t\":true,\"n\":null,\"a\":[10,20],\"o\":{\"x\":1}}")

    assert(root.kind == json.Kind.object)
    assert(root.length == 8)
    assert(root["s"].string == "text")
    assert(root["s"].length == 4)
    assert(root["s"].kind == json.Kind.string)
    assert((root["s"].string_value() !? "") == "text")
    assert(root["i"].int == 7)
    assert(root["i"].float == 7.0)
    assert(root["i"].kind == json.Kind.int)
    assert(root["f"].float == 2.5)
    assert(root["f"].int == 0)
    assert(root["w"].int == 3)
    assert((root["w"].int_value() !? 0) == 3)
    assert(root["t"].bool)
    assert(root["t"].bool_value() !? false)
    assert(root["n"].is_null)
    assert(root.has("n"))
    assert(root["i"].string == "7")
    assert(root["a"].string == "[10,20]")

    assert(root["a"].length == 2)
    assert(root["a"][1].int == 20)
    assert(root["a"].has(1))
    assert(!root["a"].has(2))
    assert(root["a"][2].is_null)
    assert(root["o"]["x"].int == 1)

    // Missing and mismatched keys read as null, as on a Value
    assert(root["nope"].is_null)
    assert(!root.has("nope"))
    assert(root["a"]["x"].is_null)
    assert(root[0].is_null)
    assert(root["i"]["x"].is_null)
    assert(root["nope"]["deeper"][0].is_null)

    root.get_required("nope") ! {
        assert(E.code == E.missing)
    }
    assert((root.get_required("i") ! panic("Missing")).int == 7)
    root["i"].string_value() ! assert(E.code == E.missing)
    root["s"].int_value() ! assert(E.code == E.missing)
    root["f"].int_value() ! assert(E.code == E.missing)
    root["s"].float_value() ! assert(E.code == E.missing)
    root["s"].bool_value() ! assert(E.code == E.missing)
}

test "Json view: each walks items and members in order" {
    let root = view_of("{\"a\":[1,2,3],\"b\\n\":\"x\",\"c\":{}}")

    let total = 0
    each root["a"] as item : total += item.int
    assert(total == 6)

    let names = ""
    each root as member, name : names += name.string + ":" + member.kind.to(int) + ";"
    assert(names == "a:%{json.Kind.array.to(int)};b\n:%{json.Kind.string.to(int)};c:%{json.Kind.object.to(int)};")

    let count = 0
    each root["c"] as _ : count++
    each root["a"][0] as _ : count++
    each root["missing"] as _ : count++
    assert(count == 0)
}

test "Json view: duplicate names, the last wins in small and large objects" {
    let small = view_of("{\"a\":1,\"b\":2,\"a\":3}")
    assert(small["a"].int == 3)
    assert(small.length == 3)
    assert(small.to_value().length == 2)

    let large = many_members(20)
    let dup = view_of(large[0 .. large.length - 1] + ",\"m3\":99}")
    assert(dup["m3"].int == 99)
    assert(dup["m19"].int == 19)
}

test "Json view: objects on both sides of the map threshold find every member" {
    each Array[uint]{ 15, 16, 17, 18, 500 } as count {
        let root = view_of(many_members(count))
        assert(root.length == count)
        each 0 .. count as i : assert(root["m%i"].int == i.to(int))
        assert(root["m%count"].is_null)
        assert(!root.has("m"))
        let seen: uint = 0
        each root as member, name {
            assert(name.string == "m%seen")
            assert(name.int == 0)
            assert(member.int == seen.to(int))
            seen++
        }
        assert(seen == count)
        assert(same_as_decode(many_members(count)))
    }
}

test "Json view: an escaped name is found by its decoded text" {
    let root = view_of("{\"a\\tb\":1,\"\\u0041\":2,\"caf\xc3\xa9\":3}")
    assert(root["a\tb"].int == 1)
    assert(root["A"].int == 2)
    assert(root["caf\xc3\xa9"].int == 3)
    assert(!root.has("a\\tb"))
    assert(root["\\u0041"].is_null)
}

fn view_that_outlives_its_input() json.View {
    let text = "{\"items\":[" + "\"x\\n\"," + "{\"deep\":\"value\"}]}"
    return view_of(text)["items"]
}

test "Json view: a node keeps its document and input alive through collections" {
    let items = view_that_outlives_its_input()
    let garbage = Array[String]{}
    each 0 .. 100000 as i {
        garbage.append("g%i")
        if i % 1000 == 0 : garbage = Array[String]{}
    }
    gc.collect()
    gc.collect()
    assert(items[0].string == "x\n")
    assert(items[1]["deep"].string == "value")

    // Stored in an object, and with a string taken out of it
    let holder = Array[json.View]{ items }
    let text = items[1]["deep"].string
    items = view_of("null")
    gc.collect()
    gc.collect()
    assert(text == "value")
    assert(holder[0][1]["deep"].string == "value")
}

test "Json view: to_value is independent of the document" {
    let view = view_of("{\"a\":[1],\"b\":\"text\"}")
    let value = view.to_value()
    value = value.set("c", 5)
    value["a"].append(2)
    assert(view["c"].is_null)
    assert(view["a"].length == 1)
    assert(value["a"].length == 2)
    assert(value["b"].string == "text")
    assert(view["a"].to_value().encode() == "[1]")
}

test "Json view: numbers keep every bit and a failed parse leaves nothing behind" {
    let root = view_of("[-1,9007199254740993,-9223372036854775808,9223372036854775807,1.5e300,-0.0,4294967296]")
    assert(root[0].int == -1)
    assert(root[1].int == 9007199254740993)
    assert(root[2].int == i64.$min)
    assert(root[3].int == i64.$max)
    assert(root[4].float == 1.5e300)
    assert(root[6].int == 4294967296)
    assert(root[0].length == 0)
    assert(root[6].length == 0)

    json.read("[1,[2,3,") ! assert(E.code == E.invalid)
    let after = view_of("[4,5]")
    assert(after.length == 2)
    assert(after[1].int == 5)
}

test "Json view: threads parse at the same time with their own scratch stack" {
    let workers = Array[thread.Thread[int]]{}
    each 0 .. 4 {
        workers.append(thread.Thread[int].start(fn() int {
            let total = 0
            each 0 .. 2000 {
                let root = view_of("{\"a\":[1,[2,{\"b\":3}],4],\"c\":{\"d\":[5,6]}}")
                total += root["a"][1][1]["b"].int + root["c"]["d"][1].int
            }
            return total
        }) !!)
    }
    each workers as worker : assert(worker.await() == 18000)
}

// Reading code written once: it must give the same text from a Value and a View
fn json_view_read_all(data: $T) String {
    let out = ByteBuffer.new(256)
    out.write("%{data["text"].string}|%{data["int"].int}|%{data["int"].float}|%{data["whole"].int}|%{data["frac"].int}|")
    out.write("%{data["yes"].bool}|%{data["nil"].is_null}|%{data["absent"].is_null}|%{data.has("nil")}|%{data.has("absent")}|")
    out.write("%{data.length}|%{data["list"].length}|%{data["text"].length}|%{data["int"].length}|")
    out.write("%{data["list"].string}|%{data["int"].string}|%{data["yes"].string}|%{data["nil"].string}|")
    out.write("%{data["text"].is_string}|%{data["yes"].is_bool}|%{data["int"].is_int}|%{data["frac"].is_float}|%{data["int"].is_number}|%{data["list"].is_array}|%{data["sub"].is_object}|")
    out.write("%{data.has_string("text")}|%{data.has_int("text")}|%{data.has_float("int")}|%{data.has_bool("yes")}|%{data.has_array("list")}|%{data.has_object("sub")}|%{data.has_object("absent")}|")
    out.write("%{data.get_string("text") !? "-"}|%{data.get_string("int") !? "-"}|%{data.get_int("whole") !? -1}|%{data.get_int("frac") !? -1}|%{data.get_float("int") !? -1.0}|%{data.get_bool("yes") !? false}|")
    out.write("%{data["list"].array.length}|%{data["int"].array.length}|%{data["sub"].object.length}|%{data["int"].object.length}|")
    out.write("%{(data.get_array("list") ! panic("list")).length}|%{(data.get_object("sub") ! panic("sub")).length}|")
    out.write("%{data["kindless"].kind == json.Kind.null}|%{data["sub"].kind == json.Kind.object}|")
    each data["list"] as item, key : out.write("[%{key.string}:%{key.int}=%{item.string}]")
    each data["sub"] as item, key : out.write("{%{key.string}:%{key.int}=%{item.string}}")
    each data["int"] as item : out.write("never")
    each data["sub"] as item : out.write(item.string)
    out.write(data.encode())
    return out.into_string()
}

test "Json view: the same reading code works on a Value and a View" {
    let text = "{\"text\":\"caf\\u00e9\",\"int\":7,\"whole\":3.0,\"frac\":1.5,\"yes\":true,\"nil\":null,\"list\":[1,\"two\",[3]],\"sub\":{\"x\":1,\"y\":\"z\"}}"
    let value = json.decode(text) ! panic("Invalid JSON")
    assert(json_view_read_all(value) == json_view_read_all(view_of(text)))
}

test "Json view: encodes and converts like a value" {
    let view = view_of("{\"a\":[1,2.5,\"x\"],\"b\":null}")
    assert(json.encode(view) == "{\"a\":[1,2.5,\"x\"],\"b\":null}")
    assert(view.encode() == json.encode(view))
    assert(json.from(view).encode() == view.encode())
    assert(view["a"].encode() == "[1,2.5,\"x\"]")
}

test "Json view: strings of every length up to the end of the input" {
    each 0 .. 40 as length {
        let plain = "x".repeat(length)
        each Array[String]{ plain, plain + "\\n", plain + "\xc3\xa9", "\\t" + plain } as body {
            assert(same_as_decode("\"" + body + "\""))
            assert(same_as_decode("{\"" + body + "\":1}"))
            assert(same_as_decode("[\"" + body + "\"]"))
            assert(same_error("\"" + body))
            assert(same_error("{\"" + body))
        }
        assert(view_of("{\"" + plain + "\":\"" + plain + "\"}")[plain].string == plain)
    }
}


use valk.mem

test "ByteBuffer" {

    let buf = ByteBuffer.new()
    let r = buf.reader()

    buf.write_string("100 200-300")

    assert(r.read_uint() == 100)
    assert(r.read_uint() == 0)
    assert(r.read_uint() == 0)
    r.skip(1)
    assert(r.read_uint() == 200)
    assert(r.read_int() == -300)
}

test "ByteBuffer overlapping clear" {
    let buf = ByteBuffer.new()
    buf.write_string("abcdef")
    buf.clear_part(1, 3)
    assert(buf == "aef")
    assert(buf.length == 3)

    buf.clear_part(0, 1)
    assert(buf == "ef")
    assert(buf.length == 2)
}

test "ByteBuffer resize and truncate" {
    let buf = ByteBuffer.new()
    buf.write_string("ab")
    buf.resize(5)
    assert(buf.length == 5)
    assert(buf[0] == 'a' && buf[1] == 'b')
    assert(buf[2] == 0 && buf[3] == 0 && buf[4] == 0)
    buf.truncate(1)
    assert(buf == "a")
    buf.truncate(10)
    assert(buf.length == 1)
}

test "ByteBuffer skip exposes only zeroed bytes" {
    let buffer = ByteBuffer.new()
    buffer.write_string("SECRET-abcdef-12345")
    buffer.clear()
    buffer.skip(8)
    assert(buffer.length == 8)
    let i: uint = 0
    while i < 8 : assert(buffer[i++] == 0)
}

test "ByteBuffer remains writable after reducing to zero" {
    let buffer = ByteBuffer.new(64)
    buffer.reduce_size(0)
    assert(buffer.size == 32)

    buffer.write_string("still writable")
    assert(buffer == "still writable")

    let consumed = ByteBuffer.new()
    consumed.into_string()
    assert(consumed.size == 0)
    consumed.minimum_size(1)
    assert(consumed.size == 32)
}

test "ByteBuffer raw u64 append" {
    let first: u64 = 0x0102030405060708
    let second: u64 = 0x1112131415161718
    let buf = ByteBuffer.new()

    buf.write_u64_string(first)
    buf.write_u64_string(second)

    assert(buf.length == size_of(u64) * 2)
    assert(mem.equal(buf.data, &first, size_of(u64)))
    assert(mem.equal(buf.data.@offset(size_of(u64)), &second, size_of(u64)))
}

test "mem.find_char handles word boundaries" {
    let data = "0123456789abcdefXYZ"
    assert((mem.find_char(data.data, '0', data.bytes) !? 99) == 0)
    assert((mem.find_char(data.data, '7', data.bytes) !? 99) == 7)
    assert((mem.find_char(data.data, '8', data.bytes) !? 99) == 8)
    assert((mem.find_char(data.data, 'f', data.bytes) !? 99) == 15)
    assert((mem.find_char(data.data, 'Z', data.bytes) !? 99) == 18)
    assert((mem.find_char(data.data.@offset(1), '8', data.bytes - 1) !? 99) == 7)
    assert((mem.find_char(data.data, 'q', data.bytes) !? 99) == 99)
}

test "ByteBuffer clone copies used bytes" {
    let original = ByteBuffer.new(4096)
    original.write_string("hello")

    let cloned = original.clone()
    assert(cloned == "hello")
    assert(cloned.length == original.length)
    assert(cloned.size == original.size)

    original.set(0, 'H')
    assert(original == "Hello")
    assert(cloned == "hello")

    cloned.write_string(" world")
    assert(cloned == "hello world")
    assert(original == "Hello")
}

test "ByteBuffer transfers its storage into a string" {
    let buffer = ByteBuffer.new(32)
    buffer.write_string("transferred")
    let data = buffer.data
    let result = buffer.into_string()

    assert(result == "transferred")
    assert(result.data == data)
    assert(buffer.length == 0)
    assert(buffer.into_string() == "")
}

test "ByteBuffer bounds checks do not wrap" {
    let maximum: uint = 0
    maximum--

    let source = ByteBuffer.new()
    source.write_string("abcd")
    assert(!source.starts_with("a", maximum))
    assert(source.part(1, maximum) == "bcd")
    assert(source.ref(1, maximum).to_string() == "bcd")

    let invalid_ref = ByteBufferRef.new(source, maximum, maximum)
    assert(invalid_ref.to_string() == "")
    assert(invalid_ref == "")

    let destination = ByteBuffer.new()
    destination.write_buffer_part(source, maximum, 1)
    assert(destination == "bcd")

    let reader = source.reader()
    reader.set_pos(maximum)
    assert(reader.get_pos() == source.length)
    reader.set_pos(1)
    reader.skip(maximum)
    assert(reader.get_pos() == source.length)
    reader.reset()
    assert(reader.read_little_endian(maximum) == 0)
    assert(reader.get_pos() == 0)
    assert(reader.read_big_endian(maximum) == 0)
    assert(reader.get_pos() == 0)
    assert(reader.read_string(maximum) == "abcd")
    assert(reader.get_pos() == source.length)
}

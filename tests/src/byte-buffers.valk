use valk.mem
use valk.gc

test "ByteBuffer" {

    let buf = ByteBuffer.new()
    buf.write("100 200-300")
    let r = buf.reader()

    assert(r.read_uint() == 100)
    assert(r.read_uint() == 0)
    assert(r.read_uint() == 0)
    r.skip(1)
    assert(r.read_uint() == 200)
    assert(r.read_int() == -300)

    let signed = ByteBuffer.new()
    signed.write("-0c17 -0xff")
    let signed_reader = signed.reader()
    assert(signed_reader.read_octal_int() == -15)
    signed_reader.skip(1)
    assert(signed_reader.read_hex_int() == -255)

    let text = ByteBuffer.new()
    text.write("abcd")
    let text_reader = text.reader()
    text_reader.skip(3)
    text_reader.rewind(2)
    assert(text_reader.read_remaining_string() == "bcd")
    assert(text_reader.read_remaining_string() == "")
    assert(text_reader.read_string(2) == "")

    let string_reader = "key 42".reader()
    assert(string_reader.read_string(3) == "key")
    string_reader.skip(1)
    assert(string_reader.read_uint() == 42)
    assert(string_reader.read_byte() == 0)
    assert(string_reader.remaining().length == 0)

    let binary = ByteBuffer.new()
    binary.write("key")
    binary.write_byte(0)
    binary.write_byte(1)
    binary.write_byte(2)
    binary.write_byte(3)
    let binary_reader = binary.view(0, binary.length).reader()
    assert(binary_reader.read_cstring() == "key")
    assert(binary_reader.read_u16_le() == 513)
    assert(binary_reader.read_byte() == 3)
    assert(binary_reader.read_cstring() == "")

    let slice_reader = "xxabcdef".view(2, 4).reader()
    assert(slice_reader.read_string(2) == "ab")
    assert(slice_reader.read_string(10) == "cd")
    assert(slice_reader.read_cstring() == "")
}

test "String and ByteBuffer convert to byte slices for writing" {
    let string_slice: Slice[u8] = "abc"
    let source = ByteBuffer.new()
    source.write("def")
    let buffer_slice: Slice[u8] = source

    let output = ByteBuffer.new()
    output.write(string_slice)
    output.write(buffer_slice)
    assert(output == "abcdef")
}

test "ByteBuffer overlapping clear" {
    let buf = ByteBuffer.new()
    buf.write("abcdef")
    buf.clear_part(1, 3)
    assert(buf == "aef")
    assert(buf.length == 3)

    buf.clear_part(0, 1)
    assert(buf == "ef")
    assert(buf.length == 2)
}

test "ByteBuffer resize and truncate" {
    let buf = ByteBuffer.new()
    buf.write("ab")
    buf.resize(5)
    assert(buf.length == 5)
    assert(buf[0] == 'a' && buf[1] == 'b')
    assert(buf[2] == 0 && buf[3] == 0 && buf[4] == 0)
    buf.truncate(1)
    assert(buf == "a")
    buf.truncate(10)
    assert(buf.length == 1)
}

test "ByteBuffer skip exposes only zeroed bytes" {
    let buffer = ByteBuffer.new()
    buffer.write("SECRET-abcdef-12345")
    buffer.clear()
    buffer.skip(8)
    assert(buffer.length == 8)
    let i: uint = 0
    while i < 8 : assert(buffer[i++] == 0)
}

test "ByteBuffer remains writable after reducing to zero" {
    let buffer = ByteBuffer.new(64)
    buffer.shrink_capacity(0)
    assert(buffer.size == 32)

    buffer.write("still writable")
    assert(buffer == "still writable")

    let consumed = ByteBuffer.new()
    consumed.into_string()
    assert(consumed.size == 0)
    consumed.ensure_capacity(1)
    assert(consumed.size == 32)
}

test "ByteBuffer writes shortest and fixed precision ASCII floats" {
    let buffer = ByteBuffer.new()
    buffer.write("value=")
    buffer.write_f64_ascii_shortest(1.5)
    buffer.write("|")
    buffer.write_f64_ascii(1.5, 3)
    buffer.write("|")
    buffer.write_f64_ascii(1.5, 3, true)
    buffer.write("|")
    buffer.write_f64_ascii(-12.25, 2)
    buffer.write("|")
    buffer.write_f64_ascii(12.0, 0)
    assert(buffer == "value=1.5|1.500|1.5|-12.25|12")

    buffer.clear()
    buffer.write_f64_ascii(1.234, 2)
    assert(buffer == "1.23")

    buffer.clear()
    buffer.write_f64_ascii_shortest(3.14159265358979)
    assert(buffer == "3.14159265358979")
    assert((buffer.to_string().to_float() !? 0) == 3.14159265358979)
}

test "ByteBuffer writes f64 bytes in explicit endian order" {
    let big = ByteBuffer.new()
    big.write_f64_be(1.0)
    assert(big.length == 8)
    assert(big[0] == 0x3f && big[1] == 0xf0)
    let i: uint = 2
    while i < 8 : assert(big[i++] == 0)

    let little = ByteBuffer.new()
    little.write_f64_le(1.0)
    assert(little.length == 8)
    i = 0
    while i < 6 : assert(little[i++] == 0)
    assert(little[6] == 0xf0 && little[7] == 0x3f)
}

test "bounded mem operations use byte slices" {
    let data = "0123456789abcdefXYZ"
    assert((mem.find_char(data.view(0, data.bytes), '0') !? 99) == 0)
    assert((mem.find_char(data.view(0, data.bytes), '7') !? 99) == 7)
    assert((mem.find_char(data.view(0, data.bytes), '8') !? 99) == 8)
    assert((mem.find_char(data.view(0, data.bytes), 'f') !? 99) == 15)
    assert((mem.find_char(data.view(0, data.bytes), 'Z') !? 99) == 18)
    assert((mem.find_char(data.view(1, data.bytes), '8') !? 99) == 7)
    assert((mem.find_char(data.view(0, data.bytes), 'q') !? 99) == 99)

    let buffer = ByteBuffer.new()
    buffer.write("ABCDEF")
    assert(mem.copy("xy".view(0, 2), buffer.view(1, 2)) == 2)
    assert(buffer == "AxyDEF")

    assert(mem.move(buffer.view(1, 3), buffer.view(2, 3)) == 3)
    assert(buffer == "AxxyDF")

    mem.ascii_to_lower(buffer.view(0, buffer.length))
    assert(buffer == "axxydf")
    assert(mem.ascii_equal_ignore_case(buffer.view(0, 2), "AX".view(0, 2)))

    mem.clear(buffer.view(1, 2))
    assert(buffer[0] == 'a' && buffer[1] == 0 && buffer[2] == 0 && buffer[3] == 'y')
    assert(mem.equal("same".view(0, 4), "same".view(0, 4)))
    assert(!mem.equal("same".view(0, 4), "different".view(0, 9)))
    assert((mem.to_uint("123".view(0, 3)) !? 0) == 123)
}

test "ByteBuffer views are bounded mutable byte slices" {
    let maximum: uint = 0
    maximum--

    let buffer = ByteBuffer.new(32)
    buffer.write("abcd")
    let view: Slice[u8] = buffer.view(1, maximum)
    assert(view.length == 3)
    assert(view.to_string() == "bcd")

    view.set(0, 'B') ! assert(false)
    assert(buffer == "aBcd")

    view.set(maximum, 'X') ! assert(true)
    assert(buffer == "aBcd")

    assert(buffer.view(maximum, maximum).length == 0)
}

test "ByteBuffer clone copies used bytes" {
    let original = ByteBuffer.new(4096)
    original.write("hello")

    let cloned = original.clone()
    assert(cloned == "hello")
    assert(cloned.length == original.length)
    assert(cloned.size == original.size)

    original.set(0, 'H')
    assert(original == "Hello")
    assert(cloned == "hello")

    cloned.write(" world")
    assert(cloned == "hello world")
    assert(original == "Hello")
}

test "ByteBuffer transfers its storage into a string" {
    let buffer = ByteBuffer.new(32)
    buffer.write("transferred")
    let data = buffer.data
    let result = buffer.into_string()

    assert(result == "transferred")
    assert(result.data == data)
    assert(buffer.length == 0)
    assert(buffer.into_string() == "")
}

test "ByteBuffer bounds checks do not wrap" {
    let maximum: uint = 0
    maximum--

    let source = ByteBuffer.new()
    source.write("abcd")
    assert(!source.starts_with("a", maximum))
    assert(source.part(1, maximum) == "bcd")
    assert(source.view(1, maximum).to_string() == "bcd")

    let invalid_ref = source.view(maximum, maximum)
    assert(invalid_ref.to_string() == "")
    assert(invalid_ref.equals(""))

    let destination = ByteBuffer.new()
    destination.write(source.view(1, maximum))
    assert(destination == "bcd")

    let reader = source.reader()
    reader.set_pos(maximum)
    assert(reader.get_pos() == source.length)
    reader.set_pos(1)
    reader.skip(maximum)
    assert(reader.get_pos() == source.length)
    reader.reset()
    assert(reader.read_little_endian(maximum) == 0)
    assert(reader.get_pos() == 0)
    assert(reader.read_big_endian(maximum) == 0)
    assert(reader.get_pos() == 0)
    assert(reader.read_string(maximum) == "abcd")
    assert(reader.get_pos() == source.length)
}

fn temporary_string_view() Slice[u8] {
    return ("prefix-" + "value-suffix").view(7, 5)
}

fn temporary_buffer_view() Slice[u8] {
    let source = ByteBuffer.new()
    source.write("prefix-value-suffix")
    return source.view(7, 5)
}

test "String and ByteBuffer views return owned byte slices" {
    let source = "ab🐔cdef"
    let view: Slice[u8] = source.view(2, 5)

    assert(view.data == source.data.@offset(2))
    assert(view.length == 5)
    assert((view[0] !!) == 0xf0)
    assert((view[4] !!) == 'c')
    assert(view.equals("🐔c"))
    assert(view.starts_with("🐔"))
    assert((view.index_of_byte('c') !? 99) == 4)
    assert((view.index_of_byte('c', 5) !? 99) == 99)
    assert(view.view(4, 99).equals("c"))
    assert(view.to_string() == "🐔c")

    let mutable_source = "abc" + "def"
    let mutable_slice = mutable_source.view(1, 2)
    mutable_slice.set(0, 'X') ! assert(false)
    assert(mutable_source == "aXcdef")
    assert("X-HEADER-value".view(0, 8).to_ascii_lower_string() == "x-header")
    assert(("x123y".view(1, 3).to_uint() !? 0) == 123)
    assert(("12x".view(0, 3).to_uint() !? 99) == 99)
    assert(("x-42y".view(1, 3).to_int() !? 0) == -42)
    assert(("x1.5y".view(1, 3).to_float() !? 0.0) == 1.5)
    let temporary = temporary_string_view()
    gc.collect()
    assert(temporary.equals("value"))

    let buffer_temporary = temporary_buffer_view()
    gc.collect()
    assert(buffer_temporary.equals("value"))

    let copy_source = ByteBuffer.new()
    copy_source.write("value")
    let copied = copy_source.view(0, copy_source.length).to_string()
    copy_source.clear()
    assert(copied == "value")

    assert("Content-Length".view(0, 14).equal_ignore_ascii_case("content-length"))
    assert(!"Content-Length".view(0, 7).equal_ignore_ascii_case("content-length"))
    assert("prefix-value".view(0, 12).equals_at(7, 5, "value"))
    assert(!"short".view(0, 5).equals_at(4, 5, "value"))
}

test "ByteBuffer views keep their backing storage alive" {
    let source = ByteBuffer.new(32)
    source.write("prefix-value")
    let view = source.view(7, 5)
    let old_data = source.data

    source.write("-012345678901234567890123456789")
    gc.collect()

    assert(source.data != old_data)
    assert(view.equals("value"))
    assert((view[4] !!) == 'e')
}

test "Numeric parsing stays within bounded byte slices" {
    let integer = "12x".view(0, 2)
    assert((integer.to_uint() !? 0) == 12)

    let decimal = "1.5x".view(0, 3)
    assert((decimal.to_float() !? 0.0) == 1.5)

    let buffer = ByteBuffer.new()
    buffer.write("+7 -8 0c17 -0xff 1.5e2x")
    let reader = buffer.reader()
    assert(reader.read_uint() == 7)
    reader.skip(1)
    assert(reader.read_int() == -8)
    reader.skip(1)
    assert(reader.read_octal_uint() == 15)
    reader.skip(1)
    assert(reader.read_hex_int() == -255)
    reader.skip(1)
    assert(reader.read_float() == 150)
    assert(buffer[reader.get_pos()] == 'x')
}

test "ByteBuffer views are independent of later logical truncation" {
    let source = ByteBuffer.new()
    source.write("abcdef")
    let view = source.view(3, 3)

    source.truncate(4)
    assert(view.length == 3)
    assert(view.equals("def"))

    source.truncate(2)
    assert(view.length == 3)
    assert(view.equals("def"))
}


trait TA {
    fn val() String {
        return "a"
    }
}
trait TB[T] {
    fn val() T {
        return "b"
    }
}

class TCA {
    use TA
}
class TCB {
    use TB[String]
}

test "Trait" {
    let a = TCA{}
    let b = TCB{}
    assert(a.val() == "a")
    assert(b.val() == "b")
}
trait TraitOrderedByKey {
    + fn lt(o: SELF) bool $lt { return this.key() < o.key() }
}

class TraitQueuedJob {
    key_value: uint (0)
    // The default needs `$lt`, which only the trait gives
    queue: Heap[TraitQueuedJob] (.{})
    use TraitOrderedByKey
    fn key() uint { return this.key_value }
}

test "Traits: a class's own property can use a hook its trait gives" {
    let job = TraitQueuedJob { key_value: 5 }
    job.queue.push(TraitQueuedJob { key_value: 2 })
    job.queue.push(TraitQueuedJob { key_value: 1 })
    let first = job.queue.pop() !!
    assert(first.key_value == 1)
}

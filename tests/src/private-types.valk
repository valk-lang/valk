- class PrivateTypeSecret {
    fn value() int { return 42 }
}

- fn private_type_make() PrivateTypeSecret { return PrivateTypeSecret {} }

+ interface PrivateTypeReveal {
    fn reveal() int;
}

- class PrivateTypeImpl is PrivateTypeReveal {
    fn reveal() int { return 7 }
}

+ fn private_type_reveal() PrivateTypeReveal { return PrivateTypeImpl {} }

test "Access: a file-private type stays usable behind wider declarations" {
    assert(private_type_make().value() == 42)
    assert(private_type_reveal().reveal() == 7)
}

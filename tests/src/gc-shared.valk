@unsafe
@ignore_access

use valk.gc
use valk.time
use valk.thread
use valk.core

class SNode {
    left : ?SNode
    right : ?SNode

    static fn tree(x: int) SNode {
        if x == 0 {
            let res = SNode {}
            return res
        }
        let res = SNode {
            left: SNode.tree(x - 1)
            right: SNode.tree(x - 1)
        }
        return res
    }
}

@shared shared_test_node : ?SNode (null)

fn shared_1() $noinline {
    shared_test_node = SNode.tree(12)
    let n = shared_test_node
    if isset(n) : assert(n.$is_shared)
}
fn shared_2() $noinline {
    let i = 0
    while i++ < 10 {
        shared_test_node = SNode.tree(12)
    }
}
fn is_shared() bool $noinline {
    let n = shared_test_node
    if isset(n) : return n.$is_shared
    return false
}

synctest "GC: Shared Leaks" {

    gc.collect_shared()

    // Record before memory usage
    let before = gc.mem_shared_now()
    // Create some shared memory
    shared_1()
    assert(is_shared())
    // Record new memory usage
    let before2 = gc.mem_shared_now()
    assert(before2 > before)
    // Create much more shared memory
    shared_2()
    assert(is_shared())
    // Test shared memory amount. The stacks of the idle threads that earlier tests left are
    // scanned conservatively: idle loops clear their stack before they wait, so no stale word
    // there may keep a freed node alive.
    gc.collect_shared()
    let after_replace = gc.mem_shared_now()
    if after_replace > before2 + SHARED_LEAK_SLACK : println("Shared GC replace mismatch: before=%before, retained=%before2, after=%after_replace, mark=%{gc.mark_count}")
    assert(after_replace <= before2 + SHARED_LEAK_SLACK)
    // Remove shared memory test
    shared_test_node = null
    assert(!is_shared())
    gc.collect_shared()
    let after_clear = gc.mem_shared_now()
    if after_clear > before + SHARED_LEAK_SLACK : println("Shared GC clear mismatch: before=%before, retained=%before2, after=%after_clear, mark=%{gc.mark_count}")
    assert(after_clear <= before + SHARED_LEAK_SLACK)
}

// What stale words in other threads' stacks may keep alive
value SHARED_LEAK_SLACK (0)

@shared shared_node : ?SNode (null)
@shared shared_lock : core.SyncMutex (core.SyncMutex.new())

fn spam_shared_memory() {
    shared_lock.lock()
    shared_lock.unlock()
    let i = 0
    while i++ < 20 {
        shared_node = SNode.tree(8)
    }
}

synctest "GC: Shared Leaks Multi Thread" {

    let mem_start = gc.mem_shared_now()

    shared_lock.lock()
    let tt = Array[thread.Thread[void]]{}
    let i = 0
    while i++ < 4 {
        let t = thread.start(fn() {
            spam_shared_memory()
        }) ! panic("Failed to start thread")
        tt.append(t)
    }
    shared_lock.unlock()
    each tt as t {
        t.await()
    }

    let usage = gc.mem_shared_now()
    assert(usage > mem_start + 10000)
    // Clear all
    shared_node = null
    gc.collect_shared()


    assert(gc.mem_shared_now() < usage - 10000)
}

synctest "GC: Share null" {
    let a = Array[?String]{null}
    gc.share(a.@cast(ptr))
}

class MovedInItem { count: uint (0) }
class MovedInBox {
    items: Array[MovedInItem] (.{})
    last: ?MovedInItem (null)
}
shared moved_in_box: ?MovedInBox (null)

synctest "GC: Shared values moved in through calls and stores stay unique" {
    let item = MovedInItem { count: 3 }
    let box = MovedInBox {}
    box.items.append(item)
    box.last = MovedInItem { count: 5 }
    let published: atomic MovedInBox = box
    assert((published.items.get(0) ! panic("missing")).count == 3)
    assert((published.last ?? panic("missing")).count == 5)

    let fresh = MovedInBox {}
    fresh.items.append(MovedInItem { count: 7 })
    fresh.last = MovedInItem { count: 11 }
    moved_in_box = fresh
    assert(((moved_in_box ?? panic("missing")).items.get(0) ! panic("missing")).count == 7)
    moved_in_box = null
}

class BranchPublishItem { number: int (0) }
shared branch_publish_saved: ?BranchPublishItem (null)
fn branch_publish(n: int) int {
    let item = BranchPublishItem {}
    let i = 0
    while i++ < 5 {
        if i == n { branch_publish_saved = item; break }
        item.number++
    }
    return n
}

synctest "GC: Shared publication on one path leaves the other paths ordinary" {
    assert(branch_publish(3) == 3)
    assert((branch_publish_saved ?? panic("missing")).number == 2)
    branch_publish_saved = null
}

class SharedStringBox { text: String ("hi") }
fn shared_string_read(s: atomic String) String { return s }

test "GC: strings are compatible with shared strings both ways" {
    let a: atomic String = "hello"
    assert(a == "hello")
    assert(shared_string_read("plain") == "plain")
    let box: atomic SharedStringBox = SharedStringBox {}
    let text: String = box.text
    assert(text == "hi")
    let hm = HashMap[uint, int]{ 1 => 2 }
    hm.set(3, 4)
    let shared_map: atomic HashMap[uint, int] = hm
    assert((shared_map.get(3) !? 0) == 4)
}

global raw_stash: ptr

fn stash_raw(p: ptr) {
    raw_stash = p
}

// Handing a raw pointer into managed storage to a callee that keeps it is
// unsafe territory, not an escape of the graph it was taken from
synctest "GC: Shared conversion ignores raw pointer arguments" {
    @unsafe
    let box = MovedInBox {}
    box.items.append(MovedInItem { count: 9 })
    stash_raw(box.items.@cast(ptr))
    let published: atomic MovedInBox = box
    assert((published.items.get(0) ! panic("missing")).count == 9)
    raw_stash = null.@cast(ptr)
}

class CoOwnSharedItem { value: uint (0) }
class CoOwnSharedBox {
    first: ?CoOwnSharedItem
    second: ?CoOwnSharedItem
}
@shared co_own_shared_box: ?CoOwnSharedBox (null)

fn co_own_shared_fill() $noinline {
    co_own_shared_box = CoOwnSharedBox {
        first: CoOwnSharedItem { value: 11 }
        second: CoOwnSharedItem { value: 22 }
    }
}

fn co_own_shared_read() uint $noinline {
    let kept = co_own_shared_box ?? panic("missing")
    let first = kept.first ?? panic("missing")
    let second = kept.second ?? panic("missing")
    // Both locals co-own shared items across these collects
    gc.collect()
    gc.collect()
    return first.value + second.value
}

synctest "GC: Local co-ownership of shared objects survives collects" {
    gc.collect_shared()
    let before = gc.mem_shared_now()
    co_own_shared_fill()
    assert(co_own_shared_read() == 33)
    gc.collect()
    co_own_shared_box = null
    gc.collect()
    gc.collect_shared()
    assert(gc.mem_shared_now() == before)
}

class GCSleeper {
    sleeping: bool (false)
}

synctest "GC: thread suspend releases the shared GC lock" {
    let state: atomic GCSleeper = .{}
    let sleeper = thread.Thread[void].start(fn() {
        state.sleeping = true
        thread.suspend_ms(800)
    }) !!
    while !state.sleeping : time.sleep_ms(1)
    time.sleep_ms(20)
    let start = time.mono_ms()
    gc.collect_shared()
    assert(time.mono_ms() - start < 500)
    sleeper.await()
}

// Threads that allocate without ever blocking let go of their gc at the
// allocator's next block switch while a shared collection waits for it
@shared spin_stop: bool (false)
@shared spin_started: uint (0)

class SpinJunk {
    value: uint
}

fn spin_allocate() uint {
    atomic(spin_started + 1)
    let junk = Array[SpinJunk]{}
    let count: uint = 0
    while !spin_stop {
        junk.append(SpinJunk { value: count })
        if junk.length > 1000 : junk.clear()
        count++
    }
    return count
}

synctest "GC: A shared collection stops threads that allocate without blocking" {
    let spinners = Array[thread.Thread[uint]]{}
    let i: uint = 0
    while i < 2 {
        spinners.append(thread.Thread[uint].start(fn() uint { return spin_allocate() }) !!)
        i++
    }
    while atomic_load(spin_started) < 2 : time.sleep_ms(1)
    let start = time.mono_ms()
    gc.collect_shared()
    gc.collect_shared()
    gc.collect_shared()
    assert(time.mono_ms() - start < 2000)
    spin_stop = true
    each spinners as t : assert(t.await() > 0)
}

shared collect_loop_stop: uint (0)

// A thread that keeps collecting shared memory, so collections the test asks for often find
// one already done and return without their own
fn collect_shared_until_stopped() {
    while atomic_load(collect_loop_stop) == 0 {
        gc.collect_shared()
        time.sleep_ms(1)
    }
}

synctest "GC: A shared collection run by another thread scans the caller from its entry" {
    atomic_store(collect_loop_stop, 0)
    let collector = thread.start(fn() {
        collect_shared_until_stopped()
    }) ! panic("Failed to start thread")
    gc.collect_shared()
    let before = gc.mem_shared_now()
    let retained: uint = 0
    let round = 0
    while round++ < 50 {
        shared_1()
        shared_test_node = null
        gc.collect_shared()
        // Without the fix, a round kept a subtree (~24 KB) through the collector's frames
        if gc.mem_shared_now() > before + SHARED_LEAK_SLACK : retained++
    }
    atomic_store(collect_loop_stop, 1)
    collector.await()
    if retained > 0 : println("rounds that kept tree nodes: %retained of 50")
    assert(retained == 0)
}

@shared small_publish_node : ?SNode (null)

// Threads count what they publish in batches; a shared collection adds every thread's rest
synctest "GC: Small publications of another thread are counted" {
    gc.collect_shared()
    let before = gc.mem_shared
    let t = thread.start(fn() {
        small_publish_node = SNode.tree(3)
    }) ! panic("Failed to start thread")
    t.await()
    gc.collect_shared()
    let counted = gc.mem_shared
    // 15 nodes of two references each
    assert(counted >= before + 15 * 16)
    small_publish_node = null
    gc.collect_shared()
    // Lower again and not wrapped around; the thread handle may still be alive
    assert(gc.mem_shared < counted)
    assert(gc.mem_shared < before + 1024)
}

shared lazy_freed: uint (0)

class LazyFreed {
    n: uint (0)
    fn gc_free() {
        atomic(lazy_freed + 1)
    }
}

@shared lazy_item : ?LazyFreed (null)
shared lazy_stop: uint (0)
shared lazy_dropped: uint (0)

fn lazy_publish() $noinline {
    lazy_item = LazyFreed{}
}

synctest "GC: Shared items a waiting thread published are freed right after the collection" {
    gc.collect_shared()
    atomic_store(lazy_stop, 0)
    atomic_store(lazy_dropped, 0)
    atomic_store(lazy_freed, 0)
    let t = thread.start(fn() {
        // Many, so a stale word in this thread's stack keeps at most a few alive
        let i = 0
        while i++ < 50 : lazy_publish()
        lazy_item = null
        atomic_store(lazy_dropped, 1)
        // Blocked: the collecting thread sweeps for this one
        while atomic_load(lazy_stop) == 0 : time.sleep_ms(1)
    }) ! panic("Failed to start thread")
    while atomic_load(lazy_dropped) == 0 : time.sleep_ms(1)
    time.sleep_ms(5)
    gc.collect_shared()
    gc.collect_shared()
    assert(atomic_load(lazy_freed) >= 48)
    atomic_store(lazy_stop, 1)
    t.await()
}

// Shares an item a thread that ended allocated, then drops it
fn lazy_publish_foreign() $noinline {
    let t = thread.Thread[LazyFreed].start(fn() LazyFreed { return LazyFreed{ n: 4 } }) !!
    lazy_item = t.await()
    lazy_item = null
}

synctest "GC: A shared item another thread allocated is freed by a later collection" {
    gc.collect_shared()
    atomic_store(lazy_freed, 0)
    lazy_publish_foreign()
    gc.collect_shared()
    gc.collect_shared()
    gc.collect_shared()
    assert(atomic_load(lazy_freed) == 1)
}

fn count_nodes(n: ?SNode) uint {
    let node = n ?! return 0
    return 1 + count_nodes(node.left) + count_nodes(node.right)
}

synctest "GC: Threads waiting for a shared collection mark with it" {
    let spinners = Array[thread.Thread[uint]]{}
    atomic_store(spin_started, 0)
    spin_stop = false
    let i: uint = 0
    while i < 3 {
        spinners.append(thread.Thread[uint].start(fn() uint { return spin_allocate() }) !!)
        i++
    }
    while atomic_load(spin_started) < 3 : time.sleep_ms(1)
    shared_test_node = SNode.tree(14)
    let round = 0
    while round++ < 5 {
        gc.collect_shared()
        assert(count_nodes(shared_test_node) == 32767)
    }
    spin_stop = true
    each spinners as t : assert(t.await() > 0)
    shared_test_node = null
    gc.collect_shared()
}

// A thread's sweep after a shared collection covers what it had shared by then; what it
// shares later is not marked yet and must stay
synctest "GC: A thread's pending sweep keeps what it shared after the collection" {
    gc.collect_shared()
    atomic_store(lazy_freed, 0)
    let g = gc.gc
    g.sweep_end = g.shared_items.index
    g.sweep_pending = g.sweep_end > 0
    lazy_publish()
    gc.collect()
    assert(!g.sweep_pending)
    assert(atomic_load(lazy_freed) == 0)
    lazy_item = null
    gc.collect_shared()
    assert(atomic_load(lazy_freed) == 1)
}

value GC_TWICE_MAGIC (0x5A5A1234)
shared gc_twice_freed: uint (0)
shared gc_twice_bad: uint (0)
shared gc_twice_stop: uint (0)
shared gc_twice_next: uint (0)

class GcTwiceNode {
    magic: uint (GC_TWICE_MAGIC)
    left: ?GcTwiceNode (null)
    right: ?GcTwiceNode (null)
    fn gc_free() {
        if this.magic != GC_TWICE_MAGIC : atomic(gc_twice_bad + 1)
        this.magic = 0
        atomic(gc_twice_freed + 1)
    }
}

@shared gc_twice_s0: ?GcTwiceNode (null)
@shared gc_twice_s1: ?GcTwiceNode (null)
@shared gc_twice_s2: ?GcTwiceNode (null)
@shared gc_twice_s3: ?GcTwiceNode (null)

fn gc_twice_set(i: uint, n: ?GcTwiceNode) $noinline {
    if i == 0 : gc_twice_s0 = n
    else if i == 1 : gc_twice_s1 = n
    else if i == 2 : gc_twice_s2 = n
    else : gc_twice_s3 = n
}

fn gc_twice_tree(depth: uint) GcTwiceNode {
    let n = GcTwiceNode {}
    if depth > 0 {
        n.left = gc_twice_tree(depth - 1)
        n.right = gc_twice_tree(depth - 1)
    }
    return n
}

fn gc_twice_worker(id: uint) {
    let i: uint = 0
    while atomic_load(gc_twice_stop) == 0 {
        gc_twice_set(id, gc_twice_tree(5 + i % 3))
        if i % 41 == 0 : gc.collect_shared()
        if i % 13 == 0 : time.sleep_ms(1)
        i++
    }
}

// A sweep after a collection may free an item whose slot a stale stack word still names; the
// owner's next scan must not take that slot for a fresh allocation, or its finalizer runs again
synctest "GC: Shared items freed by a sweep are never finalized twice" {
    let workers = Array[thread.Thread[void]]{}
    each 0 .. 4 as i {
        workers.append(thread.start(fn() { gc_twice_worker(atomic(gc_twice_next + 1) - 1) }) !!)
    }
    time.sleep_ms(500)
    atomic_store(gc_twice_stop, 1)
    each workers as w : w.await()
    each 0 .. 4 as i : gc_twice_set(i, null)
    gc.collect_shared()
    gc.collect_shared()
    assert(gc_twice_freed > 1000)
    assert(gc_twice_bad == 0)
}

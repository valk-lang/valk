@unsafe
@ignore_access

use valk.gc
use valk.time
use valk.thread
use valk.core

class SNode {
    left : ?SNode
    right : ?SNode

    static fn tree(x: int) SNode {
        if x == 0 {
            let res = SNode {}
            return res
        }
        let res = SNode {
            left: SNode.tree(x - 1)
            right: SNode.tree(x - 1)
        }
        return res
    }
}

@shared shared_test_node : ?SNode (null)

fn shared_1() $noinline {
    shared_test_node = SNode.tree(12)
    let n = shared_test_node
    if isset(n) : assert(n.$is_shared)
}
fn shared_2() $noinline {
    let i = 0
    while i++ < 10 {
        shared_test_node = SNode.tree(12)
    }
}
fn is_shared() bool $noinline {
    let n = shared_test_node
    if isset(n) : return n.$is_shared
    return false
}

synctest "GC: Shared Leaks" {

    gc.collect_shared()

    // Record before memory usage
    let before = gc.mem_shared
    // Create some shared memory
    shared_1()
    assert(is_shared())
    // Record new memory usage
    let before2 = gc.mem_shared
    assert(before2 > before)
    // Create much more shared memory
    shared_2()
    assert(is_shared())
    // Test shared memory amount
    gc.collect_shared()
    let after_replace = gc.mem_shared
    if after_replace != before2 : println("Shared GC replace mismatch: before=%before, retained=%before2, after=%after_replace, mark=%{gc.mark_count}")
    assert(after_replace == before2)
    // Remove shared memory test
    shared_test_node = null
    assert(!is_shared())
    gc.collect_shared()
    let after_clear = gc.mem_shared
    if after_clear != before : println("Shared GC clear mismatch: before=%before, retained=%before2, after=%after_clear, mark=%{gc.mark_count}")
    assert(after_clear == before)
}

@shared shared_node : ?SNode (null)
@shared shared_lock : core.SyncMutex (core.SyncMutex.new())

fn spam_shared_memory() {
    shared_lock.lock()
    shared_lock.unlock()
    let i = 0
    while i++ < 20 {
        shared_node = SNode.tree(8)
    }
}

synctest "GC: Shared Leaks Multi Thread" {

    let mem_start = gc.mem_shared

    shared_lock.lock()
    let tt = Array[thread.Thread[void]]{}
    let i = 0
    while i++ < 4 {
        let t = thread.start(fn() {
            spam_shared_memory()
        }) ! panic("Failed to start thread")
        tt.append(t)
    }
    shared_lock.unlock()
    each tt as t {
        t.await()
    }

    let usage = gc.mem_shared
    assert(usage > mem_start + 10000)
    // Clear all
    shared_node = null
    gc.collect_shared()


    assert(gc.mem_shared < usage - 10000)
}

synctest "GC: Share null" {
    let a = Array[?String]{null}
    gc.share(a.@cast(ptr))
}

class MovedInItem { count: uint (0) }
class MovedInBox {
    items: Array[MovedInItem] (.{})
    last: ?MovedInItem (null)
}
shared moved_in_box: ?MovedInBox (null)

synctest "GC: Shared values moved in through calls and stores stay unique" {
    let item = MovedInItem { count: 3 }
    let box = MovedInBox {}
    box.items.append(item)
    box.last = MovedInItem { count: 5 }
    let published: shared MovedInBox = box
    assert((published.items.get(0) ! panic("missing")).count == 3)
    assert((published.last ?? panic("missing")).count == 5)

    let fresh = MovedInBox {}
    fresh.items.append(MovedInItem { count: 7 })
    fresh.last = MovedInItem { count: 11 }
    moved_in_box = fresh
    assert(((moved_in_box ?? panic("missing")).items.get(0) ! panic("missing")).count == 7)
    moved_in_box = null
}

class BranchPublishItem { number: int (0) }
shared branch_publish_saved: ?BranchPublishItem (null)
fn branch_publish(n: int) int {
    let item = BranchPublishItem {}
    let i = 0
    while i++ < 5 {
        if i == n { branch_publish_saved = item; break }
        item.number++
    }
    return n
}

synctest "GC: Shared publication on one path leaves the other paths ordinary" {
    assert(branch_publish(3) == 3)
    assert((branch_publish_saved ?? panic("missing")).number == 2)
    branch_publish_saved = null
}

class SharedStringBox { text: String ("hi") }
fn shared_string_read(s: shared String) String { return s }

test "GC: strings are compatible with shared strings both ways" {
    let a: shared String = "hello"
    assert(a == "hello")
    assert(shared_string_read("plain") == "plain")
    let box: shared SharedStringBox = SharedStringBox {}
    let text: String = box.text
    assert(text == "hi")
    let hm = HashMap[uint, int]{ 1 => 2 }
    hm.set(3, 4)
    let shared_map: shared HashMap[uint, int] = hm
    assert((shared_map.get(3) !? 0) == 4)
}

global raw_stash: ptr

fn stash_raw(p: ptr) {
    raw_stash = p
}

// Handing a raw pointer into managed storage to a callee that keeps it is
// unsafe territory, not an escape of the graph it was taken from
synctest "GC: Shared conversion ignores raw pointer arguments" {
    @unsafe
    let box = MovedInBox {}
    box.items.append(MovedInItem { count: 9 })
    stash_raw(box.items.@cast(ptr))
    let published: shared MovedInBox = box
    assert((published.items.get(0) ! panic("missing")).count == 9)
    raw_stash = null.@cast(ptr)
}

class CoOwnSharedItem { value: uint (0) }
class CoOwnSharedBox {
    first: ?CoOwnSharedItem
    second: ?CoOwnSharedItem
}
@shared co_own_shared_box: ?CoOwnSharedBox (null)

fn co_own_shared_fill() $noinline {
    co_own_shared_box = CoOwnSharedBox {
        first: CoOwnSharedItem { value: 11 }
        second: CoOwnSharedItem { value: 22 }
    }
}

fn co_own_shared_read() uint $noinline {
    let kept = co_own_shared_box ?? panic("missing")
    let first = kept.first ?? panic("missing")
    let second = kept.second ?? panic("missing")
    // Both locals co-own shared items across these collects
    gc.collect()
    gc.collect()
    return first.value + second.value
}

synctest "GC: Local co-ownership of shared objects survives collects" {
    gc.collect_shared()
    let before = gc.mem_shared
    co_own_shared_fill()
    assert(co_own_shared_read() == 33)
    gc.collect()
    co_own_shared_box = null
    gc.collect()
    gc.collect_shared()
    assert(gc.mem_shared == before)
}

class GCSleeper {
    sleeping: bool (false)
}

synctest "GC: thread suspend releases the shared GC lock" {
    let state: shared GCSleeper = .{}
    let sleeper = thread.Thread[void].start(fn() {
        state.sleeping = true
        thread.suspend_ms(800)
    }) !!
    while !state.sleeping : time.sleep_ms(1)
    time.sleep_ms(20)
    let start = time.mono_ms()
    gc.collect_shared()
    assert(time.mono_ms() - start < 500)
    sleeper.await()
}

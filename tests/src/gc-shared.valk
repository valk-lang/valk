
@ignore_access

use valk:gc
use valk:thread
use valk:core

class SNode {
    left : ?SNode
    right : ?SNode

    static fn tree(x: int) SNode {
        if x == 0 {
            let res = SNode {}
            return res
        }
        let res = SNode {
            left: SNode.tree(x - 1)
            right: SNode.tree(x - 1)
        }
        return res
    }
}

@shared shared_test_node : ?SNode (null)

fn shared_1() {
    shared_test_node = SNode.tree(12)
    let n = shared_test_node
    if isset(n) : assert(n.$is_shared)
}
fn shared_2() {
    let i = 0
    while i++ < 10 {
        shared_test_node = SNode.tree(12)
    }
}
fn is_shared() bool {
    let n = shared_test_node
    if isset(n) : return n.$is_shared
    return false
}

synctest "GC: Shared Leaks" {

    thread:threads.lock()
    let active_threads = thread:threads.length
    thread:threads.unlock()
    if active_threads != 0 : println("Shared GC started with %active_threads registered thread(s)")
    assert(active_threads == 0)

    gc:collect_shared()

    // Record before memory usage
    let before = gc:mem_shared
    // Create some shared memory
    shared_1()
    assert(is_shared())
    // Record new memory usage
    let before2 = gc:mem_shared
    assert(before2 > before)
    // Create much more shared memory
    shared_2()
    assert(is_shared())
    // Test shared memory amount
    gc:collect_shared()
    let after_replace = gc:mem_shared
    if after_replace != before2 {
        println("Shared GC replace mismatch: before=%before, retained=%before2, after=%after_replace, mark=%{gc:mark_count}")
    }
    assert(after_replace == before2)
    // Remove shared memory test
    shared_test_node = null
    assert(!is_shared())
    gc:collect_shared()
    let after_clear = gc:mem_shared
    if after_clear != before {
        println("Shared GC clear mismatch: before=%before, retained=%before2, after=%after_clear, mark=%{gc:mark_count}")
    }
    assert(after_clear == before)
}

@shared shared_node : ?SNode (null)
@shared shared_lock : core:SyncMutex (core:SyncMutex.new()) 

fn spam_shared_memory() {
    shared_lock.lock()
    shared_lock.unlock()
    let i = 0
    while i++ < 20 {
        shared_node = SNode.tree(8)
    }
}

synctest "GC: Shared Leaks Multi Thread" {

    let mem_start = gc:mem_shared

    shared_lock.lock()
    let tt = Array[thread:Thread[void]]{}
    let i = 0
    while i++ < 4 {
        let t = thread:start(fn() {
            spam_shared_memory()
        }) ! panic("Failed to start thread")
        tt.append(t)
    }
    shared_lock.unlock()
    each tt as t {
        t.wait()
    }

    let usage = gc:mem_shared
    assert(usage > mem_start + 10000)
    // Clear all
    shared_node = null
    gc:collect_shared()


    assert(gc:mem_shared < usage - 10000)
}

synctest "GC: Share null" {
    let a = Array[?String]{null}
    gc:share(a.@cast(ptr))
}

@unsafe

test "Floats" {
    let a = 0.5
    let b = 1.7
    let c = -5.2
    let d = -0.0
    let e = 10

    assert(a == "0.5")
    assert(b == "1.7")
    assert(c == "-5.2")
    assert(d == "-0")
    assert(e == "10")

    let sum = a + b
    assert(sum == 2.2)
    sum += c
    assert(sum == -3)
    sum /= 3
    assert(sum == -1)
    sum += d
    assert(sum == -1)
    sum += e
    assert(sum == 9)
}

test "Floats: operator compatibility" {
    //
    let v_f0 : float = 0.0
    let v_f1 : float = 0.01
    let v_u8 : u8 = 0
    let v_i8 : i8 = 0
    let v_uint : uint = 0
    let v_int : int = 0
    //
    assert(v_f1 > v_i8)
    assert(v_f1 > v_u8)
    assert(v_f1 > v_uint)
    assert(v_f1 > v_int)
    // Reverse
    assert(v_i8 < v_f1)
    assert(v_u8 < v_f1)
    assert(v_uint < v_f1)
    assert(v_int < v_f1)
    //
    assert(v_i8 < 0.01)
    assert(v_u8 < 0.01)
    assert(v_uint < 0.01)
    assert(v_int < 0.01)
    //
    assert(0.01 > v_i8)
    assert(0.01 > v_u8)
    assert(0.01 > v_uint)
    assert(0.01 > v_int)
    //
    assert(0.0 == 0)
    assert(0 == 0.0)
    assert(0.0 == v_u8)
    assert(v_u8 == 0.0)
    assert(v_f0 == 0)
    assert(0 == v_f0)
    // String compare
    assert(0.0 == "0")
    assert(0 == "0")
    assert("0" == 0.0)
    assert("0" == 0)
    assert(v_f0 == "0")
    assert(v_int == "0")
    assert("0" == v_f0)
    assert("0" == v_int)
}

test "Floats: NaN comparisons follow IEEE 754" {
    let zero = 0.0
    let nan = zero / zero
    assert(nan != nan)
    assert(!(nan == nan))
    assert(!(nan < nan))
    assert(!(nan <= nan))
    assert(!(nan > nan))
    assert(!(nan >= nan))
}

test "Floats: shortest strings round trip" {
    let bits: u64 = 1
    let i: uint = 0
    while i++ < 2048 {
        bits = (bits * 6364136223846793005.to(u64) + 1442695040888963407.to(u64)) & 0x7fefffffffffffff
        if (i & 1) != 0 : bits |= 1.to(u64) << 63
        let value = @ptrv(&bits, f64)
        let text: String = value
        assert((text.to_float() !? 0.0) == value)
    }

    let single_bits: u32 = 1
    i = 0
    while i++ < 2048 {
        single_bits = (single_bits * 1664525.to(u32) + 1013904223.to(u32)) & 0x7f7fffff
        if (i & 1) != 0 : single_bits |= 1.to(u32) << 31
        let value = @ptrv(&single_bits, f32)
        let text: String = value
        assert((text.to_float() !? 0.0).to(f32) == value)
    }

    bits = 1
    let minimum = @ptrv(&bits, f64)
    let minimum_text: String = minimum
    assert((minimum_text.to_float() !? 0.0) == minimum)
    bits = 0x7fefffffffffffff
    let maximum = @ptrv(&bits, f64)
    let maximum_text: String = maximum
    assert((maximum_text.to_float() !? 0.0) == maximum)
}

fn f64_bits(value: f64) u64 {
    return @ptrv(&value, u64)
}

test "Floats: long decimal inputs are correctly rounded" {
    assert(f64_bits("1000000000000000000000000000000".to_float() !!) == 0x46293e5939a08cea)
    assert(f64_bits("10000000000000000000000000000000000000".to_float() !!) == 0x479e17b84357691b)
    assert(f64_bits("1.7976931348623158e96".to_float() !!) == 0x53eaee90b964b047)
}

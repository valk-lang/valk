test "Floats" {
    let a = 0.5
    let b = 1.7
    let c = -5.2
    let d = -0.0
    let e = 10

    assert(a == "0.5")
    assert(b == "1.7")
    assert(c == "-5.2")
    assert(d == "-0")
    assert(e == "10")

    let sum = a + b
    assert(sum == 2.2)
    sum += c
    assert(sum == -3)
    sum /= 3
    assert(sum == -1)
    sum += d
    assert(sum == -1)
    sum += e
    assert(sum == 9)
}

test "Floats: operator compatibility" {
    //
    let v_f0 : float = 0.0
    let v_f1 : float = 0.01
    let v_u8 : u8 = 0
    let v_i8 : i8 = 0
    let v_uint : uint = 0
    let v_int : int = 0
    //
    assert(v_f1 > v_i8)
    assert(v_f1 > v_u8)
    assert(v_f1 > v_uint)
    assert(v_f1 > v_int)
    // Reverse
    assert(v_i8 < v_f1)
    assert(v_u8 < v_f1)
    assert(v_uint < v_f1)
    assert(v_int < v_f1)
    //
    assert(v_i8 < 0.01)
    assert(v_u8 < 0.01)
    assert(v_uint < 0.01)
    assert(v_int < 0.01)
    //
    assert(0.01 > v_i8)
    assert(0.01 > v_u8)
    assert(0.01 > v_uint)
    assert(0.01 > v_int)
    //
    assert(0.0 == 0)
    assert(0 == 0.0)
    assert(0.0 == v_u8)
    assert(v_u8 == 0.0)
    assert(v_f0 == 0)
    assert(0 == v_f0)
    // String compare
    assert(0.0 == "0")
    assert(0 == "0")
    assert("0" == 0.0)
    assert("0" == 0)
    assert(v_f0 == "0")
    assert(v_int == "0")
    assert("0" == v_f0)
    assert("0" == v_int)
}

test "Floats: NaN comparisons follow IEEE 754" {
    let zero = 0.0
    let nan = zero / zero
    assert(nan != nan)
    assert(!(nan == nan))
    assert(!(nan < nan))
    assert(!(nan <= nan))
    assert(!(nan > nan))
    assert(!(nan >= nan))
}

test "Floats: shortest strings round trip" {
    let bits: u64 = 1
    let i: uint = 0
    let failure = ""
    while i++ < 2048 {
        bits = (bits * 6364136223846793005.to(u64) + 1442695040888963407.to(u64)) & 0x7fefffffffffffff
        if (i & 1) != 0 : bits |= 1.to(u64) << 63
        let value = @ptrv(&bits, f64)
        let text: String = value
        if failure == "" && (text.to_float() !? 0.0) != value : failure = "f64 #%i: %text did not round trip"
    }

    let single_bits: u32 = 1
    i = 0
    while i++ < 2048 {
        single_bits = (single_bits * 1664525.to(u32) + 1013904223.to(u32)) & 0x7f7fffff
        if (i & 1) != 0 : single_bits |= 1.to(u32) << 31
        let value = @ptrv(&single_bits, f32)
        let text: String = value
        if failure == "" && (text.to_float() !? 0.0).to(f32) != value : failure = "f32 #%i: %text did not round trip"
    }
    if failure != "" : println(failure)
    assert(failure == "")

    bits = 1
    let minimum = @ptrv(&bits, f64)
    let minimum_text: String = minimum
    assert((minimum_text.to_float() !? 0.0) == minimum)
    bits = 0x7fefffffffffffff
    let maximum = @ptrv(&bits, f64)
    let maximum_text: String = maximum
    assert((maximum_text.to_float() !? 0.0) == maximum)
}

fn f64_bits(value: f64) u64 {
    return @ptrv(&value, u64)
}

test "Floats: long decimal inputs are correctly rounded" {
    assert(f64_bits("1000000000000000000000000000000".to_float() !!) == 0x46293e5939a08cea)
    assert(f64_bits("10000000000000000000000000000000000000".to_float() !!) == 0x479e17b84357691b)
    assert(f64_bits("1.7976931348623158e96".to_float() !!) == 0x53eaee90b964b047)
}

test "Floats: large literals and negative zero keep their value" {
    let big = 9223372036854775807.0
    assert(big > 9000000000000000000.0)
    assert(big.to_string() == "9223372036854776000")
    let z = -0.0
    assert(z == "-0")
    let plain = 0.0
    assert((-plain) == "-0")
    let v: String = -0.0
    assert(v == "-0")
}

fn float_nan() float { let zero = 0.0; return zero / zero }
fn float_huge() float { return 1000000000000000000000000000000.0 }

test "Floats: conversion to integers saturates" {
    // NaN and out-of-range values must not produce poison
    assert(float_nan().to(int) == 0)
    assert(float_nan().to(uint) == 0)
    assert(float_huge().to(u8) == 255)
    assert(float_huge().to(i32) == 2147483647)
    assert((0.0 - float_huge()).to(i16) == -32768)
    assert((0.0 - 5.5).to(uint) == 0)
    assert((0.0 - 5.9).to(i8) == -5)
    assert(5.9.to(u8) == 5)
    assert(300.0.to(u8) == 255)
    let count = float_nan().to(uint)
    let buffer = [u8]{ 0 x count }
    assert(buffer.length == 0)
}

test "Floats: bools convert to float" {
    assert(true.to(float) == 1.0)
    assert(false.to(float) == 0.0)
    assert(true.to(f64) == 1.0)
    assert(false.to(f32) == 0.0)
    assert((1 < 2).to(f64) == 1.0)
    assert(true.to(int) == 1)
}

fn float_double_f32(value: f32) f32 { return value * 2.0 }

test "Floats: literals take the width of their target" {
    let single: f32 = 3.7
    let double: f64 = 0.25
    let negative: f32 = -1.5
    assert(single == "3.7")
    assert(double == 0.25)
    assert(negative == -1.5)
    assert(float_double_f32(1.25) == 2.5)
    let values = Array[f32]{ 1.5, 2.5 }
    assert(values[1] == 2.5)
    let sum: f32 = single + 0.3
    assert(sum > 3.9)
}

test "Floats: exponent literals" {
    let a = 1e3
    let b = 2.5E-3
    let c: f32 = 1.5e+1
    assert(a == 1000)
    assert(b == 0.0025)
    assert(c == 15)
    assert(6.02e23 > 6e23)
    let e3 = 7
    assert(e3 == 7)
}

test "Floats: to_string clamps the decimals" {
    assert(1.5.to_string(19) == "1.5000000000000000000")
    assert(1.5.to_string(80) == "1.5000000000000000000")
    assert(1.5.to_string(400, true) == "1.5")
    assert((-0.25).to_string(30) == "-0.2500000000000000000")
    assert(0.1.to_string(19).starts_with("0.1000000000000000"))
    assert(123.456.to_string(0) == "123")
    assert(1000000000000000000.0.to_string(19).length == 39)
}

test "Floats: remainder does not need valk.math" {
    let a = 5.5
    let b = 2.0
    assert(a % b == 1.5)
    assert((-5.5) % b == -1.5)
    let c = 7.25.to(f32)
    assert(c % 2 == 1.25)
}

fn float_width_of(v: $T) uint { return size_of(T) }

test "Floats: literals take the width of the other operand" {
    let f: f32 = 0.1
    assert(f == 0.1)
    assert(0.1 == f)
    assert(f.to(f64) != 0.1)
    assert(float_width_of(f + 0.1) == 4)
    assert(f + 0.1 == 0.2)
    assert(float_width_of(f * 2) == 4)
    assert(f * 2 == 0.2)
    assert(float_width_of(2 - f) == 4)
    let d: f64 = 0.1
    assert(float_width_of(d + 0.1) == 8)
    assert(d + 0.2 != 0.3)
}

@unsafe

use valk.http
use valk.net
use valk.time

fn status_handler(req: http.Request) http.Response {
    let digits = req.path.ltrim("/")
    let code = digits.to_uint() !? 200
    return http.Response.empty(code.to(u32))
}

fn status_server() {
    let server = http.Server.new("127.0.0.1", 9027, status_handler) ! return
    server.start(1)
}

fn status_line(path: String) String {
    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9027) ! return ""
    let request = "GET " + path + " HTTP/1.1\r\nHost: localhost\r\n\r\n"
    connection.send_bytes(request.data, request.bytes, true) ! return ""
    let response = ByteBuffer.new(256)
    connection.recv(response, 256) ! return ""
    let text = response.to_string()
    connection.close() ! return ""
    let newline = text.index_of_byte('\n') ! return ""
    return text.part(0, newline).replace("\r", "")
}

fn status_raw_server(port: u16, response: String) {
    let server = net.Socket.server(net.SocketType.tcp, "127.0.0.1", port) ! return
    let connection = server.accept() ! return
    let buffer = ByteBuffer.new(2048)
    connection.recv(buffer, 2048) ! return
    connection.send_bytes(response.data, response.bytes, true) ! return
    time.sleep_ms(80)
    connection.close() ! return
    server.close() ! return
}

// 0 means the client refused to parse the status line at all.
fn status_from_raw(port: u16, status_line: String) uint {
    co status_raw_server(port, status_line + "Content-Length: 0\r\n\r\n")
    time.sleep_ms(60)
    let res = http.request("GET", "http://127.0.0.1:" + port.to_string() + "/") ! return 0
    return res.status
}

test "HTTP: status line does not claim OK for codes that are not OK" {
    co status_server()

    // Codes with a known phrase keep it.
    assert(status_line("/200") == "HTTP/1.1 200 OK")
    assert(status_line("/301") == "HTTP/1.1 301 Moved Permanently")
    assert(status_line("/400") == "HTTP/1.1 400 Bad Request")
    assert(status_line("/413") == "HTTP/1.1 413 Content Too Large")
    assert(status_line("/501") == "HTTP/1.1 501 Not Implemented")
    assert(status_line("/503") == "HTTP/1.1 503 Service Unavailable")

    // An unlisted code gets the empty reason-phrase that RFC 9112 §9 allows.
    // Before this it printed "HTTP/1.1 404 OK", which 404, 405, 500 and 502 all
    // shared. The space between the code and the phrase is still there.
    let missing = status_line("/404")
    assert(missing == "HTTP/1.1 404 ")
    assert(!missing.contains("OK"))
    assert(status_line("/405") == "HTTP/1.1 405 ")
    assert(status_line("/599") == "HTTP/1.1 599 ")

    // Reading back the three status-line spellings a real server may send.
    assert(status_from_raw(9028, "HTTP/1.1 200 OK\r\n") == 200)
    assert(status_from_raw(9029, "HTTP/1.1 404 \r\n") == 404)
    assert(status_from_raw(9030, "HTTP/1.1 404\r\n") == 404)
    assert(status_from_raw(9031, "HTTP/1.1 500 Internal Server Error\r\n") == 500)

    // Still rejected: a status line with no code after the version. The next
    // space on the wire belongs to a header, so it must not be swallowed here.
    assert(status_from_raw(9032, "HTTP/1.1 \r\n") == 0)
}

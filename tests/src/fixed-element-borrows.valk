use valk.gc

class FixedBorrowItem { number: int }
struct FixedBorrowCell {
    child: ?FixedBorrowItem (null)
    count: int (0)
    fn set(number: int) {
        this.child = FixedBorrowItem { number: number }
        this.count++
    }
}
class FixedBorrowHolder {
    nullable: [?FixedBorrowItem x 2] ({ null, null })
    required: [FixedBorrowItem x 2] ({ FixedBorrowItem { number: 7 }, FixedBorrowItem { number: 19 } })
    cells: [FixedBorrowCell x 2] ({ {}, {} })
}
class FixedBorrowFactory {
    calls: int (0)
    indices: int (0)
    fn make() FixedBorrowHolder { this.calls++; return .{} }
    fn index() uint { this.indices++; return 1 }
}
fn fixed_borrow_nullable(holder: FixedBorrowHolder) &?FixedBorrowItem { return &holder.nullable[0] }
fn fixed_borrow_required(holder: FixedBorrowHolder) &FixedBorrowItem { return &holder.required[0] }
fn fixed_borrow_put(slot: stack ?FixedBorrowItem, number: int) {
    slot[0] = FixedBorrowItem { number: number }
}
fn fixed_borrow_number(item: ?FixedBorrowItem) int {
    let value = item ?! return 0
    return value.number
}

test "Fixed element borrows: managed slots retain their original storage" {
    let holder = FixedBorrowHolder {}
    let nullable = fixed_borrow_nullable(holder)
    assert(!isset(nullable[0]))
    nullable[0] = FixedBorrowItem { number: 23 }
    assert(fixed_borrow_number(holder.nullable[0]) == 23)
    let required = fixed_borrow_required(holder)
    required[0] = FixedBorrowItem { number: 29 }
    assert(holder.required[0].number == 29)
    holder = .{}
    gc.collect()
    assert(fixed_borrow_number(nullable[0]) == 23 && required[0].number == 29)
    nullable[0] = null
    assert(!isset(nullable[0]))
}

test "Fixed element borrows: inline receivers mutate the actual element" {
    let holder = FixedBorrowHolder {}
    holder.cells[0].set(31)
    assert(holder.cells[0].count == 1)
    assert(fixed_borrow_number(holder.cells[0].child) == 31)
    let cell = &holder.cells[1]
    cell.set(37)
    gc.collect()
    assert(holder.cells[1].count == 1)
    assert(fixed_borrow_number(holder.cells[1].child) == 37)
    fixed_borrow_put(&holder.nullable[1], 41)
    assert(fixed_borrow_number(holder.nullable[1]) == 41)
}

test "Fixed element borrows: local slots and temporary owners evaluate once" {
    let local: [?FixedBorrowItem x 2] = { null, null }
    fixed_borrow_put(&local[0], 43)
    gc.collect()
    assert(fixed_borrow_number(local[0]) == 43)
    let factory = FixedBorrowFactory {}
    let required = &factory.make().required[factory.index()]
    assert(factory.calls == 1 && factory.indices == 1)
    gc.collect()
    assert(required[0].number == 19)
    required[0] = FixedBorrowItem { number: 47 }
    assert(required[0].number == 47)
}

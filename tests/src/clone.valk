use valk.core
use valk.sync
use valk.http
use valk.regex
use valk.random
use valk.time
use valk.fs

struct ClonePoint {
    x: int
    y: int
}
struct CloneInline {
    child: CloneInner
}
class CloneInner {
    v: int
}
union CloneUnion : CloneInner | int {}
class CloneOuter {
    a: int
    b: String
    c: ?CloneInner
    d: CloneInner
}
class CloneAggregateHolder {
    values: [CloneInner x 1]
    tagged: CloneUnion
}


class CloneRaw {
    buf: ptr
    n: int

    fn clone() SELF {
        return CloneRaw { buf: this.buf, n: this.n }
    }
}
struct CloneRawArray {
    values: [ptr x 1]
}
struct CloneRawNested {
    value: CloneRawArray
}
union CloneRawUnion : ptr | int {}
class CloneRawHolder {
    value: CloneRaw
}

test "Clone: plain values are returned as they are" {
    assert(core.clone_value(7) == 7)
    assert(core.clone_value(true))
}

test "Clone: structs are copied by property" {
    let p = ClonePoint { x: 1, y: 2 }
    let c = core.clone_value(p)
    assert(c.x == 1 && c.y == 2)
}

test "Clone: a type with clone() copies itself" {
    // Array and String own a buffer, so only they know how to duplicate it.
    let a = Array[String]{}
    a.append("a")
    let b = core.clone_value(a)
    b.append("second")
    assert(a.length == 1 && b.length == 2)
    assert((b.get(0) !? "") == "a")

    let s = core.clone_value("text")
    assert(s == "text")
}

test "Clone: nested objects are copied, not shared" {
    let o = CloneOuter {
        a: 1
        b: "two"
        c: null
        d: CloneInner { v: 3 }
    }
    let c = core.clone_value(o)
    assert(c.a == 1 && c.b == "two")
    assert(c.c == null)


    assert(c.d != o.d)
    c.d.v = 99
    assert(o.d.v == 3 && c.d.v == 99)
}

test "Clone: nullable properties survive a round trip" {
    let o = CloneOuter {
        a: 4
        b: "x"
        c: CloneInner { v: 5 }
        d: CloneInner { v: 6 }
    }
    let c = core.clone_value(o)
    let inner = c.c
    assert(isset(inner) && inner.v == 5)
    if isset(inner) : assert(inner != o.c)
}

test "Clone: a raw pointer type with clone() is accepted" {
    let r = CloneRaw { buf: 1.@cast(ptr), n: 8 }
    let c = core.clone_value(r)
    assert(c.n == 8)

    let holder = CloneRawHolder { value: r }
    let holder_copy = clone holder
    assert(holder_copy != holder && holder_copy.value != r)
}

test "Clone: raw pointer properties include inline aggregates" {
    assert(CloneRaw.$has_raw_pointer_props)
    assert(CloneRawArray.$has_raw_pointer_props)
    assert(CloneRawNested.$has_raw_pointer_props)
    assert(CloneRawUnion.$has_raw_pointer_props)
    assert(!CloneOuter.$has_raw_pointer_props)
}

test "Clone: accessible clone method owns private storage" {
    let original = CloneViaMethod.make(71)
    let copied = clone original
    assert(copied != original && copied.result == 72)
}

test "Clone: inaccessible clone method uses writable properties" {
    let original = ClonePrivateMethod { value: 73 }
    let copied = clone original
    assert(copied != original && copied.value == 73)
}

test "Clone: hidden capability reaches container elements" {
    let original = Array[CloneViaMethod]{ CloneViaMethod.make(74) }
    let copied = clone original
    let direct = original.clone()
    assert((copied.get(0) !!).result == 75)
    assert((direct.get(0) !!).result == 75)
}

test "Clone: the method named clone is the hook" {
    let copied = clone CloneNamedOnly { value: 76 }
    assert(copied.value == 999)
}

test "Clone: inline structs clone managed fields" {
    let original: CloneInline = { child: CloneInner { v: 11 } }
    let copied = clone original
    assert(copied.child != original.child)
    copied.child.v = 12
    assert(original.child.v == 11)
}

test "Clone: fixed arrays clone every element" {
    let original: [CloneInner x 2] = { CloneInner { v: 21 }, CloneInner { v: 22 } }
    let copied = clone original
    assert(copied[0] != original[0] && copied[1] != original[1])
    copied[0].v = 23
    assert(original[0].v == 21)
}

test "Clone: aggregate properties receive fresh ownership" {
    let original = CloneAggregateHolder {
        values: { CloneInner { v: 24 } }
        tagged: CloneInner { v: 25 }
    }
    let copied = clone original
    assert(copied.values[0] != original.values[0])
    match copied.tagged {
        CloneInner as child => child.v = 26
        default => assert(false)
    }
    match original.tagged {
        CloneInner as child => assert(child.v == 25)
        default => assert(false)
    }
}

test "Clone: arrays of inline structs compile and clone" {
    let original = Array[CloneInline]{ .{ child: CloneInner { v: 27 } } }
    let copied = clone original
    let original_value = original.get(0) !!
    let copied_value = copied.get(0) !!
    assert(copied_value.child != original_value.child)
}

test "Clone: tagged unions clone only their active value" {
    let original: CloneUnion = CloneInner { v: 31 }
    let copied = clone original
    match copied {
        CloneInner as child => child.v = 32
        default => assert(false)
    }
    match original {
        CloneInner as child => assert(child.v == 31)
        default => assert(false)
    }

    let scalar: CloneUnion = 41
    let scalar_copy = clone scalar
    match scalar_copy {
        int as value => assert(value == 41)
        default => assert(false)
    }

    let missing: ?CloneUnion = null
    assert(!isset(clone missing))
    let nullable: ?CloneUnion = CloneInner { v: 42 }
    let nullable_copy = clone nullable
    match nullable_copy {
        CloneInner as child => child.v = 43
        default => assert(false)
    }
    match nullable {
        CloneInner as child => assert(child.v == 42)
        default => assert(false)
    }
}

test "Clone: nullable fixed arrays preserve presence" {
    let present: ?[CloneInner x 1] = { CloneInner { v: 44 } }
    let missing: ?[CloneInner x 1] = null
    assert(isset(clone present))
    assert(!isset(clone missing))
}

test "Clone: closure arrays do not share captured children" {
    let values: [CloneInner x 1] = { CloneInner { v: 1 } }
    let original = fn() uint {
        values[0].v++
        return values[0].v
    }
    let copied = clone original
    assert(copied() == 2)
    assert(copied() == 3)
    assert(original() == 2)
}

class ClonePublishedEntry { count: uint (0) }
class ClonePublishedState { entry: ClonePublishedEntry }

test "Clone: structural copies can be published independently" {
    let original = ClonePublishedState { entry: .{ count: 7 } }
    let published: atomic ClonePublishedState = clone original
    original.entry.count = 9
    assert(published.entry.count == 7)
    assert(original.entry.count == 9)
}

union ClonePublishedItem : ClonePublishedEntry | uint {}
class ClonePublishedAggregate {
    values: ?[ClonePublishedEntry x 1]
    item: ?ClonePublishedItem
}

fn clone_published_aggregate() ClonePublishedAggregate {
    return ClonePublishedAggregate {
        values: { ClonePublishedEntry { count: 11 } }
        item: ClonePublishedEntry { count: 13 }
    }
}

test "Clone: fresh nullable aggregates retain their ownership" {
    let original = clone_published_aggregate()
    let published: atomic ClonePublishedAggregate = clone original
    let values = original.values
    if isset(values) : values[0].count = 17
    let copied = published.values
    assert(isset(copied) && copied[0].count == 11)
    match published.item {
        ClonePublishedEntry as entry => assert(entry.count == 13)
        default => assert(false)
    }
    let fresh: atomic ClonePublishedAggregate = clone_published_aggregate()
    assert(isset(fresh.values))
}

test "Nullable fixed arrays: narrowing reads and writes their payload" {
    let values: ?[uint x 1] = { 3 }
    if isset(values) {
        assert(values[0] == 3)
        values[0] = 5
        assert(values[0] == 5)
    } else : assert(false)
    assert(isset(values) && values[0] == 5)
}

class CloneTupleItem { n: uint (0) }

test "Clone: a tuple is copied with its objects, like a fixed array" {
    let pair = (CloneTupleItem{ n: 1 }, 2)
    let copy = clone pair
    copy[0].n = 5
    assert(pair[0].n == 1 && copy[0].n == 5 && copy[1] == 2)
}

class CloneSharedOwner {
    items: Array[CloneSharedItem] (.{})
    wake: ?atomic sync.Channel[bool] (null)
}
class CloneSharedItem {
    owner: CloneSharedOwner
}

test "Clone: a field declared shared keeps the same shared data in the copy" {
    let owner = CloneSharedOwner {}
    owner.wake = sync.Channel[bool].new(1) !!
    let list = CloneSharedOwner {}
    list.items.append(CloneSharedItem { owner: owner })
    let copy = list.items.clone()
    let item = copy.get(0) !!
    assert(item.owner != owner)
    assert(item.owner.wake == owner.wake)
    // A closure that captures such an object can be cloned too
    let f = fn() uint { return list.items.length }
    let g = clone f
    assert(g() == 1)
}

class CopyInner { n: int (0) }
class CopyOuter {
    n: int (0)
    inner: CopyInner (.{})
}

test "Copy: copy is shallow, clone is deep" {
    let a = CopyOuter { n: 1, inner: CopyInner { n: 2 } }
    let shallow = copy a
    let deep = clone a
    shallow.n = 5
    shallow.inner.n = 6
    assert(a.n == 1 && a.inner.n == 6)
    assert(deep.n == 1 && deep.inner.n == 2)
    assert(shallow.inner == a.inner && deep.inner != a.inner)
}

test "Copy: collections copy through their copy method" {
    let items = Array[CopyInner]{ CopyInner { n: 1 } }
    let copied = copy items
    copied.append(CopyInner { n: 2 })
    assert(items.length == 1 && copied.length == 2)
    assert((copied.get(0) !!) == (items.get(0) !!))
    let bytes: &[u8] = "abc"
    let own = copy bytes
    own[0] = 'x'
    assert(own[0] == 'x' && bytes[0] == 'a')
}

test "Copy: atomic data copies into a plain collection of atomic parts" {
    let list: atomic Array[CopyInner] = .{ CopyInner { n: 1 } }
    let mine = copy list
    mine.append(CopyInner { n: 2 })
    assert(mine.length == 2 && list.length == 1)
}

test "Copy: copy and clone stay usable as names" {
    let copy = Array[int]{ 1, 2 }
    let clone = copy.copy()
    clone.append(3)
    assert(copy.length == 2 && clone.length == 3)
    let filled = [int]{ copy.length x 2 }
    assert(filled.length == 2 && filled[0] == 2)
}

test "Clone: stdlib values with private fields clone through their clone method" {
    let headers = http.Headers.new()
    headers.set("a", "1")
    let headers2 = clone headers
    headers2.set("a", "2")
    assert((headers.get("a") !? "") == "1" && (headers2.get("a") !? "") == "2")
    let pattern = regex.Regex.new("a+b") !!
    let published: atomic regex.Regex = pattern
    assert(published.pattern == "a+b" && (clone pattern).is_match("xaab"))
    let rng = random.Rng.new(7)
    let twin = clone rng
    assert(rng.next() == twin.next())
    let zone = time.zone_from_posix("CET-1CEST,M3.5.0,M10.5.0/3") !!
    let zone2 = clone zone
    assert(zone2.name == zone.name)
    let file = fs.InMemoryFile.new("abc")
    let file2 = clone file
    assert(file2.data.length == 3 && file2.filename == file.filename)
}

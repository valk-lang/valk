use valk:core

struct ClonePoint {
    x: int
    y: int
}
struct CloneInline {
    child: CloneInner
}
class CloneInner {
    v: int
}
union CloneUnion : CloneInner | int {}
class CloneOuter {
    a: int
    b: String
    c: ?CloneInner
    d: CloneInner
}
class CloneAggregateHolder {
    values: [CloneInner x 1]
    tagged: CloneUnion
}
// A raw pointer would be shared rather than duplicated by a property-wise copy,
// so clone_value refuses such a type unless it says how to copy itself.
class CloneRaw {
    buf: ptr
    n: int

    fn clone() SELF $clone {
        return CloneRaw { buf: this.buf, n: this.n }
    }
}

test "Clone: plain values are returned as they are" {
    assert(core:clone_value(7) == 7)
    assert(core:clone_value(true))
}

test "Clone: structs are copied by property" {
    let p = ClonePoint { x: 1, y: 2 }
    let c = core:clone_value(p)
    assert(c.x == 1 && c.y == 2)
}

test "Clone: a type with clone() copies itself" {
    // Array and String own a buffer, so only they know how to duplicate it.
    let a = Array[String]{}
    a.append("a")
    let b = core:clone_value(a)
    b.append("second")
    assert(a.length == 1 && b.length == 2)
    assert((b.get(0) !? "") == "a")

    let s = core:clone_value("text")
    assert(s == "text")
}

test "Clone: nested objects are copied, not shared" {
    let o = CloneOuter {
        a: 1
        b: "two"
        c: null
        d: CloneInner { v: 3 }
    }
    let c = core:clone_value(o)
    assert(c.a == 1 && c.b == "two")
    assert(c.c == null)
    // The copy owns its own CloneInner: writing through one is not visible in
    // the other, which is the whole point of a deep copy.
    assert(c.d != o.d)
    c.d.v = 99
    assert(o.d.v == 3 && c.d.v == 99)
}

test "Clone: nullable properties survive a round trip" {
    let o = CloneOuter {
        a: 4
        b: "x"
        c: CloneInner { v: 5 }
        d: CloneInner { v: 6 }
    }
    let c = core:clone_value(o)
    let inner = c.c
    assert(isset(inner) && inner.v == 5)
    if isset(inner) : assert(inner != o.c)
}

test "Clone: a raw pointer type with clone() is accepted" {
    let r = CloneRaw { buf: null, n: 8 }
    let c = core:clone_value(r)
    assert(c.n == 8)
}

test "Clone: accessible clone method owns private storage" {
    let original = CloneViaMethod.make(71)
    let copied = $clone(original)
    assert(copied != original && copied.result == 72)
}

test "Clone: inaccessible clone method uses writable properties" {
    let original = ClonePrivateMethod { value: 73 }
    let copied = $clone(original)
    assert(copied != original && copied.value == 73)
}

test "Clone: hidden capability reaches container elements" {
    let original = Array[CloneViaMethod]{ CloneViaMethod.make(74) }
    let copied = $clone(original)
    let direct = original.clone()
    assert((copied.get(0) !!).result == 75)
    assert((direct.get(0) !!).result == 75)
}

test "Clone: unflagged clone method is not a hook" {
    let copied = $clone(CloneNamedOnly { value: 76 })
    assert(copied.value == 76)
}

test "Clone: inline structs clone managed fields" {
    let original: <CloneInline> = { child: CloneInner { v: 11 } }
    let copied = $clone(original)
    assert(copied.child != original.child)
    copied.child.v = 12
    assert(original.child.v == 11)
}

test "Clone: fixed arrays clone every element" {
    let original = [CloneInner x 2]{ CloneInner { v: 21 }, CloneInner { v: 22 } }
    let copied = $clone(original)
    assert(copied[0] != original[0] && copied[1] != original[1])
    copied[0].v = 23
    assert(original[0].v == 21)
}

test "Clone: aggregate properties receive fresh ownership" {
    let original = CloneAggregateHolder {
        values: { CloneInner { v: 24 } }
        tagged: CloneInner { v: 25 }
    }
    let copied = $clone(original)
    assert(copied.values[0] != original.values[0])
    match copied.tagged {
        CloneInner as child => child.v = 26
        default => assert(false)
    }
    match original.tagged {
        CloneInner as child => assert(child.v == 25)
        default => assert(false)
    }
}

test "Clone: arrays of inline structs compile and clone" {
    let original = Array[<CloneInline>]{ { child: CloneInner { v: 27 } } }
    let copied = $clone(original)
    let original_value = original.get(0) !!
    let copied_value = copied.get(0) !!
    assert(copied_value.child != original_value.child)
}

test "Clone: tagged unions clone only their active value" {
    let original: CloneUnion = CloneInner { v: 31 }
    let copied = $clone(original)
    match copied {
        CloneInner as child => child.v = 32
        default => assert(false)
    }
    match original {
        CloneInner as child => assert(child.v == 31)
        default => assert(false)
    }

    let scalar: CloneUnion = 41
    let scalar_copy = $clone(scalar)
    match scalar_copy {
        int as value => assert(value == 41)
        default => assert(false)
    }

    let missing: ?CloneUnion = null
    assert(!isset($clone(missing)))
    let nullable: ?CloneUnion = CloneInner { v: 42 }
    let nullable_copy = $clone(nullable)
    match nullable_copy {
        CloneInner as child => child.v = 43
        default => assert(false)
    }
    match nullable {
        CloneInner as child => assert(child.v == 42)
        default => assert(false)
    }
}

test "Clone: nullable fixed arrays preserve presence" {
    let present: ?[CloneInner x 1] = [CloneInner x 1]{ CloneInner { v: 44 } }
    let missing: ?[CloneInner x 1] = null
    assert(isset($clone(present)))
    assert(!isset($clone(missing)))
}

test "Clone: closure arrays do not share captured children" {
    let values = [CloneInner x 1]{ CloneInner { v: 1 } }
    let original = fn() uint {
        values[0].v++
        return values[0].v
    }
    let copied = $clone(original)
    assert(copied() == 2)
    assert(copied() == 3)
    assert(original() == 2)
}

use valk.gc

// Inline aggregates of 512 bytes or more come back through a pointer the caller
// passes (ir_rett_by_pointer); every kind of call must agree on that

value BR_SIZE (300)

global br_table: [u32 x BR_SIZE] (br_make(1))

fn br_make(seed: u32) [u32 x BR_SIZE] {
    let out: [u32 x BR_SIZE] = @undefined
    let i: uint = 0
    while i < BR_SIZE {
        out[i] = seed + i.to(u32) * 3
        i++
    }
    return out
}

// A chain of returns writes the caller's slot directly
fn br_make_twice(seed: u32) [u32 x BR_SIZE] {
    return br_make(seed * 2)
}

fn br_sum(table: [u32 x BR_SIZE]) uint {
    let total: uint = 0
    each table as v : total += v.to(uint)
    return total
}

fn br_expected(seed: u32) uint {
    let total: uint = 0
    let i: uint = 0
    while i < BR_SIZE {
        total += (seed + i.to(u32) * 3).to(uint)
        i++
    }
    return total
}

struct BrPair {
    a: [u32 x BR_SIZE]
    b: [u32 x BR_SIZE]
}

fn br_pair(seed: u32) BrPair {
    return BrPair { a: br_make(seed), b: br_make(seed + 1) }
}

interface BrSource {
    fn table() [u32 x BR_SIZE];
    fn fallible_table(fail: bool) [u32 x BR_SIZE] !AnError;
}

class BrGen is BrSource {
    seed: u32
    fn table() [u32 x BR_SIZE] {
        return br_make(this.seed)
    }
    fn fallible_table(fail: bool) [u32 x BR_SIZE] !AnError {
        if fail : throw .error
        return br_make(this.seed + 5)
    }
    // Infallible implementation of the fallible requirement: called through a thunk
    fn padded() [u32 x BR_SIZE] {
        return this.table()
    }
}

class BrHolder {
    table: [u32 x BR_SIZE] (br_make(9))
}

fn br_apply(f: fn(u32)([u32 x BR_SIZE]), seed: u32) uint {
    return br_sum(f(seed))
}

test "Big returns: direct calls, chains, globals, fields and assignments" {
    assert(br_sum(br_table) == br_expected(1))
    assert(br_sum(br_make(4)) == br_expected(4))
    assert(br_sum(br_make_twice(4)) == br_expected(8))
    let local = br_make(7)
    assert(local[0] == 7)
    assert(local[BR_SIZE - 1] == 7 + (BR_SIZE - 1) * 3)
    local = br_make_twice(3)
    assert(br_sum(local) == br_expected(6))
    br_table = br_make(2)
    assert(br_sum(br_table) == br_expected(2))
    let pair = br_pair(10)
    assert(br_sum(pair.a) == br_expected(10))
    assert(br_sum(pair.b) == br_expected(11))
    let holder = BrHolder {}
    assert(br_sum(holder.table) == br_expected(9))
    holder.table = br_make(12)
    assert(br_sum(holder.table) == br_expected(12))
}

test "Big returns: closures, function pointers and bound methods" {
    let closure: fn(u32)([u32 x BR_SIZE]) = br_make
    assert(br_sum(closure(5)) == br_expected(5))
    assert(br_apply(br_make, 6) == br_expected(6))
    let offset: u32 = 100
    let capturing = fn(seed: u32) [u32 x BR_SIZE] { return br_make(seed + offset) }
    assert(br_apply(capturing, 1) == br_expected(101))
    let pointer: fnptr(u32)([u32 x BR_SIZE]) = br_make
    assert(br_sum(pointer(13)) == br_expected(13))
    let gen = BrGen { seed: 20 }
    let bound = gen.table
    assert(br_sum(bound()) == br_expected(20))
    let unbound: fn(BrGen)([u32 x BR_SIZE]) = BrGen.table
    assert(br_sum(unbound(gen)) == br_expected(20))
    gc.collect()
    assert(br_sum(closure(5)) == br_expected(5))
}

test "Big returns: interface dispatch and coroutines" {
    let gen = BrGen { seed: 30 }
    let source: BrSource = gen
    assert(br_sum(source.table()) == br_expected(30))
    assert(br_sum(source.fallible_table(false) !!) == br_expected(35))
    let failed = false
    source.fallible_table(true) ! failed = true
    assert(failed)
    assert(br_sum(gen.padded()) == br_expected(30))
    let task = co br_make(40)
    assert(br_sum(await task) == br_expected(40))
    let method_task = co gen.table()
    assert(br_sum(await method_task) == br_expected(30))
    let fallible_task = co source.fallible_table(false)
    assert(br_sum(await fallible_task !!) == br_expected(35))
}

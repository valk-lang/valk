use valk.gc

// Array operations that copy or move elements of owned storage, checked with a
// collection after each step: a premature free shows as a wrong value, a GC_DEBUG
// panic or a leak-check failure, a leak as a count that stays too high

global box_alive: uint
global box_array: ?Array[GcBox] (null)
global box_copy: ?Array[GcBox] (null)

class GcBox {
    value: uint

    fn gc_free() {
        box_alive--
    }
}

fn gc_box(value: uint) GcBox {
    box_alive++
    return GcBox { value: value }
}

fn box_fill(count: uint) $noinline {
    let items = Array[GcBox].new(count)
    let i: uint = 0
    while i < count {
        items.append(gc_box(i))
        i++
    }
    box_array = items
}

fn box_values() String $noinline {
    let items = box_array ?! return "none"
    return items.map(fn(b: GcBox) String { return b.value.to_string() }).join(",")
}

fn box_reset() uint {
    box_array = null
    box_copy = null
    gc.collect()
    gc.collect()
    return box_alive
}

fn box_range() $noinline {
    let items = box_array ?! panic("array missing")
    box_copy = items.range(1, 3)
}

fn box_copy_values() String $noinline {
    let items = box_copy ?! return "none"
    return items.map(fn(b: GcBox) String { return b.value.to_string() }).join(",")
}

synctest "GC: range copies owned elements without their ownership" {
    let base = box_reset()
    box_fill(5)
    gc.collect()
    box_range()
    box_array = null
    gc.collect()
    gc.collect()
    assert(box_copy_values() == "1,2,3")
    assert(box_alive - base == 3)
    assert(box_reset() == base)
}

fn box_shift() $noinline {
    let items = box_array ?! panic("array missing")
    items.prepend(gc_box(10))
    gc.collect()
    items.insert(2, gc_box(11)) ! panic("insert failed")
    gc.collect()
    items.prepend_many(Array[GcBox]{ gc_box(12), gc_box(13) })
    gc.collect()
    items.prepend_many(items)
}

synctest "GC: prepend, insert and prepend_many keep the elements they shift" {
    let base = box_reset()
    box_fill(3)
    gc.collect()
    box_shift()
    gc.collect()
    gc.collect()
    assert(box_values() == "12,13,10,0,11,1,2,12,13,10,0,11,1,2")
    assert(box_alive - base == 7)
    assert(box_reset() == base)
}

fn box_duplicates() $noinline {
    let a = gc_box(1)
    let b = gc_box(2)
    box_array = Array[GcBox]{ a, b, a, gc_box(3), b, a }
}

fn box_dedupe() $noinline {
    let items = box_array ?! panic("array missing")
    items.remove_duplicates()
}

synctest "GC: remove_duplicates keeps one owner per element" {
    let base = box_reset()
    box_duplicates()
    gc.collect()
    box_dedupe()
    gc.collect()
    gc.collect()
    assert(box_values() == "1,2,3")
    assert(box_alive - base == 3)
    assert(box_reset() == base)
}

// A view still covers the slot the array cleared; what it writes there is released when the
// array appends over it
fn box_write_past_length() $noinline {
    let items = Array[GcBox]{ gc_box(0), gc_box(1) }
    box_array = items
    let view = items.view()
    items.pop_last() ! panic("pop failed")
    view[1] = gc_box(2)
    gc.collect()
    items.append(gc_box(3))
}

synctest "GC: append releases an element a view wrote past the length" {
    let base = box_reset()
    box_write_past_length()
    gc.collect()
    gc.collect()
    assert(box_values() == "0,3")
    assert(box_alive - base == 2)
    assert(box_reset() == base)
}

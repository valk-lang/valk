use valk.sync
use valk.thread

// A call result that is a unique graph converts to a shared parameter the
// same way `let f: shared T = call()` does, also when the callee keeps it.

class ResultFrame {
    data: String
    static fn text(data: String) ResultFrame { return ResultFrame { data: data } }
}
class ResultItem { n: uint (1) }
class ResultBox { item: ResultItem }
fn result_wrap(x: ResultItem) ResultBox { return ResultBox { item: x } }

class ResultHub {
    frames: Array[shared ResultFrame] (.{})
    boxes: Array[shared ResultBox] (.{})
    fn push(f: shared ResultFrame) { this.frames.append(f) }
    fn keep(b: shared ResultBox) { this.boxes.append(b) }
}

interface ResultSink {
    fn put(f: shared ResultFrame);
}
class ResultListSink is ResultSink {
    frames: Array[shared ResultFrame] (.{})
    fn put(f: shared ResultFrame) { this.frames.append(f) }
}

// The callee's summary is still being computed inside the cycle
fn result_rec_a(h: ResultHub, n: uint) {
    if n == 0 : return
    h.push(ResultFrame.text("r"))
    result_rec_b(h, n - 1)
}
fn result_rec_b(h: ResultHub, n: uint) { result_rec_a(h, n) }

fn result_make_shared() shared ResultFrame { return ResultFrame.text("ret") }
fn result_size(f: shared ResultFrame) uint { return f.data.length }
fn result_peek(b: shared ResultBox) uint { return b.item.n }

test "Shared call results: stored arguments" {
    let h = ResultHub {}
    h.push(ResultFrame.text("a"))
    let f: shared ResultFrame = ResultFrame.text("b")
    h.push(f)
    h.push(ResultFrame { data: "c" })
    result_rec_a(h, 2)
    assert(h.frames.length == 5)
    assert(h.frames[0].data == "a")

    // Conditionally fresh: the argument is unique and consumed
    let x = ResultItem { n: 7 }
    h.keep(result_wrap(x))
    h.keep(result_wrap(ResultItem {}))
    assert(h.boxes.length == 2)
    assert(h.boxes[0].item.n == 7)

    let sink = ResultListSink {}
    let s: ResultSink = sink
    s.put(ResultFrame.text("i"))
    assert(sink.frames.length == 1)
}

test "Shared call results: borrows, fields, returns, channels, threads" {
    // A borrow leaves the argument usable
    let x = ResultItem { n: 2 }
    assert(result_peek(result_wrap(x)) == 2)
    x.n = 3
    assert(x.n == 3)

    let hub = ResultHub { frames: .{ ResultFrame.text("f") } }
    assert(hub.frames.length == 1)
    assert(result_make_shared().data == "ret")
    assert(result_size(ResultFrame.text("abc")) == 3)

    let ch: shared sync.Channel[shared ResultFrame] = sync.Channel[shared ResultFrame].new(2) !!
    ch.send(ResultFrame.text("ch")) !!
    assert((ch.recv() !!).data == "ch")

    let t = thread.start(fn() { assert(result_size(ResultFrame.text("thr")) == 3) }) !!
    t.await()
    let c = co result_size(ResultFrame.text("co"))
    assert(await c == 2)
}

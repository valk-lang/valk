use valk.core
use valk.fs

test "System info: CPU counts, process id and host name" {
    let threads = core.cpu_thread_count()
    let cores = core.cpu_core_count()
    assert(threads >= 1)
    assert(cores >= 1 && cores <= threads)
    assert(core.process_id() > 0)
    let host = core.hostname() !!
    assert(host.bytes > 0)
    #if OS == "linux"
    // The first field of /proc/self/stat is the process id
    let stat = fs.read("/proc/self/stat") !!
    assert(stat.starts_with(core.process_id().to_string() + " "))
    assert(host == (fs.read("/proc/sys/kernel/hostname") !!).trim())
    #end
}

test "System info: env_vars lists the environment" {
    let name = "VALK_ENV_VARS_TEST_" + core.process_id()
    core.setenv(name, "a=b c") !!
    let vars = core.env_vars()
    // The value keeps everything after the first "="
    assert((vars.get(name) !? "") == "a=b c")
    each vars as value, key {
        assert(key.bytes > 0)
        assert((core.getenv(key) !? "<missing>") == value)
    }
    core.unsetenv(name) !!
    assert(!core.env_vars().has(name))
}

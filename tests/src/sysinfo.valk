use valk.core
use valk.fs
use valk.gc

test "System info: the memory limit is known" {
    assert(core.memory_limit() > 0)
}

class ReleaseMemoryItem {
    value: uint
    next: ?ReleaseMemoryItem (null)
}

synctest "GC: release_memory frees empty blocks and keeps live data and later allocations working" {
    let live: ?ReleaseMemoryItem = null
    each 0 .. 2000 as i : live = ReleaseMemoryItem { value: i, next: live }
    let large = "".pad_right('x', 32 * 1024 * 1024)
    assert(large.bytes > 0)
    large = ""
    let before = gc.gc.mem_usage_thread
    gc.release_memory()
    assert(gc.gc.mem_usage_thread < before)
    // Allocating after a block was left, also in the same sizes, and collecting again
    let again = "".pad_right('y', 32 * 1024 * 1024)
    each 0 .. 2000 as i : live = ReleaseMemoryItem { value: i, next: live }
    gc.collect()
    gc.release_memory()
    assert(again[0] == 'y' && again[again.bytes - 1] == 'y')
    let count: uint = 0
    while isset(live) {
        count++
        live = live.next
    }
    assert(count == 4000)
}

test "System info: CPU counts, process id and host name" {
    let threads = core.cpu_thread_count()
    let cores = core.cpu_core_count()
    assert(threads >= 1)
    assert(cores >= 1 && cores <= threads)
    assert(core.process_id() > 0)
    let host = core.hostname() !!
    assert(host.bytes > 0)
    #if OS == "linux"
    // The first field of /proc/self/stat is the process id
    let stat = fs.read("/proc/self/stat") !!
    assert(stat.starts_with(core.process_id().to_string() + " "))
    assert(host == (fs.read("/proc/sys/kernel/hostname") !!).trim())
    #end
}

test "System info: env_vars lists the environment" {
    let name = "VALK_ENV_VARS_TEST_" + core.process_id()
    core.setenv(name, "a=b c") !!
    let vars = core.env_vars()
    // The value keeps everything after the first "="
    assert((vars.get(name) !? "") == "a=b c")
    each vars as value, key {
        assert(key.bytes > 0)
        assert((core.getenv(key) !? "<missing>") == value)
    }
    core.unsetenv(name) !!
    assert(!core.env_vars().has(name))
}

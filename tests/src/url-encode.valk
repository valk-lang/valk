use valk.url

fn byte_string(b: uint) String {
    let v: u8 = b.to(u8)
    return String.make_from_ptr(&v, 1)
}

fn non_printable(s: String) bool {
    let i: uint = 0
    while i < s.length {
        let c = @ptrv(s.data, u8, i)
        if c < 32 || c > 126 : return true
        i++
    }
    return false
}

test "URL: encode/decode" {
    let dec = "Hello Günter. .  .€.‚.â"
    let enc = "Hello%20G\%C3\%BCnter.%20.%20%20.\%E2%82\%AC.\%E2%80%9A.\%C3\%A2"
    assert(url.decode(enc) == dec)
    assert(url.encode(dec) == enc)
    assert(url.decode("+++") == "   ")
}

test "URL: escapes below %10 are padded with the digit zero" {
    // The pad byte was written as 0 rather than '0', so a newline encoded to the
    // three bytes '%', NUL, 'A' — any URL that crossed a C string was truncated at
    // the first escape and any HTML page got a control character injected.
    assert(url.encode("\n") == "%0A")
    assert(url.encode("\t") == "%09")
    assert(url.encode("\r") == "%0D")
    assert(url.encode(byte_string(0)) == "%00")
    assert(url.encode(byte_string(1)) == "%01")
    assert(url.encode(byte_string(15)) == "%0F")
    assert(url.encode(byte_string(16)) == "%10")
    assert(url.encode(" ") == "%20")
    assert(!non_printable(url.encode("\n \t\r")))
}

test "URL: encode escapes what would change the URL" {
    // '%' introduces an escape sequence, so passing it through meant a server that
    // decodes once had effectively decoded twice: encode("%41") -> "%41" -> "A".
    assert(url.encode("%41") == "%2541")
    assert(url.decode(url.encode("%41")) == "%41")
    // decode() reads '+' as a space, so a literal '+' cannot survive a round trip.
    assert(url.encode("a+b") == "a%2Bb")
    assert(url.decode(url.encode("a+b")) == "a+b")
    // Parameter separators and component delimiters must never appear raw.
    assert(url.encode("a&b=c?d#e/f:g@h") == "a\%26b\%3Dc\%3Fd\%23e\%2Ff\%3Ag\%40h")
    assert(url.encode("a\"b<c>d`e{f|g^h\\i") == "a\%22b\%3Cc\%3Ed\%60e\%7Bf\%7Cg\%5Eh\%5Ci")
    // RFC 3986 unreserved is all that is left untouched.
    assert(url.encode("AZaz09-._~") == "AZaz09-._~")
    // Multi-byte input is escaped per byte, which any decoder reassembles.
    assert(url.encode("ü") == "\%C3\%BC")
    assert(url.decode(url.encode("ü")) == "ü")
}

test "URL: component safe sets" {
    let s = "/a b?c#d&e=f+g:h@i,j;k(l)"
    assert(url.encode(s) == "\%2Fa\%20b\%3Fc\%23d\%26e\%3Df\%2Bg\%3Ah\%40i\%2Cj\%3Bk\%28l\%29")
    assert(url.encode(s, url.COMPONENT.path) == "/a\%20b\%3Fc\%23d&e=f\%2Bg:h@i,j;k(l)")
    assert(url.encode(s, url.COMPONENT.query) == "/a\%20b\%3Fc\%23d\%26e\%3Df\%2Bg:h@i,j\%3Bk(l)")
    assert(url.encode(s, url.COMPONENT.fragment) == "/a\%20b?c\%23d&e=f\%2Bg:h@i,j;k(l)")
    // The default is what a caller that does not know its destination component needs.
    assert(url.encode(s, url.COMPONENT.unreserved) == url.encode(s))
    // Whichever set is used, the result still decodes back to the input.
    let back_path = url.decode(url.encode(s, url.COMPONENT.path))
    let back_query = url.decode(url.encode(s, url.COMPONENT.query))
    let back_fragment = url.decode(url.encode(s, url.COMPONENT.fragment))
    assert(back_path == s)
    assert(back_query == s)
    assert(back_fragment == s)
}

test "URL: decode contract" {
    // encode() escapes '%' and '+' precisely so that these two rules below are enough
    // to make decode(encode(x)) == x for every x.
    assert(url.decode("%2Fb") == "/b")
    assert(url.decode("%2fb") == "/b")
    assert(url.decode("%2B") == "+")
    assert(url.decode("+") == " ")
    // A '%' that does not introduce an escape is kept as a literal percent.
    assert(url.decode("100\% sure") == "100\% sure")
    assert(url.decode("\%zz") == "\%zz")
    assert(url.decode("\%2") == "\%2")
    assert(url.decode("\%00") == byte_string(0))
}

test "URL: every byte round-trips in every component" {
    let comps = Array[url.COMPONENT]{
        url.COMPONENT.unreserved,
        url.COMPONENT.path,
        url.COMPONENT.query,
        url.COMPONENT.fragment
    }
    each comps as comp {
        let bad: uint = 0
        let b: uint = 0
        while b < 256 {
            let src = byte_string(b)
            let enc = url.encode(src, comp)
            if non_printable(enc) {
                bad++
            } else if url.decode(enc) != src {
                bad++
            }
            b++
        }
        assert(bad == 0)
    }
}

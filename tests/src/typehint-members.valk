// A leading `.` names something of the type a value is expected to have: an enum member, a
// static function, or an error code.

enum Paint {
    red
    green
    blue
}

error PaintError (missing_color, bad_mix) payload {
    message: String
}

class PaintTool {
    size: uint (1)

    static fn of_size(size: uint (1)) PaintTool {
        return PaintTool { size: size }
    }
}

class PaintSettings {
    color: Paint
    // A property default is typehinted as well
    fallback: Paint (.blue)
    tool: PaintTool (.of_size(2))
}

fn name_of(color: Paint) String {
    return match color : String {
        Paint.red => "red"
        Paint.green => "green"
        Paint.blue => "blue"
    }
}

fn mix(first: Paint, second: Paint) Paint !PaintError {
    if first == second : throw .bad_mix { message: "the same colour twice" }
    return Paint.green
}

test "Typehints: an enum member is reachable through the expected type" {
    // Through the type of a variable
    let color: Paint = .red
    assert(name_of(color) == "red")

    // Through the type of an argument
    assert(name_of(.green) == "green")

    // Through a nullable type
    let maybe: ?Paint = .blue
    assert(isset(maybe))
    if isset(maybe) : assert(name_of(maybe) == "blue")

    // Through the fields of a class, including their defaults
    let settings = PaintSettings { color: .green }
    assert(name_of(settings.color) == "green")
    assert(name_of(settings.fallback) == "blue")
    assert(settings.tool.size == 2)

    // Assigning to a variable that already has the type
    color = .blue
    assert(name_of(color) == "blue")

    // In an array and a map of enums
    let colors = Array[Paint]{ .red, .green }
    assert(colors.length == 2)
    assert(name_of(colors.get(1) !? Paint.red) == "green")
    let by_name: Map[Paint] = .{ "first" => .red }
    assert(name_of(by_name.get("first") !? Paint.green) == "red")

    // A comparison typehints the right hand side
    assert(color == .blue)
}

test "Typehints: static functions and error codes still resolve" {
    let tool: PaintTool = .of_size(4)
    assert(tool.size == 4)

    mix(Paint.red, Paint.red) ! {
        assert(error_is(E.code, bad_mix))
        assert(E.message == "the same colour twice")
        return
    }
    assert(false)
}

test "Each and lock take a value that ends at their keyword" {
    // The value of an `each` is followed by `skip` or `as`, never by the body, so a literal
    // needs no parentheses around it
    let seen: Array[String] = .{}
    each Array[String]{ "a", "b" } as word {
        seen.append(word)
    }
    assert(seen.length == 2)
    assert((seen.get(1) !? "") == "b")

    let pairs: Array[String] = .{}
    each Map[uint]{ "x" => 1 } as value, key {
        pairs.append(key + "=" + value)
    }
    assert((pairs.get(0) !? "") == "x=1")

    // `skip` takes its own value
    let total: uint = 0
    each Array[uint]{ 1, 2, 3 } skip 1 as number {
        total += number
    }
    assert(total == 5)

    // A single statement body still works
    let counted: uint = 0
    each Array[uint]{ 1, 2 } as number : counted += number
    assert(counted == 3)
}

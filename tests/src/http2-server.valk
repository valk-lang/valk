@ignore_access
use valk.http
use valk.compress
use valk.fs
use valk.sync
use valk.net
use valk.time

class H2HandlerState {
    entered: uint (0)
    finished: uint (0)
}

synctest "HTTP2: shutdown deadline interrupts sockets but lets handlers unwind" {
    let state: atomic H2HandlerState = .{}
    let handler: atomic fn(http.Request)(http.Response) = fn(request: http.Request) http.Response {
        state.entered++
        time.sleep_ms(100)
        state.finished++
        return http.Response.text(request.body)
    }
    let server = http.Server.new("127.0.0.1", 9196, handler)
    server.http2 = true
    server.tls(__DIR__ + "/../assets/tls-cert.pem", __DIR__ + "/../assets/tls-key.pem") !!
    let running = co server.start(1)
    time.sleep_ms(20)
    let socket = net.tcp_client("127.0.0.1", 9196) !!
    let ssl = net.Ssl.new()
    ssl.set_verify(false)
    ssl.set_alpn(.{ "h2" }) !!
    socket.ssl_connect(ssl) !!
    socket.write("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n") !!
    socket.write(http.H2Frame { kind: 4 }.encode() !!) !!
    socket.write(h2_request_frame(1, false).encode() !!) !!
    socket.write(http.H2Frame { kind: 0, flags: 1, stream: 1, payload: "abc" }.encode() !!) !!
    let deadline = time.mono_ms() + 2000
    while state.entered == 0 && time.mono_ms() < deadline : time.sleep_ms(1)
    assert(state.entered == 1)
    assert(!server.shutdown(1))
    await running !!
    assert(state.finished == 1)
    let run = server.run
    if isset(run) : assert(run.active_body_size == 0 && run.connections == 0)
    socket.close() !!
}

// Reads the next frame; `step` says what the test waits for, for the failure message
fn h2_tls_frame(connection: net.TcpConnection, input: ByteBuffer, step: String) http.H2Frame {
    let buffer = [u8]{ 0 x 16_393 }
    let started = time.mono_ms()
    while true {
        let reader = input.reader()
        let frame = http.h2_read_frame(reader) ! {
            if !error_is(E.code, incomplete) : panic("Invalid HTTP/2 test frame while waiting for " + step)
            let count = connection.read(buffer) ! {
                let kind = "read error"
                if error_is(E.code, timeout) : kind = "timeout"
                else if error_is(E.code, closed) : kind = "closed"
                panic(h2_read_failure(connection, input, step, kind, started))
            }
            if count == 0 : panic(h2_read_failure(connection, input, step, "connection closed", started))
            input.write(buffer.view(0, count))
            continue
        }
        input.clear_until(reader.pos)
        return frame
    }
}

// Everything the test knows when reading from the HTTP/2 test connection fails
fn h2_read_failure(connection: net.TcpConnection, input: ByteBuffer, step: String, kind: String, started: uint) String {
    let ssl = connection.ssl
    let tls = isset(ssl) ? ssl.get_error_message() : "no TLS session"
    let reasons = http.h2_test_end_reasons.length > 0 ? http.h2_test_end_reasons.join(" | ") : "none yet"
    return "HTTP/2 test read failed while waiting for " + step + ": " + kind + " after " + (time.mono_ms() - started) + " ms; TLS: " + tls
        + "; " + input.length + " unparsed bytes; server connections ended: " + reasons
}

test "HTTP2: TLS negotiation multiplexed responses and shutdown" {
    let handler: atomic fn(http.Request)(http.Response) = fn(request: http.Request) http.Response {
        if request.path == "/slow" : time.sleep_ms(30)
        return http.Response.text(request.path + ":" + (request.query().get("x") !? ""))
    }
    let server = http.Server.new("127.0.0.1", 9194, handler)
    server.http2 = true
    server.tls(__DIR__ + "/../assets/tls-cert.pem", __DIR__ + "/../assets/tls-key.pem") !!
    let running = co server.start(1)
    time.sleep_ms(20)
    let fallback = http.request("GET", "https://127.0.0.1:9194/fallback", http.Options { verify_tls_cert: false }) !!
    assert(fallback.body == "/fallback:")
    let socket = net.tcp_client("127.0.0.1", 9194) !!
    let ssl = net.Ssl.new()
    ssl.set_verify(false)
    ssl.set_alpn(.{ "h2", "http/1.1" }) !!
    socket.ssl_connect(ssl) !!
    assert(ssl.selected_alpn() == "h2")
    socket.write("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n") !!
    socket.write(http.H2Frame { kind: 4 }.encode() !!) !!
    let input = ByteBuffer.new()
    let settings = h2_tls_frame(socket, input, "the server SETTINGS")
    assert(settings.kind == 4 && settings.flags == 0)
    socket.write(http.H2Frame { kind: 4, flags: 1 }.encode() !!) !!
    let id: u32 = 1
    while id <= 3 {
        let fields = Array[http.HpackField] {
            .{ name: ":method", value: "GET" },
            .{ name: ":scheme", value: "https" },
            .{ name: ":path", value: id == 1 ? "/slow?x=one" : "/fast?x=two" },
            .{ name: ":authority", value: "localhost" }
        }
        socket.write(http.H2Frame { kind: 1, flags: 5, stream: id, payload: http.hpack_encode(fields) !! }.encode() !!) !!
        id += 2
    }
    let complete: uint = 0
    let first_completed: u32 = 0
    let decoder = http.HpackDecoder {}
    while complete < 2 {
        let frame = h2_tls_frame(socket, input, "response " + (complete + 1) + " of 2")
        if frame.kind == 1 {
            let fields = decoder.decode(frame.payload) !!
            assert((fields.get(0) !!).name == ":status" && (fields.get(0) !!).value == "200")
        }
        if frame.kind != 0 : continue
        if first_completed == 0 : first_completed = frame.stream
        assert(frame.payload == (frame.stream == 1 ? "/slow:one" : "/fast:two"))
        if (frame.flags & 1) != 0 : complete++
    }
    assert(first_completed == 3)
    server.request_shutdown(1000)
    let goaway = h2_tls_frame(socket, input, "the GOAWAY after the shutdown request")
    assert(goaway.kind == 7)
    assert(ByteReader.new(goaway.payload).read_u32_be() == 3)
    // The server ends the TLS session with a close notify: a clean close, not an unexpected EOF
    let rest = [u8]{ 0 x 64 }
    let ending = "more data"
    socket.read(rest) ! {
        ending = error_is(E.code, closed) ? "closed" : "error"
    }
    assert(ending == "closed")
    socket.close() !!
    await running !!
}

fn h2_advertised_setting(frame: http.H2Frame, id: u16) uint {
    let reader = ByteReader.new(frame.payload)
    while reader.remaining().length >= 6 {
        let entry = reader.read_u16_be()
        let value = reader.read_u32_be()
        if entry == id : return value
    }
    return 0
}

fn h2_open(port: u16) net.TcpConnection {
    let socket = net.tcp_client("127.0.0.1", port) !!
    let ssl = net.Ssl.new()
    ssl.set_verify(false)
    ssl.set_alpn(.{ "h2" }) !!
    socket.ssl_connect(ssl) !!
    socket.write("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n") !!
    socket.write(http.H2Frame { kind: 4 }.encode() !!) !!
    return socket
}

// Reads frames until the response of `stream` ends, rejecting any reset or shutdown.
fn h2_response(socket: net.TcpConnection, input: ByteBuffer, stream: u32) (String, String) {
    let decoder = http.HpackDecoder {}
    let body = ""
    let status = ""
    while true {
        let frame = h2_tls_frame(socket, input, "the response on stream " + stream)
        if frame.kind == 3 || frame.kind == 7 : panic("HTTP/2 server refused the request")
        if frame.stream != stream : continue
        if frame.kind == 1 {
            let fields = decoder.decode(frame.payload) !!
            each fields as field {
                if field.name == ":status" : status = field.value
            }
        }
        if frame.kind == 0 {
            body += frame.payload
            if (frame.flags & 1) != 0 : break
        }
    }
    return (status, body)
}

test "HTTP2: request size limits of zero mean no limit" {
    let handler: atomic fn(http.Request)(http.Response) = fn(request: http.Request) http.Response {
        return http.Response.text(request.body)
    }
    let server = http.Server.new("127.0.0.1", 9192, handler)
    server.http2 = true
    server.max_request_header_size = 0
    server.max_request_body_size = 0
    server.tls(__DIR__ + "/../assets/tls-cert.pem", __DIR__ + "/../assets/tls-key.pem") !!
    let running = co server.start(1)
    time.sleep_ms(20)
    let socket = h2_open(9192)
    let input = ByteBuffer.new()
    let settings = h2_tls_frame(socket, input, "the server SETTINGS")
    assert(settings.kind == 4)
    // An unlimited header limit is advertised as the protocol's largest value
    assert(h2_advertised_setting(settings, 6) == 0xffffffff)
    socket.write(http.H2Frame { kind: 4, flags: 1 }.encode() !!) !!
    let fields = Array[http.HpackField] {
        .{ name: ":method", value: "POST" },
        .{ name: ":scheme", value: "https" },
        .{ name: ":path", value: "/" },
        .{ name: ":authority", value: "localhost" }
    }
    socket.write(http.H2Frame { kind: 1, flags: 4, stream: 1, payload: http.hpack_encode(fields) !! }.encode() !!) !!
    socket.write(http.H2Frame { kind: 0, flags: 1, stream: 1, payload: "payload" }.encode() !!) !!
    let status, body = h2_response(socket, input, 1)
    assert(status == "200")
    assert(body == "payload")
    socket.close() !!
    server.request_shutdown(1000)
    await running !!
}

test "HTTP2: a non-zero request size limit still rejects oversized requests" {
    let handler: atomic fn(http.Request)(http.Response) = fn(request: http.Request) http.Response {
        return http.Response.text(request.body)
    }
    let server = http.Server.new("127.0.0.1", 9191, handler)
    server.http2 = true
    server.max_request_body_size = 2
    server.tls(__DIR__ + "/../assets/tls-cert.pem", __DIR__ + "/../assets/tls-key.pem") !!
    let running = co server.start(1)
    time.sleep_ms(20)
    let socket = h2_open(9191)
    let input = ByteBuffer.new()
    h2_tls_frame(socket, input, "the server SETTINGS")
    socket.write(http.H2Frame { kind: 4, flags: 1 }.encode() !!) !!
    let fields = Array[http.HpackField] {
        .{ name: ":method", value: "POST" },
        .{ name: ":scheme", value: "https" },
        .{ name: ":path", value: "/" },
        .{ name: ":authority", value: "localhost" }
    }
    socket.write(http.H2Frame { kind: 1, flags: 4, stream: 1, payload: http.hpack_encode(fields) !! }.encode() !!) !!
    socket.write(http.H2Frame { kind: 0, flags: 1, stream: 1, payload: "abc" }.encode() !!) !!
    let reset = false
    while true {
        let frame = h2_tls_frame(socket, input, "the stream reset")
        if frame.kind == 3 && (ByteReader.new(frame.payload).read_u32_be() == 11) : reset = true
        if reset : break
    }
    assert(reset)
    socket.close() !!
    server.request_shutdown(1000)
    await running !!
}

// Like h2_response, also returning the response headers
fn h2_response_with_headers(socket: net.TcpConnection, input: ByteBuffer, stream: u32) (String, Map[String], String) {
    return h2_response_decoded(socket, input, stream, http.HpackDecoder {})
}

// Responses on one connection share the decoder's dynamic table. With `goaway` a
// shutdown's GOAWAY may come first.
fn h2_response_decoded(socket: net.TcpConnection, input: ByteBuffer, stream: u32, decoder: http.HpackDecoder, goaway: bool (false)) (String, Map[String], String) {
    let body = ""
    let status = ""
    let headers = Map[String]{}
    while true {
        let frame = h2_tls_frame(socket, input, "the response on stream " + stream)
        if goaway && frame.kind == 7 : continue
        if frame.kind == 3 || frame.kind == 7 : panic("HTTP/2 server refused the request")
        if frame.stream != stream : continue
        if frame.kind == 1 {
            let fields = decoder.decode(frame.payload) !!
            each fields as field {
                if field.name == ":status" : status = field.value
                else : headers.set(field.name, field.value)
            }
            if (frame.flags & 1) != 0 : break
        }
        if frame.kind == 0 {
            body += frame.payload
            if (frame.flags & 1) != 0 : break
        }
    }
    return (status, headers, body)
}

test "HTTP2: compress sends gzip" {
    let handler: atomic fn(http.Request)(http.Response) = fn(request: http.Request) http.Response {
        return http.Response.html("hello ".repeat(1000))
    }
    let server = http.Server.new("127.0.0.1", 9193, handler)
    server.http2 = true
    server.compress = true
    server.tls(__DIR__ + "/../assets/tls-cert.pem", __DIR__ + "/../assets/tls-key.pem") !!
    let running = co server.start(1)
    time.sleep_ms(20)
    let socket = h2_open(9193)
    let input = ByteBuffer.new()
    h2_tls_frame(socket, input, "the server SETTINGS")
    socket.write(http.H2Frame { kind: 4, flags: 1 }.encode() !!) !!
    let fields = Array[http.HpackField] {
        .{ name: ":method", value: "GET" },
        .{ name: ":scheme", value: "https" },
        .{ name: ":path", value: "/" },
        .{ name: ":authority", value: "localhost" },
        .{ name: "accept-encoding", value: "gzip, br" }
    }
    socket.write(http.H2Frame { kind: 1, flags: 5, stream: 1, payload: http.hpack_encode(fields) !! }.encode() !!) !!
    let status, headers, body = h2_response_with_headers(socket, input, 1)
    assert(status == "200")
    assert((headers.get("content-encoding") !? "") == "gzip")
    assert((headers.get("vary") !? "") == "Accept-Encoding")
    assert(compress.gunzip(body) !! == "hello ".repeat(1000))
    socket.close() !!
    server.request_shutdown(1000)
    await running !!
}

test "HTTP2: static files answer 304, ranges and gzip" {
    let root = fs.create_temp_dir("valk-h2-static-") !!
    let css = "body { color: red; }\n".repeat(200)
    fs.write(fs.add(root, "site.css"), css) !!
    let handler: atomic fn(http.Request)(http.Response) = fn(request: http.Request) http.Response {
        return http.Response.text("handler")
    }
    let server = http.Server.new("127.0.0.1", 9206, handler)
    server.http2 = true
    server.compress = true
    server.add_static_dir(root) !!
    server.tls(__DIR__ + "/../assets/tls-cert.pem", __DIR__ + "/../assets/tls-key.pem") !!
    let running = co server.start(1)
    time.sleep_ms(20)
    let socket = h2_open(9206)
    let input = ByteBuffer.new()
    h2_tls_frame(socket, input, "the server SETTINGS")
    socket.write(http.H2Frame { kind: 4, flags: 1 }.encode() !!) !!
    let decoder = http.HpackDecoder {}
    let request = fn(stream: u32, name: String, value: String) (String, Map[String], String) {
        let fields = Array[http.HpackField] {
            .{ name: ":method", value: "GET" },
            .{ name: ":scheme", value: "https" },
            .{ name: ":path", value: "/site.css" },
            .{ name: ":authority", value: "localhost" }
        }
        if name.bytes > 0 : fields.append(.{ name: name, value: value })
        socket.write(http.H2Frame { kind: 1, flags: 5, stream: stream, payload: http.hpack_encode(fields) !! }.encode() !!) !!
        return h2_response_decoded(socket, input, stream, decoder)
    }

    let status, headers, body = request(1, "", "")
    assert(status == "200" && body == css)
    assert((headers.get("accept-ranges") !? "") == "bytes" && (headers.get("vary") !? "") == "Accept-Encoding")
    let etag = headers.get("etag") !? ""
    let cached_status, cached_headers, cached_body = request(3, "if-none-match", etag)
    assert(cached_status == "304" && cached_body == "" && !cached_headers.has("content-length"))
    let part_status, part_headers, part_body = request(5, "range", "bytes=7-11")
    assert(part_status == "206" && part_body == "color")
    assert((part_headers.get("content-range") !? "") == "bytes 7-11/" + css.bytes)
    let past_status, past_headers, past_body = request(7, "range", "bytes=99999-")
    assert(past_status == "416" && past_body == "")
    assert((past_headers.get("content-range") !? "") == "bytes */" + css.bytes)
    let gz_status, gz_headers, gz_body = request(9, "accept-encoding", "gzip")
    assert(gz_status == "200" && (gz_headers.get("content-encoding") !? "") == "gzip")
    assert(compress.gunzip(gz_body) !! == css)

    socket.close() !!
    server.request_shutdown(1000)
    await running !!
    fs.delete_all(root) !!
}

test "HTTP2: streams of unknown length end with the reader" {
    let handler: atomic fn(http.Request)(http.Response) = fn(request: http.Request) http.Response {
        if request.path == "/events" {
            let channel: atomic sync.Channel[String] = sync.Channel[String].new() !!
            channel.send("one") !!
            channel.close()
            return http.Response.events(channel)
        }
        if request.path == "/open-events" {
            let channel: atomic sync.Channel[String] = sync.Channel[String].new() !!
            return http.Response.events(channel)
        }
        return http.Response.stream(PieceReader { pieces: .{ "alpha ", "beta ", "gamma" } }, content_type: "text/plain")
    }
    let server = http.Server.new("127.0.0.1", 9207, handler)
    server.http2 = true
    server.tls(__DIR__ + "/../assets/tls-cert.pem", __DIR__ + "/../assets/tls-key.pem") !!
    let running = co server.start(1)
    time.sleep_ms(20)
    let socket = h2_open(9207)
    let input = ByteBuffer.new()
    h2_tls_frame(socket, input, "the server SETTINGS")
    socket.write(http.H2Frame { kind: 4, flags: 1 }.encode() !!) !!
    let decoder = http.HpackDecoder {}
    let request = fn(stream: u32, path: String) (String, Map[String], String) {
        let fields = Array[http.HpackField] {
            .{ name: ":method", value: "GET" },
            .{ name: ":scheme", value: "https" },
            .{ name: ":path", value: path },
            .{ name: ":authority", value: "localhost" }
        }
        socket.write(http.H2Frame { kind: 1, flags: 5, stream: stream, payload: http.hpack_encode(fields) !! }.encode() !!) !!
        return h2_response_decoded(socket, input, stream, decoder)
    }
    let status, headers, body = request(1, "/")
    assert(status == "200" && body == "alpha beta gamma" && !headers.has("content-length"))
    let ev_status, ev_headers, ev_body = request(3, "/events")
    assert(ev_status == "200" && (ev_headers.get("content-type") !? "") == "text/event-stream")
    assert(ev_body == "data: one\n\n")
    // The shutdown ends an event stream that would go on forever
    let open = Array[http.HpackField] {
        .{ name: ":method", value: "GET" },
        .{ name: ":scheme", value: "https" },
        .{ name: ":path", value: "/open-events" },
        .{ name: ":authority", value: "localhost" }
    }
    socket.write(http.H2Frame { kind: 1, flags: 5, stream: 5, payload: http.hpack_encode(open) !! }.encode() !!) !!
    time.sleep_ms(50)
    let started = time.mono_ms()
    server.request_shutdown(5000)
    let open_status, open_headers, open_body = h2_response_decoded(socket, input, 5, decoder, true)
    assert(open_status == "200" && open_body == "" && (open_headers.get("cache-control") !? "") == "no-cache")
    socket.close() !!
    await running !!
    assert(time.mono_ms() - started < 1000)
}

// Writes the byte at `index` of `frame`; false once the server ended the connection. Reads
// what the server sent meanwhile, for up to the socket's read timeout
fn h2_trickle_byte(socket: net.TcpConnection, frame: String, index: uint) bool {
    socket.write(frame.range(index, 1)) ! return false
    let chunk = [u8]{ 0 x 256 }
    let received = socket.read(chunk) ! {
        return error_is(E.code, timeout)
    }
    return received > 0
}

synctest "HTTP2: a frame trickled in pieces has the header timeout over all of them" {
    let handler: atomic fn(http.Request)(http.Response) = fn(request: http.Request) http.Response {
        return http.Response.text("ok")
    }
    let server = http.Server.new("127.0.0.1", 9198, handler)
    server.http2 = true
    server.header_timeout_ms = 500
    server.tls(__DIR__ + "/../assets/tls-cert.pem", __DIR__ + "/../assets/tls-key.pem") !!
    let running = co server.start(1)
    defer stop_http_test_server(server, running)
    time.sleep_ms(20)
    let socket = h2_open(9198)
    socket.read_timeout_ms = 100
    let ping = http.H2Frame { kind: 6, payload: "12345678" }.encode() !!

    // Frames that complete in time keep the connection, however long that goes on
    each 0 .. 8 {
        assert(h2_trickle_byte(socket, ping.range(0, 9), 0))
        socket.write(ping.range(1, ping.bytes - 1)) !!
    }

    let alive = true
    let i: uint = 0
    while alive && i < ping.bytes {
        alive = h2_trickle_byte(socket, ping, i)
        i++
    }
    assert(!alive)
    socket.close() _
}

fn h2_settings_payload(values: Array[uint]) String {
    let out = ByteBuffer.new()
    each values as value {
        out.write_big_endian(4, 2)
        out.write_big_endian(value, 4)
    }
    return out.to_string()
}

// Reads frames until a GOAWAY and returns its error code, or until a SETTINGS ack (-1)
fn h2_settings_answer(socket: net.TcpConnection, input: ByteBuffer) int {
    while true {
        let frame = h2_tls_frame(socket, input, "the SETTINGS answer")
        if frame.kind == 7 {
            let reader = ByteReader.new(frame.payload)
            reader.read_u32_be()
            return reader.read_u32_be().to(int)
        }
        if frame.kind == 4 && (frame.flags & 1) != 0 : return -1
    }
    return -2
}

test "HTTP2: SETTINGS change open streams' windows once, and an intermediate overflow is an error" {
    let handler: atomic fn(http.Request)(http.Response) = fn(request: http.Request) http.Response {
        return http.Response.text(request.body)
    }
    let server = http.Server.new("127.0.0.1", 19188, handler)
    server.http2 = true
    server.tls(__DIR__ + "/../assets/tls-cert.pem", __DIR__ + "/../assets/tls-key.pem") !!
    let running = co server.start(1)
    time.sleep_ms(20)
    let fields = Array[http.HpackField] {
        .{ name: ":method", value: "POST" },
        .{ name: ":scheme", value: "https" },
        .{ name: ":path", value: "/" },
        .{ name: ":authority", value: "localhost" }
    }

    // The window of open stream 1 grows by 1000, so 2^31 - 1 on the way overflows it
    let socket = h2_open(19188)
    let input = ByteBuffer.new()
    h2_tls_frame(socket, input, "the server SETTINGS")
    // The ack of the client's first SETTINGS
    assert(h2_settings_answer(socket, input) == -1)
    socket.write(http.H2Frame { kind: 4, flags: 1 }.encode() !!) !!
    socket.write(http.H2Frame { kind: 1, flags: 4, stream: 1, payload: http.hpack_encode(fields) !! }.encode() !!) !!
    let grow = ByteBuffer.new()
    grow.write_big_endian(1000, 4)
    socket.write(http.H2Frame { kind: 8, stream: 1, payload: grow.to_string() }.encode() !!) !!
    socket.write(http.H2Frame { kind: 4, payload: h2_settings_payload(.{ 0x7fffffff, 65535 }) }.encode() !!) !!
    assert(h2_settings_answer(socket, input) == 3)
    socket.close() _

    // Many entries in one frame are acknowledged, and the stream still answers
    let again = h2_open(19188)
    let input2 = ByteBuffer.new()
    h2_tls_frame(again, input2, "the server SETTINGS")
    assert(h2_settings_answer(again, input2) == -1)
    again.write(http.H2Frame { kind: 4, flags: 1 }.encode() !!) !!
    again.write(http.H2Frame { kind: 1, flags: 4, stream: 1, payload: http.hpack_encode(fields) !! }.encode() !!) !!
    let values = Array[uint].new()
    each 0 .. 2000 as i : values.append(i % 2 == 0 ? 0 : 65535)
    again.write(http.H2Frame { kind: 4, payload: h2_settings_payload(values) }.encode() !!) !!
    assert(h2_settings_answer(again, input2) == -1)
    again.write(http.H2Frame { kind: 0, flags: 1, stream: 1, payload: "abc" }.encode() !!) !!
    let status, body = h2_response(again, input2, 1)
    assert(status == "200" && body == "abc")
    again.close() _
    server.request_shutdown(1000)
    await running !!
}

test "HTTP2: cleartext h2c prior-knowledge, lazy headers, query_param and peer_address" {
    let handler: atomic fn(http.Request)(http.Response) = fn(req: http.Request) http.Response {
        let host = req.header("Host") !? ""
        let custom = req.header("X-Custom") !? ""
        let q = req.query_param("m") !? ""
        let c1 = req.cookie("a") !? ""
        let c2 = req.cookie("b") !? ""
        let has_peer = req.peer_address.port > 0 ? "1" : "0"
        return http.Response.text(host + "|" + custom + "|" + q + "|" + c1 + "," + c2 + "|" + has_peer)
    }
    let server = http.Server.new("127.0.0.1", 19189, handler)
    server.http2 = true
    let running = co server.start(1)
    time.sleep_ms(20)

    let socket = net.tcp_client("127.0.0.1", 19189) !!
    socket.read_timeout_ms = 5000
    socket.write("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n") !!
    socket.write(http.H2Frame { kind: 4 }.encode() !!) !!
    let input = ByteBuffer.new()
    h2_tls_frame(socket, input, "h2c server SETTINGS")
    assert(h2_settings_answer(socket, input) == -1)
    socket.write(http.H2Frame { kind: 4, flags: 1 }.encode() !!) !!

    let fields = Array[http.HpackField] {
        .{ name: ":method", value: "GET" },
        .{ name: ":scheme", value: "http" },
        .{ name: ":path", value: "/test?m=1&m=42" },
        .{ name: ":authority", value: "localhost:19189" },
        .{ name: "x-custom", value: "val" },
        .{ name: "cookie", value: "a=one" },
        .{ name: "cookie", value: "b=two" }
    }
    socket.write(http.H2Frame { kind: 1, flags: 5, stream: 1, payload: http.hpack_encode(fields) !! }.encode() !!) !!
    let status, body = h2_response(socket, input, 1)
    assert(status == "200")
    assert(body == "localhost:19189|val|42|one,two|1")

    socket.close() _
    server.request_shutdown(1000)
    await running !!
}

test "HTTP2: 16-stream multiplexed h2c batch answers fast streams ahead of slow stream" {
    let handler: atomic fn(http.Request)(http.Response) = fn(req: http.Request) http.Response {
        if req.path == "/slow" : time.sleep_ms(60)
        return http.Response.text("ok:" + req.path)
    }
    let server = http.Server.new("127.0.0.1", 19190, handler)
    server.http2 = true
    let running = co server.start(1)
    time.sleep_ms(20)

    let socket = net.tcp_client("127.0.0.1", 19190) !!
    socket.read_timeout_ms = 5000
    socket.write("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n") !!
    socket.write(http.H2Frame { kind: 4 }.encode() !!) !!
    let input = ByteBuffer.new()
    h2_tls_frame(socket, input, "h2c batch SETTINGS")
    assert(h2_settings_answer(socket, input) == -1)
    socket.write(http.H2Frame { kind: 4, flags: 1 }.encode() !!) !!

    let batch = ByteBuffer.new(2048)
    each 0 .. 16 as idx {
        let sid: u32 = (idx * 2 + 1).to(u32)
        let path = idx == 0 ? "/slow" : ("/fast-" + idx)
        let fields = Array[http.HpackField] {
            .{ name: ":method", value: "GET" },
            .{ name: ":scheme", value: "http" },
            .{ name: ":path", value: path },
            .{ name: ":authority", value: "localhost:19190" }
        }
        batch.write(http.H2Frame { kind: 1, flags: 5, stream: sid, payload: http.hpack_encode(fields) !! }.encode() !!)
    }
    socket.write(batch) !!

    let done = HashMap[u32, String].new()
    let first_done_stream: u32 = 0
    while done.length < 16 {
        let frame = h2_tls_frame(socket, input, "batch response frame")
        if frame.kind == http.H2_DATA && (frame.flags & 1) != 0 {
            done.set(frame.stream, frame.payload)
            if first_done_stream == 0 : first_done_stream = frame.stream
        }
    }
    // Fast streams (3..31) finish before stream 1 (/slow)
    assert(first_done_stream != 1)
    assert((done.get(1) !? "") == "ok:/slow")
    assert((done.get(31) !? "") == "ok:/fast-15")

    socket.close() _
    server.request_shutdown(1000)
    await running !!
}

test "HTTP2: 100-stream concurrent batch and buffered fast-before-slow flush" {
    let handler: atomic fn(http.Request)(http.Response) = fn(req: http.Request) http.Response {
        if req.path == "/slow" : time.sleep_ms(120)
        return http.Response.text("ok:" + req.path)
    }
    let server = http.Server.new("127.0.0.1", 19191, handler)
    server.http2 = true
    let running = co server.start(1)
    time.sleep_ms(20)

    let socket = net.tcp_client("127.0.0.1", 19191) !!
    socket.read_timeout_ms = 5000
    socket.write("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n") !!
    socket.write(http.H2Frame { kind: 4 }.encode() !!) !!
    let input = ByteBuffer.new()
    h2_tls_frame(socket, input, "h2c 100 SETTINGS")
    assert(h2_settings_answer(socket, input) == -1)
    socket.write(http.H2Frame { kind: 4, flags: 1 }.encode() !!) !!

    // Case 1: fast stream 1 followed by last-in-batch slow stream 3; stream 1's buffered
    // response must flush immediately when stream 3 yields instead of waiting 120ms.
    let pair = ByteBuffer.new(512)
    let enc = http.HpackEncoder {}
    let f1 = Array[http.HpackField] {
        .{ name: ":method", value: "GET" },
        .{ name: ":scheme", value: "http" },
        .{ name: ":path", value: "/fast-first" },
        .{ name: ":authority", value: "localhost:19191" },
        .{ name: "user-agent", value: "valk-test/1.0" }
    }
    let f3 = Array[http.HpackField] {
        .{ name: ":method", value: "GET" },
        .{ name: ":scheme", value: "http" },
        .{ name: ":path", value: "/slow" },
        .{ name: ":authority", value: "localhost:19191" },
        .{ name: "user-agent", value: "valk-test/1.0" }
    }
    pair.write(http.H2Frame { kind: 1, flags: 5, stream: 1, payload: enc.encode(f1, 4096) !! }.encode() !!)
    pair.write(http.H2Frame { kind: 1, flags: 5, stream: 3, payload: enc.encode(f3, 4096) !! }.encode() !!)
    let started = time.mono_ms()
    socket.write(pair) !!
    let got1 = false
    while !got1 {
        let frame = h2_tls_frame(socket, input, "stream 1 early flush")
        if frame.kind == http.H2_DATA && frame.stream == 1 && (frame.flags & 1) != 0 {
            assert(frame.payload == "ok:/fast-first")
            got1 = true
        }
    }
    assert(time.mono_ms() - started < 90)
    let got3 = false
    while !got3 {
        let frame = h2_tls_frame(socket, input, "stream 3 slow finish")
        if frame.kind == http.H2_DATA && frame.stream == 3 && (frame.flags & 1) != 0 {
            assert(frame.payload == "ok:/slow")
            got3 = true
        }
    }

    // Case 2: 100 concurrent fast streams in one batch (-m 100)
    let batch = ByteBuffer.new(4096)
    each 0 .. 100 as idx {
        let sid: u32 = (idx * 2 + 5).to(u32)
        let fields = Array[http.HpackField] {
            .{ name: ":method", value: "GET" },
            .{ name: ":scheme", value: "http" },
            .{ name: ":path", value: "/b" },
            .{ name: ":authority", value: "localhost:19191" },
            .{ name: "user-agent", value: "valk-test/1.0" }
        }
        batch.write(http.H2Frame { kind: 1, flags: 5, stream: sid, payload: enc.encode(fields, 4096) !! }.encode() !!)
    }
    socket.write(batch) !!
    let count: uint = 0
    while count < 100 {
        let frame = h2_tls_frame(socket, input, "100-stream batch frame")
        if frame.kind == http.H2_DATA && (frame.flags & 1) != 0 {
            assert(frame.payload == "ok:/b")
            count++
        }
    }

    socket.close() _
    server.request_shutdown(1000)
    await running !!
}

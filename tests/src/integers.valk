
test "Endian read/write" {
    let x : u32 = 123
    let y : u32 = 29892034
    let z = u32.read_big_endian(@ref(x))
    u32.write_big_endian(z, @ref(y))
    assert(x == 123)
    assert(y == 123)

    x = 250
    y = 0
    z = u32.read_little_endian(@ref(x))
    u32.write_little_endian(z, @ref(y))
    assert(x == 250)
    assert(y == 250)
}

test "Hex / Octal" {
    assert(239 == 0xEF)
    assert(493 == 0c755)
}

test "Signed minimum formatting" {
    let min_i8: i8 = -127
    let min_i16: i16 = -32767
    let min_i32: i32 = -2147483647
    let min_i64: i64 = -9223372036854775807
    min_i8--
    min_i16--
    min_i32--
    min_i64--

    assert(min_i8.to_str() == "-128")
    assert(min_i16.to_str() == "-32768")
    assert(min_i32.to_str() == "-2147483648")
    assert(min_i64.to_str() == "-9223372036854775808")
    assert((-5).to_str() == "-5")
}

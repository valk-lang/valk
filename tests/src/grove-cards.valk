@unsafe

use valk.gc

// Reads card bytes, the card log and the log's caps
@ignore_access

global grove_card_freed: uint

class GroveLeaf {
    value: uint
    fn gc_free() { grove_card_freed++ }
}

union GroveCardUnion : GroveLeaf | uint {}

// A 120-byte body in 120-byte slots: in one object of 16 the union's tag and its payload
// lie in different cards
class GroveCardHolder {
    a0: uint (0)
    a1: uint (0)
    a2: uint (0)
    a3: uint (0)
    a4: uint (0)
    a5: uint (0)
    a6: uint (0)
    a7: uint (0)
    a8: uint (0)
    a9: uint (0)
    a10: uint (0)
    a11: uint (0)
    a12: uint (0)
    u: GroveCardUnion
}

class GroveCardBox {
    leaf: ?GroveLeaf (null)
    other: ?GroveLeaf (null)
}

// Garbage of earlier tests is freed first
fn grove_card_reset() {
    gc.collect()
    gc.collect()
    grove_card_freed = 0
}

fn grove_leaf(value: uint) GroveLeaf $noinline {
    return GroveLeaf { value: value }
}

fn grove_card_dirty(address: uint) bool {
    return @ptrv(gc.card_of(address), u8) != 0
}

// Whether the card log holds `entry` (a card's first address, or storage | 1)
fn grove_logged(entry: uint) bool {
    let log = gc.gc.card_log
    let i: uint = 0
    while i < log.index / size_of(ptr) {
        if @ptrv(log.data, uint, i) == entry : return true
        i++
    }
    return false
}

fn grove_card_start(address: uint) uint {
    return address & (~(gc.CARD_SIZE - 1)).to(uint)
}

synctest "Grove: a store into an old object logs its card once; a collection cleans it" {
    let box = GroveCardBox {}
    gc.collect()
    let leaf = grove_leaf(1)
    let before = gc.gc.collect_count
    box.leaf = leaf
    let at = @ref(box.leaf).@cast(uint)
    let other = @ref(box.other).@cast(uint)
    let entries = gc.gc.card_log.index
    box.other = leaf
    // A collection may start at the store's end when the log's cap is small (GC_STRESS)
    if gc.gc.collect_count == before {
        assert(grove_card_dirty(at))
        assert(grove_logged(grove_card_start(at)))
        if grove_card_start(other) == grove_card_start(at) : assert(gc.gc.card_log.index == entries)
    }
    gc.collect()
    assert(!grove_card_dirty(at))
    assert(gc.gc.card_log.index == 0)
    let kept = box.leaf ?! panic("leaf missing")
    assert(kept.value == 1)
}

fn grove_union_holders(count: uint) Array[GroveCardHolder] $noinline {
    let list = Array[GroveCardHolder].new(count)
    let none: uint = 0
    let i: uint = 0
    while i < count {
        list.append(GroveCardHolder { u: none })
        i++
    }
    return list
}

// Holders whose union tag and payload lie in different cards
fn grove_union_straddles(list: Array[GroveCardHolder]) uint $noinline {
    let n: uint = 0
    each list as h {
        let tag = @ref(h.u).@cast(uint)
        if grove_card_start(tag) != grove_card_start(tag + size_of(GroveCardUnion) - 1) : n++
    }
    return n
}

fn grove_union_fill(list: Array[GroveCardHolder]) $noinline {
    each list as h, i : h.u = grove_leaf(i)
}

fn grove_union_check(list: Array[GroveCardHolder]) uint $noinline {
    let n: uint = 0
    each list as h, i {
        match h.u {
            GroveLeaf as leaf => if leaf.value == i : n++
            default => {}
        }
    }
    return n
}

fn grove_union_clear(list: Array[GroveCardHolder]) $noinline {
    let none: uint = 0
    each list as h : h.u = none
}

synctest "Grove: union stores into old objects whose payload straddles a card boundary" {
    grove_card_reset()
    let list = grove_union_holders(128)
    gc.collect()
    let first = list.get(0) !!
    assert(gc.desc_of(first.@cast(ptr)).isize == 120)
    assert(grove_union_straddles(list) >= 4)
    grove_union_fill(list)
    gc.collect()
    gc.collect()
    assert(grove_union_check(list) == 128)
    assert(grove_card_freed == 0)
    grove_union_clear(list)
    gc.collect()
    gc.collect()
    assert(grove_card_freed == 128)
}

fn grove_nulls(count: uint) Array[?GroveLeaf] $noinline {
    let list = Array[?GroveLeaf].new(count)
    let i: uint = 0
    while i < count {
        list.append(null)
        i++
    }
    return list
}

// Every 37th slot of the array gets a fresh leaf
fn grove_spread(list: Array[?GroveLeaf]) uint $noinline {
    let n: uint = 0
    let i: uint = 0
    while i < list.length {
        list.set(i, grove_leaf(i)) !!
        n++
        i += 37
    }
    return n
}

fn grove_spread_check(list: Array[?GroveLeaf]) uint $noinline {
    let n: uint = 0
    let i: uint = 0
    while i < list.length {
        let leaf = list.get(i) !!
        if isset(leaf) && leaf.value == i : n++
        i += 37
    }
    return n
}

fn grove_spread_clear(list: Array[?GroveLeaf]) $noinline {
    let i: uint = 0
    while i < list.length {
        list.set(i, null) !!
        i += 37
    }
}

synctest "Grove: slot stores into a large old array" {
    grove_card_reset()
    let list = grove_nulls(4096)
    gc.collect()
    assert((gc.desc_of(list.data.@cast(ptr)).kind & gc.desc_large) != 0)
    let count = grove_spread(list)
    gc.collect()
    gc.collect()
    assert(grove_spread_check(list) == count)
    assert(grove_card_freed == 0)
    grove_spread_clear(list)
    gc.collect()
    gc.collect()
    assert(grove_card_freed == count)
}

fn grove_leaves(count: uint, base: uint) Array[GroveLeaf] $noinline {
    let list = Array[GroveLeaf].new(count)
    let i: uint = 0
    while i < count {
        list.append(grove_leaf(base + i))
        i++
    }
    return list
}

// The first elements of `list` become those of `fresh`: their words are not counted until
// the next collection, and their cards are dirty
fn grove_replace_front(list: Array[GroveLeaf], fresh: Array[GroveLeaf]) $noinline {
    each fresh as leaf, i : list.set(i, leaf) !!
}

fn grove_sort_check(list: Array[GroveLeaf], front: uint) uint $noinline {
    let wrong: uint = 0
    let rest = list.length - front
    each list as leaf, i {
        let expect = i < rest ? i + front : 100000 + i - rest
        if leaf.value != expect : wrong++
    }
    return wrong
}

fn grove_slot(list: Array[GroveLeaf], index: uint) uint {
    return list.items().@cast(uint) + index * size_of(ptr)
}

synctest "Grove: swap_remove logs a clean card of the moved word, a dirty card logs nothing" {
    grove_card_reset()
    let list = grove_leaves(64, 0)
    gc.collect()
    gc.collect()
    let before = gc.gc.collect_count
    // A word not counted yet moves from the last card into the first, clean one
    list.set(63, grove_leaf(1000)) !!
    assert(!grove_card_dirty(grove_slot(list, 0)))
    list.swap_remove(0)
    let first = grove_card_start(grove_slot(list, 0))
    // The first card is dirty now: the next move into it logs nothing
    list.set(62, grove_leaf(1001)) !!
    let entries = gc.gc.card_log.index
    list.swap_remove(1)
    if gc.gc.collect_count == before {
        assert(grove_card_dirty(first))
        assert(grove_logged(first))
        assert(gc.gc.card_log.index == entries)
    }
    gc.collect()
    gc.collect()
    assert(list.length == 62)
    let a = list.get(0) !!
    let b = list.get(1) !!
    assert(a.value == 1000)
    assert(b.value == 1001)
    // The two removed leaves and the two replaced last ones
    assert(grove_card_freed == 4)
}

synctest "Grove: sorting a large old array logs its storage as a range" {
    grove_card_reset()
    // Small enough that the sort's own allocations start no collection
    let list = grove_leaves(3000, 0)
    let fresh = grove_leaves(1200, 100000)
    gc.collect()
    let before = gc.gc.collect_count
    grove_replace_front(list, fresh)
    // The fresh words move from the front to 75 clean cards at the end
    list.sort_by(fn(leaf: GroveLeaf) uint { return leaf.value })
    if gc.gc.collect_count == before {
        assert(grove_logged(list.data.@cast(uint) | 1))
    }
    fresh.clear()
    gc.collect()
    gc.collect()
    assert(grove_sort_check(list, 1200) == 0)
    assert(grove_card_freed == 1200)
}

// A deque whose items wrap past the end of its storage
fn grove_wrapped_deque() Deque[GroveLeaf] $noinline {
    let d = Deque[GroveLeaf].new(8)
    let i: uint = 0
    while i < 8 : d.push_back(grove_leaf(i++))
    while i < 13 {
        d.pop_front() !!
        d.push_back(grove_leaf(i++))
    }
    return d
}

fn grove_deque_storage(d: Deque[GroveLeaf]) uint $noinline {
    return d.items.data.@cast(uint)
}

fn grove_deque_check(d: Deque[GroveLeaf], first: uint) uint $noinline {
    let wrong: uint = 0
    let i: uint = 0
    while i < d.length {
        let leaf = d.get(i) !!
        if leaf.value != first + i : wrong++
        i++
    }
    return wrong
}

synctest "Grove: an old deque grows" {
    grove_card_reset()
    let d = grove_wrapped_deque()
    gc.collect()
    let storage = grove_deque_storage(d)
    let leaf = grove_leaf(13)
    let before = gc.gc.collect_count
    d.push_back(leaf)
    // The new storage takes over the references and is covered by one range entry
    let grown = grove_deque_storage(d)
    assert(grown != storage)
    if gc.gc.collect_count == before {
        assert(gc.gcdata(grown.@cast(ptr)).is_not_new())
        assert(grove_logged(grown | 1))
    }
    gc.collect()
    gc.collect()
    assert(d.length == 9)
    assert(grove_deque_check(d, 5) == 0)
    assert(grove_card_freed == 5)
}

fn grove_boxes(count: uint) Array[GroveCardBox] $noinline {
    let list = Array[GroveCardBox].new(count)
    let i: uint = 0
    while i < count {
        // Both words are counted after a collection: each relink records a removal
        let leaf = grove_leaf(i)
        list.append(GroveCardBox { leaf: leaf, other: leaf })
        i++
    }
    return list
}

// Each box takes its neighbour's leaf until a collection becomes pending; returns the stores
// made and whether the store that made it pending reached the soft cap
fn grove_relink_until_pending(list: Array[GroveCardBox]) (uint, bool) $noinline {
    let stores: uint = 0
    while stores < list.length * 4 {
        let box = list.get(stores % list.length) !!
        let next = list.get((stores + 1) % list.length) !!
        let entries = gc.log_entries
        let cap = gc.gc.e_soft
        box.other = next.leaf
        stores++
        // At most one removal record and one card entry per store
        if gc.pending : return (stores, entries < cap && entries + 2 >= cap)
    }
    return (stores, false)
}

// Allocates only on a branch the test never takes: a loop that calls it polls
fn grove_next(i: uint) uint $noinline {
    if i > 1000000 : return grove_boxes(1).length + i
    return i + 1
}

fn grove_clear_all(list: Array[GroveCardBox]) $noinline {
    list.clear()
}

synctest "Grove: stores and removals at the log's caps make a collection pending or collect" {
    grove_card_reset()
    let list = grove_boxes(40000)
    gc.collect()
    gc.collect()
    // Soft cap: the store that reaches it makes a collection pending, the next poll at or
    // above its stack depth collects
    let before = gc.gc.collect_count
    let stores, at_cap = grove_relink_until_pending(list)
    assert(at_cap)
    assert(stores > 0)
    assert(gc.gc.collect_count == before)
    // A loop with a call that reaches GC work polls at its back-edge
    let i: uint = 0
    while i < 1 : i = grove_next(i)
    assert(gc.gc.collect_count == before + 1)
    assert(!gc.pending)
    // A clear records a removal per element; past the hard cap it collects at once
    gc.collect()
    before = gc.gc.collect_count
    assert(list.length > gc.gc.e_hard)
    grove_clear_all(list)
    assert(gc.gc.collect_count > before)
    assert(gc.log_entries < gc.gc.e_hard)
    gc.collect()
    gc.collect()
    assert(grove_card_freed == 40000)
}

use valk.crypto
use valk.http
use valk.net
use valk.time
use valk.json
use valk.url
use valk.html
use valk.regex
use valk.core

test "crypto: base64url, sha3, Hmac, Blake2b, KDF, argon2id _in and _into variants" {
    // base64url
    let raw = "hello+world/test==\x00\xff"
    let expected_b64u = crypto.base64url_encode(raw)
    assert(crypto.base64url_encoded_size(raw.bytes) == expected_b64u.bytes)
    let b64_buf: [u8 x 64] = @undefined
    let b64_len = crypto.base64url_encode_in(raw, &b64_buf)
    let b64_view: local &[u8] = &b64_buf
    assert(b64_len == expected_b64u.bytes && b64_view.view(0, b64_len).to_string() == expected_b64u)
    let b64_out = ByteBuffer.new()
    assert((crypto.base64url_encode_into(raw, b64_out) !!) == expected_b64u.bytes)
    assert(b64_out.to_string() == expected_b64u)
    let dec_out = ByteBuffer.new()
    assert((crypto.base64url_decode_into(expected_b64u, dec_out) !!) == raw.bytes)
    assert(dec_out.to_string() == raw)

    // sha3_256 / sha3_512
    let d32: [u8 x 32] = @undefined
    let h64: [u8 x 64] = @undefined
    assert(crypto.sha3_256_in("abc", &d32) == 32)
    let d32_view: local &[u8] = &d32
    assert(d32_view.to_string() == crypto.sha3_256("abc"))
    assert(crypto.sha3_256_hex_in("abc", &h64) == 64)
    let h64_view: local &[u8] = &h64
    assert(h64_view.to_string() == crypto.sha3_256_hex("abc"))
    let s3_out = ByteBuffer.new()
    assert((crypto.sha3_256_into("abc", s3_out) !!) == 32 && s3_out.to_string() == crypto.sha3_256("abc"))
    s3_out.clear()
    assert((crypto.sha3_256_hex_into("abc", s3_out) !!) == 64 && s3_out.to_string() == crypto.sha3_256_hex("abc"))

    let d64: [u8 x 64] = @undefined
    let h128: [u8 x 128] = @undefined
    assert(crypto.sha3_512_in("abc", &d64) == 64)
    let d64_view: local &[u8] = &d64
    assert(d64_view.to_string() == crypto.sha3_512("abc"))
    assert(crypto.sha3_512_hex_in("abc", &h128) == 128)
    let h128_view: local &[u8] = &h128
    assert(h128_view.to_string() == crypto.sha3_512_hex("abc"))
    s3_out.clear()
    assert((crypto.sha3_512_into("abc", s3_out) !!) == 64 && s3_out.to_string() == crypto.sha3_512("abc"))
    s3_out.clear()
    assert((crypto.sha3_512_hex_into("abc", s3_out) !!) == 128 && s3_out.to_string() == crypto.sha3_512_hex("abc"))

    // Hmac
    assert(crypto.Hmac.sign_in("msg", crypto.HashAlgorithm.sha256, "key", &d32) == 32)
    assert(d32_view.to_string() == crypto.Hmac.sign("msg", crypto.HashAlgorithm.sha256, "key"))
    assert(crypto.Hmac.sign_hex_in("msg", crypto.HashAlgorithm.sha256, "key", &h64) == 64)
    assert(h64_view.to_string() == crypto.Hmac.sign_hex("msg", crypto.HashAlgorithm.sha256, "key"))
    let hm_out = ByteBuffer.new()
    assert((crypto.Hmac.sign_into("msg", crypto.HashAlgorithm.sha256, "key", hm_out) !!) == 32)
    assert(hm_out.to_string() == crypto.Hmac.sign("msg", crypto.HashAlgorithm.sha256, "key"))
    hm_out.clear()
    assert((crypto.Hmac.sign_hex_into("msg", crypto.HashAlgorithm.sha256, "key", hm_out) !!) == 64)
    assert(hm_out.to_string() == crypto.Hmac.sign_hex("msg", crypto.HashAlgorithm.sha256, "key"))

    // Blake2b
    assert((crypto.Blake2b.hash_hex_in("abc", &h128, "test") !!) == 128)
    assert(h128_view.to_string() == (crypto.Blake2b.hash_hex("abc", "test") !!))
    let b2_out = ByteBuffer.new()
    assert((crypto.Blake2b.hash_hex_into("abc", b2_out, "test") !!) == 128)
    assert(b2_out.to_string() == (crypto.Blake2b.hash_hex("abc", "test") !!))

    // PBKDF2 & HKDF
    let kdf_buf: [u8 x 48] = @undefined
    let kdf_view: local &[u8] = &kdf_buf
    let pb_expected = crypto.pbkdf2("pw", crypto.HashAlgorithm.sha256, "salt", 10, 48) !!
    assert((crypto.pbkdf2_in("pw", crypto.HashAlgorithm.sha256, "salt", 10, &kdf_buf, 48) !!) == 48)
    assert(kdf_view.to_string() == pb_expected)
    let kdf_out = ByteBuffer.new()
    assert((crypto.pbkdf2_into("pw", crypto.HashAlgorithm.sha256, "salt", 10, kdf_out, 48) !!) == 48)
    assert(kdf_out.to_string() == pb_expected)

    let prk_expected = crypto.hkdf_extract("ikm", crypto.HashAlgorithm.sha256, "salt")
    assert(crypto.hkdf_extract_in("ikm", crypto.HashAlgorithm.sha256, "salt", &d32) == 32)
    assert(d32_view.to_string() == prk_expected)
    kdf_out.clear()
    assert((crypto.hkdf_extract_into("ikm", crypto.HashAlgorithm.sha256, "salt", kdf_out) !!) == 32)
    assert(kdf_out.to_string() == prk_expected)

    let exp_expected = crypto.hkdf_expand(prk_expected, crypto.HashAlgorithm.sha256, "info", 48) !!
    assert((crypto.hkdf_expand_in(prk_expected, crypto.HashAlgorithm.sha256, "info", &kdf_buf, 48) !!) == 48)
    assert(kdf_view.to_string() == exp_expected)
    kdf_out.clear()
    assert((crypto.hkdf_expand_into(prk_expected, crypto.HashAlgorithm.sha256, "info", kdf_out, 48) !!) == 48)
    assert(kdf_out.to_string() == exp_expected)

    let hk_expected = crypto.hkdf("ikm", crypto.HashAlgorithm.sha256, "salt", "info", 48) !!
    assert((crypto.hkdf_in("ikm", crypto.HashAlgorithm.sha256, "salt", "info", &kdf_buf, 48) !!) == 48)
    assert(kdf_view.to_string() == hk_expected)
    kdf_out.clear()
    assert((crypto.hkdf_into("ikm", crypto.HashAlgorithm.sha256, "salt", "info", kdf_out, 48) !!) == 48)
    assert(kdf_out.to_string() == hk_expected)

    // Argon2id
    let a2_expected = crypto.argon2id("pw", "12345678", 64, 1, 1, 32) !!
    assert((crypto.argon2id_in("pw", "12345678", &d32, 64, 1, 1, 32) !!) == 32)
    assert(d32_view.to_string() == a2_expected)
    kdf_out.clear()
    assert((crypto.argon2id_into("pw", "12345678", kdf_out, 64, 1, 1, 32) !!) == 32)
    assert(kdf_out.to_string() == a2_expected)
    kdf_out.clear()
    let phc_len = crypto.argon2id_hash_into("pw", kdf_out, 64, 1, 1) !!
    assert(phc_len == kdf_out.length && crypto.argon2id_verify("pw", kdf_out))
}

test "http, net, time, json, url, html, regex, core _in and _into variants" {
    // http.format_date_in / _into, Cookie.to_header_into, Multipart.body_into
    let dt = time.DateTime.from_unix_seconds(784111777) !!
    let expected_date = http.format_date(dt)
    assert(expected_date == "Sun, 06 Nov 1994 08:49:37 GMT")
    let date_buf: [u8 x http.HTTP_DATE_SIZE] = @undefined
    let date_view: local &[u8] = &date_buf
    assert(http.format_date_in(dt, &date_buf) == 29 && date_view.to_string() == expected_date)
    let out = ByteBuffer.new()
    assert((http.format_date_into(dt, out) !!) == 29 && out.to_string() == expected_date)

    let cookie = http.Cookie.new("sid", "abc 123")
    cookie.max_age = 3600
    cookie.expires = dt
    out.clear()
    let clen = cookie.to_header_into(out) !!
    assert(clen == out.length && out.to_string() == cookie.to_header())

    let mp = http.Multipart.new()
    mp.add_field("a", "1")
    mp.add_file("f", "a.txt", "hello", "text/plain")
    out.clear()
    let mplen = mp.body_into(out) !!
    assert(mplen == out.length && out.to_string() == mp.body())

    // net IpAddr, Cidr, SocketAddress
    let ip6 = net.IpAddr.parse("2001:db8::1") !!
    let addr_buf: [u8 x net.ADDRESS_TEXT_SIZE] = @undefined
    let addr_view: local &[u8] = &addr_buf
    let ip_len = ip6.to_string_in(&addr_buf)
    assert(addr_view.view(0, ip_len).to_string() == "2001:db8::1")
    out.clear()
    assert((ip6.to_string_into(out) !!) == 11 && out.to_string() == "2001:db8::1")

    let cidr = net.Cidr.parse("2001:db8::1/64") !!
    let cidr_len = cidr.to_string_in(&addr_buf)
    assert(addr_view.view(0, cidr_len).to_string() == "2001:db8::/64")
    out.clear()
    assert((cidr.to_string_into(out) !!) == 13 && out.to_string() == "2001:db8::/64")

    let sa = ip6.to_socket_address(8443)
    out.clear()
    assert((sa.ip_into(out) !!) == 11 && out.to_string() == "2001:db8::1")
    out.clear()
    assert((sa.to_string_into(out) !!) == 18 && out.to_string() == "[2001:db8::1]:8443")

    // time.Duration
    let dur = time.Duration.of_seconds(3661) + time.Duration.of_ms(500)
    let dur_buf: [u8 x time.DURATION_TEXT_SIZE] = @undefined
    let dur_view: local &[u8] = &dur_buf
    let dlen = dur.to_string_in(&dur_buf)
    assert(dur_view.view(0, dlen).to_string() == "1h1m1.5s")
    out.clear()
    assert((dur.to_string_into(out) !!) == 8 && out.to_string() == "1h1m1.5s")

    // json.View.encode_into
    let view = json.read("{\"a\":1,\"b\":[true,null]}") !!
    out.clear()
    let jlen = view.encode_into(out) !!
    assert(jlen == out.length && out.to_string() == view.encode())

    // url
    let u = url.parse("https://user:pw@example.com:8080/a/b?x=1#top")
    out.clear()
    assert((u.to_string_into(out) !!) == out.length && out.to_string() == u.to_string())
    let qm = Map[String]{ "a" => "1", "b" => "x y" }
    out.clear()
    assert((url.build_query_into(qm, out) !!) == out.length && out.to_string() == url.build_query(qm))
    let qg = Map[Array[String]]{ "k" => .{ "1", "a b" } }
    out.clear()
    assert((url.build_query_grouped_into(qg, out) !!) == out.length && out.to_string() == url.build_query_grouped(qg))

    // html.sanitize_url_attributes_into
    let dirty = "<a href=\"javascript:alert(1)\">x</a>"
    out.clear()
    assert((html.sanitize_url_attributes_into(dirty, out) !!) == out.length)
    assert(out.to_string() == html.sanitize_url_attributes(dirty))

    // regex
    let re = regex.Regex.new("(?P<k>\\w+)=(\\d+)") !!
    out.clear()
    assert((re.replace_into("a=1 b=2", "${k}:$2", out) !!) == out.length && out.to_string() == "a:1 b:2")
    out.clear()
    assert((re.replace_with_into("a=1 b=2", fn(m: regex.Match) String { return m.to_string().upper() }, out) !!) == out.length)
    assert(out.to_string() == "A=1 B=2")
    let m = re.find("x=42") ?! panic("expected match")
    out.clear()
    assert((m.expand_into("[$k=$2]", out) !!) == 6 && out.to_string() == "[x=42]")
    out.clear()
    assert((regex.escape_into("a+b.(c)", out) !!) == 11 && out.to_string() == "a\\+b\\.\\(c\\)")

    // core Array.join_into & format_*_into
    let parts = Array[String]{ "one", "two", "three" }
    out.clear()
    assert((parts.join_into(", ", out) !!) == 15 && out.to_string() == "one, two, three")

    out.clear()
    assert((core.format_int_into(-42, "06", out) !!) == 6 && out.to_string() == "-00042")
    out.clear()
    assert((core.format_uint_into(255, "#06x", out) !!) == 6 && out.to_string() == "0x00ff")
    out.clear()
    assert((core.format_float_into(3.14159, ".2f", out) !!) == 4 && out.to_string() == "3.14")
    out.clear()
    assert((core.format_string_into("hi", ">5", out) !!) == 5 && out.to_string() == "   hi")
}

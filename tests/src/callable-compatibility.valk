class CallbackBox {
    number: int
}

error CallbackFailure (failed)
error CallbackFailures (other) extends (CallbackFailure)
enum CallbackChoice { first (73) }

fn callback_number(number: int) int { return number + 3 }

fn callback_optional_box(box: ?CallbackBox) int {
    return isset(box) ? box.number : 0
}

fn callback_box() CallbackBox { return CallbackBox { number: 73 } }
fn callback_choice() CallbackChoice { return CallbackChoice.first }

test "Callables: capture-free shared conversions preserve their signatures" {
    let callback: shared fn(int)(int) = callback_number
    assert(callback(41) == 44)

    let consume: shared fn(CallbackBox)(int) = callback_optional_box
    assert(consume(CallbackBox { number: 29 }) == 29)

    let create: shared fn()(?CallbackBox) = callback_box
    let result = create()
    assert(isset(result))
    if isset(result) : assert(result.number == 73)
}

fn callback_boxes() [CallbackBox x 2] {
    let values: [CallbackBox x 2] = { CallbackBox { number: 17 }, CallbackBox { number: 29 } }
    return values
}

fn callback_fail(fail: bool) int !CallbackFailure {
    if fail : throw .failed
    return 73
}

test "Callables: compatible layouts retain nullable and error variance" {
    let pointer: fnptr(CallbackBox)(int) = callback_optional_box
    assert(pointer(CallbackBox { number: 41 }) == 41)
    let pointer_result: fnptr()(?CallbackBox) = callback_box
    let box = pointer_result()
    assert(callback_optional_box(box) == 73)

    let boxes: fn()([?CallbackBox x 2]) = callback_boxes
    let values = boxes()
    assert(callback_optional_box(values[0]) == 17)
    assert(callback_optional_box(values[1]) == 29)

    let pending: co(?CallbackBox) = co callback_box()
    assert(callback_optional_box(await pending) == 73)
    let pending_boxes: co([?CallbackBox x 2]) = co callback_boxes()
    let awaited = await pending_boxes
    assert(callback_optional_box(awaited[1]) == 29)

    let fallible: fn(bool)(int !CallbackFailures) = callback_fail
    assert((fallible(false) !!) == 73)
    let failed = false
    fallible(true) ! { failed = E.code == E.failed }
    assert(failed)

    let fallible_pending: co(int !CallbackFailure) = co callback_number(70)
    assert((await fallible_pending !!) == 73)

    let enum_argument: fn(CallbackChoice)(int) = callback_number
    assert(enum_argument(CallbackChoice.first) == 76)
    let enum_result: fn()(int) = callback_choice
    assert(enum_result() == 73)
}

test "Callables: wrappers convert arguments results and error declarations" {
    let original = fn() int { return 73 }
    let optional: fn()(?int) = fn() ?int { return original() }
    assert(optional() == 73)

    let consume_optional = fn(value: ?int) int { return value ?? 0 }
    let consume: fn(int)(int) = fn(value: int) int { return consume_optional(value) }
    assert(consume(41) == 41)

    let fallible: fn()(int !CallbackFailure) = fn() int !CallbackFailure { return original() }
    assert((fallible() !!) == 73)

    let pending: co(?int) = co optional()
    assert((await pending) == 73)
}

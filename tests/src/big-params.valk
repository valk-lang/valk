use valk.gc

// Inline aggregates of 512 bytes or more are passed as the address of a copy the caller
// makes (ir_arg_by_pointer); every kind of call must agree on that

value BP_SIZE (200)

fn bp_make(seed: u32) [u32 x BP_SIZE] {
    let out: [u32 x BP_SIZE] = @undefined
    let i: uint = 0
    while i < BP_SIZE {
        out[i] = seed + i.to(u32)
        i++
    }
    return out
}

fn bp_sum(table: [u32 x BP_SIZE]) uint {
    let total: uint = 0
    each table as v : total += v.to(uint)
    return total
}

fn bp_expected(seed: u32) uint {
    return bp_sum(bp_make(seed))
}

// The callee changes its own copy only
fn bp_clear(table: [u32 x BP_SIZE]) uint {
    let i: uint = 0
    while i < BP_SIZE {
        table[i] = 0
        i++
    }
    return bp_sum(table)
}

fn bp_two(a: [u32 x BP_SIZE], b: [u32 x BP_SIZE]) uint {
    return bp_sum(a) * 1000000 + bp_sum(b)
}

fn bp_overwrite(table: local mut &[u32 x BP_SIZE], seed: u32) [u32 x BP_SIZE] {
    table[0] = 0
    return bp_make(seed)
}

struct BpNamed {
    name: String
    table: [u32 x BP_SIZE]
}

fn bp_named(item: BpNamed) String {
    return item.name + ":" + bp_sum(item.table)
}

interface BpSink {
    fn take(table: [u32 x BP_SIZE]) uint;
}

class BpAdder is BpSink {
    extra: uint
    fn take(table: [u32 x BP_SIZE]) uint {
        return bp_sum(table) + this.extra
    }
}

fn bp_generic[T](value: T, f: fn(T)(uint)) uint {
    return f(value)
}

test "Big params: direct calls keep the caller's copy" {
    let table = bp_make(3)
    assert(bp_sum(table) == bp_expected(3))
    assert(bp_clear(table) == 0)
    assert(table[5] == 8)
    assert(bp_two(table, bp_make(4)) == bp_expected(3) * 1000000 + bp_expected(4))
    // The first argument is copied before the second runs
    let first = bp_make(1)
    assert(bp_two(first, bp_overwrite(&first, 2)) == bp_expected(1) * 1000000 + bp_expected(2))
    assert(first[0] == 0)
    let item = BpNamed { name: "n", table: bp_make(5) }
    gc.collect()
    assert(bp_named(item) == "n:" + bp_expected(5))
}

test "Big params: closures, function pointers, interfaces, generics and coroutines" {
    let table = bp_make(7)
    let closure: fn([u32 x BP_SIZE])(uint) = bp_sum
    assert(closure(table) == bp_expected(7))
    let offset: uint = 10
    let capturing = fn(t: [u32 x BP_SIZE]) uint { return bp_sum(t) + offset }
    assert(capturing(table) == bp_expected(7) + 10)
    let pointer: fnptr([u32 x BP_SIZE])(uint) = bp_sum
    assert(pointer(table) == bp_expected(7))
    let adder = BpAdder { extra: 2 }
    let sink: BpSink = adder
    assert(sink.take(table) == bp_expected(7) + 2)
    let bound = adder.take
    assert(bound(table) == bp_expected(7) + 2)
    assert(bp_generic(table, bp_sum) == bp_expected(7))
    let task = co bp_sum(table)
    table[0] = 0
    assert((await task) == bp_expected(7))
    let method_task = co sink.take(bp_make(8))
    assert((await method_task) == bp_expected(8) + 2)
}

use valk.gc

// A nullable inline value keeps its payload words when absent. The collector must only
// read them while the presence flag is set: here an absent payload holds a word that is
// not an object, which a walk or a root scan would follow and fault on

global presence_alive: uint
global presence_global: ?PresenceValue (null)

class PresenceNode {
    value: uint

    fn gc_free() {
        presence_alive--
    }
}

struct PresenceValue {
    node: PresenceNode
}

class PresenceHolder {
    value: ?PresenceValue
}

fn presence_node(value: uint) PresenceNode {
    presence_alive++
    return PresenceNode { value: value }
}

// Absent, with a payload word that is no object
fn presence_poison(at: ptr) {
    @ptrv(at, u8) = 0
    @ptrv(at, uint, 1) = 0x10
}

fn presence_holder_absent() $noinline {
    @unsafe
    let holder = PresenceHolder { value: null }
    presence_poison(holder.@cast(ptr))
    gc.collect()
    holder.value = PresenceValue { node: presence_node(7) }
    gc.collect()
    let value = holder.value ?! panic("value missing")
    assert(value.node.value == 7)
}

synctest "GC: an absent nullable inline field is not traced" {
    let base = presence_alive
    presence_holder_absent()
    gc.collect()
    assert(presence_alive == base)
}

synctest "GC: an absent nullable inline global is not a root" {
    @unsafe
    presence_global = null
    presence_poison(@ref(presence_global).@cast(ptr))
    gc.collect()
    presence_global = PresenceValue { node: presence_node(9) }
    gc.collect()
    let value = presence_global ?! panic("value missing")
    assert(value.node.value == 9)
    presence_poison(@ref(presence_global).@cast(ptr))
    gc.collect()
    assert(!isset(presence_global))
}

union PresenceChoice : PresenceNode | uint {}

global presence_choice: ?PresenceChoice (null)

// Absent, with the object member's tag and a payload word that is no object
fn presence_poison_choice(at: ptr) {
    @ptrv(at, u8) = 0
    @ptrv(at, u8, 8) = 0
    @ptrv(at, uint, 2) = 0x10
}

synctest "GC: an absent nullable union global is not a root" {
    @unsafe
    let at = @ref(presence_choice).@cast(ptr)
    let raw: uint = 0x10
    presence_choice = raw
    // The layout the poison relies on: presence word, tag byte, payload word
    assert(@ptrv(at, u8) == 1 && @ptrv(at, u8, 8) == 1 && @ptrv(at, uint, 2) == 0x10)
    presence_poison_choice(at)
    gc.collect()
    presence_choice = presence_node(11)
    gc.collect()
    match presence_choice {
        PresenceNode as node => assert(node.value == 11)
        default => assert(false)
    }
    presence_poison_choice(at)
    gc.collect()
    assert(!isset(presence_choice))
}

// Classes for hook-queries.valk, declared in another file

class HookTask {
    at: uint
    + fn gt(other: HookTask) bool $gt { return this.at > other.at }
}

class HookKey {
    id: uint
    + fn eq(other: HookKey) bool $eq { return this.id == other.id }
    + fn hash() uint $hash { return this.id }
}

// Orders itself, and its own properties need that order before the hook is declared
class HookNode {
    at: uint
    kids: Heap[HookNode] (.{})
    sorted: Array[HookNode] (.{})
    + fn lt(other: HookNode) bool $lt { return this.at < other.at }
}

// The hook comes from an extend
class HookTree {
    at: uint
    kids: Heap[HookTree] (.{})
}

extend HookTree {
    + fn lt(other: HookTree) bool $lt { return this.at < other.at }
}

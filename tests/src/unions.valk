
class NarrowedUnionItem { v: int }
union NarrowedUnionVal : NarrowedUnionItem | int {}

test "Unions: a narrowed nullable union matches exhaustively" {
    let m: ?NarrowedUnionVal = NarrowedUnionItem { v: 3 }
    let total = 0
    if isset(m) {
        total = match m : int { NarrowedUnionItem as it => it.v  int as n => n }
    }
    assert(total == 3)
}

use valk.sync
use valk.net
use valk.thread
use valk.time
use valk.gc
use valk.fs

// Grove-MT v6's library changes (3.8), which Valk's collector needs too

test "CancelToken: per-request children that are cancelled and dropped are not kept (S5)" {
    let stop = sync.CancelToken.new() !!
    let i: uint = 0
    while i < 20000 {
        let request = stop.child() !!
        request.cancel()
        assert(request.is_cancelled())
        i++
    }
    assert(stop.children_for_test() == 0)
    assert(!stop.is_cancelled())
}

test "CancelToken: per-request children with a transient waiter are dropped (S5)" {
    let stop = sync.CancelToken.new() !!
    let ch = sync.Channel[uint].new() !!
    let first = stop.child() !!
    let i: uint = 0
    while i < 300 {
        let request = i == 0 ? first : (stop.child() !!)
        let timed_out = false
        ch.recv(1, request) ! { timed_out = error_is(E.code, timeout) }
        assert(timed_out)
        i++
    }
    assert(stop.children_for_test() < 40)

    // A dropped child that waits again, and a grandchild, are still reached by the cancel
    let grandchild = first.child() !!
    let first_waits = co first.wait(5000)
    let grandchild_waits = co grandchild.wait(5000)
    stop.cancel()
    assert(await first_waits)
    assert(await grandchild_waits)
    assert(grandchild.is_cancelled())
}

test "CancelToken: a child of a cancelled ancestor registers as cancelled (S5)" {
    let stop = sync.CancelToken.new() !!
    let middle = stop.child() !!
    let leaf = middle.child() !!
    stop.cancel()
    assert(leaf.is_cancelled())
    let calls: atomic sync.Channel[String] = sync.Channel[String].new() !!
    leaf.on_cancel(fn() { calls.try_send("leaf") !! })
    assert((calls.recv(2000) !!) == "leaf")
    assert(leaf.wait(10))
}

fn watched_udp_dropped(token: sync.CancelToken) $noinline {
    let socket = net.udp_server("127.0.0.1", 0) !!
    socket.set_cancel(token)
}

synctest "CancelToken: a dropped socket's watch never shuts down a reused descriptor (S8)" {
    let token = sync.CancelToken.new() !!
    let i: uint = 0
    while i < 20 {
        watched_udp_dropped(token)
        i++
    }
    gc.collect()
    gc.collect_shared()
    // Likely reuses a descriptor number of the dropped sockets
    let keep = net.udp_server("127.0.0.1", 0) !!
    let port = (keep.local_address() !!).port
    token.cancel()
    assert(token.watches_for_test() == 0)
    let client = net.udp_client("127.0.0.1", port) !!
    client.write("ok") !!
    let buffer = [u8]{ 0 x 4 }
    let bytes, _ = keep.recv_from(buffer) !!
    assert(bytes == 2)
    client.close() !!
    keep.close() !!
}

test "CancelToken: closing a watched socket drops its watch record (S8)" {
    let token = sync.CancelToken.new() !!
    let socket = net.udp_server("127.0.0.1", 0) !!
    socket.set_cancel(token)
    assert(token.watches_for_test() == 1)
    socket.close() !!
    assert(token.watches_for_test() == 0)
    token.cancel()
}

#if !TEST_ST_ONLY
fn open_fd_count() uint {
    let entries = fs.read_dir("/proc/self/fd") ! return 0
    let count: uint = 0
    while true {
        let name = entries.next() ! break
        if !isset(name) : break
        count++
    }
    entries.close() _
    return count
}

synctest "Channel: threads that end parked on a channel leave no descriptors behind (S4)" {
    let ch: atomic sync.Channel[uint] = sync.Channel[uint].new() !!
    let before = open_fd_count()
    let i: uint = 0
    while i < 200 {
        let t = thread.start(fn() {
            // Parks on the channel; the thread ends with the coroutine still waiting
            let pending = co ch.recv()
        }) !!
        t.await()
        i++
    }
    let after = open_fd_count()
    assert(after <= before + 24)
    ch.close()
}
#end

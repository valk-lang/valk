use valk.sync
use valk.thread
use valk.fs

// Grove-MT v6's library changes (3.8), which Valk's collector needs too

#if !TEST_ST_ONLY
fn open_fd_count() uint {
    let entries = fs.read_dir("/proc/self/fd") ! return 0
    let count: uint = 0
    while true {
        let name = entries.next() ! break
        if !isset(name) : break
        count++
    }
    entries.close() _
    return count
}

synctest "Channel: threads that end parked on a channel leave no descriptors behind (S4)" {
    let ch: atomic sync.Channel[uint] = sync.Channel[uint].new() !!
    let before = open_fd_count()
    let i: uint = 0
    while i < 200 {
        let t = thread.start(fn() {
            // Parks on the channel; the thread ends with the coroutine still waiting
            let pending = co ch.recv()
        }) !!
        t.await()
        i++
    }
    let after = open_fd_count()
    assert(after <= before + 24)
    ch.close()
}
#end

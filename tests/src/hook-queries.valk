// Hook queries (`$can_order`, `$has_hash`, `$has_eq`, `$has_method`) answer from the hooks a
// class declares, whichever class the build reaches first: classes are declared before and
// after their users, and in hook-query-items.valk

class HookEarlyJob {
    at: uint
    + fn lt(other: HookEarlyJob) bool $lt { return this.at < other.at }
}

class HookQueue {
    early: Heap[HookEarlyJob] (.{})
    jobs: Heap[HookJob] (.{})
    tasks: Heap[HookTask] (.{})
    sorted: Array[HookJob] (.{})
    seen: HashSet[HookKey] (.{})
    counts: HashMap[HookKey, uint] (.{})
}

global hook_heap: Heap[HookJob] (.{})
global hook_set: HashSet[HookKey] (.{})

class HookAnswers {
    #if HookJob.$can_order && HookTask.$can_order && HookKey.$has_hash && HookKey.$has_eq && HookJob.$has_method(lt)
    + all: bool (true)
    #else
    + all: bool (false)
    #end
    #if HookPlain.$can_order || HookPlain.$has_hash || HookPlain.$has_eq || HookPlain.$has_method(lt)
    + none: bool (false)
    #else
    + none: bool (true)
    #end
}

class HookJob {
    at: uint
    + fn lt(other: HookJob) bool $lt { return this.at < other.at }
}

class HookPlain {
    at: uint
}

test "Hook queries: property defaults order by hooks declared elsewhere" {
    let q = HookQueue {}
    q.early.push(HookEarlyJob { at: 4 })
    q.early.push(HookEarlyJob { at: 3 })
    assert((q.early.pop() ! panic("empty")).at == 3)
    q.jobs.push(HookJob { at: 2 })
    q.jobs.push(HookJob { at: 1 })
    q.jobs.push(HookJob { at: 3 })
    assert((q.jobs.pop() ! panic("empty")).at == 1)
    q.tasks.push(HookTask { at: 5 })
    q.tasks.push(HookTask { at: 4 })
    assert((q.tasks.pop() ! panic("empty")).at == 4)

    q.sorted.append(HookJob { at: 9 })
    q.sorted.append(HookJob { at: 7 })
    q.sorted.sort()
    assert(q.sorted[0].at == 7 && q.sorted[1].at == 9)
}

test "Hook queries: maps and sets hash keys declared elsewhere" {
    let q = HookQueue {}
    q.seen.add(HookKey { id: 3 })
    q.seen.add(HookKey { id: 3 })
    assert(q.seen.length == 1 && q.seen.has(HookKey { id: 3 }))
    q.counts.set(HookKey { id: 1 }, 5)
    assert((q.counts.get(HookKey { id: 1 }) !? 0) == 5)
}

test "Hook queries: globals and class bodies see hooks declared elsewhere" {
    hook_heap.push(HookJob { at: 8 })
    hook_heap.push(HookJob { at: 6 })
    assert((hook_heap.pop() ! panic("empty")).at == 6)
    hook_set.add(HookKey { id: 4 })
    assert(hook_set.has(HookKey { id: 4 }))

    let answers = HookAnswers {}
    assert(answers.all)
    assert(answers.none)
}

test "Hook queries: a class's own properties see hooks declared after them" {
    let node = HookNode { at: 1 }
    node.kids.push(HookNode { at: 3 })
    node.kids.push(HookNode { at: 2 })
    assert((node.kids.pop() ! panic("empty")).at == 2)
    node.sorted.append(HookNode { at: 5 })
    node.sorted.append(HookNode { at: 4 })
    node.sorted.sort()
    assert(node.sorted[0].at == 4)

    let tree = HookTree { at: 1 }
    tree.kids.push(HookTree { at: 7 })
    tree.kids.push(HookTree { at: 6 })
    assert((tree.kids.pop() ! panic("empty")).at == 6)
}

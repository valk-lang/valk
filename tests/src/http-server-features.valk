use valk.http
use valk.time
use valk.compress

fn server_features_handler(req: http.Request) http.Response {
    return http.Response.text("handler " + req.path)
}

test "HTTP server: middleware wraps the handler in order" {
    let server = http.Server.new("127.0.0.1", 19571, server_features_handler)
    server.add_middleware(fn(req: http.Request, next: shared fn(http.Request)(http.Response)) http.Response {
        if req.path == "/blocked" : return http.Response.text("denied", 403)
        let res = next(req)
        res.add_header("X-Order", "first")
        return res
    })
    server.add_middleware(fn(req: http.Request, next: shared fn(http.Request)(http.Response)) http.Response {
        let res = next(req)
        res.add_header("X-Order", "second")
        res.body = res.body + "!"
        return res
    })
    let running = co server.start(1)
    time.sleep_ms(20)

    let res = http.get("http://127.0.0.1:19571/page") !!
    assert(res.body == "handler /page!")
    // The inner middleware changed the response first
    assert(res.headers.get_all("x-order").join(",") == "second,first")
    let blocked = http.get("http://127.0.0.1:19571/blocked") !!
    assert(blocked.status == 403 && blocked.body == "denied")

    server.shutdown()
    await running !!
}

test "HTTP router: wildcard value, decoded params and allowed methods" {
    let router = http.Router[String].new()
    router.add("GET", "/users/@name", "user")
    router.add("GET", "/files/*", "files")
    router.add("POST", "/users/@name", "update")
    router.add("DELETE", "/users/@name", "remove")

    let user = router.find("GET", "/users/J\%C3\%B6rg\%20B") !!
    assert(user.params("/users/J\%C3\%B6rg\%20B").get("name") !! == "Jörg B")
    // As written, and a plus stays a plus
    assert(user.params("/users/J\%C3\%B6rg\%20B", false).get("name") !! == "J\%C3\%B6rg\%20B")
    assert(user.params("/users/c++").get("name") !! == "c++")

    let files = router.find("GET", "/files/docs/a\%20b/c.txt") !!
    assert(files.params("/files/docs/a\%20b/c.txt").get("*") !! == "docs/a b/c.txt")

    assert(router.allowed_methods("/users/ada").join(",") == "DELETE,GET,POST")
    assert(router.allowed_methods("/files/x").join(",") == "GET")
    assert(router.allowed_methods("/nothing").length == 0)
}

fn compress_handler(req: http.Request) http.Response {
    if req.path == "/small" : return http.Response.text("tiny")
    if req.path == "/binary" : return http.Response.new("x".repeat(5000), 200, "application/octet-stream")
    if req.path == "/encoded" {
        let res = http.Response.text("y".repeat(5000))
        res.set_header("Content-Encoding", "identity")
        return res
    }
    return http.Response.html("<p>" + "hello ".repeat(2000) + "</p>")
}

test "HTTP server: compress sends gzip to clients that take it" {
    let server = http.Server.new("127.0.0.1", 19572, compress_handler)
    server.compress = true
    let running = co server.start(1)
    time.sleep_ms(20)
    let base = "http://127.0.0.1:19572"

    let raw = http.get(base + "/page", http.Options { decompress: false, headers: http.Headers { "Accept-Encoding" => "gzip" } }) !!
    assert((raw.headers.get("content-encoding") !? "") == "gzip")
    assert((raw.headers.get("vary") !? "") == "Accept-Encoding")
    assert(raw.body.bytes < 1000)
    assert(compress.gunzip(raw.body) !! == "<p>" + "hello ".repeat(2000) + "</p>")

    // The client decompresses by itself
    assert((http.get(base + "/page") !!).body.bytes == 12007)

    // Not asked for, too small, not text, or already encoded: sent as it is
    let plain = http.get(base + "/page", http.Options { decompress: false }) !!
    assert(!plain.headers.has("content-encoding") && (plain.headers.get("vary") !? "") == "Accept-Encoding")
    let refused = http.get(base + "/page", http.Options { decompress: false, headers: http.Headers { "Accept-Encoding" => "gzip;q=0" } }) !!
    assert(!refused.headers.has("content-encoding"))
    assert(!(http.get(base + "/small") !!).headers.has("vary"))
    assert(!(http.get(base + "/binary", http.Options { decompress: false, headers: http.Headers { "Accept-Encoding" => "gzip" } }) !!).headers.has("content-encoding"))
    assert(((http.get(base + "/encoded", http.Options { decompress: false, headers: http.Headers { "Accept-Encoding" => "gzip" } }) !!).headers.get("content-encoding") !? "") == "identity")

    server.shutdown()
    await running !!
}

use valk.core

class DefaultValueClass {
    value: String

    static fn make_default() SELF $default {
        return SELF { value: "class-default" }
    }
}

struct DefaultValueStruct {
    value: uint

    static fn zeroed() SELF $default {
        return SELF { value: 42 }
    }
}

class DefaultValueWithArgs {
    value: String
    count: uint

    static fn make_default(value: String ("argument-default"), count: uint (7)) SELF $default {
        return SELF { value: value, count: count }
    }
}

struct DefaultValueBox[T] {
    value: T

    static fn make_default() SELF $default {
        return SELF { value: T.$default_value }
    }
}

class NoDefaultValue {}

class DefaultValueHolder {
    value: DefaultValueClass
}

class NullableDefaultValueHolder {
    value: ?DefaultValueClass
}

class ExplicitDefaultValueHolder {
    value: DefaultValueClass (DefaultValueClass { value: "property-default" })
}

test "Default value: class and struct hooks" {
    let class_value: DefaultValueClass = DefaultValueClass.$default_value
    let struct_value: DefaultValueStruct = DefaultValueStruct.$default_value

    assert(class_value.value == "class-default")
    assert(struct_value.value == 42)
}

test "Default value: hook arguments use their defaults" {
    let value: DefaultValueWithArgs = DefaultValueWithArgs.$default_value

    assert(value.value == "argument-default")
    assert(value.count == 7)
}

test "Default value: core library factories" {
    let array: Array[String] = Array[String].$default_value
    let map: Map[String] = Map[String].$default_value
    let flat_map: FlatMap[String, uint] = FlatMap[String, uint].$default_value
    let hash_map: HashMap[String, uint] = HashMap[String, uint].$default_value
    let slice: Slice[uint] = Slice[uint].$default_value
    let buffer: ByteBuffer = ByteBuffer.$default_value
    let pool: core.Pool[uint] = core.Pool[uint].$default_value
    let mutex: core.SyncMutex = core.SyncMutex.$default_value

    assert(array.length == 0)
    assert(map.length == 0)
    assert(flat_map.length == 0)
    assert(hash_map.length == 0)
    assert(slice.length == 0)
    assert(buffer.length == 0)
    assert(pool.count == 0)
    mutex.lock()
    mutex.unlock()
}

test "Default value: omitted properties use the hook" {
    let holder = DefaultValueHolder {}
    let explicit_holder = ExplicitDefaultValueHolder {}

    assert(holder.value.value == "class-default")
    assert(explicit_holder.value.value == "property-default")
}

test "Default value: generic hooks use the concrete type" {
    let number_box: DefaultValueBox[uint] = DefaultValueBox[uint].$default_value
    let bool_box: DefaultValueBox[bool] = DefaultValueBox[bool].$default_value

    assert(number_box.value == 0)
    assert(!bool_box.value)
}

test "Default value: nullable types always use null" {
    let nullable: ?DefaultValueClass = null
    let value: ?DefaultValueClass = nullable.$default_value
    let holder = NullableDefaultValueHolder {}

    assert(!isset(value))
    assert(!isset(holder.value))
}

test "Default value: availability includes type hooks" {
    #if DefaultValueClass.$has_default_value
    assert(true)
    #else
    assert(false)
    #end

    #if NoDefaultValue.$has_default_value
    assert(false)
    #else
    assert(true)
    #end
}

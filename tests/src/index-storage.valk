use valk.gc

class IndexStorageItem { number: int }
class IndexStorage {
    view: Slice[int] (Slice[int]{7, 19, 23})
    items: Slice[IndexStorageItem] (Slice[IndexStorageItem]{ IndexStorageItem {number: 7} })
    calls: int (0)
    fn shrink() uint {
        this.calls++
        this.view = Slice[int]{73}
        gc.collect()
        return 2
    }
    fn replace_items() uint {
        this.calls++
        this.items = Slice[IndexStorageItem]{ IndexStorageItem {number: 19} }
        gc.collect()
        return 0
    }
    fn replacement() IndexStorageItem {
        this.replace_items()
        return IndexStorageItem {number: 73}
    }
}

fn index_storage_shrink(view: stack Slice[int]) uint {
    view[0] = Slice[int]{73}
    gc.collect()
    return 2
}

test "Indexing: reads and ranges use the selected slice" {
    let holder = IndexStorage {}
    assert(holder.view[holder.shrink()] == 23)
    assert(holder.calls == 1 && holder.view[0] == 73)
    holder = IndexStorage {}
    let range = holder.view[holder.shrink()..1]
    assert(range.length == 1 && range[0] == 23)
    assert(holder.calls == 1 && holder.view[0] == 73)
    let local = Slice[int]{7, 19, 23}
    assert(local[index_storage_shrink(&local)] == 23)
    assert(local.length == 1 && local[0] == 73)
}

test "Indexing: stores increments and borrows use the selected slice" {
    let holder = IndexStorage {}
    let original = holder.view
    holder.view[holder.shrink()] = 29
    assert(original[2] == 29 && holder.view[0] == 73)
    holder = IndexStorage {}
    original = holder.view
    holder.view[holder.shrink()]++
    assert(original[2] == 24 && holder.calls == 1)
    holder = IndexStorage {}
    original = holder.view
    holder.view[holder.shrink()] += 3
    assert(original[2] == 26 && holder.calls == 1)
    holder = IndexStorage {}
    let borrowed = &holder.view[holder.shrink()]
    assert(borrowed[0] == 23 && holder.calls == 1)
    borrowed[0] = 29
    assert(borrowed[0] == 29 && holder.view[0] == 73)
}

test "Indexing: managed stores retain the selected owner through both operands" {
    let holder = IndexStorage {}
    let original = holder.items
    holder.items[holder.replace_items()] = IndexStorageItem {number: 73}
    gc.collect()
    assert(original[0].number == 73 && holder.items[0].number == 19)
    holder = IndexStorage {}
    original = holder.items
    holder.items[0] = holder.replacement()
    gc.collect()
    assert(original[0].number == 73 && holder.items[0].number == 19)
}

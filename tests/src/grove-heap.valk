use valk.gc
use valk.fs

// gc.GcPtr keeps the large objects of a peak alive
@ignore_access

// A 64-byte allocation fills its slot exactly: one past its end is the next slot's start.
// Only the returned word names the allocation once the function returns
fn grove_fill(size: uint, pattern: u8, keep: uint) ptr $noinline {
    @unsafe
    let item: ptr = gc.alloc(size)
    grove_set(item, size, pattern)
    return item + keep
}

fn grove_set(item: ptr, size: uint, pattern: u8) {
    let i: uint = 0
    while i < size {
        @ptrv(item, u8, i) = pattern
        i++
    }
}

fn grove_holds(item: ptr, size: uint, pattern: u8) bool {
    let i: uint = 0
    while i < size {
        if @ptrv(item, u8, i) != pattern : return false
        i++
    }
    return true
}

// Reuses (or, with GC_DEBUG, poisons) any slot of that size a collection freed
fn grove_churn(size: uint) $noinline {
    let i: uint = 0
    while i < 512 {
        grove_fill(size, 0xEE, 0)
        i++
    }
    gc.collect()
}

synctest "Grove: interior and one-past-the-end stack words keep their object" {
    @unsafe
    let end = grove_fill(64, 0x5A, 64)
    let inner = grove_fill(64, 0xA5, 24)
    gc.collect()
    grove_churn(64)
    assert(grove_holds(end - 64, 64, 0x5A))
    assert(grove_holds(inner - 24, 64, 0xA5))
}

// A 64-byte allocation in the last slot of a block of 64-byte slots, which fill its pages:
// one past its end is the next page run's first page. Returns only that word
fn grove_block_end() ptr $noinline {
    @unsafe
    while true {
        let item: ptr = gc.alloc(64)
        let end = item + 64
        let a: uint = end
        if a & 4095 == 0 && (!gc.in_heap(end) || gc.desc_of(end).@cast(ptr) != gc.desc_of(item).@cast(ptr)) {
            grove_set(item, 64, 0x5A)
            return end
        }
    }
}

synctest "Grove: one past the last slot of a block keeps its object" {
    @unsafe
    let end = grove_block_end()
    gc.collect()
    grove_churn(64)
    grove_churn(64)
    assert(grove_holds(end - 64, 64, 0x5A))
}

// The page of a fresh large object; the address itself is not kept
fn grove_large_page(size: uint) uint $noinline {
    @unsafe
    let item: ptr = gc.alloc(size)
    @ptrv(item, u8, size - 1) = 1
    let address: uint = item
    return address >> 12
}

synctest "Grove: a large object is freed and its pages are reused" {
    gc.collect()
    let before = gc.mem_usage()
    let page = grove_large_page(100_000)
    assert(gc.mem_usage() >= before + 100_000)
    gc.collect()
    assert(gc.mem_usage() < before + 100_000)
    // First fit by address: the freed pages, or lower ones
    let again = grove_large_page(100_000)
    assert(again <= page)
    gc.collect()
}

fn grove_rss() uint {
    let statm = fs.read("/proc/self/statm") !? ""
    let pages = statm.split(" ").get(1) !? "0"
    return (pages.to_uint() !? 0) * 4096
}

// Keeps `count` MiB alive in large objects whose pages are all touched, then returns the RSS
fn grove_peak(count: uint) uint $noinline {
    @unsafe
    let list = Array[gc.GcPtr].new(count)
    let size: uint = 1024 * 1024
    let i: uint = 0
    while i < count {
        let item = gc.alloc(size)
        let p: ptr = item
        let offset: uint = 0
        while offset < size {
            @ptrv(p, u8, offset) = 1
            offset += 4096
        }
        list.append(item)
        i++
    }
    return grove_rss()
}

#if OS == "linux"
synctest "Grove: memory usage and RSS fall after a peak" {
    let mib: uint = 1024 * 1024
    gc.collect()
    let before = gc.mem_usage()
    let rss_peak = grove_peak(48)
    assert(gc.mem_usage_peak >= before + 48 * mib)
    gc.collect()
    assert(gc.mem_usage() < before + 4 * mib)
    // A chunk that stayed free for two collections goes back to the OS
    gc.collect()
    assert(grove_rss() + 24 * mib < rss_peak)
}
#end

@unsafe

#if GROVE

use valk.gc

// Reads the storage word of arrays
@ignore_access

class GroveInitNode {
    v: uint (0)
}

// A traced `@undefined` word, a fixed array with a zero tail and an Array whose `data` is
// `zero_default`: words the constructor writes as zero, since the object is not zeroed
class GroveInitHolder {
    head: ?GroveInitNode (@undefined)
    slots: [?GroveInitNode x 12] ({ null... })
    list: Array[GroveInitNode] (.{})
    count: uint (5)
}

// Fills the slots that holders take, then drops them
fn grove_init_dirty(rounds: uint) $noinline {
    let i: uint = 0
    while i < rounds {
        let h = GroveInitHolder {}
        h.head = GroveInitNode { v: i }
        let k: uint = 0
        while k < 12 {
            h.slots[k] = GroveInitNode { v: k }
            k++
        }
        h.list.append(GroveInitNode { v: 1 })
        i++
    }
}

fn grove_init_fresh_ok(h: GroveInitHolder) bool {
    if isset(h.head) || h.count != 5 : return false
    if isset(h.list.data) || h.list.length != 0 || h.list.size != 0 : return false
    let k: uint = 0
    while k < 12 {
        if isset(h.slots[k]) : return false
        k++
    }
    return true
}

synctest "Grove: a constructor writes the words its fields leave out" {
    let round: uint = 0
    while round < 3 {
        grove_init_dirty(200)
        gc.collect()
        let i: uint = 0
        while i < 200 {
            let h = GroveInitHolder {}
            assert(grove_init_fresh_ok(h))
            // Marked and walked with every word written
            if i % 50 == 0 : gc.collect()
            i++
        }
        round++
    }
}

fn grove_init_fill_nodes(count: uint) Array[?GroveInitNode] $noinline {
    return Array[?GroveInitNode].fill(count, GroveInitNode { v: count })
}

synctest "Grove: fill writes every element of storage it does not zero" {
    let round: uint = 0
    while round < 20 {
        let a = Array[String].fill(64, "")
        let b = grove_init_fill_nodes(round + 1)
        let s = [?GroveInitNode]{ GroveInitNode { v: 7 } x 33 }
        gc.collect()
        assert(a.length == 64 && a.size == 64)
        assert(b.length == round + 1)
        each a as v : assert(v == "")
        each b as n {
            let node = n ?! panic("missing element")
            assert(node.v == round + 1)
        }
        each s as n {
            let node = n ?! panic("missing element")
            assert(node.v == 7)
        }
        // Appending grows the filled storage
        b.append(null)
        assert(b.length == round + 2)
        round++
    }
    let empty = Array[String].fill(0, "x")
    assert(empty.length == 0)
}

#end

fn unsafe_identity(value: ptr) ptr {
    return value
}

fn unsafe_read(value: *[u8]) u8 {
    @unsafe
    return value[0]
}

fn unsafe_write(value: *[u8]) {
    @unsafe
    value[0] = 1
}

fn explicitly_unsafe(value: ptr) ptr $unsafe {
    return value
}

#if OS == "macos" || OS == "bsd"
test "Unsafe directive applies to target-specific code" {
    @unsafe
    let value = 7.@cast(ptr)
    assert(unsafe_identity(value) == value)
}
#end

test "Unsafe local scope permits unsafe operations" {
    @unsafe
    let value = 7.@cast(ptr)
    assert(unsafe_identity(value) == value)
    assert(explicitly_unsafe(value) == value)
}

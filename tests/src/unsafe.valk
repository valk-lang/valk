fn unsafe_identity(value: ptr) ptr {
    return value
}

fn unsafe_read(value: *[u8]) u8 {
    @unsafe
    return value[0]
}

fn unsafe_write(value: *[u8]) {
    @unsafe
    value[0] = 1
}

fn safe_unsafe_wrapper(value: *[u8]) u8 {
    unsafe_write(value)
    return unsafe_read(value)
}

struct TypedMemValue {
    first: u32
    second: u64
}

#if OS == "macos" || OS == "bsd"
test "Unsafe directive applies to target-specific code" {
    @unsafe
    let value = 7.@cast(ptr)
    assert(unsafe_identity(value) == value)
}
#end

test "Unsafe local scope permits unsafe operations" {
    @unsafe
    let value = 7.@cast(ptr)
    assert(unsafe_identity(value) == value)
}

test "At tokens do not require unsafe" {
    let value = String.alloc(1)
    @ptrv(value.data.@offset(0), u8) = 7
    assert(@ptrv(value.data, u8) == 7)
}

test "References convert to void pointers without unsafe" {
    let value = 7
    let pointer: ptr = &value
    assert(pointer != null)
}

test "Unsafe operations stay inside their declaring scope" {
    let value: *[u8] = mem.alloc(1)
    assert(safe_unsafe_wrapper(value) == 1)
}

test "Typed memory helpers do not require unsafe" {
    let source = mem.new[TypedMemValue](.{ first: 12, second: 34 })
    let copied = mem.new[TypedMemValue]()
    let moved = mem.new[TypedMemValue]()

    mem.copy_value[TypedMemValue](source, copied)
    assert(copied.first == 12 && copied.second == 34)

    mem.move_value[TypedMemValue](copied, moved)
    assert(moved.first == 12 && moved.second == 34)

    mem.clear_value[TypedMemValue](copied)
    assert(copied.first == 0 && copied.second == 0)

    @unsafe
    mem.free(source)
    mem.free(copied)
    mem.free(moved)
}

test "Typed memory helpers accept numbers" {
    @unsafe
    let number = mem.new[u64](41)
    assert(@ptrv(number, u64, 0) == 41)
    let other = mem.new[u64]()
    mem.copy_value[u64](number, other)
    assert(@ptrv(other, u64, 0) == 41)
    mem.clear_value[u64](other)
    assert(@ptrv(other, u64, 0) == 0)
    let moved = mem.new[u64](7)
    mem.move_value[u64](moved, other)
    assert(@ptrv(other, u64, 0) == 7)
    let real = mem.new[f64](1.5)
    assert(@ptrv(real, f64, 0) == 1.5)
    let flag = mem.new[bool](true)
    assert(@ptrv(flag, bool, 0) == true)
    mem.free(number)
    mem.free(other)
    mem.free(moved)
    mem.free(real)
    mem.free(flag)
}

use valk.mem

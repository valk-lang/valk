
class AutoConvertSource {
    fn to_string() String $auto {
        return "converted"
    }
}

class AutoConvertTarget {
    value: String
}

class BoolConvertSource {
    fn to_bool() bool $auto {
        return true
    }
}

test "Auto-convert .to() .$to()" {
    let x = 5.to(String)
    assert(x == "5")
    let y = 257.to(u8)
    assert(y == 1)

    let source = AutoConvertSource{}
    let target = AutoConvertTarget{ value: source }
    assert(target.value == "converted")

    let bool_source = BoolConvertSource{}
    let explicit_bool = bool_source.to(bool)
    let implicit_bool: bool = bool_source
    assert(explicit_bool)
    assert(implicit_bool)
    assert(true.to(int) == 1)
}

class CompareLt {
    v: int
    + fn lt(o: CompareLt) bool $lt { return this.v < o.v }
}

class CompareGt {
    v: int
    + fn gt(o: CompareGt) bool $gt { return this.v > o.v }
}

class CompareLte {
    v: int
    + fn lte(o: CompareLte) bool $lte { return this.v <= o.v }
}

test "A single ordering hook answers all four comparisons" {
    let five = CompareLt{ v: 5 }
    let same = CompareLt{ v: 5 }
    let nine = CompareLt{ v: 9 }
    assert(!(five < same) && five <= same && !(five > same) && five >= same)
    assert(five < nine && five <= nine && !(five > nine) && !(five >= nine))
    assert(!(nine < five) && !(nine <= five) && nine > five && nine >= five)

    let g5 = CompareGt{ v: 5 }
    let g5b = CompareGt{ v: 5 }
    let g9 = CompareGt{ v: 9 }
    assert(!(g5 < g5b) && g5 <= g5b && !(g5 > g5b) && g5 >= g5b)
    assert(g5 < g9 && g5 <= g9 && !(g5 > g9) && !(g5 >= g9))

    let l5 = CompareLte{ v: 5 }
    let l5b = CompareLte{ v: 5 }
    let l9 = CompareLte{ v: 9 }
    assert(!(l5 < l5b) && l5 <= l5b && !(l5 > l5b) && l5 >= l5b)
    assert(l9 > l5 && l9 >= l5 && !(l9 < l5) && !(l9 <= l5))
}

test "Sorting uses the ordering hook, whichever one a class defines" {
    let lts = Array[CompareLt]{ CompareLt{ v: 7 }, CompareLt{ v: 5 }, CompareLt{ v: 1 }, CompareLt{ v: 5 } }
    lts.sort()
    assert(lts[0].v == 1 && lts[1].v == 5 && lts[2].v == 5 && lts[3].v == 7)
    let gts = Array[CompareGt]{ CompareGt{ v: 3 }, CompareGt{ v: 8 }, CompareGt{ v: 2 } }
    gts.sort()
    assert(gts[0].v == 2 && gts[1].v == 3 && gts[2].v == 8)
}


fn assert_in_func() {
    assert(true)
}

test "Assert in function" {
    assert_in_func()
}

fn func_default_arg_value_test(v1: String, v2: String ("x"), v3: String) String {
    return v1 + "." + v2 + "." + v3
}

class FuncArgTestClass {
    fn test(v1: String, v2: String ("x"), v3: String) String {
        return v1 + "." + v2 + "." + v3
    }
    static fn test2(v1: String, v2: String ("x"), v3: String) String {
        return v1 + "." + v2 + "." + v3
    }
}

class GenericMethodTest {
    value: String

    fn get[T]() String {
        return this.value
    }
}

test "Func arg default value _" {
    let str = func_default_arg_value_test("1", _, "3")
    assert(str == "1.x.3")
    str = func_default_arg_value_test("1", "2", "3")
    assert(str == "1.2.3")
    // Class func
    let ob = FuncArgTestClass{}
    str = ob.test("1", _, "3")
    assert(str == "1.x.3")
    str = ob.test("1", "2", "3")
    assert(str == "1.2.3")
    // Static func
    str = FuncArgTestClass.test2("1", _, "3")
    assert(str == "1.x.3")
    str = FuncArgTestClass.test2("1", "2", "3")
    assert(str == "1.2.3")
}

fn func_garg(v1: $V1, v2: $V2) uint {
    #if V2.$is_nullable
    return v1.length
    #else
    return v1.length + v2.length
    #end
}

fn accept_nonnull(value: nonnull(?String)) String {
    return value
}

test "Nonnull type transformation" {
    let value: nonnull(?String) = "value"
    assert(accept_nonnull(value) == "value")

    let unchanged: nonnull(int) = 7
    assert(unchanged == 7)

    #if !typeof(value).$nonnull.$is_type_of(String)
    #error "Expected $nonnull to remove the nullable type layer"
    #end

    // `.$nonnull` also works in type position, on the whole prefix type
    let postfix: ?String.$nonnull = "postfix"
    assert(accept_nonnull(postfix) == "postfix")
    let items: Array[?String.$nonnull] = Array[String]{ "a" }
    assert(items.length == 1)
    #if !typeof(postfix).$is_type_of(String)
    #error "Expected ?String.$nonnull to be String"
    #end
}

test "Func generic arguments" {
    let len = func_garg("Hello", "World")
    assert(len == 10)
    let n : ?String = null
    len = func_garg("Valkow", n)
    assert(len == 6)
}

class GenericArgBox[T] {
    v: T
    fn get() T { return this.v }
}
fn func_garg_box(a: $T) GenericArgBox[T] { return GenericArgBox[T]{ v: a } }
fn func_garg_map(a: $T) Map[T] { return Map[T]{ "k" => a } }
fn func_garg_opt(a: $T, yes: bool) ?GenericArgBox[T] {
    if !yes : return null
    return GenericArgBox[T]{ v: a }
}

test "Func generic arguments in a generic return type" {
    // The base signature must not instantiate classes with the `$T` placeholder
    assert(func_garg_box(5).get() == 5)
    assert(func_garg_box("str").v == "str")
    assert((func_garg_map(7).get("k") !? 0) == 7)
    let missing = func_garg_opt(1, false)
    assert(!isset(missing))
    let found = func_garg_opt(2.5, true)
    assert(isset(found) && found.v == 2.5)
}

test "Func explicit generic instance method keeps its receiver" {
    let object = GenericMethodTest { value: "receiver" }
    assert(object.get[int]() == "receiver")
}

fn test_inline_rett() [u8 x 2] {
    return .{ 10, 20 }
}

test "Func inline return type" {
    let res = test_inline_rett()
    assert(res[0] == 10)
    assert(res[1] == 20)
}

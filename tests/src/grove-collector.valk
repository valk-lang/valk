@unsafe

use valk.gc

// Reads the shadow state, the pacing state and the mark stack
@ignore_access

global grove_rules_freed: uint
global grove_rules_x_freed: uint
global grove_rules_keep: ?GroveRuleNode
global grove_rules_list: ?Array[GroveRuleNode]

class GroveRuleNode {
    id: uint
    next: ?GroveRuleNode (null)
    other: ?GroveRuleNode (null)
    fn gc_free() {
        grove_rules_freed++
        if this.id == 42 : grove_rules_x_freed++
    }
}

// Garbage of earlier tests is freed first
fn grove_rules_reset() {
    grove_rules_keep = null
    grove_rules_list = null
    gc.collect()
    gc.collect()
    grove_rules_freed = 0
    grove_rules_x_freed = 0
}

fn grove_state(n: GroveRuleNode) uint {
    return gc.gcdata(n.@cast(ptr)).state()
}

// Two nodes in a list, each naming the other
fn grove_pair() $noinline {
    let list = Array[GroveRuleNode].new(2)
    let a = GroveRuleNode { id: 1 }
    let b = GroveRuleNode { id: 2 }
    a.other = b
    b.other = a
    list.append(a)
    list.append(b)
    grove_rules_list = list
}

fn grove_list_clear() $noinline {
    let list = grove_rules_list ?! return
    list.clear()
}

// A holder whose words name both nodes of the pair, stored after the pair is old
fn grove_pair_holder() $noinline {
    let list = grove_rules_list ?! return
    let a = list.get(0) !!
    let b = list.get(1) !!
    grove_rules_keep = GroveRuleNode { id: 3, next: a, other: b }
}

fn grove_kept_state(second: bool) uint $noinline {
    let e = grove_rules_keep ?! return 99
    let n = (second ? e.other : e.next) ?! return 99
    return grove_state(n)
}

synctest "Grove: a cycle through co-edges is freed in one collection" {
    grove_rules_reset()
    grove_pair()
    gc.collect()
    // Both nodes leave the list: the walk of each lowers the other's count to 0
    grove_list_clear()
    gc.collect()
    assert(grove_rules_freed == 2)
}

synctest "Grove: a garbage cycle of a CO_ROOT and its node is freed in one collection" {
    grove_rules_reset()
    grove_pair()
    gc.collect()
    grove_pair_holder()
    gc.collect()
    // The pair leaves the list; the holder's co-edges keep it: one node is a CO_ROOT now
    grove_list_clear()
    gc.collect()
    assert(grove_rules_freed == 0)
    assert(grove_kept_state(false) == gc.st_co_root)
    assert(grove_kept_state(true) == gc.st_owned)
    // Without the holder, the CO_ROOT, the node it owns and the holder go in one collection
    grove_rules_keep = null
    gc.collect()
    assert(grove_rules_freed == 3)
}

fn grove_kept_first() GroveRuleNode $noinline {
    let e = grove_rules_keep ?! panic("no holder")
    return e.next ?! panic("no node")
}

synctest "Grove: an on-stack CO_ROOT stays a CO_ROOT and survives its last co-edge" {
    grove_rules_reset()
    grove_pair()
    gc.collect()
    grove_pair_holder()
    gc.collect()
    grove_list_clear()
    gc.collect()
    let x = grove_kept_first()
    gc.collect()
    // A root object that is a CO_ROOT is not made the stack's (divergence (a))
    assert(grove_state(x) == gc.st_co_root)
    // The holder dies while x is on the stack: x becomes ROOT_OWNED, with its node
    grove_rules_keep = null
    gc.collect()
    assert(grove_rules_freed == 1)
    assert(grove_state(x) == gc.st_root_owned)
    assert(x.id == 1)
    let y = x.other ?! panic("no node")
    assert(y.id == 2)
}

// x (id 42) is owned by one node and co-owned by another; both die in one collection
fn grove_shared_child() $noinline {
    let x = GroveRuleNode { id: 42 }
    let a = GroveRuleNode { id: 1, next: x }
    let b = GroveRuleNode { id: 2, next: x }
    let list = Array[GroveRuleNode].new(2)
    list.append(a)
    list.append(b)
    grove_rules_list = list
}

synctest "Grove: a finalizable object reached twice in one collection runs its finalizer once" {
    grove_rules_reset()
    grove_shared_child()
    gc.collect()
    grove_list_clear()
    gc.collect()
    assert(grove_rules_freed == 3)
    assert(grove_rules_x_freed == 1)
}

// A chain a -> b -> c in a list
fn grove_chain() $noinline {
    let c = GroveRuleNode { id: 3 }
    let b = GroveRuleNode { id: 2, next: c }
    let a = GroveRuleNode { id: 1, next: b }
    let list = Array[GroveRuleNode].new(2)
    list.append(a)
    grove_rules_list = list
}

// A holder of the chain's last node, stored after the chain is old: a co-edge
fn grove_chain_holder() $noinline {
    let list = grove_rules_list ?! return
    let a = list.get(0) !!
    let b = a.next ?! return
    grove_rules_keep = GroveRuleNode { id: 4, next: b.next }
}

synctest "Grove: the walk keeps the tail of a chain that a live holder still names" {
    grove_rules_reset()
    grove_chain()
    gc.collect()
    grove_chain_holder()
    gc.collect()
    grove_list_clear()
    gc.collect()
    // a and b die; c is re-owned as a CO_ROOT through the holder (dead()'s RL test)
    assert(grove_rules_freed == 2)
    assert(grove_kept_state(false) == gc.st_co_root)
    grove_rules_keep = null
    gc.collect()
    assert(grove_rules_freed == 4)
}

fn grove_wide_list(count: uint) $noinline {
    let list = Array[GroveRuleNode].new(count)
    let i: uint = 0
    while i < count {
        list.append(GroveRuleNode { id: i })
        i++
    }
    grove_rules_list = list
}

synctest "Grove: a large array is marked and walked in work items of 256 words" {
    grove_rules_reset()
    // A fresh stack: deep graphs of earlier tests grew the old one. The array is young until
    // the collection that marks it (it fits the young budget), so marking reaches its 10 000
    // elements from the storage alone
    gc.gc.mark_list = gc.Lifo.new()
    grove_wide_list(10_000)
    gc.collect()
    grove_rules_list = null
    gc.collect()
    assert(grove_rules_freed == 10_000)
    // One work item's children at a time, not 10 000 slots
    assert(gc.gc.mark_list.size < 4096)
}

fn grove_pacing_is(live: uint, young: uint, allocated: uint, b: uint, h: uint) bool {
    let pb, ph = gc.pacing(live, young, allocated)
    return pb == b && ph == h
}

synctest "Grove: pacing follows the live bytes and the survival ratio" {
    let kib: uint = 1024
    let mib: uint = 1024 * 1024
    // Nothing live: the smallest budget; H two budgets and a block
    assert(grove_pacing_is(0, 0, 0, 512 * kib, mib + 32 * kib))
    // Everything survives (s = 1): B = 1 MiB / s, H = 1.5 B
    assert(grove_pacing_is(4 * mib, mib, mib, mib, 3 * mib / 2))
    // s = 0.5: B = 2 MiB, still H = 1.5 B
    assert(grove_pacing_is(16 * mib, mib, 2 * mib, 2 * mib, 3 * mib))
    // s = 1/8: B = 8 MiB; H = 1.25 L
    assert(grove_pacing_is(16 * mib, mib, 8 * mib, 8 * mib, 20 * mib))
    // Almost nothing survives: B is L / 2 up to 8 MiB, H at most 64 MiB
    assert(grove_pacing_is(6 * mib, 0, 4 * mib, 3 * mib, 15 * mib / 2))
    assert(grove_pacing_is(100 * mib, 0, 8 * mib, 8 * mib, 64 * mib))
    // A small heap: H stays at 2 B + 32 KiB
    assert(grove_pacing_is(512 * kib, 0, mib, 512 * kib, mib + 32 * kib))
}

// Short chains that are dropped right away
fn grove_garbage(bytes: uint) $noinline {
    let made: uint = 0
    while made < bytes {
        let head = GroveRuleNode { id: 0 }
        let i = 0
        while i++ < 16 : head = GroveRuleNode { id: 0, next: head }
        made += 17 * size_of(GroveRuleNode)
    }
}

// Forced collections (GC_STRESS) replace the cycles being measured
#if !GC_STRESS
synctest "Grove: collections come at the young budget, which follows the survivors" {
    grove_rules_reset()
    gc.collect()
    assert(gc.gc.mem_new == 0)
    // Everything allocated survives: the budget is about 1 MiB of survivors. The list crosses
    // the budget whatever the live heap the earlier tests left
    let count = gc.gc.mem_trigger / 16
    if count < 100_000 : count = 100_000
    grove_wide_list(count)
    assert(gc.gc.mem_trigger >= 512 * 1024 && gc.gc.mem_trigger <= 2 * 1024 * 1024)
    assert(gc.gc.mem_limit == gc.gc.mem_trigger / 2 * 3)
    // Almost nothing survives: half the live heap
    let before = gc.gc.collect_count
    grove_garbage(16 * 1024 * 1024)
    assert(gc.gc.collect_count > before)
    let half = gc.gc.mem_marked / 2
    assert(gc.gc.mem_trigger == (half > 512 * 1024 ? half : 512 * 1024))
    // The idle point collects at three quarters of the budget
    gc.collect()
    before = gc.gc.collect_count
    gc.collect_if_threshold_almost_reached()
    assert(gc.gc.collect_count == before)
    gc.gc.mem_new = gc.gc.mem_trigger / 4 * 3
    gc.collect_if_threshold_almost_reached()
    assert(gc.gc.collect_count == before + 1)
    assert(gc.gc.mem_new == 0)
    grove_rules_list = null
}
#end

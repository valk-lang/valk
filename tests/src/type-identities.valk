use type_identity_left
use type_identity_right

union QualifiedInlineIdentity : type_identity_left.SameName | type_identity_right.SameName {}
union QualifiedErrorIdentity : fn()(!type_identity_left.SameError) | fn()(!type_identity_right.SameError) {}

test "Type identity includes namespaces" {
    let left: QualifiedInlineIdentity = type_identity_left.SameName{ value: 7 }
    let right: QualifiedInlineIdentity = type_identity_right.SameName{ value: 8 }
    assert(left == left)
    assert(right == right)
}

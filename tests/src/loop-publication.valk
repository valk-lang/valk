class LoopPublicationItem { number: int }
class LoopPublicationSteps {
    number: int (73)
    fn _next(index: uint) int !IterError {
        if index >= 2 : throw .end
        this.number++
        return this.number
    }
}
fn loop_publish_return() shared LoopPublicationSteps {
    let source = LoopPublicationSteps {}
    each source as value : return source
    panic("empty")
}

test "Loop publication: a fresh replacement starts the next iteration" {
    let source = LoopPublicationItem { number: 7 }
    let total = 0
    let index = 0
    while index++ < 3 {
        source.number++
        let published: shared LoopPublicationItem = source
        total += published.number
        source = LoopPublicationItem { number: 11 }
    }
    assert(total == 32 && source.number == 11)
}

test "Loop publication: loop-local graphs are fresh on every iteration" {
    let total = 0
    let index = 0
    while index++ < 3 {
        let source = LoopPublicationItem { number: index }
        let published: shared LoopPublicationItem = source
        total += published.number
    }
    assert(total == 6)
}

test "Loop publication: break and return end the iterator borrow" {
    let source = LoopPublicationSteps {}
    let total = 0
    each source as value {
        let published: shared LoopPublicationSteps = source
        total += published.number
        break
    }
    assert(total == 74)
    let returned = loop_publish_return()
    assert(returned.number == 74)
}

test "Loop publication: an exiting branch does not reach the next iteration" {
    let source = LoopPublicationSteps {}
    let count = 0
    each source as value, index {
        count++
        if index == 1 {
            let published: shared LoopPublicationSteps = source
            assert(published.number == 75)
            break
        }
    }
    assert(count == 2)
}

test "Loop publication: replacing the source does not replace the saved iterator" {
    let source = LoopPublicationSteps {}
    let total = 0
    each source as value {
        source = LoopPublicationSteps { number: 97 }
        let published: shared LoopPublicationSteps = source
        assert(published.number == 97)
        total += value
    }
    assert(total == 149)
}

shared loop_publication_saved: ?LoopPublicationItem (null)

test "Loop publication: a shared global store may precede break" {
    let source = LoopPublicationItem { number: 101 }
    while true {
        loop_publication_saved = source
        break
    }
    let saved = loop_publication_saved ?? panic("missing")
    assert(saved.number == 101)
    loop_publication_saved = null
}

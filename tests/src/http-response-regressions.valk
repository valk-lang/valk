use valk.http
use valk.net
use valk.time

fn audit_response_server(server: shared net.SocketServer, response: String, split: uint) {
    let connection = server.accept(2000) ! { assert(false); return }
    let buffer = [u8]{ 0 x 4096 }
    connection.read(buffer) ! { assert(false); return }
    if split > 0 {
        connection.write(response.range(0, split)) ! assert(false)
        time.sleep_ms(20)
        connection.write(response.view(split, response.bytes - split)) ! assert(false)
    } else {
        connection.write(response) ! assert(false)
    }
    connection.close() ! assert(false)
}

fn audit_response(port: u16, response: String, split: uint (0), method: String ("GET"), options: ?http.Options (null)) ?http.ClientResponse {
    let server = net.Socket.server(net.SocketType.tcp, "127.0.0.1", port) ! { assert(false); return null }
    let running = co audit_response_server(server, response, split)
    let result = http.request(method, "http://127.0.0.1:" + port + "/", options ?? http.Options { timeout_ms: 2000 }) !? null
    await running
    server.close() ! assert(false)
    return result
}

test "audit: fragmented informational responses preserve streamed output" {
    let output = ByteBuffer.new()
    let response = audit_response(19347,
        "HTTP/1.1 103 Early Hints\r\nLink: </early>\r\n\r\nHTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nX-Final: yes\r\n\r\n2\r\nok\r\n0\r\n\r\n",
        44, "GET", http.Options { output: output, timeout_ms: 2000 })
    assert(isset(response))
    if !isset(response) : return
    assert(response.status == 200)
    assert(output.to_string() == "ok")
    assert((response.headers.get("X-Final") !? "") == "yes")
    assert((response.headers.get("Link") !? "") == "")
}

test "audit: informational responses preserve HEAD semantics" {
    let response = audit_response(19348,
        "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 999\r\n\r\n", 25, "HEAD")
    assert(isset(response))
    if !isset(response) : return
    assert(response.status == 200)
    assert(response.body == "")
}

test "audit: informational response without final response fails" {
    assert(!isset(audit_response(19349, "HTTP/1.1 100 Continue\r\n\r\n")))
}

test "audit: status CRLF can cross receive boundaries" {
    let response = audit_response(19350, "HTTP/1.0 200 OK\r\nContent-Length: 2\r\n\r\nok", 16)
    assert(isset(response))
    if !isset(response) : return
    assert(response.status == 200)
    assert(response.body == "ok")
}

test "audit: status codes and reason phrases reject malformed bytes" {
    assert(!isset(audit_response(19351, "HTTP/1.1 20 OK\r\nContent-Length: 0\r\n\r\n")))
    assert(!isset(audit_response(19352, "HTTP/1.1 2x0 OK\r\nContent-Length: 0\r\n\r\n")))
    assert(!isset(audit_response(19353, "HTTP/1.1 099 Bad\r\nContent-Length: 0\r\n\r\n")))
    assert(!isset(audit_response(19354, "HTTP/1.1 200 Bad\nReason\r\nContent-Length: 0\r\n\r\n")))
}

test "audit: protocol switching is not skipped as an interim response" {
    let response = audit_response(19355, "HTTP/1.1 101 Switching Protocols\r\nConnection: upgrade\r\nUpgrade: test\r\n\r\n")
    assert(isset(response))
    if isset(response) : assert(response.status == 101)
}

test "audit: informational responses precede the final response" {
    let response = audit_response(19342, "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
    assert(isset(response))
    if !isset(response) : return
    assert(response.status == 200)
    assert(response.body == "ok")
}

test "audit: malformed response status lines are rejected" {
    assert(!isset(audit_response(19343, "NOTHTTP 200 OK\r\nContent-Length: 0\r\n\r\n")))
    assert(!isset(audit_response(19344, "HTTP/1.1 200 OK\rXContent-Length: 0\r\n\r\n")))
    assert(!isset(audit_response(19345, "HTTP/1.1 2000 OK\r\nContent-Length: 0\r\n\r\n")))
}

test "audit: ordinary final responses still work" {
    let response = audit_response(19346, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
    assert(isset(response))
    if !isset(response) : return
    assert(response.status == 200)
    assert(response.body == "ok")
}

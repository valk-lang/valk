use valk.http
use valk.net

fn pipelining_handler(req: http.Request) http.Response {
    return http.Response.text("[" + req.path + "|" + req.query_string + "]")
}

fn pipelining_server() {
    let server = http.Server.new("127.0.0.1", 9028, pipelining_handler) ! return
    server.start(1)
}

test "HTTP: pipelined requests keep their own query strings" {
    co pipelining_server()

    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9028) ! {
        assert(false)
        return
    }
    connection.write("GET /first HTTP/1.1\r\nHost: localhost\r\n\r\nGET /second?a=1 HTTP/1.1\r\nHost: localhost\r\n\r\nGET /third? HTTP/1.1\r\nHost: localhost\r\n\r\n") ! {
        assert(false)
        return
    }

    let response = ByteBuffer.new(1024)
    let chunk = Slice[u8].new(1024, 0)
    let reads = 0
    while !response.to_string().contains("[/third|]") && reads++ < 10 {
        let received = connection.read(chunk) ! break
        response.write(chunk.view(0, received))
    }
    connection.close() ! {}

    let text = response.to_string()
    assert(text.contains("[/first|]"))
    assert(text.contains("[/second|a=1]"))
    assert(text.contains("[/third|]"))
}

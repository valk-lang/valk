use valk.http
use valk.net
use valk.time

fn pipelining_handler(req: http.Request) http.Response {
    return http.Response.text("[" + req.path + "|" + req.query_string + "]")
}

fn pipelining_server() http.Server {
    let server = http.Server.new("127.0.0.1", 9028, pipelining_handler)
    return server
}

test "HTTP: pipelined requests keep their own query strings" {
    let server = pipelining_server()
    let server_running = co server.start(1)
    defer stop_http_test_server(server, server_running)

    let connection = net.tcp_client("127.0.0.1", 9028) ! {
        assert(false)
        return
    }
    connection.write("GET /first HTTP/1.1\r\nHost: localhost\r\n\r\nGET /second?a=1 HTTP/1.1\r\nHost: localhost\r\n\r\nGET /third? HTTP/1.1\r\nHost: localhost\r\n\r\n") ! {
        assert(false)
        return
    }

    let response = ByteBuffer.new(1024)
    let chunk = [u8]{ 0 x 1024 }
    let reads = 0
    while !response.to_string().contains("[/third|]") && reads++ < 10 {
        let received = connection.read(chunk) ! break
        response.write(chunk.view(0, received))
    }
    connection.close() ! {}

    let text = response.to_string()
    assert(text.contains("[/first|]"))
    assert(text.contains("[/second|a=1]"))
    assert(text.contains("[/third|]"))
}

fn keep_alive_size_handler(req: http.Request) http.Response {
    let size = req.path.range(1, req.path.bytes - 1).to_uint() !? 0
    return http.Response.text("".pad_right('x', size))
}

// Reads one response with a `Content-Length` body from `connection`; "" when it fails
fn keep_alive_read_response(connection: net.TcpConnection, input: ByteBuffer) String {
    let chunk = [u8]{ 0 x 4096 }
    while true {
        let text = input.to_string()
        let head_end = text.index_of("\r\n\r\n") !? 0
        if head_end > 0 {
            let length_at = (text.index_of("Content-Length: ") ! return "") + 16
            let line_end = text.index_of("\r\n", length_at) ! return ""
            let length = text.range(length_at, line_end - length_at).to_uint() ! return ""
            let total = head_end + 4 + length
            if text.bytes >= total {
                input.clear_until(total)
                return text.range(head_end + 4, length)
            }
        }
        let received = connection.read(chunk) ! return ""
        input.write(chunk.view(0, received))
    }
    return ""
}

test "HTTP: a keep-alive connection answers small and large responses in turn" {
    let server = http.Server.new("127.0.0.1", 19632, keep_alive_size_handler)
    let server_running = co server.start(1)
    defer stop_http_test_server(server, server_running)

    let connection = net.tcp_client("127.0.0.1", 19632) !!
    let input = ByteBuffer.new(4096)
    // Small answers go out with the server's next read, large ones on their own
    let sizes = Array[uint]{ 5, 16384, 16385, 0, 300000, 7, 1, 20000, 3 }
    each sizes as size {
        connection.write("GET /" + size + " HTTP/1.1\r\nHost: localhost\r\n\r\n") !!
        let body = keep_alive_read_response(connection, input)
        assert(body.bytes == size)
    }
    // A client that sends its last request and closes still gets the answer
    connection.write("GET /11 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n") !!
    assert(keep_alive_read_response(connection, input).bytes == 11)
    connection.close() _
}

global kept_request_path: ?&[u8] (null)

fn keep_path_handler(ctx: http.Context, res: http.ResponseWriter) {
    // Keeping a view past the handler is not allowed by the docs, but must never show
    // another connection's request
    if !isset(kept_request_path) : kept_request_path = ctx.path
    res.send("ok", 200, "text/plain")
}

test "HTTP: a parked connection's request bytes are not reused by another connection" {
    let server = http.Server.new("127.0.0.1", 18732)
    server.fast(keep_path_handler)
    let running = co server.start(1)
    defer stop_http_test_server(server, running)
    time.sleep_ms(20)

    let first = net.tcp_client("127.0.0.1", 18732) !!
    let first_input = ByteBuffer.new(256)
    first.write("GET /secret-of-the-first-client HTTP/1.1\r\nHost: localhost\r\n\r\n") !!
    assert(keep_alive_read_response(first, first_input) == "ok")
    // The first connection now waits for its next request, parked
    time.sleep_ms(30)

    let second = net.tcp_client("127.0.0.1", 18732) !!
    let second_input = ByteBuffer.new(256)
    each 0 .. 3 {
        second.write("GET /zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz HTTP/1.1\r\nHost: localhost\r\n\r\n") !!
        assert(keep_alive_read_response(second, second_input) == "ok")
        time.sleep_ms(10)
    }
    let kept = kept_request_path ?! panic("no view kept")
    assert(kept.to_string() == "/secret-of-the-first-client")
    first.close() _
    second.close() _
    kept_request_path = null
}

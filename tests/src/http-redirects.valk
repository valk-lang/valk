use valk.http

fn redirect_echo(req: http.Request) http.Response {
    let headers = req.headers()
    return http.Response.text(req.method + "|" + req.body + "|" + req.query_string
        + "|" + (headers.get("authorization") !? "")
        + "|" + (headers.get("proxy-authorization") !? "")
        + "|" + (headers.get("cookie") !? "")
        + "|" + (headers.get("content-type") !? "")
        + "|" + (headers.get("x-safe") !? ""))
}

fn redirect_origin_handler(req: http.Request) http.Response {
    if req.path == "/echo" : return redirect_echo(req)
    if req.path == "/loop" : return http.Response.redirect("/loop", 301)
    if req.path == "/limited" : return http.Response.redirect("/limited-body", 302)
    if req.path == "/limited-body" : return http.Response.text("hello")
    if req.path == "/cross" : return http.Response.redirect("http://127.0.0.1:9041/echo", 302)
    if req.path == "/relative/start" : return http.Response.redirect("../echo", 302)
    if req.path == "/without-location" : return http.Response.empty(302)
    if req.path.starts_with("/status/") {
        let status = req.path.part(8, req.path.bytes - 8).to_uint() !? 0
        return http.Response.redirect("/echo", status.to(u32))
    }
    return http.Response.empty(404)
}

fn redirect_target_handler(req: http.Request) http.Response {
    if req.path == "/echo" : return redirect_echo(req)
    return http.Response.empty(404)
}

fn redirect_origin_server() {
    let server = http.Server.new("127.0.0.1", 9040, redirect_origin_handler)
    server.start(1) ! return
}

fn redirect_target_server() {
    let server = http.Server.new("127.0.0.1", 9041, redirect_target_handler)
    server.start(1) ! return
}

test "HTTP client redirects are bounded and origin-safe" {
    co redirect_origin_server()
    co redirect_target_server()

    let base = "http://127.0.0.1:9040"
    assert(http.Options {}.max_redirects == 10)
    let loop_failed = false
    http.request("GET", base + "/loop", http.Options { max_redirects: 2 }) ! {
        loop_failed = E.code == E.too_many_redirects
    }
    assert(loop_failed)

    let response_limit_preserved = false
    http.request("GET", base + "/limited", http.Options { max_response_body_size: 4 }) ! {
        response_limit_preserved = E.code == E.response_too_large
    }
    assert(response_limit_preserved)

    let not_followed = http.request("GET", base + "/loop", http.Options {
        follow_redirects: false
    }) ! panic("redirect opt-out failed")
    assert(not_followed.status == 301)

    let missing_location = http.request("GET", base + "/without-location") ! panic("missing Location failed")
    assert(missing_location.status == 302)

    let same_origin = http.request("GET", base + "/status/302", http.Options {
        headers: Map[String]{
            "Authorization" => "same-auth"
            "Cookie" => "same-cookie"
            "X-Safe" => "same-safe"
        }
    }) ! panic("same-origin redirect failed")
    assert(same_origin.body == "GET|||same-auth||same-cookie||same-safe")

    let cross_origin = http.request("GET", base + "/cross", http.Options {
        headers: Map[String]{
            "Authorization" => "secret-auth"
            "Proxy-Authorization" => "secret-proxy"
            "Cookie" => "secret-cookie"
            "X-Safe" => "safe"
        }
    }) ! panic("cross-origin redirect failed")
    assert(cross_origin.body == "GET|||||||safe")

    let moved = http.request("POST", base + "/status/301", http.Options {
        body: "payload"
        headers: Map[String]{ "Content-Type" => "text/plain" }
    }) ! panic("301 redirect failed")
    assert(moved.body == "GET|||||||")

    let found = http.request("POST", base + "/status/302", http.Options { body: "payload" }) ! panic("302 redirect failed")
    assert(found.body == "GET|||||||")

    let see_other = http.request("PUT", base + "/status/303", http.Options { body: "payload" }) ! panic("303 redirect failed")
    assert(see_other.body == "GET|||||||")

    let temporary = http.request("POST", base + "/status/307", http.Options {
        body: "payload"
        headers: Map[String]{ "Content-Type" => "text/plain" }
    }) ! panic("307 redirect failed")
    assert(temporary.body == "POST|payload|||||text/plain|")

    let permanent = http.request("PUT", base + "/status/308", http.Options { body: "payload" }) ! panic("308 redirect failed")
    assert(permanent.body == "PUT|payload||||||")

    let relative = http.request("GET", base + "/relative/start", http.Options {
        query_data: Map[String]{ "original" => "only" }
    }) ! panic("relative redirect failed")
    assert(relative.body == "GET|||||||")
}

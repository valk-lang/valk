use valk.math

value TERNARY_LITERAL_SCALE (2.5)

fn ternary_literal_i32(v: i32) i32 { return v }
fn ternary_literal_f32(v: f32) f32 { return v }

test "Ternary: a literal takes the type of the other side" {
    let n: i32 = 5
    let x: f32 = 1.5
    let small: u8 = 200
    let yes = n > 2
    let no = n < 2

    let a = yes ? 0 : n
    let b = no ? 0 : n
    assert(ternary_literal_i32(a) == 0 && ternary_literal_i32(b) == 5)
    let c = no ? n : -1
    assert(ternary_literal_i32(c) == -1)
    let d = yes ? 1 : x
    assert(ternary_literal_f32(d) == 1)
    let e = no ? TERNARY_LITERAL_SCALE : x
    assert(ternary_literal_f32(e) == 1.5)
    let f = yes ? small : 255
    assert(f + 55 == 255)

    let maybe: ?i32 = null
    let g = yes ? 7 : maybe
    let h = no ? maybe : 9
    let typed: ?i32 = g
    assert((typed ?? 0) == 7 && (h ?? 0) == 9)

    // A literal the other side cannot hold: the closest type that holds both
    let above = yes ? 300 : small
    let as_u16: u16 = above
    assert(as_u16 == 300)
    let other = no ? small : 300
    let other_u16: u16 = other
    assert(other_u16 == 300)
    let below = yes ? -1 : small
    let as_i16: i16 = below
    assert(as_i16 == -1)
    let maybe_small: ?u8 = null
    let wide_or_null = no ? maybe_small : 300
    let nullable_u16: ?u16 = wide_or_null
    assert((nullable_u16 ?? 0) == 300)
    // No integer type holds -1 and every u64: the literal's own type
    let huge: u64 = 5
    let first = yes ? -1 : huge
    let second = no ? huge : -1
    let first_int: int = first
    let second_int: int = second
    assert(first_int == -1 && second_int == -1)
    let half = yes ? 0.5 : n
    let as_float: float = half
    assert(as_float == 0.5)

    // Two literals keep the default types
    let both = yes ? 3 : 4
    let wide: int = both
    assert(wide == 3)
}

value TERNARY_LITERAL_GRAVITY (28.0)
value TERNARY_LITERAL_STEP (0.25)

test "A 'value' constant written as a number is typed like that number" {
    let dt: f32 = 0.5
    let fall = TERNARY_LITERAL_GRAVITY * dt
    assert(ternary_literal_f32(fall) == 14)
    assert(ternary_literal_f32(TERNARY_LITERAL_GRAVITY * TERNARY_LITERAL_STEP * dt) == 3.5)
    let fast = dt > 1
    let speed = fast ? TERNARY_LITERAL_GRAVITY : dt
    assert(ternary_literal_f32(speed) == 0.5)
    // Without another type it is a float, like the literal
    let plain = TERNARY_LITERAL_GRAVITY
    let wide: float = plain
    assert(wide == 28)
}

test "A 'value' constant from another namespace is typed like its number too" {
    let half = math.PI / 2
    assert(ternary_literal_f32(math.PI / 2) > 1.57 && ternary_literal_f32(math.PI / 2) < 1.58)
    let angle: f32 = 0.5
    let turned = angle + math.TAU * 0.25
    assert(ternary_literal_f32(turned) > 2.07 && ternary_literal_f32(turned) < 2.08)
    // Without another type it stays a float
    let wide: float = half
    assert(wide > 1.57 && wide < 1.58)
}

// `-` declarations and writes to `~` declarations remain available in their
// own source file.
class AccessLocal {
    - secret: uint (7)
    ~ count: uint (3)
    + open: uint (1)

    - fn hidden() uint {
        return this.secret
    }
}

- fn access_private_func() uint {
    return 42
}

- global access_private_global : uint (5)

test "Access: source markers allow their declaring source" {
    let l = AccessLocal{ secret: 8 }
    assert(l.secret == 8)
    assert("%{l.secret}" == "8")
    assert(l.hidden() == 8)
    assert(l.open == 1)

    // `~` is writable in the source file that declared it.
    l.count = 9
    assert(l.count == 9)

    assert(access_private_func() == 42)
    assert(access_private_global == 5)
}

test "Access: package and public reads work across sources" {
    let value = AccessOtherSource {}
    value.package_value = 11
    value.public_value = 13
    value.namespace_value = 15
    value.namespace_readonly_value = 16
    value.package_readonly_value = 18
    assert(value.package_value == 11)
    assert(value.readonly_value == 3)
    assert(value.public_value == 13)
    assert(value.namespace_value == 15)
    assert(value.namespace_readonly_value == 16)
    assert(value.namespace_readonly_private_value == 7)
    assert(value.package_readonly_value == 18)

    assert(access_namespace_function() == 17)
    access_namespace_global = 20
    assert(access_namespace_global == 20)
}

test "Access: reading a '~' member of another package" {
    // A `~` declaration remains readable from every source and package.
    let a = Array[uint]{}
    a.append(1)
    assert(a.cap >= a.length)
}

use valk.url

// Every expectation in this file was taken from an independent parser
// (python3 urllib.parse.urlsplit), which follows RFC 3986 appendix B.

test "URL: parse splits components on the first delimiter" {
    // '?' ends the authority even when no '/' was seen yet. This used to put the
    // query into .host, so any allow-list built on .host was attacker-influenced.
    let a = url.parse("http://example.com?a=b/c")
    assert(a.scheme == "http")
    assert(a.host == "example.com")
    assert(a.path == "")
    assert(a.query == "a=b/c")
    assert(a.fragment == "")

    let b = url.parse("http://example.com?x")
    assert(b.host == "example.com")
    assert(b.query == "x")

    // A '?' inside the path is only a query separator once the authority is over.
    let c = url.parse("http://h/a/b?c/d=e")
    assert(c.host == "h")
    assert(c.path == "/a/b")
    assert(c.query == "c/d=e")
}

test "URL: parse extracts the fragment" {
    let a = url.parse("http://h/p#frag")
    assert(a.path == "/p")
    assert(a.fragment == "frag")

    // Only the FIRST '#' starts the fragment; the rest of it is opaque data.
    let b = url.parse("http://h/a?q=1#f#extra")
    assert(b.path == "/a")
    assert(b.query == "q=1")
    assert(b.fragment == "f#extra")
    assert(url.parse("http://h/p##x").fragment == "#x")

    // The classic parser-differential attack: everything from the '#' on must not be
    // read as part of the authority.
    let c = url.parse("http://evil.com#@good.com/")
    assert(c.host == "evil.com")
    assert(c.path == "")
    assert(c.fragment == "@good.com/")
    let d = url.parse("http://evil.com?@good.com/")
    assert(d.host == "evil.com")
    assert(d.query == "@good.com/")

    // A fragment is never a query, and a query is never part of a fragment.
    assert(url.parse("#only-frag").fragment == "only-frag")
    assert(url.parse("#only-frag").path == "")
    assert(url.parse("?only=query").query == "only=query")
    assert(url.parse("?only=query").path == "")
}

test "URL: parse scheme" {
    // ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ) — '+', '-', '.' and digits are legal.
    assert(url.parse("svn+ssh://host/x").scheme == "svn+ssh")
    assert(url.parse("x-c:foo").scheme == "x-c")
    assert(url.parse("a1://h/p").scheme == "a1")
    assert(url.parse("a.b://h/p").scheme == "a.b")
    // A scheme must start with a letter, so this is a path.
    let not_scheme = url.parse("1http://h/p")
    assert(not_scheme.scheme == "")
    assert(not_scheme.path == "1http://h/p")
    assert(not_scheme.host == "")
    // A ':' that only appears after a '/' is not a scheme either.
    let path_colon = url.parse("/a:b/c")
    assert(path_colon.scheme == "")
    assert(path_colon.path == "/a:b/c")
    // Schemes are case-insensitive and are stored lowercased, so `HTTPS://` still
    // compares equal to "https" for a caller picking a port or TLS.
    let up = url.parse("HTTPS://Example.COM/A?b#c")
    assert(up.scheme == "https")
    assert(up.host == "Example.COM")
    assert(up.path == "/A")
    assert(up.query == "b")
    assert(up.fragment == "c")
    // A scheme without "//" is hierarchical-less: everything after it is the path.
    assert(url.parse("mailto:someone@example.com").scheme == "mailto")
    assert(url.parse("mailto:someone@example.com").path == "someone@example.com")
    assert(url.parse("tel:+1-555").path == "+1-555")
    assert(url.parse("urn:isbn:0451450523").path == "isbn:0451450523")
    assert(url.parse("data:text/plain,hello").path == "text/plain,hello")
    // A trailing ':' with nothing after it still is a scheme.
    assert(url.parse("http:").scheme == "http")
    assert(url.parse("http:").path == "")
}

test "URL: parse authority for every scheme" {
    // Only http/https used to get an authority, so ftp://host/p?q=1 put "?q=1" in the
    // path and left .host empty.
    let ftp = url.parse("ftp://host/p?q=1")
    assert(ftp.scheme == "ftp")
    assert(ftp.host == "host")
    assert(ftp.path == "/p")
    assert(ftp.query == "q=1")
    assert(url.parse("svn://h/x").host == "h")
    assert(url.parse("h://x").host == "x")
    assert(url.parse("h://x").path == "")
    // The authority keeps userinfo and port as-is; splitting those off is the
    // caller's job (http.ClientRequest does exactly that).
    let auth = url.parse("http://user:pass@host:8080/a?b#c")
    assert(auth.host == "user:pass@host:8080")
    assert(auth.path == "/a")
    assert(auth.query == "b")
    assert(auth.fragment == "c")
    // A protocol-relative reference has an authority but no scheme, and one slash is
    // not an authority at all.
    let relative = url.parse("//host/path")
    assert(relative.scheme == "")
    assert(relative.host == "host")
    assert(relative.path == "/path")
    let one_slash = url.parse("http:/noslash.example/x")
    assert(one_slash.scheme == "http")
    assert(one_slash.host == "")
    assert(one_slash.path == "/noslash.example/x")
    // An empty authority.
    let empty_auth = url.parse("http://")
    assert(empty_auth.host == "")
    assert(empty_auth.path == "")
    // file:/// has an empty authority, not a host of "/".
    let file_url = url.parse("file:///c:/x")
    assert(file_url.scheme == "file")
    assert(file_url.host == "")
    assert(file_url.path == "/c:/x")
}

test "URL: parse of nothing" {
    let empty = url.parse("")
    assert(empty.scheme == "")
    assert(empty.host == "")
    assert(empty.path == "")
    assert(empty.query == "")
    assert(empty.fragment == "")
    // No scheme and no leading slash is just a path.
    let plain = url.parse("not a url at all")
    assert(plain.path == "not a url at all")
    assert(plain.host == "")
    let rel = url.parse("/relative?x=1")
    assert(rel.path == "/relative")
    assert(rel.query == "x=1")
    assert(rel.host == "")
}

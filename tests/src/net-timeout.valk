use valk.net
use valk.time
use valk.http

fn net_timeout_server() {
    let server = net.Socket.server(net.SocketType.tcp, "127.0.0.1", 9021) ! return
    let connection = server.accept() ! return
    time.sleep_ms(100)
    connection.close() ! assert(false)
    server.close() ! assert(false)
}

fn http_timeout_server() {
    let server = net.Socket.server(net.SocketType.tcp, "127.0.0.1", 9022) ! return
    let connection = server.accept() ! return
    time.sleep_ms(100)
    connection.close() ! assert(false)
    server.close() ! assert(false)
}

fn send_slice_server() {
    let server = net.Socket.server(net.SocketType.tcp, "127.0.0.1", 9034) ! return
    let connection = server.accept() ! return
    time.sleep_ms(100)
    connection.close() ! assert(false)
    server.close() ! assert(false)
}

fn net_eof_server() {
    let server = net.Socket.server(net.SocketType.tcp, "127.0.0.1", 9047) ! return
    let connection = server.accept() ! return
    connection.close() ! assert(false)
    server.close() ! assert(false)
}

test "Network reads time out without closing the coroutine thread" {
    co net_timeout_server()

    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9021) ! {
        assert(false)
        return
    }
    let buffer = ByteBuffer.new(16)
    let timed_out = false
    #if OS == "linux"
    assert(connection.is_non_block_for_test())
    #end
    assert(connection.read_timeout_ms == 5000)
    assert(connection.write_timeout_ms == 5000)
    connection.read_timeout_ms = 20
    connection.recv(buffer, 1) ! {
        timed_out = error_is(E.code, timeout)
    }
    connection.close() ! assert(false)

    assert(timed_out)
}

test "Network operation timeouts default to five seconds and HTTP requests to ten" {
    let options = http.Options {}
    assert(options.connect_timeout_ms == 5000)
    assert(options.read_timeout_ms == 5000)
    assert(options.write_timeout_ms == 5000)
    assert(options.timeout_ms == 10_000)
}

test "Network send accepts bounded byte slices" {
    co send_slice_server()

    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9034) ! {
        assert(false)
        return
    }
    let buffer = ByteBuffer.new()
    buffer.write("safe")
    assert((connection.send("", false) !? 99) == 0)
    assert((connection.send(buffer.view(1, 3)) !? 99) == 3)
    connection.close() ! assert(false)
}

test "Network recv reports orderly EOF as zero bytes" {
    co net_eof_server()

    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9047) ! {
        assert(false)
        return
    }
    let buffer = ByteBuffer.new()
    let received = connection.recv(buffer, 1) ! {
        assert(false)
        return
    }
    assert(received == 0)
    connection.close() ! assert(false)
}

#if OS == "linux"
test "Linux accept preserves file descriptor exhaustion" {
    net.accept_completion_result_for_test(0 - 24) ! {
        assert(error_is(E.code, max_connections))
    }
    net.accept_completion_result_for_test(0 - 23) ! {
        assert(error_is(E.code, max_connections))
    }
    net.accept_completion_result_for_test(0 - 12) ! {
        assert(error_is(E.code, init))
    }
}
#end

test "HTTP reports network inactivity as a timeout" {
    co http_timeout_server()

    let timed_out = false
    http.request("GET", "http://127.0.0.1:9022/", http.Options {
        read_timeout_ms: 20
        timeout_ms: 50
    }) ! {
        timed_out = error_is(E.code, timeout)
    }
    assert(timed_out)
}

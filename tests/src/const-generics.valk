struct CgMarker {}

struct CgEmptyWithMethod {
    fn tag() int {
        return 19
    }
}

struct CgHolder {
    marker: CgMarker
    value: i32
}

class CgBox {
    marker: CgMarker
    value: i32
}

struct CgFixedBuf[T, const N: uint] {
    data: [T x N]

    fn cap() uint {
        return N
    }
}

extend CgFixedBuf[T, const N: uint] {
    fn doubled_cap() uint {
        return N * 2
    }
}

trait CgHasCap[const N: uint] {
    fn trait_cap() uint {
        return N
    }
}

class CgSizedBox {
    use CgHasCap[32]
    v: int (0)
}

class CgAdder[const BASE: uint] {
    fn plus[const EXTRA: uint](x: uint) uint {
        return BASE + EXTRA + x
    }
}

fn cg_format_val[const PRETTY: bool](x: $T) String {
    #if PRETTY
    return "pretty:" + x
    #else
    return "" + x
    #end
}

fn cg_scale[const FACTOR: i32](x: i32) i32 {
    return x * FACTOR
}

fn cg_tag[const LABEL: String]() String {
    return "[" + LABEL + "]"
}

fn cg_inner[const K: uint]() uint {
    #if K > 4
    return K * 10
    #else
    return K
    #end
}

fn cg_outer[const N: uint]() uint {
    return cg_inner[N + 1]()
}

fn cg_infer_cap[T, const N: uint](b: CgFixedBuf[T, N]) uint {
    return b.cap() + N
}

fn cg_pair_marker() (CgMarker, int) {
    return (CgMarker {}, 77)
}

fn cg_check_marker[M](x: int) int {
    #if M.$is_type_of(CgMarker)
    return x + 100
    #end
    return x
}

value CG_FOUR (4)

test "Const generics: bool, integers, String, #if, and $T inference" {
    assert(cg_format_val[true](42) == "pretty:42")
    assert(cg_format_val[false](42) == "42")
    assert(cg_format_val[true]("hi") == "pretty:hi")
    assert(cg_format_val[false]("hi") == "hi")
    assert(cg_scale[-3](5) == -15)
    assert(cg_scale[4](5) == 20)
    assert(cg_tag["valk"]() == "[valk]")
    assert(cg_outer[4]() == 50)
    assert(cg_outer[2]() == 3)
}

test "Const generics: structs, fixed arrays, extend, trait, methods, and inference" {
    let b1 = CgFixedBuf[i32, 4] { data: .{ 1, 2, 3, 4 } }
    let b2: CgFixedBuf[i32, 2 + 2] = b1
    let b3: CgFixedBuf[i32, CG_FOUR] = b2
    assert(b3.cap() == 4)
    assert(b3.doubled_cap() == 8)
    assert(cg_infer_cap(b3) == 8)
    assert(b3.data[0] == 1 && b3.data[3] == 4)
    assert(size_of(CgFixedBuf[i32, 4]) == 16)
    assert(size_of(CgFixedBuf[i32, 8]) == 32)

    let sb = CgSizedBox {}
    assert(sb.trait_cap() == 32)

    let adder = CgAdder[100] {}
    assert(adder.plus[20](3) == 123)
}

test "Empty zero-sized structs: layout, containers, unions, and markers" {
    assert(size_of(CgMarker) == 0)
    assert(size_of(CgHolder) == 4)

    let m1 = CgMarker {}
    let m2 = CgMarker {}
    assert(m1 == m2)
    assert(!(m1 != m2))

    let h = CgHolder { marker: m1, value: 42 }
    let b = CgBox { marker: m2, value: 9 }
    assert(h.value == 42)
    assert(b.value == 9)

    let nm1: ?CgMarker = CgMarker {}
    let nm2: ?CgMarker = null
    assert(isset(nm1))
    assert(!isset(nm2))

    let arr = Array[CgMarker]{ CgMarker {}, CgMarker {} }
    arr.append(CgMarker {})
    assert(arr.length == 3)

    let mp = Map[CgMarker]{ "a" => CgMarker {} }
    assert(mp.has("a"))

    let u: CgMarker | int = CgMarker {}
    let is_marker = match u : bool {
        CgMarker => true
        int => false
    }
    assert(is_marker)

    let _, pv = cg_pair_marker()
    assert(pv == 77)
    assert(cg_check_marker[CgMarker](5) == 105)
    assert(cg_check_marker[CgEmptyWithMethod](5) == 5)
    let em = CgEmptyWithMethod {}
    assert(em.tag() == 19)
}

@unsafe

use valk.gc

// Reads the shadow state and the overflow map
@ignore_access

global grove_shadow_freed: uint

// An 8-byte body: its count has no shadow byte 1
class GroveNarrow {
    value: uint
    fn gc_free() { grove_shadow_freed++ }
}

// A 16-byte body: the count's high bits are in shadow byte 1
class GroveWide {
    value: uint
    other: uint
    fn gc_free() { grove_shadow_freed++ }
}

class GroveHolder {
    narrow: ?GroveNarrow
    wide: ?GroveWide
}

// Addresses kept as numbers must not look like references to the stack scan
value grove_hide (0x5A5A5A5A5A5A5A5A)

fn grove_holders(list: Array[GroveHolder], count: uint) $noinline {
    let narrow = GroveNarrow { value: 1 }
    let wide = GroveWide { value: 2, other: 3 }
    let i: uint = 0
    while i < count {
        list.append(GroveHolder { narrow: narrow, wide: wide })
        i++
    }
}

fn grove_narrow(list: Array[GroveHolder]) ptr $noinline {
    let h = list.get(list.length - 1) !!
    let n = h.narrow ?! panic("no narrow")
    return n.@cast(ptr)
}

fn grove_wide(list: Array[GroveHolder]) ptr $noinline {
    let h = list.get(list.length - 1) !!
    let w = h.wide ?! panic("no wide")
    return w.@cast(ptr)
}

fn grove_counts(list: Array[GroveHolder]) (uint, uint) $noinline {
    return (gc.gcdata(grove_narrow(list)).co_count(), gc.gcdata(grove_wide(list)).co_count())
}

fn grove_hidden(item: ptr) uint {
    let a: uint = item
    return a ^ grove_hide
}

fn grove_in_map(hidden: uint) bool $noinline {
    return gc.cnt_map_has((hidden ^ grove_hide).@cast(ptr))
}

// Every holder but the last `keep` lets go of both targets
fn grove_drop(list: Array[GroveHolder], keep: uint) $noinline {
    let i: uint = 0
    while i + keep < list.length {
        let h = list.get(i) !!
        h.narrow = null
        h.wide = null
        i++
    }
}

fn grove_co_edges(count: uint) $noinline {
    grove_shadow_freed = 0
    let list = Array[GroveHolder].new(count)
    grove_holders(list, count)
    gc.collect()
    gc.collect()
    let narrow = grove_hidden(grove_narrow(list))
    let wide = grove_hidden(grove_wide(list))
    // The format follows the body size
    assert(gc.desc_of(grove_narrow(list)).isize == 8)
    assert(gc.desc_of(grove_wide(list)).isize == 16)
    assert(!gc.cnt_wide(grove_narrow(list)))

    // One holder owns each target, the others co-own it (a stale stack word may own it instead)
    let n, w = grove_counts(list)
    assert(n >= count - 1 && n <= count)
    assert(w >= count - 1 && w <= count)
    assert(grove_in_map(narrow) == (n >= gc.cnt_marker_narrow))
    assert(grove_in_map(wide) == (w >= gc.cnt_marker(gc.cnt_wide(grove_wide(list)))))

    // Below the caps again: the counts go back inline
    grove_drop(list, 3)
    gc.collect()
    let n2, w2 = grove_counts(list)
    assert(n2 == 2 || n2 == 3)
    assert(w2 == 2 || w2 == 3)
    assert(grove_in_map(narrow) == (n2 >= gc.cnt_marker_narrow))
    assert(grove_shadow_freed == 0)

    grove_drop(list, 0)
}

synctest "Grove: many co-edges into one object are counted and released once" {
    // Above the 8-byte and the 16-byte body caps (14 and 4094), then far below them
    grove_co_edges(5000)
    gc.collect()
    gc.collect()
    assert(grove_shadow_freed == 2)
    gc.collect()
    assert(grove_shadow_freed == 2)
    // Few co-edges: inline counts only, unless the caps are small
    grove_co_edges(20)
    gc.collect()
    gc.collect()
    assert(grove_shadow_freed == 2)
}

fn grove_state_of(list: Array[GroveHolder]) uint $noinline {
    let h = list.get(0) !!
    return gc.gcdata(h.@cast(ptr)).state()
}

// The slot of the holder: its size, and whether it starts where the object does
fn grove_slot_of(list: Array[GroveHolder]) (uint, bool) $noinline {
    let h = list.get(0) !!
    let item: ptr = h.@cast(ptr)
    let desc = gc.desc_of(item)
    let off: uint = item - desc.first
    return (desc.isize, off % desc.isize == 0)
}

synctest "Grove: object state is in the shadow byte; objects have no header" {
    let list = Array[GroveHolder].new(2)
    list.append(GroveHolder { narrow: null, wide: null })
    // Young until a collection finds it
    assert(grove_state_of(list) == 0)
    gc.collect()
    assert(grove_state_of(list) == gc.st_owned)
    // A 16-byte body in a 16-byte slot, starting at the slot's first byte
    let size, at_start = grove_slot_of(list)
    assert(size == 16)
    assert(at_start)
}


use valk:core
use valk:time

test "Process" {
    #if OS != "win"
    // This test is a bit wonky on windows

    #if OS == "win"
    let p = core:Process.run("hh.exe", null, false) ! {
        assert(false)
        return
    }
    #else
    let p = core:Process.run("ls", .{ "-l" }, false) ! {
        assert(false)
        return
    }
    #end
    let exited = p.did_exit() ! {
        assert(false)
        return
    }
    assert(exited == false)
    time:sleep_ms(300)
    exited = p.did_exit() ! {
        assert(false)
        return
    }
    assert(exited == true)
    #end
}

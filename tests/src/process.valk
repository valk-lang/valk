
use valk.core
use valk.gc
use valk.time
use valk.fs
use valk.net
use valk.sync
use valk.http

test "Process" {
    #if OS == "win"
    let p = core.Process.run("C:\\Windows\\System32\\cmd.exe", .{ "/d", "/s", "/c", "exit /b 7" }, false) ! {
        assert(false)
        return
    }
    #else
    let p = core.Process.run("ls", .{ "-l" }, false) ! {
        assert(false)
        return
    }
    #end
    let exited = p.did_exit() ! {
        assert(false)
        return
    }
    if !exited {
        time.sleep_ms(300)
        exited = p.did_exit() ! {
            assert(false)
            return
        }
    }
    assert(exited)
    #if OS == "win"
    let code = p.exit_code() !? -1
    // Wine's cmd currently discards the explicit `exit /b` status, while native
    // Windows returns 7. In both cases reaching a normal exit proves that the
    // quoted command argument arrived as one argument.
    assert(code >= 0)

    // Exercise the explicit standard-handle allow-list path too.
    let inherited = core.Process.run("C:\\Windows\\System32\\cmd.exe",
        .{ "/d", "/s", "/c", "exit" }, true) ! {
        assert(false)
        return
    }
    let inherited_code = inherited.exit_code() !? -1
    assert(inherited_code >= 0)
    #end

    // A detached process no longer reports its status
    #if OS == "win"
    let exe = "C:\\Windows\\System32\\cmd.exe"
    let args: ?Array[String] = .{ "/d", "/s", "/c", "exit" }
    #else
    let exe = "true"
    let args: ?Array[String] = null
    #end
    let detached = core.Process.run(exe, args, false) ! {
        assert(false)
        return
    }
    detached.detach() ! assert(false)
    let closed = false
    detached.exit_code() ! { closed = error_is(E.code, closed) }
    assert(closed)
}

test "Process: Windows arguments are quoted without ambiguity" {
    assert(core.Process.quote_windows_arg_for_test("") == "\"\"")
    assert(core.Process.quote_windows_arg_for_test("plain") == "plain")
    assert(core.Process.quote_windows_arg_for_test("two words") == "\"two words\"")
    assert(core.Process.quote_windows_arg_for_test("C:\\Program Files\\tool.exe")
        == "\"C:\\Program Files\\tool.exe\"")
    assert(core.Process.quote_windows_arg_for_test("a\"b") == "\"a\\\"b\"")
    assert(core.Process.quote_windows_arg_for_test("C:\\dir\\") == "C:\\dir\\")
    assert(core.Process.quote_windows_arg_for_test("hé 🐔") == "\"hé 🐔\"")
}

#if OS != "win"
test "Process exit status is retained after polling" {
    let process = core.Process.run("sh", .{ "-c", "exit 7" }) !!
    assert(process.exit_code() !! == 7)
    assert(process.did_exit() !!)
    assert(process.exit_code() !! == 7)
}

test "Process without print_output still lets the child write" {
    let process = core.Process.run("sh", .{ "-c", "echo out; echo err >&2" }) !!
    assert(process.exit_code() !! == 0)
}

test "Process stop reaps the child and records its signal" {
    let process = core.Process.run("sleep", .{ "10" }) !!
    process.stop() !!
    assert(process.did_exit() !!)
    assert(process.exit_code() !! == 137)
}

test "Process detach transfers child reaping" {
    let process = core.Process.run("sh", .{ "-c", "exit 0" }) !!
    let pid = process.pid_for_test()
    process.detach() !!
    let deadline = time.mono_ms() + 2_000
    while core.Process.child_is_pending_reap_for_test(pid) && time.mono_ms() < deadline {
        time.sleep_ms(10)
    }
    assert(core.Process.child_is_reaped_for_test(pid))
    let observe_failed = false
    process.did_exit() ! { observe_failed = true }
    assert(observe_failed)
}

fn abandon_process() i32 {
    let process = core.Process.run("sh", .{ "-c", "exit 0" }) !!
    return process.pid_for_test()
}

test "Dropped Process transfers child reaping" {
    let pid = abandon_process()
    gc.collect()
    gc.collect()
    let deadline = time.mono_ms() + 2_000
    while core.Process.child_is_pending_reap_for_test(pid) && time.mono_ms() < deadline {
        time.sleep_ms(10)
    }
    assert(core.Process.child_is_reaped_for_test(pid))
}
#end

test "Process: run searches PATH for a bare program name" {
    #if OS == "win"
    let process = core.Process.run("cmd", .{ "/d", "/s", "/c", "exit /b 0" }) !!
    assert(process.exit_code() !! == 0)
    #else
    let process = core.Process.run("sh", .{ "-c", "exit 0" }) !!
    assert(process.exit_code() !! == 0)
    #end
}

#if OS == "linux"
// The descriptors a shell started from here sees, one name per line
fn process_child_descriptors(counted: String) Array[String] {
    let child = core.Process.run("sh", .{ "-c", "ls /proc/self/fd > " + counted }, false) ! return Array[String]{}
    child.exit_code() ! return Array[String]{}
    return (fs.read(counted) !? "").trim("\n").split("\n")
}

test "Process: a child inherits no descriptors beyond the standard streams" {
    // Everything the runtime opens is close-on-exec: the thread's wake descriptor,
    // a file, and a listening socket. The environment (a CI runner, a shell) may pass
    // descriptors of its own to every child, so the check is that creating these adds
    // nothing to what a child saw before they existed.
    let counted = fs.add(fs.exe_dir() !? ".", "process-cloexec-count.txt")
    let before = process_child_descriptors(counted)
    assert(before.length >= 3)

    let mutex = core.Mutex.new() !!
    let waker = sync.Waker.new() !!
    let path = fs.add(fs.exe_dir() !? ".", "process-cloexec.txt")
    let file = fs.stream(path, fs.OpenOptions { write: fs.WriteMode.truncate, create: true }) !!
    let server = net.tcp_server("127.0.0.1", 9316) !!
    let after = process_child_descriptors(counted)
    assert(after.length == before.length)

    file.close() ! {}
    server.close() ! {}
    waker.wake()
    mutex.lock()
    mutex.unlock()
    fs.delete_file(path) ! {}
    fs.delete_file(counted) ! {}
}
#end

class ProcessTicker {
    count: uint (0)
    stop: bool (false)
}

fn process_tick(ticker: ProcessTicker) {
    while !ticker.stop {
        time.sleep_ms(10)
        ticker.count++
    }
}

#if OS != "win"
test "Process.output passes arguments without a shell and keeps the streams apart" {
    let out = core.Process.output("printf", .{ "\%s|", "a b", "c;d", "$HOME", "'q'" }) !!
    assert(out.code == 0)
    assert(out.stdout == "a b|c;d|$HOME|'q'|")
    assert(out.stderr == "")

    let both = core.Process.output("sh", .{ "-c", "echo out; echo err >&2; exit 3" }) !!
    assert(both.code == 3)
    assert(both.stdout == "out\n")
    assert(both.stderr == "err\n")

    let missing = core.Process.output("valk-no-such-program-test") !!
    assert(missing.code == 127)
}

test "Process.output feeds input while reading large output" {
    let echoed = core.Process.output("cat", input: "hello") !!
    assert(echoed.stdout == "hello")

    // Far more than a pipe buffer in every direction at once
    let fill = ByteBuffer.new(1_000_000)
    fill.fill('x', 1_000_000)
    let big = fill.to_string()
    let copied = core.Process.output("cat", input: big) !!
    assert(copied.stdout.bytes == 1_000_000)
    let noisy = core.Process.output("sh", .{ "-c", "head -c 300000 /dev/zero; head -c 200000 /dev/zero >&2" }) !!
    assert(noisy.stdout.bytes == 300_000 && noisy.stderr.bytes == 200_000)

    // A child that stops reading early does not make it fail
    let early = core.Process.output("true", input: big) !!
    assert(early.code == 0)
}

test "Process.output sets the working directory and environment" {
    let root = core.Process.output("pwd", cwd: "/") !!
    assert(root.stdout == "/\n")
    let bad_dir = core.Process.output("pwd", cwd: "/valk-no-such-dir") !!
    assert(bad_dir.code == 127)

    let vars = core.env_vars()
    vars.set("VALK_PROCESS_TEST", "set here")
    let extended = core.Process.output("sh", .{ "-c", "echo \"$VALK_PROCESS_TEST\"" }, env: vars) !!
    assert(extended.stdout == "set here\n")

    // The map is the whole environment; PATH is searched in it, with the default when missing
    let only = Map[String]{ "ONLY" => "1" }
    let replaced = core.Process.output("sh", .{ "-c", "echo \"[$ONLY][$HOME]\"" }, env: only) !!
    assert(replaced.stdout == "[1][]\n")
}

test "Process pipes stream to and from a running child" {
    let p = core.Process.start("cat", stdin: core.Stdio.pipe, stdout: core.Stdio.pipe) !!
    assert(p.id() > 0 && p.id() != core.process_id())
    p.stdin.write("line 1\n") !!
    p.stdin.write("line 2\n") !!
    p.stdin.close() !!
    assert(p.stdout.read_all() !! == "line 1\nline 2\n")
    assert(p.wait() !! == 0)

    // Streams that are not pipes are closed
    let closed = false
    p.stderr.read_all() ! { closed = error_is(E.code, closed) }
    assert(closed)
}

test "Process.wait times out and signal ends the child" {
    let p = core.Process.start("sleep", .{ "10" }) !!
    let timed_out = false
    p.wait(50) ! { timed_out = error_is(E.code, timeout) }
    assert(timed_out)
    assert(p.waits_on_events_for_test())
    p.signal(.terminate) !!
    assert(p.wait(5000) !! == 143)
    // Signalling a child that exited does nothing
    p.signal(.terminate) !!
}

fn process_http_handler(req: http.Request) http.Response {
    return http.Response.text("served " + req.path)
}

test "Process: a child can reach a server running on the same thread" {
    let has_curl, _ = core.exec("command -v curl")
    if has_curl != 0 : return
    let server = http.Server.new("127.0.0.1", 19537, process_http_handler)
    let running = co server.start(1)
    time.sleep_ms(20)
    // exec used to block the thread, so the server never answered and this hung
    let code, out = core.exec("curl -s http://127.0.0.1:19537/child")
    assert(code == 0)
    assert(out == "served /child")
    let result = core.Process.output("curl", .{ "-s", "http://127.0.0.1:19537/output" }) !!
    assert(result.stdout == "served /output")
    server.shutdown()
    await running !!
}

test "Process waits suspend only the current coroutine" {
    let ticker = ProcessTicker {}
    let task = co process_tick(ticker)
    let code, _ = core.exec("sleep 0.5")
    assert(code == 0)
    let during_exec = ticker.count
    let p = core.Process.start("sleep", .{ "0.2" }) !!
    p.wait() !!
    // The other coroutine ticked while each wait was pending; a wait that blocks the thread lets
    // it tick once at most. Low bounds only: the timers of a busy CI machine run late.
    assert(during_exec >= 3)
    assert(ticker.count > during_exec)
    ticker.stop = true
    await task
}
#end

#if OS == "win"
test "Process.output on Windows" {
    let both = core.Process.output("cmd", .{ "/d", "/c", "echo out& echo err 1>&2" }) !!
    assert(both.code == 0)
    assert(both.stdout == "out\r\n")
    assert(both.stderr == "err \r\n")

    let root = core.Process.output("cmd", .{ "/d", "/c", "cd" }, cwd: "C:\\") !!
    assert(root.stdout == "C:\\\r\n")

    let vars = core.env_vars()
    vars.set("VALK_PROCESS_TEST", "set here")
    let extended = core.Process.output("cmd", .{ "/d", "/c", "echo \%VALK_PROCESS_TEST\%" }, env: vars) !!
    assert(extended.stdout == "set here\r\n")

    let p = core.Process.start("cmd", .{ "/d", "/c", "exit" }, stdout: core.Stdio.pipe) !!
    assert(p.id() > 0)
    assert(p.stdout.read_all() !! == "")
    assert(p.wait(10000) !! >= 0)
}

test "Process.wait times out and terminate ends the child on Windows" {
    // `set /p` waits for a line on the child's stdin, which stays open
    let p = core.Process.start("cmd", .{ "/d", "/c", "set /p line=" }, stdin: core.Stdio.pipe) !!
    let timed_out = false
    p.wait(50) ! { timed_out = error_is(E.code, timeout) }
    assert(timed_out)
    assert(p.waits_on_events_for_test())
    let unsupported = false
    p.signal(.interrupt) ! { unsupported = error_is(E.code, os) }
    assert(unsupported)
    p.signal(.terminate) !!
    assert(p.wait(10000) !! == 143)
}

fn process_close_input_later(p: core.Process) {
    time.sleep_ms(200)
    p.stdin.close() ! {}
}

test "Process waits suspend only the current coroutine on Windows" {
    let ticker = ProcessTicker {}
    let task = co process_tick(ticker)
    let p = core.Process.start("cmd", .{ "/d", "/c", "set /p line=" }, stdin: core.Stdio.pipe) !!
    let closer = co process_close_input_later(p)
    assert(p.wait(10000) !! >= 0)
    assert(ticker.count >= 3)
    ticker.stop = true
    await closer
    await task
}
#end

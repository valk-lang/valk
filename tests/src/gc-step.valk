@ignore_access

use valk.gc

class GcStepItem {
    a: uint (0)
    b: uint (0)
    c: uint (0)
    d: uint (0)
    e: uint (0)
    f: uint (0)
    next: ?GcStepItem (null)
}

// Short chains that are dropped right away
fn gc_step_garbage(bytes: uint) $noinline {
    let made: uint = 0
    while made < bytes {
        let head = GcStepItem {}
        let i = 0
        while i++ < 16 : head = GcStepItem { next: head }
        made += 17 * size_of(GcStepItem)
    }
}

synctest "GC: the step between collections widens when allocations die young" {
    // Everything allocated here survives: the step stays at its minimum
    let count: uint = 400_000
    let live = Array[GcStepItem].new(count)
    let i: uint = 0
    while i++ < count : live.append(GcStepItem {})
    assert(gc.gc.step_max == gc.mark_step_max)

    // Almost nothing survives: longer steps, bounded by the live heap
    gc_step_garbage(64 * 1024 * 1024)
    assert(gc.gc.step_max > gc.mark_step_max)
    assert(gc.gc.step_max <= gc.gc.mem_marked)
    assert(live.length == count)
}

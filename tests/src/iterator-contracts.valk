use valk.gc

class IteratorDefaultItem { number: int }
global iterator_default_calls: int (0)
fn iterator_default_item() IteratorDefaultItem {
    iterator_default_calls++
    return IteratorDefaultItem { number: 73 }
}
class IteratorDefaults {
    fn _next(index: uint, item: IteratorDefaultItem (iterator_default_item()), extra: int (7)) int !IterError {
        if index >= 3 : throw .end
        gc.collect()
        return item.number + extra + index.to(int)
    }
}
class IteratorInfallible {
    fn _next(index: uint, base: int (19)) (int, int) { return (base + index.to(int), 73) }
}
class IteratorNarrow {
    fn _next(index: u8) int !IterError {
        if index >= 3 : throw .end
        return index.to(int)
    }
}
class IteratorFactory {
    calls: int (0)
    skips: int (0)
    fn make() IteratorNarrow { this.calls++; return .{} }
    fn skip() u8 { this.skips++; return 1 }
}

test "Iterators: defaults are evaluated for every next call" {
    iterator_default_calls = 0
    let iterator = IteratorDefaults {}
    let sum = 0
    let count = 0
    each iterator as value, index {
        assert(value == 80 + index.to(int))
        sum += value
        count++
    }
    assert(count == 3 && sum == 243)
    assert(iterator_default_calls == 4)
}

test "Iterators: infallible next values support break and continue" {
    let iterator = IteratorInfallible {}
    let sum = 0
    each iterator as value, extra, index {
        if index == 0 : continue
        assert(extra == 73)
        sum += value
        if index == 3 : break
    }
    assert(sum == 63)
}

test "Iterators: narrow integer indices preserve source and skip evaluation" {
    let factory = IteratorFactory {}
    let sum = 0
    each factory.make() skip factory.skip() as value, index {
        assert(value == index.to(int))
        sum += value
    }
    assert(sum == 3 && factory.calls == 1 && factory.skips == 1)
}

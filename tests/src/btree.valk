class BTreeBox {
    id: int
    label: String

    + fn clone() BTreeBox {
        return BTreeBox { id: this.id, label: this.label }
    }
}

test "BTreeMap: basic operations, literals, and sorted iteration" {
    let m = BTreeMap[String, int]{ "delta" => 4, "alpha" => 1, "charlie" => 3, "bravo" => 2 }
    assert(m.length == 4)
    assert(!m.is_empty())
    assert(m["alpha"] !! == 1)
    assert(m["delta"] !! == 4)
    assert(m.has("bravo"))
    assert(!m.has("echo"))

    let missing = false
    m.get("echo") ! { missing = E == .missing }
    assert(missing)

    // Update existing key via index and update()
    m["bravo"] = 20
    assert(m["bravo"] !! == 20)
    assert(m.length == 4)

    let dup = false
    m.set_unique("alpha", 99) ! { dup = E == .exists }
    assert(dup)
    assert(m["alpha"] !! == 1)

    m.set_unique("echo", 5) !!
    assert(m.length == 5)

    let u1 = m.update("bravo", fn(cur: ?int) int { return (cur ?? 0) + 5 })
    assert(u1 == 25)
    let u2 = m.update("foxtrot", fn(cur: ?int) int { return (cur ?? 100) + 1 })
    assert(u2 == 101)
    assert(m.length == 6)

    // Keys and values come out sorted
    let ks = m.keys()
    let vs = m.values()
    assert(ks.length == 6)
    assert(ks[0] == "alpha" && ks[1] == "bravo" && ks[2] == "charlie"
        && ks[3] == "delta" && ks[4] == "echo" && ks[5] == "foxtrot")
    assert(vs[0] == 1 && vs[1] == 25 && vs[2] == 3
        && vs[3] == 4 && vs[4] == 5 && vs[5] == 101)

    // Sorted `each` iteration
    let seen_k = Array[String].new()
    let seen_v = Array[int].new()
    each m as v, k {
        seen_k.append(k)
        seen_v.append(v)
    }
    assert(seen_k.length == 6)
    assert(seen_k[0] == "alpha" && seen_k[5] == "foxtrot")
    assert(seen_v[1] == 25)

    // Nested `each` on the same map
    let pairs: uint = 0
    each m as v1, k1 {
        let prev = ""
        each m as v2, k2 {
            assert(k2 > prev)
            prev = k2
            pairs++
        }
    }
    assert(pairs == 36)

    // Copy, clone, merge, remove_where, retain, clear
    let c = m.copy()
    c["alpha"] = 999
    assert(m["alpha"] !! == 1)

    let extra = BTreeMap[String, int]{ "alpha" => 10, "golf" => 7 }
    let merged = m + extra
    assert(merged["alpha"] !! == 10)
    assert(merged["golf"] !! == 7)
    assert(merged.length == 7)
    assert(m["alpha"] !! == 1)

    merged.remove_where(fn(v: int, k: String) bool { return v >= 20 })
    assert(!merged.has("bravo") && !merged.has("foxtrot"))
    assert(merged.length == 5)

    merged.retain(fn(v: int, k: String) bool { return k <= "delta" })
    assert(merged.length == 3)
    assert(merged.keys()[2] == "delta")

    merged.clear()
    assert(merged.is_empty() && merged.length == 0)
}

test "BTreeMap: min, max, pop_min, pop_max, floor, ceil, at, range" {
    let m = BTreeMap[int, String].new()
    let empty_err = false
    m.min() ! { empty_err = E == .empty }
    assert(empty_err)
    empty_err = false
    m.max() ! { empty_err = E == .empty }
    assert(empty_err)

    let keys = Array[int]{ 50, 10, 40, 20, 30, 70, 60 }
    each keys into k : m[k] = "v" + k

    let mink, minv = m.min() !!
    assert(mink == 10 && minv == "v10")
    let maxk, maxv = m.max() !!
    assert(maxk == 70 && maxv == "v70")

    // floor & ceil
    let fk1, fv1 = m.floor(35) !!
    assert(fk1 == 30 && fv1 == "v30")
    let fk2, _ = m.floor(30) !!
    assert(fk2 == 30)
    let no_floor = false
    m.floor(5) ! { no_floor = E == .missing }
    assert(no_floor)

    let ck1, cv1 = m.ceil(35) !!
    assert(ck1 == 40 && cv1 == "v40")
    let ck2, _ = m.ceil(40) !!
    assert(ck2 == 40)
    let no_ceil = false
    m.ceil(75) ! { no_ceil = E == .missing }
    assert(no_ceil)

    // Order statistics at(index)
    let i: uint = 0
    while i < 7 {
        let ak, av = m.at(i) !!
        assert(ak == (i.to(int) + 1) * 10)
        assert(av == "v" + ak)
        i++
    }
    let oob = false
    m.at(7) ! { oob = E == .range }
    assert(oob)

    // Range queries
    let r = m.range(20, 55)
    assert(r.length == 4)
    let rks = Array[int].new()
    let rvs = Array[String].new()
    each r as v, k {
        rks.append(k)
        rvs.append(v)
    }
    assert(rks[0] == 20 && rks[1] == 30 && rks[2] == 40 && rks[3] == 50)
    assert(rvs[0] == "v20" && rvs[3] == "v50")

    // Empty / inverted range
    assert(m.range(55, 20).is_empty())
    assert(m.range(100, 200).is_empty())
    assert(m.range(1, 5).is_empty())

    // pop_min and pop_max
    let p1k, p1v = m.pop_min() !!
    assert(p1k == 10 && p1v == "v10" && m.length == 6)
    let p2k, p2v = m.pop_max() !!
    assert(p2k == 70 && p2v == "v70" && m.length == 5)
    let nmin, _ = m.min() !!
    let nmax, _ = m.max() !!
    assert(nmin == 20 && nmax == 60)
}

test "BTreeMap: custom comparator and non-orderable keys" {
    // Descending order on int
    let desc = BTreeMap[int, String].new(fn(a: int, b: int) bool { return a > b })
    desc[1] = "one"
    desc[3] = "three"
    desc[2] = "two"
    let ks = desc.keys()
    assert(ks[0] == 3 && ks[1] == 2 && ks[2] == 1)
    let mk, _ = desc.min() !!
    assert(mk == 3)

    // Custom class without `<`
    let by_id = BTreeMap[BTreeBox, String].new(fn(a: BTreeBox, b: BTreeBox) bool { return a.id < b.id })
    by_id[BTreeBox { id: 30, label: "c" }] = "thirty"
    by_id[BTreeBox { id: 10, label: "a" }] = "ten"
    by_id[BTreeBox { id: 20, label: "b" }] = "twenty"
    assert(by_id.get(BTreeBox { id: 20, label: "ignored" }) !! == "twenty")
    let first, _ = by_id.min() !!
    assert(first.id == 10)

    let cloned = by_id.clone()
    assert(cloned.length == 3)
    assert(cloned.get(BTreeBox { id: 30, label: "" }) !! == "thirty")
}

test "BTreeMap: stress test splits, borrows, merges, range, and cursor" {
    let m = BTreeMap[int, int].new()
    let ref_map = HashMap[int, int].new()

    // Insert 1500 keys in pseudo-random order (triggers multi-level splits)
    let x: uint = 123456789
    let i: uint = 0
    while i < 1500 {
        x = (x * 1103515245 + 12345) & 0x7fffffff
        let k = (x % 3000).to(int)
        let v = i.to(int) * 3 + 1
        m[k] = v
        ref_map[k] = v
        i++
    }
    assert(m.length == ref_map.length)

    // Verify full sorted order, `at(idx)`, and exact match with ref_map
    let prev: int = -1
    let idx: uint = 0
    each m as v, k {
        assert(k > prev)
        assert(ref_map[k] !! == v)
        let ak, av = m.at(idx) !!
        assert(ak == k && av == v)
        prev = k
        idx++
    }
    assert(idx == m.length)

    // Range query matches full scan filter
    let r = m.range(500, 1500)
    let expected_range: uint = 0
    each m as _, k {
        if k >= 500 && k <= 1500 : expected_range++
    }
    assert(r.length == expected_range)
    let rprev: int = 499
    each r as v, k {
        assert(k > rprev && k <= 1500)
        assert(m[k] !! == v)
        rprev = k
    }

    // Delete ~70% of keys in varied order (triggers borrows, merges, and height shrink)
    let all_keys = m.keys()
    let d: uint = 0
    while d < all_keys.length {
        if d % 3 != 0 {
            let dk = all_keys[d]
            m.remove(dk)
            ref_map.remove(dk)
        }
        d++
    }
    assert(m.length == ref_map.length)

    // Verify order, floor/ceil, and `at` after heavy deletion
    prev = -1
    idx = 0
    each m as v, k {
        assert(k > prev)
        assert(ref_map[k] !! == v)
        let ak, av = m.at(idx) !!
        assert(ak == k && av == v)
        let fk, _ = m.floor(k) !!
        let ck, _ = m.ceil(k) !!
        assert(fk == k && ck == k)
        prev = k
        idx++
    }
    assert(idx == m.length)

    // Drain remaining entries alternating pop_min and pop_max
    let toggle = false
    while !m.is_empty() {
        if toggle {
            let k, v = m.pop_max() !!
            assert(ref_map[k] !! == v)
            ref_map.remove(k)
        } else {
            let k, v = m.pop_min() !!
            assert(ref_map[k] !! == v)
            ref_map.remove(k)
        }
        toggle = !toggle
    }
    assert(ref_map.length == 0)
}

test "BTreeSet: ordered operations, range, and set algebra" {
    let s = BTreeSet[int]{ 40, 10, 30, 20, 10, 50 }
    assert(s.length == 5)
    assert(s.has(30) && !s.has(25))
    assert(!s.insert(20))
    assert(s.insert(25))
    assert(s.length == 6)

    // Sorted iteration
    let items = s.items()
    assert(items.length == 6)
    assert(items[0] == 10 && items[1] == 20 && items[2] == 25
        && items[3] == 30 && items[4] == 40 && items[5] == 50)

    // min, max, floor, ceil, at, range
    assert(s.min() !! == 10)
    assert(s.max() !! == 50)
    assert(s.floor(27) !! == 25)
    assert(s.ceil(27) !! == 30)
    assert(s.at(3) !! == 30)

    let rng = s.range(20, 40)
    assert(rng.length == 4)
    let r_items = Array[int].new()
    each rng as v : r_items.append(v)
    assert(r_items[0] == 20 && r_items[1] == 25 && r_items[2] == 30 && r_items[3] == 40)

    // pop_min / pop_max / remove
    assert(s.pop_min() !! == 10)
    assert(s.pop_max() !! == 50)
    assert(s.remove(25))
    assert(!s.remove(25))
    assert(s.length == 3)

    // Set algebra
    let a = BTreeSet[int]{ 1, 2, 3, 4 }
    let b = BTreeSet[int]{ 3, 4, 5, 6 }
    let u = a + b
    assert(u == BTreeSet[int]{ 1, 2, 3, 4, 5, 6 })
    let inter = a.intersection(b)
    assert(inter == BTreeSet[int]{ 3, 4 })
    let diff = a - b
    assert(diff == BTreeSet[int]{ 1, 2 })
    assert(diff.is_subset_of(a))
    assert(!a.is_subset_of(b))
    assert(diff.is_disjoint(b))
    assert(!a.is_disjoint(b))

    let cp = u.copy()
    cp.remove_where(fn(v: int) bool { return v % 2 == 0 })
    assert(cp == BTreeSet[int]{ 1, 3, 5 })
    cp.retain(fn(v: int) bool { return v > 2 })
    assert(cp == BTreeSet[int]{ 3, 5 })
    cp.clear()
    assert(cp.is_empty())
}

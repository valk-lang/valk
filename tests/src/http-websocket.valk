use valk.http
use valk.net
use valk.time
use valk.sync
use valk.crypto
use valk.compress

global ws_last_close_code: u16 (0)
global ws_last_close_reason: String ("")
global ws_server_saw_close: bool (false)
global ws_raw_close_code: u16 (0)
global ws_idle_saw_close: bool (false)

// Records the close code in its own global: tests run concurrently
fn ws_record_handler(req: http.Request) http.Response {
    return http.WebSocket.upgrade(req, fn(ws: http.WebSocket) {
        while true {
            let msg = ws.read() ! {
                ws_raw_close_code = ws.close_code
                break
            }
            ws.write(msg.data) ! break
        }
    })
}

// Echoes without touching any global: for tests whose server runs next to the echo test
fn ws_quiet_handler(req: http.Request) http.Response {
    return http.WebSocket.upgrade(req, fn(ws: http.WebSocket) {
        while true {
            let msg = ws.read() ! break
            ws.write(msg.data) ! break
        }
    })
}

fn ws_idle_handler(req: http.Request) http.Response {
    return http.WebSocket.upgrade(req, fn(ws: http.WebSocket) {
        ws.read() ! {
            ws_idle_saw_close = true
        }
    })
}

fn ws_echo_handler(req: http.Request) http.Response {
    if req.path == "/echo" {
        return http.WebSocket.upgrade(req, fn(ws: http.WebSocket) {
            while true {
                let msg = ws.read() ! {
                    ws_last_close_code = ws.close_code
                    ws_last_close_reason = ws.close_reason
                    ws_server_saw_close = true
                    break
                }
                if msg.is_text : ws.write(msg.data) ! break
                else : ws.write_binary(msg.data) ! break
            }
        })
    }
    if req.path == "/small" {
        return http.WebSocket.upgrade(req, fn(ws: http.WebSocket) {
            ws.max_message_size = 100
            while true {
                ws.read() ! break
            }
        })
    }
    if req.path == "/push" {
        return http.WebSocket.upgrade(req, fn(ws: http.WebSocket) {
            // Push from a second coroutine while this one waits for the client's reply
            let pusher = co fn() {
                ws.write("one") ! return
                ws.write("two") ! return
                ws.write("three") ! return
            }()
            let reply = ws.read() ! { await pusher; return }
            await pusher
            if reply.data == "got them" : ws.close(1000, "bye") ! {}
        })
    }
    return http.Response.text("plain " + req.path)
}

fn ws_frame(opcode: u8, payload: String, mask: bool, fin: bool (true), rsv: u8 (0)) String {
    let out = ByteBuffer.new(payload.bytes + 8)
    out.write_byte((fin ? 0x80 : 0) | rsv | opcode)
    let mask_bit: u8 = mask ? 0x80 : 0
    if payload.bytes < 126 {
        out.write_byte(mask_bit | payload.bytes.to(u8))
    } else {
        out.write_byte(mask_bit | 126)
        out.write_u16_be(payload.bytes.to(u16))
    }
    if mask {
        // A fixed key keeps the expected bytes easy to compute
        out.write("\x01\x02\x03\x04")
        each payload as byte, i {
            out.write_byte(byte ^ (i % 4 + 1).to(u8))
        }
    } else {
        out.write(payload)
    }
    return out.to_string()
}

// Opens a raw socket, completes the handshake by hand and returns the connection
fn ws_raw_client(port: u16, path: String) net.TcpConnection {
    let con = net.tcp_client("127.0.0.1", port) !!
    con.write("GET " + path + " HTTP/1.1\r\nHost: 127.0.0.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n") !!
    let buf = [u8]{ 0 x 4096 }
    let response = ""
    while !response.contains("\r\n\r\n") {
        let bytes = con.read(buf) !!
        response += buf.view(0, bytes).to_string()
    }
    assert(response.starts_with("HTTP/1.1 101 "))
    assert(response.contains("Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n"))
    assert(!response.contains("Content-Type"))
    return con
}

// Reads one close frame from the server and returns its code
fn ws_read_close_code(con: net.TcpConnection) u16 {
    let buf = [u8]{ 0 x 256 }
    let got: uint = 0
    while got < 4 {
        got += con.read(buf.view(got, 256 - got)) !!
    }
    assert(buf[0] == 0x88)
    return (buf[2].to(u16) << 8) | buf[3].to(u16)
}

test "WebSocket: echo text and binary, ping, fragments, large frames and close handshake" {
    let server = http.Server.new("127.0.0.1", 19495, ws_echo_handler)
    let running = co server.start(1)
    time.sleep_ms(20)

    // Plain requests still work next to the upgrade path
    let plain = http.get("http://127.0.0.1:19495/other") !!
    assert(plain.body == "plain /other")
    let not_upgrade = http.get("http://127.0.0.1:19495/echo") !!
    assert(not_upgrade.status == 400)

    let ws = http.WebSocket.connect("ws://127.0.0.1:19495/echo") !!
    assert(!ws.is_closed)
    ws.write("hello") !!
    let reply = ws.read() !!
    assert(reply.is_text && reply.data == "hello")

    ws.write_binary("\x00\x01\xff") !!
    let binary = ws.read() !!
    assert(!binary.is_text && binary.data == "\x00\x01\xff")

    // 16-bit and 64-bit length frames, with a 200 KB message
    let medium = "".pad_right('m', 70000)
    ws.write(medium) !!
    assert((ws.read() !!).data == medium)
    let big = ByteBuffer.new(200_000)
    let i: uint = 0
    while i < 200_000 {
        big.write_byte((i % 251).to(u8))
        i++
    }
    ws.write_binary(big) !!
    let out = ByteBuffer.new(200_000)
    let type = ws.read_into(out) !!
    assert(type == http.WebSocketMessageType.binary)
    assert(out.length == 200_000 && out.to_string() == big.to_string())

    // A ping is answered without disturbing the next message
    ws.ping("p") !!
    ws.write("after ping") !!
    assert((ws.read() !!).data == "after ping")

    // Unicode text survives the UTF-8 check
    ws.write("héllo 🎉") !!
    assert((ws.read() !!).data == "héllo 🎉")

    ws.close(1000, "done") !!
    assert(ws.is_closed)
    assert(ws.close_code == 1000 && ws.close_reason == "done")
    ws.write("late") ! {
        assert(error_is(E.code, closed))
    }
    time.sleep_ms(20)
    assert(ws_server_saw_close)
    assert(ws_last_close_code == 1000 && ws_last_close_reason == "done")

    // A message over the server's limit closes with 1009
    let small = http.WebSocket.connect("ws://127.0.0.1:19495/small") !!
    small.write("".pad_right('x', 101)) !!
    small.read() ! {
        assert(error_is(E.code, closed))
    }
    assert(small.close_code == 1009)

    // Two coroutines on one socket: the server pushes while waiting for a reply
    let push = http.WebSocket.connect("ws://127.0.0.1:19495/push") !!
    let received = Array[String].new()
    while received.length < 3 {
        received.append((push.read() !!).data)
    }
    assert(received.join(",") == "one,two,three")
    push.write("got them") !!
    push.read() ! {
        assert(error_is(E.code, closed))
    }
    assert(push.close_code == 1000 && push.close_reason == "bye")

    server.request_shutdown(1000)
    await running !!
}

test "WebSocket: raw frames, masking rules, fragmentation and protocol errors" {
    let server = http.Server.new("127.0.0.1", 19496, ws_record_handler)
    let running = co server.start(1)
    time.sleep_ms(20)

    // A fragmented text message is echoed as one frame
    let con = ws_raw_client(19496, "/echo")
    con.write(ws_frame(1, "ab", true, false)) !!
    con.write(ws_frame(0, "cd", true, false)) !!
    con.write(ws_frame(0, "ef", true)) !!
    let buf = [u8]{ 0 x 64 }
    let bytes = con.read(buf) !!
    assert(bytes == 8)
    assert(buf[0] == 0x81 && buf[1] == 6)
    assert(buf.view(2, 6).to_string() == "abcdef")

    // A ping gets a pong with the same payload; the server does not mask
    con.write(ws_frame(9, "hi", true)) !!
    bytes = con.read(buf) !!
    assert(bytes == 4 && buf[0] == 0x8a && buf[1] == 2 && buf.view(2, 2).to_string() == "hi")

    // A close frame is answered with a close frame carrying the same code
    con.write(ws_frame(8, "\x03\xe9", true)) !!
    assert(ws_read_close_code(con) == 1001)
    con.close() !!
    time.sleep_ms(20)
    assert(ws_raw_close_code == 1001)

    // An unmasked client frame is a protocol error
    con = ws_raw_client(19496, "/echo")
    con.write(ws_frame(1, "unmasked", false)) !!
    assert(ws_read_close_code(con) == 1002)
    con.close() !!

    // A continuation without a start is a protocol error
    con = ws_raw_client(19496, "/echo")
    con.write(ws_frame(0, "x", true)) !!
    assert(ws_read_close_code(con) == 1002)
    con.close() !!

    // Invalid UTF-8 in a text message closes with 1007
    con = ws_raw_client(19496, "/echo")
    con.write(ws_frame(1, "\xff\xfe", true)) !!
    assert(ws_read_close_code(con) == 1007)
    con.close() !!

    // A fragmented control frame is a protocol error
    con = ws_raw_client(19496, "/echo")
    con.write(ws_frame(9, "p", true, false)) !!
    assert(ws_read_close_code(con) == 1002)
    con.close() !!

    // A reserved control opcode is a protocol error, not a binary message
    con = ws_raw_client(19496, "/echo")
    con.write(ws_frame(11, "x", true)) !!
    assert(ws_read_close_code(con) == 1002)
    con.close() !!

    // A close code that may not be sent is a protocol error; a valid one is echoed
    each Array[u16]{ 999, 1004, 1005, 1006, 1015, 2999, 5000 } as bad {
        con = ws_raw_client(19496, "/echo")
        let payload = ByteBuffer.new(2)
        payload.write_u16_be(bad)
        con.write(ws_frame(8, payload.to_string(), true)) !!
        assert(ws_read_close_code(con) == 1002)
        con.close() !!
    }
    con = ws_raw_client(19496, "/echo")
    let ok_close = ByteBuffer.new(2)
    ok_close.write_u16_be(4000)
    con.write(ws_frame(8, ok_close.to_string(), true)) !!
    assert(ws_read_close_code(con) == 4000)
    con.close() !!

    server.request_shutdown(1000)
    await running !!
}

fn ws_fast_handler(ctx: http.Context, res: http.ResponseWriter) {
    if ctx.path.equals("/ws") {
        res.send_websocket(ctx, fn(ws: http.WebSocket) {
            let msg = ws.read() ! return
            ws.write("fast:" + msg.data) ! return
            ws.close() ! {}
        })
        return
    }
    res.send("fast plain", 200)
}

test "WebSocket: fast handler upgrade, handshake failures and shutdown interrupts a read" {
    let server = http.Server.new("127.0.0.1", 19497)
    server.fast(ws_fast_handler)
    server.websocket_compression = true
    let running = co server.start(1)
    time.sleep_ms(20)

    let ws = http.WebSocket.connect("ws://127.0.0.1:19497/ws") !!
    ws.write("x") !!
    assert((ws.read() !!).data == "fast:x")
    ws.read() ! {
        assert(error_is(E.code, closed))
    }
    assert(ws.close_code == 1000)

    // The fast handler negotiates compression too
    let raw = ws_raw_offer(19497, "/ws", "permessage-deflate; client_max_window_bits")
    assert(ws_header_line(raw.head, "sec-websocket-extensions") == "permessage-deflate; server_no_context_takeover; client_no_context_takeover")
    raw.con.write(ws_frame(1, compress.deflate("compressed"), true, true, 0x40)) !!
    assert(ws_raw_frame(raw) == "\x81fast:compressed")
    raw.con.close() !!

    // Not an upgrade: the fast handler answers 400
    let bad = http.get("http://127.0.0.1:19497/ws") !!
    assert(bad.status == 400)

    // A server that answers with a normal response fails the handshake
    http.WebSocket.connect("ws://127.0.0.1:19497/plain") ! {
        assert(error_is(E.code, handshake))
    }
    http.WebSocket.connect("http://127.0.0.1:19497/ws") ! {
        assert(error_is(E.code, invalid_url))
    }
    http.WebSocket.connect("ws://example.com:abc/ws") ! {
        assert(error_is(E.code, invalid_url))
    }
    let reserved = http.Options { headers: http.Headers { "Upgrade" => "h2c" } }
    http.WebSocket.connect("ws://127.0.0.1:19497/ws", reserved) ! {
        assert(error_is(E.code, invalid_request))
    }
    http.WebSocket.connect("ws://127.0.0.1:1/ws", http.Options { connect_timeout_ms: 500 }) ! {
        assert(!error_is(E.code, handshake))
    }

    server.request_shutdown(1000)
    await running !!

    // A handler blocked in `read` is interrupted by the shutdown
    let idle = http.Server.new("127.0.0.1", 19498, ws_idle_handler)
    let idle_running = co idle.start(1)
    time.sleep_ms(20)
    let waiting = http.WebSocket.connect("ws://127.0.0.1:19498/echo") !!
    let start = time.mono_ms()
    idle.request_shutdown(2000)
    await idle_running !!
    assert(time.mono_ms() - start < 1500)
    assert(ws_idle_saw_close)
    waiting.read() ! {
        assert(error_is(E.code, closed))
    }
}

test "WebSocket: a cancel token interrupts a pending read" {
    let server = http.Server.new("127.0.0.1", 19499, ws_quiet_handler)
    let running = co server.start(1)
    time.sleep_ms(20)

    let ws = http.WebSocket.connect("ws://127.0.0.1:19499/echo") !!
    let stop: shared sync.CancelToken = sync.CancelToken.new() !!
    ws.set_cancel(stop)
    stop.cancel_after(50)
    ws.read() ! {
        assert(error_is(E.code, cancelled))
    }
    ws.close() ! {}

    server.request_shutdown(1000)
    await running !!
}

test "WebSocket: wss:// over the server's TLS certificate" {
    let server = http.Server.new("127.0.0.1", 19500, ws_quiet_handler)
    server.tls(__DIR__ + "/../assets/tls-cert.pem", __DIR__ + "/../assets/tls-key.pem") !!
    let running = co server.start(1)
    time.sleep_ms(20)

    let ws = http.WebSocket.connect("wss://127.0.0.1:19500/echo", http.Options { verify_tls_cert: false }) !!
    ws.write("secure") !!
    assert((ws.read() !!).data == "secure")
    ws.close() !!
    assert(ws.close_code == 1000)

    // Verification stays on by default, so the self-signed certificate is refused
    http.WebSocket.connect("wss://127.0.0.1:19500/echo") ! {
        assert(error_is(E.code, ssl))
    }

    server.request_shutdown(1000)
    await running !!
}

// Answers one WebSocket handshake by hand with `extra` header lines
fn ws_fake_server(listener: shared net.TcpServer, extra: String) {
    let con = listener.accept(3000) ! return
    let request = ""
    let buf = [u8]{ 0 x 2048 }
    while !request.contains("\r\n\r\n") {
        let n = con.read(buf) ! return
        if n == 0 : return
        request += buf.view(0, n).to_string()
    }
    let key = ""
    each request.split("\r\n") as line {
        if line.lower().starts_with("sec-websocket-key:") : key = line.range(18, line.bytes - 18).trim(" ")
    }
    let accept = crypto.base64_encode(crypto.hash(crypto.HashAlgorithm.sha1, key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))
    con.write("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n" + extra + "\r\n") _
    time.sleep_ms(200)
    con.close() _
}

fn ws_fake_connect(port: u16, extra: String, offered: ?http.Headers) bool {
    let listener = net.tcp_server("127.0.0.1", port) !!
    let serving = co ws_fake_server(listener, extra)
    let options = http.Options{}
    if isset(offered) : options.headers = offered
    let ok = true
    http.WebSocket.connect("ws://127.0.0.1:" + port + "/", options) ! { ok = false }
    await serving
    listener.close() _
    return ok
}

test "WebSocket: a client refuses a subprotocol or extension it did not offer" {
    assert(ws_fake_connect(19576, "", null))
    assert(!ws_fake_connect(19577, "Sec-WebSocket-Protocol: chat\r\n", null))
    assert(!ws_fake_connect(19578, "Sec-WebSocket-Extensions: x-webkit-deflate-frame\r\n", null))
    let no_offer = http.Options { websocket_compression: false }
    let listener = net.tcp_server("127.0.0.1", 19590) !!
    let serving = co ws_fake_server(listener, "Sec-WebSocket-Extensions: permessage-deflate\r\n")
    let refused = false
    http.WebSocket.connect("ws://127.0.0.1:19590/", no_offer) ! { refused = error_is(E.code, handshake) }
    assert(refused)
    await serving
    listener.close() _
    let offered = http.Headers.new()
    offered.set("Sec-WebSocket-Protocol", "superchat, chat")
    assert(ws_fake_connect(19579, "Sec-WebSocket-Protocol: chat\r\n", offered))
    assert(!ws_fake_connect(19580, "Sec-WebSocket-Protocol: other\r\n", offered))
}

test "WebSocket: close refuses a code a close frame may not carry" {
    let listener = net.tcp_server("127.0.0.1", 19582) !!
    let serving = co ws_fake_server(listener, "")
    let ws = http.WebSocket.connect("ws://127.0.0.1:19582/") !!
    let refused = false
    ws.close(1006) ! { refused = error_is(E.code, protocol) }
    assert(refused)
    assert(!ws.is_closed)
    ws.close(1000, "", 100) _
    await serving
    listener.close() _
}

// ---- permessage-deflate ----------------------------------------------------------------

global ws_deflate_server_saw_close: u16 (0)

fn ws_deflate_handler(req: http.Request) http.Response {
    if req.path == "/off" {
        return http.WebSocket.upgrade(req, fn(ws: http.WebSocket) {
            let msg = ws.read() ! return
            ws.write(msg.data) ! return
        }, false)
    }
    if req.path == "/on" {
        return http.WebSocket.upgrade(req, fn(ws: http.WebSocket) {
            let msg = ws.read() ! return
            ws.write(msg.data) ! return
        }, true)
    }
    let small = req.path == "/small"
    return http.WebSocket.upgrade(req, fn(ws: http.WebSocket) {
        if small : ws.max_message_size = 1000
        while true {
            let msg = ws.read() ! {
                if small : ws_deflate_server_saw_close = ws.close_code
                break
            }
            if msg.is_text : ws.write(msg.data) ! break
            else : ws.write_binary(msg.data) ! break
        }
    })
}

class WsRaw {
    con: net.TcpConnection
    head: String
    input: ByteBuffer (ByteBuffer.new(256))
}

// Completes the handshake by hand, offering `extensions` when not empty
fn ws_raw_offer(port: u16, path: String, extensions: String) WsRaw {
    let con = net.tcp_client("127.0.0.1", port) !!
    let offer = extensions.bytes > 0 ? "Sec-WebSocket-Extensions: " + extensions + "\r\n" : ""
    con.write("GET " + path + " HTTP/1.1\r\nHost: 127.0.0.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n" + offer + "\r\n") !!
    let raw = WsRaw { con: con, head: "" }
    let buf = [u8]{ 0 x 4096 }
    while true {
        let bytes = con.read(buf) !!
        raw.input.write(buf.view(0, bytes))
        let end = raw.input.to_string().index_of("\r\n\r\n") ! continue
        raw.head = raw.input.to_string().range(0, end + 4)
        raw.input.clear_until(end + 4)
        break
    }
    assert(raw.head.starts_with("HTTP/1.1 101 "))
    return raw
}

// Reads one server frame; returns its first byte followed by the payload
fn ws_raw_frame(raw: WsRaw) String {
    let buf = [u8]{ 0 x 4096 }
    while true {
        let input = raw.input
        if input.length >= 2 {
            let length = (input.get(1) & 0x7f).to(uint)
            let header: uint = 2
            if length == 126 {
                length = (input.get(2).to(uint) << 8) | input.get(3).to(uint)
                header = 4
            }
            if input.length >= header + length {
                let frame = input.range(0, 1) + input.range(header, length)
                input.clear_until(header + length)
                return frame
            }
        }
        let bytes = raw.con.read(buf) !!
        input.write(buf.view(0, bytes))
    }
}

fn ws_header_line(head: String, name: String) String {
    each head.split("\r\n") as line {
        if line.lower().starts_with(name + ":") : return line.range(name.bytes + 1, line.bytes - name.bytes - 1).trim(" ")
    }
    return ""
}

// A message with a non-final stored block and a sync flush, tail removed
fn ws_stored_message(text: String) String {
    let out = ByteBuffer.new(text.bytes + 8)
    out.write_byte(0)
    out.write_u16_le(text.bytes.to(u16))
    out.write_u16_le((text.bytes ^ 0xffff).to(u16))
    out.write(text)
    out.write_byte(0)
    return out.to_string()
}

test "WebSocket: permessage-deflate between the client and the server" {
    let server = http.Server.new("127.0.0.1", 19591, ws_deflate_handler)
    server.websocket_compression = true
    let running = co server.start(1)
    time.sleep_ms(20)

    let repeated = "".pad_right('a', 5000) + "{\"name\":\"value\",\"list\":[1,2,3]}".pad_right('z', 300)
    let random = crypto.random_bytes(3000)
    let big = ByteBuffer.new(300_000)
    while big.length < 300_000 : big.write("line " + big.length + " of a long log message\n")

    // Default on both sides, then off on the client, the endpoint and the server
    let urls = Array[String]{ "ws://127.0.0.1:19591/echo", "ws://127.0.0.1:19591/echo", "ws://127.0.0.1:19591/off" }
    each urls as url, i {
        let options = http.Options { websocket_compression: i != 1 }
        let ws = http.WebSocket.connect(url, options) !!
        let rounds: uint = i == 2 ? 1 : 3
        let r: uint = 0
        while r < rounds {
            ws.write(repeated) !!
            assert((ws.read() !!).data == repeated)
            if i == 2 : break
            ws.write("tiny") !!
            assert((ws.read() !!).data == "tiny")
            ws.write_binary(random) !!
            assert((ws.read() !!).data == random)
            ws.write(big) !!
            let out = ByteBuffer.new(300_000)
            ws.read_into(out) !!
            assert(out.to_string() == big.to_string())
            ws.write("héllo 🎉 ".pad_right('!', 100)) !!
            assert((ws.read() !!).data == "héllo 🎉 ".pad_right('!', 100))
            ws.write("") !!
            assert((ws.read() !!).data == "")
            r++
        }
        ws.close() !!
    }

    // A compressed message over the limit closes with 1009 after decompressing 1000 bytes
    let small = http.WebSocket.connect("ws://127.0.0.1:19591/small") !!
    small.write("".pad_right('x', 900)) !!
    assert((small.read() !!).data.bytes == 900)
    small.write("".pad_right('x', 1_000_000)) !!
    small.read() ! {
        assert(error_is(E.code, closed))
    }
    assert(small.close_code == 1009)
    time.sleep_ms(20)
    assert(ws_deflate_server_saw_close == 1009)

    server.request_shutdown(1000)
    await running !!

    // Off by default on a server
    let plain = http.Server.new("127.0.0.1", 19592, ws_deflate_handler)
    let plain_running = co plain.start(1)
    time.sleep_ms(20)
    let raw = ws_raw_offer(19592, "/echo", "permessage-deflate; client_max_window_bits")
    assert(ws_header_line(raw.head, "sec-websocket-extensions") == "")
    // An endpoint can still accept it
    let opted = ws_raw_offer(19592, "/on", "permessage-deflate; client_max_window_bits")
    assert(ws_header_line(opted.head, "sec-websocket-extensions").starts_with("permessage-deflate"))
    opted.con.close() !!
    let ws = http.WebSocket.connect("ws://127.0.0.1:19592/echo") !!
    ws.write(repeated) !!
    assert((ws.read() !!).data == repeated)
    ws.close() !!
    raw.con.close() !!
    plain.request_shutdown(1000)
    await plain_running !!
}

test "WebSocket: permessage-deflate negotiation and frames on the wire" {
    let server = http.Server.new("127.0.0.1", 19593, ws_deflate_handler)
    server.websocket_compression = true
    let running = co server.start(1)
    time.sleep_ms(20)
    // The removed tail, then an empty final block so `inflate` sees the end
    let tail = "\x00\x00\xff\xff\x03\x00"

    // A browser's offer is accepted without context takeover either way
    let raw = ws_raw_offer(19593, "/echo", "permessage-deflate; client_max_window_bits")
    assert(ws_header_line(raw.head, "sec-websocket-extensions") == "permessage-deflate; server_no_context_takeover; client_no_context_takeover")

    // Compressed messages: a final block, and a stored block with a sync flush
    let text = "".pad_right('w', 200) + " compressed"
    let packed = compress.deflate(text)
    raw.con.write(ws_frame(1, packed, true, true, 0x40)) !!
    let frame = ws_raw_frame(raw)
    assert(frame[0] == 0xc1)
    assert((compress.inflate(frame.range(1, frame.bytes - 1) + tail) !!) == text)
    raw.con.write(ws_frame(1, ws_stored_message("stored hello"), true, true, 0x40)) !!
    frame = ws_raw_frame(raw)
    // Short replies go uncompressed
    assert(frame == "\x81stored hello")

    // A fragmented compressed message: RSV1 on the first frame only
    let sync = ws_stored_message("".pad_right('f', 150))
    raw.con.write(ws_frame(1, sync.range(0, 10), true, false, 0x40)) !!
    raw.con.write(ws_frame(0, sync.range(10, 100), true, false)) !!
    raw.con.write(ws_frame(0, sync.range(110, sync.bytes - 110), true, true)) !!
    frame = ws_raw_frame(raw)
    assert(frame[0] == 0xc1)
    assert((compress.inflate(frame.range(1, frame.bytes - 1) + tail) !!) == "".pad_right('f', 150))

    // Incompressible data goes uncompressed
    let noise = crypto.random_bytes(500)
    raw.con.write(ws_frame(2, noise, true)) !!
    frame = ws_raw_frame(raw)
    assert(frame[0] == 0x82 && frame.range(1, 500) == noise)

    // Control frames are never compressed
    raw.con.write(ws_frame(9, "p", true, true, 0x40)) !!
    assert(ws_read_close_code(raw.con) == 1002)
    raw.con.close() !!

    // RSV1 on a continuation frame
    raw = ws_raw_offer(19593, "/echo", "permessage-deflate")
    raw.con.write(ws_frame(1, sync.range(0, 10), true, false, 0x40)) !!
    raw.con.write(ws_frame(0, sync.range(10, sync.bytes - 10), true, true, 0x40)) !!
    assert(ws_read_close_code(raw.con) == 1002)
    raw.con.close() !!

    // RSV1 without the extension
    raw = ws_raw_offer(19593, "/echo", "")
    assert(ws_header_line(raw.head, "sec-websocket-extensions") == "")
    raw.con.write(ws_frame(1, packed, true, true, 0x40)) !!
    assert(ws_read_close_code(raw.con) == 1002)
    raw.con.close() !!

    // Broken compressed data closes with 1007, a decompression bomb with 1009
    raw = ws_raw_offer(19593, "/echo", "permessage-deflate")
    raw.con.write(ws_frame(1, "\xff\xff\xff\xff", true, true, 0x40)) !!
    assert(ws_read_close_code(raw.con) == 1007)
    raw.con.close() !!
    raw = ws_raw_offer(19593, "/small", "permessage-deflate")
    let bomb = compress.deflate("".pad_right('b', 2_000_000), 9)
    assert(bomb.bytes < 65536)
    raw.con.write(ws_frame(2, bomb, true, true, 0x40)) !!
    assert(ws_read_close_code(raw.con) == 1009)
    raw.con.close() !!

    // A message that refers to an earlier one breaks client_no_context_takeover
    raw = ws_raw_offer(19593, "/echo", "permessage-deflate")
    raw.con.write(ws_frame(1, "\x2a\xc9\x48\x55\x28\x2c\xcd\x4c\xce\x56\x48\x2a\xca\x2f\xcf\x53\x48\xcb\xaf\x50\xc8\x2a\xcd\x2d\x28\x56\xc8\x2f\x4b\x2d\x52\x28\xc9\x48\x55\xc8\x49\xac\xaa\x54\x48\xc9\x4f\x07\x00", true, true, 0x40)) !!
    frame = ws_raw_frame(raw)
    assert(frame == "\x81the quick brown fox jumps over the lazy dog")
    raw.con.write(ws_frame(1, "\x02\xb1\x89\x51\x9a\x9c\x58\x02\x00", true, true, 0x40)) !!
    assert(ws_read_close_code(raw.con) == 1007)
    raw.con.close() !!

    // Offers: the first acceptable one wins; a window limit is echoed; bad ones are declined
    raw = ws_raw_offer(19593, "/echo", "permessage-deflate; unknown=1, permessage-deflate; server_max_window_bits=10; server_no_context_takeover")
    assert(ws_header_line(raw.head, "sec-websocket-extensions") == "permessage-deflate; server_no_context_takeover; client_no_context_takeover; server_max_window_bits=10")
    let spread = Array[String].new()
    let i: uint = 0
    while i < 100 {
        spread.append("item-" + (i * 7919 % 1000))
        i++
    }
    let wide = spread.join(" ") + " " + spread.join(" ")
    raw.con.write(ws_frame(1, wide, true)) !!
    frame = ws_raw_frame(raw)
    assert(frame[0] == 0xc1)
    assert((compress.inflate(frame.range(1, frame.bytes - 1) + tail) !!) == wide)
    raw.con.close() !!
    each Array[String]{ "permessage-deflate; server_max_window_bits=16", "permessage-deflate; server_max_window_bits", "permessage-deflate; client_max_window_bits=7", "permessage-deflate; server_no_context_takeover; server_no_context_takeover", "x-webkit-deflate-frame" } as offer {
        raw = ws_raw_offer(19593, "/echo", offer)
        assert(ws_header_line(raw.head, "sec-websocket-extensions") == "")
        raw.con.close() !!
    }
    // The endpoint can turn it off
    raw = ws_raw_offer(19593, "/off", "permessage-deflate")
    assert(ws_header_line(raw.head, "sec-websocket-extensions") == "")
    raw.con.close() !!

    server.request_shutdown(1000)
    await running !!
}

// Accepts permessage-deflate with `params`, sends `frames`, then reads one client frame
// and answers with its first byte and the decompressed payload as a text frame
fn ws_deflate_fake_server(listener: shared net.TcpServer, params: String, frames: String) {
    let con = listener.accept(3000) ! return
    let input = ByteBuffer.new(1024)
    let buf = [u8]{ 0 x 2048 }
    let head_end: uint = 0
    while true {
        let n = con.read(buf) ! return
        if n == 0 : return
        input.write(buf.view(0, n))
        head_end = input.to_string().index_of("\r\n\r\n") ! continue
        break
    }
    let request = input.to_string().range(0, head_end)
    input.clear_until(head_end + 4)
    let key = ws_header_line(request, "sec-websocket-key")
    let offer = ws_header_line(request, "sec-websocket-extensions")
    let accept = crypto.base64_encode(crypto.hash(crypto.HashAlgorithm.sha1, key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))
    con.write("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\nSec-WebSocket-Extensions: permessage-deflate" + params + "\r\n\r\n") _
    con.write(frames) _
    // One masked client frame, short length
    while input.length < 6 || input.length < 6 + (input.get(1) & 0x7f).to(uint) {
        let n = con.read(buf) ! return
        if n == 0 : return
        input.write(buf.view(0, n))
    }
    let length = (input.get(1) & 0x7f).to(uint)
    let payload = ByteBuffer.new(length + 4)
    let i: uint = 0
    while i < length {
        payload.write_byte(input.get(6 + i) ^ input.get(2 + i % 4))
        i++
    }
    payload.write("\x00\x00\xff\xff\x03\x00")
    let text = compress.inflate(payload) !? "invalid"
    let reply = (input.get(0) == 0xc1 ? "rsv1 " : "plain ") + offer + " " + text
    con.write(ws_frame(1, reply, false)) _
    time.sleep_ms(200)
    con.close() _
}

test "WebSocket: the client decompresses with context takeover and compresses its messages" {
    let listener = net.tcp_server("127.0.0.1", 19594) !!
    let first = ws_frame(1, "\x2a\xc9\x48\x55\x28\x2c\xcd\x4c\xce\x56\x48\x2a\xca\x2f\xcf\x53\x48\xcb\xaf\x50\xc8\x2a\xcd\x2d\x28\x56\xc8\x2f\x4b\x2d\x52\x28\xc9\x48\x55\xc8\x49\xac\xaa\x54\x48\xc9\x4f\x07\x00", false, true, 0x40)
    let second = ws_frame(1, "\x02\xb1\x89\x51\x9a\x9c\x58\x02\x00", false, true, 0x40)
    let serving = co ws_deflate_fake_server(listener, "; client_max_window_bits=9", first + second)
    let ws = http.WebSocket.connect("ws://127.0.0.1:19594/") !!
    assert((ws.read() !!).data == "the quick brown fox jumps over the lazy dog")
    assert((ws.read() !!).data == "the quick brown fox jumps over the lazy cat")
    let text = "".pad_right('c', 90)
    ws.write(text) !!
    assert((ws.read() !!).data == "rsv1 permessage-deflate; client_no_context_takeover; client_max_window_bits " + text)
    await serving
    listener.close() _

    // A response with parameters the client cannot accept fails the handshake
    let bad = Array[String]{ "; client_max_window_bits", "; server_max_window_bits=20", "; mystery", "; server_no_context_takeover=1", ", permessage-deflate" }
    each bad as params, i {
        let port = (19595 + i).to(u16)
        let fake = net.tcp_server("127.0.0.1", port) !!
        let fake_serving = co ws_deflate_fake_server(fake, params, "")
        let refused = false
        http.WebSocket.connect("ws://127.0.0.1:" + port + "/") ! { refused = error_is(E.code, handshake) }
        assert(refused)
        await fake_serving
        fake.close() _
    }
}

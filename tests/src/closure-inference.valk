fn closure_inference_twice(f: fn(int)(int)) int {
    return f(f(1))
}

fn closure_inference_apply[R](f: fn(int)(R)) R {
    return f(2)
}

fn closure_inference_dollar(f: fn(int)($R)) R {
    return f(5)
}

test "Closures: parameter and return types come from the expected function type" {
    assert(closure_inference_twice(fn(x) int { return x + 10 }) == 21)
    // The return type too, when the literal leaves it out
    assert(closure_inference_twice(fn(x) { return x * 3 }) == 9)
    let g: fn(int, String)(String) = fn(n, s) { return s + n }
    assert(g(4, "s") == "s4")
    let maybe: ?fn(int)(bool) = fn(x) { return x > 2 }
    let check = maybe ?! return
    assert(check(3))
}

test "Closures: generic arguments follow from function literals" {
    let nums = Array[int]{ 1, 2, 3 }
    // `map[R]` without `[String]`: R is the literal's return type
    assert(nums.map(fn(x: int) String { return "n" + x }).join(",") == "n1,n2,n3")
    assert(nums.map(fn(x) String { return "m" + x }).join(",") == "m1,m2,m3")
    assert(nums.map(fn(x) { return x * 2 }).equals(Array[int]{ 2, 4, 6 }))
    // An earlier argument binds R for the literal's parameter
    assert(nums.reduce(10, fn(total, v) { return total + v }) == 16)
    assert(nums.reduce("", fn(acc, v) { return acc + v }) == "123")
    assert(nums.filter(fn(x) { return x > 1 }).length == 2)
    assert(closure_inference_apply(fn(x) String { return "v" + x }) == "v2")
    // `$R` inside a function type
    assert(closure_inference_dollar(fn(x: int) String { return "a" + x }) == "a5")
    // The explicit form still works
    assert(nums.map[String](fn(v: int) String { return v.to(String) }).join("") == "123")
}

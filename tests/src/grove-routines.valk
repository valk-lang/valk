@unsafe

use valk.gc

// Reads descriptors and the shadow state
@ignore_access

global grove_rt_freed: uint

class GroveRtLeaf {
    v: uint
    fn gc_free() {
        grove_rt_freed++
    }
}

union GroveRtUnion : GroveRtLeaf | uint {}

struct GroveRtPair {
    a: GroveRtLeaf
    b: ?GroveRtLeaf
}

// Plain words, a union member's word and a nullable inline value's words
class GroveRtHolder {
    first: ?GroveRtLeaf (null)
    either: GroveRtUnion (0)
    pair: ?GroveRtPair (null)
    last: ?GroveRtLeaf (null)
}

class GroveRtSmall {
    v: uint
}

class GroveRtMid {
    v: uint
    w: uint
}

class GroveRtOdd {
    v: uint
    w: uint
    x: uint
}

fn grove_rt_leaf(v: uint) GroveRtLeaf {
    return GroveRtLeaf { v: v }
}

fn grove_rt_reset() {
    gc.collect()
    gc.collect()
    grove_rt_freed = 0
}

synctest "Grove: a class kind with reference words has generated routines" {
    let h = GroveRtHolder {}
    let r = gc.desc_of(h.@cast(ptr)).routines ?! panic("no routines")
    let layout = gc.desc_of(h.@cast(ptr)).layout ?! panic("no layout")
    assert(r.words == gc.layout_words(layout))
    assert(r.words == 5)
    let s = [?GroveRtLeaf]{ null x 4 }
    // Sequences read the layout table
    assert(!isset(gc.desc_of(s.owner.@cast(ptr)).routines))
    let small = GroveRtSmall { v: 1 }
    assert(!isset(gc.desc_of(small.@cast(ptr)).routines))
}

fn grove_rt_fill(h: GroveRtHolder, base: uint) $noinline {
    h.first = grove_rt_leaf(base)
    h.either = grove_rt_leaf(base + 1)
    h.pair = GroveRtPair { a: grove_rt_leaf(base + 2), b: grove_rt_leaf(base + 3) }
    h.last = grove_rt_leaf(base + 4)
}

// Locals of the test's frame would keep the last holder or leaves alive, so the work is done
// in frames of their own
fn grove_rt_holders(count: uint) Array[GroveRtHolder] $noinline {
    let holders = Array[GroveRtHolder]{}
    let i: uint = 0
    while i < count {
        let h = GroveRtHolder {}
        grove_rt_fill(h, i * 10)
        holders.append(h)
        i++
    }
    return holders
}

fn grove_rt_refill(holders: Array[GroveRtHolder]) $noinline {
    each holders as h, k {
        if k % 2 == 0 : grove_rt_fill(h, 1000)
    }
}

// Reads every holder, then drops its union member's leaf and its pair
fn grove_rt_check_drop(holders: Array[GroveRtHolder]) bool $noinline {
    let ok = true
    each holders as h, k {
        let pair = h.pair ?! return false
        let v = match h.either : uint {
            GroveRtLeaf as leaf => leaf.v
            uint as n => n
        }
        if v != (k % 2 == 0 ? 1001 : k * 10 + 1) : ok = false
        if pair.a.v != (k % 2 == 0 ? 1002 : k * 10 + 2) : ok = false
        // The union's other member and an absent value hold no reference
        h.either = 7
        h.pair = null
    }
    return ok
}

synctest "Grove: generated routines follow plain words, union members and present values" {
    grove_rt_reset()
    let holders = grove_rt_holders(50)
    gc.collect()
    gc.collect()
    assert(grove_rt_freed == 0)
    // An old holder's stores are scanned through its cards
    grove_rt_refill(holders)
    gc.collect()
    assert(grove_rt_freed == 25 * 5)
    assert(grove_rt_check_drop(holders))
    gc.collect()
    assert(grove_rt_freed == 25 * 5 + 50 * 3)
    holders.clear()
    gc.collect()
    gc.collect()
    assert(grove_rt_freed == 50 * 5 + 25 * 5)
}

// The hole scan against a scan one slot at a time, over every start of the block of `item`
fn grove_rt_holes_ok(item: ptr) bool {
    let desc = gc.desc_of(item)
    let isize = desc.isize
    let first = desc.first
    let end = first + desc.slots_total * isize
    let from = first
    while from < end {
        let free = false
        while true {
            let expect = from
            while expect < end && gc.gcdata(expect).is_new() == free : expect += isize
            if gc.hole_scan(from, end, isize, free) != expect : return false
            if free : break
            free = true
        }
        from += isize
    }
    return true
}

synctest "Grove: the hole scan finds the free and used slots of 8 to 64-byte blocks" {
    let small = Array[GroveRtSmall]{}
    let mid = Array[GroveRtMid]{}
    let odd = Array[GroveRtOdd]{}
    let i: uint = 0
    while i < 600 {
        small.append(GroveRtSmall { v: i })
        mid.append(GroveRtMid { v: i, w: i })
        odd.append(GroveRtOdd { v: i, w: i, x: i })
        i++
    }
    gc.collect()
    // Holes of several lengths
    let keep_small = Array[GroveRtSmall]{}
    let keep_mid = Array[GroveRtMid]{}
    let keep_odd = Array[GroveRtOdd]{}
    i = 0
    while i < 600 {
        if i % 7 == 0 || i % 11 < 3 {
            keep_small.append(small.get(i) !!)
            keep_mid.append(mid.get(i) !!)
            keep_odd.append(odd.get(i) !!)
        }
        i++
    }
    small.clear()
    mid.clear()
    odd.clear()
    gc.collect()
    let s0 = (keep_small.get(0) !!).@cast(ptr)
    let s1 = (keep_small.get(keep_small.length - 1) !!).@cast(ptr)
    let m0 = (keep_mid.get(0) !!).@cast(ptr)
    let m1 = (keep_mid.get(keep_mid.length - 1) !!).@cast(ptr)
    let o0 = (keep_odd.get(0) !!).@cast(ptr)
    assert(gc.desc_of(s0).isize == 8 && gc.desc_of(m0).isize == 16 && gc.desc_of(o0).isize == 24)
    assert(grove_rt_holes_ok(s0) && grove_rt_holes_ok(s1))
    assert(grove_rt_holes_ok(m0) && grove_rt_holes_ok(m1))
    assert(grove_rt_holes_ok(o0))
}

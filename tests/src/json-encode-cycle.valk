use valk.json

// A recursive class, so the typed encoder is exercised through the same shapes as the
// Value encoder.
class EncLink {
    + weight: int (0)
    + children: Array[EncLink] (.{})
}

fn enc_rep(unit: String, n: uint) String {
    let buf = ByteBuffer.new(n * unit.bytes + 8)
    let i: uint = 0
    while i < n {
        buf.write(unit)
        i++
    }
    return buf
}

fn enc_deep_arrays(n: uint) String {
    return enc_rep("[", n) + "1" + enc_rep("]", n)
}

// n + 1 nested arrays, the innermost empty.
fn enc_deep_value(n: uint) json.Value {
    let root = json.new_array()
    let cur = root
    let i: uint = 0
    while i < n {
        let next = json.new_array()
        cur.values.append(json.from(next))
        cur = next
        i++
    }
    return json.from(root)
}

// n + 1 links, each level costing two containers: an object and its children array.
fn enc_deep_link(n: uint) EncLink {
    let root = EncLink {}
    let cur = root
    let i: uint = 0
    while i < n {
        let next = EncLink {}
        next.weight = i.to(int)
        cur.children.append(next)
        cur = next
        i++
    }
    return root
}

// a -> b -> c -> a, all objects, so the cycle closes three levels in.
fn enc_ring() json.ObjectValue {
    let a = json.new_object()
    let b = json.new_object()
    let c = json.new_object()
    a.values.set("b", json.from(b))
    b.values.set("c", json.from(c))
    c.values.set("a", json.from(a))
    return a
}

// One node reachable twice from every level: n + 1 distinct arrays, 2^n visits.
fn enc_doublings(n: uint) json.Value {
    let cur = json.new_array()
    cur.values.append(json.new_int(0))
    let i: uint = 0
    while i < n {
        let next = json.new_array()
        next.values.append(json.from(cur))
        next.values.append(json.from(cur))
        cur = next
        i++
    }
    return json.from(cur)
}

fn enc_markers(s: String, marker: String) uint {
    return s.split(marker).length - 1
}

// Walks the marker out of a decoded document, proving the text is real JSON.
fn enc_marker_behind(s: String) String {
    let back = json.decode(s) ! return "invalid-json"
    let lvl1 = back.object.get("b") ! return "no-b"
    let lvl2 = lvl1.object.get("c") ! return "no-c"
    let lvl3 = lvl2.object.get("a") ! return "no-a"
    return lvl3.string
}

test "Json: encoding a self-referential Value returns a document instead of crashing" {
    // The audit repro: one level of self-reference used to SIGSEGV json.encode. Reaching
    // the last assert is the proof — before the fix this binary dies in the first one.
    let o = json.new_object()
    o.values.set("self", json.from(o))
    assert(json.encode(o) == "{\"self\":\"(recursion)\"}")

    let a = json.new_array()
    a.values.append(json.from(a))
    assert(json.encode(a) == "[\"(recursion)\"]")

    let ring = enc_ring()
    assert(json.encode(ring) == "{\"b\":{\"c\":{\"a\":\"(recursion)\"}}}")
    // The root itself, referenced from three positions: the first visit is the node.
    assert(json.encode(o) == "{\"self\":\"(recursion)\"}")
    assert(json.encode(a) == "[\"(recursion)\"]")

    let holder = json.new_object()
    let bag = json.new_array()
    holder.values.set("bag", json.from(bag))
    bag.values.append(json.from(holder))
    assert(json.encode(holder) == "{\"bag\":[\"(recursion)\"]}")

    let root = json.new_array()
    root.values.append(json.from(root))
    root.values.append(json.from(root))
    root.values.append(json.from(root))
    assert(json.encode(root) == "[\"(recursion)\",\"(recursion)\",\"(recursion)\"]")

    // Pretty printing marks the same place and keeps its indentation.
    assert(json.encode(o, true) == "{\n    \"self\": \"(recursion)\"\n}")
    assert(json.encode(ring, true) == "{\n    \"b\": {\n        \"c\": {\n            \"a\": \"(recursion)\"\n        }\n    }\n}")
    // The replacement text is a string, so the document still parses.
    assert(enc_marker_behind(json.encode(ring)) == "(recursion)")
}

test "Json: the typed encoder stops at a repeated pointer too" {
    let selfref = EncLink {}
    selfref.children.append(selfref)
    assert(json.encode(selfref) == "{\"weight\":0,\"children\":[\"(recursion)\"]}")

    let a = EncLink {}
    let b = EncLink {}
    a.children.append(b)
    b.children.append(a)
    assert(json.encode(a) == "{\"weight\":0,\"children\":[{\"weight\":0,\"children\":[\"(recursion)\"]}]}")
    assert(json.encode(json.from(a)) == "{\"weight\":0,\"children\":[{\"weight\":0,\"children\":[\"(recursion)\"]}]}")
    // Converted first, the same node is still only printed once.
    assert(json.encode(enc_deep_link(2)) == "{\"weight\":0,\"children\":[{\"weight\":0,\"children\":[{\"weight\":1,\"children\":[]}]}]}")
}

test "Json: a node shared by two parents is printed once and marked after" {
    // Encoding both copies duplicates the whole subtree, so a document that reaches one
    // node twice prints it the first time only.
    let shared = json.new_array()
    shared.values.append(json.new_int(1))
    let top = json.new_array()
    top.values.append(json.from(shared))
    top.values.append(json.from(shared))
    assert(json.encode(top) == "[[1],\"(recursion)\"]")

    let distinct = json.new_array()
    distinct.values.append(json.from(json.new_array()))
    distinct.values.append(json.from(json.new_array()))
    assert(json.encode(distinct) == "[[],[]]")

    let sibling = json.new_array()
    sibling.values.append(json.from(shared))
    sibling.values.append(json.new_string("x"))
    sibling.values.append(json.from(shared))
    assert(json.encode(sibling) == "[[1],\"x\",\"(recursion)\"]")

    let deep_child = json.new_array()
    deep_child.values.append(json.new_int(7))
    let nested = json.new_array()
    nested.values.append(json.from(deep_child))
    let diamond = json.new_object()
    diamond.values.set("shallow", json.from(deep_child))
    diamond.values.set("nested", json.from(nested))
    assert(json.encode(diamond) == "{\"shallow\":[7],\"nested\":[\"(recursion)\"]}")
    assert(json.encode(top, true) == "[\n    [\n        1\n    ],\n    \"(recursion)\"\n]")

    // 31 nodes, each reached from two parents: 2^31 visits become 31 prints, and the
    // output grows by one marker per level instead of doubling. A shared node earns the
    // same "(recursion)" text a self-loop does — only a document that merely gets too deep
    // is marked "(too deep)", and this one is 31 levels deep.
    assert(json.encode(enc_doublings(24)).bytes == 387)
    assert(json.encode(enc_doublings(30)).bytes == 483)
    assert(enc_markers(json.encode(enc_doublings(30)), "(recursion)") == 30)
    assert(enc_markers(json.encode(enc_doublings(24)), "(recursion)") == 24)
    assert(!json.encode(enc_doublings(30)).contains("(too deep)"))
    json.decode(json.encode(enc_doublings(30))) ! panic("shared-node document is not JSON")
}

test "Json: encode refuses nesting deeper than the parser accepts" {
    // JSON_MAX_DEPTH_CEILING containers is the deepest document decode will hand out, and
    // encode writes exactly that many before marking the refusal.
    assert(json.encode(enc_deep_value(3)) == "[[[[]]]]")
    assert(json.encode(enc_deep_value(999)).bytes == 2000)
    assert(enc_markers(json.encode(enc_deep_value(999)), "(too deep)") == 0)
    assert(json.encode(enc_deep_value(1000)).bytes == 2012)
    assert(enc_markers(json.encode(enc_deep_value(1000)), "(too deep)") == 1)
    // Past the limit the output stops growing, because the walk stops there.
    assert(json.encode(enc_deep_value(1500)).bytes == 2012)
    assert(json.encode(enc_deep_value(5000)).bytes == 2012)
    // And it stops at a known byte: 1000 containers are written, the marker is the 1001st
    // thing in the document, and nothing else is lost on the way.
    assert(json.encode(enc_deep_value(1500)).part(0, 1000) == enc_rep("[", 1000))
    assert(json.encode(enc_deep_value(1500)).part(1000, 12) == "\"(too deep)\"")
    assert(json.encode(enc_deep_value(1500)).part(1012, 1000) == enc_rep("]", 1000))

    // The typed path costs two containers per level, so 500 links is the same boundary.
    assert(json.encode(enc_deep_link(499)).bytes == 13888)
    assert(json.encode(enc_deep_link(500)).bytes == 13900)
    assert(enc_markers(json.encode(enc_deep_link(500)), "(too deep)") == 1)

    // Only the refused container is replaced, so the truncated document still parses.
    // It is still 1000 levels deep, so reading it back needs the parser at its ceiling.
    let cut = json.decode(json.encode(enc_deep_value(1500)), 1000) ! panic("truncated document is not JSON")
    assert(cut.is_array)
}

test "Json: scalars are never replaced by a marker" {
    // The deepest document decode accepts is 1000 containers with an int at the bottom.
    // Round-tripping it is the contract: a leaf cannot recurse, so it cannot be cut.
    let legal = json.decode(enc_deep_arrays(1000), 1000) ! panic("decode refused the legal limit")
    assert(json.encode(legal) == enc_deep_arrays(1000))
    assert(!json.encode(legal).contains("(too deep)"))
    let round = json.decode(json.encode(legal), 1000) ! panic("legal document does not round trip")
    assert(round.is_array)

    let at_limit = json.encode(enc_deep_link(499))
    assert(at_limit.contains("\"weight\":498"))
    assert(at_limit.contains("\"children\":[]"))
    assert(!at_limit.contains("(too deep)"))
    // The refused level is the 501st object; its leaf is not written at all.
    assert(!json.encode(enc_deep_link(500)).contains("\"weight\":499"))

    assert(json.encode(json.decode("[1,2,3,4,5]") ! panic("decode")) == "[1,2,3,4,5]")
    assert(json.encode(json.decode("{\"a\":[]}") ! panic("decode")) == "{\"a\":[]}")
}

test "Json: the visited set does not leak between encode calls" {
    let shared = json.new_array()
    shared.values.append(json.new_int(1))
    let top = json.new_array()
    top.values.append(json.from(shared))
    top.values.append(json.from(shared))
    assert(json.encode(top) == "[[1],\"(recursion)\"]")
    // The node that was marked in one document prints in full in the next.
    assert(json.encode(json.from(shared)) == "[1]")
    assert(json.encode(top) == "[[1],\"(recursion)\"]")
    assert(json.encode_into(json.from(shared), ByteBuffer.new(64)).into_string() == "[1]")
    // A cyclic document cannot poison a later one either.
    let ring = enc_ring()
    assert(json.encode(ring) == "{\"b\":{\"c\":{\"a\":\"(recursion)\"}}}")
    assert(json.encode(json.from(shared)) == "[1]")
    assert(json.encode(ring) == "{\"b\":{\"c\":{\"a\":\"(recursion)\"}}}")
}

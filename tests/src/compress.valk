use valk.compress
use valk.io

fn hex_bytes(text: String) String {
    let out = ByteBuffer.new(text.bytes / 2)
    let i: uint = 0
    while i + 1 < text.bytes {
        out.write_byte(ByteReader.new(text.part(i, 2)).read_hex_uint().to(u8))
        i += 2
    }
    return out.to_string()
}

fn sample_text(repeats: uint) String {
    let out = ByteBuffer.new(repeats * 60)
    let i: uint = 0
    while i < repeats {
        out.write("The quick brown fox jumps over the lazy dog ")
        out.write_uint_ascii(i * 7919 % 1000)
        out.write("\n")
        i++
    }
    return out.to_string()
}

fn noise(length: uint) String {
    let out = ByteBuffer.new(length)
    let state: uint = 12345
    let i: uint = 0
    while i < length {
        state = (state * 6364136223846793005 + 1442695040888963407) & 0xffffffffffffffff
        out.write_byte(((state >> 33) & 0xff).to(u8))
        i++
    }
    return out.to_string()
}

fn round_trip(data: String, format: compress.Format, level: uint) bool {
    let packed = compress.compress(data, format, level)
    let unpacked = compress.decompress(packed, format) !!
    return unpacked == data
}

test "Compress: checksums" {
    assert(compress.crc32("") == 0)
    assert(compress.crc32("123456789") == 0xcbf43926)
    assert(compress.crc32("The quick brown fox jumps over the lazy dog") == 0x414fa339)
    // Piecewise
    let part = compress.crc32("1234")
    assert(compress.crc32("56789", part) == 0xcbf43926)
    assert(compress.adler32("") == 1)
    assert(compress.adler32("Wikipedia") == 0x11e60398)
    let a = compress.adler32("Wiki")
    assert(compress.adler32("pedia", a) == 0x11e60398)
}

test "Compress: reference streams from zlib decode" {
    let z = hex_bytes("789ccb48cdc9c95728cf2fca4901001a0b045d")
    assert((compress.unzlib(z) !!) == "hello world")
    let raw = hex_bytes("cb48cdc9c957c8402701")
    assert((compress.inflate(raw) !!) == "hello hello hello hello")
    let gz = hex_bytes("1f8b08000000000002ff0bc94855282ccd4cce56482aca2fcf5348cbaf50c82acd2d2856c82f4b2d5228014ae72456552aa4e4a7030039a34f412b000000")
    assert((compress.gunzip(gz) !!) == "The quick brown fox jumps over the lazy dog")
    // Two gzip members read as one stream
    assert((compress.gunzip(gz + gz) !!) == "The quick brown fox jumps over the lazy dogThe quick brown fox jumps over the lazy dog")
}

test "Compress: round trips at every level and format" {
    let inputs = Array[String]{ "", "a", "abc", "hello hello hello hello", sample_text(3), sample_text(2000), noise(5000), noise(70000), sample_text(30000) }
    let formats = Array[compress.Format]{ compress.Format.deflate, compress.Format.zlib, compress.Format.gzip }
    each inputs as input {
        each formats as format {
            assert(round_trip(input, format, 0))
            assert(round_trip(input, format, 1))
            assert(round_trip(input, format, 6))
            assert(round_trip(input, format, 9))
        }
    }
    // Repetitive text compresses well; noise does not grow much
    let text = sample_text(2000)
    assert(compress.deflate(text).bytes < text.bytes / 4)
    let random = noise(5000)
    assert(compress.deflate(random).bytes <= random.bytes + 40)
}

test "Compress: streaming writer and reader" {
    let data = sample_text(5000)
    let packed = ByteBuffer.new()
    let writer = compress.Compressor.new(packed, compress.Format.gzip)
    // Odd write sizes cross the internal block boundaries
    let offset: uint = 0
    let step: uint = 1
    while offset < data.bytes {
        let count = step
        if count > data.bytes - offset : count = data.bytes - offset
        writer.write(data.to_slice().view(offset, count)) !!
        offset += count
        step = step * 3 + 1
        if step > 50000 : step = 7
    }
    writer.close() !!
    assert((compress.gunzip(packed) !!) == data)

    let reader = compress.Decompressor.new(ByteReader.new(packed.to_slice()), compress.Format.gzip)
    let out = ByteBuffer.new()
    let chunk = [u8]{ 0 x 1000 }
    while true {
        let count = reader.read(chunk) !!
        if count == 0 : break
        out.write(chunk.view(0, count))
    }
    assert(out.to_string() == data)
    assert(reader.consumed() == packed.length)
}

test "Compress: malformed input" {
    let truncated = false
    compress.gunzip(hex_bytes("1f8b08000000000002ff0bc948")) ! { truncated = error_is(E.code, truncated) }
    assert(truncated)

    let invalid = false
    compress.unzlib("not a zlib stream at all") ! { invalid = error_is(E.code, invalid_input) }
    assert(invalid)

    let checksum = false
    let z = hex_bytes("789ccb48cdc9c95728cf2fca4901001a0b045e")
    compress.unzlib(z) ! { checksum = error_is(E.code, checksum) }
    assert(checksum)

    let too_large = false
    compress.inflate(compress.deflate(sample_text(100)), 100) ! { too_large = error_is(E.code, too_large) }
    assert(too_large)

    let garbage = false
    compress.inflate(noise(300)) ! { garbage = true }
    assert(garbage)
}

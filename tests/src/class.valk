
class ClassTest {
    value: int (5)

    get val : int {
        return this.value + 2
    }
    group sub {
        get val : int {
            return this.value + 20
        }
        static get stat : int {
            return 40
        }
    }
}

struct ClassGcStructTest {
    value: int (0)
}

struct RecursiveStructA {
    next: RecursiveStructB
}

struct RecursiveStructB {
    next: RecursiveStructA
}

class ClassImplicitDefaults {
    skipped: int
    integer: int
    unsigned: uint
    decimal: float
    flag: bool
    optional: ?ClassTest
}

class ClassInitFactory {
    value: int (7)

    static fn new() SELF {
        return SELF { value: 99 }
    }
}

class ClassInitListDefaults {
    value: int (5)

    + fn append(value: int) SELF $append {
        this.value += value
        return this
    }
}

test "Class syntax" {
    let x = ClassTest{}
    assert(x.value == 5)
    assert(x.val == 7)
    assert(x.sub.val == 25)
    assert(ClassTest.sub.stat == 40)
}

test "Class initializer fills implicit defaults" {
    let value = ClassImplicitDefaults {
        skipped: @undefined
    }
    assert(value.integer == 0)
    assert(value.unsigned == 0)
    assert(value.decimal == 0)
    assert(!value.flag)
    assert(!isset(value.optional))
}

test "Class initializers use property defaults" {
    let value = ClassInitFactory {}
    let explicit_factory = ClassInitFactory.new()
    let list = ClassInitListDefaults { 2 }

    assert(value.value == 7)
    assert(explicit_factory.value == 99)
    assert(list.value == 7)
}

synctest "Class GC type classification" {
    let managed = ClassTest{}
    let pointer: *ClassTest = @undefined
    let native_struct = ClassGcStructTest{}

    #if typeof(managed).$is_gc
    assert(true)
    #else
    assert(false)
    #end

    #if typeof(pointer).$is_gc
    assert(false)
    #else
    assert(true)
    #end

    #if typeof(native_struct).$is_gc
    assert(false)
    #else
    assert(true)
    #end
}

test "Recursive struct pointers without managed references" {
    let value: RecursiveStructA = @undefined
    value = @undefined
    assert(true)
}

fn contained_pointer_read(value: local mut &u8) u8 {
    {
        @unsafe
        {
            let raw: ptr = value
            return raw.@cast(*[u8])[0]
        }
    }
}

test "Unsafe scope contains caller-dependent operations" {
    let value: u8 = 7
    assert(contained_pointer_read(&value) == value)
}

fn unsafe_first_byte(text: String) u8 @unsafe {
    return text.data_cstring.get(0)
}

class UnsafeFlagged {
    + get first: u8 @unsafe {
        return 3
    }
}

test "Functions marked @unsafe can be used inside an unsafe scope" {
    @unsafe
    assert(unsafe_first_byte("abc") == 'a')
    let read = unsafe_first_byte
    assert(read("xyz") == 'x')
    assert(UnsafeFlagged{}.first == 3)
}

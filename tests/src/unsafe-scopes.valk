fn contained_pointer_read(value: &u8) u8 {
    {
        @unsafe
        {
            let raw: ptr = value
            return raw.@cast(*[u8])[0]
        }
    }
}

test "Unsafe scope contains caller-dependent operations" {
    let value: u8 = 7
    assert(contained_pointer_read(&value) == value)
}

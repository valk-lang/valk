
use valk.gc

error DeferTestError (failed)

class DeferGcValue {
    value: String
}

fn defer_append(values: Array[String], value: String) {
    values.append(value)
}

fn defer_basic(values: Array[String]) {
    defer defer_append(values, "first")
    defer defer_append(values, "second")
    values.append("body")
}

fn defer_early_return(values: Array[String], stop: bool) {
    defer defer_append(values, "outer")
    if stop {
        defer defer_append(values, "branch")
        return
    }
    values.append("continued")
}

fn defer_conditional(values: Array[String], enabled: bool) {
    if enabled : defer defer_append(values, "conditional")
    defer defer_append(values, "always")
}

fn defer_loop(values: Array[String]) {
    let i: uint = 0
    while i < 3 {
        let captured = "loop-" + i
        defer defer_append(values, captured)
        i++
    }
}

fn defer_captures_registration_value(values: Array[String]) {
    let value = "before"
    defer defer_append(values, value)
    value = "after"
}

fn defer_on_error(values: Array[String]) !DeferTestError {
    defer defer_append(values, "error")
    throw .failed
}

fn defer_generic(value: $T, values: Array[String]) {
    defer defer_append(values, "generic-" + value)
}

fn defer_gc_append(values: Array[String], value: DeferGcValue) {
    gc.collect()
    values.append(value.value)
}

fn defer_gc_root(values: Array[String]) {
    let value = DeferGcValue { value: "rooted" }
    defer defer_gc_append(values, value)
    value = null.@cast(DeferGcValue)
    gc.collect()
}

test "Defer: LIFO order and fallthrough" {
    let values = Array[String]{}
    defer_basic(values)
    assert(values.length == 3)
    assert((values[0] !!) == "body")
    assert((values[1] !!) == "second")
    assert((values[2] !!) == "first")
}

test "Defer: early return and conditional registration" {
    let values = Array[String]{}
    defer_early_return(values, true)
    assert(values.length == 2)
    assert((values[0] !!) == "branch")
    assert((values[1] !!) == "outer")

    let skipped = Array[String]{}
    defer_conditional(skipped, false)
    assert(skipped.length == 1)
    assert((skipped[0] !!) == "always")
}

test "Defer: loop registrations are independent" {
    let values = Array[String]{}
    defer_loop(values)
    assert(values.length == 3)
    assert((values[0] !!) == "loop-2")
    assert((values[1] !!) == "loop-1")
    assert((values[2] !!) == "loop-0")
}

test "Defer: captures values when registered" {
    let values = Array[String]{}
    defer_captures_registration_value(values)
    assert(values.length == 1)
    assert((values[0] !!) == "before")
}

test "Defer: runs when returning an error" {
    let values = Array[String]{}
    defer_on_error(values) _
    assert(values.length == 1)
    assert((values[0] !!) == "error")
}

test "Defer: generic specializations have independent closures" {
    let values = Array[String]{}
    defer_generic("string", values)
    defer_generic(7, values)
    assert(values.length == 2)
    assert((values[0] !!) == "generic-string")
    assert((values[1] !!) == "generic-7")
}

synctest "Defer: captured values stay rooted during cleanup" {
    let values = Array[String]{}
    defer_gc_root(values)
    assert(values.length == 1)
    assert((values[0] !!) == "rooted")
}

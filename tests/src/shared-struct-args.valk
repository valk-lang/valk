use valk.sync
use valk.thread

// A struct carrying references keeps its `shared` view in property, nullable
// and generic positions, so storing one publishes the graph it reaches.

class StructArgItem {
    names: Array[String] (.{})
    n: uint (1)
}
struct StructArgPair {
    item: StructArgItem
    tag: uint
}
class StructArgHub {
    last: ?shared StructArgPair (null)
    pairs: Array[shared StructArgPair] (.{})
    fn keep(p: shared StructArgPair) { this.pairs.append(p) }
    fn set_last(p: shared StructArgPair) { this.last = p }
}

shared STRUCT_ARG_INBOX: sync.Channel[shared StructArgPair] (sync.Channel[shared StructArgPair].new(16) !!)
fn struct_arg_send(p: shared StructArgPair) { STRUCT_ARG_INBOX.try_send(p) _ }
fn struct_arg_read(p: shared StructArgPair) uint { return p.item.n + p.tag }

test "Shared struct args: stored in nullable and generic positions" {
    let h = StructArgHub {}
    let p = StructArgPair { item: StructArgItem { n: 3 }, tag: 1 }
    p.item.names.append("a")
    h.keep(p)
    let q = StructArgPair { item: StructArgItem { n: 5 }, tag: 2 }
    h.set_last(q)

    assert(h.pairs.length == 1)
    let first = h.pairs[0]
    assert(first.item.n == 3)
    assert(first.item.names[0] == "a")
    let total: uint = 0
    each h.pairs as pair : total += pair.item.n + pair.tag
    assert(total == 4)
    let last = h.last ?! panic("missing last")
    assert(last.item.n == 5)
    assert(last.tag == 2)

    // A reader only borrows: the local stays usable
    let r = StructArgPair { item: StructArgItem { n: 7 }, tag: 1 }
    assert(struct_arg_read(r) == 8)
    r.item.n = 8
    assert(struct_arg_read(r) == 9)
}

test "Shared struct args: read on another thread" {
    let p = StructArgPair { item: StructArgItem { n: 4 }, tag: 3 }
    p.item.names.append("x")
    struct_arg_send(p)

    let t = thread.start(fn() {
        let got = STRUCT_ARG_INBOX.try_recv() ! panic("nothing sent")
        assert(got.item.n == 4)
        assert(got.item.names[0] == "x")
        assert(got.tag == 3)
        let local = StructArgPair { item: StructArgItem { n: 9 }, tag: 0 }
        struct_arg_send(local)
    }) !!
    t.await()

    let back = STRUCT_ARG_INBOX.try_recv() ! panic("nothing sent back")
    assert(back.item.n == 9)
}

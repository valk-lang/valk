use valk.gc

struct EbLarge {
    a: int (0)
    pad: [u64 x 16]
    label: String ("")

    fn sum() int {
        return this.a + this.pad[0].to(int) + this.pad[15].to(int)
    }

    fn bump(delta: int) {
        this.a += delta
    }
}

class EbHolder {
    items: [EbLarge x 2]
}

fn eb_read_one(item: local &EbLarge) int {
    return item.a
}

fn eb_mutate_one(item: local mut &EbLarge, delta: int) {
    item.a += delta
}

fn eb_sum_slice(items: local &[EbLarge]) int {
    let total = 0
    each items as &item, i {
        total += eb_read_one(item) + i.to(int)
    }
    return total
}

fn eb_bump_slice(items: local mut &[EbLarge], delta: int) {
    each items as mut &item {
        eb_mutate_one(item, delta)
    }
}

fn eb_sum_bounded(items: local &[EbLarge x 2]) int {
    let total = 0
    each items as &item {
        total += item.sum()
    }
    return total
}

fn eb_bump_bounded(items: local mut &[EbLarge x 2]) {
    each items as mut &item {
        item.bump(5)
    }
}

test "Each borrow: Array elements read, mutate, skip, and region-safe String writes" {
    let arr = Array[EbLarge]{
        EbLarge { a: 1, label: "one" }
        EbLarge { a: 2, label: "two" }
        EbLarge { a: 3, label: "three" }
    }

    let read_sum = 0
    each arr as &item, i {
        read_sum += item.a + i.to(int)
    }
    assert(read_sum == 9)

    each arr as mut &item, i {
        item.a *= 10
        item.pad[0] = i
        item.pad[15] = i + 1
        item.label = item.label + "!"
    }
    assert(arr[0].a == 10 && arr[1].a == 20 && arr[2].a == 30)
    assert(arr[0].label == "one!" && arr[1].label == "two!" && arr[2].label == "three!")
    assert(arr[2].sum() == 35)

    // skip + break + continue
    let skipped = 0
    each arr skip 1 as &item, idx {
        if idx == 1 : continue
        skipped += item.a
        break
    }
    assert(skipped == 30)

    // Empty array executes 0 iterations
    let empty = Array[EbLarge]{}
    let count = 0
    each empty as &item {
        count += item.a
    }
    assert(count == 0)
}

test "Each borrow: slices, fixed arrays, heap-owned fixed arrays, and primitives" {
    let arr = Array[EbLarge]{
        EbLarge { a: 10, label: "a" }
        EbLarge { a: 20, label: "b" }
    }
    assert(eb_sum_slice(arr) == 31)
    let mslice: mut &[EbLarge] = arr.view(0, arr.length)
    eb_bump_slice(mslice, 7)
    assert(arr[0].a == 17 && arr[1].a == 27)

    let fixed: [EbLarge x 2] = .{
        EbLarge { a: 5, label: "x" }
        EbLarge { a: 6, label: "y" }
    }
    each fixed as mut &item {
        item.a += 100
        item.label = item.label + "!"
    }
    assert(fixed[0].a == 105 && fixed[1].a == 106)
    assert(fixed[0].label == "x!" && fixed[1].label == "y!")

    eb_bump_bounded(&fixed)
    assert(eb_sum_bounded(&fixed) == 221)

    // Heap object holding an inline fixed array: GC owner must stay tracked on String writes
    let holder = EbHolder {
        items: .{
            EbLarge { a: 1, label: "h0" }
            EbLarge { a: 2, label: "h1" }
        }
    }
    each holder.items as mut &item, i {
        item.label = item.label + "_" + i
    }
    gc.collect()
    assert(holder.items[0].label == "h0_0" && holder.items[1].label == "h1_1")

    // Primitive elements
    let nums = Array[int]{ 1, 2, 3 }
    each nums as mut &n, i {
        n[0] += i.to(int) * 10
    }
    assert(nums[0] == 1 && nums[1] == 12 && nums[2] == 23)
}

test "Regions: mutating String field through element borrow in loop stays valid" {
    let arr = Array[EbLarge]{
        EbLarge { a: 1, label: "alpha" }
        EbLarge { a: 2, label: "beta" }
        EbLarge { a: 3, label: "gamma" }
    }
    let i: uint = 0
    while i < arr.length {
        let item = &arr[i]
        item.label = item.label + "!"
        i++
    }
    assert(arr[0].label == "alpha!")
    assert(arr[1].label == "beta!")
    assert(arr[2].label == "gamma!")
}

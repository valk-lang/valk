use valk.gc

class BorrowEvalItem { number: int }
class BorrowEvalHolder { values: Array[int] }
class BorrowEvalFactory {
    calls: int (0)
    indices: int (0)
    fn array() Array[int] {
        this.calls++
        return Array[int]{ this.calls, 19 }
    }
    fn slice() Slice[int] {
        this.calls++
        return Slice[int]{ this.calls, 19 }
    }
    fn arrays() Array[Array[int]] {
        this.calls++
        return Array[Array[int]]{ Array[int]{ this.calls } }
    }
    fn holder() BorrowEvalHolder {
        this.calls++
        return BorrowEvalHolder { values: Array[int]{ this.calls } }
    }
    fn objects() Array[BorrowEvalItem] {
        this.calls++
        return Array[BorrowEvalItem]{ BorrowEvalItem { number: this.calls } }
    }
    fn index() uint {
        this.indices++
        return 0
    }
}

test "Borrows: temporary arrays and slices are evaluated once" {
    let factory = BorrowEvalFactory {}
    let array_item = &factory.array()[factory.index()]
    assert(factory.calls == 1 && factory.indices == 1)
    assert(array_item[0] == 1)
    let slice_item = &factory.slice()[factory.index()]
    assert(factory.calls == 2 && factory.indices == 2)
    assert(slice_item[0] == 2)
    let range = &factory.array()[0..1]
    assert(factory.calls == 3)
    assert(range.length == 1 && range[0] == 3)
    gc.collect()
    assert(array_item[0] == 1 && slice_item[0] == 2 && range[0] == 3)
}

test "Borrows: checked nested elements preserve their setup" {
    let factory = BorrowEvalFactory {}
    let nested = &factory.arrays()[factory.index()][factory.index()]
    assert(factory.calls == 1 && factory.indices == 2)
    assert(nested[0] == 1)
    let property = &factory.holder().values[factory.index()]
    assert(factory.calls == 2 && factory.indices == 3)
    assert(property[0] == 2)
    gc.collect()
    assert(nested[0] == 1 && property[0] == 2)
}

test "Borrows: temporary array slots retain their actual storage owner" {
    let factory = BorrowEvalFactory {}
    let element = &factory.objects()[factory.index()]
    assert(factory.calls == 1 && factory.indices == 1)
    assert(element[0].number == 1)
    factory = BorrowEvalFactory {}
    gc.collect()
    element[0] = BorrowEvalItem { number: 73 }
    gc.collect()
    assert(element[0].number == 73)
}

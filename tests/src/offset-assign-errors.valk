error SlotError (full)

class Slots {
    items: Array[int] (.{ 0, 0 })

    // A throwing `$offset_assign` hook
    fn set(index: uint, value: int) !SlotError $offset_assign {
        if index >= this.items.length : throw .full
        this.items.set(index, value) ! throw .full
    }
    fn get(index: uint) int $offset {
        return this.items.get(index) !? -1
    }
}

fn risky(value: int) int !SlotError {
    if value < 0 : throw .full
    return value
}

fn fill_all(slots: Slots) !SlotError {
    // No handler: the error passes to the caller
    slots[0] = 1
    slots[5] = 2
}

test "Offset assign: throwing hooks take a handler on the assignment" {
    let slots = Slots {}
    slots[0] = 7 !!
    let failed = false
    slots[9] = 1 ! { failed = error_is(E.code, full) }
    assert(failed)
    slots[9] = 1 ! failed = false
    assert(!failed)
    slots[1] = 3 !? _
    assert(slots[1] == 3)
    slots[9] = 3 !? _
    // A handler after a throwing right-hand side belongs to that value;
    // parentheses let the assignment take its own
    slots[1] = (risky(-1) !? 8) !!
    assert(slots[1] == 8)
    slots[1] = (risky(4) !? 8) !!
    assert(slots[1] == 4)
    slots[9] = (risky(4) !? 8) !? _
    assert(slots[1] == 4)
    let passed = false
    fill_all(slots) ! { passed = error_is(E.code, full) }
    assert(passed)
    assert(slots[0] == 1)

    // Deque assignment reports an out-of-range index instead of ignoring it
    let deque = Deque[int]{ 1, 2 }
    deque[0] = 5 !!
    let missing = false
    deque[2] = 9 ! { missing = error_is(E.code, missing) }
    assert(missing)
    assert((deque.get(0) !? 0) == 5)
}

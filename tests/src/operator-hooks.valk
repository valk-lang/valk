class OperatorCounter {
    count: int (23)

    fn add(amount: int) int $add {
        this.count += amount
        return this.count
    }

    fn equal(other: int) bool $eq { return this.count == other }
}

class OperatorHolder { counter: OperatorCounter (.{}) }

class OperatorRawPointer {
    fn add(value: ptr) bool $add { return true }
    fn equal(value: ptr) bool $eq { return true }
}

struct OperatorCell {
    count: int (31)
    fn add(amount: int) int $add {
        this.count += amount
        return this.count
    }
}

test "Operator hooks: nonescaping receivers stay publishable" {
    let counter = OperatorCounter {}
    assert(counter + 1 == 24)
    assert(counter == 24)
    let published: shared OperatorCounter = counter
    assert(published.count == 24)
    assert(published + 2 == 26)
    assert(published.count == 26)
}

test "Operator hooks: borrowed receivers use their own storage" {
    let holder = OperatorHolder {}
    let counter = &mut holder.counter
    assert(counter + 1 == 24)
    assert(holder.counter.count == 24)
    let cell = OperatorCell {}
    let borrowed = &cell
    assert(borrowed + 2 == 33)
    assert(cell.count == 33)
}

test "Operator hooks: explicit unsafe permits raw pointer arguments" {
    let value = 1
    let pointer: *int = &value
    @unsafe {
        assert(OperatorRawPointer {} + pointer)
        assert(OperatorRawPointer {} == pointer)
    }
}

mode OperatorLower for String { fn dummy() {} }

class OperatorAddModes {
    fn add_str(cmp: String) String $add { return "String" }
    fn add_lower(cmp: OperatorLower) String $add { return "Lower" }
}
class OperatorAddModesFlipped {
    fn add_lower(cmp: OperatorLower) String $add { return "Lower" }
    fn add_str(cmp: String) String $add { return "String" }
}

test "Operator hooks: exact static type wins for $add" {
    let s: String = "a"
    let l: OperatorLower = "a"
    let a = OperatorAddModes {}
    assert(a + s == "String")
    assert(a + l == "Lower")
    assert(a + "lit" == "String")
    let b = OperatorAddModesFlipped {}
    assert(b + s == "String")
    assert(b + l == "Lower")
    assert(b + "lit" == "String")
}


use valk.fs

test "fs: Resolve" {
    let p1 = fs.path(".").resolve()
    #if OS == "win"
    assert(p1.range(1, 1) == ":" || p1.starts_with("\\"))
    #else
    assert(!p1.contains(".") && p1.starts_with("/"))
    #end

    let p2 = fs.path("/etc///ssl/").resolve()
    #if OS == "win"
    assert((p2.range(1, 1) == ":" || p2.starts_with("\\")) && !p2.ends_with("\\") && !p2.ends_with("/"))
    #elif OS == "macos"
    // macOS symlinks /etc to /private/etc
    assert(p2 == "/etc/ssl" || p2 == "/private/etc/ssl")
    #else
    assert(p2 == "/etc/ssl")
    #end

    #if OS == "win"
    let p3 = fs.path("C:/etc///ssl\\//").resolve()
    assert(p3 == "C:\\etc\\ssl")

    let p4 = p3.pop()
    assert(p4 == "C:\\etc")
    p4 = p4.pop()
    assert(p4 == "C:\\")
    p4 = p4.pop()
    assert(p4 == "C:\\") // Result should stay the same
    p4 = p4.add("test")
    assert(p4 == "C:\\test")
    #else
    // A backslash and a drive-like colon are ordinary name bytes outside Windows
    let base = fs.cwd() ! panic("Failed to get cwd")
    assert(fs.path("C:/etc///ssl\\//").resolve() == fs.add(base, "C:/etc/ssl\\"))
    assert(fs.resolve("/etc/a\\b") == "/etc/a\\b")
    #end

    let p5 = (fs.path("/").resolve()).pop()
    #if OS == "win"
    assert(p5.range(1, 1) == ":" || p5.starts_with("\\"))
    #else
    assert(p5 == "/")
    #end

    // Dots fold without touching the file system
    let cwd = fs.cwd() ! panic("Failed to get cwd")
    assert(fs.resolve("./does-not-exist/../also-missing/./x") == fs.add(cwd, "also-missing" + fs.PATH_DIV + "x"))
    assert(fs.resolve("sub/dir/..") == fs.add(cwd, "sub"))
    assert(fs.resolve("..") == fs.dir_of(cwd))
    #if OS == "win"
    assert(fs.resolve("C:/a/../../..") == "C:\\")
    assert(fs.resolve("C:/a/./b/") == "C:\\a\\b")
    #else
    assert(fs.resolve("/a/../../..") == "/")
    assert(fs.resolve("/a/./b/") == "/a/b")
    #end
}

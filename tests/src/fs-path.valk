
use valk.fs

test "fs: Resolve" {
    let p1 = fs.path(".").resolve()
    #if OS == "win"
    assert(p1.range(1, 1) == ":" || p1.starts_with("\\"))
    #else
    assert(!p1.contains(".") && p1.starts_with("/"))
    #end

    let p2 = fs.path("/etc///ssl/").resolve()
    #if OS == "win"
    assert((p2.range(1, 1) == ":" || p2.starts_with("\\")) && !p2.ends_with("\\") && !p2.ends_with("/"))
    #elif OS == "macos"
    // macOS symlinks /etc to /private/etc
    assert(p2 == "/etc/ssl" || p2 == "/private/etc/ssl")
    #else
    assert(p2 == "/etc/ssl")
    #end

    #if OS == "win"
    let p3 = fs.path("C:/etc///ssl\\//").resolve()
    assert(p3 == "C:\\etc\\ssl")

    let p4 = p3.pop()
    assert(p4 == "C:\\etc")
    p4 = p4.pop()
    assert(p4 == "C:\\")
    p4 = p4.pop()
    assert(p4 == "C:\\") // Result should stay the same
    p4 = p4.add("test")
    assert(p4 == "C:\\test")
    #else
    // A backslash and a drive-like colon are ordinary name bytes outside Windows
    let base = fs.cwd() ! panic("Failed to get cwd")
    assert(fs.path("C:/etc///ssl\\//").resolve() == fs.add(base, "C:/etc/ssl\\"))
    assert(fs.resolve("/etc/a\\b") == "/etc/a\\b")
    #end

    let p5 = (fs.path("/").resolve()).pop()
    #if OS == "win"
    assert(p5.range(1, 1) == ":" || p5.starts_with("\\"))
    #else
    assert(p5 == "/")
    #end

    // Dots fold without touching the file system
    let cwd = fs.cwd() ! panic("Failed to get cwd")
    assert(fs.resolve("./does-not-exist/../also-missing/./x") == fs.add(cwd, "also-missing" + fs.PATH_DIV + "x"))
    assert(fs.resolve("sub/dir/..") == fs.add(cwd, "sub"))
    assert(fs.resolve("..") == fs.dir_of(cwd))
    #if OS == "win"
    assert(fs.resolve("C:/a/../../..") == "C:\\")
    assert(fs.resolve("C:/a/./b/") == "C:\\a\\b")
    #else
    assert(fs.resolve("/a/../../..") == "/")
    assert(fs.resolve("/a/./b/") == "/a/b")
    #end
}

test "fs: resolve folds repeated leading separators" {
    #if OS == "win"
    assert(fs.resolve("\\\\a") == "\\\\a")
    #else
    // Only exactly two leading separators are the POSIX special root
    assert(fs.resolve("//a") == "//a")
    assert(fs.resolve("///a") == "/a")
    assert(fs.resolve("////a") == "/a")
    assert(fs.resolve("///") == "/")
    assert(fs.resolve("///a//b") == "/a/b")
    assert(fs.resolve("///..") == "/")
    assert(fs.resolve("///.") == "/")
    #end
}

test "fs: add with an empty directory keeps the name relative" {
    assert(fs.add("", "x") == "x")
    assert(fs.add("", "a/b") == "a/b")
    assert(fs.add("dir", "x") == "dir" + fs.PATH_DIV + "x")
}

test "fs: add never doubles the separator at the joint" {
    let dir = "a" + fs.PATH_DIV
    let joined = "a" + fs.PATH_DIV + "b"
    assert(fs.add(dir, "b") == joined)
    assert(fs.add(dir, fs.PATH_DIV + "b") == joined)
    assert(fs.add(dir, fs.PATH_DIV + fs.PATH_DIV + "b") == joined)
    // Stripping one kind of separator used to leave the other kind, which then
    // doubled the joint
    assert(fs.add(dir, fs.PATH_DIV_REPLACE + fs.PATH_DIV + "b") == joined)
    assert(fs.add(dir, fs.PATH_DIV + fs.PATH_DIV_REPLACE + "b") == joined)
    // A run on both sides of the joint, from the fix that first stripped one kind
    assert(fs.add("/etc/", fs.PATH_DIV_REPLACE + fs.PATH_DIV + "passwd") == "/etc/passwd")
}

test "fs: add collapses a run of separators at the joint" {
    let joined = "a" + fs.PATH_DIV + "b"
    // A run on either side, and on both, leaves one separator
    assert(fs.add("a" + fs.PATH_DIV + fs.PATH_DIV, "b") == joined)
    assert(fs.add("a" + fs.PATH_DIV + fs.PATH_DIV + fs.PATH_DIV, "b") == joined)
    assert(fs.add("a", fs.PATH_DIV + fs.PATH_DIV + "b") == joined)
    assert(fs.add("a" + fs.PATH_DIV + fs.PATH_DIV, fs.PATH_DIV + fs.PATH_DIV + "b") == joined)
    // One separator each is already a single joint
    assert(fs.add("a" + fs.PATH_DIV, fs.PATH_DIV + "b") == joined)

    // The joint keeps the byte the caller wrote instead of rewriting it to PATH_DIV:
    // outside Windows a backslash is an ordinary name byte, so rewriting it renames
    let other_joined = "a" + fs.PATH_DIV_REPLACE + "b"
    assert(fs.add("a", fs.PATH_DIV_REPLACE + fs.PATH_DIV_REPLACE + "b") == other_joined)
    assert(fs.add("a" + fs.PATH_DIV_REPLACE + fs.PATH_DIV_REPLACE, "b") == other_joined)
    assert(fs.add("a" + fs.PATH_DIV_REPLACE, fs.PATH_DIV_REPLACE + "b") == other_joined)

    // A run mixed with the other kind keeps the platform separator, so the two sides stay
    // apart and the order inside the run does not decide the result
    assert(fs.add("a", fs.PATH_DIV_REPLACE + fs.PATH_DIV + fs.PATH_DIV + "b") == joined)
    assert(fs.add("a" + fs.PATH_DIV + fs.PATH_DIV_REPLACE, "b") == joined)
    assert(fs.add("a" + fs.PATH_DIV_REPLACE + fs.PATH_DIV, "b") == joined)
    assert(fs.add("a", fs.PATH_DIV_REPLACE + fs.PATH_DIV + "b") == joined)
    assert(fs.add("a", fs.PATH_DIV + fs.PATH_DIV_REPLACE + "b") == joined)
    // The dir's run is what holds the joint here, and its separator survives
    assert(fs.add("a" + fs.PATH_DIV + fs.PATH_DIV_REPLACE + fs.PATH_DIV, "b") == joined)
}

test "fs: add keeps a dir of separators whole" {
    #if OS == "win"
    // A drive root keeps its separator, and the joined name is appended to it
    assert(fs.add("C:\\", "test") == "C:\\test")
    assert(fs.add("C:\\", "\\test") == "C:\\test")
    assert(fs.add("C:\\", "\\\\test") == "C:\\test")
    #else
    // `//` is the POSIX special root, so it must not collapse to `/`
    assert(fs.add("//", "b") == "//b")
    assert(fs.add("//", "//b") == "//b")
    assert(fs.add("/", "b") == "/b")
    assert(fs.add("/", "/b") == "/b")
    assert(fs.add("///", "b") == "///b")
    #end
}

test "fs: basename of a path without a separator is the whole path" {
    assert(fs.basename("nginx.conf") == "nginx.conf")
    assert(fs.basename("etc/nginx.conf") == "nginx.conf")
    assert(fs.basename("nginx/") == "nginx")
    assert(fs.basename("/") == "")
}

test "fs: dir_of a bare name is the current directory" {
    assert(fs.dir_of("etc") == ".")
    assert(fs.dir_of("etc/") == ".")
    assert(fs.dir_of("a/b") == "a")
    assert(fs.dir_of("/etc") == "/")
    assert(fs.dir_of("/") == "/")
    assert(fs.dir_of("") == "")
    // A run of separators is one separator: the parent ends before all of it
    assert(fs.dir_of("a//b") == "a")
    assert(fs.dir_of("/a//") == "/")
    assert(fs.dir_of("/etc/nginx//") == "/etc")
    assert(fs.dir_of("a///") == ".")
    assert(fs.dir_of("///") == "///")
    #if OS == "win"
    assert(fs.dir_of("C:\\etc") == "C:\\")
    assert(fs.dir_of("C:\\") == "C:\\")
    assert(fs.dir_of("C:") == "C:")
    assert(fs.dir_of("C:\\etc\\\\") == "C:\\")
    assert(fs.dir_of("C:\\\\etc") == "C:\\")
    #end
}

#if OS != "win"
test "fs: realpath keeps a backslash as part of a name" {
    let path = temp_path("fs-realpath-back\\slash.txt")
    fs.write(path, "x") ! assert(false)
    let real = fs.realpath(path) ! { assert(false); return }
    fs.delete_file(path) ! assert(false)
    assert(real.ends_with("fs-realpath-back\\slash.txt"))
    let missing = fs.realpath("missing\\name") !? ""
    assert(missing == "missing\\name")
}
#end

test "fs: resolve keeps drive roots and platform separators" {
    #if OS == "win"
    assert(fs.resolve("C:\\") == "C:\\")
    assert(fs.resolve("C:") == "C:\\")
    assert(fs.resolve("C:/a/..") == "C:\\")
    assert(fs.resolve("c:/a/b") == "c:\\a\\b")
    #else
    let cwd = fs.cwd() ! { assert(false); return }
    assert(fs.resolve("/a\\b/c") == "/a\\b/c")
    assert(fs.resolve("C:/x") == fs.add(cwd, "C:/x"))
    assert(fs.resolve("a:b") == fs.add(cwd, "a:b"))
    #end
}

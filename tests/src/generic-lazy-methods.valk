
// A method of a generic type is only checked when it is used: one naming an ever-deeper
// specialization of its own type is fine as long as nothing calls it
struct LazyPairs[T] {
    v: T
    fn dup() LazyPairs[(T, T)] { return LazyPairs[(T, T)] { v: (this.v, this.v) } }
}

test "Generics: unused methods of a specialization are not instantiated" {
    let p = LazyPairs[int] { v: 3 }
    assert(p.v == 3)
    // One level is used, the next one's `dup` is not
    let q = p.dup()
    assert(q.v[0] == 3 && q.v[1] == 3)
}

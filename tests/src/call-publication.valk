class CallPublicationItem {
    number: int
    fn bump(extra: int) int { this.number += extra; return this.number }
}
shared call_publication_saved: ?CallPublicationItem (null)
fn call_publish(item: shared CallPublicationItem) int { call_publication_saved = item; return 1 }
fn call_mutate(item: CallPublicationItem, extra: int) int { item.number += extra; return item.number }
fn call_scalar(value: int, extra: int) int { return value + extra }
fn call_shared(item: shared CallPublicationItem, extra: int) int { return item.number + extra }

synctest "Call publication: replacement preserves an earlier ordinary argument" {
    let source = CallPublicationItem { number: 73 }
    let result = call_mutate(source, <{
        source = CallPublicationItem { number: 79 }
        return call_publish(source)
    })
    assert(result == 74)
    assert((call_publication_saved ?? panic("missing")).number == 79)
    call_publication_saved = null
}

synctest "Call publication: replacement preserves an earlier method receiver" {
    let source = CallPublicationItem { number: 73 }
    let result = source.bump(<{
        source = CallPublicationItem { number: 83 }
        return call_publish(source)
    })
    assert(result == 74)
    assert((call_publication_saved ?? panic("missing")).number == 83)
    call_publication_saved = null
}

synctest "Call publication: a copied scalar does not borrow the graph" {
    let source = CallPublicationItem { number: 89 }
    assert(call_scalar(source.number, call_publish(source)) == 90)
    assert((call_publication_saved ?? panic("missing")).number == 89)
    call_publication_saved = null
}

synctest "Call publication: shared arguments can overlap publication" {
    let source = CallPublicationItem { number: 97 }
    assert(call_shared(source, call_publish(source)) == 98)
    assert((call_publication_saved ?? panic("missing")).number == 97)
    call_publication_saved = null
}

synctest "Call publication: unrelated ordinary arguments remain usable" {
    let left = CallPublicationItem { number: 11 }
    let right = CallPublicationItem { number: 13 }
    assert(call_mutate(left, call_publish(right)) == 12)
    assert((call_publication_saved ?? panic("missing")).number == 13)
    call_publication_saved = null
}

synctest "Call publication: argument snapshots are renewed on each iteration" {
    let index = 0
    let total = 0
    while index++ < 2 {
        let source = CallPublicationItem { number: index }
        total += call_mutate(source, <{
            source = CallPublicationItem { number: 79 }
            return call_publish(source)
        })
    }
    assert(total == 5)
    assert((call_publication_saved ?? panic("missing")).number == 79)
    call_publication_saved = null
}

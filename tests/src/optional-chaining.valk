
error OptError (missing)

class OptAddress {
    city: String
    zip: int (0)
    fn describe() String {
        return "in " + this.city
    }
}

class OptUser {
    name: String
    address: ?OptAddress (null)
    tags: Array[String] (.{})
    saves: uint (0)
    fn home() ?OptAddress {
        return this.address
    }
    fn save() {
        this.saves++
    }
    fn load(fail: bool) String !OptError {
        if fail : throw .missing
        return "loaded " + this.name
    }
}

struct OptPoint {
    x: int
    y: int
}

class OptCounter {
    calls: uint (0)
}

fn opt_user(name: String, with_address: bool) ?OptUser {
    if name == "" : return null
    let u = OptUser { name: name }
    if with_address : u.address = OptAddress { city: "Ghent", zip: 9000 }
    return u
}

fn opt_counted(counter: OptCounter, name: String) ?OptUser {
    counter.calls++
    return opt_user(name, true)
}

fn opt_arg(counter: OptCounter) bool {
    counter.calls++
    return false
}

test "Optional chaining: a null ends the whole chain" {
    let full = opt_user("ada", true)
    let homeless = opt_user("bob", false)
    let none = opt_user("", false)

    assert((full?.address?.city ?? "?") == "Ghent")
    assert((homeless?.address?.city ?? "?") == "?")
    assert((none?.address?.city ?? "?") == "?")

    // Steps after a `?.` that cannot be null use `.`; the null already stopped the chain
    assert((full?.name.length ?? 0) == 3)
    assert(!isset(none?.name.length))

    // Value types come out nullable
    let zip = full?.address?.zip
    assert(isset(zip) && zip == 9000)
    assert(!isset(homeless?.address?.zip))

    assert((full?.home()?.describe() ?? "-") == "in Ghent")
    assert((homeless?.home()?.describe() ?? "-") == "-")
    assert("%{full?.name ?? "x"}!" == "ada!")
}

test "Optional chaining: calls without a result are skipped on null" {
    let u = opt_user("ada", false)
    let none = opt_user("", false)
    u?.save()
    u?.save()
    none?.save()
    assert(u?.saves == 2)

    let tags = u?.tags
    tags?.append("x")
    assert(u?.tags.length == 1)
}

test "Optional chaining: the value is evaluated once and arguments only when used" {
    let counter = OptCounter {}
    assert((opt_counted(counter, "ada")?.address?.city ?? "") == "Ghent")
    assert(counter.calls == 1)

    let none = opt_user("", false)
    let args = OptCounter {}
    none?.load(opt_arg(args)) ! {}
    assert(args.calls == 0)
}

test "Optional chaining: error handlers and ?! inside and after a chain" {
    let u = opt_user("ada", false)
    let none = opt_user("", false)
    assert((u?.load(false) !? "failed") == "loaded ada")
    assert((u?.load(true) !? "failed") == "failed")
    assert(!isset(none?.load(true) !? "failed"))

    let names = Array[String]{}
    let users = Array[?OptUser]{ opt_user("a", true), opt_user("b", false), null }
    each users as user {
        let city = user?.address?.city ?! continue
        names.append(user?.name ?? "" + city)
    }
    assert(names.length == 1)
}

test "Optional chaining: structs, arrays and maps" {
    let p: ?OptPoint = OptPoint { x: 3, y: 4 }
    let q: ?OptPoint = null
    assert(p?.x == 3)
    assert(!isset(q?.y))

    let list: ?Array[int] = Array[int]{ 1, 2, 3 }
    let empty: ?Array[int] = null
    assert((list?.length ?? 0) == 3)
    assert((empty?.length ?? 0) == 0)
    assert((list?.get(1) !? -1) == 2)

    let scores: ?Map[int] = Map[int]{ "a" => 1 }
    assert((scores?.get("a") !? 0) == 1)
    assert(scores?.has("b") == false)
}

test "Optional chaining: a chain continued on the next line" {
    let u = opt_user("ada", true)
    let city = u
        ?.address
        ?.city
        .length
    assert(city == 5)
}

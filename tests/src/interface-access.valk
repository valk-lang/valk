interface PrivateRequirement {
    - fn reveal() int;
}

class PrivateRequirementImpl is PrivateRequirement {
    - secret: int (42)
    - fn reveal() int { return this.secret }
}

test "Interfaces: a private requirement accepts a private implementation" {
    let item = PrivateRequirementImpl {}
    assert(item.reveal() == 42)
}

// Callbacks and hooks that change the collection they were called from

class MutCount { n: int (0) }

global mut_ints: Array[int] (.{})
global mut_strings: Array[String] (.{})

test "Array sort: a comparator that empties the array" {
    mut_ints.clear()
    each 0 .. 1000 as i : mut_ints.append(1000 - i)
    let c = MutCount{}
    mut_ints.sort(fn(a: int, b: int) bool {
        c.n++
        if c.n == 1 : mut_ints.clear(true)
        return a > b
    })
    assert(mut_ints.length == 0)

    mut_strings.clear()
    each 0 .. 100 as i : mut_strings.append("s" + i)
    let d = MutCount{}
    mut_strings.sort(fn(a: String, b: String) bool {
        d.n++
        if d.n == 1 {
            mut_strings.clear(true)
            mut_strings.append("x")
        }
        return a.length > b.length
    })
    assert(mut_strings.length == 1)
}

class MutKey {
    id: int
    + fn eq(other: MutKey) bool $eq {
        if mut_keys.length > 2 : mut_keys.clear(true)
        return this.id == other.id
    }
    + fn hash() uint { return 1 }
}
global mut_keys: Array[MutKey] (.{})
global mut_map: HashMap[MutKey, int] (.{})

test "Array: a $eq that empties the array" {
    each 0 .. 64 as i : mut_keys.append(MutKey{ id: i })
    assert(!mut_keys.contains(MutKey{ id: 1000 }))
    each 0 .. 64 as i : mut_keys.append(MutKey{ id: i % 2 })
    mut_keys.remove_duplicates()
    assert(mut_keys.length <= 64)
}

class MutMapKey {
    id: int
    + fn eq(other: MutMapKey) bool $eq {
        if mut_keyed.length > 3 : mut_keyed.clear()
        return this.id == other.id
    }
    + fn hash() uint { return 1 }
}
global mut_keyed: HashMap[MutMapKey, int] (.{})

test "HashMap: a $eq that empties the map" {
    each 0 .. 64 as i : mut_keyed.set(MutMapKey{ id: i }, i)
    mut_keyed.set(MutMapKey{ id: 1000 }, 1)
    assert(!mut_keyed.has(MutMapKey{ id: 5 }))
    mut_keyed.remove(MutMapKey{ id: 7 })
}

global mut_buffer: ByteBuffer (ByteBuffer.new())
global mut_calls: int (0)
fn mut_shrink(ch: u8) bool {
    mut_calls++
    if mut_calls == 1 {
        mut_buffer.clear()
        mut_buffer.shrink_capacity(0)
    }
    return mut_calls < 2
}

test "ByteBuffer trim: a filter that empties the buffer" {
    mut_buffer.write("x")
    mut_buffer.write(" ".repeat(1000))
    mut_buffer.rtrim(mut_shrink)
    assert(mut_buffer.length == 0)
    mut_calls = 0
    mut_buffer.write(" ".repeat(1000))
    mut_buffer.ltrim(mut_shrink)
    assert(mut_buffer.length == 0)
}

fn mut_work() int { return 4 }
fn mut_start() int {
    let c = co mut_work()
    return await c
}
global mut_from_coro: int (mut_start())

test "Coroutines: co and await in a global's default" {
    assert(mut_from_coro == 4)
}

fn mut_default[T]() T { return T.$default_value }

test "Default values: tuples" {
    let pair = mut_default[(String, int)]()
    assert(pair[0] == "")
    assert(pair[1] == 0)
}

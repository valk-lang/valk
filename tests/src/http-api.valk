use valk.http
use valk.time
use valk.json
use valk.fs

fn http_api_handler(req: http.Request) http.Response {
    if req.path == "/json" : return http.Response.json_of(Map[String]{ "method" => req.method })
    if req.path == "/html" : return http.Response.new("<b>x</b>", 201, "text/html")
    return http.Response.text(req.method + "|" + req.body + "|" + (req.query().get("q") !? "-") + "|" + req.peer_address.ip())
}

test "HTTP api: method helpers, query, peer address and response constructors" {
    let server = http.Server.new("127.0.0.1", 19490, http_api_handler)
    let running = co server.start(1)
    time.sleep_ms(20)
    let base = "http://127.0.0.1:19490"

    let res = http.get(base + "/path?q=1") !!
    assert(res.status == 200)
    assert((res.headers.get("content-type") !? "") == "text/plain; charset=utf-8")
    assert(res.body == "GET||1|127.0.0.1")
    // A key without `=` has an empty value
    assert((http.get(base + "/path?a=1&&q") !!).body == "GET|||127.0.0.1")
    assert((http.post(base + "/", "payload") !!).body == "POST|payload|-|127.0.0.1")
    assert((http.put(base + "/", "p") !!).body == "PUT|p|-|127.0.0.1")
    assert((http.patch(base + "/", "p") !!).body == "PATCH|p|-|127.0.0.1")
    assert((http.delete(base + "/") !!).body == "DELETE||-|127.0.0.1")
    let head = http.head(base + "/") !!
    assert(head.status == 200 && head.body == "")

    // `post` stores the body in the options it is given
    let options = http.Options { timeout_ms: 2000 }
    http.post(base + "/", "kept", options) !!
    assert(options.body == "kept")

    let html = http.get(base + "/html") !!
    assert(html.status == 201)
    assert((html.headers.get("content-type") !? "") == "text/html")
    let encoded = http.get(base + "/json") !!
    assert((encoded.headers.get("content-type") !? "") == "application/json")
    assert((json.decode(encoded.body) !!).get_string("method") !! == "GET")

    server.request_shutdown(1000)
    await running !!
}

fn http_api_fast(ctx: http.Context, res: http.ResponseWriter) {
    res.send(ctx.peer_address.ip() + ":" + (ctx.query().get("k") !? ""), 200, "text/plain")
}

test "HTTP api: fast handlers see the peer address and use send" {
    let server = http.Server.new("127.0.0.1", 19491)
    server.fast(http_api_fast)
    let running = co server.start(1)
    time.sleep_ms(20)
    let res = http.get("http://127.0.0.1:19491/?k=v") !!
    assert(res.body == "127.0.0.1:v")
    server.request_shutdown(1000)
    await running !!
}

test "HTTP api: a missing static directory is an io error" {
    let server = http.Server.new("127.0.0.1", 19492)
    let refused = false
    server.add_static_dir("/definitely/not/a/directory") ! { refused = error_is(E.code, open) }
    assert(refused)
}

test "HTTP api: static file paths are percent-decoded" {
    let root = temp_path("http-static-" + time.mono_ms())
    let public = fs.add(root, "public")
    fs.create_dir(root) !!
    fs.create_dir(public) !!
    fs.write(fs.add(public, "my file+.txt"), "spaced") !!
    fs.write(fs.add(root, "secret.txt"), "secret") !!

    let server = http.Server.new("127.0.0.1", 19511, http_api_handler)
    server.add_static_dir(public) !!
    let running = co server.start(1)
    time.sleep_ms(20)
    let base = "http://127.0.0.1:19511"
    assert((http.get(base + "/my%20file%2B.txt") !!).body == "spaced")
    assert((http.get(base + "/my%20file+.txt") !!).body == "spaced")
    // An encoded `..` reaches the handler, not the parent directory
    assert((http.get(base + "/%2e%2e/secret.txt") !!).body.starts_with("GET|"))
    server.request_shutdown(1000)
    await running !!
    fs.delete_all(root) !!
}

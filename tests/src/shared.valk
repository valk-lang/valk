
class ShCoalesceItem { n: int (0) }
error ShCoalesceError (missing)

fn sh_coalesce_maybe(give: bool) ?ShCoalesceItem {
    if give : return ShCoalesceItem{ n: 1 }
    return null
}

fn sh_coalesce_get(ok: bool) ShCoalesceItem !ShCoalesceError {
    if !ok : throw .missing
    return ShCoalesceItem{ n: 2 }
}

test "Shared: a fresh value from '??' or '!?' can be published" {
    let a: shared ShCoalesceItem = sh_coalesce_maybe(false) ?? ShCoalesceItem{ n: 5 }
    let b: shared ShCoalesceItem = sh_coalesce_maybe(true) ?? panic("missing")
    let c: shared ShCoalesceItem = sh_coalesce_get(false) !? ShCoalesceItem{ n: 7 }
    let d: shared ShCoalesceItem = sh_coalesce_get(true) !? ShCoalesceItem{ n: 9 }
    assert(a.n + b.n + c.n + d.n == 15)
}

class ShCaptureItem { n: int (4) }
struct ShCaptureHolder { item: ?shared ShCaptureItem; k: int }

test "Shared: a shared function captures a struct whose references are shared" {
    let holder = ShCaptureHolder{ item: ShCaptureItem{}, k: 3 }
    let read: shared fn()(int) = fn() int {
        let item = holder.item ?! return holder.k
        return item.n + holder.k
    }
    assert(read() == 7)
}

struct ShPlainPoint {
    x: int
    y: int
}
class ShPlainOwner {
    name: String ("a")
}
struct ShPlainPair {
    item: ShPlainOwner
    p: ShPlainPoint
}

test "Shared: a borrow of a field without objects leaves the local unique" {
    let o = ShPlainPair{ item: ShPlainOwner{}, p: ShPlainPoint{ x: 1, y: 2 } }
    let px = &o.p
    assert(px.x == 1)
    let s: shared ShPlainPair = o
    assert(s.p.y == 2 && s.item.name == "a")
}

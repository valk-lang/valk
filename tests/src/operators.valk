
struct ComparedPoint {
    label: String
    value: int
}

fn compared_text(prefix: String) String { return prefix + "value" }
fn equal_multi(left: (String, int), right: (String, int)) bool { return left == right }
fn positive_seven() int { return 7 }

test "Operators" {
    // Bit shift compatibility
    0.0.to(int) << 1
    1 << 0.1.to(int)
    1.to(u8) << 1
    1 << 1.to(u8)
    1.to(u8) << 1.to(u16)
    1.to(u16) << 1.to(u8)
    1.to(i8) << 1.to(u16)
    1.to(u16) << 1.to(i8)
    1.to(i8) << 1.to(u8)
    1.to(u8) << 1.to(i8)
    1.to(int) << 1.to(uint)

    // Integer type promotion
    let t1 = 1.to(u8) + 1.to(i8)
    #if !typeof(t1).$is_type_of(i16)
    assert(false)
    #end
    let t2 = 1.to(u16) + 1.to(i16)
    #if !typeof(t2).$is_type_of(i32)
    assert(false)
    #end
    let t3 = 1.to(u32) + 1.to(i32)
    #if !typeof(t3).$is_type_of(i64)
    assert(false)
    #end

    let positive = 7
    assert(-positive == -7)
    assert(-(positive + 1) == -8)
    assert(-positive_seven() == -7)

    let positive_float = 1.5
    assert(-positive_float == -1.5)
}

test "Operators: structural equality" {
    let text = compared_text("same-")
    let left: ComparedPoint = { label: text, value: 7 }
    let same: ComparedPoint = { label: "same-value", value: 7 }
    let different: ComparedPoint = { label: "same-value", value: 8 }
    assert(left == same)
    assert(left != different)

    let array: [int x 3] = { 1, 2, 3 }
    let same_array: [int x 3] = { 1, 2, 3 }
    let different_array: [int x 3] = { 1, 2, 4 }
    assert(array == same_array)
    assert(array != different_array)
    assert(equal_multi((text, 7), ("same-value", 7)))
    assert(!equal_multi((text, 7), ("same-value", 8)))
}

@ignore_access
use valk.ext

test "FFI exposes concrete errno and poll pointer types" {
    #if OS == "linux"
    let errno_ptr: *i32 = ext.__errno_location()
    assert(errno_ptr.@cast(uint) != 0)

    let descriptor: ext.libc_pollfd = @undefined
    assert(ext.poll(@ref(descriptor), 0, 0) == 0)
    #elif OS == "macos"
    let errno_ptr: *i32 = ext.__error()
    assert(errno_ptr.@cast(uint) != 0)

    let descriptor: ext.libc_pollfd = @undefined
    assert(ext.poll(@ref(descriptor), 0, 0) == 0)
    #elif OS == "win"
    let value: i32 = 0
    assert(ext._get_errno(@ref(value)) == 0)
    #end
}

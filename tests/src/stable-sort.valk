use valk.gc
use valk.random

class SortPerson {
    name: String
    age: int
    nick: ?String (null)
}

struct SortPlain {
    key: int
    id: int
}

struct SortWithRef {
    key: int
    label: String
}

fn sort_people_names(people: Array[SortPerson]) String {
    let names = Array[String]{}
    each people as p : names.append(p.name)
    return names.join(",")
}

test "Array.sort is stable for every element kind" {
    // Plain values move as memory
    let plain = Array[SortPlain]{}
    each 0 .. 500 as i : plain.append(SortPlain { key: i % 7, id: i })
    plain.sort(fn(a, b) { return a.key > b.key })
    let ok = true
    each 1 .. plain.length - 1 as i {
        let a = plain.get(i - 1) !? SortPlain { key: 0, id: 0 }
        let b = plain.get(i) !? SortPlain { key: 0, id: 0 }
        if a.key > b.key || (a.key == b.key && a.id > b.id) : ok = false
    }
    assert(ok)

    // Values with references move inside their own storage
    let refs = Array[SortWithRef]{}
    each 0 .. 500 as i : refs.append(SortWithRef { key: i % 5, label: "n" + i })
    refs.sort(fn(a, b) { return a.key > b.key })
    let last_label: uint = 0
    let last_key = -1
    ok = true
    each refs as r {
        let n = r.label.range(1, r.label.bytes - 1).to_uint() !? 0
        if r.key == last_key && n < last_label : ok = false
        if r.key < last_key : ok = false
        last_key = r.key
        last_label = n
    }
    assert(ok)

    let people = Array[SortPerson]{
        SortPerson { name: "c", age: 30 }
        SortPerson { name: "a", age: 20 }
        SortPerson { name: "b", age: 30 }
        SortPerson { name: "d", age: 20 }
    }
    people.sort(fn(x, y) { return x.age > y.age })
    assert(sort_people_names(people) == "a,d,c,b")

    // The default order puts null first and keeps equal values in order
    let maybe = Array[?int]{ 3, null, 1, null, 2 }
    maybe.sort()
    assert(!isset(maybe.get(0) !? 9) && !isset(maybe.get(1) !? 9))
    assert((maybe.get(2) !? 0) == 1 && (maybe.get(4) !? 0) == 3)

    let words = Array[String]{ "pear", "apple", "fig", "apple" }
    assert(words.sorted().join(",") == "apple,apple,fig,pear")
    assert(words.join(",") == "pear,apple,fig,apple")
}

test "Array.sort handles large and presorted input" {
    random.seed(11)
    let numbers = Array[int]{}
    each 0 .. 20_000 as i : numbers.append(random.between(-1000, 1000))
    numbers.sort()
    let ordered = true
    each 1 .. numbers.length - 1 as i {
        if (numbers.get(i - 1) !? 0) > (numbers.get(i) !? 0) : ordered = false
    }
    assert(ordered)
    numbers.sort()
    numbers.sort(fn(a, b) { return a < b })
    assert((numbers.get(0) !? 0) >= (numbers.get(numbers.length - 1) !? 0))

    // Objects sorted with collections in between keep every element
    let people = Array[SortPerson]{}
    each 0 .. 5_000 as i : people.append(SortPerson { name: "p" + i, age: random.below(50) })
    people.sort(fn(a, b) {
        // Allocates while comparing
        let ka = "" + a.age
        let kb = "" + b.age
        return ka.length > kb.length || (ka.length == kb.length && a.age > b.age)
    })
    gc.collect()
    let seen = Map[bool]{}
    each people as p : seen.set(p.name, true)
    assert(seen.length == 5_000)
}

test "Array.sort_by and sorted_by" {
    let people = Array[SortPerson]{
        SortPerson { name: "c", age: 30 }
        SortPerson { name: "a", age: 20, nick: "z" }
        SortPerson { name: "b", age: 30, nick: "y" }
        SortPerson { name: "d", age: 20 }
    }
    people.sort_by(fn(p) { return p.age })
    assert(sort_people_names(people) == "a,d,c,b")
    assert(sort_people_names(people.sorted_by(fn(p) { return p.name })) == "a,b,c,d")
    assert(sort_people_names(people) == "a,d,c,b")

    // A null key comes first
    people.sort_by(fn(p) { return p.nick })
    assert(sort_people_names(people) == "d,c,b,a")

    // The key runs once per element
    let calls = Array[int]{}
    let words = Array[String]{ "ccc", "a", "bb", "dd" }
    words.sort_by(fn(w) {
        calls.append(0)
        return w.length
    })
    assert(words.join(",") == "a,bb,dd,ccc")
    assert(calls.length == 4)
}

test "Array.sort around the length of one run" {
    each Array[uint]{ 0, 1, 2, 15, 16, 17, 31, 32, 33 } as count {
        let values = Array[SortPlain]{}
        each 0 .. count as i : values.append(SortPlain { key: (count - i) % 3, id: i })
        values.sort(fn(a, b) { return a.key > b.key })
        let ok = values.length == count
        each values as v, i {
            if i == 0 : continue
            let prev = values.get(i - 1) !!
            if prev.key > v.key || (prev.key == v.key && prev.id > v.id) : ok = false
        }
        assert(ok)
    }
}

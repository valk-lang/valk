error NameOops (not_found, denied)
error NameWider (timeout) extends (NameOops)

fn name_fails(which: int) !NameOops {
    if which == 0 : throw .not_found
    throw .denied
}

fn name_wide() !NameWider {
    throw .timeout
}

fn name_rethrow() !NameWider {
    name_fails(1) !>
}

fn name_text(text: String) String {
    return text
}

test "Error codes as text: name(), + and interpolation" {
    let a = ""
    name_fails(0) ! { a = E.code.name() }
    assert(a == "not_found")
    let b = ""
    name_fails(1) ! { b = "failed: " + E.code }
    assert(b == "failed: denied")
    let c = ""
    name_fails(1) ! { c = E.code + "!" }
    assert(c == "denied!")
    let d = ""
    name_fails(0) ! { d = "%{E.code}" }
    assert(d == "not_found")
}

test "Error codes as text: String conversions and inherited codes" {
    let a = ""
    name_fails(1) ! { a = name_text(E.code) }
    assert(a == "denied")
    let b = ""
    name_fails(0) ! { b = E.code.to(String) }
    assert(b == "not_found")
    let c = ""
    name_wide() ! { c = E.code.name() }
    assert(c == "timeout")
    let d = ""
    name_rethrow() ! { d = E.code.name() }
    assert(d == "denied")
    // Comparisons still use the code, not its name
    let e = false
    name_fails(1) ! { e = E.code == E.denied && E.code.name() == "denied" }
    assert(e)
}

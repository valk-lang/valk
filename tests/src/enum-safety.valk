enum NonzeroDefault { first (7)
    second (19) }
enum NegativeDefault { first (-7)
    second (19) }
enum ZeroAllowed { first (7)
    zero (0) }
enum NullableEnumDefault: ?int { first (7) }
enum EnumText: String { first ("first")
    second ("second") }
enum EnumArray: [int x 2] { first ({ 7, 19 })
    second ({ 19, 7 }) }
class EnumDefaults {
    number: NonzeroDefault
    negative: NegativeDefault
    text: EnumText
    row: EnumArray
    maybe: ?NonzeroDefault
    nullable_enum: NullableEnumDefault
}
struct EnumZeroEntry { value: ZeroAllowed }
class EnumMatchCount { calls: int (0) }
global dynamic_enum_calls: int (0)
fn dynamic_enum_zero() int {
    dynamic_enum_calls++
    return 0
}
enum DynamicEnum { zero (dynamic_enum_zero()) }
fn counted_enum(count: EnumMatchCount) NonzeroDefault {
    count.calls++
    return NonzeroDefault.second
}
fn enum_incremented(value: NonzeroDefault) int { return value + 1 }
fn enum_nullable_sum(value: NonzeroDefault) ?int { return value + 1 }
fn plain_nullable_sum(value: int) ?int { return value + 1 }
fn enum_index(count: EnumMatchCount) uint {
    count.calls++
    return 0
}

test "Enums: arithmetic evaluates checked storage once" {
    let values = Array[NonzeroDefault]{ NonzeroDefault.first }
    let view = values.view()
    let count = EnumMatchCount {}
    assert(view[enum_index(count)] + 1 == 8)
    assert(count.calls == 1)
    assert(-view[enum_index(count)] == -7)
    assert(count.calls == 2)
    let number: ?int = view[enum_index(count)] + 1
    assert(number == 8 && count.calls == 3)
    assert(enum_nullable_sum(NonzeroDefault.first) == 8)
    assert(plain_nullable_sum(7) == 8)
}

test "Enums: generated defaults use the first declared member" {
    let values = EnumDefaults {}
    assert(values.number == NonzeroDefault.first)
    assert(values.negative == NegativeDefault.first)
    assert(values.text == EnumText.first)
    assert(values.row[0] == 7 && values.row[1] == 19)
    assert(NonzeroDefault.$default_value == NonzeroDefault.first)
    assert(!isset(values.maybe))
    assert(values.nullable_enum == 7)
}

test "Enums: arithmetic produces the underlying number" {
    let sum = NonzeroDefault.first + NonzeroDefault.second
    assert(sum == 26)
    assert(enum_incremented(NonzeroDefault.first) == 8)
    assert(-NonzeroDefault.first == -7)
    assert(~NonzeroDefault.first == ~7)
    let value = NonzeroDefault.first
    value = NonzeroDefault.second
    assert(value == NonzeroDefault.second)
}

test "Enums: cleared storage preserves a declared zero member" {
    let values = Array[ZeroAllowed]{ ZeroAllowed.first }
    let view = values.view()
    values.clear()
    assert(view[0] == ZeroAllowed.zero)
    assert((view.get(0) !!) == ZeroAllowed.zero)
    each view as value : assert(value == ZeroAllowed.zero)
    let entries = Array[EnumZeroEntry]{ EnumZeroEntry { value: ZeroAllowed.first } }
    let borrowed = &entries[0]
    entries.clear()
    assert(borrowed.value == ZeroAllowed.zero)
}

test "Enums: reading storage does not evaluate member expressions" {
    let values = Array[DynamicEnum]{ DynamicEnum.zero }
    let view = values.view()
    assert(dynamic_enum_calls == 1)
    assert(view[0] == 0)
    assert(dynamic_enum_calls == 1)
}

test "Enums: exhaustive value matches use equality and evaluate the input once" {
    let count = EnumMatchCount {}
    let number = match counted_enum(count) : int {
        NonzeroDefault.first => 73
        NonzeroDefault.second => 19
    }
    assert(number == 19 && count.calls == 1)
    let text = EnumText.second
    let result = match text : int {
        EnumText.first => 73
        EnumText.second => 19
    }
    assert(result == 19)
    let row = EnumArray.second
    let array_result = match row : int {
        EnumArray.first => 73
        EnumArray.second => 19
    }
    assert(array_result == 19)
}


use valk.core

test "env: setenv / unsetenv" {
    let name = "VALK_TEST_ENV_VAR"
    core.setenv(name, "first") ! assert(false)
    assert((core.getenv(name) !? "missing") == "first")
    core.setenv(name, "second") ! assert(false)
    assert((core.getenv(name) !? "missing") == "second")
    core.unsetenv(name) ! assert(false)
    assert((core.getenv(name) !? "missing") == "missing")

    let failed = false
    core.setenv("BAD=NAME", "x") ! { failed = true }
    assert(failed)
}

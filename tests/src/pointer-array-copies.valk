use valk.gc

type PointerCopyRow ([int x 2])
type PointerCopyMatrix ([PointerCopyRow x 3])
fn pointer_copy_matrix(rows: *[PointerCopyRow x 3]) PointerCopyMatrix { return rows }
fn pointer_copy_prefix(rows: *[PointerCopyRow x 3]) [PointerCopyRow x 2] { return rows }
fn pointer_copy_widen(rows: *[PointerCopyRow x 3]) [[?int x 2] x 3] { return rows }

class PointerCopyItem { number: int }
class PointerCopyOwner {
    rows: [[PointerCopyItem x 2] x 2] ({
        { PointerCopyItem { number: 7 }, PointerCopyItem { number: 11 } },
        { PointerCopyItem { number: 19 }, PointerCopyItem { number: 23 } }
    })
}
fn pointer_copy_managed(rows: *[[PointerCopyItem x 2] x 2]) [[?PointerCopyItem x 2] x 2] { return rows }

test "Pointer copies: bounded rows preserve their outer count" {
    let rows: PointerCopyMatrix = { { 7, 11 }, { 19, 23 }, { 29, 31 } }
    let copied = pointer_copy_matrix(&rows)
    let prefix = pointer_copy_prefix(&rows)
    let widened = pointer_copy_widen(&rows)
    rows[0][0] = 37
    rows[2][1] = 41
    assert(copied[0][0] == 7 && copied[1][1] == 23 && copied[2][1] == 31)
    assert(prefix[0][1] == 11 && prefix[1][0] == 19)
    assert((widened[0][0] ?? 0) == 7 && (widened[2][1] ?? 0) == 31)
    copied[1][0] = 43
    assert(rows[1][0] == 19 && copied[1][0] == 43)
}

test "Pointer copies: nested managed rows retain copied elements" {
    let owner = PointerCopyOwner {}
    let copied = pointer_copy_managed(&mut owner.rows)
    owner.rows[0][0] = PointerCopyItem { number: 47 }
    owner = .{}
    gc.collect()
    let first = copied[0][0] ?? panic("missing first item")
    let last = copied[1][1] ?? panic("missing last item")
    assert(first.number == 7 && last.number == 23)
    copied[0][0] = null
    gc.collect()
    assert(!isset(copied[0][0]) && (copied[1][0] ?? panic("missing item")).number == 19)
}

use valk.fs
use valk.io

#if OS != "win"
extern fn link(old_path: cstring, new_path: cstring) i32;
#end

test "audit: writes advance the stream position" {
    let path = fs.add(fs.exe_dir() !? "", "audit-stream-position.txt")
    let stream = fs.stream(path, fs.OpenOptions { read: false, write: fs.WriteMode.truncate, create: true }) ! { assert(false); return }
    assert((stream.write("abc") !? 99) == 3)
    assert(stream.position == 3)
    assert((stream.seek(0, io.SeekFrom.current) !? 99) == 3)
    stream.write("X") ! assert(false)
    stream.close() ! assert(false)
    assert((fs.read(path) !? "") == "abcX")
    fs.delete_file(path) ! assert(false)
}

test "audit: empty reads do not close streams" {
    let path = fs.add(fs.exe_dir() !? "", "audit-stream-empty.txt")
    fs.write(path, "abc") ! assert(false)
    let stream = fs.stream(path) ! { assert(false); return }
    let empty = [u8]{}
    assert((stream.read(empty) !? 99) == 0)
    assert(!stream.closed)
    let chunk = [u8]{ 0 x 3 }
    assert((stream.read(chunk) !? 99) == 3)
    assert(chunk.to_string() == "abc")
    stream.close() ! assert(false)
    fs.delete_file(path) ! assert(false)
}

test "audit: copy to a path alias preserves the source" {
    let dir = fs.exe_dir() !? ""
    let path = fs.add(dir, "audit-copy-alias.txt")
    let alias = dir + "/./audit-copy-alias.txt"
    fs.write(path, "must survive") ! assert(false)
    fs.copy(path, alias) ! {}
    assert((fs.read(path) !? "") == "must survive")
    fs.delete_file(path) ! assert(false)
}

test "audit: mixed reads and writes share a stream cursor" {
    let path = fs.add(fs.exe_dir() !? "", "audit-stream-mixed.txt")
    let stream = fs.stream(path, fs.OpenOptions { read: true, write: fs.WriteMode.truncate, create: true }) ! { assert(false); return }
    assert((stream.write("abcdef") !? 99) == 6)
    assert((stream.seek(1) !? 99) == 1)
    let chunk = [u8]{ 0 x 2 }
    assert((stream.read(chunk) !? 99) == 2)
    assert(chunk.to_string() == "bc")
    assert((stream.write("X") !? 99) == 1)
    assert(stream.position == 4)
    assert((stream.read(chunk) !? 99) == 2)
    assert(chunk.to_string() == "ef")
    stream.close() ! assert(false)
    assert((fs.read(path) !? "") == "abcXef")
    fs.delete_file(path) ! assert(false)
}

test "audit: append writes report their actual position" {
    let path = fs.add(fs.exe_dir() !? "", "audit-stream-append.txt")
    fs.write(path, "abc") ! assert(false)
    let stream = fs.stream(path, fs.OpenOptions { write: fs.WriteMode.append }) ! { assert(false); return }
    assert((stream.write("X") !? 99) == 1)
    assert(stream.position == 4)
    assert((stream.seek(0) !? 99) == 0)
    assert((stream.write("Y") !? 99) == 1)
    assert(stream.position == 5)
    stream.close() ! assert(false)
    assert((fs.read(path) !? "") == "abcXY")
    fs.delete_file(path) ! assert(false)
}

test "audit: copying distinct files truncates the destination" {
    let dir = fs.exe_dir() !? ""
    let source = fs.add(dir, "audit-copy-source.txt")
    let destination = fs.add(dir, "audit-copy-destination.txt")
    fs.write(source, "short") ! assert(false)
    fs.write(destination, "a much longer file") ! assert(false)
    fs.copy(source, destination) ! assert(false)
    assert((fs.read(source) !? "") == "short")
    assert((fs.read(destination) !? "") == "short")
    fs.delete_file(destination) ! assert(false)
    fs.copy(source, destination) ! assert(false)
    assert((fs.read(destination) !? "") == "short")
    fs.delete_file(source) ! assert(false)
    fs.delete_file(destination) ! assert(false)
}

#if OS != "win"
test "audit: copy preserves sources through hard links and symlinks" {
    @unsafe
    let dir = fs.exe_dir() !? ""
    let source = fs.add(dir, "audit-copy-linked-source.txt")
    let hard = fs.add(dir, "audit-copy-hard.txt")
    let symbolic = fs.add(dir, "audit-copy-symbolic.txt")
    fs.write(source, "keep") ! assert(false)
    assert(link(source.data_cstring, hard.data_cstring) == 0)
    fs.copy(source, hard) ! assert(false)
    assert((fs.read(source) !? "") == "keep")
    fs.symlink(symbolic, source, false) ! assert(false)
    fs.copy(source, symbolic) ! assert(false)
    assert((fs.read(source) !? "") == "keep")
    fs.delete_file(symbolic) ! assert(false)
    fs.delete_file(hard) ! assert(false)
    fs.delete_file(source) ! assert(false)
}
#end

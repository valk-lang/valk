
use valk.fs
use valk.io

fn read_all(reader: io.Reader) String {
    let out = io.BufferWriter.new()
    io.copy(reader, out, 3) ! {
        assert(false)
        return ""
    }
    return out.buffer.to_string()
}

test "io: slice reader and buffer writer" {
    let reader = io.SliceReader { source: "streamed" }
    let buf = Slice[u8].new(4, 0)
    assert((reader.read(buf) !? 99) == 4)
    assert(buf.to_string() == "stre")
    assert((reader.read(buf) !? 99) == 4)
    assert(buf.to_string() == "amed")
    assert((reader.read(buf) !? 99) == 0)

    assert((reader.seek(2) !? 99) == 2)
    assert((reader.seek(-1, io.SeekFrom.end) !? 99) == 7)
    assert((reader.seek(-2, io.SeekFrom.current) !? 99) == 5)
    let failed = false
    reader.seek(9) ! { failed = true }
    assert(failed)
    assert(read_all(reader) == "med")

    let bytes = ByteBuffer.new()
    bytes.write("abcdef")
    assert(read_all(io.SliceReader { source: bytes.view(1, 4) }) == "bcde")

    let all = io.read_all(io.SliceReader { source: "read everything" }, 4) ! {
        assert(false)
        return
    }
    assert(all.to_string() == "read everything")

    let writer: io.Writer = io.BufferWriter.new()
    assert((writer.write("hello") !? 0) == 5)
    assert((writer.write(" world") !? 0) == 6)
    assert(writer is_a io.BufferWriter)
}

test "io: file streams implement reader, writer and seeker" {
    let path = fs.add(fs.exe_dir() !? "", "valk-io-interface-test.txt")
    let writable = fs.stream(path, fs.OpenOptions { read: false, write: true, create: true }) ! {
        assert(false)
        return
    }
    let writer: io.Writer = writable
    assert((io.copy(io.SliceReader { source: "abcdef" }, writer, 2) !? 99) == 6)
    writable.close() ! assert(false)

    let stream = fs.stream(path) ! {
        fs.delete(path) _
        assert(false)
        return
    }
    let seeker: io.Seeker = stream
    assert((seeker.seek(3, io.SeekFrom.start) !? 99) == 3)
    let reader: io.Reader = stream
    assert(read_all(reader) == "def")
    assert(reader is_a fs.FileStream)
    stream.close() ! assert(false)

    fs.delete(path) ! assert(false)
}

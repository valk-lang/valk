
use valk.fs
use valk.io

fn read_all(reader: io.Reader) String {
    let out = io.BufferWriter.new()
    io.copy(reader, out, 3) ! {
        assert(false)
        return ""
    }
    return out.buffer.to_string()
}

test "io: byte reader and buffer writer" {
    let reader = "streamed".reader()
    let buf = Slice[u8].new(4, 0)
    assert((reader.read(buf) !? 99) == 4)
    assert(buf.to_string() == "stre")
    assert((reader.read(buf) !? 99) == 4)
    assert(buf.to_string() == "amed")
    assert((reader.read(buf) !? 99) == 0)

    assert((reader.seek(2) !? 99) == 2)
    assert((reader.seek(-1, io.SeekFrom.end) !? 99) == 7)
    assert((reader.seek(-2, io.SeekFrom.current) !? 99) == 5)
    let failed = false
    reader.seek(9) ! { failed = true }
    assert(failed)
    assert(read_all(reader) == "med")

    // The cursor shares its position with the io.Reader side
    let mixed = ByteReader.new("12 tail")
    assert(mixed.read_uint() == 12)
    mixed.skip(1)
    assert(read_all(mixed) == "tail")

    let bytes = ByteBuffer.new()
    bytes.write("abcdef")
    assert(read_all(bytes.view(1, 4).reader()) == "bcde")

    let all = io.read_all(ByteReader.new("read everything"), 4) ! {
        assert(false)
        return
    }
    assert(all.to_string() == "read everything")

    let writer: io.Writer = io.BufferWriter.new()
    assert((writer.write("hello") !? 0) == 5)
    assert((writer.write(" world") !? 0) == 6)
    assert(writer is_a io.BufferWriter)
}

test "io: standard streams" {
    let out: io.Writer = io.stdout()
    let err: io.Writer = io.stderr()
    let input: io.Reader = io.stdin()
    assert(out is_a io.StdStream)
    assert(err is_a io.StdStream)
    assert(input is_a io.StdStream)
    assert(io.stdout() == io.stdout())
    assert(io.stdin() == io.stdin())
    assert((out.write("") !? 99) == 0)
    assert((err.write("") !? 99) == 0)

    // stdin is not writable, stdout is not readable
    let failed = false
    io.stdin().write("x") ! { failed = true }
    assert(failed)
    failed = false
    let buf = Slice[u8].new(4, 0)
    io.stdout().read(buf) ! { failed = true }
    assert(failed)
}

test "io: file streams implement reader, writer, seeker and closer" {
    let path = fs.add(fs.exe_dir() !? "", "valk-io-interface-test.txt")
    let writable = fs.stream(path, fs.OpenOptions { read: false, write: true, create: true }) ! {
        assert(false)
        return
    }
    let writer: io.Writer = writable
    assert((io.copy(ByteReader.new("abcdef"), writer, 2) !? 99) == 6)
    writable.close() ! assert(false)

    let stream = fs.stream(path) ! {
        fs.delete(path) _
        assert(false)
        return
    }
    let seeker: io.Seeker = stream
    assert((seeker.seek(3, io.SeekFrom.start) !? 99) == 3)
    assert(stream.position == 3)
    assert(!stream.closed)
    let reader: io.Reader = stream
    assert(read_all(reader) == "def")
    assert(stream.position == 6)
    assert(reader is_a fs.FileStream)
    // Reading to the end closes the stream
    assert(stream.closed)
    let closer: io.Closer = stream
    closer.close() ! assert(false)
    closer.close() ! assert(false)
    let failed = false
    stream.seek(0) ! { failed = true }
    assert(failed)

    fs.delete(path) ! assert(false)
}



error TestError (err, err2) payload {
    message: String
}





fn test_errh_success() uint !TestError {
    return 5
}
fn test_errh_error() uint !TestError {
    throw .err { message: "" }
    // throw ret_err()
}
fn test_errh_error2() uint !TestError {
    throw .err2 { message: "" }
}
fn test_errh_error3() !TestError {
    throw .err { message: "Hello" }
}
fn test_errh_error4() !TestError {
    test_errh_error3() !>
    throw .err2 { message: "" }
}
fn test_errh_error5() !TestError {
    // Auto pass
    test_errh_error3()
}

test "Error handling" {
    let v1 = test_errh_success() !? 10
    assert(v1 == 5)
    let v2 = test_errh_error() !? 10
    assert(v2 == 10)
    // Ignore error
    test_errh_error3() _
    // 
    let v3 = test_errh_error() !? <{
        assert(error_is(E.code, err))
        return 5
    }
    assert(v3 == 5)
    let v4 = test_errh_error2() !? <{
        assert(!error_is(E.code, err))
        assert(error_is(E.code, err2))
        assert(E.code == E.err2)
        return 5
    } 
    assert(v4 == 5)
    // Error passing
    let has_error = false
    test_errh_error4() ! {
        has_error = true
        assert(E.code == E.err)
        assert(E.message == "Hello")
    }
    assert(has_error)
    // Auto pass
    has_error = false
    test_errh_error5() ! {
        has_error = true
        assert(E.code == E.err)
        assert(E.message == "Hello")
    }
    assert(has_error)
}

fn errh_arg_return(ok: bool, out: Array[String]) {
    out.append(test_errh_value(ok) ! return)
    out.append("after")
}
fn errh_arg_null_return(msg: ?String, out: Array[String]) {
    out.append((msg ?! return))
    out.append("after")
}
fn errh_arg_throw(ok: bool) String !TestError {
    return "got:" + (test_errh_value(ok) ! throw .err2)
}
fn test_errh_value(ok: bool) String !TestError {
    if !ok : throw .err { message: "no" }
    return "yes"
}

test "Error handlers inside call arguments" {
    let out = Array[String]{}
    errh_arg_return(true, out)
    errh_arg_return(false, out)
    assert(out.join(",") == "yes,after")
    let out2 = Array[String]{}
    errh_arg_null_return("v", out2)
    errh_arg_null_return(null, out2)
    assert(out2.join(",") == "v,after")
    let v1 = errh_arg_throw(true) !? "err"
    assert(v1 == "got:yes")
    let v2 = errh_arg_throw(false) !? "err"
    assert(v2 == "err")
    let arr = Array[String]{ test_errh_value(true) ! return, "y" }
    assert(arr.length == 2)
    let msg: ?String = null
    let count = 0
    while count < 2 {
        count++
        let m = msg
        if count == 2 : m = "set"
        arr.append(m ?! continue)
    }
    assert(arr.length == 3)
}

// `code1000826214` hashes to the value the ABI reserves for "no error"
error SentinelError (code1000826214)

fn sentinel_throw() int !SentinelError {
    throw .code1000826214
}

test "Errors: a code hashing to the sentinel still reports" {
    let fallback = sentinel_throw() !? 99
    assert(fallback == 99)
    sentinel_throw() ! {
        assert(error_is(E.code, code1000826214))
        match E.code {
            E.code1000826214 => assert(true)
            default => assert(false)
        }
    }
}

union TestError {
    err(String)
    err2(String)

    get message: String {
        return match this : String {
            .err(m) => m
            .err2(m) => m
        }
    }

    fn tag_name() String {
        return match this : String {
            .err(_) => "err"
            .err2(_) => "err2"
        }
    }
}

fn test_errh_success() uint !TestError {
    return 5
}
fn test_errh_error() uint !TestError {
    throw .err("")
}
fn test_errh_error2() uint !TestError {
    throw .err2("")
}
fn test_errh_error3() !TestError {
    throw .err("Hello")
}
fn test_errh_error4() !TestError {
    test_errh_error3() !>
    throw .err2("")
}
fn test_errh_error5() !TestError {
    // Auto pass
    test_errh_error3()
}

test "Error handling" {
    let v1 = test_errh_success() !? 10
    assert(v1 == 5)
    let v2 = test_errh_error() !? 10
    assert(v2 == 10)
    // Ignore error
    test_errh_error3() _
    let v3 = test_errh_error() !? <{
        assert(E is .err)
        return 5
    }
    assert(v3 == 5)
    let v4 = test_errh_error2() !? <{
        assert(!(E is .err))
        assert(E is .err2)
        return 5
    }
    assert(v4 == 5)
    // Error passing
    let has_error = false
    test_errh_error4() ! {
        has_error = true
        assert(E is .err)
        assert(E.message == "Hello")
    }
    assert(has_error)
    // Auto pass
    has_error = false
    test_errh_error5() ! {
        has_error = true
        assert(E is .err)
        assert(E.message == "Hello")
    }
    assert(has_error)
}

fn errh_arg_return(ok: bool, out: Array[String]) {
    out.append(test_errh_value(ok) ! return)
    out.append("after")
}
fn errh_arg_null_return(msg: ?String, out: Array[String]) {
    out.append((msg ?! return))
    out.append("after")
}
fn errh_arg_throw(ok: bool) String !TestError {
    return "got:" + (test_errh_value(ok) ! throw .err2(""))
}
fn test_errh_value(ok: bool) String !TestError {
    if !ok : throw .err("no")
    return "yes"
}

test "Error handlers inside call arguments" {
    let out = Array[String]{}
    errh_arg_return(true, out)
    errh_arg_return(false, out)
    assert(out.join(",") == "yes,after")
    let out2 = Array[String]{}
    errh_arg_null_return("v", out2)
    errh_arg_null_return(null, out2)
    assert(out2.join(",") == "v,after")
    let v1 = errh_arg_throw(true) !? "err"
    assert(v1 == "got:yes")
    let v2 = errh_arg_throw(false) !? "err"
    assert(v2 == "err")
    let arr = Array[String]{ test_errh_value(true) ! return, "y" }
    assert(arr.length == 2)
    let msg: ?String = null
    let count = 0
    while count < 2 {
        count++
        let m = msg
        if count == 2 : m = "set"
        arr.append(m ?! continue)
    }
    assert(arr.length == 3)
}

fn errh_closure_throw(code: uint, message: String) !TestError {
    if code == 1 : throw .err(message)
    throw .err2(message)
}

test "Errors: a closure keeps the caught error and payload it captured" {
    let calls = Array[fn()(String)]{}
    errh_closure_throw(2, "first") ! {
        calls.append(fn() String { return E.tag_name() + ":" + E.message })
    }
    errh_closure_throw(1, "second") _
    assert(calls[0]() == "err2:first")
}

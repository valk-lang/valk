
test "Map: initialization & get-by-key" {
    // let m = Map[String]{ "a" => "1", "b" => "2", "c" => "3" }
    let m = Map[String].new()
    m.set("a", "1")
    m.set("b", "2")
    m.set("c", "3")

    assert((m.get("a") !? "0") == "1")
    assert((m.get("b") !? "0") == "2")
    assert((m.get("c") !? "0") == "3")
    assert((m.get("d") !? "0") == "0")
}

test "HashMap" {
    let m = HashMap[String, String]{}
    m.set("a", "1")
    m.set("b", "2")
    m.set("c", "3")
    m.set("xy", "4")

    assert((m.get("a") !? "0") == "1")
    assert((m.get("b") !? "0") == "2")
    assert((m.get("c") !? "0") == "3")
    assert((m.get("d") !? "0") == "0")
    assert((m.get("x" + "y") !? "0") == "4")

    let m2 = HashMap[uint, String]{}
    m2.set(0, "1")
    m2.set(2, "2")
    m2.set(4, "3")

    assert((m2.get(0) !? "0") == "1")
    assert((m2.get(2) !? "0") == "2")
    assert((m2.get(4) !? "0") == "3")
    assert((m2.get(1) !? "0") == "0")
}

test "HashMap copy is independent" {
    let original = HashMap[String, int]{ "value" => 1 }
    let copied = original.copy()

    copied.set("value", 2)
    copied.set("new", 3)

    assert((original.get("value") !? 0) == 1)
    assert(!original.has("new"))
    assert((copied.get("value") !? 0) == 2)
    assert((copied.get("new") !? 0) == 3)
}

test "FlatMap sorting keeps values associated with their keys" {
    let map = FlatMap[String, uint]{ "z" => 26, "a" => 1, "m" => 13 }

    map.sort_keys()

    assert(map.keys() == .{ "a", "m", "z" })
    assert((map.get("a") !? 0) == 1)
    assert((map.get("m") !? 0) == 13)
    assert((map.get("z") !? 0) == 26)

    let expected_key = "a"
    each map as value, key {
        assert(key == expected_key)
        assert(value == (key == "a" ? 1 : key == "m" ? 13 : 26))
        expected_key = key == "a" ? "m" : "z"
    }
}

test "Maps reject duplicate unique keys" {
    let hash = HashMap[String, uint]{}
    hash.set_unique("key", 1) ! panic("HashMap rejected a new unique key")

    let hash_duplicate = false
    hash.set_unique("key", 2) ! { hash_duplicate = true }
    assert(hash_duplicate)
    assert(hash.length == 1)
    assert((hash.get("key") !? 0) == 1)

    let flat = FlatMap[String, uint]{}
    flat.set_unique("key", 1) ! panic("FlatMap rejected a new unique key")

    let flat_duplicate = false
    flat.set_unique("key", 2) ! { flat_duplicate = true }
    assert(flat_duplicate)
    assert(flat.length == 1)
    assert((flat.get("key") !? 0) == 1)
}

test "Maps merge by copy or in place" {
    let hash_left = HashMap[String, uint]{ "a" => 1, "shared" => 2 }
    let hash_right = HashMap[String, uint]{ "b" => 3, "shared" => 4 }
    let hash_merged = hash_left.merge(hash_right)
    assert(hash_left.length == 2)
    assert((hash_left.get("shared") !? 0) == 2)
    assert(hash_right.length == 2)
    assert(hash_merged.length == 3)
    assert((hash_merged.get("shared") !? 0) == 4)

    hash_left.merge_in_place(hash_right)
    assert(hash_left.length == 3)
    assert((hash_left.get("shared") !? 0) == 4)

    let flat_left = FlatMap[String, uint]{ "a" => 1, "shared" => 2 }
    let flat_right = FlatMap[String, uint]{ "b" => 3, "shared" => 4 }
    let flat_merged = flat_left.merge(flat_right)
    assert(flat_left.length == 2)
    assert((flat_left.get("shared") !? 0) == 2)
    assert(flat_right.length == 2)
    assert(flat_merged.length == 3)
    assert((flat_merged.get("shared") !? 0) == 4)

    flat_left.merge_in_place(flat_right)
    assert(flat_left.length == 3)
    assert((flat_left.get("shared") !? 0) == 4)
}

test "HashMap grows and distributes keys" {
    let map = HashMap[String, uint]{}

    // Read-only misses must not allocate buckets.
    assert(map.allocated_buckets_for_test() == 0)
    assert(!map.has("missing"))
    assert((map.get("missing") !? 999) == 999)
    assert(map.allocated_buckets_for_test() == 0)



    let i : uint = 0
    while i < 2000 {
        map.set("a%{i}a", i)
        i++
    }
    assert(map.length == 2000)
    assert(map.bucket_count_for_test() > 128)

    let valid = true
    i = 0
    while i < 2000 {
        if (map.get("a%{i}a") !? 9999) != i {
            valid = false
            break
        }
        i++
    }
    assert(valid)

    map.set("a100a", 5000)
    assert(map.length == 2000)
    assert((map.get("a100a") !? 0) == 5000)

    i = 0
    while i < 1000 {
        map.remove("a%{i * 2}a")
        i++
    }
    assert(map.length == 1000)
    assert(!map.has("a100a"))
    assert((map.get("a101a") !? 0) == 101)
}

mode TestLowerString for String {
    + fn equals(cmp: TestLowerString) bool $eq {
        return this.lower() == cmp.lower()
    }
    + fn hash() uint $hash {
        return this.lower().hash()
    }
}

test "HashMap keys honour $eq and $hash" {
    let h = HashMap[TestLowerString, int]{}
    h.set("HELLO", 1)
    h.set("hello", 2)
    assert(h.length == 1)
    assert((h.get("Hello") !? -1) == 2)

    let u = Array[TestLowerString]{ "HELLO", "hello", "HeLLo" }
    u.remove_duplicates()
    assert(u.length == 1)
}

test "HashMap mixes patterned integer keys" {
    let map = HashMap[uint, uint]{}
    let i : uint = 0
    while i < 1000 {
        map.set(i * 128, i)
        i++
    }

    let valid = true
    i = 0
    while i < 1000 {
        if (map.get(i * 128) !? 9999) != i {
            valid = false
            break
        }
        i++
    }
    assert(valid)
    assert(map.allocated_buckets_for_test() > 1)
}

test "HashMap reuses deleted buckets and keeps dense values aligned" {
    let map = HashMap[uint, String]{}
    let keys = Array[uint].new(512)
    let i: uint = 0
    while i < 512 {
        map.set(i, "value-%i")
        keys.append(i)
        i++
    }

    i = 0
    let valid = true
    while i < 20_000 {
        let slot = i % keys.length
        let remove = keys.get(slot) !? 0
        let insert = 512 + i
        map.remove(remove)
        map.set(insert, "value-%insert")
        keys.set(slot, insert) _
        if map.has(remove) || (map.get(insert) !? "") != "value-%insert" {
            valid = false
            break
        }
        i++
    }

    assert(valid)
    assert(map.length == 512)
    map.sort_keys()
    let failure = ""
    each map as value, key {
        if failure == "" && value != "value-%key" : failure = "key %key holds %value"
    }
    if failure != "" : println(failure)
    assert(failure == "")
}

test "HashMap replaces a cache entry with one probe result" {
    let map = HashMap[uint, String]{1 => "one", 2 => "two", 3 => "three"}

    let value, found = map.get_or_replace(2, 1, "replacement") ! panic("existing cache lookup failed")
    assert(found)
    assert(value == "two")
    assert(map.length == 3)
    assert((map.get(1) !? "") == "one")

    let value2, found2 = map.get_or_replace(4, 1, "four") ! panic("cache replacement failed")
    assert(!found2)
    assert(value2 == "four")
    assert(map.length == 3)
    assert(!map.has(1))
    assert((map.get(4) !? "") == "four")
}

test "HashMap can reserve entry capacity" {
    let map = HashMap[uint, String].new(100)
    // Room for 100 entries at 3/4 load
    assert(map.bucket_count_for_test() >= 134)
    assert(map.length == 0)

    let initial_buckets = map.bucket_count_for_test()
    let i: uint = 0
    while i < 100 {
        map.set(i, "value-%i")
        i++
    }
    assert(map.bucket_count_for_test() == initial_buckets)
}

mode TestCollisionKey for uint {
    + fn hash() uint $hash {
        return 0
    }
}

test "HashMap deletion preserves colliding search chains" {
    let map = HashMap[TestCollisionKey, uint].new(64)
    let i: uint = 0
    while i < 64 {
        map.set(i, i * 3)
        i++
    }

    i = 0
    let failure = ""
    while i < 32 {
        let replacement = 1000 + i
        let value, found = map.get_or_replace(replacement, i, replacement * 3) ! panic("colliding key disappeared")
        if failure == "" && (found || value != replacement * 3) : failure = "replacement #%i returned found=%found value=%value"
        i++
    }

    i = 32
    while i < 64 {
        let actual = map.get(i) !? 0
        if failure == "" && actual != i * 3 : failure = "key %i holds %actual"
        i++
    }
    i = 0
    while i < 32 {
        let key = 1000 + i
        let actual = map.get(key) !? 0
        if failure == "" && actual != key * 3 : failure = "replacement key %key holds %actual"
        i++
    }
    if failure != "" : println(failure)
    assert(failure == "")
}

struct UnorderedKey {
    id: uint (0)
    + fn hash() uint $hash { return this.id }
    + fn eq(other: UnorderedKey) bool $eq { return this.id == other.id }
}

test "HashMap/FlatMap: keys without an order have no sort_keys" {
    let map = HashMap[UnorderedKey, String]{}
    map.set(UnorderedKey{ id: 1 }, "one")
    assert((map.get(UnorderedKey{ id: 1 }) !? "") == "one")
    let flat = FlatMap[UnorderedKey, String]{}
    flat.set(UnorderedKey{ id: 2 }, "two")
    assert((flat.get(UnorderedKey{ id: 2 }) !? "") == "two")
    let has_sort = false
    #if HashMap[UnorderedKey, String].$has_method(sort_keys) || FlatMap[UnorderedKey, String].$has_method(sort_keys)
    has_sort = true
    #end
    assert(!has_sort)

    let ordered = HashMap[int, String]{ 3 => "c", 1 => "a", 2 => "b" }
    ordered.sort_keys()
    let keys = ordered.keys()
    assert((keys.get(0) !? 0) == 1 && (keys.get(1) !? 0) == 2 && (keys.get(2) !? 0) == 3)
}

test "HashMap: clear keeps the requested capacity" {
    let map = HashMap[uint, String].new(100)
    let buckets = map.bucket_count_for_test()
    map.set(1, "one")
    map.clear()
    assert(map.length == 0)
    assert(!map.has(1))
    assert(map.bucket_count_for_test() == buckets)
    let i: uint = 0
    while i < 100 {
        map.set(i, "value")
        i++
    }
    assert(map.bucket_count_for_test() == buckets)
    assert(map.length == 100)
    assert((map.get(99) !? "") == "value")
}

test "HashMap: small maps scan and switch to buckets past eight entries" {
    let map = HashMap[String, uint]{}
    let i: uint = 0
    while i < 8 {
        map.set("key-%i", i)
        i++
    }
    // Eight entries stay a small map without buckets
    assert(map.allocated_buckets_for_test() == 0)
    assert((map.get("key-3") !? 99) == 3 && !map.has("key-8"))
    map.set("key-3", 30)
    assert(map.length == 8 && (map.get("key-3") !? 99) == 30)

    // Removing keeps the others findable; the last entry takes the removed one's place
    map.remove("key-0")
    assert(map.length == 7 && !map.has("key-0") && (map.get("key-7") !? 99) == 7)
    let replaced, found = map.get_or_replace("new", "key-1", 100) ! { assert(false) return }
    assert(!found && replaced == 100 && !map.has("key-1") && (map.get("new") !? 0) == 100)
    let kept, found_kept = map.get_or_replace("new", "key-2", 5) ! { assert(false) return }
    assert(found_kept && kept == 100 && map.has("key-2"))
    let duplicate = false
    map.set_unique("new", 1) ! { duplicate = error_is(E.code, exists) }
    assert(duplicate)

    // The ninth entry builds the buckets; everything is still there
    i = 20
    while map.length < 9 {
        map.set("key-%i", i)
        i++
    }
    assert(map.allocated_buckets_for_test() == 9)
    assert((map.get("key-3") !? 99) == 30 && (map.get("new") !? 0) == 100 && (map.get("key-7") !? 99) == 7)
    map.remove("key-3")
    assert(!map.has("key-3") && map.allocated_buckets_for_test() == 8)

    // A cleared map is small again
    map.clear()
    assert(map.length == 0 && map.allocated_buckets_for_test() == 0)
    map.set("again", 1)
    assert((map.get("again") !? 0) == 1)
}

test "HashMap: a small reserved capacity stays a small map" {
    let map = HashMap[uint, String].new(4)
    assert(map.allocated_buckets_for_test() == 0)
    map.set(1, "one")
    map.set(2, "two")
    assert((map.get(2) !? "") == "two" && map.length == 2)
    let values = ""
    each map as value, key : values += value
    assert(values == "onetwo")
}

// The reference for the random tests: parallel arrays in HashMap's entry order
fn map_reference_index(keys: Array[uint], key: uint) ?uint {
    each keys as k, i {
        if k == key : return i
    }
    return null
}

fn try_get_or_replace(map: $M, key: uint, remove_key: uint, replacement: uint) (uint, bool, bool) {
    let value, found = map.get_or_replace(key, remove_key, replacement) ! return (0, false, true)
    return (value, found, false)
}

// Random set/remove/get_or_replace calls on `map`, checked against the reference after
// every step; returns the first difference
fn random_map_ops(map: $M, seed: uint, key_range: uint) String {
    let keys = Array[uint]{}
    let values = Array[uint]{}
    let state = seed
    let op: uint = 0
    while op < 6000 {
        state ^= state << 13
        state ^= state >> 7
        state ^= state << 17
        let key = (state >> 8) % key_range
        let kind = (state >> 40) % 8
        let index = map_reference_index(keys, key)
        if kind < 4 {
            map.set(key, op)
            if isset(index) {
                values.set(index, op) _
            } else {
                keys.append(key)
                values.append(op)
            }
        } else if kind < 7 {
            map.remove(key)
            if isset(index) {
                keys.swap_remove(index)
                values.swap_remove(index)
            }
        } else {
            let remove_key = (state >> 24) % key_range
            let remove_index = map_reference_index(keys, remove_key)
            let value, found, failed = try_get_or_replace(map, key, remove_key, op)
            if isset(index) {
                let want = values.get(index) !? 0
                if failed || !found || value != want : return "op %op: get_or_replace of held key %key"
            } else if isset(remove_index) {
                if failed || found || value != op : return "op %op: get_or_replace of %key for %remove_key"
                keys.swap_remove(remove_index)
                values.swap_remove(remove_index)
                keys.append(key)
                values.append(op)
            } else if !failed {
                return "op %op: get_or_replace without %key and %remove_key did not throw"
            }
        }

        if map.length != keys.length : return "op %op: length %{map.length}, expected %{keys.length}"
        let probe = (state >> 20) % key_range
        let probe_index = map_reference_index(keys, probe)
        let got = map.get(probe) !? 1_000_000
        let want: uint = 1_000_000
        if isset(probe_index) : want = values.get(probe_index) !? 0
        if got != want : return "op %op: key %probe holds %got, expected %want"
        op++
    }

    let map_keys = map.keys()
    each keys as k, i {
        let got: uint = map_keys.get(i) !? 1_000_000
        if got != k : return "entry %i is %got, expected %k"
    }
    return ""
}

test "HashMap: random operations match a reference, in entry order" {
    let failure = random_map_ops(HashMap[uint, uint]{}, 88172645463325252, 300)
    if failure == "" : failure = random_map_ops(HashMap[uint, uint]{}, 1234567, 12)
    if failure != "" : println(failure)
    assert(failure == "")
}

test "HashMap: random operations on keys that all collide match a reference" {
    let failure = random_map_ops(HashMap[TestCollisionKey, uint]{}, 88172645463325252, 60)
    if failure != "" : println(failure)
    assert(failure == "")
}

test "HashMap: removals in full groups stay searchable and are reused" {
    // Every key starts its search in the same group, so the first groups fill up
    let map = HashMap[TestCollisionKey, uint].new(32)
    let i: uint = 0
    while i < 24 {
        map.set(i, i)
        i++
    }
    i = 0
    while i < 8 {
        map.remove(i)
        i++
    }
    i = 8
    let missing = false
    while i < 24 {
        if (map.get(i) !? 99) != i : missing = true
        i++
    }
    assert(!missing && !map.has(3))
    let buckets = map.bucket_count_for_test()
    i = 100
    while i < 108 {
        map.set(i, i)
        i++
    }
    assert(map.length == 24 && map.allocated_buckets_for_test() == 24 && map.bucket_count_for_test() == buckets)
    assert((map.get(105) !? 0) == 105 && (map.get(20) !? 0) == 20)
}

test "HashMap: steady insert and remove churn grows the table at most once" {
    let map = HashMap[uint, uint].new(100)
    let buckets = map.bucket_count_for_test()
    let i: uint = 0
    while i < 100 {
        map.set(i, i)
        i++
    }
    while i < 20_000 {
        map.remove(i - 100)
        map.set(i, i)
        i++
    }
    // Removed entries leave markers; past half full the table doubles once, after that
    // it is rebuilt at the same size
    let grown = map.bucket_count_for_test()
    assert(grown <= buckets * 2)
    while i < 60_000 {
        map.remove(i - 100)
        map.set(i, i)
        i++
    }
    assert(map.length == 100 && map.bucket_count_for_test() == grown)
    assert((map.get(59_999) !? 0) == 59_999 && (map.get(59_900) !? 0) == 59_900 && !map.has(59_899))
}

test "HashMap: remove_where and retain keep the order of the rest" {
    let small = Map[int]{ "a" => 1, "b" => 2, "c" => 3, "d" => 4 }
    small.remove_where(fn(v: int, k: String) bool { return v % 2 == 0 })
    assert(small.keys().join(",") == "a,c")
    small.retain(fn(v: int, k: String) bool { return k != "a" })
    assert(small.keys().join(",") == "c")
    assert((small.get("c") !? 0) == 3)
    assert(!small.has("a"))

    // A map with a bucket table rebuilds it
    let big = HashMap[uint, uint]{}
    each 0 .. 100 as i : big.set(i.to(uint), i.to(uint) * 10)
    big.retain(fn(v: uint, k: uint) bool { return k % 3 == 0 })
    assert(big.length == 34)
    assert((big.get(99) !? 0) == 990)
    assert(!big.has(98))
    let order: uint = 0
    each big as v, k {
        assert(k == order)
        order += 3
    }
    big.set(98, 1)
    assert((big.get(98) !? 0) == 1)

    // Inside `each` over the map every kept entry is still visited once
    let m = Map[int]{ "a" => 1, "b" => 2, "c" => 3, "d" => 4, "e" => 5 }
    let seen = Array[String]{}
    each m as v, k {
        seen.append(k)
        if k == "a" : m.remove_where(fn(v: int, k: String) bool { return v >= 4 })
    }
    assert(seen.join(",") == "a,b,c")
    assert(m.keys().join(",") == "a,b,c")
}

test "FlatMap: remove_where and retain" {
    let m = FlatMap[String, int]{ "a" => 1, "b" => 2, "c" => 3, "d" => 4 }
    m.remove_where(fn(v: int, k: String) bool { return v == 2 })
    assert(m.keys().join(",") == "a,c,d")
    m.retain(fn(v: int, k: String) bool { return v > 1 })
    assert(m.keys().join(",") == "c,d")
    let seen = Array[String]{}
    each m as v, k {
        seen.append(k)
        m.remove_where(fn(v: int, k: String) bool { return k == "d" })
    }
    assert(seen.join(",") == "c")
    assert(m.length == 1)
}

test "HashSet: remove_where and retain" {
    let set = HashSet[int]{ 1, 2, 3, 4, 5, 6 }
    set.remove_where(fn(v: int) bool { return v > 4 })
    assert(set.items().length == 4)
    set.retain(fn(v: int) bool { return v % 2 == 0 })
    assert(set.has(2) && set.has(4) && !set.has(1) && !set.has(5))
    assert(set.length == 2)
}

struct MapKeyPoint {
    x: int
    y: int
}

struct MapKeyNamed {
    name: String
    at: MapKeyPoint
    tag: ?String
}

test "HashMap: structs, tuples and fixed arrays hash their parts" {
    let grid = HashMap[MapKeyPoint, String]{}
    grid.set(MapKeyPoint { x: 1, y: 2 }, "a")
    grid.set(MapKeyPoint { x: 2, y: 1 }, "b")
    grid.set(MapKeyPoint { x: 1, y: 2 }, "c")
    assert(grid.length == 2)
    assert((grid.get(MapKeyPoint { x: 1, y: 2 }) !? "") == "c")
    // Past the small-map scan, so the hash decides where keys land
    each 0 .. 100 as i : grid.set(MapKeyPoint { x: i, y: i * 3 }, "v" + i)
    assert(grid.length == 102)
    assert((grid.get(MapKeyPoint { x: 42, y: 126 }) !? "") == "v42")
    assert(!grid.has(MapKeyPoint { x: 42, y: 127 }))

    // Text compares by content, so equal text from different places is one key
    let pairs = HashMap[(int, String), uint]{}
    pairs.set((1, "x"), 10)
    pairs.set((1, "y"), 20)
    let x = "x"
    pairs.set((1, x + ""), 30)
    assert(pairs.length == 2)
    assert((pairs.get((1, "x")) !? 0) == 30)

    let names = HashSet[MapKeyNamed]{}
    names.add(MapKeyNamed { name: "a", at: MapKeyPoint { x: 0, y: 0 }, tag: null })
    names.add(MapKeyNamed { name: "a", at: MapKeyPoint { x: 0, y: 0 }, tag: null })
    names.add(MapKeyNamed { name: "a", at: MapKeyPoint { x: 0, y: 0 }, tag: "t" })
    names.add(MapKeyNamed { name: "a", at: MapKeyPoint { x: 0, y: 1 }, tag: "t" })
    assert(names.length == 3)

    let bytes = HashMap[[u8 x 4], bool]{}
    bytes.set([u8 x 4]{ 1, 2, 3, 4 }, true)
    assert(bytes.has([u8 x 4]{ 1, 2, 3, 4 }))
    assert(!bytes.has([u8 x 4]{ 4, 3, 2, 1 }))
}


test "Map: initialization & get-by-key" {
    // let m = Map[String]{ "a" => "1", "b" => "2", "c" => "3" }
    let m = Map[String].new()
    m.set("a", "1")
    m.set("b", "2")
    m.set("c", "3")

    assert((m.get("a") !? "0") == "1")
    assert((m.get("b") !? "0") == "2")
    assert((m.get("c") !? "0") == "3")
    assert((m.get("d") !? "0") == "0")
}

test "HashMap" {
    let m = HashMap[String, String]{}
    m.set("a", "1")
    m.set("b", "2")
    m.set("c", "3")
    m.set("xy", "4")

    assert((m.get("a") !? "0") == "1")
    assert((m.get("b") !? "0") == "2")
    assert((m.get("c") !? "0") == "3")
    assert((m.get("d") !? "0") == "0")
    assert((m.get("x" + "y") !? "0") == "4")

    let m2 = HashMap[uint, String]{}
    m2.set(0, "1")
    m2.set(2, "2")
    m2.set(4, "3")

    assert((m2.get(0) !? "0") == "1")
    assert((m2.get(2) !? "0") == "2")
    assert((m2.get(4) !? "0") == "3")
    assert((m2.get(1) !? "0") == "0")
}

test "HashMap copy is independent" {
    let original = HashMap[String, int]{ "value" => 1 }
    let copied = original.copy()

    copied.set("value", 2)
    copied.set("new", 3)

    assert((original.get("value") !? 0) == 1)
    assert(!original.has("new"))
    assert((copied.get("value") !? 0) == 2)
    assert((copied.get("new") !? 0) == 3)
}

test "Maps reject duplicate unique keys" {
    let hash = HashMap[String, uint]{}
    let hash_result = hash.set_unique("key", 1) ! panic("HashMap rejected a new unique key")
    assert(hash_result == hash)

    let hash_duplicate = false
    hash.set_unique("key", 2) ! { hash_duplicate = true }
    assert(hash_duplicate)
    assert(hash.length == 1)
    assert((hash.get("key") !? 0) == 1)

    let flat = FlatMap[String, uint]{}
    let flat_result = flat.set_unique("key", 1) ! panic("FlatMap rejected a new unique key")
    assert(flat_result == flat)

    let flat_duplicate = false
    flat.set_unique("key", 2) ! { flat_duplicate = true }
    assert(flat_duplicate)
    assert(flat.length == 1)
    assert((flat.get("key") !? 0) == 1)
}

test "HashMap grows and distributes keys" {
    let map = HashMap[String, uint]{}

    // Read-only misses must not allocate buckets.
    assert(map.allocated_buckets_for_test() == 0)
    assert(!map.has("missing"))
    assert((map.get("missing") !? 999) == 999)
    assert(map.allocated_buckets_for_test() == 0)



    let i : uint = 0
    while i < 2000 {
        map.set("a%{i}a", i)
        i++
    }
    assert(map.length == 2000)
    assert(map.bucket_count_for_test() > 128)

    let valid = true
    i = 0
    while i < 2000 {
        if (map.get("a%{i}a") !? 9999) != i {
            valid = false
            break
        }
        i++
    }
    assert(valid)

    map.set("a100a", 5000)
    assert(map.length == 2000)
    assert((map.get("a100a") !? 0) == 5000)

    i = 0
    while i < 1000 {
        map.remove("a%{i * 2}a")
        i++
    }
    assert(map.length == 1000)
    assert(!map.has("a100a"))
    assert((map.get("a101a") !? 0) == 101)
}

mode TestLowerString for String {
    fn equals(cmp: TestLowerString) bool $eq {
        return this.lower() == cmp.lower()
    }
    fn hash() uint $hash {
        return this.lower().hash()
    }
}

test "HashMap keys honour $eq and $hash" {
    let h = HashMap[TestLowerString, int]{}
    h.set("HELLO", 1)
    h.set("hello", 2)
    assert(h.length == 1)
    assert((h.get("Hello") !? -1) == 2)

    let u = Array[TestLowerString]{ "HELLO", "hello", "HeLLo" }.unique()
    assert(u.length == 1)
}

test "HashMap mixes patterned integer keys" {
    let map = HashMap[uint, uint]{}
    let i : uint = 0
    while i < 1000 {
        map.set(i * 128, i)
        i++
    }

    let valid = true
    i = 0
    while i < 1000 {
        if (map.get(i * 128) !? 9999) != i {
            valid = false
            break
        }
        i++
    }
    assert(valid)
    assert(map.allocated_buckets_for_test() > 1)
}

test "HashMap reuses deleted buckets and keeps dense values aligned" {
    let map = HashMap[uint, String]{}
    let keys = Array[uint].new(512)
    let i: uint = 0
    while i < 512 {
        map.set(i, "value-%i")
        keys.append(i)
        i++
    }

    i = 0
    let valid = true
    while i < 20_000 {
        let slot = i % keys.length
        let remove = keys.get(slot) !? 0
        let insert = 512 + i
        map.remove(remove)
        map.set(insert, "value-%insert")
        keys.set(slot, insert) _
        if map.has(remove) || (map.get(insert) !? "") != "value-%insert" {
            valid = false
            break
        }
        i++
    }

    assert(valid)
    assert(map.length == 512)
    map.sort_keys()
    each map as value, key {
        assert(value == "value-%key")
    }
}

test "HashMap replaces a cache entry with one probe result" {
    let map = HashMap[uint, String]{1 => "one", 2 => "two", 3 => "three"}

    let value, found = map.get_or_replace(2, 1, "replacement") ! panic("existing cache lookup failed")
    assert(found)
    assert(value == "two")
    assert(map.length == 3)
    assert((map.get(1) !? "") == "one")

    let value2, found2 = map.get_or_replace(4, 1, "four") ! panic("cache replacement failed")
    assert(!found2)
    assert(value2 == "four")
    assert(map.length == 3)
    assert(!map.has(1))
    assert((map.get(4) !? "") == "four")
}

test "HashMap can reserve entry capacity" {
    let map = HashMap[uint, String].new(100)
    assert(map.bucket_count_for_test() >= 134)
    assert(map.length == 0)

    let initial_buckets = map.bucket_count_for_test()
    let i: uint = 0
    while i < 100 {
        map.set(i, "value-%i")
        i++
    }
    assert(map.bucket_count_for_test() == initial_buckets)
}

mode TestCollisionKey for uint {
    fn hash() uint $hash {
        return 0
    }
}

test "HashMap backward-shift deletion preserves colliding probe chains" {
    let map = HashMap[TestCollisionKey, uint].new(64)
    let i: uint = 0
    while i < 64 {
        map.set(i, i * 3)
        i++
    }

    i = 0
    while i < 32 {
        let replacement = 1000 + i
        let value, found = map.get_or_replace(replacement, i, replacement * 3) ! panic("colliding key disappeared")
        assert(!found)
        assert(value == replacement * 3)
        i++
    }

    i = 32
    while i < 64 {
        assert((map.get(i) !? 0) == i * 3)
        i++
    }
    i = 0
    while i < 32 {
        let key = 1000 + i
        assert((map.get(key) !? 0) == key * 3)
        i++
    }
}

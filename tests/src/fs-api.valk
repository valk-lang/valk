use valk.fs
use valk.io
use valk.time

test "fs: write modes preserve, truncate and append explicitly" {
    let path = fs.add(fs.exe_dir() !? "", "fs-write-modes.txt")
    defer fs.delete_file(path) _
    each [fs.WriteMode]{ fs.WriteMode.preserve, fs.WriteMode.truncate, fs.WriteMode.append } as mode {
        fs.write(path, "abcdef") ! { assert(false); return }
        let stream = fs.stream(path, fs.OpenOptions { write: mode }) ! { assert(false); return }
        assert((stream.seek(2) !? 99) == 2)
        assert((stream.write("XY") !? 99) == 2)
        assert(stream.position == (mode == fs.WriteMode.append ? 8 : 4))
        stream.close() ! assert(false)
        let content = fs.read(path) !? ""
        if mode == fs.WriteMode.preserve : assert(content == "abXYef")
        else if mode == fs.WriteMode.append : assert(content == "abcdefXY")
        else {
            assert(content.bytes == 4)
            assert(content[0] == 0 && content[1] == 0)
            assert(content[2] == 'X' && content[3] == 'Y')
        }
    }
    fs.write(path, "abcdef") ! assert(false)
    let stream = fs.stream(path, fs.OpenOptions { write: fs.WriteMode.preserve, create: true }) ! { assert(false); return }
    let bytes = [u8]{ 0 x 2 }
    assert((stream.read(bytes) !? 99) == 2)
    assert(bytes.to_string() == "ab")
    assert((stream.write("XY") !? 99) == 2)
    stream.close() ! assert(false)
    assert((fs.read(path) !? "") == "abXYef")
}

test "fs: every write mode supports creation and exclusive creation" {
    let path = fs.add(fs.exe_dir() !? "", "fs-create-modes.txt")
    defer fs.delete_file(path) _
    each [fs.WriteMode]{ fs.WriteMode.preserve, fs.WriteMode.truncate, fs.WriteMode.append } as mode {
        if fs.exists(path) : fs.delete_file(path) ! assert(false)
        let missing = false
        fs.open(path, fs.OpenOptions { write: mode }) ! { missing = error_is(E.code, open) }
        assert(missing)
        let fd = fs.open(path, fs.OpenOptions { read: false, write: mode, create: true, exclusive: true }) ! { assert(false); return }
        io.write(fd, "keep") ! assert(false)
        io.close(fd) ! assert(false)
        let exists = false
        fs.open(path, fs.OpenOptions { write: mode, create: true, exclusive: true }) ! { exists = true }
        assert(exists)
        assert((fs.read(path) !? "") == "keep")
        let invalid = false
        fs.open(path, fs.OpenOptions { write: mode, exclusive: true }) ! { invalid = true }
        assert(invalid)
    }
}

test "fs: stat returns combined metadata and reports missing paths" {
    let root = fs.add(fs.exe_dir() !? "", "fs-stat-test")
    fs.create_dir(root) ! { assert(false); return }
    defer fs.delete_all(root) _
    let path = fs.add(root, "metadata.txt")
    fs.write(path, "metadata") ! { assert(false); return }
    let info = fs.stat(path) ! { assert(false); return }
    assert(info.kind == fs.FileKind.file)
    assert(info.size == 8)
    assert(info.modified_time > 1_000_000_000_000_000_000)
    assert(info.modified_time <= time.unix_ns() + 2_000_000_000)
    assert((fs.size(path) !? 0) == info.size)
    assert((fs.modified_time(path) !? 0) == info.modified_time)
    let directory = fs.stat(root) ! { assert(false); return }
    assert(directory.kind == fs.FileKind.directory)
    #if OS != "win"
    fs.chmod(path, 0c640) ! assert(false)
    info = fs.stat(path) ! { assert(false); return }
    assert(info.permissions == 0c640)
    let link = fs.add(root, "link")
    fs.symlink(link, path, false) ! { assert(false); return }
    let linked = fs.stat(link) ! { assert(false); return }
    assert(linked.kind == fs.FileKind.file)
    assert(linked.size == info.size)
    assert(linked.permissions == info.permissions)
    assert(linked.modified_time == info.modified_time)
    fs.delete_file(path) ! assert(false)
    let dangling = false
    fs.stat(link) ! { dangling = error_is(E.code, open) }
    assert(dangling)
    #else
    assert(info.permissions == 0c666)
    fs.chmod(path, 0c444) ! assert(false)
    info = fs.stat(path) ! { assert(false); return }
    assert(info.permissions == 0c444)
    fs.chmod(path, 0c666) ! assert(false)
    #end
    let missing = false
    fs.stat(fs.add(root, "missing")) ! { missing = error_is(E.code, open) }
    assert(missing)
}

test "fs: read_dir yields bare names and closes at exhaustion" {
    let root = fs.add(fs.exe_dir() !? "", "fs-iterator-test")
    fs.create_dir(root) ! { assert(false); return }
    defer fs.delete_all(root) _
    fs.write(fs.add(root, "résumé-🦊.txt"), "one") ! assert(false)
    fs.write(fs.add(root, ".hidden"), "two") ! assert(false)
    fs.create_dir(fs.add(root, "nested")) ! assert(false)
    fs.write(fs.add(root, "nested/child"), "three") ! assert(false)
    let entries = fs.read_dir(root) ! { assert(false); return }
    defer entries.close() _
    let names = Array[String]{}
    while true {
        let name = entries.next() ! { assert(false); return }
        if !isset(name) : break
        names.append(name)
    }
    assert(names.length == 3)
    assert(names.contains("résumé-🦊.txt"))
    assert(names.contains(".hidden"))
    assert(names.contains("nested"))
    assert(entries.closed)
    assert((entries.next() !? "error") == null)
    entries.close() ! assert(false)
    let collected = fs.files_in(root, false, true, true, true) ! { assert(false); return }
    assert(collected.length == names.length)
    each collected as name : assert(names.contains(name))
}

test "fs: read_dir handles empty, missing, non-directory and early close" {
    let root = fs.add(fs.exe_dir() !? "", "fs-iterator-empty")
    fs.create_dir(root) ! { assert(false); return }
    defer fs.delete_all(root) _
    let empty = fs.read_dir(root) ! { assert(false); return }
    assert((empty.next() !? "error") == null)
    assert(empty.closed)
    let missing = false
    fs.read_dir(fs.add(root, "missing")) ! { missing = error_is(E.code, open) }
    assert(missing)
    fs.write(fs.add(root, "file"), "data") ! assert(false)
    let not_dir = false
    fs.read_dir(fs.add(root, "file")) ! { not_dir = error_is(E.code, open) }
    assert(not_dir)
    let early = fs.read_dir(root) ! { assert(false); return }
    assert((early.next() !? "error") == "file")
    early.close() ! assert(false)
    early.close() ! assert(false)
    let closed = false
    early.next() ! { closed = error_is(E.code, closed) }
    assert(closed)
}

test "fs: read_into and write_from stream files through writers and readers" {
    let path = fs.add(fs.exe_dir() !? "", "fs-into-from.txt")
    defer fs.delete_file(path) _
    // A reader fills the file in small chunks
    assert((fs.write_from(path, "0123456789".reader(), false, 4) !!) == 10)
    assert((fs.read(path) !!) == "0123456789")
    // Appending keeps what is there
    assert((fs.write_from(path, "ab".reader(), true) !!) == 2)
    assert((fs.read(path) !!) == "0123456789ab")

    // The file reaches a writer piece by piece
    let counting = CountingWriter {}
    assert((fs.read_into(path, counting, 5) !!) == 12)
    assert(counting.out.to_string() == "0123456789ab")
    assert(counting.writes == 3)
    let buf = ByteBuffer.new()
    assert((fs.read_into(path, buf) !!) == 12)
    assert(buf.to_string() == "0123456789ab")

    // A missing file is an open error, and nothing is written
    let missing = false
    fs.read_into(fs.add(fs.exe_dir() !? "", "fs-into-missing.txt"), buf) ! { missing = error_is(E.code, open) }
    assert(missing)
    assert(buf.length == 12)

    // An in-memory file writes itself out without a copy
    buf.clear()
    let file = fs.InMemoryFile.new("held")
    assert((file.write_into(buf) !!) == 4)
    assert(buf.to_string() == "held")
}

test "fs: a directory iterator writes entry names into a writer" {
    let dir = fs.add(fs.exe_dir() !? "", "fs-next-into")
    if fs.exists(dir) : fs.delete_all(dir) ! assert(false)
    fs.create_dir(dir) ! { assert(false); return }
    defer fs.delete_all(dir) _
    fs.write(fs.add(dir, "alpha.txt"), "a") ! assert(false)
    fs.write(fs.add(dir, "beta.txt"), "b") ! assert(false)

    let names = Array[String]{}
    let buf = ByteBuffer.new()
    let it = fs.read_dir(dir) !!
    while true {
        buf.clear()
        let count = it.next_into(buf) !!
        if !isset(count) : break
        assert(count == buf.length)
        names.append(buf.to_string())
    }
    assert(names.length == 2)
    assert(names.contains("alpha.txt") && names.contains("beta.txt"))
    // The end was reached, so the iterator closed itself and stays at the end
    assert(!isset(it.next_into(buf) !!))
    assert(!isset(it.next() !!))
}

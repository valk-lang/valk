use valk.gc
use valk.io
use valk.net
use valk.http
use valk.json
use valk.regex
use valk.template

union EuIo {
    open
    read
    timeout
    closed
}

union EuNet {
    connect
    ssl
    io(EuIo) $auto
}

union EuParse {
    empty
    invalid(String, uint, u8)
    too_deep(uint)

    fn summary() String {
        return match this : String {
            .empty => "empty"
            .invalid(msg, at, _) => msg + "@" + at
            .too_deep(d) => "depth:" + d
        }
    }
}

union EuHttp {
    invalid_url(String)
    status(uint)
    net(EuNet) $auto
    parse(EuParse) $auto
}

fn eu_read(fail: int) int !EuIo {
    if fail == 1 : throw .timeout
    if fail == 2 : throw .closed
    return 42
}

fn eu_net_call(fail: int) int !EuNet {
    if fail == 3 : throw .ssl
    return eu_read(fail) !>
}

fn eu_parse_call(fail: int) int !EuParse {
    if fail == 1 : throw .empty
    if fail == 2 : throw .invalid("unexpected", 17, '!')
    if fail == 3 : throw .too_deep(64)
    return 99
}

fn eu_http_call(mode: int) int !EuHttp {
    if mode == 1 : throw .invalid_url("ftp://bad")
    if mode == 2 : throw .status(404)
    if mode == 3 : return eu_net_call(1) !>      // transitive: EuIo -> EuNet -> EuHttp
    if mode == 4 : return eu_net_call(3) !>      // direct: EuNet -> EuHttp
    if mode == 5 : return eu_parse_call(2) !>    // direct with GC String payload: EuParse -> EuHttp
    if mode == 6 : return eu_read(2) !>          // transitive directly from EuIo -> EuNet -> EuHttp
    return 200
}

fn eu_defer_clobber_inner(msg: String) int !EuParse {
    throw .invalid(msg, 5, 'a')
}

fn eu_defer_preserves_error() int !EuParse {
    defer {
        // Trigger GC and throw/catch another EuParse inside defer!
        gc.collect()
        let _ = eu_defer_clobber_inner("from-defer") !? 0
    }
    return eu_defer_clobber_inner("outer-error") !>
}

fn eu_throw_with_defer() int !EuParse {
    let owned = "thrown-" + "with-defer"
    defer {
        gc.collect()
        let _ = eu_defer_clobber_inner("from-defer-2") !? 0
    }
    throw .invalid(owned, 9, 'z')
}

test "Error unions: payloadless throw, catch, match, fallback, and equality" {
    assert((eu_read(0) !? -1) == 42)
    assert((eu_read(1) !? -1) == -1)

    let caught = ""
    eu_read(1) ! {
        assert(E == .timeout)
        caught = match E : String {
            .open => "open"
            .read => "read"
            .timeout => "timeout"
            .closed => "closed"
        }
    }
    assert(caught == "timeout")

    eu_read(2) _
}

test "Error unions: payload variants, methods, and $auto auto-wrapping" {
    assert((eu_http_call(0) !? 0) == 200)

    let describe = fn(mode: int) String {
        eu_http_call(mode) ! {
            return match E : String {
                .invalid_url(u) => "url:" + u
                .status(code) => "status:" + code
                .net(.ssl) => "net:ssl"
                .net(.connect) => "net:connect"
                .net(.io(.timeout)) => "net:io:timeout"
                .net(.io(.closed)) => "net:io:closed"
                .net(_) => "net:other"
                .parse(p) => "parse:" + p.summary()
            }
        }
        return "ok"
    }

    assert(describe(1) == "url:ftp://bad")
    assert(describe(2) == "status:404")
    assert(describe(3) == "net:io:timeout")
    assert(describe(4) == "net:ssl")
    assert(describe(5) == "parse:unexpected@17")
    assert(describe(6) == "net:io:closed")
}

test "Error unions: defers with GC and nested throws do not clobber propagated errors" {
    let m1 = ""
    eu_defer_preserves_error() ! {
        m1 = E.summary()
    }
    assert(m1 == "outer-error@5")

    let m2 = ""
    eu_throw_with_defer() ! {
        m2 = E.summary()
    }
    assert(m2 == "thrown-with-defer@9")
}

test "Error unions: closures and coroutines preserve union payloads across GC" {
    let f: fn(int)(int !EuParse) = fn(x: int) int !EuParse {
        if x < 0 : throw .invalid("neg", 1, '-')
        return x * 2
    }
    assert((f(5) !? 0) == 10)
    let cerr = ""
    f(-1) ! { cerr = E.summary() }
    assert(cerr == "neg@1")

    let t1 = co eu_parse_call(2)
    let t2 = co eu_http_call(5)
    gc.collect()

    let e1 = ""
    await t1 ! { e1 = E.summary() }
    assert(e1 == "unexpected@17")

    let e2 = ""
    await t2 ! {
        e2 = match E : String {
            .parse(p) => p.summary()
            default => "other"
        }
    }
    assert(e2 == "unexpected@17")
}

union EuDiamond {
    net(EuNet) $auto
    parse(EuParse) $auto
    io(EuIo) $auto
}

fn eu_diamond_direct() !EuDiamond {
    eu_read(1) !>
}

fn eu_throw_helper(msg: String) !EuParse $throw {
    throw .invalid(msg, 42, '?')
}

fn eu_use_throw_helper(fail: bool) int !EuHttp {
    if fail : eu_throw_helper("via-helper") !>
    return 1
}

fn eu_direct_from_throw() !EuHttp {
    let inner: EuParse = .too_deep(9)
    throw inner
}

test "Error unions: $throw helpers, direct $auto throw, diamond priority, and closure capture" {
    let diamond = ""
    eu_diamond_direct() ! {
        diamond = match E : String {
            .io(.timeout) => "direct-io-timeout"
            .net(_) => "via-net"
            default => "other"
        }
    }
    assert(diamond == "direct-io-timeout")

    assert((eu_use_throw_helper(false) !? 0) == 1)
    let helper_msg = ""
    eu_use_throw_helper(true) ! {
        helper_msg = match E : String {
            .parse(p) => p.summary()
            default => "other"
        }
    }
    assert(helper_msg == "via-helper@42")

    let direct_msg = ""
    eu_direct_from_throw() ! {
        direct_msg = match E : String {
            .parse(p) => p.summary()
            default => "other"
        }
    }
    assert(direct_msg == "depth:9")

    // Closure capturing caught union error survives a later throw of the same union type
    let captured = Array[fn()(String)]{}
    eu_parse_call(2) ! {
        captured.append(fn() String { return E.summary() })
    }
    eu_parse_call(3) _
    gc.collect()
    assert(captured[0]() == "unexpected@17")
}

test "Union errors: is .variant checks tags on plain and nullable unions" {
    let a: EuIo = .timeout
    assert(a is .timeout)
    assert(!(a is .closed))
    assert(a is .timeout && !(a is .open))
    assert(a is .open || a is .timeout)

    let p: EuParse = .invalid("bad", 3, 1)
    assert(p is .invalid)
    assert(!(p is .empty))
    assert(!(p is .too_deep))

    let maybe: ?EuParse = null
    assert(!(maybe is .empty))
    assert(!(maybe is .invalid))
    maybe = .too_deep(8)
    assert(maybe is .too_deep)
    assert(!(maybe is .empty))

    let hit = false
    eu_parse_call(3) ! {
        hit = E is .too_deep && !(E is .invalid)
    }
    assert(hit)
}

test "Union errors: stdlib errors convert to String via to_string() $auto" {
    let l: LookupError = .missing
    assert(l.to_string() == "missing")
    assert("%{l}" == "missing")
    assert("err: " + l == "err: missing")

    let s: SyntaxError = .syntax
    assert("%{s}" == "syntax")

    let g: GenericError = .error
    assert("%{g}" == "error")

    let io_e: io.IoError = .open
    assert("%{io_e}" == "open")

    let net_e: net.NetError = .io(.timeout)
    assert(net_e is .io)
    assert("%{net_e}" == "timeout")

    let http_e: http.HttpError = .invalid_url
    assert(http_e is .invalid_url)
    assert("%{http_e}" == "invalid_url")
    let http_status: http.HttpError = .status(404)
    assert(http_status is .status)
    assert("%{http_status}" == "status 404")

    let jp: json.ParseError = .invalid("bad token", 1, 0)
    assert(jp is .invalid)
    assert("%{jp}" == "bad token")

    let jd: json.DecodeError = .missing("id", 3)
    assert(jd is .missing)
    assert("%{jd}" == "id")

    let rx: regex.RegexError = .syntax("unclosed", 2)
    assert(rx is .syntax)
    assert("%{rx}" == "unclosed")

    let tp: template.ParseError = .parse("home", "unexpected end", 5, 2)
    assert(tp is .parse)
    assert("%{tp}" == "unexpected end")
}

// Regression: a global initializer calling a function with a multi-payload union error
// must not leak the transient error TLS slot into `#loop globals` / GC root registration.
global eu_global_json_init: bool ((json.decode("{\"ok\":true}") !? json.new_object()).get("ok").bool)
global eu_global_parse_init: int (eu_parse_call(2) !? 77)

test "Union errors: global initializers using multi-payload union errors compile and run" {
    assert(eu_global_json_init)
    assert(eu_global_parse_init == 77)
}

use valk.core

class FmtTag {
    name: String
    + fn to_string() String $auto {
        return "<" + this.name + ">"
    }
}

struct FmtPair {
    a: int
    b: int
    + fn to_string() String $auto {
        return "(" + this.a + "," + this.b + ")"
    }
}

test "Format specifiers: integers (width, zero-pad, sign, align, hex/bin/oct)" {
    let n: int = 42
    let neg: int = -42
    let u: uint = 255
    let byte: u8 = 10

    // Width and zero padding
    assert("%{n:5}" == "   42")
    assert("%{n:05}" == "00042")
    assert("%{neg:05}" == "-0042")
    assert("%{0:04}" == "0000")
    assert("%{n:d}" == "42")
    assert("%{n:02}" == "42")

    // Sign flags
    assert("%{n:+}" == "+42")
    assert("%{n:+05}" == "+0042")
    assert("%{neg:+05}" == "-0042")
    assert("%{n: }" == " 42")
    assert("%{n: 05}" == " 0042")
    assert("%{neg: 05}" == "-0042")

    // Alignment and custom fill
    assert("%{n:<6}" == "42    ")
    assert("%{n:>6}" == "    42")
    assert("%{n:^6}" == "  42  ")
    assert("%{n:^5}" == " 42  ")
    assert("%{n:*>6}" == "****42")
    assert("%{n:-<6}" == "42----")
    assert("%{n:_^6}" == "__42__")
    assert("%{neg:0>5}" == "00-42")

    // Hex, binary, octal, alternate form '#'
    assert("%{u:x}" == "ff")
    assert("%{u:X}" == "FF")
    assert("%{u:#x}" == "0xff")
    assert("%{u:#X}" == "0XFF")
    assert("%{u:#06x}" == "0x00ff")
    assert("%{u:#06X}" == "0X00FF")
    assert("%{byte:b}" == "1010")
    assert("%{byte:#08b}" == "0b001010")
    assert("%{64:o}" == "100")
    assert("%{64:#o}" == "0o100")
    assert("%{64:#07o}" == "0o00100")
    assert("%{-255:#x}" == "-0xff")
    assert("%{-255:#08x}" == "-0x000ff")

    // Various integer widths and extremes
    let i8v: i8 = -7
    let u16v: u16 = 0x1a2b
    let min_i = int.$min
    let max_u = uint.$max
    assert("%{i8v:04}" == "-007")
    assert("%{u16v:#06x}" == "0x1a2b")
    assert("%{min_i:d}" == "-9223372036854775808")
    assert("%{max_u:x}" == "ffffffffffffffff")
}

test "Format specifiers: floats (fixed, scientific, width, sign, special)" {
    let pi: f64 = 3.14159265
    let neg: f64 = -3.14159265
    let f32v: f32 = 1.5

    assert("%{pi:.2f}" == "3.14")
    assert("%{pi:.4f}" == "3.1416")
    assert("%{pi:.0f}" == "3")
    assert("%{pi:f}" == "3.141593")
    assert("%{pi:.2}" == "3.14")
    assert("%{f32v:.2f}" == "1.50")

    // Width, zero-pad, sign, align
    assert("%{pi:8.2f}" == "    3.14")
    assert("%{pi:08.2f}" == "00003.14")
    assert("%{neg:08.2f}" == "-0003.14")
    assert("%{pi:+08.2f}" == "+0003.14")
    assert("%{pi: 8.2f}" == "    3.14")
    assert("%{pi:<8.2f}" == "3.14    ")
    assert("%{pi:*^8.2f}" == "**3.14**")

    // Scientific notation
    let big: f64 = 1234.5
    assert("%{big:.2e}" == "1.23e3")
    assert("%{big:.2E}" == "1.23E3")

    // Special float values
    let inf: f64 = 1.0 / 0.0
    let ninf: f64 = -1.0 / 0.0
    let nan: f64 = 0.0 / 0.0
    assert("%{inf:06.2f}" == "   inf")
    assert("%{ninf:6.2f}" == "  -inf")
    assert("%{nan:5.2f}" == "  nan")
    assert("%{inf:+}" == "+inf")
}

test "Format specifiers: strings, UTF-8, expressions, and colons" {
    let s = "hi"
    assert("%{s:6}" == "hi    ")
    assert("%{s:<6}" == "hi    ")
    assert("%{s:>6}" == "    hi")
    assert("%{s:^6}" == "  hi  ")
    assert("%{s:*>6}" == "****hi")
    assert("%{s:.1}" == "h")
    assert("%{"abcdef":.3}" == "abc")
    assert("%{"abcdef":>6.3}" == "   abc")
    assert("%{"abcdef":*^7.3}" == "**abc**")
    assert("%{s:s}" == "hi")

    // UTF-8 character width and truncation
    let utf = "café!"
    assert("%{utf:>7}" == "  café!")
    assert("%{utf:.4}" == "café")

    // bool, char, and $auto-stringable types
    let flag = true
    let ch: char = 'A'
    let tag = FmtTag { name: "ok" }
    assert("%{flag:>6}" == "  true")
    assert("%{ch:*^5}" == "**A**")
    assert("%{tag:>8}" == "    <ok>")

    // Existing colons inside expressions remain unambiguous
    let cond = true
    assert("%{cond ? "yes" : "no"}" == "yes")
    assert("%{cond ? 7 : 9:04}" == "0007")
    assert("%{FmtPair { a: 1, b: 2 }}" == "(1,2)")
    assert("%{FmtPair { a: 1, b: 2 }:>8}" == "   (1,2)")
    let a = 10
    let b = 22
    assert("%{a + b:#06x}" == "0x0020")

    // Bare %name followed by ':' is NOT a format specifier
    let port = 8080
    assert("http://localhost:%port/api" == "http://localhost:8080/api")
    assert("%port:ok" == "8080:ok")
}

test "core.format_*: runtime format helpers and error handling" {
    assert(core.format_int(-42, "+06") !! == "-00042")
    assert(core.format_int(42, "+06") !! == "+00042")
    assert(core.format_uint(255, "#06x") !! == "0x00ff")
    assert(core.format_uint(10, "#08b") !! == "0b001010")
    assert(core.format_float(3.14159, "08.2f") !! == "00003.14")
    assert(core.format_float(1234.5, ".2E") !! == "1.23E3")
    assert(core.format_string("valk", "*^8") !! == "**valk**")
    assert(core.format_string("abcdef", ".3") !! == "abc")

    // Invalid specs throw SyntaxError.syntax
    let bad_int = false
    core.format_int(42, ".2f") ! { bad_int = E == .syntax }
    assert(bad_int)

    let bad_alt = false
    core.format_int(42, "#d") ! { bad_alt = E == .syntax }
    assert(bad_alt)

    let bad_float = false
    core.format_float(1.0, "x") ! { bad_float = E == .syntax }
    assert(bad_float)

    let bad_str = false
    core.format_string("hi", "05") ! { bad_str = E == .syntax }
    assert(bad_str)

    let bad_junk = false
    core.format_string("hi", "zzz") ! { bad_junk = E == .syntax }
    assert(bad_junk)
}

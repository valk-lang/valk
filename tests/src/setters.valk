
class SetTemp {
    c: float
    + get fahrenheit: float {
        return this.c * 9.0 / 5.0 + 32.0
    }
    + set fahrenheit(value: float) {
        this.c = (value - 32.0) * 5.0 / 9.0
    }
}

struct SetClamp {
    v: int
    get value: int {
        return this.v
    }
    set value(n: int) {
        this.v = n < 0 ? 0 : (n > 10 ? 10 : n)
    }
}

class SetHolder {
    calls: uint (0)
    temp: SetTemp (SetTemp { c: 0.0 })
    fn next() SetTemp {
        this.calls++
        return this.temp
    }
}

class SetBox[T] {
    items: Array[T] (.{})
    get first: ?T {
        return this.items.get(0) !? null
    }
    set first(value: ?T) {
        this.items.clear()
        if isset(value) : this.items.append(value)
    }
}

trait SetNamed {
    label: String ("")
    get name: String {
        return this.label
    }
    set name(value: String) {
        this.label = value.trim(" ")
    }
}

class SetPerson {
    use SetNamed
}

class SetExtended {
    n: int (0)
}

extend SetExtended {
    get double: int {
        return this.n * 2
    }
    set double(value: int) {
        this.n = value / 2
    }
}

test "Setters: assignment and compound assignment" {
    let t = SetTemp { c: 100.0 }
    assert(t.fahrenheit == 212.0)
    t.fahrenheit = 32.0
    assert(t.c == 0.0)
    t.fahrenheit += 18.0
    assert(t.c == 10.0)

    let c = SetClamp { v: 3 }
    c.value = 50
    assert(c.value == 10)
    c.value -= 4
    assert(c.value == 6)

    // The value that has the setter is evaluated once
    let h = SetHolder {}
    h.next().fahrenheit += 9.0
    assert(h.calls == 1)
    assert(h.temp.c == 5.0)
}

test "Setters: generic classes, traits and extend" {
    let box = SetBox[int] {}
    box.first = 7
    assert(box.first == 7 && box.items.length == 1)
    box.first = null
    assert(!isset(box.first))

    let p = SetPerson {}
    p.name = "  Ada "
    assert(p.name == "Ada")

    let e = SetExtended {}
    e.double = 10
    assert(e.n == 5)
    e.double *= 3
    assert(e.n == 15)
}

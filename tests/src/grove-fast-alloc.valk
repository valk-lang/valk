@unsafe

#if GROVE

use valk.gc

// Reads the pools' descriptors
@ignore_access

global grove_fast_freed: uint

// Three words: a 24-byte slot
class GroveFastA {
    a: uint (1)
    b: ?GroveFastA (null)
    c: uint (3)
}

// The same size, another kind
class GroveFastB {
    a: uint (1)
    b: ?GroveFastB (null)
    c: uint (3)
}

class GroveFastFinal {
    id: uint
    fn gc_free() {
        grove_fast_freed++
    }
}

fn grove_fast_pool(item: ptr) ptr {
    return gc.desc_of(item).pool
}

fn grove_fast_finals(count: uint) $noinline {
    let i: uint = 0
    while i < count {
        GroveFastFinal { id: i }
        i++
    }
}

// Fills storage of the class of 40 u64 elements with ones and drops it
fn grove_fast_dirty(rounds: uint) $noinline {
    let i: uint = 0
    while i < rounds {
        let s = [u64]{ 0xFFFFFFFFFFFFFFFF x 40 }
        if s.length != 40 : panic("bad length")
        let r = [?GroveFastA]{ GroveFastA{} x 40 }
        if r.length != 40 : panic("bad length")
        i++
    }
}

synctest "Grove: a class kind allocates from its own pool, with its slot size" {
    let a1 = GroveFastA {}
    let a2 = GroveFastA { b: a1 }
    let b1 = GroveFastB {}
    let pa = grove_fast_pool(a1.@cast(ptr))
    assert(pa == grove_fast_pool(a2.@cast(ptr)))
    // Same size, different kind: different pools
    assert(pa != grove_fast_pool(b1.@cast(ptr)))
    assert(gc.desc_of(a1.@cast(ptr)).isize == 24)
    assert(isset(gc.desc_of(a1.@cast(ptr)).layout))
    assert(a2.b == a1 && a2.a == 1 && a2.c == 3)
}

synctest "Grove: every object of a finalizer kind is finalized once" {
    gc.collect()
    gc.collect()
    grove_fast_freed = 0
    grove_fast_finals(300)
    gc.collect()
    gc.collect()
    assert(grove_fast_freed == 300)
}

synctest "Grove: sequence storage is zero after its length word, also in reused slots" {
    let round: uint = 0
    while round < 3 {
        grove_fast_dirty(50)
        gc.collect()
        let k: uint = 0
        while k < 50 {
            let s = [u64]{ 0 x 40 }
            let r = [?GroveFastA]{ null x 40 }
            assert(s.length == 40 && r.length == 40)
            let i: uint = 0
            while i < 40 {
                assert(s[i] == 0)
                assert(!isset(r[i]))
                i++
            }
            k++
        }
        round++
    }
}

synctest "Grove: sequences of one layout share a pool per size class" {
    let s1 = [?GroveFastA]{ null x 5 }
    let s2 = [?GroveFastA]{ null x 5 }
    let s3 = [?GroveFastA]{ null x 300 }
    let p1 = grove_fast_pool(s1.owner.@cast(ptr))
    assert(p1 == grove_fast_pool(s2.owner.@cast(ptr)))
    assert(p1 != grove_fast_pool(s3.owner.@cast(ptr)))
    // Large storage is zeroed too
    let big = [?GroveFastA]{ null x 3000 }
    let i: uint = 0
    while i < 3000 {
        assert(!isset(big[i]))
        i++
    }
}

#end

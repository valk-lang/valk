
use valk.crypto

fn repeat_byte(c: u8, n: uint) String {
    let buf = ByteBuffer.new(n + 1)
    let i: uint = 0
    while i < n {
        buf.write_byte(c)
        i++
    }
    return buf
}

// bcrypt() returns nothing, so the only way to observe its error channel from an
// assert is to translate it into a value.
fn bcrypt_fails(cost: uint, salt: String, password: String) bool {
    let out = ByteBuffer.new(64)
    crypto.bcrypt(cost, salt, password, out) ! return true
    return false
}

test "Bcrypt" {
    // Verify
    assert(crypto.bcrypt_verify("abc", "$2a$06$.pBSgOJEbKaFY0/jAFsZ4eE5AD8OBZvG299TMJZZL3RHejv.s5kdi"))

    // Create + Verify
    let hash = crypto.bcrypt_hash("test", 6) ! panic("bcrypt_hash failed")
    assert(crypto.bcrypt_verify("test", hash))

    let second_hash = crypto.bcrypt_hash("test", 6) ! panic("bcrypt_hash failed")
    assert(hash != second_hash)
    assert(crypto.bcrypt_verify("test", second_hash))
}

test "Bcrypt external vectors" {
    // Generated with Apache's htpasswd (-B, crypt_blowfish), so every one of these is
    // produced by an independent implementation of the same algorithm.

    // The revision prefix is not $2a$, which used to be rejected outright.
    assert(crypto.bcrypt_verify("test", "$2y$06$JcwQ7pPkT6Va4s7L.SuIbebfDTU4DqKzKyBN2JS2tPl51qzjRwLU."))
    assert(crypto.bcrypt_verify("test", "$2b$06$JcwQ7pPkT6Va4s7L.SuIbebfDTU4DqKzKyBN2JS2tPl51qzjRwLU."))
    assert(!crypto.bcrypt_verify("tesu", "$2y$06$JcwQ7pPkT6Va4s7L.SuIbebfDTU4DqKzKyBN2JS2tPl51qzjRwLU."))
    assert(!crypto.bcrypt_verify("test", "$2z$06$JcwQ7pPkT6Va4s7L.SuIbebfDTU4DqKzKyBN2JS2tPl51qzjRwLU."))
    assert(!crypto.bcrypt_verify("test", "$1$06$JcwQ7pPkT6Va4s7L.SuIbebfDTU4DqKzKyBN2JS2tPl51qzjRwLU."))

    // 8-bit characters: this key schedule zero extends, matching the fixed revisions.
    assert(crypto.bcrypt_verify("pässwörd✨", "$2y$06$xCqjth1DjElAuqwENgEvb.A9mPjtIpOACO/JzISdUi5MRUI3QLNam"))

    // The key is the password followed by a NUL, truncated to 72 bytes, so a 72 byte
    // and an 80 byte password are the same key while a 71 byte one is not.
    assert(crypto.bcrypt_verify(repeat_byte('x', 80), "$2y$06$edUiHPlZgT4LbV5KH1AHx.cvDzN168AWGE8vhUPBZjbtR71JcRrSG"))
    assert(crypto.bcrypt_verify(repeat_byte('x', 72), "$2y$06$edUiHPlZgT4LbV5KH1AHx.cvDzN168AWGE8vhUPBZjbtR71JcRrSG"))
    assert(!crypto.bcrypt_verify(repeat_byte('x', 71), "$2y$06$edUiHPlZgT4LbV5KH1AHx.cvDzN168AWGE8vhUPBZjbtR71JcRrSG"))
    assert(crypto.bcrypt_verify(repeat_byte('x', 71), "$2y$06$qQ7IMYMEmz6a6mOjGA9NYe41Uz3pY1rV2xsHz31uBxnVOGGzDjpz."))
    assert(crypto.bcrypt_verify(repeat_byte('x', 72), "$2y$06$R9xIAhXZbnDUnLf8bDJmPOWNY.Oyro4yP8nJRPHKgR5dBUaPj9aCC"))
}

test "Bcrypt rejects unusable input" {
    // A salt shorter than the 16 bytes the format carries made blowfish_expand_key()
    // refuse to touch the key schedule. The error was discarded, so the hash came out
    // as a constant: the password was silently ignored.
    assert(bcrypt_fails(4, "short", "password-a"))
    assert(bcrypt_fails(4, "", "password-a"))
    assert(bcrypt_fails(4, "0123456789abcdefghij", "password-a"))

    // Two different passwords must not be able to answer with the same bytes, which is
    // what a salt that is too short used to produce.
    let a = ByteBuffer.new(64)
    let b = ByteBuffer.new(64)
    crypto.bcrypt(4, "0123456789abcdef", "password-a", a) ! panic("bcrypt failed")
    crypto.bcrypt(4, "0123456789abcdef", "password-b", b) ! panic("bcrypt failed")
    let sa: String = a
    let sb: String = b
    assert(sa != sb)
    assert(sa.length == 60)
    assert(sb.length == 60)

    // A cost outside the range bcrypt_verify() accepts can never be verified again,
    // and 1 << 32 wraps to no expensive rounds at all.
    assert(bcrypt_fails(2, "0123456789abcdef", "pw"))
    assert(bcrypt_fails(32, "0123456789abcdef", "pw"))
    assert(bcrypt_fails(99, "0123456789abcdef", "pw"))
    assert((crypto.bcrypt_hash("pw", 1) !? "threw") == "threw")
    assert((crypto.bcrypt_hash("pw", 32) !? "threw") == "threw")
    assert((crypto.bcrypt_hash("pw", 0) !? "threw") == "threw")

    // Still fine at the ends of the accepted range and for an empty password.
    assert(!bcrypt_fails(3, "0123456789abcdef", "pw"))
    assert(!bcrypt_fails(4, "0123456789abcdef", ""))
    let empty_hash = crypto.bcrypt_hash("", 4) ! panic("bcrypt_hash failed")
    assert(crypto.bcrypt_verify("", empty_hash))
    assert(!crypto.bcrypt_verify(" ", empty_hash))

    // A credential that bcrypt() refuses to produce cannot be turned into a verifier
    // that answers true for every password.
    let forged = crypto.bcrypt_hash("password-a", 4) ! panic("bcrypt_hash failed")
    assert(crypto.bcrypt_verify("password-a", forged))
    assert(!crypto.bcrypt_verify("password-b", forged))
}

enum Enum1 {
    a // 0
    b // 2
    c (5) // 5
    d (1) // 1
}

enum Enum2: String {
    a ("ax")
    b ("bx")
    c ("cx")
}

global enum_pointer_values: [u8 x 3] ({ 4, 5, 6 })

enum EnumFixedArray: [u8 x 3] {
    values ({ 1, 2, 3 })
}

enum EnumNullablePointer: ?*u8 {
    none (null)
}

enum EnumUnion: int | bool {
    number (7)
    flag (true)
}

enum EnumPointer: *[u8 x 3] {
    values (@ref(enum_pointer_values))
}

enum EnumCallable: fnptr(int)(int) {
    increment (fn(value: int) int { return value + 1 })
}

enum EnumAliases {
    zero (0)
    none (0)
    one (1)
}

class EnumConvertSource {
    value: EnumAliases

    + fn to_enum() EnumAliases $auto {
        return this.value
    }
}

class Enum3 {
    e: Enum2
}

test "Enums" {
    let e1 = Enum1.a
    let e2 = Enum1.b
    let e3 = Enum1.c
    let e4 = Enum1.d

    assert(e1.to(int) == 0)
    assert(e2.to(int) == 2)
    assert(e3.to(int) == 5)
    assert(e4.to(int) == 1)

    assert(Enum1.a.to(int) == 0)
    assert(Enum1.b.to(int) == 2)
    assert(Enum1.c.to(int) == 5)
    assert(Enum1.d.to(int) == 1)

    assert(Enum2.a + Enum2.b + Enum2.c == "axbxcx")

    let e5 = Enum3{ e: Enum2.a }
    assert(e5.e.to(String) == "ax")
    assert("ax" == e5.e.to(String))
    e5.e = Enum2.b
    assert(e5.e.to(String) == "bx")
    assert("bx" == e5.e.to(String))
    assert(EnumFixedArray.values[0] == 1)
    assert(EnumFixedArray.values[2] == 3)
    assert(!isset(EnumNullablePointer.none))
    assert(EnumUnion.number == EnumUnion.number)
    assert(EnumUnion.flag != EnumUnion.number)
    assert(EnumPointer.values[1] == 5)
    let enum_callable = EnumCallable.increment
    assert(enum_callable(4) == 5)
}

test "Enums: exhaustive matches use distinct values" {
    let zero = match EnumAliases.none : String {
        EnumAliases.zero => "zero"
        EnumAliases.one => "one"
    }
    let one = match EnumAliases.one : String {
        EnumAliases.none => "zero"
        EnumAliases.one => "one"
    }
    assert(zero == "zero")
    assert(one == "one")
}

test "Enums: conversion hooks may produce enum values" {
    let source = EnumConvertSource{ value: EnumAliases.one }
    let explicit = source.to(EnumAliases)
    let implicit: EnumAliases = source
    let unsafe_value = 1.@cast(EnumAliases)
    assert(explicit == EnumAliases.one)
    assert(implicit == EnumAliases.one)
    assert(unsafe_value == EnumAliases.one)
}

enum EnumByte: u8 {
    first
    second
}

// An enum stored as u8 is not u8: the `mut &[u8]` byte helpers must stay off
// `mut &[EnumByte]`, or `Array[EnumByte]` fails to specialize.
test "Enum arrays keep their own type" {
    let list = Array[EnumByte]{}
    list.append(EnumByte.second)
    list.append(EnumByte.first)
    let fallback = EnumByte.first
    assert((list.get(0) !? fallback) == EnumByte.second)
    assert(list.length == 2)
    assert(!EnumByte.$is_type_of(u8))
    assert(EnumByte.$is_type_of(EnumByte))
    assert(u8.$is_type_of(u8))
}

enum NullMatchChoice { first (7)
    second (19) }
fn null_match_pick(v: ?NullMatchChoice) int {
    return match v : int {
        null => 0
        NullMatchChoice.first => 1
        NullMatchChoice.second => 2
    }
}
fn null_match_int(v: ?int) int {
    return match v : int {
        null => 0
        5 => 1
        default => 2
    }
}

test "Enums: a nullable subject matches null and its items exhaustively" {
    assert(null_match_pick(null) == 0)
    assert(null_match_pick(NullMatchChoice.first) == 1)
    assert(null_match_pick(NullMatchChoice.second) == 2)
    assert(null_match_int(null) == 0)
    assert(null_match_int(5) == 1)
    assert(null_match_int(6) == 2)
}

enum NullableCompareColor { red green blue }
fn nullable_compare_pick(flag: bool) ?NullableCompareColor { return flag ? NullableCompareColor.blue : null }

test "Enums: nullable enums compare with items and fill arrays" {
    let c = nullable_compare_pick(true)
    assert(c == NullableCompareColor.blue)
    assert(nullable_compare_pick(false) != NullableCompareColor.blue)
    let arr = Array[?NullableCompareColor]{ NullableCompareColor.green, null }
    assert(arr.length == 2)
    assert(isset(arr[0]))
    assert(!isset(arr[1]))
}

enum CompareColor: u8 { red  green }
enum CompareText: String { a ("a") }

test "Enums: compare with their own items or an explicit conversion" {
    let c = CompareColor.green
    assert(c == CompareColor.green)
    assert(CompareColor.red != CompareColor.green)
    assert(CompareColor.red < CompareColor.green)
    assert(c.to(int) == 1)
    assert(c.to(u8) > 0)
    assert(CompareText.a.to(String) == "a")
    assert(CompareText.a == CompareText.a)
}

struct EnumBackingValue {
    x: int (0)
}

enum EnumClassBacking: EnumBackingValue {
    first (EnumBackingValue { x: 5 })
}

test "Enums: a non-integer backing stores an explicit value of that type" {
    let tag: EnumClassBacking = EnumClassBacking.first
    assert(tag.@cast(EnumBackingValue).x == 5)
}

enum MethodColor { red, green, blue }

extend MethodColor {
    + fn warm() bool {
        return this == .red
    }
    + fn next() MethodColor {
        return match this : MethodColor {
            .red => .green
            .green => .blue
            .blue => .red
        }
    }
    + static fn favorite() MethodColor {
        return .blue
    }
}

enum MethodColumn { id, name, items }

fn enum_has_warm[T]() bool {
    #if T.$has_method(warm)
    return true
    #else
    return false
    #end
}

test "Enums: methods, names and items" {
    let c = MethodColor.green
    assert(!c.warm() && MethodColor.red.warm())
    assert(c.next() == .blue)
    assert(MethodColor.favorite() == .blue)
    assert(enum_has_warm[MethodColor]())

    // A name, as text; the number stays one conversion away
    assert(c.name() == "green")
    assert(c.to(String) == "green")
    assert("color: %{c}" == "color: green")
    assert("x" + c == "xgreen")
    assert(c.to(int) == 1)

    let names = Array[String]{}
    each MethodColor.items() as item : names.append(item.name())
    assert(names.join(",") == "red,green,blue")
    assert((MethodColor.from_name("blue") !!) == .blue)
    let missing = false
    MethodColor.from_name("pink") ! { missing = error_is(E.code, missing) }
    assert(missing)

    // A text enum is its text; its name is separate
    assert(Enum2.b.to(String) == "bx")
    assert(Enum2.b.name() == "b")
    assert((Enum2.from_name("c") !!) == Enum2.c)
    // Aliases share a value: the name is the first one declared
    assert(EnumAliases.none.name() == "zero")
    assert(EnumAliases.items().length == 3)

    // Items keep their names even when they match a generated method
    assert(MethodColumn.name.name() == "name")
    assert(MethodColumn.items.to(int) == 2)
    assert(MethodColumn.id.to(String) == "id")
}

use valk.fs
use valk.time

test "fs: file locks exclude each other and time out" {
    let path = fs.add(fs.exe_dir() !? "", "fs-lock-test.lock")
    defer fs.delete_file(path) _

    let first = fs.lock(path) !!
    assert(first.exclusive && first.path == path)
    // A second exclusive lock waits; with a timeout it gives up
    let timed_out = false
    let started = time.mono_ms()
    fs.lock(path, true, 40) ! { timed_out = error_is(E.code, timeout) }
    assert(timed_out)
    assert(time.mono_ms() - started >= 30)
    assert(!isset(fs.try_lock(path) !!))
    assert(!isset(fs.try_lock(path, false) !!))

    first.unlock() !!
    first.unlock() !!
    let second = fs.try_lock(path) !!
    assert(isset(second))
    if isset(second) : second.close() !!

    // Shared locks coexist and keep an exclusive one out
    let reader_a = fs.lock(path, false) !!
    let reader_b = fs.try_lock(path, false) !!
    assert(isset(reader_b))
    assert(!isset(fs.try_lock(path) !!))
    reader_a.unlock() !!
    if isset(reader_b) : reader_b.unlock() !!
    let writer = fs.lock(path, true, 1000) !!
    writer.unlock() !!

    // A missing directory cannot hold a lock file
    let refused = false
    fs.lock(fs.add(path, "no/such/dir.lock"), true, 10) ! { refused = error_is(E.code, open) }
    assert(refused)
}

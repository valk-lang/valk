// A statement that can never run must not change divergence analysis.

fn divergence_return_then_break() int {
    while true {
        return 1
        break
    }
}

fn divergence_return_then_continue() int {
    while true {
        return 2
        continue
    }
}

fn divergence_live_break(c: bool) int {
    while true {
        if c { return 3 }
        break
    }
    return 4
}

test "Divergence: an unreachable break or continue is ignored" {
    assert(divergence_return_then_break() == 1)
    assert(divergence_return_then_continue() == 2)
    assert(divergence_live_break(true) == 3)
    assert(divergence_live_break(false) == 4)
}

use valk.sync
use valk.thread

class CmapUser {
    name: String
}

test "ConcurrentMap: set, get, update, remove and snapshot" {
    let map: shared sync.ConcurrentMap[String, uint] = sync.ConcurrentMap[String, uint].new(4) !!
    assert(map.get("a") == null)
    map.set("a", 1)
    map.set("b", 2)
    assert(map.get("a") == 1 && map.has("b") && !map.has("c"))
    assert(map.add("a", 4) == 5)
    assert(map.add("c", 3) == 3)
    assert(map.update("b", fn(old: ?uint) uint { return (old ?? 0) * 10 }) == 20)
    assert(map.length == 3)
    assert(map.remove("c") && !map.remove("c"))
    let copy = map.snapshot()
    assert(copy.length == 2 && (copy.get("a") !? 0) == 5 && (copy.get("b") !? 0) == 20)
    map.clear()
    assert(map.length == 0)
}

test "ConcurrentMap: holds shared objects and integer keys" {
    let users: shared sync.ConcurrentMap[int, shared CmapUser] = sync.ConcurrentMap[int, shared CmapUser].new() !!
    let user: shared CmapUser = CmapUser{ name: "ann" }
    users.set(7, user)
    let found = users.get(7)
    assert(isset(found) && found.name == "ann")
}

fn cmap_count(map: shared sync.ConcurrentMap[uint, uint], seed: uint) {
    let i: uint = 0
    while i < 20000 {
        map.add((i * 7 + seed) % 100, 1)
        i++
    }
}

test "ConcurrentMap: threads add to the same keys without losing updates" {
    let map: shared sync.ConcurrentMap[uint, uint] = sync.ConcurrentMap[uint, uint].new() !!
    let workers = Array[thread.Thread[void]]{}
    let t: uint = 0
    while t < 4 {
        let seed = t
        workers.append(thread.start(fn() { cmap_count(map, seed) }) !!)
        t++
    }
    each workers as worker : worker.await()
    let total: uint = 0
    each map.snapshot() as value : total += value
    assert(total == 80000)
    assert(map.length == 100)
}

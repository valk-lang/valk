use valk.http
use valk.net
use valk.time
use valk.sync
use valk.core
use valk.gc

fn http_limit_handler(req: http.Request) http.Response {
    return http.Response.text("ok")
}

fn http_limit_server() http.Server {
    let server = http.Server.new("127.0.0.1", 9023, http_limit_handler)
    server.max_request_header_size = 128
    server.max_request_body_size = 16
    server.max_server_wide_body_size = 12
    return server
}

fn http_limit_connection() net.TcpConnection !net.NetError {
    return net.tcp_client("127.0.0.1", 9023) !>
}

fn http_limit_response(connection: net.TcpConnection) String {
    let response = [u8]{ 0 x 256 }
    let received = connection.read(response) ! return ""
    return response.view(0, received).to_string()
}

fn http_limit_wait_for_body_rejection() bool {
    let deadline = time.mono_ms() + 2000
    while time.mono_ms() < deadline {
        let connection = http_limit_connection() ! return false
        connection.read_timeout_ms = 20
        connection.write("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 1\r\n\r\n") ! return false
        let rejected = http_limit_response(connection).contains(" 503 ")
        connection.close() ! {}
        if rejected : return true
        time.sleep_ms(1)
    }
    return false
}

fn http_limit_wait_for_recovery() bool {
    let request = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"
    let deadline = time.mono_ms() + 2000
    while time.mono_ms() < deadline {
        let connection = http_limit_connection() ! return false
        connection.read_timeout_ms = 20
        connection.write(request) ! {}
        let recovered = http_limit_response(connection).contains(" 200 ")
        connection.close() ! {}
        if recovered : return true
        time.sleep_ms(1)
    }
    return false
}

test "HTTP server enforces request and server-wide size limits" {
    let server = http_limit_server()
    let server_running = co server.start(1)
    defer stop_http_test_server(server, server_running)

    let header_connection = http_limit_connection() ! {
        assert(false)
        return
    }
    let large_header = "GET / HTTP/1.1\r\nHost: localhost\r\nX-Large: ".pad_right('x', 160) + "\r\n\r\n"
    header_connection.write(large_header) ! assert(false)
    assert(http_limit_response(header_connection).contains(" 431 "))
    header_connection.close() ! assert(false)

    let body_connection = http_limit_connection() ! {
        assert(false)
        return
    }
    let large_body = "POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 17\r\n\r\n"
    body_connection.write(large_body) ! assert(false)
    assert(http_limit_response(body_connection).contains(" 413 "))
    body_connection.close() ! assert(false)

    let chunked_connection = http_limit_connection() ! {
        assert(false)
        return
    }
    let large_chunk = "POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n11\r\n"
    chunked_connection.write(large_chunk) ! assert(false)
    assert(http_limit_response(chunked_connection).contains(" 413 "))
    chunked_connection.close() ! assert(false)

    let reserved_connection = http_limit_connection() ! {
        assert(false)
        return
    }
    let reserved_body = "POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 12\r\n\r\n"
    reserved_connection.write(reserved_body) ! assert(false)

    // The bodies in flight are at the limit: no more bodies, but other requests are served
    assert(http_limit_wait_for_body_rejection())
    let plain = http_limit_connection() !!
    plain.write("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n") !!
    assert(http_limit_response(plain).contains(" 200 "))
    plain.close() _
    reserved_connection.close() ! assert(false)

    assert(http_limit_wait_for_recovery())
}

synctest "HTTP server bounds the whole request head by header_timeout_ms" {
    let server = http.Server.new("127.0.0.1", 19575, http_limit_handler)
    server.header_timeout_ms = 300
    let running = co server.start(1)
    defer stop_http_test_server(server, running)

    let connection = net.tcp_client("127.0.0.1", 19575) !!
    connection.write("GET / HTTP/1.1\r\n") !!
    // A byte every 50 ms keeps each read short, but not the head
    let start = time.mono_ms()
    let closed = false
    while time.mono_ms() - start < 3000 {
        time.sleep_ms(50)
        connection.write("X") ! {
            closed = true
            break
        }
    }
    connection.close() _
    assert(closed)
    assert(time.mono_ms() - start < 2000)
}

// Milliseconds until the server closes `connection`; 10 seconds at most
fn http_limit_closed_after_ms(connection: net.TcpConnection) uint {
    let start = time.mono_ms()
    connection.read_timeout_ms = 10_000
    let buf = [u8]{ 0 x 256 }
    while time.mono_ms() - start < 10_000 {
        connection.read(buf) ! {
            assert(error_is(E.code, closed))
            break
        }
    }
    return time.mono_ms() - start
}

synctest "HTTP server closes a connection idle past idle_timeout_ms" {
    let server = http.Server.new("127.0.0.1", 19630, http_limit_handler)
    server.idle_timeout_ms = 200
    let running = co server.start(1)
    defer stop_http_test_server(server, running)

    let connection = net.tcp_client("127.0.0.1", 19630) !!
    connection.write("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n") !!
    let response = [u8]{ 0 x 256 }
    let received = connection.read(response) !!
    assert(response.view(0, received).to_string().contains(" 200 "))
    // Idle after the answer: closed once the idle timeout passed, not long after
    let waited = http_limit_closed_after_ms(connection)
    connection.close() _
    assert(waited >= 150)
    assert(waited < 2000)
}

synctest "HTTP server closes a connection whose body stalls past body_timeout_ms" {
    let server = http.Server.new("127.0.0.1", 19631, http_limit_handler)
    server.body_timeout_ms = 200
    let running = co server.start(1)
    defer stop_http_test_server(server, running)

    let connection = net.tcp_client("127.0.0.1", 19631) !!
    connection.write("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 10\r\n\r\nabc") !!
    let waited = http_limit_closed_after_ms(connection)
    connection.close() _
    assert(waited >= 150)
    assert(waited < 2000)
}

synctest "HTTP server closes the connection idle the longest when max_connections is reached" {
    let server = http.Server.new("127.0.0.1", 19632, http_limit_handler)
    server.max_connections = 2
    let running = co server.start(1)
    defer stop_http_test_server(server, running)

    let request = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"
    let first = net.tcp_client("127.0.0.1", 19632) !!
    first.write(request) !!
    assert(http_limit_response(first).contains(" 200 "))
    time.sleep_ms(20)
    let second = net.tcp_client("127.0.0.1", 19632) !!
    second.write(request) !!
    assert(http_limit_response(second).contains(" 200 "))
    // A third connection is served: the first, idle the longest, is closed for it
    let third = net.tcp_client("127.0.0.1", 19632) !!
    third.write(request) !!
    assert(http_limit_response(third).contains(" 200 "))
    assert(http_limit_closed_after_ms(first) < 2000)
    // The others keep working
    second.write(request) !!
    assert(http_limit_response(second).contains(" 200 "))
    third.write(request) !!
    assert(http_limit_response(third).contains(" 200 "))
    first.close() _
    second.close() _
    third.close() _
}

synctest "HTTP server serves a client that pauses between requests and closes it on stop" {
    let server = http.Server.new("127.0.0.1", 19634, http_limit_handler)
    let running = co server.start(1)

    let request = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"
    let connection = net.tcp_client("127.0.0.1", 19634) !!
    // On Linux a connection that pauses waits without a coroutine; each request wakes it
    each 0 .. 3 as i {
        connection.write(request) !!
        assert(http_limit_response(connection).contains(" 200 "))
        time.sleep_ms(30)
    }
    // Stopping the server closes the idle connection
    stop_http_test_server(server, running)
    assert(http_limit_closed_after_ms(connection) < 2000)
    connection.close() _
}

synctest "HTTP server keeps track of its connections while some in the middle close" {
    let server = http.Server.new("127.0.0.1", 19636, http_limit_handler)
    let running = co server.start(1)

    let request = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"
    let connections = Array[net.TcpConnection]{}
    each 0 .. 8 as i {
        let connection = net.tcp_client("127.0.0.1", 19636) !!
        connection.write(request) !!
        assert(http_limit_response(connection).contains(" 200 "))
        connections.append(connection)
    }
    time.sleep_ms(30)
    // Closing some moves others into their slots of the worker's lists
    each Array[uint]{ 1, 4, 6 } as i : connections.get(i)!!.close() _
    time.sleep_ms(30)
    each Array[uint]{ 0, 2, 3, 5, 7 } as i {
        let connection = connections.get(i) !!
        connection.write(request) !!
        assert(http_limit_response(connection).contains(" 200 "))
    }
    time.sleep_ms(30)
    // Stopping reaches every connection that is left
    stop_http_test_server(server, running)
    each Array[uint]{ 0, 2, 3, 5, 7 } as i {
        let connection = connections.get(i) !!
        assert(http_limit_closed_after_ms(connection) < 2000)
        connection.close() _
    }
}

fn http_limit_parked_rounds(port: u16, delay_ms: uint) {
    let server = http.Server.new("127.0.0.1", port, http_limit_handler)
    server.batch_delay_ms = delay_ms
    let running = co server.start(1)
    defer stop_http_test_server(server, running)

    let request = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"
    let connections = Array[net.TcpConnection].new()
    each 0 .. 40 : connections.append(net.tcp_client("127.0.0.1", port) !!)
    // Each round wakes the parked connections together, then one alone
    each 0 .. 3 {
        each connections as connection : connection.write(request) !!
        each connections as connection : assert(http_limit_response(connection).contains(" 200 "))
        time.sleep_ms(30)
        let first = connections.get(0) !!
        first.write(request) !!
        assert(http_limit_response(first).contains(" 200 "))
        time.sleep_ms(30)
    }
    // Closing and reopening connections reuses their slots in the worker's parked table
    each 0 .. 20 as i : connections.get(i * 2)!!.close() _
    time.sleep_ms(50)
    each 0 .. 20 as i : connections.set(i * 2, net.tcp_client("127.0.0.1", port)!!) _
    each connections as connection : connection.write(request) !!
    each connections as connection : assert(http_limit_response(connection).contains(" 200 "))
    time.sleep_ms(30)
    each connections as connection : connection.close() _
}

synctest "HTTP server serves parked connections woken together, with and without batch_delay_ms" {
    assert(http.Server.new("127.0.0.1", 19640).batch_delay_ms == 2)
    http_limit_parked_rounds(19640, 2)
    http_limit_parked_rounds(19641, 0)
}

fn http_limit_slow_handler(req: http.Request) http.Response {
    if req.path == "/slow" : time.sleep_ms(80)
    return http.Response.text("ok " + req.path)
}

synctest "HTTP server serves a request that arrived while the connection was busy, before it parks" {
    let server = http.Server.new("127.0.0.1", 19642, http_limit_slow_handler)
    let running = co server.start(1)
    defer stop_http_test_server(server, running)

    let connection = net.tcp_client("127.0.0.1", 19642) !!
    connection.read_timeout_ms = 2000
    // Pauses make the connection one that parks between requests
    each 0 .. 2 {
        connection.write("GET /fast HTTP/1.1\r\nHost: localhost\r\n\r\n") !!
        assert(http_limit_response(connection).contains("ok /fast"))
        time.sleep_ms(30)
    }
    // The second request arrives while the first is still being handled
    connection.write("GET /slow HTTP/1.1\r\nHost: localhost\r\n\r\n") !!
    time.sleep_ms(20)
    connection.write("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n") !!
    let seen = ""
    let deadline = time.mono_ms() + 2000
    while !seen.contains("ok /after") && time.mono_ms() < deadline {
        let part = http_limit_response(connection)
        if part.length == 0 : break
        seen = seen + part
    }
    assert(seen.contains("ok /slow"))
    assert(seen.contains("ok /after"))
    connection.close() _
}

fn http_limit_slot_handler(req: http.Request) http.Response {
    return http.Response.text(req.path + "|" + (req.header("Authorization") !? "") + "|" + (req.cookie("session") !? "") + "|" + req.body)
}

fn http_limit_slot_fast_handler(ctx: http.Context, res: http.ResponseWriter) {
    res.send(ctx.path.to_string() + "|" + (ctx.header("Authorization") !? "") + "|" + (ctx.cookie("session") !? "") + "|" + ctx.body, 200, "text/plain")
}

fn http_limit_slot_body(round: uint, i: uint) String {
    let sizes = Array[uint]{ 0, 64, 4096, 20000 }
    let size = sizes.get((round + i) % sizes.length) !!
    if size == 0 : return ""
    return ("private-body-" + round + "-" + i + ":").pad_right('x', size)
}

fn http_limit_slot_churn(port: u16, workers: uint, delay_ms: uint) {
    let server = http.Server.new("127.0.0.1", port, http_limit_slot_handler)
    if workers > 1 : server.fast(http_limit_slot_fast_handler)
    server.batch_delay_ms = delay_ms
    let running = co server.start(workers)
    let connections = Array[net.TcpConnection]{}
    let inputs = Array[ByteBuffer]{}
    // More than one epoll batch on a single worker
    each 0 .. 280 {
        let connection = net.tcp_client("127.0.0.1", port) !!
        connection.read_timeout_ms = 2000 * TIME_SCALE
        connections.append(connection)
        inputs.append(ByteBuffer.new(256))
    }

    each 0 .. 5 as round {
        each connections as connection, i {
            let path = "/slot-" + round + "-" + i
            let body = http_limit_slot_body(round, i)
            connection.write("POST " + path + " HTTP/1.1\r\nHost: localhost\r\nAuthorization: Bearer " + path + "\r\nCookie: session=" + path + "\r\nContent-Length: " + body.bytes + "\r\n\r\n" + body) !!
        }
        each connections as connection, i {
            let path = "/slot-" + round + "-" + i
            let expected = path + "|Bearer " + path + "|" + path + "|" + http_limit_slot_body(round, i)
            assert(keep_alive_read_response(connection, inputs.get(i)!!) == expected)
        }
        time.sleep_ms(30)
        if round == 4 : break
        each connections as connection, i {
            if i % 3 != round % 3 : continue
            if i % 2 == 0 {
                connection.write("GET /close HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n") !!
                assert(keep_alive_read_response(connection, inputs.get(i)!!) == "/close|||")
            }
            connection.close() _
            // Reconnect while other closes and wakes are still pending
            let replacement = net.tcp_client("127.0.0.1", port) !!
            replacement.read_timeout_ms = 2000 * TIME_SCALE
            connections.set(i, replacement) !!
        }
    }

    stop_http_test_server(server, running)
    each connections as connection {
        connection.read_timeout_ms = 2000 * TIME_SCALE
        let buffer = [u8]{ 0 x 1 }
        let closed = false
        connection.read(buffer) ! { closed = error_is(E.code, closed) }
        assert(closed)
        connection.close() _
    }
}

synctest "HTTP server isolates responses and drains reused slots under connection churn" {
    http_limit_slot_churn(19643, 1, 0)
    http_limit_slot_churn(19644, 4, 2)
}

synctest "HTTP server rejects excess busy connections and recovers after they close" {
    let entered = sync.Waker.new() !!
    let release = sync.Waker.new() !!
    let handler: atomic fn(http.Request)(http.Response) = fn(req: http.Request) http.Response {
        if req.path == "/hold" {
            entered.wake()
            release.wait(5000 * TIME_SCALE)
        }
        return http.Response.text("ok")
    }
    let server = http.Server.new("127.0.0.1", 19646, handler)
    server.max_connections = 1
    let running = co server.start(1)
    defer stop_http_test_server(server, running)
    defer release.wake()
    let busy = net.tcp_client("127.0.0.1", 19646) !!
    busy.read_timeout_ms = 2000 * TIME_SCALE
    busy.write("GET /hold HTTP/1.1\r\nHost: localhost\r\n\r\n") !!
    assert(entered.wait(2000 * TIME_SCALE))
    each 0 .. 4 {
        let excess = net.tcp_client("127.0.0.1", 19646) !!
        excess.read_timeout_ms = 2000 * TIME_SCALE
        assert(http_limit_response(excess).contains(" 503 "))
        excess.close() _
    }
    release.wake()
    assert(keep_alive_read_response(busy, ByteBuffer.new(256)) == "ok")
    busy.close() _
    time.sleep_ms(30)
    let recovered = net.tcp_client("127.0.0.1", 19646) !!
    recovered.read_timeout_ms = 2000 * TIME_SCALE
    recovered.write("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n") !!
    assert(keep_alive_read_response(recovered, ByteBuffer.new(256)) == "ok")
    recovered.close() _
}

test "HTTP server limits the bodies in flight to a quarter of the memory by default" {
    let server = http.Server.new("127.0.0.1", 19647, http_limit_handler)
    assert(server.max_server_wide_body_size == core.memory_limit() / 4)
}

fn http_limit_memory_upload(port: u16, body: String) {
    let connection = net.tcp_client("127.0.0.1", port) ! return
    connection.read_timeout_ms = 5000 * TIME_SCALE
    connection.write("POST / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\nContent-Length: " + body.bytes + "\r\n\r\n" + body) ! {}
    http_limit_response(connection)
    connection.close() _
}

synctest "HTTP server gives back the memory of large requests once idle" {
    let body = "".pad_right('x', 8 * 1024 * 1024)
    let server = http.Server.new("127.0.0.1", 19648, http_limit_handler)
    let running = co server.start(1)
    defer stop_http_test_server(server, running)
    let before = gc.mem_usage_shared
    let uploads = Array[co()]{}
    each 0 .. 12 : uploads.append(co http_limit_memory_upload(19648, body))
    each uploads as upload : await upload
    assert(gc.mem_usage_peak > before + 32 * 1024 * 1024)
    let deadline = time.mono_ms() + 5000 * TIME_SCALE
    let released = false
    while time.mono_ms() < deadline {
        if gc.mem_usage_shared < before + 16 * 1024 * 1024 {
            released = true
            break
        }
        time.sleep_ms(50)
    }
    assert(released)
}

synctest "HTTP server closes a request body that arrives too slowly" {
    let server = http.Server.new("127.0.0.1", 19649, http_limit_handler)
    server.body_timeout_ms = 200
    server.min_transfer_rate = 100_000
    let running = co server.start(1)
    defer stop_http_test_server(server, running)
    let connection = net.tcp_client("127.0.0.1", 19649) !!
    connection.read_timeout_ms = 20
    connection.write("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 100000\r\n\r\nx") !!
    // Each byte keeps the read short, but not the body
    let closed = false
    let deadline = time.mono_ms() + 3000 * TIME_SCALE
    while time.mono_ms() < deadline {
        let buffer = [u8]{ 0 x 16 }
        connection.read(buffer) ! {
            if !error_is(E.code, timeout) {
                closed = true
                break
            }
        }
        connection.write("x") ! {
            closed = true
            break
        }
    }
    assert(closed)
    connection.close() _
}

synctest "HTTP server measures the body rate per body, not from an earlier request" {
    let server = http.Server.new("127.0.0.1", 19650, http_limit_handler)
    server.body_timeout_ms = 100 * TIME_SCALE
    server.min_transfer_rate = 1000
    let running = co server.start(1)
    defer stop_http_test_server(server, running)
    let connection = net.tcp_client("127.0.0.1", 19650) !!
    connection.read_timeout_ms = 2000 * TIME_SCALE
    let input = ByteBuffer.new(256)
    let body = "".pad_right('x', 1000)
    // The first body and the head of the next arrive together, the pause comes before the next body
    connection.write("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 1000\r\n\r\n" + body + "POST / HTTP/1.1\r\nHost: localhost\r\nContent-") !!
    assert(keep_alive_read_response(connection, input) == "ok")
    time.sleep_ms(50 * TIME_SCALE)
    connection.write("Length: 1000\r\n\r\n" + body) !!
    assert(keep_alive_read_response(connection, input) == "ok")
    connection.close() _
}

fn http_limit_slow_write(server: atomic net.TcpServer, done: sync.Waker, result: Array[bool]) {
    let connection = server.accept(5000 * TIME_SCALE) ! return
    connection.write_timeout_ms = 200
    connection.min_write_rate = 10 * 1024 * 1024
    let data = "".pad_right('x', 64 * 1024 * 1024)
    connection.write(data) ! {
        result.append(error_is(E.code, timeout))
    }
    connection.close() _
    done.wake()
}

synctest "A socket write below its minimum rate throws timeout" {
    let listener = net.tcp_server("127.0.0.1", 19651) !!
    let done = sync.Waker.new() !!
    let result = Array[bool]{}
    co http_limit_slow_write(listener, done, result)
    let client = net.tcp_client("127.0.0.1", 19651) !!
    client.read_timeout_ms = 20
    let buffer = [u8]{ 0 x 4096 }
    let deadline = time.mono_ms() + 10_000 * TIME_SCALE
    // Reads keep every send short, but the whole write far below the rate
    while result.length == 0 && time.mono_ms() < deadline {
        client.read(buffer) ! {}
        time.sleep_ms(5)
    }
    assert(result.length == 1 && (result.get(0) !? false))
    client.close() _
    listener.close() _
}

test "HTTP server refuses requests above max_memory and serves them again below it" {
    assert(http.Server.new("127.0.0.1", 19652, http_limit_handler).max_memory == core.memory_limit() / 4 * 3)
    let server = http.Server.new("127.0.0.1", 19652, http_limit_handler)
    server.max_memory = 1
    let running = co server.start(1)
    defer stop_http_test_server(server, running)
    let connection = net.tcp_client("127.0.0.1", 19652) !!
    connection.read_timeout_ms = 2000 * TIME_SCALE
    connection.write("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n") !!
    assert(http_limit_response(connection).contains(" 503 "))
    connection.close() _
}

use valk:http
use valk:net
use valk:time

fn http_limit_handler(req: http:Request) http:Response {
    return http:Response.text("ok")
}

fn http_limit_server() {
    let server = http:Server.new("127.0.0.1", 9023, http_limit_handler) ! return
    server.max_request_header_size = 128
    server.max_request_body_size = 16
    server.max_server_wide_body_size = 12
    server.start(1)
}

fn http_limit_connection() net:Connection !net:NetError {
    return net:Socket.client(net:SOCKET_TYPE.TCP, "127.0.0.1", 9023) !>
}

fn http_limit_response(connection: net:Connection) String {
    let response = ByteBuffer.new(256)
    connection.recv(response, 256) ! return ""
    return response.to_string()
}

test "HTTP server enforces request and server-wide size limits" {
    co http_limit_server()

    let header_connection = http_limit_connection() ! {
        assert(false)
        return
    }
    let large_header = "GET / HTTP/1.1\r\nHost: localhost\r\nX-Large: ".pad_right('x', 160) + "\r\n\r\n"
    header_connection.send_bytes(large_header.data, large_header.bytes, true) ! assert(false)
    assert(http_limit_response(header_connection).contains(" 413 "))
    header_connection.close()

    let body_connection = http_limit_connection() ! {
        assert(false)
        return
    }
    let large_body = "POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 17\r\n\r\n"
    body_connection.send_bytes(large_body.data, large_body.bytes, true) ! assert(false)
    assert(http_limit_response(body_connection).contains(" 413 "))
    body_connection.close()

    let chunked_connection = http_limit_connection() ! {
        assert(false)
        return
    }
    let large_chunk = "POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n11\r\n"
    chunked_connection.send_bytes(large_chunk.data, large_chunk.bytes, true) ! assert(false)
    assert(http_limit_response(chunked_connection).contains(" 413 "))
    chunked_connection.close()

    let reserved_connection = http_limit_connection() ! {
        assert(false)
        return
    }
    let reserved_body = "POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 12\r\n\r\n"
    reserved_connection.send_bytes(reserved_body.data, reserved_body.bytes, true) ! assert(false)

    let rejected_connection = http_limit_connection() ! {
        assert(false)
        reserved_connection.close()
        return
    }
    assert(http_limit_response(rejected_connection).contains(" 503 "))
    rejected_connection.close()
    reserved_connection.close()

    time:sleep_ms(10)
    let recovered_connection = http_limit_connection() ! {
        assert(false)
        return
    }
    let request = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"
    recovered_connection.send_bytes(request.data, request.bytes, true) ! assert(false)
    assert(http_limit_response(recovered_connection).contains(" 200 "))
    recovered_connection.close()
}

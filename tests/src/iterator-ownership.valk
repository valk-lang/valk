use valk.gc

class IteratorOwnedItem { number: int }
class IteratorFreshItems {
    fn _next(index: uint) IteratorOwnedItem !IterError {
        if index >= 3 : throw .end
        return .{ number: 73 + index.to(int) }
    }
}
class IteratorFreshGenericItems {
    fn _next(index: $I) IteratorOwnedItem !IterError {
        if index >= 2 : throw .end
        return .{ number: 79 + index.to(int) }
    }
}
class IteratorBorrowedItems {
    number: int (83)
    fn _next(index: uint) &int !IterError {
        if index >= 1 : throw .end
        return &this.number
    }
}
class IteratorScalarItems {
    number: int (89)
    fn _next(index: uint) int !IterError {
        if index >= 2 : throw .end
        return this.number
    }
}
fn iterator_saved_borrows() Array[&int] {
    let source = IteratorBorrowedItems {}
    let items = Array[&int]{}
    each source as item : items.append(item)
    return items
}

test "Iterator ownership: fresh results can become shared" {
    let source = IteratorFreshItems {}
    let values = Array[shared IteratorOwnedItem]{}
    each source as item {
        let published: shared IteratorOwnedItem = item
        values.append(published)
    }
    gc.collect()
    assert(values.length == 3)
    assert(values[0].number == 73 && values[2].number == 75)
    values[0].number++
    assert(values[1].number == 74)
}

test "Iterator ownership: generic fresh results keep inferred uniqueness" {
    let source = IteratorFreshGenericItems {}
    let count = 0
    each source as item {
        let published: shared IteratorOwnedItem = item
        assert(published.number == 79 + count)
        count++
    }
    assert(count == 2)
}

test "Iterator ownership: scalar reads keep the source publishable" {
    let source = IteratorScalarItems {}
    let total = 0
    each source as value : total += value
    let published: shared IteratorScalarItems = source
    assert(total == 178 && published.number == 89)
    let numbers = Array[int]{ 7, 11 }
    each numbers as value : total += value
    let shared_numbers: shared Array[int] = numbers
    assert(total == 196 && shared_numbers[1] == 11)
}

test "Iterator ownership: owned borrows keep the iterator alive" {
    let items = iterator_saved_borrows()
    gc.collect()
    assert(items.length == 1 && items[0][0] == 83)
    items[0][0] = 97
    gc.collect()
    assert(items[0][0] == 97)
}

use valk.regex
use valk.time

// "start:end:text" for every match, joined by spaces
fn matches(pattern: String, flags: String, text: String) String {
    let re = regex.Regex.new(pattern, flags) ! return "ERR " + E.message
    let out = Array[String]{}
    each re.find_all(text) as m {
        out.append(m.start + ":" + m.end + ":" + m.str())
    }
    return out.join(" ")
}

fn groups(pattern: String, text: String) String {
    let re = regex.Regex.new(pattern) ! return "ERR " + E.message
    let m = re.find(text)
    if !isset(m) : return "none"
    let out = Array[String]{}
    let i: uint = 1
    while i < m.count() {
        let g = m.get(i)
        out.append(isset(g) ? g : "null")
        i++
    }
    return out.join(",")
}

fn error_of(pattern: String) String {
    regex.Regex.new(pattern) ! {
        if error_is(E.code, syntax) : return "syntax:" + E.message
        if error_is(E.code, unsupported) : return "unsupported:" + E.message
        return "too_large"
    }
    return "ok"
}

test "Regex: basic matching" {
    assert(matches("a+b", "", "xaab aaab") == "1:4:aab 5:9:aaab")
    assert(matches("(\\d+)-(\\d+)", "", "tel 12-345 and 6-7") == "4:10:12-345 15:18:6-7")
    assert(groups("(\\d+)-(\\d+)", "tel 12-345 and 6-7") == "12,345")
    assert(matches("colou?r", "i", "COLOR colour") == "0:5:COLOR 6:12:colour")
    assert(matches("a.c", "", "abc a\nc") == "0:3:abc")
    assert(matches("a.c", "s", "abc a\nc") == "0:3:abc 4:7:a\nc")
    assert(matches("a{2,3}", "", "a aa aaa aaaa") == "2:4:aa 5:8:aaa 9:12:aaa")
    assert(matches("a{2,}?", "", "aaaaa") == "0:2:aa 2:4:aa")
    assert(matches("(?i:abc)d", "", "ABCd abcD") == "0:4:ABCd")
    assert(matches("\\bfoo\\b", "", "foo foobar barfoo foo") == "0:3:foo 18:21:foo")
    assert(matches("[^aeiou\\s]+", "", "hello world") == "0:1:h 2:4:ll 6:7:w 8:11:rld")
    assert(matches("[a-c[:digit:]]+", "", "xx1a2b3z") == "2:7:1a2b3")
    assert(matches("\\x41é", "", "Aé") == "0:3:Aé")
    assert(matches("a|b|", "", "cab") == "0:0: 1:2:a 2:3:b 3:3:")
    assert(matches("x*", "", "axxb") == "0:0: 1:3:xx 3:3: 4:4:")
    assert(matches("(a*)*b", "", "aaab") == "0:4:aaab")
    assert(matches("(a*)+$", "", "aaa") == "0:3:aaa 3:3:")
    assert(matches("a{,2}", "", "a{,2}") == "0:5:a{,2}")
    assert(matches("[]a]+", "", "x]a]y") == "1:4:]a]")
    assert(matches("[a-]+", "", "x-a-y") == "1:4:-a-")

    let re = regex.Regex.new("^(\\w+)\\s*=\\s*(.*)$", "m") !!
    assert(re.is_match("a = 1\n b=two\nnope"))
    let all = re.find_all("a = 1\nb=two\nnope")
    assert(all.length == 2)
    assert((all[1].get(2) ?? "") == "two")
    assert(!re.is_match("nope"))
}

test "Regex: leftmost-first alternation and lazy quantifiers" {
    assert(groups("(a|ab)(c|bcd)(d*)", "abcd") == "a,bcd,")
    assert(matches("a|ab", "", "ab") == "0:1:a")
    assert(matches("ab|a", "", "ab") == "0:2:ab")
    assert(matches("<.+>", "", "<a><b>") == "0:6:<a><b>")
    assert(matches("<.+?>", "", "<a><b>") == "0:3:<a> 3:6:<b>")
    assert(matches("a??b", "", "ab") == "0:2:ab")
    assert(groups("(a?)(a?)(a)", "aa") == "a,,a")
    assert(groups("(a+)(a+)", "aaaa") == "aaa,a")
    assert(groups("(a+?)(a+)", "aaaa") == "a,aaa")
    assert(groups("(x)?y", "y") == "null")
    assert(groups("(a)|(b)", "b") == "null,b")
}

test "Regex: unicode and case folding" {
    assert(matches("é+", "", "caféééx") == "3:9:ééé")
    assert(matches("[à-ÿ]+", "", "naïve façade") == "2:4:ï 9:11:ç")
    assert(matches("(?i)straße", "", "STRASSE Straße") == "8:15:Straße")
    assert(matches("(?i)éCOLE", "", "École école") == "0:6:École 7:13:école")
    assert(matches("(?i)[é]x", "", "Éx") == "0:3:Éx")
    assert(matches(".", "", "日本") == "0:3:日 3:6:本")
    assert(matches("\\x{65e5}", "", "日本") == "0:3:日")
    assert(matches("[^日]", "", "日本") == "3:6:本")
    // Invalid UTF-8 bytes match as themselves and never as part of a range
    let raw = ByteBuffer.new(3)
    raw.write_byte('a')
    raw.write_byte(0xff)
    raw.write_byte('b')
    let text = raw.to_string()
    let byte = text.range(1, 1)
    assert(matches("\\xff", "", text) == "1:2:" + byte)
    assert(matches("[^a-z]", "", text) == "1:2:" + byte)
    assert(matches("[\\x{ff}]", "", text) == "1:2:" + byte)
}

test "Regex: anchors and assertions" {
    assert(matches("^a", "", "aa\na") == "0:1:a")
    assert(matches("^a", "m", "aa\na") == "0:1:a 3:4:a")
    assert(matches("a$", "", "aa\na") == "3:4:a")
    assert(matches("a$", "m", "aa\na") == "1:2:a 3:4:a")
    assert(matches("\\Aa", "m", "aa\na") == "0:1:a")
    assert(matches("a\\z", "m", "aa\na") == "3:4:a")
    assert(matches("\\Bo\\B", "", "foo of") == "1:2:o")
    assert(matches("^$", "", "") == "0:0:")
    assert(matches("^$", "m", "a\n\nb") == "2:2:")
    let re = regex.Regex.new("b") !!
    assert(!isset(re.match_at("abc", 0)))
    let m = re.match_at("abc", 1)
    assert(isset(m) && m.start == 1)
    assert(isset(re.find("abc", 1)))
    assert(!isset(re.find("abc", 2)))
}

test "Regex: named groups, ranges and expansion" {
    let re = regex.Regex.new("(?P<year>\\d{4})-(?<month>\\d{2})(-(\\d{2}))?") !!
    assert(re.group_count() == 4)
    assert(re.group_names().join(",") == ",year,month,,")
    assert((re.group_index("month") !? 0) == 2)
    let m = re.find("on 2024-09 and 1999-12-31") ?! panic("no match")
    assert((m.named("year") ?? "") == "2024")
    assert((m.named("month") ?? "") == "09")
    assert(!isset(m.named("day")))
    assert(!isset(m.get(3)))
    assert(!isset(m.get(9)))
    let s, e = m.range(1) !!
    assert(s == 3 && e == 7)
    let missing = false
    m.range(4) ! { missing = true }
    assert(missing)
    assert(m.expand("$year/${month} $$ $0 $9 ${nope}") == "2024/09 $ 2024-09  ")
    let second = re.find("on 2024-09 and 1999-12-31", m.end) ?! panic("no match")
    assert((second.get(4) ?? "") == "31")
}

test "Regex: replace and split" {
    let re = regex.Regex.new("(\\w+)@(\\w+)") !!
    assert(re.replace("me@home you@work", "$2 at $1") == "home at me work at you")
    assert(re.replace("me@home you@work", "x", 1) == "x you@work")
    assert(re.replace_with("me@home you@work", fn(m: regex.Match) String { return (m.get(2) ?? "").upper() }) == "HOME WORK")
    let empty = regex.Regex.new("x*") !!
    assert(empty.replace("axxbc", "-") == "-a--b-c-")
    assert(empty.split("axxbc").join("|") == "a|b|c")
    let comma = regex.Regex.new("\\s*,\\s*") !!
    assert(comma.split("a , b,c ,d").join("|") == "a|b|c|d")
    assert(comma.split("a , b,c ,d", 2).join("|") == "a|b,c ,d")
    assert(comma.split("").join("|") == "")
    assert(comma.split(",a,").join("|") == "|a|")
    let every = regex.Regex.new("") !!
    assert(every.split("abc").join("|") == "a|b|c")
    assert(regex.escape("a.b*c(d)[e]{f}|^$\\+?") == "a\\.b\\*c\\(d\\)\\[e\\]\\{f\\}\\|\\^\\$\\\\\\+\\?")
    let literal = regex.Regex.new(regex.escape("1+1=2")) !!
    assert(literal.is_match("so 1+1=2!"))
    assert(regex.is_match("^\\d+$", "12345") !!)
    assert(!(regex.is_match("^\\d+$", "123a") !!))
}

test "Regex: errors" {
    assert(error_of("(") == "syntax:Missing ')'")
    assert(error_of(")") == "syntax:Unmatched ')'")
    assert(error_of("[a") == "syntax:Missing ']'")
    assert(error_of("*a") == "syntax:Nothing to repeat")
    assert(error_of("a**") == "ok")
    assert(error_of("a{3,2}") == "syntax:Repetition bounds out of order")
    assert(error_of("a{1001}") == "syntax:Repetition count too large")
    assert(error_of("[z-a]") == "syntax:Range out of order")
    assert(error_of("\\q") == "syntax:Unknown escape")
    assert(error_of("a\\") == "syntax:Trailing backslash")
    assert(error_of("(?P<n>a)(?P<n>b)") == "syntax:Duplicate group name")
    assert(error_of("(?z)") == "syntax:Unknown group flag")
    assert(error_of("[[:nope:]]") == "syntax:Unknown POSIX class")
    assert(error_of("(a)\\1") == "unsupported:Backreferences are not supported")
    assert(error_of("(?=a)") == "unsupported:Lookaround is not supported")
    assert(error_of("(?<!a)") == "unsupported:Lookaround is not supported")
    assert(error_of("\\p{L}") == "unsupported:Unicode property classes are not supported")
    assert(error_of("(a{500}){500}") == "too_large")
    let position: uint = 0
    regex.Regex.new("ab(") ! { position = E.position }
    assert(position == 3)
    let flag = false
    regex.Regex.new("a", "x") ! { flag = error_is(E.code, syntax) }
    assert(flag)
}

test "Regex: no catastrophic backtracking" {
    // Exponential for a backtracker; linear here
    let re = regex.Regex.new("(a*)*b") !!
    let text = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    let start = time.mono_ms()
    assert(!re.is_match(text))
    let nested = regex.Regex.new("(x+x+)+y") !!
    assert(!nested.is_match("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"))
    assert(time.mono_ms() - start < 1000)
}

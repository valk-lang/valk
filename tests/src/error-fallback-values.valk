error FallbackError (failed)
class FallbackBox { number: int (73) }

fn fallback_box(kind: int) ?FallbackBox !FallbackError {
    if kind == 0 : throw .failed
    if kind == 1 : return null
    return FallbackBox {}
}

fn fallback_number(fail: bool) int !FallbackError {
    if fail : throw .failed
    return 79
}

fn fallback_void(fail: bool) !FallbackError {
    if fail : throw .failed
}

test "Error fallbacks: successful nullable values keep their type" {
    let missing = fallback_box(1) !? FallbackBox {}
    assert(!isset(missing))
    let present = fallback_box(2) !? panic("Unexpected failure")
    assert(isset(present) && present.number == 73)
    let nullable = fallback_box(1) !? panic("Unexpected failure")
    assert(!isset(nullable))
    let recovered = fallback_box(0) !? FallbackBox {}
    assert(isset(recovered) && recovered.number == 73)
}

test "Error fallbacks: nullable alternatives widen the result" {
    let missing = fallback_number(true) !? null[int]
    assert(!isset(missing))
    let present = fallback_number(false) !? null[int]
    assert(isset(present) && present == 79)
}

test "Error fallbacks: void alternatives are only executed on failure" {
    let box = FallbackBox { number: 0 }
    let recovered = fn() { box.number++ }
    fallback_void(false) !? recovered()
    assert(box.number == 0)
    fallback_void(true) !? recovered()
    assert(box.number == 1)
}

struct SortEntry { key: int
    cell: SortCell }
class SortCell { number: int }
struct OrderedEntry {
    key: int
    fn later(other: SELF) bool $gt { return this.key > other.key }
}
union SortChoice : int | bool {}

fn sort_choice_key(value: SortChoice) int {
    match value {
        int as number => return number
        bool as flag => return flag ? 1 : 0
    }
}

test "Array sorting: named slices accept explicit comparators" {
    let rows = Array[mut &[int]]{ [int]{ 73 }, [int]{ 19 }, [int]{ 7 } }
    assert(rows.length == 3 && rows[0][0] == 73)
    rows.sort(fn(a: mut &[int], b: mut &[int]) bool { return a[0] > b[0] })
    assert(rows[0][0] == 7 && rows[1][0] == 19 && rows[2][0] == 73)
    assert(!typeof(rows[0]).$can_order && int.$can_order && String.$can_order)
    let strings = Array[String]{ "z", "b", "a" }
    strings.sort()
    assert(strings[0] == "a" && strings[2] == "z")
}

test "Array sorting: inline values preserve managed fields" {
    let rows = Array[SortEntry]{
        SortEntry { key: 3, cell: SortCell { number: 73 } }
        SortEntry { key: 1, cell: SortCell { number: 19 } }
        SortEntry { key: 2, cell: SortCell { number: 7 } }
    }
    rows.sort(fn(a: SortEntry, b: SortEntry) bool { return a.key > b.key })
    assert(rows[0].key == 1 && rows[0].cell.number == 19)
    assert(rows[1].key == 2 && rows[1].cell.number == 7)
    assert(rows[2].key == 3 && rows[2].cell.number == 73)
    let ordered = Array[OrderedEntry]{ OrderedEntry { key: 3 }, OrderedEntry { key: 1 }, OrderedEntry { key: 2 } }
    assert(OrderedEntry.$can_order)
    ordered.sort()
    assert(ordered[0].key == 1 && ordered[2].key == 3)
}

test "Array sorting: callbacks and tagged unions accept comparators" {
    let callbacks = Array[fn()(int)]{ fn() int { return 73 }, fn() int { return 19 } }
    callbacks.sort(fn(a: fn()(int), b: fn()(int)) bool { return a() > b() })
    assert(callbacks[0]() == 19 && callbacks[1]() == 73)
    let choices = Array[SortChoice]{ 73, true, 19 }
    choices.sort(fn(a: SortChoice, b: SortChoice) bool { return sort_choice_key(a) > sort_choice_key(b) })
    assert(choices[0] == true && choices[1] == 19 && choices[2] == 73)
}

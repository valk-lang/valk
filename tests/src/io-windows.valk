@ignore_access

#if OS == "win"
use valk.coro
use valk.gc
use valk.io
use valk.net
use valk.thread
use valk.time
use valk.http

extern fn GetCurrentThreadId() u32;

fn iocp_block_scheduler() {
    coro.await_last()
    thread.suspend_ms(50)
}

test "Windows: successful I/O survives a late timeout check" {
    let listener = net.Socket.server(net.SocketType.tcp, "127.0.0.1", 9076) !!
    let accepting = co listener.accept()
    let client = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9076) !!
    let accepted = await accepting !!
    accepted.write("r") !!
    client.read_timeout_ms = 1
    let blocker = co iocp_block_scheduler()
    let bytes = Slice[u8].new(1, 0)
    assert((client.read(bytes) !? 0) == 1)
    assert(bytes.to_string() == "r")
    await blocker
    client.close() !!
    accepted.close() !!
    listener.close() !!
}

class IocpAcceptState {
    listener: shared net.SocketServer
    ready: uint (0)
    timeouts: uint (0)
    port: uint (0)
}

fn iocp_accept_worker(state: shared IocpAcceptState) int {
    let owner = GetCurrentThreadId().to(int)
    state.port = io.iocp()
    state.listener.accept(10) ! {
        if error_is(E.code, timeout) : state.timeouts++
    }
    state.ready++
    let connection = state.listener.accept(2000) ! return 0
    let bytes = Slice[u8].new(1, 0)
    if (connection.read(bytes) !? 0) != 1 : return 0
    gc.collect()
    connection.write(bytes) ! return 0
    connection.close() ! return 0
    return GetCurrentThreadId().to(int) == owner ? owner : 0
}

test "Windows: listener binds to its accepting thread, not its creator" {
    let state: shared IocpAcceptState = .{
        listener: net.Socket.server(net.SocketType.tcp, "127.0.0.1", 9074) !!
    }
    let worker = thread.Thread[int].start(fn() int { return iocp_accept_worker(state) }) !!
    let deadline = time.mono_ms() + 3000
    while state.ready == 0 && time.mono_ms() < deadline : time.sleep_ms(1)
    assert(state.ready == 1 && state.timeouts == 1)
    assert(state.port != io.iocp())
    let rejected = false
    state.listener.accept(10) ! {
        rejected = error_is(E.code, os)
    }
    assert(rejected)
    let client = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9074) !!
    client.write("q") !!
    let bytes = Slice[u8].new(1, 0)
    assert((client.read(bytes) !? 0) == 1)
    assert(bytes.to_string() == "q")
    client.close() !!
    let owner = worker.await()
    assert(owner != 0 && owner != GetCurrentThreadId().to(int))
    state.listener.close() !!
}

test "Windows: HTTP handoff queues are bounded and drain after closing" {
    let inbox: shared http.WorkerInbox = .{}
    let index: uint = 0
    while index < 128 {
        assert(inbox.push(index))
        index++
    }
    assert(!inbox.push(128))
    inbox.close()
    assert(!inbox.push(129))
    index = 0
    while index < 128 {
        let fd = inbox.pop()
        assert(isset(fd) && fd == index)
        index++
    }
    assert(!isset(inbox.pop()))
    inbox.close()
}

class IocpHttpState {
    entered: uint (0)
}

fn iocp_http_request() String {
    let response = http.request("GET", "http://127.0.0.1:9075/") !!
    return response.body
}

test "Windows: HTTP handlers execute on multiple worker threads" {
    let state: shared IocpHttpState = .{}
    let handler: shared fn(http.Request)(http.Response) = fn(req: http.Request) http.Response {
        state.entered++
        let deadline = time.mono_ms() + 2000
        while state.entered < 2 && time.mono_ms() < deadline : thread.suspend_ms(1)
        if state.entered < 2 : return http.Response.text("single worker")
        return http.Response.text(GetCurrentThreadId().to_string() + "|" + io.iocp().to_string())
    }
    let server = http.Server.new("127.0.0.1", 9075, handler)
    let running = co server.start(2)
    time.sleep_ms(50)
    let first = co iocp_http_request()
    let second = co iocp_http_request()
    let first_owner = await first
    let second_owner = await second
    assert(first_owner != "single worker" && second_owner != "single worker")
    assert(first_owner != second_owner)
    let first_parts = first_owner.split("|")
    let second_parts = second_owner.split("|")
    assert(first_parts.length == 2 && second_parts.length == 2)
    assert(first_parts.get(0) !! != second_parts.get(0) !!)
    assert(first_parts.get(1) !! != second_parts.get(1) !!)
    assert(server.shutdown(1000))
    await running !!
}

class IocpQueueState {
    entered: uint (0)
    release: uint (0)
    gate: shared thread.ThreadSuspendGate (.new())
}

fn iocp_release_after_delay(state: shared IocpQueueState) {
    time.sleep_ms(50)
    state.release = 1
    state.gate.signal()
}

test "Windows: awaiting HTTP shutdown keeps the caller scheduler running" {
    let state: shared IocpQueueState = .{}
    let handler: shared fn(http.Request)(http.Response) = fn(req: http.Request) http.Response {
        state.entered = 1
        state.gate.wait(fn() bool { return state.release == 0 }, 5000)
        return http.Response.text("done")
    }
    let server = http.Server.new("127.0.0.1", 9083, handler)
    let running = co server.start(2)
    let response = co http.request("GET", "http://127.0.0.1:9083/")
    let deadline = time.mono_ms() + 2000
    while state.entered == 0 && time.mono_ms() < deadline : time.sleep_ms(1)
    assert(state.entered == 1)
    let releasing = co iocp_release_after_delay(state)
    server.request_shutdown(1000)
    await running !!
    assert(state.release == 1)
    await releasing
    let result = await response !!
    assert(result.body == "done")
}

test "Windows: HTTP shutdown closes connections still waiting for a worker" {
    let state: shared IocpQueueState = .{}
    let handler: shared fn(http.Request)(http.Response) = fn(req: http.Request) http.Response {
        state.entered = 1
        state.gate.wait(fn() bool { return state.release == 0 }, 5000)
        return http.Response.text("done")
    }
    let server = http.Server.new("127.0.0.1", 9077, handler)
    let running = co server.start(2)
    let blocked = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9077) !!
    blocked.write("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n") !!
    let deadline = time.mono_ms() + 2000
    while state.entered == 0 && time.mono_ms() < deadline : time.sleep_ms(1)
    assert(state.entered == 1)
    let clients = Array[net.Connection].new()
    let index: uint = 0
    while index++ < 12 : clients.append(net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9077) !!)
    let run_state = server.lifecycle.run
    if !isset(run_state) : panic("Server did not start")
    let inbox = run_state.inboxes.get(1) !!
    deadline = time.mono_ms() + 2000
    while inbox.sockets.length < 6 && time.mono_ms() < deadline : time.sleep_ms(1)
    assert(inbox.sockets.length == 6)
    assert(!server.shutdown(0))
    state.release = 1
    state.gate.signal()
    await running !!
    assert(inbox.sockets.length == 0 && inbox.closed)
    each clients as client {
        assert(shutdown_peer_closed(client))
        client.close() !!
    }
    blocked.close() !!
}

test "Windows: partial HTTP worker startup closes queues and the listener" {
    let fail_after: int = 0
    while fail_after < 3 {
        let config = http.Server.new("127.0.0.1", 9078)
        config.fail_worker_start_after = fail_after
        let failed = false
        config.start(4) ! { failed = error_is(E.code, init) }
        assert(failed)
        let rebound = http.Server.new("127.0.0.1", 9078)
        let running = co rebound.start(3)
        assert(rebound.shutdown(1000))
        await running !!
        fail_after++
    }
}

fn windows_iocp_server() {
    let server = net.Socket.server(net.SocketType.tcp, "127.0.0.1", 9010) ! {
        assert(false)
        return
    }
    let con = server.accept() ! {
        assert(false)
        return
    }
    let buf = Slice[u8].new(1, 0)
    con.read(buf) ! {
        assert(false)
        return
    }
    con.write("r") ! assert(false)
}

fn windows_collect_pending() {
    gc.collect()
}

fn windows_close_later(con: net.Connection) {
    coro.await_last()
    con.close() ! assert(false)
}

test "Windows: IOCP object waits and dual socket readiness" {
    let server = co windows_iocp_server()
    coro.await_last()

    let con = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9010) ! {
        assert(false)
        return
    }
    let collector = co windows_collect_pending()
    let event = io.await_socket_fd(con.fd, true, true)
    await collector
    assert(event.is_writable())
    assert(!event.is_readable())

    con.write("q") ! assert(false)
    await server

    let readable = io.await_socket_fd(con.fd, true, true)
    assert(readable.is_readable())
    assert(readable.is_writable())

    let buf = Slice[u8].new(1, 0)
    let received = con.read(buf) !? 0
    assert(buf.view(0, received).to_string() == "r")

    let closer = co windows_close_later(con)
    let closed = io.await_socket_fd(con.fd, true, false)
    assert(closed.is_closed())
    await closer
}
#end

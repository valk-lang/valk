#if OS == "win"
use valk:coro
use valk:gc
use valk:io
use valk:net

fn windows_iocp_server() {
    let server = net:Socket.server(net:SOCKET_TYPE.TCP, "127.0.0.1", 9010) ! {
        assert(false)
        return
    }
    let con = server.accept() ! {
        assert(false)
        return
    }
    let buf = ByteBuffer.new()
    con.recv(buf, 1) ! {
        assert(false)
        return
    }
    con.send("r") ! assert(false)
}

fn windows_collect_pending() {
    gc:collect()
}

fn windows_close_later(con: net:Connection) {
    coro:await_last()
    con.close()
}

test "Windows: IOCP object waits and dual socket readiness" {
    let server = co windows_iocp_server()
    coro:await_last()

    let con = net:Socket.client(net:SOCKET_TYPE.TCP, "127.0.0.1", 9010) ! {
        assert(false)
        return
    }
    let collector = co windows_collect_pending()
    let event = io:await_socket_fd(con.fd, true, true)
    await collector
    assert(event.is_writable())
    assert(!event.is_readable())

    con.send("q") ! assert(false)
    await server

    let readable = io:await_socket_fd(con.fd, true, true)
    assert(readable.is_readable())
    assert(readable.is_writable())

    let buf = ByteBuffer.new()
    con.recv(buf, 1) ! assert(false)
    assert(buf.to_string() == "r")

    let closer = co windows_close_later(con)
    let closed = io:await_socket_fd(con.fd, true, false)
    assert(closed.is_closed())
    await closer
}
#end

use valk.gc
use valk.io

struct SiBigResult {
    a: int
    b: int
    c: int
    d: int
    e: int
}

interface SiNamed {
    fn name() String;
    fn tag() String {
        return "[" + this.name() + "]"
    }
}

interface SiStepper {
    fn step() int;
    fn reset();
    fn snapshot() SiBigResult;
}

interface SiFallible {
    fn compute(x: int) int !LookupError;
}

struct SiCounter is SiStepper, SiNamed {
    label: String
    count: int (0)

    fn name() String {
        return this.label
    }

    fn step() int {
        this.count++
        return this.count
    }

    fn reset() {
        this.count = 0
    }

    fn snapshot() SiBigResult {
        return SiBigResult { a: this.count, b: this.count * 2, c: 3, d: 4, e: 5 }
    }
}

struct SiGcHolder is SiNamed {
    prefix: String
    items: Array[String]

    fn name() String {
        return this.prefix + ":" + this.items.join(",")
    }
}

class SiClassNamed is SiNamed {
    label: String

    fn name() String {
        return this.label
    }
}

struct SiUnit is SiNamed {
    fn name() String {
        return "unit"
    }
}

struct SiGenericTag[T] is SiNamed {
    val: T

    fn name() String {
        return "g:" + this.val
    }
}

struct SiInfallibleImpl is SiFallible {
    bias: int

    fn compute(x: int) int {
        return x + this.bias
    }
}

struct SiFallibleImpl is SiFallible {
    limit: int

    fn compute(x: int) int !LookupError {
        if x > this.limit : throw .missing
        return x * 10
    }
}

struct SiSliceReader is io.Reader {
    data: String
    pos: uint (0)

    + fn read(buf: local mut &[u8]) uint !io.IoError {
        if this.pos >= this.data.bytes : return 0
        let rem = this.data.bytes - this.pos
        let n = buf.length < rem ? buf.length : rem
        let i: uint = 0
        while i < n {
            buf[i] = this.data.get(this.pos + i)
            i++
        }
        this.pos += n
        return n
    }
}

fn si_run_generic[T is SiStepper + SiNamed](s: T) String {
    let a = s.step()
    let b = s.step()
    return s.tag() + ":" + a + "," + b
}

test "Struct interfaces: static dispatch via generics and dynamic dispatch with state" {
    // Zero-alloc generic dispatch
    let c = SiCounter { label: "gen", count: 10 }
    assert(si_run_generic(c) == "[gen]:11,12")

    // Dynamic dispatch (boxed struct preserves state across interface calls)
    let st: SiStepper = SiCounter { label: "dyn", count: 0 }
    assert(st.step() == 1)
    assert(st.step() == 2)
    let snap = st.snapshot()
    assert(snap.a == 2 && snap.b == 4 && snap.e == 5)
    st.reset()
    assert(st.step() == 1)

    // Default interface method + heterogeneous array mixing structs, classes, unit struct, generic struct
    let items = Array[SiNamed]{
        SiCounter { label: "c1" }
        SiClassNamed { label: "cls" }
        SiUnit {}
        SiGenericTag[int] { val: 7 }
    }
    assert(items[0].tag() == "[c1]")
    assert(items[1].tag() == "[cls]")
    assert(items[2].tag() == "[unit]")
    assert(items[3].tag() == "[g:7]")

    // Fallible and infallible struct implementations of a fallible interface method
    let f1: SiFallible = SiInfallibleImpl { bias: 5 }
    let f2: SiFallible = SiFallibleImpl { limit: 10 }
    assert((f1.compute(3) !? -1) == 8)
    assert((f2.compute(4) !? -1) == 40)
    let threw = false
    f2.compute(20) ! { threw = true }
    assert(threw)
}

test "Struct interfaces: io.Reader integration, GC tracing, is_a, and match" {
    // Stdlib io.Reader implemented by a struct
    let r: io.Reader = SiSliceReader { data: "hello struct io" }
    let out = ByteBuffer.new()
    let copied = io.copy(r, out) ! panic("io.copy failed")
    assert(copied == 15)
    assert(out.to_string() == "hello struct io")

    // GC tracing of boxed struct holding heap String & Array[String]
    let arr = Array[String]{ "one", "two", "three" }
    let boxed: SiNamed = SiGcHolder { prefix: "gc", items: arr }
    let i = 0
    let churn: uint = 0
    while i++ < 100 {
        churn += Array[String]{ "churn-" + i }.length
    }
    assert(churn == 100)
    gc.collect()
    assert(boxed.name() == "gc:one,two,three")

    // is_a and match (with struct destructuring!)
    assert(boxed is_a SiGcHolder)
    assert(!(boxed is_a SiCounter))
    assert(!(boxed is_a SiClassNamed))

    let matched = match boxed : String {
        SiCounter { label, count } => "counter:" + label + ":" + count
        SiGcHolder { prefix, items } => prefix + "#" + items.length
        SiClassNamed as cls => "class:" + cls.label
        default => "other"
    }
    assert(matched == "gc#3")

    let st: SiNamed = SiCounter { label: "ctr", count: 42 }
    let matched2 = match st : String {
        SiCounter { label, count } => label + "=" + count
        default => "other"
    }
    assert(matched2 == "ctr=42")
}

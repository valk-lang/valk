use valk.coro
use valk.gc

// A `co` call keeps its arguments in malloc'd memory that no collection scans. Each fresh
// object below is named only by the argument: the launch must root it while it appends
// the roots (a collection there under GC_STRESS), and the callee's frame must hold it while
// the callee is parked and the caller collects. An argument of 512 bytes or more is passed
// by pointer. The caller lets the callee run until it parks, then collects.

class CoroArgNode {
    value: uint
}

struct CoroSmallArgs {
    a: CoroArgNode
    b: CoroArgNode
    c: CoroArgNode
}

struct CoroBigArgs {
    a: CoroArgNode
    pad: [uint x 64]
    b: CoroArgNode
}

fn coro_small_sum(args: CoroSmallArgs) uint {
    coro.await_last()
    return args.a.value + args.b.value + args.c.value
}

fn coro_big_sum(args: CoroBigArgs) uint {
    coro.await_last()
    return args.a.value + args.b.value + args.pad[63]
}

fn coro_small_pair(args: CoroSmallArgs) (CoroSmallArgs, uint) {
    coro.await_last()
    return (args, 1)
}

fn coro_start_small() co(uint) $noinline {
    return co coro_small_sum(CoroSmallArgs {
        a: CoroArgNode { value: 1 }
        b: CoroArgNode { value: 20 }
        c: CoroArgNode { value: 300 }
    })
}

fn coro_start_big() co(uint) $noinline {
    let args = CoroBigArgs {
        a: CoroArgNode { value: 1 }
        b: CoroArgNode { value: 20 }
    }
    args.pad[63] = 300
    return co coro_big_sum(args)
}

fn coro_start_pair() co(CoroSmallArgs, uint) $noinline {
    return co coro_small_pair(CoroSmallArgs {
        a: CoroArgNode { value: 4 }
        b: CoroArgNode { value: 50 }
        c: CoroArgNode { value: 600 }
    })
}

fn coro_churn() $noinline {
    let i = 0
    while i < 200 {
        let n = CoroArgNode { value: 7 }
        i++
    }
    gc.collect()
}

synctest "GC: coroutine aggregate arguments stay rooted below 512 bytes" {
    // Many launches, so GC_STRESS collects inside some of their root appends
    let i = 0
    while i < 32 {
        let task = coro_start_small()
        coro.await_last()
        coro_churn()
        assert(await task == 321)
        i++
    }
}

synctest "GC: coroutine aggregate arguments stay rooted from 512 bytes" {
    let task = coro_start_big()
    coro.await_last()
    coro_churn()
    assert(await task == 321)
}

synctest "GC: coroutine aggregate results stay rooted" {
    let task = coro_start_pair()
    coro.await_last()
    coro_churn()
    let args, n = await task
    gc.collect()
    assert(args.a.value + args.b.value + args.c.value + n == 655)
}

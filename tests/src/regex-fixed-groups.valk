@ignore_access

use valk.regex

fn fixed_slot_text(slots: ?local &[uint]) String {
    if !isset(slots) : return "none"
    let out = ""
    each slots as slot : out += slot == regex.SLOT_UNSET ? "-," : "%slot,"
    return out
}

// The search must find what the VM alone finds, with the same groups, at every start
fn fixed_agrees(pattern: String, flags: String, text: String) bool {
    let re = regex.Regex.new(pattern, flags) ! panic("Bad pattern: %pattern")
    each 0 .. text.bytes + 1 as start {
        let fast = fixed_slot_text(re.run(text, start, false))
        let vm = fixed_slot_text(re.run_vm(text, start, re.anchored))
        if re.anchored && start > 0 : vm = "none"
        if fast != vm {
            println("'%pattern' on '%text' from %start: search %fast, VM %vm")
            return false
        }
    }
    return true
}

fn has_fixed_groups(pattern: String, flags: String ("")) bool {
    let re = regex.Regex.new(pattern, flags) ! panic("Bad pattern: %pattern")
    return isset(re.fixed_slots)
}

test "Regex fixed groups: which patterns have them" {
    assert(has_fixed_groups("\\{\\{(.*?)\\}\\}"))
    assert(has_fixed_groups("(.*)"))
    assert(has_fixed_groups("\"(.*)\""))
    assert(has_fixed_groups("key=(\\w+)"))
    assert(has_fixed_groups("(\\w+)@"))
    assert(has_fixed_groups("^a(.*)b$"))
    assert(has_fixed_groups("(ab)c(d)"))
    assert(has_fixed_groups("(ab)(.*)(cd)"))
    assert(has_fixed_groups("<((a)b(.*)c(d))>"))
    assert(has_fixed_groups("(?:ab)(x+)(?:cd)"))
    assert(has_fixed_groups("(a|b)"))

    assert(!has_fixed_groups("abc"))
    assert(!has_fixed_groups("(a*)(b*)"))
    assert(!has_fixed_groups("(\\w+)-(\\w+)"))
    assert(!has_fixed_groups("(a)|(b)"))
    assert(!has_fixed_groups("(a)*"))
    assert(!has_fixed_groups("(a)?b"))
    assert(!has_fixed_groups("(a+(b)c+)"))
    assert(!has_fixed_groups("k(.*)k(.)", "i"))
    assert(!has_fixed_groups("\xc3\xa9*(.*)\xc3\xa9*(a)"))
}

test "Regex fixed groups: every kind of pattern agrees with the VM" {
    let patterns = Array[String]{
        "\\{\\{(.*?)\\}\\}", "\\{\\{(.*)\\}\\}", "(.*)", "(.*?)", "\"(.*)\"", "\"(.*?)\"", "key=(\\w*)", "(\\w+)@", "(\\w*)@",
        "^a(.*)b$", "a(.*)b$", "^(a*)", "(a*)$", "\\b(\\w+)\\b", "\\ba(.*)b\\b", "(ab)c(d)", "(ab)(.*)(cd)", "<((a)b(.*)c(d))>",
        "(?:ab)(x+)(?:cd)", "(a|b)", "x(a|bc)y", "(?:a|bc)(x)", "(x)(?:a|bc)", "(.)(.)", "a(.)b", "(a*)(b*)", "(\\w+)-(\\w+)",
        "(a)|(b)", "(a)*", "(a)?b", "(a+(b)c+)", "()", "a()b", "()a()", "(a|)", "(|a)b", "((a))", "((.*))", "(?s)a(.*)b", "aa(a*)aa", "ab(.*)ab(.*)",
        "(a)b*", "a*(b)", "[ab](c)", "(c)[ab]", "\xc3\xa9(.*)\xc3\xa9", "(\xc3\xa9)(.)", "<(.*?)>", "<<(.*?)>"
    }
    let texts = Array[String]{
        "", "a", "ab", "abc", "abcd", "aabb", "abab", "aaaa", "aaaaaa", "xaby", "xbcy", "xay", "x", "<ab c d>", "<<a>>", "<a><b>", "<>", "<<>",
        "{{x}}", "{{ x }} {{y}}", "{{}}", "{{{x}}}", "{x}", "{{x", "x}}", "{{a\nb}}", "a\nb", "\"q\" \"r\"", "\"", "\"\"", "key=val key=", "key=", "me@ you@", "@",
        "word-word two-", "ab cd", "ab xx cd", "abxcd", "abcdabcd", "abcabc", "\xc3\xa9x\xc3\xa9", "\xc3\xa9\xc3\xa9", "a\xc3\xa9b", "\xff{{\xff}}\xff", "a\xffb", "<abcd>", "<abxcd>", "<ab1c2d>"
    }
    each patterns as pattern {
        each texts as text : assert(fixed_agrees(pattern, "", text))
        each texts as text : assert(fixed_agrees(pattern, "s", text))
        each texts as text : assert(fixed_agrees(pattern, "m", text))
    }
}

test "Regex fixed groups: caseless and non-ASCII literals keep to the VM" {
    each Array[String]{ "k(.*)k", "(k)(.)", "\xc3\xa9(.)(.)" } as pattern {
        each Array[String]{ "kxk", "KxK", "\xe2\x84\xaax\xe2\x84\xaa", "\xc3\xa9ab", "\xc3\x89ab" } as text {
            assert(fixed_agrees(pattern, "i", text))
        }
    }
    let re = regex.Regex.new("(k)(.)", "i") ! panic("Bad pattern")
    let m = re.find("\xe2\x84\xaax") ?! panic("No match")
    assert((m.get(1) ?? "") == "\xe2\x84\xaa")
    assert((m.get(2) ?? "") == "x")
}

test "Regex fixed groups: the results read through Match" {
    let re = regex.Regex.new("\\{\\{(.*?)\\}\\}") ! panic("Bad pattern")
    let m = re.find("a {{ first }} {{second}}") ?! panic("No match")
    assert(m.str() == "{{ first }}")
    assert(m.start == 2)
    assert(m.end == 13)
    assert((m.get(1) ?? "") == " first ")
    assert(!isset(m.get(2)))
    assert(re.replace_with("[{{a}}|{{bb}}]", fn(found: regex.Match) String { return (found.get(1) ?? "").upper() }) == "[A|BB]")
    assert(re.replace("[{{a}}]", "<$1>") == "[<a>]")

    let names = regex.Regex.new("<(?P<tag>.*?)>") ! panic("Bad pattern")
    assert(((names.find("x<b>") ?! panic("No match")).named("tag") ?? "") == "b")

    // A group on a span larger than the backtracker takes
    let long = "x".repeat(1 << 20)
    let big = regex.Regex.new("a(.*)b") ! panic("Bad pattern")
    assert(((big.find("a" + long + "b") ?! panic("No match")).get(1) ?? "").bytes == long.bytes)
    let clone = big.clone()
    assert(((clone.find("axb") ?! panic("No match")).get(1) ?? "") == "x")
}

test "Regex prefix search: failing starts stay linear" {
    // Each occurrence of the prefix would read to the end of the text if a failed read did
    // not hand over to the plain search
    let text = "a".repeat(200000)
    let re = regex.Regex.new("a.*b") ! panic("Bad pattern")
    assert(!isset(re.find(text)))
    assert(re.find_all(text).length == 0)
    assert((re.find(text + "b") ?! panic("No match")).end == text.bytes + 1)
    let line = regex.Regex.new("ab.*c") ! panic("Bad pattern")
    assert(!isset(line.find("ab".repeat(100000))))
    assert(fixed_agrees("a.*b", "", "aaa\naab\naa"))
    assert(fixed_agrees("ab.*c", "", "ab\nab\nabc"))
    assert(fixed_agrees("aa+b", "", "aaaacaaab"))
}

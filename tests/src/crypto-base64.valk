
use valk.crypto
use valk.thread
use valk.coro
use valk.io

fn base64_test(input: String, cmp: String) bool {
    // Encode
    let hash = crypto.base64_encode(input)
    let same1 = hash == cmp
    // Decode
    let decode = crypto.base64_decode(hash) ! return false
    let same2 = decode == input
    //
    return same1 && same2
}

fn base64_invalid(input: String) bool {
    crypto.base64_decode(input) ! return true
    return false
}

test "Base64" {
    let v = ""
    let h = ""

    v = ""
    h = ""
    assert(base64_test(v, h))
    assert((crypto.base64_decode("") !? "invalid") == "")
    assert((crypto.base64_decode("TQ") !? "") == "M")
    assert((crypto.base64_decode("TWE") !? "") == "Ma")

    v = "This is a base64 encode/decode test"
    h = "VGhpcyBpcyBhIGJhc2U2NCBlbmNvZGUvZGVjb2RlIHRlc3Q="
    assert(base64_test(v, h))

    v = "Lorem ipsum dolor sit amet consectetur adipiscing elit. Quisque faucibus ex sapien vitae pellentesque sem placerat. In id cursus mi pretium tellus duis convallis. Tempus leo eu aenean sed diam urna tempor. Pulvinar vivamus fringilla lacus nec metus bibendum egestas. Iaculis massa nisl malesuada lacinia integer nunc posuere. Ut hendrerit semper vel class aptent taciti sociosqu. Ad litora torquent per conubia nostra inceptos himenaeos. Lorem ipsum dolor sit amet consectetur adipiscing elit. Quisque faucibus ex sapien vitae pellentesque sem placerat. In id cursus mi pretium tellus duis convallis. Tempus leo eu aenean sed diam urna tempor. Pulvinar vivamus fringilla lacus nec metus bibendum egestas. Iaculis massa nisl malesuada lacinia integer nunc posuere. Ut hendrerit semper vel class aptent taciti sociosqu. Ad litora torquent per conubia nostra inceptos himenaeos."
    h = ""
    assert(base64_test(v, h))

    assert(base64_invalid("A"))
    assert(base64_invalid("AA=A"))
    assert(base64_invalid("AA$="))
    assert(base64_invalid("AB=="))
    assert(base64_invalid("VG hp"))
}

test "Base64 skips line breaks" {
    let wrapped = "VGhpcyBpcyBhIGJh\r\nc2U2NCBlbmNvZGUv\nZGVjb2RlIHRlc3Q=\n"
    let expect = "This is a base64 encode/decode test"
    assert((crypto.base64_decode(wrapped) !? "") == expect)
    let out = [u8]{ 0 x 64 }
    let len = crypto.base64_decode_in(wrapped, out) !? 0
    assert(out.view(0, len).to_string() == expect)
    let streamed = ByteBuffer.new(16)
    crypto.base64_decode_into(wrapped, streamed) !!
    assert(streamed.to_string() == expect)
    assert((crypto.base64url_decode("SGk\n") !? "") == "Hi")
}

test "Base64 streamed into a writer" {
    // Longer than one block, so the streaming path wraps around
    let long = ByteBuffer.new(4096)
    let i: uint = 0
    while i++ < 2000 : long.write_byte(('a' + (i % 26)).to(u8))
    let source = long.into_string()

    let encoded = ByteBuffer.new(64)
    let written = crypto.base64_encode_into(source, encoded) !!
    let expect = crypto.base64_encode(source)
    assert(encoded.to_string() == expect)
    assert(written == expect.bytes)

    let decoded = ByteBuffer.new(64)
    let back = crypto.base64_decode_into(expect, decoded) !!
    assert(decoded.to_string() == source)
    assert(back == source.bytes)

    // Empty input writes nothing
    let none = ByteBuffer.new(8)
    assert((crypto.base64_encode_into("", none) !!) == 0)
    assert(none.length == 0)

    // Malformed input still throws
    let bad = ByteBuffer.new(8)
    let threw = false
    crypto.base64_decode_into("AA$=", bad) ! threw = true
    assert(threw)

    // Padding may only close the stream: '=' at the last byte of a
    // non-final 504-byte block is rejected, as the one-shot decoder does
    let padded = ByteBuffer.new(520)
    let fill: uint = 0
    while fill++ < 503 : padded.write_byte('A')
    padded.write_byte('=')
    padded.write("AA")
    let one_shot = crypto.base64_decode(padded.to_string()) !? "<threw>"
    assert(one_shot == "<threw>")
    let stream_out = ByteBuffer.new(16)
    let stream_threw = false
    crypto.base64_decode_into(padded.to_string(), stream_out) ! stream_threw = true
    assert(stream_threw)
}

test "Hex and digests streamed into a writer" {
    let data = "The quick brown fox jumps over the lazy dog"

    let hex = ByteBuffer.new(16)
    let n = crypto.hex_encode_into(data, hex) !!
    assert(hex.to_string() == crypto.hex_encode(data))
    assert(n == data.bytes * 2)

    let raw = ByteBuffer.new(16)
    crypto.hex_decode_into(crypto.hex_encode(data), raw) !!
    assert(raw.to_string() == data)

    let digest = ByteBuffer.new(8)
    crypto.hash_into(crypto.HashAlgorithm.sha256, data, digest) !!
    assert(crypto.hex_encode(digest.to_string()) == crypto.sha256_hex(data))

    let digest_hex = ByteBuffer.new(8)
    let hn = crypto.hash_hex_into(crypto.HashAlgorithm.sha512, data, digest_hex) !!
    assert(digest_hex.to_string() == crypto.sha512_hex(data))
    assert(hn == 128)

    // The per-algorithm shorthands agree with the generic form
    let shorthand = ByteBuffer.new(8)
    crypto.sha256_hex_into(data, shorthand) !!
    assert(shorthand.to_string() == crypto.sha256_hex(data))
    let md5_out = ByteBuffer.new(8)
    crypto.md5_hex_into(data, md5_out) !!
    assert(md5_out.to_string() == crypto.md5_hex(data))

    // Random bytes stream out at the requested length
    let rnd = ByteBuffer.new(8)
    assert((crypto.random_bytes_into(1500, rnd) !!) == 1500)
    assert(rnd.length == 1500)

    // Longer than one chunk, so the hex streaming path wraps around
    let big = ByteBuffer.new(2048)
    let i: uint = 0
    while i++ < 1000 : big.write_byte((i % 256).to(u8))
    let bytes = big.into_string()
    let out = ByteBuffer.new(16)
    crypto.hex_encode_into(bytes, out) !!
    assert(out.to_string() == crypto.hex_encode(bytes))
}

#if !TEST_ST_ONLY
test "Crypto writers work on a spawned thread" {
    // The streaming functions must not depend on anything the main thread set up
    let data = "payload for the worker thread"
    let expect = crypto.sha256_hex(data)

    let worker = thread.Thread[String].start(fn() String {
        let out = ByteBuffer.new(8)
        crypto.sha256_hex_into("payload for the worker thread", out) !!
        crypto.base64_encode_into("abc", out) !!
        crypto.hex_encode_into("\x01", out) !!
        crypto.random_bytes_into(600, out) !!
        return out.to_string()
    }) !!
    let result = worker.await()

    assert(result.starts_with(expect))
    assert(result.range(expect.bytes, 4) == "YWJj")
    assert(result.range(expect.bytes + 4, 2) == "01")
    assert(result.bytes == expect.bytes + 4 + 2 + 600)
}
#end

test "Digest and hex buffers do not collide" {
    // 'hash_hex_into' holds a digest while hex encoding it, so the digest and
    // the hex chunk must be separate storage
    let data = "the quick brown fox"
    let out = ByteBuffer.new(8)
    crypto.hash_hex_into(crypto.HashAlgorithm.sha512, data, out) !!
    assert(out.to_string() == crypto.sha512_hex(data))

    // Back to back calls must not carry state over
    let again = ByteBuffer.new(8)
    crypto.hash_hex_into(crypto.HashAlgorithm.md5, data, again) !!
    crypto.hash_hex_into(crypto.HashAlgorithm.md5, data, again) !!
    assert(again.to_string() == crypto.md5_hex(data) + crypto.md5_hex(data))
}

// A writer that suspends its coroutine on every write, the way a socket does
// when it has to wait for the kernel. Anything the encoder still needs after
// the write must therefore survive another coroutine running in between.
class YieldingWriter is io.Writer {
    sink: ByteBuffer (.new(64))
    + fn write(data: local &[u8]) uint !io.IoError {
        coro.await_last()
        return this.sink.write(data)
    }
}

fn hex_through_yields(source: String, out: YieldingWriter) {
    crypto.hex_encode_into(source, out) !!
}

test "Interleaved coroutines do not share encoder state" {
    // Long enough that each encode spans several writes, so the two coroutines
    // are guaranteed to interleave inside the encoding loop
    let first = ByteBuffer.new(2048)
    let second = ByteBuffer.new(2048)
    let i: uint = 0
    while i++ < 700 {
        first.write_byte('a')
        second.write_byte('b')
    }
    let a = first.into_string()
    let b = second.into_string()

    let out_a = YieldingWriter {}
    let out_b = YieldingWriter {}
    let ca = co hex_through_yields(a, out_a)
    let cb = co hex_through_yields(b, out_b)
    await ca
    await cb

    assert(out_a.sink.to_string() == crypto.hex_encode(a))
    assert(out_b.sink.to_string() == crypto.hex_encode(b))
}

test "Base64: long inputs take the vector blocks" {
    // Every byte value once: 256 bytes, 344 characters, padded
    let all = ByteBuffer.new(256)
    each 0..256 as i : all.write_byte(i.to(u8))
    let expect = ""
    let bytes = all.to_string()
    assert(crypto.base64_encode(bytes) == expect)
    assert((crypto.base64_decode(expect) !? "") == bytes)
    // Every length around the block boundaries round-trips
    let ok = true
    let n: uint = 0
    while n < 80 {
        let input = bytes.range(7, n)
        let encoded = crypto.base64_encode(input)
        if encoded.bytes != (n + 2) / 3 * 4 : ok = false
        if (crypto.base64_decode(encoded) !? "?") != input : ok = false
        n++
    }
    assert(ok)
    // An invalid character inside a full block, and the whole alphabet without padding
    assert(base64_invalid("AAECAwQFBgcICQoLDA0ODxAR*hMUFRYXGBkaGxwdHh8g"))
    assert(base64_invalid("AAECAwQFBgcICQoLDA0ODxARE\xc3MUFRYXGBkaGxwdHh8g"))
    // The characters next to every alphabet range, at every lane of a 32-character block
    let neighbors = "@[`{:,-.= \t\x80\xff"
    let rejected = true
    each neighbors as bad {
        each 0..32 as pos {
            let text = [u8]{ 0 x 64 }
            each 0..64 as k : text[k] = expect[k]
            text[pos] = bad
            if !base64_invalid(text.to_string()) : rejected = false
        }
    }
    assert(rejected)
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let decoded = crypto.base64_decode(alphabet) !? ""
    assert(decoded.bytes == 48 && decoded[0] == 0 && decoded[47] == 0xBF)
    assert(crypto.base64_encode(decoded) == alphabet)
    // Streaming and in-place forms share the blocks
    let out = [u8]{ 0 x 400 }
    let written = crypto.base64_encode_in(bytes, out)
    assert(written == 344 && out.view(0, 344).to_string() == expect)
    let back = [u8]{ 0 x 300 }
    let got = crypto.base64_decode_in(expect, back) !? 0
    assert(got == 256 && back.view(0, 256).to_string() == bytes)
    let streamed = ByteBuffer.new(16)
    crypto.base64_decode_into(expect, streamed) !!
    assert(streamed.to_string() == bytes)
    // Line breaks after whole blocks, inside a block and right at the end
    let wrapped = expect.range(0, 76) + "\r\n" + expect.range(76, 100) + "\n" + expect.range(176, 168) + "\n"
    assert((crypto.base64_decode(wrapped) !? "") == bytes)
    assert((crypto.base64_decode(expect.range(0, 21) + "\n" + expect.range(21, 323)) !? "") == bytes)
}

use valk.random

test "Random: a seeded generator repeats the reference sequence" {
    // xoshiro256** seeded with splitmix64(42), as in the reference implementation
    let rng = random.Rng.new(42)
    assert(rng.next() == 1546998764402558742)
    assert(rng.next() == 6990951692964543102)
    assert(rng.next() == 12544586762248559009)
    assert(rng.next() == 17057574109182124193)
    rng.reseed(42)
    assert(rng.next() == 1546998764402558742)

    // The thread's generator follows a seed too
    random.seed(42)
    assert(random.next() == 1546998764402558742)
}

test "Random: ranges are inclusive, unbiased and cover their ends" {
    let rng = random.Rng.new(7)
    let counts = Array[uint].fill(6, 0)
    let outside: uint = 0
    each 0 .. 60000 {
        let roll = rng.between(1, 6)
        if roll < 1 || roll > 6 {
            outside++
            continue
        }
        counts.set((roll - 1).to(uint), (counts.get((roll - 1).to(uint)) !? 0) + 1) !!
    }
    assert(outside == 0)
    // Each face 10000 times give or take a few percent
    each counts as count : assert(count > 9500 && count < 10500)

    assert(rng.between(5, 5) == 5)
    let swapped = rng.between(10, -10)
    assert(swapped >= -10 && swapped <= 10)
    let low_seen = false
    let high_seen = false
    let in_range = true
    each 0 .. 1000 {
        let v = rng.between(-2, 0)
        if v == -2 : low_seen = true
        if v == 0 : high_seen = true
        if v < -2 || v > 0 : in_range = false
    }
    assert(low_seen && high_seen && in_range)
    // The whole int range does not overflow
    rng.between(int.$min, int.$max)
    let near = rng.between(int.$max - 1, int.$max)
    assert(near >= int.$max - 1)

    assert(rng.below(0) == 0)
    assert(rng.below(1) == 0)
    let below_ok = true
    each 0 .. 1000 {
        if random.below(3) >= 3 : below_ok = false
    }
    assert(below_ok)
}

test "Random: fractions and chances" {
    let rng = random.Rng.new(1)
    let sum: float = 0
    let in_range = true
    each 0 .. 10000 {
        let f = rng.fraction()
        if f < 0.0 || f >= 1.0 : in_range = false
        sum += f
    }
    assert(in_range)
    assert(sum > 4800.0 && sum < 5200.0)
    let certain = true
    each 0 .. 100 {
        if rng.chance(0.0) || !rng.chance(1.0) : certain = false
    }
    assert(certain)
    let f = random.fraction()
    assert(f >= 0.0 && f < 1.0)
}

test "Random: shuffle with a seed repeats and keeps every element" {
    let items = Array[uint]{}
    each 0 .. 50 as i : items.append(i.to(uint))
    let a = items.shuffled(random.Rng.new(3))
    let b = items.shuffled(random.Rng.new(3))
    assert(a.equals(b))
    assert(!a.equals(items))
    assert(a.equals_ignore_order(items))
    let c = items.shuffled()
    assert(c.equals_ignore_order(items))
}

use valk.log
use valk.json
use valk.fs
use valk.thread

fn log_lines(buffer: ByteBuffer) Array[String] {
    let lines = buffer.to_string().split("\n")
    // The last record ends the text with a newline
    if lines.length > 0 && lines[lines.length - 1] == "" : lines.pop_last() _
    return lines
}

test "Logging: text records" {
    let out = ByteBuffer.new(256)
    let logger = log.Logger.new(out)
    let port: uint = 8080
    logger.info("server started", .{ "port" => port, "host" => "example.com" })
    logger.debug("not written")
    logger.level = log.Level.debug
    logger.debug("shown", .{ "ratio" => 0.125, "ok" => false, "delta" => -3, "none" => null, "note" => "two words", "quote" => "say \"hi\"", "empty" => "" })
    logger.warn("line one\nline two")
    logger.error("failed")
    let lines = log_lines(out)
    assert(lines.length == 4)
    // 2024-03-05T14:07:09.250Z
    let stamp = lines[0].range(0, 24)
    assert(stamp.get(4) == '-' && stamp.get(10) == 'T' && stamp.get(19) == '.' && stamp.get(23) == 'Z')
    assert(lines[0].range(24, lines[0].bytes - 24) == " INFO  server started port=8080 host=example.com")
    assert(lines[1].range(24, lines[1].bytes - 24) == " DEBUG shown ratio=0.125 ok=false delta=-3 none=null note=\"two words\" quote=\"say \\\"hi\\\"\" empty=\"\"")
    assert(lines[2].range(24, lines[2].bytes - 24) == " WARN  line one\\nline two")
    assert(lines[3].range(24, lines[3].bytes - 24) == " ERROR failed")
}

test "Logging: JSON records keep their field types" {
    let out = ByteBuffer.new(256)
    let logger = log.Logger.new(out, log.Level.info, log.Format.json)
    let count: uint = 3
    logger.warn("slow \"query\"\n", .{ "ms" => 1250, "count" => count, "ratio" => 0.5, "ok" => true, "none" => null, "path" => "/a\\b" })
    let lines = log_lines(out)
    assert(lines.length == 1)
    let record = json.decode(lines[0]) !!
    assert((record.get_string("level") !!) == "warn")
    assert((record.get_string("msg") !!) == "slow \"query\"\n")
    assert((record.get_string("time") !!).ends_with("Z"))
    assert((record.get_int("ms") !!) == 1250 && (record.get_int("count") !!) == 3)
    assert((record.get_float("ratio") !!) == 0.5)
    assert((record.get_bool("ok") !!) && record.has("none") && !record.has_string("none"))
    assert((record.get_string("path") !!) == "/a\\b")
}

test "Logging: loggers with context fields" {
    let out = ByteBuffer.new(256)
    let base = log.Logger.new(out, log.Level.warn)
    let request = base.with(.{ "request" => "r-17", "user" => "ann" })
    let step = request.with(.{ "user" => "bob", "step" => 2 })
    assert(!request.enabled(log.Level.info) && request.enabled(log.Level.error))
    request.info("dropped")
    request.warn("first")
    step.error("second")
    base.warn("third")
    let lines = log_lines(out)
    assert(lines.length == 3)
    assert(lines[0].ends_with("first request=r-17 user=ann"))
    assert(lines[1].ends_with("second request=r-17 user=bob step=2"))
    assert(lines[2].ends_with("third"))
}

test "Logging: a record field replaces a context field with the same key" {
    let out = ByteBuffer.new(256)
    let request = log.Logger.new(out, log.Level.info, log.Format.json).with(.{ "req" => "r1", "user" => "ann" })
    request.info("moved", .{ "req" => "r2", "step" => 3 })
    request.info("kept", .{ "step" => 4 })
    let lines = log_lines(out)
    assert(lines.length == 2)
    assert(lines[0].ends_with("\"msg\":\"moved\",\"req\":\"r2\",\"user\":\"ann\",\"step\":3}"))
    assert(lines[1].ends_with("\"msg\":\"kept\",\"req\":\"r1\",\"user\":\"ann\",\"step\":4}"))
}

test "Logging: levels by name" {
    assert((log.parse_level("DEBUG") !!) == log.Level.debug)
    assert((log.parse_level("Warning") !!) == log.Level.warn)
    assert((log.parse_level("error") !!) == log.Level.error)
    let missing = false
    log.parse_level("verbose") ! { missing = error_is(E.code, missing) }
    assert(missing)
}

synctest "Logging: records of many threads land whole in one file" {
    let path = temp_path("valk-log-threads.log")
    fs.delete_file(path) _
    log.to_file(path) !!
    log.set_format(log.Format.json)
    log.set_level(log.Level.debug)
    let threads = Array[thread.Thread[void]]{}
    let t: uint = 0
    while t < 4 {
        let id = t
        threads.append(thread.Thread[void].start(fn() {
            let i: uint = 0
            while i < 500 {
                log.debug("working on something that takes a while", .{ "thread" => id, "item" => i, "padding" => "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" })
                i++
            }
        }) !!)
        t++
    }
    each threads as worker : worker.await()
    log.to_stderr()
    log.set_format(log.Format.text)
    log.set_level(log.Level.info)
    assert(log.level() == log.Level.info)

    let text = fs.read(path) !!
    let lines = text.split("\n")
    assert(lines.length == 2001 && lines[2000] == "")
    let per_thread = Array[uint]{ 0, 0, 0, 0 }
    let i: uint = 0
    while i < 2000 {
        let record = json.decode(lines[i]) !!
        let thread_id = (record.get_int("thread") !!).to(uint)
        per_thread[thread_id] = per_thread[thread_id] + 1
        assert((record.get_string("level") !!) == "debug")
        i++
    }
    each per_thread as count : assert(count == 500)
    fs.delete_file(path) _
}

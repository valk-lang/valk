use valk.io

interface GcDescribable {
    fn describe() String;
}

interface GcCloseable {
    fn close_item() bool;
}

interface GcComparable[T] {
    fn cmp(other: T) int;
}

interface GcConverter[Out] {
    fn convert() Out;
}

class GcItem is GcDescribable, GcCloseable {
    label: String
    closed: bool (false)

    fn describe() String {
        return this.label
    }

    fn close_item() bool {
        this.closed = true
        return true
    }
}

class GcOnlyDesc is GcDescribable {
    text: String

    fn describe() String {
        return this.text
    }
}

class GcScore is GcComparable[GcScore] {
    points: int

    fn cmp(other: GcScore) int {
        return this.points - other.points
    }
}

class GcIntToStr is GcConverter[String] {
    n: int

    fn convert() String {
        return this.n.to_string()
    }
}

class GcEqKey {
    id: int

    + fn eq(other: GcEqKey) bool $eq {
        return this.id == other.id
    }

    + fn hash() uint {
        return this.id.to(uint)
    }
}

fn gc_describe[T is GcDescribable](x: T) String {
    return x.describe()
}

fn gc_describe_and_close[T is GcDescribable + GcCloseable](x: T) String {
    let s = x.describe()
    x.close_item()
    return s
}

fn gc_max_cmp[T is GcComparable[T]](a: T, b: T) T {
    return a.cmp(b) >= 0 ? a : b
}

fn gc_convert_pair[Out, C is GcConverter[Out]](c: C) Out {
    return c.convert()
}

fn gc_clamp_num[T is $number + $order](v: T, lo: T, hi: T) T {
    if v < lo : return lo
    if v > hi : return hi
    return v
}

fn gc_same[T is $eq](a: T, b: T) bool {
    return a == b
}

fn gc_put_key[K is $hash + $eq](m: HashMap[K, int], k: K, v: int) {
    m.set(k, v)
}

fn gc_scale_int[T is $integer, const FACTOR: int](v: T) T {
    return v * FACTOR.to(T)
}

fn gc_half_float[T is $float](v: T) T {
    return v / 2.0.to(T)
}

fn gc_write_str[W is io.Writer](w: W, s: String) uint !io.IoError {
    return w.write(s) !>
}

class GcHolder[T is GcDescribable] {
    item: T

    fn summary() String {
        return "held:" + this.item.describe()
    }
}

struct GcNumPair[T is $number] {
    a: T
    b: T

    fn sum() T {
        return this.a + this.b
    }
}

class GcSink[Out] {
    fn pull[C is GcConverter[Out]](c: C) Out {
        return c.convert()
    }
}

trait GcDescTrait[T is GcDescribable] {
    inner: T

    fn inner_desc() String {
        return this.inner.describe()
    }
}

class GcTraitHost {
    use GcDescTrait[GcOnlyDesc]
}

class GcWrap[T] {
    value: T
}

extend GcWrap[T is GcDescribable] {
    fn label() String {
        return this.value.describe()
    }
}

extend GcWrap[T is $number] {
    fn doubled() T {
        return this.value + this.value
    }
}

test "Generic constraints: interfaces, multiple bounds, F-bounds, and inference" {
    let item = GcItem { label: "alpha" }
    assert(gc_describe[GcItem](item) == "alpha")
    assert(gc_describe(item) == "alpha")
    assert(gc_describe_and_close(item) == "alpha")
    assert(item.closed)

    // Interface type itself satisfies its own bound
    let as_iface: GcDescribable = GcOnlyDesc { text: "beta" }
    assert(gc_describe[GcDescribable](as_iface) == "beta")
    assert(gc_describe(as_iface) == "beta")

    // F-bounded constraint [T is GcComparable[T]]
    let s1 = GcScore { points: 10 }
    let s2 = GcScore { points: 25 }
    assert(gc_max_cmp(s1, s2).points == 25)
    assert(gc_max_cmp(s2, s1).points == 25)

    // Cross-parameter constraint [Out, C is GcConverter[Out]]
    assert(gc_convert_pair[String, GcIntToStr](GcIntToStr { n: 99 }) == "99")

    // Method constraint referencing enclosing class type param
    let sink = GcSink[String]{}
    assert(sink.pull(GcIntToStr { n: 7 }) == "7")

    // Stdlib interface bound (io.Writer)
    let buf = ByteBuffer.new()
    let bw = io.BufWriter.new(buf)
    assert((gc_write_str(bw, "hello") !? 0) == 5)
    bw.flush() ! panic("flush failed")
    assert(buf.to_string() == "hello")
}

test "Generic constraints: built-in bounds, classes, structs, traits, and extends" {
    assert(gc_clamp_num(15, 0, 10) == 10)
    assert(gc_clamp_num(-3, 0, 10) == 0)
    assert(gc_clamp_num(2.5, 0.0, 5.0) == 2.5)
    assert(gc_scale_int[i32, 3](14) == 42)
    assert(gc_half_float(9.0) == 4.5)

    let k1 = GcEqKey { id: 5 }
    let k2 = GcEqKey { id: 5 }
    let k3 = GcEqKey { id: 6 }
    assert(gc_same(k1, k2))
    assert(!gc_same(k1, k3))
    let map = HashMap[GcEqKey, int]{}
    gc_put_key(map, k1, 100)
    assert((map.get(k2) !? 0) == 100)

    let held = GcHolder[GcOnlyDesc] { item: GcOnlyDesc { text: "ok" } }
    assert(held.summary() == "held:ok")

    let pair = GcNumPair[int] { a: 4, b: 9 }
    assert(pair.sum() == 13)

    let host = GcTraitHost { inner: GcOnlyDesc { text: "from-trait" } }
    assert(host.inner_desc() == "from-trait")

    // Constrained extends selectively apply per instantiation
    let w_desc = GcWrap[GcOnlyDesc] { value: GcOnlyDesc { text: "wrapped" } }
    assert(w_desc.label() == "wrapped")
    let w_num = GcWrap[int] { value: 21 }
    assert(w_num.doubled() == 42)
    let w_str = GcWrap[String] { value: "plain" }
    assert(w_str.value == "plain")
}

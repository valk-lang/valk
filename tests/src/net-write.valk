use valk.net
use valk.coro
use valk.time
use valk.sync

global net_write_ticks: uint (0)
global net_write_ticking: bool (false)

fn net_write_ticker() {
    while net_write_ticking {
        net_write_ticks++
        coro.await_last()
    }
}

// Reads `expected` bytes after `delay_ms` and returns how many matched the pattern
fn net_write_slow_reader(con: net.TcpConnection, expected: uint, delay_ms: uint) uint {
    time.sleep_ms(delay_ms)
    let buf = [u8]{ 0 x 65536 }
    let total: uint = 0
    let matched: uint = 0
    while total < expected {
        let n = con.read(buf) ! break
        each 0 .. n as i {
            if buf[i] == ((total + i) % 251).to(u8) : matched++
        }
        total += n
    }
    return matched
}

fn net_write_pattern(size: uint) String {
    let out = ByteBuffer.new(size)
    each 0 .. size as i : out.write_byte((i % 251).to(u8))
    return out.to_string()
}

fn net_write_pair(port: u16) (net.TcpConnection, net.TcpConnection) {
    let listener = net.tcp_server("127.0.0.1", port) !!
    let client = net.tcp_client("127.0.0.1", port) !!
    let server = listener.accept(3000) !!
    listener.close() !!
    return (client, server)
}

fn net_write_cancel_soon(token: shared sync.CancelToken, delay_ms: uint) {
    time.sleep_ms(delay_ms)
    token.cancel()
}

test "TcpConnection: a write with room in the socket buffer does not wait" {
    let client, server = net_write_pair(9171)
    net_write_ticking = true
    let ticker = co net_write_ticker()
    coro.await_last()
    let before = net_write_ticks
    each 0 .. 100 as i : client.write("small message") !!
    #if OS != "win"
    // Linux and macOS send right away; other coroutines did not run in between
    assert(net_write_ticks == before)
    #end
    net_write_ticking = false
    await ticker
    let buf = [u8]{ 0 x 2000 }
    let total: uint = 0
    while total < 1300 : total += server.read(buf) !!
    assert(total == 1300)
    client.close() !!
    server.close() !!
}

test "TcpConnection: a write larger than the socket buffers completes once the peer reads" {
    let client, server = net_write_pair(9172)
    client.set_send_buffer(16384) !!
    server.set_receive_buffer(16384) !!
    let size: uint = 6 * 1024 * 1024
    let data = net_write_pattern(size)
    let reader = co net_write_slow_reader(server, size, 50)
    assert((client.write(data) !!) == size)
    assert(await reader == size)
    client.close() !!
    server.close() !!
}

test "TcpConnection: a write that cannot finish times out or is cancelled" {
    let client, server = net_write_pair(9173)
    client.set_send_buffer(16384) !!
    server.set_receive_buffer(16384) !!
    let data = net_write_pattern(8 * 1024 * 1024)

    client.write_timeout_ms = 50
    let start = time.mono_ms()
    let code = ""
    client.write(data) ! { code = error_is(E.code, timeout) ? "timeout" : "other" }
    assert(code == "timeout")
    assert(time.mono_ms() - start < 3000)

    client.write_timeout_ms = 10000
    let token: shared sync.CancelToken = sync.CancelToken.new() !!
    client.set_cancel(token)
    let cancel = co net_write_cancel_soon(token, 50)
    start = time.mono_ms()
    code = ""
    client.write(data) ! { code = error_is(E.code, cancelled) ? "cancelled" : "other" }
    assert(code == "cancelled")
    assert(time.mono_ms() - start < 3000)
    await cancel
    client.close() !!
    server.close() !!
}

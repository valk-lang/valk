// An if/while/each condition is followed by its body, so a `{` after the condition opens that
// body, even when an error handler sits between them. Only a type name may still take a `{`,
// which keeps a rethrow with payload fields working.

class ConditionThing {
    ok: bool (true)
}

error ConditionError (bad) payload {
    message: String
}

fn condition_rows(state: Array[uint]) bool !LookupError {
    let left = state.get(0) !>
    if left == 0 : return false
    state.set(0, left - 1) !>
    return true
}

fn condition_throws(state: Array[uint]) bool !ConditionError {
    let left = state.get(0) !? 0
    if left == 0 : throw .bad { message: "empty" }
    state.set(0, left - 1) _
    return true
}

fn condition_accepts(thing: ConditionThing) bool {
    return thing.ok
}

fn read_all_conditions(state: Array[uint]) uint !ConditionError {
    let seen: uint = 0
    while condition_throws(state) ! throw E { message: "wrapped" } {
        seen++
    }
    return seen
}

test "Conditions: a single statement handler leaves the block to the body" {
    let state = Array[uint]{ 3 }
    let seen: uint = 0
    while condition_rows(state) ! panic("unreachable") {
        seen++
    }
    assert(seen == 3)

    // `!?` gives the condition a value instead
    state.set(0, 2) _
    seen = 0
    while condition_rows(state) !? false {
        seen++
    }
    assert(seen == 2)

    // A bare `return` in the handler does not swallow the body either
    state.set(0, 1) _
    seen = 0
    while condition_rows(state) ! return {
        seen++
    }
    assert(seen == 1)
}

test "Conditions: an if takes a handler too" {
    let state = Array[uint]{ 1 }
    let taken = false
    if condition_rows(state) ! panic("unreachable") {
        taken = true
    } else {
        taken = false
    }
    assert(taken)
}

test "Conditions: a class init still works where it is unambiguous" {
    // Inside the arguments of a call the braces are a class init, not a body
    let entered = false
    if condition_accepts(ConditionThing { ok: true }) {
        entered = true
    }
    assert(entered)

    // And in parentheses
    if (ConditionThing { ok: true }).ok {
        assert(true)
    }
}

test "Conditions: a rethrow in the handler keeps its payload" {
    let state = Array[uint]{ 2 }
    let seen = read_all_conditions(state) ! {
        assert(E.message == "wrapped")
        assert(error_is(E.code, bad))
        return
    }
    assert(false)
}

test "Conditions: each and lock read their value the same way" {
    let items = Array[uint]{ 1, 2, 3 }
    let total: uint = 0
    each items as item {
        total += item
    }
    assert(total == 6)
}

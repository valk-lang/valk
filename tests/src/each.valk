
test "Each" {
    let a = Array[uint]{ 1, 2, 3, 4, 5 }

    assert(a.length == 5)
    let count = 0
    each a as nr, i {
        assert(nr == (a[i]))
        count++
    }
    assert(count == 5)

    // Skip

    assert(a.length == 5)
    count = 0
    each a skip 2 as nr, i {
        assert(nr == (a[i]))
        count++
    }
    assert(count == 3)
}

test "Each: skip starts a character iterator at the same place" {
    let text = "abcdef"
    let native = ""
    each text skip 2 as byte { native += byte.to_ascii_string() }
    assert(native == "cdef")

    let chars = ""
    each text.utf8.chars() skip 2 as ch { chars += ch }
    assert(chars == "cdef")

    let with_index = Array[String]{}
    each text.utf8.chars() skip 1 as ch, i { with_index.append(ch + i.to(String)) }
    assert(with_index.join("-") == "b1-c2-d3-e4-f5")

    // A character can be more than one byte
    let accents = "héllo"
    let rest = ""
    each accents.utf8.chars() skip 1 as ch { rest += ch }
    assert(rest == "éllo")
}

// Like `arr[start .. count]`: count numbers from start on
fn each_range_text(start: int, count: int) String {
    let text = ""
    each start .. count as i : text += i + ","
    return text
}

test "Each: a range walks count numbers from its start" {
    assert(each_range_text(0, 3) == "0,1,2,")
    assert(each_range_text(5, 3) == "5,6,7,")
    assert(each_range_text(-2, 4) == "-2,-1,0,1,")
    assert(each_range_text(4, 0) == "")
    assert(each_range_text(4, -3) == "")

    // The same indexes as a slice with the same bounds
    let values = Array[uint]{ 10, 20, 30, 40, 50 }
    let from_range: uint = 0
    each 1 .. 3 as i : from_range += values[i]
    let from_slice: uint = 0
    each values[1 .. 3] as value : from_slice += value
    assert(from_range == from_slice && from_range == 90)

    // A second name counts the numbers from 0
    let positions = ""
    each 7 .. 3 as number, position : positions += number + ":" + position + " "
    assert(positions == "7:0 8:1 9:2 ")

    // Bounds are read once, and break and continue work
    let limit = 5
    let odd = 0
    each 0 .. limit as i {
        limit = 100
        if i % 2 == 0 : continue
        if i > 3 : break
        odd += i
    }
    assert(odd == 4)
}

test "Each: a range takes the integer type of its bounds" {
    let n: uint = 3
    let total: uint = 0
    each 0 .. n as i : total += i
    assert(total == 3)

    let first: u8 = 250
    let bytes = Array[u8]{}
    each first .. 3 as b : bytes.append(b)
    assert(bytes.length == 3 && bytes[2] == 252)
}

test "each: without names the body runs once per value" {
    let n = 0
    each 0 .. 4 : n++
    assert(n == 4)
    let count: uint = 3
    each 0 .. count { n += 10 }
    assert(n == 34)
    let items = Array[int]{ 1, 2, 3 }
    each items : n += 100
    each items skip 1 { n += 1000 }
    assert(n == 2334)
    // A class init before 'as' still reads as one
    let seen = ""
    each Array[String]{ "a", "b" } as word { seen += word }
    assert(seen == "ab")
}

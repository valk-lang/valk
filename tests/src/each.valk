
test "Each" {
    let a = Array[uint]{ 1, 2, 3, 4, 5 }

    assert(a.length == 5)
    let count = 0
    each a as nr, i {
        assert(nr == (a[i]))
        count++
    }
    assert(count == 5)

    // Skip

    assert(a.length == 5)
    count = 0
    each a skip 2 as nr, i {
        assert(nr == (a[i]))
        count++
    }
    assert(count == 3)
}

test "Each: skip starts a character iterator at the same place" {
    let text = "abcdef"
    let native = ""
    each text skip 2 as byte { native += byte.to_ascii_string() }
    assert(native == "cdef")

    let chars = ""
    each text.utf8.chars() skip 2 as ch { chars += ch }
    assert(chars == "cdef")

    let with_index = Array[String]{}
    each text.utf8.chars() skip 1 as ch, i { with_index.append(ch + i.to(String)) }
    assert(with_index.join("-") == "b1-c2-d3-e4-f5")

    // A character can be more than one byte
    let accents = "héllo"
    let rest = ""
    each accents.utf8.chars() skip 1 as ch { rest += ch }
    assert(rest == "éllo")
}

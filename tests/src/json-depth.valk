use valk.json

// A recursive type whose chain runs only through the typed containers: before those
// were counted, this shape recursed straight into a segfault.
class DepthChain {
    + children: Array[DepthChain] (.{})
}

// A recursive type through a nullable field, which reaches the untyped path.
class DepthPair {
    + name: String ("")
    + next: ?DepthPair (null)
}

class DepthKnown {
    + known: int (0)
}

fn repeat_unit(unit: String, n: uint) String {
    let buf = ByteBuffer.new(n * unit.bytes + 8)
    let i: uint = 0
    while i < n {
        buf.write(unit)
        i++
    }
    return buf
}

fn deep_arrays(n: uint) String {
    return repeat_unit("[", n) + "1" + repeat_unit("]", n)
}

fn deep_objects(n: uint) String {
    return repeat_unit("{\"a\":", n) + "1" + repeat_unit("}", n)
}

fn deep_pairs(n: uint) String {
    return repeat_unit("{\"name\":\"x\",\"next\":", n) + "null" + repeat_unit("}", n)
}

// "none" when the document parsed, otherwise the variant that stopped it.
fn nest_kind(doc: String, max_depth: uint) String {
    json.decode(doc, max_depth) ! return E.code == E.too_deep ? "too_deep" : "other"
    return "none"
}

// at_index is reported as just past the container that opened too deep.
fn nest_at(doc: String, max_depth: uint) String {
    json.decode(doc, max_depth) ! return E.at_index.to(String)
    return "none"
}

fn chain_kind(doc: String, max_depth: uint) String {
    json.decode_to[DepthChain](doc, max_depth) ! return E.code == E.too_deep ? "too_deep" : "other"
    return "none"
}

fn chain_at(doc: String, max_depth: uint) String {
    json.decode_to[DepthChain](doc, max_depth) ! return E.at_index.to(String)
    return "none"
}

fn pair_kind(doc: String, max_depth: uint) String {
    json.decode_to[DepthPair](doc, max_depth) ! return E.code == E.too_deep ? "too_deep" : "other"
    return "none"
}

fn pair_at(doc: String, max_depth: uint) String {
    json.decode_to[DepthPair](doc, max_depth) ! return E.at_index.to(String)
    return "none"
}

fn value_array_kind(doc: String) String {
    json.decode_to[Array[json.Value]](doc) ! return E.code == E.too_deep ? "too_deep" : "other"
    return "none"
}

fn unknown_key_kind(doc: String) String {
    json.decode_to[DepthKnown](doc) ! return E.code == E.too_deep ? "too_deep" : "other"
    return "none"
}

fn unknown_key_at(doc: String) String {
    json.decode_to[DepthKnown](doc) ! return E.at_index.to(String)
    return "none"
}

test "Json: nesting deeper than the default limit is rejected" {
    // 128 nested containers is the contract; the 129th is refused.
    assert(nest_kind(deep_arrays(127), 128) == "none")
    assert(nest_kind(deep_arrays(128), 128) == "none")
    assert(nest_kind(deep_arrays(129), 128) == "too_deep")
    assert(nest_kind(deep_objects(128), 128) == "none")
    assert(nest_kind(deep_objects(129), 128) == "too_deep")
    // The default the new parameter carries is that same limit, so every existing
    // call site is covered without touching it.
    json.decode(deep_arrays(129)) ! assert(E.code == E.too_deep)
    json.decode(deep_objects(129)) ! assert(E.code == E.too_deep)
    json.decode(deep_arrays(128)) ! assert(false)
}

test "Json: a nesting bomb returns an error instead of killing the process" {
    // The audit repro: 200 KB of '[' used to SIGSEGV the program (one level costs about
    // 450 bytes of the 1 MiB coroutine stack every Valk program runs on, so it died near
    // depth 2400). Reaching the last assert is the proof — before the fix this binary
    // dies partway through this test instead of failing one of them.
    assert(nest_kind(repeat_unit("[", 200000), 128) == "too_deep")
    assert(nest_kind(repeat_unit("[", 2000000), 128) == "too_deep")
    assert(nest_kind(deep_arrays(200000), 128) == "too_deep")
    json.decode(repeat_unit("[", 200000)) ! assert(E.code == E.too_deep)
    // A well-formed document nobody would ever send still cannot take the process.
    assert(nest_kind(deep_arrays(2400), 128) == "too_deep")
    assert(nest_kind(deep_arrays(10000), 128) == "too_deep")
    // The process is still healthy and the next parse is unaffected.
    assert(nest_kind(deep_arrays(3), 128) == "none")
    assert(json.encode(json.decode(deep_arrays(3)) ! panic("parse")) == "[[[1]]]")
}

test "Json: max_depth is honoured below the ceiling and clamped above it" {
    assert(nest_kind("[]", 0) == "too_deep")
    assert(nest_kind("{}", 0) == "too_deep")
    assert(nest_kind("[]", 1) == "none")
    assert(nest_kind(deep_arrays(1), 1) == "none")
    assert(nest_kind(deep_arrays(2), 1) == "too_deep")
    assert(nest_kind(deep_arrays(50), 50) == "none")
    assert(nest_kind(deep_arrays(51), 50) == "too_deep")
    // 1000 is RFC 8259 section 9's interoperability floor, and this library's ceiling:
    // measured safe on every path, where the unguarded crash sits at 2200-2400 levels.
    assert(nest_kind(deep_arrays(1000), 1000) == "none")
    assert(nest_kind(deep_arrays(1001), 1000) == "too_deep")
    // Asking for more than the ceiling is clamped rather than obeyed, because obeying it
    // is a guaranteed crash.
    assert(nest_kind(deep_arrays(1000), 1000000000) == "none")
    assert(nest_kind(deep_arrays(1001), 1000000000) == "too_deep")
    assert(nest_kind(deep_arrays(1500), 1500) == "too_deep")
    assert(nest_kind(deep_arrays(1500), 1000000000) == "too_deep")
}

test "Json: byte and entry limits cover typed and untyped decoding" {
    json.decode("null", 128, 3) ! {
        assert(E.code == E.too_large)
        assert(E.message == "JSON input exceeds the maximum byte length")
    }

    let buffered = ByteBuffer.new()
    buffered.write("[1,2,3]")
    json.decode(buffered, 128, 4) ! assert(E.code == E.too_large)

    json.decode("[1,2,3]", 128, 0, 2) ! {
        assert(E.code == E.too_large)
        assert(E.message == "JSON contains more than the maximum number of entries")
    }
    json.decode("{\"a\":1,\"b\":2}", 128, 0, 1) ! assert(E.code == E.too_large)
    json.decode_to[Array[int]]("[1,2,3]", 128, 0, 2) ! assert(E.code == E.too_large)

    let bounded = json.decode("[1,2]", 128, 0, 2) ! panic("bounded JSON failed")
    let unlimited = json.decode("[1,2,3]", 128, 0, 0) ! panic("unlimited JSON failed")
    assert(bounded.array.length == 2)
    assert(unlimited.array.length == 3)
}

test "Json: the limit counts nesting levels, not containers or brackets" {
    // 5000 containers, but only two deep: counting opens instead of levels would reject
    // every ordinary document.
    let wide = "[" + repeat_unit("{\"a\":1},", 4999) + "{\"a\":1}" + "]"
    assert(nest_kind(wide, 128) == "none")
    assert(nest_kind(wide, 2) == "none")
    assert(nest_kind(wide, 1) == "too_deep")
    // Brackets inside a string are content.
    assert(nest_kind("[\"" + repeat_unit("[", 1000) + "\"]", 128) == "none")
    // Whitespace between the markers does not add levels.
    assert(nest_kind("[ [ [ 1 ] ] ]", 3) == "none")
    assert(nest_kind("[ [ [ 1 ] ] ]", 2) == "too_deep")
}

test "Json: the typed path is bounded too" {
    // Through Array[Value] the typed entry meets the untyped parser at the same limit.
    assert(value_array_kind(deep_arrays(128)) == "none")
    assert(value_array_kind(deep_arrays(129)) == "too_deep")
    // DepthChain nests two containers per level: the object and its array.
    let chain5 = "{\"children\":[{\"children\":[{\"children\":[{\"children\":[{\"children\":[{}]}]}]}]}]}"
    assert(chain_kind(chain5, 12) == "none")
    assert(chain_kind(chain5, 10) == "too_deep")
    assert(chain_kind(repeat_unit("{\"children\":[", 2000) + "{}" + repeat_unit("]}", 2000), 128) == "too_deep")
    // A nullable recursive field reaches the untyped containers, and stops at the
    // ceiling instead of at the segfault that sits past 2000 levels.
    assert(pair_kind(deep_pairs(128), 128) == "none")
    assert(pair_kind(deep_pairs(129), 128) == "too_deep")
    assert(pair_kind(deep_pairs(1000), 1000) == "none")
    assert(pair_kind(deep_pairs(1001), 1000) == "too_deep")
    // Keys the type does not know fall through to the untyped parser, bounded the same.
    assert(unknown_key_kind("{\"known\":1,\"junk\":" + deep_arrays(150) + "}") == "too_deep")
    assert(unknown_key_kind("{\"known\":1,\"junk\":" + deep_arrays(50) + "}") == "none")
}

test "Json: the refusal names the position it stopped at" {
    // Just past the container that opened one level too deep.
    assert(nest_at(deep_arrays(129), 128) == "129")
    assert(nest_at("[[[1]]]", 2) == "3")
    assert(nest_at("[[[[1]]]]", 2) == "3")
    assert(nest_at("[]", 0) == "1")
    assert(nest_at("{}", 0) == "1")
    assert(nest_at("{\"a\":{\"b\":1}}", 1) == "6")
    let chain5 = "{\"children\":[{\"children\":[{\"children\":[{\"children\":[{\"children\":[{}]}]}]}]}]}"
    assert(chain_at(chain5, 10) == "66")
    assert(pair_at(deep_pairs(129), 128) == "2433")
    assert(unknown_key_at("{\"known\":1,\"junk\":" + deep_arrays(150) + "}") == "146")
    // A distinct variant, so a caller can answer 413 where a syntax error earns a 400.
    json.decode(deep_arrays(200)) ! assert(E.code == E.too_deep && E.message == "JSON nested deeper than the maximum depth")
}

test "Json: a ByteBuffer body is bounded like a String one" {
    let bomb = ByteBuffer.new(2008)
    let fine = ByteBuffer.new(208)
    let i: uint = 0
    while i < 2000 {
        bomb.write_byte('[')
        i++
    }
    i = 0
    while i < 100 {
        fine.write_byte('[')
        i++
    }
    fine.write_byte('1')
    i = 0
    while i < 100 {
        fine.write_byte(']')
        i++
    }
    json.decode(bomb) ! assert(E.code == E.too_deep)
    let parsed = json.decode(fine) !? json.new_array()
    assert(parsed.is_array)
    // The rejected body left nothing behind for the next parse.
    json.decode(bomb) ! assert(E.code == E.too_deep)
    let again = json.decode("[1,2]") !? json.new_array()
    assert(again.is_array)
    assert(again.length == 2)
}

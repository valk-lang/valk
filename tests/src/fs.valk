
use valk.fs
use valk.io

test "fs: dir_of" {
    assert(fs.dir_of("/etc/nginx/nginx.conf") == "/etc/nginx")
    assert(fs.dir_of("/etc/nginx/") == "/etc")
    assert(fs.dir_of("/etc/nginx") == "/etc")
    assert(fs.dir_of("/etc") == "/")
    assert(fs.dir_of("/") == "/")
    assert(fs.dir_of("etc") == "etc")
    assert(fs.dir_of("") == "")
    // TODO: windows paths
}

test "fs: basename" {
    assert(fs.basename("/etc/nginx/nginx.conf") == "nginx.conf")
    assert(fs.basename("/etc/nginx/") == "nginx")
    assert(fs.basename("/") == "")
    assert(fs.basename("") == "")
    // TODO: windows paths
}

test "fs: TIFF mime extensions" {
    assert(fs.mime("tif") == "image/tiff")
    assert(fs.mime("tiff") == "image/tiff")
}

test "fs: create / delete directories & files" {

    let exe_dir = fs.exe_dir() !? ""
    let dir = exe_dir + "/valk-mkdir-test/"
    let copy_dir = exe_dir + "/valk-mkdir-test-2/"
    // Make sure files dont exist
    if fs.is_dir(dir) : fs.delete_recursive(dir) ! assert(false)
    if fs.is_dir(copy_dir) : fs.delete_recursive(copy_dir) ! assert(false)

    // Create dir
    fs.mkdir(dir, 509) _
    assert(fs.exists(dir))

    // Cwd / Chdir
    let cwd = fs.cwd() !? ""
    assert(!cwd.contains("valk-mkdir-test"))
    fs.chdir(dir) ! assert(false)
    assert((fs.cwd() !? "").contains("valk-mkdir-test"))
    fs.chdir(cwd) ! assert(false)
    assert((fs.cwd() !? "") == cwd)

    // Open & create file
    let file = dir + "test.txt"
    let fd = fs.open_extend(file, true, true, true) !? 10000
    assert(fd != 10000)
    assert(fs.exists(file))

    let failed_chdir = false
    fs.chdir(file) ! { failed_chdir = true }
    assert(failed_chdir)
    assert((fs.cwd() !? "") == cwd)

    // Files in dir
    let files = fs.files_in(dir) !? .{}
    assert(files.length == 1)
    let fn = files.get(0) !? ""
    let base = fs.basename(fn)
    assert(base == "test.txt")

    let failed_files_in = false
    fs.files_in(file) ! { failed_files_in = true }
    assert(failed_files_in)

    // Write to FD
    if fd != 10000 {
        io.write_string(fd, "hello") ! {
            assert(false)
            return
        }
        io.write_string(fd, "-world") ! {
            assert(false)
            return
        }
        io.close(fd) ! assert(false)

        let content = fs.read(file) !? "-failed to read file-"
        assert(content == "hello-world")
    }

    // Move file
    let file2 = file + ".tmp"
    fs.move(file, file2) ! assert(false)
    assert(!fs.exists(file))
    assert(fs.exists(file2))
    file = file2

    // Copy files
    fs.copy(dir, copy_dir, false) _
    files = fs.files_in(copy_dir, true) !? .{}
    assert(files.length == 1)
    // Add extra files to copy
    let subdir = fs.add(dir, "sub-dir")
    fs.mkdir(subdir) _
    let subfile = fs.add(subdir, "tmp.txt")
    fs.write(subfile, "hello") ! assert(false)
    // Copy again
    fs.copy(dir, copy_dir, true) ! assert(false)
    // Check file count
    files = fs.files_in(copy_dir, true) !? .{}
    assert(files.length == 3)

    // Delete file
    if fs.exists(file) : fs.delete(file) ! assert(false)
    assert(fs.exists(file) == false)

    // Delete recursive
    fs.delete_recursive(dir) ! assert(false)
    assert(fs.exists(dir) == false)

    fs.delete_recursive(copy_dir) ! assert(false)
    assert(fs.exists(copy_dir) == false)
}

#if OS != "win"
test "fs: recursive operations do not follow directory symlinks" {
    let exe_dir = fs.exe_dir() !? ""
    let dir = fs.add(exe_dir, "valk-symlink-tree-test")
    let outside = fs.add(exe_dir, "valk-symlink-outside-test")
    let copy_dir = fs.add(exe_dir, "valk-symlink-copy-test")

    if fs.exists(dir) : fs.delete_recursive(dir) ! assert(false)
    if fs.exists(outside) : fs.delete_recursive(outside) ! assert(false)
    if fs.exists(copy_dir) : fs.delete_recursive(copy_dir) ! assert(false)

    fs.mkdir(dir) ! assert(false)
    fs.mkdir(outside) ! assert(false)
    let outside_file = fs.add(outside, "keep.txt")
    fs.write(outside_file, "keep") ! assert(false)
    let link = fs.add(dir, "outside-link")
    fs.symlink(link, outside, true) ! assert(false)
    let broken_link = fs.add(dir, "broken-link")
    fs.symlink(broken_link, fs.add(outside, "missing.txt"), false) ! assert(false)

    assert(!fs.is_symlink(dir))
    assert(!fs.is_symlink(outside_file))
    assert(fs.is_symlink(link))
    assert(fs.is_symlink(broken_link))
    assert(!fs.exists(broken_link))

    let listed = fs.files_in(dir, true) !? .{}
    assert(listed.length == 2)

    let copy_failed = false
    fs.copy(dir, copy_dir, true) ! { copy_failed = true }
    assert(copy_failed)
    assert(!fs.exists(fs.add(copy_dir, "outside-link")))

    fs.delete_recursive(dir) ! assert(false)
    assert(!fs.exists(dir))
    assert(fs.is_file(outside_file))
    assert((fs.read(outside_file) !? "") == "keep")

    if fs.exists(copy_dir) : fs.delete_recursive(copy_dir) ! assert(false)
    fs.delete_recursive(outside) ! assert(false)
}
#end

test "fs: large files" {
    let data = fs.read(fs.add(__DIR__, "/../assets/large.png")) ! {
        assert(false)
        return
    }
    assert(data.length == 263270)
}

test "fs: size distinguishes empty files from errors" {
    let path = fs.add(fs.exe_dir() !? "", "valk-size-test.txt")
    fs.write(path, "") ! {
        assert(false)
        return
    }

    assert((fs.size(path) !? 1) == 0)
    fs.delete(path) ! assert(false)

    let failed = false
    fs.size(path) ! { failed = true }
    assert(failed)
}

test "fs: stream reads return byte counts" {
    let path = fs.add(fs.exe_dir() !? "", "valk-stream-read-count-test.txt")
    fs.write(path, "abcdef") ! {
        assert(false)
        return
    }

    let stream = fs.stream(path, true, false) ! {
        fs.delete(path) _
        assert(false)
        return
    }
    let buffer = ByteBuffer.new()

    assert((stream.read(4, buffer) !? 99) == 4)
    assert((stream.read(4, buffer) !? 99) == 2)
    assert((stream.read(4, buffer) !? 99) == 0)
    assert((stream.read(4, buffer) !? 99) == 0)
    assert(buffer.to_string() == "abcdef")

    fs.delete(path) ! assert(false)
}

test "fs: streams reject invalid writes" {
    let path = fs.add(fs.exe_dir() !? "", "valk-stream-permissions-test.txt")
    fs.write(path, "original") ! {
        assert(false)
        return
    }

    let read_only = fs.stream(path, true, false) ! {
        assert(false)
        return
    }
    let failed = false
    read_only.write("changed") ! { failed = true }
    assert(failed)
    read_only.close() ! assert(false)

    let writable = fs.stream(path, false, true) ! {
        assert(false)
        return
    }
    writable.close() ! assert(false)
    failed = false
    writable.write("changed") ! { failed = true }
    assert(failed)

    fs.delete(path) ! assert(false)
}

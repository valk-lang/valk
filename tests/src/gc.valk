use valk.gc

global node_count: uint

global inline_global_node_count: uint

class PanicAllowedFinalizer {
    should_panic: bool

    fn gc_free() {
        if this.should_panic : panic("panic is permitted from gc_free")
    }
}

class InlineGlobalNode {
    value: uint

    fn gc_free() {
        inline_global_node_count--
    }
}

struct InlineGlobalHolder {
    first: ?InlineGlobalNode
    second: ?InlineGlobalNode
}

global inline_global_holder: InlineGlobalHolder

fn inline_global_node(value: uint) InlineGlobalNode {
    inline_global_node_count++
    return InlineGlobalNode { value: value }
}

fn inline_global_fill(a: uint, b: uint) {
    inline_global_holder.first = inline_global_node(a)
    inline_global_holder.second = inline_global_node(b)
}

fn inline_global_orphan(value: uint) uint {
    // The node never escapes this frame as a managed value, so once the call returns nothing
    // roots it: this is the one object the collects below are required to take.
    let node = inline_global_node(value)
    return node.value
}

fn inline_global_values() String {
    let first = inline_global_holder.first
    let second = inline_global_holder.second
    if !isset(first) || !isset(second) : return "gone"
    return first.value.to_string() + "," + second.value.to_string()
}

@ignore_access

test "GC: zero-sized bump grows" {
    let initial_size, grown_size, index, second_at_expected = gc.bump_zero_growth_for_test()
    assert(initial_size == 32)
    assert(grown_size == 64)
    assert(index == 33)
    assert(second_at_expected)
}

class Node {
    left : ?Node
    right : ?Node

    static fn tree(x: int) Node {
        node_count++
        if x == 0 {
            let res = Node {}
            return res
        }
        let res = Node {
            left: Node.tree(x - 1)
            right: Node.tree(x - 1)
        }
        return res
    }

    fn check() uint {
        let res : uint = 1
        let lt = this.left
        let rt = this.right
        if isset(lt) && isset(rt) {
            res += lt.check()
            res += rt.check()
        }
        return res
    }

    fn gc_free() {
        node_count--
    }
}

fn stretch(depth: int) uint {
    let check = Node.tree(depth).check()
    return check
}

synctest "GC: Inline globals root every managed field" {
    inline_global_fill(73, 74)
    assert(inline_global_orphan(55) == 55)
    let base = inline_global_node_count
    gc.collect()
    gc.collect()
    gc.collect()
    assert(inline_global_node_count == base - 1)
    assert(inline_global_values() == "73,74")
}

fn verify_fixed_array_roots() $noinline {
    let nodes: [Node x 2] = {Node.tree(0), Node.tree(0)}
    gc.collect()
    assert(node_count == 2)
    assert(nodes[0].check() == 1)
    assert(nodes[1].check() == 1)
}

synctest "GC: Fixed arrays root every element" {
    gc.collect()
    assert(node_count == 0)
    verify_fixed_array_roots()
    gc.collect()
    assert(node_count == 0)
}

fn check_temporary_roots(first: Node, second: Node) uint {
    // Both freshly allocated caller arguments must survive this collection.
    gc.collect()
    return first.check() + second.check()
}

// Roots are found on the native stack, so a frame that held an object may
// keep it alive until the frame is gone: the counts below are checked from a
// caller that never touched the objects.
fn temporary_root_pair() bool $noinline {
    let first = check_temporary_roots(Node.tree(1), Node.tree(1))
    let second = check_temporary_roots(Node.tree(1), Node.tree(1))
    return first == 6 && second == 6
}

fn temporary_root_once() uint $noinline {
    return check_temporary_roots(Node.tree(1), Node.tree(1))
}

fn verify_temporary_root_pool() {
    assert(temporary_root_pair())
    gc.collect()
    assert(node_count == 0)

    let i = 0
    while i++ < 2 {
        assert(temporary_root_once() == 6)
        gc.collect()
        assert(node_count == 0)
    }
}

synctest "GC: Temporary roots share stack slots across statements" {
    gc.collect()
    assert(node_count == 0)

    verify_temporary_root_pool()

    gc.collect()
    assert(node_count == 0)
}

fn verify_gc_leaks() $noinline {









    let depth = 12

    assert(stretch(depth + 1) == 16383)

    gc.collect()
    assert(node_count == 0)

    let longlived = Node.tree(depth)

    assert(node_count == 8191)
    gc.collect()
    assert(node_count == 8191)

    let x = 4
    while x <= depth {
        let mul = (depth - x + 4)
        let iters = 1
        while mul-- > 0 {
            iters = iters * 2
        }
        let check : uint = 0

        let i = 0
        while i++ < iters {
            check += Node.tree(x).check()
        }
        if x == 4 : assert(check == 126976)
        if x == 6 : assert(check == 130048)
        if x == 8 : assert(check == 130816)
        if x == 10 : assert(check == 131008)
        if x == 12 : assert(check == 131056)
        x += 2
    }

    assert(longlived.check() == 8191)
    longlived = null.@cast(Node)
}

synctest "GC: Leaks" {
    verify_gc_leaks()

    // Temporary root slots are cleared with the function's stack frame.
    gc.collect()
    assert(node_count == 0)
}

fn stack_root_cut_retained() Node $noinline {
    let owner = Node.tree(2)
    gc.collect()
    assert(node_count == 7)

    let retained = owner.left
    if !isset(retained) : panic("missing retained subtree")
    return retained
}

fn verify_stack_root_cut() $noinline {
    assert(node_count == 0)

    let retained = stack_root_cut_retained()
    gc.collect()

    assert(node_count == 3)
    assert(retained.check() == 3)
}

synctest "GC: Stack root cuts ownership teardown" {
    verify_stack_root_cut()
    gc.collect()
    assert(node_count == 0)
}

global cycle_g : ?CycleNode (null)

class CycleNode {
    parent: ?CycleNode
    sub: ?CycleNode
}

fn cycle_check(all: Array[CycleNode], depth: uint, run: bool) ?CycleNode {
    if run && depth % 7 == 0 {
        gc.collect()
    }
    if depth == 0 {
        return null
    }
    let parent : ?CycleNode = null
    if depth % 3 == 0 {
        parent = all.pop_first() !? null
    } else if depth % 5 == 0 {
        parent = all.pop_last() !? null
    } else if depth % 4 == 0 {
        parent = cycle_g
    }
    let n = CycleNode { parent: parent }
    all.append(n)
    if depth % 7 == 0 {
        cycle_g = n
    }
    let sub = cycle_check(all, depth - 1, run)
    n.sub = sub
    return n
}

synctest "GC: Cycle reference check" {

    let all = Array[CycleNode].new(2)
    gc.collect()
    gc.collect()
    let start = gc.gc.mem_marked
    cycle_check(all, 125, false)
    all.clear(true)
    cycle_g = null
    gc.collect()
    gc.collect()
    assert(start == gc.gc.mem_marked)

    // Gc runs in between
    cycle_check(all, 175, true)
    all.clear(true)
    cycle_g = null
    gc.collect()
    gc.collect()
    assert(start == gc.gc.mem_marked)
}

global lifecycle_count: uint

class GCLifecycle {
    child: ?GCLifecycle
    value: uint

    fn gc_free() {
        lifecycle_count--
    }
}

fn lifecycle_new(value: uint) GCLifecycle {
    lifecycle_count++
    return GCLifecycle { value: value }
}

fn lifecycle_nested(value: uint) GCLifecycle {
    return lifecycle_new(value)
}

fn lifecycle_closure_scope() $noinline {
    let captured = lifecycle_new(42)
    let closure = fn() uint {
        return captured.value
    }
    gc.collect()
    assert(lifecycle_count == 1)
    assert(closure() == 42)
}

fn lifecycle_block_scope() $noinline {
    {
        let scoped = lifecycle_new(43)
        assert(scoped.value == 43)
    }
}

synctest "GC: Local collection does not require shared collection" {
    let mark = gc.mark_count
    lifecycle_block_scope()
    gc.collect()
    assert(lifecycle_count == 0)
    assert(gc.mark_count == mark)
}

fn lifecycle_break_scope() $noinline {
    while true {
        let scoped = lifecycle_new(44)
        assert(scoped.value == 44)
        break
    }
}

fn lifecycle_continue_scope() $noinline {
    let iterations = 0
    while iterations++ < 1 {
        let scoped = lifecycle_new(45)
        assert(scoped.value == 45)
        continue
    }
}

fn lifecycle_value_scope() uint $noinline {
    let result = <{
        let scoped = lifecycle_new(46)
        return scoped.value
    }
    return result
}

fn lifecycle_lexical_scopes() {
    lifecycle_block_scope()
    gc.collect()
    assert(lifecycle_count == 0)

    lifecycle_break_scope()
    gc.collect()
    assert(lifecycle_count == 0)

    lifecycle_continue_scope()
    gc.collect()
    assert(lifecycle_count == 0)

    assert(lifecycle_value_scope() == 46)
    gc.collect()
    assert(lifecycle_count == 0)
}

fn lifecycle_nullable_scope() $noinline {
    let nullable: ?GCLifecycle = lifecycle_nested(1)
    gc.collect()
    assert(lifecycle_count == 1)
    assert(isset(nullable))
    if isset(nullable) : assert(nullable.value == 1)
    nullable = null
}

fn lifecycle_attach_child(parent: GCLifecycle) $noinline {
    parent.child = lifecycle_new(3)
}

fn lifecycle_parent_scope() $noinline {
    let parent = lifecycle_new(2)
    lifecycle_attach_child(parent)
    gc.collect()
    assert(lifecycle_count == 2)
    parent.child = null
    gc.collect()
    assert(lifecycle_count == 1)
}

synctest "GC: Managed lifecycle" {
    gc.collect()
    assert(lifecycle_count == 0)

    lifecycle_nullable_scope()
    gc.collect()
    assert(lifecycle_count == 0)

    lifecycle_parent_scope()
    gc.collect()
    assert(lifecycle_count == 0)

    lifecycle_closure_scope()
    gc.collect()
    assert(lifecycle_count == 0)

    lifecycle_lexical_scopes()
}

fn array_unique_moved() $noinline {
    let first: ?GCLifecycle = lifecycle_new(10)
    let second: ?GCLifecycle = lifecycle_new(20)
    let values = Array[?GCLifecycle]{ first, first, second }
    values.remove_duplicates()
    first = null
    second = null

    gc.collect()
    assert(values.length == 2)
    let moved_first: ?GCLifecycle = values.get(0) !!
    let moved_second: ?GCLifecycle = values.get(1) !!
    assert(isset(moved_first) && moved_first.value == 10)
    assert(isset(moved_second) && moved_second.value == 20)
    assert(lifecycle_count == 2)

    moved_first = null
    moved_second = null
    values.clear()
}

synctest "GC: Array unique preserves moved property metadata" {
    gc.collect()
    assert(lifecycle_count == 0)

    array_unique_moved()
    gc.collect()
    assert(lifecycle_count == 0)
}

fn raw_class_value_scope() $noinline {
    let managed = lifecycle_new(8)
    let raw = managed.@cast(*GCLifecycle)
    assert(isset(raw))
    managed = null.@cast(GCLifecycle)
}

synctest "GC: Raw class values do not outlive their frame" {
    raw_class_value_scope()
    gc.collect()
    assert(lifecycle_count == 0)
}

global native_root_count: uint

class NativeRoot {
    value: uint
    // Keeps the object larger than one word, so an interior address exists
    padding: uint (0)

    fn gc_free() {
        native_root_count--
    }
}

fn native_root_new(value: uint) NativeRoot {
    native_root_count++
    return NativeRoot { value: value }
}

// Only an address inside the object is held while collecting
fn native_root_interior_pointer() uint $noinline {
    let raw: ptr = native_root_new(9).@cast(ptr) + size_of(ptr)
    gc.collect()
    assert(native_root_count == 1)
    let object = (raw - size_of(ptr)).@cast(NativeRoot)
    return object.value
}

// Collects while native_root_suspended is parked on its own stack
fn native_root_probe() {
    gc.collect()
    assert(native_root_count == 1)
}

fn native_root_suspended(value: uint) uint {
    let held = native_root_new(value)
    await co native_root_probe()
    return held.value
}

// The argument is dead after its field was read, but it stays rooted for
// the whole call
fn native_root_argument(object: NativeRoot) uint $noinline {
    let value = object.value
    gc.collect()
    assert(native_root_count == 1)
    return value
}

synctest "GC: Native stack roots keep objects alive" {
    gc.collect()
    assert(native_root_count == 0)

    assert(native_root_interior_pointer() == 9)
    gc.collect()
    assert(native_root_count == 0)

    assert((await co native_root_suspended(5)) == 5)
    gc.collect()
    assert(native_root_count == 0)

    assert(native_root_argument(native_root_new(3)) == 3)
    gc.collect()
    assert(native_root_count == 0)
}

union GCStorePayload : String | uint {}

class GCStoreTarget {
    name: ?String (null)
    handler: ?fn()() (null)
    payload: ?GCStorePayload (null)
}

global store_target_calls: uint (0)
global store_target: ?GCStoreTarget (null)



fn store_target_once() GCStoreTarget {
    store_target_calls++
    let existing = store_target
    if isset(existing) : return existing
    let fresh = GCStoreTarget {}
    store_target = fresh
    return fresh
}

synctest "GC: Managed property stores evaluate their object once" {
    store_target = null
    store_target_calls = 0

    store_target_once().name = "stored"
    assert(store_target_calls == 1)

    store_target_once().handler = fn() {}
    assert(store_target_calls == 2)

    store_target_once().payload = "boxed"
    assert(store_target_calls == 3)

    let target = store_target ?? GCStoreTarget {}
    assert((target.name ?? "") == "stored")
    assert(isset(target.handler))
    match target.payload {
        String as text => assert(text == "boxed")
        default => assert(false)
    }

    store_target = null
    gc.collect()
}

// Hook-style initializers call `$set_key` / `$append` on a fresh allocation.
// A collection inside a hook must not reclaim that receiver mid-chain.
class CollectingMap {
    keys: Array[String] (.{})
    values: Array[String] (.{})

    + fn set(key: String, value: String) SELF $set_key {
        gc.collect()
        this.keys.append(key)
        this.values.append(value)
        return this
    }
}

class CollectingList {
    items: Array[String] (.{})

    + fn append(item: String) $append {
        gc.collect()
        this.items.append(item)
    }
}

global collecting_map: ?CollectingMap
global collecting_list: ?CollectingList

fn collecting_map_size() uint {
    let map = collecting_map ?? <{
        let map = CollectingMap{ "a" => "1", "b" => "2", "c" => "3" }
        collecting_map = map
        return map
    }
    return map.keys.length
}

fn collecting_list_size() uint {
    let list = collecting_list ?? <{
        let list = CollectingList{ "a", "b", "c" }
        collecting_list = list
        return list
    }
    return list.items.length
}

fn collecting_churn() {
    let i = 0
    while i++ < 20 {
        let m = CollectingMap{}
        let l = CollectingList{}
        let j = 0
        while j++ < 8 {
            m.keys.append("k" + j)
            l.items.append("v" + j)
        }
    }
    gc.collect()
}

test "GC: hook initializers keep their receiver rooted" {
    assert(collecting_map_size() == 3)
    collecting_churn()
    assert(collecting_map_size() == 3)
    let map = collecting_map
    assert(isset(map) && map.keys.length == 3 && map.values.length == 3)

    assert(collecting_list_size() == 3)
    collecting_churn()
    assert(collecting_list_size() == 3)
    let list = collecting_list
    assert(isset(list) && list.items.length == 3)

    let embedded = #embed_dir("assets/embed")
    assert(embedded.length == 2)
}

interface GcNamed { get name: String; }
class GcNamedUser is GcNamed {
    n: String
    get name: String { return this.n }
}
struct GcNamedHolder { who: GcNamed; n: int }
global gc_iface_global: ?GcNamed
global gc_iface_struct_global: ?GcNamedHolder
global gc_iface_fixed_global: ?[GcNamed x 2]

fn gc_iface_make(s: String) GcNamed { return GcNamedUser { n: s + "!" } }
fn gc_iface_fill() $noinline {
    gc_iface_global = gc_iface_make("user")
    gc_iface_struct_global = GcNamedHolder { who: gc_iface_make("held"), n: 1 }
    gc_iface_fixed_global = .{ gc_iface_make("a0"), gc_iface_make("a1") }
    let junk = Array[String]{}
    let i = 0
    while i++ < 5000 : junk.append("x" + i)
}

synctest "GC: Interface globals root their objects" {
    gc_iface_fill()
    gc.collect()
    gc.collect()
    gc_iface_fill()
    let k = gc_iface_global
    assert(isset(k) && k.name == "user!")
    let h = gc_iface_struct_global
    assert(isset(h) && h.who.name == "held!")
    let f = gc_iface_fixed_global
    assert(isset(f) && f[0].name == "a0!" && f[1].name == "a1!")
}

global growth_count: uint

class GrowthItem {
    value: uint

    fn gc_free() {
        growth_count--
    }
}

fn growth_item(value: uint) GrowthItem {
    growth_count++
    return GrowthItem { value: value }
}

// A collection tags the storage slots, so the growth afterwards moves the
// ownership of the elements into storage that nothing owns yet
fn growth_dropped_after_growing() $noinline {
    let items = Array[GrowthItem].new(2)
    items.append(growth_item(0))
    items.append(growth_item(1))
    gc.collect()
    let i: uint = 2
    while i < 20 : items.append(growth_item(i++))
    assert(items.length == 20)
    assert(growth_count == 20)
}

synctest "GC: Elements of an array dropped right after growing are freed" {
    growth_dropped_after_growing()
    gc.collect()
    assert(growth_count == 0)
}

fn growth_view_over_old_storage() mut &[GrowthItem] $noinline {
    let items = Array[GrowthItem].new(2)
    items.append(growth_item(10))
    items.append(growth_item(11))
    gc.collect()
    let view = items.view()
    let i: uint = 2
    while i < 20 : items.append(growth_item(i++))
    assert(growth_count == 20)
    return view
}

synctest "GC: A view over the storage of a grown array keeps its elements" {
    let view = growth_view_over_old_storage()
    gc.collect()
    gc.collect()
    assert(view.length == 2)
    assert((view[0]).value == 10)
    assert((view[1]).value == 11)
    assert(growth_count == 2)
}

synctest "GC: Growth leaks nothing" {
    gc.collect()
    assert(growth_count == 0)
}

// The collector reads a union member's references only while that member is
// active: objects and array elements holding unions
union GCWalkInner : String | uint {}

class GCWalkHolder {
    first: GCWalkInner
    pad: uint (0)
    second: ?GCWalkInner (null)
}

fn gc_walk_union_holders(count: uint) Array[GCWalkHolder] $noinline {
    let holders = Array[GCWalkHolder]{}
    let i: uint = 0
    while i < count {
        let holder = GCWalkHolder { first: "first-" + i }
        if i % 2 == 0 : holder.second = "second-" + i
        else : holder.second = i
        holders.append(holder)
        i++
    }
    return holders
}

fn gc_walk_union_elements(count: uint) Array[GCWalkInner] $noinline {
    let elements = Array[GCWalkInner]{}
    let i: uint = 0
    while i < count {
        if i % 3 == 0 : elements.append(i)
        else : elements.append("element-" + i)
        i++
    }
    return elements
}

synctest "GC: Union members in objects and array elements are walked" {
    let holders = gc_walk_union_holders(300)
    let elements = gc_walk_union_elements(300)
    gc.collect()
    gc.collect()
    let failure = ""
    each holders as holder, i {
        match holder.first {
            String as text => if failure == "" && text != "first-" + i : failure = "holder #%i first is %text"
            default => if failure == "" : failure = "holder #%i first is not a String"
        }
        let second = holder.second ?? 0
        match second {
            String as text => if failure == "" && (i % 2 != 0 || text != "second-" + i) : failure = "holder #%i second is %text"
            uint as v => if failure == "" && (i % 2 != 1 || v != i) : failure = "holder #%i second is %v"
        }
    }
    each elements as element, i {
        match element {
            String as text => if failure == "" && (i % 3 == 0 || text != "element-" + i) : failure = "element #%i is %text"
            uint as v => if failure == "" && (i % 3 != 0 || v != i) : failure = "element #%i is %v"
        }
    }
    if failure != "" : println(failure)
    assert(failure == "")
    holders.clear()
    elements.clear()
    gc.collect()
}

test "gc.alloc of size 0 returns a valid allocation" {
    @unsafe
    let a = gc.alloc(0).@cast(?ptr)
    let b = gc.alloc(0).@cast(?ptr)
    let t = gc.alloc_typed(0, null).@cast(?ptr)
    assert(isset(a))
    assert(isset(b))
    assert(isset(t))
    assert(a != b)
}

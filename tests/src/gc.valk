@unsafe

use valk.gc

global node_count: uint

global inline_global_node_count: uint

class PanicAllowedFinalizer {
    should_panic: bool

    fn gc_free() {
        if this.should_panic : panic("panic is permitted from gc_free")
    }
}

class InlineGlobalNode {
    value: uint

    fn gc_free() {
        inline_global_node_count--
    }
}

struct InlineGlobalHolder {
    first: ?InlineGlobalNode
    second: ?InlineGlobalNode
}

global inline_global_holder: InlineGlobalHolder

fn inline_global_node(value: uint) InlineGlobalNode {
    inline_global_node_count++
    return InlineGlobalNode { value: value }
}

fn inline_global_fill(a: uint, b: uint) {
    inline_global_holder.first = inline_global_node(a)
    inline_global_holder.second = inline_global_node(b)
}

fn inline_global_orphan(value: uint) uint {
    // The node never escapes this frame as a managed value, so once the call returns nothing
    // roots it: this is the one object the collects below are required to take.
    let node = inline_global_node(value)
    return node.value
}

fn inline_global_values() String {
    let first = inline_global_holder.first
    let second = inline_global_holder.second
    if !isset(first) || !isset(second) : return "gone"
    return first.value.to_string() + "," + second.value.to_string()
}

@ignore_access

test "GC: zero-sized bump grows" {
    let initial_size, grown_size, index, second_at_expected = gc.bump_zero_growth_for_test()
    assert(initial_size == 32)
    assert(grown_size == 64)
    assert(index == 33)
    assert(second_at_expected)
}

class Node {
    left : ?Node
    right : ?Node

    static fn tree(x: int) Node {
        node_count++
        if x == 0 {
            let res = Node {}
            return res
        }
        let res = Node {
            left: Node.tree(x - 1)
            right: Node.tree(x - 1)
        }
        return res
    }

    fn check() uint {
        let res : uint = 1
        let lt = this.left
        let rt = this.right
        if isset(lt) && isset(rt) {
            res += lt.check()
            res += rt.check()
        }
        return res
    }

    fn gc_free() {
        node_count--
    }
}

fn stretch(depth: int) uint {
    let check = Node.tree(depth).check()
    return check
}

synctest "GC: Inline globals root every managed field" {
    inline_global_fill(73, 74)
    assert(inline_global_orphan(55) == 55)
    let base = inline_global_node_count
    gc.collect()
    gc.collect()
    gc.collect()
    assert(inline_global_node_count == base - 1)
    assert(inline_global_values() == "73,74")
}

fn verify_fixed_array_roots() {
    let nodes: [Node x 2] = {Node.tree(0), Node.tree(0)}
    gc.collect()
    assert(node_count == 2)
    assert(nodes[0].check() == 1)
    assert(nodes[1].check() == 1)
}

synctest "GC: Fixed arrays root every element" {
    gc.collect()
    assert(node_count == 0)
    verify_fixed_array_roots()
    gc.collect()
    assert(node_count == 0)
}

fn check_temporary_roots(first: Node, second: Node) uint {
    // Both freshly allocated caller arguments must survive this collection.
    gc.collect()
    return first.check() + second.check()
}

fn verify_temporary_root_pool() {
    let first = check_temporary_roots(Node.tree(1), Node.tree(1))
    let second = check_temporary_roots(Node.tree(1), Node.tree(1))
    assert(first == 6 && second == 6)



    gc.collect()
    assert(node_count == 0)



    let i = 0
    while i++ < 2 {
        let check = check_temporary_roots(Node.tree(1), Node.tree(1))
        assert(check == 6)
        gc.collect()
        assert(node_count == 0)
    }
}

synctest "GC: Temporary roots share stack slots across statements" {
    gc.collect()
    assert(node_count == 0)

    verify_temporary_root_pool()

    gc.collect()
    assert(node_count == 0)
}

fn verify_gc_leaks() {









    let depth = 12

    assert(stretch(depth + 1) == 16383)

    gc.collect()
    assert(node_count == 0)

    let longlived = Node.tree(depth)

    assert(node_count == 8191)
    gc.collect()
    assert(node_count == 8191)

    let x = 4
    while x <= depth {
        let mul = (depth - x + 4)
        let iters = 1
        while mul-- > 0 {
            iters = iters * 2
        }
        let check : uint = 0

        let i = 0
        while i++ < iters {
            check += Node.tree(x).check()
        }
        if x == 4 : assert(check == 126976)
        if x == 6 : assert(check == 130048)
        if x == 8 : assert(check == 130816)
        if x == 10 : assert(check == 131008)
        if x == 12 : assert(check == 131056)
        x += 2
    }

    assert(longlived.check() == 8191)
    longlived = null.@cast(Node)
}

synctest "GC: Leaks" {
    verify_gc_leaks()

    // Temporary root slots are cleared with the function's stack frame.
    gc.collect()
    assert(node_count == 0)
}

fn verify_stack_root_cut() {
    assert(node_count == 0)

    let owner = Node.tree(2)
    gc.collect()
    assert(node_count == 7)

    let retained = owner.left
    if !isset(retained) : panic("missing retained subtree")
    owner = null.@cast(Node)
    gc.collect()

    assert(node_count == 3)
    assert(retained.check() == 3)
}

synctest "GC: Stack root cuts ownership teardown" {
    verify_stack_root_cut()
    gc.collect()
    assert(node_count == 0)
}

global cycle_g : ?CycleNode (null)

class CycleNode {
    parent: ?CycleNode
    sub: ?CycleNode
}

fn cycle_check(all: Array[CycleNode], depth: uint, run: bool) ?CycleNode {
    if run && depth % 7 == 0 {
        gc.collect()
    }
    if depth == 0 {
        return null
    }
    let parent : ?CycleNode = null
    if depth % 3 == 0 {
        parent = all.pop_first() !? null
    } else if depth % 5 == 0 {
        parent = all.pop_last() !? null
    } else if depth % 4 == 0 {
        parent = cycle_g
    }
    let n = CycleNode { parent: parent }
    all.append(n)
    if depth % 7 == 0 {
        cycle_g = n
    }
    let sub = cycle_check(all, depth - 1, run)
    n.sub = sub
    return n
}

synctest "GC: Cycle reference check" {

    let all = Array[CycleNode].new(2)
    gc.collect()
    gc.collect()
    let start = gc.gc.mem_marked
    cycle_check(all, 125, false)
    all.clear(true)
    cycle_g = null
    gc.collect()
    gc.collect()
    assert(start == gc.gc.mem_marked)

    // Gc runs in between
    cycle_check(all, 175, true)
    all.clear(true)
    cycle_g = null
    gc.collect()
    gc.collect()
    assert(start == gc.gc.mem_marked)
}

global lifecycle_count: uint

class GCLifecycle {
    child: ?GCLifecycle
    value: uint

    fn gc_free() {
        lifecycle_count--
    }
}

fn lifecycle_new(value: uint) GCLifecycle {
    lifecycle_count++
    return GCLifecycle { value: value }
}

fn lifecycle_nested(value: uint) GCLifecycle {
    return lifecycle_new(value)
}

fn lifecycle_closure_scope() {
    let captured = lifecycle_new(42)
    let closure = fn() uint {
        return captured.value
    }
    gc.collect()
    assert(lifecycle_count == 1)
    assert(closure() == 42)
}

fn lifecycle_lexical_scopes() {
    {
        let scoped = lifecycle_new(43)
        assert(scoped.value == 43)
    }
    gc.collect()
    assert(lifecycle_count == 0)

    while true {
        let scoped = lifecycle_new(44)
        assert(scoped.value == 44)
        break
    }
    gc.collect()
    assert(lifecycle_count == 0)

    let iterations = 0
    while iterations++ < 1 {
        let scoped = lifecycle_new(45)
        assert(scoped.value == 45)
        continue
    }
    gc.collect()
    assert(lifecycle_count == 0)

    let result = <{
        let scoped = lifecycle_new(46)
        return scoped.value
    }
    assert(result == 46)
    gc.collect()
    assert(lifecycle_count == 0)
}

synctest "GC: Managed lifecycle" {
    gc.collect()
    assert(lifecycle_count == 0)

    let nullable: ?GCLifecycle = lifecycle_nested(1)
    gc.collect()
    assert(lifecycle_count == 1)
    nullable = null
    gc.collect()
    assert(lifecycle_count == 0)

    let parent = lifecycle_new(2)
    parent.child = lifecycle_new(3)
    gc.collect()
    assert(lifecycle_count == 2)
    parent.child = null
    gc.collect()
    assert(lifecycle_count == 1)
    parent = null.@cast(GCLifecycle)
    gc.collect()
    assert(lifecycle_count == 0)

    lifecycle_closure_scope()
    gc.collect()
    assert(lifecycle_count == 0)

    lifecycle_lexical_scopes()
}

synctest "GC: Array unique preserves moved property metadata" {
    gc.collect()
    assert(lifecycle_count == 0)

    let first: ?GCLifecycle = lifecycle_new(10)
    let second: ?GCLifecycle = lifecycle_new(20)
    let values = Array[?GCLifecycle]{ first, first, second }
    values.unique()
    first = null
    second = null

    gc.collect()
    assert(values.length == 2)
    let moved_first: ?GCLifecycle = values.get(0) !!
    let moved_second: ?GCLifecycle = values.get(1) !!
    assert(isset(moved_first) && moved_first.value == 10)
    assert(isset(moved_second) && moved_second.value == 20)
    assert(lifecycle_count == 2)

    moved_first = null
    moved_second = null
    values.clear()
    gc.collect()
    assert(lifecycle_count == 0)
}

synctest "GC: Raw class values are not roots" {
    let managed = lifecycle_new(8)
    let raw = managed.@cast(*GCLifecycle)
    assert(isset(raw))
    managed = null.@cast(GCLifecycle)
    gc.collect()
    assert(lifecycle_count == 0)
}

union GCStorePayload : String | uint {}

class GCStoreTarget {
    name: ?String (null)
    handler: ?fn()() (null)
    payload: ?GCStorePayload (null)
}

global store_target_calls: uint (0)
global store_target: ?GCStoreTarget (null)



fn store_target_once() GCStoreTarget {
    store_target_calls++
    let existing = store_target
    if isset(existing) : return existing
    let fresh = GCStoreTarget {}
    store_target = fresh
    return fresh
}

synctest "GC: Managed property stores evaluate their object once" {
    store_target = null
    store_target_calls = 0

    store_target_once().name = "stored"
    assert(store_target_calls == 1)

    store_target_once().handler = fn() {}
    assert(store_target_calls == 2)

    store_target_once().payload = "boxed"
    assert(store_target_calls == 3)

    let target = store_target ?? GCStoreTarget {}
    assert((target.name ?? "") == "stored")
    assert(isset(target.handler))
    match target.payload {
        String as text => assert(text == "boxed")
        default => assert(false)
    }

    store_target = null
    gc.collect()
}

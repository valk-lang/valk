use valk.net
use valk.thread
use valk.time
use valk.coro
use valk.gc

class SocketAcceptState {
    listener: shared net.TcpServer
    ready: uint (0)
    timeouts: uint (0)
    finished: uint (0)
}

fn socket_accept_echo(state: shared SocketAcceptState) bool {
    let index: uint = 0
    while index++ < 16 {
        state.listener.accept(2) ! {
            if error_is(E.code, timeout) : state.timeouts++
        }
    }
    state.ready++
    let connection = state.listener.accept(3000) ! return false
    let bytes = [u8]{ 0 x 1 }
    let ok = (connection.read(bytes) !? 0) == 1
    gc.collect()
    connection.write(bytes) ! { ok = false }
    connection.close() ! { ok = false }
    return ok
}

fn socket_wait_ready(state: shared SocketAcceptState, count: uint) {
    let deadline = time.mono_ms() + 5000
    while state.ready < count && time.mono_ms() < deadline : time.sleep_ms(1)
    assert(state.ready == count)
    if state.ready != count : panic("Socket accept workers did not become ready")
}

fn socket_accept_until_closed(state: shared SocketAcceptState) bool {
    let accepting = co state.listener.accept()
    coro.await_last()
    state.ready++
    let connection = await accepting !? null
    if isset(connection) : connection.close() !!
    return !isset(connection)
}

fn socket_accept_batch(state: shared SocketAcceptState, count: uint) bool {
    if count == 1 : return socket_accept_until_closed(state)
    let accepting = co socket_accept_until_closed(state)
    let others = socket_accept_batch(state, count - 1)
    let closed = await accepting
    return closed && others
}

test "TcpServer: accepts survive creator and previous accepting thread exit" {
    let creator = thread.Thread[shared net.TcpServer].start(fn() shared net.TcpServer {
        let listener = net.tcp_server("127.0.0.1", 9091) !!
        let timed_out = false
        listener.accept(2) ! { timed_out = error_is(E.code, timeout) }
        assert(timed_out)
        return listener
    }) !!
    let state: shared SocketAcceptState = .{ listener: creator.await() }
    let round: uint = 0
    while round++ < 3 {
        state.ready = 0
        state.timeouts = 0
        let worker = thread.Thread[bool].start(fn() bool { return socket_accept_echo(state) }) !!
        socket_wait_ready(state, 1)
        assert(state.timeouts == 16)
        let client = net.tcp_client("127.0.0.1", 9091) !!
        client.write("e") !!
        let bytes = [u8]{ 0 x 1 }
        assert((client.read(bytes) !? 0) == 1 && bytes.to_string() == "e")
        client.close() !!
        assert(worker.await())
        gc.collect()
    }
    state.listener.close() !!
}

test "TcpServer: close wakes pending accepts on every thread" {
    let state: shared SocketAcceptState = .{
        listener: net.tcp_server("127.0.0.1", 9092) !!
    }
    let workers = Array[thread.Thread[bool]].new()
    let index: uint = 0
    while index++ < 4 {
        workers.append(thread.Thread[bool].start(fn() bool {
            let closed = socket_accept_batch(state, 20)
            state.finished++
            return closed
        }) !!)
    }
    socket_wait_ready(state, 80)
    gc.collect()
    state.listener.close() !!
    let deadline = time.mono_ms() + 5000
    while state.finished < 4 && time.mono_ms() < deadline : time.sleep_ms(1)
    if state.finished != 4 : panic("Closing the listener did not wake every accept worker")
    each workers as worker : assert(worker.await())
    let closed = false
    state.listener.accept(1) ! { closed = error_is(E.code, closed) }
    assert(closed)
    state.listener.close() !!
}

fn v6_echo(server: shared net.TcpServer) bool {
    let connection = server.accept(3000) ! return false
    let buffer = [u8]{ 0 x 8 }
    let bytes = connection.read(buffer) ! return false
    connection.write(buffer.view(0, bytes)) ! return false
    connection.close() ! return false
    return true
}
test "TcpServer: an IPv6 listener accepts connections" {
    // `TcpServer.new` and `TcpConnection.new` are the same constructors as the functions
    let server = net.TcpServer.new("::1", 19480) !!
    assert((server.local_address() !!).ipv6)
    let echo = co v6_echo(server)
    let connection = net.TcpConnection.new("::1", 19480) !!
    connection.write("v6") !!
    let buffer = [u8]{ 0 x 8 }
    let bytes = connection.read(buffer) !!
    assert(buffer.view(0, bytes).to_string() == "v6")
    connection.close() !!
    assert(await echo)
    server.close() !!
}

test "Sockets: bind failures report their reason" {
    let first = net.udp_server("127.0.0.1", 19482) !!
    let in_use = false
    net.udp_server("127.0.0.1", 19482) ! { in_use = error_is(E.code, port_in_use) }
    assert(in_use)
    first.close() !!

    // 192.0.2.1 (TEST-NET-1) is not an address of this machine
    let udp_os = false
    net.udp_server("192.0.2.1", 19483) ! { udp_os = error_is(E.code, os) }
    assert(udp_os)
    let tcp_os = false
    net.tcp_server("192.0.2.1", 19483) ! { tcp_os = error_is(E.code, os) }
    assert(tcp_os)

    // A privileged port, where the system has them
    let privileged = net.udp_server("127.0.0.1", 1) ! {
        assert(error_is(E.code, access))
        return
    }
    privileged.close() !!
}

test "UDP: an oversized datagram is truncated" {
    let server = net.udp_server("127.0.0.1", 19484) !!
    let client = net.udp_client("127.0.0.1", 19484) !!
    assert((client.write("abcdefghij") !!) == 10)
    let buffer = [u8]{ 0 x 4 }
    let bytes, from = server.recv_from(buffer) !!
    assert(bytes == 4)
    assert(buffer.to_string() == "abcd")
    assert(from.port == (client.local_address() !!).port)

    // The socket keeps working after a truncated datagram
    client.write("xy") !!
    let next, _ = server.recv_from(buffer) !!
    assert(next == 2)
    assert(buffer.view(0, 2).to_string() == "xy")
    client.close() !!
    server.close() !!
}

test "TcpConnection: a client can choose its local end and both ends report their addresses" {
    let server = net.tcp_server("127.0.0.1", 19485) !!
    let client = net.tcp_client("127.0.0.1", 19485, 5000, 19486, "127.0.0.1") !!
    let accepted = server.accept(3000) !!
    assert((client.local_address() !!).port == 19486)
    assert((client.peer_address() !!).port == 19485)
    assert((accepted.peer_address() !!).port == 19486)
    assert((accepted.local_address() !!).port == 19485)
    client.set_receive_buffer(65536) !!
    client.set_send_buffer(65536) !!
    // The local port is taken: refused at the bind, or on Windows at the connect
    let in_use = false
    net.tcp_client("127.0.0.1", 19485, 5000, 19486) ! { in_use = error_is(E.code, port_in_use) || error_is(E.code, connect) }
    assert(in_use)
    accepted.close() !!
    client.close() !!
    server.close() !!
}

use valk.html

test "HTML escaping uses explicit escape options" {
    assert(html.escape("<tag a='b'>&") == "&lt;tag a=&#39;b&#39;&gt;&amp;")
    let options = html.EscapeOptions {
        escape_single_quote: false
    }
    assert(html.escape("<tag a='b'>", options) == "&lt;tag a='b'&gt;")
}

test "HTML URL attributes reject executable schemes" {
    assert(html.sanitize_url_attributes("<a href=\"JaVaScRiPt:alert(1)\">x</a>") == "<a href=\"\">x</a>")
    assert(html.sanitize_url_attributes("<a href=javascript:alert(1)>x</a>") == "<a href=\"\">x</a>")
    assert(html.sanitize_url_attributes("<img src=' java\tscript:alert(1) '>") == "<img src=''>")
    assert(html.sanitize_url_attributes("<a href=\"javascript&colon;alert(1)\">x</a>") == "<a href=\"\">x</a>")
    assert(html.sanitize_url_attributes("<a href=\"java&#x09;script&#58;alert(1)\">x</a>") == "<a href=\"\">x</a>")

    // Emptying an unquoted value must not leave the text after it to be read as the
    // value: a browser takes the next non-space run after "=" as the value
    assert(html.sanitize_url_attributes("<a href=javascript:alert(1) javascript:alert(2)>") == "<a href=\"\" javascript:alert(2)>")
    assert(html.sanitize_url_attributes("<a href=javascript:x\tjavascript:alert(1)>x</a>") == "<a href=\"\"\tjavascript:alert(1)>x</a>")
    assert(html.sanitize_url_attributes("<img src=javascript:alert(1)\r>") == "<img src=\"\"\r>")
}

test "HTML URL attributes retain allowed targets and raw text" {
    let source = "<a href=\"HTTPS://example.com/a?x=1&y=2\">x</a><p id=\"javascript:x\">y</p>"
    assert(html.sanitize_url_attributes(source) == source)
    assert(html.sanitize_url_attributes("<a href=\"/account?q=a&b=c\">x</a>") == "<a href=\"/account?q=a&b=c\">x</a>")

    let script = "<script>let link = '<a href=\"https://example.com\">'</script>"
    assert(html.sanitize_url_attributes(script) == script)

    assert(html.sanitize_url_attributes("<a href=\"tel:+123\">x</a>", Array[String]{ "tel" }) == "<a href=\"tel:+123\">x</a>")
    assert(html.sanitize_url_attributes("<a href=\"https://example.com\">x</a>", Array[String]{ "tel" }) == "<a href=\"\">x</a>")
}

test "HTML URL attributes are checked wherever a browser could read a tag" {
    // A vertical tab is no HTML whitespace, so the quote belongs to the name
    assert(html.sanitize_url_attributes("<a title=a\vb=\"  > <a href=javascript:alert(1)> \">") == "<a title=a\vb=\"  > <a href=\"\"> \">")
    // Raw text does not exist in svg, and `</scriptx` does not end a script
    assert(html.sanitize_url_attributes("<svg><style><a href=\"javascript:alert(1)\">") == "<svg><style><a href=\"\">")
    assert(html.sanitize_url_attributes("<script></scriptx><textarea></script><a href=javascript:alert(1)>") == "<script></scriptx><textarea></script><a href=\"\">")
    // Comments end at `-->` and end tags read quoted values
    assert(html.sanitize_url_attributes("<!-- > <a title=\" --> <a href=javascript:alert(1)> \">") == "<!-- > <a title=\" --> <a href=\"\"> \">")
    assert(html.sanitize_url_attributes("</a x=\"><a title='\"><a href=javascript:alert(1)>'>") == "</a x=\"><a title='\"><a href=\"\">'>")
    // Tags inside raw text are checked too
    assert(html.sanitize_url_attributes("<script>'<a href=\"javascript:x\">'</script>") == "<script>'<a href=\"\">'</script>")

    // Emptying one value can turn another into a rejected one: repeat until nothing changes
    let joined = html.sanitize_url_attributes("<b href=\"java<a href=evil:x>script:alert(1)\">")
    assert(!joined.lower().contains("javascript"))

    // Tags that overlap too much to check get every `<` escaped
    let nested = ByteBuffer.new(200000)
    each 0 .. 20000 : nested.write("<a/href=")
    let escaped = html.sanitize_url_attributes(nested.to_string())
    assert(!escaped.contains("<"))
}

use valk.html

test "HTML escaping uses explicit escape options" {
    assert(html.escape("<tag a='b'>&") == "&lt;tag a=&#39;b&#39;&gt;&amp;")
    let options = html.HtmlEscapeOptions {
        escape_single_quote: false
    }
    assert(html.escape("<tag a='b'>", options) == "&lt;tag a='b'&gt;")
}

test "HTML URL attributes reject executable schemes" {
    assert(html.sanitize_url_attributes("<a href=\"JaVaScRiPt:alert(1)\">x</a>") == "<a href=\"\">x</a>")
    assert(html.sanitize_url_attributes("<a href=javascript:alert(1)>x</a>") == "<a href=>x</a>")
    assert(html.sanitize_url_attributes("<img src=' java\tscript:alert(1) '>") == "<img src=''>")
    assert(html.sanitize_url_attributes("<a href=\"javascript&colon;alert(1)\">x</a>") == "<a href=\"\">x</a>")
    assert(html.sanitize_url_attributes("<a href=\"java&#x09;script&#58;alert(1)\">x</a>") == "<a href=\"\">x</a>")
}

test "HTML URL attributes retain allowed targets and raw text" {
    let source = "<a href=\"HTTPS://example.com/a?x=1&y=2\">x</a><p id=\"javascript:x\">y</p>"
    assert(html.sanitize_url_attributes(source) == source)
    assert(html.sanitize_url_attributes("<a href=\"/account?q=a&b=c\">x</a>") == "<a href=\"/account?q=a&b=c\">x</a>")

    let script = "<script>let link = '<a href=\"javascript:inside-text\">'</script>"
    assert(html.sanitize_url_attributes(script) == script)

    assert(html.sanitize_url_attributes("<a href=\"tel:+123\">x</a>", Array[String]{ "tel" }) == "<a href=\"tel:+123\">x</a>")
    assert(html.sanitize_url_attributes("<a href=\"https://example.com\">x</a>", Array[String]{ "tel" }) == "<a href=\"\">x</a>")
}

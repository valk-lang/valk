fn tuple_element_pair() (u8, u64) {
    return (7, 700)
}

fn tuple_element_first(pair: (u8, u64)) u8 {
    let first, _ = pair
    return first
}

test "Tuples: a single name holds a tuple value" {
    let whole = tuple_element_pair()
    let first, second = whole
    assert(first == 7)
    assert(second == 700)
    assert(tuple_element_first(whole) == 7)
}

test "Tuples: array elements keep the whole value" {
    let pairs = Array[(u8, u64)].new()
    pairs.append((1, 100))
    pairs.append((2, 200))
    pairs.append((1, 100))
    assert(pairs.length == 3)
    let head_first, head_second = pairs[0]
    assert(head_first == 1)
    assert(head_second == 100)

    // `into` holds the whole pair; `as` splits it across the names
    let total = 0
    each pairs into pair {
        let left, right = pair
        total += left.to(int)
        total += right.to(int)
    }
    assert(total == 404)

    let split_total = 0
    let seen_indexes = Array[uint]{}
    each pairs as left, right, index {
        split_total += left.to(int)
        split_total += right.to(int)
        assert(right == left.to(u64) * 100)
        seen_indexes.append(index)
    }
    assert(split_total == 404)
    assert(seen_indexes == Array[uint]{ 0, 1, 2 })

    // `into` with an index keeps the pair whole
    let whole_indexes = 0
    each pairs into pair, index {
        let left, right = pair
        whole_indexes += index.to(int)
        assert(right == left.to(u64) * 100)
    }
    assert(whole_indexes == 3)

    let copy = pairs.copy()
    assert(copy.length == 3)
    assert((copy.index_of((2, 200)) !? 99) == 1)
    pairs.remove_duplicates()
    assert(pairs.length == 2)
    let last = pairs.pop_last() ! panic("empty")
    let last_left, _ = last
    assert(last_left == 2)
    assert(pairs.length == 1)
}

struct TupleTypeBox[T] {
    item: T
}

struct TupleTypeFixedHolder {
    fixed: [(u8, u64) x 2]
}

slice TupleTypeSlice of (u8, u64) {}

fn tuple_type_borrow_len(items: &[(u8, u64)]) uint { return items.length }
fn tuple_type_dynamic_len(items: $array[(u8, u64)]) uint { return items.length }

test "Tuples: accepted in every type position" {
    assert(size_of(TupleTypeFixedHolder) == 2 * size_of((u8, u64)))
    assert(size_of(TupleTypeSlice) > 0)
    let box = TupleTypeBox[(u8, u64)] { item: (3, 300) }
    let boxed_first, boxed_second = box.item
    assert(boxed_first == 3)
    assert(boxed_second == 300)
}

test "Tuples: a fixed array element keeps the whole tuple" {
    // A whole tuple is one element when the element type is that tuple
    let pair = tuple_element_pair()
    let one: [(u8, u64) x 1] = { pair }
    let one_first, one_second = one[0]
    assert(one_first == 7)
    assert(one_second == 700)

    let literal: [(u8, u64) x 1] = { (3.to(u8), 4.to(u64)) }
    let literal_first, literal_second = literal[0]
    assert(literal_first == 3)
    assert(literal_second == 4)

    let both: [(u8, u64) x 2] = { (1.to(u8), 2.to(u64)), pair }
    let second_first, second_second = both[1]
    assert(second_first == 7)
    assert(second_second == 700)

    // One entry is one element: a scalar array still takes its values apart
    let scalars: [u8 x 2] = { 5, 6 }
    assert(scalars[0] == 5)
    assert(scalars[1] == 6)

    // And a repeated entry fills the remaining elements
    let filled: [(u8, u64) x 3] = { pair... }
    let filled_first, filled_second = filled[2]
    assert(filled_first == 7)
    assert(filled_second == 700)

    // The same rule applies to a fixed array field of a struct
    let holder = TupleTypeFixedHolder { fixed: { pair, (3.to(u8), 4.to(u64)) } }
    let field_first, field_second = holder.fixed[0]
    assert(field_first == 7)
    assert(field_second == 700)

    // And to every other initializer: one entry, one element
    let slice = [(u8, u64)]{ pair, (3.to(u8), 4.to(u64)) }
    assert(slice.length == 2)
    let slice_first, slice_second = slice[0]
    assert(slice_first == 7)
    assert(slice_second == 700)

    let dynamic = Array[(u8, u64)]{ pair }
    assert(dynamic.length == 1)
    let dynamic_first, dynamic_second = dynamic[0]
    assert(dynamic_first == 7)
    assert(dynamic_second == 700)

    let boxed = TupleTypeBox[(u8, u64)] { item: pair }
    let boxed_first, boxed_second = boxed.item
    assert(boxed_first == 7)
    assert(boxed_second == 700)
}

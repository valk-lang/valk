@unsafe

#if GROVE

use valk.gc

// Reads the pacing state
@ignore_access

global grove_poll_freed: uint
// Two reference words, no header
value grove_poll_node_bytes (16)

class GrovePollNode {
    left: ?GrovePollNode (null)
    right: ?GrovePollNode (null)
}

// A finalizer whose loop makes a call: its poll is no GC effect, so this compiles
class GrovePollFinal {
    fn gc_free() {
        let i: uint = 0
        while i < 3 : i = grove_poll_next(i)
        grove_poll_freed++
    }
}

fn grove_poll_next(i: uint) uint $noinline {
    return i + 1
}

// Allocates only on a branch these tests never take: a loop that calls it keeps its poll
fn grove_poll_step(i: uint) uint $noinline {
    if i > 1000000 : return grove_poll_count(GrovePollNode {}) + i
    return i + 1
}

// A tree of `count` nodes built by recursion only: no loop, so no poll
fn grove_poll_tree(count: uint) ?GrovePollNode {
    if count == 0 : return null
    let left = (count - 1) / 2
    return GrovePollNode { left: grove_poll_tree(left), right: grove_poll_tree(count - 1 - left) }
}

fn grove_poll_count(node: ?GrovePollNode) uint {
    if !isset(node) : return 0
    return 1 + grove_poll_count(node.left) + grove_poll_count(node.right)
}

// Builds and drops a tree; returns its size and whether a collection ran meanwhile
fn grove_poll_build_drop(count: uint) (uint, bool) $noinline {
    let before = gc.gc.collect_count
    let size = grove_poll_count(grove_poll_tree(count))
    return (size, gc.gc.collect_count != before)
}

// Forced collections (GC_STRESS) replace the cycles being measured
#if !GC_STRESS
synctest "Grove: a deep recursion collects at the next poll, after its tree is dropped" {
    gc.collect()
    gc.collect()
    let marked = gc.gc.mem_marked
    // Between the young budget B and the hard limit H
    let bytes = (gc.gc.mem_trigger + gc.gc.mem_limit) / 2 - gc.gc.mem_new
    let count = bytes / grove_poll_node_bytes
    let before = gc.gc.collect_count
    let size, collected = grove_poll_build_drop(count)
    assert(size == count)
    assert(!collected)
    assert(gc.pending)
    assert(gc.gc.collect_count == before)
    // A loop whose calls reach no GC work has no poll
    let i: uint = 0
    while i < 3 : i = grove_poll_next(i)
    assert(gc.pending)
    assert(gc.gc.collect_count == before)
    // The loop's poll is at or above the depth where the budget ran out
    i = 0
    while i < 1 : i = grove_poll_step(i)
    assert(gc.gc.collect_count == before + 1)
    assert(!gc.pending)
    // The dropped tree was not marked
    assert(gc.gc.mem_marked < marked + bytes / 4)
}

synctest "Grove: an allocation loop without calls collects at its polling refill" {
    gc.collect()
    let before = gc.gc.collect_count
    let total = gc.gc.mem_limit * 4
    let made: uint = 0
    let over: uint = 0
    let keep: ?GrovePollNode = null
    while made < total {
        keep = GrovePollNode {}
        made += grove_poll_node_bytes
        // A plain refill would let `allocated` run on to H
        if gc.gc.mem_new > gc.gc.mem_trigger && gc.gc.mem_new - gc.gc.mem_trigger > over {
            over = gc.gc.mem_new - gc.gc.mem_trigger
        }
    }
    assert(isset(keep))
    assert(gc.gc.collect_count >= before + 3)
    assert(over <= 32 * 1024)
}

synctest "Grove: a coroutine switch runs a pending collection" {
    gc.collect()
    let before = gc.gc.collect_count
    // Pending with a trigger_sp no poll reaches
    gc.poll_inv = 1
    let task = co grove_poll_task()
    assert(await task == 7)
    assert(gc.gc.collect_count > before)
    assert(!gc.pending)
}

synctest "Grove: a coroutine that finishes with a collection pending keeps the caller's objects" {
    gc.collect()
    let before = gc.gc.collect_count
    let keep = Array[uint]{ 1, 2, 3 }
    let task = co grove_poll_finish()
    assert(await task == 9)
    // The collection at its last switch scanned its own stack, not up to the main stack's top
    assert(gc.gc.collect_count > before)
    assert(!gc.pending)
    assert((keep.get(2) !? 0) == 3)
}
#end

fn grove_poll_task() uint {
    return 7
}

fn grove_poll_finish() uint {
    // Pending with a trigger_sp no poll reaches
    gc.poll_inv = 1
    return 9
}

synctest "Grove: a finalizer with a polled loop runs" {
    grove_poll_freed = 0
    let i: uint = 0
    while i < 10 {
        GrovePollFinal {}
        i++
    }
    gc.collect()
    gc.collect()
    assert(grove_poll_freed == 10)
}

#end

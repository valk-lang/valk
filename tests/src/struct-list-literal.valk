struct LitBag {
    count: uint (0)
    items: ?Array[int] (null)

    + fn add(item: int) $append {
        let list = this.items ?? <{
            let created = Array[int]{}
            this.items = created
            return created
        }
        list.append(item)
        this.count++
    }
    fn total() int {
        let sum = 0
        each this.items ?? Array[int]{} as item : sum += item
        return sum
    }
}

struct LitPairs {
    keys: String ("")
    sum: int (0)

    + fn put(key: String, value: int) $set_key {
        this.keys += key
        this.sum += value
    }
}

struct LitStack[T] {
    items: Array[T] (.{})
    + fn push(item: T) $append {
        this.items.append(item)
    }
}

class LitHolder {
    bag: LitBag (LitBag{ 5, 6 })
}

fn lit_total(bag: LitBag) int {
    return bag.total()
}

test "Struct list literals keep what their hooks add" {
    let bag = LitBag{ 1, 2, 3 }
    assert(bag.count == 3 && bag.total() == 6)
    // With the type from the parameter
    assert(lit_total(.{ 4, 5 }) == 9)
    // Map-style literals of a struct
    let pairs = LitPairs{ "a" => 1, "b" => 2 }
    assert(pairs.keys == "ab" && pairs.sum == 3)
    // Inside a map literal, and as a field default
    let named = Map[LitBag]{ "x" => .{ 7, 8, 9 } }
    let x = named.get("x") !? LitBag{}
    assert(x.total() == 24)
    assert(LitHolder {}.bag.total() == 11)
    // A generic struct
    let stack = LitStack[String]{ "a", "b" }
    assert(stack.items.join(",") == "a,b")
    // Each literal is its own value
    let first = LitBag{ 1 }
    let second = LitBag{ 2 }
    assert(first.total() == 1 && second.total() == 2)
}

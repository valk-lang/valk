use valk.fs
use valk.http
use valk.net
use valk.time

global bodyless_server_release: bool (false)
global framing_server_ready: u16 (0)

fn wait_for_framing_server(port: u16) bool {
    let waited: uint = 0
    while framing_server_ready != port {
        if waited++ >= 2000 : return false
        time.sleep_ms(1)
    }
    return true
}

fn download_framing_server() {
    let server = net.Socket.server(net.SOCKET_TYPE.TCP, "127.0.0.1", 9042) ! return
    framing_server_ready = 9042
    let connection = server.accept() ! return
    let request = ByteBuffer.new(2048)
    connection.recv(request, 2048) ! return

    // The second response is already coalesced into the same receive buffer.
    // This client does not reuse connections, so it must save only the first
    // response's declared byte and discard everything after that on close.
    let response = "HTTP/1.1 200 OK\r\nContent-Length: 1\r\n\r\nA"
        + "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nEXTRA"
    connection.send_bytes(response.data, response.bytes, true) ! return
    time.sleep_ms(80)
    connection.close() ! return
    server.close() ! return
}

fn close_delimited_server(port: u16, body: String) {
    let server = net.Socket.server(net.SOCKET_TYPE.TCP, "127.0.0.1", port) ! return
    framing_server_ready = port
    let connection = server.accept() ! return
    let request = ByteBuffer.new(2048)
    connection.recv(request, 2048) ! return
    let response = "HTTP/1.1 200 OK\r\n\r\n" + body
    connection.send_bytes(response.data, response.bytes, true) ! return
    time.sleep_ms(80)
    connection.close() ! return
    server.close() ! return
}

fn bodyless_server(port: u16, status: String) {
    let server = net.Socket.server(net.SOCKET_TYPE.TCP, "127.0.0.1", port) ! return
    framing_server_ready = port
    let connection = server.accept() ! return
    let request = ByteBuffer.new(2048)
    connection.recv(request, 2048) ! return
    let response = "HTTP/1.1 " + status + "\r\n\r\n"
    connection.send_bytes(response.data, response.bytes, true) ! return
    // Keep the connection open until the client has returned. If it mistakes
    // this for a close-delimited body, both sides wait until the client timeout.
    while !bodyless_server_release : time.sleep_ms(1)
    connection.close() ! return
    server.close() ! return
}

test "HTTP download stops at Content-Length" {
    let path = fs.add(fs.exe_dir() !? "", "http-download-framing.tmp")
    if fs.exists(path) : fs.delete(path) ! assert(false)

    framing_server_ready = 0
    co download_framing_server()
    if !wait_for_framing_server(9042) {
        assert(false)
        return
    }
    http.download("http://127.0.0.1:9042/", path) ! panic("download failed")

    let contents = fs.read(path) !? ""
    assert(contents == "A")
    fs.delete(path) ! assert(false)
}

test "HTTP client reads a close-delimited response through EOF" {
    framing_server_ready = 0
    co close_delimited_server(9043, "close-delimited body")
    if !wait_for_framing_server(9043) {
        assert(false)
        return
    }

    let response = http.request("GET", "http://127.0.0.1:9043/") ! {
        assert(false)
        return
    }
    assert(response.body == "close-delimited body")
}

test "HTTP download saves a close-delimited response through EOF" {
    let path = fs.add(fs.exe_dir() !? "", "http-download-close-delimited.tmp")
    if fs.exists(path) : fs.delete(path) ! assert(false)

    framing_server_ready = 0
    co close_delimited_server(9044, "close-delimited download")
    if !wait_for_framing_server(9044) {
        assert(false)
        return
    }
    http.download("http://127.0.0.1:9044/", path) ! panic("download failed")

    let contents = fs.read(path) !? ""
    assert(contents == "close-delimited download")
    fs.delete(path) ! assert(false)
}

test "HTTP bodyless responses do not wait for EOF" {
    let options = http.Options { read_timeout_ms: 500, timeout_ms: 1000 }

    bodyless_server_release = false
    framing_server_ready = 0
    let head_server = co bodyless_server(9045, "200 OK")
    if !wait_for_framing_server(9045) {
        assert(false)
        return
    }
    let head = http.request("HEAD", "http://127.0.0.1:9045/", options) ! {
        bodyless_server_release = true
        assert(false)
        return
    }
    assert(head.body == "")
    bodyless_server_release = true
    await head_server

    bodyless_server_release = false
    framing_server_ready = 0
    let no_content_server = co bodyless_server(9046, "204 No Content")
    if !wait_for_framing_server(9046) {
        assert(false)
        return
    }
    let no_content = http.request("GET", "http://127.0.0.1:9046/", options) ! {
        bodyless_server_release = true
        assert(false)
        return
    }
    assert(no_content.body == "")
    bodyless_server_release = true
    await no_content_server
}

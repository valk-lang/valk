use valk.thread

// Values become shared or move into locked data as copies; a literal and data of the same
// lock move as they are

class PcItem {
    n: int (0)
    tags: Array[String] (.{})
}

class PcNode {
    n: int (0)
    next: ?PcNode (null)
    other: ?PcNode (null)
}

class PcState {
    items: Array[PcItem] (.{})
    first: ?PcItem (null)
    second: ?PcItem (null)
}

global pc_shared: ?atomic PcItem (null)

test "Publish copy: a published variable is a copy, the original stays usable" {
    let item = PcItem { n: 1 }
    item.tags.append("a")
    let view: atomic PcItem = item
    item.n = 2
    item.tags.append("b")
    assert(view.n == 1 && view.tags.length == 1)
    assert(item.n == 2 && item.tags.length == 2)
}

test "Publish copy: a shared global takes a copy" {
    let item = PcItem { n: 3 }
    pc_shared = item
    item.n = 4
    assert((pc_shared?.n ?? 0) == 3)
}

test "Publish copy: cycles and parts reached twice keep their shape" {
    let a = PcNode { n: 1 }
    let b = PcNode { n: 2, next: a }
    a.next = b
    a.other = b
    let view: atomic PcNode = a
    let next = view.next ?! panic("missing next")
    let back = next.next ?! panic("missing cycle")
    assert(next.n == 2 && back.n == 1)
    let other = view.other ?! panic("missing other")
    assert(other == next)
}

test "Publish copy: stores into locked data copy plain values" {
    let state: atomic Lock[PcState] = .new(PcState {}) !!
    let item = PcItem { n: 5 }
    lock state as s {
        s.items.append(item)
        s.first = item
    }
    item.n = 6
    lock state as s {
        assert((s.items.get(0) !? null)?.n == 5)
        assert((s.first?.n ?? 0) == 5)
    }
}

test "Publish copy: data of one lock moves within that lock" {
    let state: atomic Lock[PcState] = .new(PcState {}) !!
    lock state as s {
        s.first = PcItem { n: 7 }
        s.second = s.first
        let first = s.first ?! panic("missing first")
        first.n = 8
        assert((s.second?.n ?? 0) == 8)
    }
}

test "Publish copy: data from another lock is copied in" {
    let a: atomic Lock[PcState] = .new(PcState { first: PcItem { n: 9 } }) !!
    let b: atomic Lock[PcState] = .new(PcState {}) !!
    lock a as x {
        lock b as y {
            y.first = x.first
        }
        let first = x.first ?! panic("missing first")
        first.n = 10
    }
    lock b as y : assert((y.first?.n ?? 0) == 9)
}

test "Publish copy: literals for shared data copy what they were given" {
    let a = PcItem { n: 1 }
    let list: atomic Array[PcItem] = .{ a }
    let b = PcItem { n: 1 }
    let typed: atomic Array[PcItem] = Array[PcItem]{ b }
    let c = PcItem { n: 1 }
    let fixed: atomic [PcItem x 1] = .{ c }
    let d = PcItem { n: 1 }
    let state: atomic PcState = .{ first: d }
    a.n = 2
    b.n = 2
    c.n = 2
    d.n = 2
    assert((list.get(0) !? null)?.n == 1)
    assert((typed.get(0) !? null)?.n == 1)
    assert(fixed[0].n == 1)
    assert((state.first?.n ?? 0) == 1)
}

class PcSlots {
    item: ?PcItem (null)
    cells: mut &[?PcItem] ([?PcItem]{ null x 2 })
    hits: uint (0)
}

#if !TEST_ST_ONLY && !TEST_MT_TODO
test "Shared views: references change through the view, as copies" {
    let slots: atomic PcSlots = PcSlots {}
    let item = PcItem { n: 3 }
    slots.item = item
    slots.cells[1] = item
    item.n = 4
    assert((slots.item?.n ?? 0) == 3)
    assert((slots.cells[1]?.n ?? 0) == 3)
    slots.item = null
    assert(!isset(slots.item))
}

test "Shared views: threads replace a reference while others read it" {
    let slots: atomic PcSlots = PcSlots { item: PcItem { n: 1 } }
    let threads = Array[thread.Thread[void]]{}
    let i = 0
    while i++ < 4 {
        threads.append(thread.start(fn() {
            let round: int = 0
            while round < 2000 {
                slots.item = PcItem { n: round }
                let seen = slots.item ?! continue
                if seen.n >= 0 : atomic(slots.hits + 1)
                round++
            }
        }) !!)
    }
    each threads as t : t.await()
    assert(slots.hits == 8000)
}
#end

test "Atomic arrays: copy and sorted give plain arrays of atomic elements" {
    let list: atomic Array[PcItem] = .{ PcItem { n: 3 }, PcItem { n: 1 }, PcItem { n: 2 } }
    let sorted = list.sorted(fn(a: atomic PcItem, b: atomic PcItem) bool { return a.n > b.n })
    let first = list.get(0) !!
    sorted.append(first)
    assert(sorted.length == 4 && (sorted.get(0) !? null)?.n == 1 && (sorted.get(3) !? null)?.n == 3)
    let copy = list.copy()
    copy.clear()
    assert(copy.length == 0 && list.length == 3)
    let nums: atomic Array[int] = .{ 3, 1, 2 }
    let ns = nums.sorted()
    ns.append(0)
    assert((ns.get(0) !? 0) == 1 && ns.length == 4)
}

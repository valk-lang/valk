// Values become shared or move into locked data as copies; a literal and data of the same
// lock move as they are

class PcItem {
    n: int (0)
    tags: Array[String] (.{})
}

class PcNode {
    n: int (0)
    next: ?PcNode (null)
    other: ?PcNode (null)
}

class PcState {
    items: Array[PcItem] (.{})
    first: ?PcItem (null)
    second: ?PcItem (null)
}

global pc_shared: ?shared PcItem (null)

test "Publish copy: a published variable is a copy, the original stays usable" {
    let item = PcItem { n: 1 }
    item.tags.append("a")
    let view: shared PcItem = item
    item.n = 2
    item.tags.append("b")
    assert(view.n == 1 && view.tags.length == 1)
    assert(item.n == 2 && item.tags.length == 2)
}

test "Publish copy: a shared global takes a copy" {
    let item = PcItem { n: 3 }
    pc_shared = item
    item.n = 4
    assert((pc_shared?.n ?? 0) == 3)
}

test "Publish copy: cycles and parts reached twice keep their shape" {
    let a = PcNode { n: 1 }
    let b = PcNode { n: 2, next: a }
    a.next = b
    a.other = b
    let view: shared PcNode = a
    let next = view.next ?! panic("missing next")
    let back = next.next ?! panic("missing cycle")
    assert(next.n == 2 && back.n == 1)
    let other = view.other ?! panic("missing other")
    assert(other == next)
}

test "Publish copy: stores into locked data copy plain values" {
    let state: shared Lock[PcState] = .new(PcState {}) !!
    let item = PcItem { n: 5 }
    lock state as s {
        s.items.append(item)
        s.first = item
    }
    item.n = 6
    lock state as s {
        assert((s.items.get(0) !? null)?.n == 5)
        assert((s.first?.n ?? 0) == 5)
    }
}

test "Publish copy: data of one lock moves within that lock" {
    let state: shared Lock[PcState] = .new(PcState {}) !!
    lock state as s {
        s.first = PcItem { n: 7 }
        s.second = s.first
        let first = s.first ?! panic("missing first")
        first.n = 8
        assert((s.second?.n ?? 0) == 8)
    }
}

test "Publish copy: data from another lock is copied in" {
    let a: shared Lock[PcState] = .new(PcState { first: PcItem { n: 9 } }) !!
    let b: shared Lock[PcState] = .new(PcState {}) !!
    lock a as x {
        lock b as y {
            y.first = x.first
        }
        let first = x.first ?! panic("missing first")
        first.n = 10
    }
    lock b as y : assert((y.first?.n ?? 0) == 9)
}

test "Publish copy: literals for shared data copy what they were given" {
    let a = PcItem { n: 1 }
    let list: shared Array[PcItem] = .{ a }
    let b = PcItem { n: 1 }
    let typed: shared Array[PcItem] = Array[PcItem]{ b }
    let c = PcItem { n: 1 }
    let fixed: shared [PcItem x 1] = .{ c }
    let d = PcItem { n: 1 }
    let state: shared PcState = .{ first: d }
    a.n = 2
    b.n = 2
    c.n = 2
    d.n = 2
    assert((list.get(0) !? null)?.n == 1)
    assert((typed.get(0) !? null)?.n == 1)
    assert(fixed[0].n == 1)
    assert((state.first?.n ?? 0) == 1)
}

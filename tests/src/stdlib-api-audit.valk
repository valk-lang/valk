use valk.fs

// Characterizes current behavior for the API audit, not the desired contracts.
test "API audit: filter_self copies and removes predicate matches" {
    let source = Array[int]{ 1, 2, 3 }
    let predicate = fn(value: int) bool { return value > 1 }
    let kept = source.filter(predicate)
    let removed = source.filter_self(predicate)
    assert(kept.length == 2)
    assert((kept.get(0) !? 0) == 2 && (kept.get(1) !? 0) == 3)
    assert(removed.length == 1 && (removed.get(0) !? 0) == 1)
    assert(source.length == 3 && (source.get(1) !? 0) == 2)
}

test "API audit: byte reader hides incomplete and invalid input" {
    let reader = "x".reader()
    assert(reader.read_u32_le() == 0)
    assert(reader.get_pos() == 0)
    assert(reader.read_uint() == 0)
    assert(reader.get_pos() == 0)
    assert(reader.read_string(4) == "x")
    assert(reader.read_byte() == 0)
}

test "API audit: array range is a copy" {
    let source = Array[int]{ 1, 2 }
    let snapshot = source.range(0, source.length)
    snapshot.set(0, 9) ! assert(false)
    assert((source.get(0) !? 0) == 1)
    assert(snapshot.length == 2)
}

test "ByteBuffer shortest ASCII writer is explicitly named" {
    let buffer = ByteBuffer.new()
    buffer.write_f64_ascii_shortest(1.5)
    assert(buffer.to_string() == "1.5")
}

test "fs: truncation must be explicitly requested" {
    let directory = fs.exe_dir() ! { assert(false); return }
    let path = fs.add(directory, "valk-stdlib-api-audit.txt")
    fs.write(path, "existing contents") ! { assert(false); return }
    defer fs.delete_file(path) _
    let stream = fs.stream(path, fs.OpenOptions { write: fs.WriteMode.truncate }) ! { assert(false); return }
    stream.close() ! assert(false)
    assert((fs.size(path) !? 99) == 0)
}

use valk.http
use valk.net

fn expect_handler(req: http.Request) http.Response {
    return http.Response.text("received " + req.body.bytes)
}

// Reads until `marker` shows up or the reads run out
fn expect_read_until(connection: net.TcpConnection, marker: String) String {
    connection.read_timeout_ms = 2000
    let response = ByteBuffer.new(1024)
    let chunk = [u8]{ 0 x 1024 }
    let reads = 0
    while !response.to_string().contains(marker) && reads++ < 20 {
        let received = connection.read(chunk) ! break
        if received == 0 : break
        response.write(chunk.view(0, received))
    }
    return response.to_string()
}

test "HTTP: Expect: 100-continue gets an interim response before the body" {
    let server = http.Server.new("127.0.0.1", 9203, expect_handler)
    let server_running = co server.start(1)
    defer stop_http_test_server(server, server_running)

    let connection = net.tcp_client("127.0.0.1", 9203) ! {
        assert(false)
        return
    }
    let body = "0123456789" + "0123456789"
    connection.write("POST /upload HTTP/1.1\r\nHost: test\r\nContent-Length: 20\r\nExpect: 100-continue\r\n\r\n") ! {
        assert(false)
        return
    }
    // The server answers before it has seen a single body byte
    let interim = expect_read_until(connection, "\r\n\r\n")
    assert(interim == "HTTP/1.1 100 Continue\r\n\r\n")

    connection.write(body) ! {
        assert(false)
        return
    }
    let final = expect_read_until(connection, "received 20")
    assert(final.starts_with("HTTP/1.1 200 OK\r\n"))
    assert(final.ends_with("\r\n\r\nreceived 20"))

    // The connection stays usable, and a request without the header gets no interim
    connection.write("POST /again HTTP/1.1\r\nHost: test\r\nContent-Length: 3\r\n\r\nabc") ! {
        assert(false)
        return
    }
    let plain = expect_read_until(connection, "received 3")
    assert(plain.starts_with("HTTP/1.1 200 OK\r\n"))
    assert(!plain.contains("100 Continue"))
    connection.close() ! {}
}

test "HTTP: Expect: 100-continue with the body already sent still works" {
    let server = http.Server.new("127.0.0.1", 9204, expect_handler)
    let server_running = co server.start(1)
    defer stop_http_test_server(server, server_running)

    let connection = net.tcp_client("127.0.0.1", 9204) ! {
        assert(false)
        return
    }
    // A client may send the body without waiting; headers and body arrive together
    connection.write("POST /upload HTTP/1.1\r\nHost: test\r\nContent-Length: 5\r\nExpect: 100-continue\r\n\r\nhello") ! {
        assert(false)
        return
    }
    let response = expect_read_until(connection, "received 5")
    assert(response.contains("HTTP/1.1 200 OK\r\n"))
    assert(response.ends_with("received 5"))
    connection.close() ! {}
}

test "HTTP: Expect is ignored on an HTTP/1.0 request" {
    let server = http.Server.new("127.0.0.1", 9205, expect_handler)
    let server_running = co server.start(1)
    defer stop_http_test_server(server, server_running)

    let connection = net.tcp_client("127.0.0.1", 9205) ! {
        assert(false)
        return
    }
    connection.write("POST /old HTTP/1.0\r\nContent-Length: 4\r\nExpect: 100-continue\r\n\r\n") ! {
        assert(false)
        return
    }
    // No interim response: the server simply waits for the body
    connection.read_timeout_ms = 300
    let chunk = [u8]{ 0 x 64 }
    let got = connection.read(chunk) !? 0
    assert(got == 0)
    connection.write("data") ! {
        assert(false)
        return
    }
    let response = expect_read_until(connection, "received 4")
    assert(response.starts_with("HTTP/1.1 200 OK\r\n"))
    assert(!response.contains("100 Continue"))
    connection.close() ! {}
}

error CommaListError (failed)

interface CommaNamed {
    fn name() String;
}

interface CommaCounted {
    fn count() int;
}

trait CommaTrait[T] {
    fn identity(value: T) T {
        return value
    }
}

class CommaValue[T] is CommaNamed, CommaCounted {
    use CommaTrait[T]

    value: T

    fn name() String {
        return "comma"
    }

    fn count() int {
        return 2
    }
}

fn comma_pair[T](left: T, right: T) (T, T) {
    return (left, right)
}

fn comma_failure() !CommaListError {
    throw .failed
}

fn comma_success() (int, int) !CommaListError {
    return (3, 4)
}

test "Only class initializers allow a trailing comma" {
    let item = CommaValue[int] { value: 4, }
    assert(item.name() == "comma")
    assert(item.count() == 2)
    assert(item.identity(5) == 5)

    let values = Array[int]{
        1
        2
    }
    assert(values.length == 2)

    let left, right = comma_pair[int](1, 2)
    assert(left == 1)
    assert(right == 2)

    let success = 0
    comma_success() -> (success_left, success_right) {
        success = success_left + success_right
    }
    assert(success == 7)

    let each_count = 0
    each values as value, index {
        assert(value == (values[index] !!))
        each_count++
    }
    assert(each_count == 2)

    let handled = false
    comma_failure() ! {
        handled = error_is(E.code, failed)
    }
    assert(handled)
}

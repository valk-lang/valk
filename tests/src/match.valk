
fn test_match_return(val: int) int {
    match val {
        1 => return 5
        2 => return 10
        default => {
            return 15
        }
    }
}

test "Match" {

    let a = 100
    let b = 0

    match a {
        default => {
            a = 1
            b = 15
        }
    }

    assert(a == 1)
    assert(b == 15)

    let c = match a : String {
        1 => "v1"
        default => "v2"
    }

    assert(c == "v1")

    let arr = Array[String].new()
    arr.get(0) ! match E.code {
        E.missing => a = 2
        default => a = 3
    }

    assert(a == 2)

    //
    assert(test_match_return(1) == 5)
    assert(test_match_return(2) == 10)
    assert(test_match_return(3) == 15)

    // Auto cast
    let d = match a : String {
        default => 123
    }
    assert(d == "123")

    // Multi value
    let m1, m2, m3 = match a : (int, String, int) {
        default => (10, 20, 30)
    }
    assert(m1 == 10)
    assert(m2 == "20")
    assert(m3 == 30)
}

error MatchBase (base_a, base_b)
error MatchCodes (own_a) extends (MatchBase)

fn match_codes_throw(n: int) !MatchCodes {
    if n == 1 : throw .own_a
    if n == 2 : throw .base_a
    throw .base_b
}

fn match_codes_name(n: int) String {
    match_codes_throw(n) ! {
        match E.code {
            E.own_a => return "own_a"
            E.base_a => return "base_a"
            E.base_b => return "base_b"
        }
    }
    return "none"
}

test "Match error codes without default" {
    assert(match_codes_name(1) == "own_a")
    assert(match_codes_name(2) == "base_a")
    assert(match_codes_name(3) == "base_b")
}
error MatchArm (two) payload { msg: String }

fn match_arm_exits(x: int) int !MatchArm {
    let v = match x : int {
        1 => 10
        2 => throw .two { msg: "two" }
        3 => return -3
        4 => panic("unreachable")
        default => 0
    }
    return v + 1
}

fn match_bool(v: bool) int {
    return match v : int {
        true => 1
        false => 2
    }
}

fn match_bool_nullable(v: ?bool) int {
    return match v : int {
        null => 3
        true => 1
        false => 2
    }
}

test "Match arms that never yield" {
    assert((match_arm_exits(1) !? -1) == 11)
    assert((match_arm_exits(2) !? -1) == -1)
    let msg = ""
    match_arm_exits(2) ! { msg = E.msg }
    assert(msg == "two")
    assert((match_arm_exits(3) !? -1) == -3)
    assert((match_arm_exits(5) !? -1) == 1)
    let sum = 0
    let items = Array[int]{ 1, 2, 3, 4 }
    each items as it {
        let w = match it : int {
            2 => continue
            4 => break
            default => it
        }
        sum += w
    }
    assert(sum == 4)
}

test "Match on bool is exhaustive" {
    assert(match_bool(true) == 1)
    assert(match_bool(false) == 2)
    assert(match_bool_nullable(true) == 1)
    assert(match_bool_nullable(false) == 2)
    assert(match_bool_nullable(null) == 3)
}

enum MatchPatternColor { red, green, blue, yellow }

class MatchGuardCalls {
    count: uint (0)
    fn check(x: int) bool {
        this.count++
        return x > 0
    }
}
union MatchPatternShape: int | float | String | null {}
error MatchPatternError (busy, gone, broken)

fn match_pattern_kind(n: int) String {
    return match n : String {
        0 => "zero"
        1, 2, 3 => "small"
        // `start .. count`, like `each` and slices: 4 to 9
        4 .. 6 => "medium"
        _ if n < 0 => "negative"
        default => "big"
    }
}

fn match_pattern_warm(c: MatchPatternColor) bool {
    // Several enum items per case still make the match exhaustive
    return match c : bool {
        .red, .yellow => true
        .green, .blue => false
    }
}

fn match_pattern_shape(s: MatchPatternShape) String {
    return match s : String {
        null => "none"
        int as n if n > 100 => "big int " + n
        int, float => "number"
        String as t => "text " + t
    }
}

fn match_pattern_char(ch: u8) String {
    return match ch : String {
        'a' .. 26 => "lower"
        'A' .. 26, '0' .. 10 => "upper or digit"
        default => "other"
    }
}

fn match_pattern_fail(which: uint) !MatchPatternError {
    if which == 0 : throw .busy
    if which == 1 : throw .gone
    throw .broken
}

fn match_pattern_error(which: uint) String {
    match_pattern_fail(which) ! {
        return match E.code : String {
            E.busy, E.gone => "retry"
            E.broken => "fail"
        }
    }
    return "ok"
}

test "Match: several patterns, guards and ranges" {
    let kinds = Array[String]{}
    each Array[int]{ 0, 2, 3, 4, 9, 10, -4 } as n : kinds.append(match_pattern_kind(n))
    assert(kinds.join(",") == "zero,small,small,medium,medium,big,negative")
    assert(match_pattern_warm(.red) && match_pattern_warm(.yellow))
    assert(!match_pattern_warm(.green) && !match_pattern_warm(.blue))
    assert(match_pattern_shape(500) == "big int 500")
    assert(match_pattern_shape(5) == "number")
    assert(match_pattern_shape(2.5) == "number")
    assert(match_pattern_shape("hi") == "text hi")
    assert(match_pattern_shape(null) == "none")
    assert(match_pattern_char('q') == "lower")
    assert(match_pattern_char('Q') == "upper or digit")
    assert(match_pattern_char('7') == "upper or digit")
    assert(match_pattern_char('!') == "other")
    assert(match_pattern_error(0) == "retry")
    assert(match_pattern_error(1) == "retry")
    assert(match_pattern_error(2) == "fail")

    // A guard on a nullable subject; the guarded case does not count as handling 7
    let limit = 10
    let v: ?int = 7
    let seen = ""
    match v {
        null => seen = "null"
        7 if limit < 5 => seen = "small limit"
        7 => seen = "seven"
        default => seen = "other"
    }
    assert(seen == "seven")
    let none: ?int = null
    let none_seen = match none : String {
        null, 0 => "empty"
        default => "set"
    }
    assert(none_seen == "empty")

    // A guard only runs for a value that matched the pattern
    let calls = MatchGuardCalls {}
    let result = match 3 : String {
        1 if calls.check(1) => "one"
        3 if calls.check(3) => "three"
        default => "other"
    }
    assert(result == "three" && calls.count == 1)
}

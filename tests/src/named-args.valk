class NamedArgsCounter {
    n: int (0)
    fn next() int {
        this.n++
        return this.n
    }
}

fn named_args_box(width: int, height: int (10), label: String ("box")) String {
    return label + " " + width + "x" + height
}

fn named_args_sum(values: ...int) int {
    let total = 0
    each values as v : total += v
    return total
}

fn named_args_join(sep: String, parts: ...String) String {
    return parts.join(sep)
}

fn named_args_pair(a: int, b: int) String {
    return a + "," + b
}

class NamedArgsWindow {
    title: String ("")
    fn resize(width: uint, height: uint (100)) String {
        return this.title + ":" + width + "x" + height
    }
}

test "Calls: arguments by name" {
    assert(named_args_box(3) == "box 3x10")
    assert(named_args_box(3, label: "crate") == "crate 3x10")
    assert(named_args_box(height: 4, width: 2) == "box 2x4")
    assert(named_args_box(width: 1, label: "l", height: 2) == "l 1x2")
    let w = NamedArgsWindow { title: "w" }
    assert(w.resize(height: 5, width: 7) == "w:7x5")
    // Values named out of order are still evaluated in the order written
    let c = NamedArgsCounter {}
    assert(named_args_pair(b: c.next(), a: c.next()) == "2,1")
}

test "Calls: variadic parameters" {
    assert(named_args_sum() == 0)
    assert(named_args_sum(1, 2, 3) == 6)
    let nums = Array[int]{ 4, 5 }
    assert(named_args_sum(...nums) == 9)
    assert(named_args_join("-", "a", "b", "c") == "a-b-c")
    assert(named_args_join("+") == "")
    assert(named_args_join(sep: "/") == "")
}

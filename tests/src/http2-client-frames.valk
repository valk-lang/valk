use valk.http
use valk.net
use valk.time

// HTTP/2 client against a raw server that answers with frames written by hand

fn h2_raw_frame(out: ByteBuffer, kind: u8, flags: u8, stream: u32, payload: local &[u8]) {
    let length = payload.length
    out.write_byte((length >> 16).to(u8))
    out.write_byte((length >> 8).to(u8))
    out.write_byte(length.to(u8))
    out.write_byte(kind)
    out.write_byte(flags)
    out.write_u32_be(stream)
    out.write(payload)
}

// Answers the first request once its HEADERS frame arrived, then waits for the client to close
fn h2_raw_server(server: atomic net.TcpServer, frames: String) {
    let connection = server.accept(2000 * TIME_SCALE) ! return
    connection.read_timeout_ms = 5000 * TIME_SCALE
    let input = ByteBuffer.new()
    let buf = [u8]{ 0 x 4096 }
    let seen = false
    while !seen {
        let count = connection.read(buf) ! return
        if count == 0 : return
        input.write(buf.view(0, count))
        // Frames follow the 24-byte connection preface
        let pos: uint = 24
        while pos + 9 <= input.length {
            let length = (input.get(pos).to(uint) << 16) | (input.get(pos + 1).to(uint) << 8) | input.get(pos + 2).to(uint)
            if input.get(pos + 3) == 1 : seen = true
            pos += 9 + length
        }
    }
    connection.write(frames) ! return
    while true {
        let count = connection.read(buf) ! break
        if count == 0 : break
    }
    connection.close() _
}

test "HTTP2 client: END_STREAM on HEADERS still ends the stream after CONTINUATION" {
    let frames = ByteBuffer.new()
    h2_raw_frame(frames, 4, 0, 0, "")
    h2_raw_frame(frames, 4, 1, 0, "")
    // HEADERS with END_STREAM but without END_HEADERS, then the block in a CONTINUATION
    h2_raw_frame(frames, 1, 1, 1, "")
    let block = ByteBuffer.new()
    // `:status: 200` from the static table
    block.write_byte(0x88)
    h2_raw_frame(frames, 9, 4, 1, block)

    let server = net.tcp_server("127.0.0.1", 0) !!
    let address = server.local_address() !!
    let running = co h2_raw_server(server, frames.to_string())
    let response = http.get("http://127.0.0.1:" + address.port + "/", http.Options { http2: true, timeout_ms: 2000 * TIME_SCALE }) !? null
    await running
    server.close() _
    assert(isset(response))
    if !isset(response) : return
    assert(response.status == 200 && response.body == "")
}

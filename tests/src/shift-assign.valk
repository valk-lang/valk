class ShiftBox {
    bits: u8 (1)
}

test "Shift assignment: <<= and >>=" {
    let x = 1
    x <<= 3
    assert(x == 8)
    x >>= 2
    assert(x == 2)

    let neg = -16
    neg >>= 2
    assert(neg == -4)

    let box = ShiftBox {}
    box.bits <<= 7
    assert(box.bits == 128)

    let words = Array[u16]{ 1, 2 }
    words[1] <<= 4
    assert(words[1] == 32)

    // The count converts to the shifted type, like the right side of `+=`
    let count: u8 = 2
    let wide: u64 = 1
    wide <<= count
    assert(wide == 4)
}

shared shift_flags: u64 (1)

test "Shift assignment on shared storage" {
    shift_flags <<= 4
    shift_flags >>= 1
    assert(shift_flags == 8)
}

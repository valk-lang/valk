use valk.http
use valk.net

fn bad_header_handler(req: http.Request) http.Response {
    let marker = req.headers().get("x-marker") !? ""
    return http.Response.text("marker=" + marker)
}

fn bad_header_server() {
    let server = http.Server.new("127.0.0.1", 9024, bad_header_handler)
    server.start(1) ! return
}

fn bad_header_send(request: String) String {
    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9024) ! return ""
    connection.send_string(request, true) ! return ""
    let response = ByteBuffer.new(256)
    connection.recv(response, 256) ! return ""
    let text = response.to_string()
    connection.close() ! return text
    return text
}

fn bad_header_with_byte(prefix: String, byte: u8, suffix: String) String {
    let request = ByteBuffer.new(prefix.bytes + suffix.bytes + 1)
    request.write_string(prefix)
    request.write_byte(byte)
    request.write_string(suffix)
    return bad_header_send(request.into_string())
}

test "HTTP: ambiguous request syntax is rejected with 400" {
    co bad_header_server()

    let no_colon = bad_header_send("GET / HTTP/1.1\r\nHost: localhost\r\nnocolon\r\n\r\n")
    assert(no_colon.contains(" 400 "))

    let folded = bad_header_send("GET / HTTP/1.1\r\nHost: localhost\r\nX-Folded: a\r\n b\r\n\r\n")
    assert(folded.contains(" 400 "))

    let empty_name = bad_header_send("GET / HTTP/1.1\r\nHost: localhost\r\n:value\r\n\r\n")
    assert(empty_name.contains(" 400 "))

    let spaced_name = bad_header_send("GET / HTTP/1.1\r\nHost: localhost\r\nX Bad: 1\r\n\r\n")
    assert(spaced_name.contains(" 400 "))

    let bad_name = bad_header_send("GET / HTTP/1.1\r\nHost: localhost\r\nX@Bad: 1\r\n\r\n")
    assert(bad_name.contains(" 400 "))

    let bad_method = bad_header_send("GE(T / HTTP/1.1\r\nHost: localhost\r\n\r\n")
    assert(bad_method.contains(" 400 "))

    let absolute_target = bad_header_send("GET http://localhost/ HTTP/1.1\r\nHost: localhost\r\n\r\n")
    assert(absolute_target.contains(" 400 "))

    let fragment = bad_header_send("GET /path#fragment HTTP/1.1\r\nHost: localhost\r\n\r\n")
    assert(fragment.contains(" 400 "))

    let nul_target = bad_header_with_byte("GET /before", 0, "after HTTP/1.1\r\nHost: localhost\r\n\r\n")
    assert(nul_target.contains(" 400 "))

    let bad_percent = bad_header_send("GET /path\%Q0 HTTP/1.1\r\nHost: localhost\r\n\r\n")
    assert(bad_percent.contains(" 400 "))

    let bad_version = bad_header_send("GET / HTTP/1.0\r\nHost: localhost\r\n\r\n")
    assert(bad_version.contains(" 400 "))

    let duplicate_host = bad_header_send("GET / HTTP/1.1\r\nHost: localhost\r\nhOsT: example.com\r\n\r\n")
    assert(duplicate_host.contains(" 400 "))

    let empty_host = bad_header_send("GET / HTTP/1.1\r\nHost:\r\n\r\n")
    assert(empty_host.contains(" 400 "))

    let bad_host = bad_header_send("GET / HTTP/1.1\r\nHost: user@example.com\r\n\r\n")
    assert(bad_host.contains(" 400 "))

    let bad_hostname = bad_header_send("GET / HTTP/1.1\r\nHost: .localhost\r\n\r\n")
    assert(bad_hostname.contains(" 400 "))

    let ambiguous_ipv4 = bad_header_send("GET / HTTP/1.1\r\nHost: 0127.0.0.1\r\n\r\n")
    assert(ambiguous_ipv4.contains(" 400 "))

    let bad_port = bad_header_send("GET / HTTP/1.1\r\nHost: localhost:65536\r\n\r\n")
    assert(bad_port.contains(" 400 "))

    let empty_port = bad_header_send("GET / HTTP/1.1\r\nHost: localhost:\r\n\r\n")
    assert(empty_port.contains(" 400 "))

    let bad_ipv6 = bad_header_send("GET / HTTP/1.1\r\nHost: [:::]\r\n\r\n")
    assert(bad_ipv6.contains(" 400 "))

    let nul_value = bad_header_with_byte("GET / HTTP/1.1\r\nHost: localhost\r\nX-Test: before", 0, "after\r\n\r\n")
    assert(nul_value.contains(" 400 "))

    let del_value = bad_header_with_byte("GET / HTTP/1.1\r\nHost: localhost\r\nX-Test: before", 127, "after\r\n\r\n")
    assert(del_value.contains(" 400 "))

    let long_nul_value = bad_header_with_byte("GET / HTTP/1.1\r\nHost: localhost\r\nX-Test: 0123456789abcdef", 0, "after\r\n\r\n")
    assert(long_nul_value.contains(" 400 "))

    let tab_value = bad_header_send("GET / HTTP/1.1\r\nHost: localhost\r\nX-Test: before\tafter\r\n\r\n")
    assert(tab_value.contains(" 200 "))

    let bare_lf = bad_header_send("GET / HTTP/1.1\r\nHost: localhost\r\nX-Test: before\nafter\r\n\r\n")
    assert(bare_lf.contains(" 400 "))

    let empty_value = bad_header_send("GET / HTTP/1.1\r\nHost: localhost\r\nX-Marker:\r\n\r\n")
    assert(empty_value.contains(" 200 "))
    assert(empty_value.contains("marker="))

    let spaces_only = bad_header_send("GET / HTTP/1.1\r\nHost: localhost\r\nX-Marker:   \r\n\r\n")
    assert(spaces_only.contains(" 200 "))
    assert(spaces_only.contains("marker="))
    assert(!spaces_only.contains("marker= "))

    let valid = bad_header_send("GET / HTTP/1.1\r\nHost: localhost\r\nX-Marker: alive\r\n\r\n")
    assert(valid.contains(" 200 "))
    assert(valid.contains("marker=alive"))

    let valid_port = bad_header_send("GET /ok%20path?x=1 HTTP/1.1\r\nHost: localhost:9024\r\n\r\n")
    assert(valid_port.contains(" 200 "))

    let valid_ipv4 = bad_header_send("GET / HTTP/1.1\r\nHost: 127.0.0.1:9024\r\n\r\n")
    assert(valid_ipv4.contains(" 200 "))

    let encoded_slash = bad_header_send("GET /a%2Fb HTTP/1.1\r\nHost: localhost\r\n\r\n")
    assert(encoded_slash.contains(" 200 "))

    let valid_ipv6 = bad_header_send("GET / HTTP/1.1\r\nHost: [::1]:80\r\n\r\n")
    assert(valid_ipv6.contains(" 200 "))

    let valid_ipv4_in_ipv6 = bad_header_send("GET / HTTP/1.1\r\nHost: [::ffff:192.0.2.1]\r\n\r\n")
    assert(valid_ipv4_in_ipv6.contains(" 200 "))

    let options = bad_header_send("OPTIONS * HTTP/1.1\r\nHost: localhost\r\n\r\n")
    assert(options.contains(" 200 "))
}

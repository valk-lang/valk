use valk.http
use valk.time

fn cookie_echo_handler(req: http.Request) http.Response {
    let cookies = req.cookies()
    if req.path == "/count" : return http.Response.text(cookies.length)
    if req.path == "/one" {
        let name = req.query().get("name") !? ""
        let found = req.cookie(name) ! return http.Response.text("<missing>")
        return http.Response.text(found)
    }
    return http.Response.text("?")
}

fn read_cookie(base: String, header: String, name: String) String {
    let sent = http.Headers.new()
    sent.set("Cookie", header)
    let res = http.get(base + "/one?name=" + name, http.Options { headers: sent }) !!
    return res.body
}

test "HTTP cookies: reading a Cookie header" {
    let server = http.Server.new("127.0.0.1", 19471, cookie_echo_handler)
    let running = co server.start(1)
    time.sleep_ms(20)
    let base = "http://127.0.0.1:19471"

    let header = "session=YWJjZA==; theme=dark; note=\"a, b\"; empty=; broken"
    // A base64 value keeps its padding: only the first '=' separates name from value
    assert(read_cookie(base, header, "session") == "YWJjZA==")
    assert(read_cookie(base, header, "theme") == "dark")
    // Double quotes hold a space or a comma, and are not part of the value
    assert(read_cookie(base, header, "note") == "a, b")
    assert(read_cookie(base, header, "empty") == "")
    // A part without '=' is not a cookie
    assert(read_cookie(base, header, "broken") == "<missing>")
    assert(read_cookie(base, header, "absent") == "<missing>")

    let sent = http.Headers.new()
    sent.set("Cookie", header)
    assert((http.get(base + "/count", http.Options { headers: sent }) !!).body == "4")
    // A request without the header has no cookies
    assert((http.get(base + "/count") !!).body == "0")
    // The most specific path comes first, and is the one kept
    assert(read_cookie(base, "a=deep; a=shallow", "a") == "deep")

    server.request_shutdown(1000)
    await running !!
}

test "HTTP cookies: writing a Set-Cookie header" {
    let cookie = http.Cookie.new("session", "abc")
    // Safe by default: out of reach of scripts, and not sent along by another site
    assert(cookie.to_header() == "session=abc; Path=/; HttpOnly; SameSite=Lax")

    cookie.secure = true
    cookie.max_age = 3600
    cookie.domain = "example.com"
    cookie.path = "/account"
    cookie.same_site = http.SameSite.strict
    assert(cookie.to_header() == "session=abc; Path=/account; Domain=example.com; Max-Age=3600; Secure; HttpOnly; SameSite=Strict")

    let open = http.Cookie.new("theme", "dark")
    open.http_only = false
    open.same_site = http.SameSite.none
    open.expires = time.DateTime.from_unix_seconds(784111777) !!
    assert(open.to_header() == "theme=dark; Path=/; Expires=Sun, 06 Nov 1994 08:49:37 GMT; SameSite=None")

    // A value with a space or a comma is quoted, and survives a round trip
    let spaced = http.Cookie.new("note", "a, b")
    assert(spaced.to_header().contains("note=\"a, b\""))

    // A name or value a header cannot carry gives no header at all
    let broken = http.Cookie.new("session", "a;b")
    assert(!broken.is_valid() && broken.to_header() == "")
    assert(!http.Cookie.new("bad name", "x").is_valid())
    assert(!http.Cookie.new("", "x").is_valid())
    assert(http.Cookie.new("session", "").is_valid())
}

test "HTTP cookies: dates" {
    let date = time.DateTime.from_unix_seconds(784111777) !!
    assert(http.format_date(date) == "Sun, 06 Nov 1994 08:49:37 GMT")
    assert(http.format_date(time.DateTime.from_unix_seconds(0) !!) == "Thu, 01 Jan 1970 00:00:00 GMT")

    let read = http.parse_date("Sun, 06 Nov 1994 08:49:37 GMT") !!
    assert(read.unix_seconds() == 784111777)
    assert(http.format_date(read) == "Sun, 06 Nov 1994 08:49:37 GMT")

    let failed = false
    http.parse_date("Sunday, 06-Nov-94 08:49:37 GMT") ! { failed = true }
    assert(failed)
    failed = false
    http.parse_date("Sun, 06 Xyz 1994 08:49:37 GMT") ! { failed = true }
    assert(failed)
}

test "HTTP cookies: reading a Set-Cookie header" {
    let cookie = http.Cookie.parse("session=abc; Path=/account; Domain=.example.com; Max-Age=60; Secure; HttpOnly; SameSite=Strict") !!
    assert(cookie.name == "session" && cookie.value == "abc")
    assert(cookie.path == "/account")
    assert((cookie.domain ?? "") == "example.com")
    assert((cookie.max_age ?? 0) == 60)
    assert(cookie.secure && cookie.http_only)
    assert(cookie.same_site == http.SameSite.strict)

    let dated = http.Cookie.parse("a=1; Expires=Sun, 06 Nov 1994 08:49:37 GMT") !!
    assert((dated.expires ?? time.DateTime.now()).unix_seconds() == 784111777)

    // An attribute this package does not know, and an Expires it cannot read, are skipped
    let odd = http.Cookie.parse("a=1; Priority=High; Expires=nonsense") !!
    assert(odd.name == "a" && !isset(odd.expires))

    let failed = false
    http.Cookie.parse("nonsense") ! { failed = true }
    assert(failed)
}

fn cookie_handler(req: http.Request) http.Response {
    if req.path == "/set" {
        let res = http.Response.text("set")
        let session = http.Cookie.new("session", req.query().get("id") !? "none")
        session.secure = true
        session.max_age = 600
        res.set_cookie(session)
        let theme = http.Cookie.new("theme", "dark")
        theme.http_only = false
        res.set_cookie(theme)
        return res
    }
    if req.path == "/clear" {
        let res = http.Response.text("cleared")
        res.clear_cookie("session")
        return res
    }
    return http.Response.text((req.cookies().get("session") !? "-") + "|" + (req.cookies().get("theme") !? "-"))
}

test "HTTP cookies: through a server" {
    let server = http.Server.new("127.0.0.1", 19470, cookie_handler)
    let running = co server.start(1)
    time.sleep_ms(20)
    let base = "http://127.0.0.1:19470"

    let set = http.get(base + "/set?id=abc123") !!
    let cookies = set.cookies()
    assert(cookies.length == 2)
    let session = cookies.get(0) !!
    assert(session.name == "session" && session.value == "abc123")
    assert(session.secure && session.http_only && (session.max_age ?? 0) == 600)
    assert(!(cookies.get(1) !!).http_only)

    // Send them back the way a browser would
    let sent = http.Headers.new()
    sent.set("Cookie", "session=abc123; theme=dark")
    let options = http.Options { headers: sent }
    assert((http.get(base + "/read", options) !!).body == "abc123|dark")

    let cleared = http.get(base + "/clear") !!
    let gone = (cleared.cookies().get(0) !!)
    assert(gone.name == "session" && gone.value == "")
    assert((gone.max_age ?? -1) == 0)
    assert(http.format_date(gone.expires ?? time.DateTime.now()) == "Thu, 01 Jan 1970 00:00:00 GMT")

    server.request_shutdown(1000)
    await running !!
}

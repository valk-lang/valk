@ignore_access

use valk.core
use valk.gc
use valk.io
use valk.thread
use valk.time

#if OS == "linux" || OS == "macos"
synctest "Mutex: native waits retry nonblocking pipes and permit shared GC" {
    let mutex: shared core.Mutex = .new() !!
    io.set_nonblocking(mutex.pipe[0], true) !!
    mutex.lock()
    let worker = thread.start(fn() {
        time.sleep_ms(20)
        gc.collect_shared()
        mutex.unlock()
    }) !!
    assert(mutex.read_token_sync())
    // Taking the token directly skips `lock`, which also marks the mutex held
    mutex.held = 1
    mutex.unlock()
    worker.await()
    mutex.lock()
    mutex.unlock()
}

class MutexNativeProgress { finished: uint (0) }

synctest "Mutex: thread shutdown waits for the shared registry lock" {
    let gate: shared core.Mutex = .new() !!
    let progress: shared MutexNativeProgress = .{}
    gate.lock()
    let worker = thread.start(fn() {
        gate.await_unlock()
        progress.finished = 1
    }) !!
    #if OS == "linux"
    // Match macOS's mutex pipe mode for the native thread-exit path.
    io.set_nonblocking(thread.threads.mutex.pipe[0], true) !!
    #end
    lock thread.threads as list {
        gate.unlock()
        while progress.finished == 0 : time.sleep_ms(1)
        time.sleep_ms(20)
        assert(list.length > 0)
    }
    worker.await()
    #if OS == "linux"
    io.set_nonblocking(thread.threads.mutex.pipe[0], false) !!
    #end
    assert(progress.finished == 1)
}
#end

class MutexProbe {
    entered: uint (0)
}

fn mutex_probe_take(mutex: core.Mutex, state: MutexProbe) {
    mutex.lock()
    state.entered++
}

test "Mutex: unlocking an unlocked mutex does nothing" {
    let mutex = core.Mutex.new() !!
    mutex.unlock()
    mutex.unlock()
    mutex.lock()

    let state = MutexProbe {}
    let first = co mutex_probe_take(mutex, state)
    let second = co mutex_probe_take(mutex, state)
    time.sleep_ms(20)
    // The extra unlocks did not leave tokens behind for the waiters
    assert(state.entered == 0)

    mutex.unlock()
    time.sleep_ms(20)
    assert(state.entered == 1)
    mutex.unlock()
    await first
    await second
    assert(state.entered == 2)
    mutex.unlock()
    mutex.unlock()
    mutex.lock()
    mutex.unlock()
}

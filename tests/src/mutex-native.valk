@ignore_access

use valk.core
use valk.gc
use valk.thread
use valk.time

synctest "Mutex: a native wait lets a shared GC run" {
    let mutex: shared core.Mutex = .new() !!
    mutex.lock()
    let worker = thread.start(fn() {
        time.sleep_ms(20)
        gc.collect_shared()
        mutex.unlock()
    }) !!
    // Outside a coroutine: blocks this thread without holding the GC lock
    mutex.lock()
    mutex.unlock()
    worker.await()
    mutex.lock()
    mutex.unlock()
}

class MutexNativeProgress { finished: uint (0) }

synctest "Mutex: thread shutdown waits for the shared registry lock" {
    let gate: shared core.Mutex = .new() !!
    let progress: shared MutexNativeProgress = .{}
    gate.lock()
    let worker = thread.start(fn() {
        gate.await_unlock()
        progress.finished = 1
    }) !!
    lock thread.threads as list {
        gate.unlock()
        while progress.finished == 0 : time.sleep_ms(1)
        time.sleep_ms(20)
        assert(list.length > 0)
    }
    worker.await()
    assert(progress.finished == 1)
}

class MutexProbe {
    entered: uint (0)
}

fn mutex_probe_take(mutex: core.Mutex, state: MutexProbe) {
    mutex.lock()
    state.entered++
}

test "Mutex: unlocking an unlocked mutex does nothing" {
    let mutex = core.Mutex.new() !!
    mutex.unlock()
    mutex.unlock()
    mutex.lock()

    let state = MutexProbe {}
    let first = co mutex_probe_take(mutex, state)
    let second = co mutex_probe_take(mutex, state)
    time.sleep_ms(20)
    // The extra unlocks did not leave tokens behind for the waiters
    assert(state.entered == 0)

    mutex.unlock()
    time.sleep_ms(20)
    assert(state.entered == 1)
    mutex.unlock()
    await first
    await second
    assert(state.entered == 2)
    mutex.unlock()
    mutex.unlock()
    mutex.lock()
    mutex.unlock()
}

// `==` and `!=` (and ordering hooks) on locked and shared views

struct LeNamed {
    name: String
    nums: Array[uint]
}

struct LeWords {
    a: uint
    b: uint
}

class LeScore {
    n: uint
    + fn same(o: LeScore) bool $eq { return this.n == o.n }
    + fn less(o: LeScore) bool $lt { return this.n < o.n }
}

class LeState {
    numbers: Array[uint] (.{})
    other: Array[uint] (.{})
    nested: Array[Array[uint]] (.{})
    names: Array[String] (.{})
    name: String ("ab")
    map: HashMap[String, uint] (.{})
    m: Map[uint] (.{})
    set: HashSet[uint] (.{})
    set2: HashSet[uint] (.{})
    flat: FlatMap[String, uint] (.{})
    dq: Deque[uint] (.{})
    named: LeNamed (LeNamed { name: "x", nums: .{ 1 } })
    words: LeWords (LeWords { a: 1, b: 2 })
    low: LeScore (LeScore { n: 1 })
    high: LeScore (LeScore { n: 2 })
    opt: ?Array[uint] (null)
}

test "Locked equality: arrays with literals, plain and locked arrays" {
    let state: shared Lock[LeState] = .new(LeState {}) !!
    let plain = Array[uint]{ 1 }
    lock state as t {
        t.numbers.append(1)
        t.other.append(1)
        assert(t.numbers == .{ 1 })
        assert(!(t.numbers != .{ 1 }))
        assert(t.numbers != .{ 2 })
        assert(t.numbers != .{ 1, 1 })
        assert(Array[uint]{ 1 } == t.numbers)
        assert(t.numbers == plain)
        assert(plain == t.numbers)
        assert(!(t.numbers != plain))
        assert(!(plain != t.numbers))
        assert(t.numbers == t.other)
        t.other.append(2)
        assert(t.numbers != t.other)
        assert(t.other != t.numbers)

        t.nested.append(.{ 1, 2 })
        assert(t.nested == .{ .{ 1, 2 } })
        assert(t.nested != .{ .{ 1 } })
        t.names.append("a")
        assert(t.names == .{ "a" })
        assert(t.name == "ab")
        assert("ab" == t.name)

        assert(t.opt == null)
        assert(t.opt != .{ 1 })
        t.opt = .{ 1 }
        assert(t.opt == .{ 1 })
        assert(t.opt == t.numbers)
        assert(t.opt == plain)
    }
}

test "Locked equality: sets, maps, deques and structs" {
    let state: shared Lock[LeState] = .new(LeState {}) !!
    let pset = HashSet[uint]{ 1, 2 }
    let pnamed = LeNamed { name: "x", nums: .{ 1 } }
    let pmap = HashMap[String, uint]{}
    lock state as t {
        t.set.add(1)
        t.set.add(2)
        t.set2.add(2)
        t.set2.add(1)
        assert(t.set == pset)
        assert(pset == t.set)
        assert(t.set == t.set2)
        assert(t.set == .{ 1, 2 })
        assert(t.set != .{ 1 })
        // Collections without an `$eq` hook compare by identity
        assert(t.map == t.map)
        assert(t.map != pmap)
        assert(pmap != t.map)
        assert(t.m == t.m)
        assert(t.flat == t.flat)
        assert(t.dq == t.dq)
        assert(t.named == pnamed)
        assert(pnamed == t.named)
        assert(t.words == LeWords { a: 1, b: 2 })
        assert(t.words != LeWords { a: 1, b: 3 })
    }
}

test "Locked equality: user compare hooks" {
    let state: shared Lock[LeState] = .new(LeState {}) !!
    let two = LeScore { n: 2 }
    lock state as t {
        assert(t.low != two)
        assert(two == t.high)
        assert(t.low < t.high)
        assert(t.high > t.low)
        assert(two <= t.high)
        assert(!(t.low >= two))
    }
}

test "Shared equality: arrays and sets with plain values and literals" {
    let plain = Array[uint]{ 1 }
    let sh: shared Array[uint] = .{ 1 }
    let sh2: shared Array[uint] = .{ 1 }
    assert(sh == .{ 1 })
    assert(sh != .{ 2 })
    assert(sh == plain)
    assert(plain == sh)
    assert(sh == sh2)
    assert(!(sh != sh2))
    let pset = HashSet[uint]{ 1, 2 }
    let shs: shared HashSet[uint] = .{ 2, 1 }
    assert(shs == pset)
    assert(pset == shs)

    let state: shared Lock[LeState] = .new(LeState {}) !!
    lock state as t {
        t.numbers.append(1)
        assert(t.numbers == sh)
        assert(sh == t.numbers)
    }
}

@ignore_access

use valk.regex

// The DFAs find match extents; the Pike VM is the reference they must agree with

class RegexDfaRng {
    state: uint
    fn below(n: uint) uint {
        let x = this.state
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        this.state = x
        return x % n
    }
}

fn regex_dfa_pattern(r: RegexDfaRng, out: ByteBuffer, depth: uint) {
    let atoms = Array[String]{ "a", "b", "A", "_", " ", "\\n", "é", "[ab]", "[^a\\n]", "[a-cé]", ".", "\\w", "\\d", "\\b", "\\B", "^", "$", "@", "#@", "s" }
    let parts = 1 + r.below(3)
    let i: uint = 0
    while i < parts {
        let k = r.below(8)
        if depth < 2 && k == 0 {
            out.write(r.below(2) == 0 ? "(" : "(?:")
            regex_dfa_pattern(r, out, depth + 1)
            out.write("|")
            regex_dfa_pattern(r, out, depth + 1)
            out.write(")")
        } else {
            out.write(atoms[r.below(atoms.length)])
        }
        let q = r.below(10)
        if q == 0 : out.write("*")
        else if q == 1 : out.write("+")
        else if q == 2 : out.write("?")
        else if q == 3 : out.write("{1,3}")
        else if q == 4 : out.write("*?")
        i++
    }
}

// Short texts, and now and then a long one for the 16-byte skipping scans
fn regex_dfa_text(r: RegexDfaRng) String {
    let out = ByteBuffer.new(32)
    let n = r.below(4) == 0 ? 16 + r.below(60) : r.below(24)
    let i: uint = 0
    while i < n {
        let k = r.below(14)
        if k < 7 : out.write_byte("ab_A 1\n"[k])
        else if k < 9 : out.write("é")
        else if k == 9 : out.write_byte(0xFF)
        else if k == 10 : out.write_byte('@')
        else if k == 11 : out.write("Sſ#")
        else : out.write_byte('a')
        i++
    }
    return out.to_string()
}

// Every match of find_all, found by the VM alone
fn regex_vm_all(re: regex.Regex, text: String) Array[uint] {
    let out = Array[uint]{}
    let pos: uint = 0
    while pos <= text.bytes {
        if re.anchored && pos > 0 : break
        let slots = re.run_vm(text, pos, re.anchored) ?! break
        each slots as v : out.append(v)
        pos = slots[1]
        if slots[1] == slots[0] : pos += regex.char_width(text, pos)
    }
    return out
}

fn regex_dfa_all(re: regex.Regex, text: String) Array[uint] {
    let out = Array[uint]{}
    each re.find_all(text) as m {
        each m.slots as v : out.append(v)
    }
    return out
}

fn regex_same(a: Array[uint], b: Array[uint]) bool {
    if a.length != b.length : return false
    each a as v, i {
        if v != b[i] : return false
    }
    return true
}

test "Regex: the DFA search agrees with the VM on random patterns and texts" {
    let r = RegexDfaRng { state: 88172645463325252 }
    let flags = Array[String]{ "", "i", "m", "s" }
    let failure = ""
    let n: uint = 0
    while n < 300 && failure == "" {
        let buf = ByteBuffer.new(32)
        regex_dfa_pattern(r, buf, 0)
        let pattern = buf.to_string()
        let flag = flags[r.below(flags.length)]
        let re = regex.Regex.new(pattern, flag) ! {
            n++
            continue
        }
        let t: uint = 0
        while t < 4 {
            let text = regex_dfa_text(r)
            if !regex_same(regex_dfa_all(re, text), regex_vm_all(re, text)) : failure = "find_all: /" + pattern + "/" + flag + " on " + text.escape()
            if re.is_match(text) != isset(re.run_vm(text, 0, re.anchored)) : failure = "is_match: /" + pattern + "/" + flag + " on " + text.escape()
            let at = r.below(text.bytes + 1)
            let dfa = re.run(text, at, true)
            let vm = re.run_vm(text, at, true)
            if isset(dfa) != isset(vm) : failure = "match_at " + at + ": /" + pattern + "/" + flag + " on " + text.escape()
            t++
        }
        n++
    }
    if failure != "" : println(failure)
    assert(failure == "")
}

test "Regex: a DFA with too many states resets and falls back to the VM" {
    let state: uint = 7
    let buf = ByteBuffer.new(40_000)
    let i: uint = 0
    while i < 30_000 {
        state = state * 6364136223846793005 + 1442695040888963407
        buf.write_byte((state >> 60) % 2 == 0 ? 'a' : 'b')
        if (state >> 50) % 97 == 0 : buf.write_byte('\n')
        i++
    }
    let text = buf.to_string()
    let failure = ""
    each Array[String]{ "[ab]*a[ab]{12}", "(?m)^[ab]*?a[ab]{11}$", "a[ab]{10}b|b[ab]{9}a" } as pattern {
        let re = regex.Regex.new(pattern) ! {
            failure = "bad pattern " + pattern
            break
        }
        if !regex_same(regex_dfa_all(re, text), regex_vm_all(re, text)) : failure = pattern
    }
    if failure != "" : println(failure)
    assert(failure == "")
}

test "Regex: a match never starts inside a multi-byte character" {
    // é is C3 A9: between its bytes `\B` holds, and a stray A9 reads as ©
    let copyright = regex.Regex.new("\\B©") ! { assert(false) return }
    assert(!isset(copyright.find("_é")) && !isset(copyright.run_vm("_é", 0, false)))
    let inner = regex.Regex.new("\\B") ! { assert(false) return }
    let starts = Array[uint]{}
    each inner.find_all("aé.xx") as m : starts.append(m.start)
    let vm = regex_vm_all(inner, "aé.xx")
    assert(regex_same(starts, Array[uint]{ 3, 5 }) && regex_same(vm, Array[uint]{ 3, 3, 5, 5 }))
}

// Every search form of the DFA path against the VM on one pattern and text
fn regex_agrees(pattern: String, flags: String, text: String) bool {
    let re = regex.Regex.new(pattern, flags) ! return false
    if !regex_same(regex_dfa_all(re, text), regex_vm_all(re, text)) : return false
    if re.is_match(text) != isset(re.run_vm(text, 0, re.anchored)) : return false
    let at: uint = 0
    while at <= text.bytes {
        if isset(re.run(text, at, true)) != isset(re.run_vm(text, at, true)) : return false
        at++
    }
    return true
}

test "Regex: searches that jump between occurrences of an inner literal" {
    // The prefix cannot consume the literal: the first occurrence after the search start
    // bounds the match, occurrences inside a suffix belong to the match before them
    assert(regex_agrees("[a-z]+@[^ ]+", "", "ab@cd@ef gh@ij @@x@y zz@"))
    assert(regex_agrees("[a-z]+@[a-z]+", "", "@a@ b@@c @d@e@f@ ghi@jkl@mno"))
    // The forward read fails after passing later occurrences: the plain search takes over
    assert(regex_agrees("[a-z]+@[^!\\n]*!", "", "a@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb c@d\nzz x@y! q@r"))
    // A literal that overlaps itself, and one of two bytes
    assert(regex_agrees("[0-9]+aa[0-9]*", "", "1aaa2 aa3 4aaaa 5aa6"))
    assert(regex_agrees("\\w+#@\\w*", "", "x#@y ##@ #@#@ a#@#@b"))
    // Assertions and multi-line anchors around the prefix
    assert(regex_agrees("\\b\\w+@\\w+\\b", "", "é@x me@home.a @@ 1@2"))
    assert(regex_agrees("^\\s*#.*", "m", "  # one\n#two\nx # three\n\n#"))
    assert(regex_agrees("[a-z]*@[a-z]*", "", "@@@ a@ @b"))
    // Case folding keeps the inner literal out: `s` folds to `ſ` as well
    assert(regex_agrees("[a-z]+@s", "i", "ab@S cd@ſ ef@s"))
    // An anchored pattern and an anchored search do not jump
    assert(regex_agrees("^[a-z]+@[a-z]+", "", "ab@cd ef@gh"))
}

test "Regex: two-byte start filters on alternations" {
    let long = "The Googlebot crawled; a scanner and a Spider were indexing; robots and crawlers; ſcanner too. bot"
    assert(regex_agrees("(?i)bot|crawler|scanner|spider|indexing|crawl|robot", "", long))
    assert(regex_agrees("bot|crawler|scanner|spider|indexing|crawl|robot", "", long))
    assert(regex_agrees("(?i)/login|/signin", "", "GET /Login x /signin /SIGNIN/ /log"))
    // More alternatives than buckets, and matches in the final 16 bytes of the text
    assert(regex_agrees("a1|b2|c3|d4|e5|f6|g7|h8|i9|j0|k1", "", "xx a1 xx b2 xx c3 xx d4 xx e5 xx f6 xx g7 xx h8 xx i9 xx j0 xx k1 x"))
    assert(regex_agrees("a1|b2|c3|d4|e5|f6|g7|h8|i9|j0|k1", "", "nothing here but filler text that is long enough to scan twice over"))
    // Sets and repeats after the first character, and a non-ASCII first character
    assert(regex_agrees("[st][ab]+x|q\\d", "", "sa sabx tbbx q9 saq1 tttx sax"))
    assert(regex_agrees("é[a-z]|ab", "", "xx éa xx ab xx é1 xx éz"))
}

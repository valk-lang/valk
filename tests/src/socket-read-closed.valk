use valk.net
use valk.io

// Reads until the peer closes; returns everything received plus the end reason
fn read_closed_server(listener: shared net.SocketServer) String {
    let con = listener.accept(3000) ! return "accept failed"
    let buffer = [u8]{ 0 x 64 }
    let out = ByteBuffer.new()
    while true {
        let bytes = con.read(buffer) ! {
            if error_is(E.code, closed) : out.write("|closed")
            else : out.write("|error")
            break
        }
        out.write(buffer.view(0, bytes))
    }
    con.close() ! {}
    return out.to_string()
}

test "Connection.read throws closed when the peer closes" {
    let listener = net.Socket.server(net.SocketType.tcp, "127.0.0.1", 9097) !!
    let server = co read_closed_server(listener)
    let client = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9097) !!
    client.write("PING") !!
    client.close() !!
    assert(await server == "PING|closed")
    listener.close() !!
}

test "io.copy treats a closed connection as the end of input" {
    let listener = net.Socket.server(net.SocketType.tcp, "127.0.0.1", 9098) !!
    let client = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9098) !!
    let con = listener.accept(3000) !!
    client.write("abc") !!
    client.close() !!
    let out = ByteBuffer.new()
    let copied = io.copy(con, out) !? 999
    assert(copied == 3)
    assert(out.to_string() == "abc")
    con.close() !!
    listener.close() !!
}

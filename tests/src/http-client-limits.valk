use valk.fs
use valk.http
use valk.net
use valk.time

global response_limit_server_ready: u16 (0)

fn response_limit_server(port: u16, response: String) {
    let server = net.Socket.server(net.SocketType.tcp, "127.0.0.1", port) ! return
    response_limit_server_ready = port
    let connection = server.accept() ! return
    let request = ByteBuffer.new(2048)
    connection.recv(request, 2048) ! return
    connection.send_bytes(response.data, response.bytes, true) ! return
    time.sleep_ms(40)
    connection.close() ! return
    server.close() ! return
}

fn response_limit_wait_for_server(port: u16) bool {
    let deadline = time.mono_ms() + 2000
    while response_limit_server_ready != port {
        if time.mono_ms() >= deadline : return false
        time.sleep_ms(1)
    }
    return true
}

fn response_limit_rejected(port: u16, response: String, options: http.Options) bool {
    response_limit_server_ready = 0
    co response_limit_server(port, response)
    if !response_limit_wait_for_server(port) : return false
    http.request("GET", "http://127.0.0.1:" + port.to_string() + "/", options) ! {
        return E.code == E.response_too_large
    }
    return false
}

fn response_limit_body(port: u16, method: String, response: String, options: http.Options) String {
    response_limit_server_ready = 0
    co response_limit_server(port, response)
    if !response_limit_wait_for_server(port) : return "ERROR"
    let result = http.request(method, "http://127.0.0.1:" + port.to_string() + "/", options) ! return "ERROR"
    return result.body
}

test "HTTP client bounds response headers and every body framing" {
    let defaults = http.Options {}
    assert(defaults.max_response_header_size == 8 * 1024)
    assert(defaults.max_response_body_size == 32 * 1024 * 1024)

    let body_limit = http.Options { max_response_body_size: 4 }
    assert(response_limit_rejected(9050,
        "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello", body_limit))
    assert(response_limit_rejected(9051,
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n",
        body_limit))
    assert(response_limit_rejected(9052,
        "HTTP/1.1 200 OK\r\n\r\nhello", body_limit))

    let header_limit = http.Options { max_response_header_size: 40 }
    assert(response_limit_rejected(9053,
        "HTTP/1.1 200 OK\r\nX-Large: abcdefghijklmnopqrstuvwxyz\r\nContent-Length: 0\r\n\r\n",
        header_limit))

    assert(response_limit_body(9054, "GET",
        "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello",
        http.Options { max_response_body_size: 5 }) == "hello")
    assert(response_limit_body(9055, "HEAD",
        "HTTP/1.1 200 OK\r\nContent-Length: 999999\r\n\r\n",
        body_limit) == "")

    let chunk_body = "".pad_right('x', 80)
    assert(response_limit_body(9058, "GET",
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n50\r\n"
            + chunk_body + "\r\n0\r\nX-Trailer: yes\r\n\r\n",
        http.Options { max_response_header_size: 80, max_response_body_size: 80 }) == chunk_body)
    assert(response_limit_rejected(9059,
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n1\r\nx\r\n0\r\nX-Trailer: yes\r\n\r\n",
        http.Options { max_response_header_size: 55 }))
}

test "HTTP download streams with a configurable response limit" {
    let path = fs.add(fs.exe_dir() !? "", "http-client-limit.tmp")
    if fs.exists(path) : fs.delete(path) ! assert(false)

    response_limit_server_ready = 0
    co response_limit_server(9056, "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello")
    assert(response_limit_wait_for_server(9056))
    let rejected = false
    http.download("http://127.0.0.1:9056/", path, "GET",
        http.Options { max_response_body_size: 4 }) ! {
        rejected = E.code == E.response_too_large
    }
    assert(rejected)

    response_limit_server_ready = 0
    co response_limit_server(9057, "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello")
    assert(response_limit_wait_for_server(9057))
    http.download("http://127.0.0.1:9057/", path, "GET",
        http.Options { max_response_body_size: 0 }) ! assert(false)
    assert((fs.read(path) !? "") == "hello")
    fs.delete(path) ! assert(false)
}

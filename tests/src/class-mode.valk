test "Class mode compatibility" {
    let x : Map[uint] = HashMap[String, uint]{}
    x.set("x", 1)
}

extend Array[T] {
    + fn test_last() ?T { return this.get(this.length - 1) !? null }
}
extend X[T] {
    fn test_first() ?T { return this.get(0) !? null }
}

mode X[T] for Array[T] {
    get size : uint { return this.length + 100 }
}

struct ModeStruct {
    first: uint
    second: uint
}

type ModeStructValue (ModeStruct)
type ModeStructPointer (*ModeStruct)

fn mode_type_is_gc[T]() bool {
    #if T.$is_gc
    return true
    #else
    return false
    #end
}

test "Class mode" {
    assert(mode_type_is_gc[X[String]]())
    let x : X[String] = X[String].new()
    let y : Array[String] = x
    assert(x.size == 100)
    assert(y.length == 0)
    x.append("hi")
    assert(x.size == 101)
    assert(y.length == 1)
    let z = x + y
    assert(z.length == 2)
    assert((x.test_first() ?? "") == "hi")
    assert((x.test_last() ?? "") == "hi")
    assert((y.test_last() ?? "") == "hi")
}

test "Type aliases preserve struct representation" {
    assert(size_of(ModeStructValue) == size_of(ModeStruct))
    assert(size_of(ModeStructPointer) == size_of(ptr))
}

mode ModeScores for Array[int] {
    fn total() int {
        let sum = 0
        each this as v : sum += v
        return sum
    }
}

extend X[T] {
    fn test_joined() String {
        let out = ""
        each this as v, i : out += "%i=%v "
        return out
    }
}

test "each over a mode of Array reads its elements" {
    let scores = ModeScores{ 3, 8, 5 }
    assert(scores.total() == 16)
    let seen = Array[int]{}
    each scores as v : seen.append(v)
    assert(seen == Array[int]{ 3, 8, 5 })
    let x : X[String] = X[String].new()
    x.append("a")
    x.append("b")
    assert(x.test_joined() == "0=a 1=b ")
}


test "Class mode compatibility" {
    let x : Map[uint] = HashMap[String, uint]{}
    x.set("x", 1)
}

extend Array[T] {
    + fn test_last() ?T { return this.get(this.length - 1) !? null }
}
extend X[T] {
    fn test_first() ?T { return this.get(0) !? null }
}

mode X[T] for Array[T] {
    get size : uint { return this.length + 100 }
}

fn mode_type_is_gc[T]() bool {
    #if T.$is_gc
    return true
    #else
    return false
    #end
}

test "Class mode" {
    assert(mode_type_is_gc[X[String]]())
    let x : X[String] = X[String].new()
    let y : Array[String] = x
    assert(x.size == 100)
    assert(y.length == 0)
    x.append("hi")
    assert(x.size == 101)
    assert(y.length == 1)
    let z = x + y
    assert(z.length == 2)
    assert((x.test_first() ?? "") == "hi")
    assert((x.test_last() ?? "") == "hi")
    assert((y.test_last() ?? "") == "hi")
}

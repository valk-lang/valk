
class AccessUser {
    name: String
    age: int
}

test "Array.insert shifts the rest up" {
    let arr = Array[int]{ 1, 3, 5 }
    arr.insert(1, 2) !!
    arr.insert(0, 0) !!
    arr.insert(arr.length, 6) !!
    assert(arr.join(",") == "0,1,2,3,5,6")
    let failed = false
    arr.insert(99, 1) ! { failed = error_is(E.code, range) }
    assert(failed)

    let words = Array[String]{ "a", "c" }
    words.insert(1, "b") !!
    assert(words.join(",") == "a,b,c")
}

test "Array.first and last" {
    let arr = Array[int]{ 4, 5, 6 }
    assert(arr.first() !! == 4)
    assert(arr.last() !! == 6)
    assert(arr.length == 3)
    let empty = Array[int]{}
    let failed = false
    empty.last() ! { failed = error_is(E.code, empty) }
    assert(failed)
    assert((empty.first() !? -1) == -1)
}

test "Array.binary_search" {
    let arr = Array[int]{ 1, 3, 5, 7 }
    let found, at = arr.binary_search(5)
    assert(found && at == 2)
    let missing, place = arr.binary_search(4)
    assert(!missing && place == 2)
    arr.insert(place, 4) !!
    assert(arr.join(",") == "1,3,4,5,7")
    let past, end = arr.binary_search(100)
    assert(!past && end == arr.length)

    // The first of equal elements
    let dup = Array[int]{ 1, 2, 2, 2, 3 }
    let f, i = dup.binary_search(2)
    assert(f && i == 1)

    // Sorted another way
    let desc = Array[int]{ 9, 7, 5 }
    let fd, id = desc.binary_search(6, fn(a, b) { return a < b })
    assert(!fd && id == 2)

    let empty = Array[String]{}
    let fe, ie = empty.binary_search("x")
    assert(!fe && ie == 0)
}

test "Array.min_by and max_by" {
    let users = Array[AccessUser]{
        AccessUser { name: "Ada", age: 36 }
        AccessUser { name: "Bob", age: 25 }
        AccessUser { name: "Cy", age: 41 }
        AccessUser { name: "Di", age: 25 }
    }
    // A tie keeps the first
    assert((users.min_by(fn(u) { return u.age }) !!).name == "Bob")
    assert((users.max_by(fn(u) { return u.age }) !!).name == "Cy")
    assert((users.max_by(fn(u) { return u.name.length }) !!).name == "Ada")
    let empty = Array[AccessUser]{}
    let failed = false
    empty.min_by(fn(u) { return u.age }) ! { failed = error_is(E.code, empty) }
    assert(failed)
}

use valk.gc
use valk.thread

class WeakItem {
    id: int
    name: String
}

class WeakCycleNode {
    id: int
    peer: ?WeakCycleNode (null)
}

global weak_fin_saw_alive: bool (false)
global weak_fin_ran: uint (0)
global weak_fin_ref: ?Weak[WeakFinalized] (null)

class WeakFinalized {
    id: int

    fn gc_free() {
        weak_fin_ran++
        let w = weak_fin_ref
        if isset(w) {
            if w.is_alive || isset(w.get()) {
                weak_fin_saw_alive = true
            }
        }
    }
}

class WeakSharedItem {
    value: int
}

global weak_strong_holder: ?WeakItem (null)
global weak_cycle_holder: ?WeakCycleNode (null)
global weak_fin_holder: ?WeakFinalized (null)
global weak_array_holder: ?Array[int] (null)
@shared weak_shared_holder: ?atomic WeakSharedItem (null)

fn make_weak_item_in_holder(id: int, name: String) Weak[WeakItem] $noinline {
    let item = WeakItem { id: id, name: name }
    weak_strong_holder = item
    return Weak[WeakItem].new(item)
}

fn make_transient_weak_item(id: int) Weak[WeakItem] $noinline {
    let item = WeakItem { id: id, name: "temp" }
    return Weak[WeakItem].new(item)
}

fn make_two_weak_refs(id: int) (Weak[WeakItem], Weak[WeakItem]) $noinline {
    let item = WeakItem { id: id, name: "shared-local" }
    weak_strong_holder = item
    return (Weak[WeakItem].new(item), Weak[WeakItem].new(item))
}

fn make_cycle_weaks() (Weak[WeakCycleNode], Weak[WeakCycleNode]) $noinline {
    let a = WeakCycleNode { id: 1 }
    let b = WeakCycleNode { id: 2 }
    a.peer = b
    b.peer = a
    weak_cycle_holder = a
    return (Weak[WeakCycleNode].new(a), Weak[WeakCycleNode].new(b))
}

fn make_finalized_weak(id: int) Weak[WeakFinalized] $noinline {
    let f = WeakFinalized { id: id }
    weak_fin_holder = f
    let w = Weak[WeakFinalized].new(f)
    weak_fin_ref = w
    return w
}

fn make_array_weak() Weak[Array[int]] $noinline {
    let arr = Array[int]{ 10, 20, 30 }
    weak_array_holder = arr
    return Weak[Array[int]].new(arr)
}

fn make_promoted_weak() Weak[WeakSharedItem] $noinline {
    let item = WeakSharedItem { value: 77 }
    let w = Weak[WeakSharedItem].new(item)
    weak_shared_holder = item
    return w
}

fn make_shared_weak(v: int) Weak[atomic WeakSharedItem] $noinline {
    let item: atomic WeakSharedItem = WeakSharedItem { value: v }
    weak_shared_holder = item
    return Weak[atomic WeakSharedItem].new(item)
}

fn check_holder_item(w: Weak[WeakItem], expected_id: int) bool $noinline {
    let got = w.get()
    if !isset(got) : return false
    return got.id == expected_id
}

fn check_array_weak(w: Weak[Array[int]]) bool $noinline {
    let got = w.get()
    if !isset(got) : return false
    return got.length == 3 && (got.get(1) !? 0) == 20
}

fn check_promoted_weak(w: Weak[WeakSharedItem], expected: int) bool $noinline {
    let got = w.get()
    if !isset(got) : return false
    return got.value == expected
}

fn churn_dropped_weaks(target: WeakItem, count: uint) $noinline {
    let i: uint = 0
    while i < count {
        let w = Weak[WeakItem].new(target)
        assert(w.is_alive)
        i++
    }
}

fn populate_weak_cache(cache: HashMap[String, Weak[WeakItem]], keep: Array[WeakItem]) $noinline {
    let i = 0
    while i < 40 {
        let item = WeakItem { id: i, name: "entry-" + i }
        cache.set("k" + i, Weak[WeakItem].new(item))
        if i % 4 == 0 {
            keep.append(item)
        }
        i++
    }
}

test "Weak[T]: basic alive and collected lifecycle" {
    let w = make_weak_item_in_holder(42, "alpha")
    assert(w.is_alive)
    assert(check_holder_item(w, 42))

    gc.collect()
    assert(w.is_alive)
    assert(check_holder_item(w, 42))

    weak_strong_holder = null
    gc.collect()
    assert(!w.is_alive)
    assert(!isset(w.get()))
}

test "Weak[T]: transient target collected on first GC" {
    let w = make_transient_weak_item(7)
    gc.collect()
    assert(!w.is_alive)
    assert(!isset(w.get()))
}

test "Weak[T]: empty and default" {
    let e = Weak[WeakItem].empty()
    assert(!e.is_alive)
    assert(!isset(e.get()))
    e.clear()
    assert(!e.is_alive)

    let d = Weak[WeakItem]{}
    assert(!d.is_alive)
    assert(!isset(d.get()))
}

test "Weak[T]: multiple weak refs, clear, and clone" {
    let w1, w2 = make_two_weak_refs(99)
    let w3 = w1.clone()

    assert(w1.is_alive && w2.is_alive && w3.is_alive)
    assert(check_holder_item(w1, 99))
    assert(check_holder_item(w2, 99))
    assert(check_holder_item(w3, 99))

    // Clearing one does not affect the target or other weak refs
    w1.clear()
    assert(!w1.is_alive)
    assert(!isset(w1.get()))
    assert(w2.is_alive && w3.is_alive)

    // Cloning a cleared weak ref yields an empty weak ref
    let c_dead = w1.clone()
    assert(!c_dead.is_alive)
    assert(!isset(c_dead.get()))

    // Collecting target clears all remaining weak refs
    weak_strong_holder = null
    gc.collect()
    assert(!w2.is_alive && !w3.is_alive)
    assert(!isset(w2.get()) && !isset(w3.get()))
}

test "Weak[T]: dropping weak refs while target stays alive" {
    let target = WeakItem { id: 5, name: "sticky" }
    churn_dropped_weaks(target, 500)
    gc.collect()
    gc.collect()
    assert(target.id == 5)
}

test "Weak[T]: reference cycle is collected and weak refs clear" {
    let wa, wb = make_cycle_weaks()
    gc.collect()
    assert(wa.is_alive && wb.is_alive)

    weak_cycle_holder = null
    gc.collect()
    assert(!wa.is_alive && !wb.is_alive)
    assert(!isset(wa.get()) && !isset(wb.get()))
}

test "Weak[T]: cleared before target gc_free finalizer runs" {
    weak_fin_saw_alive = false
    weak_fin_ran = 0
    let w = make_finalized_weak(11)
    gc.collect()
    assert(w.is_alive)
    assert(weak_fin_ran == 0)

    weak_fin_holder = null
    gc.collect()
    assert(weak_fin_ran == 1)
    assert(!weak_fin_saw_alive)
    assert(!w.is_alive)
    assert(!isset(w.get()))
    weak_fin_ref = null
}

test "Weak[T]: works with Array[T]" {
    let w = make_array_weak()
    gc.collect()
    assert(w.is_alive)
    assert(check_array_weak(w))

    weak_array_holder = null
    gc.collect()
    assert(!w.is_alive)
    assert(!isset(w.get()))
}

test "Weak[T]: cache map pattern" {
    let cache = HashMap[String, Weak[WeakItem]]{}
    let keep = Array[WeakItem]{}
    populate_weak_cache(cache, keep)
    gc.collect()

    let alive_count: uint = 0
    let dead_count: uint = 0
    let i = 0
    while i < 40 {
        let w = cache.get("k" + i) !? Weak[WeakItem].empty()
        if w.is_alive {
            alive_count++
            assert(i % 4 == 0)
        } else {
            dead_count++
            assert(i % 4 != 0)
        }
        i++
    }
    assert(alive_count == 10)
    assert(dead_count == 30)

    keep.clear()
    gc.collect()
    let remaining: uint = 0
    each cache as w {
        if w.is_alive : remaining++
    }
    assert(remaining == 0)
}

synctest "Weak[T]: local object promoted to shared" {
    let w = make_promoted_weak()
    gc.collect()
    assert(w.is_alive)
    assert(check_promoted_weak(w, 77))

    gc.collect_shared()
    assert(w.is_alive)

    weak_shared_holder = null
    gc.collect_shared()
    assert(!w.is_alive)
    assert(!isset(w.get()))
}

synctest "Weak[atomic T]: shared across threads and after worker shutdown" {
    let w: atomic Weak[atomic WeakSharedItem] = make_shared_weak(123)
    assert(w.is_alive)

    let t1 = thread.Thread[int].start(fn() int {
        let got = w.get()
        if !isset(got) : return -1
        return got.value
    }) ! panic("thread failed")
    assert(t1.await() == 123)

    // Worker creates a weak ref to the same shared object and exits
    let t2 = thread.Thread[atomic Weak[atomic WeakSharedItem]].start(fn() atomic Weak[atomic WeakSharedItem] {
        let item = weak_shared_holder ?! panic("missing shared item")
        let local_w: atomic Weak[atomic WeakSharedItem] = Weak[atomic WeakSharedItem].new(item)
        return local_w
    }) ! panic("thread failed")
    let from_worker = t2.await()

    gc.collect_shared()
    assert(w.is_alive)
    assert(from_worker.is_alive)

    weak_shared_holder = null
    gc.collect_shared()
    assert(!w.is_alive)
    assert(!from_worker.is_alive)
    assert(!isset(w.get()))
    assert(!isset(from_worker.get()))
}

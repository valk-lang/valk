
extern fn malloc(size: uint) ptr;
extern fn free(adr: ptr);
extern fn memcmp(left: *ExternValue, right: *ExternValue, size: uint) i32;

struct ExternValue {
    value: u64
}

class ExternManagedValue {
    value: int
}

extern fn inspect_managed_pointer(value: *ExternManagedValue);

test "Extern token" {
    let adr = malloc(8)
    @ptrv(adr, u64) = 5
    free(adr)
}

test "Extern pointers require an explicit raw reference" {
    let left = ExternValue { value: 42 }
    let right = ExternValue { value: 42 }
    assert(memcmp(@ref(left), @ref(right), size_of(ExternValue)) == 0)
}

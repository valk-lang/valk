extern fn malloc(size: uint) ptr;
extern fn free(adr: ptr);
extern fn memcmp(left: *ExternValue, right: *ExternValue, size: uint) i32;

struct ExternValue {
    value: u64
}

class ExternManagedValue {
    value: int
}

extern fn inspect_managed_pointer(value: *ExternManagedValue);

test "Extern token" {
    @unsafe
    let adr = malloc(8)
    @ptrv(adr, u64) = 5
    free(adr)
}

test "Extern pointers require an explicit raw reference" {
    let left = ExternValue { value: 42 }
    let right = ExternValue { value: 42 }
    assert(memcmp(@ref(left), @ref(right), size_of(ExternValue)) == 0)
}

#if OS != "win"
extern fn snprintf(buffer: ptr, size: uint, format: cstring, ...) i32;

test "Extern variadic arguments keep their own type" {
    @unsafe
    let buffer = [u8 x 64]{ 0... }
    let small: u8 = 200
    let single: f32 = 1.5
    let double: f64 = 2.25
    let count: i32 = 7
    let length = snprintf(@ref(buffer), 64, "\%d \%d \%.1f \%.2f \%s".data_cstring, count, small, single, double, "text".data_cstring)
    let result = String.copy_from_ptr(@ref(buffer).@cast(ptr), length.to(uint))
    assert(result == "7 200 1.5 2.25 text")
}
#end

struct CompareBox {
    owner: ?*CompareBox

    fn owned_by(other: ?*CompareBox) bool {
        return this.owner == other
    }

    // Both operands nullable, the right one a part of the receiver borrow
    fn is_self(other: ?*CompareBox) bool {
        return other == this.@cast(?*CompareBox)
    }
}

test "Nullable pointers compare across short-circuit branches" {
    let root = CompareBox { owner: null }
    let child = CompareBox { owner: @ref(root) }
    assert(root.owned_by(null))
    assert(!child.owned_by(null))
    assert(child.owned_by(@ref(root)))
    assert(root.is_self(@ref(root)))
    assert(!root.is_self(null))
    assert(!root.is_self(@ref(child)))
}

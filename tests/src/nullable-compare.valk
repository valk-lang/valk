struct CompareBox {
    owner: ?*CompareBox

    fn owned_by(other: ?*CompareBox) bool {
        return this.owner == other
    }

    // Both operands nullable, the right one a part of the receiver borrow
    fn is_self(other: ?*CompareBox) bool {
        return other == this.@cast(?*CompareBox)
    }
}

test "Nullable pointers compare across short-circuit branches" {
    let root = CompareBox { owner: null }
    let child = CompareBox { owner: @ref(root) }
    assert(root.owned_by(null))
    assert(!child.owned_by(null))
    assert(child.owned_by(@ref(root)))
    assert(root.is_self(@ref(root)))
    assert(!root.is_self(null))
    assert(!root.is_self(@ref(child)))
}

error CompareLoadError (missing)

class CompareCounter {
    calls: uint (0)

    fn next(value: ?int) ?int {
        this.calls++
        return value
    }

    fn load(fail: bool) String !CompareLoadError {
        if fail : throw .missing
        return "loaded"
    }
}

test "Nullable compare evaluates each side once, in order" {
    let c = CompareCounter {}
    assert(c.next(3) == 3)
    assert(c.calls == 1)
    assert(c.next(null) != 3)
    assert(c.calls == 2)
    assert(c.next(4) == c.next(4))
    assert(c.calls == 4)
    assert(c.next(null) == c.next(null))
    assert(c.calls == 6)

    // A handled call inside a nullable branch
    let ok = true
    let none: ?String = null
    assert((ok ? (c.load(false) !? "failed") : none) == "loaded")
    assert((ok ? (c.load(true) !? "failed") : none) == "failed")
}

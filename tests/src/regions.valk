use valk.gc

// Objects that provably stay in one scope live in a region. A region object has an all-zero
// header, an object of the collector never has

class RgNode {
    value: int (0)
    left: ?RgNode (null)
    right: ?RgNode (null)

    static fn tree(depth: int) RgNode {
        if depth == 0 : return RgNode { value: 1 }
        return RgNode {
            value: 1
            left: RgNode.tree(depth - 1)
            right: RgNode.tree(depth - 1)
        }
    }

    fn total() int {
        let total = this.value
        let left = this.left
        let right = this.right
        if isset(left) : total += left.total()
        if isset(right) : total += right.total()
        return total
    }

    fn grow(value: int) {
        this.left = RgNode { value: value, left: this.left }
    }

    fn deepest() RgNode {
        let at = this
        while true {
            let next = at.left ?! break
            at = next
        }
        return at
    }
}

class RgEmpty {
}

class RgList {
    items: Array[int] (.{})
    head: ?RgNode (null)
}

global rg_kept: ?RgNode (null)
global rg_kept_holder: ?RgHolder (null)

error RgFailure (failed)

fn rg_in_region(node: RgNode) bool {
    @unsafe
    return @ptrv(node.@cast(ptr) - 8, u64) == 0
}

fn rg_list_in_region(list: RgList) bool {
    @unsafe
    return @ptrv(list.@cast(ptr) - 8, u64) == 0
}

// Collections in between: nothing they do may reach a region
fn rg_garbage() {
    let junk = Array[RgNode]{}
    each 0 .. 500 as i : junk.append(RgNode { value: i.to(int) })
    gc.collect()
    gc.collect()
}

fn rg_local() bool {
    let node = RgNode { value: 5 }
    rg_garbage()
    return rg_in_region(node) && node.value == 5
}

fn rg_tree_total(depth: int) int {
    let tree = RgNode.tree(depth)
    rg_garbage()
    let leaf = tree.deepest()
    if !rg_in_region(tree) || !rg_in_region(leaf) : return -1
    return tree.total()
}

fn rg_rounds(rounds: int, depth: int) int {
    let total = 0
    let i = 0
    while i++ < rounds {
        let tree = RgNode.tree(depth)
        if !rg_in_region(tree) : return -1
        total += tree.total()
    }
    return total
}

fn rg_rounds_leave(rounds: int) int {
    let total = 0
    let i = 0
    while i++ < rounds {
        let tree = RgNode.tree(3)
        if i % 3 == 0 : continue
        if i == rounds - 2 : break
        if i == 1000 : return -1
        total += tree.total()
    }
    return total
}

fn rg_built(count: int) int {
    let root = RgNode { value: 0 }
    root.grow(1)
    root.grow(2)
    root.grow(count)
    rg_garbage()
    let first = root.left
    if !isset(first) || !rg_in_region(first) : return -1
    return root.total()
}

fn rg_stored_in_global() bool {
    let node = RgNode { value: 7 }
    rg_kept = node
    return rg_in_region(node)
}

fn rg_make_kept() RgNode {
    return RgNode.tree(2)
}

fn rg_captured() int {
    let node = RgNode { value: 3 }
    let read = fn() int { return node.value }
    rg_garbage()
    if rg_in_region(node) : return -1
    return read()
}

fn rg_in_array() int {
    let node = RgNode { value: 4 }
    let list = Array[RgNode]{}
    list.append(node)
    list.append(RgNode { value: 6 })
    list.append(RgNode { value: 7 })
    rg_garbage()
    // The array, its storage and what it holds are one region
    let last = list.get(2) !? RgNode {}
    if !rg_in_region(node) || !rg_in_region(last) : return -1
    return (list.get(0) !? RgNode {}).value + list.length.to(int)
}

fn rg_with_array_field() int {
    let list = RgList { head: RgNode { value: 2 } }
    list.items.append(40)
    rg_garbage()
    let head = list.head
    if !rg_list_in_region(list) : return -1
    return (list.items.get(0) !? 0) + (isset(head) ? head.value : 0)
}

// An array that outgrows its storage several times, with collections in between
fn rg_array_grows() int {
    let list = Array[RgNode]{}
    list.append(RgNode { value: 1 })
    list.append(RgNode { value: 2 })
    list.append(RgNode { value: 3 })
    rg_garbage()
    list.append(RgNode { value: 4 })
    list.append(RgNode { value: 5 })
    list.append(RgNode { value: 6 })
    list.append(RgNode { value: 7 })
    list.append(RgNode { value: 8 })
    list.append(RgNode { value: 9 })
    rg_garbage()
    let removed = list.get(0) !? RgNode {}
    list.remove(0)
    list.set(0, RgNode { value: 20 }) _
    let total = removed.value
    each list as node {
        if !rg_in_region(node) : return -1
        total += node.value
    }
    return total
}

fn rg_array_kept() int {
    let list = Array[RgNode]{}
    list.append(RgNode { value: 1 })
    rg_kept = list.get(0) !? null
    rg_garbage()
    let first = list.get(0) !? RgNode {}
    if rg_in_region(first) : return -1
    return first.value
}

fn rg_fails(fail: bool) int !RgFailure {
    let tree = RgNode.tree(4)
    if fail : throw .failed
    return tree.total()
}

fn rg_recursive(depth: int) int {
    let node = RgNode { value: depth }
    if depth == 0 : return node.value
    let below = rg_recursive(depth - 1)
    return node.value + below
}

fn rg_picked(first: bool) int {
    let node = first ? RgNode { value: 1 } : RgNode.tree(2)
    rg_garbage()
    return node.total()
}

fn rg_empty() bool {
    @unsafe
    let a = RgEmpty {}
    let b = RgEmpty {}
    return a.@cast(ptr) != b.@cast(ptr)
}

test "Regions: an object that stays in its function lives in a region" {
    assert(rg_local())
    assert(rg_empty())
}

test "Regions: a function builds its result in the region of its caller" {
    assert(rg_tree_total(3) == 15)
    assert(rg_tree_total(10) == 2047)
    assert(rg_picked(true) == 1)
    assert(rg_picked(false) == 7)
}

test "Regions: a large structure grows past the frame and is freed with the call" {
    assert(rg_tree_total(17) == 262143)
    assert(rg_tree_total(17) == 262143)
}

test "Regions: every round of a loop starts with an empty region" {
    assert(rg_rounds(2000, 4) == 2000 * 31)
    assert(rg_rounds(6, 14) == 6 * 32767)
    assert(rg_rounds_leave(100) == 15 * 65)
}

test "Regions: a method grows the region its object is in" {
    assert(rg_built(5) == 8)
}

test "Regions: what leaves its scope stays with the collector" {
    assert(!rg_stored_in_global())
    rg_garbage()
    let kept = rg_kept
    assert(isset(kept) && kept.value == 7)

    rg_kept = rg_make_kept()
    rg_garbage()
    let tree = rg_kept
    assert(isset(tree) && !rg_in_region(tree) && tree.total() == 7)
    rg_kept = null

    assert(rg_captured() == 3)
    assert(rg_array_kept() == 1)
    rg_kept = null
}

test "Regions: an array, its storage and its elements share a region" {
    assert(rg_in_array() == 7)
    assert(rg_with_array_field() == 42)
    assert(rg_array_grows() == 1 + 20 + 3 + 4 + 5 + 6 + 7 + 8 + 9)
}

test "Regions: an error and a deep recursion leave nothing behind" {
    assert((rg_fails(false) !? -1) == 31)
    assert((rg_fails(true) !? -1) == -1)
    assert(rg_recursive(200) == 20100)
}

class RgHolder {
    node: ?RgNode (null)
}

struct RgPair {
    a: RgNode
    b: RgNode
}

fn rg_carried(rounds: int) int {
    let last: ?RgNode = null
    let i = 0
    while i++ < rounds {
        let node = RgNode { value: i, left: last }
        last = node
    }
    rg_garbage()
    if !isset(last) || rg_in_region(last) : return -1
    return last.total()
}

fn rg_carried_undefined(rounds: int) int {
    let last: RgNode = @undefined
    let i = 0
    while i++ < rounds {
        if i == 1 : last = RgNode { value: 100 }
        else : last = RgNode { value: i, left: last }
    }
    rg_garbage()
    return last.total()
}

fn rg_attach(holder: RgHolder, node: RgNode) {
    holder.node = node
}

fn rg_attached() int {
    let holder = RgHolder {}
    let node = RgNode.tree(2)
    rg_attach(holder, node)
    rg_garbage()
    let held = holder.node
    if !isset(held) || !rg_in_region(held) : return -1
    return held.total()
}

fn rg_attached_to_kept(holder: RgHolder) {
    rg_attach(holder, RgNode.tree(2))
}

fn rg_pick(a: RgNode, b: RgNode, first: bool) RgNode {
    if first : return a
    return b
}

fn rg_picked_of_two(first: bool) int {
    let a = RgNode { value: 1 }
    let b = RgNode.tree(1)
    let chosen = rg_pick(a, b, first)
    rg_garbage()
    if !rg_in_region(chosen) : return -1
    return chosen.total()
}

fn rg_pair() RgPair {
    return RgPair { a: RgNode { value: 2 }, b: RgNode.tree(1) }
}

fn rg_paired() int {
    let pair = rg_pair()
    rg_garbage()
    return pair.a.total() + pair.b.total()
}

fn rg_found(rounds: int) ?RgNode {
    let i = 0
    while i++ < rounds {
        let tree = RgNode.tree(2)
        if i == rounds - 1 : return tree
    }
    return null
}

fn rg_scoped(flag: bool) int {
    let node = <{
        if flag : return RgNode { value: 10 }
        return RgNode.tree(1)
    }
    let other: ?RgNode = null
    if !flag : other = RgNode { value: 5 }
    rg_garbage()
    return node.total() + (other?.value ?? 0)
}

test "Regions: a value carried from one round of a loop to the next stays with the collector" {
    assert(rg_carried(50) == 1275)
    assert(rg_carried_undefined(50) == 1374)
}

test "Regions: objects linked by a call share their region or the heap" {
    assert(rg_attached() == 7)
    // A holder that stays here takes what a function attaches into its region; one that
    // something else keeps takes it from the collector
    let holder = RgHolder {}
    rg_attached_to_kept(holder)
    rg_garbage()
    let held = holder.node
    assert(isset(held) && rg_in_region(held) && held.total() == 7)
    let kept = RgHolder {}
    rg_kept_holder = kept
    rg_attached_to_kept(kept)
    rg_garbage()
    let other = kept.node
    assert(isset(other) && !rg_in_region(other) && other.total() == 7)
    rg_kept_holder = null
    assert(rg_picked_of_two(true) == 1)
    assert(rg_picked_of_two(false) == 3)
    assert(rg_paired() == 5)
    let found = rg_found(10)
    rg_garbage()
    assert(isset(found) && !rg_in_region(found) && found.total() == 7)
    assert(rg_scoped(true) == 10)
    assert(rg_scoped(false) == 8)
}

fn rg_loop_built(count: int) Array[RgNode] $region {
    let list = Array[RgNode]{}
    let i = 0
    while i++ < count {
        list.append(RgNode { value: i })
    }
    return list
}

fn rg_loop_built_plain(count: int) Array[RgNode] {
    let list = Array[RgNode]{}
    let i = 0
    while i++ < count {
        list.append(RgNode { value: i })
    }
    return list
}

fn rg_loop_sum(list: Array[RgNode]) int {
    let total = 0
    each list as node : total += node.value
    return total
}

// 0: on the heap, 1: in a region
fn rg_loop_place(list: Array[RgNode]) int {
    let first = list.get(0) !? RgNode {}
    return rg_in_region(first) ? 1 : 0
}

fn rg_loop_host(count: int) int $region {
    let list = Array[RgNode]{}
    let i = 0
    while i++ < count {
        list.append(RgNode { value: i })
        if i % 100 == 0 : rg_garbage()
    }
    if rg_loop_place(list) != 1 : return -1
    return rg_loop_sum(list)
}

fn rg_loop_rounds(rounds: int, count: int) int {
    let total = 0
    let i = 0
    while i++ < rounds {
        let list = rg_loop_built(count)
        if rg_loop_place(list) != 1 : return -1
        total += rg_loop_sum(list)
    }
    return total
}

test "Regions: $region lets the loops of a function add to a region" {
    assert(rg_loop_host(1000) == 500500)
    // A caller that keeps the result to itself has it in its region, one round at a time
    assert(rg_loop_rounds(200, 3000) == 200 * 4501500)
    let built = rg_loop_built_plain(100)
    rg_garbage()
    assert(rg_loop_place(built) == 0 && rg_loop_sum(built) == 5050)
}

class RgLog {
    last: ?RgNode (null)
    count: int (0)
}

global rg_kept_log: ?RgLog (null)

// Makes objects in two groups: its result, and what it attaches to the log
fn rg_two(log: RgLog, value: int) RgNode {
    log.last = RgNode { value: value }
    log.count++
    return RgNode { value: value, left: RgNode { value: 1 } }
}

// The places of the result and of what the log got: 1 in a region, 0 on the heap
fn rg_two_places(log: RgLog, node: RgNode) int {
    let last = log.last ?! return -1
    return (rg_in_region(node) ? 10 : 0) + (rg_in_region(last) ? 1 : 0)
}

fn rg_two_both() int {
    let log = RgLog {}
    let node = rg_two(log, 5)
    rg_garbage()
    return rg_two_places(log, node) * 100 + node.total() + log.count
}

fn rg_two_result_kept() int {
    let log = RgLog {}
    let node = rg_two(log, 6)
    rg_kept = node
    rg_garbage()
    return rg_two_places(log, node) * 100 + node.total() + log.count
}

fn rg_two_log_kept() int {
    let log = RgLog {}
    rg_kept_log = log
    let node = rg_two(log, 7)
    rg_garbage()
    return rg_two_places(log, node) * 100 + node.total() + log.count
}

test "Regions: a function that fills two groups takes a region for each, or none" {
    assert(rg_two_both() == 1100 + 6 + 1)
    assert(rg_two_result_kept() == 100 + 7 + 1)
    assert(rg_two_log_kept() == 1000 + 8 + 1)
    rg_garbage()
    let kept = rg_kept
    let log = rg_kept_log
    assert(isset(kept) && kept.total() == 7)
    assert(isset(log) && (log.last?.value ?? 0) == 7)
    rg_kept = null
    rg_kept_log = null
}

class RgNamed {
    name: String
    next: ?RgNamed (null)
}

global rg_kept_text: String ("")
global rg_kept_named: ?RgNamed (null)

fn rg_named_in_region(n: RgNamed) bool {
    @unsafe
    return @ptrv(n.@cast(ptr) - 8, u64) == 0
}

// Text of the collector that nothing else refers to once this returns
fn rg_heap_text(n: int) String {
    let text = "heap-text-" + n
    rg_kept_text = text
    rg_kept_text = ""
    return text
}

fn rg_text_fresh(n: int) int {
    let a = RgNamed { name: "id-" + n }
    let b = RgNamed { name: "other-" + n, next: a }
    rg_garbage()
    if !rg_named_in_region(a) || !rg_named_in_region(b) : return -1
    return a.name.bytes.to(int) + b.name.bytes.to(int)
}

fn rg_text_pinned(n: int) int {
    let a = RgNamed { name: rg_heap_text(n) }
    let b = RgNamed { name: rg_heap_text(n + 1).range(5, 4), next: a }
    rg_garbage()
    rg_garbage()
    if !rg_named_in_region(a) || !rg_named_in_region(b) : return -1
    return (a.name == "heap-text-" + n ? 1 : 0) + (b.name == "text" ? 10 : 0)
}

// Many different texts, more than the region remembers by itself
fn rg_text_many(count: int) int $region {
    let first = RgNamed { name: "first" }
    let last = first
    let i = 0
    while i++ < count {
        let n = RgNamed { name: rg_heap_text(i) }
        last.next = n
        last = n
        if i % 40 == 0 : rg_garbage()
    }
    let ok = 0
    let at: ?RgNamed = first.next
    i = 0
    while isset(at) {
        i++
        if at.name == "heap-text-" + i : ok++
        at = at.next
    }
    return rg_named_in_region(last) ? ok : -1
}

fn rg_text_set(n: RgNamed, name: String) {
    n.name = name
}

fn rg_text_stored_by_call(n: int) int {
    let a = RgNamed { name: "" }
    rg_text_set(a, rg_heap_text(n))
    rg_garbage()
    if !rg_named_in_region(a) : return -1
    return a.name == "heap-text-" + n ? 1 : 0
}

fn rg_text_leaves(n: int) int {
    let a = RgNamed { name: "kept-" + n }
    rg_kept_text = a.name
    rg_garbage()
    return rg_named_in_region(a) ? 1 : 0
}

fn rg_text_object_leaves(n: int) int {
    let a = RgNamed { name: "object-" + n }
    rg_kept_named = a
    rg_garbage()
    return rg_named_in_region(a) ? 1 : 0
}

fn rg_text_in_array(n: int) int {
    let list = Array[String]{}
    list.append(rg_heap_text(n))
    list.append("made-" + n)
    list.append(rg_heap_text(n + 1))
    rg_garbage()
    let total = 0
    each list as text : total += text.bytes.to(int)
    return (list.get(0) !? "") == "heap-text-" + n ? total : -1
}

test "Regions: an object in a region refers to text the collector owns, and keeps it" {
    assert(rg_text_fresh(5) == 11)
    assert(rg_text_pinned(7) == 11)
    assert(rg_text_many(300) == 300)
    assert(rg_text_stored_by_call(3) == 1)
    assert(rg_text_in_array(4) == 11 + 6 + 11)
}

test "Regions: text that leaves is the collector's, and so is text of an object that leaves" {
    assert(rg_text_leaves(3) == 1)
    rg_garbage()
    assert(rg_kept_text == "kept-3")
    assert(rg_text_object_leaves(4) == 0)
    rg_garbage()
    let kept = rg_kept_named
    assert(isset(kept) && kept.name == "object-4")
    rg_kept_text = ""
    rg_kept_named = null
}

// References have a direction: an object lives at most as long as what it refers to, so the
// objects of one round of a loop may refer to objects that stay

class RgConfig {
    name: String
    limit: int
    owner: ?RgItem (null)
}

class RgItem {
    config: RgConfig
    label: String
    value: int
}

class RgItems {
    a: RgItem
    b: RgItem
}

class RgConfigHolder {
    config: ?RgConfig (null)
}

global rg_kept_configs: ?RgConfigHolder (null)

fn rg_item_in_region(item: RgItem) bool {
    @unsafe
    return @ptrv(item.@cast(ptr) - 8, u64) == 0
}

fn rg_config_in_region(config: RgConfig) bool {
    @unsafe
    return @ptrv(config.@cast(ptr) - 8, u64) == 0
}

// Fills the memory that collected configs leave behind
fn rg_config_garbage() {
    gc.collect()
    gc.collect()
    let junk = Array[RgConfig]{}
    each 0 .. 500 as i : junk.append(RgConfig { name: "junk", limit: -1 })
    gc.collect()
}

// Only reads what its parameter refers to
fn rg_score(items: RgItems) int {
    return items.a.value + items.b.value + items.a.config.limit + items.b.label.bytes.to(int)
}

fn rg_round_temporaries(rounds: int, label: String) int {
    let config = RgConfig { name: "main", limit: 3 }
    let sum = 0
    let i = 0
    while i++ < rounds {
        let item = RgItem { config: config, label: label, value: i }
        let items = RgItems { a: item, b: RgItem { config: config, label: "abc", value: 1 } }
        if i % 40 == 0 : rg_garbage()
        if !rg_item_in_region(item) || !rg_item_in_region(items.b) : return -1
        sum += rg_score(items)
    }
    if !rg_config_in_region(config) : return -2
    return sum
}

// The object that stays is an argument: the collector's or a region's, the caller knows
fn rg_round_temporaries_of(config: RgConfig, rounds: int) int {
    let sum = 0
    let i = 0
    while i++ < rounds {
        let item = RgItem { config: config, label: config.name, value: i }
        if i % 40 == 0 : rg_garbage()
        if !rg_item_in_region(item) : return -1
        sum += rg_score(RgItems { a: item, b: item })
    }
    return sum
}

fn rg_round_temporaries_of_local(rounds: int) int {
    let config = RgConfig { name: "abc", limit: 3 }
    if !rg_config_in_region(config) : return -2
    return rg_round_temporaries_of(config, rounds)
}

fn rg_round_temporaries_of_kept(rounds: int) int {
    let holder = RgConfigHolder { config: RgConfig { name: "ab" + "c", limit: 3 } }
    rg_kept_configs = holder
    let config = holder.config ?! return -3
    let sum = rg_round_temporaries_of(config, rounds)
    rg_kept_configs = null
    return sum
}

fn rg_config_of(holder: RgConfigHolder) RgConfig {
    return holder.config ?! panic("no config")
}

// Gives the kept holder another config: nothing else refers to the one it had
fn rg_config_renew(limit: int) {
    let holder = rg_kept_configs ?! return
    holder.config = RgConfig { name: "config-" + limit, limit: limit }
}

// An object read out of an argument, which the argument then lets go of: the region keeps it
fn rg_read_out(holder: RgConfigHolder, limit: int) int {
    rg_config_renew(limit)
    let item = RgItem { config: rg_config_of(holder), label: "read", value: limit }
    rg_config_renew(-1)
    rg_config_garbage()
    if !rg_item_in_region(item) : return -1
    return item.config.limit == limit && item.config.name == "config-" + limit ? 1 : 0
}

fn rg_read_out_of_kept(count: int) int {
    let holder = RgConfigHolder {}
    rg_kept_configs = holder
    let result = rg_read_out(holder, count)
    rg_kept_configs = null
    return result
}

// Text that only a callee stores, many times over
fn rg_text_set_many(count: int) int $region {
    let list = Array[RgNamed]{}
    let i = 0
    while i++ < count {
        let n = RgNamed { name: "" }
        rg_text_set(n, rg_heap_text(i))
        list.append(n)
        if i % 40 == 0 : rg_garbage()
    }
    rg_garbage()
    let ok = 0
    each list as n, at {
        if !rg_named_in_region(n) : return -1
        if n.name == "heap-text-" + (at + 1) : ok++
    }
    return ok
}

// A callee that links what the items refer to back to an item: the two live equally long
fn rg_link_back(items: RgItems) {
    items.a.config.owner = items.a
}

fn rg_linked_back(rounds: int) int {
    let config = RgConfig { name: "main", limit: 3 }
    let i = 0
    while i++ < rounds {
        let item = RgItem { config: config, label: "item", value: i }
        rg_link_back(RgItems { a: item, b: item })
    }
    rg_garbage()
    let owner = config.owner ?! return -2
    if rg_item_in_region(owner) : return -1
    return owner.value
}

// A callee that hands the text of one object to another: both keep it
fn rg_copy_label(items: RgItems) {
    items.a.label = items.b.config.name
}

fn rg_copied_label(n: int) int {
    let config = RgConfig { name: rg_heap_text(n), limit: 1 }
    let item = RgItem { config: config, label: "", value: 0 }
    rg_copy_label(RgItems { a: item, b: item })
    config.name = ""
    rg_garbage()
    rg_garbage()
    if !rg_item_in_region(item) : return -1
    return item.label == "heap-text-" + n ? 1 : 0
}

global rg_finalized: int (0)

class RgFinal {
    value: int (0)

    fn gc_free() {
        rg_finalized++
    }
}

class RgFinalHolder {
    item: ?RgFinal (null)
}

fn rg_final_holder_in_region(holder: RgFinalHolder) bool {
    @unsafe
    return @ptrv(holder.@cast(ptr) - 8, u64) == 0
}

fn rg_final_replace(holder: RgFinalHolder, value: int) {
    holder.item = RgFinal { value: value }
}

// A region would keep the replaced object until the function ends
fn rg_final_held() int {
    let holder = RgFinalHolder { item: RgFinal { value: 1 } }
    rg_final_replace(holder, 2)
    return rg_final_holder_in_region(holder) ? -1 : (holder.item?.value ?? 0)
}

test "Regions: the objects of a round refer to objects that stay, and a callee that only reads keeps them apart" {
    assert(rg_round_temporaries(200, "abc") == 200 * 201 / 2 + 200 * 7)
    assert(rg_round_temporaries_of_local(200) == 200 * 201 + 200 * 6)
    assert(rg_round_temporaries_of_kept(200) == 200 * 201 + 200 * 6)
}

test "Regions: a region keeps the object it read out of an argument, and text a callee stored" {
    assert(rg_read_out_of_kept(41) == 1)
    assert(rg_text_set_many(300) == 300)
}

test "Regions: what a callee links both ways, or hands from one object to another, lives equally long" {
    assert(rg_linked_back(50) == 50)
    assert(rg_copied_label(9) == 1)
}

test "Regions: an object that refers to one with a finalizer stays with the collector" {
    assert(rg_final_held() == 2)
}

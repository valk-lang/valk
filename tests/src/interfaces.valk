use valk.gc

interface InterfaceNamed {
    get label: String;
}

interface InterfaceDescribe {
    fn describe(prefix: String) String;
}

interface InterfaceValue[T] {
    fn value() T;
}

interface InterfaceFallible {
    fn read(ok: bool) String !AnError;
}

interface InterfaceMarker {}

class InterfaceMarked is InterfaceMarker {}
class InterfaceAlsoMarked is InterfaceMarker {}

class InterfaceDog is InterfaceNamed, InterfaceDescribe {
    name: String

    get label: String {
        return this.name
    }

    fn describe(prefix: String) String {
        return prefix + this.name
    }
}

class InterfaceCat is InterfaceDescribe {
    name: String

    fn describe(prefix: String) String {
        return prefix + "cat:" + this.name
    }
}

class InterfaceNumber is InterfaceValue[int] {
    number: int

    fn value() int {
        return this.number
    }
}

class InterfaceBox[T] is InterfaceValue[T] {
    item: T

    fn value() T {
        return this.item
    }
}

class InterfaceReader is InterfaceFallible {
    fn read(ok: bool) String !AnError {
        if !ok : throw .error
        return "read"
    }
}

interface InterfaceFallibleVoid {
    fn run() !AnError;
}

interface InterfaceFalliblePair {
    fn pair() (uint, String) !AnError;
}

// Infallible methods may implement fallible interface methods
class InterfaceInfallible is InterfaceFallible, InterfaceFallibleVoid, InterfaceFalliblePair {
    ran: bool (false)

    fn read(ok: bool) String {
        return ok ? "always" : "still"
    }
    fn run() {
        this.ran = true
    }
    fn pair() (uint, String) {
        return (7, "seven")
    }
}

global interface_gc_value_count: uint
global interface_is_a_calls: uint

class InterfaceGcValue is InterfaceValue[uint] {
    number: uint

    fn value() uint {
        return this.number
    }

    fn gc_free() {
        interface_gc_value_count--
    }
}

fn interface_gc_new(number: uint) InterfaceGcValue {
    interface_gc_value_count++
    return InterfaceGcValue { number: number }
}

fn interface_is_a_value() InterfaceDescribe {
    interface_is_a_calls++
    return InterfaceDog { name: "side effect" }
}

fn interface_gc_direct_scope() {
    let concrete = interface_gc_new(11)
    let value: InterfaceValue[uint] = concrete
    concrete = null.@cast(InterfaceGcValue)

    gc.collect()
    assert(interface_gc_value_count == 1)
    assert(value.value() == 11)
}

fn interface_gc_array() Array[InterfaceValue[uint]] {
    return Array[InterfaceValue[uint]]{ interface_gc_new(22) }
}

fn interface_gc_array_scope() {
    let values = interface_gc_array()
    gc.collect()
    assert(interface_gc_value_count == 1)
    let value = values.get(0) !? null
    assert(isset(value))
    if isset(value) : assert(value.value() == 22)
}

fn interface_gc_callback() fn()(uint) {
    let value: InterfaceValue[uint] = interface_gc_new(33)
    return value.value
}

fn interface_gc_closure_scope() {
    let callback = interface_gc_callback()
    gc.collect()
    assert(interface_gc_value_count == 1)
    assert(callback() == 33)
}

fn interface_description(value: InterfaceDescribe, prefix: String) String {
    return value.describe(prefix)
}

fn interface_nullable_equal(left: ?InterfaceDescribe, right: ?InterfaceDescribe) bool {
    return left == right
}

test "Interfaces: class dispatch" {
    let dog = InterfaceDog { name: "Milo" }
    let cat = InterfaceCat { name: "Nori" }
    let described: InterfaceDescribe = dog
    let described_again: InterfaceDescribe = dog
    let cat_description: InterfaceDescribe = cat
    let maybe_described: ?InterfaceDescribe = dog
    let maybe_described_again: ?InterfaceDescribe = dog
    let no_description: ?InterfaceDescribe = null
    let named: InterfaceNamed = dog

    assert(described.describe("dog:") == "dog:Milo")
    assert(described == described_again)
    assert(maybe_described == maybe_described_again)
    assert(interface_nullable_equal(maybe_described, maybe_described_again))
    assert(!interface_nullable_equal(maybe_described, no_description))
    assert(interface_nullable_equal(no_description, null))
    assert(no_description == null)
    assert(maybe_described != no_description)
    assert(named.label == "Milo")
    assert(InterfaceDog.$can_convert_to(InterfaceDescribe))
    assert(interface_description(cat, "hello ") == "hello cat:Nori")
    assert(described is_a InterfaceDog)
    assert(described is_a InterfaceDog && true)
    assert(!(described is_a InterfaceCat))
    assert(cat_description is_a InterfaceCat)
    assert(!(no_description is_a InterfaceDog))
    assert(size_of(InterfaceDescribe) == size_of(ptr) * 2)

    let values = Array[InterfaceDescribe]{ dog, cat }
    assert((values.get(0) !? dog).describe("") == "Milo")
    assert((values.get(1) !? dog).describe("") == "cat:Nori")
}

test "Interfaces: bound method" {
    let described: InterfaceDescribe = InterfaceDog { name: "Pip" }
    let describe = described.describe
    assert(describe("hi ") == "hi Pip")
}

test "Interfaces: generic contract" {
    let value: InterfaceValue[int] = InterfaceNumber { number: 42 }
    let text: InterfaceValue[String] = InterfaceBox[String] { item: "boxed" }
    let boxed_number: InterfaceValue[int] = InterfaceBox[int] { item: 81 }
    assert(value.value() == 42)
    assert(text.value() == "boxed")
    assert(boxed_number.value() == 81)
    assert(value is_a InterfaceNumber)
    assert(text is_a InterfaceBox[String])
    assert(boxed_number is_a InterfaceBox[int])
    assert(!(text is_a InterfaceNumber))
}

test "Interfaces: empty interface keeps concrete identity" {
    let marked: InterfaceMarker = InterfaceMarked {}
    let also_marked: InterfaceMarker = InterfaceAlsoMarked {}
    assert(marked is_a InterfaceMarked)
    assert(!(marked is_a InterfaceAlsoMarked))
    assert(also_marked is_a InterfaceAlsoMarked)
}

test "Interfaces: is_a evaluates its value" {
    interface_is_a_calls = 0
    assert(!(interface_is_a_value() is_a InterfaceNumber))
    assert(interface_is_a_calls == 1)
}

test "Interfaces: vtables work across source files" {
    let value: CrossInterface = CrossImplementation {}
    assert(value.cross_value() == 73)
    assert(value is_a CrossImplementation)
}

test "Interfaces: fallible dispatch" {
    let reader: InterfaceFallible = InterfaceReader {}
    assert((reader.read(true) !? "failed") == "read")
    assert((reader.read(false) !? "failed") == "failed")
}

test "Interfaces: infallible implementations of fallible methods" {
    let value = InterfaceInfallible {}
    let reader: InterfaceFallible = value
    assert((reader.read(true) !? "failed") == "always")
    assert((reader.read(false) !? "failed") == "still")
    assert(value.read(false) == "still")

    let runner: InterfaceFallibleVoid = value
    runner.run() ! assert(false)
    assert(value.ran)

    let pairs: InterfaceFalliblePair = value
    let number, text = pairs.pair() ! {
        assert(false)
        return
    }
    assert(number == 7 && text == "seven")
}

synctest "Interfaces: GC traces fat values" {
    gc.collect()
    gc.collect()
    assert(interface_gc_value_count == 0)
    let marked = gc.gc.mem_marked

    interface_gc_direct_scope()
    gc.collect()
    gc.collect()
    assert(interface_gc_value_count == 0)

    interface_gc_array_scope()
    gc.collect()
    gc.collect()
    assert(interface_gc_value_count == 0)

    interface_gc_closure_scope()
    gc.collect()
    gc.collect()
    assert(interface_gc_value_count == 0)
    assert(gc.gc.mem_marked == marked)
}

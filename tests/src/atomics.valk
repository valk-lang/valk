
use valk.thread

enum CasPhase: u8 {
    idle
    running
    done
}

class CasCounter {
    + count: uint (0)
    + claimed: bool (false)
    + wins: uint (0)
}

shared cas_shared_global: uint (0)

test "Atomics" {
    let a = 5
    let b = 0
    b = atomic(a + 10)
    assert(a == 15)
    assert(b == 5)
    b = atomic(a - 3)
    assert(a == 12)
    assert(b == 15)
    b = atomic(a | 1)
    assert(a == 13)
    assert(b == 12)
    b = atomic(a & 9)
    assert(a == 9)
    assert(b == 13)
    b = atomic(a ^ 3)
    assert(a == 10)
    assert(b == 9)
}

test "Atomics: atomic_cas on integers, bool, enum, pointers and globals" {
    let x: int = 10
    assert(!atomic_cas(x, 5, 20))
    assert(x == 10)
    assert(atomic_cas(x, 10, 20))
    assert(x == 20)

    let small: u8 = 1
    assert(atomic_cas(small, 1, 250))
    assert(!atomic_cas(small, 1, 2))
    assert(small == 250)

    let flag = false
    assert(!atomic_cas(flag, true, false))
    assert(atomic_cas(flag, false, true))
    assert(flag)
    assert(atomic_cas(flag, true, false))
    assert(!flag)

    let phase = CasPhase.idle
    assert(!atomic_cas(phase, .done, .running))
    assert(atomic_cas(phase, .idle, .running))
    assert(phase == .running)
    assert(atomic_cas(phase, .running, .done))
    assert(phase == .done)

    // Raw pointers (?ptr and ?*int)
    let v1 = 1
    let v2 = 2
    let p1 = @ref(v1)
    let p2 = @ref(v2)
    let slot: ?*int = null
    assert(!atomic_cas(slot, p1, p2))
    assert(atomic_cas(slot, null, p1))
    assert(slot == p1)
    assert(atomic_cas(slot, p1, p2))
    assert(slot == p2)

    let raw: ?ptr = null
    assert(atomic_cas(raw, null, p1))
    assert(raw == p1)
    assert(!atomic_cas(raw, null, p2))
    assert(atomic_cas(raw, p1, null))
    assert(!isset(raw))

    // Shared global
    atomic_store(cas_shared_global, 0)
    assert(atomic_cas(cas_shared_global, 0, 42))
    assert(!atomic_cas(cas_shared_global, 0, 99))
    assert(atomic_load(cas_shared_global) == 42)
}

test "Atomics: atomic_cas under multi-threaded contention" {
    let box: atomic CasCounter = CasCounter {}
    let threads = Array[thread.Thread[void]]{}
    let t: uint = 0
    while t < 4 {
        let th = thread.start(fn() {
            if atomic_cas(box.claimed, false, true) {
                atomic(box.wins + 1)
            }
            let i: uint = 0
            while i < 10000 {
                while true {
                    let cur = atomic_load(box.count)
                    if atomic_cas(box.count, cur, cur + 1) : break
                }
                i++
            }
        }) !!
        threads.append(th)
        t++
    }
    each threads as th : th.await()
    assert(atomic_load(box.count) == 40000)
    assert(atomic_load(box.claimed))
    assert(atomic_load(box.wins) == 1)
}

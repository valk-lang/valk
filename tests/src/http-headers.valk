use valk.http

test "HTTP Headers preserve values and match names without case" {
    let headers = http.Headers.new()
    assert(headers.length == 0)
    assert(!headers.has("missing"))
    assert(headers.get_all("missing").length == 0)
    let missing = false
    headers.get("missing") ! { missing = E.code == E.missing }
    assert(missing)

    headers.append("Set-Cookie", "a=1; Expires=Wed, 09 Jun 2027 10:18:14 GMT")
    headers.append("X-Other", "unchanged")
    headers.append("sEt-CoOkIe", "b=2")
    assert(headers.length == 3)
    assert(headers.has("SET-COOKIE"))
    assert((headers.get("set-cookie") !? "") == "a=1; Expires=Wed, 09 Jun 2027 10:18:14 GMT")
    let cookies = headers.get_all("SET-cookie")
    assert(cookies.length == 2)
    assert((cookies.get(1) !? "") == "b=2")
    cookies.clear()
    assert(headers.get_all("set-cookie").length == 2)

    let names = Array[String].new()
    let values = Array[String].new()
    each headers as value, name {
        names.append(name)
        values.append(value)
    }
    assert(names.join("|") == "Set-Cookie|X-Other|sEt-CoOkIe")
    assert((values.get(2) !? "") == "b=2")

    let copy = headers.copy()
    copy.set("SET-cookie", "replacement")
    assert(copy.length == 2)
    assert(copy.get_all("set-cookie").length == 1)
    assert((copy.get("set-cookie") !? "") == "replacement")
    assert((copy.get("x-other") !? "") == "unchanged")
    assert(headers.get_all("set-cookie").length == 2)
    copy.remove("set-COOKIE").remove("absent")
    assert(copy.length == 1 && !copy.has("set-cookie"))
    copy.clear()
    assert(copy.length == 0)

    let literal = http.Headers { "Accept" => "text/plain", "accept" => "application/json" }
    assert(literal.length == 1)
    assert((literal.get("ACCEPT") !? "") == "application/json")
}

test "HTTP response and options use Headers" {
    let response = http.Response.empty()
    response.set_header("X-Test", "first")
    response.add_header("x-test", "second")
    assert(response.headers.get_all("X-TEST").join("|") == "first|second")
    response.set_header("X-Test", "replacement")
    assert(response.headers.get_all("x-test").join("|") == "replacement")

    let source = http.Headers.new().append("X-Test", "first").append("x-test", "second")
    let options = http.Options {}
    options.set_header("X-Unrelated", "preserved")
    options.set_header("X-Test", "old")
    options.set_headers(source)
    source.clear()
    assert(options.get_headers().get_all("X-Test").join("|") == "first|second")
    assert((options.get_headers().get("x-unrelated") !? "") == "preserved")
    options.set_headers(options.get_headers())
    assert(options.get_headers().get_all("X-Test").join("|") == "first|second")
    options.set_header("X-TEST", "replacement")
    assert(options.get_headers().get_all("x-test").join("|") == "replacement")
    options.clear_headers()
    assert(options.get_headers().length == 0)
}

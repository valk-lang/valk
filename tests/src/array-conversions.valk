use valk.gc

fn array_widen_value(values: [int x 2]) [?int x 2] { return values }
fn array_widen_pointer(values: *[int x 2]) [?int x 2] { return values }
fn array_widen_borrow(values: stack [int x 2]) [?int x 2] { return values }
fn array_widen_nullable(values: ?[int x 2]) ?[?int x 2] { return values }
fn array_widen_nested(values: [[int x 2] x 1]) [[?int x 2] x 1] { return values }

global array_conversion_calls: uint (0)
fn array_conversion_source() [int x 2] {
    array_conversion_calls++
    return .{ 17, 19 }
}

test "Array conversions: nullable elements use the destination layout" {
    let source: [int x 2] = { 7, 11 }
    let value = array_widen_value(source)
    let pointer = array_widen_pointer(&source)
    let borrow = array_widen_borrow(source)
    source[0] = 23
    assert((value[0] ?? -1) == 7 && (value[1] ?? -1) == 11)
    assert((pointer[0] ?? -1) == 7 && (pointer[1] ?? -1) == 11)
    assert((borrow[0] ?? -1) == 7 && (borrow[1] ?? -1) == 11)
}

test "Array conversions: nullable arrays and nested arrays widen" {
    let source: [int x 2] = { 23, 29 }
    let optional: ?[int x 2] = source
    assert(isset(optional) && optional[0] == 23 && optional[1] == 29)
    assert(!isset(array_widen_nullable(null)))
    let present = array_widen_nullable([int x 2]{ 29, 31 })
    assert(isset(present) && (present[0] ?? -1) == 29 && (present[1] ?? -1) == 31)
    let nested: [[int x 2] x 1] = { { 37, 41 } }
    let widened = array_widen_nested(nested)
    assert((widened[0][0] ?? -1) == 37 && (widened[0][1] ?? -1) == 41)
}

test "Array conversions: the source is evaluated once" {
    array_conversion_calls = 0
    let values: [?int x 2] = array_conversion_source()
    assert(array_conversion_calls == 1)
    assert((values[0] ?? -1) == 17 && (values[1] ?? -1) == 19)
}

class ArrayConversionItem { number: int }
class ArrayConversionOwner { values: [ArrayConversionItem x 2] }
fn array_copy_managed(values: &[ArrayConversionItem x 2]) [?ArrayConversionItem x 2] { return values }

test "Array conversions: compatible managed layouts retain their values" {
    let owner = ArrayConversionOwner {
        values: { ArrayConversionItem { number: 43 }, ArrayConversionItem { number: 47 } }
    }
    let copied = array_copy_managed(&owner.values)
    owner.values[0] = ArrayConversionItem { number: 53 }
    gc.collect()
    gc.collect()
    let first = copied[0]
    let second = copied[1]
    assert(isset(first) && first.number == 43)
    assert(isset(second) && second.number == 47)
    assert(owner.values[0].number == 53)
}

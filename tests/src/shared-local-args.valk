use valk.sync
use valk.thread

// A unique local passed to a shared parameter is published when the callee
// keeps it, the same way `let s: atomic T = local` does, and borrowed when
// the callee only reads it.

class LocalArgItem {
    names: Array[String] (.{})
    n: uint (1)
}
class LocalArgHub {
    items: Array[atomic LocalArgItem] (.{})
    last: ?atomic LocalArgItem (null)
    fn keep(i: atomic LocalArgItem) { this.items.append(i) }
    fn set_last(i: atomic LocalArgItem) { this.last = i }
}

shared LOCAL_ARG_INBOX: sync.Channel[atomic LocalArgItem] (sync.Channel[atomic LocalArgItem].new(64) !!)
fn local_arg_publish(item: atomic LocalArgItem) { LOCAL_ARG_INBOX.try_send(item) _ }
fn local_arg_read(item: atomic LocalArgItem) uint { return item.names.length + item.n }

interface LocalArgSink {
    fn put(i: atomic LocalArgItem);
}
class LocalArgListSink is LocalArgSink {
    items: Array[atomic LocalArgItem] (.{})
    fn put(i: atomic LocalArgItem) { this.items.append(i) }
}
interface LocalArgReader {
    fn look(i: atomic LocalArgItem) uint;
}
class LocalArgCounter is LocalArgReader {
    seen: uint (0)
    fn look(i: atomic LocalArgItem) uint {
        this.seen += i.n
        return this.seen
    }
}

// The callee's summary is still being computed inside the cycle
fn local_arg_rec_a(h: LocalArgHub, n: uint) {
    if n == 0 : return
    let item = LocalArgItem { n: n }
    item.names.append("rec")
    h.keep(item)
    local_arg_rec_b(h, n - 1)
}
fn local_arg_rec_b(h: LocalArgHub, n: uint) { local_arg_rec_a(h, n) }

fn local_arg_drain() Array[uint] {
    let found = Array[uint]{}
    while true {
        let item = LOCAL_ARG_INBOX.try_recv() ! break
        found.append(item.n)
    }
    return found
}

test "Shared local args: stored, branches, loops" {
    let h = LocalArgHub {}
    let item = LocalArgItem {}
    item.names.append("a")
    h.keep(item)
    assert(h.items.length == 1)
    assert(h.items[0].names[0] == "a")

    // Settled callee that stores
    let last = LocalArgItem { n: 4 }
    h.set_last(last)
    assert((h.last?.n ?? 0) == 4)

    // Published on one path, still usable on the other
    let c = LocalArgItem { n: 2 }
    if h.items.length > 5 {
        h.keep(c)
    } else {
        c.n = 3
        assert(c.n == 3)
    }

    // A fresh local per iteration
    let i: uint = 0
    while i < 3 {
        let x = LocalArgItem { n: i }
        x.names.append("x")
        h.keep(x)
        i++
    }
    assert(h.items.length == 4)
    assert(h.items[3].n == 2)

    // Published on the iteration that leaves the loop
    let once = LocalArgItem { n: 9 }
    let j: uint = 0
    while j < 5 {
        if j == 2 {
            h.keep(once)
            break
        }
        j++
    }
    assert(h.items.length == 5)
    assert(h.items[4].n == 9)

    // Data moved in before publishing goes along
    let inner = Array[String]{}
    inner.append("z")
    let z = LocalArgItem { names: inner }
    h.keep(z)
    assert(h.items[5].names[0] == "z")

    local_arg_rec_a(h, 2)
    assert(h.items.length == 8)
}

test "Shared local args: readers keep the local usable" {
    let q = LocalArgItem { n: 5 }
    assert(local_arg_read(q) == 5)
    q.n = 6
    assert(local_arg_read(q) == 6)

    let counter = LocalArgCounter {}
    let reader: LocalArgReader = counter
    let r = LocalArgItem { n: 4 }
    assert(reader.look(r) == 4)
    r.n = 5
    assert(reader.look(r) == 9)

    let list = LocalArgListSink {}
    let sink: LocalArgSink = list
    let k = LocalArgItem { n: 7 }
    sink.put(k)
    assert(list.items.length == 1)
    assert(list.items[0].n == 7)
}

#if !TEST_ST_ONLY && !TEST_MT_TODO
test "Shared local args: channels, coroutines, threads" {
    local_arg_drain()
    let b = LocalArgItem { n: 2 }
    b.names.append("b")
    local_arg_publish(b)

    each 0 .. 2 as k {
        let y = LocalArgItem { n: 10 + k }
        local_arg_publish(y)
    }

    let co_item = LocalArgItem { n: 6 }
    let task = co local_arg_publish(co_item)
    await task

    let t = thread.start(fn() {
        let local = LocalArgItem { n: 7 }
        local_arg_publish(local)
    }) !!
    t.await()

    let found = local_arg_drain()
    assert(found.length == 5)
    assert(found[0] == 2)
    assert(found[1] == 10)
    assert(found[2] == 11)
    assert(found[3] == 6)
    assert(found[4] == 7)

    let ch: atomic sync.Channel[atomic LocalArgItem] = sync.Channel[atomic LocalArgItem].new(2) !!
    let sent = LocalArgItem { n: 3 }
    ch.send(sent) !!
    assert((ch.recv() !!).n == 3)
}
#end

test "Shared local args: aliases that are never used again" {
    // A local that held the published graph may stay, as long as it is not used again
    let list = Array[LocalArgItem]{}
    let item = LocalArgItem { n: 4 }
    list.append(item)
    let s: atomic LocalArgItem = item
    assert(s.n == 4)

    let alias_source = LocalArgItem { n: 5 }
    let alias = alias_source
    let t: atomic LocalArgItem = alias_source
    assert(t.n == 5)
}

test "Shared local args: a local reassigned before an alias is published" {
    // Only the version that reaches the publication is used up
    let item = LocalArgItem { n: 6 }
    let keep = item
    item = LocalArgItem { n: 7 }
    let s: atomic LocalArgItem = keep
    item.n++
    assert(s.n == 6)
    assert(item.n == 8)
}

fn local_arg_rejoin(mode: uint) uint {
    let item = LocalArgItem { n: 1 }
    let keep = item
    if mode == 0 {
        item = LocalArgItem { n: 2 }
    } else {
        match mode {
            1 => item = LocalArgItem { n: 3 }
            default => item = LocalArgItem { n: 4 }
        }
    }
    let s: atomic LocalArgItem = keep
    item.n += 10
    return item.n + s.n
}

test "Shared local args: a local reassigned on every path before an alias is published" {
    assert(local_arg_rejoin(0) == 13)
    assert(local_arg_rejoin(1) == 14)
    assert(local_arg_rejoin(2) == 15)
    let item = LocalArgItem { n: 5 }
    let keep = item
    let n = <{
        if item.n > 1 {
            item = LocalArgItem { n: 6 }
            return 1
        }
        item = LocalArgItem { n: 7 }
        return 2
    }
    let s: atomic LocalArgItem = keep
    item.n += n
    assert(item.n == 7)
    assert(s.n == 5)
}

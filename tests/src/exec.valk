
use valk.core

test "Exec" {

    let code, out = core.exec("echo \"hello\"")
    #if OS == "win"
    assert(code == 0)
    assert(out == "\"hello\" \r\n")
    #else
    assert(code == 0)
    assert(out == "hello\n")
    #end



    let code1, _ = core.exec("unknowncomanndtotestvalk")
    #if OS == "win"
    assert(code1 == 1)
    #else
    assert(code1 == 127)
    #end

    // A second call has to work as well as the first: exec reuses buffers.
    let code2, out2 = core.exec("echo test")
    assert(code2 == 0)
    assert(out2.contains("test"))
}

#if OS != "win"
test "Exec preserves binary output and signal status" {
    let command = "printf 'a\\000b'"
    let code, output = core.exec(command)
    assert(command == "printf 'a\\000b'")
    assert(code == 0)
    assert(output.bytes == 3)
    assert(output.get(0) == 'a' && output.get(1) == 0 && output.get(2) == 'b')

    let signal_code, _ = core.exec("sh -c 'kill -TERM $$'")
    assert(signal_code == 143)
}

test "Exec can leave stderr separate" {
    let _, output = core.exec("sh -c 'echo out; echo err >&2' 2>/dev/null", false, false)
    assert(output == "out\n")
}
#end

use valk.core
use valk.thread
use valk.time

test "Mutex" {
    let m: shared core.Mutex = core.Mutex.new() ! {
        assert(false)
        return
    }
    let count = 0
    let ref: *int = @ref(count)
    let threads = Array[thread.Thread[void]]{}
    m.lock()
    let x = 0
    while x++ < 4 {
        let t = thread.start(fn(){
            m.await_unlock()
            let i = 0
            while i++ < 1000 {
                m.lock()
                ref[0]++
                m.unlock()
            }
        }) ! {
            assert(false)
            m.unlock()
            return
        }
        threads.append(t)
    }
    time.sleep_ms(100)
    m.unlock()
    each threads as t {
        t.await()
    }
    assert(count == 4000)
}

test "SyncMutexStruct: the value-carrying mutex holds and returns a value" {
    // The value-carrying branch was dead code that could not compile: it used an
    // undefined constant for the mutex storage and a `swap` expression the language
    // does not have
    assert(core.mutex_struct_value_for_test(41) == 42)
    assert(core.mutex_struct_value_for_test(-7) == -6)
    assert(core.mutex_struct_value_for_test(0) == 1)
}

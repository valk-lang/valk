slice MetadataNumbers of uint {
    // A named slice is built by its own class: a view over existing storage
    static fn over(values: &mut [uint]) SELF {
        @unsafe
        return SELF { owner: values.owner, data: values.data, length: values.length }
    }
}
slice MetadataCallbacks of fn(int)(int) {
    static fn over(values: &mut [fn(int)(int)]) SELF {
        @unsafe
        return SELF { owner: values.owner, data: values.data, length: values.length }
    }
}
array MetadataArray of uint {}

test "Sequence metadata: empty native containers are safe to construct" {
    let values = MetadataNumbers {}
    let callbacks = MetadataCallbacks {}
    let array = MetadataArray {}
    assert(values.length == 0)
    assert(callbacks.length == 0)
    assert(array.length == 0)
}

test "Sequence metadata: typed views over initialized storage need no unsafe code at the use site" {
    let backing = [uint x 3]{ 7 }
    let values = MetadataNumbers.over(backing)
    values[1] = 19
    assert(values.length == 3)
    assert(backing[1] == 19)
    // A named slice converts back to the bare forms
    let bare: &mut [uint] = values
    bare[2] = 23
    assert(backing[2] == 23)
    let callback: fn(int)(int) = fn(value: int) int { return value + 73 }
    let callbacks = MetadataCallbacks.over([fn(int)(int) x 2]{ callback })
    assert(callbacks[0](19) == 92)
    assert(callbacks[1](7) == 80)
}

test "Sequence metadata: trusted container code can manage its descriptor" {
    let values = MetadataNumbers {}
    @unsafe {
        values = MetadataNumbers { length: 3 }
        values.length--
        let length = &mut values.length
        length[0] = 1
    }
    values[0] = 73
    assert(values.length == 1)
    assert(values[0] == 73)
}

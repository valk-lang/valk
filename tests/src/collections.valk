use valk.gc

class Task {
    name: String
    priority: uint
}

test "HashSet: add, membership, removal and iteration" {
    let set = HashSet[String]{ "a", "b", "c" }
    assert(set.length == 3)
    assert(set.has("a") && set.has("c") && !set.has("d"))
    assert(!set.insert("a"))
    assert(set.insert("d"))
    assert(set.length == 4)
    assert(set.remove("b"))
    assert(!set.remove("b"))
    assert(set.length == 3)

    let seen = Array[String]{}
    each set as value, index {
        seen.append(value)
        assert(index == seen.length - 1)
    }
    assert(seen.length == 3)
    assert(seen.contains("a") && seen.contains("c") && seen.contains("d"))
    assert(set.items().length == 3)

    set.clear()
    assert(set.length == 0)
    assert(!set.has("a"))
}

test "HashSet: set algebra" {
    let a = HashSet[int]{ 1, 2, 3, 4 }
    let b = HashSet[int]{ 3, 4, 5 }
    let u = a.union(b)
    assert(u.length == 5 && u.has(1) && u.has(5))
    assert((a + b).equals(u))
    let i = a.intersection(b)
    assert(i.length == 2 && i.has(3) && i.has(4))
    let d = a.difference(b)
    assert(d.length == 2 && d.has(1) && d.has(2) && !d.has(3))
    assert((a - b).equals(d))
    let shrinking = a.copy()
    shrinking -= b
    assert(shrinking.equals(d))
    let growing = d.copy()
    growing += b
    assert(growing.equals(u))
    assert(i.is_subset_of(a) && i.is_subset_of(b) && !a.is_subset_of(b))
    assert(d.is_disjoint(b) && !a.is_disjoint(b))
    assert(a.equals(HashSet[int]{ 4, 3, 2, 1 }))
    assert(!a.equals(b))

    let copy = a.copy()
    copy.add(99)
    assert(!a.has(99) && copy.has(99))
    let big = HashSet[uint].new(1000)
    let n: uint = 0
    while n < 5000 {
        big.add(n * 7)
        n++
    }
    assert(big.length == 5000 && big.has(4999 * 7) && !big.has(1))
    gc.collect()
    assert(big.length == 5000)
}

test "Deque: both ends, indexing and rebalancing" {
    let d = Deque[String]{ "b", "c" }
    d.push_front("a")
    d.push_back("d")
    assert(d.length == 4)
    assert((d.peek_front() !? "") == "a")
    assert((d.peek_back() !? "") == "d")
    assert(d[0] == "a" && d[1] == "b" && d[2] == "c" && d[3] == "d")
    d[1] = "B" !!
    assert(d[1] == "B")
    assert(d.contains("B") && !d.contains("b"))
    let joined = ""
    each d as item, index {
        joined += item
        assert(item == d[index])
    }
    assert(joined == "aBcd")
    assert((d.pop_front() !? "") == "a")
    assert((d.pop_back() !? "") == "d")
    assert((d.pop_front() !? "") == "B")
    assert((d.pop_front() !? "") == "c")
    assert(d.is_empty())
    let empty = false
    d.pop_front() ! { empty = true }
    assert(empty)

    // Alternating pushes and pops from both ends keep FIFO order per end
    let q = Deque[uint]{}
    let i: uint = 0
    while i < 1000 {
        q.push_back(i)
        i++
    }
    i = 0
    while i < 500 {
        assert((q.pop_front() !? 9999) == i)
        i++
    }
    i = 1000
    while i > 500 {
        i--
        assert((q.pop_back() !? 9999) == i)
    }
    assert(q.is_empty())
    i = 0
    while i < 100 {
        q.push_front(i)
        q.push_back(i)
        i++
    }
    assert(q.length == 200)
    assert(q[0] == 99 && q[99] == 0 && q[100] == 0 && q[199] == 99)
    let arr = q.to_array()
    assert(arr.length == 200 && (arr.get(0) !? 1) == 99 && (arr.get(199) !? 1) == 99)
    let out_of_range = false
    q.get(200) ! { out_of_range = true }
    assert(out_of_range)
    gc.collect()
    assert((q.pop_back() !? 1) == 99 && (q.pop_front() !? 1) == 99)
}

test "Heap: min-heap order, custom comparator and drain" {
    let h = Heap[int]{ 5, 1, 4, 2, 3 }
    assert(h.length == 5)
    assert((h.peek() !? 0) == 1)
    assert((h.pop() !? 0) == 1)
    assert((h.pop() !? 0) == 2)
    h.push(0)
    assert((h.pop() !? 9) == 0)
    assert((h.replace(10) !? 0) == 3)
    let rest = h.drain()
    assert(rest.length == 3)
    assert((rest.get(0) !? 0) == 4 && (rest.get(1) !? 0) == 5 && (rest.get(2) !? 0) == 10)
    assert(h.is_empty())
    let empty = false
    h.pop() ! { empty = true }
    assert(empty)

    // Highest priority first, ties by name
    let tasks = Heap[Task].new(fn(a: Task, b: Task) bool {
        if a.priority != b.priority : return a.priority > b.priority
        return a.name < b.name
    })
    tasks.push(Task { name: "write", priority: 2 })
    tasks.push(Task { name: "read", priority: 5 })
    tasks.push(Task { name: "idle", priority: 0 })
    tasks.push(Task { name: "compile", priority: 5 })
    let order = ""
    while true {
        let task = tasks.pop() ! break
        order += task.name + " "
    }
    assert(order == "compile read write idle ")

    // Many random pushes come out sorted
    let big = Heap[uint]{}
    let state: uint = 7
    let i: uint = 0
    while i < 3000 {
        state = (state * 1103515245 + 12345) & 0x7fffffff
        big.push(state % 1000)
        i++
    }
    gc.collect()
    let last: uint = 0
    i = 0
    while i < 3000 {
        let value = big.pop() !? 0
        assert(value >= last)
        last = value
        i++
    }
    assert(big.is_empty())
    let strings = Heap[String]{ "pear", "apple", "fig" }
    assert((strings.pop() !? "") == "apple")
}

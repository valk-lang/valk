struct FillPair {
    name: String
    n: uint
}

test "Array fill literal: Array[T]{ v x n }" {
    let zeros = Array[uint]{ 0 x 5 }
    assert(zeros.length == 5)
    assert(zeros[4] == 0)

    let n: uint = 3
    let words = Array[String]{ "ab" x n }
    assert(words.join(",") == "ab,ab,ab")

    let none = Array[int]{ 7 x 0 }
    assert(none.length == 0)

    // Through a type hint, and by calling fill directly
    let hinted: Array[bool] = .{ true x 2 }
    assert(hinted.length == 2 && hinted[1])
    assert(Array[u8].fill(4, 9).sum() == 36)

    // A struct with a reference goes through the store guard in every slot
    let pairs = Array[FillPair]{ FillPair { name: "p", n: 2 } x 3 }
    assert(pairs.length == 3 && pairs[2].name == "p" && pairs[1].n == 2)
    pairs.append(FillPair { name: "q", n: 4 })
    assert(pairs.length == 4 && pairs[3].name == "q")

    // The repeated value is shared, not copied
    let inner = Array[int]{ 1 }
    let nested = Array[Array[int]]{ inner x 2 }
    nested[0].append(2)
    assert(nested[1].length == 2)
}

class FillPoint {
    name: String ("")
    x: int (0)
    y: int (0)
    z: int (0)
}

test "Array fill literal: a field named x on its own line is a field" {
    let p = FillPoint{
        name: "a"
        x: 1
        y: 2
        z: 3
    }
    assert(p.name == "a" && p.x == 1 && p.y == 2 && p.z == 3)
    let hinted: FillPoint = .{
        y: 5
        x: 4
    }
    assert(hinted.x == 4 && hinted.y == 5)
    let commas = FillPoint{ name: "b", x: 6 }
    assert(commas.x == 6)

    // The fill form still repeats, with `x n` on the line the value ends on
    let points = Array[FillPoint]{ FillPoint{
        name: "c"
        x: 7
    } x 2 }
    assert(points.length == 2 && points[1].x == 7 && points[1].name == "c")
    let lines = Array[uint]{
        9 x 3
    }
    assert(lines.length == 3 && lines[2] == 9)

    // A variable named x on its own line is an element
    let x : uint = 4
    let items = Array[uint]{
        1
        x
        x + 1
    }
    assert(items.length == 3 && items[1] == 4 && items[2] == 5)
}

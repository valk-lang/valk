use valk.compress
use valk.crypto
use valk.ext
use valk.gc
use valk.io
use valk.net
use valk.thread
use valk.time

// A reader that hands out `data`, then fails with `timeout`
class FixSysFailingReader is io.Reader {
    data: String
    pos: uint (0)

    + fn read(buf: mut &[u8]) uint !io.IoError {
        if this.pos >= this.data.bytes : throw .timeout
        let count = this.data.bytes - this.pos
        if count > buf.length : count = buf.length
        let i: uint = 0
        while i < count {
            buf[i] = this.data.get(this.pos + i)
            i++
        }
        this.pos += count
        return count
    }
}

test "Fix sys: Decompressor reports truncation and passes source errors through" {
    let buffer = ByteBuffer.new(1200)
    let n: uint = 0
    while n < 40 {
        buffer.write("Decompressor truncation test ")
        buffer.write_uint_ascii(n)
        buffer.write(". ")
        n++
    }
    let text = buffer.to_string()
    let packed = compress.gzip(text)

    // A truncated stream must not look like the end of input
    let cut = packed.range(0, packed.bytes / 2)
    let reader = compress.Decompressor.new(ByteReader.new(cut.view()), compress.Format.gzip)
    let code = ""
    io.read_all(reader) ! {
        if error_is(E.code, read) : code = "read"
        else if error_is(E.code, closed) : code = "closed"
        else : code = "other"
    }
    assert(code == "read")

    // An error from the source keeps its own code
    let failing = compress.Decompressor.new(FixSysFailingReader { data: cut }, compress.Format.gzip)
    let timeout = false
    io.read_all(failing) ! { timeout = error_is(E.code, timeout) }
    assert(timeout)

    // The whole stream still reads back
    let full = compress.Decompressor.new(ByteReader.new(packed.view()), compress.Format.gzip)
    assert((io.read_all(full) !!).to_string() == text)
}

test "Fix sys: Blake2b finalize writes into a checked buffer" {
    let b = crypto.Blake2b.new(32) !!
    b.update("abc")
    let out = [u8]{ 0xaa x 40 }
    b.finalize(out)
    let first: uint = out[0]
    let last: uint = out[31]
    let after: uint = out[32]
    // BLAKE2b-256("abc") = bddd813c...8a1b3319
    assert(first == 0xbd)
    assert(last == 0x19)
    assert(after == 0xaa)
}

test "Fix sys: ext struct layouts match C" {
    #if OS == "win"
    assert(size_of(ext.CRITICAL_SECTION_DEBUG) == 48)
    assert(size_of(ext.libc_timeval) == 8)
    #elif OS == "macos"
    assert(size_of(ext.sigevent) == 32)
    assert(size_of(ext.aiocb) == 80)
    #end
    assert(size_of(ext.libc_addrinfo) == 48)
}

test "Fix sys: addrinfo null fields are nullable" {
    @unsafe
    let info = net.AddrInfo.new("127.0.0.1", 80) !!
    let first = info.data
    assert(!isset(first.ai_canonname))
    assert(!isset(first.ai_next))
    assert(!info.is_ipv6())
}

test "Fix sys: gc.alloc of size 0 returns a valid allocation" {
    @unsafe
    let a = gc.alloc(0).@cast(?ptr)
    let b = gc.alloc(0).@cast(?ptr)
    let t = gc.alloc_typed(0, null).@cast(?ptr)
    assert(isset(a))
    assert(isset(b))
    assert(isset(t))
    assert(a != b)
}

// Sequential: another test allocating between its usage add and its peak update would race
synctest "Fix sys: mem_usage_peak covers the current usage" {
    let tasks = Array[thread.Task]{}
    let i: uint = 0
    while i < 4 {
        tasks.append(thread.task(fn() {
            let keep = Array[String]{}
            let j: uint = 0
            while j < 2000 {
                keep.append("item " + j.to_string())
                j++
            }
        }) !!)
        i++
    }
    each tasks as task : task.await()
    assert(gc.mem_usage_peak >= gc.mem_usage())
    assert(gc.mem_usage_peak > 0)
}

fn fix_sys_coro_sleep() uint {
    let start = time.mono_ns()
    time.sleep_ns(300_000)
    return time.mono_ns() - start
}

test "Fix sys: coroutine sleep_ns lasts at least the given time" {
    let task = co fix_sys_coro_sleep()
    let elapsed = await task
    assert(elapsed >= 300_000)
}

test "Fix sys: DateTime.new defaults missing trailing parts to their minimum" {
    let date = time.DateTime.new(2024, 3, 5) !!
    assert(date.year() == 2024)
    assert(date.month() == 3)
    assert(date.day() == 5)
    assert(date.hour() == 0)
    assert(date.minute() == 0)
    assert(date.second() == 0)
    assert(date.microsecond() == 0)

    let year = time.DateTime.new(2024) !!
    assert(year.month() == 1)
    assert(year.day() == 1)
    assert(year.hour() == 0)

    let before = time.DateTime.now()
    let nine = time.DateTime.new(null, null, null, 9) !!
    let after = time.DateTime.now()
    assert(nine.hour() == 9)
    assert(nine.minute() == 0)
    assert(nine.second() == 0)
    assert(nine.microsecond() == 0)
    assert(nine.day() == before.day() || nine.day() == after.day())
}


fn maybenot() bool {
    return false
}

test "Null checking: ??" {
    let s : ?String = <{ return null }
    let s2 = <{ return s } ?? <{ return "1" }
    assert(s2 == "1")
    s = "2"
    s2 = <{
        if maybenot() : return null
        return "2"
    } ?? <{ return "1" }
    assert(s2 == "2")
}

// A value scope with no outer type expectation infers its result type from the
// returns, widening to `?T` when any branch returns null. The returns collected
// before the widening must be re-wrapped, so these also cover the case where the
// re-wrapped branch is the one that produces the value.
test "Null: vscope infers nullable result" {
    let taken = <{
        if !maybenot() : return "a"
        return null
    }
    assert(isset(taken) && taken == "a")

    let missed = <{
        if maybenot() : return "b"
        return null
    }
    assert(!isset(missed))
}

test "Null: vscope infers nullable inline result" {
    let taken = <{
        if !maybenot() : return 7
        return null
    }
    assert(isset(taken) && taken == 7)

    let missed = <{
        if maybenot() : return 9
        return null
    }
    assert(!isset(missed))
}

// `.{}` produces an object, so it narrows a nullable local even though the
// expectation at the assignment was `?T`.
class NCHolder {
    data: ?Map[String] (null)

    fn get_data() Map[String] {
        let d = this.data
        if !isset(d) {
            d = .{}
            this.data = d
        }
        return d
    }
}

test "Null: object literal narrows" {
    let h = NCHolder{}
    let d = h.get_data()
    d.set("k", "v")
    assert(h.get_data().length == 1)
}

// A fact established before a loop survives it when the body never assigns the
// declaration a possibly-null value, so `x` is still non-null after the loop.
test "Null: fact survives loop" {
    let x : ?String = "a"
    let seen = 0
    let items = Array[String]{ "p", "q" }
    each items as item {
        seen += item.bytes
    }
    let t : String = x
    assert(t == "a")
    assert(seen == 2)
}

// A loop that invalidates a nullable local must re-check it inside the body. The
// check has to hold per-iteration, so `isset` must not be folded away using a fact
// established before the loop.
test "Null: loop re-checks nullable" {
    let x : ?String = "a"
    let n = 0
    let i = 0
    while i++ < 3 {
        if isset(x) : n += 10
        else : n += 1
        x = null
    }
    assert(n == 12)
}

test "Null: while-loop" {
    let x : ?String = "x"
    let z = ""
    while isset(x) {
        let i = 0
        while i++ < 2 {
            z += x
        }
        x = null
    }
    assert(z == "xx")
}

test "Null: each-loop" {
    let list = Array[String]{ "a", "b", "c" }
    let x : ?String = "x"
    let z = ""
    each list as item, i {
        if isset(x) && i < 2 : z += x + item
        else : x = null
    }
    assert(z == "xaxb")
}

test "Null: dont merge not_null" {
    let x : ?String = "x"
    if true {
        x = null
        return
    }
    x + x
}

test "Null: isset && ..." {
    let x : ?String = null
    let y : ?String = null
    if isset(x) && isset(y) && x.bytes > 0 && y.bytes > 0 {
        println(x.bytes)
        println(y.bytes)
    }

    let z = isset(x) ? x.bytes : "a".bytes
    assert(z == 1)
}

class NCSOrHolder {
    value: uint
}

test "Null: !isset || property access" {
    let absent: ?NCSOrHolder = null
    if !isset(absent) || absent.value == 1 {
        assert(true)
    }

    let present: ?NCSOrHolder = NCSOrHolder { value: 7 }
    assert(isset(present))
    assert(!isset(present) || present.value == 7)
}

fn nc_maybe(set: bool) ?String {
    if set : return "v"
    return null
}

fn nc_fail(msg: String) !AnError $throw {
    throw .error
}

// The guard is a call to a `$throw` function rather than a `throw` statement. It
// still cannot return, so the code after the `if` is only reachable with x set.
fn nc_guarded_colon(set: bool) uint !AnError {
    let x = nc_maybe(set)
    if !isset(x) : nc_fail("unset") !>
    return x.bytes
}

fn nc_guarded_block(set: bool) uint !AnError {
    let x = nc_maybe(set)
    if !isset(x) {
        nc_fail("unset") !>
    }
    return x.bytes
}

test "Null: $throw call guard proves non-null" {
    assert((nc_guarded_colon(true) !? 0) == 1)
    assert((nc_guarded_block(true) !? 0) == 1)
    // The guard really does throw when the value is unset
    assert((nc_guarded_colon(false) !? 99) == 99)
    assert((nc_guarded_block(false) !? 99) == 99)
}

// A declaration still typed `?T` can be proven set on this path, and copying it
// carries that over. Judged by fact rather than declared type, so an assignment
// between two `?T` locals does not lose what was already proven.
test "Null: fact carries across assignment" {
    let x = nc_maybe(true)
    if !isset(x) {
        assert(false)
        return
    }
    let y : ?String = null
    y = x
    assert(y.bytes == 1)
}

// The carried fact is re-established every iteration, so it survives the loop.
// A body that also assigned x something nullable would be rejected instead.
test "Null: carried fact inside a loop" {
    let x = nc_maybe(true)
    if !isset(x) {
        assert(false)
        return
    }
    let y : ?String = null
    let count = 0
    let i = 0
    while i < 3 {
        y = x
        count += y.bytes
        i++
    }
    assert(count == 3)
}

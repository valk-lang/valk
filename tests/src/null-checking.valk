
fn maybenot() bool {
    return false
}

test "Null checking: ??" {
    let s : ?String = <{ return null }
    let s2 = <{ return s } ?? <{ return "1" }
    assert(s2 == "1")
    s = "2"
    s2 = <{
        if maybenot() : return null
        return "2"
    } ?? <{ return "1" }
    assert(s2 == "2")
}





global nc_calls: uint

fn nc_counted(set: bool) ?String {
    nc_calls++
    if !set : return null
    return "v"
}

// The operand is read by the null check and again as the result; a call
// must still run only once
test "Null: ?? and ?! evaluate the operand once" {
    nc_calls = 0
    let a = nc_counted(true) ?? "alt"
    assert(a == "v")
    assert(nc_calls == 1)

    nc_calls = 0
    let b = nc_counted(false) ?? "alt"
    assert(b == "alt")
    assert(nc_calls == 1)

    nc_calls = 0
    let c = nc_counted(true) ?! return
    assert(c == "v")
    assert(nc_calls == 1)

    nc_calls = 0
    let d: String = <{
        let inner = nc_counted(false) ?! return "exited"
        return inner
    }
    assert(d == "exited")
    assert(nc_calls == 1)
}

test "Null: vscope infers nullable result" {
    let taken = <{
        if !maybenot() : return "a"
        return null
    }
    assert(isset(taken) && taken == "a")

    let missed = <{
        if maybenot() : return "b"
        return null
    }
    assert(!isset(missed))
}

test "Null: vscope infers nullable inline result" {
    let taken = <{
        if !maybenot() : return 7
        return null
    }
    assert(isset(taken) && taken == 7)

    let missed = <{
        if maybenot() : return 9
        return null
    }
    assert(!isset(missed))
}



class NCHolder {
    data: ?Map[String] (null)

    fn get_data() Map[String] {
        let d = this.data
        if !isset(d) {
            d = .{}
            this.data = d
        }
        return d
    }
}

test "Null: object literal narrows" {
    let h = NCHolder{}
    let d = h.get_data()
    d.set("k", "v")
    assert(h.get_data().length == 1)
}



test "Null: fact survives loop" {
    let x : ?String = "a"
    let seen = 0
    let items = Array[String]{ "p", "q" }
    each items as item {
        seen += item.bytes
    }
    let t : String = x
    assert(t == "a")
    assert(seen == 2)
}




test "Null: loop re-checks nullable" {
    let x : ?String = "a"
    let n = 0
    let i = 0
    while i++ < 3 {
        if isset(x) : n += 10
        else : n += 1
        x = null
    }
    assert(n == 12)
}

test "Null: while-loop" {
    let x : ?String = "x"
    let z = ""
    while isset(x) {
        let i = 0
        while i++ < 2 {
            z += x
        }
        x = null
    }
    assert(z == "xx")
}

test "Null: each-loop" {
    let list = Array[String]{ "a", "b", "c" }
    let x : ?String = "x"
    let z = ""
    each list as item, i {
        if isset(x) && i < 2 : z += x + item
        else : x = null
    }
    assert(z == "xaxb")
}

test "Null: dont merge not_null" {
    let x : ?String = "x"
    if true {
        x = null
        return
    }
    x + x
}

test "Null: isset && ..." {
    let x : ?String = null
    let y : ?String = null
    if isset(x) && isset(y) && x.bytes > 0 && y.bytes > 0 {
        println(x.bytes)
        println(y.bytes)
    }

    let z = isset(x) ? x.bytes : "a".bytes
    assert(z == 1)
}

class NCSOrHolder {
    value: uint
}

test "Null: !isset || property access" {
    let absent: ?NCSOrHolder = null
    if !isset(absent) || absent.value == 1 {
        assert(true)
    }

    let present: ?NCSOrHolder = NCSOrHolder { value: 7 }
    assert(isset(present))
    assert(!isset(present) || present.value == 7)
}

fn nc_maybe(set: bool) ?String {
    if set : return "v"
    return null
}

fn nc_fail(msg: String) !AnError $throw {
    throw .error
}



fn nc_guarded_colon(set: bool) uint !AnError {
    let x = nc_maybe(set)
    if !isset(x) : nc_fail("unset") !>
    return x.bytes
}

fn nc_guarded_block(set: bool) uint !AnError {
    let x = nc_maybe(set)
    if !isset(x) {
        nc_fail("unset") !>
    }
    return x.bytes
}

test "Null: $throw call guard proves non-null" {
    assert((nc_guarded_colon(true) !? 0) == 1)
    assert((nc_guarded_block(true) !? 0) == 1)
    // The guard really does throw when the value is unset
    assert((nc_guarded_colon(false) !? 99) == 99)
    assert((nc_guarded_block(false) !? 99) == 99)
}




class NCBorrowedNode {
    v: int (1)
}

fn nc_wipe_borrowed(p: &?NCBorrowedNode) {
    p[0] = null
}

test "Null: borrow does not keep a stale non-null fact" {
    let x: ?NCBorrowedNode = NCBorrowedNode {}
    if !isset(x) {
        assert(false)
        return
    }
    nc_wipe_borrowed(&x)
    assert(!isset(x))
    x = NCBorrowedNode { v: 4 }
    let t: NCBorrowedNode = x
    assert(t.v == 4)
}

test "Null: while-loop borrow after use" {
    let x: ?NCBorrowedNode = NCBorrowedNode { v: 3 }
    let z = 0
    while isset(x) {
        z += x.v
        nc_wipe_borrowed(&x)
    }
    assert(z == 3)
    assert(!isset(x))
}

test "Null: fact carries across assignment" {
    let x = nc_maybe(true)
    if !isset(x) {
        assert(false)
        return
    }
    let y : ?String = null
    y = x
    assert(y.bytes == 1)
}



test "Null: carried fact inside a loop" {
    let x = nc_maybe(true)
    if !isset(x) {
        assert(false)
        return
    }
    let y : ?String = null
    let count = 0
    let i = 0
    while i < 3 {
        y = x
        count += y.bytes
        i++
    }
    assert(count == 3)
}

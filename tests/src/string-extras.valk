
test "String.split with a limit" {
    assert("key=a=b".split("=", 2).join("|") == "key|a=b")
    assert("a,b,c".split(",", 1).join("|") == "a,b,c")
    assert("a,b,c".split(",", 5).join("|") == "a|b|c")
    assert("a,b,c".split(",").join("|") == "a|b|c")
    assert("abc".split("", 2).join("|") == "a|bc")
    assert("a😀b😀c".utf8.split("😀", 2).join("|") == "a|b😀c")
}

test "String.lines" {
    assert("one\ntwo\r\nthree\n".lines().join("|") == "one|two|three")
    assert("".lines().length == 0)
    assert("\n\nx".lines().join("|") == "||x")
    assert("no break".lines().length == 1)
}

test "String.last_index_of, count and repeat" {
    assert("a/b/c".last_index_of("/") !! == 3)
    assert(("abc".last_index_of("x") !? 99) == 99)
    assert("abc".last_index_of("") !! == 3)
    assert("abcabc".last_index_of("abc") !! == 3)
    assert("a,b,,c".count(",") == 3)
    assert("aaaa".count("aa") == 2)
    assert("abc".count("") == 0)
    assert("ab".repeat(3) == "ababab")
    assert("x".repeat(0) == "")
    assert("".repeat(5) == "")
}

test "String.trim removes Unicode spaces" {
    assert(" \u{00A0}hi\u{3000} \t".trim() == "hi")
    assert("\u{2003}x\u{205F}".trim() == "x")
    assert("\u{00A0}x".ltrim() == "x")
    assert("x\u{00A0}".rtrim() == "x")
    // Other characters are left alone, whole
    assert("é ".trim() == "é")
    assert("\u{00A1}x".trim() == "\u{00A1}x")
    // The limit counts characters
    assert("  x  ".trim(null, 1) == " x ")
    assert("\u{3000}\u{3000}x".ltrim(null, 1) == "\u{3000}x")
}

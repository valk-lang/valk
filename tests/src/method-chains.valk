// A method chain may run over several lines inside a statement: a line that starts with `.name`
// continues the value before it, because no statement can begin with one.

enum ChainColor {
    red
    green
    blue
}

class ChainQuery {
    parts: Array[String] (.{})
    rows: uint (0)

    static fn select(columns: String ("*")) ChainQuery {
        return ChainQuery { parts: .{ "select " + columns } }
    }
    fn from(table: String) SELF {
        this.parts.append("from " + table)
        return this
    }
    fn where(condition: String) SELF {
        this.parts.append("where " + condition)
        return this
    }
    fn limit(rows: uint) SELF {
        this.rows = rows
        return this
    }
    get sql: String {
        return this.parts.join(" ") + " limit " + this.rows
    }
}

fn chain_name_of(color: ChainColor) String {
    return match color : String {
        .red => "red"
        .green => "green"
        default => "blue"
    }
}

// A statement match: a one-line case body is followed by the next `.member` case
fn chain_statement_name(color: ChainColor) String {
    match color {
        .red => return "r"
        .green => return "g"
        .blue => return "b"
    }
}

fn chain_built() ChainQuery {
    return ChainQuery.select("id")
        .from("users")
        .limit(1)
}

fn chain_length(text: String) uint {
    return text.length
}

test "Chains: a statement value continues on the next line" {
    let query = ChainQuery.select("id, name")
        .from("users")
        .where("age > 18")
        .limit(10)
    assert(query.sql == "select id, name from users where age > 18 limit 10")

    // As the value of a return
    assert(chain_built().sql == "select id from users limit 1")

    // A chain that is a statement of its own
    let other = ChainQuery.select("x")
    other.from("t")
        .where("a = 1")
    assert(other.sql == "select x from t where a = 1 limit 0")

    // Inside the arguments of a call
    assert(chain_length(ChainQuery.select("y")
        .from("t")
        .sql) > 0)

    // Comments and blank lines between the parts
    let commented = ChainQuery.select("z")
        .from("t")

        // pick only a few
        .limit(2)
    assert(commented.sql == "select z from t limit 2")

    // A getter ends a chain as well
    let text = ChainQuery.select("q")
        .from("t")
        .sql
    assert(text.starts_with("select q"))
}

test "Chains: a leading dot elsewhere still names a member of the expected type" {
    // Match arms are read one by one, so their leading dots are not continuations
    assert(chain_name_of(ChainColor.red) == "red")
    assert(chain_name_of(ChainColor.green) == "green")
    assert(chain_name_of(ChainColor.blue) == "blue")
    assert(chain_statement_name(ChainColor.red) == "r")
    assert(chain_statement_name(ChainColor.green) == "g")
    assert(chain_statement_name(ChainColor.blue) == "b")

    // The items of a literal, written over several lines without commas
    let colors = Array[ChainColor]{ .red, .green }
    assert(colors.length == 2)
    let by_name: Map[ChainColor] = .{
        "first" => .red
        "second" => .green
    }
    assert(by_name.length == 2)
    assert(chain_name_of(by_name.get("second") !? ChainColor.red) == "green")

    // A condition is not a statement value, so its body block is still its own
    let seen: uint = 0
    if ChainQuery.select("a").from("t").rows == 0 {
        seen++
    }
    assert(seen == 1)
}

class LiveViewCell { number: int }
struct LiveViewEntry {
    first: LiveViewCell
    second: LiveViewCell
    fn sum() int { return this.first.number + this.second.number }
}
struct NestedViewEntry { entry: LiveViewEntry }
struct NullableViewEntry { cell: ?LiveViewCell }
union LiveViewChoice : LiveViewCell | int {}
union ZeroViewChoice : int | bool {}
class LiveViewCounter { calls: int (0) }

fn live_borrow_source(counter: LiveViewCounter, entries: Array[LiveViewEntry]) mut &LiveViewEntry {
    counter.calls++
    return &entries[0]
}

test "Array views: borrowed fields can restore cleared storage" {
    let entries = Array[LiveViewEntry]{ LiveViewEntry {
        first: LiveViewCell { number: 7 }
        second: LiveViewCell { number: 19 }
    } }
    let counter = LiveViewCounter {}
    assert(live_borrow_source(counter, entries).second.number == 19)
    assert(counter.calls == 1)
    let borrowed = &entries[0]
    let bound = borrowed.sum
    assert(bound() == 26)
    let view = entries.view()
    entries.clear()
    borrowed.first = LiveViewCell { number: 73 }
    assert(borrowed.first.number == 73)
    borrowed.second = LiveViewCell { number: 19 }
    let copied = view[0]
    assert(copied.sum() == 92 && bound() == 92)
}

test "Array views: borrowed nested fields remain writable" {
    let entries = Array[NestedViewEntry]{ NestedViewEntry { entry: {
        first: LiveViewCell { number: 7 }
        second: LiveViewCell { number: 19 }
    } } }
    let borrowed = &entries[0]
    entries.clear()
    borrowed.entry.first = LiveViewCell { number: 73 }
    assert(borrowed.entry.first.number == 73)
    borrowed.entry.second = LiveViewCell { number: 19 }
    assert(borrowed.entry.sum() == 92)
    let numbers = Array[NullableViewEntry]{ NullableViewEntry { cell: LiveViewCell { number: 7 } } }
    let nullable = &numbers[0]
    numbers.clear()
    assert(!isset(nullable.cell))
}

fn live_view_source(counter: LiveViewCounter) mut &[LiveViewEntry] {
    counter.calls++
    return [LiveViewEntry]{ LiveViewEntry {
        first: LiveViewCell { number: 7 }
        second: LiveViewCell { number: 19 }
    } }
}

test "Array views: presence checks evaluate computed inline values once" {
    let counter = LiveViewCounter {}
    assert(live_view_source(counter)[0].second.number == 19)
    assert(counter.calls == 1)
    let value = live_view_source(counter)[0]
    assert(value.first.number == 7 && value.second.number == 19)
    assert(counter.calls == 2)
    let copied = live_view_source(counter).get(0) !!
    assert(copied.first.number == 7 && counter.calls == 3)
}

test "Array views: live callbacks and union alternatives remain usable" {
    let callbacks = Array[fn(int)(int)]{ fn(value: int) int { return value + 73 } }
    let view = callbacks.view()
    assert(view[0](19) == 92)
    assert((view.get(0) !!)(7) == 80)
    each view as callback : assert(callback(1) == 74)
    let choices = Array[LiveViewChoice]{ LiveViewCell { number: 73 }, 19 }
    let choice_view = choices.view()
    assert(choice_view[1] == 19)
    let choice = choice_view[0]
    match choice {
        LiveViewCell as cell => assert(cell.number == 73)
        int => assert(false)
    }
}

test "Array views: cleared nullable and plain values stay valid" {
    let values = Array[?LiveViewCell]{ LiveViewCell { number: 73 } }
    let view = values.view()
    values.clear()
    assert(!isset(view[0]))
    let entries = Array[NullableViewEntry]{ NullableViewEntry { cell: LiveViewCell { number: 19 } } }
    let entry_view = entries.view()
    entries.clear()
    assert(!isset(entry_view[0].cell))
    let numbers = Array[int]{ 73 }
    let number_view = numbers.view()
    numbers.clear()
    assert(number_view[0] == 0)
    let choices = Array[ZeroViewChoice]{ 73 }
    let choice_view = choices.view()
    choices.clear()
    match choice_view[0] {
        int as value => assert(value == 0)
        bool as value => assert(!value)
    }
}

use valk.json

trait AuditTags {
    created_at: int (0) $tag(json: "createdAt", omitempty)
}

class TaggedUser {
    use AuditTags
    id: int $tag(json: "user_id", db: "id", pk)
    name: String $tag(json: "full_name") $tag(db: "name", indexed)
    secret: String ("hidden") $tag(json: "-")
    internal_count: int $tag(json: "-")
    cached: ?String $tag(json: "-")
    bio: ?String (null) $tag(json: "bio", omitempty)
    nickname: String ("") $tag(omitempty)
    score: int $tag(omitempty)
    ratio: float $tag(omitempty)
    active: bool $tag(omitempty)
    tags: Array[String] (.{}) $tag(omitempty)
    meta: Map[int] (.{}) $tag(omitempty)
    labels: HashSet[String] (.{}) $tag(omitempty)
    queue: Deque[int] (.{}) $tag(omitempty)
    extra: FlatMap[String, int] (.{}) $tag(omitempty)
    dyn: json.Value (null) $tag(omitempty)
}

struct TaggedPoint {
    x: int $tag(json: "px")
    y: int $tag(json: "py", omitempty)
    scratch: int $tag(json: "-")
}

class TaggedBox[T] {
    value: T $tag(json: "item")
    label: String ("") $tag(omitempty)
}

class EscapedTagModel {
    quoted: String $tag(json: "a\"b\\c")
    unicode: int $tag(json: "café")
}

class ExtendedBase {
    a: int $tag(json: "alpha")
}

extend ExtendedBase {
    b: String ("") $tag(json: "beta", omitempty)
}

class AllOmitted {
    secret: int $tag(json: "-")
    note: String ("") $tag(omitempty)
}

class ShortTagUser {
    id: int `json: "user_id", db: "id", pk`
    name: String `json: "full_name"` $tag(db: "name", indexed)
    secret: String ("hidden") `json: "-"`
    bio: ?String (null) `json: "bio", omitempty`
}

struct ShortTagPoint {
    x: int `json: "px"`
    y: int `json: "py", omitempty`
}

fn describe_props[T]() Array[String] {
    let out = Array[String]{}
    #loop properties T as prop
    let has_json = prop.$has_tag("json") ? "1" : "0"
    let has_pk = prop.$has_tag("pk") ? "1" : "0"
    let has_missing = prop.$has_tag("nope") ? "1" : "0"
    let j1 = prop.$tag("json")
    let j2 = prop.$tag("json", prop.name)
    let j3 = prop.$tag("json", prop)
    let db = prop.$tag("db", "none")
    #if prop.$has_tag("indexed")
    let idx = "idx"
    #else
    let idx = "-"
    #end
    out.append(prop.name + ":" + has_json + has_pk + has_missing + ":" + j1 + ":" + j2 + ":" + j3 + ":" + db + ":" + idx)
    #end
    return out
}

fn collect_object_tags(obj: $T) Array[String] {
    let out = Array[String]{}
    #loop object obj as prop
    #if prop.$tag("json") != "-"
    out.append(prop.$tag("json", prop.name) + "=" + prop)
    #end
    #end
    return out
}

test "Field tags: compile-time reflection on classes, structs, generics, traits, extend" {
    let user_props = describe_props[TaggedUser]()
    assert(user_props.contains("created_at:100:createdAt:createdAt:createdAt:none:-"))
    assert(user_props.contains("id:110:user_id:user_id:user_id:id:-"))
    assert(user_props.contains("name:100:full_name:full_name:full_name:name:idx"))
    assert(user_props.contains("secret:100:-:-:-:none:-"))
    assert(user_props.contains("nickname:000::nickname:nickname:none:-"))

    let pt_props = describe_props[TaggedPoint]()
    assert(pt_props.length == 3)
    assert(pt_props[0] == "x:100:px:px:px:none:-")
    assert(pt_props[1] == "y:100:py:py:py:none:-")
    assert(pt_props[2] == "scratch:100:-:-:-:none:-")

    let box_props = describe_props[TaggedBox[int]]()
    assert(box_props.length == 2)
    assert(box_props[0] == "value:100:item:item:item:none:-")
    assert(box_props[1] == "label:000::label:label:none:-")

    let ext_props = describe_props[ExtendedBase]()
    assert(ext_props.length == 2)
    assert(ext_props[0] == "a:100:alpha:alpha:alpha:none:-")
    assert(ext_props[1] == "b:100:beta:beta:beta:none:-")

    let pt = TaggedPoint { x: 10, y: 20, scratch: 99 }
    let pairs = collect_object_tags(pt)
    assert(pairs.length == 2)
    assert(pairs[0] == "px=10")
    assert(pairs[1] == "py=20")
}

test "Field tags: JSON encode/from/decode_to rename, skip, and omitempty" {
    // All omitempty fields empty -> only required fields appear
    let empty_u = TaggedUser {
        id: 7
        name: "Ada"
        secret: "top-secret"
        internal_count: 42
        cached: "memo"
    }
    let encoded = json.encode(empty_u)
    assert(encoded == "{\"user_id\":7,\"full_name\":\"Ada\"}")

    let val = json.from(empty_u)
    assert(val.object.length == 2)
    assert(val.get("user_id").int == 7)
    assert(val.get("full_name").string == "Ada")
    assert(!val.has("secret"))
    assert(!val.has("internal_count"))
    assert(!val.has("cached"))
    assert(!val.has("bio"))
    assert(!val.has("nickname"))
    assert(!val.has("score"))
    assert(!val.has("ratio"))
    assert(!val.has("active"))
    assert(!val.has("tags"))
    assert(!val.has("meta"))
    assert(!val.has("labels"))
    assert(!val.has("queue"))
    assert(!val.has("extra"))
    assert(!val.has("dyn"))
    assert(!val.has("createdAt"))

    // Decode minimal JSON back (both fast path decode_to and Value.to_type)
    // Include skipped field names in input JSON to verify they are ignored!
    let input = "{\"user_id\":7,\"full_name\":\"Ada\",\"secret\":\"hacked\",\"internal_count\":999,\"cached\":\"bad\"}"
    let d1 = json.decode_to[TaggedUser](input) ! panic("decode_to failed")
    assert(d1.id == 7)
    assert(d1.name == "Ada")
    assert(d1.secret == "hidden")
    assert(d1.internal_count == 0)
    assert(!isset(d1.cached))
    assert(!isset(d1.bio))
    assert(d1.nickname == "")
    assert(d1.score == 0)
    assert(d1.ratio == 0.0)
    assert(!d1.active)
    assert(d1.tags.length == 0)
    assert(d1.meta.length == 0)
    assert(d1.created_at == 0)

    let parsed = json.decode(input) ! panic("decode failed")
    let d2 = parsed.to_type[TaggedUser]() ! panic("to_type failed")
    assert(d2.id == 7)
    assert(d2.name == "Ada")
    assert(d2.secret == "hidden")
    assert(d2.internal_count == 0)
    assert(!isset(d2.cached))
    assert(d2.score == 0)
    assert(!d2.active)

    // Populated omitempty fields are emitted and round-trip
    let labels = HashSet[String]{}
    labels.add("vip")
    let q = Deque[int]{}
    q.push_back(5)
    let ex = FlatMap[String, int]{}
    ex.set("k", 3)

    let full_u = TaggedUser {
        created_at: 1700000000
        id: 9
        name: "Grace"
        secret: "never-emitted"
        internal_count: 100
        bio: "compiler pioneer"
        nickname: "amazing"
        score: -4
        ratio: 1.5
        active: true
        tags: .{ "a", "b" }
        meta: .{ "x" => 1 }
        labels: labels
        queue: q
        extra: ex
        dyn: "present"
    }
    let full_json = json.encode(full_u)
    let full_val = json.from(full_u)
    assert(full_val.get("createdAt").int == 1700000000)
    assert(full_val.get("user_id").int == 9)
    assert(full_val.get("full_name").string == "Grace")
    assert(!full_val.has("secret"))
    assert(full_val.get("bio").string == "compiler pioneer")
    assert(full_val.get("nickname").string == "amazing")
    assert(full_val.get("score").int == -4)
    assert(full_val.get("ratio").float == 1.5)
    assert(full_val.get("active").bool)
    assert(full_val.get("tags").array.length == 2)
    assert(full_val.get("meta").get("x").int == 1)
    assert(full_val.get("labels").array.length == 1)
    assert(full_val.get("queue").array.length == 1)
    assert(full_val.get("extra").get("k").int == 3)
    assert(full_val.get("dyn").string == "present")

    let rt = json.decode_to[TaggedUser](full_json) ! panic("full decode_to failed")
    assert(rt.created_at == 1700000000)
    assert(rt.id == 9)
    assert(rt.name == "Grace")
    assert(rt.secret == "hidden")
    assert(rt.bio == "compiler pioneer")
    assert(rt.nickname == "amazing")
    assert(rt.score == -4)
    assert(rt.ratio == 1.5)
    assert(rt.active)
    assert(rt.tags.length == 2 && rt.tags[1] == "b")
    assert((rt.meta.get("x") !? 0) == 1)
    assert(rt.labels.has("vip"))
    assert(rt.queue.length == 1)
    assert((rt.extra.get("k") !? 0) == 3)
    assert(rt.dyn.string == "present")

    // Nullable String with empty string "" is also omitted by omitempty
    let empty_bio = TaggedUser { id: 1, name: "X", bio: "" }
    assert(json.encode(empty_bio) == "{\"user_id\":1,\"full_name\":\"X\"}")
}

test "Field tags: structs, generics, escaped keys, and all-omitted objects in JSON" {
    let p0 = TaggedPoint { x: 3, y: 0, scratch: 77 }
    assert(json.encode(p0) == "{\"px\":3}")
    let p0_rt = json.decode_to[TaggedPoint](json.encode(p0)) ! panic("point decode failed")
    assert(p0_rt.x == 3 && p0_rt.y == 0 && p0_rt.scratch == 0)

    let p1 = TaggedPoint { x: 3, y: 4, scratch: 77 }
    assert(json.encode(p1) == "{\"px\":3,\"py\":4}")
    let p1_rt = json.decode_to[TaggedPoint](json.encode(p1)) ! panic("point1 decode failed")
    assert(p1_rt.x == 3 && p1_rt.y == 4 && p1_rt.scratch == 0)

    let b = TaggedBox[int] { value: 123 }
    assert(json.encode(b) == "{\"item\":123}")
    let b_rt = json.decode_to[TaggedBox[int]]("{\"item\":456}") ! panic("box decode failed")
    assert(b_rt.value == 456 && b_rt.label == "")

    let esc = EscapedTagModel { quoted: "ok", unicode: 5 }
    let esc_json = json.encode(esc)
    assert(esc_json == "{\"a\\\"b\\\\c\":\"ok\",\"café\":5}")
    let esc_rt = json.decode_to[EscapedTagModel](esc_json) ! panic("escaped decode_to failed")
    assert(esc_rt.quoted == "ok" && esc_rt.unicode == 5)
    let esc_val = json.decode(esc_json) ! panic("escaped decode failed")
    let esc_rt2 = esc_val.to_type[EscapedTagModel]() ! panic("escaped to_type failed")
    assert(esc_rt2.quoted == "ok" && esc_rt2.unicode == 5)

    let all_gone = AllOmitted { secret: 9, note: "" }
    assert(json.encode(all_gone) == "{}")
    assert(json.encode(all_gone, true) == "{}")
    assert(json.from(all_gone).object.length == 0)

    let ext = ExtendedBase { a: 1, b: "" }
    assert(json.encode(ext) == "{\"alpha\":1}")
    let ext2 = ExtendedBase { a: 1, b: "hi" }
    assert(json.encode(ext2) == "{\"alpha\":1,\"beta\":\"hi\"}")
    let ext2_pretty = json.encode(ext2, true)
    assert(ext2_pretty == "{\n    \"alpha\": 1,\n    \"beta\": \"hi\"\n}")

    // Missing required renamed field fails decode_to and to_type
    let missing_ok = true
    json.decode_to[TaggedPoint]("{\"x\":1}") ! { missing_ok = false }
    assert(!missing_ok)
    let wrong_val = json.decode("{\"x\":1}") ! panic("decode failed")
    let to_type_ok = true
    wrong_val.to_type[TaggedPoint]() ! { to_type_ok = false }
    assert(!to_type_ok)
}

test "Field tags: backtick shorthand syntax" {
    let props = describe_props[ShortTagUser]()
    assert(props.length == 4)
    assert(props[0] == "id:110:user_id:user_id:user_id:id:-")
    assert(props[1] == "name:100:full_name:full_name:full_name:name:idx")
    assert(props[2] == "secret:100:-:-:-:none:-")
    assert(props[3] == "bio:100:bio:bio:bio:none:-")

    let u = ShortTagUser { id: 42, name: "Lin", secret: "pw" }
    assert(json.encode(u) == "{\"user_id\":42,\"full_name\":\"Lin\"}")
    let rt = json.decode_to[ShortTagUser]("{\"user_id\":42,\"full_name\":\"Lin\",\"bio\":\"hi\"}") ! panic("short decode failed")
    assert(rt.id == 42 && rt.name == "Lin" && rt.secret == "hidden" && rt.bio == "hi")

    let pt = ShortTagPoint { x: 5, y: 0 }
    assert(json.encode(pt) == "{\"px\":5}")
    let pt_rt = json.decode_to[ShortTagPoint]("{\"px\":5,\"py\":9}") ! panic("short point decode failed")
    assert(pt_rt.x == 5 && pt_rt.y == 9)
}

use valk.gc

type ReadPublicationRow ([int x 2])
class ReadPublicationChild { number: int }
struct ReadPublicationPart { number: int }
class ReadPublicationItem {
    number: int
    numbers: [int x 2] ({ 73, 79 })
    matrix: [ReadPublicationRow x 2] ({ .{ 83, 89 }, .{ 97, 101 } })
    parts: [ReadPublicationPart x 2] ({ .{ number: 103 }, .{ number: 107 } })
    children: [ReadPublicationChild x 2] ({ ReadPublicationChild { number: 109 }, ReadPublicationChild { number: 113 } })
}
shared read_publication_saved: ?ReadPublicationItem (null)
fn read_publish(item: shared ReadPublicationItem) int { read_publication_saved = item; return 0 }

synctest "Read publication: replacement preserves the saved source" {
    let source = ReadPublicationItem { number: 11 }
    let number = source.numbers[<{
        source = ReadPublicationItem { number: 13 }
        return read_publish(source)
    }]
    assert(number == 73)
    assert((read_publication_saved ?? panic("missing")).number == 13)
    read_publication_saved = null
}

synctest "Read publication: nested row addresses survive source replacement" {
    let source = ReadPublicationItem { number: 11 }
    let number = source.matrix[1][<{
        source = ReadPublicationItem { number: 17 }
        return read_publish(source)
    }]
    assert(number == 97)
    assert((read_publication_saved ?? panic("missing")).number == 17)
    read_publication_saved = null
}

synctest "Read publication: managed elements survive collection after replacement" {
    let source = ReadPublicationItem { number: 11 }
    let child = source.children[<{
        source = ReadPublicationItem { number: 19 }
        return read_publish(source)
    }]
    gc.collect()
    assert(child.number == 109)
    assert((read_publication_saved ?? panic("missing")).number == 19)
    read_publication_saved = null
}

synctest "Read publication: inline elements preserve the saved source" {
    let source = ReadPublicationItem { number: 11 }
    let part = source.parts[<{
        source = ReadPublicationItem { number: 23 }
        return read_publish(source)
    }]
    assert(part.number == 103)
    assert((read_publication_saved ?? panic("missing")).number == 23)
    read_publication_saved = null
}

synctest "Read publication: independent graphs and local arrays remain readable" {
    let source = ReadPublicationItem { number: 11 }
    let other = ReadPublicationItem { number: 29 }
    assert(source.numbers[read_publish(other)] == 73)
    let local: [int x 2] = { 127, 131 }
    other = ReadPublicationItem { number: 31 }
    assert(local[read_publish(other)] == 127)
    read_publication_saved = null
}

synctest "Read publication: shared element reads retain their atomic access" {
    let source: shared ReadPublicationItem = ReadPublicationItem { number: 11 }
    assert(source.numbers[read_publish(source)] == 73)
    read_publication_saved = null
}

synctest "Read publication: source snapshots are renewed in loops" {
    let index = 0
    let total = 0
    while index++ < 2 {
        let source = ReadPublicationItem { number: 11 }
        total += source.numbers[<{
            source = ReadPublicationItem { number: index }
            return read_publish(source)
        }]
    }
    assert(total == 146)
    assert((read_publication_saved ?? panic("missing")).number == 2)
    read_publication_saved = null
}

synctest "Read publication: leaving the loop cancels a pending read" {
    let source = ReadPublicationItem { number: 11 }
    let number = 0
    while true {
        number = source.numbers[<{
            if source.number == 11 {
                read_publish(source)
                break
            }
            return 0
        }]
    }
    assert(number == 0)
    assert((read_publication_saved ?? panic("missing")).number == 11)
    read_publication_saved = null
}

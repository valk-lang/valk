use valk.markdown

test "Markdown: escapes text in every content context" {
    // Paragraph
    let html = markdown.to_html("a < b and c > d and e <f>\n")
    assert(html == "\n<p>a &lt; b and c &gt; d and e &lt;f&gt;</p>")
    html = markdown.to_html("He said \"hi\" & 'bye'\n")
    assert(html == "\n<p>He said &quot;hi&quot; &amp; &#39;bye&#39;</p>")
    // `&` is escaped even when it already looks like a character reference, so a
    // document cannot smuggle markup through the renderer's own escapes
    html = markdown.to_html("AT&T &amp; &#39; &copy;\n")
    assert(html == "\n<p>AT&amp;T &amp;amp; &amp;#39; &amp;copy;</p>")
    // ATX and setext headings
    html = markdown.to_html("# <script>alert(1)</script>\n")
    assert(html == "\n<h1>&lt;script&gt;alert(1)&lt;/script&gt;</h1>")
    html = markdown.to_html("# A & B <C>\n")
    assert(html == "\n<h1>A &amp; B &lt;C&gt;</h1>")
    html = markdown.to_html("Title <b>&\n=====\n")
    assert(html == "\n<h1>Title &lt;b&gt;&amp;</h1>")
    html = markdown.to_html("Title <b>&\n-----\n")
    assert(html == "\n<h2>Title &lt;b&gt;&amp;</h2>")
    // Lists
    html = markdown.to_html("1. a < b & c\n2. \"x\"\n")
    assert(html == "\n<ol>\n  <li>a &lt; b &amp; c</li>\n  <li>&quot;x&quot;</li>\n</ol>")
    html = markdown.to_html("* <b>bold</b> & `x<y`\n- \"quoted\" 'single' &\n")
    assert(html == "\n<ul>\n  <li>&lt;b&gt;bold&lt;/b&gt; &amp; <code>x&lt;y</code></li>\n</ul>\n<ul>\n  <li>&quot;quoted&quot; &#39;single&#39; &amp;</li>\n</ul>")
    // Inline code and emphasis: the markers still pair up around the escapes, because
    // every character reference starts with `&` and ends with `;` and neither is
    // alphanumeric
    html = markdown.to_html("use `<b>&\"</b>` here\n")
    assert(html == "\n<p>use <code>&lt;b&gt;&amp;&quot;&lt;/b&gt;</code> here</p>")
    html = markdown.to_html("*<i>em</i>* and <b>**not bold**</b>\n")
    assert(html == "\n<p><em>&lt;i&gt;em&lt;/i&gt;</em> and &lt;b&gt;<strong>not bold</strong>&lt;/b&gt;</p>")
    html = markdown.to_html("~~<s>gone</s>~~\n")
    assert(html == "\n<p><del>&lt;s&gt;gone&lt;/s&gt;</del></p>")
    // A soft line break is the renderer's own tag, inserted after the escape
    html = markdown.to_html("line one < &\nline two > \"q\"\n")
    assert(html == "\n<p>line one &lt; &amp;<br>line two &gt; &quot;q&quot;</p>")
    // Raw HTML in the document is content, not markup
    html = markdown.to_html("<div onmouseover=\"alert(1)\">x</div>\n")
    assert(html == "\n<p>&lt;div onmouseover=&quot;alert(1)&quot;&gt;x&lt;/div&gt;</p>")
    // Interpolation is compile time only, so runtime data cannot re-enter a template.
    // The percents below are written \% because a bare %{ starts interpolation in source
    html = markdown.to_html("100% {x} \%{y} \%{\"z\"} done\n")
    assert(html == "\n<p>100% {x} \%{y} \%{&quot;z&quot;} done</p>")
    // A blockquote marker is structure and has to survive the escaper. The element
    // itself is never emitted, which is a separate defect of the renderer
    html = markdown.to_html("> <script>evil()</script> & \"q\"\n")
    assert(html == "\n<p> &lt;script&gt;evil()&lt;/script&gt; &amp; &quot;q&quot;</p>")
}

test "Markdown: escapes fenced code blocks" {
    // A fenced block is a mandatory-escape context: its content can close the very
    // element it is inside of
    let html = markdown.to_html("```\n<script>i</script>\n```\n")
    assert(html == "\n<pre><code>&lt;script&gt;i&lt;/script&gt;\n</code></pre>")
    html = markdown.to_html("```\n</code><script>alert(1)</script>\n</pre>\n```\n")
    assert(html == "\n<pre><code>&lt;/code&gt;&lt;script&gt;alert(1)&lt;/script&gt;\n&lt;/pre&gt;\n</code></pre>")
    html = markdown.to_html("```\nc = \"x\" and y = 'z' and &\n```\n")
    assert(html == "\n<pre><code>c = &quot;x&quot; and y = &#39;z&#39; and &amp;\n</code></pre>")
    // An info string is content too, and never reaches the scheme check
    html = markdown.to_html("```<b>\n&\n```\n")
    assert(html == "\n<pre><code>&amp;\n</code></pre>")
}

test "Markdown: escapes attribute values" {
    // Labels are content, targets are attributes: both are escaped
    let html = markdown.to_html("[<b>bold</b> & \"q\"](http://ok/x)\n")
    assert(html == "\n<p><a href=\"http://ok/x\">&lt;b&gt;bold&lt;/b&gt; &amp; &quot;q&quot;</a></p>")
    html = markdown.to_html("[a](http://x/?p=1&q=2)\n")
    assert(html == "\n<p><a href=\"http://x/?p=1&amp;q=2\">a</a></p>")
    html = markdown.to_html("[a](http://x/?p=\"q\"&r='s')\n")
    assert(html == "\n<p><a href=\"http://x/?p=&quot;q&quot;&amp;r=&#39;s&#39;\">a</a></p>")
    // A quote in the target can no longer end the attribute and open a handler, which
    // also neutralises the "title" syntax the link parser does not know
    html = markdown.to_html("![logo](/img/x.png \"the title\")\n")
    assert(html == "\n<p><img src=\"/img/x.png &quot;the title&quot;\" alt=\"logo\"/></p>")
}

test "Markdown: escapes the class names the caller passes in" {
    let html = markdown.to_html("a < b\n", markdown.ToHtmlOptions { paragraph_class: "lead\" onclick=\"alert(1)" })
    assert(html == "\n<p class=\"lead&quot; onclick=&quot;alert(1)\">a &lt; b</p>")
    html = markdown.to_html("x\n", markdown.ToHtmlOptions { paragraph_class: "lead" })
    assert(html == "\n<p class=\"lead\">x</p>")
    html = markdown.to_html("```\n&\n```", markdown.ToHtmlOptions { code_class: "lang\"><script>" })
    assert(html == "\n<pre><code class=\"lang&quot;&gt;&lt;script&gt;\">&amp;\n</code></pre>")
    html = markdown.to_html("```\n&\n```", markdown.ToHtmlOptions { code_class: "lang-rs" })
    assert(html == "\n<pre><code class=\"lang-rs\">&amp;\n</code></pre>")
}

test "Markdown: drops a link whose scheme is not allowed" {
    // A browser reaches the URL parser with case folded and with every ASCII tab,
    // newline and surrounding space removed, so all nine of these are javascript:
    let blocked = Array[String]{
        "javascript:alert(1)",
        "JaVaScRiPt:alert(1)",
        "JAVASCRIPT:alert(1)",
        "  javascript:alert(1)",
        "javascript:alert(1) ",
        "java\tscript:alert(1)",
        "java\rscript:alert(1)",
        "javascript\t:alert(1)",
        "\tjavascript:alert(1)",
    }
    each blocked as target {
        let out = markdown.to_html("[click](" + target + ")\n")
        assert(out == "\n<p>click</p>")
    }
    let html = markdown.to_html("[x](data:text/html;base64,PHNjcmlwdD4=)\n")
    assert(html == "\n<p>x</p>")
    html = markdown.to_html("[x](vbscript:msgbox(1))\n")
    assert(html == "\n<p>x</p>")
    html = markdown.to_html("[x](file:///etc/passwd)\n")
    assert(html == "\n<p>x</p>")
    html = markdown.to_html("[x](ftp://h/f)\n")
    assert(html == "\n<p>x</p>")
    html = markdown.to_html("[x](about:blank)\n")
    assert(html == "\n<p>x</p>")
    html = markdown.to_html("[x](tel:+15551234)\n")
    assert(html == "\n<p>x</p>")
    // A dotted first segment is a scheme to a browser too, not a relative path
    html = markdown.to_html("[a](a.b.c:8080/x)\n")
    assert(html == "\n<p>a</p>")
}

test "Markdown: keeps targets it is safe to follow" {
    // A space inside the first segment stops it from being a scheme in a browser as
    // well, so this stays the relative URL that it looks like
    let html = markdown.to_html("[click](javascript :alert(1))\n")
    assert(html == "\n<p><a href=\"javascript :alert(1)\">click</a></p>")
    // A URL with no scheme at all is relative, and relative is always allowed
    html = markdown.to_html("[a](./foo) [b](#frag) [c](/x) [d](//h/x) [e](?q=1)\n")
    assert(html == "\n<p><a href=\"./foo\">a</a> <a href=\"#frag\">b</a> <a href=\"/x\">c</a> <a href=\"//h/x\">d</a> <a href=\"?q=1\">e</a></p>")
    html = markdown.to_html("[a](/q?a=javascript:x) [b](http://x/a:b)\n")
    assert(html == "\n<p><a href=\"/q?a=javascript:x\">a</a> <a href=\"http://x/a:b\">b</a></p>")
    html = markdown.to_html("[a](http://x) [b](https://y)\n")
    assert(html == "\n<p><a href=\"http://x\">a</a> <a href=\"https://y\">b</a></p>")
    html = markdown.to_html("[e](mailto:x@y) [f](MAILTO:z@w)\n")
    assert(html == "\n<p><a href=\"mailto:x@y\">e</a> <a href=\"MAILTO:z@w\">f</a></p>")
    html = markdown.to_html("[a]()\n")
    assert(html == "\n<p><a href=\"\">a</a></p>")
    // Malformed link markup is left as text
    html = markdown.to_html("[a [b] c](http://ok)\n")
    assert(html == "\n<p><a href=\"http://ok\">a [b] c</a></p>")
    html = markdown.to_html("[a](http://ok\n")
    assert(html == "\n<p>[a](http://ok</p>")
}

test "Markdown: a character reference in a target stays inert" {
    // Escaping `&` along with < > " is what makes these inert: an attribute value is
    // decoded exactly once, so a browser reads the entity as text, not as a colon
    let html = markdown.to_html("[click](javascript&colon;alert(1))\n")
    assert(html == "\n<p><a href=\"javascript&amp;colon;alert(1)\">click</a></p>")
    html = markdown.to_html("[click](javascript&#58;alert(1))\n")
    assert(html == "\n<p><a href=\"javascript&amp;#58;alert(1)\">click</a></p>")
    html = markdown.to_html("[click](javascript&#x3a;alert(1))\n")
    assert(html == "\n<p><a href=\"javascript&amp;#x3a;alert(1)\">click</a></p>")
    // The same holds when the entity would spell the first letter or a tab
    html = markdown.to_html("[click](&#106;avascript:alert(1))\n")
    assert(html == "\n<p><a href=\"&amp;#106;avascript:alert(1)\">click</a></p>")
    html = markdown.to_html("[click](&Tab;javascript:alert(1))\n")
    assert(html == "\n<p><a href=\"&amp;Tab;javascript:alert(1)\">click</a></p>")
}

test "Markdown: images name their text with alt and drop blocked sources" {
    let html = markdown.to_html("![i](/ok.png)\n")
    assert(html == "\n<p><img src=\"/ok.png\" alt=\"i\"/></p>")
    html = markdown.to_html("![i](javascript:alert(1))\n")
    assert(html == "\n<p></p>")
    // A link around an image keeps its target, the blocked image goes away
    html = markdown.to_html("[![alt](javascript:x)](http://ok)\n")
    assert(html == "\n<p><a href=\"http://ok\"></a></p>")
    html = markdown.to_html("[![alt](/ok.png)](http://ok)\n")
    assert(html == "\n<p><a href=\"http://ok\"><img src=\"/ok.png\" alt=\"alt\"/></a></p>")
}

test "Markdown: allowed_schemes replaces the default list" {
    let html = markdown.to_html("[a](http://x) [b](https://y) [c](tel:1) [d](/z)\n", markdown.ToHtmlOptions { allowed_schemes: Array[String]{ "https" } })
    assert(html == "\n<p>a <a href=\"https://y\">b</a> c <a href=\"/z\">d</a></p>")
    html = markdown.to_html("[c](tel:+1555) [a](http://x)\n", markdown.ToHtmlOptions { allowed_schemes: Array[String]{ "http", "tel" } })
    assert(html == "\n<p><a href=\"tel:+1555\">c</a> <a href=\"http://x\">a</a></p>")
    html = markdown.to_html("[a](http://x) [d](/z)\n", markdown.ToHtmlOptions { allowed_schemes: Array[String]{} })
    assert(html == "\n<p>a <a href=\"/z\">d</a></p>")
    html = markdown.to_html("[b](HTTPS://y) [a](HTTP://x)\n", markdown.ToHtmlOptions { allowed_schemes: Array[String]{ "HTTPS" } })
    assert(html == "\n<p><a href=\"HTTPS://y\">b</a> a</p>")
    html = markdown.to_html("[a](javascript:1) [b](tel:2)\n", markdown.ToHtmlOptions { allowed_schemes: Array[String]{ "tel" } })
    assert(html == "\n<p>a <a href=\"tel:2\">b</a></p>")
    html = markdown.to_html("[a](http://x) [b](tel:1)\n")
    assert(html == "\n<p><a href=\"http://x\">a</a> b</p>")
    // Options from an earlier call must not leak into a later one
    let wide = markdown.ToHtmlOptions { allowed_schemes: Array[String]{ "tel", "ftp", "file" } }
    html = markdown.to_html("[a](tel:1)\n", wide)
    assert(html == "\n<p><a href=\"tel:1\">a</a></p>")
    html = markdown.to_html("[a](tel:1) [b](http://x)\n")
    assert(html == "\n<p>a <a href=\"http://x\">b</a></p>")
    // The caller owns the array, so changing it changes the next call
    wide.allowed_schemes.append("http")
    html = markdown.to_html("[a](http://x)\n", wide)
    assert(html == "\n<p><a href=\"http://x\">a</a></p>")
}

test "Markdown: a hostile document yields no live markup" {
    let evil = Array[String]{
        "# <script>alert(1)</script>",
        "",
        "<script src=\"//evil.tld/x.js\"></script>",
        "",
        "[a](javascript:alert(1)) [b](x\" onmouseover=\"alert(1))",
        "![c](data:text/html,<script>alert(2)</script>)",
        "",
        "```",
        "</code></pre><script>alert(3)</script>",
        "```",
    }.join("\n") + "\n"
    let html = markdown.to_html(evil)
    assert(!html.contains("<script"))
    assert(!html.contains("javascript:"))
    assert(!html.contains("data:text/html"))
    assert(!html.contains("\" onmouseover"))
    // The attacks are still in the output, as text a reader can see
    assert(html.contains("&lt;script&gt;"))
    assert(html.contains("&lt;script src="))
    assert(html.contains("onmouseover=&quot;"))
    assert(html.contains("alert(1)"))
}


use valk:time

test "Time: sleep" {
    let s1 = time:microtime()
    time:sleep_ms(100)
    let ms = (time:microtime() - s1) / 1000
    assert(ms >= 95)
    assert(ms < 2000)
}

test "Time: Datetime calendar and timestamps" {
    let epoch = time:Datetime.new(1970, 1, 1)
    assert(epoch.timestamp() == 0)
    assert(epoch.day_of_week() == 4)
    assert(epoch.day_of_year() == 1)
    assert(epoch.to_iso8601() == "1970-01-01T00:00:00Z")

    let leap = time:Datetime.new(2024, 2, 29, 23, 58, 59, 123_456)
    assert(leap.is_leap_year())
    assert(leap.day_of_year() == 60)
    assert(leap.to_iso8601() == "2024-02-29T23:58:59.123456Z")
    assert(time:Datetime.from_unix_microseconds(leap.unix_microseconds()) == leap)
}

test "Time: Datetime immutable and mutating operations" {
    let original = time:Datetime.new(2024, 1, 31, 12)
    let next_month = original.add_months(1)
    assert(original.month() == 1)
    assert(original.day() == 31)
    assert(next_month.month() == 2)
    assert(next_month.day() == 29)

    original.add_months_mut(1).add_days_mut(1)
    assert(original.year() == 2024)
    assert(original.month() == 3)
    assert(original.day() == 1)

    let pre_epoch = time:Datetime.new(1969, 12, 31, 23, 59, 59, 999_999)
    assert(pre_epoch.unix_microseconds() == -1)
    assert(pre_epoch.add_microseconds(1) == time:Datetime.new(1970, 1, 1))
}


use valk.time

test "Time: sleep" {
    let s1 = time.mono_us()
    time.sleep_ms(100)
    let ms = (time.mono_us() - s1) / 1000
    assert(ms >= 95)
    assert(ms < 2000)
}

global long_sleep_resumed: bool (false)

fn sleep_ms_max_probe() {
    time.sleep_ms(uint.$max)
    long_sleep_resumed = true
}

fn sleep_ns_max_probe() {
    time.sleep_ns(uint.$max)
    long_sleep_resumed = true
}

test "Time: a sleep past the nanosecond count does not return at once" {
    // uint.max milliseconds wrapped the nanosecond conversion and uint.max
    // nanoseconds wrapped the coroutine timespec, both inside a millisecond
    long_sleep_resumed = false
    co sleep_ms_max_probe()
    time.sleep_ms(20)
    assert(!long_sleep_resumed)
    co sleep_ns_max_probe()
    time.sleep_ms(20)
    assert(!long_sleep_resumed)
}

test "Time: Unix and monotonic units" {
    let unix_ns = time.unix_ns()
    let unix_us = time.unix_us()
    let unix_ms = time.unix_ms()
    assert(unix_ns / 1_000_000 <= unix_ms + 1)
    assert(unix_us / 1000 <= unix_ms + 1)
    assert(unix_ms > 1_000_000_000_000)

    let mono_ns = time.mono_ns()
    let mono_us = time.mono_us()
    let mono_ms = time.mono_ms()
    assert(mono_ns / 1_000_000 <= mono_ms + 1)
    assert(mono_us / 1000 <= mono_ms + 1)
}

test "Time: DateTime calendar and timestamps" {
    let epoch = time.DateTime.new(1970, 1, 1, 0, 0, 0, 0) ! panic("Invalid date")
    assert(epoch.unix_seconds() == 0)
    assert(epoch.day_of_week() == 4)
    assert(epoch.day_of_year() == 1)
    assert(epoch.to_iso8601() == "1970-01-01T00:00:00Z")

    let leap = time.DateTime.new(2024, 2, 29, 23, 58, 59, 123_456) ! panic("Invalid date")
    assert(leap.is_leap_year())
    assert(leap.day_of_year() == 60)
    assert(leap.to_iso8601() == "2024-02-29T23:58:59.123456Z")
    assert((time.DateTime.from_unix_us(leap.unix_us()) ! panic("Invalid date")) == leap)
}

test "Time: DateTime constructor defaults to current time" {
    let before = time.unix_us().to(int)
    let current = time.DateTime.new() ! panic("Invalid date")
    let after = time.unix_us().to(int)
    assert(current.unix_us() >= before)
    assert(current.unix_us() <= after)

    let partial = time.DateTime.new(2000, 5, 6) ! panic("Invalid date")
    assert(partial.year() == 2000)
    assert(partial.month() == 5)
    assert(partial.day() == 6)
    assert(partial.hour() <= 23)
    assert(partial.minute() <= 59)
    assert(partial.second() <= 59)
}

test "Time: DateTime immutable and mutating operations" {
    let original = time.DateTime.new(2024, 1, 31, 12) ! panic("Invalid date")
    let next_month = original.add_months(1) ! panic("Invalid date")
    assert(original.month() == 1)
    assert(original.day() == 31)
    assert(next_month.month() == 2)
    assert(next_month.day() == 29)

    original.modify_add_months(1) ! panic("Invalid date")
    original.modify_add_days(1) ! panic("Invalid date")
    assert(original.year() == 2024)
    assert(original.month() == 3)
    assert(original.day() == 1)

    let same_object = original
    original.modify_hour(8) ! panic("Invalid date")
    original.modify_minute(30) ! panic("Invalid date")
    assert(same_object.hour() == 8)
    assert(same_object.minute() == 30)

    let pre_epoch = time.DateTime.new(1969, 12, 31, 23, 59, 59, 999_999) ! panic("Invalid date")
    assert(pre_epoch.unix_us() == -1)
    assert((pre_epoch.add_microseconds(1) ! panic("Invalid date")) == (time.DateTime.new(1970, 1, 1, 0, 0, 0, 0) ! panic("Invalid date")))
}

test "Time: DateTime format round trip" {
    let datetime = time.DateTime.new(2026, 8, 8, 19, 7, 6, 123_456) ! panic("Invalid date")
    let pattern = "Y-m-d H:i:s.u"
    let formatted = datetime.format(pattern)
    assert(formatted == "2026-08-08 19:07:06.123456")
    let parsed = time.DateTime.from_format(pattern, formatted) ! panic("Formatted value rejected")
    assert(parsed == datetime)

    assert(datetime.format("Y-m-d\\TH:i:s.v\\Z") == "2026-08-08T19:07:06.123Z")
    let date = time.DateTime.from_format("d/m/Y", "29/02/2024") ! panic("Valid date rejected")
    assert(date == (time.DateTime.new(2024, 2, 29, 0, 0, 0, 0) ! panic("Invalid date")))

    let invalid_rejected = false
    time.DateTime.from_format("Y-m-d", "2023-02-29") ! {
        invalid_rejected = true
        assert(E.code == E.syntax)
    }
    assert(invalid_rejected)
}

test "Time: DateTime names, 12-hour clock, offsets and short numbers" {
    let dt = time.DateTime.new(2024, 3, 5, 14, 7, 9) !!
    assert(dt.format("D, j M Y g:i A") == "Tue, 5 Mar 2024 2:07 PM")
    assert(dt.format("l F jS") == "Tuesday March 5S")
    assert(dt.format("n/j/y h:i:s a N") == "3/5/24 02:07:09 pm 2")
    assert(dt.format("G:i O P T") == "14:07 +0000 +00:00 UTC")
    assert(dt.format("U") == dt.unix_seconds().to_string())
    let midnight = time.DateTime.new(2024, 12, 29, 0, 30) !!
    assert(midnight.format("g:i A, l, F") == "12:30 AM, Sunday, December")
    let noon = time.DateTime.new(2024, 1, 1, 12) !!
    assert(noon.format("h A") == "12 PM")

    let zoned = time.DateTime.new_in(time.fixed_zone(-5 * 3600 - 30 * 60), 2024, 3, 5, 9) !!
    assert(zoned.format("O P") == "-0530 -05:30")

    // format_size is an upper bound that format_in fits in
    assert(time.DateTime.format_size("D, j M Y g:i A") >= dt.format("D, j M Y g:i A").bytes)
    let buf = [u8 x 64]{ 0... }
    let written = dt.format_in("l, F j Y", buf)
    assert(written == "Tuesday, March 5 2024".bytes)

    // Parsing reads the same tokens back
    let parsed = time.DateTime.from_format("D, j M Y g:i A", "Tue, 5 Mar 2024 2:07 PM") !!
    assert(parsed == (time.DateTime.new(2024, 3, 5, 14, 7) !!))
    assert((time.DateTime.from_format("l F j, Y", "tuesday MARCH 5, 2024") !!) == (time.DateTime.new(2024, 3, 5) !!))
    assert((time.DateTime.from_format("n/j/y", "12/31/99") !!).year() == 1999)
    assert((time.DateTime.from_format("n/j/y", "1/2/03") !!).year() == 2003)
    assert((time.DateTime.from_format("Y-m-d h:i a", "2024-03-05 12:15 am") !!).hour() == 0)
    assert((time.DateTime.from_format("Y-m-d g A", "2024-03-05 12 PM") !!).hour() == 12)
    assert((time.DateTime.from_format("Y-m-d G:i", "2024-03-05 7:05") !!).hour() == 7)
    let offset = time.DateTime.from_format("Y-m-d H:i P", "2024-03-05 14:07 +01:00") !!
    assert(offset.utc_offset() == 3600 && offset.hour() == 14)
    assert((time.DateTime.from_format("Y-m-d H:i O", "2024-03-05 14:07 -0130") !!).utc_offset() == -5400)
    assert((time.DateTime.from_format("Y-m-d H:i T", "2024-03-05 14:07 GMT") !!).utc_offset() == 0)
    assert((time.DateTime.from_format("U", "1709647629") !!) == (time.DateTime.from_unix_seconds(1709647629) !!))

    let bad = Array[String]{ "Y-m-d g:i A|2024-03-05 13:00 PM", "Y-m-d H A|2024-03-05 14 AM", "D Y-m-d|Xyz 2024-03-05", "M Y d|Mar 2024", "Y-m-d T|2024-03-05 CET", "U Y|17 2024", "n/j/Y|/5/2024" }
    each bad as line {
        let parts = line.split("|")
        let failed = false
        time.DateTime.from_format(parts.get(0) !? "", parts.get(1) !? "") ! { failed = true }
        assert(failed)
    }
}

fn date(year: int, month: uint, day: uint, hour: uint (0), minute: uint (0), second: uint (0), us: uint (0)) time.DateTime {
    return time.DateTime.new(year, month, day, hour, minute, second, us) ! panic("Invalid date")
}

test "Time: DateTime rejects invalid components" {
    assert((time.DateTime.new(2024, 2, 30) !? null) == null)
    assert((time.DateTime.new(2023, 2, 29) !? null) == null)
    assert((time.DateTime.new(0, 0, 0, 0, 0, 0, 0) !? null) == null)
    assert((time.DateTime.new(2024, 13, 1) !? null) == null)
    assert((time.DateTime.new(2024, 1, 1, 24) !? null) == null)
    assert((time.DateTime.new(2024, 1, 1, 0, 0, 0, 1_000_000) !? null) == null)
    assert((time.DateTime.new(10_000, 1, 1) !? null) == null)
    let failed = false
    time.DateTime.new(2024, 2, 30) ! { failed = true; assert(E.code == E.range) }
    assert(failed)

    let d = date(2024, 1, 31)
    let modify_month_failed = false
    d.modify_month(13) ! { modify_month_failed = true }
    assert(modify_month_failed)
    let modify_day_failed = false
    d.modify_day(0) ! { modify_day_failed = true }
    assert(modify_day_failed)
    let modify_hour_failed = false
    d.modify_hour(uint.$max) ! { modify_hour_failed = true }
    assert(modify_hour_failed)
    assert((d.with_minute(60) !? null) == null)
    assert((d.with_second(60) !? null) == null)
    assert((d.with_year(0) !? null) == null)
    // A failed modification leaves the object unchanged
    assert(d == date(2024, 1, 31))
    d.modify_month(2) ! panic("Invalid date")
    assert(d.day() == 29)
}

test "Time: DateTime timestamps and arithmetic stay in range" {
    assert((time.DateTime.from_unix_seconds(253402300800) !? null) == null)
    assert((time.DateTime.from_unix_seconds(int.$max) !? null) == null)
    assert((time.DateTime.from_unix_seconds(int.$min) !? null) == null)
    assert((time.DateTime.from_unix_us(int.$max) !? null) == null)
    assert((time.DateTime.from_unix_us(int.$min) !? null) == null)
    assert((time.DateTime.from_unix_seconds(253402300799) !? null) == date(9999, 12, 31, 23, 59, 59))

    let last = date(9999, 12, 31, 23, 59, 59, 999_999)
    assert((last.add_microseconds(1) !? null) == null)
    assert((last.add_seconds(1) !? null) == null)
    assert((last.add_years(1) !? null) == null)
    assert((last.add_months(1) !? null) == null)
    let last_modify_failed = false
    last.modify_add_days(1) ! { last_modify_failed = true }
    assert(last_modify_failed)
    assert(last == date(9999, 12, 31, 23, 59, 59, 999_999))

    let first = date(1, 1, 1)
    assert((first.add_seconds(-1) !? null) == null)
    assert((first.add_days(int.$min) !? null) == null)
    assert((first.add_days(int.$max) !? null) == null)
    assert((first.add_months(int.$max) !? null) == null)
    assert((first.add_months(int.$min) !? null) == null)
    assert((first.add_years(int.$max) !? null) == null)
    assert((first.add_years(int.$min) !? null) == null)
    let first_modify_failed = false
    first.modify_add_hours(int.$min) ! { first_modify_failed = true }
    assert(first_modify_failed)
    assert(first == date(1, 1, 1))
    assert((first.add_days(1) !? null) == date(1, 1, 2))
}

test "DateTime.new defaults missing trailing parts to their minimum" {
    let date = time.DateTime.new(2024, 3, 5) !!
    assert(date.year() == 2024)
    assert(date.month() == 3)
    assert(date.day() == 5)
    assert(date.hour() == 0)
    assert(date.minute() == 0)
    assert(date.second() == 0)
    assert(date.microsecond() == 0)

    let year = time.DateTime.new(2024) !!
    assert(year.month() == 1)
    assert(year.day() == 1)
    assert(year.hour() == 0)

    let before = time.DateTime.now()
    let nine = time.DateTime.new(null, null, null, 9) !!
    let after = time.DateTime.now()
    assert(nine.hour() == 9)
    assert(nine.minute() == 0)
    assert(nine.second() == 0)
    assert(nine.microsecond() == 0)
    assert(nine.day() == before.day() || nine.day() == after.day())
}

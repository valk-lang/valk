
struct CastStruct {
    value: u8
}

test "Casting" {
    // Explicit number-to-pointer conversion
    let v1 : ptr = 2 + 1
    // ptrtoint + trunc
    assert(v1.@cast(u8) == 3)
    //
    let v2: ptr = 0
    v2 = 2
    let v3 : uint = 1
    v2 += v3
    assert(v1 == v2)

    // upscale unsigned -> unsigned
    let v4 : u8 = 4
    let v5 : uint = 5
    let v6 = v4 + v5
    let v7 = v5 + v4
    assert(v6 == 9)
    assert(v7 == 9)
    // upscale unsigned -> signed 
    let v9 : u8 = 5
    let v10 : i16 = v9
    assert(v10 == 5)
    // Auto cast 0xf to u8
    let v11 : u8 = 0xf
    let v12 = 0xf + v11 // should become u8
    let v13 : u8 = v12 // check if u8
    assert(v12 == 0x1e)
    assert(v13 == 0x1e)

    let integer_ptr: ptr = 3
    let integer_value: uint = integer_ptr
    assert(integer_value == 3)

    let number = 7
    let reference: &int = &number
    let reference_ptr: ptr = reference
    let restored_reference: &int = reference_ptr
    let typed_pointer: *int = reference_ptr
    let typed_ptr: ptr = typed_pointer
    assert(@ptrv(restored_reference, int) == 7)
    assert(typed_ptr == reference_ptr)

    let object: *CastStruct = .{ value: 9 }
    let object_ptr: ptr = object
    assert(@ptrv(object_ptr, u8) == 9)
}

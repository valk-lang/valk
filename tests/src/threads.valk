
use valk:core
use valk:thread
use valk:time

shared thread_count : uint (0)

test "Threads" {
    let x : uint = 10
    let t = thread:Thread[void].start(fn() {
        time:sleep_ms(100)
        thread_count++
        thread_count += x
        thread_count++
    }) !!

    t.wait()

    assert(thread_count == 12)
}

class MTValue {
    value: int (0)

    fn increment() {
        this.value++
    }

    fn inspect_as_shared() int {
        return inspect_shared_mt_value(this)
    }
}

fn inspect_mt_value(value: MTValue) int {
    return value.value
}

fn inspect_shared_mt_value(value: shared MTValue) int {
    return value.value
}

class SharedFactoryValue {
    value: int

    static fn new(value: int) SELF {
        return SELF { value: value }
    }
}

class SharedFactoryBox {
    value: SharedFactoryValue

    static fn new(value: SharedFactoryValue) SELF {
        return SELF { value: value }
    }
}

// Intentionally shared mutable state (not captured heap data — that is cloned).
shared mt_counter : int (5)

test "Threads: multi-threading" {
    mt_counter = 5
    let y = 4

    let threads = Array[thread:Thread[void]].new()
    while y-- > 0 {
        let t = thread:Thread[void].start(fn() {
            let a = 100
            while a-- > 0 {
                atomic(mt_counter + 10)
            } 
        }) !!
        threads.append(t)
    }

    each threads as t {
        t.wait()
    }

    assert(mt_counter == 4005)
}

test "Threads: group waits for the first completed result" {
    let group = thread:ThreadGroup[int].new()
    let release_slow: shared core:Mutex = core:Mutex.new() !!
    release_slow.lock()
    let slow = group.start(fn() int {
        release_slow.await_unlock()
        return 1
    }) !!
    let fast = group.start(fn() int {
        return 2
    }) !!

    let first_index, first = group.await_next()
    assert(first_index == fast)
    assert(first == 2)
    assert(group.has_pending())

    release_slow.unlock()
    let second_index, second = group.await_next()
    assert(second_index == slow)
    assert(second == 1)
    assert(!group.has_pending())
}

test "Threads: void group waits for completion" {
    let group = thread:ThreadGroup[void].new()
    let expected = group.start(fn() {}) !!
    assert(group.await_next() == expected)
    assert(!group.has_pending())
}

test "Threads: task" {

    let value = 0
    let valueRef: *int = @ref(value)

    let task = thread:task(fn() {
        valueRef[0]++
        time:sleep_ms(100)
        valueRef[0]++
    }) ! {
        println("Failed to start task")
        assert(false)
        return
    }

    task.await()
    assert(value == 2)
}

test "Threads: return value and shared handler data" {
    let data: shared MTValue = .{ value: 1 }
    assert(!data.$is_shared)
    let t = thread:Thread[int].start(fn() int {
        data.value += 1
        return data.value
    }) !!
    assert(data.$is_shared)
    let local_result = t.await_result()
    assert(local_result == 2)
    assert(t.await_result() == 2)
    assert(data.value == 2)
}

test "Threads: nullable return value" {
    let t = thread:Thread[?MTValue].start(fn() ?MTValue {
        return null
    }) !!
    let result = t.await_result()
    assert(!isset(result))
}

test "Shared: fresh graphs can become shared" {
    let data: shared MTValue = MTValue { value: 1 }
    assert(!data.$is_shared)
    assert(data.value == 1)
}

test "Shared: nonescaping method preserves inferred uniqueness" {
    let data = MTValue { value: 1 }
    data.increment()
    let published: shared MTValue = data
    assert(published.value == 2)
}

test "Shared: nonescaping function preserves inferred uniqueness" {
    let data = MTValue { value: 3 }
    assert(inspect_mt_value(data) == 3)
    let published: shared MTValue = data
    assert(published.value == 3)
}

test "Shared: nonescaping shared parameters borrow ordinary graphs" {
    let data = MTValue { value: 4 }
    let alias = data
    assert(data.inspect_as_shared() == 4)
    assert(inspect_shared_mt_value(data) == 4)
    alias.increment()
    assert(data.value == 5)
}

test "Shared: fresh arrays provide readonly unpublished element views" {
    let data: shared Array[MTValue] = Array[MTValue]{ MTValue { value: 7 } }
    let item = data.get(0) !!
    assert(!item.$is_shared)
    assert(item.value == 7)
    let indexed = data[0] !!
    assert(!indexed.$is_shared)
    assert(indexed.value == 7)
    each data as value {
        assert(!value.$is_shared)
        assert(value.value == 7)
    }
}

test "Shared: an array filled with append can still be published" {
    let rows = Array[MTValue]{}
    let i = 0
    while i++ < 3 : rows.append(MTValue { value: i.to(int) })
    let published: shared Array[MTValue] = rows
    assert(published.length == 3)
    let first = published[0] !!
    assert(first.value == 1)
}

class MTNode {
    next: ?MTNode (null)
    value: int (0)
}
class MTList {
    head: ?MTNode (null)
    // Re-links through its own field: an internal rearrangement, not an escape
    fn push(value: int) { this.head = MTNode { next: this.head, value: value } }
}

test "Shared: re-linking a structure through its own fields stays publishable" {
    let list = MTList {}
    let i = 0
    while i++ < 3 : list.push(i.to(int))
    let published: shared MTList = list
    let head = published.head
    assert(isset(head) && head.value == 3)
}

test "Shared: generic empty factory is inferred fresh" {
    let data: shared Array[int] = Array[int].new()
    assert(data.length == 0)
}

test "Threads: shared integer captures are atomic" {
    let data: shared MTValue = .{ value: 0 }
    assert(!data.$is_shared)
    let threads = Array[thread:Thread[void]]{}
    let i = 0
    while i++ < 4 {
        threads.append(thread:start(fn() {
            let n = 0
            while n++ < 1000 : data.increment()
        }) !!)
    }
    assert(data.$is_shared)
    each threads as t : t.wait()
    assert(data.value == 4000)
}

test "Shared: integer increment values" {
    let data: shared MTValue = .{}
    let old = data.value++
    let next = ++data.value
    assert(old == 0)
    assert(next == 2)
    assert(data.value == 2)
}

test "Shared: inferred factory construction" {
    let local = SharedFactoryValue.new(7)
    let data: shared SharedFactoryValue = .new(42)
    let local_box = SharedFactoryBox.new(local)
    let shared_box: shared SharedFactoryBox = .new(.new(7))
    assert(local.value == 7)
    assert(!data.$is_shared)
    assert(data.value == 42)
    assert(local_box.value == local)
    assert(!shared_box.$is_shared)
    assert(shared_box.value.value == 7)
}

test "Threads: returned value becomes shared" {
    let t = thread:Thread[SharedFactoryValue].start(fn() SharedFactoryValue {
        let value = SharedFactoryValue.new(9)
        assert(!value.$is_shared)
        return value
    }) !!
    let result = t.await_result()
    assert(result.$is_shared)
    assert(result.value == 9)
}

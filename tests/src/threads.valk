
use valk:thread
use valk:time

shared thread_count : uint (0)

test "Threads" {
    let x : uint = 10
    let t = thread:Thread[void].start(fn() {
        time:sleep_ms(100)
        thread_count++
        thread_count += x
        thread_count++
    }) !!

    t.wait()

    assert(thread_count == 12)
}

class MTValue {
    value: int (0)

    fn increment() {
        this.value++
    }
}

class SharedFactoryValue {
    value: int

    static fn new(value: int) SELF {
        return SELF { value: value }
    }
}

class SharedFactoryBox {
    value: SharedFactoryValue

    static fn new(value: SharedFactoryValue) SELF {
        return SELF { value: value }
    }
}

// Intentionally shared mutable state (not captured heap data — that is cloned).
shared mt_counter : int (5)

test "Threads: multi-threading" {
    mt_counter = 5
    let y = 4

    let threads = Array[thread:Thread[void]].new()
    while y-- > 0 {
        let t = thread:Thread[void].start(fn() {
            let a = 100
            while a-- > 0 {
                atomic(mt_counter + 10)
            } 
        }) !!
        threads.append(t)
    }

    each threads as t {
        t.wait()
    }

    assert(mt_counter == 4005)
}

test "Threads: task" {

    let value = 0
    let valueRef = @ref(value).@cast(ptr[int])

    let task = thread:task(fn() {
        valueRef[0]++
        time:sleep_ms(100)
        valueRef[0]++
    }) ! {
        println("Failed to start task")
        assert(false)
        return
    }

    task.await()
    assert(value == 2)
}

test "Threads: return value and shared handler data" {
    let data: shared MTValue = .{ value: 1 }
    assert(data.$is_shared)
    let t = thread:Thread[int].start(fn() int {
        data.value += 1
        return data.value
    }) !!
    t.wait()
    let local_result = t.result
    assert(local_result == 2)
    assert(t.result == 2)
    assert(data.value == 2)
}

test "Threads: shared integer captures are atomic" {
    let data: shared MTValue = .{ value: 0 }
    let threads = Array[thread:Thread[void]]{}
    let i = 0
    while i++ < 4 {
        threads.append(thread:start(fn() {
            let n = 0
            while n++ < 1000 : data.increment()
        }) !!)
    }
    each threads as t : t.wait()
    assert(data.value == 4000)
}

test "Shared: inferred factory construction" {
    let local = SharedFactoryValue.new(7)
    let data: shared SharedFactoryValue = .new(42)
    let local_box = SharedFactoryBox.new(local)
    let shared_box: shared SharedFactoryBox = .new(data)
    assert(local.value == 7)
    assert(data.$is_shared)
    assert(data.value == 42)
    assert(local_box.value == local)
    assert(shared_box.$is_shared)
    assert(shared_box.value == data)
}

test "Threads: returned value becomes shared" {
    let t = thread:Thread[SharedFactoryValue].start(fn() SharedFactoryValue {
        let value = SharedFactoryValue.new(9)
        assert(!value.$is_shared)
        return value
    }) !!
    t.wait()
    assert(t.result.$is_shared)
    assert(t.result.value == 9)
}


use valk:thread
use valk:time

shared thread_count : uint (0)

test "Threads" {
    let x : uint = 10
    let t = thread:Thread[void].start(fn() {
        time:sleep_ms(100)
        thread_count++
        thread_count += x
        thread_count++
    }) !!

    t.wait()

    assert(thread_count == 12)
}

class MTValue {
    value: int (0)
}

// Intentionally shared mutable state (not captured heap data — that is cloned).
shared mt_counter : int (5)

test "Threads: multi-threading" {
    mt_counter = 5
    let y = 4

    let threads = Array[thread:Thread[void]].new()
    while y-- > 0 {
        let t = thread:Thread[void].start(fn() {
            let a = 100
            while a-- > 0 {
                atomic(mt_counter + 10)
            } 
        }) !!
        threads.append(t)
    }

    each threads as t {
        t.wait()
    }

    assert(mt_counter == 4005)
}

test "Threads: task" {

    let value = 0
    let valueRef = @ref(value).@cast(ptr[int])

    let task = thread:task(fn() {
        valueRef[0]++
        time:sleep_ms(100)
        valueRef[0]++
    }) ! {
        println("Failed to start task")
        assert(false)
        return
    }

    task.await()
    assert(value == 2)
}

test "Threads: return value and cloned handler data" {
    let data = MTValue { value: 1 }
    let t = thread:Thread[int].start(fn() int {
        data.value += 1
        return data.value
    }) !!
    t.wait()
    let local_result = t.result
    assert(local_result == 2)
    assert(t.result == 2)
    // Handler captures were deep-cloned for the thread, so the original is untouched.
    assert(data.value == 1)
}

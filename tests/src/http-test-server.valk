use valk.http

fn stop_http_test_server(server: http.Server, running: co(!http.HttpError)) {
    server.request_shutdown(0)
    await running ! {
        let reason = "an unexpected error"
        if error_is(E.code, port_in_use) : reason = "port_in_use"
        else if error_is(E.code, init) : reason = "init"
        else if error_is(E.code, timeout) : reason = "timeout"
        else if error_is(E.code, closed) : reason = "closed"
        panic("HTTP test server on port " + server.port + " failed: " + reason)
    }
}

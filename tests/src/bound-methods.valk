use valk.gc

class BmCounter {
    n: int (0)

    fn read() int { return this.n }

    static fn twice(value: int) int { return value * 2 }

    fn bump(by: int) int {
        this.n += by
        return this.n
    }
}

struct BmAcc {
    total: int (0)

    fn add(n: int) {
        this.total += n
    }

    fn checked_add(n: int) int !AnError {
        if n < 0 : throw .error
        this.total += n
        return this.total
    }

    fn add_total(n: int) int {
        this.total += n
        return this.total
    }
}

class BmAccOwner {
    acc: BmAcc
}

fn bm_apply(f: fn(int)(int), value: int) int {
    return f(value)
}

fn bm_apply_stack(f: fn(int)(), value: int) {
    f(value)
}

test "Bound methods: a class method binds without an environment allocation" {
    let counter = BmCounter {}
    let bump = counter.bump
    assert(bump(2) == 2)
    let copy = bump.clone()
    assert(copy(3) == 5)
    let stored = Array[fn(int)(int)]{ bump }
    counter = BmCounter {}
    gc.collect()
    gc.collect()
    let kept = stored.get(0) ! panic("missing bound method")
    assert(kept(1) == 6)
    assert(bm_apply(kept, 1) == 7)
    assert(counter.n == 0)
}

test "Bound methods: a struct method binds its frame receiver" {
    let acc = BmAcc {}
    let add = acc.add
    add(5)
    add(6)
    assert(acc.total == 11)
    bm_apply_stack(add, 1)
    assert(acc.total == 12)

    let owner = BmAccOwner { acc: {} }
    let boxed = owner.acc.add
    boxed(4)
    gc.collect()
    boxed(4)
    assert(owner.acc.total == 8)
}

test "Unbound methods: receivers remain explicit in pointers and closures" {
    let counter = BmCounter {}
    let pointer: fnptr(BmCounter, int)(int) = BmCounter.bump
    assert(pointer(counter, 7) == 7)
    let method: fn(BmCounter, int)(int) = BmCounter.bump
    assert(method(counter, 19) == 26)
    let copied = method.clone()
    gc.collect()
    assert(copied(counter, 3) == 29)
    assert(await co method(counter, 1) == 30)
    let bound = counter.bump
    assert(bound(7) == 37)
    let unbound_again: fn(BmCounter, int)(int) = BmCounter.bump
    assert(unbound_again(counter, 4) == 41)
    let static_pointer: fnptr(int)(int) = BmCounter.twice
    assert(static_pointer(19) == 38)
    let static_closure: shared fn(int)(int) = BmCounter.twice
    assert(static_closure(19) == 38)
}

test "Unbound methods: struct adapters preserve explicit borrowed receivers" {
    let acc = BmAcc {}
    let bound = acc.add
    bound(7)
    let method: fn(local mut &BmAcc, int)() = BmAcc.add
    method(&acc, 19)
    let pointer: fnptr(local mut &BmAcc, int)() = BmAcc.add
    pointer(&acc, 3)
    assert(acc.total == 29)
    bound(1)
    assert(acc.total == 30)
}

test "Bound methods: shared callbacks retain shared receivers" {
    let counter: shared BmCounter = BmCounter { n: 73 }
    let read: shared fn()(int) = counter.read
    let copied = read.clone()
    counter = BmCounter { n: 19 }
    gc.collect()
    assert(copied() == 73)
    assert(counter.read() == 19)
}

class BmFactory {
    calls: int (0)
    fn make() BmAccOwner {
        this.calls++
        return BmAccOwner { acc: { total: 7 } }
    }
}

fn bm_collect_suspended() { gc.collect() }

test "Bound methods: a local call keeps the original receiver alive" {
    let factory = BmFactory {}
    let owner = factory.make()
    let add = owner.acc.add_total
    owner = BmAccOwner { acc: { total: 19 } }
    gc.collect()
    assert(add(3) == 10)
    await co bm_collect_suspended()
    gc.collect()
    assert(add(5) == 15)
    assert(owner.acc.total == 19)
    assert(factory.calls == 1)

    let once = factory.make().acc.add
    once(1)
    once(2)
    assert(factory.calls == 2)
    let borrowed = &factory.make().acc
    assert(borrowed.add_total(3) == 10)
    let number = &factory.make().acc.total
    gc.collect()
    assert(number[0] == 7)
    assert(factory.calls == 4)
}

test "Bound methods: loops retain copies of earlier bindings" {
    let owner = BmAccOwner { acc: {} }
    let previous = owner.acc.add
    let i = 0
    while i < 3 {
        let current_owner = BmAccOwner { acc: {} }
        let current = current_owner.acc.add
        if i == 0 : previous = current
        current(7)
        previous(3)
        assert(current_owner.acc.total == (i == 0 ? 10 : 7))
        i++
    }
    previous(1)
    assert(owner.acc.total == 0)
}

test "Bound methods: cloned struct bindings still refer to their receiver" {
    let acc = BmAcc {}
    let add = acc.add
    let copied = add.clone()
    gc.collect()
    add(7)
    copied(19)
    assert(acc.total == 26)
}


test "Bound methods: optimized local calls preserve errors" {
    let acc = BmAcc {}
    let add = acc.checked_add
    assert((add(7) !? -1) == 7)
    assert((add(-1) !? -1) == -1)
    assert(acc.total == 7)
}

struct BmTempCounter {
    number: int
    fn add(n: int) int { this.number += n; return this.number }
}
fn bm_make_counter(start: int) BmTempCounter { return BmTempCounter { number: start } }

test "Bound methods: a struct returned by value is a valid receiver" {
    assert(bm_make_counter(10).add(1) == 11)
    let add = bm_make_counter(20).add
    assert(add(1) == 21)
    assert(add(1) == 22)
}


fn vscope_err() int !AnError {
    throw .error
}
fn vscope_err2() (int, int) !AnError {
    throw .error
}
fn vscope_err3() (String, String) !AnError {
    throw .error
}
fn mvtest() (String, String) {
    return ("1", "2")
}

test "Value scopes" {

    let a = <{
        return 1
    }
    let b = vscope_err() !? <{
        return 2
    }
    let c = vscope_err() !? <{
        if true {
            return 3
        }
        return 4
    }

    assert(a == 1)
    assert(b == 2)
    assert(c == 3)

    let d, e = <{
        if true {
            return (1,2)
        }
        return (3,4)
    }

    assert(d == 1)
    assert(e == 2)

    let f, g = vscope_err2() !? <{
        return (3, 4)
    }

    assert(f == 3)
    assert(g == 4)

    let h, i = vscope_err3() !? <{
        return (3, 4)
    }

    assert(h == "3")
    assert(i == "4")
}

error VscopeExit (one, two) payload { msg: String }

fn vscope_exit_throw(fail: bool) int !VscopeExit {
    let v = fail ? <{ throw .one { msg: "vscope" } } : 5
    return v
}
fn vscope_exit_handler() int !VscopeExit {
    let v = vscope_err() !? <{ throw .two { msg: "handler" } }
    return v
}
fn vscope_exit_break(items: Array[int]) int {
    let sum = 0
    each items as it {
        let v: int = it > 2 ? <{ break } : it
        let w = it == 1 ? <{ continue } : v
        sum += w
    }
    return sum
}

test "Value scopes that only exit" {
    assert((vscope_exit_throw(false) !? -1) == 5)
    assert((vscope_exit_throw(true) !? -1) == -1)
    let msg = ""
    vscope_exit_throw(true) ! { msg = E.msg }
    assert(msg == "vscope")
    vscope_exit_handler() ! { msg = E.msg }
    assert(msg == "handler")
    assert(vscope_exit_break(Array[int]{ 1, 2, 3, 4 }) == 2)
    let x = 3
    let y: int = x == 3 ? 7 : <{ panic("unreachable") }
    assert(y == 7)
}

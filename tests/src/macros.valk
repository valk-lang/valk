
test "Macro: array" {
    let arr = Array[String]{}
    assert(arr.length == 0)
    arr = Array[String]{ "a", "b", "c" }
    assert(arr.length == 3)
    arr = Array[String]{
        "a",
        "b"
    }
    assert(arr.length == 2)
    arr = Array[String]{
        "a"
        "b",
    }
    assert(arr.length == 2)
    // Use the assignment's suggested Array[String] type
    arr = .{ "x" }
    assert(arr.length == 1)
    assert((arr.get(0) !? "y") == "x")
    assert((arr.get(1) !? "y") == "y")
}

test "Macro: map" {
    let m = Map[String]{}
    assert(m.length == 0)
    m = Map[String]{ "a" => "1",
        "b" => "2"
        "c" => "3",
    }
    assert(m.length == 3)
    assert((m.get("a") !? "9") == "1")
    assert((m.get("b") !? "9") == "2")
    assert((m.get("c") !? "9") == "3")
}

class MacroScopeTest {
    value: Array[String] (.{})
}

global macro_explicit_default: int (7)
global macro_implicit_default: int

test "Macro: is_defined" {
    let local = 1
    assert(is_defined(local))
    assert(is_defined(int))
    assert(is_defined(__PATH__))
    assert(is_defined(__FILE__))
    assert(is_defined(__LINE__))
    assert(__FILE__ == "macros.valk")
    assert(__PATH__.ends_with(__FILE__))
    assert(__PATH__ != __FILE__)
    assert(__LINE__ > 0)
    assert(!is_defined(missing_identifier))

    #if is_defined(local)
    assert(true)
    #else
    assert(false)
    #end

    #if is_defined(missing_identifier)
    assert(false)
    #else
    assert(true)
    #end
}

test "Macro: default value compile test" {
    // Check if this compile
    let x = MacroScopeTest{}
    assert(x.value.length == 0)

    #if macro_explicit_default.$has_default_value
    assert(true)
    #else
    assert(false)
    #end
    #if macro_explicit_default.$has_explicit_default_value
    assert(true)
    #else
    assert(false)
    #end

    // `int` has a generated default, but this global has no source initializer.
    #if macro_implicit_default.$has_default_value
    assert(true)
    #else
    assert(false)
    #end
    #if macro_implicit_default.$has_explicit_default_value
    assert(false)
    #else
    assert(true)
    #end
}

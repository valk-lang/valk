use valk:gc

union TaggedScalar : String | int | bool {
    static fn number() TaggedScalar {
        return 7
    }

    fn describe() String {
        return match this : String {
            String as text => "string:" + text
            int as number => "int:" + number
            bool as enabled => enabled ? "bool:true" : "bool:false"
        }
    }
}

union TaggedScalarReordered : bool | String | int {}

union NullableTaggedScalar : String | int | null {
    fn describe() String {
        return match this : String {
            String as text => text
            int as number => number.to(String)
            default => "missing"
        }
    }
}

union TaggedFloat : String | float {}
union TaggedF32 : f32 | int {}
union TaggedF64 : f64 | int {}
union TaggedSignedUnsigned : int | uint {}
union TaggedI32 : String | i32 {}
union TaggedU8 : String | u8 {}

enum TaggedKind: u8 {
    none
    value
}

union TaggedEnum : TaggedKind | String {}

global tagged_multi_node_count: uint

class TaggedMultiNode {
    value: uint

    fn gc_free() {
        tagged_multi_node_count--
    }
}

fn tagged_multi_node(value: uint) TaggedMultiNode {
    tagged_multi_node_count++
    return TaggedMultiNode { value: value }
}

union TaggedMulti : (u8, TaggedMultiNode) | int {}

fn tagged_multi_value() TaggedMulti {
    return (7.to(u8), tagged_multi_node(31))
}

struct TaggedWideNodes {
    first: TaggedMultiNode
    marker: uint
    second: TaggedMultiNode
}

struct TaggedOffsetNode {
    marker: uint
    node: TaggedMultiNode
}

union TaggedOverlap : <TaggedWideNodes> | <TaggedOffsetNode> | int {}

class TaggedOverlapHolder {
    value: TaggedOverlap
}

fn tagged_overlap_wide() TaggedOverlap {
    let value: <TaggedWideNodes> = {
        first: tagged_multi_node(1)
        marker: 7
        second: tagged_multi_node(2)
    }
    return value
}

fn tagged_overlap_offset() TaggedOverlap {
    let value: <TaggedOffsetNode> = {
        marker: 9
        node: tagged_multi_node(3)
    }
    return value
}

fn tagged_overlap_holder() TaggedOverlapHolder {
    return TaggedOverlapHolder { value: tagged_overlap_wide() }
}

fn tagged_overlap_replace(holder: TaggedOverlapHolder, offset: bool) {
    holder.value = offset ? tagged_overlap_offset() : 0
}

struct TaggedInlineObject {
    label: String
    count: int
}

struct TaggedInlineStruct {
    left: int
    right: int
}

union TaggedInline : <TaggedInlineObject> | <TaggedInlineStruct> | [int x 3] {}

class TaggedHolder {
    value: TaggedScalar
}

class TaggedInlineHolder {
    value: TaggedInline
}

class TaggedText {
    value: String
}

class TaggedList {
    values: Array[TaggedTree]
}

union TaggedTree : TaggedText | TaggedList {}

global tagged_global: TaggedScalar (0)

fn tagged_value(kind: uint) TaggedScalar {
    if kind == 0 : return "text"
    if kind == 1 : return 42
    return true
}

fn tagged_accept_reordered(value: TaggedScalarReordered) String {
    return match value : String {
        String as text => text
        int as number => number.to(String)
        bool as enabled => enabled ? "true" : "false"
    }
}

fn nullable_tagged_value(present: bool) NullableTaggedScalar {
    if present : return "set"
    return null
}

fn nullable_string_to_tagged(value: ?String) NullableTaggedScalar {
    return value
}

fn tagged_float_value(value: TaggedFloat) float {
    return match value : float {
        String as _ => 0.0
        float as number => number
    }
}

fn tagged_f32_value(value: TaggedF32) f32 {
    return match value : f32 {
        f32 as number => number
        int as number => number.to(f32)
    }
}

fn tagged_f64_value(value: TaggedF64) f64 {
    return match value : f64 {
        f64 as number => number
        int as number => number.to(f64)
    }
}

fn tagged_signed_unsigned_value(value: TaggedSignedUnsigned) String {
    return match value : String {
        int as signed => "int:" + signed.to(String)
        uint as unsigned => "uint:" + unsigned.to(String)
    }
}

fn tagged_i32_value(value: TaggedI32) i32 {
    return match value : i32 {
        String as _ => 0
        i32 as number => number
    }
}

fn tagged_u8_value(value: TaggedU8) u8 {
    return match value : u8 {
        String as _ => 0
        u8 as number => number
    }
}

fn tagged_inline_object_value(value: TaggedInline) String {
    return match value : String {
        <TaggedInlineObject> as object => object.label + ":" + object.count
        default => "other"
    }
}

fn tagged_inline_struct_value(value: TaggedInline) String {
    return match value : String {
        <TaggedInlineStruct> as point => (point.left + point.right).to(String)
        default => "other"
    }
}

fn tagged_inline_array_value(value: TaggedInline) String {
    return match value : String {
        [int x 3] as values => (values[0] + values[1] + values[2]).to(String)
        default => "other"
    }
}

fn tagged_ignore_non_string(value: TaggedScalar) String {
    match value {
        String as text => return text
        default => _
    }
    return "other"
}

fn anonymous_union_ignore(value: String | int) String {
    match value {
        String as text => return text
        default => _
    }
    return "other"
}

fn tagged_coro_echo(value: TaggedScalar) TaggedScalar {
    gc:collect()
    return value
}

fn tagged_compare_text(prefix: String) String {
    return prefix + "value"
}

global tagged_compare_count: uint

fn tagged_compared(value: TaggedScalar) TaggedScalar {
    tagged_compare_count++
    return value
}

test "Tagged unions: widen and exhaustively match" {
    assert(tagged_value(0).describe() == "string:text")
    assert(tagged_value(1).describe() == "int:42")
    assert(tagged_value(2).describe() == "bool:true")
    assert(tagged_float_value(1.5) == 1.5)
    let f32_value: TaggedF32 = 1.25.to(f32)
    let f64_value: TaggedF64 = 1.25.to(f64)
    assert(tagged_f32_value(f32_value) == 1.25.to(f32))
    assert(tagged_f64_value(f64_value) == 1.25.to(f64))
    assert(TaggedScalar.number().describe() == "int:7")

    let text = "same-" + "object"
    let text_value: TaggedScalar = text
    let text_copy = text_value
    assert(text_value == text_copy)

    let signed: TaggedSignedUnsigned = 5
    let unsigned: TaggedSignedUnsigned = 5.to(uint)
    assert(tagged_signed_unsigned_value(signed) == "int:5")
    assert(tagged_signed_unsigned_value(unsigned) == "uint:5")

    let narrow_signed: TaggedI32 = -123.to(i32)
    let narrow_unsigned: TaggedU8 = 250.to(u8)
    assert(tagged_i32_value(narrow_signed) == -123)
    assert(tagged_u8_value(narrow_unsigned) == 250)

    assert(size_of(TaggedScalar) == size_of(u64) + size_of(ptr))
    assert(size_of(TaggedF64) == size_of(u64) + size_of(f64))
    assert(size_of(TaggedTree) == size_of(u64) + size_of(ptr))
    assert(size_of(TaggedInline) == size_of(u64) + size_of([int x 3]))
}

test "Tagged unions: compare member values" {
    let value: TaggedEnum = TaggedKind.value
    assert(value == TaggedKind.value)
    assert(TaggedKind.value == value)
    assert(value != TaggedKind.none)
    assert(TaggedKind.none != value)

    let text = tagged_compare_text("same-")
    let left: TaggedScalar = text
    let right: TaggedScalar = "same-value"
    assert(text == "same-value")
    assert(left == right)
    assert(left == "same-value")
    assert("same-value" == left)
    tagged_compare_count = 0
    assert(tagged_compared(left) == tagged_compared(right))
    assert(tagged_compare_count == 2)
}

synctest "Tagged unions: inline payloads use typed GC storage" {
    let label = "al" + "ive"
    let object: <TaggedInlineObject> = { label: label, count: 7 }
    let value: TaggedInline = object
    gc:collect()
    assert(tagged_inline_object_value(value) == "alive:7")

    let point: <TaggedInlineStruct> = { left: 2, right: 3 }
    let point_value: TaggedInline = point
    assert(tagged_inline_struct_value(point_value) == "5")

    let values: TaggedInline = [int x 3]{ 1, 2, 3 }
    assert(tagged_inline_array_value(values) == "6")
}

synctest "Tagged unions: aligned multi payloads keep their managed fields" {
    gc:collect()
    assert(tagged_multi_node_count == 0)

    let value = tagged_multi_value()
    gc:collect()
    assert(tagged_multi_node_count == 1)
    assert(value == value)

    value = 0
    gc:collect()
    assert(tagged_multi_node_count == 0)
}

synctest "Tagged unions: active tags trace overlapping GC layouts" {
    gc:collect()
    assert(tagged_multi_node_count == 0)

    let holder = tagged_overlap_holder()
    gc:collect()
    assert(tagged_multi_node_count == 2)

    tagged_overlap_replace(holder, true)
    gc:collect()
    assert(tagged_multi_node_count == 1)

    tagged_overlap_replace(holder, false)
    gc:collect()
    assert(tagged_multi_node_count == 0)
}

synctest "Tagged unions: fixed arrays trace tagged nullable inline values" {
    let values: [?<TaggedInlineObject> x 2] = {
        { label: "nullable-" + "alive", count: 21 }
        null
    }
    gc:collect()

    let first = values[0]
    if !isset(first) : panic("nullable inline value was lost")
    assert(first.label == "nullable-alive")
    assert(first.count == 21)
}

test "Tagged unions: locals, properties and containers" {
    let local: TaggedScalar = 7
    assert(local.describe() == "int:7")

    let holder = TaggedHolder { value: "property" }
    assert(holder.value.describe() == "string:property")

    let values = Array[TaggedScalar]{}
    values.append(false)
    values.append("array")
    assert((values.get(0) !? true).describe() == "bool:false")
    assert((values.get(1) !? true).describe() == "string:array")
}

synctest "Tagged unions: copies own their active value" {
    let original: TaggedScalar = "copy-" + "alive"
    let copy = original
    original = 7
    gc:collect()
    assert(copy.describe() == "string:copy-alive")

    let holder = TaggedHolder { value: "property-" + "alive" }
    let property_copy = holder.value
    holder.value = 9
    gc:collect()
    assert(property_copy.describe() == "string:property-alive")

    holder.value = "property-" + "updated"
    gc:collect()
    assert(holder.value.describe() == "string:property-updated")
}

synctest "Tagged unions: nested inline GC fields survive heap storage" {
    let object: <TaggedInlineObject> = {
        label: "inline-" + "alive"
        count: 11
    }
    let holder = TaggedInlineHolder { value: object }
    gc:collect()
    assert(tagged_inline_object_value(holder.value) == "inline-alive:11")

    let point: <TaggedInlineStruct> = { left: 4, right: 5 }
    holder.value = point
    gc:collect()
    assert(tagged_inline_struct_value(holder.value) == "9")
}

synctest "Tagged unions: arrays trace and copy inline values" {
    let values = Array[TaggedScalar]{}
    values.append("array-" + "alive")
    gc:collect()
    let copy = values.get(0) !? false
    values.set(0, 13) _
    gc:collect()
    assert(copy.describe() == "string:array-alive")
}

synctest "Tagged unions: globals root their active managed payload" {
    tagged_global = "global-" + "alive"
    gc:collect()
    assert(tagged_global.describe() == "string:global-alive")
    tagged_global = 0
}

synctest "Tagged unions: coroutines retain inline arguments and results" {
    let task = co tagged_coro_echo("coro-" + "alive")
    gc:collect()
    let result = await task
    gc:collect()
    assert(result.describe() == "string:coro-alive")

    let scalar_task = co tagged_coro_echo(42)
    assert((await scalar_task).describe() == "int:42")
}

test "Tagged unions: nullable union uses outer null" {
    let value: ?TaggedScalar = null
    assert(!isset(value))
    value = "present"
    assert(isset(value))
    assert(value.describe() == "string:present")

    let missing: ?String = null
    let missing_union = nullable_string_to_tagged(missing)
    assert(!isset(missing_union))

    let present: ?String = "converted"
    let present_union = nullable_string_to_tagged(present)
    assert(isset(present_union))
    if isset(present_union) {
        assert(present_union.describe() == "converted")
    }
}

test "Tagged unions: named declarations have nominal identity" {
    let value: TaggedScalarReordered = 19
    assert(tagged_accept_reordered(value) == "19")
    assert(!TaggedScalar.$is_type_of(TaggedScalarReordered))
}

test "Tagged unions: null syntax and exhaustive null match" {
    let missing = nullable_tagged_value(false)
    let present = nullable_tagged_value(true)
    let missing_text = match missing : String {
        null => "missing"
        String as text => text
        int as number => number.to(String)
    }
    let present_text = match present : String {
        null => "missing"
        String as text => text
        int as number => number.to(String)
    }
    assert(missing_text == "missing")
    assert(present_text == "set")
    assert(missing.describe() == "missing")
    assert(present.describe() == "set")
}

test "Tagged unions: empty match arms" {
    assert(tagged_ignore_non_string("text") == "text")
    assert(tagged_ignore_non_string(42) == "other")
    assert(anonymous_union_ignore(42) == "other")
}

synctest "Tagged unions: GC traces recursive union payloads" {
    let tree: TaggedTree = TaggedList {
        values: Array[TaggedTree]{
            TaggedText { value: "still alive" }
        }
    }
    gc:collect()
    match tree {
        TaggedText as text => assert(text.value == "unused")
        TaggedList as list => match (list.values.get(0) !? tree) {
            TaggedText as text => assert(text.value == "still alive")
            TaggedList as nested => assert(nested.values.length == 0)
        }
    }
}

use valk.core

// Globals initialize after the globals their default reads, whatever the
// declaration order, and after the stdlib globals their default needs.

global order_a: int (order_b + 1)
global order_b: int (order_c * 2)
global order_c: int (5)
global order_text: String (order_suffix + "!")
global order_suffix: String ("d")

fn order_from_func() int { return order_a + order_text.length }
global order_via_func: int (order_from_func())

fn format_float() String { let f = 1.5; return f.to(String) + "|" + 12345.to(String) }
global order_float: String (format_float())

class GlobalNode { value: int }
fn make_node() GlobalNode { return GlobalNode { value: order_via_func } }
shared order_shared: GlobalNode (make_node())
@shared order_at_shared: GlobalNode (GlobalNode { value: 9 })
global order_fixed: [u8 x 3] ({ 1, 2, 3 })

test "Globals: initialization follows dependencies" {
    assert(order_c == 5)
    assert(order_b == 10)
    assert(order_a == 11)
    assert(order_text == "d!")
    assert(order_via_func == 13)
    assert(order_shared.value == 13)
    assert(order_at_shared.value == 9)
    assert(order_fixed[1] == 2)
}

test "Globals: initializer can format floats" {
    assert(order_float == "1.5|12345")
    assert(order_float == format_float())
}

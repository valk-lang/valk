use valk.json
use valk.template
use valk.thread
use valk.validate

class FixJsonFloats {
    + ratio: float
    + small: f32
}

class FixJsonDefaults {
    + name: String ("anon")
    + count: int (7)
    + note: ?String ("n")
    + plain: ?int
}

test "Fix json: a container shared without a cycle is written in full each time" {
    let shared = json.new_array()
    shared.values.append(json.new_int(1))
    let doc = json.new_object()
    doc.values.set("a", json.from(shared))
    doc.values.set("b", json.from(shared))
    assert(json.encode(doc) == "{\"a\":[1],\"b\":[1]}")
    assert(json.encode(doc) == "{\"a\":[1],\"b\":[1]}")

    // A real cycle is still cut, even below a node that was shared.
    let loop = json.new_array()
    loop.values.append(json.from(loop))
    let top = json.new_array()
    top.values.append(json.from(loop))
    top.values.append(json.from(loop))
    assert(json.encode(top) == "[[\"(recursion)\"],[\"(recursion)\"]]")
}

test "Fix json: an integer is accepted where a float is expected" {
    let v = json.decode("3") !!
    assert(v.float == 3.0)
    assert((v.float_value() !? 0.0) == 3.0)
    assert((v.to_type[float]() !? 0.0) == 3.0)
    assert((v.to_type[f32]() !? 0.0.to(f32)) == 3.0.to(f32))
    assert((json.decode_to[float]("-4") !? 0.0) == -4.0)

    let doc = json.decode("{\"x\":2}") !!
    assert((doc.get_float("x") !? 0.0) == 2.0)
    assert(doc.has_float("x"))
    assert(!doc.has_float("missing"))
    assert((json.decode("\"s\"") !!).float == 0.0)

    let text = "{\"ratio\":5,\"small\":-2}"
    let direct = json.decode_to[FixJsonFloats](text) !!
    assert(direct.ratio == 5.0 && direct.small == -2.0.to(f32))
    let converted = (json.decode(text) !!).to_type[FixJsonFloats]() !!
    assert(converted.ratio == 5.0 && converted.small == -2.0.to(f32))

    // An encoded whole float comes back.
    let again = json.decode_to[FixJsonFloats](json.encode(direct)) !!
    assert(again.ratio == 5.0)

    assert(validate.Field.float().validate(json.from(4)))
    assert(!validate.Field.float().validate(json.from("4")))
}

test "Fix json: decode_to gives the default for a null field, as to_type does" {
    let text = "{\"name\":null,\"count\":null,\"note\":null,\"plain\":null}"
    let direct = json.decode_to[FixJsonDefaults](text) !!
    let converted = (json.decode(text) !!).to_type[FixJsonDefaults]() !!
    assert(direct.name == "anon" && converted.name == "anon")
    assert(direct.count == 7 && converted.count == 7)
    assert((direct.note ?? "") == "n" && (converted.note ?? "") == "n")
    assert(!isset(direct.plain) && !isset(converted.plain))

    let filled = json.decode_to[FixJsonDefaults]("{\"count\":null,\"count\":3,\"name\" : null }") !!
    assert(filled.count == 3 && filled.name == "anon")
    json.decode_to[FixJsonDefaults]("{\"count\":nullx}") ! {
        assert(E.code == E.invalid)
        return
    }
    assert(false)
}

test "Fix template: an escape of null writes values unescaped" {
    let data = Map[String]{ "v" => "<b>" }
    assert(template.render_content("{{ v }}", data, template.RenderOptions { escape: null }) !! == "<b>")
    assert(template.render_content("{{ v }}", data, template.RenderOptions {}) !! == "&lt;b&gt;")
    assert(template.render_content("{{ v }}", data, template.RenderOptions { max_depth: 3 }) !! == "&lt;b&gt;")
    assert(template.render_content("{{ v }}", data) !! == "&lt;b&gt;")
}

test "Fix template: @isset tests existence, not truthiness" {
    let data = json.decode("{\"zero\":0,\"empty\":\"\",\"off\":false,\"none\":null,\"obj\":{\"n\":0}}") !!
    let content = "@if(@isset(zero))a@end @if(@isset(empty))b@end @if(@isset(off))c@end @if(@isset(obj.n))d@end @if(@isset(none))x@end @if(@isset(nope))y@end @if(@isset(obj.nope))z@end"
    assert(template.render_content(content, data) !! == "a b c d")
}

test "Fix template: render and render_content count max_depth the same way" {
    template.set_content("fix-depth-leaf", "leaf")
    template.set_content("fix-depth-mid", "@include(\"fix-depth-leaf\")")
    template.set_content("fix-depth-top", "@include(\"fix-depth-mid\")")
    let data = Map[String]{}
    let zero = template.RenderOptions { max_depth: 0 }
    let one = template.RenderOptions { max_depth: 1 }
    let two = template.RenderOptions { max_depth: 2 }

    // No include: fine even at 0, for both.
    assert(template.render("fix-depth-leaf", data, zero) !! == "leaf")
    assert(template.render_content("leaf", data, zero) !! == "leaf")
    // One level of include.
    assert(template.render("fix-depth-mid", data, one) !! == "leaf")
    assert(template.render_content("@include(\"fix-depth-leaf\")", data, one) !! == "leaf")
    assert((template.render("fix-depth-mid", data, zero) !? "err") == "err")
    assert((template.render_content("@include(\"fix-depth-leaf\")", data, zero) !? "err") == "err")
    // Two levels.
    assert(template.render("fix-depth-top", data, two) !! == "leaf")
    assert(template.render_content("@include(\"fix-depth-mid\")", data, two) !! == "leaf")
    assert((template.render("fix-depth-top", data, one) !? "err") == "err")
    assert((template.render_content("@include(\"fix-depth-mid\")", data, one) !? "err") == "err")
}

test "Fix template: templates registered on one thread render on another" {
    template.set_content("fix-thread-page", "Hi {{ name }} @include(\"fix-thread-part\")")
    template.set_content_many(Map[String]{ "fix-thread-part" => "from {! where !}" })
    let worker = thread.Thread[String].start(fn() String {
        return template.render("fix-thread-page", Map[String]{ "name" => "<w>", "where" => "<t>" }) !? "missing"
    }) !!
    assert(worker.await() == "Hi &lt;w&gt; from <t>")

    let other = thread.Thread[bool].start(fn() bool {
        template.set_content("fix-thread-late", "late")
        return true
    }) !!
    assert(other.await())
    assert(template.render("fix-thread-late", Map[String]{}) !! == "late")
}

test "Fix validate: string_syntax has a default translation" {
    let errors = Map[String]{}
    let rule = validate.Field.string().is_syntax("a")
    assert(!rule.validate(json.from("abc!"), errors))
    let code = errors.get("field") !? "?"
    assert(code == "string_syntax")
    validate.Field.translate_errors(errors)
    assert((errors.get("field") !? "?") == "Contains invalid characters")
    assert((validate.default_translations.get("string_syntax") !? "") != "")
}

test "Fix validate: translate_errors keeps a colon in the value" {
    let errors = Map[String]{ "f" => "string_equal:a:b:c", "g" => "int_min:3", "h" => "custom" }
    validate.Field.translate_errors(errors)
    assert((errors.get("f") !? "") == "Must be equal to 'a:b:c'")
    assert((errors.get("g") !? "") == "Minimum value is 3")
    assert((errors.get("h") !? "") == "custom")
}

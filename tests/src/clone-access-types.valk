class CloneViaMethod {
    - value: uint

    + static fn make(value: uint) SELF {
        return SELF { value: value }
    }

    + get result: uint { return this.value }

    + fn duplicate() SELF $clone {
        return SELF { value: this.value + 1 }
    }
}

class ClonePrivateMethod {
    + value: uint

    - fn clone() SELF $clone {
        return SELF { value: 999 }
    }
}

class CloneIgnoredAccess {
    - value: uint
}

class CloneNamedOnly {
    + value: uint

    + fn clone() SELF {
        return SELF { value: 999 }
    }
}

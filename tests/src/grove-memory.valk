use valk.gc
use valk.fs
use valk.mem

// Reads the collector's buffers and the heap's constants
@ignore_access

synctest "Grove: the collector's buffers shrink after a peak" {
    let mib: uint = 1024 * 1024
    // As after a peak: room for 300 000 removals and 4 MiB of root objects
    gc.gc.props_removed.reserve(300_000)
    gc.gc.stack_items.minimum_size(4 * mib)
    assert(gc.gc.props_removed.size * size_of(ptr) >= 2 * mib)
    // The first collection arms the guards; two below a quarter shrink to that quarter
    gc.collect()
    gc.collect()
    assert(gc.gc.stack_items.size == 4 * mib)
    gc.collect()
    assert(gc.gc.props_removed.size * size_of(ptr) < mib)
    assert(gc.gc.stack_items.size == mib)
}

synctest "Grove: a buffer above 1 MiB shrinks only after two quiet collections" {
    @unsafe
    let mib: uint = 1024 * 1024
    let b = gc.Bump.new(4 * mib)
    b.shrink_idle()
    // Filled past a quarter in this cycle: it stays
    mem.clear_bytes(b.get(2 * mib), 2 * mib)
    b.reset()
    b.shrink_idle()
    assert(b.size == 4 * mib)
    // Below a quarter for two collections: it shrinks to the quarter and keeps its entries
    b.add_ptr(b.@cast(ptr))
    b.shrink_idle()
    assert(b.size == 4 * mib)
    b.shrink_idle()
    assert(b.size == mib)
    assert(b.index == size_of(ptr))
    assert(@ptrv(b.data, ptr) == b.@cast(ptr))
    b.free()
}

fn grove_mem_large(count: uint, size: uint) $noinline {
    @unsafe
    let list = Array[gc.GcPtr].new(count)
    let i: uint = 0
    while i < count {
        let item = gc.alloc(size)
        let p: ptr = item
        let offset: uint = 0
        while offset < size {
            @ptrv(p, u8, offset) = 1
            offset += 4096
        }
        list.append(item)
        i++
    }
}

synctest "Grove: a free chunk goes back to the OS whatever the zero flags of its pages" {
    // The last chunk the objects reach keeps pre-zeroed pages beside their freed ones
    grove_mem_large(12, 3 * 1024 * 1024 + 256 * 1024)
    gc.collect()
    gc.collect()
    gc.collect()
    let retain = gc.gc.mem_trigger * 2
    if retain < gc.RETAIN_MIN : retain = gc.RETAIN_MIN
    assert(gc.free_chunks_kept_for_test() <= retain)
}

fn grove_mem_rss() uint {
    let statm = fs.read("/proc/self/statm") !? ""
    let pages = statm.split(" ").get(1) !? "0"
    return (pages.to_uint() !? 0) * 4096
}

// A large object with every page written; returns its address
fn grove_mem_touched(size: uint) uint $noinline {
    @unsafe
    let p: ptr = gc.alloc(size)
    let offset: uint = 0
    while offset < size {
        @ptrv(p, u8, offset) = 1
        offset += 4096
    }
    let a: uint = p
    return a
}

fn grove_mem_storage(count: uint) (Array[uint], uint) $noinline {
    @unsafe
    let list = Array[uint].new(count)
    let a: uint = list.items().@cast(ptr)
    return (list, a)
}

#if OS == "linux"
synctest "Grove: a large storage on reused pages does not become resident" {
    let mib: uint = 1024 * 1024
    gc.collect()
    let freed = grove_mem_touched(32 * mib)
    // Freed, its pages are still resident: a chunk goes back after two idle collections
    gc.collect()
    let before = grove_mem_rss()
    let list, at = grove_mem_storage(4 * mib)
    let now = grove_mem_rss()
    if at >= freed && at < freed + 32 * mib {
        // Zeroed by giving the pages back, not by writing them
        assert(now + 16 * mib < before)
    } else {
        assert(now < before + 16 * mib)
    }
    list.append(5)
    assert((list.get(0) !? 0) == 5)
    assert((list.get(1) !? 1) == 1)
}
#end

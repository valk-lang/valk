fn bounded_pointer_read(value: *[u8 x 2]) u8 {
    return value[0]
}

fn bounded_pointer_write(value: *[u8 x 2]) {
    value[1] = 1
}

global SAFE_POINTER: ptr

fn acquire_pointer() ptr {
    return SAFE_POINTER
}

fn call_pointer_return() ptr {
    return acquire_pointer()
}

fn call_pointer_callback_return(callback: fnptr()(ptr)) ptr {
    return callback()
}

fn accept_pointer_array(values: Array[ptr]) {}

fn pass_pointer_array(values: Array[ptr]) {
    accept_pointer_array(values)
}

fn pointer_identity(value: ptr) ptr {
    return value
}

fn generic_pointer_identity(value: $T) T {
    return value
}

fn call_pointer_argument(callback: fnptr(ptr)(ptr), value: ptr) ptr {
    @unsafe
    return callback(value)
}

test "Void pointer arguments require unsafe" {
    @unsafe
    let value = acquire_pointer()
    assert(pointer_identity(value) == value)
    assert(generic_pointer_identity(value) == value)
    assert(call_pointer_argument(pointer_identity, value) == value)
}

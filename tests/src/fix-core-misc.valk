@ignore_access

use valk.core
use valk.ext
use valk.coro
use valk.time

class FixCoreMiscState {
    entered: uint (0)
}

fn fix_core_misc_take(mutex: core.Mutex, state: FixCoreMiscState) {
    mutex.lock()
    state.entered++
}

test "Mutex: unlocking an unlocked mutex does nothing" {
    let mutex = core.Mutex.new() !!
    mutex.unlock()
    mutex.unlock()
    mutex.lock()

    let state = FixCoreMiscState {}
    let first = co fix_core_misc_take(mutex, state)
    let second = co fix_core_misc_take(mutex, state)
    time.sleep_ms(20)
    // The extra unlocks did not leave tokens behind for the waiters
    assert(state.entered == 0)

    mutex.unlock()
    time.sleep_ms(20)
    assert(state.entered == 1)
    mutex.unlock()
    await first
    await second
    assert(state.entered == 2)
    mutex.unlock()
    mutex.unlock()
    mutex.lock()
    mutex.unlock()
}

test "raise: returns when the signal is ignored" {
    #if OS == "win"
    // SIGILL (4), ignored (SIG_IGN is 1)
    let sig: i32 = 4
    #else
    // SIGWINCH (28), ignored (SIG_IGN is 1)
    let sig: i32 = 28
    #end
    @unsafe
    ext.signal(sig, 1.@cast(ptr))
    core.raise(sig)
    let reached = true
    assert(reached)
}

test "Heap: peek on an empty heap throws empty" {
    let h = Heap[int]{}
    let empty = false
    h.peek() ! { empty = error_is(E.code, empty) }
    assert(empty)
    h.push(3)
    assert((h.peek() !? 0) == 3)
}

test "HashMap: clear keeps the requested capacity" {
    let map = HashMap[uint, String].new(100)
    let buckets = map.bucket_count_for_test()
    map.set(1, "one")
    map.clear()
    assert(map.length == 0)
    assert(!map.has(1))
    assert(map.bucket_count_for_test() == buckets)
    let i: uint = 0
    while i < 100 {
        map.set(i, "value")
        i++
    }
    assert(map.bucket_count_for_test() == buckets)
    assert(map.length == 100)
    assert((map.get(99) !? "") == "value")
}

test "Array: default sort puts nulls first" {
    let items = Array[?String]{ "c", null, "a", null, "b" }
    items.sort()
    assert(!isset(items.get(0) !? "x"))
    assert(!isset(items.get(1) !? "x"))
    assert((items.get(2) !? null) == "a")
    assert((items.get(3) !? null) == "b")
    assert((items.get(4) !? null) == "c")

    let numbers = Array[?int]{ 3, null, 1, 2, null }
    let sorted = numbers.sorted()
    assert(!isset(sorted.get(0) !? 0) && !isset(sorted.get(1) !? 0))
    assert((sorted.get(2) !? null) == 1 && (sorted.get(3) !? null) == 2 && (sorted.get(4) !? null) == 3)
}

struct FixCoreMiscKey {
    id: uint (0)
    + fn hash() uint $hash { return this.id }
    + fn eq(other: FixCoreMiscKey) bool $eq { return this.id == other.id }
}

test "HashMap/FlatMap: keys without an order compile and have no sort_keys" {
    let map = HashMap[FixCoreMiscKey, String]{}
    map.set(FixCoreMiscKey{ id: 1 }, "one")
    assert((map.get(FixCoreMiscKey{ id: 1 }) !? "") == "one")
    let flat = FlatMap[FixCoreMiscKey, String]{}
    flat.set(FixCoreMiscKey{ id: 2 }, "two")
    assert((flat.get(FixCoreMiscKey{ id: 2 }) !? "") == "two")
    let has_sort = false
    #if HashMap[FixCoreMiscKey, String].$has_method(sort_keys) || FlatMap[FixCoreMiscKey, String].$has_method(sort_keys)
    has_sort = true
    #end
    assert(!has_sort)

    let ordered = HashMap[int, String]{ 3 => "c", 1 => "a", 2 => "b" }
    ordered.sort_keys()
    let keys = ordered.keys()
    assert((keys.get(0) !? 0) == 1 && (keys.get(1) !? 0) == 2 && (keys.get(2) !? 0) == 3)
}

test "Number: round_down and round_up round toward the infinities" {
    assert((-5).round_down(4) == -8)
    assert((-5).round_up(4) == -4)
    assert((-8).round_down(4) == -8)
    assert((-8).round_up(4) == -8)
    assert((5).round_down(4) == 4)
    assert((5).round_up(4) == 8)
    assert((-5).round_down(-4) == -8)
    assert((5).round_up(-4) == 8)
    assert((0).round_down(4) == 0)
    let u: uint = 13
    assert(u.round_down(8) == 8)
    assert(u.round_up(8) == 16)
    let small: i8 = -127
    assert(small.round_down(4) == -128)
}

test "Process: run searches PATH for a bare program name" {
    #if OS == "win"
    let process = core.Process.run("cmd", .{ "/d", "/s", "/c", "exit" }) !!
    #else
    let process = core.Process.run("sh", .{ "-c", "exit 0" }) !!
    #end
    assert(process.exit_code() !! == 0)
}

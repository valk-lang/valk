// The request fields the multipart parser reads are private; the parser is exercised
// through a constructed request rather than a server round trip.
@ignore_access

use valk.http

test "Http: multipart parameters unescape quotes and keep '=' in a value" {
    let escaped = "--B\r\nContent-Disposition: form-data; name=\"f\"; filename=\"a\\\"b.txt\"\r\nContent-Type: text/plain\r\n\r\nDATA\r\n--B--\r\n"
    let request = http.Request {
        method: "POST"
        path: "/"
        query_string: ""
        body_data: escaped
        header_data: "Content-Type: multipart/form-data; boundary=B\r\n\r\n"
    }
    let file = request.files().get("f") ! { assert(false); return }
    // A quoted-pair stands for the quote itself, without its backslash
    assert(file.filename == "a\"b.txt")

    let bare = "--B\r\nContent-Disposition: form-data; name=a=b\r\n\r\nv\r\n--B--\r\n"
    let second = http.Request {
        method: "POST"
        path: "/"
        query_string: ""
        body_data: bare
        header_data: "Content-Type: multipart/form-data; boundary=B\r\n\r\n"
    }
    // "name=a=b" names the field "a=b": the '=' separates only the first time
    assert((second.form().get("a=b") !? "") == "v")

    // A backslash before the closing quote does not end the string, and an
    // escaped backslash still does
    let trailing = "--B\r\nContent-Disposition: form-data; name=\"f\"; filename=\"b\\\\\"\r\nContent-Type: text/plain\r\n\r\nDATA\r\n--B--\r\n"
    let third = http.Request {
        method: "POST"
        path: "/"
        query_string: ""
        body_data: trailing
        header_data: "Content-Type: multipart/form-data; boundary=B\r\n\r\n"
    }
    let second_file = third.files().get("f") ! { assert(false); return }
    assert(second_file.filename == "b\\")
}

fn multipart_request(body: String, content_type: String ("multipart/form-data; boundary=B")) http.Request {
    return http.Request {
        method: "POST"
        path: "/"
        query_string: ""
        body_data: body
        header_data: "Content-Type: " + content_type + "\r\n\r\n"
    }
}

test "Http: multipart parts end only at a delimiter line" {
    // The boundary text inside a value is data, not a delimiter
    let inside = multipart_request("--B\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nsee --B here\r\n--B\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\nx\r\n--B--\r\n")
    assert((inside.form().get("a") !? "") == "see --B here")
    assert((inside.form().get("b") !? "") == "x")

    // A file without its own type is text/plain, and parameter names ignore case
    let untyped = multipart_request("preamble\r\n--B\r\nContent-Disposition: form-data; NAME=\"f\"; Filename=\"x.bin\"\r\n\r\nraw\r\n--B--\r\n")
    let file = untyped.files().get("f") ! { assert(false); return }
    assert(file.filename == "x.bin")
    assert(file.mime_type == "text/plain")
    assert(file.to_string() == "raw")

    // Truncated bodies give no fields instead of failing
    assert(multipart_request("--B").form().length == 0)
    assert(multipart_request("--B\r").form().length == 0)
    assert(multipart_request("--B\r\nContent-Disposition: form-data; name=\"a\"\r\n").form().length == 0)
}

test "Http: a urlencoded name without '=' has an empty value" {
    let form = multipart_request("a=1&c&&d=a+b", "application/x-www-form-urlencoded").form()
    assert(form.length == 3)
    assert((form.get("c") !? "missing") == "")
    assert((form.get("d") !? "") == "a b")
}

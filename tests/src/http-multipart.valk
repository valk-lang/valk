// The request fields the multipart parser reads are private; the parser is exercised
// through a constructed request rather than a server round trip.
@ignore_access

use valk.http
use valk.fs

test "Http: multipart parameters unescape quotes and keep '=' in a value" {
    let escaped = "--B\r\nContent-Disposition: form-data; name=\"f\"; filename=\"a\\\"b.txt\"\r\nContent-Type: text/plain\r\n\r\nDATA\r\n--B--\r\n"
    let request = http.Request {
        method: "POST"
        path: "/"
        query_string: ""
        body_data: escaped
        header_data: "Content-Type: multipart/form-data; boundary=B\r\n\r\n"
    }
    let file = request.files().get("f") ! { assert(false); return }
    // A quoted-pair stands for the quote itself, without its backslash
    assert(file.filename == "a\"b.txt")

    let bare = "--B\r\nContent-Disposition: form-data; name=a=b\r\n\r\nv\r\n--B--\r\n"
    let second = http.Request {
        method: "POST"
        path: "/"
        query_string: ""
        body_data: bare
        header_data: "Content-Type: multipart/form-data; boundary=B\r\n\r\n"
    }
    // "name=a=b" names the field "a=b": the '=' separates only the first time
    assert((second.form().get("a=b") !? "") == "v")

    // A backslash before the closing quote does not end the string, and an
    // escaped backslash still does
    let trailing = "--B\r\nContent-Disposition: form-data; name=\"f\"; filename=\"b\\\\\"\r\nContent-Type: text/plain\r\n\r\nDATA\r\n--B--\r\n"
    let third = http.Request {
        method: "POST"
        path: "/"
        query_string: ""
        body_data: trailing
        header_data: "Content-Type: multipart/form-data; boundary=B\r\n\r\n"
    }
    let second_file = third.files().get("f") ! { assert(false); return }
    assert(second_file.filename == "b\\")
}

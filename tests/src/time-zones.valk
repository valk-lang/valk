use valk.time
use valk.core
use valk.thread

fn zone_named(name: String) time.Zone {
    return time.zone(name) ! panic("missing zone " + name)
}

fn utc_at(year: int, month: uint, day: uint, hour: uint, minute: uint (0)) time.DateTime {
    return time.DateTime.new(year, month, day, hour, minute) ! panic("invalid date")
}

test "Time zones: offsets and abbreviations follow daylight saving time" {
    let amsterdam = zone_named("Europe/Amsterdam")
    let winter = utc_at(2024, 1, 15, 12).unix_seconds()
    let summer = utc_at(2024, 7, 15, 12).unix_seconds()
    assert(amsterdam.name == "Europe/Amsterdam")
    assert(amsterdam.offset_at(winter) == 3600)
    assert(amsterdam.offset_at(summer) == 7200)
    assert(amsterdam.abbreviation_at(winter) == "CET")
    assert(amsterdam.abbreviation_at(summer) == "CEST")
    assert(!amsterdam.is_dst_at(winter))
    assert(amsterdam.is_dst_at(summer))

    let new_york = zone_named("America/New_York")
    assert(new_york.offset_at(winter) == -18000)
    assert(new_york.abbreviation_at(summer) == "EDT")

    // Half-hour offsets, the southern hemisphere, and times the rules decide
    let kolkata = zone_named("Asia/Kolkata")
    assert(kolkata.offset_at(summer) == 19800)
    assert(kolkata.abbreviation_at(summer) == "IST")
    let sydney = zone_named("Australia/Sydney")
    assert(sydney.offset_at(winter) == 39600)
    assert(sydney.offset_at(summer) == 36000)
    let far = utc_at(2150, 7, 1, 12).unix_seconds()
    assert(amsterdam.offset_at(far) == 7200)
    assert(sydney.offset_at(far) == 36000)
    // Before standard time: local mean time, with seconds
    let lmt = utc_at(1880, 1, 1, 0).unix_seconds()
    assert(new_york.offset_at(lmt) == -17762 && new_york.abbreviation_at(lmt) == "LMT")
}

test "Time zones: unknown and unsafe names are missing" {
    let missing = false
    time.zone("Europe/Atlantis") ! { missing = error_is(E.code, missing) }
    assert(missing)
    missing = false
    time.zone("../../../etc/passwd") ! { missing = error_is(E.code, missing) }
    assert(missing)
    missing = false
    time.zone("") ! { missing = error_is(E.code, missing) }
    assert(missing)
    missing = false
    time.zone("/usr/share/zoneinfo/UTC") ! { missing = error_is(E.code, missing) }
    assert(missing)
    assert((time.zone("UTC") !!).offset_at(0) == 0)
}

test "Time zones: a DateTime shows its instant as wall-clock time in its zone" {
    let amsterdam = zone_named("Europe/Amsterdam")
    let utc = utc_at(2024, 7, 15, 22, 30)
    let local = utc.in_zone(amsterdam) !!
    assert(local.hour() == 0 && local.minute() == 30)
    assert(local.day() == 16)
    assert(local.day_of_week() == 2 && utc.day_of_week() == 1)
    assert(local.utc_offset() == 7200)
    assert(local.zone_abbreviation() == "CEST")
    assert(local.is_dst())
    assert(local.zone().name == "Europe/Amsterdam")
    // The same instant compares equal in any zone
    assert(local == utc)
    assert(local.unix_seconds() == utc.unix_seconds())
    assert((local.in_utc() !!).hour() == 22)
    assert(utc.zone().name == "UTC" && utc.zone_abbreviation() == "UTC" && !utc.is_dst())
    assert(local.to_iso8601() == "2024-07-16T00:30:00+02:00")
    assert(local.format("Y-m-d H:i") == "2024-07-16 00:30")
    assert((utc.in_zone(zone_named("America/St_Johns")) !!).to_iso8601() == "2024-07-15T20:00:00-02:30")
    let lmt = utc_at(1880, 1, 1, 0).in_zone(zone_named("America/New_York")) !!
    assert(lmt.to_iso8601() == "1879-12-31T19:03:58-04:56:02")
}

test "Time zones: wall-clock times around daylight saving changes" {
    let amsterdam = zone_named("Europe/Amsterdam")
    // 02:30 does not exist when the clocks go forward: it moves past the gap
    let gap = time.DateTime.new_in(amsterdam, 2024, 3, 31, 2, 30) !!
    assert(gap.hour() == 3 && gap.minute() == 30 && gap.utc_offset() == 7200)
    // 02:30 happens twice when they go back: the first one is taken
    let fold = time.DateTime.new_in(amsterdam, 2024, 10, 27, 2, 30) !!
    assert(fold.utc_offset() == 7200)
    assert(fold.unix_seconds() == utc_at(2024, 10, 27, 0, 30).unix_seconds())
    let after = fold.add_hours(1) !!
    assert(after.hour() == 2 && after.minute() == 30 && after.utc_offset() == 3600)

    // Calendar days keep the wall-clock time; hours count elapsed time
    let evening = time.DateTime.new_in(amsterdam, 2024, 3, 30, 21) !!
    let next = evening.add_days(1) !!
    assert(next.hour() == 21 && next.utc_offset() == 7200)
    assert(next.unix_seconds() - evening.unix_seconds() == 23 * 3600)
    let later = evening.add_hours(24) !!
    assert(later.hour() == 22)
    let moved = evening.copy()
    moved.modify_add_days(1) !!
    assert(moved == next)
    moved.modify_hour(3) !!
    assert(moved.hour() == 3 && moved.utc_offset() == 7200)
    assert(((evening.with_month(7) !!).utc_offset()) == 7200)
    assert(((evening.add_months(-3) !!).zone_abbreviation()) == "CET")
}

test "Time zones: fixed offsets and ISO 8601 text" {
    let zone = time.fixed_zone(-5 * 3600 - 30 * 60)
    assert(zone.name == "-05:30")
    assert(zone.offset_at(0) == -19800)
    assert(time.fixed_zone(3600).name == "+01:00")

    let parsed = time.DateTime.from_iso8601("2024-03-05T15:07:09.25+01:00") !!
    assert(parsed.hour() == 15 && parsed.microsecond() == 250000 && parsed.utc_offset() == 3600)
    assert(parsed.unix_seconds() == utc_at(2024, 3, 5, 14, 7).unix_seconds() + 9)
    assert(parsed.to_iso8601() == "2024-03-05T15:07:09.250000+01:00")
    assert((time.DateTime.from_iso8601("2024-03-05 14:07:09Z") !!).to_iso8601() == "2024-03-05T14:07:09Z")
    assert((time.DateTime.from_iso8601("2024-03-05T14:07-0130") !!).utc_offset() == -5400)
    assert((time.DateTime.from_iso8601("2024-03-05T14:07:09+05") !!).utc_offset() == 18000)
    assert((time.DateTime.from_iso8601("2024-03-05T14:07:09.123456789Z") !!).microsecond() == 123456)
    assert((time.DateTime.from_iso8601("2024-03-05T14:07:09") !!).zone().name == "UTC")
    // A date alone is midnight UTC; RFC 3339 allows a lowercase t and z
    let date_only = time.DateTime.from_iso8601("2024-03-05") !!
    assert(date_only.to_iso8601() == "2024-03-05T00:00:00Z")
    assert((time.DateTime.from_iso8601("2024-03-05t14:07:09z") !!).to_iso8601() == "2024-03-05T14:07:09Z")
    let bad = Array[String]{ "", "2024-03", "2024-03-05T", "2024-03-05 ", "2024-03-05T14", "2024-02-30T10:00Z", "2024-03-05T14:07:09+", "2024-03-05T14:07:09.Z", "2024-03-05T14:07:09+24:00", "2024-03-05T14:07:09Zx" }
    each bad as text {
        let failed = false
        time.DateTime.from_iso8601(text) ! { failed = true }
        assert(failed)
    }

    // A zoned value needs the longer buffer
    let buf = [u8 x 35]{ 0... }
    let length = parsed.to_iso8601_in(buf)
    assert(length == 32)

    let formatted = time.DateTime.from_format_in(zone_named("Europe/Amsterdam"), "Y-m-d H:i", "2024-07-01 09:15") !!
    assert(formatted.utc_offset() == 7200 && formatted.hour() == 9)
    assert((formatted.in_utc() !!).hour() == 7)
}

test "Time zones: POSIX rules" {
    let rule = time.zone_from_posix("CET-1CEST,M3.5.0,M10.5.0/3") !!
    let amsterdam = zone_named("Europe/Amsterdam")
    let t = utc_at(2030, 1, 1, 0).unix_seconds()
    let end = utc_at(2032, 1, 1, 0).unix_seconds()
    while t < end {
        assert(rule.offset_at(t) == amsterdam.offset_at(t))
        assert(rule.abbreviation_at(t) == amsterdam.abbreviation_at(t))
        t += 3 * 3600 + 17
    }
    // Southern hemisphere, quoted names, Julian days, and daylight saving all year
    let south = time.zone_from_posix("AEST-10AEDT,M10.1.0,M4.1.0/3") !!
    assert(south.offset_at(utc_at(2030, 1, 10, 0).unix_seconds()) == 39600)
    assert(south.offset_at(utc_at(2030, 7, 10, 0).unix_seconds()) == 36000)
    let quoted = time.zone_from_posix("<+0330>-3:30") !!
    assert(quoted.offset_at(0) == 12600 && quoted.abbreviation_at(0) == "+0330")
    let julian = time.zone_from_posix("EST5EDT,J60,J300") !!
    assert(julian.offset_at(utc_at(2031, 3, 1, 8).unix_seconds()) == -14400)
    assert(julian.offset_at(utc_at(2031, 2, 28, 6).unix_seconds()) == -18000)
    let always = time.zone_from_posix("EST5EDT,0/0,J365/25") !!
    assert(always.offset_at(utc_at(2031, 1, 1, 12).unix_seconds()) == -14400)
    assert(always.offset_at(utc_at(2031, 12, 31, 23).unix_seconds()) == -14400)
    // Daylight saving time without dates follows the United States rules
    let us = time.zone_from_posix("EST5EDT") !!
    assert(us.offset_at(utc_at(2031, 7, 1, 12).unix_seconds()) == -14400)
    assert(us.offset_at(utc_at(2031, 12, 1, 12).unix_seconds()) == -18000)

    let bad = Array[String]{ "", "X", "CE-1", "CET", "CET-1CEST,M13.5.0,M10.5.0", "CET-1CEST,M3.5.0", "CET-1CEST,M3.5.0,M10.5.7", "<+03-3", "CET-1CEST,M3.5.0,M10.5.0/3x" }
    each bad as text {
        let invalid = false
        time.zone_from_posix(text) ! { invalid = error_is(E.code, invalid) }
        assert(invalid)
    }
}

// A version 1 zone file: one transition from +01 to +02 at t=1000
fn tzif_v1() ByteBuffer {
    let data = ByteBuffer.new(80)
    data.write("TZif")
    let i = 0
    while i++ < 16 : data.write_byte(0)
    let counts = Array[uint]{ 0, 0, 0, 1, 2, 8 }
    each counts as count : data.write_u32_be(count.to(u32))
    data.write_u32_be(1000)
    data.write_byte(1)
    data.write_u32_be(3600)
    data.write_byte(0)
    data.write_byte(0)
    data.write_u32_be(7200)
    data.write_byte(1)
    data.write_byte(4)
    data.write("AAA\0BBB\0")
    return data
}

test "Time zones: zone files from other sources" {
    let zone = time.zone_from_tzif("Test/Zone", tzif_v1().to_string()) !!
    assert(zone.name == "Test/Zone")
    assert(zone.offset_at(999) == 3600 && zone.abbreviation_at(999) == "AAA")
    assert(zone.offset_at(1000) == 7200 && zone.abbreviation_at(5000) == "BBB" && zone.is_dst_at(5000))
    assert(zone.offset_at(-100000) == 3600)

    let truncated = tzif_v1().to_string().range(0, 50)
    let invalid = false
    time.zone_from_tzif("Bad", truncated) ! { invalid = error_is(E.code, invalid) }
    assert(invalid)
    invalid = false
    time.zone_from_tzif("Bad", "not a zone file at all, but long enough to hold a header") ! { invalid = error_is(E.code, invalid) }
    assert(invalid)
}

@shared tz_offset_seen: int (0)

fn local_zone_with_tz(value: String) String {
    core.setenv("TZ", value) ! panic("setenv failed")
    // The local zone is looked up once per thread
    let seen = thread.Thread[String].start(fn() String {
        let zone = time.local_zone()
        tz_offset_seen = zone.offset_at(0)
        return zone.name
    }) !!
    return seen.await()
}

synctest "Time zones: the local zone follows TZ" {
    let before = core.getenv("TZ") !? ""
    let had_tz = before.bytes > 0
    assert(local_zone_with_tz("Asia/Tokyo") == "Asia/Tokyo")
    assert(tz_offset_seen == 32400)
    assert(local_zone_with_tz(":America/Denver") == "America/Denver")
    assert(local_zone_with_tz("<+05>-5") == "<+05>-5")
    assert(tz_offset_seen == 18000)
    assert(local_zone_with_tz("Not a rule at all") == "UTC")
    if had_tz : core.setenv("TZ", before) ! assert(false)
    else : core.unsetenv("TZ") ! assert(false)
}

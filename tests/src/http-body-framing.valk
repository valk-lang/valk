use valk.http
use valk.net
fn http_body_handler(req: http.Request) http.Response {
    return http.Response.text("body=" + req.body)
}

fn http_body_send(request: String) String {
    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9263) ! return ""
    connection.write(request) ! return ""
    let response = [u8]{ 0 x 4096 }
    let received = connection.read(response) ! return ""
    let text = response.view(0, received).to_string()
    connection.close() ! return text
    return text
}

fn framing_handler(req: http.Request) http.Response {
    let marker = req.headers().get("x-marker") !? ""
    return http.Response.text("marker=" + marker + " body=" + req.body)
}

fn framing_server() http.Server {
    let server = http.Server.new("127.0.0.1", 9025, framing_handler)
    server.max_request_body_size = 16
    return server
}

fn framing_send(request: String) String {
    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9025) ! return ""
    connection.write(request) ! return ""
    let response = [u8]{ 0 x 4096 }
    let received = connection.read(response) ! return ""
    let text = response.view(0, received).to_string()
    connection.close() ! return text
    return text
}

test "HTTP: body lengths that wrap are rejected instead of smuggled" {
    let server = framing_server()
    let server_running = co server.start(1)
    defer stop_http_test_server(server, server_running)

    // Content-Length 2^64 wrapped to 0, which both passed the 16 byte limit and
    // left the rest of the connection to be parsed as a second request.
    let wrapped = framing_send("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 18446744073709551616\r\n\r\nGET / HTTP/1.1\r\nHost: localhost\r\nX-Marker: smuggled\r\n\r\n")
    assert(wrapped.contains(" 400 "))
    assert(!wrapped.contains("marker=smuggled"))

    let oversized = framing_send("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 99999999999999999999\r\n\r\n")
    assert(oversized.contains(" 400 "))

    // A chunk size of 16^16 wrapped to 0, which reads as "final chunk", so the
    // request behind it became the next pipelined request.
    let chunk_wrap = framing_send("POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n10000000000000000\r\nGET / HTTP/1.1\r\nHost: localhost\r\nX-Marker: smuggled\r\n\r\n")
    assert(chunk_wrap.contains(" 400 "))
    assert(!chunk_wrap.contains("marker=smuggled"))

    // hex_to_uint accepts the '0x' form for source literals, but a front-end
    // would not read "0x5" as a chunk size of five.
    let prefixed = framing_send("POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n0x5\r\nhello\r\n0\r\n\r\n")
    assert(prefixed.contains(" 400 "))

    // Legitimate framing still works, and leading zeros are not an overflow.
    let by_length = framing_send("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 00000005\r\n\r\nhello")
    assert(by_length.contains(" 200 "))
    assert(by_length.contains("body=hello"))

    let by_chunks = framing_send("POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n")
    assert(by_chunks.contains(" 200 "))
    assert(by_chunks.contains("body=hello"))

    // Two well formed requests on one connection do produce two responses, so
    // the smuggled assertions above can actually fail.
    let pipelined = framing_send("GET / HTTP/1.1\r\nHost: localhost\r\nX-Marker: first\r\n\r\nGET / HTTP/1.1\r\nHost: localhost\r\nX-Marker: second\r\n\r\n")
    assert(pipelined.contains("marker=first"))
    assert(pipelined.contains("marker=second"))

    let alive = framing_send("GET / HTTP/1.1\r\nHost: localhost\r\nX-Marker: alive\r\n\r\n")
    assert(alive.contains(" 200 "))
    assert(alive.contains("marker=alive"))
}

test "HTTP: rejects a signed length and a 0X chunk size" {
    let server = http.Server.new("127.0.0.1", 9263, http_body_handler)
    let server_running = co server.start(1)
    defer stop_http_test_server(server, server_running)

    let signed_length = http_body_send("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: +5\r\n\r\nhello")
    assert(signed_length.contains(" 400 "))
    let upper_prefix = http_body_send("POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n0X5\r\nhello\r\n0\r\n\r\n")
    assert(upper_prefix.contains(" 400 "))
    let signed_chunk = http_body_send("POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n+5\r\nhello\r\n0\r\n\r\n")
    assert(signed_chunk.contains(" 400 "))
    let plain = http_body_send("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 5\r\n\r\nhello")
    assert(plain.contains(" 200 "))

    // Field values are read after leading and trailing OWS is removed
    let trailing_space = http_body_send("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 5 \r\n\r\nhello")
    assert(trailing_space.contains(" 200 "))
    assert(trailing_space.contains("body=hello"))
    let trailing_tab = http_body_send("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 5\t\r\n\r\nhello")
    assert(trailing_tab.contains(" 200 "))
    assert(trailing_tab.contains("body=hello"))
    // ... but a value of nothing but whitespace is still not a length
    let blank_length = http_body_send("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: \t \r\n\r\nhello")
    assert(blank_length.contains(" 400 "))
}

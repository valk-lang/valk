
use valk:mem
use valk:time

struct RefTest {
    x: <@[u8 x 10]> ({1...})
}

test "References" {
    let x = RefTest{}
    let a = x.x
    assert(a[5] == 1)
    mem:free(x)
}

// `&` on an argument. The argument's Decl needs real storage before the
// prologue stores the incoming value into it, which is what broke when that
// storage was the stable stack: its block was allocated after the stores.

fn ref_arg_write(n: int) int {
    let r = &n
    @ptrv(r, int, 0) = 42
    return n
}

fn ref_arg_read(n: int) int {
    return @ptrv(&n, int, 0)
}

fn ref_arg_two(a: int, b: int) int {
    let ra = &a
    let rb = &b
    @ptrv(ra, int, 0) = 1
    @ptrv(rb, int, 0) = 2
    return a * 10 + b
}

class RefCell {
    v: int
}

// A GC argument beside plain ones: its declaration lives in the GC stack while
// `b`'s lives in the stable stack, so both kinds of storage are set up here.
fn ref_arg_mixed(a: int, c: RefCell, b: int) int {
    let rb = &b
    @ptrv(rb, int, 0) = 5
    return a + c.v + b
}

fn ref_arg_at_ref(n: int) int {
    let r = @ref(n)
    @ptrv(r, int, 0) = 7
    return n
}

test "References: to an argument" {
    assert(ref_arg_write(1) == 42)
    assert(ref_arg_read(11) == 11)
    assert(ref_arg_two(0, 0) == 12)
    assert(ref_arg_mixed(1, RefCell { v: 2 }, 0) == 8)
    assert(ref_arg_at_ref(0) == 7)
}

// The stable stack exists so a pointer taken before a suspension still refers
// to the variable after the coroutine's stack has been copied back.
fn ref_arg_coro(n: int) int {
    let r = &n
    time:sleep_ms(5)
    @ptrv(r, int, 0) = n + 1
    time:sleep_ms(5)
    return n
}

test "References: to an argument across a coroutine suspension" {
    let task = co ref_arg_coro(41)
    let res = await task
    assert(res == 42)
}


use valk:mem
use valk:time
use valk:gc

struct RefTest {
    x: [u8 x 10] ({1...})

    fn free() {
        mem:free(this)
    }
}

test "References" {
    let x: *RefTest = .{}
    let a = x.x
    assert(a[5] == 1)
    x.free()
}





fn ref_arg_write(n: int) int {
    let r = &n
    @ptrv(r, int, 0) = 42
    return n
}

fn ref_arg_read(n: int) int {
    return @ptrv(&n, int, 0)
}

fn ref_arg_two(a: int, b: int) int {
    let ra = &a
    let rb = &b
    @ptrv(ra, int, 0) = 1
    @ptrv(rb, int, 0) = 2
    return a * 10 + b
}

class RefCell {
    v: int
}

struct BorrowedPayload {
    value: int
}

class BorrowedOwner {
    payload: BorrowedPayload
}



fn ref_arg_mixed(a: int, c: RefCell, b: int) int {
    let rb = &b
    @ptrv(rb, int, 0) = 5
    return a + c.v + b
}

fn ref_arg_at_ref(n: int) int {
    let r = @ref(n)
    @ptrv(r, int, 0) = 7
    return n
}

fn accept_pointer_or_string(value: *int | String) {}

fn wrap_explicit_pointer(value: *int) [*int x 1] {
    return { value }
}

fn read_nested_reference(values: [&int x 1]) int {
    return values[0][0]
}

test "References: to an argument" {
    assert(ref_arg_write(1) == 42)
    assert(ref_arg_read(11) == 11)
    assert(ref_arg_two(0, 0) == 12)
    assert(ref_arg_mixed(1, RefCell { v: 2 }, 0) == 8)
    assert(ref_arg_at_ref(0) == 7)
    let array = Array[int]{3, 7}
    let pointer: *Array[int] = &array
    let reference: &Array[int] = &array
    assert(pointer[0][1] == 7)
    assert(reference[0][0] == 3)
    accept_pointer_or_string("value")
    let number = 1
    let number_pointer: *int = &number
    accept_pointer_or_string(number_pointer)
    let explicit_pointer: *int = &number
    assert(wrap_explicit_pointer(explicit_pointer)[0][0] == 1)
    let borrowed: &int = &number
    assert(read_nested_reference({ borrowed }) == 1)
}

test "References: managed interior borrows retain their owner" {
    let owner = BorrowedOwner { payload: { value: 42 } }
    let borrowed: &BorrowedPayload = owner.payload
    owner = BorrowedOwner { payload: { value: 7 } }
    gc:collect()
    gc:collect()
    assert(borrowed.value == 42)
}



fn ref_arg_coro(n: int) int {
    let r = &n
    time:sleep_ms(5)
    @ptrv(r, int, 0) = n + 1
    time:sleep_ms(5)
    return n
}

test "References: to an argument across a coroutine suspension" {
    let task = co ref_arg_coro(41)
    let res = await task
    assert(res == 42)
}

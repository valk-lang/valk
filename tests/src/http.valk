
use valk.http
use valk.fs
use valk.json
use valk.net

fn http_handler_data(req: http.Request) http.Response {
    let result = req.method + "|" + req.path
    result += "|" + req.params().get("p1") !? ""
    result += "|" + req.params().get("p2") !? ""
    result += "|" + req.data().get("p3") !? ""
    return http.Response.html(result)
}

fn http_handler_file(req: http.Request) http.Response {
    return http.Response.file(__DIR__ + "/../assets/valk-logo.png")
}

fn http_handler_multipart(req: http.Request) http.Response {
    let result = req.data().get("username") !? ""
    let file = req.files().get("avatar") !? null
    if isset(file) {
        result += "|" + file.filename + "|" + file.mime_type + "|" + file.to_string()
    }
    return http.Response.html(result)
}

fn http_handler_stream(req: http.Request) http.Response {
    let body = "streamed body"
    return http.Response.stream(ByteReader.new(body), body.bytes, "text/plain", "out.txt")
}

fn http_handler_headers(req: http.Request) http.Response {
    let acc = req.headers().get("accept") !? ""
    return http.Response.text(acc)
}

fn http_handler_response_headers(req: http.Request) http.Response {
    let response = http.Response.text("safe", 200, "text/plain\r\nX-Content-Type-Injected: yes")
    response.set_header("X-Good", "good")
    response.set_header("X-Bad\r\nX-Name-Injected", "bad")
    response.set_header("X-Bad-Value", "bad\r\nX-Value-Injected: yes")
    response.add_header("X-Raw-Good", "raw-good")
    response.add_header("X-Raw", "bad\r\nX-Raw-Injected: yes")
    return response
}

fn http_handler_response_filename(req: http.Request) http.Response {
    return http.Response.file(__DIR__ + "/../assets/valk-logo.png", "bad\"\r\nX-Filename-Injected: yes")
}

fn http_handler_response_filename_quote(req: http.Request) http.Response {
    return http.Response.file(__DIR__ + "/../assets/valk-logo.png", "bad\"\\name.txt")
}

fn http_handler(req: http.Request) http.Response {
    let r: http.Router[fn(http.Request)(http.Response)] = http.Router[fn(http.Request)(http.Response)].$default_value
    r.add("POST", "/test-data", http_handler_data)
    r.add("POST", "/test-multipart", http_handler_multipart)
    r.add("GET", "/test-headers", http_handler_headers)
    r.add("GET", "/test-response-headers", http_handler_response_headers)
    r.add("GET", "/test-response-filename", http_handler_response_filename)
    r.add("GET", "/test-response-filename-quote", http_handler_response_filename_quote)
    r.add("GET", "/test-file", http_handler_file)
    r.add("GET", "/test-stream", http_handler_stream)
    r.add("GET", "/ping", fn(req: http.Request) http.Response { return http.Response.text("pong") })
    r.add("GET", "/stop", http_handler_file)

    let route = r.find(req.method, req.path) ! {
        println("ROUTE NOT FOUND: '" + req.path + "'")
        return http.Response.empty(404)
    }
    return route.handler(req)
}

fn http_server() {
    let s = http.Server.new("127.0.0.1", 9000, http_handler)
    s.start(1) ! return
}

test "Http: default response" {
    let response: http.Response = http.Response.$default_value

    assert(response.status == 200)
    assert(response.body == "")
    assert(response.content_type == "text/plain")
}

test "Http: router supports more than 255 segments" {
    let router = http.Router[String].new()
    let path = ""
    let i: uint = 0
    while i++ < 260 : path += "/s" + i
    router.add("GET", path, "deep")
    let route = router.find("GET", path) ! panic("deep route was not found")
    assert(route.handler == "deep")
    let shallow = router.find("GET", "/s1/s2/s3/s4/s5") !? null
    assert(!isset(shallow))
}

test "Http: server/client" {
    co http_server()

    // Request 1
    let post_data = Map[String]{ "p3" => "v3" }
    let json = json.from(post_data)
    // println(json.encode(json, true))
    let res = http.request("POST", "http://127.0.0.1:9000/test-data?p1=v1", http.Options {
        query_data: Map[String]{ "p2" => "v2" }
        body: json.encode(json)
        headers: Map[String]{ "content-type" => "application/json" }
    }) ! {
        assert(false)
        return
    }
    assert(res.body == "POST|/test-data|v1|v2|v3")

    // A query value must not be able to add a parameter of its own. url.encode() used
    // to pass '&' and '=' through, so this went out as p2=v2 plus an attacker-added x.
    let injected = http.request("POST", "http://127.0.0.1:9000/test-data?p1=v1", http.Options {
        query_data: Map[String]{ "p2" => "v2&x=INJECTED" }
        body: json.encode(json)
        headers: Map[String]{ "content-type" => "application/json" }
    }) ! {
        assert(false)
        return
    }
    assert(injected.body == "POST|/test-data|v1|v2&x=INJECTED|v3")

    // A fragment identifies a piece of the document, not a server-side resource, so it
    // must never reach the wire. url.parse() used to leave it inside .query.
    let with_fragment = http.request("POST", "http://127.0.0.1:9000/test-data?p1=v1#never-sent", http.Options {
        body: json.encode(json)
        headers: Map[String]{ "content-type" => "application/json" }
    }) ! {
        assert(false)
        return
    }
    assert(with_fragment.body == "POST|/test-data|v1||v3")

    // Multipart Request
    let boundary = "---------------------------974767299852498929531610575"
    let body = "--" + boundary + "\r\n"
    body += "Content-Disposition: form-data; name=\"username\"\r\n\r\n"
    body += "valk_user\r\n"
    body += "--" + boundary + "\r\n"
    body += "Content-Disposition: form-data; name=\"avatar\"; filename=\"avatar.txt\"\r\n"
    body += "Content-Type: text/plain\r\n\r\n"
    body += "hello multipart\r\n"
    body += "--" + boundary + "--\r\n"

    res = http.request("POST", "http://127.0.0.1:9000/test-multipart", http.Options {
        body: body
        headers: Map[String]{ "content-type" => "multipart/form-data; boundary=" + boundary }
    }) ! {
        assert(false)
        return
    }
    assert(res.body == "valk_user|avatar.txt|text/plain|hello multipart")

    // Mixed-case duplicate header test
    res = http.request("GET", "http://127.0.0.1:9000/test-headers", http.Options {
        headers: Map[String]{ "Accept" => "text/html", "accept" => "application/json" }
    }) ! {
        assert(false)
        return
    }
    assert(res.body == "text/html, application/json")

    let safe_headers = http.request("GET", "http://127.0.0.1:9000/test-response-headers") ! {
        assert(false)
        return
    }
    assert(safe_headers.body == "safe")
    assert((safe_headers.headers.get("content-type") !? "") == "text/plain")
    assert((safe_headers.headers.get("x-good") !? "") == "good")
    assert((safe_headers.headers.get("x-raw-good") !? "") == "raw-good")
    assert(!safe_headers.headers.has("x-content-type-injected"))
    assert(!safe_headers.headers.has("x-name-injected"))
    assert(!safe_headers.headers.has("x-value-injected"))
    assert(!safe_headers.headers.has("x-raw-injected"))

    let safe_filename = http.request("GET", "http://127.0.0.1:9000/test-response-filename") ! {
        assert(false)
        return
    }
    assert(!safe_filename.headers.has("x-filename-injected"))
    assert(!safe_filename.headers.has("content-disposition"))

    let quoted_filename = http.request("GET", "http://127.0.0.1:9000/test-response-filename-quote") ! {
        assert(false)
        return
    }
    assert((quoted_filename.headers.get("content-disposition") !? "")
        == "attachment; filename=\"bad\\\"\\\\name.txt\"")

    // Request 2
    res = http.request("GET", "http://127.0.0.1:9000/test-file?p1=v1") ! {
        assert(false)
        return
    }
    assert(res.body.bytes == 15425)
    assert(res.body == (fs.read(__DIR__ + "/../assets/valk-logo.png") !? ""))

    // Download to file
    let to = fs.add(fs.exe_dir() !? "", "logo-download.png")
    if fs.exists(to) : fs.delete(to) ! assert(false)
    //
    http.download("http://127.0.0.1:9000/test-file?p1=v1", to) ! {
        assert(false)
    }
    // Check exists
    assert(fs.exists(to))
    // Check file content
    let file_content = fs.read(to) !? <{
        println("Failed reading file")
        return ""
    }
    assert(file_content == res.body)

    // Download to a path that cannot be opened
    let bad_path = fs.add(to, "missing-dir/file.png")
    let open_failed = false
    http.download("http://127.0.0.1:9000/test-file?p1=v1", bad_path) ! { open_failed = error_is(E.code, open) }
    assert(open_failed)

    // Download into a writer
    let sink = ByteBuffer.new()
    let to_writer = http.request("GET", "http://127.0.0.1:9000/test-file?p1=v1", http.Options { output: sink }) ! {
        assert(false)
        return
    }
    assert(to_writer.body == "")
    assert(sink.length == 15425)
    assert(sink.to_string() == res.body)

    // Streamed response body
    let streamed = http.request("GET", "http://127.0.0.1:9000/test-stream") ! {
        assert(false)
        return
    }
    assert(streamed.body == "streamed body")
    assert((streamed.headers.get("content-type") !? "") == "text/plain")
    assert((streamed.headers.get("content-length") !? "") == "13")
    assert((streamed.headers.get("content-disposition") !? "") == "attachment; filename=\"out.txt\"")
}

fn non_https_server() {
    let s = http.Server.new("127.0.0.1", 9001, http_handler)
    s.start(1) ! return
}

test "Https: Client" {
    let req = http.request("GET", "https://valk-lang.dev/api/versions") ! {
        assert(false)
        return
    }
    assert(req.body.length > 0)

    // Verify the OpenSSL configuration without adding more network requests.
    let ssl = net.Ssl.new()
    assert(ssl.verification_enabled_for_test())
    ssl.set_host("expected.example") ! {
        assert(false)
        return
    }
    ssl.set_verify(false)
    assert(!ssl.verification_enabled_for_test())

    // Fail SSL
    co non_https_server()

    let failed = false
    http.request("GET", "https://127.0.0.1:9001/ping") ! {
        failed = true
    }
    assert(failed)

    //
    let res = http.request("GET", "http://127.0.0.1:9001/ping") ! {
        assert(false)
        return
    }
    assert(res.body == "pong")
}

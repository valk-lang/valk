class BorrowInner {
    n: uint (3)
}

class BorrowBox {
    v: uint (7)
    inner: BorrowInner (.{})

    + fn get_v() uint {
        return this.v
    }
}

fn borrow_read(b: &BorrowBox) uint {
    return b.v
}

test "Borrow of a managed value reads the object, not the slot" {
    let box = BorrowBox{}
    let r = &box
    // Before `&` on a managed type produced the reference itself, this read
    // the address of the object as if it were the first field.
    assert(r.v == 7)
    assert(r.get_v() == 7)
    assert(r.inner.n == 3)
    assert(borrow_read(r) == 7)
}

test "Borrow of a scalar writes through to its owner" {
    let n : u64 = 5
    let r = &n
    @ptrv(r, u64) = @ptrv(r, u64) + 2
    assert(n == 7)
}

test "An owned value satisfies a borrow parameter" {
    let box = BorrowBox{}
    assert(borrow_read(box) == 7)
}

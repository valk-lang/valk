class BorrowInner {
    n: uint (3)
}

class BorrowBox {
    v: uint (7)
    inner: BorrowInner (.{})

    + fn get_v() uint {
        return this.v
    }
}

fn borrow_read(b: &BorrowBox) uint {
    return b.v
}

test "Borrow of a managed value reads the object, not the slot" {
    let box = BorrowBox{}
    let r = &box
    // Before `&` on a managed type produced the reference itself, this read
    // the address of the object as if it were the first field.
    assert(r.v == 7)
    assert(r.get_v() == 7)
    assert(r.inner.n == 3)
    assert(borrow_read(r) == 7)
}

test "Borrow of a scalar writes through to its owner" {
    let n : u64 = 5
    let r = &n
    @ptrv(r, u64) = @ptrv(r, u64) + 2
    assert(n == 7)
}

test "An owned value satisfies a borrow parameter" {
    let box = BorrowBox{}
    assert(borrow_read(box) == 7)
}

// A borrow may be returned when it points at storage the caller already owns.
// Every one of these bottoms out at an argument or a global.

fn borrow_pass_through(b: &BorrowBox) &BorrowBox {
    return b
}

fn borrow_inner_of(b: &BorrowBox) &BorrowInner {
    return b.inner
}

fn borrow_inner_via_local(b: &BorrowBox) &BorrowInner {
    let i = b.inner
    return i
}

fn borrow_inner_chained(b: &BorrowBox) &BorrowInner {
    return borrow_inner_of(b)
}

fn borrow_of_owned_arg(b: BorrowBox) &BorrowBox {
    return b
}

global borrow_global_n : u64 (9)

fn borrow_of_global() &u64 {
    return &borrow_global_n
}

test "A borrow that comes from an argument can be returned" {
    let box = BorrowBox{}
    assert(borrow_pass_through(&box).v == 7)
    assert(borrow_inner_of(&box).n == 3)
    assert(borrow_inner_via_local(&box).n == 3)
    assert(borrow_inner_chained(&box).n == 3)
    assert(borrow_of_owned_arg(box).v == 7)
}

test "A borrow of a global can be returned" {
    assert(@ptrv(borrow_of_global(), u64) == 9)
}

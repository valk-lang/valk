use valk.thread

class ViewItem { name: String ("a") }

struct ViewPair {
    n: int (0)
    item: ViewItem
    fn bump() { this.n++ }
    fn get() ViewItem { return this.item }
}
struct ViewInner { n: int (0) }
struct ViewOuter { inner: ViewInner (ViewInner {}) }

class ViewHolder {
    pair: ViewPair (ViewPair { item: ViewItem {} })
    outer: ViewOuter (ViewOuter {})
    ints: mut &[int] ([int]{ 0, 0 })
    direct: int (0)
}

class ViewState {
    pair: ViewPair (ViewPair { item: ViewItem {} })
    sl: mut &[ViewItem] ([ViewItem]{ ViewItem {}, ViewItem {} })
    other: ViewItem (ViewItem { name: "other" })
}

fn view_run_threads(work: shared fn()()) {
    let threads = Array[thread.Thread[void]]{}
    let i = 0
    while i++ < 4 : threads.append(thread.start(work) !!)
    each threads as t : t.await()
}

test "Shared views: struct fields and slice elements use atomic stores" {
    let h: shared ViewHolder = ViewHolder {}
    view_run_threads(fn() {
        let i = 0
        while i++ < 50000 {
            h.pair.n++
            h.pair.bump()
            h.outer.inner.n += 1
            h.ints[0]++
            h.ints[1] += 1
            h.direct++
        }
    })
    assert(h.pair.n == 400000)
    assert(h.outer.inner.n == 200000)
    assert(h.ints[0] == 200000)
    assert(h.ints[1] == 200000)
    assert(h.direct == 200000)
    // A copy of the struct is ordinary data
    let copy = h.outer
    copy.inner.n++
    assert(copy.inner.n == 200001 && h.outer.inner.n == 200000)
}

test "Locked views: struct methods and slice properties" {
    let st: shared Lock[ViewState] = .new(ViewState {}) !!
    let t = thread.start(fn() {
        lock st as s {
            s.pair.bump()
            s.pair.bump()
            assert(s.pair.get().name == "a")
            s.sl[0] = ViewItem { name: "fresh" }
            s.sl[1] = s.other
            assert(s.sl[0].name == "fresh" && s.sl[1].name == "other")
            s.sl = [ViewItem]{ ViewItem { name: "x" }, ViewItem { name: "y" }, ViewItem { name: "z" } }
        }
    }) !!
    t.await()
    lock st as s {
        assert(s.pair.n == 2)
        assert(s.sl.length == 3 && s.sl[0].name == "x" && s.sl[2].name == "z")
        // Stored under the lock, the new slice was published with it
        assert(s.sl[0].$is_shared)
    }
}

test "Locks: lock accepts a narrowed nullable Lock" {
    let gl: ?shared Lock[ViewState] = Lock[ViewState].new(ViewState {}) !!
    if isset(gl) {
        lock gl as s : s.pair.n++
    }
    let l = gl
    if !isset(l) : return
    lock l as s : assert(s.pair.n == 1)
}

test "Shared views: an inline aggregate carrying references becomes shared" {
    let fresh = ViewOuter { inner: ViewInner { n: 3 } }
    let shared_outer: shared ViewOuter = fresh
    assert(shared_outer.inner.n == 3)

    let shared_pair: shared (int, ViewInner) = (7, ViewInner {})
    let first, inner = shared_pair
    assert(first == 7)
    assert(inner.n == 0)

    let fresh_items: [ViewItem x 2] = { ViewItem { name: "a" }, ViewItem { name: "b" } }
    let shared_items: shared [ViewItem x 2] = fresh_items
    assert(shared_items[1].name == "b")
}

class SharedLabelsHolder {
    labels: Array[String]
}

fn shared_labels_count(items: local &[String]) uint {
    return items.length
}

test "Shared views: an array property lends itself to a local slice parameter" {
    let holder: shared SharedLabelsHolder = SharedLabelsHolder { labels: .{ "a", "b" } }
    assert(shared_labels_count(holder.labels) == 2)
}

fn shared_bytes_count(data: local &[u8]) uint {
    return data.length
}

fn shared_numbers_sum(items: local &[uint]) uint {
    let sum: uint = 0
    each items as item : sum += item
    return sum
}

class SharedBufferHolder {
    buf: ByteBuffer (ByteBuffer.new())
}

test "Shared views: shared String, Array and ByteBuffer lend themselves to local slice parameters" {
    let text: shared String = "ab" + 1
    assert(shared_bytes_count(text) == 3)
    let numbers: shared Array[uint] = .{ 2, 3, 4 }
    assert(shared_numbers_sum(numbers) == 9)
    let buf: shared ByteBuffer = ByteBuffer.new()
    assert(shared_bytes_count(buf) == 0)
    let state: shared Lock[SharedBufferHolder] = .new(SharedBufferHolder {}) !!
    lock state as holder {
        assert(shared_bytes_count(holder.buf) == 0)
        assert(holder.buf.view().length == 0)
    }
}

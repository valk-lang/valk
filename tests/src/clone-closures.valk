use valk.gc

class ClosureCloneCounter { calls: int (0) }
class ClosureCloneChild {
    number: int
    fn clone() SELF $clone {
        gc.collect()
        return SELF { number: this.number }
    }
}

fn closure_clone_source(counter: ClosureCloneCounter) fn()(int) {
    counter.calls++
    let child = ClosureCloneChild { number: counter.calls }
    if counter.calls % 2 == 0 {
        let offset: int = 100
        return fn() int { return child.number + offset }
    }
    return fn() int { return child.number }
}

fn closure_clone_optional(counter: ClosureCloneCounter, present: bool) ?fn()(int) {
    if !present {
        counter.calls++
        return null
    }
    return closure_clone_source(counter)
}

test "Clone: computed closures evaluate once with matching captures" {
    let counter = ClosureCloneCounter {}
    let i = 1
    while i <= 4 {
        let copied = closure_clone_source(counter).clone()
        gc.collect()
        assert(counter.calls == i)
        assert(copied() == (i % 2 == 0 ? i + 100 : i))
        i++
    }
    let copied = $clone(closure_clone_source(counter))
    assert(counter.calls == 5 && copied() == 5)
}

test "Clone: nullable computed closures preserve presence" {
    let counter = ClosureCloneCounter {}
    let missing = $clone(closure_clone_optional(counter, false))
    assert(counter.calls == 1 && !isset(missing))
    let copied = $clone(closure_clone_optional(counter, true))
    gc.collect()
    assert(counter.calls == 2 && isset(copied) && copied() == 102)
}

test "Clone: collecting capture hooks retain independent children" {
    let first = ClosureCloneChild { number: 7 }
    let second = ClosureCloneChild { number: 11 }
    let original = fn() int { return first.number + second.number }
    let copied = original.clone()
    first.number = 13
    second.number = 17
    gc.collect()
    assert(original() == 30)
    assert(copied() == 18)
    let copied_again = copied.clone()
    gc.collect()
    assert(copied_again() == 18)
}

use valk.http
use valk.json

fn http_json_data_handler(req: http.Request) http.Response {
    return http.Response.json_of(req.json())
}

test "HTTP JSON data: parses form data before returning the cache" {
    let server = http.Server.new("127.0.0.1", 19390, http_json_data_handler)
    let running = co server.start(1)
    defer stop_http_test_server(server, running)
    let options = http.Options { body: "email=test%40example.com&password=dummy%23%25%5E%26%2B" }
    options.set_header("Content-Type", "application/x-www-form-urlencoded")
    let response = http.request("POST", "http://127.0.0.1:19390/", options) ! panic("Form request failed")
    let data = json.decode(response.body) ! panic("Invalid JSON response")
    assert(data.is_object)
    assert((data.get_string("email") !? "") == "test@example.com")
    assert((data.get_string("password") !? "") == "dummy#%^&+")
}

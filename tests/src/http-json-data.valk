use valk.http
use valk.json

fn http_json_data_handler(req: http.Request) http.Response {
    return http.Response.json_of(req.json())
}

test "HTTP JSON data: parses form data before returning the cache" {
    let server = http.Server.new("127.0.0.1", 19390, http_json_data_handler)
    let running = co server.start(1)
    defer stop_http_test_server(server, running)
    let options = http.Options { body: "email=test%40example.com&password=dummy%23%25%5E%26%2B" }
    options.set_header("Content-Type", "application/x-www-form-urlencoded")
    let response = http.request("POST", "http://127.0.0.1:19390/", options) ! panic("Form request failed")
    let data = json.decode(response.body) ! panic("Invalid JSON response")
    assert(data.is_object)
    assert((data.get_string("email") !? "") == "test@example.com")
    assert((data.get_string("password") !? "") == "dummy#%^&+")
}

fn http_json_parse_handler(req: http.Request) http.Response {
    // json() first, so parse_json has to see past the cached empty object
    let lenient = req.json()
    let body = req.parse_json() ! return http.Response.text("invalid:" + lenient.encode(), 400)
    return http.Response.json_of(body)
}

test "HTTP JSON data: parse_json throws for a body that is not JSON" {
    let server = http.Server.new("127.0.0.1", 19391, http_json_parse_handler)
    let running = co server.start(1)
    defer stop_http_test_server(server, running)
    let url = "http://127.0.0.1:19391/"

    let good = http.post(url, "{\"a\":1}") !!
    assert(good.status == 200)
    assert(good.body == "{\"a\":1}")

    let bad = http.post(url, "{not json") !!
    assert(bad.status == 400)
    assert(bad.body == "invalid:{}")

    let empty = http.post(url, "") !!
    assert(empty.status == 400)

    let form = http.Options { body: "name=ann" }
    form.set_header("Content-Type", "application/x-www-form-urlencoded")
    let from_form = http.request("POST", url, form) !!
    assert(from_form.status == 200)
    assert(from_form.body == "{\"name\":\"ann\"}")
}

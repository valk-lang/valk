use valk.gc

class BorrowConversionStorage { values: [int x 2] ({ 7, 11 }) }
class BorrowConversionItem { count: int (13) }
class BorrowConversionSlot { value: ?BorrowConversionItem (null) }

fn borrow_nullable_slice(values: ?&mut [int x 2]) ?&mut [int] { return values }
fn borrow_nullable_named_slice(values: ?&mut [int x 2]) ?Slice[int] { return values }

fn borrow_proven_slice(values: ?&mut [int x 2]) &mut [int] {
    if !isset(values) : return Slice[int].new(0, 0)
    return values
}

fn borrow_clear_slot(value: &mut ?BorrowConversionItem) { value[0] = null }

fn borrow_copy_prefix(values: *[int x 2]) [int x 1] { return values }

test "Borrow conversions: nullable slices preserve presence and storage" {
    assert(!isset(borrow_nullable_slice(null)))
    assert(!isset(borrow_nullable_named_slice(null)))
    assert(borrow_proven_slice(null).length == 0)

    let storage = BorrowConversionStorage {}
    let slice = borrow_nullable_slice(&mut storage.values)
    let named = borrow_nullable_named_slice(&mut storage.values)
    let proven = borrow_proven_slice(&mut storage.values)
    assert(isset(slice) && slice.length == 2 && slice[0] == 7)
    assert(isset(named) && named.length == 2 && named[1] == 11)
    proven[0] = 17
    assert(storage.values[0] == 17)
    if isset(slice) : slice[1] = 19
    assert(storage.values[1] == 19)
    let prefix = borrow_copy_prefix(&storage.values)
    storage.values[0] = 23
    assert(prefix[0] == 17)
}

test "Borrow conversions: a slice retains a temporary storage owner" {
    let slice = borrow_proven_slice(&mut BorrowConversionStorage {}.values)
    gc.collect()
    gc.collect()
    assert(slice[0] == 7 && slice[1] == 11)
}

test "Borrow conversions: nullable pointees remain writable" {
    let slot = BorrowConversionSlot { value: BorrowConversionItem {} }
    borrow_clear_slot(&mut slot.value)
    assert(!isset(slot.value))
}

struct BcInlinePart { number: int (3) }
class BcInlineOwner { part: BcInlinePart (.{}) }
fn bc_read_part(p: &BcInlinePart) int { return p.number }
fn bc_get_part(o: BcInlineOwner) &BcInlinePart { return o.part }

test "Borrow conversions: an inline property converts to an owned borrow argument and return" {
    let o = BcInlineOwner {}
    assert(bc_read_part(o.part) == 3)
    assert(bc_get_part(o).number == 3)
}

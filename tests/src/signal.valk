@ignore_access

use valk.core
use valk.ext
use valk.signal
use valk.sync
use valk.time
use valk.coro

#if OS == "win"
fn test_signal() signal.Signal { return signal.Signal.terminate }
fn other_signal() signal.Signal { return signal.Signal.interrupt }
#else
fn test_signal() signal.Signal { return signal.Signal.user1 }
fn other_signal() signal.Signal { return signal.Signal.user2 }
#end

fn raise_soon(sig: signal.Signal, ms: uint) {
    time.sleep_ms(ms)
    signal.raise(sig) !!
}

test "Signal: cancels a token" {
    let token: shared sync.CancelToken = sync.CancelToken.new() !!
    signal.cancel_on(test_signal(), token) !!
    assert(!token.is_cancelled())
    signal.raise(test_signal()) !!
    assert(token.wait(3000))

    // A second token registered later is cancelled by the next signal
    let again: shared sync.CancelToken = sync.CancelToken.new() !!
    signal.cancel_on(test_signal(), again) !!
    signal.raise(test_signal()) !!
    assert(again.wait(3000))
}

test "Signal: wait and callbacks" {
    // No signal: the wait times out
    assert(!(signal.wait(other_signal(), 50) !!))

    let raiser = co raise_soon(other_signal(), 30)
    let start = time.mono_ms()
    assert(signal.wait(other_signal(), 3000) !!)
    assert(time.mono_ms() - start < 3000)
    await raiser

    // Callbacks run on the dispatcher thread; report through a channel
    let seen: shared sync.Channel[uint] = sync.Channel[uint].new() !!
    signal.on(other_signal(), fn() { seen.send(1) !! }) !!
    signal.raise(other_signal()) !!
    assert((seen.recv(3000) !!) == 1)
    signal.raise(other_signal()) !!
    assert((seen.recv(3000) !!) == 1)

    // Ignoring drops the callback; checked here, as tests run concurrently
    // and a separate test would race with the raises above
    signal.ignore(other_signal()) !!
    signal.raise(other_signal()) !!
    assert(!(signal.wait(other_signal(), 50) !!))
}

test "Signal: unsupported signals throw" {
    #if OS == "win"
    let unsupported = false
    signal.cancel_on(signal.Signal.user1, sync.CancelToken.new() !!) ! { unsupported = error_is(E.code, unsupported) }
    assert(unsupported)
    #end
}

#if OS != "win"
fn wait_hangup() bool {
    return signal.wait(signal.Signal.hangup, 5000) ! return true
}

test "Signal: a stale wake does not end a signal wait" {
    sync.leave_stale_wake_for_test() !!
    let start = time.mono_ms()
    assert(!(signal.wait(signal.Signal.quit, 50) !!))
    assert(time.mono_ms() - start >= 40)
    signal.restore(signal.Signal.quit) !!
}

test "Signal: ignore wakes pending signal waits" {
    let waiting = co wait_hangup()
    time.sleep_ms(30)
    let start = time.mono_ms()
    signal.ignore(signal.Signal.hangup) !!
    assert(!(await waiting))
    assert(time.mono_ms() - start < 2000)
    signal.restore(signal.Signal.hangup) !!
}
#end

test "Signal: raise returns when the signal is ignored" {
    #if OS == "win"
    // SIGILL (4), ignored (SIG_IGN is 1)
    let sig: i32 = 4
    #else
    // SIGWINCH (28), ignored (SIG_IGN is 1)
    let sig: i32 = 28
    #end
    @unsafe
    ext.signal(sig, 1.@cast(ptr))
    core.raise(sig)
    let reached = true
    assert(reached)
}

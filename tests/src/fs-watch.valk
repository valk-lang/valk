use valk.fs
use valk.time

test "FS: write_atomic creates, replaces, and leaves no temp files" {
    let dir = fs.create_temp_dir("valk-atomic-") !!
    defer fs.delete_all(dir) _

    let target = fs.add(dir, "config.json")
    fs.write_atomic(target, "{\"v\":1}") ! assert(false)
    assert((fs.read(target) !!) == "{\"v\":1}")

    // Overwrite atomically
    fs.write_atomic(target, "{\"v\":2,\"ok\":true}", false) ! assert(false)
    assert((fs.read(target) !!) == "{\"v\":2,\"ok\":true}")

    // Empty content
    fs.write_atomic(target, "", false) ! assert(false)
    assert((fs.read(target) !!) == "")

    // No orphan temp files left in directory
    let entries = fs.files_in(dir) !!
    assert(entries.length == 1)

    // Nonexistent directory fails cleanly
    let missing_dir = fs.add(fs.add(dir, "no-such-dir"), "file.txt")
    let failed = false
    fs.write_atomic(missing_dir, "x") ! { failed = E == .open }
    assert(failed)
}

fn wait_for_event(w: fs.Watcher, want_path: String, want_kind: fs.WatchEventKind, timeout_ms: uint) bool {
    let deadline = time.mono_ms() + timeout_ms
    while time.mono_ms() < deadline {
        let rem = deadline - time.mono_ms()
        let ev = w.next(rem) ! return false
        if !isset(ev) : return false
        if ev.path == want_path && ev.kind == want_kind : return true
    }
    return false
}

test "FS: Watcher detects create, modify, rename, remove, timeout and close" {
    let dir = fs.create_temp_dir("valk-watch-") !!
    defer fs.delete_all(dir) _

    let watcher = fs.Watcher.new() !!
    defer watcher.close() _

    // Missing path throws .open
    let open_err = false
    watcher.add(fs.add(dir, "does-not-exist")) ! { open_err = E == .open }
    assert(open_err)

    watcher.add(dir) ! assert(false)
    // Duplicate add is a no-op
    watcher.add(dir) ! assert(false)

    // No events -> timeout returns null
    let none = watcher.next(30) !!
    assert(!isset(none))

    // Create + modify + rename + remove in watched directory
    let file_a = fs.add(dir, "a.txt")
    let file_b = fs.add(dir, "b.txt")

    let writer = co fn() {
        time.sleep_ms(15)
        fs.write(file_a, "v1") ! assert(false)
    }()
    assert(wait_for_event(watcher, file_a, fs.WatchEventKind.create, 2000))
    await writer

    // Drain any follow-up modify from initial write, then do a clean modify
    while isset(watcher.next(20) !? null) {}
    let modifier = co fn() {
        time.sleep_ms(15)
        fs.write(file_a, "v2-updated") ! assert(false)
    }()
    assert(wait_for_event(watcher, file_a, fs.WatchEventKind.modify, 2000))
    await modifier

    while isset(watcher.next(20) !? null) {}
    fs.move(file_a, file_b) ! assert(false)
    assert(wait_for_event(watcher, file_b, fs.WatchEventKind.rename, 2000)
        || wait_for_event(watcher, file_a, fs.WatchEventKind.rename, 2000))

    while isset(watcher.next(20) !? null) {}
    fs.delete_file(file_b) ! assert(false)
    assert(wait_for_event(watcher, file_b, fs.WatchEventKind.remove, 2000))

    // Remove directory watch: further changes emit nothing
    watcher.remove(dir) ! assert(false)
    while isset(watcher.next(20) !? null) {}
    let file_c = fs.add(dir, "c.txt")
    fs.write(file_c, "ignored") ! assert(false)
    assert(!isset(watcher.next(40) !!))

    // Watch a single file directly
    watcher.add(file_c) ! assert(false)
    let fmod = co fn() {
        time.sleep_ms(15)
        fs.write(file_c, "changed") ! assert(false)
    }()
    assert(wait_for_event(watcher, file_c, fs.WatchEventKind.modify, 2000))
    await fmod

    // Closing wakes a blocked next() immediately and subsequent calls throw .closed
    let close_start = time.mono_ms()
    let closer = co fn() {
        time.sleep_ms(25)
        watcher.close() _
    }()
    let got_closed = false
    while true {
        let ev = watcher.next(2000) ! {
            got_closed = E == .closed
            break
        }
        if !isset(ev) : break
    }
    await closer
    assert(got_closed)
    assert(time.mono_ms() - close_start < 1500)

    let after_close = false
    watcher.add(dir) ! { after_close = E == .closed }
    assert(after_close)
}

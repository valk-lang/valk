global compound_offset_calls: uint (0)

fn compound_offset_next(i: uint) uint {
    compound_offset_calls++
    return i
}

class CompoundOffsetBox {
    items: Array[int] (.{ 1, 2, 3 })
}

fn compound_offset_box(box: CompoundOffsetBox) CompoundOffsetBox {
    compound_offset_calls++
    return box
}

fn compound_offset_words(text: String) HashMap[String, int] {
    let counts = HashMap[String, int]{}
    each text.split(" ") as word {
        counts[word] += 1 !? 0
    }
    return counts
}

fn compound_offset_deque(d: Deque[int], index: uint) !LookupError {
    d[index] += 10
}

test "Compound assignment on an Array element" {
    let a = Array[int]{ 1, 2, 3, 4 }
    a[0] -= 3
    a[1] += 5
    a[2] *= 10
    a[3] /= 2
    assert(a[0] == -2 && a[1] == 7 && a[2] == 30 && a[3] == 2)
    let flags = Array[u8]{ 1 }
    flags[0] |= 6
    flags[0] ^= 2
    assert(flags[0] == 5)
    let names = Array[String]{ "a", "b" }
    names[1] += "c"
    assert(names[1] == "bc")
}

test "Compound assignment evaluates the sequence and the index once" {
    compound_offset_calls = 0
    let box = CompoundOffsetBox {}
    compound_offset_box(box).items[compound_offset_next(2)] += 100
    assert(box.items[2] == 103)
    assert(compound_offset_calls == 2)
}

test "Compound assignment through '$offset' hooks" {
    let bytes = ByteBuffer.new(4)
    bytes.write_byte(1)
    bytes[0] += 6
    assert(bytes[0] == 7)

    let m = HashMap[String, int]{ "k" => 1 }
    m["k"] += 5 !! 
    assert((m["k"] !!) == 6)
    let counts = compound_offset_words("a b a c a")
    assert((counts["a"] !!) == 3 && (counts["c"] !!) == 1)

    let d = Deque[int]{}
    d.push_back(1)
    d[0] += 5 !!
    assert((d[0] !!) == 6)
    compound_offset_deque(d, 0) !!
    assert((d[0] !!) == 16)
    let missing = false
    compound_offset_deque(d, 5) ! { missing = true }
    assert(missing)

    let f = FlatMap[String, u8]{ "x" => 1 }
    f["x"] ^= 3 !!
    assert((f["x"] !!) == 2)
}

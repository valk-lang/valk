@ignore_access
// Closing a descriptor through the socket helpers reports failure only when the
// descriptor itself could not be closed.
#if OS != "win"
use valk.net
use valk.ext

test "net: closing a descriptor that cannot be shut down still reports success" {
    @unsafe
    let pipe: [i32 x 2] = { -1... }
    assert(ext.pipe(@ref(pipe)) == 0)
    // A pipe cannot be shut down, but the close that follows releases it either way,
    // so the helper must not claim the close failed
    net.close_fd(pipe[0]) ! assert(false)
    assert(ext.fcntl(pipe[0], ext.F_GETFD, 0) < 0)
    assert(ext.close(pipe[1]) == 0)
}
#end

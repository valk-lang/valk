use valk.url

test "url: resolve follows RFC 3986 section 5.4" {
    let base = url.parse("http://a/b/c/d;p?q")
    let cases = Array[String]{
        "g:h", "g:h", "g", "http://a/b/c/g", "./g", "http://a/b/c/g", "g/", "http://a/b/c/g/",
        "/g", "http://a/g", "//g", "http://g", "?y", "http://a/b/c/d;p?y", "g?y", "http://a/b/c/g?y",
        "#s", "http://a/b/c/d;p?q#s", "g#s", "http://a/b/c/g#s", "g?y#s", "http://a/b/c/g?y#s",
        ";x", "http://a/b/c/;x", "g;x", "http://a/b/c/g;x", "g;x?y#s", "http://a/b/c/g;x?y#s",
        "", "http://a/b/c/d;p?q", ".", "http://a/b/c/", "./", "http://a/b/c/", "..", "http://a/b/",
        "../", "http://a/b/", "../g", "http://a/b/g", "../..", "http://a/", "../../", "http://a/",
        "../../g", "http://a/g", "../../../g", "http://a/g", "../../../../g", "http://a/g",
        "/./g", "http://a/g", "/../g", "http://a/g", "g.", "http://a/b/c/g.", ".g", "http://a/b/c/.g",
        "g..", "http://a/b/c/g..", "..g", "http://a/b/c/..g", "./../g", "http://a/b/g",
        "./g/.", "http://a/b/c/g/", "g/./h", "http://a/b/c/g/h", "g/../h", "http://a/b/c/h",
        "g;x=1/./y", "http://a/b/c/g;x=1/y", "g;x=1/../y", "http://a/b/c/y",
        "g?y/./x", "http://a/b/c/g?y/./x", "g?y/../x", "http://a/b/c/g?y/../x",
        "g#s/./x", "http://a/b/c/g#s/./x", "g#s/../x", "http://a/b/c/g#s/../x", "http:g", "http:g"
    }
    let failures = Array[String]{}
    let i: uint = 0
    while i < cases.length {
        let reference = cases.get(i) !? ""
        let want = cases.get(i + 1) !? ""
        let got = base.resolve(reference).to_string()
        if got != want : failures.append(reference + " -> " + got)
        i += 2
    }
    assert(failures.length == 0)

    let page = url.parse("https://example.com/docs/guide/intro.html")
    assert(page.resolve("../img/logo.png").to_string() == "https://example.com/docs/img/logo.png")
    assert(url.parse("https://example.com").resolve("a").to_string() == "https://example.com/a")
}

test "url: Url.to_string and remove_dot_segments" {
    assert(url.parse("https://u:p@h:8080/x?y#z").to_string() == "https://u:p@h:8080/x?y#z")
    assert(url.parse("file:///etc/hosts").to_string() == "file:///etc/hosts")
    assert(url.parse("mailto:a@b.c").to_string() == "mailto:a@b.c")
    assert(url.parse("/relative?x").to_string() == "/relative?x")
    let u = url.parse("https://example.com/a")
    u.path = "b"
    u.query = "q=1"
    assert("%{u}" == "https://example.com/b?q=1")
    assert(url.remove_dot_segments("/a/b/../c/./d") == "/a/c/d")
    assert(url.remove_dot_segments("/../a") == "/a")
    assert(url.remove_dot_segments("/a/b/..") == "/a/")
}

test "url: parse_query and build_query" {
    let q = url.parse_query("a=1&b=x%20y&c=a+b&flag&&a=2")
    assert(q.get("a") !! == "2")
    assert(q.get("b") !! == "x y")
    assert(q.get("c") !! == "a b")
    assert(q.get("flag") !! == "")
    assert(q.length == 4)

    let grouped = url.parse_query_grouped("tag=a&tag=b&x")
    assert((grouped.get("tag") !!).join(",") == "a,b")
    assert(url.build_query_grouped(grouped) == "tag=a&tag=b&x=")

    let params = Map[String]{ "page" => "2", "q" => "a b&c=d" }
    let built = url.build_query(params)
    assert(built == "page=2&q=a%20b%26c%3Dd")
    assert(url.parse_query(built).get("q") !! == "a b&c=d")
    assert(url.build_query(Map[String]{}) == "")
}

use valk.gc

union NuOutcome {
    ok(int)
    err(int)
    empty
}

union NuMaybe[T] {
    some(T)
    none

    fn unwrap_or(fallback: T) T {
        return match this : T {
            .some(v) => v
            .none => fallback
        }
    }
}

union NuRes[T, E] {
    ok(T)
    err(E)

    get is_ok: bool {
        return match this : bool {
            .ok(_) => true
            .err(_) => false
        }
    }
}

struct NuSize {
    w: int
    h: int
}

union NuEvent {
    quit
    idle
    click(int, int)
    key(String)
    resize(NuSize)
    patch(?String)
}

union NuTree[T] {
    leaf(T)
    branch(Array[NuTree[T]])

    fn sum() int {
        return match this : int {
            .leaf(v) => v.to(int)
            .branch(children) => <{
                let total = 0
                each children as child : total += child.sum()
                return total
            }
        }
    }
}

struct NuPoint {
    x: int
    y: int
}

struct NuLine {
    start: NuPoint
    end: NuPoint
}

class NuUser {
    name: String
    age: int
}

interface NuShape {
    fn tag() String;
}

class NuCircle is NuShape {
    r: int

    fn tag() String {
        return "circle"
    }
}

class NuRect is NuShape {
    w: int
    h: int

    fn tag() String {
        return "rect"
    }
}

union NuPayload: NuPoint | (int, String) | int {}

fn nu_make_outcome(good: bool) NuOutcome {
    if good : return .ok(42)
    return .err(42)
}

fn nu_describe_event(e: NuEvent) String {
    return match e : String {
        .quit, .idle => "stop"
        .click(0, 0) => "origin"
        .click(0, y) => "y=" + y
        .click(x, y) if x == y => "diag=" + x
        .click(x, y) => "xy=" + x + "," + y
        .key("Enter") => "enter"
        .key(k) => "key:" + k
        .resize(NuSize { w: 0, h }) => "zero-w:" + h
        .resize(.{ w, h }) => "size:" + w + "x" + h
        .patch(null) => "clear"
        .patch(s) => "set:" + (s ?? "")
    }
}

test "Named tagged unions: duplicate payload types, equality, clone, and shorthand" {
    let a = NuOutcome.ok(42)
    let b = NuOutcome.err(42)
    let c = nu_make_outcome(true)
    let d = NuOutcome.empty

    assert(a == c)
    assert(a != b)
    assert(a != d)
    assert(b != d)
    assert(d == NuOutcome.empty)

    let cloned_a = clone a
    let cloned_d = clone d
    assert(cloned_a == a)
    assert(cloned_d == d)

    let score = match a : int {
        NuOutcome.ok(v) => v
        NuOutcome.err(v) => -v
        NuOutcome.empty => 0
    }
    assert(score == 42)

    let err_score = match b : int {
        .ok(v) => v
        .err(v) => -v
        .empty => 0
    }
    assert(err_score == -42)
}

test "Named tagged unions: generic unions, nested inference, recursive trees, and GC" {
    let m1: NuMaybe[int] = .some(99)
    let m2: NuMaybe[int] = .none
    assert(m1.unwrap_or(0) == 99)
    assert(m2.unwrap_or(7) == 7)

    let r1: NuRes[NuMaybe[int], String] = .ok(.some(10))
    let r2: NuRes[NuMaybe[int], String] = .ok(.none)
    let r3: NuRes[NuMaybe[int], String] = .err("bad")
    assert(r1.is_ok)
    assert(r2.is_ok)
    assert(!r3.is_ok)

    let classify = fn(r: NuRes[NuMaybe[int], String]) String {
        return match r : String {
            .ok(.some(0)) => "zero"
            .ok(.some(n)) => "n=" + n
            .ok(.none) => "none"
            .err(msg) => "err:" + msg
            default => ""
        }
    }
    assert(classify(r1) == "n=10")
    assert(classify(r2) == "none")
    assert(classify(r3) == "err:bad")
    assert(classify(.ok(.some(0))) == "zero")

    // Recursive tree with GC collection
    let leaves = Array[NuTree[int]]{ .leaf(1), .leaf(2), .leaf(3) }
    let sub = Array[NuTree[int]]{ .branch(leaves), .leaf(4) }
    let tree: NuTree[int] = .branch(sub)
    gc.collect()
    assert(tree.sum() == 10)
}

test "Named tagged unions: multi-payload, struct payload, nullable payload, and nullable union" {
    assert(nu_describe_event(.quit) == "stop")
    assert(nu_describe_event(.idle) == "stop")
    assert(nu_describe_event(.click(0, 0)) == "origin")
    assert(nu_describe_event(.click(0, 9)) == "y=9")
    assert(nu_describe_event(.click(5, 5)) == "diag=5")
    assert(nu_describe_event(.click(3, 8)) == "xy=3,8")
    assert(nu_describe_event(.key("Enter")) == "enter")
    assert(nu_describe_event(.key("a")) == "key:a")
    assert(nu_describe_event(.resize(NuSize { w: 0, h: 10 })) == "zero-w:10")
    assert(nu_describe_event(.resize(NuSize { w: 800, h: 600 })) == "size:800x600")
    assert(nu_describe_event(.patch(null)) == "clear")
    assert(nu_describe_event(.patch("abc")) == "set:abc")

    // Nullable named union
    let make_opt = fn(present: bool) ?NuEvent {
        if present : return NuEvent.click(2, 3)
        return null
    }
    let maybe_ev = make_opt(false)
    let r_null = match maybe_ev : String {
        null => "missing"
        .quit => "quit"
        default => "other"
    }
    assert(r_null == "missing")

    let some_ev = make_opt(true)
    let r_click = match some_ev : int {
        null => -1
        .click(x, y) => x * 10 + y
        default => 0
    }
    assert(r_click == 23)
}

test "Match destructuring: tuples, structs, classes, type-unions, and interfaces" {
    // Direct tuple destructuring (irrefutable final arm, no default needed)
    let eval_pair = fn(p: (int, String)) String {
        return match p : String {
            (0, _) => "zero"
            (n, "special") => "special:" + n
            (n, s) if n < 0 => "neg:" + s
            (n, s) => s + "=" + n
        }
    }
    assert(eval_pair((0, "anything")) == "zero")
    assert(eval_pair((7, "special")) == "special:7")
    assert(eval_pair((-2, "low")) == "neg:low")
    assert(eval_pair((4, "ok")) == "ok=4")

    // Nested tuple destructuring
    let nested = ((1, 2), "tag")
    let nres = match nested : int {
        ((a, b), _) => a + b
    }
    assert(nres == 3)

    // Direct struct destructuring (named, shorthand, partial, nested, irrefutable)
    let eval_pt = fn(p: NuPoint) String {
        return match p : String {
            NuPoint { x: 0, y: 0 } => "origin"
            NuPoint { x: 0, y } => "y:" + y
            .{ x: px, y: 0 } => "x:" + px
            .{ x, y } if x == y => "diag:" + x
            .{ x, .. } => "other:" + x
        }
    }
    assert(eval_pt(NuPoint { x: 0, y: 0 }) == "origin")
    assert(eval_pt(NuPoint { x: 0, y: 5 }) == "y:5")
    assert(eval_pt(NuPoint { x: 9, y: 0 }) == "x:9")
    assert(eval_pt(NuPoint { x: 4, y: 4 }) == "diag:4")
    assert(eval_pt(NuPoint { x: 2, y: 8 }) == "other:2")

    // Nested struct destructuring
    let line = NuLine { start: NuPoint { x: 1, y: 2 }, end: NuPoint { x: 4, y: 6 } }
    let dx = match line : int {
        NuLine { start: .{ x: x1, y: _ }, end: .{ x: x2, .. } } => x2 - x1
    }
    assert(dx == 3)

    // Class destructuring (including nullable class)
    let u: ?NuUser = NuUser { name: "Ada", age: 36 }
    let udesc = match u : String {
        null => "none"
        NuUser { name: "Ada", age } => "ada:" + age
        NuUser { name, .. } => name
    }
    assert(udesc == "ada:36")

    // Type-based union with struct and tuple destructuring
    let eval_u = fn(v: NuPayload) String {
        return match v : String {
            NuPoint { x: 0, y } => "pt0:" + y
            NuPoint as { x, y } => "pt:" + x + "," + y
            (int, String) as(n, s) => s + ":" + n
            int as n => "int:" + n
        }
    }
    assert(eval_u(NuPoint { x: 0, y: 5 }) == "pt0:5")
    assert(eval_u(NuPoint { x: 2, y: 3 }) == "pt:2,3")
    assert(eval_u((8, "hi")) == "hi:8")
    assert(eval_u(99) == "int:99")

    // Interface match with class destructuring
    let area = fn(s: NuShape) int {
        return match s : int {
            NuCircle { r } => r * r * 3
            NuRect { w, h } => w * h
            default => 0
        }
    }
    assert(area(NuCircle { r: 4 }) == 48)
    assert(area(NuRect { w: 5, h: 6 }) == 30)
}

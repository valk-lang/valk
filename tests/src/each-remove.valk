use valk.json

// Removing entries while `each` walks a map is safe: every entry that stays is visited once

fn each_remove_evens(n: int) (int, int, String) {
    let m = HashMap[int, int]{}
    each 0 .. n as i : m.set(i, i * 10)
    let visited = 0
    let bad_index = ""
    each m as v, k, i {
        if i.to(int) != visited : bad_index = "index %i at visit %visited"
        visited++
        if k % 2 == 0 : m.remove(k)
    }
    return (visited, m.length.to(int), bad_index)
}

test "Each remove: every entry of a map is visited while entries are removed" {
    // Small maps scan their keys, larger ones keep a bucket table
    each Array[int]{ 6, 20, 1000 } as n {
        let visited, left, bad_index = each_remove_evens(n)
        assert(visited == n)
        assert(left == n / 2)
        assert(bad_index == "")
    }
}

test "Each remove: an entry removed before it is reached is skipped, the index has no gap" {
    let m = HashMap[String, int]{ "a" => 1, "b" => 2, "c" => 3, "d" => 4 }
    let seen = ""
    each m as v, k, i {
        seen += "%k%i "
        if k == "a" : m.remove("c")
    }
    assert(seen == "a0 b1 d2 ")
    assert(m.keys() == .{ "a", "b", "d" })
    // The holes are closed once the loop is done
    m.set("e", 5)
    assert(m.length == 4)
    assert((m.get("e") !? 0) == 5)
    assert(!m.has("c"))
}

test "Each remove: entries added in the loop come at the end" {
    let m = HashMap[String, int]{ "a" => 1 }
    let seen = ""
    each m as v, k {
        seen += k
        if k == "a" {
            m.remove("a")
            m.set("b", 2)
        }
    }
    assert(seen == "ab")
    assert(m.keys() == .{ "b" })
}

fn each_remove_then_return(m: HashMap[int, int]) int {
    each m as v, k {
        m.remove(k)
        if k == 2 : return k
    }
    return -1
}

fn each_remove_then_throw(m: HashMap[int, int]) !LookupError {
    each m as v, k {
        m.remove(k)
        if k == 4 : throw .missing
    }
}

test "Each remove: leaving the loop early closes the holes" {
    let m = HashMap[int, int]{}
    each 0 .. 12 as i : m.set(i, i)

    each m as v, k {
        m.remove(k)
        if k == 0 : break
    }
    assert(m.length == 11)
    assert((m.keys().get(0) !? -1) == 1)

    assert(each_remove_then_return(m) == 2)
    assert(m.length == 9)
    each_remove_then_throw(m) _
    assert(m.length == 7)
    // After closing, removal outside a loop still works
    m.remove(11)
    assert(m.length == 6)
    let count = 0
    each m as v : count++
    assert(count == 6)
}

test "Each remove: nested loops close the holes when the outer one ends" {
    let m = HashMap[int, int]{ 1 => 1, 2 => 2, 3 => 3 }
    let outer = 0
    each m as v, k {
        outer++
        each m as v2, k2 {
            if k2 == 3 : m.remove(3)
        }
        // The inner loop ended, the outer still runs: the hole stays until it ends
        assert(!m.has(3))
    }
    assert(outer == 2)
    assert(m.keys() == .{ 1, 2 })
}

test "Each remove: sets, flat maps and JSON objects" {
    let s = HashSet[int]{}
    each 0 .. 20 as i : s.add(i)
    let visits = 0
    each s as v, i {
        assert(i.to(int) == visits)
        visits++
        if v % 3 == 0 : s.remove(v)
    }
    assert(visits == 20)
    assert(s.length == 13)

    let f = FlatMap[String, int]{ "a" => 1, "b" => 2, "c" => 3, "d" => 4 }
    let seen = ""
    each f as v, k, i {
        seen += "%k%i "
        if k == "a" : f.remove("b")
        if k == "c" : f.remove("c")
    }
    assert(seen == "a0 c1 d2 ")
    assert(f.keys() == .{ "a", "d" })

    let doc = json.decode("{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10}") !!
    let keys = ""
    each doc as v, k {
        keys += k.string
        if v.int % 2 == 0 : doc.remove(k.string)
    }
    assert(keys == "abcdefghij")
    assert(doc.encode() == "{\"a\":1,\"c\":3,\"e\":5,\"g\":7,\"i\":9}")
}

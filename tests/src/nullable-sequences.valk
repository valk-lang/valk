use valk.gc

fn nullable_pointer_update(values: ?*[int x 2]) int {
    if !isset(values) : return 0
    values[0] = 7
    let part = values[0 .. 2]
    return part[0] + values[1]
}

fn nullable_borrow_update(values: ?mut &[int x 2]) int {
    if !isset(values) : return 0
    values[0] = 11
    let part = values[0 .. 2]
    return part[0] + values[1]
}

fn nullable_slice_update(values: ?mut &[int]) int {
    if !isset(values) : return 0
    values[0] = 13
    let part = values[0 .. 2]
    return part[0] + values[1]
}

fn nullable_array_update(values: ?Array[int]) int {
    if !isset(values) : return 0
    values[0] = 17
    return values[0] + values[1]
}

fn nullable_element_borrow(values: ?Array[int]) ?&int {
    if !isset(values) : return null
    return &values[0]
}

fn nullable_range_borrow(values: ?Array[int]) ?&[int] {
    if !isset(values) : return null
    return &values[1 .. 2]
}

class NullableSequenceStorage { values: [int x 2] ({ 1, 2 }) }

test "Nullable sequences: proven pointers and borrows support indexing" {
    let local: [int x 2] = { 1, 2 }
    assert(nullable_pointer_update(&local) == 9)
    assert(local[0] == 7)
    assert(nullable_pointer_update(null) == 0)

    let storage = NullableSequenceStorage {}
    assert(nullable_borrow_update(&storage.values) == 13)
    assert(storage.values[0] == 11)
    assert(nullable_borrow_update(null) == 0)
}

test "Nullable sequences: proven slices and arrays support indexing" {
    let values = Array[int]{ 1, 2 }
    assert(nullable_slice_update(values.view()) == 15)
    assert(values[0] == 13)
    assert(nullable_slice_update(null) == 0)
    assert(nullable_array_update(values) == 19)
    assert(values[0] == 17)
    assert(nullable_array_update(null) == 0)

    let text: ?String = "abc"
    assert(isset(text) && text[1] == 'b')
    if isset(text) : assert(text[1 .. 2] == "bc")
}

test "Nullable sequences: element borrows retain their owner" {
    let element = nullable_element_borrow(Array[int]{ 23 })
    let range = nullable_range_borrow(Array[int]{ 29, 31, 37 })
    gc.collect()
    gc.collect()
    assert(isset(element) && element[0] == 23)
    assert(isset(range) && range[0] == 31 && range[1] == 37)
    assert(!isset(nullable_element_borrow(null)))
    assert(!isset(nullable_range_borrow(null)))
}

@unsafe

@ignore_access

test "Clone: @ignore_access permits structural cloning" {
    let original = CloneIgnoredAccess { value: 81 }
    let copied = $clone(original)
    assert(copied != original && copied.value == 81)
}


test "Clone: @ignore_access capability reaches container elements" {
    let original = Array[CloneIgnoredAccess]{ CloneIgnoredAccess { value: 82 } }
    let copied = $clone(original)
    assert((copied.get(0) !!).value == 82)
}

use valk.ansi
use valk.core

test "Ansi: dim lowers the intensity and gives back only that" {
    let esc = 27.to(u8).to_ascii_string()
    assert("note".ansi.dim() == esc + "[2mnote" + esc + "[22m")

    // A color around dimmed text stays on for what follows it
    let line = ("before " + "aside".ansi.dim() + " after").ansi.red()
    assert(line == esc + "[0;31mbefore " + esc + "[2maside" + esc + "[22m after" + esc + "[0m")

    assert("".ansi.dim() == esc + "[2m" + esc + "[22m")
}

fn ansi_test_env(name: String, value: ?String) {
    if isset(value) : core.setenv(name, value) ! panic("setenv failed")
    else : core.unsetenv(name) ! panic("unsetenv failed")
}

test "Ansi: colors need a terminal unless forced, and never with NO_COLOR" {
    let names = Array[String]{ "NO_COLOR", "FORCE_COLOR", "CLICOLOR_FORCE", "TERM" }
    let before = Array[?String]{}
    each names as name : before.append(core.getenv(name) !? null)

    ansi_test_env("NO_COLOR", null)
    ansi_test_env("FORCE_COLOR", null)
    ansi_test_env("CLICOLOR_FORCE", null)
    ansi_test_env("TERM", "xterm-256color")
    assert(ansi.detect_for_test(true))
    // A pipe or a file
    assert(!ansi.detect_for_test(false))
    ansi_test_env("TERM", "dumb")
    assert(!ansi.detect_for_test(true))

    ansi_test_env("FORCE_COLOR", "1")
    assert(ansi.detect_for_test(false))
    ansi_test_env("FORCE_COLOR", "0")
    assert(!ansi.detect_for_test(false))
    ansi_test_env("CLICOLOR_FORCE", "1")
    assert(ansi.detect_for_test(false))
    ansi_test_env("NO_COLOR", "1")
    assert(!ansi.detect_for_test(false))
    assert(!ansi.detect_for_test(true))

    each names as name, i : ansi_test_env(name, before.get(i) !? null)
}

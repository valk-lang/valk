
struct StackSlotQuad {
    a: uint
    b: uint
    c: uint
    d: uint
}

fn stack_slot_sum(q: StackSlotQuad) uint $noinline {
    return q.a + q.b + q.c + q.d
}

test "Struct literals in a loop reuse one stack slot" {
    // A slot per iteration would need 32 MB of stack
    let total: uint = 0
    let i: uint = 0
    while i < 1_000_000 {
        total += stack_slot_sum(StackSlotQuad { a: i, b: 1, c: 2, d: 3 })
        i++
    }
    assert(total == 499_999_500_000 + 6_000_000)
}

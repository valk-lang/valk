use valk.http
use valk.net
use valk.mem

fn fix_parsing_uint_fails(value: String) bool {
    value.to_uint() ! return true
    return false
}
fn fix_parsing_int_fails(value: String) bool {
    value.to_int() ! return true
    return false
}
fn fix_parsing_hex_uint_fails(value: String) bool {
    value.hex_to_uint() ! return true
    return false
}
fn fix_parsing_hex_int_fails(value: String) bool {
    value.hex_to_int() ! return true
    return false
}
fn fix_parsing_octal_uint_fails(value: String) bool {
    value.octal_to_uint() ! return true
    return false
}
fn fix_parsing_octal_int_fails(value: String) bool {
    value.octal_to_int() ! return true
    return false
}
fn fix_parsing_float_fails(value: String) bool {
    value.to_float() ! return true
    return false
}
fn fix_parsing_slice_float_fails(value: String) bool {
    value.view(0, value.bytes).to_float() ! return true
    return false
}
fn fix_parsing_ptr_float_fails(value: String) bool {
    @unsafe
    let data: ptr = value.data
    data.read_float(value.bytes) ! return true
    return false
}
fn fix_parsing_ptr_int_fails(value: String) bool {
    @unsafe
    let data: ptr = value.data
    data.read_int(value.bytes) ! return true
    return false
}
fn fix_parsing_ptr_octal_int_fails(value: String) bool {
    @unsafe
    let data: ptr = value.data
    data.read_octal_int(value.bytes) ! return true
    return false
}
fn fix_parsing_ptr_octal_uint_fails(value: String) bool {
    @unsafe
    let data: ptr = value.data
    data.read_octal_uint(value.bytes) ! return true
    return false
}
fn fix_parsing_ptr_hex_int_fails(value: String) bool {
    @unsafe
    let data: ptr = value.data
    data.read_hex_int(value.bytes) ! return true
    return false
}
fn fix_parsing_ptr_hex_uint(value: String) uint {
    @unsafe
    let data: ptr = value.data
    return data.read_hex_uint(value.bytes) !? 999
}

test "Fix parsing: cstring length, index_of and to_string are linear" {
    let buf = ByteBuffer.new()
    let i = 0
    while i++ < 200000 : buf.write_byte('a')
    buf.write_byte('b')
    let text = buf.to_string()
    let c = text.data_cstring
    assert(c.length() == 200001)
    assert((c.index_of('b') !? 0) == 200000)
    assert((c.index_of('z') !? 7) == 7)
    assert(c.to_string().bytes == 200001)
    assert("".data_cstring.length() == 0)
}

test "Fix parsing: String.unescape keeps a trailing lone backslash" {
    let text = "ab\\".unescape()
    assert(text.bytes == 3)
    assert(text == "ab\\")
    assert("\\".unescape() == "\\")
    assert("a\\nb\\\\".unescape() == "a\nb\\")
}

test "Fix parsing: u8.unescape maps the escape letters" {
    assert('f'.to(u8).unescape() == '\f')
    assert('a'.to(u8).unescape() == '\a')
    assert('v'.to(u8).unescape() == '\v')
    assert('q'.to(u8).unescape() == 'q')
}

test "Fix parsing: hex and octal parsers need digits" {
    assert(fix_parsing_hex_uint_fails(""))
    assert(fix_parsing_hex_uint_fails("0x"))
    assert(fix_parsing_octal_uint_fails(""))
    assert(fix_parsing_octal_uint_fails("0c"))
    assert(fix_parsing_hex_int_fails("0x"))
    assert(fix_parsing_hex_int_fails("-0x"))
    assert(fix_parsing_octal_int_fails("0c"))
    assert(fix_parsing_octal_int_fails("-0c"))
    assert(("0xff".hex_to_uint() !? 0) == 255)
    assert(("0c17".octal_to_uint() !? 0) == 15)
    assert(("0".hex_to_uint() !? 9) == 0)
    assert(("0".octal_to_int() !? 9) == 0)
}

test "Fix parsing: floats need mantissa digits" {
    assert(fix_parsing_float_fails("."))
    assert(fix_parsing_float_fails("e5"))
    assert(fix_parsing_float_fails("-."))
    assert(fix_parsing_float_fails("-e5"))
    assert(fix_parsing_slice_float_fails("."))
    assert(fix_parsing_slice_float_fails("e5"))
    assert(fix_parsing_ptr_float_fails("."))
    assert(fix_parsing_ptr_float_fails("-."))
    assert(fix_parsing_ptr_float_fails("1e400"))
    assert((".5".to_float() !? 0.0) == 0.5)
    assert(("5.".to_float() !? 0.0) == 5.0)
    assert(("-2.5e1".to_float() !? 0.0) == -25.0)
}

test "Fix parsing: String.is_number needs a digit" {
    assert(!".".is_number())
    assert(!"".is_number())
    assert(!"1.2.3".is_number())
    assert("1.5".is_number())
    assert(".5".is_number())
    assert("5.".is_number())
}

test "Fix parsing: every parser takes exactly one optional sign" {
    assert(("+7".to_uint() !? 0) == 7)
    assert(("+7".view(0, 2).to_uint() !? 0) == 7)
    assert(("+7".to_int() !? 0) == 7)
    assert(("+1.5".to_float() !? 0.0) == 1.5)
    assert(("+1.5".view(0, 4).to_float() !? 0.0) == 1.5)
    assert(("+ff".hex_to_int() !? 0) == 255)
    assert(("+0xff".hex_to_uint() !? 0) == 255)
    assert(("+17".octal_to_int() !? 0) == 15)
    assert(("+0c17".octal_to_uint() !? 0) == 15)
    assert(fix_parsing_uint_fails("++7"))
    assert(fix_parsing_uint_fails("-7"))
    assert(fix_parsing_int_fails("-+5"))
    assert(fix_parsing_int_fails("++5"))
    assert(fix_parsing_int_fails("+-5"))
    assert(fix_parsing_float_fails("+-1"))
    assert(fix_parsing_float_fails("--1"))
    assert(fix_parsing_hex_int_fails("-+5"))
    assert(fix_parsing_hex_uint_fails("-5"))
    assert(fix_parsing_hex_uint_fails("++5"))
    assert(fix_parsing_octal_int_fails("+-5"))
    assert(fix_parsing_octal_uint_fails("-5"))
    assert(fix_parsing_ptr_int_fails("-+5"))
    assert(fix_parsing_ptr_int_fails("++5"))
    let reader = "+12 +0x1f +0c7 +2.5".reader()
    assert(reader.read_uint() == 12)
    reader.skip(1)
    assert(reader.read_hex_int() == 31)
    reader.skip(1)
    assert(reader.read_octal_uint() == 7)
    reader.skip(1)
    assert(reader.read_float() == 2.5)
    assert(reader.remaining().length == 0)
}

test "Fix parsing: octal readers check range and empty input" {
    assert(fix_parsing_ptr_octal_uint_fails(""))
    assert(fix_parsing_ptr_octal_int_fails(""))
    assert(fix_parsing_ptr_octal_int_fails("-"))
    assert(fix_parsing_ptr_octal_uint_fails("2000000000000000000000"))
    assert(fix_parsing_ptr_octal_int_fails("1000000000000000000000"))
    assert(!fix_parsing_ptr_octal_uint_fails("1777777777777777777777"))
    assert(!fix_parsing_ptr_octal_int_fails("-1000000000000000000000"))
}

test "Fix parsing: hex readers check the int range and accept 0X" {
    assert(fix_parsing_ptr_hex_int_fails("FFFFFFFFFFFFFFFF"))
    assert(fix_parsing_ptr_hex_int_fails("8000000000000000"))
    assert(fix_parsing_ptr_hex_int_fails(""))
    assert(fix_parsing_ptr_hex_int_fails("-"))
    assert(!fix_parsing_ptr_hex_int_fails("-8000000000000000"))
    assert(fix_parsing_ptr_hex_uint("0XfF") == 255)
    assert(fix_parsing_ptr_hex_uint("0xff") == 255)
    assert(("0XFF".hex_to_uint() !? 0) == 255)
    let reader = "0XAb".reader()
    assert(reader.read_hex_uint() == 171)
    assert(reader.remaining().length == 0)
    let signed = "-0X10".reader()
    assert(signed.read_hex_int() == -16)
}

test "Fix parsing: ptr.read_cstring returns the scanned bytes without a terminator" {
    @unsafe
    let text = "abcdef"
    let data: ptr = text.data
    assert(data.read_cstring(3) == "abc")
    assert(data.read_cstring(100) == "abcdef")
}

test "Fix parsing: ByteReader.read_float leaves an exponent without digits" {
    let reader = "2em".reader()
    assert(reader.read_float() == 2.0)
    assert(reader.get_pos() == 1)
    let signed = "3e+x".reader()
    assert(signed.read_float() == 3.0)
    assert(signed.get_pos() == 1)
    let full = "1e2x".reader()
    assert(full.read_float() == 100.0)
    assert(full.get_pos() == 3)
    let dot = ".e5".reader()
    assert(dot.read_float() == 0.0)
    assert(dot.get_pos() == 0)
}

test "Fix parsing: ByteReader does not consume a bare radix prefix" {
    let hex = "0xg".reader()
    assert(hex.read_hex_uint() == 0)
    assert(hex.get_pos() == 0)
    let hex_signed = "-0x".reader()
    assert(hex_signed.read_hex_int() == 0)
    assert(hex_signed.get_pos() == 0)
    let octal = "0c9".reader()
    assert(octal.read_octal_uint() == 0)
    assert(octal.get_pos() == 0)
    let octal_signed = "-0c".reader()
    assert(octal_signed.read_octal_int() == 0)
    assert(octal_signed.get_pos() == 0)
}

fn fix_parsing_http_handler(req: http.Request) http.Response {
    return http.Response.text("body=" + req.body)
}

fn fix_parsing_http_send(request: String) String {
    let connection = net.Socket.client(net.SocketType.tcp, "127.0.0.1", 9263) ! return ""
    connection.write(request) ! return ""
    let response = [u8]{ 0 x 4096 }
    let received = connection.read(response) ! return ""
    let text = response.view(0, received).to_string()
    connection.close() ! return text
    return text
}

test "Fix parsing: HTTP rejects a signed length and a 0X chunk size" {
    let server = http.Server.new("127.0.0.1", 9263, fix_parsing_http_handler)
    let server_running = co server.start(1)
    defer stop_http_test_server(server, server_running)

    let signed_length = fix_parsing_http_send("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: +5\r\n\r\nhello")
    assert(signed_length.contains(" 400 "))
    let upper_prefix = fix_parsing_http_send("POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n0X5\r\nhello\r\n0\r\n\r\n")
    assert(upper_prefix.contains(" 400 "))
    let signed_chunk = fix_parsing_http_send("POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n+5\r\nhello\r\n0\r\n\r\n")
    assert(signed_chunk.contains(" 400 "))
    let plain = fix_parsing_http_send("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 5\r\n\r\nhello")
    assert(plain.contains(" 200 "))
}

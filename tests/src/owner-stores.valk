use valk.gc

class StoreOwnerItem { number: int }
struct StoreOwnerPart { child: ?StoreOwnerItem (null) }
class StoreOwnerHolder {
    part: StoreOwnerPart ({})
    items: [?StoreOwnerItem x 2] ({ null, null })
}
class StoreOwnerFactory {
    calls: int (0)
    indices: int (0)
    holder: StoreOwnerHolder (.{})
    fn make() StoreOwnerHolder {
        this.calls++
        this.holder = .{}
        return this.holder
    }
    fn part() &StoreOwnerPart { return &this.make().part }
    fn item() &?StoreOwnerItem { return &this.make().part.child }
    fn index() uint {
        this.indices++
        return 1
    }
    fn replace() StoreOwnerItem {
        this.holder = .{}
        gc.collect()
        return StoreOwnerItem { number: 73 }
    }
    fn replace_index() uint {
        this.holder = .{}
        gc.collect()
        return 1
    }
}
class StoreOwnerView {
    view: &StoreOwnerPart
    fn replace() StoreOwnerItem {
        this.view = &StoreOwnerHolder {}.part
        gc.collect()
        return StoreOwnerItem { number: 73 }
    }
}

fn store_owner_number(item: ?StoreOwnerItem) int {
    let value = item ?! return 0
    return value.number
}

test "Stores: inline managed fields evaluate their owner once" {
    let factory = StoreOwnerFactory {}
    factory.make().part.child = StoreOwnerItem { number: 19 }
    assert(factory.calls == 1)
    gc.collect()
    assert(store_owner_number(factory.holder.part.child) == 19)
    factory.make().items[factory.index()] = StoreOwnerItem { number: 23 }
    assert(factory.calls == 2 && factory.indices == 1)
    gc.collect()
    assert(store_owner_number(factory.holder.items[1]) == 23)
}

test "Stores: temporary borrows evaluate their owner once" {
    let factory = StoreOwnerFactory {}
    factory.part().child = StoreOwnerItem { number: 29 }
    assert(factory.calls == 1)
    gc.collect()
    assert(store_owner_number(factory.holder.part.child) == 29)
    factory.item()[0] = StoreOwnerItem { number: 31 }
    assert(factory.calls == 2)
    gc.collect()
    assert(store_owner_number(factory.holder.part.child) == 31)
}

test "Stores: managed fields keep their selected owner through the right operand" {
    let factory = StoreOwnerFactory {}
    let original = factory.holder
    factory.holder.part.child = factory.replace()
    gc.collect()
    assert(store_owner_number(original.part.child) == 73)
    assert(!isset(factory.holder.part.child))
    original = factory.holder
    factory.holder.items[1] = factory.replace()
    gc.collect()
    assert(store_owner_number(original.items[1]) == 73)
    assert(!isset(factory.holder.items[1]))
    original = factory.holder
    factory.holder.items[factory.replace_index()] = StoreOwnerItem { number: 37 }
    gc.collect()
    assert(store_owner_number(original.items[1]) == 37)
    assert(!isset(factory.holder.items[1]))
}

test "Stores: borrowed properties keep their selected owner through the right operand" {
    let original = StoreOwnerHolder {}
    let holder = StoreOwnerView { view: &original.part }
    holder.view.child = holder.replace()
    gc.collect()
    assert(store_owner_number(original.part.child) == 73)
    assert(!isset(holder.view.child))
}

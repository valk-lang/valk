use valk.gc

class BorrowMethodItem {
    number: int (23)

    + fn text() String $auto { return this.number.to(String) }
    fn read() int { return this.number }
}

struct BorrowMethodCell {
    number: int (31)

    fn increment() { this.number++ }
    + fn text() String $auto { return this.number.to(String) }
}

union BorrowMethodUnion : int | String | null {
    fn number() int {
        return match this : int {
            int as value => value
            default => 0
        }
    }
}

class BorrowMethodOwner {
    number: int (17)
    item: BorrowMethodItem (.{})
    name: String ("borrowed")
    cell: BorrowMethodCell (.{})
    variant: BorrowMethodUnion (null)
}

fn borrowed_number_text(value: &int) String { return value }
fn borrowed_item_text(value: &BorrowMethodItem) String { return value }
fn borrowed_cell_text(value: &BorrowMethodCell) String { return value }

fn borrowed_nested_item(value: local &BorrowMethodItem) int { return value.read() }
fn borrowed_nested_cell(value: local mut &BorrowMethodCell) { value.increment() }
fn borrowed_union(value: &BorrowMethodUnion) int { return value.number() }

fn borrowed_nullable_item(value: ?mut &BorrowMethodItem) int {
    if !isset(value) : return 0
    let before = value.number
    value.number = before + 1
    let read = value.read
    gc.collect()
    assert(read() == before + 1)
    return value.read()
}

test "Borrowed receivers: conversion hooks read the stored value" {
    let owner = BorrowMethodOwner {}
    assert(borrowed_number_text(&owner.number) == "17")
    assert(borrowed_item_text(&owner.item) == "23")
    assert(borrowed_cell_text(&owner.cell) == "31")
    let number = &owner.number
    assert(number.to(String) == "17")
    let name = &owner.name
    assert(name.length == 8)
    assert(name.starts_with("borrow"))
    let cell = &owner.cell
    cell.increment()
    assert(owner.cell.number == 32)
    borrowed_nested_cell(cell)
    assert(owner.cell.number == 33)
    let item = &owner.item
    assert(borrowed_nested_item(item) == 23)
    assert(borrowed_union(&owner.variant) == 0)
    owner.variant = 37
    assert(borrowed_union(&owner.variant) == 37)
}

test "Borrowed receivers: nullable object slots narrow before access" {
    assert(borrowed_nullable_item(null) == 0)
    let owner = BorrowMethodOwner {}
    assert(borrowed_nullable_item(&owner.item) == 24)
    assert(owner.item.number == 24)
    assert(borrowed_nullable_item(&BorrowMethodOwner {}.item) == 24)
}

test "Conversion hooks: nonescaping receivers stay publishable" {
    let item = BorrowMethodItem {}
    let text: String = item
    let shared_item: shared BorrowMethodItem = item
    assert(text == "23")
    assert(shared_item.number == 23)
}

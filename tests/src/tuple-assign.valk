class TaPoint {
    x: int (0)
    y: int (0)
    - _z: int (0)
    get z: int { return this._z }
    set z(v: int) { this._z = v * 10 }
}

class TaBox {
    v: int (0)
}

enum TaColor { red, green }

fn ta_size() (int, String) {
    return (640, "wide")
}

fn ta_next(calls: Array[String], name: String) int {
    calls.append(name)
    return calls.length.to(int)
}

test "Tuple assignment swaps and takes tuples from calls" {
    let a = 1
    let b = 2
    (a, b) = (b, a)
    assert(a == 2 && b == 1)

    let w = 0
    let label = ""
    (w, label) = ta_size()
    assert(w == 640 && label == "wide")

    let s1 = "a"
    let s2 = "b"
    (s1, s2) = (s2 + "!", s1)
    assert(s1 == "b!" && s2 == "a")

    let k = 0
    (_, k) = (5, 6)
    assert(k == 6)
}

test "Tuple assignment to properties, setters and elements" {
    let p = TaPoint {}
    (p.x, p.y) = (p.y + 5, 7)
    assert(p.x == 5 && p.y == 7)
    (p.z, p.x) = (3, p.z)
    assert(p.z == 30 && p.x == 0)

    let arr = Array[int]{ 1, 2, 3 }
    (arr[0], arr[2]) = (arr[2], arr[0])
    assert(arr.join(",") == "3,2,1")

    let fixed = [int x 3]{ 1, 2, 3 }
    (fixed[0], fixed[1]) = (fixed[1], fixed[0])
    assert(fixed[0] == 2 && fixed[1] == 1)

    let boxes = Array[TaBox]{ TaBox { v: 1 }, TaBox { v: 2 } }
    (boxes[0], boxes[1]) = (boxes[1], boxes[0])
    assert(boxes[0].v == 2 && boxes[1].v == 1)
}

test "Tuple assignment evaluates the right side first, then targets left to right" {
    let i: uint = 0
    let list = Array[int]{ 10, 20 }
    // The index is read after `i` was assigned
    (i, list[i]) = (1, 99)
    assert(i == 1 && list.join(",") == "10,99")

    let calls = Array[String]{}
    let x = 0
    let y = 0
    (x, y) = (ta_next(calls, "first"), ta_next(calls, "second"))
    assert(x == 1 && y == 2 && calls.join(",") == "first,second")
}

test "Tuple assignment takes the targets' types for its values" {
    let n: ?String = "x"
    let c = TaColor.red
    (n, c) = (null, .green)
    assert(!isset(n) && c == TaColor.green)

    let small: u8 = 0
    let k = 0
    (small, k) = (200, 1)
    assert(small == 200 && k == 1)

    let s: shared TaBox = TaBox {}
    let box = TaBox { v: 3 }
    (s, box) = (box, TaBox { v: 4 })
    assert(s.v == 3 && box.v == 4)
}

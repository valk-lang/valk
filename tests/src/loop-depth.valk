
// A collection that counts the loops running over it
class DepthItems {
    items: Array[int]
    running: int (0)
    loops: uint (0)

    fn _next(index: uint) int !IterError {
        return this.items.get(index) ! throw .end
    }
    fn _each_begin() {
        this.running++
        this.loops++
    }
    fn _each_end() {
        this.running--
    }
}

test "break 2 and continue 2 leave nested loops" {
    let grid = Array[Array[int]]{ .{ 1, 2, 3 }, .{ 4, 5, 6 }, .{ 7, 8, 9 } }
    let seen = Array[int]{}
    each grid as row {
        each row as cell {
            if cell == 5 : break 2
            seen.append(cell)
        }
    }
    assert(seen.join(",") == "1,2,3,4")

    let firsts = Array[int]{}
    let after_inner: uint = 0
    each grid as row {
        each row as cell {
            firsts.append(cell)
            continue 2
        }
        after_inner++
    }
    assert(firsts.join(",") == "1,4,7")
    assert(after_inner == 0)

    // `break 1` is a plain break
    let count = 0
    while true {
        count++
        if count == 3 : break 1
    }
    assert(count == 3)
}

test "break 3 and continue 2 in while loops" {
    let i = 0
    let hits = 0
    while i < 5 {
        i++
        let j = 0
        while true {
            j++
            if j > 3 : continue 2
            if i == 4 : break 2
            hits++
        }
    }
    assert(i == 4 && hits == 9)

    let found = ""
    each 0 .. 3 as a {
        each 0 .. 3 as b {
            each 0 .. 3 as c {
                if a + b + c == 5 {
                    found = "" + a + b + c
                    break 3
                }
            }
        }
    }
    assert(found == "122")
}

test "break 2 ends the loops it leaves over a collection" {
    let outer = DepthItems { items: .{ 1, 2, 3 } }
    let inner = DepthItems { items: .{ 10, 20, 30 } }
    let pairs = Array[int]{}
    each outer as a {
        each inner as b {
            pairs.append(a + b)
            if b == 20 && a == 2 : break 2
            if b == 20 : continue 2
        }
    }
    assert(pairs.join(",") == "11,21,12,22")
    assert(outer.running == 0 && inner.running == 0)
    assert(outer.loops == 1 && inner.loops == 2)

    // Removing from a map inside nested loops, then leaving both
    let map = Map[int]{ "a" => 1, "b" => 2, "c" => 3 }
    each 0 .. 3 as round {
        each map as v, k {
            if v == 2 {
                map.remove(k)
                break 2
            }
        }
    }
    map.set("d", 4)
    let keys = Array[String]{}
    each map as v, k : keys.append(k)
    assert(keys.join(",") == "a,c,d")
}

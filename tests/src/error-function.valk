
fn test_err_func_throw(val: local mut &uint) !AnError $throw {
    val[0]++
    throw AnError.error
}
fn test_err_func(val: local mut &uint) !AnError {
    if val[0] == 0 : test_err_func_throw(val)
}

test "Error function" {
    let v : uint = 0
    let has_err = false
    test_err_func(&v) ! has_err = true
    assert(has_err)
    assert(v == 1)

    has_err = false
    test_err_func(&v) ! has_err = true
    assert(!has_err)
    assert(v == 1)
}

fn test_err_func_return_throw(val: local mut &uint) uint !AnError {
    if val[0] == 0 : return test_err_func_throw(val)
    return val[0] + 10
}

test "Error function: a throw call in a return position throws" {
    let v : uint = 0
    let r = test_err_func_return_throw(&v) !? 99
    assert(r == 99)
    assert(v == 1)
    assert((test_err_func_return_throw(&v) !? 0) == 11)
}
fn test_err_func_throw_branches(n: uint) !AnError $throw {
    if n == 0 { throw AnError.error }
    match n {
        1 => throw AnError.error
        default => test_err_func_throw_pass() !>
    }
}
fn test_err_func_throw_pass() !AnError $throw {
    throw AnError.error
}
fn test_err_func_branches(n: uint) uint !AnError {
    if n < 10 : test_err_func_throw_branches(n)
    return n
}

test "Error function: every branch of a throw function throws" {
    assert((test_err_func_branches(0) !? 99) == 99)
    assert((test_err_func_branches(1) !? 99) == 99)
    assert((test_err_func_branches(2) !? 99) == 99)
    assert((test_err_func_branches(10) !? 99) == 10)
}

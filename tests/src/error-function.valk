
fn test_err_func_throw(val: stack uint) !AnError $throw {
    val[0]++
    throw AnError.error
}
fn test_err_func(val: stack uint) !AnError {
    if val[0] == 0 : test_err_func_throw(val)
}

test "Error function" {
    let v : uint = 0
    let has_err = false
    test_err_func(&v) ! has_err = true
    assert(has_err)
    assert(v == 1)

    has_err = false
    test_err_func(&v) ! has_err = true
    assert(!has_err)
    assert(v == 1)
}

fn test_err_func_return_throw(val: stack uint) uint !AnError {
    if val[0] == 0 : return test_err_func_throw(val)
    return val[0] + 10
}

test "Error function: a throw call in a return position throws" {
    let v : uint = 0
    let r = test_err_func_return_throw(&v) !? 99
    assert(r == 99)
    assert(v == 1)
    assert((test_err_func_return_throw(&v) !? 0) == 11)
}
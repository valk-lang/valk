
use valk.template
use valk.fs
use valk.html

fn escape_template_value(value: String) String {
    return html.escape(value)
}

class TemplateContent {
    msg: String
    attr: String
    xss: String
}
class TemplateData {
    title: String
    content: TemplateContent
    test: ?String
}
class TemplateExtendContent {
    msg: String
    js: String
}
class TemplateExtendData {
    title: String
    content: TemplateExtendContent
}

test "Templates" {
    let data = TemplateData {
        title: "Hello"
        content: TemplateContent {
            msg: "World"
            attr: "\" class=\"test\""
            xss: "<script>alert('test');</script>"
        }
        test: null[String]
    }

    let vdir = __DIR__ + "/../assets/views"
    let options = template.RenderOptions {
        escape: escape_template_value
    }

    let files = #embed_dir("assets/views")
    template.set_content_many(files)
    let result = template.render("pages/test-page.html", data, options) !? E.message
    let expect = fs.read(vdir + "/expect/result-1.html") !? "-?-"

    assert(result == expect)
}

test "Template extending" {
    let data = TemplateExtendData {
        title: "Hello"
        content: TemplateExtendContent {
            msg: "World"
            js: "<script>alert('test');</script>"
        }
    }

    let vdir = __DIR__ + "/../assets/views"
    let options = template.RenderOptions {
        escape: escape_template_value
    }

    let files = #embed_dir("assets/views")
    template.set_content_many(files)
    let result = template.render("pages/test-extend.html", data, options) !? E.message
    let expect = fs.read(vdir + "/expect/result-2.html") !? "-?-"

    assert(result == expect)
}

test "Template isset handles missing data" {
    template.set_content("isset-missing-test", "@if(@isset(missing.value))yes@else no@end")
    let result = template.render("isset-missing-test", Map[String]{}) ! {
        assert(false)
        return
    }
    assert(result == "no")
}

test "Template content rendering exposes parse errors" {
    let rendered = template.render_content("Hello {{ name }}", Map[String]{ "name" => "Valk" }) ! {
        assert(false)
        return
    }
    assert(rendered == "Hello Valk")

    template.render_content("@end", Map[String]{}) ! {
        assert(E.code == E.parse)
        return
    }
    assert(false)
}

test "Template values escape by default and raw values are explicit" {
    let data = Map[String]{ "value" => "<b title='x'>&</b>" }
    assert(template.render_content("{{ value }}", data) !! == "&lt;b title=&#39;x&#39;&gt;&amp;&lt;/b&gt;")
    assert(template.render_content("{{ value }}", data, template.RenderOptions {}) !! == "&lt;b title=&#39;x&#39;&gt;&amp;&lt;/b&gt;")
    assert(template.render_content("{! value !}", data) !! == "<b title='x'>&</b>")

    let options = template.RenderOptions {
        escape: fn(value: String) String { return "[" + value + "]" }
    }
    assert(template.render_content("{{ value }} {! value !}", Map[String]{ "value" => "raw" }, options) !! == "[raw] raw")
}

test "Template missing values return errors" {
    template.render_content("v={{ nope }}", Map[String]{}) ! {
        assert(E.code == E.parse)
        return
    }
    assert(false)
}

test "Template array subscripts retain numeric indexes" {
    let data = Map[Array[Map[String]]]{
        "items" => Array[Map[String]]{
            Map[String]{ "name" => "first" }
        }
    }
    assert(template.render_content("{{ items[0].name }}", data) !! == "first")
}

test "Template self-include cycles return parse errors" {
    template.set_content("cycle-self", "@include(\"cycle-self\")")
    template.render("cycle-self", Map[String]{}) ! {
        assert(E.code == E.parse)
        assert(E.message.contains("cycle-self -> cycle-self"))
        return
    }
    assert(false)
}

test "Template multi-file extension cycles return parse errors" {
    template.set_content("cycle-a", "@extend(\"cycle-b\")")
    template.set_content("cycle-b", "@extend(\"cycle-c\")")
    template.set_content("cycle-c", "@extend(\"cycle-a\")")
    template.render("cycle-a", Map[String]{}) ! {
        assert(E.code == E.parse)
        assert(E.message.contains("cycle-a -> cycle-b -> cycle-c -> cycle-a"))
        return
    }
    assert(false)
}

test "Template deep acyclic includes respect max_depth" {
    let depth: uint = 0
    while depth < 32 {
        let name = "depth-" + depth
        let content = depth == 31 ? "done" : "@include(\"depth-" + (depth + 1) + "\")"
        template.set_content(name, content)
        depth++
    }

    let options = template.RenderOptions { max_depth: 32 }
    assert(template.render("depth-0", Map[String]{}, options) !! == "done")
}

test "Template depth limit returns a parse error" {
    let options = template.RenderOptions { max_depth: 31 }
    template.render("depth-0", Map[String]{}, options) ! {
        assert(E.code == E.parse)
        assert(E.message.contains("maximum of 31"))
        return
    }
    assert(false)
}


use valk.template
use valk.io
use valk.json
use valk.thread
use valk.fs
use valk.html

fn escape_template_value(value: local &[u8], out: io.Writer) uint !io.IoError {
    return html.escape_into(value, out) !>
}

class TemplateContent {
    msg: String
    attr: String
    xss: String
}
class TemplateData {
    title: String
    content: TemplateContent
    test: ?String
}
class TemplateExtendContent {
    msg: String
    js: String
}
class TemplateExtendData {
    title: String
    content: TemplateExtendContent
}

test "Templates" {
    let engine = template.Engine.new()
    let data = TemplateData {
        title: "Hello"
        content: TemplateContent {
            msg: "World"
            attr: "\" class=\"test\""
            xss: "<script>alert('test');</script>"
        }
        test: null[String]
    }

    let vdir = __DIR__ + "/../assets/views"
    let options = template.RenderOptions {
        escape: escape_template_value
    }

    let files = #embed_dir("assets/views")
    engine.set_many(files)
    let result = engine.render("pages/test-page.html", data, options) !? E.message
    let expect = fs.read(vdir + "/expect/result-1.html") !? "-?-"

    assert(result == expect)
}

test "Template extending" {
    let engine = template.Engine.new()
    let data = TemplateExtendData {
        title: "Hello"
        content: TemplateExtendContent {
            msg: "World"
            js: "<script>alert('test');</script>"
        }
    }

    let vdir = __DIR__ + "/../assets/views"
    let options = template.RenderOptions {
        escape: escape_template_value
    }

    let files = #embed_dir("assets/views")
    engine.set_many(files)
    let result = engine.render("pages/test-extend.html", data, options) !? E.message
    let expect = fs.read(vdir + "/expect/result-2.html") !? "-?-"

    assert(result == expect)
}

test "Template isset handles missing data" {
    let engine = template.Engine.new()
    engine.set("isset-missing-test", "@if(@isset(missing.value))yes@else no@end")
    let result = engine.render("isset-missing-test", Map[String]{}) ! {
        assert(false)
        return
    }
    assert(result == "no")
}

test "Template conditions compare strings" {
    let engine = template.Engine.new()
    let data = Map[String]{ "title" => "Hello world", "other" => "x" }
    let content = "@if(title == \"Hello world\")yes@else no@end"
    assert(engine.render_content(content, data) !! == "yes")
    content = "@if(title != \"Hello world\")yes@else no@end"
    assert(engine.render_content(content, data) !! == "no")
    content = "@if(title == other)same@elif(other == \"x\")elif@else no@end"
    assert(engine.render_content(content, data) !! == "elif")
    content = "@if(title > \"a\")yes@else no@end"
    assert(engine.render_content(content, data) !! == "no")
}

test "Template content rendering exposes parse errors" {
    let engine = template.Engine.new()
    let rendered = engine.render_content("Hello {{ name }}", Map[String]{ "name" => "Valk" }) ! {
        assert(false)
        return
    }
    assert(rendered == "Hello Valk")

    engine.render_content("@end", Map[String]{}) ! {
        assert(E.code == E.parse)
        return
    }
    assert(false)
}

test "Template values escape by default and raw values are explicit" {
    let engine = template.Engine.new()
    let data = Map[String]{ "value" => "<b title='x'>&</b>" }
    assert(engine.render_content("{{ value }}", data) !! == "&lt;b title=&#39;x&#39;&gt;&amp;&lt;/b&gt;")
    assert(engine.render_content("{{ value }}", data, template.RenderOptions {}) !! == "&lt;b title=&#39;x&#39;&gt;&amp;&lt;/b&gt;")
    assert(engine.render_content("{! value !}", data) !! == "<b title='x'>&</b>")

    let options = template.RenderOptions {
        escape: fn(value: local &[u8], out: io.Writer) uint !io.IoError { return out.write("[" + value.to_string() + "]") !> }
    }
    assert(engine.render_content("{{ value }} {! value !}", Map[String]{ "value" => "raw" }, options) !! == "[raw] raw")
}

test "Template missing values return errors" {
    let engine = template.Engine.new()
    engine.render_content("v={{ nope }}", Map[String]{}) ! {
        assert(E.code == E.parse)
        return
    }
    assert(false)
}

test "Template array subscripts retain numeric indexes" {
    let engine = template.Engine.new()
    let data = Map[Array[Map[String]]]{
        "items" => Array[Map[String]]{
            Map[String]{ "name" => "first" }
        }
    }
    assert(engine.render_content("{{ items[0].name }}", data) !! == "first")
}

test "Template self-include cycles return parse errors" {
    let engine = template.Engine.new()
    engine.set("cycle-self", "@include(\"cycle-self\")")
    engine.render("cycle-self", Map[String]{}) ! {
        assert(E.code == E.parse)
        assert(E.message.contains("cycle-self -> cycle-self"))
        return
    }
    assert(false)
}

test "Template multi-file extension cycles return parse errors" {
    let engine = template.Engine.new()
    engine.set("cycle-a", "@extend(\"cycle-b\")")
    engine.set("cycle-b", "@extend(\"cycle-c\")")
    engine.set("cycle-c", "@extend(\"cycle-a\")")
    engine.render("cycle-a", Map[String]{}) ! {
        assert(E.code == E.parse)
        assert(E.message.contains("cycle-a -> cycle-b -> cycle-c -> cycle-a"))
        return
    }
    assert(false)
}

// Registers depth-0 .. depth-31 in `engine`, each including the next.
fn register_template_depth_chain(engine: template.Engine) {
    let depth: uint = 0
    while depth < 32 {
        let name = "depth-" + depth
        let content = depth == 31 ? "done" : "@include(\"depth-" + (depth + 1) + "\")"
        engine.set(name, content)
        depth++
    }
}

test "Template deep acyclic includes respect max_depth" {
    let engine = template.Engine.new()
    register_template_depth_chain(engine)

    // 31 levels of @include below depth-0; the rendered template itself is not counted.
    let options = template.RenderOptions { max_depth: 31 }
    assert(engine.render("depth-0", Map[String]{}, options) !! == "done")
}

test "Template depth limit returns a parse error" {
    let engine = template.Engine.new()
    register_template_depth_chain(engine)
    let options = template.RenderOptions { max_depth: 30 }
    engine.render("depth-0", Map[String]{}, options) ! {
        assert(E.code == E.parse)
        assert(E.message.contains("maximum of 30"))
        return
    }
    assert(false)
}

test "Template: @isset tests existence, not truthiness" {
    let engine = template.Engine.new()
    let data = json.decode("{\"zero\":0,\"empty\":\"\",\"off\":false,\"none\":null,\"obj\":{\"n\":0}}") !!
    let content = "@if(@isset(zero))a@end @if(@isset(empty))b@end @if(@isset(off))c@end @if(@isset(obj.n))d@end @if(@isset(none))x@end @if(@isset(nope))y@end @if(@isset(obj.nope))z@end"
    assert(engine.render_content(content, data) !! == "a b c d")
}

test "Template: an escape of null writes values unescaped" {
    let engine = template.Engine.new()
    let data = Map[String]{ "v" => "<b>" }
    assert(engine.render_content("{{ v }}", data, template.RenderOptions { escape: null }) !! == "<b>")
    assert(engine.render_content("{{ v }}", data, template.RenderOptions { escape: template.html_escape }) !! == "&lt;b&gt;")
    assert(engine.render_content("{{ v }}", data, template.RenderOptions {}) !! == "&lt;b&gt;")
    assert(engine.render_content("{{ v }}", data, template.RenderOptions { max_depth: 3 }) !! == "&lt;b&gt;")
    assert(engine.render_content("{{ v }}", data) !! == "&lt;b&gt;")
}

test "Template: render and render_content count max_depth the same way" {
    let engine = template.Engine.new()
    engine.set("fix-depth-leaf", "leaf")
    engine.set("fix-depth-mid", "@include(\"fix-depth-leaf\")")
    engine.set("fix-depth-top", "@include(\"fix-depth-mid\")")
    let data = Map[String]{}
    let zero = template.RenderOptions { max_depth: 0 }
    let one = template.RenderOptions { max_depth: 1 }
    let two = template.RenderOptions { max_depth: 2 }

    // No include: fine even at 0, for both.
    assert(engine.render("fix-depth-leaf", data, zero) !! == "leaf")
    assert(engine.render_content("leaf", data, zero) !! == "leaf")
    // One level of include.
    assert(engine.render("fix-depth-mid", data, one) !! == "leaf")
    assert(engine.render_content("@include(\"fix-depth-leaf\")", data, one) !! == "leaf")
    assert((engine.render("fix-depth-mid", data, zero) !? "err") == "err")
    assert((engine.render_content("@include(\"fix-depth-leaf\")", data, zero) !? "err") == "err")
    // Two levels.
    assert(engine.render("fix-depth-top", data, two) !! == "leaf")
    assert(engine.render_content("@include(\"fix-depth-mid\")", data, two) !! == "leaf")
    assert((engine.render("fix-depth-top", data, one) !? "err") == "err")
    assert((engine.render_content("@include(\"fix-depth-mid\")", data, one) !? "err") == "err")
}

test "Template text that names a directive does not shift the skip depth" {
    let engine = template.Engine.new()
    let items = Array[int]{}
    let case = Map[json.Value]{
        "f" => json.from(false),
        "items" => json.from(items),
    }
    // Both words are text in a skipped branch, not branch openers
    assert(engine.render_content("A@if(f)mention @each here@end B", case) !! == "A B")
    assert(engine.render_content("A@if(f)mention @if here@end B", case) !! == "A B")
    let each_case = Map[json.Value]{
        "empty" => json.from(Array[int]{}),
        "f" => json.from(false),
    }
    assert(engine.render_content("S@each(empty as v) X @if Y@end E", each_case) !! == "S E")
    assert(engine.render_content("S@each(empty as v) X @include(\"@each\") Y@end E", each_case) !! == "S E")
}

test "Template extend chains keep the most derived block" {
    let engine = template.Engine.new()
    engine.set("chain-base", "B[@yield(\"t\")]E")
    engine.set("chain-mid", "@extend(\"chain-base\")@block(\"t\")M@end")
    engine.set("chain-leaf", "@extend(\"chain-mid\")@block(\"t\")L@end")
    assert(engine.render("chain-leaf", Map[String]{}) !! == "B[L]E")
    // Without a block of its own, the middle template passes the leaf's one through
    engine.set("chain-mid2", "@extend(\"chain-base\")")
    engine.set("chain-leaf2", "@extend(\"chain-mid2\")@block(\"t\")L@end")
    assert(engine.render("chain-leaf2", Map[String]{}) !! == "B[L]E")
}

test "Template include sees the scope of the loop around it" {
    let engine = template.Engine.new()
    engine.set("scope-frag", "[{{ v }}]")
    let data = Map[json.Value]{
        "items" => json.from(Array[int]{ 1, 2 }),
        "v" => json.from("ROOT"),
    }
    assert(engine.render_content("@each(items as v)@include(\"scope-frag\")@end", data) !! == "[1][2]")
}

// The 0.7.0 free functions are deprecated but keep working: one registry for all threads
test "Template: the deprecated free functions share one registry across threads" {
    template.set_content("fix-thread-page", "Hi {{ name }} @include(\"fix-thread-part\")")
    template.set_content_many(Map[String]{ "fix-thread-part" => "from {! where !}" })
    let worker = thread.Thread[String].start(fn() String {
        return template.render("fix-thread-page", Map[String]{ "name" => "<w>", "where" => "<t>" }) !? "missing"
    }) !!
    assert(worker.await() == "Hi &lt;w&gt; from <t>")

    let other = thread.Thread[bool].start(fn() bool {
        template.set_content("fix-thread-late", "late")
        return true
    }) !!
    assert(other.await())
    assert(template.render("fix-thread-late", Map[String]{}) !! == "late")
}

// ---- The compiled engine: expressions, whitespace, filters, engines and directives ----

test "Template: conditions take &&, ||, ! and parentheses" {
    let engine = template.Engine.new()
    let data = json.decode("{\"admin\":false,\"name\":\"T\",\"n\":3,\"f\":1.5}") !!
    assert(engine.render_content("@if(admin || name == \"T\")a@end", data) !! == "a")
    assert(engine.render_content("@if(admin && name == \"T\")a@else b@end", data) !! == "b")
    assert(engine.render_content("@if(!admin && (n > 2 || admin))a@end", data) !! == "a")
    assert(engine.render_content("@if(n >= 3 && f < 2.0 && name != \"x\")a@end", data) !! == "a")
    assert(engine.render_content("@if(true && !false && !null)a@end", data) !! == "a")
    assert(engine.render_content("@if(@len(name) == 1 && @isset(f))a@end", data) !! == "a")
}

test "Template: a control directive alone on its line takes the line with it" {
    let engine = template.Engine.new()
    let data = json.decode("{\"items\":[1,2],\"admin\":false,\"t\":\"T\"}") !!
    assert(engine.render_content("<ul>\n@each(items as it)\n<li>{{ it }}</li>\n@end\n</ul>", data) !! == "<ul>\n<li>1</li>\n<li>2</li>\n</ul>")
    assert(engine.render_content("a\n@if(admin)\nx\n@else\ny\n@end\nb", data) !! == "a\ny\nb")
    assert(engine.render_content("a\n    @if(admin)\n    x\n    @end\nb", data) !! == "a\nb")
    // Inline directives keep the text around them as it is
    assert(engine.render_content("a @if(admin)x@else y@end b", data) !! == "a  y b")
    assert(engine.render_content("@each(items as it){{ it }},@end", data) !! == "1,2,")
    // Output on the same line keeps the line
    assert(engine.render_content("{{ t }} @if(admin)x@end\nb", data) !! == "T \nb")
}

test "Template: @empty, @set, comments and escaped directives" {
    let engine = template.Engine.new()
    let data = json.decode("{\"none\":[],\"items\":[1],\"t\":\"T\"}") !!
    assert(engine.render_content("@each(none as x)x@empty none@end", data) !! == "none")
    assert(engine.render_content("@each(items as x)[{{ x }}]@empty none@end", data) !! == "[1]")
    assert(engine.render_content("@set(v = t)@set(w = \"W\"){{ v }}{{ w }}", data) !! == "TW")
    // A loop's @set stays inside the loop
    assert(engine.render_content("@each(items as x)@set(v = x)@end@if(@isset(v))in@else outer@end", data) !! == "outer")
    assert(engine.render_content("a{# hidden #}b\n{# a whole line #}\nc", data) !! == "ab\nc")
    assert(engine.render_content("\\@if(x) and \\{{ t }} stay text", data) !! == "@if(x) and {{ t }} stay text")
    assert(engine.render_content("email @unsafe is text", data) !! == "email @unsafe is text")
}

test "Template: filters" {
    let engine = template.Engine.new()
    let data = json.decode("{\"t\":\"Hello World\",\"items\":[3,1,2],\"price\":12.5,\"o\":{\"a\":1,\"b\":2},\"empty\":\"\",\"raw\":\"<b>\"}") !!
    assert(engine.render_content("{{ t | upper }}|{{ t | lower }}|{{ \"hi\" | capitalize }}", data) !! == "HELLO WORLD|hello world|Hi")
    assert(engine.render_content("{{ items | join(\"-\") }}|{{ items | first }}|{{ items | last }}|{{ items | length }}", data) !! == "3-1-2|3|2|3")
    assert(engine.render_content("{{ items | reverse | join }}", data) !! == "2, 1, 3")
    assert(engine.render_content("{{ price | round(1) }}|{{ price | round }}", data) !! == "12.5|12")
    assert(engine.render_content("{{ t | truncate(5, \"..\") }}|{{ t | truncate(50) }}", data) !! == "Hello..|Hello World")
    // A missing variable is an error even with a default filter behind it
    assert((engine.render_content("{{ nope | default(\"x\") }}", data) !? "E") == "E")
    assert(engine.render_content("{{ empty | default(\"none\") }}|{{ t | default(\"none\") }}", data) !! == "none|Hello World")
    assert(engine.render_content("{{ t | replace(\"World\", \"You\") }}|{{ o | keys | join }}|{{ o | json }}", data) !! == "Hello You|a, b|{&quot;a&quot;:1,&quot;b&quot;:2}")
    assert(engine.render_content("{! o | json !}|{{ raw | escape }}|{! raw | escape !}", data) !! == "{\"a\":1,\"b\":2}|&amp;lt;b&amp;gt;|&lt;b&gt;")
    assert(engine.render_content("{{ \"a b&c\" | urlencode }}|{{ \"  x  \" | trim }}|{{ \"abc\" | reverse }}", data) !! == "a%20b%26c|x|cba")
    // Filters chain and take expressions as arguments
    assert((engine.render_content("{{ t | truncate(@len(items) + 0, \"\") }}", data) !? "E") == "E")
    assert(engine.render_content("{{ t | truncate(@len(items)) | upper }}", data) !! == "HEL…")
    engine.render_content("{{ t | nope }}", data) ! {
        assert(E.code == E.parse)
        assert(E.message.contains("Unknown filter 'nope'"))
        return
    }
    assert(false)
}

test "Template: custom filters and separate engines" {
    let engine = template.Engine.new()
    engine.set_filter("money", fn(v: json.Value, args: Array[json.Value]) json.Value {
        let symbol = args.get(0) !? json.from("$")
        return json.from(symbol.string + v.float.to_string(2))
    })
    let data = json.decode("{\"price\":12.5}") !!
    assert(engine.render_content("{{ price | money }} {{ price | money(\"€\") }}", data) !! == "$12.50 €12.50")

    // A filter is an ordinary closure: it may capture what it needs
    let symbols = Map[String]{ "eur" => "€" }
    engine.set_filter("symbol", fn(v: json.Value, args: Array[json.Value]) json.Value {
        return json.from(symbols.get(v.string) !? "?")
    })
    assert(engine.render_content("{{ \"eur\" | symbol }}{{ \"x\" | symbol }}", data) !! == "€?")

    // A custom filter replaces a built-in one of the same name
    engine.set_filter("upper", fn(v: json.Value, args: Array[json.Value]) json.Value {
        return json.from("UP:" + v.string)
    })
    assert(engine.render_content("{{ \"x\" | upper }}", data) !! == "UP:x")

    // Engines have their own templates and filters
    let other = template.Engine.new()
    engine.set("page", "engine [{{ price | money }}]")
    other.set("page", "other")
    assert(engine.has("page") && other.render("page", data) !! == "other")
    assert(engine.render("page", data) !! == "engine [$12.50]")
    other.render_content("{{ price | money }}", data) ! {
        assert(E.message.contains("Unknown filter 'money'"))
        return
    }
    assert(false)
}

// Each thread runs the initializer of a `global`, so every thread gets an engine of its own
global thread_views: template.Engine (load_thread_views())

fn load_thread_views() template.Engine {
    let engine = template.Engine.new()
    engine.set("greet", "Hi {{ name }}")
    return engine
}

test "Template: a per-thread global engine renders on every thread and recompiles on change" {
    let worker = thread.Thread[String].start(fn() String {
        return thread_views.render("greet", Map[String]{ "name" => "w" }) !? "missing"
    }) !!
    assert(worker.await() == "Hi w")
    assert(thread_views.render("greet", Map[String]{ "name" => "m" }) !! == "Hi m")
    // A new registration replaces the compiled copy on this thread only
    thread_views.set("greet", "Bye {{ name }}")
    assert(thread_views.render("greet", Map[String]{ "name" => "m" }) !! == "Bye m")
    let again = thread.Thread[String].start(fn() String {
        return thread_views.render("greet", Map[String]{ "name" => "w" }) !? "missing"
    }) !!
    assert(again.await() == "Hi w")
}

test "Template: @include with its own data" {
    let engine = template.Engine.new()
    engine.set("card", "[{{ name }}:{{ n }}]")
    let data = json.decode("{\"items\":[{\"name\":\"a\",\"n\":1},{\"name\":\"b\",\"n\":2}],\"name\":\"root\",\"n\":0}") !!
    assert(engine.render_content("@each(items as it)@include(\"card\", it)@end", data) !! == "[a:1][b:2]")
    assert(engine.render_content("@include(\"card\")", data) !! == "[root:0]")
    // The partial sees only the value it was given
    engine.render_content("@include(\"card\", items)", data) ! {
        assert(E.code == E.parse)
        return
    }
    assert(false)
}

test "Template: the engine's escape sets the output format" {
    let data = Map[String]{ "v" => "<b> & 'x'" }
    let html = template.Engine.new()
    assert(html.render_content("{{ v }}", data) !! == "&lt;b&gt; &amp; &#39;x&#39;")

    // Plain text: no escaping at all
    let text = template.Engine.new()
    text.escape = null
    assert(text.render_content("{{ v }}", data) !! == "<b> & 'x'")
    // Options carry their own escape (HTML by default), so a plain-text engine passes its own
    assert(text.render_content("{{ v }}", data, template.RenderOptions { max_depth: 2 }) !! == "&lt;b&gt; &amp; &#39;x&#39;")
    assert(text.render_content("{{ v }}", data, template.RenderOptions { escape: text.escape, max_depth: 2 }) !! == "<b> & 'x'")
    assert(html.render_content("{{ v }}", data, template.RenderOptions { escape: null }) !! == "<b> & 'x'")

    // Another format: SQL-style quoting, written straight into the page
    let sql = template.Engine.new()
    sql.escape = fn(input: local &[u8], out: io.Writer) uint !io.IoError {
        return out.write(input.to_string().replace("'", "''")) !>
    }
    assert(sql.render_content("name = '{{ v }}'", data) !! == "name = '<b> & ''x'''")
    // A per-render option overrides the engine's function
    let shout = template.RenderOptions { escape: fn(value: local &[u8], out: io.Writer) uint !io.IoError { return out.write(value.to_string().upper()) !> } }
    assert(sql.render_content("{{ v }}", data, shout) !! == "<B> & 'X'")
}

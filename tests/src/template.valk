
use valk.template
use valk.io
use valk.json
use valk.thread
use valk.fs
use valk.html

fn escape_template_value(value: local &[u8], out: io.Writer) uint !io.IoError {
    return html.escape_into(value, out) !>
}

class TemplateContent {
    msg: String
    attr: String
    xss: String
}
class TemplateData {
    title: String
    content: TemplateContent
    test: ?String
}
class TemplateExtendContent {
    msg: String
    js: String
}
class TemplateExtendData {
    title: String
    content: TemplateExtendContent
}

test "Templates" {
    let engine = template.Engine.new()
    let data = TemplateData {
        title: "Hello"
        content: TemplateContent {
            msg: "World"
            attr: "\" class=\"test\""
            xss: "<script>alert('test');</script>"
        }
        test: null[String]
    }

    let vdir = __DIR__ + "/../assets/views"
    let options = template.RenderOptions {
        escape: escape_template_value
    }

    let files = #embed_dir("assets/views")
    engine.set_many(files)
    let result = engine.render("pages/test-page.html", data, options) !? E.message
    let expect = fs.read(vdir + "/expect/result-1.html") !? "-?-"

    assert(result == expect)
}

test "Template extending" {
    let engine = template.Engine.new()
    let data = TemplateExtendData {
        title: "Hello"
        content: TemplateExtendContent {
            msg: "World"
            js: "<script>alert('test');</script>"
        }
    }

    let vdir = __DIR__ + "/../assets/views"
    let options = template.RenderOptions {
        escape: escape_template_value
    }

    let files = #embed_dir("assets/views")
    engine.set_many(files)
    let result = engine.render("pages/test-extend.html", data, options) !? E.message
    let expect = fs.read(vdir + "/expect/result-2.html") !? "-?-"

    assert(result == expect)
}

test "Template isset handles missing data" {
    let engine = template.Engine.new()
    engine.set("isset-missing-test", "@if(@isset(missing.value))yes@else no@end")
    let result = engine.render("isset-missing-test", Map[String]{}) ! {
        assert(false)
        return
    }
    assert(result == "no")
}

test "Template conditions compare strings" {
    let engine = template.Engine.new()
    let data = Map[String]{ "title" => "Hello world", "other" => "x" }
    let content = "@if(title == \"Hello world\")yes@else no@end"
    assert(engine.render_content(content, data) !! == "yes")
    content = "@if(title != \"Hello world\")yes@else no@end"
    assert(engine.render_content(content, data) !! == "no")
    content = "@if(title == other)same@elif(other == \"x\")elif@else no@end"
    assert(engine.render_content(content, data) !! == "elif")
    content = "@if(title > \"a\")yes@else no@end"
    assert(engine.render_content(content, data) !! == "no")
}

test "Template content rendering exposes parse errors" {
    let engine = template.Engine.new()
    let rendered = engine.render_content("Hello {{ name }}", Map[String]{ "name" => "Valk" }) ! {
        assert(false)
        return
    }
    assert(rendered == "Hello Valk")

    engine.render_content("@end", Map[String]{}) ! {
        assert(match E : bool { .parse(_, _, _, _) => true default => false })
        return
    }
    assert(false)
}

test "Template values escape by default and raw values are explicit" {
    let engine = template.Engine.new()
    let data = Map[String]{ "value" => "<b title='x'>&</b>" }
    assert(engine.render_content("{{ value }}", data) !! == "&lt;b title=&#39;x&#39;&gt;&amp;&lt;/b&gt;")
    assert(engine.render_content("{{ value }}", data, template.RenderOptions {}) !! == "&lt;b title=&#39;x&#39;&gt;&amp;&lt;/b&gt;")
    assert(engine.render_content("{! value !}", data) !! == "<b title='x'>&</b>")

    let options = template.RenderOptions {
        escape: fn(value: local &[u8], out: io.Writer) uint !io.IoError { return out.write("[" + value.to_string() + "]") !> }
    }
    assert(engine.render_content("{{ value }} {! value !}", Map[String]{ "value" => "raw" }, options) !! == "[raw] raw")
}

test "Template missing values return errors" {
    let engine = template.Engine.new()
    engine.render_content("v={{ nope }}", Map[String]{}) ! {
        assert(match E : bool { .parse(_, _, _, _) => true default => false })
        return
    }
    assert(false)
}

test "Template array subscripts retain numeric indexes" {
    let engine = template.Engine.new()
    let data = Map[Array[Map[String]]]{
        "items" => Array[Map[String]]{
            Map[String]{ "name" => "first" }
        }
    }
    assert(engine.render_content("{{ items[0].name }}", data) !! == "first")
}

test "Template self-include cycles return parse errors" {
    let engine = template.Engine.new()
    engine.set("cycle-self", "@include(\"cycle-self\")")
    engine.render("cycle-self", Map[String]{}) ! {
        assert(match E : bool { .parse(_, _, _, _) => true default => false })
        assert(E.message.contains("cycle-self -> cycle-self"))
        return
    }
    assert(false)
}

test "Template multi-file extension cycles return parse errors" {
    let engine = template.Engine.new()
    engine.set("cycle-a", "@extend(\"cycle-b\")")
    engine.set("cycle-b", "@extend(\"cycle-c\")")
    engine.set("cycle-c", "@extend(\"cycle-a\")")
    engine.render("cycle-a", Map[String]{}) ! {
        assert(match E : bool { .parse(_, _, _, _) => true default => false })
        assert(E.message.contains("cycle-a -> cycle-b -> cycle-c -> cycle-a"))
        return
    }
    assert(false)
}

// Registers depth-0 .. depth-31 in `engine`, each including the next.
fn register_template_depth_chain(engine: template.Engine) {
    let depth: uint = 0
    while depth < 32 {
        let name = "depth-" + depth
        let content = depth == 31 ? "done" : "@include(\"depth-" + (depth + 1) + "\")"
        engine.set(name, content)
        depth++
    }
}

test "Template deep acyclic includes respect max_depth" {
    let engine = template.Engine.new()
    register_template_depth_chain(engine)

    // 31 levels of @include below depth-0; the rendered template itself is not counted.
    let options = template.RenderOptions { max_depth: 31 }
    assert(engine.render("depth-0", Map[String]{}, options) !! == "done")
}

test "Template depth limit returns a parse error" {
    let engine = template.Engine.new()
    register_template_depth_chain(engine)
    let options = template.RenderOptions { max_depth: 30 }
    engine.render("depth-0", Map[String]{}, options) ! {
        assert(match E : bool { .parse(_, _, _, _) => true default => false })
        assert(E.message.contains("maximum of 30"))
        return
    }
    assert(false)
}

test "Template: @isset tests existence, not truthiness" {
    let engine = template.Engine.new()
    let data = json.decode("{\"zero\":0,\"empty\":\"\",\"off\":false,\"none\":null,\"obj\":{\"n\":0}}") !!
    let content = "@if(@isset(zero))a@end @if(@isset(empty))b@end @if(@isset(off))c@end @if(@isset(obj.n))d@end @if(@isset(none))x@end @if(@isset(nope))y@end @if(@isset(obj.nope))z@end"
    assert(engine.render_content(content, data) !! == "a b c d")
}

test "Template: an escape of null writes values unescaped" {
    let engine = template.Engine.new()
    let data = Map[String]{ "v" => "<b>" }
    assert(engine.render_content("{{ v }}", data, template.RenderOptions { escape: null }) !! == "<b>")
    assert(engine.render_content("{{ v }}", data, template.RenderOptions { escape: template.html_escape }) !! == "&lt;b&gt;")
    assert(engine.render_content("{{ v }}", data, template.RenderOptions {}) !! == "&lt;b&gt;")
    assert(engine.render_content("{{ v }}", data, template.RenderOptions { max_depth: 3 }) !! == "&lt;b&gt;")
    assert(engine.render_content("{{ v }}", data) !! == "&lt;b&gt;")
}

test "Template: render and render_content count max_depth the same way" {
    let engine = template.Engine.new()
    engine.set("fix-depth-leaf", "leaf")
    engine.set("fix-depth-mid", "@include(\"fix-depth-leaf\")")
    engine.set("fix-depth-top", "@include(\"fix-depth-mid\")")
    let data = Map[String]{}
    let zero = template.RenderOptions { max_depth: 0 }
    let one = template.RenderOptions { max_depth: 1 }
    let two = template.RenderOptions { max_depth: 2 }

    // No include: fine even at 0, for both.
    assert(engine.render("fix-depth-leaf", data, zero) !! == "leaf")
    assert(engine.render_content("leaf", data, zero) !! == "leaf")
    // One level of include.
    assert(engine.render("fix-depth-mid", data, one) !! == "leaf")
    assert(engine.render_content("@include(\"fix-depth-leaf\")", data, one) !! == "leaf")
    assert((engine.render("fix-depth-mid", data, zero) !? "err") == "err")
    assert((engine.render_content("@include(\"fix-depth-leaf\")", data, zero) !? "err") == "err")
    // Two levels.
    assert(engine.render("fix-depth-top", data, two) !! == "leaf")
    assert(engine.render_content("@include(\"fix-depth-mid\")", data, two) !! == "leaf")
    assert((engine.render("fix-depth-top", data, one) !? "err") == "err")
    assert((engine.render_content("@include(\"fix-depth-mid\")", data, one) !? "err") == "err")
}

test "Template text that names a directive does not shift the skip depth" {
    let engine = template.Engine.new()
    let items = Array[int]{}
    let case = Map[json.Value]{
        "f" => json.from(false),
        "items" => json.from(items),
    }
    // Both words are text in a skipped branch, not branch openers
    assert(engine.render_content("A@if(f)mention @each here@end B", case) !! == "A B")
    assert(engine.render_content("A@if(f)mention @if here@end B", case) !! == "A B")
    let each_case = Map[json.Value]{
        "empty" => json.from(Array[int]{}),
        "f" => json.from(false),
    }
    assert(engine.render_content("S@each(empty as v) X @if Y@end E", each_case) !! == "S E")
    assert(engine.render_content("S@each(empty as v) X @include(\"@each\") Y@end E", each_case) !! == "S E")
}

test "Template extend chains keep the most derived block" {
    let engine = template.Engine.new()
    engine.set("chain-base", "B[@yield(\"t\")]E")
    engine.set("chain-mid", "@extend(\"chain-base\")@block(\"t\")M@end")
    engine.set("chain-leaf", "@extend(\"chain-mid\")@block(\"t\")L@end")
    assert(engine.render("chain-leaf", Map[String]{}) !! == "B[L]E")
    // Without a block of its own, the middle template passes the leaf's one through
    engine.set("chain-mid2", "@extend(\"chain-base\")")
    engine.set("chain-leaf2", "@extend(\"chain-mid2\")@block(\"t\")L@end")
    assert(engine.render("chain-leaf2", Map[String]{}) !! == "B[L]E")
}

test "Template include sees the scope of the loop around it" {
    let engine = template.Engine.new()
    engine.set("scope-frag", "[{{ v }}]")
    let data = Map[json.Value]{
        "items" => json.from(Array[int]{ 1, 2 }),
        "v" => json.from("ROOT"),
    }
    assert(engine.render_content("@each(items as v)@include(\"scope-frag\")@end", data) !! == "[1][2]")
}

// ---- The compiled engine: expressions, whitespace, filters, engines and directives ----

test "Template: conditions take &&, ||, ! and parentheses" {
    let engine = template.Engine.new()
    let data = json.decode("{\"admin\":false,\"name\":\"T\",\"n\":3,\"f\":1.5}") !!
    assert(engine.render_content("@if(admin || name == \"T\")a@end", data) !! == "a")
    assert(engine.render_content("@if(admin && name == \"T\")a@else b@end", data) !! == "b")
    assert(engine.render_content("@if(!admin && (n > 2 || admin))a@end", data) !! == "a")
    assert(engine.render_content("@if(n >= 3 && f < 2.0 && name != \"x\")a@end", data) !! == "a")
    assert(engine.render_content("@if(true && !false && !null)a@end", data) !! == "a")
    assert(engine.render_content("@if(@len(name) == 1 && @isset(f))a@end", data) !! == "a")
}

test "Template: a control directive alone on its line takes the line with it" {
    let engine = template.Engine.new()
    let data = json.decode("{\"items\":[1,2],\"admin\":false,\"t\":\"T\"}") !!
    assert(engine.render_content("<ul>\n@each(items as it)\n<li>{{ it }}</li>\n@end\n</ul>", data) !! == "<ul>\n<li>1</li>\n<li>2</li>\n</ul>")
    assert(engine.render_content("a\n@if(admin)\nx\n@else\ny\n@end\nb", data) !! == "a\ny\nb")
    assert(engine.render_content("a\n    @if(admin)\n    x\n    @end\nb", data) !! == "a\nb")
    // Inline directives keep the text around them as it is
    assert(engine.render_content("a @if(admin)x@else y@end b", data) !! == "a  y b")
    assert(engine.render_content("@each(items as it){{ it }},@end", data) !! == "1,2,")
    // Output on the same line keeps the line
    assert(engine.render_content("{{ t }} @if(admin)x@end\nb", data) !! == "T \nb")
}

test "Template: @empty, @set, comments and escaped directives" {
    let engine = template.Engine.new()
    let data = json.decode("{\"none\":[],\"items\":[1],\"t\":\"T\"}") !!
    assert(engine.render_content("@each(none as x)x@empty none@end", data) !! == "none")
    assert(engine.render_content("@each(items as x)[{{ x }}]@empty none@end", data) !! == "[1]")
    assert(engine.render_content("@set(v = t)@set(w = \"W\"){{ v }}{{ w }}", data) !! == "TW")
    // A loop's @set stays inside the loop
    assert(engine.render_content("@each(items as x)@set(v = x)@end@if(@isset(v))in@else outer@end", data) !! == "outer")
    assert(engine.render_content("a{# hidden #}b\n{# a whole line #}\nc", data) !! == "ab\nc")
    assert(engine.render_content("\\@if(x) and \\{{ t }} stay text", data) !! == "@if(x) and {{ t }} stay text")
    assert(engine.render_content("email @unsafe is text", data) !! == "email @unsafe is text")
}

test "Template: filters" {
    let engine = template.Engine.new()
    let data = json.decode("{\"t\":\"Hello World\",\"items\":[3,1,2],\"price\":12.5,\"o\":{\"a\":1,\"b\":2},\"empty\":\"\",\"raw\":\"<b>\"}") !!
    assert(engine.render_content("{{ t | upper }}|{{ t | lower }}|{{ \"hi\" | capitalize }}", data) !! == "HELLO WORLD|hello world|Hi")
    assert(engine.render_content("{{ items | join(\"-\") }}|{{ items | first }}|{{ items | last }}|{{ items | length }}", data) !! == "3-1-2|3|2|3")
    assert(engine.render_content("{{ items | reverse | join }}", data) !! == "2, 1, 3")
    assert(engine.render_content("{{ price | round(1) }}|{{ price | round }}", data) !! == "12.5|12")
    assert(engine.render_content("{{ t | truncate(5, \"..\") }}|{{ t | truncate(50) }}", data) !! == "Hello..|Hello World")
    // A missing variable is an error even with a default filter behind it
    assert((engine.render_content("{{ nope | default(\"x\") }}", data) !? "E") == "E")
    assert(engine.render_content("{{ empty | default(\"none\") }}|{{ t | default(\"none\") }}", data) !! == "none|Hello World")
    assert(engine.render_content("{{ t | replace(\"World\", \"You\") }}|{{ o | keys | join }}|{{ o | json }}", data) !! == "Hello You|a, b|{&quot;a&quot;:1,&quot;b&quot;:2}")
    assert(engine.render_content("{! o | json !}|{{ raw | escape }}|{! raw | escape !}", data) !! == "{\"a\":1,\"b\":2}|&amp;lt;b&amp;gt;|&lt;b&gt;")
    assert(engine.render_content("{{ \"a b&c\" | urlencode }}|{{ \" \\n x \\t \" | trim }}|{{ \"abc\" | reverse }}", data) !! == "a%20b%26c|x|cba")
    // Filters chain and take expressions as arguments
    assert(engine.render_content("{{ t | truncate(@len(items) + 1, \"\") }}", data) !! == "Hell")
    assert(engine.render_content("{{ t | truncate(@len(items)) | upper }}", data) !! == "HEL…")
    engine.render_content("{{ t | nope }}", data) ! {
        assert(match E : bool { .parse(_, _, _, _) => true default => false })
        assert(E.message.contains("Unknown filter 'nope'"))
        return
    }
    assert(false)
}

test "Template: custom filters and separate engines" {
    let engine = template.Engine.new()
    engine.set_filter("money", fn(v: json.Value, args: Array[json.Value]) json.Value {
        let symbol = args.get(0) !? json.from("$")
        return json.from(symbol.string + v.float.to_string(2))
    })
    let data = json.decode("{\"price\":12.5}") !!
    assert(engine.render_content("{{ price | money }} {{ price | money(\"€\") }}", data) !! == "$12.50 €12.50")

    // A filter is an ordinary closure: it may capture what it needs
    let symbols = Map[String]{ "eur" => "€" }
    engine.set_filter("symbol", fn(v: json.Value, args: Array[json.Value]) json.Value {
        return json.from(symbols.get(v.string) !? "?")
    })
    assert(engine.render_content("{{ \"eur\" | symbol }}{{ \"x\" | symbol }}", data) !! == "€?")

    // A custom filter replaces a built-in one of the same name
    engine.set_filter("upper", fn(v: json.Value, args: Array[json.Value]) json.Value {
        return json.from("UP:" + v.string)
    })
    assert(engine.render_content("{{ \"x\" | upper }}", data) !! == "UP:x")

    // Engines have their own templates and filters
    let other = template.Engine.new()
    engine.set("page", "engine [{{ price | money }}]")
    other.set("page", "other")
    assert(engine.has("page") && other.render("page", data) !! == "other")
    assert(engine.render("page", data) !! == "engine [$12.50]")
    other.render_content("{{ price | money }}", data) ! {
        assert(E.message.contains("Unknown filter 'money'"))
        return
    }
    assert(false)
}

// Each thread runs the initializer of a `global`, so every thread gets an engine of its own
global thread_views: template.Engine (load_thread_views())

fn load_thread_views() template.Engine {
    let engine = template.Engine.new()
    engine.set("greet", "Hi {{ name }}")
    return engine
}

test "Template: a per-thread global engine renders on every thread and recompiles on change" {
    let worker = thread.Thread[String].start(fn() String {
        return thread_views.render("greet", Map[String]{ "name" => "w" }) !? "missing"
    }) !!
    assert(worker.await() == "Hi w")
    assert(thread_views.render("greet", Map[String]{ "name" => "m" }) !! == "Hi m")
    // A new registration replaces the compiled copy on this thread only
    thread_views.set("greet", "Bye {{ name }}")
    assert(thread_views.render("greet", Map[String]{ "name" => "m" }) !! == "Bye m")
    let again = thread.Thread[String].start(fn() String {
        return thread_views.render("greet", Map[String]{ "name" => "w" }) !? "missing"
    }) !!
    assert(again.await() == "Hi w")
}

test "Template: @include with its own data" {
    let engine = template.Engine.new()
    engine.set("card", "[{{ name }}:{{ n }}]")
    let data = json.decode("{\"items\":[{\"name\":\"a\",\"n\":1},{\"name\":\"b\",\"n\":2}],\"name\":\"root\",\"n\":0}") !!
    assert(engine.render_content("@each(items as it)@include(\"card\", it)@end", data) !! == "[a:1][b:2]")
    assert(engine.render_content("@include(\"card\")", data) !! == "[root:0]")
    // The partial sees only the value it was given
    engine.render_content("@include(\"card\", items)", data) ! {
        assert(match E : bool { .parse(_, _, _, _) => true default => false })
        return
    }
    assert(false)
}

test "Template: the engine's escape sets the output format" {
    let data = Map[String]{ "v" => "<b> & 'x'" }
    let html = template.Engine.new()
    assert(html.render_content("{{ v }}", data) !! == "&lt;b&gt; &amp; &#39;x&#39;")

    // Plain text: no escaping at all
    let text = template.Engine.new()
    text.escape = null
    assert(text.render_content("{{ v }}", data) !! == "<b> & 'x'")
    // Options carry their own escape (HTML by default), so a plain-text engine passes its own
    assert(text.render_content("{{ v }}", data, template.RenderOptions { max_depth: 2 }) !! == "&lt;b&gt; &amp; &#39;x&#39;")
    assert(text.render_content("{{ v }}", data, template.RenderOptions { escape: text.escape, max_depth: 2 }) !! == "<b> & 'x'")
    assert(html.render_content("{{ v }}", data, template.RenderOptions { escape: null }) !! == "<b> & 'x'")

    // Another format: SQL-style quoting, written straight into the page
    let sql = template.Engine.new()
    sql.escape = fn(input: local &[u8], out: io.Writer) uint !io.IoError {
        return out.write(input.to_string().replace("'", "''")) !>
    }
    assert(sql.render_content("name = '{{ v }}'", data) !! == "name = '<b> & ''x'''")
    // A per-render option overrides the engine's function
    let shout = template.RenderOptions { escape: fn(value: local &[u8], out: io.Writer) uint !io.IoError { return out.write(value.to_string().upper()) !> } }
    assert(sql.render_content("{{ v }}", data, shout) !! == "<B> & 'X'")
}

class TemplateNumbers {
    count: int
    price: float
    items: Array[String]
    name: String
}

test "Template arithmetic" {
    let engine = template.Engine.new()
    let data = TemplateNumbers { count: 7, price: 2.5, items: Array[String]{ "a", "b", "c" }, name: "box" }
    let render = fn(content: String) String {
        return engine.render_content(content, data) ! return "error: " + E.message
    }
    assert(render("{{ count + 1 }}") == "8")
    assert(render("{{ count - 10 }}") == "-3")
    assert(render("{{ 2 + 3 * 4 }}") == "14")
    assert(render("{{ (2 + 3) * 4 }}") == "20")
    assert(render("{{ count / 2 }}") == "3.5")
    assert(render("{{ 8 / 2 }}") == "4")
    assert(render("{{ count % 3 }}") == "1")
    assert(render("{{ price * 2 }}") == "5")
    assert(render("{{ price + count }}") == "9.5")
    assert(render("{{ -count }}") == "-7")
    assert(render("{{ 10 - -count }}") == "17")
    assert(render("{{ @len(items) - 1 }}") == "2")
    assert(render("{{ name + \"-\" + count }}") == "box-7")
    assert(render("@if(count * 2 > 10)big@else small@end") == "big")
    assert(render("@each(items as item, i, index)[{{ index + 1 }}:{{ item }}]@end") == "[1:a][2:b][3:c]")
    assert(render("@set(total = count * price){{ total }}") == "17.5")
    // Filters bind tighter than arithmetic
    assert(render("{{ @len(items) + items | length }}") == "6")
    // `round` gives a number, so it computes instead of joining text
    assert(render("{{ count + price | round }}") == "9")
    assert(render("{{ count + price | round(1) }}") == "9.5")
    assert(render("{{ 1e3 }}|{{ 2.5E-1 * 4 }}|{{ 1e+2 }}") == "1000|1|100")
    // `fixed` keeps the trailing zeros as text
    assert(render("{{ 12.5 | fixed }}|{{ 3 | fixed(1) }}|{{ 2.675 | fixed(0) }}") == "12.50|3.0|3")
    // A whole number beyond int is a float, and int.$min / -1 does not trap
    assert(render("{{ 99999999999999999999 > count }}") == "true")
    assert(render("{{ (-9223372036854775807 - 1) / -1 }}") == "-9223372036854775808")
    assert(render("{{ (-9223372036854775807 - 1) % -1 }}") == "0")

    assert(render("{{ count / 0 }}").contains("Division by zero"))
    assert(render("{{ count - name }}").contains("'-' needs numbers, not a number and text"))
    assert(render("{{ price % 2 }}").contains("'%' needs integers"))
    assert(render("{{ -name }}").contains("'-' needs a number"))
}

test "Template render reports a syntax error of a registered template as a parse error" {
    let engine = template.Engine.new()
    engine.set("broken", "line one\n@end")
    let parse = false
    engine.render("broken", Map[String]{}) ! {
        parse = match E : bool { .parse(name, _, _, _) => name == "broken" default => false }
    }
    assert(parse)
    let missing = false
    engine.render("not-registered", Map[String]{}) ! {
        missing = match E : bool { .template_not_found(_, _) => true default => false }
    }
    assert(missing)
}

class TemplateTypedRow {
    id: int
    message: String
    secret: String $tag(json: "-")
    renamed: String $tag(json: "label")
}

class TemplateOmitRow {
    name: String
    note: String $tag(omitempty)
}

class TemplateTypedPage {
    title: String
    rows: Array[TemplateTypedRow]
    empty: Array[TemplateTypedRow]
    omit_rows: Array[TemplateOmitRow]
}

test "Template typed structs and array cursors match json semantics" {
    let engine = template.Engine.new()
    engine.set("row-partial", "{{ id }}:{{ label }}={{ message }}")
    let data = TemplateTypedPage {
        title: "Fortunes"
        rows: Array[TemplateTypedRow]{
            TemplateTypedRow { id: 1, message: "<b>first</b>", secret: "x", renamed: "a" }
            TemplateTypedRow { id: 2, message: "plain message longer than sixteen bytes & more", secret: "y", renamed: "b" }
        }
        empty: Array[TemplateTypedRow]{}
        omit_rows: Array[TemplateOmitRow]{
            TemplateOmitRow { name: "only", note: "" }
        }
    }

    // Typed @each cursor, escaping, json tags, @isset, @len, indexing, filters
    let tpl = "{{ title }}|{{ @len(rows) }}|{{ rows | length }}|{{ rows[1].label }}|@each(rows as r, i)[{{ i }}:{{ r.id }}:{{ r.label }}:{{ r.message }}:@if(@isset(r.secret))bad@else ok@end]@end|@each(empty as r)nope@empty none@end"
    assert(engine.render_content(tpl, data) !! == "Fortunes|2|2|b|[0:1:a:&lt;b&gt;first&lt;/b&gt;: ok][1:2:b:plain message longer than sixteen bytes &amp; more: ok]| none")

    // `@set` must snapshot the cursor item rather than aliasing the mutable loop cursor across iterations
    let snap = "@each(rows as r, i)@if(i == 0)@set(first = r)@end@if(i == 1){{ first.id }}:{{ first.label }}/{{ r.id }}:{{ r.label }}@end@end"
    assert(engine.render_content(snap, data) !! == "1:a/2:b")

    // `@include` with a cursor item
    let inc = "@each(rows as r)[@include(\"row-partial\", r)]@end"
    assert(engine.render_content(inc, data) !! == "[1:a=&lt;b&gt;first&lt;/b&gt;][2:b=plain message longer than sixteen bytes &amp; more]")

    // `omitempty` fields still omit empty values just like `json.from`
    let omit = "@each(omit_rows as o){{ o.name }}:@if(@isset(o.note))has@else omitted@end@end"
    assert(engine.render_content(omit, data) !! == "only: omitted")
}

// ---- Layouts, blocks, multi-level inheritance, @super() and Engine.loader ----

test "Template: base layout default blocks, selective overrides and standalone render" {
    let engine = template.Engine.new()
    engine.set("base", "<head><title>@block(\"title\")Default Title@end</title></head><body><nav>@block(\"nav\")Home@end</nav><main>@block(\"content\")Empty@end</main></body>")
    engine.set("page", "@extend(\"base\")\n@block(\"content\")Hello {{ name }}@end")

    let data = Map[String]{ "name" => "Valk" }
    // Rendering the base directly uses every default block
    assert(engine.render("base", data) !! == "<head><title>Default Title</title></head><body><nav>Home</nav><main>Empty</main></body>")
    // Child overrides only `content`; `title` and `nav` keep their defaults
    assert(engine.render("page", data) !! == "<head><title>Default Title</title></head><body><nav>Home</nav><main>Hello Valk</main></body>")
}

test "Template: multi-level inheritance with @super() across 3 levels" {
    let engine = template.Engine.new()
    engine.set("base", "[T:@block(\"title\")Site@end][B:@block(\"body\")BaseBody@end]")
    engine.set("mid", "@extend(\"base\")\n@block(\"title\")@super() / Docs@end\n@block(\"body\")Mid(@super())@end")
    engine.set("leaf", "@extend(\"mid\")\n@block(\"title\")@super() / Templates@end\n@block(\"body\")Leaf[@super()]@end")

    assert(engine.render("leaf", Map[String]{}) !! == "[T:Site / Docs / Templates][B:Leaf[Mid(BaseBody)]]")

    // Skipping the middle layer: @super() jumps straight to base
    engine.set("mid-pass", "@extend(\"base\")")
    engine.set("leaf-pass", "@extend(\"mid-pass\")\n@block(\"title\")@super() - Direct@end")
    assert(engine.render("leaf-pass", Map[String]{}) !! == "[T:Site - Direct][B:BaseBody]")

    // Base with @yield + mid defining block + leaf composing with @super()
    engine.set("yield-base", "(@yield(\"x\"))")
    engine.set("yield-mid", "@extend(\"yield-base\")@block(\"x\")Mid@end")
    engine.set("yield-leaf", "@extend(\"yield-mid\")@block(\"x\")@super()+Leaf@end")
    assert(engine.render("yield-leaf", Map[String]{}) !! == "(Mid+Leaf)")
}

test "Template: nested blocks, @yield defaults and loop-safe base blocks" {
    let engine = template.Engine.new()
    engine.set("nested-base", "@block(\"outer\")<h>@block(\"inner\")BaseInner@end</h>@end")
    // Override only inner
    engine.set("nested-inner", "@extend(\"nested-base\")@block(\"inner\")ChildInner@end")
    assert(engine.render("nested-inner", Map[String]{}) !! == "<h>ChildInner</h>")
    // Override outer without @super() replaces everything
    engine.set("nested-outer", "@extend(\"nested-base\")@block(\"outer\")Replaced@end")
    assert(engine.render("nested-outer", Map[String]{}) !! == "Replaced")
    // Override both outer (with @super()) and inner
    engine.set("nested-both", "@extend(\"nested-base\")@block(\"outer\")[ @super() ]@end@block(\"inner\")@super()!@end")
    assert(engine.render("nested-both", Map[String]{}) !! == "[ <h>BaseInner!</h> ]")

    // @yield with default expression
    engine.set("ybase", "<title>@yield(\"title\", fallback)</title><p>@yield(\"body\", \"<b>def</b>\")</p>")
    engine.set("ychild", "@extend(\"ybase\")@block(\"title\")Custom@end")
    let data = Map[String]{ "fallback" => "A & B" }
    assert(engine.render("ybase", data) !! == "<title>A &amp; B</title><p>&lt;b&gt;def&lt;/b&gt;</p>")
    assert(engine.render("ychild", data) !! == "<title>Custom</title><p>&lt;b&gt;def&lt;/b&gt;</p>")

    // Base block inside @each must not duplicate fallback entries across iterations
    let items = json.decode("{\"items\":[1,2,3]}") !!
    engine.set("loop-base", "@each(items as n)@block(\"item\"){{ n }}@end,@end")
    engine.set("loop-child", "@extend(\"loop-base\")@block(\"item\")[@super()]@end")
    assert(engine.render("loop-base", items) !! == "1,2,3,")
    assert(engine.render("loop-child", items) !! == "[1],[2],[3],")

    // @set scoping across multi-level inheritance
    engine.set("set-base", "@yield(\"a\")|@yield(\"b\")")
    engine.set("set-mid", "@extend(\"set-base\")@set(x = \"mid\")@block(\"b\"){{ x }}@end")
    engine.set("set-leaf", "@extend(\"set-mid\")@set(x = \"leaf\")@block(\"a\"){{ x }}@end")
    assert(engine.render("set-leaf", Map[String]{}) !! == "leaf|mid")
}

test "Template: @super() with no parent block returns a parse error with line and column" {
    let engine = template.Engine.new()
    engine.set("ybase", "@yield(\"body\")")
    engine.set("bad-super", "@extend(\"ybase\")\n@block(\"body\")\n  @super()\n@end")
    engine.render("bad-super", Map[String]{}) ! {
        assert(E.template_name == "bad-super")
        assert(E.line == 3)
        assert(E.column == 3)
        assert(E.message.contains("No parent block named 'body'"))
        return
    }
    assert(false)
}

test "Template: Engine.loader resolves layouts, includes, remove and clear_cache" {
    let engine = template.Engine.new()
    let ver = Array[int]{ 1 }
    engine.loader = fn(name: String) ?String {
        let v = ver.get(0) !? 0
        if name == "layout.html" : return "[@block(\"body\")v" + v + "@end]"
        if name == "part.html" : return "P" + v
        if name == "page.html" : return "@extend(\"layout.html\")@block(\"body\")@super()-@include(\"part.html\")@end"
        return null
    }
    assert(engine.render("page.html", Map[String]{}) !! == "[v1-P1]")

    // Cached until clear_cache()
    ver.set(0, 2) ! {}
    assert(engine.render("page.html", Map[String]{}) !! == "[v1-P1]")
    engine.clear_cache()
    assert(engine.render("page.html", Map[String]{}) !! == "[v2-P2]")

    // Registered templates override loader; remove() restores fallback
    engine.set("part.html", "STATIC")
    assert(engine.has("part.html"))
    assert(engine.render("page.html", Map[String]{}) !! == "[v2-STATIC]")
    engine.remove("part.html")
    assert(!engine.has("part.html"))
    assert(engine.render("page.html", Map[String]{}) !! == "[v2-P2]")

    // Unknown template via loader returns .template_not_found
    let not_found = false
    engine.render("nope.html", Map[String]{}) ! {
        not_found = match E : bool { .template_not_found(n, _) => n == "nope.html" default => false }
    }
    assert(not_found)
}

// ---- Context-aware auto-escaping ----

test "Template: context-aware auto-escaping for HTML text, quoted and unquoted attributes" {
    let engine = template.Engine.new()
    let data = Map[String]{
        "text" => "<script>x</script> & \"'\"",
        "attr" => "\" onmouseover=\"alert(1)",
        "unq" => "btn onclick=alert(1) `x`><b>",
        "empty" => "",
    }
    assert(engine.render_content("<p>{{ text }}</p>", data) !! == "<p>&lt;script&gt;x&lt;/script&gt; &amp; &quot;&#39;&quot;</p>")
    assert(engine.render_content("<div title=\"{{ attr }}\"></div>", data) !! == "<div title=\"&quot; onmouseover=&quot;alert(1)\"></div>")
    assert(engine.render_content("<div title='{{ attr }}'></div>", data) !! == "<div title='&quot; onmouseover=&quot;alert(1)'></div>")
    assert(engine.render_content("<div class={{ unq }}></div>", data) !! == "<div class=btn&#32;onclick&#61;alert(1)&#32;&#96;x&#96;&gt;&lt;b&gt;></div>")
    assert(engine.render_content("<div class={{ empty }}></div>", data) !! == "<div class=\"\"></div>")
    // Single-quoted strings inside expressions work cleanly inside double-quoted attributes
    assert(engine.render_content("<div title=\"{{ empty | default('Anon') }}\"></div>", data) !! == "<div title=\"Anon\"></div>")
}

test "Template: context-aware auto-escaping for URL attributes" {
    let engine = template.Engine.new()
    let data = Map[String]{
        "https_url" => "https://example.com/a?x=1&y=2",
        "http_url" => "http://example.com",
        "mailto_url" => "mailto:hi@example.com",
        "rel_url" => "/users/42?a=1&b=2",
        "js_url" => "javascript:alert(1)",
        "js_upper" => "JAVASCRIPT:alert(1)",
        "js_obf" => "  java&#x09;script:alert(1)",
        "vbs_url" => "vbscript:msgbox(1)",
        "data_url" => "data:text/html,<script>alert(1)</script>",
        "rest" => "script:alert(1)",
        "q" => "javascript:search&x=1",
    }

    // Allowed schemes and relative URLs pass through HTML-escaped
    assert(engine.render_content("<a href=\"{{ https_url }}\">x</a>", data) !! == "<a href=\"https://example.com/a?x=1&amp;y=2\">x</a>")
    assert(engine.render_content("<a href=\"{{ http_url }}\">x</a>", data) !! == "<a href=\"http://example.com\">x</a>")
    assert(engine.render_content("<a href=\"{{ mailto_url }}\">x</a>", data) !! == "<a href=\"mailto:hi@example.com\">x</a>")
    assert(engine.render_content("<a href=\"{{ rel_url }}\">x</a>", data) !! == "<a href=\"/users/42?a=1&amp;b=2\">x</a>")

    // Dangerous schemes are blocked across URL attributes
    assert(engine.render_content("<a href=\"{{ js_url }}\">x</a>", data) !! == "<a href=\"\">x</a>")
    assert(engine.render_content("<a href=\"{{ js_upper }}\">x</a>", data) !! == "<a href=\"\">x</a>")
    assert(engine.render_content("<a href=\"{{ js_obf }}\">x</a>", data) !! == "<a href=\"\">x</a>")
    assert(engine.render_content("<img src=\"{{ vbs_url }}\">", data) !! == "<img src=\"\">")
    assert(engine.render_content("<form action=\"{{ data_url }}\"></form>", data) !! == "<form action=\"\"></form>")
    assert(engine.render_content("<button formaction=\"{{ js_url }}\"></button>", data) !! == "<button formaction=\"\"></button>")
    assert(engine.render_content("<video poster=\"{{ js_url }}\"></video>", data) !! == "<video poster=\"\"></video>")
    assert(engine.render_content("<blockquote cite=\"{{ js_url }}\"></blockquote>", data) !! == "<blockquote cite=\"\"></blockquote>")
    assert(engine.render_content("<object data=\"{{ data_url }}\"></object>", data) !! == "<object data=\"\"></object>")

    // Unquoted rejected URL becomes `""` so following attributes cannot become the URL
    assert(engine.render_content("<a href={{ js_url }} class=x></a>", data) !! == "<a href=\"\" class=x></a>")

    // Partial scheme prefix injection is caught
    assert(engine.render_content("<a href=\"java{{ rest }}\"></a>", data) !! == "<a href=\"java\"></a>")

    // Relative / query prefix fixes the scheme so query values containing colons stay intact
    assert(engine.render_content("<a href=\"/search?q={{ q }}\"></a>", data) !! == "<a href=\"/search?q=javascript:search&amp;x=1\"></a>")
}

test "Template: context-aware auto-escaping for <script>, event handlers and <style>" {
    let engine = template.Engine.new()
    let data = json.decode("{\"name\":\"O'Brien </script>\\n\\\"x\\\"\",\"tpl\":\"${evil}\",\"n\":42,\"ok\":true,\"none\":null,\"obj\":{\"tag\":\"</script><script>\"},\"color\":\"#1a2b3c\",\"bad_css\":\"red; }</style><script>alert(1)</script>\",\"url_css\":\"url(javascript:alert(1))\",\"css_str\":\"hi\\\"</style>\"}") !!

    // <script> string literals (double, single, template literal)
    assert(engine.render_content("<script>const a = \"{{ name }}\";</script>", data) !! == "<script>const a = \"O\\u0027Brien \\u003c\\/script\\u003e\\n\\\"x\\\"\";</script>")
    assert(engine.render_content("<script>const b = '{{ name }}';</script>", data) !! == "<script>const b = 'O\\u0027Brien \\u003c\\/script\\u003e\\n\\\"x\\\"';</script>")
    assert(engine.render_content("<script>const c = `{{ tpl }}`;</script>", data) !! == "<script>const c = `\\u0024{evil}`;</script>")

    // <script> value positions (numbers, bool, null, strings, objects)
    assert(engine.render_content("<script>const n = {{ n }}, b = {{ ok }}, z = {{ none }};</script>", data) !! == "<script>const n = 42, b = true, z = null;</script>")
    assert(engine.render_content("<script>const s = {{ name }};</script>", data) !! == "<script>const s = \"O\\u0027Brien \\u003c\\/script\\u003e\\n\\\"x\\\"\";</script>")
    assert(engine.render_content("<script>const o = {{ obj }};</script>", data) !! == "<script>const o = {\"tag\":\"\\u003c/script\\u003e\\u003cscript\\u003e\"};</script>")

    // JS comments with apostrophes must not desync string state
    assert(engine.render_content("<script>\n// don't break\nconst x = {{ n }};\n</script>", data) !! == "<script>\n// don't break\nconst x = 42;\n</script>")

    // Event handler attributes (both string and value)
    assert(engine.render_content("<button onclick=\"hi('{{ name }}', {{ n }})\"></button>", data) !! == "<button onclick=\"hi('O\\u0027Brien \\u003c\\/script\\u003e\\n\\u0022x\\u0022', 42)\"></button>")
    assert(engine.render_content("<button onclick=\"hi({{ obj }})\"></button>", data) !! == "<button onclick=\"hi({&quot;tag&quot;:&quot;\\u003c/script\\u003e\\u003cscript\\u003e&quot;})\"></button>")

    // <style> and inline style="..."
    assert(engine.render_content("<style>body { color: {{ color }}; }</style>", data) !! == "<style>body { color: #1a2b3c; }</style>")
    let bad_style = engine.render_content("<style>body { color: {{ bad_css }}; }</style>", data) !!
    assert(!bad_style.contains("</style><script>"))
    assert(!bad_style.contains(";}"))
    let bad_url_css = engine.render_content("<div style=\"background: {{ url_css }}\"></div>", data) !!
    assert(!bad_url_css.contains("url("))
    assert(!bad_url_css.contains("javascript:"))
    let css_quoted = engine.render_content("<style>.a::before { content: \"{{ css_str }}\"; }</style>", data) !!
    assert(css_quoted == "<style>.a::before { content: \"hi\\22 \\3c \\2f style\\3e \"; }</style>")
}

test "Template: raw opt-out ({! !} and | raw), auto_escape toggle and inherited contexts" {
    let engine = template.Engine.new()
    let data = Map[String]{
        "html" => "<b>ok</b>",
        "js_url" => "javascript:void(0)",
        "name" => "a\"</script>",
    }

    // Both `{! !}` and `{{ ... | raw }}` bypass auto-escaping
    assert(engine.render_content("{! html !}|{{ html | raw }}|{{ html | upper | raw }}", data) !! == "<b>ok</b>|<b>ok</b>|<B>OK</B>")
    assert(engine.render_content("<a href=\"{{ js_url | raw }}\">x</a>", data) !! == "<a href=\"javascript:void(0)\">x</a>")

    // Custom `raw` filter takes precedence if explicitly registered
    let custom = template.Engine.new()
    custom.set_filter("raw", fn(v: json.Value, args: Array[json.Value]) json.Value {
        return json.from("CUSTOM:" + v.string)
    })
    assert(custom.render_content("{{ html | raw }}", data) !! == "CUSTOM:&lt;b&gt;ok&lt;/b&gt;")

    // Disabling context-aware auto_escape falls back to plain HTML entity escaping
    assert(engine.render_content("<a href=\"{{ js_url }}\">x</a>", data, template.RenderOptions { auto_escape: false }) !! == "<a href=\"javascript:void(0)\">x</a>")
    let plain_html = template.Engine.new()
    plain_html.auto_escape = false
    assert(plain_html.render_content("<a href=\"{{ js_url }}\">x</a>", data) !! == "<a href=\"javascript:void(0)\">x</a>")
    assert(plain_html.render_content("<a href=\"{{ js_url }}\">x</a>", data, template.RenderOptions { auto_escape: true }) !! == "<a href=\"\">x</a>")

    // Context propagates into @yield / @include placed inside <script> or href="..."
    engine.set("js-base", "<script>@yield(\"init\")</script>")
    engine.set("js-page", "@extend(\"js-base\")@block(\"init\")const u = \"{{ name }}\";@end")
    assert(engine.render("js-page", data) !! == "<script>const u = \"a\\\"\\u003c\\/script\\u003e\";</script>")

    engine.set("url-frag", "{{ js_url }}")
    assert(engine.render_content("<a href=\"@include('url-frag')\">x</a>", data) !! == "<a href=\"\">x</a>")
}

class TemplateCtxItem {
    id: int
    name: String
    url: String
    color: String
}

class TemplateCtxModel {
    user: TemplateCtxItem
    items: Array[TemplateCtxItem]
}

test "Template: typed rendering works with context-aware auto-escaping" {
    let engine = template.Engine.new()
    let model = TemplateCtxModel {
        user: TemplateCtxItem { id: 7, name: "A\"</script>", url: "https://valk.dev/?a=1&b=2", color: "#00ff00" }
        items: Array[TemplateCtxItem]{
            TemplateCtxItem { id: 1, name: "<b>one</b>", url: "javascript:alert(1)", color: "red;}" }
            TemplateCtxItem { id: 2, name: "two", url: "/ok?x=1&y=2", color: "blue" }
        }
    }
    let tpl = "<script>const u = {{ user }}; const id = {{ user.id }}; const n = \"{{ user.name }}\";</script>@each(items as it)<a href=\"{{ it.url }}\" style=\"color: {{ it.color }}\" data-id={{ it.id }}>{{ it.name }}</a>@end"
    let out = engine.render_content(tpl, model) !!
    assert(out.contains("const id = 7;"))
    assert(out.contains("const n = \"A\\\"\\u003c\\/script\\u003e\";"))
    assert(out.contains("\"name\":\"A\\\"\\u003c/script\\u003e\""))
    assert(out.contains("<a href=\"\" style=\"color: red\\3b \\7d \" data-id=1>&lt;b&gt;one&lt;/b&gt;</a>"))
    assert(out.contains("<a href=\"/ok?x=1&amp;y=2\" style=\"color: blue\" data-id=2>two</a>"))
}

// ---- Sharper line & column parse errors ----

fn expect_parse_error(engine: template.Engine, src: String, line: uint, col: uint, substr: String) {
    engine.render_content(src, Map[String]{ "a" => "1" }) ! {
        assert(match E : bool { .parse(_, _, _, _) => true default => false })
        assert(E.line == line)
        assert(E.column == col)
        assert(E.message.contains("line " + line + ", column " + col))
        assert(E.message.contains(substr))
        return
    }
    assert(false)
}

test "Template: sharp line and column parse errors for syntax mistakes" {
    let engine = template.Engine.new()

    // Unclosed comment
    expect_parse_error(engine, "hi\n  {# no end", 2, 3, "Unclosed comment")
    // Unclosed output tag
    expect_parse_error(engine, "line1\n  {{ a", 2, 7, "Expected '}}'")
    expect_parse_error(engine, "{! a", 1, 5, "Expected '!}'")
    // Empty output expression
    expect_parse_error(engine, "x {{ }}", 1, 6, "Unexpected '}}'")
    // Unclosed @if, @each, @block point to the opener's exact line and column
    expect_parse_error(engine, "a\n  @if(a)\n    hi", 2, 3, "Unclosed '@if'")
    expect_parse_error(engine, "  @each(a as x)\nhi", 1, 3, "Unclosed '@each'")
    expect_parse_error(engine, "a\nb\n   @block(\"x\")\nhi", 3, 4, "Unclosed '@block'")
    // Mismatched / stray closers
    expect_parse_error(engine, "ok\n  @end", 2, 3, "Unexpected '@end'")
    expect_parse_error(engine, "@each(a as x)\n  @else\n@end", 2, 3, "only valid inside '@if'")
    expect_parse_error(engine, "@if(a)\n  @else\n  @elif(a)\n@end", 3, 3, "after '@else'")
    expect_parse_error(engine, "@if(a)\n  @empty\n@end", 2, 3, "only valid inside '@each'")
    expect_parse_error(engine, "@each(a as x)\n  @empty\n  @empty\n@end", 3, 3, "after '@empty'")
    // Unclosed string literals (double and single quotes)
    expect_parse_error(engine, "x\n  {{ \"unterminated }}", 2, 6, "Unclosed string literal")
    expect_parse_error(engine, "{{ 'unterminated }}", 1, 4, "Unclosed string literal")
    // Invalid expressions
    expect_parse_error(engine, "{{ a + }}", 1, 8, "Unexpected '}}'")
    expect_parse_error(engine, "{{ (a }}", 1, 7, "Expected ')'")
    expect_parse_error(engine, "{{ a[0 }}", 1, 8, "Expected ']'")
    expect_parse_error(engine, "{{ a. }}", 1, 7, "Expected a name")
    expect_parse_error(engine, "{{ a | }}", 1, 8, "Expected a name")
    expect_parse_error(engine, "{{ @bogus(1) }}", 1, 4, "Unknown function '@bogus'")
    // Duplicate block
    expect_parse_error(engine, "@block(\"x\")1@end\n  @block(\"x\")2@end", 2, 3, "Duplicate block 'x'")
    // Invalid @extend placement and duplicate @extend
    expect_parse_error(engine, "@if(a)\n  @extend(\"base\")\n@end", 2, 3, "@extend cannot be placed inside")
    expect_parse_error(engine, "@extend(\"a\")\n  @extend(\"b\")", 2, 3, "only have one @extend")
    // @super() outside @block
    expect_parse_error(engine, "hi\n    @super()", 2, 5, "@super() can only be used inside a @block")
    // Empty directive names
    expect_parse_error(engine, "@extend(\"\")", 1, 9, "Template name cannot be empty")
    expect_parse_error(engine, "@include(\"\")", 1, 10, "Template name cannot be empty")
    expect_parse_error(engine, "@block(\"\")@end", 1, 8, "Block name cannot be empty")
    expect_parse_error(engine, "@yield(\"\")", 1, 8, "Block name cannot be empty")

    // Compile error includes a caret source snippet
    engine.render_content("line1\n  {{ a + }}", Map[String]{ "a" => "1" }) ! {
        assert(E.message.contains("2 |   {{ a + }}"))
        assert(E.message.contains("^"))
        assert(E.to_string() == E.message)
        return
    }
    assert(false)
}

test "Template: render-time errors report exact line and column" {
    let engine = template.Engine.new()
    let data = json.decode("{\"user\":{\"name\":\"Valk\"},\"n\":5}") !!

    // Missing variable
    engine.render_content("ok\n  {{ missing_var }}", data) ! {
        assert(E.line == 2)
        assert(E.column == 6)
        assert(E.message.contains("Data not found: 'missing_var'"))
    }
    // Missing property
    engine.render_content("ok\n  {{ user.nope }}", data) ! {
        assert(E.line == 2)
        assert(E.column == 11)
        assert(E.message.contains("Property not found: 'nope'"))
    }
    // Unknown filter
    engine.render_content("{{ n | no_such_filter }}", data) ! {
        assert(E.line == 1)
        assert(E.column == 8)
        assert(E.message.contains("Unknown filter 'no_such_filter'"))
    }
    // Division by zero
    engine.render_content("x\n{{ n / 0 }}", data) ! {
        assert(E.line == 2)
        assert(E.column == 6)
        assert(E.message.contains("Division by zero"))
    }
    // Missing parent layout reports @extend line and column
    engine.set("orphan", "line1\n  @extend(\"no-layout\")")
    engine.render("orphan", data) ! {
        assert(E.template_name == "orphan")
        assert(E.line == 2)
        assert(E.column == 3)
        assert(E.message.contains("Template not found: no-layout"))
    }
    // Cyclic @extend reports the closing @extend's exact line and column
    engine.set("cyc1", "@extend(\"cyc2\")")
    engine.set("cyc2", "line1\n    @extend(\"cyc1\")")
    engine.render("cyc1", data) ! {
        assert(E.template_name == "cyc2")
        assert(E.line == 2)
        assert(E.column == 5)
        assert(E.message.contains("cyc1 -> cyc2 -> cyc1"))
    }
}


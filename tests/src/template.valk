
use valk.template
use valk.json
use valk.thread
use valk.fs
use valk.html

fn escape_template_value(value: String) String {
    return html.escape(value)
}

class TemplateContent {
    msg: String
    attr: String
    xss: String
}
class TemplateData {
    title: String
    content: TemplateContent
    test: ?String
}
class TemplateExtendContent {
    msg: String
    js: String
}
class TemplateExtendData {
    title: String
    content: TemplateExtendContent
}

test "Templates" {
    let data = TemplateData {
        title: "Hello"
        content: TemplateContent {
            msg: "World"
            attr: "\" class=\"test\""
            xss: "<script>alert('test');</script>"
        }
        test: null[String]
    }

    let vdir = __DIR__ + "/../assets/views"
    let options = template.RenderOptions {
        escape: escape_template_value
    }

    let files = #embed_dir("assets/views")
    template.set_content_many(files)
    let result = template.render("pages/test-page.html", data, options) !? E.message
    let expect = fs.read(vdir + "/expect/result-1.html") !? "-?-"

    assert(result == expect)
}

test "Template extending" {
    let data = TemplateExtendData {
        title: "Hello"
        content: TemplateExtendContent {
            msg: "World"
            js: "<script>alert('test');</script>"
        }
    }

    let vdir = __DIR__ + "/../assets/views"
    let options = template.RenderOptions {
        escape: escape_template_value
    }

    let files = #embed_dir("assets/views")
    template.set_content_many(files)
    let result = template.render("pages/test-extend.html", data, options) !? E.message
    let expect = fs.read(vdir + "/expect/result-2.html") !? "-?-"

    assert(result == expect)
}

test "Template isset handles missing data" {
    template.set_content("isset-missing-test", "@if(@isset(missing.value))yes@else no@end")
    let result = template.render("isset-missing-test", Map[String]{}) ! {
        assert(false)
        return
    }
    assert(result == "no")
}

test "Template conditions compare strings" {
    let data = Map[String]{ "title" => "Hello world", "other" => "x" }
    let content = "@if(title == \"Hello world\")yes@else no@end"
    assert(template.render_content(content, data) !! == "yes")
    content = "@if(title != \"Hello world\")yes@else no@end"
    assert(template.render_content(content, data) !! == "no")
    content = "@if(title == other)same@elif(other == \"x\")elif@else no@end"
    assert(template.render_content(content, data) !! == "elif")
    content = "@if(title > \"a\")yes@else no@end"
    assert(template.render_content(content, data) !! == "no")
}

test "Template content rendering exposes parse errors" {
    let rendered = template.render_content("Hello {{ name }}", Map[String]{ "name" => "Valk" }) ! {
        assert(false)
        return
    }
    assert(rendered == "Hello Valk")

    template.render_content("@end", Map[String]{}) ! {
        assert(E.code == E.parse)
        return
    }
    assert(false)
}

test "Template values escape by default and raw values are explicit" {
    let data = Map[String]{ "value" => "<b title='x'>&</b>" }
    assert(template.render_content("{{ value }}", data) !! == "&lt;b title=&#39;x&#39;&gt;&amp;&lt;/b&gt;")
    assert(template.render_content("{{ value }}", data, template.RenderOptions {}) !! == "&lt;b title=&#39;x&#39;&gt;&amp;&lt;/b&gt;")
    assert(template.render_content("{! value !}", data) !! == "<b title='x'>&</b>")

    let options = template.RenderOptions {
        escape: fn(value: String) String { return "[" + value + "]" }
    }
    assert(template.render_content("{{ value }} {! value !}", Map[String]{ "value" => "raw" }, options) !! == "[raw] raw")
}

test "Template missing values return errors" {
    template.render_content("v={{ nope }}", Map[String]{}) ! {
        assert(E.code == E.parse)
        return
    }
    assert(false)
}

test "Template array subscripts retain numeric indexes" {
    let data = Map[Array[Map[String]]]{
        "items" => Array[Map[String]]{
            Map[String]{ "name" => "first" }
        }
    }
    assert(template.render_content("{{ items[0].name }}", data) !! == "first")
}

test "Template self-include cycles return parse errors" {
    template.set_content("cycle-self", "@include(\"cycle-self\")")
    template.render("cycle-self", Map[String]{}) ! {
        assert(E.code == E.parse)
        assert(E.message.contains("cycle-self -> cycle-self"))
        return
    }
    assert(false)
}

test "Template multi-file extension cycles return parse errors" {
    template.set_content("cycle-a", "@extend(\"cycle-b\")")
    template.set_content("cycle-b", "@extend(\"cycle-c\")")
    template.set_content("cycle-c", "@extend(\"cycle-a\")")
    template.render("cycle-a", Map[String]{}) ! {
        assert(E.code == E.parse)
        assert(E.message.contains("cycle-a -> cycle-b -> cycle-c -> cycle-a"))
        return
    }
    assert(false)
}

// Registers depth-0 .. depth-31, each including the next. Tests run in any order and the
// registry is shared by all threads, so every test that renders the chain registers it.
fn register_template_depth_chain() {
    let depth: uint = 0
    while depth < 32 {
        let name = "depth-" + depth
        let content = depth == 31 ? "done" : "@include(\"depth-" + (depth + 1) + "\")"
        template.set_content(name, content)
        depth++
    }
}

test "Template deep acyclic includes respect max_depth" {
    register_template_depth_chain()

    // 31 levels of @include below depth-0; the rendered template itself is not counted.
    let options = template.RenderOptions { max_depth: 31 }
    assert(template.render("depth-0", Map[String]{}, options) !! == "done")
}

test "Template depth limit returns a parse error" {
    register_template_depth_chain()
    let options = template.RenderOptions { max_depth: 30 }
    template.render("depth-0", Map[String]{}, options) ! {
        assert(E.code == E.parse)
        assert(E.message.contains("maximum of 30"))
        return
    }
    assert(false)
}

test "Template: @isset tests existence, not truthiness" {
    let data = json.decode("{\"zero\":0,\"empty\":\"\",\"off\":false,\"none\":null,\"obj\":{\"n\":0}}") !!
    let content = "@if(@isset(zero))a@end @if(@isset(empty))b@end @if(@isset(off))c@end @if(@isset(obj.n))d@end @if(@isset(none))x@end @if(@isset(nope))y@end @if(@isset(obj.nope))z@end"
    assert(template.render_content(content, data) !! == "a b c d")
}

test "Template: an escape of null writes values unescaped" {
    let data = Map[String]{ "v" => "<b>" }
    assert(template.render_content("{{ v }}", data, template.RenderOptions { escape: null }) !! == "<b>")
    assert(template.render_content("{{ v }}", data, template.RenderOptions {}) !! == "&lt;b&gt;")
    assert(template.render_content("{{ v }}", data, template.RenderOptions { max_depth: 3 }) !! == "&lt;b&gt;")
    assert(template.render_content("{{ v }}", data) !! == "&lt;b&gt;")
}

test "Template: render and render_content count max_depth the same way" {
    template.set_content("fix-depth-leaf", "leaf")
    template.set_content("fix-depth-mid", "@include(\"fix-depth-leaf\")")
    template.set_content("fix-depth-top", "@include(\"fix-depth-mid\")")
    let data = Map[String]{}
    let zero = template.RenderOptions { max_depth: 0 }
    let one = template.RenderOptions { max_depth: 1 }
    let two = template.RenderOptions { max_depth: 2 }

    // No include: fine even at 0, for both.
    assert(template.render("fix-depth-leaf", data, zero) !! == "leaf")
    assert(template.render_content("leaf", data, zero) !! == "leaf")
    // One level of include.
    assert(template.render("fix-depth-mid", data, one) !! == "leaf")
    assert(template.render_content("@include(\"fix-depth-leaf\")", data, one) !! == "leaf")
    assert((template.render("fix-depth-mid", data, zero) !? "err") == "err")
    assert((template.render_content("@include(\"fix-depth-leaf\")", data, zero) !? "err") == "err")
    // Two levels.
    assert(template.render("fix-depth-top", data, two) !! == "leaf")
    assert(template.render_content("@include(\"fix-depth-mid\")", data, two) !! == "leaf")
    assert((template.render("fix-depth-top", data, one) !? "err") == "err")
    assert((template.render_content("@include(\"fix-depth-mid\")", data, one) !? "err") == "err")
}

test "Template: templates registered on one thread render on another" {
    template.set_content("fix-thread-page", "Hi {{ name }} @include(\"fix-thread-part\")")
    template.set_content_many(Map[String]{ "fix-thread-part" => "from {! where !}" })
    let worker = thread.Thread[String].start(fn() String {
        return template.render("fix-thread-page", Map[String]{ "name" => "<w>", "where" => "<t>" }) !? "missing"
    }) !!
    assert(worker.await() == "Hi &lt;w&gt; from <t>")

    let other = thread.Thread[bool].start(fn() bool {
        template.set_content("fix-thread-late", "late")
        return true
    }) !!
    assert(other.await())
    assert(template.render("fix-thread-late", Map[String]{}) !! == "late")
}

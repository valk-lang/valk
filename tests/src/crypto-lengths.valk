use valk.crypto

// Every length from 0 to 300 and a few around larger block multiples, so that each
// padding case and the whole-block path are covered. Expected values come from
// Python's hashlib: the hash of all the digests, one after another

fn length_data(length: uint) String {
    let out = ByteBuffer.new(length)
    let x: u32 = 12345
    let i: uint = 0
    while i < length {
        x = x * 1103515245 + 12345
        out.write_byte((x >> 16).to(u8))
        i++
    }
    return out.to_string()
}

fn test_lengths() Array[uint] {
    let lengths = Array[uint].new()
    each 0..301 as n : lengths.append(n)
    lengths.append(1023)
    lengths.append(1024)
    lengths.append(1025)
    lengths.append(100000)
    return lengths
}

// The digest of the digests of every test length, each fed in pieces of `step` bytes
fn digest_of_lengths(algorithm: crypto.HashAlgorithm, step: uint) String {
    let data = length_data(100000)
    let bytes: &[u8] = data
    let all = crypto.hasher(algorithm)
    let size = crypto.digest_size(algorithm)
    let out = [u8]{ 0 x size }
    each test_lengths() as length {
        let h = crypto.hasher(algorithm)
        let i: uint = 0
        while i < length {
            let n = step
            if n > length - i : n = length - i
            h.update(bytes.view(i, n))
            i += n
        }
        h.finish(out)
        all.update(out)
    }
    all.finish(out)
    return crypto.hex_encode(out)
}

test "Hashes: every padding length, whole and in pieces" {
    let md5 = "a4001e9ffdd85c16534bd1fd99e85131"
    let sha1 = "0d7e4b9dbe416ec58c3e964fa5a7c423d30ee36b"
    let sha256 = "a170e6a51a67d051b306ce712600b594f95fa922ca90fa862ca9d2c10a64de4b"
    let sha384 = "bf6059829679b5bfd7df659c1843d0e58db1622ace9065ef7c7380353234099754eb426116772e0afb971c349175af68"
    let sha512 = "5b264d540bfaafa5a991f2212e41d67b7bb9c312e6269fa65960ee87f9d5a91514f6e53c3bb71284d699ebad1afb06a75de270ff9376c45cacfdac68709e3a80"
    each Array[uint]{ 100000, 1, 7, 64, 129 } as step {
        assert(digest_of_lengths(crypto.HashAlgorithm.md5, step) == md5)
        assert(digest_of_lengths(crypto.HashAlgorithm.sha1, step) == sha1)
        assert(digest_of_lengths(crypto.HashAlgorithm.sha256, step) == sha256)
        assert(digest_of_lengths(crypto.HashAlgorithm.sha384, step) == sha384)
        assert(digest_of_lengths(crypto.HashAlgorithm.sha512, step) == sha512)
    }
}

test "Blake2b and Hmac: every padding length" {
    let data = length_data(100000)
    let bytes: &[u8] = data
    let blake = crypto.Blake2b.new(64) ! panic("blake2b")
    let mac256 = crypto.Hmac.new(crypto.HashAlgorithm.sha256, "key")
    let mac512 = crypto.Hmac.new(crypto.HashAlgorithm.sha512, length_data(200))
    each test_lengths() as length {
        let b = crypto.Blake2b.new(64) ! panic("blake2b")
        b.update(bytes.view(0, length))
        let out = [u8]{ 0 x 64 }
        b.finalize(out)
        blake.update(out)
        mac256.update(crypto.Hmac.sign(crypto.HashAlgorithm.sha256, "key", bytes.view(0, length)))
        mac512.update(crypto.Hmac.sign(crypto.HashAlgorithm.sha512, length_data(200), bytes.view(0, length)))
    }
    let out = [u8]{ 0 x 64 }
    blake.finalize(out)
    assert(crypto.hex_encode(out) == "cc5b3e56960454e96ebdd6578b7e38d72801327068430ee63ff39f16211413e68225feaf704f6d893114a004d554aadd94239503385e1360a993f013de78f31a")
    mac256.finish(out)
    assert(crypto.hex_encode(out.view(0, 32)) == "37ec7bb7be81716972e4f368e35020a395f4be24404297cf7c86813bf5d8e597")
    mac512.finish(out)
    assert(crypto.hex_encode(out) == "a3d191f9f11d5bef04d92b3a72319a4f8d2bbb8a6f79ac1dfd2f16d73bd76d7656687d945ee84b1f745c18c376f3cf5e2ca1b4e7c2e7bf0da8cd1ac4ec260197")
}

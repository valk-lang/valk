use valk.json

// A type alias naming `Array[json.Value]` instantiates that class before the stdlib's
// `extend Array[T]` blocks are attached; the instantiation must still get their methods.
type ValueList (fn(Array[json.Value])(uint))

test "Generics: an instantiation named by a type alias gets later extend methods" {
    let count: ValueList = fn(items: Array[json.Value]) uint { return items.length }
    let values = json.decode_to[Array[json.Value]]("[1, 2, 3]") !? Array[json.Value]{}
    assert(count(values) == 3)
}

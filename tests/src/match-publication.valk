class MatchPublicationItem { number: int }
shared match_publication_saved: ?MatchPublicationItem (null)
fn match_publish(item: shared MatchPublicationItem) int {
    match_publication_saved = item
    return 1
}
fn match_retain_again(item: shared MatchPublicationItem) int {
    match_publication_saved = item
    let first = item.number
    match_publication_saved = item
    return first + item.number
}

synctest "Shared publication: storing a shared parameter does not consume it" {
    let item: shared MatchPublicationItem = MatchPublicationItem { number: 73 }
    assert(match_retain_again(item) == 146)
    assert(match_retain_again(item) == 146)
    assert(item.number == 73)
    let saved = match_publication_saved ?? panic("missing")
    assert(saved.number == 73)
    match_publication_saved = null
}

synctest "Match publication: a failed condition reaches the selected case" {
    let source = MatchPublicationItem { number: 79 }
    let selected = 0
    while true {
        match source.number {
            match_publish(source) => { selected = 1; break }
            79 => { selected = 2; break }
            default => break
        }
    }
    assert(selected == 2)
    let saved = match_publication_saved ?? panic("missing")
    assert(saved.number == 79)
    match_publication_saved = null
}

synctest "Match publication: a fresh value permits the next iteration" {
    let index = 0
    let total = 0
    while index++ < 2 {
        let source = MatchPublicationItem { number: index }
        let selected = match 0 : int {
            match_publish(source) => 73
            default => 79
        }
        total += selected
    }
    assert(total == 158)
    let saved = match_publication_saved ?? panic("missing")
    assert(saved.number == 2)
    match_publication_saved = null
}

synctest "Match publication: nested matches preserve the cached outer input" {
    let source = MatchPublicationItem { number: 83 }
    let selected = 0
    while true {
        match source.number {
            match 0 : int {
                0 => match_publish(source)
                default => 0
            } => { selected = 1; break }
            83 => { selected = 2; break }
            default => break
        }
    }
    assert(selected == 2)
    match_publication_saved = null
}

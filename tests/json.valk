
use valk:json
use valk:fs

test "Json" {
    let str = "{ \"msg\": \"hello\", \"sub\": { \"msg\": \"world\" } }"
    let data = json:decode(str) ! {
        assert(false)
        return
    }
    assert(data.get_or("msg").string() == "hello")
    assert(data.get_or("sub").get_or("msg").string() == "world")

    let sub = data.get_or("sub")
    sub.set("msg", json:new_string("modified"))
    let enc = sub.encode()

    assert(enc == "{\"msg\":\"modified\"}")
}

class JsonTest{
    v1: String ("Hello")
    v2: int (123)
    v3: int (-123)
    v4: uint (-123)
    v5: JsonSub (JsonSub{})
    v6: Array[Map[String]] (.{ .{ "a" => "b" }, .{ "c" => "d" } })
    v7: f64 (-123.056700)
    v8: f64 (-123.0)
}
class JsonSub{
    v1: String ("World")
}

test "Json convert" {
    let ob = JsonTest{}
    let json = json:encode_to_string(ob, true)
    let compare = "{
    \"v1\": \"Hello\",
    \"v2\": 123,
    \"v3\": -123,
    \"v4\": -123,
    \"v5\": {
        \"v1\": \"World\"
    },
    \"v6\": [
        {
            \"a\": \"b\"
        },
        {
            \"c\": \"d\"
        }
    ],
    \"v7\": -123.0567,
    \"v8\": -123
}"
    assert(json == compare)
    if json != compare {
        println("result: '" + json + "'")
        println("expected: '" + compare + "'")
        // println("'" + json.escape() + "'")
        // println("'" + compare.escape() + "'")
    }

    let jval = json:value(ob)
    let ob2 = json:to_type[JsonTest](jval)
    assert(ob2.v1 == "Hello")
    assert(ob2.v5.v1 == "World")
}

test "Json decode" {
    let json = #embed("tests/assets/parse.json")

    let value = json:decode(json) !? <{
        println(E.message)
        assert(false)
        return json:new_null()
    }

    value.encode(true)
    // let enc = value.encode(true)
    // assert(enc == json)
}

test "Json escape" {
    // The escape table is indexed by a raw byte, so it has to cover the whole u8
    // range: non-ASCII UTF-8 used to read past its end and emit garbage escapes.
    let text = "em dash — accents éü and a tab\there"
    let enc = json:encode_to_string(text)
    assert(enc == "\"em dash — accents éü and a tab\\there\"")
    let back = json:decode(enc) ! {
        assert(false)
        return
    }
    assert(back.string() == text)
    // Round trip through a document, where the string is a value rather than the
    // whole payload.
    let ob = json:new_object()
    ob.set("k", json:new_string(text))
    let doc = json:decode(ob.encode()) ! {
        assert(false)
        return
    }
    assert(doc.get_or("k").string() == text)
}

test "Json unicode escapes" {
    // \uXXXX is how most encoders write anything non-ASCII, so it has to decode
    // even though this package never emits it for those characters.
    assert(json_decoded("\"caf\\u00e9\"") == "café")
    assert(json_decoded("\"\\u20ac\"") == "€")
    assert(json_decoded("\"A\\u0041\"") == "AA")
    // Outside the basic multiplane the code point arrives as a surrogate pair
    assert(json_decoded("\"\\ud83d\\ude00\"") == "😀")
    // An unpaired surrogate is not a code point, so it becomes U+FFFD. A
    // character following a high surrogate is still read as itself.
    assert(json_decoded("\"\\ud83d\"") == "�")
    assert(json_decoded("\"\\ud83dX\"") == "�X")
    // A truncated or non-hex escape is a parse error, not a silent pass-through
    assert(json_decoded("\"\\u004\"") == "<parse-error>")
    assert(json_decoded("\"\\uZZZZ\"") == "<parse-error>")
}

test "Json control character round trip" {
    // 0x0b has no short escape, so it can only travel as \u000b. Decoding is
    // also how the character gets here: valk string literals have no \u form.
    let text = json_decoded("\"a\\u000bb\"")
    assert(text.bytes == 3)
    assert(@ptrv(text.data, u8, 1) == 11)
    assert(json:encode_to_string(text) == "\"a\\u000bb\"")
}

fn json_decoded(str: String) String {
    let v = json:decode(str) ! return "<parse-error>"
    return v.string()
}

use valk:json
use valk:gc

class JsonTest {
    v1: String ("Hello")
    v2: int (123)
    v3: int (-123)
    v4: uint (123)
    v5: JsonSub (JsonSub{})
    v6: Array[Map[String]] (.{ .{ "a" => "b" }, .{ "c" => "d" } })
    v7: f64 (-123.056700)
    v8: f64 (-123.0)
}

class JsonSub {
    v1: String ("World")
}

test "Json: parse, inspect, mutate and stringify" {
    let document = json:parse("{\"name\":\"Alice\",\"age\":30,\"active\":true,\"score\":4.5,\"missing\":null,\"tags\":[\"one\",\"two\"]}") ! {
        assert(false)
        return
    }
    let object = document.as_object() ! {
        assert(false)
        return
    }

    assert(((object.get("name") !? null).as_string() !? "") == "Alice")
    assert(((object.get("age") !? null).as_int() !? 0) == 30)
    assert((object.get("active") !? null).as_bool() !? false)
    assert(((object.get("score") !? null).as_float() !? 0.0) == 4.5)
    assert((object.get("missing") !? "not null").is_null())

    let tags = (object.get("tags") !? null).as_array() ! {
        assert(false)
        return
    }
    assert(tags.length() == 2)
    assert(((tags.get(1) !? null).as_string() !? "") == "two")

    object.set("name", "Valk")
    let encoded = json:stringify(object)
    let decoded = json:parse(encoded) !? null
    assert(decoded.get_or_null("name").string_or("") == "Valk")
}

test "Json: Value façade provides direct object and array access" {
    let user = json:parse("{\"name\":\"Alice\",\"tags\":[\"one\"]}") ! {
        assert(false)
        return
    }

    assert(user.is_object())
    assert(((user.get("name") !? null).as_string() !? "") == "Alice")
    assert(user.get_or_null("missing").is_null())

    user.set("name", "Valk") ! {
        assert(false)
        return
    }
    assert(((user.get("name") !? null).as_string() !? "") == "Valk")

    let tags = user.get("tags") !? null
    assert(tags.is_array())
    assert(((tags.get_index(0) !? null).as_string() !? "") == "one")
    tags.append("two") ! {
        assert(false)
        return
    }
    assert((tags.length() !? 0) == 2)
}

test "Json: construct concrete containers" {
    let object = json:object()
    object.set("message", "hello")

    let items = json:array()
    items.append(1)
    items.append(null)
    object.set("items", items)

    assert(json:stringify(object) == "{\"message\":\"hello\",\"items\":[1,null]}")
}

test "Json: typed conversion" {
    let original = JsonTest{}
    let value = json:to_value(original)
    let converted = json:from_value[JsonTest](value) ! {
        assert(false)
        return
    }

    assert(converted.v1 == "Hello")
    assert(converted.v3 == -123)
    assert(converted.v4 == 123)
    assert(converted.v5.v1 == "World")
    assert(converted.v6.length == 2)
    assert(((converted.v6.get(1) !? .{}).get("c") !? "") == "d")
    assert(converted.v7 == -123.0567)
    assert(converted.v8 == -123.0)
}

test "Json: to_value preserves an existing Value" {
    let scalar: json:Value = 42
    let converted = json:to_value(scalar)
    assert((converted.as_int() !? 0) == 42)

    scalar = "text"
    converted = json:to_value(scalar)
    assert(converted.string_or("") == "text")

    scalar = null
    converted = json:to_value(scalar)
    assert(converted.is_null())
}

test "Json: accessors are strict" {
    let failed = false
    let wrong: json:Value = "12"
    wrong.as_int() ! { failed = true }
    assert(failed)

    failed = false
    wrong = "false"
    wrong.as_bool() ! { failed = true }
    assert(failed)

    failed = false
    wrong = 42
    wrong.length() ! { failed = true }
    assert(failed)

    let object = json:object()
    object.get("missing") ! { failed = true }
    assert(failed)
    assert(object.get_or_null("missing").is_null())
}

test "Json: stringify into an existing ByteBuffer" {
    let output = ByteBuffer.$default_value
    output.write_string("prefix:")
    let value = json:to_value(Map[String]{ "value" => "text" })
    let encoded = json:stringify_to(value, output)
    assert(encoded.to_string() == "prefix:{\"value\":\"text\"}")
}

test "Json: escaped strings round trip" {
    let text = "em dash — accents éü and a tab\there"
    let encoded = json:stringify(text)
    assert(encoded == "\"em dash — accents éü and a tab\\there\"")
    assert(json_decoded(encoded) == text)
}

test "Json: unicode escapes" {
    assert(json_decoded("\"caf\\u00e9\"") == "café")
    assert(json_decoded("\"\\u20ac\"") == "€")
    assert(json_decoded("\"A\\u0041\"") == "AA")
    assert(json_decoded("\"\\ud83d\\ude00\"") == "😀")
    assert(json_decoded("\"\\ud83d\"") == "�")
    assert(json_decoded("\"\\ud83dX\"") == "�X")
    assert(json_decoded("\"\\u004\"") == "<parse-error>")
    assert(json_decoded("\"\\uZZZZ\"") == "<parse-error>")
    assert(json_decoded("\"bad\\qescape\"") == "<parse-error>")
    assert(json_decoded("\"escaped\\/slash\"") == "escaped/slash")
}

test "Json: number grammar and range errors" {
    let first_number = json:parse("1.25e2") !? null
    assert((first_number.as_float() !? 0.0) == 125.0)
    let second_number = json:parse("-2E-2") !? null
    assert((second_number.as_float() !? 0.0) == -0.02)
    assert(json_parse_fails("-"))
    assert(json_parse_fails("01"))
    assert(json_parse_fails("1."))
    assert(json_parse_fails("1e"))
    assert(json_parse_fails("92233720368547758070"))
}

test "Json: control character round trip" {
    let text = json_decoded("\"a\\u000bb\"")
    assert(text.bytes == 3)
    assert(@ptrv(text.data, u8, 1) == 11)
    assert(json:stringify(text) == "\"a\\u000bb\"")
    assert(json_parse_fails("\"raw\nline\""))
}

synctest "Json: GC traces recursive union values" {
    let document = json:parse("{\"items\":[{\"name\":\"alive\"}],\"count\":1}") ! {
        assert(false)
        return
    }
    gc:collect()
    let items = document.get_or_null("items").array_or_empty()
    let first = items.get_or_null(0)
    assert(first.get_or_null("name").string_or("") == "alive")
}

fn json_decoded(text: String) String {
    let value = json:parse(text) ! return "<parse-error>"
    return value.as_string() !? "<not-string>"
}

fn json_parse_fails(text: String) bool {
    json:parse(text) ! return true
    return false
}

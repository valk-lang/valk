@ignore_access

#if OS == "linux"
use valk:io

test "io_uring: partial submission accounting" {
    io:uring_unsubmitted = 5

    assert(io:uring_record_submitted(2) == 2)
    assert(io:uring_unsubmitted == 3)

    assert(io:uring_record_submitted(3) == 3)
    assert(io:uring_unsubmitted == 0)
}

test "io_uring: a submit larger than the count does not wrap" {
    // The ring can drain entries this counter never saw. The count is unsigned,
    // so the result has to be zero rather than a wrapped-around huge number.
    io:uring_unsubmitted = 2
    assert(io:uring_record_submitted(5) == 5)
    assert(io:uring_unsubmitted == 0)

    io:uring_unsubmitted = 0
    assert(io:uring_record_submitted(1) == 1)
    assert(io:uring_unsubmitted == 0)
}
#end

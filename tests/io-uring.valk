@ignore_access

#if OS == "linux"
use valk:io

test "io_uring: partial submission accounting" {
    io:uring_unsubmitted = 5

    assert(io:uring_record_submitted(2) == 2)
    assert(io:uring_unsubmitted == 3)

    assert(io:uring_record_submitted(3) == 3)
    assert(io:uring_unsubmitted == 0)
}
#end

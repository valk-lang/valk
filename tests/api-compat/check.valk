// Compares the public standard-library API against the last stable release.
//
// Usage:
//   check <baseline.json> <current.json> [allowed-changes.txt]
//   check --write <baseline.json> <api.json>   (normalizes `valk doc` output into a baseline)
//
// Everything the baseline declares must still exist with the same signature; adding
// declarations, trailing arguments with defaults, and widening access is allowed.
// Changes that would break existing callers are reported as `BREAK` lines; a line in the
// allowed-changes file naming the declaration accepts one on purpose.

use valk.fs
use valk.json

global breaks: uint (0)
global additions: uint (0)
global allowed: Array[String] (.{})
global allowed_used: Array[String] (.{})

fn main(args: Array[String]) {
    let first = args.get(1) !? ""
    if first == "--write" {
        let out = args.get(2) ! usage()
        let source = args.get(3) ! usage()
        write_baseline(out, source)
        return
    }
    let baseline_path = args.get(1) ! usage()
    let current_path = args.get(2) ! usage()
    let allowed_path = args.get(3) !? null
    if isset(allowed_path) : allowed = read_allowed(allowed_path)

    let baseline = load(baseline_path)
    let current = load(current_path)
    compare_namespaces(baseline["namespaces"], current["namespaces"])

    each allowed as entry {
        if !allowed_used.contains(entry) : println("NOTE " + entry + ": listed as an allowed change but nothing changed there")
    }
    println("API compatibility: " + breaks.to(String) + " breaking change(s), " + additions.to(String) + " addition(s)")
    if breaks > 0 : exit(1)
}

fn usage() $exit {
    println("Usage: check <baseline.json> <current.json> [allowed-changes.txt]")
    println("       check --write <baseline.json> <api.json>")
    exit(2)
}

fn load(path: String) json.Value {
    let text = fs.read(path) ! panic("Cannot read " + path)
    return json.decode(text) ! panic("Invalid JSON in " + path)
}

fn read_allowed(path: String) Array[String] {
    let text = fs.read(path) ! panic("Cannot read " + path)
    let result = Array[String]{}
    each text.split("\n") as line {
        let entry = line.split("#").get(0) !? ""
        entry = entry.trim(" ").trim("\t").trim("\r")
        if entry.is_empty() : continue
        result.append(entry)
    }
    return result
}

// ---- Baseline -----------------------------------------------------------------------

fn write_baseline(out: String, source: String) {
    let doc = load(source)
    strip(doc)
    fs.write(out, json.encode(doc, true) + "\n") ! panic("Cannot write " + out)
    println("Wrote " + out)
}

// Drops descriptions and sorts members so the baseline diffs cleanly
fn strip(value: json.Value) {
    match value {
        json.ObjectValue as object => {
            object.remove("description")
            object.values.sort_keys()
            each object.values as member : strip(member)
        }
        json.ArrayValue as array => {
            each array.values as item : strip(item)
        }
        default => {}
    }
}

// ---- Reporting ----------------------------------------------------------------------

fn report(path: String, reason: String) {
    let accepted = false
    each allowed as entry {
        if entry == path || path.starts_with(entry + ".") {
            accepted = true
            if !allowed_used.contains(entry) : allowed_used.append(entry)
        }
    }
    if accepted {
        println("ALLOWED " + path + ": " + reason)
        return
    }
    breaks++
    println("BREAK " + path + ": " + reason)
}

fn added(path: String, what: String) {
    additions++
    println("ADDED " + path + " (" + what + ")")
}

fn str(value: json.Value, key: String) String {
    return value[key].string_value() !? ""
}

fn members(value: json.Value) Map[json.Value] {
    let object = value.object_value() ! return Map[json.Value]{}
    return object.values
}

fn items(value: json.Value) Array[json.Value] {
    let array = value.array_value() ! return Array[json.Value]{}
    return array.values
}

fn list_text(value: json.Value) String {
    let parts = Array[String]{}
    each items(value) as item : parts.append(item.string_value() !? "?")
    return parts.join(", ")
}

// A parameter may widen to a type every old argument still converts to: a `String` to a
// byte view, a borrowed view to a `local` one
fn type_widens(old: String, new: String) bool {
    if old == new : return true
    if old == "String" : return new == "&[u8]" || new == "local &[u8]"
    if old == "&[u8]" : return new == "local &[u8]"
    if old == "mut &[u8]" : return new == "local mut &[u8]"
    return false
}

// Read-only access may widen to writable; anything else must stay the same
fn access_ok(old: String, new: String) bool {
    if old == new : return true
    if new == "+" : return old == "~" || old == "~+" || old == "-~+"
    if new == "~+" : return old == "~"
    return false
}

// ---- Namespaces ---------------------------------------------------------------------

fn compare_namespaces(baseline: json.Value, current: json.Value) {
    let cur = members(current)
    each members(baseline) as ns, name {
        let now = cur.get(name) ! {
            report(name, "namespace removed")
            continue
        }
        compare_functions(name, ns["functions"], now["functions"], false)
        compare_classes(name, ns["classes"], now["classes"])
        compare_globals(name, ns["globals"], now["globals"])
        compare_aliases(name, ns["aliases"], now["aliases"])
        compare_errors(name, ns["errors"], now["errors"])
        compare_enums(name, ns["enums"], now["enums"])
    }
    each cur as ns, name {
        if !baseline.has(name) : added(name, "namespace")
    }
}

fn compare_functions(prefix: String, baseline: json.Value, current: json.Value, interface: bool) {
    let cur = members(current)
    each members(baseline) as func, name {
        let path = prefix + "." + name
        let now = cur.get(name) ! {
            report(path, "removed")
            continue
        }
        compare_function(path, func, now)
    }
    each cur as func, name {
        if baseline.has(name) : continue
        // Every implementer of an interface has to add the method
        if interface : report(prefix + "." + name, "added to an interface; existing implementations no longer compile")
        else : added(prefix + "." + name, "function")
    }
}

fn compare_function(path: String, old: json.Value, new: json.Value) {
    if !access_ok(str(old, "act"), str(new, "act")) : report(path, "access changed from '" + str(old, "act") + "' to '" + str(new, "act") + "'")
    if old["is_static"].bool != new["is_static"].bool : report(path, "static changed")
    if old["is_getter"].bool != new["is_getter"].bool : report(path, "getter changed")
    if str(old, "return-type") != str(new, "return-type") : report(path, "return type changed from '" + str(old, "return-type") + "' to '" + str(new, "return-type") + "'")
    let old_error = old["error_type"].string_value() !? "none"
    let new_error = new["error_type"].string_value() !? "none"
    if old_error != new_error : report(path, "error type changed from '" + old_error + "' to '" + new_error + "'")
    if list_text(old["generics"]) != list_text(new["generics"]) : report(path, "generic parameters changed")

    let old_args = items(old["arguments"])
    let new_args = items(new["arguments"])
    each old_args as arg, i {
        let now = new_args.get(i) ! {
            report(path, "argument '" + str(arg, "name") + "' removed")
            continue
        }
        let arg_path = path + "(" + str(arg, "name") + ")"
        if str(arg, "name") != str(now, "name") : report(arg_path, "argument renamed to '" + str(now, "name") + "'")
        if !type_widens(str(arg, "type"), str(now, "type")) : report(arg_path, "argument type changed from '" + str(arg, "type") + "' to '" + str(now, "type") + "'")
        if arg.has("default-value") {
            if !now.has("default-value") : report(arg_path, "default value removed")
            else if str(arg, "default-value") != str(now, "default-value") : report(arg_path, "default value changed from '" + str(arg, "default-value") + "' to '" + str(now, "default-value") + "'")
        }
    }
    let i = old_args.length
    while i < new_args.length {
        let arg = new_args.get(i) ! break
        if !arg.has("default-value") : report(path, "new argument '" + str(arg, "name") + "' has no default value")
        i++
    }
}

fn compare_classes(prefix: String, baseline: json.Value, current: json.Value) {
    let cur = members(current)
    each members(baseline) as class, name {
        let path = prefix + "." + name
        let now = cur.get(name) ! {
            report(path, "removed")
            continue
        }
        if str(class, "kind") != str(now, "kind") : report(path, "kind changed from '" + str(class, "kind") + "' to '" + str(now, "kind") + "'")
        if !access_ok(str(class, "act"), str(now, "act")) : report(path, "access changed from '" + str(class, "act") + "' to '" + str(now, "act") + "'")
        if list_text(class["generics"]) != list_text(now["generics"]) : report(path, "generic parameters changed")
        if str(class, "slice_type") != str(now, "slice_type") : report(path, "element type changed")
        if str(class, "mode_for") != str(now, "mode_for") : report(path, "mode base changed")
        each items(class["interfaces"]) as interface {
            let iname = interface.string_value() !? ""
            if !list_text(now["interfaces"]).split(", ").contains(iname) : report(path, "no longer implements '" + iname + "'")
        }
        if class.has("alternatives") && list_text(class["alternatives"]) != list_text(now["alternatives"]) {
            report(path, "union alternatives changed from [" + list_text(class["alternatives"]) + "] to [" + list_text(now["alternatives"]) + "]")
        }
        compare_properties(path, class["properties"], now["properties"])
        compare_functions(path, class["functions"], now["functions"], str(class, "kind") == "interface")
        if class.has("extensions") : compare_functions(path, class["extensions"], now["extensions"], false)
    }
    each cur as class, name {
        if !baseline.has(name) : added(prefix + "." + name, str(class, "kind"))
    }
}

fn compare_properties(prefix: String, baseline: json.Value, current: json.Value) {
    let cur = members(current)
    each members(baseline) as prop, name {
        let path = prefix + "." + name
        let now = cur.get(name) ! {
            report(path, "property removed")
            continue
        }
        if str(prop, "type") != str(now, "type") : report(path, "property type changed from '" + str(prop, "type") + "' to '" + str(now, "type") + "'")
        if !access_ok(str(prop, "act"), str(now, "act")) : report(path, "property access changed from '" + str(prop, "act") + "' to '" + str(now, "act") + "'")
    }
    each cur as prop, name {
        if !baseline.has(name) : added(prefix + "." + name, "property")
    }
}

fn compare_globals(prefix: String, baseline: json.Value, current: json.Value) {
    let cur = members(current)
    each members(baseline) as g, name {
        let path = prefix + "." + name
        let now = cur.get(name) ! {
            report(path, "global removed")
            continue
        }
        if str(g, "type") != str(now, "type") : report(path, "global type changed from '" + str(g, "type") + "' to '" + str(now, "type") + "'")
        if g["shared"].bool != now["shared"].bool : report(path, "global shared-ness changed")
        if !access_ok(str(g, "act"), str(now, "act")) : report(path, "global access changed")
    }
    each cur as g, name {
        if !baseline.has(name) : added(prefix + "." + name, "global")
    }
}

fn compare_aliases(prefix: String, baseline: json.Value, current: json.Value) {
    let cur = members(current)
    each members(baseline) as a, name {
        let path = prefix + "." + name
        let now = cur.get(name) ! {
            report(path, str(a, "kind") + " removed")
            continue
        }
        if str(a, "kind") != str(now, "kind") : report(path, "changed from " + str(a, "kind") + " to " + str(now, "kind"))
        else if str(a, "for") != str(now, "for") : report(path, str(a, "kind") + " changed from '" + str(a, "for") + "' to '" + str(now, "for") + "'")
        if a.has("access") && !access_ok(str(a, "access"), str(now, "access")) : report(path, "access changed")
    }
    each cur as a, name {
        if !baseline.has(name) : added(prefix + "." + name, str(a, "kind"))
    }
}

fn compare_errors(prefix: String, baseline: json.Value, current: json.Value) {
    let cur = members(current)
    each members(baseline) as e, name {
        let path = prefix + "." + name
        let now = cur.get(name) ! {
            report(path, "error type removed")
            continue
        }
        let new_codes = list_text(now["codes"]).split(", ")
        let old_codes = list_text(e["codes"]).split(", ")
        each old_codes as code {
            if !new_codes.contains(code) : report(path, "error code '" + code + "' removed")
        }
        each new_codes as code {
            // An exhaustive `match E.code` in a caller stops compiling
            if !old_codes.contains(code) : report(path, "error code '" + code + "' added; exhaustive matches on the codes no longer compile")
        }
        if list_text(e["extends"]) != list_text(now["extends"]) : report(path, "extends changed from [" + list_text(e["extends"]) + "] to [" + list_text(now["extends"]) + "]")
        let new_payload = members(now["payload"])
        each members(e["payload"]) as field, field_name {
            let now_field = new_payload.get(field_name) ! {
                report(path + "." + field_name, "payload field removed")
                continue
            }
            if str(field, "type") != str(now_field, "type") : report(path + "." + field_name, "payload type changed")
            if field.has("default-value") && !now_field.has("default-value") : report(path + "." + field_name, "payload default removed")
        }
        each new_payload as field, field_name {
            if e["payload"].has(field_name) : continue
            if !field.has("default-value") : report(path + "." + field_name, "new payload field without a default; every throw site must set it")
            else : added(path + "." + field_name, "payload field")
        }
    }
    each cur as e, name {
        if !baseline.has(name) : added(prefix + "." + name, "error")
    }
}

fn compare_enums(prefix: String, baseline: json.Value, current: json.Value) {
    let cur = members(current)
    each members(baseline) as e, name {
        let path = prefix + "." + name
        let now = cur.get(name) ! {
            report(path, "enum removed")
            continue
        }
        if str(e, "type") != str(now, "type") : report(path, "enum type changed")
        if !access_ok(str(e, "act"), str(now, "act")) : report(path, "access changed")
        let old_items = Map[json.Value]{}
        each items(e["items"]) as item : old_items.set(str(item, "name"), item)
        let new_items = Map[json.Value]{}
        each items(now["items"]) as item : new_items.set(str(item, "name"), item)
        each old_items as item, item_name {
            let now_item = new_items.get(item_name) ! {
                report(path + "." + item_name, "enum item removed")
                continue
            }
            if str(item, "value") != str(now_item, "value") : report(path + "." + item_name, "enum value changed")
        }
        each new_items as item, item_name {
            if !old_items.has(item_name) : report(path + "." + item_name, "enum item added; exhaustive matches no longer compile")
        }
    }
    each cur as e, name {
        if !baseline.has(name) : added(prefix + "." + name, "enum")
    }
}

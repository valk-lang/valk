/// A box holding one value of `T`.
///
/// ```valk
/// Box[uint]{ 3 }.get() == 3
/// ```
+ class Box[T] {
    /// The type of the stored value.
    + get value_type : T {
        return @undefined
    }

    // A plain comment, not documentation.
    + fn get(value: T) T {
        return value
    }
}

/// A class declared before the generic one it is compared against.
+ class Ahead {
    + fn name() String {
        return "ahead"
    }
}

/// Picks `value` for the caller.
///
/// Generic documentation is kept on every instantiation.
+ fn choose[K, V](key: K, value: V) V {
    return value
}

/// Two values of the same type.
+ struct Pair[T] {
    /// The first half.
    + first: T
    + second: T

    /// Returns `first`.
    + fn left() T {
        return this.first
    }
}

extend Box[X] {
    #if X.$is_type_of(String)
    /// Shouts the value.
    + fn shout() String {
        return "loud"
    }
    #end
}

+ fn use_boxes(text: Box[String], number: Box[uint]) {}

//// A separator line is not documentation.
+ fn separator() {}

/// Detached by the blank line below, so it documents nothing.

+ fn detached() {}

/// Number of boxes alive in tests.
+ global box_count: uint (0)

fn hidden_target() {}
+ value public_callable (hidden_target)
- value private_callable (hidden_target)

/// Public alias for a private function.
+ value documented_alias (hidden_target)

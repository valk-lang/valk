+ class Box[T] {
    + get value_type : T {
        return @undefined
    }

    + fn get(value: T) T {
        return value
    }
}

+ class Ahead {
    + fn name() String {
        return "ahead"
    }
}

+ fn choose[K, V](key: K, value: V) V {
    return value
}

+ struct Pair[T] {
    + first: T
    + second: T

    + fn left() T {
        return this.first
    }
}

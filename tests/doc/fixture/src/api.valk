+ class Box[T] {
    + get value_type : T {
        return @undefined
    }

    + fn get(value: T) T {
        return value
    }
}

+ class Ahead {
    + fn name() String {
        return "ahead"
    }
}

+ fn choose[K, V](key: K, value: V) V {
    return value
}

+ struct Pair[T] {
    + first: T
    + second: T

    + fn left() T {
        return this.first
    }
}

extend Box[X] {
    #if X.$is_type_of(String)
    + fn shout() String {
        return "loud"
    }
    #end
}

+ fn use_boxes(text: Box[String], number: Box[uint]) {}

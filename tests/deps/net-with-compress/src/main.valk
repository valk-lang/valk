use valk.net
use valk.compress

// `valk.net` brings io.Reader implementations nothing here reaches (TcpConnection,
// UdpClient); their bodies are parsed only for the interface summary and the private
// methods they call must still be analyzed. Otherwise the conservative defaults of
// those methods flow into `io.Reader.read` and `compress.decompress`, which lends frame
// storage through that interface, fails to build.
fn main() {
    let packed = compress.zlib("hello from a pruned build")
    let text = compress.unzlib(packed, 1024) ! panic("unzlib failed")
    println(text)
}

// `+` / `~` / `-` only restrict other packages, so everything a package declares
// stays reachable inside that package regardless of its marker.
class AccessLocal {
    - secret: uint (7)
    ~ count: uint (3)
    + open: uint (1)

    - fn hidden() uint {
        return this.secret
    }
}

- fn access_private_func() uint {
    return 42
}

- global access_private_global : uint (5)

test "Access: markers do not restrict the declaring package" {
    let l = AccessLocal{ secret: 8 }
    assert(l.secret == 8)
    assert(l.hidden() == 8)
    assert(l.open == 1)

    // `~` is writable here: the read-only restriction is cross-package only
    l.count = 9
    assert(l.count == 9)

    assert(access_private_func() == 42)
    assert(access_private_global == 5)
}

test "Access: reading a '~' member of another package" {
    // Array.each_slice is `~` in the valk package: readable, not writable.
    let a = Array[uint]{}
    a.append(1)
    assert(!isset(a.each_slice))
}

@ignore_access

// A file-level `@ignore_access` lifts every access check for this file. The
// compiler's own src/doc, src/helper and src/lsp files rely on this to reach
// stdlib internals.
test "Access: @ignore_access reaches another package's private members" {
    let m = Map[uint]{}
    m.set("a", 1)
    m.set("b", 2)
    // HashMap._keys has no marker in the valk package.
    assert(m._keys.length == 2)
}


// The import and the local are referenced only from a branch that most builds
// compile out. Neither is really unused, so nothing may be reported here — on any
// target, which is what makes this test portable.
use valk:fs

fn main() {
    let dir_len = 3
    #if OS == "win"
    println(fs:cwd() + dir_len)
    #end
}

// Which statements a `#if` leaves reachable is a property of the target, not of
// the code: `#if OS == "win" return #end cleanup()` is dead on Windows and live
// everywhere else. So reachability is not reported for a statement list holding a
// compile macro, and the statement below — dead on every target, since one of
// these branches always returns — is deliberately left alone.
fn cond_flow() uint {
    #if OS == "win"
    return 1
    #else
    return 2
    #end
    println("not reported")
}

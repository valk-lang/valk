fn helper(count: uint, label: String) String {
    return label + count
}

fn go() {
    let total = 3
    let name = "abc"
    let out = helper(total, name)
    println(out)
}

/// Sums the values in `numbers`.
///
/// Returns `0` for an empty array.
fn total(numbers: Array[uint]) uint {
    let sum: uint = 0
    each numbers as n : sum += n
    return sum
}

fn go_total() {
    let numbers = Array[uint]{ 1, 2, 3 }
    let out = total(numbers)
    println(out)
}

/// A counter that records how often it was bumped.
+ class Counter {
    /// The current total.
    + count: uint (0)

    /// Adds one to `count`.
    + fn bump() {
        this.count++
    }
}

fn go_counter() {
    let counter = Counter {}
    counter.bump()
    println(counter.count)
}

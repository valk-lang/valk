interface Describable {
    fn describe() String;
}

class TaggedUser is Describable {
    id: int `json: "user_id", pk`
    name: String $tag(json: "full_name", omitempty)

    fn describe() String {
        return "%{this.id:04d}:%{this.name:>10}"
    }
}

struct UninstBuf[T is Describable, const M: uint] {
    data: [T x M]

    fn cap() uint {
        return M
    }

    fn show(x: T) String {
        return x.describe()
    }
}

union Color {
    red
    rgb(u8, u8, u8)

    fn is_red() bool {
        return match this : bool {
            .red => true
            .rgb(r, _, _) => r > 0
        }
    }
}

fn inspect_props[T]() String {
    #loop properties T as prop
    return prop.$tag("json", prop.name)
    #end
    return ""
}

bench "describe user" {
    let u = TaggedUser { id: 1, name: "ada" }
    while b.loop() {
        b.keep(u.describe())
    }
}

fn main() {
    let a: int = 0
    let ok = atomic_cas(a, 0, 1)
    let c = Color.rgb(1, 2, 3)
    let _ = inspect_props[TaggedUser]()
    let _ = "%{a:04x}" + (ok ? "1" : "0") + (c.is_red() ? "r" : "c")
}

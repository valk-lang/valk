// Three independent broken functions. Function bodies are resolved
// independently, so all three errors are collected and the language server
// publishes all of them. The CLI deliberately still prints only the first.
fn one() {
    println(bad_one_xyz)
}

fn two() {
    println(bad_two_xyz)
}

fn three() {
    let n: uint = "not a number"
    println(n)
}








use valk:fs

global sym_count: uint (0)

enum SymColor {
    red
    green
}

error SymError (bad, worse) payload {
    message: String
}

trait SymGreeter {
    fn greet() String {
        return "hi"
    }
}

struct SymPoint {
    x: uint
    y: uint
}

class SymThing {
    label: String
    size: uint (0)

    static fn make(label: String) SymThing {
        return SymThing { label: label }
    }

    fn describe() String {
        return this.label
    }

    group sub {
        fn nested() uint {
            return 1
        }
    }
}

fn sym_helper(count: uint) String {
    sym_count = count
    return fs:cwd()
}

use valk.fs

class Holder[T] {
    v: T


    fn peek() T {
        let spare = this.v
        return this.v
    }
}

fn compute() uint {
    let leftover = 40




    return 2
}

fn main() {
    let result = compute()
    let a = Holder[String]{ v: fs.cwd() !? "" }
    let b = Holder[uint]{ v: result }
    println(a.peek() + b.peek())
}

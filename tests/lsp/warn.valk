
// Compiles cleanly, but nothing here refers to `valk:mem`, `leftover` or `spare`.
// Everything else is deliberately in use, so this file produces exactly three
// warnings — run.sh asserts that count, which is what catches a regression that
// reports a variable or import that *is* used.
//
// `main` is here so the same fixture can be built from the command line.
use valk:mem
use valk:fs

class Holder[T] {
    v: T
    // Specialized twice below, so `spare` also covers the rule that one span is
    // reported once however many times its body was resolved.
    fn peek() T {
        let spare = this.v
        return this.v
    }
}

fn compute() uint {
    let leftover = 40

    // Comments after the declaration, because looking for a continuation of the
    // value expression consumes them: the reported span used to run all the way
    // to the end of the last one. run.sh pins the end of this warning's range.
    return 2
}

fn main() {
    let result = compute()
    let a = Holder[String]{ v: fs:cwd() }
    let b = Holder[uint]{ v: result }
    println(a.peek() + b.peek())
}

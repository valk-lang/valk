
// Exactly two warnings: one write-only variable and one unreachable statement.
// Everything else here is a case that must stay quiet, so the count run.sh
// asserts is what catches over-reporting.

fn flow_write_only() uint {
    // Assigned after its declaration and never read -> reported
    let dead = 1
    dead = 2

    // Read after being assigned -> quiet
    let live = 1
    live = 2

    // A compound assignment reads the old value -> quiet
    let acc = 0
    acc += 5

    // `++` reads it too -> quiet
    let counter = 0
    counter++

    // Storing null drops a reference, which the collector observes, so the store
    // is the point of it and nothing needs to read it afterwards -> quiet
    let released: ?String = "x"
    released = null

    return live + acc + counter
}

fn flow_unreachable() uint {
    return 1
    // Only the first dead statement is reported; the rest are dead for the same
    // reason and would say nothing new.
    println("never runs")
    println("never runs either")
}

fn flow_reachable(x: bool) uint {
    // One branch returning leaves the rest of the block reachable -> quiet
    if x {
        return 1
    }
    let i = 0
    while i < 3 {
        i++
        if i == 2 : continue
    }
    return i
}

fn main() {
    println(flow_write_only())
    println(flow_unreachable())
    println(flow_reachable(false))
}

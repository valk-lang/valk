fn test_helper(value: uint) uint {
    return value
}

test "definition inside a test body" {
    let value = 3
    let result = test_helper(value)
    println(result)
    let helper = TestBodyMethod {}
    let method_result = helper.double(value)
    println(method_result)
}

class TestBodyMethod {
    fn double(value: uint) uint {
        return value * 2
    }
}

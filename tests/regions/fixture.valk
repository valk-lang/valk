use valk.json

// Every place that makes an object carries the verdict of `--region-report` in a comment

class Node {
    value: int (0)
    next: ?Node (null)

    fn add(value: int) {
        this.next = Node { value: value, next: this.next } // region of a caller
    }
}

class Named {
    name: String ("")
    items: Array[int] (.{})
}

global kept: ?Node (null)

fn chain(length: int) Node {
    if length == 0 : return Node {}                        // region of a caller
    return Node { value: length, next: chain(length - 1) } // region of a caller
}

fn total(node: Node) int {
    let sum = node.value
    let next = node.next
    if isset(next) : sum += total(next)
    return sum
}

// A few objects per call are left to the collector, which frees them at no cost
fn stays() int {
    let node = Node { value: 1 } // heap: a few objects per call
    return node.value
}

// `$region` asks for the region
fn stays_asked() int $region {
    let node = Node { value: 1 } // region of stays_asked
    return node.value
}

fn built() int {
    let list = chain(4) // region of built
    list.add(5)         // region of built
    return total(list)
}

fn rounds() int {
    let sum = 0
    let i = 0
    while i++ < 10 {
        let list = chain(3) // region of rounds, per round of a loop
        sum += total(list)
    }
    return sum
}

fn grows() int {
    let list = Node {} // heap: made in a loop inside the scope it lives in ($region on the function allows it)
    let i = 0
    while i++ < 10 {
        list.add(i) // heap: made in a loop inside the scope it lives in ($region on the function allows it)
    }
    return total(list)
}

fn grows_allowed() int $region {
    let list = Node {} // region of grows_allowed
    let i = 0
    while i++ < 10 {
        list.add(i) // region of grows_allowed
    }
    return total(list)
}

fn numbers(count: int) Array[int] $region {
    let list = Array[int]{} // region of a caller
    let i = 0
    while i++ < count {
        list.append(i) // region of a caller
    }
    return list
}

fn numbers_used() int {
    let list = numbers(5) // region of numbers_used
    return list.length.to(int)
}

class Slot {
    node: ?Node (null)
}

fn fills(count: int) int {
    let list = Array[Node]{} // region of fills
    let i = 0
    while i++ < count {
        list.append(Node { value: i }) // region of fills
    }
    return list.length.to(int)
}

fn fills_some(count: int) int {
    let list = Array[Node]{} // heap: refers to an object on the heap: made in a loop inside the scope it lives in ($region on the function allows it)
    let i = 0
    while i++ < count {
        let node = Node { value: i } // heap: made in a loop inside the scope it lives in ($region on the function allows it)
        if i % 2 == 0 : list.append(node)
    }
    return list.length.to(int)
}

fn replaces(count: int) int {
    let slot = Slot {} // heap: made in a loop inside the scope it lives in ($region on the function allows it)
    let i = 0
    while i++ < count {
        slot.node = Node { value: i } // heap: made in a loop inside the scope it lives in ($region on the function allows it)
    }
    return slot.node?.value ?? 0
}

fn made_list(count: int) Array[Node] {
    let list = Array[Node]{} // region of a caller
    let i = 0
    while i++ < count {
        list.append(Node { value: i }) // region of a caller
    }
    return list
}

fn made_lists(count: int) int {
    let all = Array[Array[Node]]{} // region of made_lists
    let i = 0
    while i++ < count {
        all.append(made_list(i)) // region of made_lists
    }
    return all.length.to(int)
}

fn decoded() int {
    let document = json.decode("{\"a\":[1,2,{\"b\":\"c\"}]}") ! return 0 // region of decoded
    return document.get("a").length.to(int)
}

fn in_global() {
    kept = Node { value: 2 } // heap: stored in a global
}

fn returned() Node {
    return chain(2) // heap: no caller keeps it in a region
}

fn captured() fn()(int) {
    let node = Node { value: 3 } // heap: captured by a closure in main.captured
    return fn() int { return node.value }
}

fn with_text(text: String) int {
    let named = Named { name: text } // region of with_text
    return named.name.bytes.to(int)
}

fn attach(holder: Node, value: int) Node {
    holder.next = Node { value: value } // heap: no caller keeps it in a region
    return Node { value: value + 1 }    // heap: no caller keeps it in a region
}

fn attach_kept() int {
    let holder = Node {}     // heap: a few objects per call
    kept = attach(holder, 3) // heap: a few objects per call
    return total(holder)
}

class Config {
    limit: int (0)
    owner: ?Item (null)
}

class Item {
    config: Config
    value: int (0)
}

class Final {
    fn gc_free() {
    }
}

class FinalHolder {
    item: ?Final (null)
}

fn limit_of(item: Item) int {
    return item.config.limit + item.value
}

fn link_back(item: Item) {
    item.config.owner = item
}

fn temporaries(rounds: int) int {
    let config = Config { limit: 3 } // region of temporaries
    let sum = 0
    let i = 0
    while i++ < rounds {
        let item = Item { config: config, value: i } // region of temporaries, per round of a loop
        sum += limit_of(item)
    }
    return sum
}

fn temporaries_of(config: Config, rounds: int) int {
    let sum = 0
    let i = 0
    while i++ < rounds {
        let item = Item { config: config, value: i } // region of temporaries_of, per round of a loop
        sum += limit_of(item)
    }
    return sum
}

fn listed(config: Config, rounds: int) int {
    let sum = 0
    let i = 0
    while i++ < rounds {
        let items = Array[Item]{}                       // region of listed, per round of a loop
        items.append(Item { config: config, value: i }) // region of listed, per round of a loop
        sum += items.length.to(int)
    }
    return sum
}

fn linked_back(rounds: int) int {
    let config = Config { limit: 3 } // heap: made in a loop inside the scope it lives in ($region on the function allows it)
    let i = 0
    while i++ < rounds {
        let item = Item { config: config, value: i } // heap: made in a loop inside the scope it lives in ($region on the function allows it)
        link_back(item)
    }
    return config.owner?.value ?? 0
}

fn holds_final() bool {
    let item = Final {}                     // heap: the runtime keeps helpers for it
    let holder = FinalHolder { item: item } // heap: refers to an object on the heap: the runtime keeps helpers for it
    return isset(holder.item)
}

class Drive {
    main: ?Folder (null)
}

class Folder {
    name: String
    drive: Drive
    path: ?String (null)
    parent: ?Folder (null)

    // Calls itself one reference further on: the summary has to settle
    fn full() String {
        let main = this.drive.main
        if !isset(main) : return this.name
        let root = main.path
        let path = this.path
        if !isset(root) || !isset(path) : return this.name
        if path.starts_with(root) : return path.range(root.length, path.length - root.length)
        let parent = this.parent
        if !isset(parent) : return this.name
        return parent.full() + "/" + this.name
    }
}

fn folders() uint {
    let drive = Drive {}                                                     // region of folders
    let top = Folder { name: "top", drive: drive }                           // region of folders
    let sub = Folder { name: "sub", drive: drive, parent: top, path: "x/b" } // region of folders
    drive.main = Folder { name: "main", drive: drive, path: "y" }            // region of folders
    return sub.full().length                                                 // region of folders
}

// Library functions that build one result in a loop are marked `$region`
fn pieces(count: int) uint {
    let text = "a,b,c," + count
    let parts = text.split(",")  // region of pieces
    let joined = parts.join("-") // region of pieces
    let wide = joined.repeat(2)  // region of pieces
    return parts.length + wide.length
}

fn numbered(text: String, count: int) uint {
    let list = Array[String].new() // region of numbered
    let i = 0
    while i++ < count {
        list.append(text.range(0, 1)) // region of numbered
    }
    return list.length
}

// A buffer that is there before the loop keeps what the rounds write
fn spelled(count: int) String {
    let buf = ByteBuffer.new() // region of a caller
    let i = 0
    while i++ < count {
        buf.write("ab") // region of a caller
    }
    return buf.into_string() // region of a caller
}

fn spelled_use() uint {
    let text = spelled(5) // region of spelled_use
    return text.length
}

// Bytes copied out of text refer to nothing: the joined text is new
fn rejoined(text: String) uint {
    let parts = text.split(",")  // region of rejoined
    let joined = parts.join("-") // region of rejoined
    return joined.length
}

fn main() {
    let keep = returned()
    let read = captured()
    in_global()
    println("%{stays()} %{stays_asked()} %{built()} %{rounds()} %{grows()} %{grows_allowed()} %{numbers_used()} %{attach_kept()} %{total(keep)} %{read()} %{with_text("a")} %{temporaries(4)} %{temporaries_of(Config { limit: 2 }, 4)} %{linked_back(4)} %{holds_final()} %{listed(Config { limit: 1 }, 3)} %{fills(5)} %{fills_some(5)} %{replaces(5)} %{made_lists(4)} %{decoded()} %{folders()} %{pieces(4)} %{numbered("xy", 3)} %{spelled_use()} %{rejoined("a,b,c")}")
}

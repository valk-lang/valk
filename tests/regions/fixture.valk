// Every place that makes an object carries the verdict of `--region-report` in a comment

class Node {
    value: int (0)
    next: ?Node (null)

    fn add(value: int) {
        this.next = Node { value: value, next: this.next } // region of a caller
    }
}

class Named {
    name: String ("")
    items: Array[int] (.{})
}

global kept: ?Node (null)

fn chain(length: int) Node {
    if length == 0 : return Node {}                        // region of a caller
    return Node { value: length, next: chain(length - 1) } // region of a caller
}

fn total(node: Node) int {
    let sum = node.value
    let next = node.next
    if isset(next) : sum += total(next)
    return sum
}

fn stays() int {
    let node = Node { value: 1 } // region of stays
    return node.value
}

fn built() int {
    let list = chain(4) // region of built
    list.add(5)         // region of built
    return total(list)
}

fn rounds() int {
    let sum = 0
    let i = 0
    while i++ < 10 {
        let list = chain(3) // region of rounds, per round of a loop
        sum += total(list)
    }
    return sum
}

fn grows() int {
    let list = Node {} // heap: made in a loop inside the scope it lives in
    let i = 0
    while i++ < 10 {
        list.add(i) // heap: made in a loop inside the scope it lives in
    }
    return total(list)
}

fn in_global() {
    kept = Node { value: 2 } // heap: stored in a global
}

fn returned() Node {
    return chain(2) // heap: no caller keeps it in a region
}

fn captured() fn()(int) {
    let node = Node { value: 3 } // heap: captured by a closure in main.captured
    return fn() int { return node.value }
}

fn with_text(text: String) int {
    let named = Named { name: text } // heap: not a plain object
    return named.name.bytes.to(int)
}

fn main() {
    let keep = returned()
    let read = captured()
    in_global()
    println("%{stays()} %{built()} %{rounds()} %{grows()} %{total(keep)} %{read()} %{with_text("a")}")
}

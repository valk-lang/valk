
class ClassTest {
    value: int (5)

    get val : int {
        return this.value + 2
    }
    group sub {
        get val : int {
            return this.value + 20
        }
        static get stat : int {
            return 40
        }
    }
}

struct ClassGcStructTest {
    value: int
}

test "Class syntax" {
    let x = ClassTest{}
    assert(x.value == 5)
    assert(x.val == 7)
    assert(x.sub.val == 25)
    assert(ClassTest.sub.stat == 40)
}

test "Class GC type classification" {
    let managed = ClassTest{}
    let inline: <ClassTest> = {}
    let pointer: *ClassTest = @undefined
    let native_struct = ClassGcStructTest{}

    #if typeof(managed).$is_gc
    assert(true)
    #else
    assert(false)
    #end

    #if typeof(inline).$is_gc
    assert(false)
    #else
    assert(true)
    #end

    #if typeof(pointer).$is_gc
    assert(false)
    #else
    assert(true)
    #end

    #if typeof(native_struct).$is_gc
    assert(false)
    #else
    assert(true)
    #end
}

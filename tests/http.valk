
use valk:http
use valk:fs
use valk:json
use valk:net

fn http_handler_data(req: http:Request) http:Response {
    let result = req.method + "|" + req.path
    result += "|" + req.params().get("p1") !? ""
    result += "|" + req.params().get("p2") !? ""
    result += "|" + req.data().get("p3") !? ""
    return http:Response.html(result)
}

fn http_handler_file(req: http:Request) http:Response {
    return http:Response.file(__DIR__ + "/assets/valk-logo.png")
}

fn http_handler_multipart(req: http:Request) http:Response {
    let result = req.data().get("username") !? ""
    let file = req.files().get("avatar") !? null
    if isset(file) {
        result += "|" + file.filename + "|" + file.mime_type + "|" + file.read_all()
    }
    return http:Response.html(result)
}

fn http_handler_headers(req: http:Request) http:Response {
    let acc = req.headers().get("accept") !? ""
    return http:Response.text(acc)
}

fn http_handler(req: http:Request) http:Response {

    let r: http:Router[fn(http:Request)(http:Response)] = http:Router[fn(http:Request)(http:Response)].$default_value
    r.add("POST", "/test-data", http_handler_data)
    r.add("POST", "/test-multipart", http_handler_multipart)
    r.add("GET", "/test-headers", http_handler_headers)
    r.add("GET", "/test-file", http_handler_file)
    r.add("GET", "/ping", fn(req: http:Request) http:Response { return http:Response.text("pong") })
    r.add("GET", "/stop", http_handler_file)

    let route = r.find(req.method, req.path) ! {
        println("ROUTE NOT FOUND: '" + req.path + "'")
        return http:Response.empty(404)
    }
    return route.handler(req)
}

fn http_server() {
    let s = http:Server.new("127.0.0.1", 9000, http_handler) ! return
    s.start(1)
}

test "Http: default response" {
    let response: http:Response = http:Response.$default_value

    assert(response.status == 200)
    assert(response.body == "")
    assert(response.content_type == "text/plain")
}

test "Http: server/client" {

    co http_server()

    // Request 1
    let post_data = Map[String]{ "p3" => "v3" }
    let json = json:from(post_data)
    // println(json:encode(json, true))
    let res = http:request("POST", "http://127.0.0.1:9000/test-data?p1=v1", http:Options {
        query_data: Map[String]{ "p2" => "v2" }
        body: json:encode(json)
        headers: Map[String]{ "content-type" => "application/json" }
    }) ! {
        assert(false)
        return
    }
    assert(res.body == "POST|/test-data|v1|v2|v3")

    // Multipart Request
    let boundary = "---------------------------974767299852498929531610575"
    let body = "--" + boundary + "\r\n"
    body += "Content-Disposition: form-data; name=\"username\"\r\n\r\n"
    body += "valk_user\r\n"
    body += "--" + boundary + "\r\n"
    body += "Content-Disposition: form-data; name=\"avatar\"; filename=\"avatar.txt\"\r\n"
    body += "Content-Type: text/plain\r\n\r\n"
    body += "hello multipart\r\n"
    body += "--" + boundary + "--\r\n"

    res = http:request("POST", "http://127.0.0.1:9000/test-multipart", http:Options {
        body: body
        headers: Map[String]{ "content-type" => "multipart/form-data; boundary=" + boundary }
    }) ! {
        assert(false)
        return
    }
    assert(res.body == "valk_user|avatar.txt|text/plain|hello multipart")

    // Mixed-case duplicate header test
    res = http:request("GET", "http://127.0.0.1:9000/test-headers", http:Options {
        headers: Map[String]{ "Accept" => "text/html", "accept" => "application/json" }
    }) ! {
        assert(false)
        return
    }
    assert(res.body == "text/html, application/json")

    // Request 2
    res = http:request("GET", "http://127.0.0.1:9000/test-file?p1=v1") ! {
        assert(false)
        return
    }
    assert(res.body.bytes == 15425)

    // Download to file
    let to = fs:add(fs:exe_dir(), "logo-download.png")
    if fs:exists(to) : fs:delete(to) ! assert(false)
    //
    http:download("http://127.0.0.1:9000/test-file?p1=v1", to) ! {
        assert(false)
    }
    // Check exists
    assert(fs:exists(to))
    // Check file content
    let file_content = fs:read(to) !? <{
        println("Failed reading file")
        return ""
    }
    assert(file_content == res.body)
}

fn non_https_server() {
    let s = http:Server.new("127.0.0.1", 9001, http_handler) ! return
    s.start(1)
}

test "Https: Client" {
    // #if OS == "win"
    // net:set_ca_cert_path(fs:exe_dir() + "\\cacert.pem")
    // #end

    let req = http:request("GET", "https://valk-lang.dev/api/versions") ! {
        assert(false)
        return
    }
    assert(req.body.length > 0)

    // Verify the OpenSSL configuration without adding more network requests.
    let ssl = net:SSL.new()
    assert(ssl.verification_enabled_for_test())
    ssl.set_host("expected.example") ! {
        assert(false)
        return
    }
    ssl.set_verify(false)
    assert(!ssl.verification_enabled_for_test())

    // Fail SSL
    co non_https_server()

    let failed = false
    http:request("GET", "https://127.0.0.1:9001/ping") ! {
        failed = true
    }
    assert(failed)

    //
    let res = http:request("GET", "http://127.0.0.1:9001/ping") ! {
        assert(false)
        return
    }
    assert(res.body == "pong")
}

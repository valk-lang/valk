// D-15/D-16: a deterministic mixed workload for the differential oracle (misc/gc-oracle.sh).
// Built with either collector it allocates the same objects in the same order; at each
// checkpoint both builds must still hold exactly the same objects
use valk.gc
use valk.json

class Node {
    id: uint
    next: ?Node (null)
    peer: ?Node (null)
    items: Array[Node] (.{})
}

struct Pair {
    left: ?Node
    right: ?Node
}

class Holder {
    pairs: Array[?Pair] (.{})
    names: Map[Node] (.{})
}

global seed: uint (12345)
global keep: ?Holder (null)

fn rand(n: uint) uint {
    seed = seed * 6364136223846793005 + 1442695040888963407
    return (seed >> 33) % n
}

// Growth, insert, prepend, remove, swap, sort and drops in one epoch
fn arrays() Array[Node] $noinline {
    let list = Array[Node]{}
    let i: uint = 0
    while i < 400 {
        let n = Node { id: i }
        if i % 3 == 0 : list.prepend(n)
        else if i % 3 == 1 : list.append(n)
        else : list.insert(rand(list.length + 1), n) ! {}
        if list.length > 8 && rand(4) == 0 : list.remove(rand(list.length))
        if list.length > 2 : list.swap(rand(list.length), rand(list.length))
        i++
    }
    list.sort(fn(a: Node, b: Node) bool { return a.id < b.id })
    list.remove_duplicates()
    let kept = Array[Node]{}
    each list as n, k {
        if k % 2 == 0 : kept.append(n)
    }
    list.prepend_many(kept)
    let half = list.length / 2
    while list.length > half : list.pop_last() ! break
    return list
}

// Cycles that become garbage, and chains held from old objects
fn graphs(root: Node) $noinline {
    let i: uint = 0
    while i < 200 {
        let a = Node { id: 1000 + i }
        let b = Node { id: 2000 + i, next: a }
        a.next = b
        if i % 5 == 0 {
            a.peer = root
            root.items.append(a)
        }
        i++
    }
    while root.items.length > 30 : root.items.remove(0)
}

// Nullable inline values and maps of objects in an old holder
fn holders(h: Holder, list: Array[Node]) $noinline {
    let i: uint = 0
    while i < 150 {
        if i % 4 == 0 {
            h.pairs.append(null)
        } else {
            h.pairs.append(Pair { left: list.get(rand(list.length)) !? null, right: Node { id: 3000 + i } })
        }
        h.names.set("n" + (i % 40), Node { id: 4000 + i })
        i++
    }
    h.pairs.swap_remove(3)
    h.pairs.pop_first() ! {}
    h.names.remove("n7")
}

// Unions: json values built, changed and dropped
fn values() String $noinline {
    let v: json.Value = null
    let i: uint = 0
    while i < 100 {
        let arr: json.Value = null
        arr = arr.append_int(i.to(int))
        arr = arr.append_string("s" + i)
        v = v.set("k" + (i % 25), arr)
        i++
    }
    v = v.remove("k3")
    return v.encode()
}

fn keep_holder(list: Array[Node]) $noinline {
    let h = Holder {}
    keep = h
    holders(h, list)
}

fn main() {
    let root = Node { id: 0 }
    gc.oracle_checkpoint()
    let list = arrays()
    gc.oracle_checkpoint()
    graphs(root)
    gc.oracle_checkpoint()
    // Only the global holds the holder: a local of main would keep it in one build's frame
    keep_holder(list)
    gc.oracle_checkpoint()
    let text = values()
    gc.oracle_checkpoint()
    list.clear()
    keep = null
    gc.oracle_checkpoint()
    println(text.length + root.items.length + list.length)
}

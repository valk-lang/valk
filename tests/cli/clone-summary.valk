class Entry { count: uint (0) }
class State { entries: Array[Entry] (.{}) }

fn copy(state: shared Lock[State]) State {
    lock state as s { return $clone(s) }
}

test "clone" {
    let state: shared Lock[State] = .new(State {}) !!
    lock state as s : s.entries.append(Entry { count: 7 })
    let result = copy(state)
    result.entries[0].count = 9
    lock state as s : assert(s.entries[0].count == 7)
    assert(result.entries[0].count == 9)
}

test "other" { assert(true) }

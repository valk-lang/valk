enum Choice { first (7)
    second (19) }
fn choose(value: Choice) int {
    return match value : int {
        Choice.first => 73
        Choice.second => 19
    }
}
fn main(args: Array[String]) {
    let value = 0.@cast(Choice)
    if args.get(1) !! == "statement" {
        match value {
            Choice.first => print("invalid arm ran")
            Choice.second => print("invalid arm ran")
        }
    } else {
        print(choose(value))
    }
    panic("Invalid enum escaped its match")
}

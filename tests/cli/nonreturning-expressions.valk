use valk.time

interface Readable { fn read() int; }

class ExitBox is Readable {
    value: int
    fn read() int { return this.value }
}

struct ExitPair {
    first: int
    second: int
    fn read() int { return this.first }
}

slice ExitSlice of int {
    static fn interrupted() SELF {
        @unsafe
        return SELF { length: stop[uint]() }
    }
}

error ExitError (failed)

fn stop[T]() T $exit { panic("Nonreturning operand reached") }
fn before() int { println("before operand"); return 11 }
fn later() int { panic("Later operand ran") }
fn consume(a: int, b: int, c: int) int { return a + b + c }
fn fallible(value: int) int !ExitError { return value }
fn nullable_failure() ?int !ExitError { throw .failed }
fn void_exit_return() int { return panic("Nonreturning operand reached") }
fn delayed_stop() int $exit {
    time.sleep_ms(10)
    panic("Nonreturning operand reached")
}
fn partial_exit() int {
    let first = (before(), stop[int]())
}

fn main(args: Array[String]) {
    let name = args.get(1) !!
    if name == "argument" : consume(before(), stop[int](), later())
    if name == "conditional-argument" : consume(before(), panic("Nonreturning operand reached") ? 73 : 79, later())
    if name == "void-argument" : consume(before(), panic("Nonreturning operand reached"), later())
    if name == "void-closure-argument" {
        let call: fn(int, int, int)(int) = consume
        call(before(), panic("Nonreturning operand reached"), later())
    }
    if name == "void-fnptr-argument" {
        let call: fnptr(int, int, int)(int) = consume
        call(before(), panic("Nonreturning operand reached"), later())
    }
    if name == "void-let" {
        let value: int = panic("Nonreturning operand reached")
        println(value)
    }
    if name == "void-assign" {
        let value = 11
        value = panic("Nonreturning operand reached")
        println(value)
    }
    if name == "void-return" : void_exit_return()
    if name == "void-vscope" {
        let value: int = <{ return panic("Nonreturning operand reached") }
        println(value)
    }
    if name == "void-error-fallback" {
        let value = nullable_failure() !? panic("Nonreturning operand reached")
        println(value ?? 11)
    }
    if name == "closure-argument" {
        let call: fn(int, int, int)(int) = consume
        call(before(), stop[int](), later())
    }
    if name == "fnptr-argument" {
        let call: fnptr(int, int, int)(int) = consume
        call(before(), stop[int](), later())
    }
    if name == "binary-left" : println(stop[int]() + later())
    if name == "binary-right" : println(before() + stop[int]())
    if name == "unary" : println(-stop[int]())
    if name == "cast" : println(stop[int]().to(float))
    if name == "field" : println(ExitBox { value: stop[int]() }.value)
    if name == "inline" {
        let pair: ExitPair = { first: before(), second: stop[int]() }
        println(pair.first)
    }
    if name == "array" {
        let values: [int x 2] = { before(), stop[int]() }
        println(values[0])
    }
    if name == "slice" {
        let values = ExitSlice.interrupted()
        println(values.length)
    }
    if name == "if" {
        if stop[bool]() : println("Later operand ran")
    }
    if name == "while" {
        while stop[bool]() : println("Later operand ran")
    }
    if name == "property" : println(stop[ExitBox]().value)
    if name == "index" {
        let values: [int x 2] = { 11, 17 }
        println(values[stop[int]()])
    }
    if name == "store" {
        stop[ExitBox]().value = later()
    }
    if name == "receiver" : stop[ExitBox]().read()
    if name == "inline-receiver" : stop[ExitPair]().read()
    if name == "interface-receiver" : stop[Readable]().read()
    if name == "interface-wrap" {
        let value: Readable = stop[ExitBox]()
        value.read()
    }
    if name == "bound-method" {
        let value = stop[ExitBox]().read
        value()
    }
    if name == "multi" {
        let first, second = (before(), stop[int]())
        println(first + second)
    }
    if name == "partial-multi" : partial_exit()
    if name == "discarded-multi" {
        let _ = (before(), stop[int]())
    }
    if name == "closure" : stop[fn()(int)]()()
    if name == "fnptr" : stop[fnptr()(int)]()()
    if name == "fnptr-callee-argument" : stop[fnptr(int, int, int)(int)]()(later(), later(), later())
    if name == "co-callee-argument" {
        let task = co stop[fn(int, int, int)(int)]()(later(), later(), later())
        println(await task)
    }
    if name == "fnptr-wrap" {
        let value: fn()(int) = stop[fnptr()(int)]()
        value()
    }
    if name == "isset" : println(isset(stop[?ExitBox]()))
    if name == "match" {
        let value = match stop[int]() : int { 11 => 13 default => 17 }
        println(value)
    }
    if name == "match-condition" {
        let value = match 11 : int { stop[int]() => 13 default => 17 }
        println(value)
    }
    if name == "error" : fallible(stop[int]()) !!
    if name == "co" {
        let task = co consume(before(), stop[int](), later())
        println(await task)
    }
    if name == "co-body" {
        let task = co delayed_stop()
        println("caller continued")
        println(await task)
    }
    if name == "await" : println(await stop[co(int)]())
    if name == "vscope" {
        let value: int = <{ return stop[int]() }
        println(value + later())
    }
    panic("Fixture did not exit")
}

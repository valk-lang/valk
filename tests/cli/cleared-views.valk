class Cell { number: int (73) }
enum NonzeroEnum { first (7)
    second (19) }
struct EnumEntry { value: NonzeroEnum }
struct Entry {
    cell: Cell
    fn read() int { return this.cell.number }
}
struct Nested { entry: Entry }
struct Pair { first: Cell
    second: Cell }
struct NestedPair { pair: Pair }
struct Callbacks { callback: fn()(int) }
struct Readers { reader: Readable }
struct FixedEntries { cells: [Cell x 2] }
union EntryChoice : Entry | Pair {}
struct UnionEntries { choice: EntryChoice }
mode EntryMode for Entry {}
union Choice : Cell | int {}
interface Readable { fn read() int; }
class Reader is Readable { fn read() int { return 73 } }

fn number() int { return 73 }

fn main(args: Array[String]) {
    let name = args.get(1) !!
    if name == "enum" || name == "enum-get" || name == "enum-each" {
        let values = Array[NonzeroEnum]{ NonzeroEnum.first }
        let view = values.view()
        values.clear()
        if name == "enum" : print(view[0])
        if name == "enum-get" : print(view.get(0) !!)
        if name == "enum-each" : each view as value : print(value)
    }
    if name == "enum-borrowed" {
        let values = Array[EnumEntry]{ EnumEntry { value: NonzeroEnum.first } }
        let borrowed = &values[0]
        values.clear()
        print(borrowed.value)
    }
    if name == "borrowed-fixed" {
        let values = Array[FixedEntries]{ FixedEntries { cells: { Cell {}, Cell {} } } }
        let borrowed = &values[0]
        values.clear()
        let copied = borrowed.cells
        print(copied[1].number)
    }
    if name == "borrowed-union" {
        let values = Array[UnionEntries]{ UnionEntries { choice: Entry { cell: Cell {} } } }
        let borrowed = &values[0]
        values.clear()
        match borrowed.choice {
            Entry as entry => print(entry.cell.number)
            Pair as pair => print(pair.second.number)
        }
    }
    if name == "borrowed-field" || name == "borrowed-method" || name == "borrowed-bound" {
        let values = Array[Entry]{ Entry { cell: Cell {} } }
        let borrowed = &values[0]
        let bound = borrowed.read
        values.clear()
        if name == "borrowed-field" : print(borrowed.cell.number)
        if name == "borrowed-method" : print(borrowed.read())
        if name == "borrowed-bound" : print(bound())
    }
    if name == "borrowed-nested" {
        let values = Array[Nested]{ Nested { entry: { cell: Cell {} } } }
        let borrowed = &values[0]
        values.clear()
        print(borrowed.entry.cell.number)
    }
    if name == "borrowed-callback" {
        let values = Array[Callbacks]{ Callbacks { callback: number } }
        let borrowed = &values[0]
        values.clear()
        print(borrowed.callback())
    }
    if name == "borrowed-interface" {
        let values = Array[Readers]{ Readers { reader: Reader {} } }
        let borrowed = &values[0]
        values.clear()
        print(borrowed.reader.read())
    }
    if name == "partial-struct" {
        let values = Array[Pair]{ Pair { first: Cell {}, second: Cell {} } }
        let borrowed = &values[0]
        let view = values.view()
        values.clear()
        borrowed.first = Cell {}
        let copied = view[0]
        print(copied.second.number)
    }
    if name == "partial-nested-field" {
        let values = Array[NestedPair]{ NestedPair { pair: { first: Cell {}, second: Cell {} } } }
        let borrowed = &values[0]
        let view = values.view()
        values.clear()
        borrowed.pair.first = Cell {}
        print(view[0].pair.first.number)
    }
    if name == "partial-fixed" {
        let row: [Cell x 2] = { Cell {}, Cell {} }
        let values = Array[[Cell x 2]]{ row }
        let borrowed = &values[0]
        let view = values.view()
        values.clear()
        borrowed[0] = Cell {}
        let copied = view[0]
        print(copied[1].number)
    }
    if name == "callback" || name == "callback-get" || name == "callback-each" {
        let values = Array[fn()(int)]{ number }
        let view = values.view()
        values.clear()
        if name == "callback" : print(view[0]())
        if name == "callback-get" : print((view.get(0) !!)())
        if name == "callback-each" : each view as callback { print(callback()) }
    }
    if name == "pointer" {
        let pointer: fnptr()(int) = number
        let values = Array[fnptr()(int)]{ pointer }
        let view = values.view()
        values.clear()
        print(view[0]())
    }
    if name == "inline" || name == "inline-get" || name == "inline-each" {
        let values = Array[Entry]{ Entry { cell: Cell {} } }
        let view = values.view()
        values.clear()
        if name == "inline" : print(view[0].cell.number)
        if name == "inline-get" : print((view.get(0) !!).cell.number)
        if name == "inline-each" : each view as entry { print(entry.cell.number) }
    }
    if name == "nested" {
        let values = Array[Nested]{ Nested { entry: { cell: Cell {} } } }
        let view = values.view()
        values.clear()
        print(view[0].entry.cell.number)
    }
    if name == "mode" {
        let values = Array[EntryMode]{ EntryMode { cell: Cell {} } }
        let view = values.view()
        values.clear()
        print(view[0].cell.number)
    }
    if name == "fixed" {
        let row: [Cell x 2] = { Cell {}, Cell {} }
        let values = Array[[Cell x 2]]{ row }
        let view = values.view()
        values.clear()
        print(view[0][1].number)
    }
    if name == "union" {
        let values = Array[Choice]{ Cell {} }
        let view = values.view()
        values.clear()
        let value = view[0]
        assert(value == 73)
    }
    if name == "interface" {
        let values = Array[Readable]{ Reader {} }
        let view = values.view()
        values.clear()
        print(view[0].read())
    }
    if name == "borrow" {
        let cell = Cell {}
        let values = Array[&int]{ &cell.number }
        let view = values.view()
        values.clear()
        print(view[0][0])
    }
    if name == "slice" {
        let values = Array[Slice[int]]{ Slice[int]{ 73 } }
        let view = values.view()
        values.clear()
        print(view[0].length)
    }
    if name == "string" {
        let values = Array[String]{ "live" }
        let view = values.view()
        values.clear()
        print(view[0].length)
    }
    panic("Cleared slot escaped its check")
}

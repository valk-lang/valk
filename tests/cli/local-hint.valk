// Borrow parameters the body never keeps are reported with a `local` suggestion
global hint_keep: ?&[u8] (null)
class HintBox { data: &[u8] }
interface HintSink {
    fn put(b: &[u8]);
}
class HintOut is HintSink {
    fn put(b: &[u8]) { println(b.length) }
}
struct HintPt { x: int }

// Reported: nothing keeps the parameter
fn hint_sum(b: &[u8]) uint {
    let t: uint = 0
    each b as v : t += v
    return t
}
fn hint_maybe(b: ?&[u8]) uint { return isset(b) ? b.length : 0 }
fn hint_pt(p: &HintPt) int { return p.x }
fn hint_lend(b: &[u8]) uint { return hint_already(b) }
fn hint_mut(b: mut &[u8]) { b[0] = 1 }

// Quiet: already local, kept, returned, captured, or fixed by an interface
fn hint_already(b: local &[u8]) uint { return b.length }
fn hint_store(b: &[u8]) { hint_keep = b }
fn hint_box(b: &[u8]) HintBox { return HintBox{ data: b } }
fn hint_first(b: &[u8]) &u8 { return &b[0] }
fn hint_cap(b: &[u8]) fn()(uint) { return fn() uint { return b.length } }
fn hint_text(s: String) uint { return s.bytes }

fn main() {
    let a = Array[u8].new()
    a.append(1)
    println(hint_sum(a.view()) + hint_maybe(a.view()) + hint_lend(a.view()))
    println(hint_first(a.view())[0])
    hint_store(a.view())
    hint_box(a.view())
    let s: HintSink = HintOut{}
    s.put(a.view())
    hint_mut(a.view())
    println(hint_cap(a.view())() + hint_text("ab"))
}

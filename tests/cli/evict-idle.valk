
// Used by run.sh: `server <port>` serves under a low file descriptor limit, `client <port> <n>`
// opens n keep-alive connections one by one and expects every request to be answered. The
// server makes room for a new connection by closing the one idle the longest.
use valk.http
use valk.net
use valk.time

fn evict_handler(req: http.Context, res: http.ResponseWriter) {
    res.send("ok", 200, "text/plain")
}

fn main(args: Array[String]) {
    let mode = args.get(1) !? ""
    let port = (args.get(2) !? "0").to(u16) !? 0
    if mode == "server" {
        let server = http.Server.new("127.0.0.1", port)
        server.fast(evict_handler)
        server.start(1) ! panic("Failed to start the server")
        return
    }
    let count = (args.get(3) !? "0").to(uint) !? 0
    let request = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"
    let open = Array[net.TcpConnection]{}
    let deadline = time.mono_ms() + 5000
    let served: uint = 0
    while served < count {
        let connection = net.tcp_client("127.0.0.1", port) ! {
            if time.mono_ms() > deadline : panic("Cannot connect")
            time.sleep_ms(10)
            continue
        }
        connection.read_timeout_ms = 5000
        connection.write(request) ! panic("Write failed")
        let response = [u8]{ 0 x 256 }
        let received = connection.read(response) ! panic("Read failed on connection " + served)
        if !response.view(0, received).to_string().contains(" 200 ") : panic("Bad response on connection " + served)
        open.append(connection)
        served++
    }
    println("served " + served)
    each open as connection : connection.close() _
}

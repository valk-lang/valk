// A statement that can never run must not change divergence analysis.

fn divergence_return_then_break() int {
    while true {
        return 1
        break
    }
}

fn divergence_return_then_continue() int {
    while true {
        return 2
        continue
    }
}

fn divergence_live_break(c: bool) int {
    while true {
        if c { return 3 }
        break
    }
    return 4
}

fn main() {
    if divergence_return_then_break() != 1 : panic("return then break")
    if divergence_return_then_continue() != 2 : panic("return then continue")
    if divergence_live_break(true) != 3 : panic("live break, true")
    if divergence_live_break(false) != 4 : panic("live break, false")
    println("divergence ok")
}

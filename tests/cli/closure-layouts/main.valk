use valk.gc

class ClosureLayoutNode { number: int }
global closure_layout_a: ?shared fn()(int) (null)
global closure_layout_b: ?shared fn()(int) (null)

fn main() {
    closure_layout_a = closure_layout_first()
    closure_layout_b = closure_layout_other()
    gc.collect()
    gc.collect_shared()
    let first = closure_layout_a ?! panic("missing first closure")
    let other = closure_layout_b ?! panic("missing other closure")
    assert(first() == 31)
    assert(other() == 31)
    let number = closure_layout_generic[int](17)
    let text = closure_layout_generic[String]("hello")
    let copied_number = number.clone()
    let copied_text = text.clone()
    gc.collect()
    assert(number() == 17 && copied_number() == 17)
    assert(text() == "hello" && copied_text() == "hello")
    let nested_number = closure_layout_nested[int](19)()
    let nested_text = closure_layout_nested[String]("nested")()
    gc.collect()
    assert(nested_number() == 19 && nested_text() == "nested")
    println("closure layouts OK")
}

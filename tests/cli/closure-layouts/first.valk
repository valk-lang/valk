// Keep both factory prefixes aligned to exercise matching closure offsets.
fn closure_layout_first() atomic fn()(int) {
    let first: atomic ClosureLayoutNode = .{ number: 7 }
    let other: atomic ClosureLayoutNode = .{ number: 11 }
    let number = 24
    assert(other.number == 11 && number == 24)
    return fn() int { return first.number + number }
}

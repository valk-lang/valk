class Box {
    items: Array[int] (.{})

    fn pick(index: uint) int {
        let value = this.items.get(index) !!
        return value
    }
}

fn deeper[T](box: Box, value: T) int {
    let run = fn() int {
        return box.pick(3)
    }
    return run()
}

fn main() {
    let box = Box {}
    println("start")
    println(deeper[int](box, 1))
}

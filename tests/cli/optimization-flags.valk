use valk.gc

global noinline_alive: int (0)

class NoinlineLifetime {
    number: int (23)
    fn gc_free() { noinline_alive-- }
}

class NoinlineCounter {
    number: int (0)
    fn increment() $noinline { this.number++ }
    fn clone() SELF $clone $noinline { return SELF { number: this.number } }
}

fn noinline_frame() $noinline {
    noinline_alive++
    let value = NoinlineLifetime {}
    gc.collect()
    assert(noinline_alive == 1 && value.number == 23)
}

fn noinline_generic[T](value: T) T $noinline { return value }
fn inline_increment(value: int) int $inline { return value + 1 }

fn main() {
    noinline_frame()
    gc.collect()
    assert(noinline_alive == 0)
    assert(noinline_generic[int](17) == 17)
    assert(noinline_generic[String]("text") == "text")
    assert(inline_increment(19) == 20)
    let value = NoinlineCounter {}
    value.increment()
    let copy = $clone(value)
    assert(copy.number == 1)
    let shared_value: shared NoinlineCounter = .{}
    shared_value.increment()
    assert(shared_value.number == 1)
    let guarded: shared Lock[NoinlineCounter] = .new(NoinlineCounter {}) !!
    lock guarded as current { current.increment() }
    lock guarded as current { assert(current.number == 1) }
    println("optimization flags OK")
}

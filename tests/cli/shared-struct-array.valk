// A standalone program keeping structs with references in Array[shared T]

class Item { n: int (0) }
struct Pair { item: Item }
class PairHub { last: ?shared Pair (null)   pairs: Array[shared Pair] (.{}) }

fn keep(h: PairHub, p: shared Pair) {
    h.pairs.append(p)
    h.last = p
}

fn main() {
    let h = PairHub {}
    keep(h, Pair { item: Item { n: 2 } })
    let p = Pair { item: Item { n: 3 } }
    keep(h, p)
    let total = 0
    each h.pairs as pair : total += pair.item.n
    let last = h.last ?! panic("missing")
    if total == 5 && last.item.n == 3 : println("shared structs ok")
}

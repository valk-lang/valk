@ignore_access

use valk.coro

class TempBox {
    v: int
}

fn leaf_add(a: int, b: int) int $noinline {
    return a + b
}

fn make_temp(x: int) int $noinline {
    let b = TempBox { v: x }
    return leaf_add(b.v, 1)
}

fn worker_boom() $noinline {
    panic("coro trace")
}

fn main() {
    #if DEBUG
    println("DEBUG=true")
    #else
    println("DEBUG=false")
    #end
    #if STACK_TRACES
    println("STACK_TRACES=true")
    #else
    println("STACK_TRACES=false")
    #end
    println("STACK_SIZE=" + coro.STACK_SIZE)
    println("SUM=" + make_temp(41))
    let c = co worker_boom()
    await c
}

fn classify(x: int) int {
    if x < 0 {
        return -1
    }
    if x == 0 {
        return 0
    }
    return 1
}

fn unused_helper(x: int) int {
    let y = x + 1
    return y * 2
}

fn identity[T](v: T) T {
    return v
}

fn sum_up(n: int) int {
    let total = 0
    let i = 0
    while i < n {
        total += i
        i++
    }
    return total
}

test "coverage branches and generics" {
    assert(classify(5) == 1)
    assert(classify(0) == 0)
    assert(identity[int](7) == 7)
    assert(identity[String]("ok") == "ok")
    assert(sum_up(5) == 10)
}

bench "simple sum" {
    b.keep(sum_up(100))
}

bench "hash payload" {
    let data = "0123456789abcdef0123456789abcdef"
    b.set_bytes(data.bytes)
    b.reset_timer()
    while b.loop() {
        b.stop_timer()
        b.start_timer()
        b.keep(data.hash())
    }
}

enum Nonzero { first (7)
    second (19) }
enum Zero { first (0)
    second (19) }
class Counter { calls: uint (0) }
fn index(counter: Counter) uint {
    counter.calls++
    return 0
}
fn arithmetic(values: &[Nonzero], counter: Counter) int {
    return values[index(counter)] + 1
}
fn read_enum(values: &[Nonzero]) Nonzero { return values[0] }
fn read_zero_enum(values: &[Zero]) Zero { return values[0] }
fn choose(value: Nonzero) int {
    return match value : int {
        Nonzero.first => 73
        Nonzero.second => 19
    }
}
fn default_enum() Nonzero { return Nonzero.$default_value }
fn nullable_sum(value: int) ?int { return value + 1 }
fn main() {
    assert(choose(read_enum(Slice[Nonzero]{ Nonzero.second })) == 19)
    assert(read_zero_enum(Slice[Zero]{ Zero.first }) == Zero.first)
    assert(default_enum() == Nonzero.first)
    assert(nullable_sum(7) == 8)
    let counter = Counter {}
    assert(arithmetic(Slice[Nonzero]{ Nonzero.first }, counter) == 8)
    assert(counter.calls == 1)
}

class Item { number: int }
struct Part { child: ?Item (null) }
class Holder { part: Part ({}) items: [?Item x 2] ({ null, null }) }
class Factory {
    holder: Holder (.{})
    calls: int (0)
    fn make() Holder { this.calls++; return this.holder }
    fn part() &Part { this.calls++; return &this.holder.part }
    fn item() &?Item { this.calls++; return &this.holder.part.child }
}
fn store_inline(factory: Factory, item: Item) { factory.make().part.child = item }
fn store_element(factory: Factory, item: Item) { factory.make().items[1] = item }
fn store_borrowed_part(factory: Factory, item: Item) { factory.part().child = item }
fn store_borrowed_item(factory: Factory, item: Item) { factory.item()[0] = item }
fn main() {
    let factory = Factory {}
    let item = Item { number: 73 }
    store_inline(factory, item)
    store_element(factory, item)
    store_borrowed_part(factory, item)
    store_borrowed_item(factory, item)
    assert(factory.calls == 4)
    assert(factory.holder.part.child == item)
    assert(factory.holder.items[1] == item)
}

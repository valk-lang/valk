+ fn __array_widen_elements__(values: *[int x 2]) [?int x 2] { return values }
+ fn __array_same_layout__(values: *[int x 2]) [uint x 2] { return values }
+ fn __array_add_presence__(values: [int x 2]) ?[int x 2] { return values }

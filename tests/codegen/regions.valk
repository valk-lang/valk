class Node {
    left: ?Node (null)
    right: ?Node (null)

    static fn tree(depth: int) Node {
        if depth == 0 : return Node {}
        return Node { left: Node.tree(depth - 1), right: Node.tree(depth - 1) }
    }

    fn count() int {
        let total = 1
        let left = this.left
        let right = this.right
        if isset(left) : total += left.count()
        if isset(right) : total += right.count()
        return total
    }
}

fn in_region(depth: int) int {
    return Node.tree(depth).count()
}

fn main() {
    println(in_region(3))
}

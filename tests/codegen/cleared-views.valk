class Cell { number: int (73) }
struct Pair {
    first: Cell
    second: Cell
}

fn read_number(values: &[int]) int { return values[0] }
fn read_borrowed_pair(value: &Pair) int { return value.second.number }
fn read_stable_cell(value: Cell) int { return value.number }
fn read_callback(values: &[fn()(int)]) int { return values[0]() }
fn read_pair(values: &[Pair]) int {
    let pair = values[0]
    return pair.first.number + pair.second.number
}

fn main() {
    assert(read_number([int]{ 19 }) == 19)
    assert(read_callback([fn()(int)]{ fn() int { return 73 } }) == 73)
    assert(read_pair([Pair]{ Pair { first: Cell {}, second: Cell {} } }) == 146)
    let pairs = Array[Pair]{ Pair { first: Cell {}, second: Cell {} } }
    assert(read_borrowed_pair(&pairs[0]) == 73)
    assert(read_stable_cell(pairs[0].first) == 73)
}

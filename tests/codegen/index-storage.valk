class Holder {
    view: &mut [int] ([int]{7, 19, 23})
    fn shrink() uint {
        this.view = [int]{73}
        return 2
    }
}
fn read_selected(holder: Holder) int { return holder.view[holder.shrink()] }
fn write_selected(holder: Holder) { holder.view[holder.shrink()] = 29 }
fn borrow_selected(holder: Holder) &int { return &holder.view[holder.shrink()] }
fn range_selected(holder: Holder) &mut [int] { return holder.view[holder.shrink()..1] }
fn main() {
    let holder = Holder {}
    assert(read_selected(holder) == 23)
    holder = Holder {}
    let original = holder.view
    write_selected(holder)
    assert(original[2] == 29 && holder.view[0] == 73)
    holder = Holder {}
    assert(borrow_selected(holder)[0] == 23)
    holder = Holder {}
    assert(range_selected(holder)[0] == 23)
}

class Counter {
    number: int (73)
    fn read(value: int) int { return this.number + value }
}
struct Accumulator {
    number: int (0)
    fn add(value: int) { this.number += value }
}

class AccumulatorBox { acc: Accumulator (.{}) }

fn unbound_class() fn(Counter, int)(int) { return Counter.read }
fn unbound_struct() fn(local mut &Accumulator, int)() { return Accumulator.add }
fn bound_class(counter: Counter) fn(int)(int) { return counter.read }

fn apply_bound(method: fn(int)(), value: int) { method(value) }

fn main() {
    let counter = Counter {}
    assert(unbound_class()(counter, 19) == 92)
    assert(bound_class(counter)(19) == 92)
    let acc = Accumulator {}
    unbound_struct()(&acc, 19)
    assert(acc.number == 19)
    // A struct inside an object may be bound and handed on; frame storage may not
    let box = AccumulatorBox {}
    apply_bound(box.acc.add, 7)
    assert(box.acc.number == 7)
}

// Coroutine arguments: a by-pointer argument (>= 512 B) is copied into the helper's frame
// before its roots are popped, and the launch appends roots from a frame copy, not from Coro.args

class CoroArgValue {
    value: uint
}

struct CoroArgBig {
    item: CoroArgValue
    pad: [uint x 64]
}

fn coro_arg_big(arg: CoroArgBig) uint {
    return arg.item.value
}

fn main() {
    let big = CoroArgBig { item: CoroArgValue { value: 1 }, pad: @undefined }
    let task = co coro_arg_big(big)
    let _ = await task
}

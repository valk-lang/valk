use valk.time

struct AddressValue {
    value: uint
}

extern fn observe_address(value: ptr) void;

+ fn __native_address_storage__() uint {
    let value = AddressValue {value: 7}
    observe_address(@ref(value))
    return value.value
}

fn suspend_indirectly() {
    time.sleep_ms(0)
}

+ fn __suspending_address_storage__() uint {
    let value = AddressValue {value: 9}
    observe_address(@ref(value))
    suspend_indirectly()
    return value.value
}

fn main() {
    if __native_address_storage__() != 7 : panic("native address storage")
    let task = co __suspending_address_storage__()
    if await task != 9 : panic("suspending address storage")
}

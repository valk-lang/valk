fn sort_numbers(values: Array[int]) { values.sort() }
fn sort_slices(values: Array[mut &[int]]) {
    values.sort(fn(a: mut &[int], b: mut &[int]) bool { return a[0] > b[0] })
}
fn main() {
    let numbers = Array[int]{ 73, 19 }
    sort_numbers(numbers)
    assert(numbers[0] == 19)
    let rows = Array[mut &[int]]{ [int]{ 73 }, [int]{ 19 } }
    sort_slices(rows)
    assert(rows[0][0] == 19)
}

// Large fixed-array fills and copies must not expand per element.
struct Block {
    data: [u8 x 4096]
}

fn zero_struct() u8 {
    let b = Block{}
    return b.data[5]
}

fn seven_local() u8 {
    let a: [u8 x 4096] = { 7... }
    return a[5]
}

fn word_fill() int {
    let a: [int x 512] = { -1... }
    return a[5]
}

fn copy_block() u8 {
    let b = Block{}
    let c = b
    c.data[5] = 1
    return b.data[5] + c.data[5]
}

fn return_fill() [u8 x 4096] $noinline {
    return .{ 0... }
}

fn take_fill(a: [u8 x 4096]) u8 $noinline {
    return a[5]
}

fn pass_fill() u8 $noinline {
    return take_fill(.{ 7... })
}

fn main() {
    println(zero_struct() + seven_local())
    println(word_fill())
    println(copy_block())
    let r = return_fill()
    println(r[5] + pass_fill())
}

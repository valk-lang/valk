interface CodegenValue {
    fn value() uint;
}

class CodegenNumber is CodegenValue {
    fn value() uint {
        return 19
    }
}

fn interface_fat_value(value: CodegenNumber) bool {
    let wrapped: CodegenValue = value
    return wrapped is_a CodegenNumber && wrapped.value() == 19
}

fn main() {
    assert(interface_fat_value(CodegenNumber {}))
}

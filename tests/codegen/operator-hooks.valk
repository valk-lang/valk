class HookCounter {
    count: int (0)
    fn add(amount: int) int $add {
        this.count += amount
        return this.count
    }
    group stats {
        fn increment() { this.count++ }
        get total: int { return this.count }
        fn read() int { return this.total }
    }
}

+ fn __shared_operator_add__(counter: atomic HookCounter) int { return counter + 1 }
+ fn __shared_group_increment__(counter: atomic HookCounter) { counter.stats.increment() }
+ fn __shared_group_read__(counter: atomic HookCounter) int { return counter.stats.read() }

fn main() {
    let counter: atomic HookCounter = HookCounter {}
    if __shared_operator_add__(counter) != 1 : panic("shared operator")
    __shared_group_increment__(counter)
    if __shared_group_read__(counter) != 2 : panic("shared group")
}

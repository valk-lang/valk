class Holder { values: [int x 3] ({ 7, 19, 23 }) }
class Factory {
    holder: Holder (.{})
    calls: int (0)
    starts: int (0)
    fn make() Holder { this.calls++; return this.holder }
    fn borrowed() &[int x 3] { this.calls++; return &this.holder.values }
    fn start() uint { this.starts++; return 1 }
}
fn copy_property(factory: Factory) [int x 2] { return factory.make().values[factory.start()..2] }
fn copy_borrowed(factory: Factory) [int x 2] { return factory.borrowed()[factory.start()..2] }
fn main() {
    let factory = Factory {}
    let first = copy_property(factory)
    let second = copy_borrowed(factory)
    assert(factory.calls == 2 && factory.starts == 2)
    assert(first[0] == 19 && first[1] == 23)
    assert(second[0] == 19 && second[1] == 23)
}

class Steps {
    fn _next(index: $I, value: $V (73)) V !IterError {
        if index >= 2 : throw .end
        return value
    }
}
class Endless { fn _next(index: $I, value: $V (19)) (I, V) { return (index, value) } }
fn generic_sum(steps: Steps) int {
    let total = 0
    each steps as value : total += value
    return total
}
fn generic_tuple_sum(steps: Endless) int {
    let total = 0
    each steps as index, value {
        total += value
        if index == 2 : break
    }
    return total
}
fn main() {
    assert(generic_sum(Steps {}) == 146)
    assert(generic_tuple_sum(Endless {}) == 57)
}

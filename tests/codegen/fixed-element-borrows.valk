class Item { number: int }
class Holder {
    items: [?Item x 2] ({ null, null })
    required: [Item x 2] ({ Item { number: 7 }, Item { number: 19 } })
}
fn borrow_nullable(holder: Holder, index: uint) &mut ?Item { return &mut holder.items[index] }
fn borrow_required(holder: Holder, index: uint) &mut Item { return &mut holder.required[index] }
fn main() {
    let holder = Holder {}
    let item = Item { number: 73 }
    borrow_nullable(holder, 0)[0] = item
    borrow_required(holder, 1)[0] = item
    assert(holder.items[0] == item && holder.required[1] == item)
}

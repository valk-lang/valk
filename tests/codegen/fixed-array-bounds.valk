fn fixed_read(values: [u8 x 3], index: uint) u8 {
    return values[index]
}

fn bounded_read(values: *[u8 x 3], index: uint) u8 {
    return values[index]
}

fn named_bounded_read(values: cstring[x 3], index: uint) u8 {
    return values[index]
}

fn fixed_write(values: [u8 x 3], index: uint, value: u8) {
    values[index] = value
}

fn main() {
    let values: [u8 x 3] = {1, 2, 3}
    fixed_write(values, 1, 4)
    if fixed_read(values, 1) != 4 : panic("fixed array write failed")
    if bounded_read(values, 2) != 3 : panic("bounded view read failed")
    if named_bounded_read(@ref(values).@cast(cstring[x 3]), 0) != 1 : panic("named bounded read failed")
}

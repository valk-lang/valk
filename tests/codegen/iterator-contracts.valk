class Steps { fn _next(index: uint, base: int (73)) int !IterError {
    if index >= 2 : throw .end
    return base + index.to(int)
} }
class Endless { fn _next(index: uint, base: int (19)) int { return base + index.to(int) } }
fn default_sum(steps: Steps) int {
    let total = 0
    each steps as value : total += value
    return total
}
fn infallible_sum(steps: Endless) int {
    let total = 0
    each steps as value, index {
        total += value
        if index == 2 : break
    }
    return total
}
fn main() {
    assert(default_sum(Steps {}) == 147)
    assert(infallible_sum(Endless {}) == 60)
}

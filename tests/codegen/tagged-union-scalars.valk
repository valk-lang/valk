union BoxInt : String | int {}
union BoxI32 : String | i32 {}
union BoxU8 : String | u8 {}
union BoxBool : String | bool {}
union BoxF32 : String | f32 {}
union BoxF64 : String | f64 {}
union ScalarOnly : int | bool {}

enum ScalarKind: u8 {
    none
    value
}

union ScalarEnum : ScalarKind | String {}

class GcOnlyNode {}
union GcOnly : String | GcOnlyNode {}

fn box_int(value: int) BoxInt { return value }
fn box_i32(value: i32) BoxI32 { return value }
fn box_u8(value: u8) BoxU8 { return value }
fn box_bool(value: bool) BoxBool { return value }
fn box_f32(value: f32) BoxF32 { return value }
fn box_f64(value: f64) BoxF64 { return value }
fn box_scalar_only(value: int) ScalarOnly { return value }
fn box_gc_only(value: String) GcOnly { return value }
fn union_equal_member(value: ScalarEnum) bool { return value == ScalarKind.value }
fn member_equal_union(value: ScalarEnum) bool { return ScalarKind.value == value }

fn main() {
    box_int(-1)
    box_i32(-2)
    box_u8(3)
    box_bool(true)
    box_f32(1.25.to(f32))
    box_f64(2.5.to(f64))
    box_scalar_only(4)
    box_gc_only("gc")
    union_equal_member(ScalarKind.value)
    member_equal_union(ScalarKind.value)
}

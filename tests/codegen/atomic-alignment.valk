class AtomicAlignment {
    byte: u8
    half: u16
    word: u32
}

class AtomicReadOnly {
    - fixed: u32 (0)
}

fn atomic_alignment(value: atomic AtomicAlignment) u32 {
    return value.byte + value.half + value.word
}

fn atomic_readonly_load(value: atomic AtomicReadOnly) u32 {
    return value.fixed
}

fn locked_plain_store(box: Lock[AtomicAlignment]) {
    lock box as v {
        v.word += 1
        v.word = 7
    }
}

fn publish_elide_dead() atomic Array[uint] {
    let items = Array[uint].new(4)
    items.append(1)
    items.append(2)
    return items
}

fn publish_keep_live() (atomic Array[uint], uint) {
    let items = Array[uint].new(4)
    items.append(1)
    let shared: atomic Array[uint] = items
    items.append(2)
    return (shared, items.length)
}

fn main() {
    atomic_alignment(AtomicAlignment { byte: 1, half: 2, word: 3 })
    atomic_readonly_load(AtomicReadOnly { fixed: 4 })
    let box: Lock[AtomicAlignment] = .new(AtomicAlignment { byte: 1, half: 2, word: 3 }) !!
    locked_plain_store(box)
    publish_elide_dead()
    publish_keep_live()
}

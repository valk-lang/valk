fn conditional_scalar(value: ?int) int {
    return value ?? panic("Missing value")
}

fn conditional_aggregate(value: ?[int x 2]) [int x 2] {
    return value ?? panic("Missing array")
}

fn main() {
    assert(conditional_scalar(73) == 73)
    let values: [int x 2] = { 79, 83 }
    assert(conditional_aggregate(values)[0] == 79)
}

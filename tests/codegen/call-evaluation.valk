fn consume(value: int) int { return value + 73 }

fn pointer_call(pointer: fnptr(int)(int), value: int) int {
    return pointer(value)
}

fn pointer_task(pointer: fnptr(int)(int), value: int) co(int) {
    return co pointer(value)
}

fn main() {
    assert(pointer_call(consume, 7) == 80)
    let task = pointer_task(consume, 11)
    assert(await task == 84)
}

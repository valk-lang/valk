fn exit_number() int $exit { panic("Nonreturning operand reached") }
fn combine(first: int, second: int) int { return first + second }

fn interrupted_call(fail: bool) int {
    return combine(11, fail ? combine(13, exit_number()) : 17)
}

fn interrupted_array(fail: bool) [int x 2] {
    return .{ 11, fail ? combine(13, exit_number()) : 17 }
}

fn main() {
    assert(interrupted_call(false) == 28)
    assert(interrupted_array(false)[1] == 17)
}

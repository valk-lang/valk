class Item { number: int (23) }
struct Cell {
    number: int (17)
    fn increment() { this.number++ }
}

+ fn __borrow_receiver_read__(value: &Item) int { return value.number }
+ fn __borrow_receiver_write__(value: &Cell) { value.increment() }

class Owner {
    item: Item (.{})
    cell: Cell (.{})
}

fn main() {
    let owner = Owner {}
    __borrow_receiver_write__(&owner.cell)
    if __borrow_receiver_read__(&owner.item) != 23 || owner.cell.number != 18 : panic("borrowed receiver")
}

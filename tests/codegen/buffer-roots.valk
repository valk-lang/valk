use valk:gc

class RootValue {
    value: uint
}

fn keep_two(first: RootValue, second: RootValue) uint {
    // The caller's temporary roots must remain valid while collection runs.
    gc:collect()
    return first.value + second.value
}

fn coalesced_roots() uint {
    let first = keep_two(RootValue { value: 1 }, RootValue { value: 2 })
    let second = keep_two(RootValue { value: 3 }, RootValue { value: 4 })
    return first + second
}

fn coroutine_root(value: RootValue) RootValue {
    gc:collect()
    return value
}

fn main() {
    if coalesced_roots() != 10 : panic("temporary GC root corruption")
    let task = co coroutine_root(RootValue { value: 5 })
    if (await task).value != 5 : panic("coroutine GC root corruption")
}

use valk:gc

class RootValue {
    value: uint
}

struct InlineLayoutValue {
    nested: RootValue
}

union AlignedLayoutUnion : (bool, RootValue) | int {}

fn aligned_layout_union() AlignedLayoutUnion {
    return (true, RootValue { value: 5 })
}

fn keep_two(first: RootValue, second: RootValue) uint {
    // The caller's temporary roots must remain valid while collection runs.
    gc:collect()
    return first.value + second.value
}

fn coalesced_roots() uint {
    let first = keep_two(RootValue { value: 1 }, RootValue { value: 2 })
    let second = keep_two(RootValue { value: 3 }, RootValue { value: 4 })
    return first + second
}

fn coroutine_root(value: RootValue) RootValue {
    gc:collect()
    return value
}

fn inline_layout_roots(values: [?InlineLayoutValue x 2], tagged: AlignedLayoutUnion) bool {
    gc:collect()
    return isset(values[0]) && tagged == tagged
}

fn lexical_scope_roots() {
    {
        let scoped = RootValue { value: 7 }
        if scoped.value != 7 : panic("scope root corruption")
    }
    gc:collect()
}

fn inline_fixed_value() [u8 x 3] {
    return [u8 x 3]{1, 2, 3}
}

fn main() {
    if coalesced_roots() != 10 : panic("temporary GC root corruption")
    let task = co coroutine_root(RootValue { value: 5 })
    if (await task).value != 5 : panic("coroutine GC root corruption")

    let inline_values: [?InlineLayoutValue x 2] = {
        { nested: RootValue { value: 5 } }
        null
    }
    if !inline_layout_roots(inline_values, aligned_layout_union()) {
        panic("inline GC layout corruption")
    }
    lexical_scope_roots()
    if inline_fixed_value()[2] != 3 : panic("inline fixed value corruption")
}

struct Entry {
    number: int
    fn read() int { return this.number }
    fn read_generic[T](unused: T) int { return this.number }
}
enum Choice: Entry { first (Entry { number: 7 }) }
fn read_enum(value: local &Choice) int { return value.read() }
fn read_bound(value: local &Choice) int {
    let read = value.read
    return read()
}
fn read_generic(value: local &Choice) int { return value.read_generic[int](1) }
fn modify_copy(value: Choice) int {
    let copy: Entry = value
    copy.number = 73
    return copy.number
}
fn main() {
    let value = Choice.first
    assert(read_enum(&value) == 7)
    assert(read_bound(&value) == 7)
    assert(read_generic(&value) == 7)
    assert(modify_copy(value) == 73 && value.number == 7)
}

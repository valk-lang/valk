class Holder { rows: [[int x 2] x 3] ({ { 7, 11 }, { 19, 23 }, { 29, 31 } }) }
fn borrow_rows(holder: Holder) &[[int x 2] x 3] { return &holder.rows }
fn row_view(rows: &[[int x 2] x 3]) &[[int x 2]] { return rows }
fn read_row(rows: &[[int x 2] x 3], index: uint) int { return rows[index][1] }
fn main() {
    let holder = Holder {}
    let rows = borrow_rows(holder)
    assert(read_row(rows, 2) == 31)
    let view = row_view(rows)
    assert(view.length == 3 && view[1][0] == 19)
}

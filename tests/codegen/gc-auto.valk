// `--gc auto` builds this single-threaded program with Grove: its loop with a call polls
class GcAutoNode {
    v: int (0)
}

fn gc_auto_step(i: int) int $noinline {
    let node = GcAutoNode { v: i }
    return node.v
}

fn gc_auto_loop(n: int) int $noinline {
    let total = 0
    let i = 0
    while i < n {
        total += gc_auto_step(i)
        i++
    }
    return total
}

fn main() {
    println(gc_auto_loop(3))
}

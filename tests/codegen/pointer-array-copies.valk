fn copy_rows(rows: *[[int x 2] x 3]) [[int x 2] x 3] { return rows }
fn widen_rows(rows: *[[int x 2] x 3]) [[?int x 2] x 3] { return rows }
fn main() {
    let rows: [[int x 2] x 3] = { { 7, 11 }, { 19, 23 }, { 29, 31 } }
    let copy = copy_rows(&rows)
    let widened = widen_rows(&rows)
    assert(copy[2][1] == 31)
    assert((widened[2][1] ?? 0) == 31)
}

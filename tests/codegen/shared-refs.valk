class SharedRefItem {
    value: uint
}

class SharedRefHolder {
    items: [?SharedRefItem x 2]
}

shared shared_ref_global: ?SharedRefItem (null)

fn shared_ref_global_store(item: SharedRefItem) {
    shared_ref_global = item
}

fn shared_ref_global_load() uint {
    let item = shared_ref_global ?! return 0
    return item.value
}

fn shared_ref_element_store(holder: atomic SharedRefHolder, item: SharedRefItem) {
    holder.items[1] = item
}

fn shared_ref_element_load(holder: atomic SharedRefHolder) uint {
    let item = holder.items[1] ?! return 0
    return item.value
}

fn main() {
    shared_ref_global_store(SharedRefItem { value: 1 })
    let holder: atomic SharedRefHolder = SharedRefHolder { items: .{ null, null } }
    shared_ref_element_store(holder, SharedRefItem { value: 2 })
    shared_ref_global_load() + shared_ref_element_load(holder)
}

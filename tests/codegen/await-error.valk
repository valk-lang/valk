error AwaitError (failed)

class AwaitResult {
    value: uint (1)
}

fn failed_result() AwaitResult !AwaitError {
    throw .failed
}

fn await_failed_result() bool {
    let task = co failed_result()
    let result = await task !? null
    return !isset(result)
}

fn main() {
    assert(await_failed_result())
}

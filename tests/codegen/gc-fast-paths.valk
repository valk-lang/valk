class GuardNode {
    next: ?GuardNode
}

fn property_guard_fast_path(node: GuardNode, next: ?GuardNode) {
    node.next = next
}

fn array_append_fast_path(items: Array[ptr], item: ptr) {
    @unsafe
    items.append(item)
}

fn reassign_slice_argument(value: String) String {
    value = value + "!"
    return value
}

fn main() {
    @unsafe
    let node = GuardNode {}
    property_guard_fast_path(node, null)

    let items = Array[ptr]{}
    array_append_fast_path(items, items.items().@cast(ptr))
    reassign_slice_argument("rooted")
}

class GuardNode {
    next: ?GuardNode
}

fn property_guard_fast_path(node: GuardNode, next: ?GuardNode) {
    node.next = next
}

fn array_append_fast_path(items: Array[ptr], item: ptr) {
    items.append(item)
}

fn main() {
    let node = GuardNode {}
    property_guard_fast_path(node, null)

    let items = Array[ptr]{}
    array_append_fast_path(items, items.data)
}

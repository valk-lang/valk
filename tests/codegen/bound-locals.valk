struct Counter {
    number: int
    fn add(n: int) int { this.number += n
 return this.number }
}
fn local_binding(counter: local mut &Counter) int {
    let add = counter.add
    return add(7) + add(19)
}
fn loop_binding(counter: local mut &Counter) int {
    let i = 0
    while i < 3 {
        let add = counter.add
        add(7)
        i++
    }
    return counter.number
}
class Owner { counter: Counter }
class Factory {
    calls: int (0)
    fn make() Owner { this.calls++
 return Owner { counter: { number: 0 } } }
}
fn from_factory(factory: Factory) int {
    let add = factory.make().counter.add
    return add(7)
}
fn main() {
    let counter = Counter { number: 0 }
    assert(local_binding(&counter) == 33)
    assert(loop_binding(&counter) == 47)
    let factory = Factory {}
    assert(from_factory(factory) == 7 && factory.calls == 1)
}

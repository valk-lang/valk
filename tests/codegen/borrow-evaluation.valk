class Factory {
    calls: int (0)
    indices: int (0)
    fn array() Array[int] {
        this.calls++
        return Array[int]{ this.calls }
    }
    fn arrays() Array[Array[int]] {
        this.calls++
        return Array[Array[int]]{ Array[int]{ this.calls } }
    }
    fn index() uint {
        this.indices++
        return 0
    }
}
fn borrow_temporary(factory: Factory) &int {
    return &factory.array()[factory.index()]
}
fn borrow_nested(factory: Factory) &int {
    return &factory.arrays()[factory.index()][factory.index()]
}
fn main() {
    let factory = Factory {}
    let first = borrow_temporary(factory)
    assert(factory.calls == 1 && factory.indices == 1 && first[0] == 1)
    let nested = borrow_nested(factory)
    assert(factory.calls == 2 && factory.indices == 3 && nested[0] == 2)
}

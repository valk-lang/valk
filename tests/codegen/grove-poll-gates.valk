// Grove: a loop whose calls cannot reach GC work keeps a poll whose gate is false; a loop
// that calls an allocating function keeps a live poll
class PollGateNode {
    v: int (0)
}

fn poll_gate_leaf(i: int) int $noinline {
    return i * 3 + 1
}

fn poll_gate_alloc(i: int) int $noinline {
    let node = PollGateNode { v: i }
    return node.v
}

fn poll_gate_leaf_loop(n: int) int $noinline {
    let total = 0
    let i = 0
    while i < n {
        total += poll_gate_leaf(i)
        i++
    }
    return total
}

fn poll_gate_alloc_loop(n: int) int $noinline {
    let total = 0
    let i = 0
    while i < n {
        total += poll_gate_alloc(i)
        i++
    }
    return total
}

fn main() {
    println(poll_gate_leaf_loop(3) + poll_gate_alloc_loop(3))
}

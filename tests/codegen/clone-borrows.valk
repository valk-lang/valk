struct CloneCell {
    number: int (23)
    fn clone() SELF $clone { return SELF { number: this.number } }
}

+ fn __clone_borrow_inline__(value: stack CloneCell) CloneCell { return $clone(value) }
+ fn __clone_nullable_borrow_inline__(value: ?stack CloneCell) ?CloneCell { return $clone(value) }
+ fn __clone_nullable_inline__(value: ?CloneCell) ?CloneCell { return $clone(value) }

fn main() {
    let value = CloneCell {}
    if __clone_borrow_inline__(&value).number != 23 : panic("clone receiver")
    let copied = __clone_nullable_borrow_inline__(&value)
    if !isset(copied) : panic("clone presence")
    if copied.number != 23 : panic("clone value")
    if isset(__clone_nullable_borrow_inline__(null)) : panic("clone absence")
    let optional = __clone_nullable_inline__(value)
    if !isset(optional) : panic("inline clone presence")
    if optional.number != 23 : panic("inline clone value")
    if isset(__clone_nullable_inline__(null)) : panic("inline clone absence")
}

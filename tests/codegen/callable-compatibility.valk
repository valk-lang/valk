class CallableBox { number: int (73) }

fn callable_consume(box: ?CallableBox) int {
    return isset(box) ? box.number : 0
}

fn callable_create() CallableBox { return CallableBox {} }

fn callable_argument_view() shared fn(CallableBox)(int) { return callable_consume }
fn callable_result_view() fn()(?CallableBox) { return callable_create }
fn callable_pointer_view() fnptr(CallableBox)(int) { return callable_consume }

fn main() {
    let argument = callable_argument_view()
    let result = callable_result_view()
    let pointer = callable_pointer_view()
    let box = result()
    if !isset(box) : panic("Missing callable result")
    assert(argument(box) == 73)
    assert(pointer(box) == 73)
}

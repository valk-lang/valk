fn scale(a: Array[float], f: float) $noinline {
    let i: uint = 0
    while i < a.length {
        a[i] = a[i] * f
        i++
    }
}

fn raw_store(p: ptr) $noinline {
    @unsafe
    @ptrv(p, u64, 1) = 7
}

fn main() {
    @unsafe
    let a = Array[float]{ 1.0 x 8 }
    scale(a, 0.5)
    let p = a.data.@cast(ptr)
    raw_store(p)
}

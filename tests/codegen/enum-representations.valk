enum Optional: ?int { first (7)
    second (19) }
enum Row: [int x 2] { first ({ 7, 19 })
    second ({ 19, 7 }) }
class Holder { value: Optional
    row: Row }
fn read_optional(value: &Optional) ?int { return value[0] }
fn replace_row(value: stack Row) { value[0] = Row.second }
fn read_row(value: &Row) int { return value[0][1] }
fn main() {
    let holder = Holder {}
    assert(read_optional(&holder.value) == 7)
    replace_row(&mut holder.row)
    assert(read_row(&holder.row) == 7)
    let rows: &[Row] = holder.row
    assert(rows.length == 1 && rows[0][0] == 19)
}

type PointerClosureFunction (fnptr(int)(int))

fn add(value: int) int { return value + 73 }

fn known_pointer_closure(value: int) int {
    let closure: fn(int)(int) = add.to(PointerClosureFunction)
    return closure(value)
}

fn known_literal_closure(value: int) int {
    let closure: fn(int)(int) = (fn(number: int) int { return number + 29 }).to(PointerClosureFunction)
    return closure(value)
}

fn dynamic_pointer_closure(pointer: fnptr(int)(int)) fn(int)(int) {
    return pointer
}

fn main() {
    assert(known_pointer_closure(19) == 92)
    assert(known_literal_closure(19) == 48)
    let closure = dynamic_pointer_closure(add)
    assert(closure(19) == 92)
}

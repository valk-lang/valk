use valk.thread
use valk.time

// A panic on one thread ends the process with code 1 while the other thread
// is still busy.
fn main() int {
    thread.start(fn() {
        panic("Conditional panic reached")
    }) !!
    let spins: uint = 0
    while spins < 1_000_000_000 : spins++
    return 0
}

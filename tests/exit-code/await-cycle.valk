use valk.time

class AwaitCycle {
    a: ?co(int) (null)
    b: ?co(int) (null)
}

fn await_cycle_a(h: AwaitCycle) int {
    time.sleep_ms(2)
    let t = h.b ?! return 0
    return await t
}
fn await_cycle_b(h: AwaitCycle) int {
    time.sleep_ms(2)
    let t = h.a ?! return 0
    return await t
}

fn main() {
    let h = AwaitCycle{}
    h.a = co await_cycle_a(h)
    h.b = co await_cycle_b(h)
    let t = h.a ?! return
    println(await t)
}

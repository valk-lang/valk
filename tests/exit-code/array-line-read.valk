fn first(values: Array[int], index: uint) int {
    return values[index]
}

fn second(values: Array[int], index: uint) int {
    let start = values[0]
    return start + values[index]
}

// Each index reports its own line, not the first one compiled for the array's type
fn main() {
    let values = Array[int]{ 1, 2 }
    println(second(values, 1))
    println(first(values, 9))
}

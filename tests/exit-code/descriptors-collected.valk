use valk.fs
use valk.net
use valk.core

// Run under a low `ulimit -n`: every descriptor below is dropped without a close

fn drop_file() {
    fs.stream("/dev/null") !!
}

fn drop_socket() {
    net.udp_client("127.0.0.1", 9) !!
}

fn drop_pipes() {
    core.Process.start("true", stdout: core.Stdio.pipe, stderr: core.Stdio.pipe) !!
}

fn main() {
    each 0 .. 1000 : drop_file()
    each 0 .. 1000 : drop_socket()
    each 0 .. 200 : drop_pipes()
}

use valk.gc
use valk.mem

class Node {
    value: int (0)
    next: ?Node (null)
}

global holder: ?Node (null)

// An object in a region is put into an object of the collector behind the compiler's back,
// as a number: a debug build stops at the next collection
fn smuggle() $noinline {
    @unsafe
    let node = Node { value: 9 }
    let adr = mem.identity(node.@cast(ptr))
    let h = holder
    if isset(h) : @ptrv(h.@cast(ptr), uint, 1) = adr
    gc.collect()
    println(node.value)
}

fn main() {
    holder = Node { value: 1 }
    smuggle()
}

// Not in the main suite: GC_DEBUG builds always clear, only plain builds take the calloc shortcut
use valk.gc

fn dirty_bytes(v: &[u8]) uint {
    let count: uint = 0
    each v as b {
        if b != 0 : count++
    }
    return count
}

fn run(seed: uint, size: uint) {
    let keep = Array[mut &[u8]]{}
    let x = seed
    each 0 .. 2500 as round {
        x = x * 1103515245 + 12345
        each 0 .. (x >> 16) % 20 + 1 as n {
            let v = [u8]{ 0 x size }
            if dirty_bytes(v) > 0 : panic("Zero-filled slice holds old data")
            each 0 .. v.length as i {
                v[i] = 0xAB
            }
            x = x * 1103515245 + 12345
            if (x >> 20) % 4 == 0 : keep.append(v)
        }
        x = x * 1103515245 + 12345
        let drop = (x >> 18) % 8
        if drop == 0 : keep.clear()
        if drop == 1 && keep.length > 0 : keep.remove(0)
        if drop == 2 : gc.collect()
    }
}

fn main() {
    each 0 .. 6 as s {
        run(s.to(uint) * 7 + 1, 33000)
        run(s.to(uint) * 3 + 2, 70000)
        gc.release_memory()
    }
}

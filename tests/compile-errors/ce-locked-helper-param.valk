// A helper that stores its parameter under a lock it takes itself cannot vouch for it
class E { n: uint (0) }
class S { list: Array[E] (.{}) }
fn put(l: shared Lock[S], x: E) {
    lock l as s { s.list.append(x) }
}
fn main() {
    let a: shared Lock[S] = .new(S {}) !!
    let x = E{}
    put(a, x)
}

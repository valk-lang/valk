class LockEachEntry { id: uint (0) }
class LockEachValue { entry: ?LockEachEntry (null) }
fn main() {
    let state: shared Lock[LockEachValue] = .new(LockEachValue {}) !!
    let names = Map[uint]{}
    names.set("a", 1)
    each names as v, k {
        let entry = LockEachEntry {}
        let alias = entry
        lock state as s {
            s.entry = entry
        }
        alias.id = v
    }
}

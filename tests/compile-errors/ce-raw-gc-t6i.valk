// Grove C-31: raw access to memory with GC references (probe t6i)
class Node {
    v: uint
}
class Holder {
    a: ?Node
}
fn main() {
    let h = Holder { a: Node { v: 5 } }
    let h2 = Holder { a: null }
    let p = h.@cast(ptr)
    let p2 = h2.@cast(ptr)
    @ptrv(p2, uint, 0) = @ptrv(p, uint, 0)
    let n = h2.a ?? Node { v: 0 }
    println(n.v)
}

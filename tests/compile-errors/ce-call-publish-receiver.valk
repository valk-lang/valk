class Item { number: int; fn bump(extra: int) { this.number += extra } }
shared retained: ?Item (null)
fn publish(item: shared Item) int { retained = item; return 1 }
fn mutate(item: Item, extra: int) { item.number += extra }
fn main() {
    let source = Item { number: 73 }
    source.bump(publish(source))
    println((retained ?? panic("missing")).number)
}

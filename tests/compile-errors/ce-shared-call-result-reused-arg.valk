class Item { n: uint (1) }
class Box { item: Item }
fn wrap(x: Item) Box { return Box { item: x } }

class Hub {
    boxes: Array[shared Box] (.{})
    fn keep(b: shared Box) { this.boxes.append(b) }
}

fn main() {
    let h = Hub {}
    let x = Item {}
    h.keep(wrap(x))
    x.n = 5
    println(h.boxes.length)
}

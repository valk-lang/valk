use valk.core
class LockValue { count: uint (0) }
class LockKeeper { kept: ?shared LockValue (null) }
fn keep(keeper: LockKeeper, value: shared LockValue) { keeper.kept = value }
fn main() {
    let state: shared Lock[LockValue] = .new(LockValue {}) !!
    let keeper = LockKeeper {}
    lock state as s {
        keep(keeper, s)
    }
}

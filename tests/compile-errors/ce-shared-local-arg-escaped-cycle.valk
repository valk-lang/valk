class Item { names: Array[String] (.{}); n: uint (1); child: ?Item (null) }
class Hub {
    items: Array[shared Item] (.{})
    fn keep(i: shared Item) { this.items.append(i) }
}
class Registry { items: Array[Item] (.{}) }

// The cycle's summary is still being computed when the local is passed
fn reg_a(r: Registry, h: Hub, i: Item, n: uint) {
    if n == 0 {
        r.items.append(i)
        return
    }
    reg_b(r, h, i, n - 1)
    let item = Item {}
    reg_b(r, h, item, 0)
    h.keep(item)
}
fn reg_b(r: Registry, h: Hub, i: Item, n: uint) { reg_a(r, h, i, n) }

fn main() {
    reg_a(Registry {}, Hub {}, Item {}, 1)
}

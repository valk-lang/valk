class LockedSortItem { n: int (0) }
class LockedSortState { items: Array[LockedSortItem] (.{}) }
fn main() {
    let state: shared Lock[LockedSortState] = .new(LockedSortState {}) !!
    lock state as s {
        s.items.sort(fn(a: LockedSortItem, b: LockedSortItem) bool { return a.n > b.n })
    }
}

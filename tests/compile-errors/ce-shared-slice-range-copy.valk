class SharedSliceRangeItem { name: String ("a") }
class SharedSliceRangeHolder { ro: &[SharedSliceRangeItem] ([SharedSliceRangeItem]{ SharedSliceRangeItem {}, SharedSliceRangeItem {} }) }
fn main() {
    let h: shared SharedSliceRangeHolder = SharedSliceRangeHolder {}
    let part = h.ro[0..2]
    each part as item : item.name = "mut"
}

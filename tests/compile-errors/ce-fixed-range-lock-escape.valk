class Item { number: int }
class Holder { values: [Item x 2] ({ Item { number: 7 }, Item { number: 19 } }) }
fn copy(state: shared Lock[Holder]) [locked Item x 2] {
    lock state as holder { return holder.values[0..2] }
}
fn main() {
    let state: shared Lock[Holder] = .new(Holder {}) !!
    let _ = copy(state)
}

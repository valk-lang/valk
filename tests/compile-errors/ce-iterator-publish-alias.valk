class Item { number: int }
class Steps {
    item: Item (.{ number: 7 })
    fn _next(index: uint) Item !IterError {
        if index >= 1 : throw .end
        return this.item
    }
}
fn main() {
    let source = Steps {}
    each source as item {
        let published: shared Item = item
        source.item.number = 73
        println(published.number)
    }
}

class LoopReadAliasChild { number: int }
class LoopReadAliasParent { child: LoopReadAliasChild (.{ number: 1 }) }
shared loop_read_alias_saved: ?LoopReadAliasParent (null)
fn main() {
    let parent = LoopReadAliasParent {}
    let child = LoopReadAliasChild { number: 0 }
    let i = 0
    while i++ < 3 {
        loop_read_alias_saved = parent
        child.number = 99
        parent = LoopReadAliasParent {}
        child = parent.child
    }
}

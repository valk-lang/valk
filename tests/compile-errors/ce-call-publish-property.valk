class Item { number: int }
class Parent { item: Item (.{ number: 73 }) }
shared retained: ?Parent (null)
fn publish(parent: shared Parent) int { retained = parent; return 1 }
fn mutate(item: Item, extra: int) { item.number += extra }
fn main() {
    let source = Parent {}
    mutate(source.item, publish(source))
}

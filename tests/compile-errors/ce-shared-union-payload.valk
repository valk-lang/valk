class SharedUnionItem { name: String ("a") }
union SharedUnionValue : SharedUnionItem | int {}
class SharedUnionHolder { value: SharedUnionValue }

fn mutate(item: SharedUnionItem) { item.name = "b" }
fn make() SharedUnionHolder { return SharedUnionHolder { value: SharedUnionItem {} } }

fn main() {
    let holder: shared SharedUnionHolder = make()
    match holder.value {
        SharedUnionItem as item => mutate(item)
        int as number => println(number)
    }
}

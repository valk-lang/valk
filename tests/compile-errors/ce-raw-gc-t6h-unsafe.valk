// Grove C-31: inside @unsafe the access is rejected by provenance (probe t6h)
class Node {
    v: uint
}
struct Inner {
    node: ?Node
}
class Holder {
    inner: Inner
}
fn main() {
    @unsafe
    let h = Holder { inner: .{ node: Node { v: 1 } } }
    let p = @ref(h.inner)
    p.node = Node { v: 7 }
    let n = h.inner.node ?? Node { v: 0 }
    println(n.v)
}

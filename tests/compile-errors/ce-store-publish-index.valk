struct Part { number: int }
class Item { number: int; part: Part; numbers: [int x 2] }
shared retained: ?Item (null)
fn publish(item: shared Item) int { retained = item; return 0 }
fn main() {
    let source = Item { number: 73, part: .{ number: 71 }, numbers: .{ 67, 61 } }
    source.numbers[publish(source)] = 79
}

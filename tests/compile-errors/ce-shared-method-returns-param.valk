class SharedReturnsParamValue { name: String ("a") }
class SharedReturnsParamBox { fn choose(other: SharedReturnsParamValue) SharedReturnsParamValue { return other } }
shared shared_returns_param_saved: ?SharedReturnsParamValue (null)
fn main() {
    let sb: shared SharedReturnsParamBox = SharedReturnsParamBox {}
    let v = SharedReturnsParamValue {}
    shared_returns_param_saved = sb.choose(v)
    v.name = "mutated"
}

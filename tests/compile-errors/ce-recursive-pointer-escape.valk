global kept_pointer: ?*int (null)
fn retain_pointer(value: *int, depth: uint) {
    if depth == 0 {
        kept_pointer = value
        return
    }
    forward_pointer(value, depth - 1)
}
fn forward_pointer(value: *int, depth: uint) { retain_pointer(value, depth) }
fn main() {
    let number = 23
    forward_pointer(&number, 3)
}

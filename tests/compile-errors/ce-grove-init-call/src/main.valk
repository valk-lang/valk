fn tick(i: uint) uint $noinline {
    return i + 1
}

// A call between the storage's allocation and its first `@init` store
fn make(n: uint) &[uint] {
    @unsafe
    let s = @uninit([uint]{ 0 x n })
    let data = s.data
    let first = tick(0)
    @init(@ptrv(data, uint, 0), first)
    return s
}

fn main() {
    make(1)
}

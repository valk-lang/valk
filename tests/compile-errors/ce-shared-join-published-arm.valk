class JoinArmItem { n: int (0) }
shared JOIN_ARM_SAVED: ?JoinArmItem (null)

fn run(mode: int) {
    let item = JoinArmItem{}
    match mode {
        1 => item = JoinArmItem{}
        default => {
            let s: shared JoinArmItem = item
            JOIN_ARM_SAVED = s
        }
    }
    item.n = 1
}

fn main() { run(1) }

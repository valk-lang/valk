class SharedToItem { name: String ("a") }
class SharedToWrap {
    item: SharedToItem
    fn to_item() SharedToItem $to { return this.item }
}

fn mutate(item: SharedToItem) { item.name = "b" }
fn make() SharedToWrap { return SharedToWrap { item: SharedToItem {} } }

fn main() {
    let wrap: atomic SharedToWrap = make()
    mutate(wrap.to(SharedToItem))
}

class SharedStructItem { name: String ("a") }
struct SharedStructPair { item: SharedStructItem }
class SharedStructHolder { pair: SharedStructPair }

fn mutate(item: SharedStructItem) { item.name = "b" }
fn make() SharedStructHolder { return SharedStructHolder { pair: SharedStructPair { item: SharedStructItem {} } } }

fn main() {
    let holder: shared SharedStructHolder = make()
    mutate(holder.pair.item)
}

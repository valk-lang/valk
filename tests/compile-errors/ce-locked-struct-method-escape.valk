class LockedStructItem { name: String ("a") }
struct LockedStructPair { item: LockedStructItem fn stash() { locked_struct_global = this.item } }
class LockedStructState { pair: LockedStructPair (LockedStructPair { item: LockedStructItem {} }) }
global locked_struct_global : ?LockedStructItem (null)
fn main() {
    let st: shared Lock[LockedStructState] = .new(LockedStructState {}) !!
    lock st as s { s.pair.stash() }
}

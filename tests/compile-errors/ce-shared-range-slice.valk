class SharedRangeItem { name: String ("a") }

fn mutate(item: SharedRangeItem) { item.name = "b" }
fn make() Array[SharedRangeItem] {
    return Array[SharedRangeItem]{ SharedRangeItem {}, SharedRangeItem {} }
}

fn main() {
    let items: shared Array[SharedRangeItem] = make()
    let part = items[0 .. 2]
    mutate(part.get(0) !!)
}

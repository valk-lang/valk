class Entry { count: uint (0) }
union Item : Entry | uint {}
class State { item: Item }
fn steal(state: atomic Lock[State]) ?locked Entry {
    lock state as s {
        match s.item {
            Entry as entry => return entry
            uint => return null
        }
    }
}
fn make() State { return State { item: Entry {} } }
fn main() {
    let state: atomic Lock[State] = .new(make()) !!
    steal(state)
}

error Base (base) payload {
    detail: String
}
error Extended (extended) extends (Base) payload {
    extra: String ("default-extra")
}
fn narrow() int !Base {
    throw .base { detail: "d" }
}
fn call_wide(f: fn()(int !Extended)) int {
    return f() ! { return E.extra.length }
}
fn main() {
    println(call_wide(narrow))
}

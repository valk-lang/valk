class CopiedReceiverEntry { count: uint (0) }
class CopiedReceiverBox {
    items: Array[CopiedReceiverEntry] (.{})
    fn copy() SELF {
        let new = SELF {}
        each this.items as item : new.items.append(item)
        return new
    }
}
fn main() {
    let entry = CopiedReceiverEntry {}
    let box = CopiedReceiverBox {}
    box.items.append(entry)
    let published: shared CopiedReceiverBox = box.copy()
    entry.count = 9
    published
}

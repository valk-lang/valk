class Entry { count: uint (0) }
class State {
    first: Entry
    second: Entry
}
fn identity(entry: Entry) Entry { return entry }
fn fresh() Entry { return Entry {} }
fn make(entry: Entry) State {
    return State { first: identity(entry), second: fresh() }
}
fn main() {
    let entry = Entry {}
    let alias = entry
    let published: shared State = make(entry)
    alias.count++
    print(published.first.count)
}

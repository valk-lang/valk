class Item { names: Array[String] (.{}); n: uint (1); child: ?Item (null) }
class Hub {
    items: Array[shared Item] (.{})
    fn keep(i: shared Item) { this.items.append(i) }
}
interface Registrar { fn add(i: Item); }
class ListRegistrar is Registrar {
    items: Array[Item] (.{})
    fn add(i: Item) { this.items.append(i) }
}
fn main() {
    let h = Hub {}
    let list = ListRegistrar {}
    let r: Registrar = list
    let item = Item {}
    // An interface method's summary settles at the end of the build
    r.add(item)
    h.keep(item)
    println(list.items.length)
}

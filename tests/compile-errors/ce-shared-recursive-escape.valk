class SharedRecursiveValue {}

global retained_recursive_value: ?SharedRecursiveValue (null)

fn retain_recursive(value: SharedRecursiveValue, depth: uint) {
    if depth == 0 {
        retained_recursive_value = value
        return
    }
    retain_recursive(value, depth - 1)
}

fn main() {
    let value = SharedRecursiveValue {}
    retain_recursive(value, 1)
    let published: shared SharedRecursiveValue = value
}

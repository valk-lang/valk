// MT-4 `clonethis`: a plain class whose `@threadsafe` clone returns this, inside a published object
class CloneThisConn {
    fd: int (0)
    fn clone() SELF @threadsafe {
        return this
    }
}

class CloneThisMsg {
    c: CloneThisConn
    n: int (0)
}

fn main() {
    let c = CloneThisConn { fd: 7 }
    let m = CloneThisMsg { c: c }
    let a: atomic CloneThisMsg = m
    println(a.n)
}

class SharedSliceBorrowItem { name: String ("a") }
class SharedSliceBorrowHolder { sl: &mut [SharedSliceBorrowItem] ([SharedSliceBorrowItem]{ SharedSliceBorrowItem {} }) }
fn main() {
    let h: shared SharedSliceBorrowHolder = SharedSliceBorrowHolder {}
    let sl = h.sl
    let r = &mut sl[0]
    r.name = "mut"
}

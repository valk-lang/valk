class Item { number: int }
class Steps {
    item: Item (.{ number: 73 })
    fn _next(index: uint) int !IterError {
        if index >= 2 : throw .end
        this.item.number++
        return this.item.number
    }
}
fn main() {
    let source = Steps {}
    each source as value {
        let published: shared Steps = source
        println(published.item.number)
    }
}

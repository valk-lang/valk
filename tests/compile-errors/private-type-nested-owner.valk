- class NestedSecret {
    n: int (0)
}

class NestedShared {
    n: int (0)
}

class NestedPlain {
    shared: NestedShared
}

class NestedInner {
    back: ?NestedOuter (null)
    shared: ?NestedShared (null)
    secret: ?NestedSecret (null)
}

class NestedOuter {
    shared: NestedShared
    inner: ?NestedInner (null)
}

+ fn nested_plain(p: NestedPlain) int {
    return p.shared.n
}

+ fn nested_outer(o: NestedOuter) int {
    return o.shared.n
}

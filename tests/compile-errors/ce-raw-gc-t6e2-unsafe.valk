// Grove C-31: inside @unsafe the access is rejected by provenance (probe t6e2)
class Node {
    v: uint
}
union U : String | Node | int {}
class Holder {
    u: U
}
fn describe(u: U) String {
    @unsafe
    return match u : String {
        String as s => "string"
        Node as n => "node"
        int as i => "int"
    }
}
fn main() {
    @unsafe
    let h = Holder { u: Node { v: 1 } }
    println(describe(h.u))
    let p = h.@cast(ptr)
    @ptrv(p, u8, 0) = 2
    println(describe(h.u))
}

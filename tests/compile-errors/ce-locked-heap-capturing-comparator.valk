class LockedHeapState {
    h: Heap[uint] (.{})
}
fn main() {
    let weights = Array[uint]{ 5, 1 }
    let state: shared Lock[LockedHeapState] = .new(LockedHeapState {}) !!
    lock state as t {
        t.h = Heap[uint].new(fn(a: uint, b: uint) bool { return (weights.get(a) !? 0) < (weights.get(b) !? 0) })
    }
}

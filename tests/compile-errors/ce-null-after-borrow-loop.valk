

class LoopBorrowedNode {
    v: int (1)
}

fn wipe_loop_borrowed(p: &?LoopBorrowedNode) {
    p[0] = null
}

fn cond() bool {
    return true
}

fn main() {
    let x: ?LoopBorrowedNode = LoopBorrowedNode {}
    if isset(x) {
        while cond() {
            println(x.v)
            wipe_loop_borrowed(&x)
        }
    }
}

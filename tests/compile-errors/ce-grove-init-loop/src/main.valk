fn tick(i: uint) uint $noinline {
    return i + 1
}

// The next iteration's `@init` follows this iteration's call
fn make(n: uint) &[uint] {
    @unsafe
    let s = @uninit([uint]{ 0 x n })
    let data = s.data
    let i: uint = 0
    while i < n {
        @init(@ptrv(data, uint, i), i)
        i = tick(i)
    }
    return s
}

fn main() {
    make(3)
}

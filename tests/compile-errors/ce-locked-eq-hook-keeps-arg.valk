class V {
    n: uint
    + fn same(o: V) bool $eq {
        kept.append(o)
        return this.n == o.n
    }
}
global kept: Array[V] (.{})
class T2 {
    v: V (V { n: 1 })
}
fn main() {
    let state: shared Lock[T2] = Lock[T2].new(T2 {}) !!
    let pv = V { n: 2 }
    lock state as t {
        println(pv == t.v)
    }
}

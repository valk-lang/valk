class StructEscapeItem { name: String ("a") }
struct StructEscapePair { item: StructEscapeItem fn stash() { struct_escape_global = this.item } }
class StructEscapeHolder { pair: StructEscapePair (StructEscapePair { item: StructEscapeItem {} }) }
global struct_escape_global : ?StructEscapeItem (null)
fn main() {
    let h: shared StructEscapeHolder = StructEscapeHolder {}
    h.pair.stash()
}

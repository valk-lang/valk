class LoopEscapeItem { number: int }
shared loop_escape_saved: ?LoopEscapeItem (null)
global loop_escape_stash: Array[LoopEscapeItem] (.{})
fn loop_escape_keep(item: LoopEscapeItem) { loop_escape_stash.append(item) }
fn main() {
    let item = LoopEscapeItem { number: 1 }
    let i = 0
    while i++ < 3 {
        loop_escape_saved = item
        item = LoopEscapeItem { number: 2 }
        loop_escape_keep(item)
    }
}

union LeafErr {
    bad
}

union LeftErr {
    leaf(LeafErr) $auto
}

union RightErr {
    leaf(LeafErr) $auto
}

union DiamondErr {
    left(LeftErr) $auto
    right(RightErr) $auto
}

fn make_leaf() !LeafErr {
    throw .bad
}

fn pass_diamond() !DiamondErr {
    make_leaf() !>
}

fn main() {
    pass_diamond() _
}

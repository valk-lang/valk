class SharedEscapingValue {}

global retained_shared_value: ?SharedEscapingValue (null)

fn retain_shared_value(value: SharedEscapingValue) {
    retained_shared_value = value
}

fn main() {
    let value = SharedEscapingValue {}
    retain_shared_value(value)
    let published: shared SharedEscapingValue = value
}

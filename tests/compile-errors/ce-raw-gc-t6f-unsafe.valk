// Grove C-31: inside @unsafe the access is rejected by provenance (probe t6f)
class Node {
    v: uint
}
class Holder {
    a: ?Node
}
fn main() {
    @unsafe
    let arr = Array[Node].new(4)
    arr.append(Node { v: 1 })
    let x = @ptrv(arr.items(), Node, 0)
    let h = Holder { a: null }
    h.a = x
    println(isset(h.a))
}

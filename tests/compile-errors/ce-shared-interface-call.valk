// An interface call is as safe as its least safe implementation: one of them
// keeps the receiver, so the graph passed through the interface may be aliased
interface SharedEffectInterface {
    fn inspect();
}

class SharedEffectValue is SharedEffectInterface {
    fn inspect() {}
}

global kept: ?SharedEffectKeeper (null)
class SharedEffectKeeper is SharedEffectInterface {
    fn inspect() { kept = this }
}

fn inspect_interface(value: SharedEffectInterface) {
    value.inspect()
}

fn main() {
    let value = SharedEffectValue {}
    inspect_interface(value)
    let published: shared SharedEffectValue = value
    let keeper = SharedEffectKeeper {}
    inspect_interface(keeper)
}

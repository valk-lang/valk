// The callee stores the borrow in another argument's object; that object may
// then not leave the frame
global saved: ?ByteReader (null)
fn keep(reader: ByteReader, data: &[u8]) {
    reader.source = data
}

fn main() {
    let bytes: [u8 x 4] = { 1, 2, 3, 4 }
    let reader = ByteReader.new("x")
    keep(reader, bytes)
    saved = reader
}

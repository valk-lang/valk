use valk:gc as gc

class Cell[T] {
    - data: ptr
    + static fn new() SELF {
        return SELF { data: gc:alloc(size_of(T)).to_ptr() }
    }
    + fn set(v: T) {
        @property_init(this, @ptrv(this.data, T, 0), v)
    }
}

fn main() {
    let x : uint = 5
    let c = Cell[&uint].new()
    c.set(&x)
}

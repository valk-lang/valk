class Item { names: Array[String] (.{}); n: uint (1); child: ?Item (null) }
class Box { item: ?Item (null) }
class Hub {
    items: Array[shared Item] (.{})
    fn keep(i: shared Item) { this.items.append(i) }
}

class Registry { items: Array[Item] (.{}) }
fn register(r: Registry, item: Item) { r.items.append(item) }
fn main() {
    let h = Hub {}
    let r = Registry {}
    let item = Item {}
    register(r, item)
    h.keep(item)
}

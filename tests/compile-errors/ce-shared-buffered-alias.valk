class Entry { count: uint (0) }
class State { entry: Entry }

fn identity(entry: Entry) Entry { return entry }
fn make(entry: Entry) State { return State { entry: identity(entry) } }

fn main() {
    let entry = Entry {}
    let alias = entry
    let published: shared State = make(entry)
    alias.count++
    print(published.entry.count)
}

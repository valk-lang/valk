// A coroutine keeps its arguments past the launch
fn wrap(data: &[u8]) ByteReader {
    return ByteReader.new(data)
}
fn drain(reader: ByteReader) u8 { return reader.read_byte() }

fn main() {
    let bytes: [u8 x 4] = { 1, 2, 3, 4 }
    let reader = wrap(bytes)
    let task = co drain(reader)
    await task
}

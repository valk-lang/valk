use valk.core
class LockEntry { id: uint (0) }
class LockValue { entry: ?LockEntry (null) }
fn main() {
    let first: shared Lock[LockValue] = .new(LockValue { entry: LockEntry {} }) !!
    let second: shared Lock[LockValue] = .new(LockValue {}) !!
    lock first as a {
        lock second as b {
            b.entry = a.entry
        }
    }
}

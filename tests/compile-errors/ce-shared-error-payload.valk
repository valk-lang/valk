class PayloadEscapeValue { name: String ("a") }
error PayloadEscapeCarry (with) payload { v: PayloadEscapeValue }
fn payload_escape_thrower(v: PayloadEscapeValue) !PayloadEscapeCarry { throw .with { v: v } }
fn main() {
    let v = PayloadEscapeValue {}
    let alias: ?PayloadEscapeValue = null
    payload_escape_thrower(v) ! { alias = E.v }
    let s: shared PayloadEscapeValue = v
    (alias ?? panic("x")).name = "mutated"
    s
}

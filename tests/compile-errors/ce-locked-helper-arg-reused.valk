// An argument a helper stores into locked data it was handed is published with it
class E { n: uint (0) }
class S { list: Array[E] (.{}) }
fn put(s: locked S, x: E) { s.list.append(x) }
fn main() {
    let a: shared Lock[S] = .new(S {}) !!
    let x = E{}
    lock a as s { put(s, x) }
    x.n = 42
}

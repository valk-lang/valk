class Item { number: int }
class Steps {
    item: Item (.{ number: 7 })
    fn _next(index: $I) Item !IterError {
        if index >= 1 : throw .end
        return this.item
    }
}
fn steal(state: shared Lock[Steps]) locked Item {
    lock state as source {
        return source._next(0.to(uint)) !!
    }
    panic("missing")
}
fn main() { let source: shared Lock[Steps] = .new(Steps {}) !!; let _ = steal(source) }

use valk.core

// MT-2 `ts`: a `@threadsafe` method of a `$atomic` class mutates a plain container under its own mutex
class TsLog $atomic {
    m: core.Mutex
    lines: Array[String]

    + fn add(line: String) @threadsafe {
        this.m.lock()
        this.lines.append(line)
        this.m.unlock()
    }
}

fn main() {
    let log = TsLog { m: core.Mutex.new() !!, lines: Array[String].new() }
    log.add("x")
}

class Item { names: Array[String] (.{}); n: uint (1); child: ?Item (null) }
class Box { item: ?Item (null) }
class Hub {
    items: Array[shared Item] (.{})
    fn keep(i: shared Item) { this.items.append(i) }
}

interface Sink { fn put(i: shared Item); }
class ListSink is Sink {
    items: Array[shared Item] (.{})
    fn put(i: shared Item) { this.items.append(i) }
}
fn main() {
    let ls = ListSink {}
    let s: Sink = ls
    let item = Item {}
    s.put(item)
    item.n = 2
}

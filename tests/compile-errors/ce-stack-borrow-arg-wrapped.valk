// The callee returns an object holding the borrow; a closure keeping that
// object outlives the frame
fn wrap(data: &[u8]) ByteReader {
    return ByteReader.new(data)
}

fn main() {
    let bytes: [u8 x 4] = { 1, 2, 3, 4 }
    let reader = wrap(bytes)
    let later = fn() u8 { return reader.read_byte() }
    later()
}

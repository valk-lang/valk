class LockedSliceItem { name: String ("a") }
class LockedSliceState { sl: mut &[LockedSliceItem] ([LockedSliceItem]{ LockedSliceItem {} }) }
fn main() {
    let st: shared Lock[LockedSliceState] = .new(LockedSliceState {}) !!
    let out: ?LockedSliceItem = null
    lock st as s { out = s.sl[0] }
    if isset(out) : out.name = "leak"
}

use valk.sync

class Message {
    id: uint
}

fn main() {
    let ch: shared sync.Channel[shared Message] = sync.Channel[shared Message].new() !!
    let message = Message { id: 1 }
    // A unique local handed to a channel that keeps it is published, so it
    // cannot be used after the call
    ch.send(message) !!
    println(message.id)
}

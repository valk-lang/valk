use valk.sync

class Message {
    id: uint
}

fn main() {
    let ch: shared sync.Channel[shared Message] = sync.Channel[shared Message].new() !!
    let message = Message { id: 1 }
    // A named value may still be used after the call, so it cannot be
    // handed to a channel that keeps it; only a literal or a value that was
    // converted to `shared` first can
    ch.send(message) !!
    println(message.id)
}

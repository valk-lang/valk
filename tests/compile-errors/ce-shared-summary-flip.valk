class FlipNode { v: int (0) }

global flip_kept: ?FlipNode (null)
global flip_published: ?shared FlipNode (null)

// `b` is summarized while `f` is still being analyzed, so its escape flag is
// provisional; `c` is analyzed in that window and must not trust it.
fn flip_f(n: FlipNode, depth: int) {
    let r = flip_b(FlipNode {}, 1)
    let sr: shared FlipNode = r
    let w = flip_c()
    let sw: shared FlipNode = w
    if depth > 0 : flip_b(n, depth - 1)
    flip_kept = n
}

fn flip_c() FlipNode {
    let y = FlipNode {}
    flip_b(y, 1)
    let s: shared FlipNode = y
    flip_published = s
    return FlipNode {}
}

fn flip_b(n: FlipNode, depth: int) FlipNode {
    if depth > 0 : flip_f(n, depth - 1)
    return FlipNode {}
}

fn main() {
    flip_f(FlipNode {}, 0)
}

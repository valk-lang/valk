class Item { number: int }
class Steps {
    item: Item (.{ number: 7 })
    fn _next(index: uint) Item !IterError {
        if index >= 1 : throw .end
        return this.item
    }
}
fn main() {
    // Resolve the method summary before checking a separate source.
    let warmup = Steps {}
    let first = warmup._next(0.to(uint)) !!
    println(first.number)
    let source = Steps {}
    let retained: ?Item = null
    each source as item : retained = item
    let published: shared Steps = source
    if isset(retained) : retained.number = 73
    println(published.item.number)
}

struct StoredBorrowPayload {
    value: int
}

class StoredBorrowOwner {
    payload: StoredBorrowPayload
}

class StoredBorrowKeeper {
    view: ?&StoredBorrowPayload (null)
}

fn main() {
    let owner = StoredBorrowOwner { payload: StoredBorrowPayload { value: 1 } }
    let keeper = StoredBorrowKeeper {}
    keeper.view = &owner.payload
    let published: shared StoredBorrowOwner = owner
}

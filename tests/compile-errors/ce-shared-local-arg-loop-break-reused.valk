class Item { names: Array[String] (.{}); n: uint (1); child: ?Item (null) }
class Box { item: ?Item (null) }
class Hub {
    items: Array[shared Item] (.{})
    fn keep(i: shared Item) { this.items.append(i) }
}

fn main() {
    let h = Hub {}
    let item = Item {}
    let i: uint = 0
    while i < 4 {
        if i == 2 {
            h.keep(item)
            break
        }
        i++
    }
    item.n = 2
}

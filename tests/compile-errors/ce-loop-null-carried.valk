// `y = x` carries x's proven-non-null fact to y. The fact was established before
// the loop and the body then invalidates x, so on the second iteration the
// assignment would copy a possibly-null x. Carrying a fact by assignment must be
// held to the same loop rule as reading it directly.

fn maybe() ?String {
    return null
}

fn main() {
    let x = maybe()
    if !isset(x) : return
    let y : ?String = null
    let i = 0
    while i < 3 {
        y = x
        x = maybe()
        println(y.bytes)
        i++
    }
}

class CloneHookAliasEntry {
    count: uint (0)
    fn clone() SELF $clone { return this }
}
class CloneHookAliasState { entries: Array[CloneHookAliasEntry] (.{}) }
fn main() {
    let entry = CloneHookAliasEntry {}
    let state = CloneHookAliasState {}
    state.entries.append(entry)
    let published: shared CloneHookAliasState = $clone(state)
    entry.count = 9
    published
}

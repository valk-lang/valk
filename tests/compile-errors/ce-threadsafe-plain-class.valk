use valk.core

// MT-3 `ts_plain`: the same on a plain class published as atomic data
class TsRegistry {
    m: core.Mutex
    lines: Array[String]

    + fn add(line: String) @threadsafe {
        this.m.lock()
        this.lines.append(line)
        this.m.unlock()
    }
}

fn main() {
    let reg: atomic TsRegistry = TsRegistry { m: core.Mutex.new() !!, lines: Array[String].new() }
    reg.add("x")
}

class SharedAutoItem { name: String ("a") }
class SharedAutoWrap {
    item: SharedAutoItem
    fn to_item() SharedAutoItem $auto { return this.item }
}

fn mutate(item: SharedAutoItem) { item.name = "b" }
fn make() SharedAutoWrap { return SharedAutoWrap { item: SharedAutoItem {} } }

fn main() {
    let wrap: shared SharedAutoWrap = make()
    let item: SharedAutoItem = wrap
    mutate(item)
}

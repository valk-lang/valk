// A target picked from two locks may be either one
class E { n: uint (0) }
class S { e: E (.{}) }
fn main() {
    let a: shared Lock[S] = .new(S {}) !!
    let b: shared Lock[S] = .new(S {}) !!
    let k = true
    lock a as x {
        lock b as y {
            let t = k ? y : x
            t.e = x.e
        }
    }
}

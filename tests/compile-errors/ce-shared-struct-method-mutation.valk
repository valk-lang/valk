class StructMutItem { name: String ("a") }
struct StructMutPair { item: StructMutItem fn rename() { this.item.name = "x" } }
class StructMutHolder { pair: StructMutPair (StructMutPair { item: StructMutItem {} }) }
fn main() {
    let h: shared StructMutHolder = StructMutHolder {}
    h.pair.rename()
}

global retained_conversion_item: ?Item (null)

class Item {
    number: uint (23)

    fn text() String $auto {
        retained_conversion_item = this
        return "item"
    }
}

fn main() {
    let item = Item {}
    let text: String = item
    let shared_item: shared Item = item
    print(text)
    print(shared_item.number)
}


error Narrow (bad) payload {
    message: String
}
error Wide (bad) extends (Narrow) payload {
    detail: String
}

fn fail() !Narrow {
    throw .bad { message: "x" }
}

fn pass_it() !Wide {
    // detail is required on Wide and is not on Narrow — pure pass is not allowed
    fail() !>
}

fn main() {
    pass_it() _
}

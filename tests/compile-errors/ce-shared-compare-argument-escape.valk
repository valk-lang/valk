global retained_compare_arg: ?Item (null)

class Item { number: uint (23) }
class Comparator {
    fn equal(other: Item) bool $eq {
        retained_compare_arg = other
        return true
    }
}

fn main() {
    let item = Item {}
    let equal = Comparator {} == item
    let published: shared Item = item
    print(equal)
    print(published.number)
}

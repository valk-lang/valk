class LockedKeepBox { n: uint (0) }
global locked_keep_kept: ?fn(uint)(bool) (null)

class LockedKeepState {
    box: LockedKeepBox (LockedKeepBox {})
    fn run(func: fn(uint)(bool)) {
        locked_keep_a(func, 1)
    }
}

fn locked_keep_a(func: fn(uint)(bool), depth: int) {
    if depth > 0 : locked_keep_b(func, depth - 1)
}

fn locked_keep_b(func: fn(uint)(bool), depth: int) {
    locked_keep_a(func, depth)
    locked_keep_kept = func
}

fn main() {
    let state: shared Lock[LockedKeepState] = .new(LockedKeepState {}) !!
    let seen = Array[uint]{}
    lock state as s {
        s.run(fn(v: uint) bool { return seen.contains(v) })
    }
}

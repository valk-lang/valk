class LockedKeepState {
    kept: Array[fn(uint)(bool)] (.{})
    fn run(func: fn(uint)(bool)) {
        locked_keep_a(this, func, 1)
    }
}

fn locked_keep_a(state: locked LockedKeepState, func: fn(uint)(bool), depth: int) {
    if depth > 0 : locked_keep_b(state, func, depth - 1)
}

fn locked_keep_b(state: locked LockedKeepState, func: fn(uint)(bool), depth: int) {
    locked_keep_a(state, func, depth)
    state.kept.append(func)
}

fn main() {
    let state: shared Lock[LockedKeepState] = .new(LockedKeepState {}) !!
    let seen = Array[uint]{}
    lock state as s {
        s.run(fn(v: uint) bool { return seen.contains(v) })
    }
}

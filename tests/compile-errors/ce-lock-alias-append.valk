use valk.core
class LockEntry { id: uint (0) }
class LockValue { entries: Array[LockEntry] (.{}) }
fn main() {
    let state: shared Lock[LockValue] = .new(LockValue {}) !!
    let entry = LockEntry {}
    let alias = entry
    lock state as s {
        s.entries.append(entry)
    }
    alias.id = 2
}

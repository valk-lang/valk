class RelinkNode { next: ?RelinkNode (null) }
class RelinkBag {
    head: ?RelinkNode (null)
    // Stores the bag's own data into a node the caller keeps
    fn link(node: RelinkNode) { node.next = this.head }
}

fn main() {
    let bag = RelinkBag { head: RelinkNode {} }
    let node = RelinkNode {}
    bag.link(node)
    let published: shared RelinkBag = bag
    node
}

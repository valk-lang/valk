class LockedAbsorbItem { name: String ("a") }
struct LockedAbsorbPair { item: LockedAbsorbItem fn set(e: LockedAbsorbItem) { this.item = e } }
class LockedAbsorbState { pair: LockedAbsorbPair (LockedAbsorbPair { item: LockedAbsorbItem {} }) }
fn main() {
    let st: shared Lock[LockedAbsorbState] = .new(LockedAbsorbState {}) !!
    let local = LockedAbsorbItem {}
    let alias = local
    lock st as s { s.pair.set(local) }
    alias.name = "leak"
}

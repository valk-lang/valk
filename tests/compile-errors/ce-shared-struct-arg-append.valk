class Item { names: Array[String] (.{}); n: uint (1); child: ?Item (null) }
struct Pair { item: Item }
struct Outer { pair: Pair; tag: uint }
class PairHub {
    last: ?shared Pair (null)
    pairs: Array[shared Pair] (.{})
    outers: Array[shared Outer] (.{})
    fixed: ?shared [Pair x 2] (null)
    fn keep(p: shared Pair) { this.pairs.append(p) }
    fn set_last(p: shared Pair) { this.last = p }
    fn keep_outer(o: shared Outer) { this.outers.append(o) }
}
fn keep_last(h: PairHub, p: shared Pair) { h.last = p }
fn keep_append(h: PairHub, p: shared Pair) { h.pairs.append(p) }
fn main() {
    let h = PairHub {}
    let p = Pair { item: Item {} }
    keep_append(h, p)
    p.item.n = 2
}

class Child { number: int }
class Item { numbers: [Child x 2] ({ Child { number: 73 }, Child { number: 79 } }) }
shared retained: ?Item (null)
fn publish(item: shared Item) int { retained = item; return 0 }
fn main() {
    let source = Item {}
    let number = source.numbers[publish(source)]
    println(number.number)
}

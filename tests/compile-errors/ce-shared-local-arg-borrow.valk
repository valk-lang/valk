class Item { names: Array[String] (.{}); n: uint (1); child: ?Item (null) }
class Box { item: ?Item (null) }
class Hub {
    items: Array[atomic Item] (.{})
    fn keep(i: atomic Item) { this.items.append(i) }
}

fn main() {
    let h = Hub {}
    let item = Item {}
    let r = &item
    h.keep(r)
}

class SharedMethodAliasValue {}

class SharedMethodAliasBox {
    value: SharedMethodAliasValue

    fn attach_external() {
        this.value = shared_method_external
    }
}

global shared_method_external: SharedMethodAliasValue (SharedMethodAliasValue {})

fn main() {
    let box = SharedMethodAliasBox { value: SharedMethodAliasValue {} }
    box.attach_external()
    let published: shared SharedMethodAliasBox = box
}

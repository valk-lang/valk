global retained_compare: ?Item (null)

class Item {
    number: uint (23)
    fn equal(other: int) bool $eq {
        retained_compare = this
        return this.number == other
    }
}

fn main() {
    let item = Item {}
    let equal = item == 23
    let published: shared Item = item
    print(equal)
    print(published.number)
}

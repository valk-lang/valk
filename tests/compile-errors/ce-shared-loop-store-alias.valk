class LoopStoreAliasItem { number: int }
class LoopStoreAliasHolder { item: ?LoopStoreAliasItem (null) }
shared loop_store_alias_saved: ?LoopStoreAliasItem (null)
fn main() {
    let holder = LoopStoreAliasHolder {}
    let item = LoopStoreAliasItem { number: 1 }
    let i = 0
    while i++ < 3 {
        loop_store_alias_saved = item
        let held = holder.item
        if isset(held) : held.number = 99
        item = LoopStoreAliasItem { number: 2 }
        holder.item = item
    }
}

class SharedFixedItem { name: String ("a") }
class SharedFixedHolder { items: [SharedFixedItem x 2] }

fn mutate(item: SharedFixedItem) { item.name = "b" }
fn make() SharedFixedHolder {
    return SharedFixedHolder { items: { SharedFixedItem {}, SharedFixedItem {} } }
}

fn main() {
    let holder: shared SharedFixedHolder = make()
    mutate(holder.items[0])
}

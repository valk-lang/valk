class Entry {
    count: uint (0)
    fn clone() SELF { return this }
}
class State { entry: ?Entry (null) }
fn copy(state: atomic Lock[State]) ?Entry {
    lock state as s { return clone s.entry }
}
fn main() {
    let state: atomic Lock[State] = .new(State { entry: Entry {} }) !!
    copy(state)
}

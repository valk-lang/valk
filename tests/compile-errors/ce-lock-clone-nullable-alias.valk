class Entry {
    count: uint (0)
    fn clone() SELF $clone { return this }
}
class State { entry: ?Entry (null) }
fn copy(state: shared Lock[State]) ?Entry {
    lock state as s { return $clone(s.entry) }
}
fn main() {
    let state: shared Lock[State] = .new(State { entry: Entry {} }) !!
    copy(state)
}

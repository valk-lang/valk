use valk.sync
class Item { names: Array[String] (.{}); n: uint (1); child: ?Item (null) }
class Box { item: ?Item (null) }
class Hub {
    items: Array[shared Item] (.{})
    fn keep(i: shared Item) { this.items.append(i) }
}

shared INBOX: sync.Channel[shared Item] (sync.Channel[shared Item].new() !!)
fn publish(item: shared Item) { INBOX.try_send(item) _ }
fn main() {
    let item = Item {}
    item.names.append("a")
    publish(item)
    item.names.append("b")
}

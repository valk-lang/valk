class SharedFactoryAliasValue {}

class SharedFactoryAliasBox {
    value: SharedFactoryAliasValue

    static fn new(value: SharedFactoryAliasValue) SELF {
        return SELF { value: value }
    }
}

fn main() {
    let value = SharedFactoryAliasValue {}
    let box = SharedFactoryAliasBox.new(value)
    let published: shared SharedFactoryAliasBox = box
}

class Child { number: int }
class Item { child: Child (.{ number: 7 }) }
class Steps {
    item: Item (.{})
    fn _next(index: $I) Item !IterError {
        if index >= 1 : throw .end
        return this.item
    }
}
fn main() {
    let source: shared Steps = .{}
    let item = source._next(0.to(uint)) !!
    item.child = Child { number: 73 }
}

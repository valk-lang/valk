class LockedSliceAliasItem { name: String ("a") }
class LockedSliceAliasState { sl: &mut [LockedSliceAliasItem] ([LockedSliceAliasItem]{ LockedSliceAliasItem {} }) }
fn main() {
    let st: shared Lock[LockedSliceAliasState] = .new(LockedSliceAliasState {}) !!
    let local = LockedSliceAliasItem {}
    let alias = local
    lock st as s { s.sl[0] = local }
    alias.name = "leak"
}

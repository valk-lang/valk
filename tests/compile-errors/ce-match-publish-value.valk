class Item { number: int }
shared retained: ?Item (null)
fn publish(item: shared Item) int {
    retained = item
    return 1
}
fn main() {
    let source = Item { number: 73 }
    let index = 0
    while index++ < 2 {
        source.number++
        let value = match 0 : int {
            publish(source) => 7
            default => 11
        }
        println(value)
    }
}

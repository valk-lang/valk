class LockedGlobalValue { name: String ("a") }
global locked_global_cache: LockedGlobalValue (.{})
class LockedGlobalBox { v: ?LockedGlobalValue (null); fn g() LockedGlobalValue { return locked_global_cache } }
fn main() {
    let st: shared Lock[LockedGlobalBox] = .new(LockedGlobalBox {}) !!
    lock st as s { s.v = s.g() }
}

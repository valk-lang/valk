
fn maybenot() bool {
    return false
}

test "Null checking: ??" {
    let s : ?String = <{ return null }
    let s2 = <{ return s } ?? <{ return "1" }
    assert(s2 == "1")
    s = "2"
    s2 = <{
        if maybenot() : return null
        return "2"
    } ?? <{ return "1" }
    assert(s2 == "2")
}

// A value scope with no outer type expectation infers its result type from the
// returns, widening to `?T` when any branch returns null. The returns collected
// before the widening must be re-wrapped, so these also cover the case where the
// re-wrapped branch is the one that produces the value.
test "Null: vscope infers nullable result" {
    let taken = <{
        if !maybenot() : return "a"
        return null
    }
    assert(isset(taken) && taken == "a")

    let missed = <{
        if maybenot() : return "b"
        return null
    }
    assert(!isset(missed))
}

test "Null: vscope infers nullable inline result" {
    let taken = <{
        if !maybenot() : return 7
        return null
    }
    assert(isset(taken) && taken == 7)

    let missed = <{
        if maybenot() : return 9
        return null
    }
    assert(!isset(missed))
}

// `.{}` produces an object, so it narrows a nullable local even though the
// expectation at the assignment was `?T`.
class NCHolder {
    data: ?Map[String] (null)

    fn get_data() Map[String] {
        let d = this.data
        if !isset(d) {
            d = .{}
            this.data = d
        }
        return d
    }
}

test "Null: object literal narrows" {
    let h = NCHolder{}
    let d = h.get_data()
    d.set("k", "v")
    assert(h.get_data().length == 1)
}

// A fact established before a loop survives it when the body never assigns the
// declaration a possibly-null value, so `x` is still non-null after the loop.
test "Null: fact survives loop" {
    let x : ?String = "a"
    let seen = 0
    let items = Array[String]{ "p", "q" }
    each items as item {
        seen += item.bytes
    }
    let t : String = x
    assert(t == "a")
    assert(seen == 2)
}

test "Null: while-loop" {
    let x : ?String = "x"
    let z = ""
    while isset(x) {
        let i = 0
        while i++ < 2 {
            z += x
        }
        x = null
    }
    assert(z == "xx")
}

test "Null: each-loop" {
    let list = Array[String]{ "a", "b", "c" }
    let x : ?String = "x"
    let z = ""
    each list as item, i {
        if isset(x) && i < 2 : z += x + item
        else : x = null
    }
    assert(z == "xaxb")
}

test "Null: dont merge not_null" {
    let x : ?String = "x"
    if true {
        x = null
        return
    }
    x + x
}

test "Null: isset && ..." {
    let x : ?String = null
    let y : ?String = null
    if isset(x) && isset(y) && x.bytes > 0 && y.bytes > 0 {
        println(x.bytes)
        println(y.bytes)
    }

    let z = isset(x) ? x.bytes : "a".bytes
    assert(z == 1)
}

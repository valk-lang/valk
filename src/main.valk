
use build
use doc
use valk.gc
use lsp
use helper

@ignore_access

fn main(args: Array[String]) i32 {

    if args.contains("--leak-check") {
        args.remove_value("--leak-check")
        gc.verify = true
    }

    args.remove(0)
    let action = args.get(0) ! { help(1) }
    args.remove(0)

    if action == "build" {
        build.check_not_a_make_command(args)
        build.Build.from_args(args)
    } else if action == "run" {
        // `valk run` is `valk build --run`; a declared target is `valk make`
        return build.run_paths(args)
    } else if action == "make" {
        let first = args.get(0) !? ""
        if first == "-h" || first == "--help" : make_help()
        return build.make_action(args)
    } else if action == "ls" {
        return build.list_action(args)
    } else if action == "doc" {
        let show_help = args.contains("-h") || args.contains("--help")
        if show_help : doc.help(0)
        args.append("--docs")
        build.Build.from_args(args)
    } else if action == "fmt" {
        if args.contains("-h") || args.contains("--help") : fmt_help()
        args.append("--fmt")
        build.Build.from_args(args)
    } else if action == "lsp" {
        lsp.run(args)
    } else if action == "linker-symlinks" {
        link_create_lld_symlinks(build.default_os())
    } else if action == "version" || action == "--version" {
        println("valk-" + VERSION)
    } else if action == "-h" || action == "--help" {
        help(0)
    } else {
        helper.eprintln("Unknown command '" + action + "'")
        help(1)
    }

    return 0
}

fn basic_error(msg: String) $exit {
    helper.eprintln("#Error: " + msg)
    exit(1)
}

fn help(code: i32) $exit {
    println("-------------------------")
    println(" Valk v" + VERSION)
    println("-------------------------")
    print("\n")

    println(" Build:        valk build ./src -o myapp");
    println(" Build + Run:  valk build ./src -o myapp --run");
    println(" Lint:         valk build ./src --lint");
    println(" Format:       valk fmt ./src");
    println(" Run:          valk run ./src");

    print("\n")
    println(" valk build -h         Compile Valk code");
    print("\n")
    println(" valk make {name}      Run a make command declared in valk.json");
    println(" valk ls               List the make commands of this project");
    print("\n")
    println(" valk doc {directory}  Generate docs for a project");
    println(" valk doc -h           Generate docs help");
    println(" valk lsp              Start the language server (for editors)");
    println(" valk version          Show compiler version");

    print("\n")

    exit(code)
}

fn fmt_help() $exit {
    println("Usage: valk fmt {directories / .valk-file(s)} [--check]")
    print("\n")
    println("Formats the given files in place and lists the ones that changed.")
    println("With --check nothing is written: the files that need formatting are")
    println("listed and the exit code is 1 when there are any, for CI.")
    println("A directory formats the .valk files directly inside it; for a package")
    println("directory, those of its source directory.")
    exit(0)
}

fn make_help() $exit {
    println("Usage: valk make {name} [arguments]")
    print("\n")
    println("Runs a make command declared in valk.json under \"make\"; without a name the")
    println("first one. Arguments after the name are passed on and win over the declared")
    println("ones. 'valk ls' lists the commands.")
    exit(0)
}


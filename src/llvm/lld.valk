#if LLD
use valk.mem

extern fn valk_lld(argc: i32, argv: ptr, out: *?cstring) i32;

// lld in this process: its exit code and what it printed. args[0] picks the driver.
+ fn lld_link(args: Array[String]) (i32, String) {
    @unsafe
    let argv = Array[?cstring]{}
    each args as arg : argv.append(arg.data_cstring)
    let out: ?cstring = null
    let code = valk_lld(argv.length.@cast(i32), argv.items().@cast(ptr), @ref(out))
    let printed = out ?! return (code, "")
    let text = printed.to_string()
    mem.free(printed.@cast(ptr))
    return (code, text)
}
#end

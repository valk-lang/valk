#if LLD
use valk.mem

extern fn valk_lld(argc: i32, argv: ptr, out: *?cstring) i32;

// lld in this process, on a response file: its exit code and what it printed
+ fn lld_link(argfile: String) (i32, String) {
    @unsafe
    let flavor = "ld.lld"
    let rsp = "@" + argfile
    let argv = Array[?cstring]{ flavor.data_cstring, rsp.data_cstring }
    let out: ?cstring = null
    let code = valk_lld(2, argv.items().@cast(ptr), @ref(out))
    let printed = out ?! return (code, "")
    let text = printed.to_string()
    mem.free(printed.@cast(ptr))
    return (code, text)
}
#end

alias LLVMBool for bool

value LLVMObjectFile (1)
value LLVMReturnStatusAction (2)

value LLVMCodeGenLevelNone (0)
value LLVMCodeGenLevelDefault (2)
value LLVMCodeGenLevelAggressive (3)

value LLVMRelocPIC (2)
value LLVMCodeModelDefault (0)

value LLVMExternalLinkage (0)
value LLVMAvailableExternallyLinkage (1)
value LLVMAppendingLinkage (7)
value LLVMInternalLinkage (8)
value LLVMPrivateLinkage (9)
value LLVMHiddenVisibility (1)
// Attribute index of the function itself; 0 is the return value, 1.. the parameters
value LLVMAttributeFunctionIndex (0xFFFFFFFF)

pointer LLVMModuleRef {}
pointer LLVMContextRef {}
pointer LLVMMemoryBufferRef {}
pointer LLVMTargetMachineRef {}
pointer LLVMTargetDataRef {}
pointer LLVMTargetRef {}
pointer LLVMErrorRef {}
pointer LLVMPassBuilderOptionsRef {}
pointer LLVMValueRef {}
pointer LLVMTypeRef {}
pointer LLVMAttributeRef {}

extern fn LLVMContextCreate() LLVMContextRef;
extern fn LLVMCreateMemoryBufferWithMemoryRangeCopy(data: ptr, length: uint, name: cstring) LLVMMemoryBufferRef;
extern fn LLVMParseIRInContext(context: LLVMContextRef, buffer: LLVMMemoryBufferRef, mod_ref: *?LLVMModuleRef, msg_ref: *?cstring) LLVMBool;
extern fn LLVMVerifyModule(mod: LLVMModuleRef, return_status_action: i32, error_msg_ref: *?cstring) LLVMBool;

extern fn LLVMGetTargetFromTriple(triple: cstring, target_ref: *?LLVMTargetRef, msg_ref: *?cstring) LLVMBool;
extern fn LLVMCreateTargetMachine(target: LLVMTargetRef, triple: cstring, cpu: cstring, features: cstring, code_gen_level: i32, reloc_mode: i32, code_model: i32) ?LLVMTargetMachineRef;
extern fn LLVMCreateTargetDataLayout(machine: LLVMTargetMachineRef) LLVMTargetDataRef;
extern fn LLVMGetHostCPUName() cstring;
extern fn LLVMInstallFatalErrorHandler(handler: ptr) void;
extern fn LLVMGetHostCPUFeatures() cstring;
extern fn LLVMCopyStringRepOfTargetData(target: LLVMTargetDataRef) cstring;

extern fn LLVMCreatePassBuilderOptions() LLVMPassBuilderOptionsRef;
extern fn LLVMRunPasses(mod: LLVMModuleRef, passes: cstring, machine: LLVMTargetMachineRef, options: LLVMPassBuilderOptionsRef) ?LLVMErrorRef;

extern fn LLVMSetTarget(mod: LLVMModuleRef, triple: cstring) void;
extern fn LLVMSetDataLayout(mod: LLVMModuleRef, layout: cstring) void;
extern fn LLVMTargetMachineEmitToFile(machine: LLVMTargetMachineRef, mod: LLVMModuleRef, path_out: cstring, output_type: i32, error_msg_ref: *?cstring) LLVMBool;

extern fn LLVMDisposeMessage(message: ?cstring) void;
extern fn LLVMDisposeModule(module: LLVMModuleRef) void;
extern fn LLVMContextDispose(context: LLVMContextRef) void;
extern fn LLVMDisposeTargetMachine(machine: LLVMTargetMachineRef) void;
extern fn LLVMDisposeTargetData(target_data: LLVMTargetDataRef) void;
extern fn LLVMDisposePassBuilderOptions(options: LLVMPassBuilderOptionsRef) void;
extern fn LLVMGetErrorMessage(error: LLVMErrorRef) cstring;
extern fn LLVMDisposeErrorMessage(message: cstring) void;

extern fn LLVMInitializeX86TargetInfo() void;
extern fn LLVMInitializeX86Target() void;
extern fn LLVMInitializeX86TargetMC() void;
extern fn LLVMInitializeX86AsmPrinter() void;
extern fn LLVMInitializeX86AsmParser() void;
extern fn LLVMInitializeAArch64TargetInfo() void;
extern fn LLVMInitializeAArch64Target() void;
extern fn LLVMInitializeAArch64TargetMC() void;
extern fn LLVMInitializeAArch64AsmPrinter() void;
extern fn LLVMInitializeAArch64AsmParser() void;

extern fn LLVMWriteBitcodeToMemoryBuffer(mod: LLVMModuleRef) LLVMMemoryBufferRef;
extern fn LLVMParseBitcodeInContext2(context: LLVMContextRef, buffer: LLVMMemoryBufferRef, mod_ref: *?LLVMModuleRef) LLVMBool;
extern fn LLVMGetBufferStart(buffer: LLVMMemoryBufferRef) ptr;
extern fn LLVMGetBufferSize(buffer: LLVMMemoryBufferRef) uint;
extern fn LLVMDisposeMemoryBuffer(buffer: LLVMMemoryBufferRef) void;
extern fn LLVMGetFirstFunction(mod: LLVMModuleRef) ?LLVMValueRef;
extern fn LLVMGetNextFunction(func: LLVMValueRef) ?LLVMValueRef;
extern fn LLVMGetFirstGlobal(mod: LLVMModuleRef) ?LLVMValueRef;
extern fn LLVMGetNextGlobal(global: LLVMValueRef) ?LLVMValueRef;
extern fn LLVMGetFirstGlobalAlias(mod: LLVMModuleRef) ?LLVMValueRef;
extern fn LLVMIsDeclaration(global: LLVMValueRef) LLVMBool;
extern fn LLVMCountBasicBlocks(func: LLVMValueRef) u32;
extern fn LLVMGetLinkage(global: LLVMValueRef) i32;
extern fn LLVMSetLinkage(global: LLVMValueRef, linkage: i32) void;
extern fn LLVMSetVisibility(global: LLVMValueRef, visibility: i32) void;
extern fn LLVMDeleteGlobal(global: LLVMValueRef) void;
extern fn LLVMGetVisibility(global: LLVMValueRef) i32;
extern fn LLVMGetValueName2(value: LLVMValueRef, length: *uint) ptr;
extern fn LLVMSetValueName2(value: LLVMValueRef, name: ptr, length: uint) void;
extern fn LLVMGlobalGetValueType(global: LLVMValueRef) LLVMTypeRef;
extern fn LLVMAddFunction(mod: LLVMModuleRef, name: cstring, type: LLVMTypeRef) LLVMValueRef;
extern fn LLVMDeleteFunction(func: LLVMValueRef) void;
extern fn LLVMReplaceAllUsesWith(old: LLVMValueRef, new: LLVMValueRef) void;
extern fn LLVMGetFunctionCallConv(func: LLVMValueRef) u32;
extern fn LLVMSetFunctionCallConv(func: LLVMValueRef, cc: u32) void;
extern fn LLVMCountParams(func: LLVMValueRef) u32;
extern fn LLVMGetAttributeCountAtIndex(func: LLVMValueRef, index: u32) u32;
extern fn LLVMGetAttributesAtIndex(func: LLVMValueRef, index: u32, attrs: ptr) void;
extern fn LLVMAddAttributeAtIndex(func: LLVMValueRef, index: u32, attr: LLVMAttributeRef) void;

use valk.json

// `valk doc [dir] <query>`: prints one namespace, declaration or class member. `core.` may
// be left out and a declaration name alone is found in any namespace. Exits 1 with
// suggestions when nothing matches.
fn doc_lookup(doc: json.Value, query: String) $exit {
    let namespaces = jmap(jget(doc, "namespaces"))
    let parts = query.split(".")
    let first = parts.get(0) !? ""

    let text: ?String = null
    if namespaces.has(first) {
        text = lookup_in_namespace(first, jget(doc, "namespaces").get(first), parts.range(1, parts.length - 1))
    } else {
        let core = namespaces.get("core") !? null
        if isset(core) : text = lookup_in_namespace("core", core, parts)
        if !isset(text) {
            let owners = Array[String]{}
            each namespaces as ns, ns_name {
                if isset(lookup_in_namespace(ns_name, ns, parts)) : owners.append(ns_name + "." + query)
            }
            if owners.length > 1 {
                println("'" + query + "' is declared in several namespaces: " + owners.join(", "))
                exit(1)
            }
            let owner = owners.get(0) !? null
            if isset(owner) {
                let ns_name = owner.range(0, owner.bytes - query.bytes - 1)
                text = lookup_in_namespace(ns_name, namespaces.get(ns_name) !? json.new_object(), parts)
            }
        }
    }

    if isset(text) {
        println(text.trim("\n"))
        exit(0)
    }
    println("No documentation found for '" + query + "'")
    let suggestions = lookup_suggestions(namespaces, parts.get(parts.length - 1) !? query)
    if suggestions.length > 0 : println("Did you mean: " + suggestions.join(", "))
    exit(1)
}

// The text for `rest` inside one namespace, or null when it names nothing there
fn lookup_in_namespace(ns_name: String, ns: json.Value, rest: Array[String]) ?String {
    if rest.length == 0 {
        let overview = md_namespace(ns_name, ns, false)
        return overview.is_empty() ? null : plain_text(overview)
    }
    let name = rest.get(0) ! return null
    let class = lookup_item(ns, "classes", name)
    if isset(class) {
        if rest.length == 1 : return plain_text(md_class(ns_name, name, class, false)) + lookup_description(class)
        if rest.length == 2 : return lookup_member(class, rest.get(1) ! return null)
        return null
    }
    if rest.length != 1 : return null
    let func = lookup_item(ns, "functions", name)
    if isset(func) : return md_signature(ns_name, name, func) + lookup_description(func)
    let error = lookup_item(ns, "errors", name)
    if isset(error) : return md_error(name, error) + lookup_description(error)
    let enu = lookup_item(ns, "enums", name)
    if isset(enu) : return md_enum(name, enu) + lookup_description(enu)
    let global = lookup_item(ns, "globals", name)
    if isset(global) {
        let token = jbool(jget(global, "shared")) ? "shared" : "global"
        return jstring(jget(global, "act")) + " " + token + " " + name + " : " + jstring(jget(global, "type")) + "\n" + lookup_description(global)
    }
    let alias = lookup_item(ns, "aliases", name)
    if isset(alias) {
        let kind = jstring(jget(alias, "kind"))
        let target = jstring(jget(alias, "for"))
        let line = kind == "type" ? "type " + name + " (" + target + ")" : (kind == "value" ? "value " + name + " (" + target + ")" : "alias " + name + " for " + target)
        return line + "\n" + lookup_description(alias)
    }
    return null
}

// A property, method, getter or setter of a class, or a method of its extensions
fn lookup_member(class: json.Value, name: String) ?String {
    let prop = lookup_item(class, "properties", name)
    if isset(prop) {
        return jstring(jget(prop, "act")) + " " + name + ": " + jstring(jget(prop, "type")) + "\n" + lookup_description(prop)
    }
    let text = ""
    let func = lookup_item(class, "functions", name)
    if isset(func) : text += md_signature("", name, func) + lookup_description(func)
    let setter = lookup_item(class, "functions", "set " + name)
    if isset(setter) {
        if text.bytes > 0 : text += "\n"
        text += md_signature("", "set " + name, setter) + lookup_description(setter)
    }
    if class.has("extensions") {
        each jmap(jget(class, "extensions")) as funcs, ext_name {
            let ext_func = lookup_item(funcs, "", name)
            if !isset(ext_func) : continue
            if text.bytes > 0 : text += "\n"
            text += "extend " + ext_name + ":\n" + md_signature("", name, ext_func) + lookup_description(ext_func)
        }
    }
    return text.bytes > 0 ? text : null
}

// `container[group][name]`, or `container[name]` without a group
fn lookup_item(container: json.Value, group: String, name: String) ?json.Value {
    let items = group.bytes > 0 ? jget(container, group) : container
    if !items.has(name) : return null
    return items.get(name)
}

fn lookup_description(item: json.Value) String {
    if !item.has("description") : return ""
    let doc = jstring(jget(item, "description"))
    if doc.is_empty() : return ""
    return "\n" + doc + "\n"
}

// Markdown for a terminal: without the code fences
fn plain_text(markdown: String) String {
    let out = Array[String]{}
    each markdown.split("\n") as line {
        if line == "```js" || line == "```" : continue
        out.append(line)
    }
    return out.join("\n")
}

// Up to 10 paths whose last part contains `name`, ignoring case
fn lookup_suggestions(namespaces: Map[json.Value], name: String) Array[String] {
    let wanted = name.lower()
    let found = Array[String]{}
    if wanted.bytes == 0 : return found
    let sorted = namespaces.copy()
    sorted.sort_keys()
    each sorted as ns, ns_name {
        each Array[String]{ "classes", "functions", "errors", "enums", "globals", "aliases" } as group {
            let items = jmap(jget(ns, group))
            items.sort_keys()
            each items as item, item_name {
                if item_name.lower().contains(wanted) : found.append(ns_name + "." + item_name)
                if group != "classes" : continue
                each Array[String]{ "properties", "functions" } as member_group {
                    let members = jmap(jget(item, member_group))
                    members.sort_keys()
                    each members as member, member_name {
                        if member_name.starts_with("set ") : continue
                        if member_name.lower().contains(wanted) : found.append(ns_name + "." + item_name + "." + member_name)
                    }
                }
                if found.length >= 10 : return found
            }
        }
    }
    return found
}


use valk.json
use build

fn jget(value: json.Value, key: String) json.Value {
    return value.get(key)
}

fn jmap(value: json.Value) Map[json.Value] {
    return value.object.values
}

fn jarray(value: json.Value) Array[json.Value] {
    return value.array.values
}

fn jstring(value: json.Value) String {
    return value.string_value() !? ""
}

fn jbool(value: json.Value) bool {
    return value.bool
}

fn convert_to_markdown(b: build.Build, doc: json.Value, full: bool) String {
    let str = "\n# Documentation\n\n"

    let namespaces = jmap(jget(doc, "namespaces")).sort_keys()

    str += "Namespaces: "
    let count = 0
    each namespaces as ns, ns_name, i {
        let classes = jmap(jget(ns, "classes"))
        let funcs = jmap(jget(ns, "functions"))
        let globals = jmap(jget(ns, "globals"))
        let aliases = jmap(jget(ns, "aliases"))
        if funcs.length == 0 && classes.length == 0 && globals.length == 0 && aliases.length == 0 : continue

        if count > 0 : str += " | "
        str += "[%ns_name](#%ns_name)"
        count++
    }

    str += "\n\n---\n\n"

    each namespaces as ns, ns_name {
        let classes = jmap(jget(ns, "classes")).sort_keys()
        let funcs = jmap(jget(ns, "functions")).sort_keys()
        let globals = jmap(jget(ns, "globals")).sort_keys()
        let aliases = jmap(jget(ns, "aliases")).sort_keys()
        if funcs.length == 0 && classes.length == 0 && globals.length == 0 && aliases.length == 0 : continue

        let ns_str = "# " + ns_name + "\n\n"

        // Aliases come first: they name the types the rest of the namespace uses
        if aliases.length > 0 {
            let sub = "## Aliases for '" + ns_name + "'\n\n```js\n"
            each aliases as a, name {
                let summary = md_summary(a)
                if !summary.is_empty() : sub += "// " + summary + "\n"
                let target = jstring(jget(a, "for"))
                if jstring(jget(a, "kind")) == "type" {
                    sub += "type " + name + " (" + target + ")\n"
                } else if jstring(jget(a, "kind")) == "value" {
                    let access = jstring(jget(a, "access"))
                    if access != "" : sub += access + " "
                    sub += "value " + name + " (" + target + ")\n"
                } else {
                    sub += "alias " + name + " for " + target + "\n"
                }
            }
            ns_str += sub + "```\n\n"
            each aliases as a, name {
                ns_str += md_docs(name, "###", a, full)
            }
        }
        if funcs.length > 0 {
            let funcs_str = "## Functions for '" + ns_name + "'\n\n```js\n"
            each funcs as func, name {
                let func_str = md_func(ns_name, name, func)
                funcs_str += func_str
            }
            funcs_str += "```\n\n"
            each funcs as func, name {
                funcs_str += md_docs(name, "###", func, full)
            }
            ns_str += funcs_str
        }
        if classes.length > 0 {
            let classes_str = ""
            each classes as class, name {
                let class_str = md_class(ns_name, name, class, full)
                classes_str += class_str
            }
            ns_str += "## Classes for '" + ns_name + "'\n\n" + classes_str
        }
        if globals.length > 0 {
            let sub = "## Globals for '" + ns_name + "'\n\n```js\n"
            each globals as g, name {
                let summary = md_summary(g)
                if !summary.is_empty() : sub += "// " + summary + "\n"
                let token = jbool(jget(g, "shared")) ? "shared" : "global"
                sub += jstring(jget(g, "act")) + " " + token + " " + name + " : " + jstring(jget(g, "type")) + "\n"
            }
            ns_str += sub + "```\n\n"
            each globals as g, name {
                ns_str += md_docs(name, "###", g, full)
            }
        }

        str += ns_str
    }

    return str.rtrim("\n") + "\n"
}

// One-line summary of a documented declaration: its first paragraph, unwrapped.
fn md_summary(item: json.Value) String {
    if !item.has("description") : return ""
    let doc = jstring(jget(item, "description"))
    if doc.is_empty() : return ""
    let first = doc.split("\n\n").get(0) !? ""
    return first.replace("\n", " ")
}

// Full markdown section for a documented declaration, only with `--full`.
fn md_docs(name: String, level: String, item: json.Value, full: bool) String {
    if !full : return ""
    if !item.has("description") : return ""
    let doc = jstring(jget(item, "description"))
    if doc.is_empty() : return ""
    return level + " " + name + "\n\n" + doc + "\n\n"
}

fn md_class(ns_name: String, name: String, class: json.Value, full: bool) String {
    // let str = "### " + ns_name + ":" + name + "\n\n"
    let mode_for = jstring(jget(class, "mode_for"))
    let n = name
    let gnames = jarray(jget(class, "generics"))
    if gnames.length > 0 {
        n += "["
        each gnames as gname, i {
            if i > 0 : n += ", "
            n += jstring(gname)
        }
        n += "]"
    }

    let str = ""
    str += "```js\n"
    let class_summary = md_summary(class)
    if !class_summary.is_empty() : str += "// " + class_summary + "\n"
    let declaration_kind = jstring(jget(class, "kind"))
    if declaration_kind.is_empty() : declaration_kind = mode_for.is_empty() ? "class" : "mode"
    str += jstring(jget(class, "act")) + " " + declaration_kind + " " + n
    if !mode_for.is_empty() : str += " for " + mode_for
    if declaration_kind == "slice" : str += " of " + jstring(jget(class, "slice_type"))
    let interfaces = jarray(jget(class, "interfaces"))
    if interfaces.length > 0 {
        str += " is "
        each interfaces as interface, i {
            if i > 0 : str += ", "
            str += jstring(interface)
        }
    }
    if declaration_kind == "union" {
        let alternatives = jarray(jget(class, "alternatives"))
        str += " : "
        each alternatives as alternative, i {
            if i > 0 : str += " | "
            str += jstring(alternative)
        }
    }
    str += " {\n"
    let props = jmap(jget(class, "properties")).sort_keys()
    each props as prop, prop_name {
        let summary = md_summary(prop)
        if !summary.is_empty() : str += "    // " + summary + "\n"
        str += "    " + jstring(jget(prop, "act")) + " " + prop_name + ": " + jstring(jget(prop, "type")) + "\n"
    }

    let funcs = jmap(jget(class, "functions")).sort_keys()
    if funcs.length > 0 {
        if props.length > 0 : str += "\n"
        each funcs as func, name {
            let func_str = md_func("", name, func, "    ")
            str += "    " + func_str
        }
    }

    str += "}\n```\n\n"

    let class_doc = md_docs(name, "###", class, full)
    each props as prop, prop_name {
        class_doc += md_docs(prop_name, "####", prop, full)
    }
    each funcs as func, func_name {
        class_doc += md_docs(func_name, "####", func, full)
    }
    str += class_doc

    if class.has("extensions") {
        let extensions = jmap(jget(class, "extensions")).sort_keys()
        each extensions as ext_funcs, ext_name {
            str += "```js\n" + jstring(jget(class, "act")) + " extend " + ext_name + " {\n"
            each jmap(ext_funcs).sort_keys() as func, func_name {
                str += "    " + md_func("", func_name, func, "    ")
            }
            str += "}\n```\n\n"
            each jmap(ext_funcs).sort_keys() as func, func_name {
                str += md_docs(ext_name + "." + func_name, "####", func, full)
            }
        }
    }
    return str
}

fn md_func(ns_name: String, name: String, func: json.Value, indent: String ("") ) String {
    let signature = md_signature(ns_name, name, func)
    let summary = md_summary(func)
    if summary.is_empty() : return signature
    return "// " + summary + "\n" + indent + signature
}

fn md_signature(ns_name: String, name: String, func: json.Value) String {
    let str = jstring(jget(func, "act"))
    if jbool(jget(func, "is_static")) : str += " static"

    if jbool(jget(func, "is_getter")) {
        str += " get " + name + ": " + jstring(jget(func, "return-type"))
        let etype = jget(func, "error_type")
        match etype {
            String as error_name => str += " !" + error_name
            default => {}
        }
        return str + "\n"
    }

    str += " fn "

    let n = name
    let gnames = jarray(jget(func, "generics"))
    if gnames.length > 0 {
        n += "["
        each gnames as gname, i {
            if i > 0 : n += ", "
            n += jstring(gname)
        }
        n += "]"
    }

    str += n + "("
    let args = jarray(jget(func, "arguments"))

    each args as arg, i {
        if i > 0 : str += ", "
        str += jstring(jget(arg, "name")) + ": " + jstring(jget(arg, "type"))
        if arg.has("default-value") {
            str += " (" + jstring(jget(arg, "default-value")) + ")"
        }
    }

    str += ") "
    str += jstring(jget(func, "return-type"))

    let etype = jget(func, "error_type")
    match etype {
        String as error_name => str += " !" + error_name
        default => {}
    }

    str += "\n"

    return str
}

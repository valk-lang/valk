
fn help(code: i32) $exit {

    print("\n")
    println("# The doc generator will generate documentation for all namespaces");
    println("# that are defined found in the {directory}/valk.json config");
    print("\n")

    println("# Basic usage:");
    println(" valk doc {directory}");
    print("\n")
    println("# Look up one namespace, declaration or member of the standard library");
    println(" valk doc http.Server.compress");
    println(" valk doc Array.sort");
    print("\n")
    println("# ... or of a package");
    println(" valk doc {directory} Client.request");
    print("\n")
    println("# Output markdown instead of json");
    println(" valk doc {directory} --markdown");
    print("\n")
    println("# Output to file");
    println(" valk doc {directory} -o {path}");
    print("\n")
    println("# Show the whole documentation block under each signature");
    println(" valk doc {directory} --full");
    print("\n")
    println("# Ignore private fields");
    println(" valk doc {directory} --no-private");
    print("\n")

    println("# You can also use any argument that's used for 'build'");
    println(" valk doc {directory} --def \"X=Y\" --static -vvv ...");
    print("\n")

    exit(code)
} 

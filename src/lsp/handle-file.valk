
use valk.fs

extend Lsp {
    fn bump_file_version(uri: String, content: String) {
        this.file_version++
        this.file_versions.set(uri, this.file_version)
        this.file_decl_sigs.set(uri, lsp_decl_signature(content))
    }

    fn handle_open() {
        let data = this.data
        let params = data.get("params")
        let doc = params.get("textDocument")
        let uri = doc.get("uri").string_value() !? ""
        let text = doc.get("text").string_value() !? ""
        if uri.is_empty() : return
        uri = lsp_path_from_uri(uri)
        this.document_symbols.remove(uri)
        let prev = this.file_content.get(uri) !? null
        if !isset(prev) || prev != text {
            this.file_content.set(uri, text)
            this.bump_file_version(uri, text)
            this.changed_files.set(uri, true)
        }
        this.pending_diagnostics = uri
    }
    fn handle_close() {
        let uri = this.request_file() ?! return
        this.document_symbols.remove(uri)
        this.file_content.remove(uri)
        this.file_versions.remove(uri)
        this.file_decl_sigs.remove(uri)
    }
    fn handle_change() {
        let uri = this.request_file() ?! return
        this.document_symbols.remove(uri)

        let prev = this.file_content.get(uri) !? null
        let content = prev ?? (fs.read(uri) !? "")

        each this.data.get("params").get("contentChanges") as change {
            let text = change.get("text").string_value() !? ""
            if !change.has("range") {
                content = text
                continue
            }

            let range = change.get("range")
            let start = range.get("start")
            let end = range.get("end")
            let from = lsp_offset_for(
                content,
                start.get("line").int.to(u32) + 1,
                start.get("character").int.to(u32) + 1
            ).to(uint)
            let until = lsp_offset_for(
                content,
                end.get("line").int.to(u32) + 1,
                end.get("character").int.to(u32) + 1
            ).to(uint)
            if until < from : until = from

            let result_size = from + text.bytes + content.bytes - until
            let result = ByteBuffer.new(result_size)
            result.append_text(content.range(0, from))
            result.append_text(text)
            result.append_text(content.range(until, content.bytes - until))
            content = result.to_string()
        }
        if !isset(prev) || prev != content {
            this.file_content.set(uri, content)
            this.bump_file_version(uri, content)
            // Recorded even in save mode: the next pass builds from this buffer
            this.changed_files.set(uri, true)
        }
        if this.diagnostics_on_change {
            this.pending_diagnostics = uri
        }
    }
    fn handle_save() {
        let uri = this.request_file() ?! return
        let params = this.data.get("params")
        if params.has("text") {
            let text = params.get("text").string_value() !? ""
            let prev = this.file_content.get(uri) !? null
            if !isset(prev) || prev != text {
                this.document_symbols.remove(uri)
                this.file_content.set(uri, text)
                this.bump_file_version(uri, text)
                this.changed_files.set(uri, true)
            }
        } else if !this.file_content.has(uri) {
            this.changed_files.set(uri, true)
        }
        this.pending_diagnostics = uri
    }
}

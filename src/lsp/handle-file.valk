
use valk.fs

extend Lsp {
    fn handle_open() {
        let data = this.data
        let params = data.get("params")
        let doc = params.get("textDocument")
        let uri = doc.get("uri").string_value() !? ""
        let text = doc.get("text").string_value() !? ""
        if uri.is_empty() : return
        uri = lsp_path_from_uri(uri)
        this.document_symbols.remove(uri)
        this.file_content.set(uri, text)
        this.pending_diagnostics = uri
    }
    fn handle_close() {
        let uri = this.request_file() ?! return
        this.document_symbols.remove(uri)
        this.file_content.remove(uri)
    }
    fn handle_change() {
        let uri = this.request_file() ?! return
        this.document_symbols.remove(uri)

        let content = this.file_content.get(uri) !? null
        if !isset(content) : content = fs.read(uri) !? ""

        let changes = this.data.get("params").get("contentChanges").array.values
        each changes as change {
            let text = change.get("text").string_value() !? ""
            if !change.has("range") {
                content = text
                continue
            }

            let range = change.get("range")
            let start = range.get("start")
            let end = range.get("end")
            let from = lsp_offset_for(
                content,
                start.get("line").int.to(uint) + 1,
                start.get("character").int.to(uint) + 1
            ).to(uint)
            let until = lsp_offset_for(
                content,
                end.get("line").int.to(uint) + 1,
                end.get("character").int.to(uint) + 1
            ).to(uint)
            if until < from : until = from

            let result_size = from + text.bytes + content.bytes - until
            let result = ByteBuffer.new(result_size)
            result.append_text(content.part(0, from))
            result.append_text(text)
            result.append_text(content.part(until, content.bytes - until))
            content = result.to_string()
        }
        this.file_content.set(uri, content)
        if this.diagnostics_on_change {
            this.pending_diagnostics = uri
        }
    }
    fn handle_save() {
        let uri = this.request_file() ?! return
        this.pending_diagnostics = uri
    }
}


use valk:fs

extend Lsp {
    fn handle_open() {
        let data = this.data
        let params = data.get("params")
        let doc = params.get("textDocument")
        let uri = doc.get("uri").string()
        let text = doc.get("text").string()
        if uri.is_empty() : return
        uri = lsp_path_from_uri(uri)
        this.document_symbols.remove(uri)
        this.file_content.set(uri, text)
        // Report what is already wrong the moment a file is opened, rather than
        // waiting for the first save. One build per file opened.
        this.pending_diagnostics = uri
    }
    fn handle_close() {
        let uri = this.request_file() ?! return
        this.document_symbols.remove(uri)
        this.file_content.remove(uri)
    }
    fn handle_change() {
        let uri = this.request_file() ?! return
        this.document_symbols.remove(uri)

        // Changes in one notification are ordered and every range refers to the
        // result of the preceding change. Start from the open editor buffer; the
        // disk fallback makes the server tolerant of clients that omit didOpen.
        let content = this.file_content.get(uri) !? null
        if !isset(content) : content = fs:read(uri) !? ""

        let changes = this.data.get("params").get("contentChanges").array().values
        each changes as change {
            let text = change.get("text").string()
            if !change.has("range") {
                content = text
                continue
            }

            let range = change.get("range")
            let start = range.get("start")
            let end = range.get("end")
            let from = lsp_offset_for(
                content,
                start.get("line").int().to(uint) + 1,
                start.get("character").int().to(uint) + 1
            ).to(uint)
            let until = lsp_offset_for(
                content,
                end.get("line").int().to(uint) + 1,
                end.get("character").int().to(uint) + 1
            ).to(uint)
            if until < from : until = from

            // Assemble the replacement sequentially so a small edit needs one
            // result allocation instead of a chain of temporary concatenations.
            let result_size = from + text.bytes + content.bytes - until
            let result = ByteBuffer.new(result_size)
            result.write_string(content.part(0, from))
            result.write_string(text)
            result.write_string(content.part(until, content.bytes - until))
            content = result.to_string()
        }
        this.file_content.set(uri, content)
        if this.diagnostics_on_change {
            // parse() flushes this only after every complete message already in
            // the input buffer has been handled, naturally coalescing bursts.
            this.pending_diagnostics = uri
        }
    }
    fn handle_save() {
        let uri = this.request_file() ?! return
        // Queued rather than built here, so a save arriving in the same batch as
        // the changes that preceded it does not build twice.
        this.pending_diagnostics = uri
    }
}

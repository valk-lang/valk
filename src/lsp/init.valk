
use valk:json

extend Lsp {
    fn init(params: json:Value) {
        this.configure_diagnostics(params.get_or("initializationOptions"))

        let resp = json:new_object()
        let caps = json:new_object()
        resp.set("capabilities", caps)

        let sync = json:new_object()
        caps.set("textDocumentSync", sync)

        sync.set("openClose", json:new_bool(true))
        // Incremental sync lets editors send only the range that changed. The
        // server still accepts a range-less change as a full-document replacement,
        // as required by the protocol and used by a few simpler clients.
        sync.set("change", json:new_int(2))
        sync.set("save", json:new_bool(true))

        caps.set("documentFormattingProvider", json:new_bool(true))
        caps.set("definitionProvider", json:new_bool(true))
        caps.set("hoverProvider", json:new_bool(true))
        caps.set("documentSymbolProvider", json:new_bool(true))

        // Completion
        let comp = json:new_object()
        caps.set("completionProvider", comp)
        // Completion - triggers
        let chars = json:new_array()
        comp.set("triggerCharacters", chars)
        chars.append(json:new_string("."))
        chars.append(json:new_string(":"))

        // Sig help
        let sighelp = json:new_object()
        caps.set("signatureHelpProvider", sighelp)
        chars = json:new_array()
        sighelp.set("triggerCharacters", chars)
        chars.append(json:new_string("("))
        chars.append(json:new_string(","))
        chars = json:new_array()
        sighelp.set("retriggerCharacters", chars)
        chars.append(json:new_string(" "))

        // Diagnostics
        // let dia = json:new_object()
        // caps.set("diagnosticProvider", dia)
        // dia.set("interFileDependencies", json:new_bool(true))
        // dia.set("workspaceDiagnostics", json:new_bool(false))

        this.success(resp)
    }

    // Accept either the compact initialization-options shape
    // `{ "diagnosticsMode": "change" }` or the settings shape editors use for
    // workspace configuration: `{ "valk": { "diagnosticsMode": "change" } }`.
    fn configure_diagnostics(settings: json:Value) {
        if settings.has("valk") : settings = settings.get_or("valk")
        let mode = settings.get_or("diagnosticsMode").string()
        if mode == "change" : this.diagnostics_on_change = true
        else if mode == "save" : this.diagnostics_on_change = false
    }

    fn handle_configuration() {
        let params = this.data.get_or("params")
        this.configure_diagnostics(params.get_or("settings"))
        // The protocol defines this as a notification. Be tolerant of a client
        // sending it as a request so it does not wait forever for a response.
        if this.is_request : this.send_empty_response()
    }
}

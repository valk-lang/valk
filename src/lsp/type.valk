
use build

// Which request the current build is serving. The compiler's hook sites test
// this on every expression they resolve, so it is an int compare rather than
// the method-string comparison the request arrived as.
value req_none (0)
value req_diagnostics (1)
value req_definition (2)
value req_completion (3)
value req_sig_help (4)

// CompletionItemKind from the LSP specification. The numbers are protocol
// constants and must not be renumbered.
value ck_text (1)
value ck_method (2)
value ck_function (3)
value ck_constructor (4)
value ck_field (5)
value ck_variable (6)
value ck_class (7)
value ck_interface (8)
value ck_module (9)
value ck_property (10)
value ck_unit (11)
value ck_value (12)
value ck_enum (13)
value ck_keyword (14)
value ck_snippet (15)
value ck_color (16)
value ck_file (17)
value ck_reference (18)
value ck_folder (19)
value ck_enum_member (20)
value ck_constant (21)
value ck_struct (22)
value ck_event (23)
value ck_operator (24)
value ck_type_parameter (25)

// One entry in a completion response.
class Completion {
    type: int
    label: String
    insert: ?String (null)
    detail: ?String (null)
}

// How an identifier should be presented in a completion list.
fn completion_kind_for_idf(idf: build:Idf) int {
    if idf.type == build:IDF.func : return ck_function
    if idf.type == build:IDF.class : return ck_class
    if idf.type == build:IDF.enum : return ck_enum
    if idf.type == build:IDF.error_type : return ck_enum
    if idf.type == build:IDF.trait : return ck_interface
    if idf.type == build:IDF.global : return ck_variable
    if idf.type == build:IDF.decl : return ck_variable
    if idf.type == build:IDF.property : return ck_field
    if idf.type == build:IDF.scope : return ck_module
    if idf.type == build:IDF.type : return ck_class
    // Compile-time constants (`value X (…)`, --def, OS/ARCH)
    if idf.type == build:IDF.value : return ck_constant
    if idf.type == build:IDF.value_expr : return ck_constant
    return ck_text
}

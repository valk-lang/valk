
use build
use valk:json

extend Lsp {
    fn definition() {
        let data = this.data
        let params = data.get_or("params")
        let doc = params.get_or("textDocument")
        let pos = params.get_or("position")
        let uri = doc.get_or("uri").string()
        if uri.is_empty() : return
        uri = uri.ltrim("file://")
        this.file = uri
        this.line = pos.get_or("line").int().to(uint) + 1
        this.col = pos.get_or("character").int().to(uint) + 1
        this.build()
    }

    // Reply with the span of a declaration. Called from the compiler once it has
    // resolved the identifier the cursor is on, so the target is whatever the
    // compiler itself decided the name refers to.
    fn send_definition(exp: build:Exp) {
        // A declaration written inside a `%{...}` interpolation has positions
        // relative to that expression; resolve to the containing file.
        let at = build:message_resolve(exp.src, exp.i)
        let path = at.src.path
        if !isset(path) : return
        let loc = build:message_line_col(at.src.content, at.i)

        let resp = json:new_object()
        let res = json:new_object()
        resp.set("id", this.id)
        resp.set("result", res)

        res.set("uri", "file://" + path)
        // A zero-width range at the declaration: editors place the caret there
        // rather than selecting the name.
        res.set("range", json_range(loc.line, loc.col, loc.line, loc.col))

        this.respond(resp)
    }
}

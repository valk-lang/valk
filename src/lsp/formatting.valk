
use build
use valk:json

extend Lsp {
    fn formatting() {
        let data = this.data
        let params = data.get_or("params")
        let doc = params.get_or("textDocument")
        let uri = doc.get_or("uri").string()
        if uri.is_empty() : return
        uri = lsp_path_from_uri(uri)
        this.file = uri
        // No cursor: formatting covers the whole document
        this.line = 0
        this.col = 0
        this.build()
    }

    fn send_formatting(b: build:Build) {
        // Errors are not a reason to refuse: the formatter works off the token
        // stream, so a file that does not resolve still formats correctly, and a
        // buffer mid-edit is exactly when format-on-save runs. Only text that
        // cannot be tokenized is left alone, because then even the token
        // boundaries are unknown.
        each b.format_sources as src {
            let path = src.path
            if !isset(path) : continue
            if path != this.file : continue
            let text = build:format_tokens(src) ! continue
            // Nothing to do when the file is already formatted: an empty edit
            // list stops the editor from marking the buffer dirty.
            if text == src.content {
                this.success(json:new_array())
                return
            }
            this.send_edits(src.content, text)
            return
        }
    }

    // One edit replacing the whole document. A real diff would produce tighter
    // edits, but the formatter rewrites the file as a whole anyway, so there is
    // no smaller unit of change to report.
    fn send_edits(original: String, formatted: String) {
        let edits = json:new_array()
        let edit = json:new_object()
        // End of the original text, so the range covers every existing byte
        let end = build:message_line_col(original, original.bytes.to(u32))
        edit.set("range", json_range(1, 1, end.line, end.col))
        edit.set("newText", json:new_string(formatted))
        edits.append(edit)
        this.success(edits)
    }
}

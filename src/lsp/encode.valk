
use valk:json

// JSON encoding for the wire protocol, in place of json:encode_to_string.
//
// The stdlib escaper (core:StringComposer.append_str_json_escaped) indexes a 128
// entry table with a raw byte, so every byte >= 0x80 read past the end of the
// table and emitted whatever followed it on the stack as an escape character.
// One em dash in a source file was enough to make a reply unparseable and have
// the client shut the server down.
//
// That is fixed in this repo's lib, but `./valk` is compiled by the installed
// 0.1.14 against *its* stdlib, which this repo cannot change. LSP payloads are
// almost entirely user file content, so the protocol gets an encoder we own
// rather than one that has to be correct in a compiler we are replacing.
fn encode(v: json:Value) String {
    let buf = ByteBuffer.new(1024)
    encode_value(v, buf)
    return buf.to_string()
}

// json:TYPE is private to the json package, so the kind is read through the
// public predicates rather than compared against it.
fn encode_value(v: json:Value, buf: ByteBuffer) {
    if v.is_object() {
        buf.write_byte('{')
        let values = v.object_values
        if isset(values) {
            let first = true
            each values as val, key {
                if !first : buf.write_byte(',')
                first = false
                encode_string(key, buf)
                buf.write_byte(':')
                encode_value(val, buf)
            }
        }
        buf.write_byte('}')
        return
    }
    if v.is_array() {
        buf.write_byte('[')
        let values = v.array_values
        if isset(values) {
            let first = true
            each values as val {
                if !first : buf.write_byte(',')
                first = false
                encode_value(val, buf)
            }
        }
        buf.write_byte(']')
        return
    }
    if v.is_string() {
        encode_string(v.string_value, buf)
        return
    }
    if v.is_int() {
        buf.write_int_ascii(v.int_value)
        return
    }
    if v.is_bool() {
        buf.write_string(v.bool_value ? "true" : "false")
        return
    }
    // Floats do not occur in the messages this server sends, and `none` has no
    // JSON form, so both land here with null.
    buf.write_string("null")
}

// Bytes >= 0x80 are passed through untouched: a JSON string is UTF-8 text, and
// the input is already UTF-8, so escaping them would only mangle it.
fn encode_string(str: String, buf: ByteBuffer) {
    buf.write_byte('"')
    let data = str.data
    let bytes = str.bytes
    let i : uint = 0
    while i < bytes {
        let ch = @ptrv(data, u8, i++)
        if ch == '"' || ch == '\\' {
            buf.write_byte('\\')
            buf.write_byte(ch)
            continue
        }
        if ch == '\n' { buf.write_string("\\n") continue }
        if ch == '\r' { buf.write_string("\\r") continue }
        if ch == '\t' { buf.write_string("\\t") continue }
        // JSON forbids raw control characters; the rest have no short escape.
        if ch < 32 {
            buf.write_string("\\u00")
            buf.write_byte(hex_digit(ch >> 4))
            buf.write_byte(hex_digit(ch & 15))
            continue
        }
        buf.write_byte(ch)
    }
    buf.write_byte('"')
}

fn hex_digit(v: u8) u8 {
    if v < 10 : return '0' + v
    return 'a' + (v - 10)
}

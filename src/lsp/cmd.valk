
use valk:io

#if OS == "win"
extern fn _get_osfhandle(fd: i32) int;
extern fn PeekNamedPipe(handle: uint, buffer: ?ptr, size: u32, read: ?*u32, available: ?*u32, left: ?*u32) i32;
extern fn Sleep(ms: u32) void;
#else
struct LspPollFd {
    fd: i32
    events: i16
    revents: i16
}
extern fn poll(fds: *LspPollFd, count: u32, timeout_ms: i32) i32;
#end

@ignore_access

fn help(code: i32) $exit {

    print("\n")
    println("# Start the LSP server");
    println("> valk lsp run");
    print("\n")

    exit(code)
} 

fn run(args: Array[String]) {
    let show_help = args.contains("-h") || args.contains("--help")
    if show_help : help(0)
    let action = args.pop_first() ! help(1)
    if action == "run" {
        start_server()
    } else {
        help(1)
    }
}

fn start_server() {
    let buf = ByteBuffer.new(65536)
    let l = Lsp{ buf: buf }

    io:set_mode(0, io:MODE.binary) ! panic("Failed to configure standard input")
    io:set_mode(1, io:MODE.binary) ! panic("Failed to configure standard output")

    l.log("LSP server is running")
    while true {

        let bytes = lsp_read(buf) ! {
            l.log("No more input. Stopping LSP server")
            exit(1)
        }
        if bytes == 0 {
            l.log("No more input (EOF). Stopping LSP server")
            exit(1)
        }
        l.parse(false)
        if isset(l.pending_diagnostics) {
            while lsp_input_ready(15) {
                let more = lsp_read(buf) ! break
                if more == 0 : break
                l.parse(false)
            }
            l.flush_pending()
        }
    }
}

fn lsp_read(buf: ByteBuffer) uint !io:IoError {
    buf.reserve_space(65536)
    let bytes = io:read_to_ptr_sync(0, buf.data.@offset(buf.length), 65536, buf.length) !>
    buf.skip(bytes)
    return bytes
}

fn lsp_input_ready(timeout_ms: u32) bool {
    #if OS == "win"
    let handle = _get_osfhandle(0).to(uint)
    let waited: u32 = 0
    while waited < timeout_ms {
        let available: u32 = 0
        if PeekNamedPipe(handle, null, 0, null, @ref(available), null) != 0 && available > 0 : return true
        Sleep(1)
        waited++
    }
    return false
    #else
    let fd = LspPollFd { fd: 0, events: 1, revents: 0 }
    let ready = poll(@ref(fd), 1, timeout_ms.to(i32))
    return ready > 0 && (fd.revents & 1) != 0
    #end
}

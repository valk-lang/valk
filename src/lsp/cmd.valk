
use valk.io
use valk.time

// Windows has no library wrapper for peeking at the editor's pipe; elsewhere the
// runtime waits on stdin itself
#if OS == "win"
extern fn _get_osfhandle(fd: i32) int;
extern fn PeekNamedPipe(handle: uint, buffer: ?*u8, size: u32, read: ?*u32, available: ?*u32, left: ?*u32) i32;
#end

@ignore_access

fn help(code: i32) $exit {

    print("\n")
    println("# Start the LSP server");
    println("> valk lsp run");
    print("\n")

    exit(code)
} 

fn run(args: Array[String]) {
    let show_help = args.contains("-h") || args.contains("--help")
    if show_help : help(0)
    let action = args.pop_first() ! help(1)
    if action == "run" {
        start_server()
    } else {
        help(1)
    }
}

fn start_server() {
    let buf = ByteBuffer.new(65536)
    let l = Lsp{ buf: buf }

    #if OS == "win"
    io.set_mode(0, io.Mode.binary) ! {
        l.log("Failed to configure standard input")
        exit(1)
    }
    io.set_mode(1, io.Mode.binary) ! {
        l.log("Failed to configure standard output")
        exit(1)
    }
    #end

    l.log("LSP server is running")
    while true {

        let bytes = lsp_read(buf) ! {
            l.log("No more input. Stopping LSP server")
            exit(1)
        }
        if bytes == 0 {
            l.log("No more input (EOF). Stopping LSP server")
            exit(1)
        }
        l.parse(false)
        if isset(l.pending_diagnostics) {
            while lsp_input_ready(15) {
                let more = lsp_read(buf) ! break
                if more == 0 : break
                l.parse(false)
            }
            l.flush_pending()
        }
    }
}

fn lsp_read(buf: ByteBuffer) uint !io.IoError {
    buf.reserve(65536)
    let bytes = io.read_sync(0, buf.view_spare(65536)) !>
    buf.skip(bytes)
    return bytes
}

fn lsp_input_ready(timeout_ms: u32) bool {
    #if OS == "win"
    let handle = _get_osfhandle(0).to(uint)
    let waited: u32 = 0
    while waited < timeout_ms {
        let available: u32 = 0
        if PeekNamedPipe(handle, null, 0, null, @ref(available), null) != 0 && available > 0 : return true
        time.sleep_ms(1)
        waited++
    }
    return false
    #else
    // The server runs in a coroutine, so the runtime's own wait serves
    return io.await_fd(0, true, false, timeout_ms.to(uint)).is_readable()
    #end
}

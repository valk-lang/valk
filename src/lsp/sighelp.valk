use valk:json


extend Lsp {
    fn sighelp() {
        let data = this.data
        let params = data.get("params")
        let doc = params.get("textDocument")
        let pos = params.get("position")
        let uri = doc.get("uri").string()
        if uri.is_empty() : return
        uri = lsp_path_from_uri(uri)
        this.file = uri
        this.line = pos.get("line").int().to(uint) + 1
        this.col = pos.get("character").int().to(uint) + 1
        this.build()
    }

    // `label` is the whole signature, `parts` its individual arguments in order,
    // and `active` the index of the one the cursor is in. Both label and parts
    // are built by the compiler from the Func it resolved (func_signature_label).
    fn send_sig_help(label: String, parts: Array[String], active: uint) {
        let res = json:new_object()
        let sigs = json:new_array()
        res.set("signatures", sigs)
        res.set("activeSignature", json:from(0))
        res.set("activeParameter", json:from(active))

        let sig = json:new_object()
        let params = json:new_array()
        sigs.append(sig)

        sig.set("label", json:from(label))
        sig.set("parameters", params)
        sig.set("activeParameter", json:from(active))

        each parts as part {
            let item = json:new_object()
            params.append(item)
            item.set("label", part)
        }

        this.success(res)
    }
}


use valk.json
use build
use helper
use valk.fs
use valk.gc

value lsp_msg_type_error (1)
value lsp_msg_type_warn (2)
value lsp_msg_type_info (3)

fn lsp_hex_nibble(ch: u8) int {
    if ch >= '0' && ch <= '9' : return (ch - '0').to(int)
    if ch >= 'a' && ch <= 'f' : return (ch - 'a' + 10).to(int)
    if ch >= 'A' && ch <= 'F' : return (ch - 'A' + 10).to(int)
    return -1
}

fn lsp_uri_decode(text: String) String {
    if !text.contains("%") : return text
    let out = ByteBuffer.new(text.bytes)
    let i: uint = 0
    while i < text.bytes {
        let ch = text.get(i)
        if ch == '%' && i + 2 < text.bytes {
            let hi = lsp_hex_nibble(text.get(i + 1))
            let lo = lsp_hex_nibble(text.get(i + 2))
            if hi >= 0 && lo >= 0 {
                out.write_byte(((hi << 4) | lo).to(u8))
                i += 3
                continue
            }
        }
        out.write_byte(ch)
        i++
    }
    return out.to_string()
}

fn lsp_path_from_uri(uri: String) String {
    if uri.starts_with("file://") {
        uri = uri.range(7, uri.length - 7)
    }
    uri = lsp_uri_decode(uri)
    #if OS == "win"
    if uri.length > 2 && uri.get(0) == '/' && uri.get(2) == ':' {
        uri = uri.range(1, uri.length - 1)
    }
    if uri.length >= 2 && uri.get(1) == ':' && uri.get(0) >= 'a' && uri.get(0) <= 'z' {
        let upper = ByteBuffer.new(uri.bytes)
        upper.write_byte(uri.get(0) - 32)
        upper.write(uri.range(1, uri.bytes - 1))
        uri = upper.to_string()
    }
    #end
    return fs.resolve(uri)
}

fn lsp_uri_from_path(path: String) String {
    #if OS == "win"
    path = path.replace("\\", "/")
    if !path.starts_with("/") : return "file:///" + path
    #end
    return "file://" + path
}

class LspLineCol {
    line: u32
    col: u32
}

fn lsp_utf8_width(ch: u8) uint {
    if ch < 0x80 : return 1
    if (ch & 0xE0) == 0xC0 : return 2
    if (ch & 0xF0) == 0xE0 : return 3
    if (ch & 0xF8) == 0xF0 : return 4
    return 1
}

fn lsp_utf16_width(ch: u8) u32 {
    return ((ch & 0xF8) == 0xF0) ? 2 : 1
}

// Convert a 1-based LSP line/column to the compiler's UTF-8 byte offset.
+ fn lsp_offset_for(content: String, line: u32, col: u32) u32 {
    let data = content.data
    let bytes = content.bytes
    let cur_line: u32 = 1
    let p: uint = 0
    while p < bytes && cur_line < line {
        if @ptrv(data, u8, p) == '\n' : cur_line++
        p++
    }

    let target = col > 0 ? col - 1 : 0
    let units: u32 = 0
    while p < bytes && units < target {
        let ch = @ptrv(data, u8, p)
        if ch == '\n' : break
        let width = lsp_utf8_width(ch)
        let utf16 = lsp_utf16_width(ch)
        if units + utf16 > target : break
        if p + width > bytes : p++
        else : p += width
        units += utf16
    }
    return p.to(u32)
}

fn lsp_line_col(content: String, offset: u32) LspLineCol {
    let data = content.data
    let bytes = content.bytes
    let limit = offset.to(uint)
    if limit > bytes : limit = bytes
    let line: u32 = 1
    let col: u32 = 1
    let p: uint = 0
    while p < limit {
        let ch = @ptrv(data, u8, p)
        if ch == '\n' {
            line++
            col = 1
            p++
            continue
        }
        let width = lsp_utf8_width(ch)
        if p + width > limit : break
        p += width
        col += lsp_utf16_width(ch)
    }
    return LspLineCol { line: line, col: col }
}

fn lsp_line_col_in(src: build.Source, offset: u32) LspLineCol {
    let content = src.content
    let data = content.data
    let bytes = content.bytes
    let limit = offset.to(uint)
    if limit > bytes : limit = bytes
    let idx = src.line_index(limit.to(u32))
    let starts = src.get_line_starts()
    let p = (starts.get(idx) !? 0).to(uint)
    let col: u32 = 1
    while p < limit {
        let ch = @ptrv(data, u8, p)
        if ch == '\n' : break
        let width = lsp_utf8_width(ch)
        if p + width > limit : break
        p += width
        col += lsp_utf16_width(ch)
    }
    return LspLineCol { line: idx.to(u32) + 1, col: col }
}

class Diagnostic {
    // Identifies the message across builds, to report it once when several groups see it
    key: String
    severity: int
    msg: String
    line: u32
    col: u32
    end_line: u32
    end_col: u32
    code: String ("")
    related: Array[DiagnosticSpan] (.{})
    fixes: Array[DiagnosticFix] (.{})
}

// A suggested edit, offered as a quickfix code action
class DiagnosticFix {
    title: String
    path: String
    line: u32
    col: u32
    end_line: u32
    end_col: u32
    replacement: String
    preferred: bool (true)
    extra_edits: Array[DiagnosticFix] (.{})
}

// A labeled span of a diagnostic (LSP relatedInformation)
class DiagnosticSpan {
    path: String
    msg: String
    line: u32
    col: u32
    end_line: u32
    end_col: u32
}

class Lsp {
    buf: ByteBuffer
    index: uint (0)
    stage: uint (0)
    headers: Map[String] (Map[String]{})
    headers_str: String ("")
    data: json.Value (json.new_null())
    id: json.Value (json.new_null())
    is_request: bool (false)
    request: int (req_none)
    // Files
    file_content: Map[String] (Map[String]{})
    file_version: uint (0)
    file_versions: Map[uint] (Map[uint]{})
    file_decl_sigs: Map[String] (Map[String]{})
    document_symbols: Map[json.Value] (Map[json.Value]{})
    // Paths that currently have diagnostics published, so they can be cleared
    has_errors: Array[String] (Array[String]{})
    diagnostics_on_change: bool (false)
    // Last build result per namespace dir (or loose file path), see build_diagnostics
    diagnostic_groups: Map[DiagnosticGroup] (Map[DiagnosticGroup]{})
    // Cached package lookup per directory: dir -> pkg_dir ("" if loose)
    pkg_dir_cache: Map[String] (Map[String]{})
    pkg_srcdir_cache: Map[String] (Map[String]{})
    // Cached workspace symbol index per package root (or loose file)
    workspace_symbols: Map[WorkspaceSymbolGroup] (Map[WorkspaceSymbolGroup]{})
    // Cached public stdlib symbols for auto-import quickfixes
    stdlib_symbols: ?Map[Array[AutoImportEntry]] (null)
    // Buffers edited since the last diagnostics pass
    changed_files: Map[bool] (Map[bool]{})
    did_build: bool (false)
    //
    file: String ("")
    line: uint (0)
    col: uint (0)
    pending_diagnostics: ?String (null)
    //
    shutdown: bool (false)
    responded: bool (false)
    // The workspace folder the editor opened, for workspace-wide requests
    root: String ("")

    fn reset_request() {
        this.data = json.new_null()
        this.id = json.new_null()
        this.is_request = false
        this.request = req_none
        this.responded = false
        //
        this.file = ""
        this.line = 0
        this.col = 0
    }

    fn reset() {
        this.headers.clear()
        this.index = 0
        this.stage = 0
        this.reset_request()
    }

    fn parse(flush: bool (true)) {
        this.parse_messages()
        if flush : this.flush_pending()
    }

    fn flush_pending() {
        let file = this.pending_diagnostics ?! return
        this.pending_diagnostics = null
        this.reset_request()
        this.request = req_diagnostics
        this.file = file
        this.build()
    }

    fn parse_messages() {
        while this.buf.length > 0 {
            if this.stage == 0 {
                this.parse_headers() ! {
                    if E is .more {
                        return
                    }
                    this.log("Invalid headers")
                    this.drop_invalid()
                    this.reset()
                    continue
                }
            }
            if this.stage == 1 {
                this.parse_content() ! {
                    if E is .more : return
                    this.reset()
                    continue
                }
            }

            this.handle()
            this.reset()
        }
    }

    fn parse_headers() !LspError {
        let buf = this.buf
        let pos = this.index

        while true {
            let index = buf.index_of('\r', pos) ! throw .more
            if index + 1 >= buf.length : throw .more
            if buf.get(index + 1) != '\n' : throw .invalid

            if index == pos {
                // End of headers
                pos += 2
                break
            }

            // Read header
            let index2 = buf.index_of(':', pos) ! throw .invalid
            if index2 > index : throw .invalid
            let key = buf.range(pos, index2 - pos).trim(" ").trim("\t")
            // Anything else is not a header line: input out of step with the messages
            if key.bytes == 0 : throw .invalid
            each key as ch {
                if !ch.is_alpha_numeric() && ch != '-' : throw .invalid
            }
            let value = buf.range(index2 + 1, index - index2 - 1).trim(" ").trim("\t")
            pos = index + 2
            this.index = pos

            this.headers.set(key.lower(), value)
        }

        this.stage = 1
        this.headers_str = this.buf.range(0, pos)
        this.buf.clear_until(pos)
        this.index = 0
    }

    // Drops the input up to the next `Content-Length` header after the bad one, so one bad
    // message does not stop the ones after it
    fn drop_invalid() {
        let buf = this.buf
        let at = this.index + 1
        while at < buf.length {
            let found = buf.index_of('C', at) ! break
            if buf.range(found, 15).equals("Content-Length:") {
                buf.clear_until(found)
                return
            }
            at = found + 1
        }
        buf.clear()
    }

    fn parse_content() !LspError {
        // Without a length the body cannot be found: skip to the next message
        let length_text = this.headers.get("content-length") !? ""
        let len = length_text.to_uint() ! {
            this.drop_invalid()
            throw .invalid
        }
        if this.buf.length < len : throw .more
        let content = this.buf.range(0, len)
        this.buf.clear_until(len)

        let data = json.decode(content) ! {
            this.log("Invalid JSON-RPC input: '%content' | length: %len/%{content.length} | Headers: " + this.headers_str)
            throw .invalid
        }

        this.data = data
    }

    fn handle() {
        let data = this.data

        let method = data.get("method").string_value() !? ""
        let params = data.get("params")

        this.id = data.get("id")
        this.is_request = data.has("id")
        this.request = request_for_method(method)

        if this.shutdown {
            if method == "exit" {
                exit(0)
            }
            return
        }

        if method == "initialize" {
            this.init(params)
        } else if method == "initialized" {
        } else if method == "shutdown" {
            this.shutdown = true
            this.send_empty_response()
        } else if method == "exit" {
            exit(0)
        } else if method == "textDocument/didOpen" {
            this.handle_open()
        } else if method == "textDocument/didClose" {
            this.handle_close()
        } else if method == "textDocument/didChange" {
            this.handle_change()
        } else if method == "textDocument/didSave" {
            this.handle_save()
        } else if method == "workspace/didChangeConfiguration" {
            this.handle_configuration()
        } else if method == "textDocument/definition" {
            this.definition()
            this.send_empty_response()
        } else if method == "textDocument/completion" {
            this.completion()
            this.send_empty_response()
        } else if method == "textDocument/signatureHelp" {
            this.sighelp()
            this.send_empty_response()
        } else if method == "textDocument/hover" {
            this.hover()
            this.send_empty_response()
        } else if method == "textDocument/formatting" {
            this.formatting()
            this.send_empty_response()
        } else if method == "textDocument/documentSymbol" {
            this.document_symbol()
            // A documentSymbol result must be an array; `{}` makes the client throw
            this.success(json.new_array())
        } else if method == "textDocument/codeAction" {
            this.code_action()
        } else if method == "textDocument/references" {
            this.references(null)
        } else if method == "textDocument/rename" {
            let new_name = this.data.get("params").get("newName").string_value() !? ""
            this.references(new_name)
        } else if method == "workspace/symbol" {
            this.workspace_symbol()
        } else if method == "textDocument/inlayHint" {
            this.inlay_hint()
        } else if method == "textDocument/semanticTokens/full" {
            this.semantic_tokens()
        } else if method.starts_with("$/") {
            if this.is_request : this.error_response(-32601, "Unsupported request: " + method)
        } else {
            if this.is_request {
                this.error_response(-32601, "Unsupported request: " + method)
            } else {
                this.log("Unsupported notification: " + method)
            }
        }
    }

    fn error_response(code: int, msg: String) {
        if !this.is_request : return
        let resp = json.new_object()
        resp.set("id", this.id)
        let err = json.new_object()
        err.set("code", json.from(code))
        err.set("message", json.from(msg))
        resp.set("error", err)
        this.respond(resp)
    }

    fn success(result: json.Value) {
        if !this.is_request : return
        let resp = json.new_object()
        resp.set("id", this.id)
        resp.set("result", result)
        this.respond(resp)
    }

    // `null` is the "nothing here" result of hover, definition, completion and the rest;
    // `{}` is not a valid CompletionList or Location
    fn send_empty_response() {
        if !this.is_request : return
        let resp = json.new_object()
        resp.set("id", this.id)
        resp.set("result", json.new_null())
        this.respond(resp)
    }

    fn respond(data: json.Value) {
        if this.responded : return
        this.send(data)
        this.responded = true
    }
    fn send(data: json.Value) {
        let content = encode(data)
        let resp = "Content-Length: " + (content.length) + "\r\n"
        resp += "\r\n" + content
        print(resp)
    }

    // ########################################
    // BUILD
    // ########################################

    // Path of the document a request refers to.
    fn request_file() ?String {
        let uri = this.data.get("params").get("textDocument").get("uri").string_value() !? ""
        if uri.is_empty() : return null
        return lsp_path_from_uri(uri)
    }

    // Every position-based request carries the same textDocument/position pair.
    fn build_at_cursor() {
        let params = this.data.get("params")
        let pos = params.get("position")
        let uri = params.get("textDocument").get("uri").string_value() !? ""
        if uri.is_empty() : return
        this.file = lsp_path_from_uri(uri)
        this.line = pos.get("line").int.to(u32) + 1
        this.col = pos.get("character").int.to(u32) + 1
        this.build()
    }

    fn build() {
        this.did_build = false
        this.build_wrap()
        if this.did_build : gc.collect()
    }

    fn attach_to_build(b: build.Build) {
        b.options.lsp = this
        // The editor checks everything, including `#if TEST` helpers and the tests
        // that call them. Only the macro is set, not test mode: that would also
        // queue every test body in every loaded file.
        b.set_macro_def_bool("TEST", true)
    }

    fn build_wrap() {
        if this.request == req_diagnostics {
            this.build_diagnostics()
            return
        }
        let args = Array[String]{}

        let file = this.file
        if !file.is_empty() : args.append(file, true)

        let b = build.Build.init_from_args(args) ! {
            this.log(E.msg)
            return
        }
        this.did_build = true
        this.attach_to_build(b)
        if this.request == req_formatting : b.options.is_fmt = true
        if this.request == req_inlay_hint || this.request == req_semantic_tokens : b.options.keep_going = true
        b.run() ! {}

        if b.lsp_answered : return
        if this.request == req_formatting {
            this.send_formatting(b)
            return
        }
        if this.request == req_doc_symbol {
            this.send_symbols(b)
            return
        }
        if this.request == req_inlay_hint {
            this.send_inlay_hints(b)
            return
        }
        if this.request == req_semantic_tokens {
            this.send_semantic_tokens(b)
            return
        }
    }

    // ########################################
    // DIAGNOSTICS
    // ########################################

    // Find the package dir containing `path` (if inside its `srcdir`), cached per directory.
    fn find_pkg_dir_for_path(path: String) ?String {
        let dir = fs.is_dir(path) ? path : fs.dir_of(path)
        let pkg_dir = this.find_closest_pkg_dir(dir) ?! return null
        let srcdir = this.pkg_srcdir(pkg_dir)
        if path == srcdir || path.starts_with(srcdir + fs.PATH_DIV) : return pkg_dir
        return null
    }

    fn find_closest_pkg_dir(dir: String) ?String {
        this.pkg_dir_cache.get(dir) -> cached {
            if cached.is_empty() : return null
            if fs.exists(helper.add(cached, "valk.json")) : return cached
            this.pkg_dir_cache.remove(dir)
        }
        if fs.exists(helper.add(dir, "valk.json")) {
            this.pkg_dir_cache.set(dir, dir)
            return dir
        }
        let parent = fs.dir_of(dir)
        if parent == dir {
            this.pkg_dir_cache.set(dir, "")
            return null
        }
        let found = this.find_closest_pkg_dir(parent)
        this.pkg_dir_cache.set(dir, found ?? "")
        return found
    }

    fn pkg_srcdir(pkg_dir: String) String {
        this.pkg_srcdir_cache.get(pkg_dir) -> cached : return cached
        let srcdir = helper.add(pkg_dir, "src")
        let config_path = helper.add(pkg_dir, "valk.json")
        let config = helper.Config.load(config_path) !? null
        if isset(config) {
            let src = config.json.get("src")
            match src {
                String as p => srcdir = helper.resolve(helper.add(pkg_dir, p))
                default => {}
            }
        }
        this.pkg_srcdir_cache.set(pkg_dir, srcdir)
        return srcdir
    }

    // Groups open files by namespace directory within their package (or by file path
    // for loose files outside a package).
    fn group_diagnostic_file(groups: Map[Array[String]], path: String) {
        if !fs.exists(path) : return
        let key = path
        let pkg_dir = this.find_pkg_dir_for_path(path)
        if isset(pkg_dir) {
            key = pkg_dir + "::" + fs.dir_of(path)
        }
        let files = groups.get(key) !? <{
            let created = Array[String]{}
            groups.set(key, created)
            return created
        }
        files.append(path, true)
    }

    // Open files are built per namespace (a loose file is a group of its own). Each
    // group's result is kept, and a group is only rebuilt when a file it loaded changed:
    // body-only edits in one file re-check only that file without re-parsing sibling bodies.
    fn build_diagnostics() {
        let per_path = Map[Array[Diagnostic]]{}
        let no_location = Array[String]{}
        let loaded_files = Map[bool]{}
        let seen_messages = Map[bool]{}
        let changed = this.changed_files
        this.changed_files = Map[bool]{}

        each this.file_content as _, path : per_path.set(path, Array[Diagnostic]{})
        let saved = this.file
        if !saved.is_empty() : per_path.set(saved, Array[Diagnostic]{})

        let groups = Map[Array[String]]{}
        each this.file_content as _, path {
            this.group_diagnostic_file(groups, path)
        }
        if !saved.is_empty() && !this.file_content.has(saved) {
            this.group_diagnostic_file(groups, saved)
        }

        each groups as files, key {
            let group = this.diagnostic_groups.get(key) !? null
            if !isset(group) {
                let single: ?String = files.length == 1 ? (files.get(0) !? null) : null
                group = this.collect_diagnostic_build(files, single)
                this.diagnostic_groups.set(key, group)
            } else {
                let action = this.check_group_stale(group, files, changed)
                if action.mode == 2 {
                    let single: ?String = files.length == 1 ? (files.get(0) !? null) : null
                    group = this.collect_diagnostic_build(files, single)
                    this.diagnostic_groups.set(key, group)
                } else if action.mode == 1 {
                    let target = action.single_file
                    let fresh = this.collect_diagnostic_build(Array[String]{ target }, target)
                    this.merge_single_file_group(group, fresh, target, files)
                } else {
                    // Prune diagnostics of files that were closed in this group
                    let old_targets = group.target_files
                    each old_targets as old_path {
                        if !files.contains(old_path) : group.per_path.remove(old_path)
                    }
                    group.target_files = files
                }
            }
            each group.loaded as _, path : loaded_files.set(path, true)
            each group.no_location as msg : no_location.append(msg, true)
            each group.per_path as diags, path {
                let list = per_path.get(path) !? <{
                    let created = Array[Diagnostic]{}
                    per_path.set(path, created)
                    return created
                }
                each diags as d {
                    // The same stdlib error surfaces in every group that loads the file
                    if seen_messages.has(d.key) : continue
                    seen_messages.set(d.key, true)
                    list.append(d)
                }
            }
        }

        // Forget groups whose files were all closed
        let closed = Array[String]{}
        each this.diagnostic_groups as _, key {
            if !groups.has(key) : closed.append(key)
        }
        each closed as key : this.diagnostic_groups.remove(key)

        this.publish_errors(per_path, no_location, loaded_files)
    }

    fn check_group_stale(group: DiagnosticGroup, files: Array[String], changed: Map[bool]) GroupAction {
        let dirty_targets = Array[String]{}

        each files as path {
            if !group.loaded.has(path) : return GroupAction { mode: 2 }
            if !group.target_files.contains(path) {
                // Newly opened file that this group already loaded from disk
                let disk_mtime = fs.modified_time(path) !? 0
                let old_mtime = group.loaded.get(path) !? 0
                if disk_mtime != old_mtime : return GroupAction { mode: 2 }
                let buf = this.file_content.get(path) !? null
                if isset(buf) {
                    let disk = fs.read(path) !? ""
                    if buf != disk {
                        let buf_sig = this.file_decl_sigs.get(path) !? lsp_decl_signature(buf)
                        if buf_sig != lsp_decl_signature(disk) : return GroupAction { mode: 2 }
                    }
                }
                dirty_targets.append(path, true)
                continue
            }
            if this.file_content.has(path) {
                let ver = this.file_versions.get(path) !? 0
                let old_ver = group.buffer_versions.get(path) !? 0
                if ver != old_ver {
                    let sig = this.file_decl_sigs.get(path) !? ""
                    let old_sig = group.decl_sigs.get(path) !? ""
                    if sig != old_sig || old_sig.is_empty() : return GroupAction { mode: 2 }
                    dirty_targets.append(path, true)
                }
            }
        }

        // Non-open files explicitly flagged as changed (e.g. didSave without didOpen)
        each changed as _, path {
            if !this.file_content.has(path) && group.loaded.has(path) : return GroupAction { mode: 2 }
        }

        // Check every loaded file: open buffers by version/decl_sig, unopened files by disk mtime
        each group.loaded as mtime, path {
            if this.file_content.has(path) {
                if files.contains(path) : continue
                let ver = this.file_versions.get(path) !? 0
                if group.buffer_versions.has(path) {
                    let old_ver = group.buffer_versions.get(path) !? 0
                    if ver == old_ver : continue
                    let sig = this.file_decl_sigs.get(path) !? ""
                    let old_sig = group.decl_sigs.get(path) !? ""
                    if sig != old_sig : return GroupAction { mode: 2 }
                } else {
                    // File was unopened during the last build, now opened in another group
                    if (fs.modified_time(path) !? 0) != mtime : return GroupAction { mode: 2 }
                    let buf = this.file_content.get(path) !? ""
                    let disk = fs.read(path) !? ""
                    if buf != disk {
                        let buf_sig = this.file_decl_sigs.get(path) !? lsp_decl_signature(buf)
                        if buf_sig != lsp_decl_signature(disk) : return GroupAction { mode: 2 }
                    }
                    group.buffer_versions.set(path, ver)
                    group.decl_sigs.set(path, this.file_decl_sigs.get(path) !? lsp_decl_signature(buf))
                }
                continue
            }
            if (fs.modified_time(path) !? 0) != mtime : return GroupAction { mode: 2 }
        }

        if dirty_targets.length == 0 : return GroupAction { mode: 0 }
        if dirty_targets.length == 1 {
            return GroupAction { mode: 1, single_file: dirty_targets.get(0) !? "" }
        }
        return GroupAction { mode: 2 }
    }

    fn merge_single_file_group(group: DiagnosticGroup, fresh: DiagnosticGroup, target: String, files: Array[String]) {
        group.per_path.set(target, fresh.per_path.get(target) !? Array[Diagnostic]{})
        // Also pick up any declaration/syntax diagnostics for non-open sibling files
        each fresh.per_path as diags, path {
            if path == target : continue
            if files.contains(path) : continue
            group.per_path.set(path, diags)
        }
        let old_targets = group.target_files
        each old_targets as old_path {
            if !files.contains(old_path) : group.per_path.remove(old_path)
        }
        each fresh.loaded as mtime, path : group.loaded.set(path, mtime)
        each fresh.buffer_versions as ver, path : group.buffer_versions.set(path, ver)
        each fresh.decl_sigs as sig, path : group.decl_sigs.set(path, sig)
        group.target_files = files
        group.no_location = fresh.no_location
    }

    fn collect_diagnostic_build(args: Array[String], single_file: ?String (null)) DiagnosticGroup {
        let group = DiagnosticGroup{}
        group.target_files = args
        let b = build.Build.init_from_args(args) ! {
            group.no_location.append(E.msg, true)
            return group
        }
        this.did_build = true
        this.attach_to_build(b)
        // A broken declaration elsewhere in the package must not hide the
        // errors of the file being checked.
        b.options.keep_going = true

        let prev_req = this.request
        let prev_file = this.file
        if isset(single_file) {
            this.request = req_file_diagnostics
            this.file = single_file
        }
        b.run() ! {}
        this.request = prev_req
        this.file = prev_file

        this.cache_symbols_for(b, args)

        each b.cache.loaded_files as _, path {
            group.loaded.set(path, fs.modified_time(path) !? 0)
            if this.file_content.has(path) {
                group.buffer_versions.set(path, this.file_versions.get(path) !? 0)
                let sig = this.file_decl_sigs.get(path) !? ""
                if !sig.is_empty() : group.decl_sigs.set(path, sig)
            }
        }

        each b.messages as m {
            let src = m.src
            if !isset(src) {
                group.no_location.append(m.msg, true)
                continue
            }
            let at = build.message_resolve(src, m.i)
            let path = at.src.path
            if !isset(path) {
                group.no_location.append(m.msg, true)
                continue
            }
            let start = lsp_line_col_in(at.src, at.i)
            let end = lsp_line_col_in(at.src, at.i + m.len)
            let list = group.per_path.get(path) !? <{
                let created = Array[Diagnostic]{}
                group.per_path.set(path, created)
                return created
            }
            let text = m.msg
            each m.notes as note : text += "\nnote: " + note
            let diagnostic = Diagnostic {
                key: path + ":" + at.i + ":" + m.len + ":" + m.type.to(int) + ":" + m.msg
                severity: m.type == build.MSG.error ? lsp_msg_type_error : lsp_msg_type_warn
                msg: text
                line: start.line
                col: start.col
                end_line: end.line
                end_col: end.col
                code: m.code
            }
            each m.labels as label {
                let span = lsp_diagnostic_span(label.src, label.i, label.len) ?! continue
                span.msg = label.text
                diagnostic.related.append(span)
            }
            each m.fixes as fix {
                let span = lsp_diagnostic_span(fix.src, fix.i, fix.len) ?! continue
                diagnostic.fixes.append(DiagnosticFix {
                    title: fix.text
                    path: span.path
                    line: span.line
                    col: span.col
                    end_line: span.end_line
                    end_col: span.end_col
                    replacement: fix.replacement
                })
            }
            this.attach_extra_fixes(b, m, at.src, at.i, diagnostic)
            list.append(diagnostic)
        }
        return group
    }

    fn publish_errors(
        per_path: Map[Array[Diagnostic]],
        no_location: Array[String],
        loaded_files: Map[bool]
    ) {
        let published = Array[String]{}
        each per_path as list, path {
            this.send_diagnostics(path, list)
            published.append(path)
        }

        each this.has_errors as path {
            if per_path.has(path) : continue
            if !loaded_files.has(path) && fs.exists(path) {
                published.append(path)
                continue
            }
            this.send_diagnostics(path, Array[Diagnostic]{})
        }
        this.has_errors = published

        let first = no_location.get(0) !? null
        if isset(first) : this.log(first, lsp_msg_type_error)
    }

    fn send_diagnostics(path: String, items: Array[Diagnostic]) {
        let resp = json.new_object()
        let res = json.new_object()
        resp.set("method", json.from("textDocument/publishDiagnostics"))
        resp.set("params", res)

        let diag = json.new_array()
        res.set("uri", lsp_uri_from_path(path))
        res.set("diagnostics", diag)

        each items as d {
            let item = json.new_object()
            item.set("severity", json.from(d.severity))
            item.set("message", json.from(d.msg))
            item.set("range", json_range(d.line, d.col, d.end_line, d.end_col))
            if !d.code.is_empty() : item.set("code", json.from(d.code))
            if d.related.length > 0 {
                let related = json.new_array()
                each d.related as span {
                    let info = json.new_object()
                    let location = json.new_object()
                    location.set("uri", json.from(lsp_uri_from_path(span.path)))
                    location.set("range", json_range(span.line, span.col, span.end_line, span.end_col))
                    info.set("location", location)
                    info.set("message", json.from(span.msg))
                    related.append(info)
                }
                item.set("relatedInformation", related)
            }
            diag.append(item)
        }

        this.respond(resp)
        this.responded = false
    }

    fn log(msg: String, type: int (lsp_msg_type_info)) {
        let resp = json.new_object()
        let res = json.new_object()
        resp.set("method", json.from("window/logMessage"))
        resp.set("params", res)

        res.set("type", json.from(type))
        res.set("message", json.from(msg))

        this.send(resp)
    }
}

// Result of building one diagnostics group, kept between passes
class DiagnosticGroup {
    // Every file the build read, with its modification time at that moment
    loaded: Map[uint] (Map[uint]{})
    // Open buffer versions and declaration signatures at the time this group was built
    buffer_versions: Map[uint] (Map[uint]{})
    decl_sigs: Map[String] (Map[String]{})
    target_files: Array[String] (Array[String]{})
    per_path: Map[Array[Diagnostic]] (Map[Array[Diagnostic]]{})
    no_location: Array[String] (Array[String]{})
}

class GroupAction {
    // 0 = fresh (cache hit), 1 = single-file incremental check, 2 = full rebuild
    mode: int (0)
    single_file: String ("")
}

// Fingerprint of top-level and type declarations, replacing non-generic function/test/bench
// bodies with `{}` so body-only edits can be detected quickly.
fn lsp_decl_signature(content: String) String {
    let bytes = content.bytes
    let data = content.data
    let out = ByteBuffer.new(bytes / 2 + 64)
    let i: uint = 0
    let brace_depth: int = 0
    let paren_depth: int = 0
    // Track brace depths that keep all inner bodies verbatim (traits, generic types)
    let keep_depth: int = -1
    let pending_keep_type = false
    let in_fn_header = false
    let fn_has_parens = false
    let fn_is_generic = false
    let fn_is_accessor = false

    while i < bytes {
        let ch = @ptrv(data, u8, i)

        // Line comment
        if ch == '/' && i + 1 < bytes && @ptrv(data, u8, i + 1) == '/' {
            i += 2
            while i < bytes && @ptrv(data, u8, i) != '\n' : i++
            continue
        }
        // Block comment
        if ch == '/' && i + 1 < bytes && @ptrv(data, u8, i + 1) == '*' {
            i += 2
            while i + 1 < bytes {
                if @ptrv(data, u8, i) == '*' && @ptrv(data, u8, i + 1) == '/' {
                    i += 2
                    break
                }
                i++
            }
            continue
        }
        // String literal
        if ch == '"' {
            out.write_byte(ch)
            i++
            while i < bytes {
                let c = @ptrv(data, u8, i)
                out.write_byte(c)
                i++
                if c == '\\' && i < bytes {
                    out.write_byte(@ptrv(data, u8, i))
                    i++
                } else if c == '"' {
                    break
                }
            }
            continue
        }
        // Char literal
        if ch == '\'' {
            out.write_byte(ch)
            i++
            while i < bytes {
                let c = @ptrv(data, u8, i)
                out.write_byte(c)
                i++
                if c == '\\' && i < bytes {
                    out.write_byte(@ptrv(data, u8, i))
                    i++
                } else if c == '\'' {
                    break
                }
            }
            continue
        }
        // Collapse whitespace runs to a single space
        if ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n' {
            if ch == '\n' : out.write_byte('\n')
            else : out.write_byte(' ')
            while i < bytes {
                let c = @ptrv(data, u8, i)
                if c != ' ' && c != '\t' && c != '\r' && c != '\n' : break
                i++
            }
            continue
        }

        // Word token
        if ch.is_alpha() || ch == '_' {
            let start = i
            while i < bytes {
                let c = @ptrv(data, u8, i)
                if !c.is_alpha_numeric() && c != '_' : break
                i++
            }
            let word = content.range(start, i - start)
            out.append_text(word)

            if keep_depth < 0 && paren_depth == 0 {
                if word == "trait" {
                    pending_keep_type = true
                    in_fn_header = false
                } else if word == "class" || word == "struct" || word == "union" || word == "interface" || word == "extend" {
                    in_fn_header = false
                    pending_keep_type = false
                } else if word == "fn" {
                    in_fn_header = true
                    fn_has_parens = false
                    fn_is_generic = false
                    fn_is_accessor = false
                } else if word == "test" || word == "bench" {
                    if brace_depth == 0 {
                        in_fn_header = true
                        fn_has_parens = true
                        fn_is_generic = false
                        fn_is_accessor = true
                    }
                } else if (word == "get" || word == "set") && brace_depth >= 1 {
                    in_fn_header = true
                    fn_has_parens = true
                    fn_is_generic = false
                    fn_is_accessor = true
                }
            }
            continue
        }

        if ch == '[' && paren_depth == 0 {
            if in_fn_header && !fn_has_parens : fn_is_generic = true
            else if !in_fn_header && keep_depth < 0 : pending_keep_type = true
        }
        if ch == '(' {
            if in_fn_header && paren_depth == 0 : fn_has_parens = true
            paren_depth++
        } else if ch == ')' && paren_depth > 0 {
            paren_depth--
        } else if ch == ';' && paren_depth == 0 {
            in_fn_header = false
        }

        if ch == '{' {
            if in_fn_header && paren_depth == 0 && !fn_is_generic && keep_depth < 0 && (fn_has_parens || fn_is_accessor) {
                // Skip non-generic function/accessor/test/bench body
                out.append_text("{}")
                in_fn_header = false
                let depth: int = 1
                i++
                while i < bytes && depth > 0 {
                    let c = @ptrv(data, u8, i)
                    if c == '/' && i + 1 < bytes && @ptrv(data, u8, i + 1) == '/' {
                        i += 2
                        while i < bytes && @ptrv(data, u8, i) != '\n' : i++
                        continue
                    }
                    if c == '/' && i + 1 < bytes && @ptrv(data, u8, i + 1) == '*' {
                        i += 2
                        while i + 1 < bytes {
                            if @ptrv(data, u8, i) == '*' && @ptrv(data, u8, i + 1) == '/' {
                                i += 2
                                break
                            }
                            i++
                        }
                        continue
                    }
                    if c == '"' || c == '\'' {
                        let q = c
                        i++
                        while i < bytes {
                            let s = @ptrv(data, u8, i)
                            i++
                            if s == '\\' && i < bytes : i++
                            else if s == q : break
                        }
                        continue
                    }
                    if c == '{' : depth++
                    else if c == '}' : depth--
                    i++
                }
                continue
            }
            if pending_keep_type && keep_depth < 0 {
                keep_depth = brace_depth
                pending_keep_type = false
            }
            in_fn_header = false
            brace_depth++
        } else if ch == '}' {
            if brace_depth > 0 : brace_depth--
            if keep_depth >= 0 && brace_depth <= keep_depth : keep_depth = -1
            in_fn_header = false
        }

        out.write_byte(ch)
        i++
    }
    return out.to_string()
}

fn request_for_method(method: String) int {
    if method == "textDocument/definition" : return req_definition
    if method == "textDocument/completion" : return req_completion
    if method == "textDocument/signatureHelp" : return req_sig_help
    if method == "textDocument/hover" : return req_hover
    if method == "textDocument/formatting" : return req_formatting
    if method == "textDocument/documentSymbol" : return req_doc_symbol
    if method == "textDocument/references" || method == "textDocument/rename" : return req_references
    if method == "workspace/symbol" : return req_workspace_symbol
    if method == "textDocument/inlayHint" : return req_inlay_hint
    if method == "textDocument/semanticTokens/full" : return req_semantic_tokens
    if method == "textDocument/didSave" : return req_diagnostics
    return req_none
}

// Line/column span of a source range, or null for a source without a path
fn lsp_diagnostic_span(src: build.Source, i: u32, len: u32) ?DiagnosticSpan {
    let at = build.message_resolve(src, i)
    let path = at.src.path ?! return null
    let start = lsp_line_col_in(at.src, at.i)
    let end = lsp_line_col_in(at.src, at.i + len)
    return DiagnosticSpan {
        path: path
        msg: ""
        line: start.line
        col: start.col
        end_line: end.line
        end_col: end.col
    }
}

fn json_range(line: u32, col: u32, end_line: u32, end_col: u32) json.Value {
    let range = json.new_object()
    range.set("start", json_position(line, col))
    range.set("end", json_position(end_line, end_col))
    return range
}

fn json_position(line: u32, col: u32) json.Value {
    let pos = json.new_object()
    pos.set("line", json.from(line > 0 ? (line - 1).to(uint) : 0))
    pos.set("character", json.from(col > 0 ? (col - 1).to(uint) : 0))
    return pos
}


use valk:json
use build
use valk:fs
use valk:gc

value lsp_msg_type_error (1)
value lsp_msg_type_warn (2)
value lsp_msg_type_info (3)

// One entry of a publishDiagnostics notification. Positions are the 1-based
// line/col the compiler reports; converting to the protocol's 0-based numbers
// happens where the JSON is built.
class Diagnostic {
    severity: int
    msg: String
    line: u32
    col: u32
    end_line: u32
    end_col: u32
}

class Lsp {
    buf: ByteBuffer
    index: uint (0)
    stage: uint (0)
    headers: Map[String] (Map[String]{})
    headers_str: String ("")
    data: json:Value (json:new_null())
    id: int (0)
    method: String ("")
    // Which kind of request the current build is serving (req_* in type.valk).
    // The compiler's hook sites read this per resolved expression.
    request: int (req_none)
    // Files
    file_content: Map[String] (Map[String]{})
    // Paths that currently have diagnostics published, so they can be cleared
    has_errors: Array[String] (Array[String]{})
    //
    file: String ("")
    line: uint (0)
    col: uint (0)
    //
    shutdown: bool (false)
    responded: bool (false)

    fn reset() {
        this.headers.clear()
        this.index = 0
        this.stage = 0
        this.data = json:new_null()
        this.id = 0
        this.method = ""
        this.request = req_none
        this.responded = false
        //
        this.file = ""
        this.line = 0
        this.col = 0
    }

    fn parse() {

        while this.buf.length > 0 {
            if this.stage == 0 {
                this.parse_headers() ! {
                    if E.code == E.more {
                        return
                    }
                    this.log("Invalid headers")
                    this.reset()
                    return
                }
            }
            if this.stage == 1 {
                this.parse_content() ! {
                    if E.code == E.more : return
                    this.reset()
                    return
                }
            }

            this.handle()
            this.reset()
        }
    }

    fn parse_headers() !LspError {
        let buf = this.buf
        let pos = this.index

        while true {
            let index = buf.index_of('\r', pos) ! throw .more
            if index + 1 >= buf.length : throw .more
            if buf.get(index + 1) != '\n' : throw .invalid

            if index == pos {
                // End of headers
                pos += 2
                break
            }

            // Read header
            let index2 = buf.index_of(':', pos) ! throw .invalid
            let key = buf.part(pos, index2 - pos).trim(" ").trim("\t")
            let value = buf.part(index2 + 1, index - index2 - 1).trim(" ").trim("\t")
            pos = index + 2
            this.index = pos

            this.headers.set(key.lower(), value)
        }

        this.stage = 1
        this.headers_str = this.buf.part(0, pos)
        this.buf.clear_until(pos)
        this.index = 0
    }

    fn parse_content() !LspError {
        let len = (this.headers.get("content-length") !? "0").to_uint() ! throw .invalid
        if this.buf.length < len : throw .more
        let content = this.buf.part(0, len)
        this.buf.clear_until(len)

        let data = json:decode(content) ! {
            this.log("Invalid JSON-RPC input: '%content' | length: %len/%{content.length} | Headers: " + this.headers_str)
            throw .invalid
        }

        this.data = data
    }

    fn handle() {
        let data = this.data

        let id = data.get_or("id").int()
        let method = data.get_or("method").string()
        let params = data.get_or("params")

        this.id = id
        this.method = method
        this.request = request_for_method(method)

        if this.shutdown {
            if method == "exit" {
                exit(0)
            }
            return
        }

        if method == "initialize" {
            this.init(params)
        } else if method == "initialized" {
        } else if method == "shutdown" {
            this.shutdown = true
            this.send_empty_response()
        } else if method == "exit" {
            exit(0)
        } else if method == "textDocument/didOpen" {
            this.handle_open()
        } else if method == "textDocument/didClose" {
            this.handle_close()
        } else if method == "textDocument/didChange" {
            this.handle_change()
        } else if method == "textDocument/didSave" {
            this.handle_save()
        } else if method == "textDocument/definition" {
            this.definition()
            this.send_empty_response()
        } else if method == "textDocument/completion" {
            this.completion()
            this.send_empty_response()
        } else if method == "textDocument/signatureHelp" {
            this.sighelp()
            this.send_empty_response()
        } else {
            this.log("Unsupported method: " + method)
        }
    }

    fn error(msg: String) {
        let resp = json:new_object()
        resp.set("id", json:new_int(this.id))
        resp.set("error", json:new_string(msg))
        this.respond(resp)
    }

    fn success(result: json:Value) {
        let resp = json:new_object()
        resp.set("id", json:new_int(this.id))
        resp.set("result", result)
        this.respond(resp)
    }

    fn send_empty_response() {
        let resp = json:new_object()
        resp.set("id", json:new_int(this.id))
        resp.set("result", json:new_object())
        this.respond(resp)
    }

    fn respond(data: json:Value) {
        if this.responded : return
        this.send(data)
        this.responded = true
    }
    fn send(data: json:Value) {
        let content = json:encode_to_string(data)
        let resp = "Content-Length: " + (content.length) + "\r\n"
        resp += "\r\n" + content
        print(resp)
    }

    // ########################################
    // BUILD
    // ########################################

    fn build() {
        this.build_wrap()
        // A build holds the whole front end of the project. Releasing it between
        // requests keeps an idle server from sitting on that memory.
        gc:collect()
    }

    fn build_wrap() {
        let args = Array[String]{}

        let file = this.file
        if !file.is_empty() {
            args.append(file)
        }

        let b = build:Build.init_from_args(args) ! {
            this.log(E.msg)
            return
        }
        b.options.lsp = this
        // Errors are the normal outcome of compiling a file mid-edit: they are
        // the diagnostics. The build's own reporting (print_results) exits the
        // process, so it is deliberately not used here.
        b.run() ! { }

        // A cursor request that found its answer stopped the build on purpose
        // and has already responded. Anything the build had not reached yet is
        // simply unexamined, not clean, so no diagnostics are published.
        if b.lsp_answered : return
        this.send_errors(b)
    }

    // ########################################
    // DIAGNOSTICS
    // ########################################

    fn send_errors(b: build:Build) {
        if this.request != req_diagnostics : return

        // publishDiagnostics replaces the entire list for one file, so each file
        // with messages needs exactly one notification.
        let per_path = Map[Array[Diagnostic]]{}
        // Messages with no source span (bad build arguments, missing files)
        let no_location = Array[String]{}

        // The saved file always gets a notification, even an empty one. Without
        // it a file that compiles cleanly on the first save is never mentioned,
        // and a client holding diagnostics from an earlier server run would keep
        // showing them.
        let saved = this.file
        if !saved.is_empty() : per_path.set(saved, Array[Diagnostic]{})

        each b.messages as m {
            let src = m.src
            if !isset(src) {
                no_location.append(m.msg)
                continue
            }
            // A span inside a `%{...}` interpolation belongs to the file the
            // interpolation was written in, not to the expression's own Source.
            let at = build:message_resolve(src, m.i)
            let path = at.src.path
            if !isset(path) {
                no_location.append(m.msg)
                continue
            }
            let content = at.src.content
            let start = build:message_line_col(content, at.i)
            let end = build:message_line_col(content, at.i + m.len)
            let list = per_path.get(path) !? <{
                let created = Array[Diagnostic]{}
                per_path.set(path, created)
                return created
            }
            list.append(Diagnostic {
                severity: m.type == build:MSG.error ? lsp_msg_type_error : lsp_msg_type_warn
                msg: m.msg
                line: start.line
                col: start.col
                end_line: end.line
                end_col: end.col
            })
        }

        let published = Array[String]{}
        each per_path as list, path {
            this.send_diagnostics(path, list)
            published.append(path)
        }

        each this.has_errors as path {
            if per_path.has(path) : continue
            // A file this build never read keeps whatever was published for it.
            // Editing one file only compiles that file's namespace and what it
            // uses, so an unread file's errors are unexamined rather than fixed;
            // clearing them would hide real problems.
            if !b.cache.loaded_files.contains(path) && fs:exists(path) {
                published.append(path)
                continue
            }
            this.send_diagnostics(path, Array[Diagnostic]{})
        }
        this.has_errors = published

        let first = no_location.get(0) !? null
        if isset(first) : this.log(first, lsp_msg_type_error)
    }

    fn send_diagnostics(path: String, items: Array[Diagnostic]) {
        let resp = json:new_object()
        let res = json:new_object()
        resp.set("method", json:new_string("textDocument/publishDiagnostics"))
        resp.set("params", res)

        let diag = json:new_array()
        res.set("uri", "file://" + path)
        res.set("diagnostics", diag)

        each items as d {
            let item = json:new_object()
            item.set("severity", json:new_int(d.severity))
            item.set("message", json:new_string(d.msg))
            item.set("range", json_range(d.line, d.col, d.end_line, d.end_col))
            diag.append(item)
        }

        this.respond(resp)
        // Diagnostics are notifications, not a reply to a request: several files
        // are published in one pass and none of them consumes the response slot.
        this.responded = false
    }

    fn log(msg: String, type: int (lsp_msg_type_info)) {
        let resp = json:new_object()
        let res = json:new_object()
        resp.set("method", json:new_string("window/logMessage"))
        resp.set("params", res)

        res.set("type", json:new_int(type))
        res.set("message", json:new_string(msg))

        this.send(resp)
    }
}

fn request_for_method(method: String) int {
    if method == "textDocument/definition" : return req_definition
    if method == "textDocument/completion" : return req_completion
    if method == "textDocument/signatureHelp" : return req_sig_help
    if method == "textDocument/didSave" : return req_diagnostics
    return req_none
}

// A protocol Range from 1-based compiler line/col. The protocol counts both
// lines and characters from zero.
fn json_range(line: u32, col: u32, end_line: u32, end_col: u32) json:Value {
    let range = json:new_object()
    range.set("start", json_position(line, col))
    range.set("end", json_position(end_line, end_col))
    return range
}

fn json_position(line: u32, col: u32) json:Value {
    let pos = json:new_object()
    pos.set("line", json:new_uint(line > 0 ? (line - 1).to(uint) : 0))
    pos.set("character", json:new_uint(col > 0 ? (col - 1).to(uint) : 0))
    return pos
}

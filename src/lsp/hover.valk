
use build
use valk:json

extend Lsp {
    fn hover() {
        this.build_at_cursor()
    }

    // `text` is what the compiler resolved at the cursor; `at` is the expression
    // it came from, whose span tells the editor how much to underline.
    fn send_hover(text: String, at: build:Exp) {
        let res = json:new_object()

        // A fenced block gets the editor's valk syntax highlighting, and stops a
        // type containing `_` or `*` from being read as markdown emphasis.
        let contents = json:new_object()
        contents.set("kind", json:from("markdown"))
        contents.set("value", json:from("```valk\n" + text + "\n```"))
        res.set("contents", contents)

        // Range is optional, but without it the editor guesses the word bounds and
        // gets `ns:name` or `a.b` wrong.
        let start = build:message_resolve(at.src, at.i)
        let end = build:message_resolve(at.src, at.i + at.len)
        if isset(start.src.path) {
            let from = lsp_line_col(start.src.content, start.i)
            let to = lsp_line_col(end.src.content, end.i)
            res.set("range", json_range(from.line, from.col, to.line, to.col))
        }

        this.success(res)
    }
}

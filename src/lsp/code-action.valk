
use valk.json

extend Lsp {
    // Quickfixes for the diagnostics of the last pass that carry a suggested
    // edit and touch the requested range. No build is needed: the fixes were
    // collected when the diagnostics were published.
    fn code_action() {
        let uri = this.request_file() ?! {
            this.success(json.new_array())
            return
        }
        let range = this.data.get("params").get("range")
        let from_line = range.get("start").get("line").int.to(u32) + 1
        let until_line = range.get("end").get("line").int.to(u32) + 1

        let actions = json.new_array()
        each this.diagnostic_groups as group {
            let diagnostics = group.per_path.get(uri) ! continue
            each diagnostics as d {
                if d.fixes.length == 0 : continue
                if d.line > until_line || d.end_line < from_line : continue
                each d.fixes as fix : actions.append(lsp_code_action(d, fix))
            }
        }
        this.success(actions)
    }
}

fn lsp_code_action(d: Diagnostic, fix: DiagnosticFix) json.Value {
    let action = json.new_object()
    action.set("title", json.from(fix.title))
    action.set("kind", json.from("quickfix"))
    action.set("isPreferred", json.from(true))

    let related = json.new_array()
    let diagnostic = json.new_object()
    diagnostic.set("severity", json.from(d.severity))
    diagnostic.set("message", json.from(d.msg))
    diagnostic.set("range", json_range(d.line, d.col, d.end_line, d.end_col))
    if !d.code.is_empty() : diagnostic.set("code", json.from(d.code))
    related.append(diagnostic)
    action.set("diagnostics", related)

    let text_edit = json.new_object()
    text_edit.set("range", json_range(fix.line, fix.col, fix.end_line, fix.end_col))
    text_edit.set("newText", json.from(fix.replacement))
    let edits = json.new_array()
    edits.append(text_edit)
    let changes = json.new_object()
    changes.set("file://" + fix.path, edits)
    let edit = json.new_object()
    edit.set("changes", changes)
    action.set("edit", edit)
    return action
}


use build
use valk.json
use valk.fs

extend Lsp {
    fn inlay_hint() {
        let uri = this.request_file() ?! {
            this.success(json.new_array())
            return
        }
        this.file = uri
        this.line = 0
        this.col = 0
        this.build()
    }

    fn send_inlay_hints(b: build.Build) {
        let content = this.file_content.get(this.file) !? (fs.read(this.file) !? "")
        let has_range = false
        let start_off: u32 = 0
        let end_off: u32 = content.bytes.to(u32)

        let params = this.data.get("params")
        if params.has("range") {
            let r = params.get("range")
            let s = r.get("start")
            let e = r.get("end")
            start_off = lsp_offset_for(content, s.get("line").int.to(u32) + 1, s.get("character").int.to(u32) + 1)
            end_off = lsp_offset_for(content, e.get("line").int.to(u32) + 1, e.get("character").int.to(u32) + 1)
            has_range = true
        }

        let hints = Array[build.LspInlayHint]{}
        let seen = Map[bool]{}
        each b.lsp_inlay_hints as h {
            if has_range && (h.offset < start_off || h.offset > end_off) : continue
            let key = "" + h.offset + ":" + h.kind
            if seen.has(key) : continue
            seen.set(key, true)
            hints.append(h)
        }

        hints.sort(fn(a: build.LspInlayHint, b: build.LspInlayHint) bool {
            if a.offset != b.offset : return a.offset > b.offset
            return a.kind > b.kind
        })

        let list = json.new_array()
        each hints as h {
            let lc = lsp_line_col(content, h.offset)
            let obj = json.new_object()
            obj.set("position", json_position(lc.line, lc.col))
            obj.set("label", json.from(h.label))
            obj.set("kind", json.from(h.kind))
            if h.padding_left : obj.set("paddingLeft", json.from(true))
            if h.padding_right : obj.set("paddingRight", json.from(true))
            list.append(obj)
        }
        this.success(list)
    }
}

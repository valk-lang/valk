use valk:json


extend Lsp {
    fn completion() {
        this.build_at_cursor()
        this.send_completion(Array[Completion]{})
    }

    fn send_completion(list: Array[Completion]) {
        let res = json:new_object()
        let items = json:new_array()

        res.set("isIncomplete", json:from(false))
        res.set("items", items)

        each list as li {
            let insert = li.insert
            let detail = li.detail

            let item = json:new_object()
            item.set("kind", json:from(li.type))
            item.set("label", json:from(li.label))

            if isset(detail) {
                let d = json:new_object()
                item.set("labelDetails", d)
                d.set("detail", json:from(detail))
            }

            if isset(insert) : item.set("insertText", json:from(insert))
            if li.type == ck_method || li.type == ck_function : item.set("insertTextFormat", json:from(2))

            items.append(item)
        }

        this.success(res)
    }
}

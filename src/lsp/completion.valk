
use valk:json

extend Lsp {
    fn completion() {
        let data = this.data
        let params = data.get_or("params")
        let doc = params.get_or("textDocument")
        let pos = params.get_or("position")
        let uri = doc.get_or("uri").string()
        if uri.is_empty() : return
        uri = lsp_path_from_uri(uri)
        this.file = uri
        this.line = pos.get_or("line").int().to(uint) + 1
        this.col = pos.get_or("character").int().to(uint) + 1
        this.build()
        // Nothing under the cursor produced a list (the file failed to parse
        // before reaching it, or the position is not in an expression). An empty
        // list is a valid answer and stops the editor from waiting.
        this.send_completion(Array[Completion]{})
    }

    fn send_completion(list: Array[Completion]) {
        let res = json:new_object()
        let items = json:new_array()

        res.set("isIncomplete", json:new_bool(false))
        res.set("items", items)

        each list as li {
            let insert = li.insert
            let detail = li.detail

            let item = json:new_object()
            item.set("kind", json:new_int(li.type))
            item.set("label", json:new_string(li.label))

            if isset(detail) {
                let d = json:new_object()
                item.set("labelDetails", d)
                d.set("detail", json:new_string(detail))
            }

            if isset(insert) : item.set("insertText", json:new_string(insert))
            // Snippet format, so the editor can place the caret between the
            // parentheses of a call it inserts.
            if li.type == ck_method || li.type == ck_function : item.set("insertTextFormat", json:new_int(2))

            items.append(item)
        }

        this.success(res)
    }
}


fn parse_base_ast(src: Source, ns: Namespace, u: Unit) !Error {
    // Init parser
    let p = src.start().init_parser()

    // Convert src content to expressions
    let exps = Array[Exp]{}
    while true {
        let t = p.tok(true, true) !>
        if t == TOK.end : break
        if t == TOK.comment {
            exps.append(read_comment_exp(p))
            continue
        }
        if t == TOK.sign && p.word_is(";") : continue
        exps.append(read_base_exp(p, t) !>)
    }

    // Loop over all expressions and parse further.
    // `state` tracks #if / #elif / #else / #end so false branches can skip.
    let scope = ns.scope.sub_scope()
    let state = ParseState.new()
    each exps as exp {
        parse_base_exp(ns, u, scope, state, exp) !>
    }
    if state.has_open_if() || state.is_skipping() {
        src.build.error("Missing compile macro '#end' in " + (src.path ?? "source"))
    }

    // Optional formatting (formats the full raw exp list, including skipped branches)
    if src.format {
        let result = ByteBuffer.new()
        each exps as exp {
            exp.format(result, 0)
        }
        result.write_string("\n")
        println(result)
    }
}

// Parse one top-level expression. `t` is the already-read first token.
fn read_base_exp(p: Parser, t: int) Exp !Error {
    // Newlines before the first token of this expression (before any access modifier).
    let new_lines = p.new_lines

    // Compile macros: #if / #elif / #else / #end / #loop / ...
    if t == TOK.sign && p.word_is("#") {
        let exp = read_macro_exp(p) !>
        exp.new_lines = new_lines
        return exp
    }

    // Optional access modifier: + (public) / ~ (readonly) / - (private)
    let act: ACT = ACT.undefined
    if t == TOK.sign && (p.word_is("+") || p.word_is("-") || p.word_is("~")) {
        act = read_act_sign(p) !>
        t = p.tok(true, false) !>
    }

    let exp : ?Exp = null
    if t == TOK.word || t == TOK.at_word {
        if p.word_is("use") : exp = read_use_exp(p) !>
        else if p.word_is("extern") : exp = read_extern_exp(p, act) !>
        else if p.word_is("fn") : exp = read_func_exp(p, act) !>
        else if p.word_is("test") : exp = read_test_exp(p) !>
        else if p.word_is("class") || p.word_is("struct") || p.word_is("slice") || p.word_is("pointer") || p.word_is("integer") || p.word_is("float") || p.word_is("boolean") || p.word_is("mode") {
            exp = read_class_exp(p, act) !>
        } else if p.word_is("enum") : exp = read_enum_exp(p, act) !>
        else if p.word_is("global") : exp = read_global_exp(p, act, GLOBAL_KIND.global) !>
        else if p.word_is("shared") : exp = read_global_exp(p, act, GLOBAL_KIND.shared) !>
        else if p.word_is("@shared") : exp = read_global_exp(p, act, GLOBAL_KIND.at_shared) !>
        else if p.word_is("alias") : exp = read_alias_exp(p, act) !>
        else if p.word_is("type") : exp = read_alias_type_exp(p, act) !>
        else if p.word_is("value") : exp = read_alias_value_exp(p, act) !>
        else if p.word_is("link") : exp = read_link_exp(p) !>
        else if p.word_is("error") : exp = read_error_exp(p, act) !>
        else if p.word_is("@ignore_access") : exp = read_ignore_access_exp(p) !>
    }
    if isset(exp) {
        exp.new_lines = new_lines
        return exp
    }

    p.error("Unexpected token: '" + p.word() + "'")
}

// Current token is `#`. Parse #if / #elif / #else / #end / #loop / #print / #error / ...
// Condition after #if / #elif is a full EXP.value (e.g. `OS == win`).
// Exp.kind = MACRO_KIND.
fn read_macro_exp(p: Parser) Exp !Error {
    let exp = p.create_exp(EXP.macro)
    if p.word_len > 0 && p.pos.i >= p.word_len {
        exp.i = p.pos.i - p.word_len
    }

    // Macro keyword immediately after `#` (no space): if, elif, else, end, ...
    let t = p.tok(false, false) !>
    if t != TOK.word {
        p.error("Expected compile macro name after '#', found: '" + p.word() + "'")
    }

    if p.word_is("if") {
        exp.kind = MACRO_KIND.if
        exp.set(MACRO_EXP.value, read_value_exp(p, false) !>)
    } else if p.word_is("elif") {
        exp.kind = MACRO_KIND.elif
        exp.set(MACRO_EXP.value, read_value_exp(p, false) !>)
    } else if p.word_is("else") {
        exp.kind = MACRO_KIND.else
    } else if p.word_is("end") {
        exp.kind = MACRO_KIND.end
    } else if p.word_is("print") {
        exp.kind = MACRO_KIND.print
        t = p.tok(true, false) !>
        if t != TOK.string {
            p.error("Expected string after '#print', found: '" + p.word() + "'")
        }
        exp.str2 = p.word()
    } else if p.word_is("error") {
        exp.kind = MACRO_KIND.error
        t = p.tok(true, false) !>
        if t != TOK.string {
            p.error("Expected string after '#error', found: '" + p.word() + "'")
        }
        exp.str2 = p.word()
    } else if p.word_is("loop") {
        exp.kind = MACRO_KIND.loop
        // Collect remaining words on this line: kind + names / `as` binders
        let words = Array[String]{}
        while true {
            t = p.tok(true, false, false) !>
            if t == TOK.end || t == TOK.none : break
            if t != TOK.word && t != TOK.at_word : break
            p.tok(true, false) !>
            words.append(p.word())
        }
        if words.length > 0 : exp.list = words
    } else if p.word_is("print_type") {
        exp.kind = MACRO_KIND.print_type
        exp.set(MACRO_EXP.value, read_value_exp(p, false) !>)
    } else if p.word_is("print_value_type") {
        exp.kind = MACRO_KIND.print_value_type
        exp.set(MACRO_EXP.value, read_value_exp(p, false) !>)
    } else {
        p.error("Unknown compile macro '#" + p.word() + "'")
    }

    exp.set_end(p.pos.i)
    return exp
}

fn read_act_sign(p: Parser) ACT !Error {
    if p.word_is("+") : return ACT.public
    if p.word_is("~") : return ACT.readonly
    if p.word_is("-") : return ACT.private
    p.error("Expected '+' (public), '~' (read-only) or '-' (private). Found: '" + p.word() + "'")
}

// Current token is TOK.comment; store full `//...` text (excluding trailing newline).
fn read_comment_exp(p: Parser) Exp {
    let exp = p.create_exp(EXP.comment)
    exp.str1 = p.word()
    // Span: word covers the comment; pos is after it
    if p.word_len > 0 && p.pos.i >= p.word_len {
        exp.i = p.pos.i - p.word_len
        exp.len = p.word_len
    }
    return exp
}

fn read_use_exp(p: Parser) Exp !Error {
    let use_exp = p.create_exp(EXP.use)
    let id = p.read_id(true, false) !>
    // Optional `as alias`
    let alias : ?String = null
    let t = p.tok(true, false, false) !>
    if t == TOK.word && p.word_is("as") {
        p.tok(true, false) !>
        alias = p.read_word(true, false) !>
    }
    use_exp.str2 = alias
    use_exp.set(USE_EXP.id, id)
    use_exp.set_end(p.pos.i)
    return use_exp
}

// Current token is `link`. Form: link [dynamic|static|framework] "lib"
// Exp.kind = LINK_KIND (auto when no keyword); str1 = library path/name without quotes.
fn read_link_exp(p: Parser) Exp !Error {
    let exp = p.create_exp(EXP.link)
    if p.word_len > 0 && p.pos.i >= p.word_len {
        exp.i = p.pos.i - p.word_len
    }

    let kind: LINK_KIND = LINK_KIND.auto
    let t = p.tok(true, false, false) !>
    if t == TOK.word {
        if p.word_is("dynamic") {
            kind = LINK_KIND.dynamic
            p.tok(true, true) !>
        } else if p.word_is("static") {
            kind = LINK_KIND.static
            p.tok(true, true) !>
        } else if p.word_is("framework") {
            kind = LINK_KIND.framework
            p.tok(true, true) !>
        }
    }
    exp.kind = kind

    t = p.tok(true, false) !>
    if t != TOK.string {
        p.error("Expected a string after 'link', found: '" + p.word() + "'")
    }
    exp.str1 = strip_quotes(p.word())
    exp.set_end(p.pos.i)
    return exp
}

// Current token is `extern`. Form: extern fn|global|shared|@shared ...
// Marks the following func/global as externally defined (EXP.bool2 = is_extern).
fn read_extern_exp(p: Parser, act: ACT) Exp !Error {
    let t = p.tok(true, false) !>
    if t != TOK.word && t != TOK.at_word {
        p.error("Expected 'fn', 'global', 'shared' or '@shared' after 'extern', found: '" + p.word() + "'")
    }
    if p.word_is("fn") {
        return read_func_exp(p, act, false, true) !>
    }
    if p.word_is("global") {
        return read_global_exp(p, act, GLOBAL_KIND.global, true) !>
    }
    if p.word_is("shared") {
        return read_global_exp(p, act, GLOBAL_KIND.shared, true) !>
    }
    if p.word_is("@shared") {
        return read_global_exp(p, act, GLOBAL_KIND.at_shared, true) !>
    }
    p.error("Invalid token after 'extern': '" + p.word() + "'. Expected: 'fn', 'global', 'shared' or '@shared'")
}

// `fn` keyword is the current token. Optional static flag from class methods.
// kind = FUNC_KIND; bool1 = is_static; bool2 = is_extern.
fn read_func_exp(p: Parser, act: ACT, is_static: bool (false), is_extern: bool (false)) Exp !Error {
    let exp = p.create_exp(EXP.func)
    exp.act = act
    exp.kind = FUNC_KIND.fn
    exp.bool1 = is_static
    exp.bool2 = is_extern
    exp.str1 = p.read_word(true, false) !>

    // Optional generics body [T, U]
    let t = p.tok(true, false, false) !>
    if t == TOK.sign && p.word_is("[") {
        p.tok(true, false) !>
        exp.set(FUNC_EXP.generics, read_body_exp(p, "[", "]") !>)
    }

    // Arguments body () — required
    p.expect("(", true, false) !>
    exp.set(FUNC_EXP.args, read_body_exp(p, "(", ")") !>)

    // Optional return type
    t = p.tok(true, true, false) !>
    if t != TOK.flag && t != TOK.at_word && !(t == TOK.sign && (p.word_is("{") || p.word_is("!") || p.word_is(";"))) {
        exp.set(FUNC_EXP.type, read_type_exp(p) !>)
        t = p.tok(true, true, false) !>
    }

    // Optional error type: !ErrorName
    if t == TOK.sign && p.word_is("!") {
        p.tok(true, true) !>
        exp.set(FUNC_EXP.error, p.read_id(false, false) !>)
        t = p.tok(true, true, false) !>
    }

    // Flags: $exit, @something, ...
    let flags = Array[String]{}
    while t == TOK.flag || t == TOK.at_word {
        p.tok(true, true) !>
        flags.append(p.word())
        t = p.tok(true, true, false) !>
    }
    if flags.length > 0 : exp.list = flags

    // Function body may be `{...}` or `;` (e.g. signature-only / extern-style)
    if t == TOK.sign && p.word_is("{") {
        p.tok(true, true) !>
        exp.set(FUNC_EXP.body, read_body_exp(p, "{", "}") !>)
    } else if t == TOK.sign && p.word_is(";") {
        p.tok(true, true) !>
    } else {
        p.error("Expected '{' or ';' after function signature, found: '" + p.word() + "'")
    }
    exp.set_end(p.pos.i)
    return exp
}

fn read_test_exp(p: Parser) Exp !Error {
    // test "name" { ... }
    let exp = p.create_exp(EXP.test)
    let t = p.tok(true, false) !>
    if t != TOK.string {
        p.error("Expected a valid test name (must be double quoted string), found: '" + p.word() + "'")
    }
    exp.str1 = p.word()
    p.expect("{", true, true) !>
    exp.set(TEST_EXP.body, read_body_exp(p, "{", "}") !>)
    exp.set_end(p.pos.i)
    return exp
}

fn read_class_exp(p: Parser, act: ACT) Exp !Error {
    let exp = p.create_exp(EXP.class)
    exp.act = act
    // Keyword: class / struct / slice / pointer / integer / float / boolean / mode
    let kind = read_class_kind(p) !>
    exp.kind = kind
    exp.str1 = p.read_word(true, false) !>

    // Optional generics body [T, U]
    let t = p.tok(true, false, false) !>
    if t == TOK.sign && p.word_is("[") {
        p.tok(true, false) !>
        exp.set(CLASS_EXP.generics, read_body_exp(p, "[", "]") !>)
    }

    // Kind-specific header
    // - integer: signed|unsigned, then size 1|2|4|8|*  → number (bytes; * = ptr_size)
    // - float: size 4|8|*  → number
    // - struct: optional packed → bool1
    // bool1: integer → signed; struct → packed
    // list: $noNewProperties / $global
    let flags = Array[String]{}

    if kind == CLASS_KIND.integer {
        t = p.tok(true, true) !>
        if p.word_is("signed") {
            exp.bool1 = true
        } else if p.word_is("unsigned") {
            exp.bool1 = false
        } else {
            p.error("Expected 'signed' or 'unsigned' after integer name, found: '" + p.word() + "'")
        }
        exp.number = read_class_size(p, true) !>
    } else if kind == CLASS_KIND.float {
        exp.number = read_class_size(p, false) !>
    }

    // Optional trailing modifiers
    while true {
        t = p.tok(true, false, false) !>
        if t == TOK.end : p.error("Expected '{' after class header")
        if t == TOK.sign && p.word_is("{") : break

        if kind == CLASS_KIND.struct && t == TOK.word && p.word_is("packed") {
            p.tok(true, false) !>
            exp.bool1 = true
            continue
        }
        if (kind == CLASS_KIND.class || kind == CLASS_KIND.struct) && t == TOK.flag && p.word_is("$noNewProperties") {
            p.tok(true, false) !>
            flags.append("$noNewProperties")
            continue
        }
        if t == TOK.flag && p.word_is("$global") {
            p.tok(true, false) !>
            flags.append("$global")
            continue
        }

        p.error("Unexpected token in class header: '" + p.word() + "'")
    }

    if flags.length > 0 : exp.list = flags

    // Body is required
    p.expect("{", true, true) !>
    exp.set(CLASS_EXP.body, read_body_exp(p, "{", "}") !>)
    exp.set_end(p.pos.i)
    return exp
}

// Map current keyword token to CLASS_KIND without allocating.
fn read_class_kind(p: Parser) CLASS_KIND !Error {
    if p.word_is("class") : return CLASS_KIND.class
    if p.word_is("struct") : return CLASS_KIND.struct
    if p.word_is("slice") : return CLASS_KIND.slice
    if p.word_is("pointer") : return CLASS_KIND.pointer
    if p.word_is("integer") : return CLASS_KIND.integer
    if p.word_is("float") : return CLASS_KIND.float
    if p.word_is("boolean") : return CLASS_KIND.boolean
    if p.word_is("mode") : return CLASS_KIND.mode
    p.error("Expected class kind keyword, found: '" + p.word() + "'")
}

// Size after integer/float name: 1,2,4,8,* (integer) or 4,8,* (float).
// `*` is stored as 0 so the AST can round-trip back to source for formatting.
fn read_class_size(p: Parser, is_int: bool) u32 !Error {
    let t = p.tok(true, false) !>
    if t == TOK.sign && p.word_is("*") : return 0
    if is_int {
        if p.word_is("1") : return 1
        if p.word_is("2") : return 2
        if p.word_is("4") : return 4
        if p.word_is("8") : return 8
        p.error("Invalid integer size: '" + p.word() + "' | Options: 1,2,4,8,*")
    }
    if p.word_is("4") : return 4
    if p.word_is("8") : return 8
    p.error("Invalid float size: '" + p.word() + "' | Options: 4,8,*")
}

fn read_enum_exp(p: Parser, act: ACT) Exp !Error {
    let exp = p.create_exp(EXP.enum)
    exp.act = act
    exp.str1 = p.read_word(true, false) !>

    // Optional `: Type` after the name (spaces allowed around `:`)
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is(":") {
        p.tok(true, true) !>
        exp.set(ENUM_EXP.type, read_type_exp(p) !>)
    }

    // Body is required
    p.expect("{", true, true) !>
    exp.set(ENUM_EXP.body, read_body_exp(p, "{", "}") !>)
    exp.set_end(p.pos.i)
    return exp
}

// Current token is `global`, `shared`, or `@shared`.
// Form: [extern] global name: Type [(default)]
//       [extern] shared name: Type [(default)]
//       @shared name: Type [(default)]
// kind = GLOBAL_KIND; bool2 = is_extern.
// allow_unsafe later: kind == at_shared || (is_extern && kind == shared).
fn read_global_exp(p: Parser, act: ACT, kind: GLOBAL_KIND, is_extern: bool (false)) Exp !Error {
    let exp = p.create_exp(EXP.global)
    exp.act = act
    exp.kind = kind
    exp.bool2 = is_extern
    exp.str1 = p.read_word(true, false) !>

    p.expect(":", true, false) !>
    exp.set(GLOBAL_EXP.type, read_type_exp(p, false, true) !>)

    // Optional default value: ( ... )
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is("(") {
        p.tok(true, true) !>
        exp.set(GLOBAL_EXP.default, read_body_exp(p, "(", ")") !>)
    }

    exp.set_end(p.pos.i)
    return exp
}

// Current token is `alias`. Form: alias Name for Id
fn read_alias_exp(p: Parser, act: ACT) Exp !Error {
    let exp = p.create_exp(EXP.alias)
    exp.act = act
    exp.str1 = p.read_word(true, false) !>
    p.expect("for", true, false) !>
    exp.set(ALIAS_EXP.id, p.read_id(true, false) !>)
    exp.set_end(p.pos.i)
    return exp
}

// Current token is `type`. Form: type Name (Type)
// Body is stored as raw EXP.body and re-parsed later as a type.
fn read_alias_type_exp(p: Parser, act: ACT) Exp !Error {
    let exp = p.create_exp(EXP.alias_type)
    exp.act = act
    exp.str1 = p.read_word(true, false) !>
    p.expect("(", true, false) !>
    exp.set(ALIAS_TYPE_EXP.body, read_body_exp(p, "(", ")") !>)
    exp.set_end(p.pos.i)
    return exp
}

// Current token is `value`. Form: value Name (Value)
// Body is stored as raw EXP.body and re-parsed later as a value.
fn read_alias_value_exp(p: Parser, act: ACT) Exp !Error {
    let exp = p.create_exp(EXP.alias_value)
    exp.act = act
    exp.str1 = p.read_word(true, false) !>
    p.expect("(", true, false) !>
    exp.set(ALIAS_VALUE_EXP.body, read_body_exp(p, "(", ")") !>)
    exp.set_end(p.pos.i)
    return exp
}

// Current token is `@ignore_access`. File-level directive (no operands).
fn read_ignore_access_exp(p: Parser) Exp !Error {
    let exp = p.create_exp(EXP.ignore_access)
    if p.word_len > 0 && p.pos.i >= p.word_len {
        exp.i = p.pos.i - p.word_len
    }
    exp.set_end(p.pos.i)
    return exp
}

// Current token is `error`. Form:
//   error Name (code, ...) [extends (...)] [payload {...}] [$global]
// Codes are parsed into exp.list. Payload (and extends) are raw EXP.body for later.
// bool1 = $global
fn read_error_exp(p: Parser, act: ACT) Exp !Error {
    let exp = p.create_exp(EXP.error)
    exp.act = act
    exp.str1 = p.read_word(true, false) !>

    // Required code list: (code1, code2, ...)
    p.expect("(", true, true) !>
    let codes = Array[String]{}
    while true {
        let t = p.tok(true, true) !>
        if t == TOK.sign && p.word_is(")") : break
        if t != TOK.word {
            p.error("Expected error code name, found: '" + p.word() + "'")
        }
        let code = p.word()
        if code == "code" {
            p.error("You cannot use 'code' as an error code, this is a reserved name")
        }
        each codes as existing {
            if existing == code : p.error("Duplicate error code: " + code)
        }
        codes.append(code)

        t = p.tok(true, true) !>
        if t == TOK.sign && p.word_is(")") : break
        if t == TOK.sign && p.word_is(",") : continue
        p.error("Expected ',' or ')' in error codes, found: '" + p.word() + "'")
    }
    if codes.length == 0 : exp.error("Error type must define at least one code")
    exp.list = codes

    // Optional trailing sections: extends (...), payload {...}, $global
    while true {
        let t = p.tok(true, false, false) !>
        if t == TOK.word && p.word_is("extends") {
            if isset(exp.get(ERROR_EXP.extends)) : p.error("Error type already has an 'extends' clause")
            p.tok(true, true) !>
            p.expect("(", true, true) !>
            exp.set(ERROR_EXP.extends, read_body_exp(p, "(", ")") !>)
            continue
        }
        if t == TOK.word && p.word_is("payload") {
            if isset(exp.get(ERROR_EXP.payload)) : p.error("Error type already has a 'payload' clause")
            p.tok(true, true) !>
            p.expect("{", true, true) !>
            exp.set(ERROR_EXP.payload, read_body_exp(p, "{", "}") !>)
            continue
        }
        if t == TOK.flag && p.word_is("$global") {
            p.tok(true, false) !>
            exp.bool1 = true
            continue
        }
        break
    }

    exp.set_end(p.pos.i)
    return exp
}

// Read a bracketed body into an EXP.body. Opener must already be consumed.
// Stores the start index and a Pos snapshot (for re-parsing content later);
// content is skipped until the matching closer.
fn read_body_exp(p: Parser, open: String, close: String) Exp !Error {
    let body = p.create_exp(EXP.body)
    body.pos = p.pos.copy()
    p.skip_balanced(open, close) !>
    body.set_end(p.pos.i)
    return body
}

class Scope {
    parent: ?Scope
    identifiers: ?IdfMap
    allow_unsafe: bool (false)
    unsafe_directive: ?UnsafeDirective (null)
    // Function-body AST: ordered list of Values (including if/while/let as void values)
    values: Array[Value] (.{})
    // Owning function when this is a func/body scope
    func: ?Func (null)
    // Control-flow bookkeeping
    did_return: bool (false)
    reported_unreachable: bool (false)
    must_return: bool (false)
    must_exit: bool (false)
    must_throw: bool (false)
    is_loop: bool (false)
    did_break: bool (false)
    // Set on the body scope of a `lock` block: the call that releases it
    lock_release: ?Value (null)
    // Created on first use; most scopes never touch them
    loop_invalidated: ?Array[Decl] (null)
    loop_trusted: ?Array[Decl] (null)
    not_null_removed: ?Array[Decl] (null)
    // Locals declared in this scope (order preserved for IR later)
    decls: Array[Decl] (.{})
    not_null: Array[Decl] (.{})
    vscope_returns: ?Array[Value] (null)
    vscope_rett: ?Type (null)

    static fn new(parent: ?Scope (null)) SELF {
        return SELF {
            parent: parent
        }
    }

    fn sub_scope() SELF {
        let s = SELF {
            parent: this
        }
        // Nested blocks inherit the owning function
        s.func = this.func
        return s
    }

    fn unsafe_allowed() bool {
        if this.allow_unsafe : return true
        let p = this.parent
        return isset(p) && p.unsafe_allowed()
    }

    fn enable_unsafe(exp: Exp) {
        let directive = UnsafeDirective { exp: exp }
        this.allow_unsafe = true
        this.unsafe_directive = directive
        exp.src.build.lists.unsafe_directives.append(directive)
    }

    fn mark_unsafe_used() bool {
        if this.allow_unsafe {
            let directive = this.unsafe_directive
            if isset(directive) : directive.used = true
            return true
        }
        let p = this.parent
        return isset(p) && p.mark_unsafe_used()
    }

    // Nearest enclosing value-scope (`<{...}`), if any.
    fn find_vscope() ?Scope {
        if isset(this.vscope_returns) : return this
        let p = this.parent
        if isset(p) : return p.find_vscope()
        return null
    }

    fn is_not_null_removed(decl: Decl) bool {
        let removed = this.not_null_removed
        return isset(removed) && removed.contains(decl)
    }

    fn not_null_check(decl: Decl) bool {
        if this.is_not_null_removed(decl) : return false
        if this.not_null.contains(decl) : return true
        let p = this.parent
        if isset(p) : return p.not_null_check(decl)
        return false
    }

    fn not_null_check_relied(decl: Decl) bool {
        return this.not_null_check_relied_from(decl, null)
    }

    fn not_null_check_relied_from(decl: Decl, loop: ?Scope) bool {
        if this.is_not_null_removed(decl) : return false
        if this.not_null.contains(decl) {
            if isset(loop) : loop.loop_trusted_list().append(decl, true)
            return true
        }
        let p = this.parent
        if !isset(p) : return false
        let inner = loop
        if this.is_loop && !isset(inner) : inner = this
        return p.not_null_check_relied_from(decl, inner)
    }

    fn apply_issets(issets: ?Array[Decl]) {
        if !isset(issets) : return
        each issets as d : this.mark_not_null(d)
    }

    fn mark_not_null(decl: Decl) {
        let removed = this.not_null_removed
        if isset(removed) : removed.remove_value(decl)
        this.not_null.append(decl, true)
    }

    fn clear_not_null(decl: Decl) {
        this.not_null.remove_value(decl)
        this.not_null_removed_list().append(decl, true)
        this.record_loop_invalidation(decl)
    }

    fn record_loop_invalidation(decl: Decl) {
        if this.is_loop : this.loop_invalidated_list().append(decl, true)
        let p = this.parent
        if isset(p) : p.record_loop_invalidation(decl)
    }

    fn not_null_removed_list() Array[Decl] {
        return this.not_null_removed ?? <{
            let a = Array[Decl]{}
            this.not_null_removed = a
            return a
        }
    }

    fn loop_trusted_list() Array[Decl] {
        return this.loop_trusted ?? <{
            let a = Array[Decl]{}
            this.loop_trusted = a
            return a
        }
    }

    fn loop_invalidated_list() Array[Decl] {
        return this.loop_invalidated ?? <{
            let a = Array[Decl]{}
            this.loop_invalidated = a
            return a
        }
    }

    // Every caller declares a new Decl, so neither list can already hold it.
    fn add_decl(decl: Decl) {
        this.decls.append(decl)
        let f = this.func
        if isset(f) : f.all_decls.append(decl)
    }

    fn append_value(v: Value) {
        this.values.append(v)
    }

    // Ensure identifiers map exists and return it.
    fn idfs() IdfMap {
        let m = this.identifiers
        if isset(m) : return m
        let created = IdfMap {}
        this.identifiers = created
        return created
    }

    fn get_idf(name: String) ?Idf {
        return this.get_idf_hashed(name, name.hash())
    }

    // The name is hashed once for the whole parent chain
    fn get_idf_hashed(name: String, hash: uint) ?Idf {
        let m = this.identifiers
        if isset(m) {
            let idf = m.get_hashed(name, hash)
            if isset(idf) : return idf
        }
        let parent = this.parent
        if isset(parent) : return parent.get_idf_hashed(name, hash)
        return null
    }

    fn find_scope_idf(name: String) ?Idf {
        return this.find_scope_idf_hashed(name, name.hash())
    }

    fn find_scope_idf_hashed(name: String, hash: uint) ?Idf {
        let m = this.identifiers
        if isset(m) {
            let idf = m.get_hashed(name, hash)
            if isset(idf) && idf.type == IDF.scope : return idf
        }
        let parent = this.parent
        if isset(parent) : return parent.find_scope_idf_hashed(name, hash)
        return null
    }

    fn get_scope_idf(name: String) ?Idf {
        let idf = this.find_scope_idf(name)
        if !isset(idf) : return null
        let u = idf.from_use
        if isset(u) : u.is_used = true
        return idf
    }

    fn has_idf(name: String) bool {
        return isset(this.get_idf(name))
    }

    // True if this scope (not parents) already defines `name`.
    fn has_local(name: String) bool {
        let m = this.identifiers
        if isset(m) : return m.has(name)
        return false
    }

    // Set an identifier in this scope only (does not walk parents).
    fn set_idf(name: String, idf: Idf) {
        this.idfs().set(name, idf)
    }
}

class UnsafeDirective {
    exp: Exp
    used: bool (false)
}

// Scope identifiers in insertion order. Most scopes hold a handful of names,
// so lookups scan; a hash index is added once the scope grows past that.
class IdfMap {
    names: Array[String] (.{})
    hashes: Array[uint] (.{})
    idfs: Array[Idf] (.{})
    index: ?Map[uint] (null)

    get length: uint {
        return this.names.length
    }

    fn find(name: String, hash: uint) ?uint {
        let index = this.index
        if isset(index) : return index.get(name) !? null
        each this.hashes as h, i {
            if h == hash && (this.names.get(i) !? "") == name : return i
        }
        return null
    }

    fn get(name: String) ?Idf {
        return this.get_hashed(name, name.hash())
    }

    fn get_hashed(name: String, hash: uint) ?Idf {
        let i = this.find(name, hash) ?! return null
        return this.idfs.get(i) !? null
    }

    fn has(name: String) bool {
        return isset(this.find(name, name.hash()))
    }

    fn set(name: String, idf: Idf) {
        let hash = name.hash()
        let i = this.find(name, hash)
        if isset(i) {
            this.idfs.set(i, idf) _
            return
        }
        this.names.append(name)
        this.hashes.append(hash)
        this.idfs.append(idf)
        let index = this.index
        if isset(index) {
            index.set(name, this.names.length - 1)
        } else if this.names.length > 8 {
            let created = Map[uint]{}
            each this.names as n, i : created.set(n, i)
            this.index = created
        }
    }

    fn _next(index: uint) (Idf, String) !IterError {
        let name = this.names.get(index) ! throw .end
        let idf = this.idfs.get(index) ! throw .end
        return (idf, name)
    }
}

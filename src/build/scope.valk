class Scope {
    parent: ?Scope
    identifiers: ?Map[Idf]
    // Function-body AST: ordered list of Values (including if/while/let as void values)
    values: Array[Value] (.{})
    // Owning function when this is a func/body scope
    func: ?Func (null)
    // Control-flow bookkeeping
    did_return: bool (false)
    reported_unreachable: bool (false)
    must_return: bool (false)
    must_exit: bool (false)
    must_throw: bool (false)
    is_loop: bool (false)
    did_break: bool (false)
    loop_invalidated: Array[Decl] (.{})
    loop_trusted: Array[Decl] (.{})
    // Locals declared in this scope (order preserved for IR later)
    decls: Array[Decl] (.{})
    not_null: Array[Decl] (.{})
    not_null_removed: Array[Decl] (.{})
    vscope_returns: ?Array[Value] (null)
    vscope_rett: ?Type (null)

    static fn new(parent: ?Scope (null)) SELF {
        return SELF {
            parent: parent
        }
    }

    fn sub_scope() SELF {
        let s = SELF {
            parent: this
        }
        // Nested blocks inherit the owning function
        s.func = this.func
        return s
    }

    // Nearest enclosing value-scope (`<{...}`), if any.
    fn find_vscope() ?Scope {
        if isset(this.vscope_returns) : return this
        let p = this.parent
        if isset(p) : return p.find_vscope()
        return null
    }

    fn not_null_check(decl: Decl) bool {
        if this.not_null_removed.contains(decl) : return false
        if this.not_null.contains(decl) : return true
        let p = this.parent
        if isset(p) : return p.not_null_check(decl)
        return false
    }

    fn not_null_check_relied(decl: Decl) bool {
        return this.not_null_check_relied_from(decl, null)
    }

    fn not_null_check_relied_from(decl: Decl, loop: ?Scope) bool {
        if this.not_null_removed.contains(decl) : return false
        if this.not_null.contains(decl) {
            if isset(loop) : loop.loop_trusted.append(decl, true)
            return true
        }
        let p = this.parent
        if !isset(p) : return false
        let inner = loop
        if this.is_loop && !isset(inner) : inner = this
        return p.not_null_check_relied_from(decl, inner)
    }

    fn apply_issets(issets: ?Array[Decl]) {
        if !isset(issets) : return
        each issets as d {
            this.not_null_removed.remove_value(d)
            this.not_null.append(d, true)
        }
    }

    fn mark_not_null(decl: Decl) {
        this.not_null_removed.remove_value(decl)
        this.not_null.append(decl, true)
    }

    fn clear_not_null(decl: Decl) {
        this.not_null.remove_value(decl)
        if !this.not_null_removed.contains(decl) : this.not_null_removed.append(decl)
        this.record_loop_invalidation(decl)
    }

    fn record_loop_invalidation(decl: Decl) {
        if this.is_loop : this.loop_invalidated.append(decl, true)
        let p = this.parent
        if isset(p) : p.record_loop_invalidation(decl)
    }

    // Every caller declares a new Decl, so neither list can already hold it.
    fn add_decl(decl: Decl) {
        this.decls.append(decl)
        let f = this.func
        if isset(f) : f.all_decls.append(decl)
    }

    fn append_value(v: Value) {
        this.values.append(v)
    }

    // Ensure identifiers map exists and return it.
    fn idfs() Map[Idf] {
        let m = this.identifiers
        if isset(m) : return m
        let created = Map[Idf]{}
        this.identifiers = created
        return created
    }

    fn get_idf(name: String) ?Idf {
        let m = this.identifiers
        if isset(m) {
            m.get(name) -> idf : return idf
        }
        let parent = this.parent
        if isset(parent) : return parent.get_idf(name)
        return null
    }

    fn find_scope_idf(name: String) ?Idf {
        let m = this.identifiers
        if isset(m) {
            m.get(name) -> idf {
                if idf.type == IDF.scope : return idf
            }
        }
        let parent = this.parent
        if isset(parent) : return parent.find_scope_idf(name)
        return null
    }

    fn get_scope_idf(name: String) ?Idf {
        let idf = this.find_scope_idf(name)
        if !isset(idf) : return null
        let u = idf.from_use
        if isset(u) : u.is_used = true
        return idf
    }

    fn has_idf(name: String) bool {
        return isset(this.get_idf(name))
    }

    // True if this scope (not parents) already defines `name`.
    fn has_local(name: String) bool {
        let m = this.identifiers
        if isset(m) : return m.has(name)
        return false
    }

    // Set an identifier in this scope only (does not walk parents).
    fn set_idf(name: String, idf: Idf) {
        this.idfs().set(name, idf)
    }
}

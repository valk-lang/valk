class Scope {
    parent: ?Scope
    identifiers: ?Map[Idf]
    // Function-body AST: ordered list of Values (including if/while/let as void values)
    values: Array[Value] (.{})
    // Owning function when this is a func/body scope
    func: ?Func (null)
    // Control-flow bookkeeping
    did_return: bool (false)
    // Unreachable code in this block has already been reported. Everything after
    // the first dead statement is dead for the same reason, so one warning per
    // block says all there is to say.
    reported_unreachable: bool (false)
    must_return: bool (false)
    must_exit: bool (false)
    must_throw: bool (false)
    // Marks a scope whose body is a loop. Break/continue validation walks
    // these scopes, stopping at a nested function boundary.
    is_loop: bool (false)
    // A `break` inside this loop reached it. A loop that cannot end any other
    // way — `while true` — falls through only when this is set, which is what
    // tells the missing-return check whether the statement after it runs.
    did_break: bool (false)
    // Loop bodies only: decls invalidated anywhere inside, including in nested
    // scopes. Drives which facts survive the loop (see record_loop_invalidation).
    loop_invalidated: Array[Decl] (.{})
    // Loop bodies only: decls whose non-null fact the body relied on while the fact
    // was established *before* the loop. Such a fact only holds on the first
    // iteration, so a body that also invalidates the decl is rejected.
    loop_trusted: Array[Decl] (.{})
    // Locals declared in this scope (order preserved for IR later)
    decls: Array[Decl] (.{})
    // Decls known non-null in this scope (from `isset` / `&&` propagation).
    // Used by try_remove_nullable / try_convert to strip `?T` → `T`.
    not_null: Array[Decl] (.{})
    // Facts invalidated by assignments in this scope. This shadows an
    // inherited non-null fact from an enclosing scope.
    not_null_removed: Array[Decl] (.{})
    // Value scope (`<{...}`): when set, `return` targets this scope (not the function).
    // vscope_returns collects the emitted VAL.return statements — the same values IR
    // phis together — so a later branch can widen the result type by re-wrapping the
    // values already collected. rett is the unified result type.
    vscope_returns: ?Array[Value] (null)
    vscope_rett: ?Type (null)

    static fn new(parent: ?Scope (null)) SELF {
        return SELF {
            parent: parent
        }
    }

    fn sub_scope() SELF {
        let s = SELF {
            parent: this
        }
        // Nested blocks inherit the owning function
        s.func = this.func
        return s
    }

    // Nearest enclosing value-scope (`<{...}`), if any.
    fn find_vscope() ?Scope {
        if isset(this.vscope_returns) : return this
        let p = this.parent
        if isset(p) : return p.find_vscope()
        return null
    }

    // True if `decl` is known non-null in this scope or an ancestor. A plain query:
    // use it for bookkeeping, such as intersecting the facts of two branches.
    fn not_null_check(decl: Decl) bool {
        if this.not_null_removed.contains(decl) : return false
        if this.not_null.contains(decl) : return true
        let p = this.parent
        if isset(p) : return p.not_null_check(decl)
        return false
    }

    // not_null_check for the sites that *rely* on the fact to accept code that would
    // otherwise be rejected (stripping `?T` → `T`, proving a call argument). When the
    // fact is found beyond an enclosing loop body, that body is leaning on something
    // established before the loop, which only holds on the first iteration: record it
    // so the loop can reject a body that also invalidates the decl. A fact found
    // inside the loop (from its condition, or assigned in the body) is re-established
    // every iteration and needs no record.
    fn not_null_check_relied(decl: Decl) bool {
        return this.not_null_check_relied_from(decl, null)
    }

    fn not_null_check_relied_from(decl: Decl, loop: ?Scope) bool {
        if this.not_null_removed.contains(decl) : return false
        if this.not_null.contains(decl) {
            if isset(loop) : loop.loop_trusted.append(decl, true)
            return true
        }
        let p = this.parent
        if !isset(p) : return false
        let inner = loop
        if this.is_loop && !isset(inner) : inner = this
        return p.not_null_check_relied_from(decl, inner)
    }

    // Mark decls non-null in this scope (e.g. after isset / true branch of &&).
    // Establishing a fact also cancels an invalidation recorded earlier in this
    // scope: proving non-null again supersedes the assignment that cleared it.
    // Same reasoning as mark_not_null, which drops the record for a direct assign.
    fn apply_issets(issets: ?Array[Decl]) {
        if !isset(issets) : return
        each issets as d {
            this.not_null_removed.remove_value(d)
            this.not_null.append(d, true)
        }
    }

    fn mark_not_null(decl: Decl) {
        this.not_null_removed.remove_value(decl)
        this.not_null.append(decl, true)
    }

    fn clear_not_null(decl: Decl) {
        this.not_null.remove_value(decl)
        if !this.not_null_removed.contains(decl) : this.not_null_removed.append(decl)
        this.record_loop_invalidation(decl)
    }

    // Record on every enclosing loop body that `decl` was invalidated somewhere
    // inside it. Unlike not_null_removed this is sticky: `break` can leave the loop
    // while the declaration is null even when later code in the body re-establishes
    // the fact, so a loop must not keep a fact its body invalidated at any point.
    fn record_loop_invalidation(decl: Decl) {
        if this.is_loop : this.loop_invalidated.append(decl, true)
        let p = this.parent
        if isset(p) : p.record_loop_invalidation(decl)
    }

    fn add_decl(decl: Decl) {
        this.decls.append(decl)
        let f = this.func
        if isset(f) : f.all_decls.append(decl, true)
    }

    fn append_value(v: Value) {
        this.values.append(v)
    }

    // Ensure identifiers map exists and return it.
    fn idfs() Map[Idf] {
        let m = this.identifiers
        if isset(m) : return m
        let created = Map[Idf]{}
        this.identifiers = created
        return created
    }

    fn get_idf(name: String) ?Idf {
        let m = this.identifiers
        if isset(m) {
            m.get(name) -> idf : return idf
        }
        let parent = this.parent
        if isset(parent) : return parent.get_idf(name)
        return null
    }

    // Namespace-qualified syntax (`ns:name`) must keep looking past locals or
    // arguments named `ns`. The colon makes the namespace intent explicit.
    // Every IDF.scope comes from a `use`, and `ns:name` is the only syntax that
    // resolves one, so this is also where an import is recorded as referenced.
    fn get_scope_idf(name: String) ?Idf {
        let m = this.identifiers
        if isset(m) {
            m.get(name) -> idf {
                if idf.type == IDF.scope {
                    let u = idf.from_use
                    if isset(u) : u.is_used = true
                    return idf
                }
            }
        }
        let parent = this.parent
        if isset(parent) : return parent.get_scope_idf(name)
        return null
    }

    fn has_idf(name: String) bool {
        return isset(this.get_idf(name))
    }

    // True if this scope (not parents) already defines `name`.
    fn has_local(name: String) bool {
        let m = this.identifiers
        if isset(m) : return m.has(name)
        return false
    }

    // Set an identifier in this scope only (does not walk parents).
    fn set_idf(name: String, idf: Idf) {
        this.idfs().set(name, idf)
    }
}

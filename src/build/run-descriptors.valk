use valk.fs

#if OS != "win"
extern fn fcntl(fd: i32, action: i32, ...) i32;
extern fn getdtablesize() i32;
#end

// The program started for --run shares this process's standard streams and nothing
// else. Descriptors the compiler still holds (worker pipes, cache files) would otherwise
// count against the program's own limit: an HTTP server run this way hit "too many
// connections" hundreds of connections early. Newer standard libraries create their
// descriptors close-on-exec, but the compiler is built against the previous release.
fn close_descriptors_on_exec() {
    #if OS == "linux"
    // Names only: every entry is a descriptor number, whatever it points at
    let names = fs.files_in("/proc/self/fd", false, true, true, true) !? Array[String]{}
    each names as name {
        let fd = name.to_uint() !? 0
        if fd > 2 : fcntl(fd.to(i32), 2, 1)
    }
    #elif OS == "macos"
    let most = getdtablesize()
    let fd: i32 = 3
    while fd < most {
        fcntl(fd, 2, 1)
        fd++
    }
    #end
}

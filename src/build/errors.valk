
error InitError (init) payload { msg: String }
error Error (error)

enum MSG {
    error
    warning
}

class Message {
    type: int
    msg: String
    // Optional source location (set by Exp.error / Parser errors with a span)
    src: ?Source (null)
    i: u32 (0)
    len: u32 (0)

    // Print this message with optional file/line/col and a highlighted source snippet.
    fn print() {
        let is_err = this.type == MSG.error
        if is_err {
            println("# Build error")
        } else {
            println("# Warning")
        }
        println("-----------------------------")

        let src = this.src
        if isset(src) {
            // A span inside a `%{...}` interpolation is relative to the expression
            // text, not the file. Walk back to the file that contains it so the
            // line, column and snippet below all describe real source.
            let i = this.i
            let parent = src.parent
            while isset(parent) {
                i += src.parent_offset
                src = parent
                parent = src.parent
            }

            let path = src.path
            if isset(path) {
                println("# File: " + path)
            }

            let loc = message_line_col(src.content, i)
            println("# Line: " + loc.line + " | Col: " + loc.col)
            println("# Error: " + this.msg)
            println("-----------------------------")

            // Source line containing the span start
            let line_text = src.content.part(loc.line_start, loc.line_len)
            // Drop trailing newline so underline aligns cleanly
            if line_text.ends_with("\n") {
                line_text = line_text.part(0, line_text.bytes - 1)
            }
            if line_text.ends_with("\r") {
                line_text = line_text.part(0, line_text.bytes - 1)
            }
            println(line_text)

            // Underline the Message span within this line
            let span_start = i
            if span_start < loc.line_start : span_start = loc.line_start
            let col0 = span_start - loc.line_start // 0-based offset on the line
            let mark_len = this.len
            if mark_len == 0 : mark_len = 1
            // Clamp mark to end of line text
            let line_bytes = line_text.bytes.to(u32)
            if col0 > line_bytes : col0 = line_bytes
            if col0 + mark_len > line_bytes {
                if col0 < line_bytes : mark_len = line_bytes - col0
                else : mark_len = 1
            }

            let pad = ""
            let k: u32 = 0
            while k < col0 {
                // Prefer spaces; keep tabs so columns roughly match
                let ch = line_text.get(k.to(uint))
                if ch == '\t' : pad = pad + "\t"
                else : pad = pad + " "
                k++
            }
            let carets = ""
            k = 0
            while k < mark_len {
                carets = carets + "^"
                k++
            }
            println(pad + carets)
        } else {
            println(this.msg)
        }

        println("-----------------------------")
    }
}

// Line/column (1-based) and line span for byte index `i` in `content`.
class LineCol {
    line: u32
    col: u32
    line_start: u32
    line_len: u32
}

fn message_line_col(content: String, i: u32) LineCol {
    let data = content.data
    let bytes = content.bytes
    let idx = i.to(uint)
    if idx > bytes : idx = bytes

    let line: u32 = 1
    let col: u32 = 1
    let line_start: u32 = 0
    let p: uint = 0
    while p < idx {
        let ch = @ptrv(data, u8, p)
        p++
        if ch == '\n' {
            line++
            col = 1
            line_start = p.to(u32)
        } else {
            col++
        }
    }

    // Extend to end of line (or EOF)
    let line_end = idx
    while line_end < bytes {
        let ch = @ptrv(data, u8, line_end)
        if ch == '\n' : break
        line_end++
    }
    let line_len = (line_end - line_start.to(uint)).to(u32)

    return LineCol {
        line: line
        col: col
        line_start: line_start
        line_len: line_len
    }
}

fn init_error(msg: String) !InitError $throw {
    throw .init { msg: msg }
}

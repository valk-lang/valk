
use helper
use valk.fs
error InitError (init) payload { msg: String }
error Error (error)

enum MSG {
    error
    warning
}

// A secondary span with its own explanation, shown after the primary span.
class MessageLabel {
    src: Source
    i: u32
    len: u32
    text: String
}

// A suggested edit: replace the span with `replacement` (empty = remove it).
class MessageFix {
    src: Source
    i: u32
    len: u32
    replacement: String
    text: String
}

// One diagnostic. Created through `exp.message(...)` / `build.message(...)`,
// extended with labels, notes and fixes, then reported with `error()` or
// `warn()`. `exp.error(msg)` is the short form for a plain error.
class Message {
    build: Build
    type: MSG
    msg: String
    // Optional primary source span
    src: ?Source (null)
    i: u32 (0)
    len: u32 (0)
    // Stable identifier for tooling, e.g. "unused-import". Empty when unassigned.
    code: String ("")
    // Raised by the tokenizer or parser rather than by type checking
    syntax: bool (false)
    labels: Array[MessageLabel] (.{})
    notes: Array[String] (.{})
    fixes: Array[MessageFix] (.{})

    fn with_code(code: String) SELF {
        this.code = code
        return this
    }

    fn label(at: Exp, text: String) SELF {
        this.labels.append(MessageLabel { src: at.src, i: at.i, len: at.len, text: text })
        return this
    }

    fn note(text: String) SELF {
        this.notes.append(text)
        return this
    }

    // Suggest replacing the span of `at` with `replacement`.
    fn suggest(at: Exp, replacement: String, text: String) SELF {
        this.fixes.append(MessageFix { src: at.src, i: at.i, len: at.len, replacement: replacement, text: text })
        return this
    }

    // Suggest removing `at`. When it is the only thing on its line, the whole
    // line goes, so the edit leaves no blank line behind.
    fn suggest_removal(at: Exp, text: String) SELF {
        let from = at.i
        let until = at.i + at.len
        let content = at.src.content
        let bytes = content.bytes.to(u32)
        let line_start = from
        while line_start > 0 && content.get((line_start - 1).to(uint)) != '\n' : line_start--
        let line_end = until
        while line_end < bytes && content.get(line_end.to(uint)) != '\n' : line_end++
        let only_thing = content.range(line_start.to(uint), (from - line_start).to(uint)).trim(" \t").is_empty()
            && content.range(until.to(uint), (line_end - until).to(uint)).trim(" \t\r").is_empty()
        if only_thing {
            from = line_start
            until = line_end < bytes ? line_end + 1 : line_end
        }
        this.fixes.append(MessageFix { src: at.src, i: from, len: until - from, replacement: "", text: text })
        return this
    }

    fn error() !Error $throw {
        this.type = MSG.error
        this.build.has_errors = true
        this.build.report(this)
        throw .error
    }

    // Warnings are reported once per message and span
    fn warn() {
        this.type = MSG.warning
        let src = this.src
        if isset(src) {
            let key = this.msg + "@" + src.id + ":" + this.i
            if this.build.warned_spans.has(key) : return
            this.build.warned_spans.set(key, true)
        }
        this.build.report(this)
    }

    fn print() {
        let is_err = this.type == MSG.error
        if !is_err {
            this.print_line()
            return
        }
        println("# Build error")
        println("-----------------------------")

        let msg_src = this.src
        if isset(msg_src) {
            let at = message_resolve(msg_src, this.i)
            let path = at.src.path
            if isset(path) : println("# File: " + path)
            let loc = at.src.line_col(at.i)
            println("# Line: " + loc.line + " | Col: " + loc.col)
            println("# Error: " + this.msg)
            if !this.code.is_empty() : println("# Code: " + this.code)
            println("-----------------------------")
            message_print_snippet(at.src, at.i, this.len)
        } else {
            println(this.msg)
            if !this.code.is_empty() : println("# Code: " + this.code)
        }
        println("-----------------------------")

        each this.labels as label {
            let at = message_resolve(label.src, label.i)
            let loc = at.src.line_col(at.i)
            let where = at.src.path ?? "source"
            println("# Note: " + label.text)
            println("# At: " + where + ":" + loc.line + ":" + loc.col)
            message_print_snippet(at.src, at.i, label.len)
            println("-----------------------------")
        }
        each this.notes as text {
            println("# Note: " + text)
        }
        each this.fixes as fix {
            println("# Help: " + fix.text + " " + message_fix_display(fix))
        }
        if this.notes.length > 0 || this.fixes.length > 0 {
            println("-----------------------------")
        }
    }

    fn print_line() {
        let at = this.msg
        let msg_src = this.src
        if isset(msg_src) {
            let pos = message_resolve(msg_src, this.i)
            let loc = pos.src.line_col(pos.i)
            let path = pos.src.path
            if isset(path) : at += " @ " + path + ":" + loc.line + ":" + loc.col
            else : at += " @ line " + loc.line + ":" + loc.col
        }
        helper.msg("⚠️", at)
    }
}

// The edit of a fix as text: `(remove 'x')` or `(replace 'x' with 'y')`.
fn message_fix_display(fix: MessageFix) String {
    let at = message_resolve(fix.src, fix.i)
    let current = at.src.content.range(at.i.to(uint), fix.len.to(uint)).trim(" \t\r\n")
    if fix.replacement.is_empty() : return "(remove '" + current + "')"
    return "(replace '" + current + "' with '" + fix.replacement + "')"
}

// Print the source line holding `i` with the span underlined.
fn message_print_snippet(src: Source, i: u32, len: u32) {
    let loc = src.line_col(i)
    let line_text = src.content.range(loc.line_start, loc.line_len)
    if line_text.ends_with("\n") : line_text = line_text.range(0, line_text.bytes - 1)
    if line_text.ends_with("\r") : line_text = line_text.range(0, line_text.bytes - 1)
    println(line_text)

    let span_start = i
    if span_start < loc.line_start : span_start = loc.line_start
    let col0 = span_start - loc.line_start
    let mark_len = len
    if mark_len == 0 : mark_len = 1
    let line_bytes = line_text.bytes.to(u32)
    if col0 > line_bytes : col0 = line_bytes
    if col0 + mark_len > line_bytes {
        if col0 < line_bytes : mark_len = line_bytes - col0
        else : mark_len = 1
    }

    let pad = ""
    let k: u32 = 0
    while k < col0 {
        // Prefer spaces; keep tabs so columns roughly match
        let ch = line_text.get(k.to(uint))
        if ch == '\t' : pad = pad + "\t"
        else : pad = pad + " "
        k++
    }
    let carets = ""
    k = 0
    while k < mark_len {
        carets = carets + "^"
        k++
    }
    println(pad + carets)
}

class MessagePos {
    src: Source
    i: u32
}

fn message_resolve(src: Source, i: u32) MessagePos {
    let parent = src.parent
    while isset(parent) {
        i += src.parent_offset
        src = parent
        parent = src.parent
    }
    return MessagePos {
        src: src
        i: i
    }
}

// Line/column (1-based) and line span for a byte index in a Source (see Source.line_col).
class LineCol {
    line: u32
    col: u32
    line_start: u32
    line_len: u32
}

fn init_error(msg: String) !InitError $throw {
    throw .init { msg: msg }
}

// Source position for a runtime panic message: "path:line", with the path
// relative to the root of the package the source belongs to. A dependency
// names its package, since its files are outside the program being built.
fn panic_location(src: Source, i: u32) String {
    let origin = message_resolve(src, i)
    let path = origin.src.path ?! return ""
    let line = origin.src.line_of(origin.i)
    let ns = origin.src.ns
    let pkg = isset(ns) ? ns.pkg : origin.src.build.main_pkg
    let dir = isset(pkg) ? pkg.dir : null
    let display = path
    if isset(dir) && path.starts_with(dir + fs.PATH_DIV) {
        display = path.range(dir.length + 1, path.length - dir.length - 1)
    } else {
        let cwd = fs.cwd() !? ""
        if cwd.length > 0 && path.starts_with(cwd + fs.PATH_DIV) {
            display = path.range(cwd.length + 1, path.length - cwd.length - 1)
        }
    }
    // One display form on every platform
    display = display.replace("\\", "/")
    let result = display + ":" + line
    if isset(pkg) && isset(dir) && pkg.name != "main" : result = result + " in package " + pkg.name
    return result
}

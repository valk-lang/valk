
class FmtTok {
    // TOK.*, as returned by Parser.tok.
    type: TOK
    // Raw source slice, so strings, chars and numbers are echoed exactly.
    text: String
    // Newlines between the previous token and this one.
    new_lines: u32
    spaced: bool
    // A word that can act as a keyword: not a member name after `.`, not an
    // enum member. Cleared while rendering when the scope says otherwise.
    keyword: bool (false)
}

// What the formatter knows about the statement being written. A statement
// spans continuation lines and any `(`/`[` opened on it; a `{` starts a new
// one for its body and the outer statement resumes after the `}`.
class FmtStmt {
    first: ?FmtTok (null)
    // opens.length when the statement started.
    depth: uint (0)
    // Indent of the statement's first line.
    indent: uint (0)
    // Open `?` operators waiting for their `:`.
    ternary: uint (0)
    has_match: bool (false)
    has_union: bool (false)
    // A `->` success handler or `! {` error handler: its `:` body colon is spaced.
    has_handler: bool (false)
    // A declaration's `name: Type` colon at the statement's own depth.
    has_type_colon: bool (false)
    // `fn name` seen: the next `(` opens the argument list.
    fn_wait_args: bool (false)
    // opens.length while inside a function declaration's argument list.
    fn_args_depth: uint (0)
    // The argument list just closed: the next token starts the return type.
    fn_return_pending: bool (false)
    is_fn_decl: bool (false)
}

// No `: u8` base: the 0.6.0 bootstrap compiler treats an enum stored as u8 as
// u8 itself when it specializes `Slice[T]`, and then rejects `Array[FMT_SCOPE]`.
enum FMT_SCOPE {
    root
    block
    paren
    bracket
    function
    test
    class
    interface
    struct
    array
    slice
    unbound
    pointer
    integer
    float
    boolean
    mode
    union
    enum
    trait
    extend
    error
    value
    alias
    type
    global
    shared
    at_shared
    link
    use
}

fn format_tokens(src: Source) String !Error {
    let toks = fmt_tokenize(src) !>
    let out = format_align_comments(fmt_render(toks))
    fmt_verify(src, toks, out) !>
    return out
}

fn fmt_tokenize(src: Source) Array[FmtTok] !Error {
    let p = src.start().init_parser()
    let toks = Array[FmtTok]{}
    let prev_end: u32 = 0
    let prev_text = ""
    while true {
        let t = p.tok(true, true) !>
        if t == TOK.end : break
        let start = p.word_i
        let len = p.word_len
        let text = src.content.part(start, len)
        toks.append(FmtTok {
            type: t
            text: text
            new_lines: p.new_lines
            spaced: toks.length > 0 && start > prev_end
            keyword: (t == TOK.word || t == TOK.at_word) && prev_text != "."
        })
        prev_end = start + len
        if t != TOK.comment : prev_text = text
    }
    return toks
}

// The formatter may only move whitespace. Re-tokenize its output and refuse
// anything that changed a token, so a formatter bug can never damage a file.
fn fmt_verify(src: Source, toks: Array[FmtTok], out: String) !Error {
    let check = Source {
        build: src.build
        content: out
        path: src.path
    }
    let again = fmt_tokenize(check) ! src.build.error("Formatter produced unreadable output for: " + (src.path ?? "source"))
    let mismatch = again.length != toks.length
    if !mismatch {
        each toks as tok, i {
            let other = again.get(i) ! break
            // Comments only lose trailing whitespace and carriage returns
            let same = other.type == tok.type && (other.text == tok.text
                || (tok.type == TOK.comment && other.text == fmt_comment_text(tok.text)))
            if !same {
                mismatch = true
                break
            }
        }
    }
    if mismatch : src.build.error("Formatter changed the code of: " + (src.path ?? "source") + " (bug, file left untouched)")
}

fn fmt_render(toks: Array[FmtTok]) String {
    let out = ByteBuffer.new()
    let opens = Array[uint]{}
    let scopes = Array[FMT_SCOPE]{}
    let stmts = Array[FmtStmt]{}
    let stmt = FmtStmt {}
    // Indent level of the line being written.
    let indent: uint = 0
    let index: uint = 0
    let count = toks.length
    let prev: ?FmtTok = null
    let prev_infix_sign = false
    let prev_tight_sign = false
    let prev_code: ?FmtTok = null
    let before_prev_code: ?FmtTok = null
    let callable_wait_args: uint = 0
    let callable_wait_results: uint = 0
    let callable_args_depths = Array[uint]{}
    let callable_result_depths = Array[uint]{}
    let macro_indents = Array[uint]{}
    let declaration_scope = FMT_SCOPE.root

    while index < count {
        let tok = toks.get(index) ! break
        let next: ?FmtTok = null
        if index + 1 < count : next = toks.get(index + 1) !? null
        index++
        let callable_return_pending = callable_wait_results > 0
            && tok.type != TOK.comment
            && tok.text != "("
            && tok.text != "!"
            && tok.text != "/"
            && tok.text != ":"
            && tok.text != "{"
        if callable_wait_results > 0 && tok.type != TOK.comment && tok.text != "(" {
            callable_wait_results = 0
        }

        let closer = fmt_is_closer(tok)
        let pv = prev
        let pc = prev_code
        let bpc = before_prev_code
        let infix_sign = false
        let scope = FMT_SCOPE.root
        if scopes.length > 0 : scope = scopes.get(scopes.length - 1) !? FMT_SCOPE.root
        // Enum members are names, whatever they are called.
        if scope == FMT_SCOPE.enum && tok.new_lines > 0 : tok.keyword = false
        let return_pending = stmt.fn_return_pending || callable_return_pending
        let callable_error = tok.text == "!" && callable_result_depths.length > 0
        let macro_word = ""
        if tok.text == "#" && isset(next) && next.new_lines == 0 : macro_word = next.text
        let macro_opener = macro_word == "if" || macro_word == "loop"
        let macro_closer = macro_word == "end"
        let macro_leading_comment = tok.type == TOK.comment && fmt_next_starts_macro(toks, index)
        if isset(pc) {
            infix_sign = fmt_is_positional_infix(tok, pc, return_pending)
        }
        let tight_sign = callable_error || fmt_is_tight_sign(tok, pv, infix_sign)
        let access_declaration = fmt_starts_access_declaration(toks, index - 1)
        let tight_left = false
        if isset(pv) {
            let fn_arg_default = stmt.fn_args_depth > 0 && opens.length == stmt.fn_args_depth
            tight_left = fmt_is_tight_left(pv, tok, stmt, scope, declaration_scope,
                callable_wait_args, callable_wait_results, return_pending, fn_arg_default)
        }

        let nl = tok.new_lines
        if !isset(pv) {
            if nl > 1 : nl = 1
        } else {
            if nl > 2 : nl = 2
            // A blank line against the edge of a block reads as an accident.
            if nl > 1 && fmt_is_opener(pv) : nl = 1
            if nl > 1 && closer : nl = 1
            if isset(pc) {
                if nl > 1 && pc.text == ":" : nl = 1
            }
        }

        if nl > 0 || !isset(pv) {
            if closer && opens.length > 0 {
                indent = opens.pop_last() !? 0
                scopes.pop_last() !? FMT_SCOPE.root
                if tok.text == "}" && stmts.length > 0 : stmt = stmts.pop_last() !? stmt
            } else {
                indent = 0
                if opens.length > 0 : indent = (opens.get(opens.length - 1) !? 0) + 1
                let continuation = false
                // Inside `(`/`[` the bracket already indents the line.
                if isset(pc) && opens.length == stmt.depth {
                    if fmt_is_continuation(pc, tok, scope)
                        || fmt_is_sign_continuation(tok, pc, scope, stmt.ternary > 0, infix_sign, tight_sign, access_declaration) : continuation = true
                }
                if continuation : indent++
                if (macro_opener || macro_leading_comment)
                    && isset(pc) && fmt_macro_needs_continuation(pc, bpc) : indent++
                if macro_indents.length > 0 {
                    let macro_indent = macro_indents.get(macro_indents.length - 1) !? 0
                    if indent < macro_indent : indent = macro_indent
                }
                // A code line at the statement's own level starts a new one.
                // Comment lines and macro lines leave it alone.
                if !continuation && tok.type != TOK.comment && opens.length <= stmt.depth {
                    stmt = FmtStmt { first: tok, depth: opens.length, indent: indent }
                }
            }
            let n = nl
            while n-- > 0 : out.write_byte('\n')
            let d = indent
            while d-- > 0 : out.append_text("    ")
        } else {
            if closer && opens.length > 0 {
                opens.pop_last() !? 0
                scopes.pop_last() !? FMT_SCOPE.root
                if tok.text == "}" && stmts.length > 0 : stmt = stmts.pop_last() !? stmt
            }
            if isset(pv) {
                let own = opens.length == stmt.depth
                let fn_arg_default = (stmt.fn_args_depth > 0 && opens.length == stmt.fn_args_depth)
                    || (fmt_scope_has_access(scope) && own && stmt.has_type_colon && !stmt.is_fn_decl)
                if fmt_space_between(pv, tok, stmt, own, scope, return_pending, callable_error, infix_sign, prev_infix_sign, prev_tight_sign, tight_left, fn_arg_default) : out.write_byte(' ')
            }
        }
        if !isset(stmt.first) && tok.type != TOK.comment : stmt.first = tok

        out.append_text(tok.type == TOK.comment ? fmt_comment_text(tok.text) : tok.text)

        if macro_opener {
            macro_indents.append(indent)
        } else if macro_closer && macro_indents.length > 0 {
            macro_indents.pop_last() !? 0
        }

        if fmt_is_opener(tok) {
            let opened_scope = FMT_SCOPE.block
            let pushed = indent
            if tok.text == "(" {
                opened_scope = fmt_paren_scope(declaration_scope)
                if declaration_scope != FMT_SCOPE.function : declaration_scope = FMT_SCOPE.root
            } else if tok.text == "[" {
                opened_scope = FMT_SCOPE.bracket
            } else {
                if fmt_scope_has_body(declaration_scope) : opened_scope = declaration_scope
                declaration_scope = FMT_SCOPE.root
                // The body of `if a\n && b {` belongs to the `if`, not to the
                // continuation line that happened to hold the brace.
                if indent > stmt.indent && fmt_stmt_owns_block(stmt) : pushed = stmt.indent
            }
            opens.append(pushed)
            scopes.append(opened_scope)
            if tok.text == "(" && stmt.fn_wait_args {
                stmt.fn_args_depth = opens.length
                stmt.fn_wait_args = false
            } else if tok.text == "(" && callable_wait_args > 0 {
                callable_args_depths.append(opens.length)
                callable_wait_args--
            } else if tok.text == "(" && callable_wait_results > 0 {
                callable_result_depths.append(opens.length)
                callable_wait_results--
            }
            if tok.text != "(" && tok.text != "[" {
                stmts.append(stmt)
                stmt = FmtStmt { depth: opens.length, indent: pushed + 1 }
            }
        }
        if tok.text == "?" && isset(pc) && fmt_ends_operand(pc) && !return_pending {
            if infix_sign || tok.spaced : stmt.ternary++
        } else if tok.text == ":" && stmt.ternary > 0 {
            stmt.ternary--
        }
        if tok.text == "match" && tok.keyword : stmt.has_match = true
        if tok.text == "union" && tok.keyword : stmt.has_union = true
        if tok.text == "->" : stmt.has_handler = true
        if tok.text == "!" && isset(next) && next.text == "{" && next.new_lines == 0 : stmt.has_handler = true
        if tok.text == ":" && stmt.ternary == 0 && opens.length == stmt.depth : stmt.has_type_colon = true
        let declared_scope = fmt_declared_scope(tok, stmt, scope)
        if declared_scope != FMT_SCOPE.root : declaration_scope = declared_scope
        if tok.text == "fn" && tok.keyword {
            if isset(next) && next.type == TOK.word {
                stmt.fn_wait_args = true
                stmt.is_fn_decl = true
            } else if isset(next) && next.text == "(" : callable_wait_args++
        }
        if tok.text == "fnptr" && isset(next) && next.text == "(" : callable_wait_args++
        if tok.text == "co" && isset(next) && next.text == "(" : callable_wait_results++

        prev_infix_sign = infix_sign
        prev_tight_sign = tight_sign
        if return_pending : stmt.fn_return_pending = false
        if tok.text == ")" && stmt.fn_args_depth > 0 && opens.length < stmt.fn_args_depth {
            stmt.fn_args_depth = 0
            stmt.fn_return_pending = true
        }
        if tok.text == ")" && callable_result_depths.length > 0 {
            let depth = callable_result_depths.get(callable_result_depths.length - 1) !? 0
            if opens.length < depth : callable_result_depths.pop_last() !? 0
        } else if tok.text == ")" && callable_args_depths.length > 0 {
            let depth = callable_args_depths.get(callable_args_depths.length - 1) !? 0
            if opens.length < depth {
                callable_args_depths.pop_last() !? 0
                callable_wait_results++
            }
        }
        if tok.text == ";" {
            declaration_scope = FMT_SCOPE.root
            stmt = FmtStmt { depth: stmt.depth, indent: stmt.indent }
        }
        prev = tok
        if tok.type != TOK.comment {
            before_prev_code = prev_code
            prev_code = tok
        }
    }

    out.write_byte('\n')
    return out.to_string()
}

// Statements whose `{` body is indented from the statement, not from the
// line that holds the brace.
fn fmt_comment_text(text: String) String {
    return text.rtrim(" ").rtrim("\t").rtrim("\r").rtrim(" ").rtrim("\t")
}

fn fmt_stmt_owns_block(stmt: FmtStmt) bool {
    if stmt.is_fn_decl : return true
    // A `! { }` handler body belongs to the statement, wherever its call ends
    if stmt.has_handler : return true
    let first = stmt.first ?! return false
    let w = first.text
    if fmt_is_access_sign(w) : return true
    if w == "static" || w == "extern" || w == "export" || w == "#" : return true
    if !first.keyword : return false
    if w == "if" || w == "else" || w == "while" || w == "each" || w == "match" : return true
    if w == "test" || w == "synctest" : return true
    return fmt_is_declaration_word(w)
}

fn fmt_is_continuation(prev_code: FmtTok, tok: FmtTok, scope: FMT_SCOPE) bool {
    if fmt_is_binary(tok.text) {
        // A leading `+` at the top level or in a class body declares a public member.
        if tok.text != "+" : return true
        if !fmt_scope_has_access(scope) && scope != FMT_SCOPE.root : return true
    }
    if tok.text == "." : return true
    let w = prev_code.text
    // The single-statement body of `if x :`, written on the line below.
    if w == ":" : return true
    // A condition split off from the keyword it belongs to.
    if prev_code.keyword && (w == "if" || w == "while" || w == "each") : return true
    return false
}

fn fmt_macro_needs_continuation(prev_code: FmtTok, before_prev: ?FmtTok) bool {
    if fmt_is_binary(prev_code.text) : return true
    // `return` may be the complete single-statement body of a control clause.
    if prev_code.text == "return" && isset(before_prev) && before_prev.text == ":" : return false
    return fmt_is_prefix_keyword(prev_code)
}

fn fmt_next_starts_macro(toks: Array[FmtTok], at: uint) bool {
    let i = at
    while i < toks.length {
        let tok = toks.get(i) ! return false
        if tok.type == TOK.comment {
            i++
            continue
        }
        if tok.text != "#" || i + 1 >= toks.length : return false
        let word = toks.get(i + 1) ! return false
        if word.new_lines > 0 : return false
        return word.text == "if" || word.text == "loop"
    }
    return false
}

fn fmt_is_sign_continuation(tok: FmtTok, prev_code: FmtTok, scope: FMT_SCOPE, ternary: bool, infix: bool, tight: bool, access_declaration: bool) bool {
    if fmt_scope_has_access(scope) && fmt_is_access_sign(tok.text) : return false
    if tok.text == ":" && ternary : return true
    if access_declaration && scope == FMT_SCOPE.root : return false
    if infix : return true
    if !tight : return false
    if fmt_is_binary(prev_code.text) : return true
    if fmt_is_prefix_keyword(prev_code) : return true
    return false
}

fn fmt_space_between(prev: FmtTok, tok: FmtTok, stmt: FmtStmt, own: bool, scope: FMT_SCOPE, fn_return_pending: bool, callable_error: bool, infix_sign: bool, prev_infix_sign: bool, prev_tight_sign: bool, tight_left: bool, fn_arg_default: bool) bool {
    let t = tok.text
    let p = prev.text

    if tok.type == TOK.comment : return true

    // Parentheses and square brackets are tight. Non-empty braces are padded.
    if t == "," : return false
    if t == ")" || t == "]" : return false
    if t == "}" : return p != "{" && p != "<{"
    if p == "(" || p == "[" : return false
    if p == "{" || p == "<{" : return true
    // `&mut [T]`: the qualifier is a word, the slice bracket is not an index
    if t == "[" && p == "mut" && prev.keyword : return true
    if tight_left : return false
    if t == "(" && fmt_paren_prefix_wants_space(prev) : return true
    // An argument default: `name: Type (value)`.
    if t == "(" && fn_arg_default && fmt_ends_operand(prev) && !fmt_is_type_call_word(prev) : return true

    if p == "." : return false
    if t == "." {
        if fmt_is_binary(p) || fmt_is_prefix_keyword(prev) : return true
        return tok.spaced
    }

    if p == "," : return true

    let scope_space = fmt_scope_space_between(scope, prev, tok, stmt.first)
    if isset(scope_space) : return scope_space

    if !tok.spaced && (p == "-" || p == "~") && (t == "~" || t == "+") : return false

    if t == "{" {
        if p == "]" : return tok.spaced
        return true
    }

    if t == ":" {
        if stmt.ternary > 0 : return true
        if !own : return false
        return fmt_colon_wants_space(stmt)
    }
    if p == ":" {
        return true
    }

    if fn_return_pending && fmt_starts_return_type(tok) : return true
    if callable_error : return true

    if fmt_is_binary(t) : return true
    if fmt_is_binary(p) : return true

    if infix_sign : return true
    if prev_infix_sign : return true
    if fmt_is_prefix_keyword(prev) && fmt_is_prefix_sign_text(t) : return true
    if fmt_is_control_keyword(prev) && fmt_is_prefix_sign_text(t) : return true
    if fmt_is_type_prefix_keyword(prev) && fmt_is_prefix_sign_text(t) : return true
    if t == "++" || t == "--" : return false
    if prev_tight_sign : return false

    // A sign the language reads by its spacing. Keep what was written.
    return tok.spaced
}

// Types written as a call: `nonnull(?T)`, `typeof(x)`, `fn(int)(bool)`.
fn fmt_is_type_call_word(tok: FmtTok) bool {
    if !tok.keyword : return false
    let w = tok.text
    return w == "nonnull" || w == "typeof" || w == "fn" || w == "fnptr" || w == "co"
}

fn fmt_starts_return_type(tok: FmtTok) bool {
    let t = tok.text
    if tok.type == TOK.word : return true
    return t == "?" || t == "*" || t == "&" || t == "[" || t == "(" || t == "!"
}

fn fmt_is_tight_left(prev: FmtTok, tok: FmtTok, stmt: FmtStmt, scope: FMT_SCOPE, declaration_scope: FMT_SCOPE, callable_wait_args: uint, callable_wait_results: uint, fn_return_pending: bool, fn_arg_default: bool) bool {
    let t = tok.text
    let p = prev.text

    if t == ";" || p == "#" : return true

    let first = stmt.first
    if isset(first) && fmt_is_access_sign(first.text)
        && fmt_is_access_sign(p) && fmt_is_access_sign(t) : return true

    if t == "." {
        return fmt_ends_operand(prev) && !fmt_is_prefix_keyword(prev)
    }

    if t == "[" {
        if fn_return_pending : return false
        if p == "array" || p == "slice" : return true
        // `stack [T x N]` is a type prefix; `stack[0]` an index. Written spacing decides.
        if p == "stack" && prev.keyword : return false
        return fmt_ends_operand(prev) && !fmt_is_prefix_keyword(prev)
    }

    if t != "(" : return false
    if fn_return_pending : return false
    if stmt.fn_wait_args || callable_wait_args > 0 || callable_wait_results > 0 : return true
    if fn_arg_default : return false
    if !fmt_ends_operand(prev) || fmt_paren_prefix_wants_space(prev) : return false
    if declaration_scope != FMT_SCOPE.root && declaration_scope != FMT_SCOPE.function : return false
    if scope == FMT_SCOPE.enum && isset(first) && first.text == p : return false
    if fmt_scope_has_access(scope) : return false
    return true
}

fn fmt_starts_access_declaration(toks: Array[FmtTok], at: uint) bool {
    let first = toks.get(at) ! return false
    if !fmt_is_access_sign(first.text) : return false
    let i = at + 1
    while i < toks.length {
        let tok = toks.get(i) ! return false
        if tok.new_lines > 0 || tok.type == TOK.comment : return false
        let t = tok.text
        if fmt_is_access_sign(t) || t == "static" || t == "extern" || t == "export" {
            i++
            continue
        }
        return fmt_is_declaration_word(t)
    }
    return false
}

fn fmt_is_declaration_word(t: String) bool {
    return t == "fn" || t == "class" || t == "interface" || t == "struct"
        || t == "array" || t == "slice" || t == "unbound" || t == "pointer"
        || t == "integer" || t == "float" || t == "boolean" || t == "mode"
        || t == "union" || t == "enum" || t == "trait" || t == "extend"
        || t == "error" || t == "value" || t == "alias" || t == "type"
        || t == "global" || t == "shared" || t == "@shared" || t == "link"
        || t == "use"
}

fn fmt_paren_prefix_wants_space(prev: FmtTok) bool {
    if !prev.keyword : return false
    let t = prev.text
    return t == "if" || t == "while" || t == "each" || t == "match"
        || t == "return" || t == "throw" || t == "await" || t == "co"
        || t == "defer" || t == "else"
}

fn fmt_colon_wants_space(stmt: FmtStmt) bool {
    if stmt.ternary > 0 : return true
    if stmt.has_match : return true
    if stmt.has_handler : return true
    let first = stmt.first ?! return false
    let w = first.text
    if w == "}" : return true
    if !first.keyword : return false
    if w == "match" : return true
    // The single-statement body of a control structure: `if x : return`.
    if w == "if" || w == "while" || w == "each" || w == "else" || w == "lock" : return true
    return false
}

fn fmt_is_prefix_keyword(t: FmtTok) bool {
    if !t.keyword : return false
    let w = t.text
    return w == "return" || w == "throw" || w == "await" || w == "co"
}

// Keywords that qualify the type after them: `shared ?T`, `extend &[T]`
fn fmt_is_type_prefix_keyword(t: FmtTok) bool {
    if !t.keyword : return false
    let w = t.text
    return w == "shared" || w == "locked" || w == "stack" || w == "extend"
}

// Keywords followed by a condition or subject: what comes next starts an expression
fn fmt_is_control_keyword(t: FmtTok) bool {
    if !t.keyword : return false
    let w = t.text
    return w == "if" || w == "while" || w == "each" || w == "match" || w == "lock" || w == "else"
}

fn fmt_is_prefix_sign_text(t: String) bool {
    return t == "-" || t == "!" || t == "~" || t == "?" || t == "&" || t == "*" || t == "<" || t == ">" || t == "++" || t == "--"
}

fn fmt_is_positional_infix(tok: FmtTok, prev: FmtTok, fn_return_pending: bool) bool {
    let t = tok.text
    if !fmt_ends_operand(prev) : return false
    // Prefix keywords introduce a new expression, so operators after them
    // are unary prefix (tight), not binary infix (spaced).
    if fmt_is_prefix_keyword(prev) || fmt_is_control_keyword(prev) || fmt_is_type_prefix_keyword(prev) : return false
    if fn_return_pending && prev.text == ")" && (t == "?" || t == "&" || t == "*" || t == "<") : return false
    return t == "-" || t == "<" || t == ">" || t == "?" || t == "&" || t == "*"
}

fn fmt_is_tight_sign(tok: FmtTok, prev: ?FmtTok, infix: bool) bool {
    let t = tok.text
    if t == "++" || t == "--" : return true
    if infix : return false
    if t != "-" && t != "!" && t != "~" && t != "?" && t != "&" && t != "*" && t != "<" && t != ">" : return false
    if t == "!" && isset(prev) && fmt_ends_operand(prev) : return false
    if t == "?" && tok.spaced && isset(prev) && fmt_ends_operand(prev) : return false
    if tok.new_lines > 0 || !isset(prev) : return true
    if t == "~" && !tok.spaced && prev.text == "-" : return false
    return true
}

fn fmt_declared_scope(tok: FmtTok, stmt: FmtStmt, scope: FMT_SCOPE) FMT_SCOPE {
    if !tok.keyword : return FMT_SCOPE.root
    let t = tok.text
    if t == "fn" : return FMT_SCOPE.function
    if t == "get" && fmt_scope_has_access(scope) : return FMT_SCOPE.function
    // A `group name { ... }` body holds members like the class around it.
    if t == "group" && fmt_scope_has_access(scope) : return scope
    if t == "payload" : return FMT_SCOPE.error

    let first = stmt.first ?! return FMT_SCOPE.root
    if first != tok {
        // `- class Name {` and `static fn` still declare; `x.type` does not.
        if !fmt_is_access_sign(first.text) && first.text != "static"
            && first.text != "extern" && first.text != "export" : return FMT_SCOPE.root
    }
    if t == "test" || t == "synctest" : return FMT_SCOPE.test
    if t == "class" : return FMT_SCOPE.class
    if t == "interface" : return FMT_SCOPE.interface
    if t == "struct" : return FMT_SCOPE.struct
    if t == "array" : return FMT_SCOPE.array
    if t == "slice" : return FMT_SCOPE.slice
    if t == "unbound" : return FMT_SCOPE.unbound
    if t == "pointer" : return FMT_SCOPE.pointer
    if t == "integer" : return FMT_SCOPE.integer
    if t == "float" : return FMT_SCOPE.float
    if t == "boolean" : return FMT_SCOPE.boolean
    if t == "mode" : return FMT_SCOPE.mode
    if t == "union" : return FMT_SCOPE.union
    if t == "enum" : return FMT_SCOPE.enum
    if t == "trait" : return FMT_SCOPE.trait
    if t == "extend" : return FMT_SCOPE.extend
    if t == "error" : return FMT_SCOPE.error
    if t == "value" : return FMT_SCOPE.value
    if t == "alias" : return FMT_SCOPE.alias
    if t == "type" : return FMT_SCOPE.type
    if t == "global" : return FMT_SCOPE.global
    if t == "shared" : return FMT_SCOPE.shared
    if t == "@shared" : return FMT_SCOPE.at_shared
    if t == "link" : return FMT_SCOPE.link
    if t == "use" : return FMT_SCOPE.use
    return FMT_SCOPE.root
}

fn fmt_paren_scope(declaration: FMT_SCOPE) FMT_SCOPE {
    if declaration == FMT_SCOPE.function || declaration == FMT_SCOPE.error
        || declaration == FMT_SCOPE.value || declaration == FMT_SCOPE.type
        || declaration == FMT_SCOPE.global || declaration == FMT_SCOPE.shared
        || declaration == FMT_SCOPE.at_shared {
        return declaration
    }
    return FMT_SCOPE.paren
}

fn fmt_scope_has_body(scope: FMT_SCOPE) bool {
    return scope == FMT_SCOPE.function || scope == FMT_SCOPE.test
        || scope == FMT_SCOPE.class || scope == FMT_SCOPE.interface
        || scope == FMT_SCOPE.struct || scope == FMT_SCOPE.array
        || scope == FMT_SCOPE.slice || scope == FMT_SCOPE.unbound
        || scope == FMT_SCOPE.pointer || scope == FMT_SCOPE.integer
        || scope == FMT_SCOPE.float || scope == FMT_SCOPE.boolean
        || scope == FMT_SCOPE.mode || scope == FMT_SCOPE.union
        || scope == FMT_SCOPE.enum || scope == FMT_SCOPE.trait
        || scope == FMT_SCOPE.extend || scope == FMT_SCOPE.error
}

fn fmt_scope_has_access(scope: FMT_SCOPE) bool {
    return scope == FMT_SCOPE.class || scope == FMT_SCOPE.interface
        || scope == FMT_SCOPE.struct || scope == FMT_SCOPE.array
        || scope == FMT_SCOPE.slice || scope == FMT_SCOPE.unbound
        || scope == FMT_SCOPE.pointer || scope == FMT_SCOPE.integer
        || scope == FMT_SCOPE.float || scope == FMT_SCOPE.boolean
        || scope == FMT_SCOPE.mode || scope == FMT_SCOPE.union
        || scope == FMT_SCOPE.trait || scope == FMT_SCOPE.extend
}

fn fmt_scope_space_between(scope: FMT_SCOPE, prev: FmtTok, tok: FmtTok, first: ?FmtTok) ?bool {
    if fmt_scope_has_access(scope) : return fmt_member_space_between(prev, tok, first)
    return null
}

fn fmt_member_space_between(prev: FmtTok, tok: FmtTok, first: ?FmtTok) ?bool {
    let f = first ?! return null
    if !fmt_is_access_sign(f.text) : return null
    if fmt_is_access_sign(tok.text) : return false
    if tok.type == TOK.word && fmt_is_access_sign(prev.text) : return true
    return null
}

fn fmt_is_access_sign(t: String) bool {
    return t == "-" || t == "+" || t == "~"
}

fn fmt_is_binary(t: String) bool {
    if t == "=" : return true
    if t == "==" || t == "!=" || t == "<=" || t == ">=" : return true
    if t == "+" || t == "/" || t == "%" : return true
    if t == "&&" || t == "||" : return true
    if t == "<<" || t == ">>" : return true
    if t == "|" || t == "^" : return true
    if t == "+=" || t == "-=" || t == "*=" || t == "/=" : return true
    if t == "%=" || t == "^=" || t == "&=" || t == "|=" : return true
    if t == "=>" || t == "->" : return true
    if t == "??" || t == "?!" || t == "!?" : return true
    if t == ".." : return true
    return false
}

fn fmt_is_opener(t: FmtTok) bool {
    let s = t.text
    return s == "{" || s == "<{" || s == "(" || s == "["
}

fn fmt_is_closer(t: FmtTok) bool {
    let s = t.text
    return s == "}" || s == ")" || s == "]"
}

fn fmt_ends_operand(t: FmtTok) bool {
    let s = t.text
    if s == ")" || s == "]" || s == "}" : return true
    if s == "++" || s == "--" || s == "!>" || s == "!!" : return true
    let ty = t.type
    if ty == TOK.word || ty == TOK.at_word || ty == TOK.flag : return true
    if ty == TOK.string || ty == TOK.char : return true
    return fmt_is_number(t)
}

fn fmt_is_number(t: FmtTok) bool {
    let ty = t.type
    return ty == TOK.int || ty == TOK.float || ty == TOK.hex || ty == TOK.octal
}

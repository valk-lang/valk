use helper

// Textual LLVM function generation. This follows the classic compiler's
// per-function lifecycle: resolve AST -> emit textual IR -> release AST.

fn generate_unit_modules(build: Build) !Error {
    mark_reachable(build) !>

    // Nothing reads the recorded references once reachability has been
    // decided, and module assembly below is where this build peaks.
    each build.lists.units as unit {
        each unit.functions as func {
            func.functions_used = .{}
            func.globals_used = .{}
            func.strings_used = .{}
        }
    }

    each build.lists.units as unit {
        // A unit nothing reaches produces no module, and therefore no object
        // file for the linker to be handed (see linker.valk).
        if !unit.is_used : continue
        unit.ir_code = generate_unit_module(build, unit) !>
    }
}

fn generate_unit_module(build: Build, unit: Unit) String !Error {
    ir_prepare_allocator_helpers(build, unit) !>
    let out = ByteBuffer.new(32768)
    out.write_string("; Valk LLVM module: ")
    out.write_string(unit.name)
    out.write_string("\n")
    out.write_string("target triple = \"")
    out.write_string(ir_target_triple(build.options.target))
    out.write_string("\"\n\n")
    out.write_string("declare void @llvm.memset.inline.p0.i64(ptr, i8, i64, i1)\n")
    out.write_string("declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n\n")

    // Constants keep their index in the name, so skipping one leaves the rest
    // addressable as before.
    each unit.string_values as value, i {
        if !(unit.string_used.get(i) !? false) : continue
        ir_write_string_constant(out, i, value)
    }
    if unit.string_values.length > 0 : out.write_string("\n")

    // Only symbols actually referenced by this unit need declarations. Externs
    // are declared under their raw C name, and two files may well declare the
    // same libc function, so a module gets one `declare` per symbol — otherwise
    // a single module (--release / --ir) is rejected as a redefinition.
    let declared_externs = Map[bool]{}
    each unit.extern_functions as func {
        // Recorded while lowering any function of this unit, reachable or not.
        if !func.info_used : continue
        if func.is_extern {
            if declared_externs.has(func.name) : continue
            declared_externs.set(func.name, true)
        }
        ir_write_func_signature(out, func, true) !>
    }
    // Some lazily-specialized/generic-argument functions are callable before
    // their body is materialized. Keep the module valid with a declaration;
    // once generated, their non-empty ir_code below replaces this path.
    each unit.functions as func {
        if func.is_extern || func.is_generic_base || !func.info_used : continue
        if func.ir_code.length > 0 : continue
        ir_write_func_signature(out, func, true) !>
    }
    out.write_string("\n")

    // A zero initializer is valid for pointers, numbers, arrays and aggregate
    // storage. Explicit global defaults will be lowered in the next pass.
    let declared_global_externs = Map[bool]{}
    each unit.globals as global {
        if !global.is_used : continue
        let type = global.get_type() !>
        let external = global.is_extern
        // Same as extern functions: one declaration per raw C symbol
        if external {
            if declared_global_externs.has(global.name) : continue
            declared_global_externs.set(global.name, true)
        }
        out.write_string("@\"")
        out.write_string(global_ir_name(global))
        out.write_string("\" = ")
        if external : out.write_string("external ")
        // Also for `extern global` declarations: a non-shared global is
        // thread-local, and the C symbol it refers to (errno) is too. Omitting
        // the marker here produces a non-TLS reference that the linker rejects
        // as soon as the declaration and a use share a module (--release/--ir).
        if !global.shared : out.write_string("thread_local(initialexec) ")
        out.write_string("global ")
        out.write_string(ir_type(type) !>)
        if !external : out.write_string(" zeroinitializer")
        out.write_string("\n")
    }
    each unit.extern_globals as global {
        if !global.is_used : continue
        out.write_string("@\"")
        out.write_string(global_ir_name(global))
        out.write_string("\" = external ")
        if !global.shared : out.write_string("thread_local(initialexec) ")
        out.write_string("global ")
        out.write_string(ir_type(global.get_type() !>) !>)
        out.write_string("\n")
    }
    out.write_string("\n")

    ir_write_allocator_helpers(out, build, unit) !>

    each unit.functions as func {
        if func.is_extern || func.is_generic_base || !func.info_used : continue
        if func.ir_code.length == 0 : continue
        out.write_string(func.ir_code)
    }
    return out.to_string()
}

fn ir_prepare_allocator_helpers(build: Build, unit: Unit) !Error {
    each build.lists.allocator_init_sites as site {
        let func = site.ctx.func
        if !isset(func) : continue
        if func.unit != unit || !func.info_used : continue
        each build.lists.allocators as allocator {
            let global = allocator.global
            // Allocators are discovered while lowering every function, and a
            // class only constructed by unreachable code still produces one.
            // The pool global is marked when a reachable function allocates
            // from it (ir_emit_class_alloc), so that is the test.
            if !global.is_used : continue
            if global.unit != unit : unit.extern_globals.append(global, true)
            let pool_class = (global.get_type() !>).get_class_or_null()
            if !isset(pool_class) : build.bug("Generated allocator global is not a Pool")
            let init = pool_class.get_func("init")
            if !isset(init) : build.bug("gc:Pool.init is missing")
            if !init.parsed_types : parse_func_types(init) !>
            if init.unit != unit || init.is_extern : unit.extern_functions.append(init, true)
            let onfree = allocator.onfree
            if isset(onfree) && (onfree.unit != unit || onfree.is_extern) {
                unit.extern_functions.append(onfree, true)
            }
            let props_func = allocator.props_func
            if isset(props_func) {
                if !props_func.parsed_types : parse_func_types(props_func) !>
                if props_func.unit != unit || props_func.is_extern {
                    unit.extern_functions.append(props_func, true)
                }
            }
        }
    }
}

fn ir_write_allocator_helpers(out: ByteBuffer, build: Build, unit: Unit) !Error {
    each build.lists.allocator_init_sites as site {
        let owner = site.ctx.func
        if !isset(owner) : continue
        if owner.unit != unit || !owner.info_used : continue

        each build.lists.allocators as allocator, i {
            if !allocator.global.is_used : continue
            let props_func = allocator.props_func
            if allocator.props.length == 0 && !isset(props_func) : continue
            out.write_string("define internal void @\"valk.allocator.props.")
            out.write_int_ascii(site.value.int_val)
            out.write_string(".")
            out.write_uint_ascii(i)
            out.write_string("\"(ptr \%item, ptr \%list, { ptr, ptr } \%callback) {\nentry:\n")
            out.write_string("  \%callback.fn = extractvalue { ptr, ptr } \%callback, 0\n")
            out.write_string("  \%callback.data = extractvalue { ptr, ptr } \%callback, 1\n")
            each allocator.props as prop, pi {
                out.write_string("  \%ref.")
                out.write_uint_ascii(pi)
                out.write_string(" = getelementptr i8, ptr \%item, i64 ")
                out.write_uint_ascii(prop.offset)
                out.write_string("\n  call void \%callback.fn(ptr \%callback.data, ptr \%ref.")
                out.write_uint_ascii(pi)
                out.write_string(", ptr \%list)\n")
            }
            if isset(props_func) {
                out.write_string("  call void @\"")
                out.write_string(func_ir_name(props_func))
                out.write_string("\"(ptr \%item, ptr \%list, { ptr, ptr } \%callback)\n")
            }
            out.write_string("  ret void\n}\n\n")
        }

        out.write_string("define internal void @\"valk.init.allocators.")
        out.write_int_ascii(site.value.int_val)
        out.write_string("\"() {\nentry:\n")
        each build.lists.allocators as allocator, i {
            let global = allocator.global
            if !global.is_used : continue
            let pool_class = (global.get_type() !>).get_class_or_null()
            if !isset(pool_class) : build.bug("Generated allocator global is not a Pool")
            let init = pool_class.get_func("init")
            if !isset(init) : build.bug("gc:Pool.init is missing")

            out.write_string("  \%pool.")
            out.write_uint_ascii(i)
            out.write_string(" = call ")
            out.write_string(ir_type(init.get_rett()) !>)
            out.write_string(" @\"")
            out.write_string(func_ir_name(init))
            out.write_string("\"(i64 ")
            out.write_uint_ascii(allocator.size)
            out.write_string(", ptr ")
            if allocator.props.length > 0 || isset(allocator.props_func) {
                out.write_string("@\"valk.allocator.props.")
                out.write_int_ascii(site.value.int_val)
                out.write_string(".")
                out.write_uint_ascii(i)
                out.write_string("\"")
            } else {
                out.write_string("null")
            }
            out.write_string(", ptr ")
            let onfree = allocator.onfree
            if isset(onfree) {
                out.write_string("@\"")
                out.write_string(func_ir_name(onfree))
                out.write_string("\"")
            } else {
                out.write_string("null")
            }
            out.write_string(")\n  store ptr \%pool.")
            out.write_uint_ascii(i)
            out.write_string(", ptr @\"")
            out.write_string(global_ir_name(global))
            out.write_string("\"\n")
        }
        out.write_string("  ret void\n}\n\n")
    }
}

fn ir_write_string_constant(out: ByteBuffer, index: uint, value: String) {
    let size = value.bytes + 1
    out.write_string("@\"valk.str.")
    out.write_uint_ascii(index)
    // GcData immediately precedes the String value. The collector updates its
    // on-stack/ownership flags even for literal strings, so this storage must
    // remain writable (the classic backend also emits `private global`).
    out.write_string("\" = private global <{ i64, i64, [")
    out.write_uint_ascii(size)
    out.write_string(" x i8] }> <{ i64 0, i64 ")
    out.write_uint_ascii(value.bytes)
    out.write_string(", [")
    out.write_uint_ascii(size)
    out.write_string(" x i8] c\"")
    let i: uint = 0
    while i < value.bytes {
        let byte = @ptrv(value.data, u8, i++)
        // LLVM's string syntax accepts printable ASCII except quote and slash.
        if byte >= 32 && byte <= 126 && byte != 34 && byte != 92 {
            out.write_byte(byte)
        } else {
            out.write_byte('\\')
            let hex = byte.to_hex()
            if hex.bytes < 2 : out.write_byte('0')
            out.write_string(hex)
        }
    }
    out.write_string("\\00\" }>\n")
}

fn ir_write_func_signature(out: ByteBuffer, func: Func, declare: bool) !Error {
    out.write_string(declare ? "declare " : "define ")
    out.write_string(ir_func_rett_type(func) !>)
    out.write_string(" @\"")
    out.write_string(func_ir_name(func))
    out.write_string("\"(")
    if func.is_literal : out.write_string("ptr")
    each func.args as arg, i {
        if i > 0 || func.is_literal : out.write_string(", ")
        out.write_string(ir_type(arg.type) !>)
    }
    if func.infinite_args {
        if func.args.length > 0 : out.write_string(", ")
        out.write_string("...")
    }
    out.write_string(")\n")
}

fn ir_target_triple(target: Target) String {
    if target.arch == "x64" {
        if target.os == "linux" : return "x86_64-pc-linux-gnu"
        if target.os == "macos" : return "x86_64-apple-darwin"
        return "x86_64-pc-windows-msvc"
    }
    if target.os == "linux" : return "aarch64-pc-linux-gnu"
    if target.os == "macos" : return "arm64-apple-darwin"
    return "aarch64-pc-windows-msvc"
}

class IRFunc {
    func: Func
    code: ByteBuffer (.new(4096))
    coro_helpers: ByteBuffer (.new(2048))
    varc: uint (0)
    blockc: uint (0)
    terminated: bool (false)
    loop_cond: ?String (null)
    loop_after: ?String (null)
    gc_stack_global: String ("")
    gc_stack_previous: String ("")
    cleanup_active: bool (false)
    current_block: String ("")
    vscope_after: ?String (null)
    vscope_results: ?Array[String] (null)
    vscope_blocks: ?Array[String] (null)
    error_values: Array[Value] (.{})
    error_results: Array[String] (.{})
    vscope_values: Array[Value] (.{})
    vscope_rendered: Array[String] (.{})
    multi_values: Array[Value] (.{})
    multi_rendered: Array[String] (.{})
    // Scoped substitution used by match lowering so its input expression is
    // evaluated once even though every generated comparison references it.
    match_value: ?Value (null)
    match_rendered: String ("")

    fn line(text: String) {
        this.code.write_string("  ")
        this.code.write_string(text)
        this.code.write_string("\n")
    }

    fn line_start() {
        this.code.write_string("  ")
    }

    fn write(text: String) {
        this.code.write_string(text)
    }

    fn write_uint(value: uint) {
        this.code.write_uint_ascii(value)
    }

    fn write_int(value: int) {
        this.code.write_int_ascii(value)
    }

    fn line_end() {
        this.code.write_string("\n")
    }

    fn comment(text: String) {
        // Every physical line must remain an LLVM comment. Embedded source
        // strings (JSON/templates/etc.) commonly contain newlines.
        this.line("; " + text.replace("\n", "\n  ; "))
    }

    fn var() String {
        return "\%." + this.varc++
    }

    fn block(prefix: String) String {
        return prefix + "." + this.blockc++
    }

    fn captured_address(decl: Decl) String !Error {
        each this.func.capture_decls as captured, i {
            if captured != decl : continue
            let class = this.func.capture_class
            if !isset(class) : this.func.exp.bug("Literal capture environment is missing")
            let prop = class.props.get(i) !? null
            if !isset(prop) : this.func.exp.bug("Literal capture property is missing")
            let address = this.var()
            this.line_start()
            this.write(address)
            this.write(" = getelementptr i8, ptr \%closure.data, i64 ")
            this.write_uint(prop.offset)
            this.line_end()
            return address
        }
        this.func.exp.bug("Literal references an unregistered capture")
    }

    fn label(name: String) {
        this.code.write_string(name)
        this.code.write_string(":\n")
        this.current_block = name
        this.terminated = false
    }

    fn jump(name: String) {
        if this.terminated : return
        this.line("br label \%" + name)
        this.terminated = true
    }

    fn cond_jump(cond: String, yes: String, no: String) {
        if this.terminated : return
        this.line("br i1 " + cond + ", label \%" + yes + ", label \%" + no)
        this.terminated = true
    }

    fn cached_error_result(value: Value) ?String {
        each this.error_values as existing, i {
            if existing == value : return this.error_results.get(i) !? null
        }
        return null
    }

    fn cache_error_result(value: Value, result: String) {
        each this.error_values as existing, i {
            if existing == value {
                this.error_results.set(i, result) _
                return
            }
        }
        this.error_values.append(value)
        this.error_results.append(result)
    }

    fn cached_vscope(value: Value) ?String {
        each this.vscope_values as existing, i {
            if existing == value : return this.vscope_rendered.get(i) !? null
        }
        return null
    }

    fn cache_vscope(value: Value, result: String) {
        if isset(this.cached_vscope(value)) : return
        this.vscope_values.append(value)
        this.vscope_rendered.append(result)
    }

    fn cached_multi(value: Value) ?String {
        each this.multi_values as existing, i {
            if existing == value : return this.multi_rendered.get(i) !? null
        }
        return null
    }

    fn cache_multi(value: Value, result: String) {
        if isset(this.cached_multi(value)) : return
        this.multi_values.append(value)
        this.multi_rendered.append(result)
    }
}

fn generate_func_ir(func: Func) !Error {
    let scope = func.body_scope
    if !isset(scope) : return

    let ir = IRFunc { func: func }
    func.ir_name = func_ir_name(func)

    ir.code.write_string("define dso_local ")
    ir.code.write_string(ir_func_rett_type(func) !>)
    ir.code.write_string(" @\"")
    ir.code.write_string(func.ir_name)
    ir.code.write_string("\"(")
    if func.is_literal : ir.code.write_string("ptr \%closure.data")
    each func.args as arg, i {
        if i > 0 || func.is_literal : ir.code.write_string(", ")
        ir.code.write_string(ir_type(arg.type) !>)
        ir.code.write_string(" \%arg.")
        ir.code.write_uint_ascii(i)
    }
    if func.infinite_args {
        if func.args.length > 0 : ir.code.write_string(", ")
        ir.code.write_string("...")
    }
    ir.code.write_string(")")
    if func.is_inline : ir.code.write_string(" alwaysinline")
    if func.is_hot : ir.code.write_string(" hot")
    ir.code.write_string(" {\n")
    ir.label("entry")

    // `$entrance` functions initialize a fresh thread's GC state themselves.
    // Their frame must be installed at the explicit `@allocas` splice point,
    // after that initialization, rather than in the ordinary entry prologue.
    if !func.is_entrance : ir_emit_gc_stack_init(ir) !>
    let stable_stack_decl = func.stable_stack_decl
    if isset(stable_stack_decl) && !func.is_entrance {
        stable_stack_decl.ir_name = "\%valk_stable_stack"
        ir.line_start()
        ir.write(stable_stack_decl.ir_name)
        ir.write(" = getelementptr i8, ptr \%valk.gc.stack.values, i64 ")
        ir.write_uint(stable_stack_decl.offset)
        ir.line_end()
    }

    // Allocate every local once in the entry block. The old backend used the
    // generated decl_offset nodes; emitting them here has the same LLVM shape
    // and keeps later value lowering independent of declaration order.
    each func.all_decls as decl, i {
        decl.ir_name = "\%decl." + i
        if ir_decl_uses_gc_stack(func, decl) {
            if !func.is_entrance {
                ir.line(decl.ir_name + " = getelementptr i8, ptr \%valk.gc.stack.values, i64 " + decl.offset)
            }
        } else if decl.must_be_stable {
            // Address comes from the stable stack block, set up just below once
            // every declaration has been named.
        } else {
            ir.line(decl.ir_name + " = alloca " + (ir_type(decl.type) !>))
        }
    }

    // An argument whose address is taken lives in the stable stack, so that
    // block has to exist before the stores below write the incoming values into
    // it. An entrance function runs before gc:thread_init and cannot call the
    // pool allocator here; it keeps the block at its own `@allocas` point, and
    // has no arguments to take the address of.
    if isset(stable_stack_decl) && !func.is_entrance {
        ir.comment("STABLE STACK")
        ir_emit_stable_stack_init(ir, stable_stack_decl, func.stable_alloca_size) !>
    }

    each func.args as arg, i {
        ir.line("store " + (ir_type(arg.type) !>) + " \%arg." + i + ", ptr " + arg.decl.ir_name)
        ir_sync_closure_root(ir, arg.decl, "\%arg." + i) !>
    }

    each scope.values as value {
        ir_emit_stmt(ir, value) !>
    }

    if !ir.terminated {
        let rett = func.get_rett()
        ir_emit_func_cleanup(ir) !>
        if func.can_error {
            ir_emit_error_return(ir, rett.is_void_type() ? "" : "undef", rett, "0") !>
        } else if rett.is_void_type() {
            ir.line("ret void")
        } else {
            ir.line("ret " + (ir_type(rett) !>) + " undef")
        }
    }
    ir.code.write_string("}\n\n")
    ir.code.write_buffer(ir.coro_helpers)
    func.ir_code = ir.code.to_string()
}

fn ir_decl_uses_gc_stack(func: Func, decl: Decl) bool {
    let stable = func.stable_stack_decl
    if isset(stable) && stable == decl : return true
    if func.disable_gc_stack : return false
    return decl.is_gc && (!decl.is_arg || decl.is_mut)
}

fn ir_sync_closure_root(ir: IRFunc, decl: Decl, closure: String) !Error {
    let offset = decl.closure_root_offset
    if !isset(offset) : return
    let data = ir.var()
    ir.line_start()
    ir.write(data)
    ir.write(" = extractvalue ")
    ir.write(ir_type(decl.type) !>)
    ir.write(" ")
    ir.write(closure)
    ir.write(", 1")
    ir.line_end()
    let address = ir.var()
    ir.line_start()
    ir.write(address)
    ir.write(" = getelementptr i8, ptr \%valk.gc.stack.values, i64 ")
    ir.write_uint(offset)
    ir.line_end()
    ir.line_start()
    ir.write("store ptr ")
    ir.write(data)
    ir.write(", ptr ")
    ir.write(address)
    ir.line_end()
}

fn ir_emit_gc_stack_init(ir: IRFunc) !Error {
    let func = ir.func
    if func.gc_decl_count == 0 : return

    let idf = valk_idf(func.ns.build, "coro", "gc_stack_sp") !>
    let global = idf.global
    if !isset(global) : func.exp.bug("coro:gc_stack_sp is not a global")
    ir_use_global(ir, global)

    let global_name = "@\"" + global_ir_name(global) + "\""
    let frame_size = func.alloca_size + 16
    let int_type = "i" + (func.ns.build.options.target.ptr_size.to(uint) * 8)
    ir.gc_stack_global = global_name
    ir.gc_stack_previous = "\%valk.gc.stack.previous"
    ir.line("\%valk.gc.stack = alloca [" + frame_size + " x i8]")
    ir.line(ir.gc_stack_previous + " = load ptr, ptr " + global_name)
    ir.line("\%valk.gc.stack.next = getelementptr i8, ptr \%valk.gc.stack, i64 0")
    ir.line("store ptr " + ir.gc_stack_previous + ", ptr \%valk.gc.stack.next")
    ir.line("\%valk.gc.stack.count = getelementptr i8, ptr \%valk.gc.stack, i64 8")
    ir.line("store " + int_type + " " + func.gc_decl_count + ", ptr \%valk.gc.stack.count")
    ir.line("\%valk.gc.stack.values = getelementptr i8, ptr \%valk.gc.stack, i64 16")
    if func.alloca_size > 0 {
        ir.line("call void @llvm.memset.inline.p0.i64(ptr \%valk.gc.stack.values, i8 0, i64 " + func.alloca_size + ", i1 false)")
    }
    ir.line("store ptr \%valk.gc.stack, ptr " + global_name)
}

fn ir_emit_gc_stack_defer(ir: IRFunc) {
    if ir.gc_stack_global == "" || ir.func.is_entrance : return
    ir.line_start()
    ir.write("store ptr ")
    ir.write(ir.gc_stack_previous)
    ir.write(", ptr ")
    ir.write(ir.gc_stack_global)
    ir.line_end()
}

// Run the generated function defer scope on every real function exit. It may
// contain user-visible cleanup such as test result submission in addition to
// the generated GC-frame pop. cleanup_active prevents a cleanup call that is
// itself marked non-returning from recursively entering the same scope.
fn ir_emit_func_cleanup(ir: IRFunc) !Error {
    if ir.cleanup_active : return
    ir.cleanup_active = true
    let restored_gc_stack = false
    let scope = ir.func.defer_scope
    if isset(scope) {
        each scope.values as value {
            if value.type == VAL.gc_stack_defer : restored_gc_stack = true
            ir_emit_stmt(ir, value) !>
        }
    }
    if !restored_gc_stack : ir_emit_gc_stack_defer(ir)
    ir.cleanup_active = false
}

fn ir_build_error_result(ir: IRFunc, rendered: String, rett: Type, code: String) String !Error {
    if rett.is_void_type() : return code
    let abi = ir_error_abi_type(rett) !>
    let current = "undef"
    if rett.type == TYPE.multi {
        let subs = rett.sub_types
        if !isset(subs) : rett.build.bug("Fallible multi return is missing subtypes")
        each subs as sub, i {
            let part = ir.var()
            ir.line_start()
            ir.write(part)
            ir.write(" = extractvalue ")
            ir.write(ir_type(rett) !>)
            ir.write(" ")
            ir.write(rendered)
            ir.write(", ")
            ir.write_uint(i)
            ir.line_end()
            let next = ir.var()
            ir.line_start()
            ir.write(next)
            ir.write(" = insertvalue ")
            ir.write(abi)
            ir.write(" ")
            ir.write(current)
            ir.write(", ")
            ir.write(ir_type(sub) !>)
            ir.write(" ")
            ir.write(part)
            ir.write(", ")
            ir.write_uint(i)
            ir.line_end()
            current = next
        }
    } else {
        let next = ir.var()
        ir.line_start()
        ir.write(next)
        ir.write(" = insertvalue ")
        ir.write(abi)
        ir.write(" ")
        ir.write(current)
        ir.write(", ")
        ir.write(ir_type(rett) !>)
        ir.write(" ")
        ir.write(rendered)
        ir.write(", 0")
        ir.line_end()
        current = next
    }
    let out = ir.var()
    ir.line_start()
    ir.write(out)
    ir.write(" = insertvalue ")
    ir.write(abi)
    ir.write(" ")
    ir.write(current)
    ir.write(", i32 ")
    ir.write(code)
    ir.write(", ")
    ir.write_uint(ir_normal_rett_count(rett))
    ir.line_end()
    return out
}

fn ir_emit_error_return(ir: IRFunc, rendered: String, rett: Type, code: String) !Error {
    let result = ir_build_error_result(ir, rendered, rett, code) !>
    ir.line_start()
    ir.write("ret ")
    ir.write(ir_error_abi_type(rett) !>)
    ir.write(" ")
    ir.write(result)
    ir.line_end()
}

// Record that the function currently being written refers to `func`, and
// declare it when the definition lives in another module. Every reference to a
// function symbol goes through here, so the recorded edges are exactly the
// call graph of the generated code — which is what reachable.valk walks.
fn ir_use_func(ir: IRFunc, func: Func) {
    ir.func.functions_used.append(func, true)
    if func.unit != ir.func.unit || func.is_extern {
        ir.func.unit.extern_functions.append(func, true)
    }
}

// Same for a global. `declare`s go to extern_globals when it is defined elsewhere.
fn ir_use_global(ir: IRFunc, global: Global) {
    ir.func.globals_used.append(global, true)
    if global.unit != ir.func.unit {
        ir.func.unit.extern_globals.append(global, true)
    }
}

// The function being written allocates GC memory here. Recorded on the spot,
// during generation, because lowering is where allocation actually appears:
// a body that mentions no allocation at all still gets pool calls for object
// construction, closure data and coroutine frames (see gc-stack.valk).
fn ir_note_allocates(ir: IRFunc) {
    ir.func.info_creates_objects = true
}

// Control leaves this function for somewhere the compiler cannot follow: an
// indirect call, a function reference that may be invoked from C, or a
// coroutine switch. Whatever runs there may allocate.
fn ir_note_unknown_code(ir: IRFunc) {
    ir.func.info_calls_unknown_code = true
}

// True when this module already holds `name`, in which case the caller reuses
// it rather than writing a second definition under the same symbol. Its owner
// becomes reachable along with the referrer, because the adapter's text sits in
// that owner's ir_code and would otherwise be dropped from the module.
fn ir_reuse_adapter(ir: IRFunc, name: String) bool {
    ir.func.unit.closure_adapters.get(name) -> owner {
        ir.func.functions_used.append(owner, true)
        return true
    }
    return false
}

// Intern a string literal in the current module and record the use, so an
// unreachable function's literals are not emitted as constants.
fn ir_use_string(ir: IRFunc, value: String) uint {
    let index = ir.func.unit.add_string(value)
    ir.func.strings_used.append(index, true)
    return index
}

fn func_ir_name(func: Func) String {
    if func.is_extern : return func.name
    if func.name == "__valk_main__" : return "main"
    let out = ir_name_prefix(func.unit, func.ns, func.exp)
    let class = func.class
    if isset(class) : out += "__" + class.name
    out += "__" + func.name + "__" + func.exp.i
    return out
}

// Symbol prefix for a declaration. The unit name is normally enough, because
// each source file has its own unit. With --release / --ir every file shares one
// unit, so the source id is needed as well: two files can otherwise produce the
// same symbol (same declaration name, and for functions the same source offset).
fn ir_name_prefix(unit: Unit, ns: Namespace, exp: Exp) String {
    if !ns.build.options.single_unit : return unit.name
    return unit.name + "_" + exp.src.id
}

fn ir_func_rett_type(func: Func) String !Error {
    if !func.can_error : return ir_type(func.get_rett()) !>
    return ir_error_abi_type(func.get_rett()) !>
}

fn ir_error_abi_type(rett: Type) String !Error {
    if rett.is_void_type() : return "i32"
    if rett.type == TYPE.multi {
        let subs = rett.sub_types
        if !isset(subs) : rett.build.bug("Fallible multi return is missing subtypes")
        let out = "{ "
        each subs as sub, i {
            if i > 0 : out += ", "
            out += ir_type(sub) !>
        }
        if subs.length > 0 : out += ", "
        return out + "i32 }"
    }
    return "{ " + (ir_type(rett) !>) + ", i32 }"
}

fn ir_normal_rett_count(rett: Type) uint {
    if rett.is_void_type() : return 0
    if rett.type == TYPE.multi {
        let subs = rett.sub_types
        return isset(subs) ? subs.length : 0
    }
    return 1
}

fn global_ir_name(global: Global) String {
    if global.is_extern : return global.name
    return ir_name_prefix(global.unit, global.ns, global.exp) + "__" + global.name
}

fn ir_type(type: Type) String !Error {
    let t = type.get_non_nullable()
    if ir_is_tagged_nullable(type) {
        // Keep LLVM's natural padding here. The classic ABI reserves a
        // pointer-sized presence slot for nullable inline values.
        return "{ i1, " + (ir_type(t) !>) + " }"
    }
    if t.type == TYPE.fn : return "{ ptr, ptr }"
    if t.is_pointer_sized() : return "ptr"
    if t.type == TYPE.void : return "void"
    if t.type == TYPE.bool : return "i1"
    if t.type == TYPE.error_code : return "i32"
    if t.type == TYPE.int {
        return "i" + ((t.size() !>).to(uint) * 8)
    }
    if t.type == TYPE.float {
        let size = t.size() !>
        if size == 4 : return "float"
        if size == 8 : return "double"
        type.build.error("Unsupported LLVM float size: " + size)
    }
    if t.type == TYPE.array {
        let sub = t.sub_type
        if !isset(sub) : type.build.bug("Array type is missing its element type during IR generation")
        return "[" + t.array_size + " x " + (ir_type(sub) !>) + "]"
    }
    if t.type == TYPE.inline {
        let sub = t.sub_type
        if !isset(sub) : type.build.bug("Inline type is missing its subtype during IR generation")
        // A named struct/class value is pointer-sized, but its explicit `<T>`
        // form is the inline body. Use the wrapper's computed size rather than
        // asking the named subtype for its (pointer) representation size.
        return "[" + (t.size() !>) + " x i8]"
    }
    if t.type == TYPE.multi {
        let subs = t.sub_types
        if !isset(subs) : type.build.bug("Multi type is missing subtypes during IR generation")
        if subs.length == 0 : return "void"
        if subs.length == 1 {
            let first = subs.get(0) !? null
            if isset(first) : return ir_type(first) !>
        }
        let out = "{ "
        each subs as sub, i {
            if i > 0 : out += ", "
            out += ir_type(sub) !>
        }
        return out + " }"
    }
    // Inline class/struct storage.
    if t.type == TYPE.class {
        return "[" + (t.size() !>) + " x i8]"
    }
    type.build.error("Cannot convert type to LLVM IR type: " + type.compat_display_name())
}

fn ir_is_tagged_nullable(type: Type) bool {
    if !type.is_nullable_type() : return false
    let sub = type.sub_type
    if !isset(sub) : return false
    return !sub.is_pointer_sized() && sub.type != TYPE.fn
}

fn ir_emit_values(ir: IRFunc, values: ?Array[Value]) !Error {
    if !isset(values) : return
    each values as value {
        ir_emit_stmt(ir, value) !>
        ir_clear_statement_buffers(ir, value) !>
    }
}

// Argument/receiver buffers are GC roots only for the duration of the
// statement that evaluates them. Leaving their last value in the function's
// GC frame retains otherwise-dead object graphs until the function returns
// (and indefinitely inside loops).
fn ir_clear_statement_buffers(ir: IRFunc, value: Value) !Error {
    if ir.terminated : return
    let buffers = Array[Decl]{}
    ir_collect_statement_buffers(value, buffers)
    each buffers as decl {
        if !decl.is_gc : continue
        ir.line("store ptr null, ptr " + decl.ir_name)
    }
}

fn ir_collect_statement_buffers(value: Value, buffers: Array[Decl]) {
    if value.type == VAL.decl {
        let decl = value.decl
        if isset(decl) && decl.is_buffer : buffers.append(decl, true)
    }
    let pre = value.pre_value
    if isset(pre) : ir_collect_statement_buffers(pre, buffers)
    let first = value.value1
    if isset(first) : ir_collect_statement_buffers(first, buffers)
    let second = value.value2
    if isset(second) : ir_collect_statement_buffers(second, buffers)
    let children = value.values
    if isset(children) {
        each children as child : ir_collect_statement_buffers(child, buffers)
    }
}

fn ir_emit_stmt(ir: IRFunc, value: Value) !Error {
    if ir.terminated : return
    let t = value.type

    if t == VAL.block || t == VAL.allocas {
        ir_emit_values(ir, value.values) !>
        return
    }
    if t == VAL.init_allocators {
        // The helper body is emitted at module finalization, after allocator
        // discovery has reached its fixed point.
        ir.line("call void @\"valk.init.allocators." + value.int_val + "\"()")
        return
    }
    if t == VAL.return {
        let retv = value.value1
        let vscope_after = ir.vscope_after
        if isset(vscope_after) {
            if !isset(retv) : value.bug("IR value-scope return has no value")
            let results = ir.vscope_results
            let blocks = ir.vscope_blocks
            if !isset(results) || !isset(blocks) : value.bug("IR value-scope merge state is missing")
            results.append(ir_emit_value(ir, retv) !>)
            blocks.append(ir.current_block)
            ir.jump(vscope_after)
            return
        }
        if !isset(retv) {
            ir_emit_func_cleanup(ir) !>
            if ir.func.can_error : ir_emit_error_return(ir, "", ir.func.get_rett(), "0") !>
            else : ir.line("ret void")
        } else {
            let rendered = ir_emit_value(ir, retv) !>
            ir_emit_func_cleanup(ir) !>
            if ir.func.can_error : ir_emit_error_return(ir, rendered, ir.func.get_rett(), "0") !>
            else : ir.line("ret " + (ir_type(retv.rett) !>) + " " + rendered)
        }
        ir.terminated = true
        return
    }
    if t == VAL.throw {
        let thrown = value.value1
        if !isset(thrown) : value.bug("IR throw is missing its error value")
        let code = ir_emit_value(ir, thrown) !>
        ir_emit_func_cleanup(ir) !>
        ir_emit_error_return(ir, "undef", ir.func.get_rett(), code) !>
        ir.terminated = true
        return
    }
    if t == VAL.assign {
        ir_emit_assign(ir, value) !>
        return
    }
    if t == VAL.if {
        ir_emit_if(ir, value) !>
        return
    }
    if t == VAL.while {
        ir_emit_while(ir, value) !>
        return
    }
    // Both are rejected during lowering when there is no loop to leave
    // (see scope_has_loop), so reaching here means the two disagree — and
    // emitting nothing would silently fall through instead of branching.
    if t == VAL.break {
        let after = ir.loop_after ?! value.bug("'break' reached IR without an enclosing loop")
        ir.jump(after)
        return
    }
    if t == VAL.continue {
        let cond = ir.loop_cond ?! value.bug("'continue' reached IR without an enclosing loop")
        ir.jump(cond)
        return
    }
    if t == VAL.ir_comment {
        ir.comment(value.string_val)
        return
    }
    if t == VAL.gc_stack_init {
        if ir.func.is_entrance : ir_emit_gc_stack_init(ir) !>
        return
    }
    if t == VAL.decl_offset {
        // Ordinary functions define their declaration addresses in entry.
        // Entrance functions delay GC-backed addresses until `@allocas`.
        if ir.func.is_entrance {
            let decl = value.decl
            if !isset(decl) : value.bug("Declaration offset is missing its declaration")
            if ir_decl_uses_gc_stack(ir.func, decl) {
                let stable = ir.func.stable_stack_decl
                if !isset(stable) || stable != decl {
                    ir.line(decl.ir_name + " = getelementptr i8, ptr \%valk.gc.stack.values, i64 " + decl.offset)
                }
            }
        }
        return
    }
    if t == VAL.gc_stack_defer {
        ir_emit_gc_stack_defer(ir)
        return
    }
    if t == VAL.stable_stack_init {
        let sd = value.decl
        if !isset(sd) : value.bug("Stable stack initialization is missing its declaration")
        ir_emit_stable_stack_init(ir, sd, value.int_val.to(uint)) !>
        return
    }

    // Expression statement: evaluate for side effects.
    ir_emit_value(ir, value) !>
}

fn ir_emit_stable_stack_init(ir: IRFunc, stack_decl: Decl, size: uint) !Error {
    ir_note_allocates(ir)
    let at = ir.func.exp
    if size == 0 : at.bug("Stable stack initialization has an invalid size")
    if ir.func.is_entrance {
        ir.line(stack_decl.ir_name + " = getelementptr i8, ptr \%valk.gc.stack.values, i64 " + stack_decl.offset)
    }

    let build = ir.func.ns.build
    let pools_idf = valk_idf(build, "gc", "pools") !>
    let pools = pools_idf.global
    if !isset(pools) : at.bug("gc:pools is not a global")
    ir_use_global(ir, pools)

    let pools_type = pools.get_type() !>
    let pool_type = pools_type.sub_type
    if !isset(pool_type) : at.bug("gc:pools has no element type")
    let pool_class = pool_type.get_class_or_null()
    if !isset(pool_class) : at.bug("gc:pools does not contain Pool values")
    let pool_get = pool_class.get_func("get")
    if !isset(pool_get) : at.bug("gc:Pool.get is missing")
    if !pool_get.parsed_types : parse_func_types(pool_get) !>
    ir_use_func(ir, pool_get)

    let index = ir_pool_index(size, build.options.target.ptr_size.to(uint))
    let pool_address = ir.var()
    ir.line_start()
    ir.write(pool_address)
    ir.write(" = getelementptr ")
    ir.write(ir_type(pools_type) !>)
    ir.write(", ptr @\"")
    ir.write(global_ir_name(pools))
    ir.write("\", i64 0, i64 ")
    ir.write_uint(index)
    ir.line_end()

    let pool = ir.var()
    ir.line_start()
    ir.write(pool)
    ir.write(" = load ")
    ir.write(ir_type(pool_type) !>)
    ir.write(", ptr ")
    ir.write(pool_address)
    ir.line_end()

    let stack = ir.var()
    ir.line_start()
    ir.write(stack)
    ir.write(" = call ")
    ir.write(ir_type(pool_get.get_rett()) !>)
    ir.write(" @\"")
    ir.write(func_ir_name(pool_get))
    ir.write("\"(ptr ")
    ir.write(pool)
    ir.write(")")
    ir.line_end()

    ir.line_start()
    ir.write("store ptr ")
    ir.write(stack)
    ir.write(", ptr ")
    ir.write(stack_decl.ir_name)
    ir.line_end()

    each ir.func.all_decls as decl {
        if !decl.must_be_stable : continue
        ir.line_start()
        ir.write(decl.ir_name)
        ir.write(" = getelementptr i8, ptr ")
        ir.write(stack)
        ir.write(", i64 ")
        ir.write_uint(decl.offset)
        ir.line_end()
    }
}

fn ir_pool_index(size: uint, ptr_size: uint) uint {
    let until = 16 * ptr_size
    if size <= until {
        let index = size / ptr_size
        if index * ptr_size == size : index--
        return index
    }
    let index: uint = 16
    let item_size = until * 2
    while item_size < size {
        index++
        item_size *= 2
    }
    return index
}

fn ir_emit_if(ir: IRFunc, value: Value) !Error {
    let condv = value.value1
    if !isset(condv) : value.bug("IR if is missing its condition")
    let cond = ir_emit_value(ir, condv) !>
    let yes = ir.block("if.then")
    let no = ir.block("if.else")
    let after = ir.block("if.after")
    ir.cond_jump(cond, yes, no)

    ir.label(yes)
    ir_emit_values(ir, value.values) !>
    ir.jump(after)

    ir.label(no)
    let elsev = value.value2
    if isset(elsev) : ir_emit_stmt(ir, elsev) !>
    ir.jump(after)

    ir.label(after)
}

fn ir_emit_while(ir: IRFunc, value: Value) !Error {
    let cond_block = ir.block("while.cond")
    let body_block = ir.block("while.body")
    let after_block = ir.block("while.after")
    ir.jump(cond_block)

    ir.label(cond_block)
    let condv = value.value1
    if !isset(condv) : value.bug("IR while is missing its condition")
    let cond = ir_emit_value(ir, condv) !>
    ir.cond_jump(cond, body_block, after_block)

    ir.label(body_block)
    let old_cond = ir.loop_cond
    let old_after = ir.loop_after
    ir.loop_cond = cond_block
    ir.loop_after = after_block
    ir_emit_values(ir, value.values) !>
    ir.loop_cond = old_cond
    ir.loop_after = old_after
    ir.jump(cond_block)

    ir.label(after_block)
}

fn ir_emit_assign(ir: IRFunc, value: Value) !Error {
    let left = value.value1
    let right = value.value2
    if !isset(left) || !isset(right) : value.bug("IR assignment is missing an operand")

    // Writes to an already-visible GC object must update collector ownership
    // state. Class initialization does not pass through VAL.assign and keeps
    // its faster direct-store path.
    if left.type == VAL.prop {
        let owner = left.value1
        let prop = left.prop
        if !isset(owner) || !isset(prop) : value.bug("IR property assignment is incomplete")
        if owner.rett.is_gc_type() && left.rett.get_non_nullable().type == TYPE.fn {
            let owner_value = ir_emit_value(ir, owner) !>
            let address = ir.var()
            ir.line(address + " = getelementptr i8, ptr " + owner_value + ", i64 " + prop.offset)
            let result = ir_emit_value(ir, right) !>
            let op = value.op.@cast(ASSIGN_OP)
            if op != ASSIGN_OP.set : value.bug("Compound assignment is not valid for a closure property")
            let function = ir.var()
            ir.line(function + " = extractvalue { ptr, ptr } " + result + ", 0")
            let environment = ir.var()
            ir.line(environment + " = extractvalue { ptr, ptr } " + result + ", 1")
            let environment_address = ir.var()
            ir.line(environment_address + " = getelementptr i8, ptr " + address + ", i64 " + owner.rett.ptr_size())
            ir_emit_gc_property_update(ir, value, owner_value, environment_address, environment) !>
            ir.line("store ptr " + function + ", ptr " + address)
            return
        }
        if owner.rett.is_gc_type() && left.rett.is_gc_type() {
            let owner_value = ir_emit_value(ir, owner) !>
            let address = ir.var()
            ir.line(address + " = getelementptr i8, ptr " + owner_value + ", i64 " + prop.offset)
            let result = ir_emit_value(ir, right) !>
            let op = value.op.@cast(ASSIGN_OP)
            if op != ASSIGN_OP.set {
                let old = ir.var()
                let type = ir_type(left.rett) !>
                ir.line(old + " = load " + type + ", ptr " + address)
                result = ir_emit_binary(ir, old, result, assign_value_op(op), left.rett) !>
            }
            ir_emit_gc_property_update(ir, value, owner_value, address, result) !>
            return
        }
    }

    let address = ir_emit_address(ir, left) !>
    let result = ir_emit_value(ir, right) !>
    let op = value.op.@cast(ASSIGN_OP)
    if op != ASSIGN_OP.set {
        let old = ir.var()
        let type = ir_type(left.rett) !>
        ir.line(old + " = load " + type + ", ptr " + address)
        result = ir_emit_binary(ir, old, result, assign_value_op(op), left.rett) !>
    }
    // When assigning to a shared global with a GC type, mark the value's
    // object graph as shared before the store so the collector treats it
    // correctly across threads.
    if left.type == VAL.global && left.rett.is_gc_type() {
        let g = left.global
        if isset(g) && g.shared {
            ir_emit_gc_share_null_check(ir, value, result) !>
        }
    }
    ir.line("store " + (ir_type(left.rett) !>) + " " + result + ", ptr " + address)
    if left.type == VAL.decl {
        let decl = left.decl
        if isset(decl) : ir_sync_closure_root(ir, decl, result) !>
    }
}

fn ir_emit_gc_property_update(ir: IRFunc, value: Value, owner: String, address: String, result: String) !Error {
    let idf = valk_idf(ir.func.ns.build, "gc", "property_update") !>
    let update = idf.func
    if !isset(update) : value.bug("gc:property_update is not a function")
    if !update.parsed_types : parse_func_types(update) !>
    ir_use_func(ir, update)
    ir.line("call void @\"" + func_ir_name(update) + "\"(ptr " + owner + ", ptr " + address + ", ptr " + result + ")")
}

fn ir_emit_gc_share_null_check(ir: IRFunc, value: Value, result: String) !Error {
    let idf = valk_idf(ir.func.ns.build, "gc", "share_null_check") !>
    let func = idf.func
    if !isset(func) : value.bug("gc:share_null_check is not a function")
    if !func.parsed_types : parse_func_types(func) !>
    ir_use_func(ir, func)
    ir.line("call void @\"" + func_ir_name(func) + "\"(ptr " + result + ")")
}

fn assign_value_op(op: ASSIGN_OP) VALUE_OP {
    if op == ASSIGN_OP.add : return VALUE_OP.add
    if op == ASSIGN_OP.sub : return VALUE_OP.sub
    if op == ASSIGN_OP.mul : return VALUE_OP.mul
    if op == ASSIGN_OP.div : return VALUE_OP.div
    if op == ASSIGN_OP.mod : return VALUE_OP.mod
    if op == ASSIGN_OP.bit_and : return VALUE_OP.bit_and
    if op == ASSIGN_OP.bit_or : return VALUE_OP.bit_or
    return VALUE_OP.bit_xor
}

fn ir_emit_address(ir: IRFunc, value: Value) String !Error {
    if value.type == VAL.decl {
        let decl = value.decl
        if !isset(decl) : value.bug("IR declaration value is missing its Decl")
        if decl.ir_name == "-nameless-" || decl.ir_name.starts_with("\%.") || decl.ir_name.starts_with("\%capture.") {
            // Captured outer declarations need closure-environment lowering.
            // Materialize a verifier-safe placeholder until that layout exists.
            return ir.captured_address(decl) !>
        }
        return decl.ir_name
    }
    if value.type == VAL.global {
        let global = value.global
        if !isset(global) : value.bug("IR global value is missing its Global")
        ir_use_global(ir, global)
        return "@\"" + global_ir_name(global) + "\""
    }
    if value.type == VAL.prop {
        let on = value.value1
        let prop = value.prop
        if !isset(on) || !isset(prop) : value.bug("IR property value is incomplete")
        let base = (on.rett.type == TYPE.array || on.rett.type == TYPE.inline) ? (ir_emit_address(ir, on) !>) : (ir_emit_value(ir, on) !>)
        let out = ir.var()
        ir.line(out + " = getelementptr i8, ptr " + base + ", i64 " + prop.offset)
        return out
    }
    if value.type == VAL.ptrv {
        let on = value.value1
        let index = value.value2
        if !isset(on) || !isset(index) : value.bug("IR pointer access is incomplete")
        let base = (on.rett.type == TYPE.array || on.rett.type == TYPE.inline) ? (ir_emit_address(ir, on) !>) : (ir_emit_value(ir, on) !>)
        let off = ir_emit_gep_index(ir, index) !>
        let out = ir.var()
        ir.line(out + " = getelementptr " + (ir_type(value.rett) !>) + ", ptr " + base + ", " + off)
        return out
    }
    // Address-taking of a temporary aggregate (for example a fixed-array
    // literal passed to a reference argument) materializes a stack slot.
    let temporary = ir.var()
    let type = ir_type(value.rett) !>
    ir.line(temporary + " = alloca " + type)
    ir.line("store " + type + " " + (ir_emit_value(ir, value) !>) + ", ptr " + temporary)
    return temporary
}

// Emit an index for a getelementptr, as the `<type> <value>` pair it needs.
//
// LLVM reads GEP indices as *signed*, whatever their integer type says, so a
// narrow unsigned index must be widened here rather than handed over as-is:
// `getelementptr i8, ptr %p, i8 200` offsets by -56, not 200. Widening to the
// pointer-sized integer makes the sign of the value the language's business
// again, so both signed and unsigned indices land where they should.
fn ir_emit_gep_index(ir: IRFunc, index: Value) String !Error {
    let value = ir_emit_value(ir, index) !>
    let from = index.rett
    let ptr_bits = ir.func.ns.build.options.target.ptr_size.to(uint) * 8
    if !from.is_integer_type() : return (ir_type(from) !>) + " " + value
    if (from.size() !>).to(uint) * 8 >= ptr_bits : return (ir_type(from) !>) + " " + value

    let to = "i" + ptr_bits
    let inst = from.is_signed_type() ? "sext" : "zext"
    let out = ir.var()
    ir.line(out + " = " + inst + " " + (ir_type(from) !>) + " " + value + " to " + to)
    return to + " " + out
}

fn ir_emit_value(ir: IRFunc, value: Value) String !Error {
    let match_value = ir.match_value
    if isset(match_value) && match_value == value {
        return ir.match_rendered
    }
    let t = value.type
    if t == VAL.error_handler {
        return ir_emit_error_handler(ir, value) !>
    }

    let pre = value.pre_value
    // trim_errors() represents the success projection as a non-fallible clone
    // whose pre_value is the original call. Reuse that call's ABI result rather
    // than issuing the call a second time.
    if t == VAL.call && !value.can_error && isset(pre) && pre.type == VAL.call && pre.can_error {
        let raw = ir.cached_error_result(pre) ?? (ir_emit_value(ir, pre) !>)
        return ir_extract_error_success(ir, raw, pre.rett) !>
    }
    if isset(pre) : ir_emit_stmt(ir, pre) !>

    if t == VAL.int {
        if ir_is_tagged_nullable(value.rett) {
            return ir_build_tagged_nullable(ir, value.rett, value.int_val) !>
        }
        return value.int_val
    }
    if t == VAL.float {
        // FloatNumber.to_string() defaults to two decimal places. LLVM constants
        // need enough precision to round-trip the parsed f64 value.
        let rendered = value.float_val.to_str(17, false)
        if ir_is_tagged_nullable(value.rett) {
            return ir_build_tagged_nullable(ir, value.rett, rendered) !>
        }
        return rendered
    }
    if t == VAL.bool {
        let rendered = value.bool_val ? "1" : "0"
        if ir_is_tagged_nullable(value.rett) {
            return ir_build_tagged_nullable(ir, value.rett, rendered) !>
        }
        return rendered
    }
    if t == VAL.null : return (ir_type(value.rett) !>) == "ptr" ? "null" : "zeroinitializer"
    if t == VAL.undefined : return "undef"
    if t == VAL.wrap || t == VAL.paren {
        let inner = value.value1
        if !isset(inner) : value.bug("IR wrapped value is missing its child")
        if t == VAL.wrap && value.rett.type == TYPE.fnptr && inner.type == VAL.func {
            let func = inner.func
            if isset(func) && !func_has_captures(func) {
                ir_note_unknown_code(ir)
                if func.is_literal {
                    return "@\"" + (ir_emit_fnptr_adapter(ir, value, func) !>) + "\""
                }
                ir_use_func(ir, func)
                return "@\"" + func_ir_name(func) + "\""
            }
        }
        if t == VAL.wrap && value.rett.type == TYPE.fn && inner.rett.type == TYPE.fnptr {
            return ir_emit_fnptr_closure(ir, value, inner) !>
        }
        if t == VAL.wrap && ir_is_tagged_nullable(value.rett) {
            let rendered = ir_emit_value(ir, inner) !>
            if ir_is_tagged_nullable(inner.rett) : return rendered
            return ir_build_tagged_nullable(ir, value.rett, rendered) !>
        }
        if t == VAL.wrap && ir_is_tagged_nullable(inner.rett) && !value.rett.is_nullable_type() {
            let rendered = ir_emit_value(ir, inner) !>
            return ir_extract_tagged_nullable_value(ir, rendered, inner.rett) !>
        }
        return ir_emit_value(ir, inner) !>
    }
    if t == VAL.decl || t == VAL.global || t == VAL.ptrv {
        let address = ir_emit_address(ir, value) !>
        let out = ir.var()
        ir.line(out + " = load " + (ir_type(value.rett) !>) + ", ptr " + address)
        // A captured declaration is physically a property of the closure
        // environment. Unlike an ordinary local/global slot, the collector
        // may tag that property in place.
        if t == VAL.decl && value.rett.is_gc_type() {
            let decl = value.decl
            if isset(decl) && ir.func.capture_decls.contains(decl) {
                let as_int = ir.var()
                ir.line(as_int + " = ptrtoint ptr " + out + " to i64")
                let masked = ir.var()
                ir.line(masked + " = and i64 " + as_int + ", -4")
                let clean = ir.var()
                ir.line(clean + " = inttoptr i64 " + masked + " to ptr")
                return clean
            }
        }
        return out
    }
    if t == VAL.prop {
        let address = ir_emit_address(ir, value) !>
        let out = ir.var()
        ir.line(out + " = load " + (ir_type(value.rett) !>) + ", ptr " + address)
        // GC-tracked properties carry ownership tag bits (prop_owned /
        // prop_co_owned, see lib/src/gc/gc-data.valk) written in place by
        // the collector's marking pass (lib/src/gc/marking.valk). Every read
        // must mask them off before the value is used as a real pointer.
        let prop = value.prop
        if isset(prop) && prop.type.is_gc_type() {
            let as_int = ir.var()
            ir.line(as_int + " = ptrtoint ptr " + out + " to i64")
            let masked = ir.var()
            ir.line(masked + " = and i64 " + as_int + ", -4")
            let clean = ir.var()
            ir.line(clean + " = inttoptr i64 " + masked + " to ptr")
            return clean
        }
        // A closure property stores its managed environment in aggregate
        // element 1. The collector tags that pointer just like an ordinary
        // class property, while element 0 remains the function pointer.
        if isset(prop) && prop.type.get_non_nullable().type == TYPE.fn {
            let func = ir.var()
            ir.line(func + " = extractvalue { ptr, ptr } " + out + ", 0")
            let environment = ir.var()
            ir.line(environment + " = extractvalue { ptr, ptr } " + out + ", 1")
            let as_int = ir.var()
            ir.line(as_int + " = ptrtoint ptr " + environment + " to i64")
            let masked = ir.var()
            ir.line(masked + " = and i64 " + as_int + ", -4")
            let clean_environment = ir.var()
            ir.line(clean_environment + " = inttoptr i64 " + masked + " to ptr")
            let clean = ir.var()
            ir.line(clean + " = insertvalue { ptr, ptr } undef, ptr " + func + ", 0")
            let complete = ir.var()
            ir.line(complete + " = insertvalue { ptr, ptr } " + clean + ", ptr " + clean_environment + ", 1")
            return complete
        }
        return out
    }
    if t == VAL.ptr_of {
        let inner = value.value1
        if !isset(inner) : value.bug("IR @ref is missing its value")
        return ir_emit_address(ir, inner) !>
    }
    if t == VAL.ptr_offset {
        let on = value.value1
        let offset = value.value2
        if !isset(on) || !isset(offset) : value.bug("IR pointer offset is incomplete")
        let base = ir_emit_value(ir, on) !>
        let amount = ir_emit_gep_index(ir, offset) !>
        let out = ir.var()
        ir.line(out + " = getelementptr i8, ptr " + base + ", " + amount)
        return out
    }
    if t == VAL.load {
        let on = value.value1
        if !isset(on) : value.bug("IR load is missing its pointer")
        let address = ir_emit_value(ir, on) !>
        let out = ir.var()
        ir.line(out + " = load " + (ir_type(value.rett) !>) + ", ptr " + address)
        return out
    }
    if t == VAL.op {
        let left = value.value1
        let right = value.value2
        if !isset(left) : value.bug("IR operator is missing its left operand")
        // ++/-- are represented as an op with no right child.
        if !isset(right) {
            let address = ir_emit_address(ir, left) !>
            let old = ir.var()
            let type = ir_type(left.rett) !>
            ir.line(old + " = load " + type + ", ptr " + address)
            let next = ir_emit_binary(ir, old, "1", value.op.@cast(VALUE_OP), left.rett) !>
            ir.line("store " + type + " " + next + ", ptr " + address)
            return value.bool_val ? next : old
        }
        let op = value.op.@cast(VALUE_OP)
        if op == VALUE_OP.and || op == VALUE_OP.or {
            return ir_emit_short_circuit(ir, left, right, op) !>
        }
        return ir_emit_binary(ir, ir_emit_value(ir, left) !>, ir_emit_value(ir, right) !>, op, left.rett) !>
    }
    if t == VAL.unary {
        let inner = value.value1
        if !isset(inner) : value.bug("IR unary operator is missing its operand")
        let val = ir_emit_value(ir, inner) !>
        let op = value.op.@cast(VALUE_OP)
        if op == VALUE_OP.not {
            let out = ir.var()
            ir.line(out + " = xor i1 " + val + ", true")
            return out
        }
        if op == VALUE_OP.neg {
            let out = ir.var()
            let type = ir_type(inner.rett) !>
            let inst = inner.rett.is_float_type() ? "fsub" : "sub"
            ir.line(out + " = " + inst + " " + type + " 0, " + val)
            return out
        }
        let out = ir.var()
        ir.line(out + " = xor " + (ir_type(inner.rett) !>) + " " + val + ", -1")
        return out
    }
    if t == VAL.cast {
        let inner = value.value1
        if !isset(inner) : value.bug("IR cast is missing its operand")
        // Aggregate-to-pointer casts take the aggregate's address. Numeric
        // pointer casts are actual inttoptr conversions; returning the address
        // of an integer temporary leaks a stack pointer as the runtime value.
        if value.rett.is_pointer_sized() && !inner.rett.is_pointer_sized() && !inner.rett.is_integer_type() {
            return ir_emit_address(ir, inner) !>
        }
        return ir_emit_cast(ir, ir_emit_value(ir, inner) !>, inner.rett, value.rett) !>
    }
    if t == VAL.call {
        return ir_emit_call(ir, value) !>
    }
    if t == VAL.co {
        return ir_emit_co(ir, value) !>
    }
    if t == VAL.await {
        return ir_emit_await(ir, value) !>
    }
    if t == VAL.isset {
        return ir_emit_isset(ir, value) !>
    }
    if t == VAL.this_or_that {
        return ir_emit_this_or_that(ir, value) !>
    }
    if t == VAL.match {
        return ir_emit_match(ir, value) !>
    }
    if t == VAL.atomic_op {
        return ir_emit_atomic_op(ir, value) !>
    }
    if t == VAL.atomic_store {
        return ir_emit_atomic_store(ir, value) !>
    }
    if t == VAL.atomic_load {
        return ir_emit_atomic_load(ir, value) !>
    }
    if t == VAL.assign {
        ir_emit_assign(ir, value) !>
        return "undef"
    }
    if t == VAL.multi {
        return ir_emit_multi(ir, value) !>
    }
    if t == VAL.array_init {
        return ir_emit_array_init(ir, value) !>
    }
    if t == VAL.class_init {
        return ir_emit_class_init(ir, value) !>
    }
    if t == VAL.error_value {
        let et = value.rett.get_non_nullable().error_type
        if !isset(et) : value.bug("IR error value has no ErrorType")
        let payload = value.values
        if isset(payload) {
            each payload as field {
                let global = et.payload_globals.get(field.name) !? null
                if !isset(global) : value.bug("Error payload global is missing: " + et.name + "." + field.name)
                ir_use_global(ir, global)
                let rendered = ir_emit_value(ir, field) !>
                ir.line("store " + (ir_type(field.rett) !>) + " " + rendered + ", ptr @\"" + global_ir_name(global) + "\"")
            }
        }
        return helper:ctxhash_u32(value.string_val).to(int)
    }
    if t == VAL.memcpy {
        let values = value.values
        if isset(values) && values.length == 3 {
            let from = values.get(0) !? null
            let to = values.get(1) !? null
            let len = values.get(2) !? null
            if isset(from) && isset(to) && isset(len) {
                let from_ir = ir_emit_value(ir, from) !>
                let to_ir = ir_emit_value(ir, to) !>
                let len_ir = ir_emit_value(ir, len) !>
                ir.line_start()
                ir.write("call void @llvm.memcpy.p0.p0.i64(ptr ")
                ir.write(to_ir)
                ir.write(", ptr ")
                ir.write(from_ir)
                ir.write(", i64 ")
                ir.write(len_ir)
                ir.write(", i1 false)")
                ir.line_end()
            }
        }
        return "undef"
    }
    if t == VAL.vscope {
        return ir_emit_vscope(ir, value) !>
    }
    if t == VAL.block {
        ir_emit_values(ir, value.values) !>
        let result = value.value1
        if isset(result) : return ir_emit_value(ir, result) !>
        return "undef"
    }
    if t == VAL.property_meta {
        let runtime_value = value.value1
        if isset(runtime_value) : return ir_emit_value(ir, runtime_value) !>
    }
    if t == VAL.string || t == VAL.property_meta {
        let index = ir_use_string(ir, value.string_val)
        let out = ir.var()
        ir.line(out + " = getelementptr i8, ptr @\"valk.str." + index + "\", i64 8")
        return out
    }
    if t == VAL.func {
        let func = value.func
        if !isset(func) : value.bug("IR function value has no resolved function")
        // Reached only in value position — ir_emit_call renders a direct call
        // target itself.
        ir_note_unknown_code(ir)
        ir_use_func(ir, func)
        if value.rett.type == TYPE.fn {
            return ir_emit_closure(ir, value, func) !>
        }
        return "@\"" + func_ir_name(func) + "\""
    }

    value.bug("Value kind reached IR without lowering: " + t)
}

fn ir_emit_atomic_op(ir: IRFunc, value: Value) String !Error {
    let left = value.value1
    let right = value.value2
    if !isset(left) || !isset(right) : value.bug("IR atomic operation is missing an operand")

    let op = value.op.@cast(VALUE_OP)
    let instruction = ""
    if op == VALUE_OP.add : instruction = left.rett.is_float_type() ? "fadd" : "add"
    else if op == VALUE_OP.sub : instruction = left.rett.is_float_type() ? "fsub" : "sub"
    else if op == VALUE_OP.bit_and : instruction = "and"
    else if op == VALUE_OP.bit_or : instruction = "or"
    else if op == VALUE_OP.bit_xor : instruction = "xor"
    else : value.bug("Unsupported atomic operation")

    let address = ir_emit_address(ir, left) !>
    let rendered = ir_emit_value(ir, right) !>
    let out = ir.var()
    ir.line_start()
    ir.write(out)
    ir.write(" = atomicrmw ")
    ir.write(instruction)
    ir.write(" ptr ")
    ir.write(address)
    ir.write(", ")
    ir.write(ir_type(left.rett) !>)
    ir.write(" ")
    ir.write(rendered)
    ir.write(" seq_cst, align ")
    ir.write_uint(ir_atomic_align(left.rett) !>)
    ir.line_end()
    return out
}

fn ir_emit_atomic_store(ir: IRFunc, value: Value) String !Error {
    let left = value.value1
    let right = value.value2
    if !isset(left) || !isset(right) : value.bug("IR atomic store is missing an operand")

    let address = ir_emit_address(ir, left) !>
    let rendered = ir_emit_value(ir, right) !>
    ir.line_start()
    ir.write("store atomic ")
    ir.write(ir_type(left.rett) !>)
    ir.write(" ")
    ir.write(rendered)
    ir.write(", ptr ")
    ir.write(address)
    ir.write(" release, align ")
    ir.write_uint(ir_atomic_align(left.rett) !>)
    ir.line_end()
    return rendered
}

fn ir_emit_atomic_load(ir: IRFunc, value: Value) String !Error {
    let left = value.value1
    if !isset(left) : value.bug("IR atomic load is missing its value")

    let address = ir_emit_address(ir, left) !>
    let out = ir.var()
    ir.line_start()
    ir.write(out)
    ir.write(" = load atomic ")
    ir.write(ir_type(left.rett) !>)
    ir.write(", ptr ")
    ir.write(address)
    ir.write(" acquire, align ")
    ir.write_uint(ir_atomic_align(left.rett) !>)
    ir.line_end()
    return out
}

fn ir_atomic_align(type: Type) u32 !Error {
    let size = type.size() !>
    let ptr_size = type.build.options.target.ptr_size.to(u32)
    if size >= ptr_size : return ptr_size
    return 4
}

fn ir_emit_match(ir: IRFunc, value: Value) String !Error {
    let on = value.value1
    let cases = value.values
    if !isset(on) || !isset(cases) : value.bug("IR match is incomplete")

    let rendered_on = ir_emit_value(ir, on) !>
    let previous_match_value = ir.match_value
    let previous_match_rendered = ir.match_rendered
    ir.match_value = on
    ir.match_rendered = rendered_on

    let after = ir.block("match.after")
    let results = Array[String]{}
    let predecessors = Array[String]{}
    let found_default = false

    each cases as case_value, i {
        let cond = case_value.value1
        let is_default = case_value.bool_val
        let body_block = ir.block("match.case")
        if is_default {
            found_default = true
            // The current block is already the unmatched path from the
            // preceding condition. Keep the extra case label only when this
            // is the first arm.
            if i == 0 {
                ir.jump(body_block)
                ir.label(body_block)
            }
        } else {
            if !isset(cond) : case_value.bug("Non-default match case has no condition")
            let next = ir.block("match.next")
            let rendered_cond = ir_emit_value(ir, cond) !>
            ir.cond_jump(rendered_cond, body_block, next)
            ir.label(body_block)
            ir_emit_match_case(ir, value, case_value, after, results, predecessors) !>
            ir.label(next)
            continue
        }
        ir_emit_match_case(ir, value, case_value, after, results, predecessors) !>
    }

    ir.match_value = previous_match_value
    ir.match_rendered = previous_match_rendered
    if !found_default : value.bug("IR match has no default case")

    ir.label(after)
    if value.rett.is_void_type() {
        if predecessors.length == 0 {
            ir.line("unreachable")
            ir.terminated = true
        }
        return ""
    }
    if results.length == 0 {
        ir.line("unreachable")
        ir.terminated = true
        return "undef"
    }
    if results.length == 1 : return results.get(0) !? "undef"

    let out = ir.var()
    ir.line_start()
    ir.write(out)
    ir.write(" = phi ")
    ir.write(ir_type(value.rett) !>)
    ir.write(" ")
    each results as result, i {
        if i > 0 : ir.write(", ")
        ir.write("[ ")
        ir.write(result)
        ir.write(", \%")
        ir.write(predecessors.get(i) !? "")
        ir.write(" ]")
    }
    ir.line_end()
    return out
}

fn ir_emit_match_case(
    ir: IRFunc,
    match_value: Value,
    case_value: Value,
    after: String,
    results: Array[String],
    predecessors: Array[String]
) !Error {
    if match_value.rett.is_void_type() {
        ir_emit_values(ir, case_value.values) !>
        if !ir.terminated : predecessors.append(ir.current_block)
    } else {
        let result = case_value.value2
        if !isset(result) : case_value.bug("Value-returning match case has no result")
        let rendered = ir_emit_value(ir, result) !>
        rendered = ir_emit_cast(ir, rendered, result.rett, match_value.rett) !>
        if !ir.terminated {
            results.append(rendered)
            predecessors.append(ir.current_block)
        }
    }
    ir.jump(after)
}

fn ir_emit_isset(ir: IRFunc, value: Value) String !Error {
    let on = value.value1
    if !isset(on) : value.bug("IR isset is missing its operand")

    // Error handlers use VAL.isset as their internal has-error condition.
    // Keep this path usable independently as well as through
    // ir_emit_error_handler.
    if value.name == "has_error" {
        let raw = ir.cached_error_result(on) ?? (ir_emit_value(ir, on) !>)
        ir.cache_error_result(on, raw)
        let code = ir_extract_error_code(ir, raw, on.rett) !>
        let out = ir.var()
        ir.line_start()
        ir.write(out)
        ir.write(" = icmp ne i32 ")
        ir.write(code)
        ir.write(", 0")
        ir.line_end()
        return out
    }

    let rendered = ir_emit_value(ir, on) !>
    let type = on.rett.get_non_nullable()
    let lowered = ir_type(on.rett) !>
    let out = ir.var()
    if ir_is_tagged_nullable(on.rett) {
        ir.line_start()
        ir.write(out)
        ir.write(" = extractvalue ")
        ir.write(lowered)
        ir.write(" ")
        ir.write(rendered)
        ir.write(", 0")
        ir.line_end()
        return out
    }
    if type.type == TYPE.fn {
        let target = ir.var()
        ir.line_start()
        ir.write(target)
        ir.write(" = extractvalue ")
        ir.write(lowered)
        ir.write(" ")
        ir.write(rendered)
        ir.write(", 0")
        ir.line_end()
        ir.line_start()
        ir.write(out)
        ir.write(" = icmp ne ptr ")
        ir.write(target)
        ir.write(", null")
        ir.line_end()
        return out
    }
    ir.line_start()
    ir.write(out)
    if type.is_pointer_sized() {
        ir.write(" = icmp ne ptr ")
        ir.write(rendered)
        ir.write(", null")
    } else if type.is_float_type() {
        ir.write(" = fcmp one ")
        ir.write(lowered)
        ir.write(" ")
        ir.write(rendered)
        ir.write(", 0.0")
    } else if type.is_integer_type() || type.is_bool_type() || type.type == TYPE.error_code {
        ir.write(" = icmp ne ")
        ir.write(lowered)
        ir.write(" ")
        ir.write(rendered)
        ir.write(", 0")
    } else {
        value.bug("IR isset cannot test nullable type: " + on.rett.compat_display_name())
    }
    ir.line_end()
    return out
}

fn ir_build_tagged_nullable(ir: IRFunc, type: Type, value: String) String !Error {
    let lowered = ir_type(type) !>
    let inner = type.get_non_nullable()
    let with_tag = ir.var()
    ir.line_start()
    ir.write(with_tag)
    ir.write(" = insertvalue ")
    ir.write(lowered)
    ir.write(" undef, i1 true, 0")
    ir.line_end()
    let out = ir.var()
    ir.line_start()
    ir.write(out)
    ir.write(" = insertvalue ")
    ir.write(lowered)
    ir.write(" ")
    ir.write(with_tag)
    ir.write(", ")
    ir.write(ir_type(inner) !>)
    ir.write(" ")
    ir.write(value)
    ir.write(", 1")
    ir.line_end()
    return out
}

fn ir_extract_tagged_nullable_value(ir: IRFunc, value: String, type: Type) String !Error {
    let out = ir.var()
    ir.line_start()
    ir.write(out)
    ir.write(" = extractvalue ")
    ir.write(ir_type(type) !>)
    ir.write(" ")
    ir.write(value)
    ir.write(", 1")
    ir.line_end()
    return out
}

fn ir_emit_this_or_that(ir: IRFunc, value: Value) String !Error {
    let cond = value.value1
    let then_value = value.value2
    let else_values = value.values
    if !isset(cond) || !isset(then_value) || !isset(else_values) {
        value.bug("IR conditional value is incomplete")
    }
    let else_value = else_values.get(0) !? null
    if !isset(else_value) : value.bug("IR conditional value has no else value")

    let rendered_cond = ir_emit_value(ir, cond) !>
    let then_block = ir.block("this_or_that.then")
    let else_block = ir.block("this_or_that.else")
    let after_block = ir.block("this_or_that.after")
    ir.cond_jump(rendered_cond, then_block, else_block)

    ir.label(then_block)
    let rendered_then = ir_emit_value(ir, then_value) !>
    rendered_then = ir_emit_cast(ir, rendered_then, then_value.rett, value.rett) !>
    let then_reaches_after = !ir.terminated
    let then_predecessor = ir.current_block
    ir.jump(after_block)

    ir.label(else_block)
    let rendered_else = ir_emit_value(ir, else_value) !>
    rendered_else = ir_emit_cast(ir, rendered_else, else_value.rett, value.rett) !>
    let else_reaches_after = !ir.terminated
    let else_predecessor = ir.current_block
    ir.jump(after_block)

    ir.label(after_block)
    if then_reaches_after && else_reaches_after {
        let out = ir.var()
        ir.line_start()
        ir.write(out)
        ir.write(" = phi ")
        ir.write(ir_type(value.rett) !>)
        ir.write(" [ ")
        ir.write(rendered_then)
        ir.write(", \%")
        ir.write(then_predecessor)
        ir.write(" ], [ ")
        ir.write(rendered_else)
        ir.write(", \%")
        ir.write(else_predecessor)
        ir.write(" ]")
        ir.line_end()
        return out
    }
    if then_reaches_after : return rendered_then
    if else_reaches_after : return rendered_else
    return "undef"
}

fn ir_emit_vscope(ir: IRFunc, value: Value) String !Error {
    let cached = ir.cached_vscope(value)
    if isset(cached) : return cached

    let after = ir.block("vscope.after")
    let old_after = ir.vscope_after
    let old_results = ir.vscope_results
    let old_blocks = ir.vscope_blocks
    let results = Array[String]{}
    let blocks = Array[String]{}
    ir.vscope_after = after
    ir.vscope_results = results
    ir.vscope_blocks = blocks

    ir_emit_values(ir, value.values) !>
    if !ir.terminated : ir.jump(after)
    ir.label(after)

    ir.vscope_after = old_after
    ir.vscope_results = old_results
    ir.vscope_blocks = old_blocks

    if results.length == 0 {
        ir.cache_vscope(value, "undef")
        return "undef"
    }
    if results.length == 1 {
        let only = results.get(0) !? "undef"
        ir.cache_vscope(value, only)
        return only
    }
    let out = ir.var()
    ir.line_start()
    ir.write(out)
    ir.write(" = phi ")
    ir.write(ir_type(value.rett) !>)
    ir.write(" ")
    each results as result, i {
        if i > 0 : ir.write(", ")
        ir.write("[ ")
        ir.write(result)
        ir.write(", \%")
        ir.write(blocks.get(i) !? "")
        ir.write(" ]")
    }
    ir.line_end()
    ir.cache_vscope(value, out)
    return out
}

fn ir_extract_error_code(ir: IRFunc, raw: String, rett: Type) String !Error {
    let count = ir_normal_rett_count(rett)
    if count == 0 : return raw
    let out = ir.var()
    ir.line_start()
    ir.write(out)
    ir.write(" = extractvalue ")
    ir.write(ir_error_abi_type(rett) !>)
    ir.write(" ")
    ir.write(raw)
    ir.write(", ")
    ir.write_uint(count)
    ir.line_end()
    return out
}

fn ir_extract_error_success(ir: IRFunc, raw: String, rett: Type) String !Error {
    if rett.is_void_type() : return ""
    let abi = ir_error_abi_type(rett) !>
    if rett.type != TYPE.multi {
        let out = ir.var()
        ir.line_start()
        ir.write(out)
        ir.write(" = extractvalue ")
        ir.write(abi)
        ir.write(" ")
        ir.write(raw)
        ir.write(", 0")
        ir.line_end()
        return out
    }
    let subs = rett.sub_types
    if !isset(subs) : rett.build.bug("Fallible multi return is missing subtypes")
    let current = "undef"
    each subs as sub, i {
        let part = ir.var()
        ir.line(part + " = extractvalue " + abi + " " + raw + ", " + i)
        let next = ir.var()
        ir.line(next + " = insertvalue " + (ir_type(rett) !>) + " " + current + ", " + (ir_type(sub) !>) + " " + part + ", " + i)
        current = next
    }
    return current
}

fn ir_store_caught_error(ir: IRFunc, value: Value, code: String) !Error {
    let decl = value.decl
    if !isset(decl) : return
    ir.line_start()
    ir.write("store i32 ")
    ir.write(code)
    ir.write(", ptr ")
    ir.write(decl.ir_name)
    ir.line_end()

    let payloads = decl.error_payloads
    let pre = value.pre_value
    let error_type: ?ErrorType = null
    if isset(pre) : error_type = pre.error_type
    if !isset(payloads) || !isset(error_type) : return
    each payloads as payload_decl, name {
        let global = error_type.payload_globals.get(name) !? null
        if !isset(global) : continue
        ir_use_global(ir, global)
        let type = ir_type(payload_decl.type) !>
        let loaded = ir.var()
        ir.line(loaded + " = load " + type + ", ptr @\"" + global_ir_name(global) + "\"")
        ir.line("store " + type + " " + loaded + ", ptr " + payload_decl.ir_name)
    }
}

fn ir_error_default(ir: IRFunc, type: Type) String !Error {
    let string_class = type_string(ir.func.ns.build).get_class_or_null()
    let class = type.get_class_or_null()
    if isset(string_class) && class == string_class {
        let index = ir_use_string(ir, "")
        let out = ir.var()
        ir.line_start()
        ir.write(out)
        ir.write(" = getelementptr i8, ptr @\"valk.str.")
        ir.write_uint(index)
        ir.write("\", i64 8")
        ir.line_end()
        return out
    }
    if type.is_pointer_sized() : return "null"
    return "zeroinitializer"
}

fn ir_default_pass_payloads(ir: IRFunc, value: Value, from: ?ErrorType, to: ?ErrorType) !Error {
    if !isset(to) : return
    each to.payload as ptype, name {
        if isset(from) && from.payload.has(name) : continue
        let global = to.payload_globals.get(name) !? null
        if !isset(global) : value.bug("Error payload global is missing: " + to.name + "." + name)
        ir_use_global(ir, global)
        let fallback = ir_error_default(ir, ptype) !>
        ir.line_start()
        ir.write("store ")
        ir.write(ir_type(ptype) !>)
        ir.write(" ")
        ir.write(fallback)
        ir.write(", ptr @\"")
        ir.write(global_ir_name(global))
        ir.write("\"")
        ir.line_end()
    }
}

fn ir_emit_error_panic(ir: IRFunc, value: Value) !Error {
    let idf = valk_idf(ir.func.ns.build, "core", "panic") !>
    let panic_func = idf.func
    if !isset(panic_func) : value.bug("core:panic is not a function")
    if !panic_func.parsed_types : parse_func_types(panic_func) !>
    ir_use_func(ir, panic_func)
    let index = ir_use_string(ir, "Unhandled error")
    let msg = ir.var()
    ir.line_start()
    ir.write(msg)
    ir.write(" = getelementptr i8, ptr @\"valk.str.")
    ir.write_uint(index)
    ir.write("\", i64 8")
    ir.line_end()
    ir_emit_func_cleanup(ir) !>
    ir.line_start()
    ir.write("call void @\"")
    ir.write(func_ir_name(panic_func))
    ir.write("\"(ptr ")
    ir.write(msg)
    ir.write(")")
    ir.line_end()
    ir.line("unreachable")
    ir.terminated = true
}

fn ir_emit_error_handler(ir: IRFunc, value: Value) String !Error {
    let call = value.pre_value
    if !isset(call) : value.bug("IR error handler is missing its fallible value")
    let raw = ir.cached_error_result(call) ?? (ir_emit_value(ir, call) !>)
    ir.cache_error_result(call, raw)
    let call_rett = call.rett
    let code = ir_extract_error_code(ir, raw, call_rett) !>
    let success_value = ir_extract_error_success(ir, raw, call_rett) !>
    let has_error = ir.var()
    ir.line_start()
    ir.write(has_error)
    ir.write(" = icmp ne i32 ")
    ir.write(code)
    ir.write(", 0")
    ir.line_end()

    let error_block = ir.block("error")
    let success_block = ir.block("success")
    let after_block = ir.block("error.after")
    ir.cond_jump(has_error, error_block, success_block)

    let kind = value.op.@cast(ERRH_KIND)
    let error_result = ""
    let error_reaches_after = false
    let error_predecessor = error_block
    ir.label(error_block)
    ir_store_caught_error(ir, value, code) !>
    if kind == ERRH_KIND.pass {
        ir_default_pass_payloads(ir, value, call.error_type, ir.func.error_type) !>
        ir_emit_func_cleanup(ir) !>
        ir_emit_error_return(ir, "undef", ir.func.get_rett(), code) !>
        ir.terminated = true
    } else if kind == ERRH_KIND.panic {
        ir_emit_error_panic(ir, value) !>
    } else if kind == ERRH_KIND.value {
        let handler = value.value2
        if !isset(handler) : value.bug("Error value handler is missing its fallback")
        error_result = ir_emit_value(ir, handler) !>
        error_result = ir_emit_cast(ir, error_result, handler.rett, value.rett) !>
        error_reaches_after = !ir.terminated
        error_predecessor = ir.current_block
        ir.jump(after_block)
    } else if kind == ERRH_KIND.block {
        let handler = value.value2
        if isset(handler) : ir_emit_stmt(ir, handler) !>
        error_reaches_after = !ir.terminated
        ir.jump(after_block)
    } else {
        // Ignore and success-handler forms both continue on error.
        error_reaches_after = true
        ir.jump(after_block)
    }

    ir.label(success_block)
    let success_result = success_value
    if kind == ERRH_KIND.value {
        success_result = ir_emit_cast(ir, success_result, call_rett, value.rett) !>
    }
    if kind == ERRH_KIND.success {
        let handler = value.value2
        if isset(handler) : ir_emit_stmt(ir, handler) !>
    }
    let success_reaches_after = !ir.terminated
    let success_predecessor = ir.current_block
    ir.jump(after_block)

    ir.label(after_block)
    if value.rett.is_void_type() : return ""
    if kind == ERRH_KIND.value && error_reaches_after && success_reaches_after {
        let out = ir.var()
        ir.line_start()
        ir.write(out)
        ir.write(" = phi ")
        ir.write(ir_type(value.rett) !>)
        ir.write(" [ ")
        ir.write(error_result)
        ir.write(", \%")
        ir.write(error_predecessor)
        ir.write(" ], [ ")
        ir.write(success_result)
        ir.write(", \%")
        ir.write(success_predecessor)
        ir.write(" ]")
        ir.line_end()
        return out
    }
    return success_result
}

fn ir_emit_array_init(ir: IRFunc, value: Value) String !Error {
    let values = value.values
    if !isset(values) : value.bug("IR fixed-array initializer has no elements")
    let aggregate = "undef"
    let aggregate_type = ir_is_tagged_nullable(value.rett) ? value.rett.get_non_nullable() : value.rett
    let whole = ir_type(aggregate_type) !>
    each values as item, i {
        let item_value = ir_emit_value(ir, item) !>
        let out = ir.var()
        ir.line(out + " = insertvalue " + whole + " " + aggregate + ", " + (ir_type(item.rett) !>) + " " + item_value + ", " + i)
        aggregate = out
    }
    if ir_is_tagged_nullable(value.rett) {
        return ir_build_tagged_nullable(ir, value.rett, aggregate) !>
    }
    return aggregate
}

fn ir_emit_class_init(ir: IRFunc, value: Value) String !Error {
    // Hook-based collection initializers carry their constructed object in
    // value1 and the append/set calls in values.
    let base = value.value1
    if isset(base) {
        let hooks = value.values
        if isset(hooks) {
            // When a hook returns SELF, value1 is the final call in a nested
            // receiver chain; emitting it also emits every preceding call.
            each hooks as hook {
                if hook == base : return ir_emit_value(ir, base) !>
            }
        }
        let result = ir_emit_value(ir, base) !>
        ir_emit_values(ir, hooks) !>
        return result
    }

    let type = value.rett.get_non_nullable()
    let storage_type = type
    if type.type == TYPE.inline {
        let sub = type.sub_type
        if !isset(sub) : value.bug("Inline class initializer has no subtype")
        storage_type = sub
    }
    let class = value.class_ref ?? storage_type.get_class_or_null()
    if !isset(class) : value.bug("Aggregate class initializer has no class")

    // Evaluate fields first. In particular, a nested GC allocation must happen
    // before the new object exists but has not yet been rooted.
    let fields = value.values
    let rendered = Array[String]{}
    if isset(fields) {
        each fields as field {
            rendered.append(ir_emit_value(ir, field) !>)
        }
    }

    let result_type = ir_is_tagged_nullable(value.rett) ? value.rett.get_non_nullable() : value.rett
    let lowered = ir_type(result_type) !>
    let size = class.compute_body_size() !>
    if size == 0 && lowered == "ptr" : return "null"

    let slot = ""
    if lowered == "ptr" {
        slot = ir_emit_class_alloc(ir, value, class, size) !>
    } else {
        slot = ir.var()
        ir.line(slot + " = alloca " + lowered)
    }
    if size > 0 {
        ir.line("call void @llvm.memset.inline.p0.i64(ptr " + slot + ", i8 0, i64 " + size + ", i1 false)")
    }

    if isset(fields) {
        each fields as field, i {
            let prop: ?Prop = null
            if field.name != "" : prop = class.get_prop_by_name(field.name) !? null
            if !isset(prop) : prop = class.props.get(i) !? null
            if !isset(prop) : value.bug("Cannot match aggregate initializer field to a property")
            let field_value = rendered.get(i) !? "undef"
            let address = ir.var()
            ir.line(address + " = getelementptr i8, ptr " + slot + ", i64 " + prop.offset)
            ir.line("store " + (ir_type(prop.type) !>) + " " + field_value + ", ptr " + address)
        }
    }
    if lowered == "ptr" : return slot

    let out = ir.var()
    ir.line(out + " = load " + lowered + ", ptr " + slot)
    if ir_is_tagged_nullable(value.rett) {
        return ir_build_tagged_nullable(ir, value.rett, out) !>
    }
    return out
}

fn ir_emit_class_alloc(ir: IRFunc, value: Value, class: Class, size: u32) String !Error {
    let allocator = value.allocator
    if isset(allocator) {
        ir_note_allocates(ir)
        let global = allocator.global
        ir_use_global(ir, global)
        let pool_type = global.get_type() !>
        let pool_class = pool_type.get_class_or_null()
        if !isset(pool_class) : value.bug("Generated allocator global is not a Pool")
        let method_name = isset(allocator.onfree) ? "get_vtable" : "get"
        let pool_get = pool_class.get_func(method_name)
        if !isset(pool_get) : value.bug("gc:Pool has no '" + method_name + "' method")
        if !pool_get.parsed_types : parse_func_types(pool_get) !>
        ir_use_func(ir, pool_get)

        let pool = ir.var()
        ir.line(pool + " = load " + (ir_type(pool_type) !>) + ", ptr @\"" + global_ir_name(global) + "\"")
        let result = ir.var()
        ir.line(result + " = call " + (ir_type(pool_get.get_rett()) !>) + " @\"" + func_ir_name(pool_get) + "\"(ptr " + pool + ")")
        return result
    }

    // Structs, slices, and other pointer-backed value wrappers are reference
    // values too, but are not GC-managed and therefore have no Pool allocator.
    if class.kind != CLASS_KIND.class {
        let idf = valk_idf(ir.func.ns.build, "mem", "alloc_ob") !>
        let alloc = idf.func
        if !isset(alloc) : value.bug("mem:alloc_ob is not a function")
        if !alloc.parsed_types : parse_func_types(alloc) !>
        ir_use_func(ir, alloc)
        let result = ir.var()
        ir.line(result + " = call " + (ir_type(alloc.get_rett()) !>) + " @\"" + func_ir_name(alloc) + "\"(i64 " + size + ")")
        return result
    }

    value.bug("GC class initializer has no allocator: " + class.pretty_name())
}

fn ir_emit_closure_adapter(parent: IRFunc, value: Value, func: Func) String !Error {
    let name = "valk.closure.adapter." + func_ir_name(func)
    ir_use_func(parent, func)
    if ir_reuse_adapter(parent, name) : return name
    parent.func.unit.closure_adapters.set(name, parent.func)

    let ir = IRFunc {
        func: parent.func
        code: parent.coro_helpers
    }
    let bound = isset(func.class) && !func.is_static
    ir.code.write_string("define internal ")
    ir.code.write_string(ir_func_rett_type(func) !>)
    ir.code.write_string(" @\"")
    ir.code.write_string(name)
    ir.code.write_string("\"(ptr \%closure.data")
    each func.args as arg, i {
        if bound && i == 0 : continue
        ir.code.write_string(", ")
        ir.code.write_string(ir_type(arg.type) !>)
        ir.code.write_string(" \%arg.")
        ir.code.write_uint_ascii(i)
    }
    ir.code.write_string(") {\n")
    ir.label("entry")

    let receiver = ""
    if bound {
        let class = func.capture_class
        if !isset(class) : value.bug("Bound closure data class is missing")
        let prop = class.props.get(0) !? null
        if !isset(prop) : value.bug("Bound closure receiver property is missing")
        receiver = ir_coro_load_prop(ir, "\%closure.data", prop) !>
    }

    let raw = ""
    let has_result = !func.get_rett().is_void_type() || func.can_error
    ir.line_start()
    if has_result {
        raw = ir.var()
        ir.write(raw)
        ir.write(" = ")
    }
    ir.write("call ")
    ir.write(ir_func_rett_type(func) !>)
    ir.write(" @\"")
    ir.write(func_ir_name(func))
    ir.write("\"(")
    let wrote = false
    each func.args as arg, i {
        if bound && i == 0 {
            ir.write(ir_type(arg.type) !>)
            ir.write(" ")
            ir.write(receiver)
            wrote = true
            continue
        }
        if wrote : ir.write(", ")
        ir.write(ir_type(arg.type) !>)
        ir.write(" \%arg.")
        ir.write_uint(i)
        wrote = true
    }
    ir.write(")")
    ir.line_end()
    if has_result {
        ir.line_start()
        ir.write("ret ")
        ir.write(ir_func_rett_type(func) !>)
        ir.write(" ")
        ir.write(raw)
        ir.line_end()
    } else {
        ir.line("ret void")
    }
    ir.code.write_string("}\n\n")
    return name
}

fn ir_emit_fnptr_adapter(parent: IRFunc, value: Value, func: Func) String !Error {
    let name = "valk.fnptr.adapter." + func_ir_name(func)
    ir_use_func(parent, func)
    if ir_reuse_adapter(parent, name) : return name
    parent.func.unit.closure_adapters.set(name, parent.func)

    let ir = IRFunc {
        func: parent.func
        code: parent.coro_helpers
    }
    ir.code.write_string("define internal ")
    ir.code.write_string(ir_func_rett_type(func) !>)
    ir.code.write_string(" @\"")
    ir.code.write_string(name)
    ir.code.write_string("\"(")
    each func.args as arg, i {
        if i > 0 : ir.code.write_string(", ")
        ir.code.write_string(ir_type(arg.type) !>)
        ir.code.write_string(" \%arg.")
        ir.code.write_uint_ascii(i)
    }
    ir.code.write_string(") {\n")
    ir.label("entry")
    let raw = ""
    let has_result = !func.get_rett().is_void_type() || func.can_error
    ir.line_start()
    if has_result {
        raw = ir.var()
        ir.write(raw)
        ir.write(" = ")
    }
    ir.write("call ")
    ir.write(ir_func_rett_type(func) !>)
    ir.write(" @\"")
    ir.write(func_ir_name(func))
    ir.write("\"(ptr null")
    each func.args as arg, i {
        ir.write(", ")
        ir.write(ir_type(arg.type) !>)
        ir.write(" \%arg.")
        ir.write_uint(i)
    }
    ir.write(")")
    ir.line_end()
    if has_result {
        ir.line_start()
        ir.write("ret ")
        ir.write(ir_func_rett_type(func) !>)
        ir.write(" ")
        ir.write(raw)
        ir.line_end()
    } else {
        ir.line("ret void")
    }
    ir.code.write_string("}\n\n")
    return name
}

fn ir_emit_fnptr_closure(parent: IRFunc, value: Value, inner: Value) String !Error {
    return ir_build_closure_value(parent, value.rett, ir_emit_value(parent, inner) !>, "null") !>
}

fn ir_build_closure_value(ir: IRFunc, type: Type, target: String, data: String) String !Error {
    let first = ir.var()
    ir.line_start()
    ir.write(first)
    ir.write(" = insertvalue ")
    ir.write(ir_type(type) !>)
    ir.write(" undef, ptr ")
    ir.write(target)
    ir.write(", 0")
    ir.line_end()
    let result = ir.var()
    ir.line_start()
    ir.write(result)
    ir.write(" = insertvalue ")
    ir.write(ir_type(type) !>)
    ir.write(" ")
    ir.write(first)
    ir.write(", ptr ")
    ir.write(data)
    ir.write(", 1")
    ir.line_end()
    return result
}

fn ir_emit_closure(ir: IRFunc, value: Value, func: Func) String !Error {
    func_prepare_closure(func) !>
    let class = func.capture_class
    let allocator = func.capture_allocator
    if !isset(class) : value.bug("Closure data class was not prepared")
    let environment = "null"
    if isset(allocator) {
        let alloc_value = Value {
            type: VAL.class_init
            rett: class.get_type() !>
            allocator: allocator
            exp: value.exp
        }
        let size = class.compute_body_size() !>
        environment = ir_emit_class_alloc(ir, alloc_value, class, size) !>
        ir.line_start()
        ir.write("call void @llvm.memset.inline.p0.i64(ptr ")
        ir.write(environment)
        ir.write(", i8 0, i64 ")
        ir.write_uint(size)
        ir.write(", i1 false)")
        ir.line_end()
    }

    let target_name = func_ir_name(func)
    if func.is_literal : ir_use_func(ir, func)
    else : target_name = ir_emit_closure_adapter(ir, value, func) !>

    let capture_base: uint = 0
    let receiver = value.value1
    if isset(receiver) && isset(func.class) && !func.is_static {
        let prop = class.props.get(0) !? null
        if !isset(prop) : value.bug("Bound closure receiver property is missing")
        let rendered = ir_emit_value(ir, receiver) !>
        let address = ir_prop_address(ir, environment, prop)
        ir.line_start()
        ir.write("store ")
        ir.write(ir_type(receiver.rett) !>)
        ir.write(" ")
        ir.write(rendered)
        ir.write(", ptr ")
        ir.write(address)
        ir.line_end()
        capture_base++
    }
    each func.capture_decls as decl, i {
        let prop = class.props.get(i + capture_base) !? null
        if !isset(prop) : value.bug("Closure capture property is missing")
        let rendered = ir_emit_value(ir, vgen_decl(decl)) !>
        let address = ir_prop_address(ir, environment, prop)
        ir.line_start()
        ir.write("store ")
        ir.write(ir_type(decl.type) !>)
        ir.write(" ")
        ir.write(rendered)
        ir.write(", ptr ")
        ir.write(address)
        ir.line_end()
    }
    return ir_build_closure_value(ir, value.rett, "@\"" + target_name + "\"", environment) !>
}

fn ir_emit_call(ir: IRFunc, value: Value) String !Error {
    let callee = value.value1
    if !isset(callee) : value.bug("IR call is missing its callee")
    let args = value.values
    let rendered_types = Array[String]{}
    let rendered_values = Array[String]{}
    let direct_func: ?Func = callee.type == VAL.func ? callee.func : null
    let closure_call = callee.rett.get_non_nullable().type == TYPE.fn && callee.type != VAL.func
    if callee.type == VAL.func {
        let direct_func = callee.func
        if isset(direct_func) && direct_func.is_literal : closure_call = true
    }

    let target = ""
    if closure_call {
        let closure = ir_emit_value(ir, callee) !>
        target = ir.var()
        ir.line_start()
        ir.write(target)
        ir.write(" = extractvalue ")
        ir.write(ir_type(callee.rett) !>)
        ir.write(" ")
        ir.write(closure)
        ir.write(", 0")
        ir.line_end()
        let environment = ir.var()
        ir.line_start()
        ir.write(environment)
        ir.write(" = extractvalue ")
        ir.write(ir_type(callee.rett) !>)
        ir.write(" ")
        ir.write(closure)
        ir.write(", 1")
        ir.line_end()
        rendered_types.append("ptr")
        rendered_values.append(environment)
    }

    // Bound method receiver is the implicit first argument.
    if callee.type == VAL.func {
        let receiver = callee.value1
        if isset(receiver) {
            let expected: ?Type = null
            if isset(direct_func) {
                direct_func.args.get(0) -> func_arg {
                    expected = func_arg.type
                }
            }
            if isset(expected) && ir_call_arg_needs_inline_address(receiver.rett, expected) {
                rendered_types.append(ir_type(expected) !>)
                rendered_values.append(ir_emit_inline_call_address(ir, receiver) !>)
            } else {
                rendered_types.append(ir_type(receiver.rett) !>)
                rendered_values.append(ir_emit_value(ir, receiver) !>)
            }
        }
    }
    if isset(args) {
        each args as arg, i {
            let expected: ?Type = null
            if isset(direct_func) {
                let receiver_offset: uint = isset(callee.value1) ? 1 : 0
                direct_func.args.get(i + receiver_offset) -> func_arg {
                    expected = func_arg.type
                }
            }
            if isset(expected) && ir_call_arg_needs_inline_address(arg.rett, expected) {
                rendered_types.append(ir_type(expected) !>)
                rendered_values.append(ir_emit_inline_call_address(ir, arg) !>)
            } else if isset(expected) && ir_call_arg_needs_raw_function(arg.rett, expected) {
                rendered_types.append(ir_type(expected) !>)
                rendered_values.append(ir_emit_raw_function(ir, arg) !>)
            } else {
                rendered_types.append(ir_type(arg.rett) !>)
                rendered_values.append(ir_emit_value(ir, arg) !>)
            }
        }
    }

    if !closure_call {
        if callee.type == VAL.func {
            let direct_func = callee.func
            if isset(direct_func) {
                ir_use_func(ir, direct_func)
                target = "@\"" + func_ir_name(direct_func) + "\""
            } else {
                ir_note_unknown_code(ir)
                target = ir_emit_value(ir, callee) !>
            }
        } else {
            ir_note_unknown_code(ir)
            target = ir_emit_value(ir, callee) !>
        }
    }
    let exits = false
    let call_type = ir_type(value.rett) !>
    if callee.type == VAL.func {
        let func = callee.func
        if isset(func) {
            exits = func.must_exit || func.will_exit
            call_type = ir_func_rett_type(func) !>
        }
    } else if value.can_error || isset(value.error_type) {
        call_type = ir_error_abi_type(value.rett) !>
    }
    if exits : ir_emit_func_cleanup(ir) !>
    let returns_abi_value = value.can_error || isset(value.error_type)
    let has_result = !value.rett.is_void_type() || returns_abi_value
    let out = ""
    ir.line_start()
    if has_result {
        out = ir.var()
        ir.write(out)
        ir.write(" = ")
    }
    ir.write("call ")
    ir.write(call_type)
    // The callee's variadic function type is significant on Apple ARM64.
    // Without it LLVM treats the call as a non-variadic prototype and passes
    // trailing arguments in registers, while Darwin's variadic ABI expects
    // them on the stack (for example fcntl's third argument and open's mode).
    if isset(direct_func) && direct_func.infinite_args {
        ir.write(" (")
        if direct_func.is_literal : ir.write("ptr")
        each direct_func.args as arg, i {
            if i > 0 || direct_func.is_literal : ir.write(", ")
            ir.write(ir_type(arg.type) !>)
        }
        if direct_func.args.length > 0 || direct_func.is_literal : ir.write(", ")
        ir.write("...)")
    }
    ir.write(" ")
    ir.write(target)
    ir.write("(")
    each rendered_values as rendered, i {
        if i > 0 : ir.write(", ")
        ir.write(rendered_types.get(i) !? "")
        ir.write(" ")
        ir.write(rendered)
    }
    ir.write(")")
    ir.line_end()
    if exits {
        ir.line("unreachable")
        ir.terminated = true
    }
    if !has_result : return ""
    if value.can_error || isset(value.error_type) {
        // A fallible Value can be emitted again in a different short-circuit
        // branch. Keep its success projection tied to the most recently
        // emitted ABI result instead of an earlier, non-dominating call.
        ir.cache_error_result(value, out)
    }
    return out
}

// `<Struct>` is an inline byte aggregate, but passing it to a parameter of
// named type `Struct` passes the address of that storage. Loading the aggregate
// and placing it directly in the call changes the native ABI (and made libc
// write through an unrelated register value for calls such as stat()).
fn ir_call_arg_needs_inline_address(actual: Type, expected: Type) bool {
    if actual.type != TYPE.inline || !expected.is_pointer_sized() : return false
    let actual_class = actual.get_class_or_null()
    let expected_class = expected.get_class_or_null()
    return isset(actual_class) && actual_class == expected_class
}

// Native callback APIs describe their entry point as `ptr`. A Valk `fn` is a
// two-pointer closure value, so passing that aggregate directly gives the
// native ABI the wrong argument (notably pthread_create on arm64). Pass only
// its code pointer; callback context is supplied through the API's separate
// data argument.
fn ir_call_arg_needs_raw_function(actual: Type, expected: Type) bool {
    return actual.get_non_nullable().type == TYPE.fn && expected.get_non_nullable().type == TYPE.ptr
}

fn ir_emit_raw_function(ir: IRFunc, value: Value) String !Error {
    let direct = value_resolve_func_ref(value)
    if isset(direct) && !direct.is_literal {
        ir_use_func(ir, direct)
        return "@\"" + func_ir_name(direct) + "\""
    }

    let closure = ir_emit_value(ir, value) !>
    let function = ir.var()
    ir.line(function + " = extractvalue " + (ir_type(value.rett) !>) + " " + closure + ", 0")
    return function
}

fn ir_emit_inline_call_address(ir: IRFunc, value: Value) String !Error {
    if value.type == VAL.wrap || value.type == VAL.paren {
        let inner = value.value1
        if isset(inner) : return ir_emit_inline_call_address(ir, inner) !>
    }
    if value.type == VAL.decl || value.type == VAL.global || value.type == VAL.prop {
        return ir_emit_address(ir, value) !>
    }

    // Non-lvalue inline expressions still need stable addressable storage for
    // the duration of the call.
    let rendered = ir_emit_value(ir, value) !>
    let slot = ir.var()
    let type = ir_type(value.rett) !>
    ir.line(slot + " = alloca " + type)
    ir.line("store " + type + " " + rendered + ", ptr " + slot)
    return slot
}

fn ir_coro_class(value: Value) Class !Error {
    let idf = valk_idf(value.rett.build, "coro", "Coro") !>
    let class = idf.class
    if !isset(class) : value.bug("coro:Coro is not a class")
    return class
}

fn ir_coro_func(ir: IRFunc, value: Value, class: Class, name: String) Func !Error {
    let func = class.get_func(name)
    if !isset(func) : value.bug("coro:Coro has no function named '" + name + "'")
    if !func.parsed_types : parse_func_types(func) !>
    ir_use_func(ir, func)
    return func
}

fn ir_coro_prop(value: Value, class: Class, name: String) Prop !Error {
    return class.get_prop_by_name(name) ! value.bug("coro:Coro has no property named '" + name + "'")
}

fn ir_prop_address(ir: IRFunc, on: String, prop: Prop) String {
    let address = ir.var()
    ir.line_start()
    ir.write(address)
    ir.write(" = getelementptr i8, ptr ")
    ir.write(on)
    ir.write(", i64 ")
    ir.write_uint(prop.offset)
    ir.line_end()
    return address
}

fn ir_coro_load_prop(ir: IRFunc, coro: String, prop: Prop) String !Error {
    let address = ir_prop_address(ir, coro, prop)
    let result = ir.var()
    ir.line_start()
    ir.write(result)
    ir.write(" = load ")
    ir.write(ir_type(prop.type) !>)
    ir.write(", ptr ")
    ir.write(address)
    ir.line_end()
    // Coro lowering accesses properties directly instead of going through
    // VAL.prop/ir_emit_value. The collector stores ownership tags in managed
    // property pointers, so apply the same cleanup ordinary property reads do.
    if prop.type.is_gc_type() {
        let as_int = ir.var()
        ir.line(as_int + " = ptrtoint ptr " + result + " to i64")
        let masked = ir.var()
        ir.line(masked + " = and i64 " + as_int + ", -4")
        let clean = ir.var()
        ir.line(clean + " = inttoptr i64 " + masked + " to ptr")
        return clean
    }
    // Inline closures are `{ function, environment }`. Their environment is
    // the managed property and may be tagged independently of the function.
    if prop.type.get_non_nullable().type == TYPE.fn {
        let func = ir.var()
        ir.line(func + " = extractvalue { ptr, ptr } " + result + ", 0")
        let environment = ir.var()
        ir.line(environment + " = extractvalue { ptr, ptr } " + result + ", 1")
        let as_int = ir.var()
        ir.line(as_int + " = ptrtoint ptr " + environment + " to i64")
        let masked = ir.var()
        ir.line(masked + " = and i64 " + as_int + ", -4")
        let clean_environment = ir.var()
        ir.line(clean_environment + " = inttoptr i64 " + masked + " to ptr")
        let clean = ir.var()
        ir.line(clean + " = insertvalue { ptr, ptr } undef, ptr " + func + ", 0")
        let complete = ir.var()
        ir.line(complete + " = insertvalue { ptr, ptr } " + clean + ", ptr " + clean_environment + ", 1")
        return complete
    }
    return result
}

fn ir_coro_append_gc(ir: IRFunc, value: Value, gc_args: String, item: String) !Error {
    let gc_args_prop = ir_coro_prop(value, ir_coro_class(value) !>, "gc_args") !>
    let array_class = gc_args_prop.type.get_class_or_null()
    if !isset(array_class) : value.bug("Coro.gc_args is not an Array")
    let append = array_class.get_append_hook()
    if !isset(append) : value.bug("Coro.gc_args Array has no append hook")
    if !append.parsed_types : parse_func_types(append) !>
    ir_use_func(ir, append)
    ir.line_start()
    if !append.get_rett().is_void_type() {
        let ignored = ir.var()
        ir.write(ignored)
        ir.write(" = ")
    }
    ir.write("call ")
    ir.write(ir_func_rett_type(append) !>)
    ir.write(" @\"")
    ir.write(func_ir_name(append))
    ir.write("\"(ptr ")
    ir.write(gc_args)
    ir.write(", ptr ")
    ir.write(item)
    ir.write(", i1 0)")
    ir.line_end()
}

fn ir_coro_get_gc(ir: IRFunc, value: Value, gc_args: String, index: uint) String !Error {
    let gc_args_prop = ir_coro_prop(value, ir_coro_class(value) !>, "gc_args") !>
    let array_class = gc_args_prop.type.get_class_or_null()
    if !isset(array_class) : value.bug("Coro.gc_args is not an Array")
    let data_prop = array_class.get_prop_by_name("data") ! value.bug("Array has no data property")
    let data = ir_coro_load_prop(ir, gc_args, data_prop) !>
    let item_address = ir.var()
    ir.line_start()
    ir.write(item_address)
    ir.write(" = getelementptr ptr, ptr ")
    ir.write(data)
    ir.write(", i64 ")
    ir.write_uint(index)
    ir.line_end()
    let item = ir.var()
    ir.line_start()
    ir.write(item)
    ir.write(" = load ptr, ptr ")
    ir.write(item_address)
    ir.line_end()
    // Array[GcPtr] entries are managed properties too and may carry ownership
    // tags after a collection.
    let as_int = ir.var()
    ir.line(as_int + " = ptrtoint ptr " + item + " to i64")
    let masked = ir.var()
    ir.line(masked + " = and i64 " + as_int + ", -4")
    let clean = ir.var()
    ir.line(clean + " = inttoptr i64 " + masked + " to ptr")
    return clean
}

fn ir_coro_pop_gc(ir: IRFunc, value: Value, gc_args: String) String !Error {
    let gc_args_prop = ir_coro_prop(value, ir_coro_class(value) !>, "gc_args") !>
    let array_class = gc_args_prop.type.get_class_or_null()
    if !isset(array_class) : value.bug("Coro.gc_args is not an Array")
    let pop = array_class.get_func("pop_first")
    if !isset(pop) : value.bug("Coro.gc_args Array has no pop_first function")
    if !pop.parsed_types : parse_func_types(pop) !>
    ir_use_func(ir, pop)
    let raw = ir.var()
    ir.line_start()
    ir.write(raw)
    ir.write(" = call ")
    ir.write(ir_func_rett_type(pop) !>)
    ir.write(" @\"")
    ir.write(func_ir_name(pop))
    ir.write("\"(ptr ")
    ir.write(gc_args)
    ir.write(")")
    ir.line_end()
    return ir_extract_error_success(ir, raw, pop.get_rett()) !>
}

fn ir_coro_result_types(type: Type) Array[Type] {
    let result = Array[Type]{}
    if type.is_void_type() : return result
    if type.type == TYPE.multi {
        let subs = type.sub_types
        if isset(subs) {
            each subs as sub : result.append(sub)
        }
    } else {
        result.append(type)
    }
    return result
}

fn ir_is_closure_callable(value: Value) bool {
    if value.rett.get_non_nullable().type != TYPE.fn : return false
    if value.type != VAL.func : return true
    let func = value.func
    return isset(func) && func.is_literal
}

fn ir_emit_co(ir: IRFunc, value: Value) String !Error {
    ir_note_allocates(ir)
    ir_note_unknown_code(ir)
    let call = value.value1
    if !isset(call) : value.bug("IR co value has no call")
    let callee = call.value1
    if !isset(callee) : value.bug("IR co call has no callee")
    let class = ir_coro_class(value) !>
    let new_func = ir_coro_func(ir, value, class, "new") !>
    let current_idf = valk_idf(value.rett.build, "coro", "current_coro") !>
    let current_global = current_idf.global
    if !isset(current_global) : value.bug("coro:current_coro is not a global")
    ir_use_global(ir, current_global)

    let arg_types = Array[Type]{}
    let arg_values = Array[String]{}
    if callee.type == VAL.func {
        let receiver = callee.value1
        if isset(receiver) {
            arg_types.append(receiver.rett)
            arg_values.append(ir_emit_value(ir, receiver) !>)
        }
    }
    let args = call.values
    if isset(args) {
        each args as arg {
            arg_types.append(arg.rett)
            arg_values.append(ir_emit_value(ir, arg) !>)
        }
    }
    // Passed by value (not by address) so the closure survives independently
    // of whichever coroutine's stack the spawning call happens to run on —
    // that stack is a single shared, reused buffer across coroutines (see
    // lib/src/coro/stack.valk), so a pointer into it is only valid until the
    // next coroutine switch.
    let handler = ir_emit_value(ir, callee) !>
    let handler_type = ir_type(callee.rett) !>

    ir_emit_coro_helper(ir, value, call, arg_types) !>

    let coro = ir.var()
    ir.line_start()
    ir.write(coro)
    ir.write(" = call ")
    ir.write(ir_func_rett_type(new_func) !>)
    ir.write(" @\"")
    ir.write(func_ir_name(new_func))
    ir.write("\"(")
    ir.write(handler_type)
    ir.write(" ")
    ir.write(handler)
    ir.write(", ptr @\"")
    ir.write(value.name)
    ir.write("\")")
    ir.line_end()

    let args_prop = ir_coro_prop(value, class, "args") !>
    let gc_args_prop = ir_coro_prop(value, class, "gc_args") !>
    let raw_args = ir_coro_load_prop(ir, coro, args_prop) !>
    let gc_args = ir_coro_load_prop(ir, coro, gc_args_prop) !>
    let offset: uint = 0
    each arg_types as type, i {
        let rendered = arg_values.get(i) !? "undef"
        if type.is_gc_type() {
            ir_coro_append_gc(ir, value, gc_args, rendered) !>
        } else {
            let address = ir.var()
            ir.line_start()
            ir.write(address)
            ir.write(" = getelementptr i8, ptr ")
            ir.write(raw_args)
            ir.write(", i64 ")
            ir.write_uint(offset)
            ir.line_end()
            ir.line_start()
            ir.write("store ")
            ir.write(ir_type(type) !>)
            ir.write(" ")
            ir.write(rendered)
            ir.write(", ptr ")
            ir.write(address)
            ir.line_end()
            offset += type.size() !>
        }
    }

    // Entrance functions run on the native stack and have no current
    // coroutine to suspend. Coro.new already adds the new coroutine to the
    // run queue; the matching await drives that queue through Coro.loop.
    if !ir.func.is_entrance {
        // Resolved here rather than above: naming a coroutine helper records a
        // reference to it, and on the entrance path this one is never called.
        let await_last = ir_coro_func(ir, value, class, "await_last") !>
        let current = ir.var()
        ir.line_start()
        ir.write(current)
        ir.write(" = load ptr, ptr @\"")
        ir.write(global_ir_name(current_global))
        ir.write("\"")
        ir.line_end()
        ir.line_start()
        ir.write("call ")
        ir.write(ir_func_rett_type(await_last) !>)
        ir.write(" @\"")
        ir.write(func_ir_name(await_last))
        ir.write("\"(ptr ")
        ir.write(current)
        ir.write(")")
        ir.line_end()
    }
    return coro
}

fn ir_emit_coro_complete(ir: IRFunc, value: Value, class: Class, coro: String) !Error {
    let complete = ir_coro_func(ir, value, class, "complete") !>
    ir.line_start()
    ir.write("call ")
    ir.write(ir_func_rett_type(complete) !>)
    ir.write(" @\"")
    ir.write(func_ir_name(complete))
    ir.write("\"(ptr ")
    ir.write(coro)
    ir.write(")")
    ir.line_end()
}

fn ir_emit_coro_helper(parent: IRFunc, value: Value, call: Value, arg_types: Array[Type]) !Error {
    let class = ir_coro_class(value) !>
    let current_idf = valk_idf(value.rett.build, "coro", "current_coro") !>
    let current_global = current_idf.global
    if !isset(current_global) : value.bug("coro:current_coro is not a global")
    ir_use_global(parent, current_global)

    let ir = IRFunc {
        func: parent.func
        code: parent.coro_helpers
    }
    ir.code.write_string("define internal void @\"")
    ir.code.write_string(value.name)
    ir.code.write_string("\"() {\n")
    ir.label("entry")

    let callee = call.value1
    if !isset(callee) : value.bug("Coroutine helper call has no callable")
    let closure_handler = ir_is_closure_callable(callee)
    let result_types = ir_coro_result_types(call.rett)
    let root_count: uint = 0
    each arg_types as type {
        if type.is_gc_type() : root_count++
    }
    each result_types as type {
        if type.is_gc_type() : root_count++
    }
    let root_global = ""
    let root_previous = ""
    let root_values = ""
    if root_count > 0 {
        let stack_idf = valk_idf(value.rett.build, "coro", "gc_stack_sp") !>
        let stack_global = stack_idf.global
        if !isset(stack_global) : value.bug("coro:gc_stack_sp is not a global")
        ir_use_global(parent, stack_global)
        root_global = "@\"" + global_ir_name(stack_global) + "\""
        root_previous = ir.var()
        root_values = ir.var()
        let frame = ir.var()
        let count_address = ir.var()
        ir.line_start()
        ir.write(frame)
        ir.write(" = alloca [")
        ir.write_uint(16 + root_count * 8)
        ir.write(" x i8]")
        ir.line_end()
        ir.line_start()
        ir.write(root_previous)
        ir.write(" = load ptr, ptr ")
        ir.write(root_global)
        ir.line_end()
        ir.line_start()
        ir.write("store ptr ")
        ir.write(root_previous)
        ir.write(", ptr ")
        ir.write(frame)
        ir.line_end()
        ir.line_start()
        ir.write(count_address)
        ir.write(" = getelementptr i8, ptr ")
        ir.write(frame)
        ir.write(", i64 8")
        ir.line_end()
        ir.line_start()
        ir.write("store i64 ")
        ir.write_uint(root_count)
        ir.write(", ptr ")
        ir.write(count_address)
        ir.line_end()
        ir.line_start()
        ir.write(root_values)
        ir.write(" = getelementptr i8, ptr ")
        ir.write(frame)
        ir.write(", i64 16")
        ir.line_end()
        ir.line_start()
        ir.write("call void @llvm.memset.inline.p0.i64(ptr ")
        ir.write(root_values)
        ir.write(", i8 0, i64 ")
        ir.write_uint(root_count * 8)
        ir.write(", i1 false)")
        ir.line_end()
        ir.line_start()
        ir.write("store ptr ")
        ir.write(frame)
        ir.write(", ptr ")
        ir.write(root_global)
        ir.line_end()
    }

    let coro = ir.var()
    ir.line_start()
    ir.write(coro)
    ir.write(" = load ptr, ptr @\"")
    ir.write(global_ir_name(current_global))
    ir.write("\"")
    ir.line_end()

    let args_prop = ir_coro_prop(value, class, "args") !>
    let gc_args_prop = ir_coro_prop(value, class, "gc_args") !>
    let handler_prop = ir_coro_prop(value, class, "handler") !>
    let error_prop = ir_coro_prop(value, class, "error_code") !>
    let raw_args = ir_coro_load_prop(ir, coro, args_prop) !>
    let gc_args = ir_coro_load_prop(ir, coro, gc_args_prop) !>
    // handler is stored by value (see ir_emit_co / Coro.handler), so a
    // single property load already yields the closure — no second
    // dereference through a (potentially stale) pointer-to-elsewhere.
    let closure = ir_coro_load_prop(ir, coro, handler_prop) !>
    let handler = ir.var()
    ir.line_start()
    ir.write(handler)
    ir.write(" = extractvalue ")
    ir.write(ir_type(callee.rett) !>)
    ir.write(" ")
    ir.write(closure)
    ir.write(", 0")
    ir.line_end()
    let handler_environment = ir.var()
    ir.line_start()
    ir.write(handler_environment)
    ir.write(" = extractvalue ")
    ir.write(ir_type(callee.rett) !>)
    ir.write(" ")
    ir.write(closure)
    ir.write(", 1")
    ir.line_end()

    let rendered_args = Array[String]{}
    let offset: uint = 0
    let root_index: uint = 0
    each arg_types as type {
        let rendered = ""
        if type.is_gc_type() {
            // Removing the argument also clears the Array's GC ownership.
            // Consequently result roots start at index zero, matching await.
            rendered = ir_coro_pop_gc(ir, value, gc_args) !>
            let root_address = ir.var()
            ir.line_start()
            ir.write(root_address)
            ir.write(" = getelementptr ptr, ptr ")
            ir.write(root_values)
            ir.write(", i64 ")
            ir.write_uint(root_index++)
            ir.line_end()
            ir.line_start()
            ir.write("store ptr ")
            ir.write(rendered)
            ir.write(", ptr ")
            ir.write(root_address)
            ir.line_end()
        } else {
            let address = ir.var()
            ir.line_start()
            ir.write(address)
            ir.write(" = getelementptr i8, ptr ")
            ir.write(raw_args)
            ir.write(", i64 ")
            ir.write_uint(offset)
            ir.line_end()
            rendered = ir.var()
            ir.line_start()
            ir.write(rendered)
            ir.write(" = load ")
            ir.write(ir_type(type) !>)
            ir.write(", ptr ")
            ir.write(address)
            ir.line_end()
            offset += type.size() !>
        }
        rendered_args.append(rendered)
    }
    let raw_result = ""
    let call_type = call.can_error ? (ir_error_abi_type(call.rett) !>) : (ir_type(call.rett) !>)
    let has_call_result = !call.rett.is_void_type() || call.can_error
    ir.line_start()
    if has_call_result {
        raw_result = ir.var()
        ir.write(raw_result)
        ir.write(" = ")
    }
    ir.write("call ")
    ir.write(call_type)
    ir.write(" ")
    ir.write(handler)
    ir.write("(")
    if closure_handler {
        ir.write("ptr ")
        ir.write(handler_environment)
        if rendered_args.length > 0 : ir.write(", ")
    }
    each rendered_args as rendered, i {
        if i > 0 : ir.write(", ")
        ir.write(ir_type(arg_types.get(i) !? type_void(value.rett.build)) !>)
        ir.write(" ")
        ir.write(rendered)
    }
    ir.write(")")
    ir.line_end()

    let success = raw_result
    if call.can_error {
        let code = ir_extract_error_code(ir, raw_result, call.rett) !>
        let error_address = ir_prop_address(ir, coro, error_prop)
        ir.line_start()
        ir.write("store i32 ")
        ir.write(code)
        ir.write(", ptr ")
        ir.write(error_address)
        ir.line_end()
        let failed = ir.var()
        ir.line_start()
        ir.write(failed)
        ir.write(" = icmp ne i32 ")
        ir.write(code)
        ir.write(", 0")
        ir.line_end()
        let error_block = ir.block("coro.error")
        let success_block = ir.block("coro.success")
        ir.cond_jump(failed, error_block, success_block)
        ir.label(error_block)
        if root_count > 0 {
            ir.line_start()
            ir.write("store ptr ")
            ir.write(root_previous)
            ir.write(", ptr ")
            ir.write(root_global)
            ir.line_end()
        }
        ir_emit_coro_complete(ir, value, class, coro) !>
        ir.line("ret void")
        ir.terminated = true
        ir.label(success_block)
        success = ir_extract_error_success(ir, raw_result, call.rett) !>
    }

    let result_offset: uint = 0
    each result_types as type, i {
        let rendered = success
        if call.rett.type == TYPE.multi {
            rendered = ir.var()
            ir.line_start()
            ir.write(rendered)
            ir.write(" = extractvalue ")
            ir.write(ir_type(call.rett) !>)
            ir.write(" ")
            ir.write(success)
            ir.write(", ")
            ir.write_uint(i)
            ir.line_end()
        }
        if type.is_gc_type() {
            let root_address = ir.var()
            ir.line_start()
            ir.write(root_address)
            ir.write(" = getelementptr ptr, ptr ")
            ir.write(root_values)
            ir.write(", i64 ")
            ir.write_uint(root_index++)
            ir.line_end()
            ir.line_start()
            ir.write("store ptr ")
            ir.write(rendered)
            ir.write(", ptr ")
            ir.write(root_address)
            ir.line_end()
            ir_coro_append_gc(ir, value, gc_args, rendered) !>
        } else {
            let address = ir.var()
            ir.line_start()
            ir.write(address)
            ir.write(" = getelementptr i8, ptr ")
            ir.write(raw_args)
            ir.write(", i64 ")
            ir.write_uint(result_offset)
            ir.line_end()
            ir.line_start()
            ir.write("store ")
            ir.write(ir_type(type) !>)
            ir.write(" ")
            ir.write(rendered)
            ir.write(", ptr ")
            ir.write(address)
            ir.line_end()
            result_offset += type.size() !>
        }
    }
    if root_count > 0 {
        ir.line_start()
        ir.write("store ptr ")
        ir.write(root_previous)
        ir.write(", ptr ")
        ir.write(root_global)
        ir.line_end()
    }
    ir_emit_coro_complete(ir, value, class, coro) !>
    ir.line("ret void")
    ir.code.write_string("}\n\n")
}

fn ir_emit_await(ir: IRFunc, value: Value) String !Error {
    ir_note_unknown_code(ir)
    let task_value = value.value1
    if !isset(task_value) : value.bug("IR await has no coroutine value")
    let task = ir_emit_value(ir, task_value) !>
    let class = ir_coro_class(value) !>
    let current_idf = valk_idf(value.rett.build, "coro", "current_coro") !>
    let current_global = current_idf.global
    if !isset(current_global) : value.bug("coro:current_coro is not a global")
    ir_use_global(ir, current_global)
    if ir.func.is_entrance {
        let loop = ir_coro_func(ir, value, class, "loop") !>
        ir.line_start()
        ir.write("call ")
        ir.write(ir_func_rett_type(loop) !>)
        ir.write(" @\"")
        ir.write(func_ir_name(loop))
        ir.write("\"(ptr ")
        ir.write(task)
        ir.write(")")
        ir.line_end()
    } else {
        // Resolved here rather than above: naming a coroutine helper records a
        // reference to it, and on the entrance path this one is never called.
        let await_coro = ir_coro_func(ir, value, class, "await_coro") !>
        let current = ir.var()
        ir.line_start()
        ir.write(current)
        ir.write(" = load ptr, ptr @\"")
        ir.write(global_ir_name(current_global))
        ir.write("\"")
        ir.line_end()
        ir.line_start()
        ir.write("call ")
        ir.write(ir_func_rett_type(await_coro) !>)
        ir.write(" @\"")
        ir.write(func_ir_name(await_coro))
        ir.write("\"(ptr ")
        ir.write(current)
        ir.write(", ptr ")
        ir.write(task)
        ir.write(")")
        ir.line_end()
    }

    let args_prop = ir_coro_prop(value, class, "args") !>
    let gc_args_prop = ir_coro_prop(value, class, "gc_args") !>
    let error_prop = ir_coro_prop(value, class, "error_code") !>
    let raw_args = ir_coro_load_prop(ir, task, args_prop) !>
    let gc_args = ir_coro_load_prop(ir, task, gc_args_prop) !>
    let result_types = ir_coro_result_types(value.rett)
    let aggregate = "undef"
    let offset: uint = 0
    let gc_index: uint = 0
    each result_types as type, i {
        let rendered = ""
        if type.is_gc_type() {
            rendered = ir_coro_get_gc(ir, value, gc_args, gc_index) !>
            gc_index++
        } else {
            let address = ir.var()
            ir.line_start()
            ir.write(address)
            ir.write(" = getelementptr i8, ptr ")
            ir.write(raw_args)
            ir.write(", i64 ")
            ir.write_uint(offset)
            ir.line_end()
            rendered = ir.var()
            ir.line_start()
            ir.write(rendered)
            ir.write(" = load ")
            ir.write(ir_type(type) !>)
            ir.write(", ptr ")
            ir.write(address)
            ir.line_end()
            offset += type.size() !>
        }
        if value.rett.type == TYPE.multi {
            let next = ir.var()
            ir.line_start()
            ir.write(next)
            ir.write(" = insertvalue ")
            ir.write(ir_type(value.rett) !>)
            ir.write(" ")
            ir.write(aggregate)
            ir.write(", ")
            ir.write(ir_type(type) !>)
            ir.write(" ")
            ir.write(rendered)
            ir.write(", ")
            ir.write_uint(i)
            ir.line_end()
            aggregate = next
        } else {
            aggregate = rendered
        }
    }

    if !value.can_error : return aggregate
    let error_address = ir_prop_address(ir, task, error_prop)
    let code = ir.var()
    ir.line_start()
    ir.write(code)
    ir.write(" = load i32, ptr ")
    ir.write(error_address)
    ir.line_end()
    let raw = ir_build_error_result(ir, aggregate, value.rett, code) !>
    ir.cache_error_result(value, raw)
    return raw
}

fn ir_emit_multi(ir: IRFunc, value: Value) String !Error {
    let source = value.value1
    if isset(source) && (value.name == "part" || value.name == "phi_part") {
        let aggregate = ir.cached_multi(source)
        if !isset(aggregate) {
            aggregate = ir_emit_value(ir, source) !>
            ir.cache_multi(source, aggregate)
        }
        let out = ir.var()
        ir.line_start()
        ir.write(out)
        ir.write(" = extractvalue ")
        ir.write(ir_type(source.rett) !>)
        ir.write(" ")
        ir.write(aggregate)
        ir.write(", ")
        ir.write_int(value.int_val)
        ir.line_end()
        return out
    }
    let values = value.values
    if !isset(values) : return "undef"
    if values.length == 0 : return "undef"
    let current = "undef"
    let whole = ir_type(value.rett) !>
    each values as item, i {
        let item_value = ir_emit_value(ir, item) !>
        let out = ir.var()
        ir.line(out + " = insertvalue " + whole + " " + current + ", " + (ir_type(item.rett) !>) + " " + item_value + ", " + i)
        current = out
    }
    return current
}

fn ir_emit_short_circuit(ir: IRFunc, left: Value, right: Value, op: VALUE_OP) String !Error {
    let rendered_left = ir_emit_value(ir, left) !>
    let left_predecessor = ir.current_block
    let right_block = ir.block("logic.right")
    let after_block = ir.block("logic.after")

    if op == VALUE_OP.and {
        ir.cond_jump(rendered_left, right_block, after_block)
    } else {
        ir.cond_jump(rendered_left, after_block, right_block)
    }

    ir.label(right_block)
    let rendered_right = ir_emit_value(ir, right) !>
    let right_reaches_after = !ir.terminated
    let right_predecessor = ir.current_block
    ir.jump(after_block)

    ir.label(after_block)
    if !right_reaches_after {
        return op == VALUE_OP.and ? "false" : "true"
    }

    let out = ir.var()
    ir.line_start()
    ir.write(out)
    ir.write(" = phi i1 [ ")
    ir.write(op == VALUE_OP.and ? "false" : "true")
    ir.write(", \%")
    ir.write(left_predecessor)
    ir.write(" ], [ ")
    ir.write(rendered_right)
    ir.write(", \%")
    ir.write(right_predecessor)
    ir.write(" ]")
    ir.line_end()
    return out
}

fn ir_emit_binary(ir: IRFunc, left: String, right: String, op: VALUE_OP, type: Type) String !Error {
    if type.get_non_nullable().type == TYPE.fn && (op == VALUE_OP.eq || op == VALUE_OP.ne) {
        let lt = ir.var()
        let ld = ir.var()
        let rt = ir.var()
        let rd = ir.var()
        let closure_type = ir_type(type) !>
        ir.line(lt + " = extractvalue " + closure_type + " " + left + ", 0")
        ir.line(ld + " = extractvalue " + closure_type + " " + left + ", 1")
        ir.line(rt + " = extractvalue " + closure_type + " " + right + ", 0")
        ir.line(rd + " = extractvalue " + closure_type + " " + right + ", 1")
        let tc = ir.var()
        let dc = ir.var()
        let result = ir.var()
        let compare = op == VALUE_OP.eq ? "icmp eq" : "icmp ne"
        let combine = op == VALUE_OP.eq ? "and" : "or"
        ir.line(tc + " = " + compare + " ptr " + lt + ", " + rt)
        ir.line(dc + " = " + compare + " ptr " + ld + ", " + rd)
        ir.line(result + " = " + combine + " i1 " + tc + ", " + dc)
        return result
    }
    let out = ir.var()
    let irt = ir_type(type) !>
    let inst = ""
    let compare = false

    if type.is_pointer_sized() && op != VALUE_OP.eq && op != VALUE_OP.ne && op != VALUE_OP.lt && op != VALUE_OP.gt && op != VALUE_OP.lte && op != VALUE_OP.gte {
        type.build.bug("Pointer/class operator reached native IR lowering for type '" + type.compat_display_name() + "': " + op)
    }

    if op == VALUE_OP.eq {
        inst = type.is_float_type() ? "fcmp oeq" : "icmp eq"
        compare = true
    } else if op == VALUE_OP.ne {
        inst = type.is_float_type() ? "fcmp one" : "icmp ne"
        compare = true
    } else if op == VALUE_OP.lt {
        inst = type.is_float_type() ? "fcmp olt" : (type.is_signed_type() ? "icmp slt" : "icmp ult")
        compare = true
    } else if op == VALUE_OP.gt {
        inst = type.is_float_type() ? "fcmp ogt" : (type.is_signed_type() ? "icmp sgt" : "icmp ugt")
        compare = true
    } else if op == VALUE_OP.lte {
        inst = type.is_float_type() ? "fcmp ole" : (type.is_signed_type() ? "icmp sle" : "icmp ule")
        compare = true
    } else if op == VALUE_OP.gte {
        inst = type.is_float_type() ? "fcmp oge" : (type.is_signed_type() ? "icmp sge" : "icmp uge")
        compare = true
    } else if op == VALUE_OP.add : inst = type.is_float_type() ? "fadd" : "add"
    else if op == VALUE_OP.sub : inst = type.is_float_type() ? "fsub" : "sub"
    else if op == VALUE_OP.mul : inst = type.is_float_type() ? "fmul" : "mul"
    else if op == VALUE_OP.div : inst = type.is_float_type() ? "fdiv" : (type.is_signed_type() ? "sdiv" : "udiv")
    else if op == VALUE_OP.mod : inst = type.is_float_type() ? "frem" : (type.is_signed_type() ? "srem" : "urem")
    else if op == VALUE_OP.bit_and || op == VALUE_OP.and : inst = "and"
    else if op == VALUE_OP.bit_or || op == VALUE_OP.or : inst = "or"
    else if op == VALUE_OP.bit_xor : inst = "xor"
    else if op == VALUE_OP.shl : inst = "shl"
    else if op == VALUE_OP.shr : inst = type.is_signed_type() ? "ashr" : "lshr"
    else : inst = "add"

    ir.line(out + " = " + inst + " " + irt + " " + left + ", " + right)
    return out
}

fn ir_emit_cast(ir: IRFunc, value: String, from: Type, to: Type) String !Error {
    if ir_is_tagged_nullable(from) {
        let tag = ir.var()
        ir.line_start()
        ir.write(tag)
        ir.write(" = extractvalue ")
        ir.write(ir_type(from) !>)
        ir.write(" ")
        ir.write(value)
        ir.write(", 0")
        ir.line_end()
        let inner_value = ir_extract_tagged_nullable_value(ir, value, from) !>
        let from_inner = from.get_non_nullable()
        if !ir_is_tagged_nullable(to) {
            return ir_emit_cast(ir, inner_value, from_inner, to) !>
        }
        let to_inner = to.get_non_nullable()
        let converted = ir_emit_cast(ir, inner_value, from_inner, to_inner) !>
        let lowered = ir_type(to) !>
        let with_tag = ir.var()
        ir.line_start()
        ir.write(with_tag)
        ir.write(" = insertvalue ")
        ir.write(lowered)
        ir.write(" undef, i1 ")
        ir.write(tag)
        ir.write(", 0")
        ir.line_end()
        let out = ir.var()
        ir.line_start()
        ir.write(out)
        ir.write(" = insertvalue ")
        ir.write(lowered)
        ir.write(" ")
        ir.write(with_tag)
        ir.write(", ")
        ir.write(ir_type(to_inner) !>)
        ir.write(" ")
        ir.write(converted)
        ir.write(", 1")
        ir.line_end()
        return out
    }
    if ir_is_tagged_nullable(to) {
        let inner = to.get_non_nullable()
        let converted = ir_emit_cast(ir, value, from, inner) !>
        return ir_build_tagged_nullable(ir, to, converted) !>
    }

    let ft = ir_type(from) !>
    let tt = ir_type(to) !>
    if ft == tt : return value

    let inst = "bitcast"
    if from.is_pointer_sized() && to.is_integer_type() : inst = "ptrtoint"
    else if from.is_integer_type() && to.is_pointer_sized() : inst = "inttoptr"
    else if from.is_bool_type() && to.is_integer_type() : inst = "zext"
    else if from.is_integer_type() && to.is_bool_type() : inst = "trunc"
    else if from.is_integer_type() && to.is_integer_type() {
        let fs = from.size() !>
        let ts = to.size() !>
        if fs > ts : inst = "trunc"
        else : inst = from.is_signed_type() ? "sext" : "zext"
    } else if from.is_float_type() && to.is_float_type() {
        inst = (from.size() !>) > (to.size() !>) ? "fptrunc" : "fpext"
    } else if from.is_integer_type() && to.is_float_type() {
        inst = from.is_signed_type() ? "sitofp" : "uitofp"
    } else if from.is_float_type() && to.is_integer_type() {
        inst = to.is_signed_type() ? "fptosi" : "fptoui"
    }

    let out = ir.var()
    ir.line(out + " = " + inst + " " + ft + " " + value + " to " + tt)
    return out
}

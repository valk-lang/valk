
fn read_type_exp(p: Parser, allow_newline: bool (true), allow_multi: bool (true)) Exp !Error {
    let union = p.create_exp(EXP.type)
    let first = read_postfix_type_exp(p, allow_newline, allow_multi) !>
    let t = p.tok(true, allow_newline, false) !>
    if t != TOK.sign || !p.word_is("|") : return first

    union.kind = TYPE_KIND.union
    union.set(0, first)
    let i: uint = 1
    while true {
        p.tok(true, allow_newline) !>
        union.set(i++, read_postfix_type_exp(p, allow_newline, allow_multi) !>)
        let next = p.tok(true, allow_newline, false) !>
        if next != TOK.sign || !p.word_is("|") : break
    }
    union.set_end(p.token_end)
    return union
}

// A type followed by `.$nonnull` postfixes, applied to the whole prefix chain
fn read_postfix_type_exp(p: Parser, allow_newline: bool, allow_multi: bool) Exp !Error {
    let exp = read_primary_type_exp(p, allow_newline, allow_multi) !>
    while type_at_nonnull_postfix(p) !> {
        p.tok(false, false) !>
        p.tok(false, false) !>
        let wrap = p.create_exp(EXP.type)
        wrap.kind = TYPE_KIND.nonnull
        wrap.i = exp.i
        wrap.set(TYPE_EXP.type, exp)
        wrap.set_end(p.token_end)
        exp = wrap
    }
    return exp
}

// Whether `.$nonnull` follows, without consuming anything
fn type_at_nonnull_postfix(p: Parser) bool !Error {
    if p.tok(false, false, false) !> != TOK.sign || !p.word_is(".") : return false
    let pos = p.pos
    let saved = pos.copy()
    let token_end = p.token_end
    p.tok(false, false) !>
    let found = p.tok(false, false, false) !> == TOK.flag && p.word_is("$nonnull")
    pos.i = saved.i
    pos.line = saved.line
    pos.col = saved.col
    p.token_end = token_end
    p.peek_valid = false
    return found
}

fn read_primary_type_exp(p: Parser, allow_newline: bool (true), allow_multi: bool (true)) Exp !Error {
    p.enter_nesting("Type") !>
    let exp = read_primary_type_exp_inner(p, allow_newline, allow_multi) ! {
        p.leave_nesting()
        throw E
    }
    p.leave_nesting()
    return exp
}

fn read_primary_type_exp_inner(p: Parser, allow_newline: bool, allow_multi: bool) Exp !Error {
    let exp = p.create_exp(EXP.type)
    let t = p.tok(true, allow_newline) !>

    if t == TOK.sign {
        if p.word_is("?") {
            return finish_unary_type(p, exp, TYPE_KIND.nullable) !>
        }
        if p.word_is("*") {
            return finish_indirect_type(p, exp, TYPE_KIND.ptr) !>
        }
        if p.word_is("&") {
            // `mut` is a modifier before the ampersand: `mut &T`, not `&mut T`
            if p.tok(true, false, false) !> == TOK.word && p.word_is("mut") {
                p.error("Mutable borrows put 'mut' before the ampersand: 'mut &T'")
            }
            return finish_indirect_type(p, exp, TYPE_KIND.ref) !>
        }
        if p.word_is(".") {
            exp.kind = TYPE_KIND.suggested
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("<") {
            return finish_inline_type(p, exp) !>
        }
        if p.word_is("[") {
            exp.bool2 = true
            return finish_sequence_type(p, exp, TYPE_KIND.fixed_array) !>
        }
        if p.word_is("$[") {
            p.error("Slice types use '&[T]'")
        }
        if p.word_is("@[") {
            p.error("Unbound pointer types use '*T'")
        }
        if allow_multi && p.word_is("(") {
            return finish_multi_type(p, exp) !>
        }
    }

    // `$T`: a generic parameter inferred from the argument at this position
    if t == TOK.flag {
        // `$array[T]`: the class-less dynamic array. `$array` without `[` stays
        // a generic parameter named `array`.
        if p.word_is("$array") && p.next_word_is("[", false, false, false) !> {
            p.expect("[", false, false) !>
            return finish_sequence_type(p, exp, TYPE_KIND.dynamic_array) !>
        }
        let name = p.word().ltrim("$")
        if name.length == 0 : p.error("Empty generic argument name")
        exp.kind = TYPE_KIND.named
        exp.bool1 = true
        let id = p.create_exp(EXP.id)
        id.str1 = name
        id.set_end(p.token_end)
        exp.set(TYPE_EXP.id, id)
        exp.set_end(p.token_end)
        return exp
    }

    if t == TOK.word {
        if p.word_is("null") {
            exp.kind = TYPE_KIND.null
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("void") {
            exp.kind = TYPE_KIND.void
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("fn") {
            return finish_fn_type(p, exp, TYPE_KIND.fn) !>
        }
        if p.word_is("fnptr") {
            return finish_fn_type(p, exp, TYPE_KIND.fnptr) !>
        }
        if p.word_is("co") {
            return finish_co_type(p, exp) !>
        }
        if p.word_is("array") {
            p.error("Anonymous array types are written '$array[T]'")
        }
        if p.word_is("slice") {
            p.error("Anonymous slice types are written '&[T]'; 'slice X of T' declares a named one")
        }
        if p.word_is("shared") {
            return finish_unary_type(p, exp, TYPE_KIND.shared) !>
        }
        if p.word_is("locked") {
            return finish_unary_type(p, exp, TYPE_KIND.locked) !>
        }
        if p.word_is("local") || p.word_is("mut") {
            return finish_borrow_modifier_type(p, exp) !>
        }
        if p.word_is("nonnull") {
            exp.kind = TYPE_KIND.nonnull
            p.expect("(", false, false) !>
            exp.set(TYPE_EXP.type, read_type_exp(p, true, false) !>)
            p.expect(")", true, true) !>
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("typeof") {
            // typeof(value) — operand is a value expression; type is its result type
            exp.kind = TYPE_KIND.typeof
            p.expect("(", false, false) !>
            exp.set(TYPE_EXP.type, read_value_exp(p, true) !>)
            p.expect(")", true, true) !>
            exp.set_end(p.token_end)
            return exp
        }
        // Named type: Id / namespace.Id, optional [..]
        return finish_named_type(p, exp) !>
    }

    p.error("Unknown type: '" + p.word() + "'")
}

fn finish_unary_type(p: Parser, exp: Exp, kind: TYPE_KIND) Exp !Error {
    exp.kind = kind
    let inner = read_primary_type_exp(p, false, true) !>
    exp.set(TYPE_EXP.type, inner)
    exp.set_end(p.token_end)
    return exp
}

fn finish_indirect_type(p: Parser, exp: Exp, kind: TYPE_KIND) Exp !Error {
    let t = p.tok(true, false, false) !>
    if t != TOK.sign || !p.word_is("[") : return finish_unary_type(p, exp, kind) !>
    p.tok(true, false) !>
    exp.kind = kind
    exp.bool2 = true
    exp.set(TYPE_EXP.type, read_type_exp(p, false, false) !>)
    if p.tok(true, false, false) !> == TOK.word && p.word_is("x") {
        p.tok(true, false) !>
        exp.set(TYPE_EXP.size, read_type_size_value(p) !>)
    }
    p.expect("]", true, false) !>
    exp.set_end(p.token_end)
    return exp
}

// Borrow modifiers before the ampersand: `local &T`, `local mut &T`, `mut &T`.
// `local` marks a frame borrow that cannot escape; `mut` allows writes.
// The modifier word is the current token.
fn finish_borrow_modifier_type(p: Parser, exp: Exp) Exp !Error {
    let is_local = p.word_is("local")
    if !is_local : exp.bool1 = true
    else if p.tok(true, false, false) !> == TOK.word && p.word_is("mut") {
        p.tok(true, false) !>
        exp.bool1 = true
    }
    let t = p.tok(true, false, false) !>
    if t != TOK.sign || !p.word_is("&") {
        if is_local : p.error("The 'local' modifier applies to a borrow type: 'local &T' or 'local mut &T'")
        p.error("The 'mut' modifier applies to a borrow type: 'mut &T'")
    }
    p.tok(true, false) !>
    if is_local : exp.bool3 = true
    return finish_indirect_type(p, exp, TYPE_KIND.ref) !>
}

// Inline type: opener `<` already consumed.
fn finish_inline_type(p: Parser, exp: Exp) Exp !Error {
    let next = p.tok(true, false, false) !>
    if next == TOK.sign && p.word_is("@[") {
        p.error("Unbound pointer types use '*T'")
    }
    exp.kind = TYPE_KIND.inline
    exp.set(TYPE_EXP.type, read_type_exp(p, false, false) !>)
    p.expect(">", true, false) !>
    exp.set_end(p.token_end)
    return exp
}

fn finish_sequence_type(p: Parser, exp: Exp, kind: TYPE_KIND) Exp !Error {
    exp.kind = kind
    exp.set(TYPE_EXP.type, read_type_exp(p, false, false) !>)
    let t = p.tok(true, false, false) !>
    if t == TOK.word && p.word_is("x") {
        if kind == TYPE_KIND.dynamic_array {
            p.error("Fixed inline sequences use '[T x N]'")
        }
        p.tok(true, false) !>
        exp.set(TYPE_EXP.size, read_type_size_value(p) !>)
    } else if exp.bool2 {
        p.error("Fixed inline sequence types require a length: '[T x N]'")
    }
    p.expect("]", true, false) !>
    exp.set_end(p.token_end)
    return exp
}

// Multi type: opener `(` already consumed
fn finish_multi_type(p: Parser, exp: Exp) Exp !Error {
    exp.kind = TYPE_KIND.multi
    let i: uint = 0
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is(")") {
        p.tok(true, true) !>
        exp.set_end(p.token_end)
        return exp
    }
    while true {
        t = p.tok(true, true, false) !>
        if t == TOK.end || t == TOK.none {
            p.error("Expected type or ')' in multi-type")
        }
        exp.set(i, read_type_exp(p, true, true) !>)
        i++
        if !(read_comma_list_next(p, ")", "multi-type") !>) : break
    }
    exp.set_end(p.token_end)
    return exp
}

// Callable result list: (R1, R2 !Error), (!Error), or ().
// The opening `(` has already been consumed.
fn finish_callable_results(p: Parser, owner: Exp, rett: Exp) Exp !Error {
    rett.kind = TYPE_KIND.multi
    let i: uint = 0
    while true {
        let t = p.tok(true, true, false) !>
        if t == TOK.end || t == TOK.none {
            p.error("Expected return type, '!Error', or ')' in callable results")
        }
        if t == TOK.sign && p.word_is(")") {
            p.tok(true, true) !>
            rett.set_end(p.token_end)
            return rett
        }
        if t == TOK.sign && p.word_is("!") {
            p.tok(true, true) !>
            owner.set(TYPE_EXP.error, p.read_id(false, false) !>)
            p.expect(")", true, true) !>
            rett.set_end(p.token_end)
            return rett
        }

        rett.set(i++, read_type_exp(p, true, true) !>)
        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is("!") : continue
        if t == TOK.sign && p.word_is(")") {
            p.tok(true, true) !>
            rett.set_end(p.token_end)
            return rett
        }
        if t != TOK.sign || !p.word_is(",") {
            p.error("Expected ',', '!Error', or ')' in callable results, found: '" + p.word() + "'")
        }

        p.tok(true, true) !>
        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is(")") {
            p.error("Trailing comma in callable results")
        }
        if t == TOK.sign && p.word_is(",") {
            p.error("Empty item in callable results")
        }
        if t == TOK.sign && p.word_is("!") {
            p.error("Callable error type must not be preceded by ','")
        }
    }
}

// fn/fnptr(args)(returns !Error) — keyword already current word.
fn finish_fn_type(p: Parser, exp: Exp, kind: TYPE_KIND) Exp !Error {
    exp.kind = kind
    // Arg types
    p.expect("(", false, false) !>
    let args = p.create_exp(EXP.type)
    exp.set(TYPE_EXP.args, finish_multi_type(p, args) !>)
    // Return types
    p.expect("(", false, false) !>
    let rett = p.create_exp(EXP.type)
    exp.set(TYPE_EXP.rett, finish_callable_results(p, exp, rett) !>)
    reject_callable_type_flags(p) !>
    exp.set_end(p.token_end)
    return exp
}

// co(returns !Error) — keyword already current word. Bare `co` remains valid.
fn finish_co_type(p: Parser, exp: Exp) Exp !Error {
    exp.kind = TYPE_KIND.co
    if p.next_word_is("(", false, false, true) !> {
        let rett = p.create_exp(EXP.type)
        exp.set(TYPE_EXP.rett, finish_callable_results(p, exp, rett) !>)
    }
    reject_callable_type_flags(p) !>
    exp.set_end(p.token_end)
    return exp
}

fn reject_callable_type_flags(p: Parser) !Error {
    if p.tok(true, false, false) !> != TOK.flag : return
    p.tok(true, false) !>
    p.error("Callable types do not support flags: " + p.word())
}

// Named type — first word already current token
fn finish_named_type(p: Parser, exp: Exp) Exp !Error {
    exp.kind = TYPE_KIND.named
    let id = p.create_exp(EXP.id)
    id.str1 = p.word()
    let t = p.tok(false, false, false) !>
    if t == TOK.sign && p.word_is(".") && !(type_at_nonnull_postfix(p) !>) {
        p.tok(false, false) !>
        id.str2 = id.str1
        // Completion asked about `ns.` in a type position (see lsp_completion_at)
        if lsp_completion_at(p.pos.src, p.pos.i) {
            id.str1 = ""
            id.set_end(p.token_end)
            exp.set(TYPE_EXP.id, id)
            exp.set_end(p.token_end)
            return exp
        }
        id.str1 = p.read_word(false, false) !>
    }
    id.set_end(p.token_end)
    exp.set(TYPE_EXP.id, id)

    // Optional generic arguments or sequence size
    t = p.tok(false, false, false) !>
    if t == TOK.sign && p.word_is("[") {
        p.tok(false, false) !>
        read_named_type_brackets(p, exp) !>
    }

    exp.set_end(p.token_end)
    return exp
}

// After `[` on a named type: generics or named sequence size `x N`
fn read_named_type_brackets(p: Parser, exp: Exp) !Error {
    let t = p.tok(true, false, false) !>
    if t == TOK.word && p.word_is("x") {
        p.tok(true, false) !>
        exp.set(TYPE_EXP.size, read_type_size_value(p) !>)
        p.expect("]", true, false) !>
        return
    }

    let first = read_type_exp(p, true, true) !>
    // Generics: [T] or [T, U, ...]
    let generics = p.create_exp(EXP.type)
    generics.kind = TYPE_KIND.multi
    generics.set(0, first)
    let i: uint = 1
    while true {
        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is("]") {
            p.tok(true, true) !>
            break
        }
        p.expect(",", true, true) !>
        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is("]") {
            p.error("Trailing comma in generic type arguments")
        }
        if t == TOK.sign && p.word_is(",") {
            p.error("Empty item in generic type arguments")
        }
        generics.set(i, read_type_exp(p, true, true) !>)
        i++
    }
    generics.set_end(p.token_end)
    exp.set(TYPE_EXP.generics, generics)

    // Optional length after generic sequence arguments: Chain[T][x N]
    t = p.tok(false, false, false) !>
    if t == TOK.sign && p.word_is("[") {
        p.tok(false, false) !>
        p.expect("x", true, false) !>
        exp.set(TYPE_EXP.size, read_type_size_value(p) !>)
        p.expect("]", true, false) !>
    }
}

fn read_type_size_value(p: Parser) Exp !Error {
    return read_value_exp(p, false) !>
}

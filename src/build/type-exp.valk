// Parse a type into a structured EXP.type expression.
// Exp.kind = TYPE_KIND (named, void, nullable, ptr, …)

fn read_type_exp(p: Parser, allow_newline: bool (true), allow_multi: bool (true)) Exp !Error {
    let union = p.create_exp(EXP.type)
    let first = read_primary_type_exp(p, allow_newline, allow_multi) !>
    let t = p.tok(true, allow_newline, false) !>
    if t != TOK.sign || !p.word_is("|") : return first

    union.kind = TYPE_KIND.union
    union.set(0, first)
    let i: uint = 1
    while true {
        p.tok(true, allow_newline) !>
        union.set(i++, read_primary_type_exp(p, allow_newline, allow_multi) !>)
        let next = p.tok(true, allow_newline, false) !>
        if next != TOK.sign || !p.word_is("|") : break
    }
    union.set_end(p.token_end)
    return union
}

// One type atom/wrapper. `read_type_exp` above owns the low-precedence `|`
// chain so unions work consistently in aliases, generics and return types.
fn read_primary_type_exp(p: Parser, allow_newline: bool (true), allow_multi: bool (true)) Exp !Error {
    let exp = p.create_exp(EXP.type)
    let t = p.tok(true, allow_newline) !>

    if t == TOK.sign {
        if p.word_is("?") {
            return finish_unary_type(p, exp, TYPE_KIND.nullable) !>
        }
        if p.word_is("*") {
            return finish_unary_type(p, exp, TYPE_KIND.ptr) !>
        }
        if p.word_is("&") {
            return finish_unary_type(p, exp, TYPE_KIND.ref) !>
        }
        if p.word_is(".") {
            exp.kind = TYPE_KIND.suggested
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("<") {
            return finish_inline_type(p, exp) !>
        }
        if p.word_is("[") {
            p.error("Dynamic array types use 'array[T]'")
        }
        if p.word_is("$[") {
            p.error("Slice types use 'slice[T]'")
        }
        if p.word_is("@[") {
            return finish_sequence_type(p, exp, TYPE_KIND.unbound) !>
        }
        if allow_multi && p.word_is("(") {
            return finish_multi_type(p, exp) !>
        }
    }

    if t == TOK.word {
        if p.word_is("null") {
            exp.kind = TYPE_KIND.null
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("void") {
            exp.kind = TYPE_KIND.void
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("fn") {
            return finish_fn_type(p, exp, TYPE_KIND.fn) !>
        }
        if p.word_is("fnptr") {
            return finish_fn_type(p, exp, TYPE_KIND.fnptr) !>
        }
        if p.word_is("co") {
            return finish_co_type(p, exp) !>
        }
        if p.word_is("array") {
            p.expect("[", false, false) !>
            return finish_sequence_type(p, exp, TYPE_KIND.dynamic_array) !>
        }
        if p.word_is("slice") {
            p.expect("[", false, false) !>
            return finish_sequence_type(p, exp, TYPE_KIND.slice) !>
        }
        if p.word_is("shared") {
            return finish_unary_type(p, exp, TYPE_KIND.shared) !>
        }
        if p.word_is("notnull") {
            exp.kind = TYPE_KIND.notnull
            p.expect("(", false, false) !>
            exp.set(TYPE_EXP.type, read_type_exp(p, true, false) !>)
            p.expect(")", true, true) !>
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("typeof") {
            // typeof(value) — operand is a value expression; type is its result type
            exp.kind = TYPE_KIND.typeof
            p.expect("(", false, false) !>
            exp.set(TYPE_EXP.type, read_value_exp(p, true) !>)
            p.expect(")", true, true) !>
            exp.set_end(p.token_end)
            return exp
        }
        // Named type: Id / namespace:Id, optional [..]
        return finish_named_type(p, exp) !>
    }

    p.error("Unknown type: '" + p.word() + "'")
}

fn finish_unary_type(p: Parser, exp: Exp, kind: TYPE_KIND) Exp !Error {
    exp.kind = kind
    exp.set(TYPE_EXP.type, read_primary_type_exp(p, false, true) !>)
    exp.set_end(p.token_end)
    return exp
}

// Inline type: opener `<` already consumed.
fn finish_inline_type(p: Parser, exp: Exp) Exp !Error {
    exp.kind = TYPE_KIND.inline
    exp.set(TYPE_EXP.type, read_type_exp(p, false, false) !>)
    p.expect(">", true, false) !>
    exp.set_end(p.token_end)
    return exp
}

fn finish_sequence_type(p: Parser, exp: Exp, kind: TYPE_KIND) Exp !Error {
    exp.kind = kind
    exp.set(TYPE_EXP.type, read_type_exp(p, false, false) !>)
    let t = p.tok(true, false, false) !>
    if t == TOK.word && p.word_is("x") {
        if kind == TYPE_KIND.dynamic_array {
            p.error("Fixed inline sequences use '<@[T x N]>'")
        }
        p.tok(true, false) !>
        exp.set(TYPE_EXP.size, read_type_size_value(p) !>)
    }
    p.expect("]", true, false) !>
    exp.set_end(p.token_end)
    return exp
}

// Multi type: opener `(` already consumed
fn finish_multi_type(p: Parser, exp: Exp) Exp !Error {
    exp.kind = TYPE_KIND.multi
    let i: uint = 0
    while true {
        let t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is(")") {
            p.tok(true, true) !>
            break
        }
        if t == TOK.end || t == TOK.none {
            p.error("Expected type or ')' in multi-type")
        }
        if i > 0 {
            p.expect(",", true, true) !>
        }
        exp.set(i, read_type_exp(p, true, true) !>)
        i++
    }
    exp.set_end(p.token_end)
    return exp
}

// fn/fnptr (args)(rett) !Error — keyword already current word
fn finish_fn_type(p: Parser, exp: Exp, kind: TYPE_KIND) Exp !Error {
    exp.kind = kind
    // Arg types
    p.expect("(", false, false) !>
    let args = p.create_exp(EXP.type)
    exp.set(TYPE_EXP.args, finish_multi_type(p, args) !>)
    // Return types
    p.expect("(", false, false) !>
    let rett = p.create_exp(EXP.type)
    exp.set(TYPE_EXP.rett, finish_multi_type(p, rett) !>)
    // Optional !Error
    if p.next_word_is("!", true, false, true) !> {
        exp.set(TYPE_EXP.error, p.read_id(false, false) !>)
    }
    reject_callable_type_flags(p) !>
    exp.set_end(p.token_end)
    return exp
}

// co(rett...) !Error — keyword already current word
fn finish_co_type(p: Parser, exp: Exp) Exp !Error {
    exp.kind = TYPE_KIND.co
    if p.next_word_is("(", false, false, true) !> {
        let rett = p.create_exp(EXP.type)
        exp.set(TYPE_EXP.rett, finish_multi_type(p, rett) !>)
    }
    if p.next_word_is("!", true, false, true) !> {
        exp.set(TYPE_EXP.error, p.read_id(false, false) !>)
    }
    reject_callable_type_flags(p) !>
    exp.set_end(p.token_end)
    return exp
}

fn reject_callable_type_flags(p: Parser) !Error {
    if p.tok(true, false, false) !> != TOK.flag : return
    p.tok(true, false) !>
    p.error("Callable types do not support flags: " + p.word())
}

// Named type — first word already current token
fn finish_named_type(p: Parser, exp: Exp) Exp !Error {
    exp.kind = TYPE_KIND.named
    let id = p.create_exp(EXP.id)
    id.str1 = p.word()
    let t = p.tok(false, false, false) !>
    if t == TOK.sign && p.word_is(":") {
        p.tok(false, false) !>
        id.str2 = id.str1
        // Completion asked about `ns:` in a type position (see lsp_completion_at)
        if lsp_completion_at(p.pos.src, p.pos.i) {
            id.str1 = ""
            id.set_end(p.token_end)
            exp.set(TYPE_EXP.id, id)
            exp.set_end(p.token_end)
            return exp
        }
        id.str1 = p.read_word(false, false) !>
    }
    id.set_end(p.token_end)
    exp.set(TYPE_EXP.id, id)

    // Optional generic arguments or sequence size
    t = p.tok(false, false, false) !>
    if t == TOK.sign && p.word_is("[") {
        p.tok(false, false) !>
        read_named_type_brackets(p, exp) !>
    }

    exp.set_end(p.token_end)
    return exp
}

// After `[` on a named type: generics or named sequence size `x N`
fn read_named_type_brackets(p: Parser, exp: Exp) !Error {
    let t = p.tok(true, false, false) !>
    if t == TOK.word && p.word_is("x") {
        p.tok(true, false) !>
        exp.set(TYPE_EXP.size, read_type_size_value(p) !>)
        p.expect("]", true, false) !>
        return
    }

    let first = read_type_exp(p, true, true) !>
    t = p.tok(true, false, false) !>
    // Generics: [T] or [T, U, ...]
    let generics = p.create_exp(EXP.type)
    generics.kind = TYPE_KIND.multi
    generics.set(0, first)
    let i: uint = 1
    while true {
        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is("]") {
            p.tok(true, true) !>
            break
        }
        p.expect(",", true, true) !>
        generics.set(i, read_type_exp(p, true, true) !>)
        i++
    }
    generics.set_end(p.token_end)
    exp.set(TYPE_EXP.generics, generics)

    // Optional length after generic sequence arguments: Chain[T][x N]
    t = p.tok(false, false, false) !>
    if t == TOK.sign && p.word_is("[") {
        p.tok(false, false) !>
        p.expect("x", true, false) !>
        exp.set(TYPE_EXP.size, read_type_size_value(p) !>)
        p.expect("]", true, false) !>
    }
}

// Size after `x` in a sequence type: any value expression that folds to VAL.int
// (literals, size_of(Type), value aliases, arithmetic, …).
fn read_type_size_value(p: Parser) Exp !Error {
    return read_value_exp(p, false) !>
}

class ParseAlias {
    ns: Namespace
    // File scope (for lookup + type/value resolution; includes `use` bindings)
    scope: Scope
    exp: Exp
    resolving: bool (false)
    resolved: bool (false)
}

fn alias_register_pending(item: ParseAlias) {
    let b = item.ns.build
    let name = item.exp.str1
    let found = b.pending_aliases.get(name) !? null
    let items = isset(found) ? found : Array[ParseAlias]{}
    if !isset(found) : b.pending_aliases.set(name, items)
    items.append(item)
}

fn resolve_alias(item: ParseAlias, at: Exp) !Error {
    let b = item.ns.build
    if item.resolving : alias_cycle_error(b, item, at)
    if item.resolved : return
    item.resolved = true
    item.resolving = true
    b.alias_stack.append(item)
    defer alias_resolve_done(b, item)
    parse_alias(item) !>
}

fn alias_resolve_done(b: Build, item: ParseAlias) {
    item.resolving = false
    b.alias_stack.pop_last() ! {}
}

fn alias_cycle_error(b: Build, item: ParseAlias, at: Exp) !Error {
    let names = Array[String]{}
    let started = false
    each b.alias_stack as entry {
        if entry == item : started = true
        if started : names.append(entry.exp.str1)
    }
    names.append(item.exp.str1)
    at.error("Circular alias definition: " + names.join(" -> "))
}

// An unknown name may be an alias that is still waiting; resolve it now
fn resolve_pending_alias(b: Build, name: String, scope: Scope, at: Exp) bool !Error {
    let items = b.pending_aliases.get(name) ! return false
    each items as item {
        if !item.resolving && item.resolved : continue
        if !scope_reaches(scope, alias_idf_scope(item)) : continue
        resolve_alias(item, at) !>
        return true
    }
    return false
}

fn scope_reaches(scope: Scope, target: Scope) bool {
    let current: ?Scope = scope
    while isset(current) {
        if current == target : return true
        current = current.parent
    }
    return false
}

// Resolve one deferred alias into the relevant declaration scope.
fn parse_alias(item: ParseAlias) !Error {
    let exp = item.exp
    if exp.type == EXP.alias {
        parse_alias_idf(item) !>
        return
    }
    if exp.type == EXP.alias_value {
        parse_alias_value(item) !>
        return
    }
    if exp.type == EXP.alias_type {
        parse_alias_type(item) !>
        return
    }
    exp.bug("Expected EXP.alias / alias_value / alias_type")
}

// Scope where an alias name is bound: `$global` → Build.scope; else private/public base.
fn alias_idf_scope(item: ParseAlias) Scope {
    let exp = item.exp
    if exp.bool1 : return item.ns.build.scope
    return base_idf_scope(item.ns, item.scope, exp.act)
}

fn set_alias_idf(item: ParseAlias, scope: Scope, name: String, idf: Idf) {
    scope.set_idf(name, idf)
    if item.exp.bool1 {
        item.ns.build.lists.global_alias_ns.set(name, item.ns)
    }
}

fn alias_target_exists(item: ParseAlias) bool {
    let id = item.exp.get(ALIAS_EXP.id)
    if !isset(id) : return false
    let name = id.str1
    let ns_name = id.str2
    if isset(ns_name) {
        let ns_idf = item.scope.get_scope_idf(ns_name)
        if !isset(ns_idf) : return false
        let ns_scope = ns_idf.scope
        return isset(ns_scope) && isset(ns_scope.get_idf(name))
    }
    return isset(item.scope.get_idf(name))
}

// `alias Name for Id [$global]` — re-bind the target Idf under Name.
fn parse_alias_idf(item: ParseAlias) !Error {
    let exp = item.exp
    let name = exp.str1
    if name.length == 0 : exp.bug("Alias is missing a name")

    let idf_scope = alias_idf_scope(item)
    if idf_scope.has_local(name) {
        exp.error("Name already used: " + name)
    }

    let id = exp.get(ALIAS_EXP.id)
    if !isset(id) : exp.bug("Alias is missing target id")
    let target = resolve_idf_from_id(id, item.scope) !>
    set_alias_idf(item, idf_scope, name, target)
}

// `value Name (Expr) [$global]` — parse the body as a value expression; store as IDF.value_expr.
fn parse_alias_value(item: ParseAlias) !Error {
    let exp = item.exp
    let name = exp.str1
    if name.length == 0 : exp.bug("Value alias is missing a name")

    let idf_scope = alias_idf_scope(item)
    if idf_scope.has_local(name) {
        exp.error("Name already used: " + name)
    }

    let body = exp.get(ALIAS_VALUE_EXP.body)
    if !isset(body) : exp.bug("Value alias is missing body")
    let value_exp = parse_body_as_value_exp(body) !>
    value_exp.act = exp.act
    set_alias_idf(item, idf_scope, name, Idf.for_value_expr(value_exp, item.scope))
}

// `type Name (Type) [$global]` — resolve the body to a Type; store as IDF.type.
fn parse_alias_type(item: ParseAlias) !Error {
    let exp = item.exp
    let name = exp.str1
    if name.length == 0 : exp.bug("Type alias is missing a name")

    let idf_scope = alias_idf_scope(item)
    if idf_scope.has_local(name) {
        exp.error("Name already used: " + name)
    }

    let body = exp.get(ALIAS_TYPE_EXP.body)
    if !isset(body) : exp.bug("Type alias is missing body")
    let type_exp = parse_body_as_type_exp(body) !>
    let of_type = type_from_exp(type_exp, item.scope) !>
    set_alias_idf(item, idf_scope, name, Idf.for_type(of_type))
}

// Look up an EXP.id (`name` or `ns.name`) in `scope`.
fn resolve_idf_from_id(id: Exp, scope: Scope) Idf !Error {
    let name = id.str1
    let ns_name = id.str2
    if isset(ns_name) {
        let ns_idf = scope.get_scope_idf(ns_name)
        if !isset(ns_idf) : id.error("Unknown namespace: " + ns_name)
        let ns_scope = ns_idf.scope
        if !isset(ns_scope) : id.bug("Scope idf is missing scope")
        let found = ns_scope.get_idf(name)
        if !isset(found) && (resolve_pending_alias(id.src.build, name, ns_scope, id) !>) : found = ns_scope.get_idf(name)
        if !isset(found) : id.error("Unknown identifier: " + ns_name + "." + name)
        return found
    }
    let found = scope.get_idf(name)
    if !isset(found) && (resolve_pending_alias(id.src.build, name, scope, id) !>) : found = scope.get_idf(name)
    if !isset(found) : id.error("Unknown identifier: " + name)
    return found
}

// Re-parse EXP.body interior as a single value expression.
fn parse_body_as_value_exp(body: Exp) Exp !Error {
    let p = body_parser(body) !>
    return read_value_exp(p, true) !>
}

// Re-parse an EXP.body interior as comma-separated values.
fn parse_body_as_value_list(body: Exp) Array[Exp] !Error {
    let p = body_parser(body) !>
    let out = Array[Exp]{}
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is(")") : return out
    while true {
        out.append(read_value_exp(p, true, true) !>)
        if !(read_comma_list_next(p, ")", "arguments") !>) : break
    }
    return out
}

// Re-parse EXP.body interior as a single type expression.
fn parse_body_as_type_exp(body: Exp) Exp !Error {
    let p = body_parser(body) !>
    return read_type_exp(p, true, true) !>
}

// Re-parse EXP.body `[...]` interior as a comma-separated type list (until `]`).
fn parse_body_as_type_list(body: Exp) Array[Exp] !Error {
    let p = body_parser(body) !>
    let out = Array[Exp]{}
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is("]") {
        return out
    }
    if t == TOK.end {
        return out
    }
    while true {
        out.append(read_type_exp(p, true, true) !>)
        t = p.tok(true, true, false) !>
        if t == TOK.end : break
        if !(read_comma_list_next(p, "]", "type arguments") !>) : break
    }
    return out
}

// Re-parse EXP.body `{...}` interior as class-init fields (consumes trailing `}`).
fn parse_body_as_class_init_fields(body: Exp) Exp !Error {
    let p = body_parser(body) !>
    let fields, count = read_class_init_fields(p) !>
    return fields
}

// Same, allowing `v x n` (consumes trailing `}`).
fn parse_body_as_slice_init(body: Exp) (Exp, ?Exp) !Error {
    let p = body_parser(body) !>
    return read_class_init_fields(p, true) !>
}

// Re-parse EXP.body `{...}` interior as fixed-array element values (consumes trailing `}`).
fn parse_body_as_array_init_elements(body: Exp) Exp !Error {
    let p = body_parser(body) !>
    return read_array_init_elements(p) !>
}

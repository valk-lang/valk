
// Build warnings: code that compiles, but that the author most likely did not
// mean to leave behind.
//
// Only the main package is reported. A warning about a dependency — the standard
// library above all — is not actionable in the build that surfaces it, and the
// volume would bury the ones that are.
//
// Warnings are appended as MSG.warning Messages, so the CLI prints them after a
// successful build (unless --no-warn) and the language server publishes them as
// severity-2 diagnostics on the span reported here.

// Locals introduced by `let` and never mentioned again.
//
// Called from parse_func_ast rather than from a pass over every function,
// because Func.all_decls is released as soon as the body has been lowered.
//
// Only `let` is reported. The other named declarations are structural: an `each`
// binding cannot be dropped when a later one in the same list is needed
// (`each map as value, key` with only `key` in use), and a caught-error payload
// binding is named by the error type, not by this function. `let _ = value` is
// the way to say a value is deliberately discarded.
fn warn_unused_decls(func: Func) {
    let b = func.ns.build
    if func.ns.pkg != b.main_pkg : return

    each func.all_decls as decl {
        if decl.is_read : continue
        if decl.is_arg : continue
        let name = decl.name ?! continue
        let exp = decl.exp ?! continue
        if exp.type != EXP.let : continue
        // The reference this target compiled out could be the only one there is.
        if exp.src.skipped_code : continue
        // Assigned later but never read: the stores are all dead, which is a
        // different mistake from never mentioning the variable again.
        if decl.is_used {
            exp.warn("Variable '" + name + "' is assigned but never read")
            continue
        }
        exp.warn("Variable '" + name + "' was declared but never used")
    }
}

// A statement the path can never reach, because whatever came before it in the
// same block returned, threw, exited, or broke out of a loop.
//
// Reported once per block: everything after the first dead statement is dead for
// the same reason, and one warning is what points at the cause.
//
// Not reported for a block containing a compile macro. `#if OS == "win" return
// #end cleanup()` really is dead code on Windows and live code everywhere else,
// so a build for one target must not advise deleting what another one runs.
fn warn_unreachable(ctx: Context, scope: Scope, exp: Exp) {
    if scope.reported_unreachable : return
    scope.reported_unreachable = true
    let func = ctx.func ?! return
    if func.ns.pkg != ctx.build.main_pkg : return
    exp.warn("Unreachable code: this statement can never run")
}

// Imports that nothing in the package refers to.
//
// Runs once, after the pipeline: a `use` is bound on its file's scope and can be
// picked up by any function in that file, so nothing is known until every body
// has been resolved.
fn warn_unused_uses(b: Build) {
    each b.lists.uses as use {
        if use.is_used : continue
        if use.ns.pkg != b.main_pkg : continue
        // An import a `#if` branch needs is not removable just because this
        // target compiled that branch out. Building for one platform must not
        // report code the next one requires.
        if use.exp.src.skipped_code : continue
        // A generic base keeps its body unresolved until something specializes
        // it, so a `use` that only that body refers to has had no chance to be
        // marked. Report nothing for such a file rather than guess.
        if unit_has_unresolved_body(use.unit) : continue

        let id = use.id ?! continue
        let pkg_name = id.str2
        let display = isset(pkg_name) ? pkg_name + ":" + id.str1 : id.str1
        use.exp.warn("Namespace '" + display + "' is imported but never used")
    }
}

// True when any function in this unit still has an unparsed body.
fn unit_has_unresolved_body(unit: Unit) bool {
    each unit.functions as func {
        if !func.parsed_ast : return true
    }
    return false
}



fn warn_unused_decls(func: Func) {
    let b = func.ns.build
    if func.ns.pkg != b.main_pkg : return

    each func.all_decls as decl {
        if decl.is_read : continue
        if decl.is_arg : continue
        let name = decl.name ?! continue
        let exp = decl.exp ?! continue
        if exp.type != EXP.let : continue
        // The reference this target compiled out could be the only one there is.
        if exp.src.skipped_code : continue
        if decl.is_used {
            exp.warn("Variable '" + name + "' is assigned but never read")
            continue
        }
        exp.warn("Variable '" + name + "' was declared but never used")
    }
}

// A borrow parameter the body never keeps could be `local`, so callers may pass frame
// storage. Proven by checking the body again with that parameter lent
fn warn_params_could_be_local(func: Func) {
    let b = func.ns.build
    if func.ns.pkg != b.main_pkg || b.options.no_warn : return
    if func_is_view_variant(func) || func.is_local_check || func.is_literal || func.is_test : return
    if func.is_extern || func.is_export || func.is_interface || func.is_entrance || isset(func.global_init) : return
    if func.is_generic_base || func.has_generic_args || func_generic_depth(func) > 0 : return
    if !isset(func.body) || !lsp_parses_bodies_in(b, func.exp.src) : return
    if func_implements_interface_method(func) : return
    let first = isset(func.class) && !func.is_static ? 1 : 0
    each func.args as arg, i {
        if i < first || arg.implicit || arg.is_generic || isset(arg.variadic) : continue
        let t = arg.type.get_non_nullable()
        if t.is_local || t.is_shared || t.is_locked : continue
        if t.kind != TYPE.ref_of && t.kind != TYPE.ref_slice : continue
        // A String never changes: nothing is gained by lending it
        let named = t.class
        if isset(named) && named.representation_class().immutable : continue
        let at = arg.type_exp ?! continue
        if !func_param_could_be_local(func, arg) : continue
        let local = arg.type.local_type().compat_display_name()
        let m = at.message("Parameter '" + arg.name + "' is never kept: write '" + local + "' so callers can pass frame storage")
        m.with_code("param-could-be-local").suggest(at, local, "Add 'local'").warn()
    }
}

// Whether the body still type-checks when `param` is lent: then nothing keeps it
fn func_param_could_be_local(func: Func, param: Arg) bool {
    let b = func.ns.build
    // A released body cannot be checked again
    if !isset(func.body) || func.is_generic_base : return false
    let index = func.args.index_of(param) ! return false
    let variant = get_func_view_variant(func, 0, 0, func.exp, null) ! return false
    variant.name = func.name + "__local_" + index
    variant.is_local_check = true
    let arg = variant.args.get(index) ! return false
    arg.type = arg.type.local_type()
    arg.decl.type = arg.type
    arg.decl.implicit_borrow = arg.type.has_borrowed_refs()
    b.silent++
    let ok = true
    parse_func_ast(variant) ! { ok = false }
    b.silent--
    return ok
}

fn func_implements_interface_method(func: Func) bool {
    let class = func.class ?! return false
    each class.interfaces as interface {
        each interface.funcs as method {
            if method.name == func.name : return true
        }
    }
    return false
}

fn warn_unused_unsafe(b: Build) {
    each b.lists.unsafe_directives as directive {
        if directive.used : continue
        let exp = directive.exp
        let ns = exp.src.ns
        if !isset(ns) || ns.pkg != b.main_pkg : continue
        // Unparsed bodies (the LSP skips them) are where the unsafe operations would be
        if !lsp_parses_bodies_in(b, exp.src) : continue
        if unsafe_directive_location_used(b, directive) : continue
        let m = exp.message("Unnecessary '@unsafe': this scope contains no unsafe operations").with_code("unnecessary-unsafe")
        m.suggest_removal(exp, "Remove the directive").warn()
    }
}

fn unsafe_directive_location_used(b: Build, directive: UnsafeDirective) bool {
    let exp = directive.exp
    each b.lists.unsafe_directives as other {
        if !other.used : continue
        let other_exp = other.exp
        if other_exp.src == exp.src && other_exp.i == exp.i : return true
    }
    return false
}

fn warn_unreachable(ctx: Context, scope: Scope, exp: Exp) {
    if scope.reported_unreachable : return
    scope.reported_unreachable = true
    let func = ctx.func ?! return
    if func.ns.pkg != ctx.build.main_pkg : return
    exp.warn("Unreachable code: this statement can never run")
}

fn warn_unused_uses(b: Build) {
    each b.lists.uses as use {
        if use.is_used : continue
        if use.ns.pkg != b.main_pkg : continue
        if use.exp.src.skipped_code : continue
        // A file whose bodies the LSP skipped (its tests included) cannot prove a use
        if !lsp_parses_bodies_in(b, use.exp.src) : continue
        if bodies_use_namespace(use, use.unit.unresolved_generic_bodies) : continue
        if bodies_use_namespace(use, use.unit.skipped_test_bodies) : continue
        if unit_has_unresolved_body(use.unit) : continue

        let id = use.id ?! continue
        let pkg_name = id.str2
        let display = isset(pkg_name) ? pkg_name + "." + id.str1 : id.str1
        let m = use.exp.message("Namespace '" + display + "' is imported but never used").with_code("unused-import")
        m.suggest_removal(use.exp, "Remove the unused import").warn()
    }
}

// Whether one of `bodies`, which were never parsed, names the namespace as `name.`
fn bodies_use_namespace(use: Use, bodies: Array[Exp]) bool {
    let id = use.id ?! return false
    let name = use.alias ?? id.str1
    each bodies as body {
        let pos = body.pos ?! continue
        let parser = pos.copy().init_parser()
        let end = body.i + body.len
        while parser.pos.i < end {
            let token = parser.tok(true, true) ! return true
            if token == TOK.end : break
            if token != TOK.word || !parser.word_is(name) : continue
            let next = parser.tok(false, false, false) ! return true
            if next == TOK.sign && parser.word_is(".") : return true
        }
    }
    return false
}

// True when any function in this unit still has an unparsed body.
fn unit_has_unresolved_body(unit: Unit) bool {
    each unit.functions as func {
        if !func.parsed_ast : return true
    }
    return false
}



fn warn_unused_decls(func: Func) {
    let b = func.ns.build
    if func.ns.pkg != b.main_pkg : return

    each func.all_decls as decl {
        if decl.is_read : continue
        if decl.is_arg : continue
        let name = decl.name ?! continue
        let exp = decl.exp ?! continue
        if exp.type != EXP.let : continue
        // The reference this target compiled out could be the only one there is.
        if exp.src.skipped_code : continue
        if decl.is_used {
            exp.warn("Variable '" + name + "' is assigned but never read")
            continue
        }
        exp.warn("Variable '" + name + "' was declared but never used")
    }
}

fn warn_unused_unsafe(b: Build) {
    each b.lists.unsafe_directives as directive {
        if directive.used : continue
        let exp = directive.exp
        let ns = exp.src.ns
        if !isset(ns) || ns.pkg != b.main_pkg : continue
        // Unparsed bodies (the LSP skips them) are where the unsafe operations would be
        if !lsp_parses_bodies_in(b, exp.src) : continue
        if unsafe_directive_location_used(b, directive) : continue
        exp.warn("Unnecessary '@unsafe': this scope contains no unsafe operations")
    }
}

fn unsafe_directive_location_used(b: Build, directive: UnsafeDirective) bool {
    let exp = directive.exp
    each b.lists.unsafe_directives as other {
        if !other.used : continue
        let other_exp = other.exp
        if other_exp.src == exp.src && other_exp.i == exp.i : return true
    }
    return false
}

fn warn_unreachable(ctx: Context, scope: Scope, exp: Exp) {
    if scope.reported_unreachable : return
    scope.reported_unreachable = true
    let func = ctx.func ?! return
    if func.ns.pkg != ctx.build.main_pkg : return
    exp.warn("Unreachable code: this statement can never run")
}

fn warn_unused_uses(b: Build) {
    each b.lists.uses as use {
        if use.is_used : continue
        if use.ns.pkg != b.main_pkg : continue
        if use.exp.src.skipped_code : continue
        // A file whose bodies the LSP skipped (its tests included) cannot prove a use
        if !lsp_parses_bodies_in(b, use.exp.src) : continue
        if unresolved_generic_body_uses(use) : continue
        if unit_has_unresolved_body(use.unit) : continue

        let id = use.id ?! continue
        let pkg_name = id.str2
        let display = isset(pkg_name) ? pkg_name + "." + id.str1 : id.str1
        use.exp.warn("Namespace '" + display + "' is imported but never used")
    }
}

fn unresolved_generic_body_uses(use: Use) bool {
    let id = use.id ?! return false
    let name = use.alias ?? id.str1
    each use.unit.unresolved_generic_bodies as body {
        let pos = body.pos ?! continue
        let parser = pos.copy().init_parser()
        let end = body.i + body.len
        while parser.pos.i < end {
            let token = parser.tok(true, true) ! return true
            if token == TOK.end : break
            if token != TOK.word || !parser.word_is(name) : continue
            let next = parser.tok(false, false, false) ! return true
            if next == TOK.sign && parser.word_is(".") : return true
        }
    }
    return false
}

// True when any function in this unit still has an unparsed body.
fn unit_has_unresolved_body(unit: Unit) bool {
    each unit.functions as func {
        if !func.parsed_ast : return true
    }
    return false
}

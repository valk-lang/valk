////////////////////////////
// Flow facts
////////////////////////////

fn value_append_fact(v: Value, decl: Decl, is_set: bool) {
    let list = is_set ? v.get_issets() : v.get_not_issets()
    if !isset(list) {
        list = Array[Decl]{}
        if is_set : v.set_issets(list)
        else : v.set_not_issets(list)
    }
    list.append(decl, true)
}

fn value_merge_facts(v: Value, facts: ?Array[Decl], is_set: bool) {
    if !isset(facts) : return
    each facts as decl : value_append_fact(v, decl, is_set)
}

fn value_add_isset(v: Value, on: Value) {
    if on.type != VAL.decl : return
    let decl = on.decl
    if isset(decl) : value_append_fact(v, decl, true)
}

////////////////////////////
// Conversions
////////////////////////////

fn vgen_wrap(on: Value, rett: Type) Value {
    let result = Value {
        type: VAL.wrap
        value1: on
        rett: rett
        exp: on.exp
        can_error: on.can_error
    }
    result.set_issets(on.get_issets())
    result.set_not_issets(on.get_not_issets())
    result.set_error_type(on.get_error_type())
    result.set_pre_value(on.get_pre_value())
    if on.is_implicit_borrow() : result.mark_implicit_borrow()
    return result
}

fn value_stores_non_null(v: Value, scope: Scope) bool {
    if !v.rett.is_nullable_type() && v.type != VAL.null : return true
    if v.type != VAL.decl : return false
    let d = v.decl ?! return false
    return scope.not_null_check_relied(d)
}

fn value_try_remove_nullable(v: Value, scope: Scope, ctx: Context) Value {
    if !v.rett.is_nullable_type() : return v
    return value_try_convert(v, scope, ctx, v.rett.get_non_nullable())
}

fn value_force_remove_nullable(v: Value) Value {
    if !v.rett.is_nullable_type() : return v
    return vgen_wrap(v, v.rett.get_non_nullable())
}

fn value_make_nullable(v: Value) Value {
    if v.rett.is_nullable_type() : return v
    return vgen_wrap(v, v.rett.nullable())
}

fn value_force_to(v: Value, scope: Scope, ctx: Context, target: Type, at: Exp) Value !Error {
    if v.rett.is_number_type() && target.is_number_type() {
        let c = vgen_cast(v, target)
        c.exp = at
        return c
    }
    let result = value_try_convert(v, scope, ctx, target, false)
    if target.compat(result.rett) {
        result.exp = at
        return result
    }
    at.error("Cannot convert value to: '" + target.compat_display_name() + "'")
}

fn value_retype_function(v: Value, kind: TYPE) Value {
    return vgen_wrap(v, Type {
        build: v.rett.build
        kind: kind
        enum_info: v.rett.enum_info
        info: v.rett.info
        is_shared: v.rett.is_shared
    })
}

fn union_numeric_member(target_union: Type, source: Type) ?uint {
    let members = target_union.get_members()
    if !isset(members) : return null

    let family: ?uint = null
    let numeric: ?uint = null
    let family_ambiguous = false
    let numeric_ambiguous = false
    each members as member, i {
        let number = member.is_number_type() && source.is_number_type()
            && member.is_bool_type() == source.is_bool_type()
        if !member.compat(source) && !number : continue
        if !number : continue
        if member.is_float_type() == source.is_float_type() {
            if isset(family) : family_ambiguous = true
            else : family = i
        } else {
            if isset(numeric) : numeric_ambiguous = true
            else : numeric = i
        }
    }
    if isset(family) && !family_ambiguous : return family
    if !isset(family) && isset(numeric) && !numeric_ambiguous : return numeric
    return null
}

fn value_try_union_convert(v: Value, scope: Scope, ctx: Context, target: Type, is_auto: bool) ?Value {
    let target_union = target.get_non_nullable()
    if target_union.kind != TYPE.union || v.rett.get_non_nullable().kind == TYPE.union {
        return null
    }
    if v.rett.is_nullable_type() && !target.is_nullable_type() : return null
    let exact = target_union.union_member_index(v.rett) !? null
    if isset(exact) : return vgen_union_wrap(v, target, exact, ctx)
    let index = union_numeric_member(target_union, v.rett)
    if !isset(index) : return null
    let members = target_union.get_members()
    if !isset(members) : return null
    let member = members.get(index) !? v.rett
    let converted = value_try_convert(v, scope, ctx, member, is_auto)
    if !member.compat(converted.rett) : return null
    return vgen_union_wrap(converted, target, index, ctx)
}

fn value_shared_view(v: Value, target: Type) Value {
    return Value {
        type: VAL.shared_view
        value1: v
        rett: target
        exp: v.exp
    }
}

fn fixed_array_pointer_compat(source: Type, target: Type) bool {
    let element = source.get_sub_type()
    if !isset(element) : return false
    if target.kind == TYPE.voidptr : return true
    if target.kind != TYPE.ptr_of && target.kind != TYPE.ref_of : return false
    let pointed = target.get_sub_type()
    if !isset(pointed) : return false
    if target.length > source.length : return false
    if pointed.is_fixed_array_type() : return pointed.compat(source)
    return pointed.compat(element)
}

fn inline_pointer_compat(source: Type, target: Type) bool {
    if source.is_fixed_array_type() : return fixed_array_pointer_compat(source, target)
    if target.kind == TYPE.voidptr : return true
    if target.kind == TYPE.ptr_of || target.kind == TYPE.ref_of {
        let pointed = target.get_sub_type()
        return isset(pointed) && pointed.compat(source)
    }
    return source.kind == TYPE.struct && target.kind == TYPE.struct
        && isset(source.class) && source.class == target.class
}

fn value_try_convert(
    v: Value,
    scope: Scope,
    ctx: Context,
    target: Type,
    is_auto: bool (true),
    allow_inline_borrow: bool (false)
) Value {
    if target.is_void_type() : return v

    let result = v

    if target.kind == TYPE.closure && target.is_shared && result.rett.kind == TYPE.closure && !result.rett.is_shared {
        let func = value_resolve_func_ref(result)
        if isset(func) && func.capture_free {
            result.rett = target
        }
    }

    let target_class = target.get_non_nullable().get_class_or_null()
    let source_class = result.rett.get_non_nullable().get_class_or_null()
    if isset(target_class) && target_class.kind == CLASS_KIND.interface
        && isset(source_class) && source_class.kind == CLASS_KIND.class
        && class_implements_interface(source_class, target_class)
    {
        let adapter = target_class.interface_adapters.get(interface_adapter_key(source_class)) !? null
        if isset(adapter) : return vgen_interface_wrap(result, target.get_non_nullable(), adapter, ctx)
    }

    if result.rett.is_nullable_type() && !target.is_nullable_type()
        && value_stores_non_null(result, scope)
    {
        result = value_force_remove_nullable(result)
    }

    let target_nn = target.get_non_nullable()
    let source_nn = result.rett.get_non_nullable()
    if target_nn.is_shared && !source_nn.is_shared && target_nn.is_gc_type()
        && target_nn.get_class_or_null() == source_nn.get_class_or_null()
        && (target.is_nullable_type() || !result.rett.is_nullable_type())
    {
        return value_shared_view(result, target)
    }

    let union_value = value_try_union_convert(result, scope, ctx, target, is_auto)
    if isset(union_value) : return union_value

    if !result.rett.is_nullable_type() {
        let class = result.rett.get_class_or_null()
        if isset(class) {
            let hook = class_get_to_hook(class, target, is_auto)
            if isset(hook) {
                let callee = vgen_func(hook, result)
                let call = vgen_call(ctx, callee, Array[Value]{}, hook.get_rett(), scope)
                call.exp = result.exp
                result = call
            }
        }
    }

    if !is_auto && result.rett.kind == TYPE.closure && target.get_non_nullable().kind == TYPE.voidptr {
        let func = value_resolve_func_ref(result)
        if isset(func) && !func.is_literal {
            return value_retype_function(result, TYPE.fnptr)
        }
    }

    if !target.is_nullable_type() && !result.rett.is_nullable_type() {
        if target.is_raw_pointer() && result.rett.is_integer_type() {
            return vgen_cast(result, target)
        }
        if result.rett.is_raw_pointer() && target.is_integer_type() {
            return vgen_cast(result, target)
        }
    }

    if target.compat(result.rett) && target.is_nullable_type() == result.rett.is_nullable_type() {
        return result
    }

    if result.rett.kind == TYPE.closure && target.kind == TYPE.fnptr {
        let func = value_resolve_func_ref(result)
        if isset(func) && func.capture_free {
            result = value_retype_function(result, TYPE.fnptr)
        }
    }
    if result.rett.kind == TYPE.fnptr && target.kind == TYPE.closure {
        result = value_retype_function(result, TYPE.closure)
    }

    if target.is_nullable_type() {
        let nnt = target.get_non_nullable()
        result = value_try_convert(result, scope, ctx, nnt, is_auto, allow_inline_borrow)
        if result.rett.is_nullable_type() : return result
        return vgen_wrap(result, result.rett.nullable())
    }

    // Inline value → reference target: take its address. Explicit aggregate
    // literals are addressable temporaries too.
    // Numbers are inline values too, but a number passed to raw `ptr` is an
    // address value and must reach the inttoptr conversion below. Taking its
    // stack address turns Windows HANDLE arguments into pointers to locals.
    if allow_inline_borrow && result.rett.is_inline_type() && !result.rett.is_number_type() && result.rett.kind != TYPE.closure
        && target.get_non_nullable().kind == TYPE.ref_of && inline_pointer_compat(result.rett, target)
    {
        if result.assignable() || result.type == VAL.array_init || result.type == VAL.class_init {
            let borrowed = vgen_ptr_of(result, target, result.exp)
            borrowed.mark_implicit_borrow()
            return borrowed
        }
    }

    // A pointer view can be copied into fixed inline sequence storage.
    if target.is_fixed_array_type() && (result.rett.kind == TYPE.ptr_of || result.rett.kind == TYPE.ref_of) {
        let target_sub = target.get_sub_type()
        let source = result.rett.get_sub_type()
        if isset(target_sub) && isset(source) {
            let source_sub = source
            let source_size: uint = result.rett.length > 0 ? result.rett.length : 1
            if source.is_fixed_array_type() {
                let element = source.get_sub_type()
                if isset(element) : source_sub = element
                source_size = source.length
            }
            let enough_values = source_size > 0 && target.length <= source_size
            if enough_values && target_sub.compat(source_sub) {
                return vgen_load(result, target, result.exp)
            }
        }
    }

    // Number → number (widen / signedness / int→float), same as old try_convert
    if result.rett.is_number_type() && target.is_number_type() {
        // Integer literals can adopt the target integer type when their value
        // fits (character literals lower to VAL.int too).
        if result.type == VAL.int && target.is_integer_type() {
            if type_fits_int_literal(target, result.int_val) {
                let lit = vgen_int(result.int_val, target)
                lit.exp = result.exp
                return lit
            }
        }
        if result.type == VAL.int && target.is_float_type() {
            let c = vgen_cast(result, target)
            c.exp = result.exp
            return c
        }

        if result.rett.is_integer_type() && target.is_float_type() {
            return vgen_cast(result, target)
        }
        if result.rett.is_float_type() && target.is_float_type() {
            if result.rett.number_byte_size() < target.number_byte_size() {
                return vgen_cast(result, target)
            }
        }
        // int → wider int, or same size with different signedness
        if result.rett.is_integer_type() && target.is_integer_type() {
            let rs = result.rett.number_byte_size()
            let ts = target.number_byte_size()
            if rs < ts || (rs == ts && result.rett.is_signed_type() != target.is_signed_type()) {
                return vgen_cast(result, target)
            }
        }
        return result
    }

    // To bare `ptr`: other pointers retype; ints inttoptr (old TYPE.voidptr path)
    if target.is_raw_pointer() {
        if result.rett.is_pointer()
            && (!is_auto || result.rett.is_raw_pointer() || result.rett.kind == TYPE.ptr_of
                || result.rett.kind == TYPE.ref_of || result.rett.is_struct_object())
        {
            return vgen_wrap(result, target)
        }
    }

    // Bare `ptr` → `*T` / `&T`.
    if result.rett.is_raw_pointer() && (target.kind == TYPE.ptr_of || target.kind == TYPE.ref_of) {
        return vgen_wrap(result, target)
    }
    return result
}

// Pair returned by value_balance_numbers
class ValuePair {
    left: Value
    right: Value
}

fn value_balance_union_equal(left: Value, right: Value, scope: Scope, ctx: Context) ValuePair {
    let converted = value_try_union_convert(right, scope, ctx, left.rett, true)
    if isset(converted) : return ValuePair { left: left, right: converted }
    converted = value_try_union_convert(left, scope, ctx, right.rett, true)
    if isset(converted) : return ValuePair { left: converted, right: right }
    return ValuePair { left: left, right: right }
}

////////////////////////////
// Numeric balancing
////////////////////////////

// Balance two numeric operands: fit int literals, then upscale to a common type.
// Mirrors old value_balance used by arithmetic and compare.
fn value_balance_numbers(left: Value, right: Value, b: Build) ValuePair {
    let t1 = left.rett
    let t2 = right.rett
    if !t1.is_number_type() || !t2.is_number_type() {
        return ValuePair { left: left, right: right }
    }

    // Int literal soft-fit toward the other side first
    if left.type == VAL.int && right.type != VAL.int && t2.is_integer_type() {
        if type_fits_int_literal(t2, left.int_val) {
            let lit = vgen_int(left.int_val, t2)
            lit.exp = left.exp
            return ValuePair { left: lit, right: right }
        }
    }
    if right.type == VAL.int && left.type != VAL.int && t1.is_integer_type() {
        if type_fits_int_literal(t1, right.int_val) {
            let lit = vgen_int(right.int_val, t1)
            lit.exp = right.exp
            return ValuePair { left: left, right: lit }
        }
    }

    let is_float = t1.is_float_type() || t2.is_float_type()
    let is_signed = t1.is_signed_type() || t2.is_signed_type()
    let s1 = t1.number_byte_size()
    let s2 = t2.number_byte_size()
    let psz = b.options.target.ptr_size.to(u32)

    let size: u32 = 0
    if is_float {
        size = s1 > s2 ? s1 : s2
    } else {
        // Promote smaller signed-mismatch operands like the old compiler
        let x1 = (s1 < psz && t1.is_signed_type() != is_signed) ? s1 * 2 : s1
        let x2 = (s2 < psz && t2.is_signed_type() != is_signed) ? s2 * 2 : s2
        size = x1 > x2 ? x1 : x2
    }
    if size > psz : return ValuePair { left: left, right: right }

    let common = type_number_sized(b, size, is_float, is_signed)
    if !isset(common) : return ValuePair { left: left, right: right }

    if !t1.compat(common) || t1.is_signed_type() != common.is_signed_type() || t1.number_byte_size() != common.number_byte_size() {
        left = vgen_cast(left, common)
    }
    if !t2.compat(common) || t2.is_signed_type() != common.is_signed_type() || t2.number_byte_size() != common.number_byte_size() {
        right = vgen_cast(right, common)
    }
    return ValuePair { left: left, right: right }
}

// Core integer/float type for a size + signedness (1/2/4/8 bytes).
fn type_number_sized(b: Build, size: u32, is_float: bool, is_signed: bool) ?Type {
    if is_float {
        if size <= 4 : return type_from_core_or_null(b, "f32")
        return type_from_core_or_null(b, "f64") ?? type_from_core_or_null(b, "float")
    }
    if is_signed {
        if size <= 1 : return type_from_core_or_null(b, "i8")
        if size <= 2 : return type_from_core_or_null(b, "i16")
        if size <= 4 : return type_from_core_or_null(b, "i32") ?? type_from_core_or_null(b, "int")
        return type_from_core_or_null(b, "i64") ?? type_from_core_or_null(b, "int")
    }
    if size <= 1 : return type_from_core_or_null(b, "u8")
    if size <= 2 : return type_from_core_or_null(b, "u16")
    if size <= 4 : return type_from_core_or_null(b, "u32") ?? type_from_core_or_null(b, "uint")
    return type_from_core_or_null(b, "u64") ?? type_from_core_or_null(b, "uint")
}

fn type_ptr_uint(b: Build) Type {
    return type_number_sized(b, b.options.target.ptr_size.to(u32), false, false) ?? type_int(b)
}

// Can integer literal `v` be represented in integer type `t`? (old Type.fits_intv)
fn type_fits_int_literal(t: Type, v: int) bool {
    if !t.is_integer_type() : return false
    let bits = t.number_byte_size() * 8
    if bits == 0 || bits > 64 : return true
    if t.is_signed_type() {
        if v < 0 {
            // min = -(1 << (bits-1)); accept v >= min
            if bits >= 64 : return true
            let shift = (bits - 1).to(int)
            let min = 0 - (1 << shift)
            return v >= min
        }
        // non-neg signed: max = (1 << (bits-1)) - 1
        if bits >= 64 : return true
        let max = (1 << (bits - 1).to(int)) - 1
        return v <= max
    }
    // unsigned: reject negatives; max = (1 << bits) - 1
    if v < 0 : return false
    if bits >= 64 : return true
    let umax = (1 << bits.to(int)) - 1
    return v <= umax
}

////////////////////////////
// Operator hooks
////////////////////////////

fn class_get_to_hook(class: Class, target: Type, is_auto: bool) ?Func {
    each class.to_hooks as func {
        if is_auto && !func.auto_to : continue
        let fr = func.get_rett()
        if target.compat(fr) {
            let tc = target.get_class_or_null()
            let fc = fr.get_class_or_null()
            if tc == fc : return func
            if !isset(tc) && !isset(fc) : return func
            if target.kind == TYPE.ptr_of && fr.is_raw_pointer() : return func
        }
    }
    return null
}

fn func_call_arg(func: Func) Arg !LookupError {
    let skip: uint = isset(func.class) && !func.is_static ? 1 : 0
    return func.args.get(skip) !>
}

fn class_get_add_hook(class: Class, rtype: Type) ?Func {
    each class.add_hooks as func {
        let arg = func_call_arg(func) ! continue
        if arg.type.compat(rtype) : return func
    }

    let rclass = rtype.get_class_or_null()
    if !isset(rclass) : return null
    each class.add_hooks as func {
        let arg = func_call_arg(func) ! continue
        let conversion = class_get_to_hook(rclass, arg.type, true)
        if isset(conversion) : return func
    }
    return null
}

fn value_try_add_hook(left: Value, right: Value, scope: Scope, ctx: Context, at: Exp) ?Value !Error {
    if left.rett.is_nullable_type() || right.rett.is_nullable_type() : return null
    let b = ctx.build

    let l = left
    let r = right
    let string_class = type_string(b).get_class_or_null()
    if isset(string_class) {
        let lc = l.rett.get_class_or_null()
        let rc = r.rett.get_class_or_null()
        if lc == string_class && rc != string_class {
            r = value_try_convert(r, scope, ctx, type_string(b))
        } else if rc == string_class && lc != string_class {
            l = value_try_convert(l, scope, ctx, type_string(b))
        }
    }

    let hook_class = l.rett.get_class_or_null()
    if !isset(hook_class) : return null
    let hook = class_get_add_hook(hook_class, r.rett)
    if !isset(hook) {
        let mode_for = hook_class.mode_for_class
        if isset(mode_for) : hook = class_get_add_hook(mode_for, r.rett)
    }
    if !isset(hook) : return null

    let arg = func_call_arg(hook) ! at.bug("'$add' function is missing its argument")
    let rarg = value_try_convert(r, scope, ctx, arg.type)
    arg.type.compat_check(rarg.rett, at) !>

    let callee = vgen_func(hook, l)
    let args = Array[Value]{ rarg }
    value_buffer_call_receiver(callee, ctx)
    let call = vgen_call(ctx, callee, args, hook.get_rett(), scope)
    call.exp = at
    return call
}

fn hook_select_compare(hooks: Array[Func], left_type: Type, right_type: Type) ?Func {
    each hooks as func {
        let args = func.args
        let arg1 = args.get(0) ! continue
        let arg2 = args.get(1) ! continue
        if !arg1.type.compat(left_type) : continue
        if !arg2.type.compat(right_type) : continue
        return func
    }
    return null
}

fn class_get_compare_hook(class: Class, left_type: Type, right_type: Type, op: VALUE_OP, flipped: bool) ?Func {
    let hooks: ?Array[Func] = null
    if op == VALUE_OP.eq : hooks = class.eq_hooks
    else if op == VALUE_OP.lt : hooks = flipped ? class.gte_hooks : class.lt_hooks
    else if op == VALUE_OP.lte : hooks = flipped ? class.gt_hooks : class.lte_hooks
    else if op == VALUE_OP.gt : hooks = flipped ? class.lte_hooks : class.gt_hooks
    else if op == VALUE_OP.gte : hooks = flipped ? class.lt_hooks : class.gte_hooks
    if !isset(hooks) : return null
    return hook_select_compare(hooks, left_type, right_type)
}

////////////////////////////
// Operators and comparisons
////////////////////////////

fn value_check_logical_operand(v: Value, at: Exp) !Error {
    if !v.rett.is_void_type() && !v.rett.is_bool_type() {
        at.error("Expected a value of type 'bool', not: " + v.rett.compat_display_name())
    }
}

fn value_from_short_circuit_exp(exp: Exp, left_exp: Exp, right_exp: Exp, op: VALUE_OP, scope: Scope, ctx: Context) Value !Error {
    let b = ctx.build
    let is_and = op == VALUE_OP.and
    let left = value_from_exp(left_exp, scope, ctx.without_suggested_type()) !>
    value_check_logical_operand(left, exp) !>
    let facts = is_and ? left.get_issets() : left.get_not_issets()
    let sub = scope.sub_scope()
    sub.apply_issets(facts)
    let right = value_from_exp(right_exp, sub, ctx.without_suggested_type()) !>
    value_check_logical_operand(right, exp) !>

    let result = value_try_fold_op(left, right, op, b) ?? vgen_op(left, right, op, type_bool(b))
    result.exp = exp
    value_merge_facts(result, facts, is_and)
    value_merge_facts(result, is_and ? right.get_issets() : right.get_not_issets(), is_and)
    return result
}

fn value_from_op_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let left_exp = exp.get(VALUE_EXP.left)
    let right_exp = exp.get(VALUE_EXP.right)
    if !isset(left_exp) || !isset(right_exp) : exp.bug("Missing binary op operands")
    let op = exp.number.@cast(VALUE_OP)
    let b = ctx.build

    if op == VALUE_OP.and || op == VALUE_OP.or {
        return value_from_short_circuit_exp(exp, left_exp, right_exp, op, scope, ctx) !>
    }

    if op == VALUE_OP.eq || op == VALUE_OP.ne || op == VALUE_OP.lt || op == VALUE_OP.gt || op == VALUE_OP.lte || op == VALUE_OP.gte {
        return value_from_compare_exp(exp, left_exp, right_exp, op, scope, ctx) !>
    }

    let suggested_type = ctx.suggested_type
    let numeric_target: ?Type = null
    if isset(suggested_type) && suggested_type.is_number_type() : numeric_target = suggested_type
    let left_ctx = isset(numeric_target) ? ctx.with_suggested_type(numeric_target) : ctx.without_suggested_type()
    let left = value_from_exp(left_exp, scope, left_ctx) !>
    left = value_try_remove_nullable(left, scope, ctx)

    let left_pointer_kind = left.rett.get_non_nullable().kind
    let left_is_raw_pointer = left.rett.is_pointer()
        && (left_pointer_kind == TYPE.voidptr || left_pointer_kind == TYPE.ptr_of)
    if left_is_raw_pointer && (op == VALUE_OP.add || op == VALUE_OP.sub) {
        let offset = value_from_exp(right_exp, scope, ctx.with_suggested_type(type_int(b))) !>
        offset = value_try_convert(offset, scope, ctx, type_int(b))
        if op == VALUE_OP.sub && offset.rett.is_raw_pointer() {
            let ptr_uint = type_ptr_uint(b)
            let laddr = vgen_cast(left, ptr_uint)
            let raddr = vgen_cast(offset, ptr_uint)
            let v = vgen_op(laddr, raddr, VALUE_OP.sub, ptr_uint)
            v.exp = exp
            return v
        }
        if !offset.rett.is_integer_type() {
            right_exp.error("Pointer offset must be an integer, got: " + offset.rett.compat_display_name())
        }
        if op == VALUE_OP.sub {
            offset = vgen_unary(offset, VALUE_OP.neg, offset.rett)
        }
        return vgen_ptr_offset(left, offset, exp)
    }

    if left_is_raw_pointer {
        let ptr_uint = type_ptr_uint(b)
        left = vgen_cast(left, ptr_uint)
    }

    let right_ctx = isset(numeric_target) ? ctx.with_suggested_type(numeric_target) : (left.rett.is_void_type() ? ctx.without_suggested_type() : ctx.with_suggested_type(left.rett))
    let right = value_from_exp(right_exp, scope, right_ctx) !>
    right = value_try_remove_nullable(right, scope, ctx)

    if op == VALUE_OP.shl || op == VALUE_OP.shr {
        if !left.rett.is_integer_type() {
            left_exp.error("Shift operand must be an integer, got: " + left.rett.compat_display_name())
        }
        if !right.rett.is_integer_type() {
            right_exp.error("Shift operand must be an integer, got: " + right.rett.compat_display_name())
        }
    }

    if isset(numeric_target) && left.rett.is_number_type() && right.rett.is_number_type() {
        left = value_try_convert(left, scope, ctx, numeric_target)
        right = value_try_convert(right, scope, ctx, numeric_target)
        if !numeric_target.compat(left.rett) : left = value_force_to(left, scope, ctx, numeric_target, left_exp) !>
        if !numeric_target.compat(right.rett) : right = value_force_to(right, scope, ctx, numeric_target, right_exp) !>
    }

    let folded = value_try_fold_op(left, right, op, b)
    if isset(folded) {
        folded.exp = exp
        return folded
    }
    if op == VALUE_OP.add {
        let hooked = value_try_add_hook(left, right, scope, ctx, exp) !>
        if isset(hooked) : return hooked
        let left_class = left.rett.get_class_or_null()
        if isset(left_class) && !left.rett.is_number_type() {
            exp.error("Cannot do math operations on types: '" + left.rett.compat_display_name() + "' <> '" + right.rett.compat_display_name() + "'")
        }
    }
    let balanced = value_balance_numbers(left, right, b)
    left = balanced.left
    right = balanced.right
    value_check_op_compat(left, right, op, exp) !>
    let result_type = numeric_target ?? left.rett
    let v = vgen_op(left, right, op, result_type)
    v.exp = exp
    return v
}

fn value_native_comparable(type: Type) bool {
    let t = type.get_non_nullable()
    return t.is_number_type() || t.is_pointer() || t.kind == TYPE.error_code
}

fn value_structural_equal_part(result: Value, left: Value, right: Value, offset: u32, type: Type,
scope: Scope, ctx: Context, at: Exp) Value !Error {
    let b = ctx.build
    let byte_offset = vgen_int(offset.to(int), type_i64(b))
    let left_value = vgen_load(vgen_ptr_offset(left, byte_offset, at), type, at)
    let right_value = vgen_load(vgen_ptr_offset(right, byte_offset, at), type, at)
    let equal = value_compare_values(left_value, right_value, VALUE_OP.eq, scope, ctx, at) !>
    return vgen_this_or_that(result, equal, vgen_bool(false, type_bool(b)), type_bool(b))
}

fn value_structural_equal(left: Value, right: Value, scope: Scope, ctx: Context, at: Exp) Value !Error {
    let b = ctx.build
    let type = left.rett.get_non_nullable()
    let func = ctx.get_func() !>
    let left_slot = vgen_scratch_value(func, type, at)
    let right_slot = vgen_scratch_value(func, type, at)
    let left_address = vgen_cast(left_slot, type_ptr(b))
    let right_address = vgen_cast(right_slot, type_ptr(b))
    let result = vgen_bool(true, type_bool(b))

    if type.is_fixed_array_type() {
        let member = type.get_sub_type() ?! at.bug("Fixed array comparison has no element type")
        let stride = member.byte_size() !>
        let i: u32 = 0
        while i < type.length {
            result = value_structural_equal_part(result, left_address, right_address, stride * i, member, scope, ctx, at) !>
            i++
        }
    } else if type.is_tuple_type() {
        let members = type.get_members() ?! at.bug("Multi-value comparison has no member types")
        let offset: u32 = 0
        each members as member {
            offset = member.ir_align_offset(offset) !>
            result = value_structural_equal_part(result, left_address, right_address, offset, member, scope, ctx, at) !>
            offset += member.byte_size() !>
        }
    } else {
        let class = type.class ?! at.bug("Inline comparison has no class")
        each class.props as prop {
            result = value_structural_equal_part(result, left_address, right_address, prop.offset, prop.type, scope, ctx, at) !>
        }
    }

    let body = Array[Value]{
        vgen_assign(left_slot, left, ASSIGN_OP.set, b, at)
        vgen_assign(right_slot, right, ASSIGN_OP.set, b, at)
    }
    return vgen_scoped_value(body, result, at)
}

fn value_union_equal(left: Value, right: Value, scope: Scope, ctx: Context, at: Exp) Value !Error {
    let b = ctx.build
    let bool_t = type_bool(b)
    let union = left.rett.get_non_nullable()
    let members = union.get_members()
    if !isset(members) : at.bug("Tagged union comparison has no alternatives")
    let func = ctx.get_func() !>
    let left_slot = vgen_scratch_value(func, union, at)
    let right_slot = vgen_scratch_value(func, union, at)
    let result = vgen_bool(false, bool_t)

    each members as member, index {
        let left_active = vgen_union_is(left_slot, index, at)
        let right_active = vgen_union_is(right_slot, index, at)
        let active = vgen_op(left_active, right_active, VALUE_OP.bit_and, bool_t)
        let left_member = vgen_union_extract(left_slot, member, ctx, at) !>
        let right_member = vgen_union_extract(right_slot, member, ctx, at) !>
        let equal = value_compare_values(left_member, right_member, VALUE_OP.eq, scope, ctx, at) !>
        result = vgen_this_or_that(active, equal, result, bool_t)
    }

    let body = Array[Value]{
        vgen_assign(left_slot, left, ASSIGN_OP.set, b, at)
        vgen_assign(right_slot, right, ASSIGN_OP.set, b, at)
    }
    return vgen_scoped_value(body, result, at)
}

fn value_compare_values(left: Value, right: Value, op: VALUE_OP, scope: Scope, ctx: Context, exp: Exp) Value !Error {
    let b = ctx.build
    if op == VALUE_OP.eq || op == VALUE_OP.ne {
        let unions = value_balance_union_equal(left, right, scope, ctx)
        left = unions.left
        right = unions.right
    }

    let folded = value_try_fold_op(left, right, op, b)
    if isset(folded) {
        folded.exp = exp
        return folded
    }

    if left.rett.is_void_type() {
        exp.error("The left value type does not support compare operators: '" + left.rett.compat_display_name() + "'")
    }
    if right.rett.is_void_type() {
        exp.error("The right value type does not support compare operators: '" + right.rett.compat_display_name() + "'")
    }

    let l = value_try_remove_nullable(left, scope, ctx)
    let r = value_try_remove_nullable(right, scope, ctx)

    let noteq = false
    let cmp_op = op
    if cmp_op == VALUE_OP.ne {
        cmp_op = VALUE_OP.eq
        noteq = true
    }

    if cmp_op != VALUE_OP.eq {
        let left_type = l.rett.get_non_nullable()
        let right_type = r.rett.get_non_nullable()
        if l.rett.is_nullable_type() || left_type.kind == TYPE.union || left_type.kind == TYPE.closure {
            exp.error("The left value type does not support compare operators: '" + l.rett.compat_display_name() + "'")
        }
        if r.rett.is_nullable_type() || right_type.kind == TYPE.union || right_type.kind == TYPE.closure {
            exp.error("The right value type does not support compare operators: '" + r.rett.compat_display_name() + "'")
        }
    }

    let nnl = l.rett.is_nullable_type() ? value_force_remove_nullable(l) : l
    let nnr = r.rett.is_nullable_type() ? value_force_remove_nullable(r) : r

    let hook: ?Func = null
    let lc = nnl.rett.get_class_or_null()
    if isset(lc) {
        hook = class_get_compare_hook(lc, nnl.rett, nnr.rett, cmp_op, false)
    }

    if !isset(hook) {
        let rc = nnr.rett.get_class_or_null()
        if isset(rc) {
            let flipped = class_get_compare_hook(rc, nnr.rett, nnl.rett, cmp_op, true)
            if isset(flipped) {
                hook = flipped
                let tmp = nnl
                nnl = nnr
                nnr = tmp
                let tmp2 = l
                l = r
                r = tmp2
            }
        }
    }

    let cmp: Value = vgen_op(nnl, nnr, cmp_op, type_bool(b))
    if isset(hook) {
        let callee = vgen_func(hook, nnl)
        let args = Array[Value]{ nnr }
        cmp = vgen_call(ctx, callee, args, type_bool(b), scope)
    } else {
        let balanced = value_balance_numbers(nnl, nnr, b)
        nnl = balanced.left
        nnr = balanced.right
        if !nnl.rett.is_void_type() && !nnr.rett.is_void_type() {
            if !nnl.rett.compat(nnr.rett) && !nnr.rett.compat(nnl.rett) {
                nnl.rett.compat_check(nnr.rett, exp) !>
            }
        }
        let compare_type = nnl.rett.get_non_nullable().kind
        if compare_type == TYPE.union {
            cmp = value_union_equal(nnl, nnr, scope, ctx, exp) !>
        } else if cmp_op == VALUE_OP.eq
            && nnl.rett.get_non_nullable().is_inline {
            cmp = value_structural_equal(nnl, nnr, scope, ctx, exp) !>
        } else {
            if compare_type != TYPE.closure && !value_native_comparable(nnl.rett) {
                exp.error("The left value type does not support compare operators: '" + nnl.rett.compat_display_name() + "'")
            }
            if nnr.rett.get_non_nullable().kind != TYPE.closure && !value_native_comparable(nnr.rett) {
                exp.error("The right value type does not support compare operators: '" + nnr.rett.compat_display_name() + "'")
            }
            cmp = vgen_op(nnl, nnr, cmp_op, type_bool(b))
        }
    }

    if cmp_op == VALUE_OP.eq {
        let bool_t = type_bool(b)
        if l.rett.is_nullable_type() && r.rett.is_nullable_type() {
            let issetl = vgen_isset_val(l, bool_t)
            let issetr = vgen_isset_val(r, bool_t)
            let either_set = vgen_op(issetl, issetr, VALUE_OP.or, bool_t)
            let both_null = vgen_unary(either_set, VALUE_OP.not, bool_t)
            let both_set = vgen_op(issetl, issetr, VALUE_OP.and, bool_t)
            let set_and_eq = vgen_op(both_set, cmp, VALUE_OP.and, bool_t)
            cmp = vgen_op(both_null, set_and_eq, VALUE_OP.or, bool_t)
        } else if l.rett.is_nullable_type() {
            cmp = vgen_op(vgen_isset_val(l, bool_t), cmp, VALUE_OP.and, bool_t)
        } else if r.rett.is_nullable_type() {
            cmp = vgen_op(vgen_isset_val(r, bool_t), cmp, VALUE_OP.and, bool_t)
        }
    }

    if noteq {
        cmp = vgen_unary(cmp, VALUE_OP.not, type_bool(b))
    }
    cmp.exp = exp
    return cmp
}

fn value_from_compare_exp(exp: Exp, left_exp: Exp, right_exp: Exp, op: VALUE_OP, scope: Scope, ctx: Context) Value !Error {
    let left = value_from_exp(left_exp, scope, ctx.without_suggested_type()) !>
    let right_ctx = left.rett.is_void_type() ? ctx.without_suggested_type() : ctx.with_suggested_type(left.rett)
    let right = value_from_exp(right_exp, scope, right_ctx) !>
    return value_compare_values(left, right, op, scope, ctx, exp) !>
}

////////////////////////////
// isset and ternary
////////////////////////////

fn vgen_isset_val(on: Value, bool_t: Type) Value {
    return Value {
        type: VAL.isset
        value1: on
        rett: bool_t
        exp: on.exp
    }
}

// ---- isset(v) ----

fn value_from_isset_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let inner_exp = exp.get(VALUE_EXP.left)
    if !isset(inner_exp) : exp.bug("Missing isset operand")
    let on = value_from_exp(inner_exp, scope, ctx.without_suggested_type()) !>
    let b = ctx.build
    let bool_t = type_bool(b)

    if on.rett.is_nullable_type() {
        let v = vgen_isset_val(on, bool_t)
        v.exp = exp
        value_add_isset(v, on)
        return v
    }

    let v = vgen_bool(true, bool_t)
    v.exp = exp
    v.set_pre_value(on)
    value_add_isset(v, on)
    return v
}

// ---- ternary / ?? / ?! ----

fn value_from_ternary_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let cond_exp = exp.get(VALUE_EXP.left)
    let then_exp = exp.get(VALUE_EXP.right)
    let else_exp = exp.get(VALUE_EXP.third)
    if !isset(cond_exp) || !isset(then_exp) || !isset(else_exp) : exp.bug("Incomplete ternary")

    let cond = value_from_exp(cond_exp, scope, ctx.with_suggested_type(type_bool(ctx.build))) !>
    if !cond.rett.is_void_type() && !cond.rett.is_bool_type() {
        exp.error("You can only use '?' after values that return a bool. This value has type: " + cond.rett.compat_display_name())
    }

    let then_scope = scope.sub_scope()
    then_scope.apply_issets(cond.get_issets())
    let v1 = value_from_exp(then_exp, then_scope, ctx) !>
    let suggested_type = ctx.suggested_type
    if isset(suggested_type) {
        v1 = value_try_convert(v1, then_scope, ctx, suggested_type)
    }

    let else_scope = scope.sub_scope()
    else_scope.apply_issets(cond.get_not_issets())
    let else_ctx = ctx
    if !isset(suggested_type) && !v1.rett.is_void_type() {
        else_ctx = ctx.with_suggested_type(v1.rett)
    }
    let v2 = value_from_exp(else_exp, else_scope, else_ctx) !>
    if isset(suggested_type) {
        v2 = value_try_convert(v2, else_scope, ctx, suggested_type)
    }

    let l = value_try_remove_nullable(v1, then_scope, ctx)
    let r = v2
    if !l.rett.is_nullable_type() {
        r = value_try_remove_nullable(v2, else_scope, ctx)
    }
    if r.rett.is_nullable_type() {
        l = value_make_nullable(l)
    } else if l.rett.is_nullable_type() {
        r = value_make_nullable(r)
    }
    r = value_try_convert(r, else_scope, ctx, l.rett)
    if !l.rett.is_void_type() && !r.rett.is_void_type() {
        l.rett.compat_check(r.rett, exp) !>
    }

    let v = vgen_this_or_that(cond, l, r, l.rett)
    v.exp = exp
    return v
}

fn value_nullable_operand_ctx(ctx: Context) Context {
    let outer = ctx.suggested_type
    if !isset(outer) : return ctx
    if outer.is_nullable_type() || outer.is_void_type() : return ctx
    return ctx.with_suggested_type(outer.nullable())
}

fn value_from_null_coalesce_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let left_exp = exp.get(VALUE_EXP.left)
    let right_exp = exp.get(VALUE_EXP.right)
    if !isset(left_exp) || !isset(right_exp) : exp.bug("Incomplete ??")

    let on = value_from_exp(left_exp, scope, value_nullable_operand_ctx(ctx)) !>
    if !on.rett.is_void_type() && !on.rett.is_nullable_type() {
        exp.error("You can only use '??' and '?!' on nullable values. Value type is: '" + on.rett.compat_display_name() + "'")
    }

    let alt = value_from_exp(right_exp, scope, ctx.with_suggested_type(on.rett.is_nullable_type() ? on.rett.get_non_nullable() : on.rett)) !>
    let iss = vgen_isset_val(on, type_bool(ctx.build))
    let left = on
    if !alt.rett.is_nullable_type() {
        left = value_force_remove_nullable(on)
    }
    alt = value_try_convert(alt, scope, ctx, left.rett)
    if !left.rett.is_void_type() && !alt.rett.is_void_type() {
        left.rett.compat_check(alt.rett, exp) !>
    }
    let v = vgen_this_or_that(iss, left, alt, alt.rett)
    v.exp = exp
    return v
}

fn value_from_null_exit_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let left_exp = exp.get(VALUE_EXP.left)
    let body_exp = exp.get(VALUE_EXP.right)
    if !isset(left_exp) || !isset(body_exp) : exp.bug("Incomplete ?!")

    let on = value_from_exp(left_exp, scope, value_nullable_operand_ctx(ctx)) !>
    if !on.rett.is_void_type() && !on.rett.is_nullable_type() {
        exp.error("You can only use '??' and '?!' on nullable values. Value type is: '" + on.rett.compat_display_name() + "'")
    }

    let sub = scope.sub_scope()
    let body = value_body_from_block_exp(ctx, sub, body_exp) !>
    if !sub.did_return {
        exp.error("Expected the code after '?!' to end with: return, exit, continue, break or throw")
    }

    let iss = vgen_isset_val(on, type_bool(ctx.build))
    let nn = value_force_remove_nullable(on)
    let not_iss = vgen_unary(iss, VALUE_OP.not, type_bool(ctx.build))
    let ifv = vgen_if(not_iss, Array[Value]{ body }, null, ctx.build, exp)
    let v = vgen_wrap(nn, nn.rett)
    v.set_pre_value(ifv)
    v.exp = exp
    return v
}

////////////////////////////
// Blocks
////////////////////////////

fn value_append_body_exps(ctx: Context, scope: Scope, state: ParseState, values: Array[Value], exps: Array[Exp]) !Error {
    each exps as exp {
        let value = body_value_from_exp(ctx, scope, state, exp) !>
        if isset(value) : values.append(value)
    }
}

fn value_body_from_block_exp(ctx: Context, scope: Scope, body_exp: Exp) Value !Error {
    let state = ParseState.new()
    let values = Array[Value]{}
    let members = body_exp.body_exps
    if isset(members) {
        value_append_body_exps(ctx, scope, state, values, members) !>
    } else if body_exp.type == EXP.block {
        let raw = body_exp.get(BLOCK_EXP.body)
        if isset(raw) {
            let pos = raw.pos
            if isset(pos) {
                let p = pos.copy().init_parser()
                let stmts = read_func_stmts(p) !>
                value_append_body_exps(ctx, scope, state, values, stmts) !>
            }
        }
    } else {
        let v = body_value_from_exp(ctx, scope, state, body_exp) !>
        if isset(v) {
            values.append(v)
        }
    }
    return vgen_block(values, ctx.build, body_exp)
}

fn vgen_this_or_that(cond: Value, then_v: Value, else_v: Value, rett: Type) Value {
    let result = Value {
        type: VAL.this_or_that
        value1: cond
        value2: then_v
        values: Array[Value]{ else_v }
        rett: rett
        exp: cond.exp
    }
    if then_v.is_implicit_borrow() || else_v.is_implicit_borrow() : result.mark_implicit_borrow()
    return result
}

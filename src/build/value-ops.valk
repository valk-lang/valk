use valk.time

////////////////////////////
// Flow facts
////////////////////////////

fn value_append_fact(v: Value, decl: Decl, is_set: bool) {
    // A writable alias may store null between the check and the use
    if is_set && decl.mut_borrowed : return
    let list = is_set ? v.get_issets() : v.get_not_issets()
    if !isset(list) {
        list = Array[Decl]{}
        if is_set : v.set_issets(list)
        else : v.set_not_issets(list)
    }
    list.append(decl, true)
}

fn value_merge_facts(v: Value, facts: ?Array[Decl], is_set: bool) {
    if !isset(facts) : return
    each facts as decl : value_append_fact(v, decl, is_set)
}

fn value_add_isset(v: Value, on: Value) {
    if on.type != VAL.decl : return
    let decl = on.decl
    if isset(decl) : value_append_fact(v, decl, true)
}

// `&x` / `@ref(x)` aliases the local, so a callee can write `null` through it.
// Drop the same non-null fact that a reassignment would.
fn value_clear_borrowed_local_facts(v: Value, scope: Scope) {
    if v.type != VAL.decl : return
    let decl = v.decl
    if isset(decl) : scope.clear_not_null(decl)
}

////////////////////////////
// Conversions
////////////////////////////

fn vgen_wrap(on: Value, rett: Type) Value {
    let result = Value {
        type: VAL.wrap
        value1: on
        rett: rett
        exp: on.exp
        can_error: on.can_error
    }
    result.set_issets(on.get_issets())
    result.set_not_issets(on.get_not_issets())
    result.set_error_type(on.get_error_type())
    if on.is_implicit_borrow() : result.mark_implicit_borrow()
    return result
}

fn value_stores_non_null(v: Value, scope: Scope) bool {
    if !v.rett.is_nullable_type() && v.type != VAL.null : return true
    if v.type != VAL.decl : return false
    let d = v.decl ?! return false
    return scope.not_null_check_relied(d)
}

fn value_try_remove_nullable(v: Value, scope: Scope, ctx: Context) Value !Error {
    if !v.rett.is_nullable_type() : return v
    return value_try_convert(v, scope, ctx, v.rett.get_non_nullable()) !>
}

fn value_force_remove_nullable(v: Value) Value {
    if !v.rett.is_nullable_type() : return v
    return vgen_wrap(v, v.rett.get_non_nullable())
}

fn value_make_nullable(v: Value) Value {
    if v.rett.is_nullable_type() : return v
    return vgen_wrap(v, v.rett.nullable())
}

fn value_enum_representation(value: Value) Value !Error {
    let enu = value.rett.get_enum() ?! return value
    let type = enu.get_item_type() !>
    let result: Value = value
    if value.type == VAL.int : result = vgen_int(value.int_val, type)
    else if value.type == VAL.float : result = vgen_float(value.float_val, type)
    else if value.type == VAL.bool : result = vgen_bool(value.bool_val, type)
    else : result = vgen_wrap(value, value.rett.storage_view_of(type))
    result.exp = value.exp
    return result
}

// Whether `value` is an enum value that turns into text with a hook of its own, such as its name
fn value_enum_has_text(value: Value, string_type: Type) bool {
    if value.rett.is_nullable_type() : return false
    let enu = value.rett.get_enum() ?! return false
    let methods = enu.methods ?! return false
    return isset(class_get_to_hook(methods, string_type, true))
}

fn value_force_to(v: Value, scope: Scope, ctx: Context, target: Type, at: Exp) Value !Error {
    let target_enum = target.get_enum() ?? target.get_non_nullable().get_enum()
    if isset(target_enum) && (v.rett.get_enum() ?? v.rett.get_non_nullable().get_enum()) != target_enum {
        let converted = value_try_convert(v, scope, ctx, target, false) !>
        if target.compat(converted.rett) {
            converted.exp = at
            return converted
        }
        at.error("Cannot convert value to enum: '" + target_enum.name + "'")
    }
    if !isset(target_enum) {
        // An enum's own conversion, such as its name for `to(String)`, comes first
        let source_enum = v.rett.get_enum()
        let methods = isset(source_enum) ? source_enum.methods : null
        if isset(methods) && isset(class_get_to_hook(methods, target, false)) {
            let hooked = value_try_convert(v, scope, ctx, target, false) !>
            if target.compat(hooked.rett) {
                hooked.exp = at
                return hooked
            }
        }
        // Leaving an enum: convert its storage value
        v = value_enum_representation(v) !>
    }
    if v.rett.is_number_type() && target.is_number_type()
        && (v.rett.is_bool_type() || !target.is_bool_type())
    {
        let c = vgen_cast(v, target)
        c.exp = at
        return c
    }
    let parsed = value_string_to_number(v, scope, ctx, target, at) !>
    if isset(parsed) : return parsed
    let result = value_try_convert(v, scope, ctx, target, false) !>
    if target.compat(result.rett) {
        result.exp = at
        return result
    }
    at.error("Cannot convert value of type '" + result.rett.compat_display_name()
        + "' to: '" + target.compat_display_name() + "'")
}

// `"100".to(u8)` parses through String.to_number[T], a fallible call: text
// that is not a number or does not fit the target throws SyntaxError
fn value_string_to_number(v: Value, scope: Scope, ctx: Context, target: Type, at: Exp) ?Value !Error {
    if !target.is_number_type() || target.is_bool_type() || target.is_nullable_type() : return null
    if v.rett.is_nullable_type() : return null
    let class = v.rett.get_class_or_null() ?! return null
    if class != type_string(ctx.build).get_class_or_null() : return null
    let base = class.get_func("to_number") ?! at.bug("String.to_number is missing")
    if !base.parsed_types : parse_func_types(base) !>
    let func = base.specialize(Array[Type]{ target }, at) !>
    if !func.parsed_types : parse_func_types(func) !>
    let receiver = value_read_borrowed_receiver(v, scope, ctx, at) !>
    let callee = vgen_func(func, receiver)
    let args = Array[Value]{}
    value_check_call_args(func, callee, args, scope, ctx, at) !>
    let call = vgen_call(ctx, callee, args, func.get_rett(), scope)
    call.exp = at
    call.can_error = true
    call.set_error_type(func.error_type)
    return call
}

fn value_retype_function(v: Value, kind: TYPE) Value {
    return vgen_wrap(v, Type {
        build: v.rett.build
        kind: kind
        enum_info: v.rett.enum_info
        info: v.rett.info
        is_shared: v.rett.is_shared
    })
}

fn union_numeric_member(target_union: Type, source: Type) ?uint {
    let members = target_union.get_members()
    if !isset(members) : return null

    let family: ?uint = null
    let numeric: ?uint = null
    let family_ambiguous = false
    let numeric_ambiguous = false
    each members as member, i {
        let number = member.is_number_type() && source.is_number_type()
            && member.is_bool_type() == source.is_bool_type()
        if !member.compat(source) && !number : continue
        if !number : continue
        if member.is_float_type() == source.is_float_type() {
            if isset(family) : family_ambiguous = true
            else : family = i
        } else {
            if isset(numeric) : numeric_ambiguous = true
            else : numeric = i
        }
    }
    if isset(family) && !family_ambiguous : return family
    if !isset(family) && isset(numeric) && !numeric_ambiguous : return numeric
    return null
}

fn value_try_union_convert(v: Value, scope: Scope, ctx: Context, target: Type, is_auto: bool) ?Value !Error {
    let target_union = target.get_non_nullable()
    if target_union.kind != TYPE.union : return null
    // A `null` alternative is a real tag: `null` and a missing `?X` select it,
    // while `?U` keeps its own missing state
    let null_tag = target_union.union_null_tag()
    if v.type == VAL.null {
        if target.is_nullable_type() || !isset(null_tag) : return null
        return vgen_union_wrap(v, target, null_tag, ctx)
    }
    if v.rett.get_non_nullable().kind == TYPE.union : return null
    if v.rett.is_nullable_type() && !target.is_nullable_type() {
        if !isset(null_tag) : return null
        let at = v.exp ?! return null
        let body = Array[Value]{}
        let source = value_bind_once(v, ctx, at, body)
        let present = value_try_union_convert(value_force_remove_nullable(source), scope, ctx, target, is_auto) !> ?! return null
        let missing = vgen_union_wrap(vgen_null(target.nullable()), target, null_tag, ctx) ?! return null
        let result = vgen_this_or_that(vgen_isset_val(source, type_bool(ctx.build)), present, missing, target)
        if body.length == 0 : return result
        return vgen_scoped_value(body, result, at)
    }
    let exact = target_union.union_compatible_member_index(v.rett) !? null
    if isset(exact) : return vgen_union_wrap(v, target, exact, ctx)
    let index = union_numeric_member(target_union, v.rett)
    if !isset(index) : return null
    let members = target_union.get_members()
    if !isset(members) : return null
    let member = members.get(index) !? v.rett
    let converted = value_try_convert(v, scope, ctx, member, is_auto) !>
    if !member.compat(converted.rett) : return null
    return vgen_union_wrap(converted, target, index, ctx)
}

// `borrowed`: a temporary view for a callee that keeps nothing, or an explicit unsafe one;
// every other view of ordinary data publishes it
fn value_shared_view(v: Value, target: Type) Value {
    return Value {
        type: VAL.shared_view
        value1: v
        rett: target
        exp: v.exp
    }
}

fn decl_escape_arg(decl: Decl) ?Arg {
    if !decl.is_arg : return null
    each decl.owner.args as arg {
        if arg.decl == decl : return arg
    }
    return null
}

// A bare raw pointer, as opposed to a typed '*T' or '@ref' address
fn type_is_bare_raw_pointer(type: Type) bool {
    return type.is_raw_pointer() && type.kind != TYPE.ptr_of && type.kind != TYPE.adr_of
}

// With 'into_managed' false the walk does not step from a bare raw pointer
// into the managed graph it was taken from: keeping such a pointer is unsafe
// territory for its writer, not an escape of that graph. Frame addresses and
// raw parameters behind it are still reported.
fn value_collect_escape_origins(value: Value, origins: Array[Decl], into_managed: bool (true)) {
    let type = value.rett.get_non_nullable()
    // Checked before the graph source: a raw pointer read from an object
    // still names that object as its source
    if !into_managed && type_is_bare_raw_pointer(type) {
        value_collect_raw_pointer_origins(value, origins)
        return
    }
    let graph_source = value.get_graph_source()
    if isset(graph_source) {
        value_collect_escape_origins(graph_source, origins, into_managed)
        return
    }
    // A raw address taken from a graph still reaches that graph, so the walk
    // continues through it; plain data carries no provenance.
    let raw_address = type.is_raw_pointer() || type.kind == TYPE.ptr_of || type.kind == TYPE.adr_of
    if !value.rett.has_gc_refs() && type.kind != TYPE.closure && !raw_address : return
    let string_class = type_string(type.build).get_class_or_null()
    if isset(string_class) && type.get_class_or_null() == string_class : return
    if value.type == VAL.decl {
        let decl = value.decl
        if !isset(decl) : return
        let arg = decl_escape_arg(decl)
        if isset(arg) : origins.append(decl, true)
        let decl_origins = decl.escape_origins
        if isset(decl_origins) {
            each decl_origins as origin : origins.append(origin, true)
        }
        if decl.is_buffer {
            let pre = value.get_pre_value()
            let source = isset(pre) ? pre.value2 : null
            if isset(source) : value_collect_escape_origins(source, origins)
        }
        return
    }
    if value.type == VAL.global || value.type == VAL.string || value.type == VAL.null : return
    // A locked result only comes out of locked data: the receiver's or an
    // argument's graph, so it traces back to those
    if value.type == VAL.call && value.rett.has_locked_refs() {
        let callee = value.value1
        let receiver = isset(callee) ? callee.value1 : null
        if isset(receiver) : value_collect_escape_origins(receiver, origins, into_managed)
    }
    if value.type == VAL.error_handler {
        let call = value.get_pre_value()
        if isset(call) : value_collect_escape_origins(call, origins, into_managed)
    }
    let inner = value.value1
    if isset(inner) : value_collect_escape_origins(inner, origins, into_managed)
    let other = value.value2
    if isset(other) : value_collect_escape_origins(other, origins, into_managed)
    let values = value.values
    if isset(values) {
        each values as item : value_collect_escape_origins(item, origins, into_managed)
    }
}

// The origins of a bare raw pointer that matter when it is kept: the raw
// parameter or frame address it was made from, never a managed object
fn value_collect_raw_pointer_origins(value: Value, origins: Array[Decl]) {
    if value.type == VAL.decl {
        let decl = value.decl
        if !isset(decl) : return
        if decl.is_buffer {
            let pre = value.get_pre_value()
            let source = isset(pre) ? pre.value2 : null
            if isset(source) : value_collect_escape_origins(source, origins, false)
            return
        }
        let arg = decl_escape_arg(decl)
        if isset(arg) : origins.append(decl, true)
        return
    }
    if value.type == VAL.global || value.type == VAL.string || value.type == VAL.null : return
    let inner = value.value1
    if isset(inner) && !inner.rett.has_gc_refs() : value_collect_escape_origins(inner, origins, false)
    let other = value.value2
    if isset(other) && !other.rett.has_gc_refs() : value_collect_escape_origins(other, origins, false)
    let values = value.values
    if isset(values) {
        each values as item {
            if !item.rett.has_gc_refs() : value_collect_escape_origins(item, origins, false)
        }
    }
}

fn value_escape_origins(value: Value) Array[Decl] {
    let origins = Array[Decl]{}
    value_collect_escape_origins(value, origins)
    return origins
}

// Same list in reused storage; only valid until the next scratch walk.
fn value_scratch_escape_origins(value: Value, origins: Array[Decl]) Array[Decl] {
    origins.clear()
    value_collect_escape_origins(value, origins)
    return origins
}

// Writes to inline subobjects reach the storage owner, not a copied scalar.
fn value_mark_summary_write(value: Value) {
    if value.type != VAL.prop && value.type != VAL.ptrv : return
    let owner = value.value1 ?! return
    if owner.rett.is_inline_type() && !owner.rett.get_non_nullable().is_fat_borrow() {
        value_mark_summary_write(owner)
        return
    }
    each (value_scratch_escape_origins(owner, owner.rett.build.cache.origins_buf)) as origin {
        let arg = decl_escape_arg(origin)
        if isset(arg) : arg.may_write = true
    }
}

fn value_note_call_write(value: Value, param: ?Arg) {
    // A raw pointer handed to a callee is unsafe territory, not a write to
    // the storage it was read from
    let nn = value.rett.get_non_nullable()
    if nn.is_raw_pointer() || nn.kind == TYPE.ptr_of : return
    each (value_scratch_escape_origins(value, value.rett.build.cache.origins_buf)) as origin {
        let source = decl_escape_arg(origin) ?! continue
        if !isset(param) {
            source.may_write = true
            continue
        }
        let dependents = param.write_dependents ?? <{
            let created = Array[Arg]{}
            param.write_dependents = created
            return created
        }
        dependents.append(source, true)
    }
}

fn value_note_call_writes(callee: Value, args: Array[Value]) {
    let func = callee.resolve_call_func()
    let skip: uint = 0
    if isset(func) && !func.is_static && isset(func.class) {
        let receiver = callee.value1
        if isset(receiver) && receiver.type != VAL.type {
            skip = 1
            value_note_call_write(receiver, func.args.get(0) !? null)
        }
    }
    if !isset(func) : value_note_call_write(callee, null)
    let i: uint = 0
    each args as arg {
        let param: ?Arg = isset(func) ? (func.args.get(i + skip) !? null) : null
        value_note_call_write(arg, param)
        i++
    }
}

// The variable whose graph holds this value, when there is one
fn value_root_decl(value: Value) ?Decl {
    let graph_source = value.get_graph_source()
    if isset(graph_source) : return value_root_decl(graph_source)
    if value.type == VAL.decl {
        let decl = value.decl ?! return null
        if !decl.is_buffer : return decl
        let pre = value.get_pre_value()
        let source = isset(pre) && pre.type == VAL.assign ? pre.value2 : null
        return isset(source) ? value_root_decl(source) : null
    }
    if value.type == VAL.prop || value.type == VAL.wrap || value.type == VAL.cast
        || value.type == VAL.interface_wrap || value.type == VAL.block
    {
        let inner = value.value1 ?! return null
        return value_root_decl(inner)
    }
    return null
}

// The lock a locked value belongs to in this function: a `lock` block's binding, or the
// function's own locked receiver and arguments, which a call takes from one lock. Null when
// it cannot be named
fn value_lock_root(value: Value, func: Func) ?Decl {
    let origins = value_escape_origins(value)
    let root: ?Decl = null
    each origins as origin {
        let found: ?Decl = null
        if isset(origin.lock_scope) : found = origin
        else if isset(decl_escape_arg(origin)) {
            let first = func.args.get(0) ! return null
            found = first.decl
        }
        if !isset(found) : return null
        if isset(root) && root != found : return null
        root = found
    }
    return root
}

// Locked data moves within its own lock; data from another lock is copied in
fn value_lock_store(owner: Value, right: Value, target: Type, ctx: Context, scope: Scope) Value !Error {
    if !right.rett.has_locked_refs() : return right
    // Converted into the view just now: copied already when it needed to be
    if right.type == VAL.shared_view : return right
    if !owner.rett.get_non_nullable().is_locked && !owner.rett.has_locked_refs() : return right
    let func = ctx.get_func() !>
    let from = value_lock_root(right, func)
    if isset(from) && from == value_lock_root(owner, func) : return right
    let copied = value_publish_copy(right, ctx, scope, target) !>
    if copied == right : return right
    return value_shared_view(copied, target)
}

// What becomes shared or moves into locked data is copied, so nothing else can name it. A
// literal is its own already: only the parts it was given from elsewhere are copied
fn value_publish_copy(value: Value, ctx: Context, scope: Scope, target: Type) Value !Error {
    if value_publish_needs_no_copy(value) : return value
    let t = value.type
    if (t == VAL.class_init && value_init_sets_fields(value)) || t == VAL.array_init {
        let values = value.values ?? Array[Value]{}
        each values as part, i {
            let copied = value_publish_copy(part, ctx, scope, target) !>
            if copied != part {
                let prop = part.get_init_prop()
                if isset(prop) : copied.set_init_prop(prop)
                values.set(i, copied) _
            }
        }
        return value
    }
    // A literal's part waiting in a buffer: copy what is stored into the buffer
    let pre = t == VAL.decl ? value.get_pre_value() : null
    if isset(pre) && pre.type == VAL.assign {
        let stored = pre.value2
        if isset(stored) : pre.value2 = value_publish_copy(stored, ctx, scope, target) !>
        return value
    }
    if t == VAL.this_or_that {
        let yes = value.value2
        if isset(yes) : value.value2 = value_publish_copy(yes, ctx, scope, target) !>
        let values = value.values ?? Array[Value]{}
        each values as no, i : values.set(i, value_publish_copy(no, ctx, scope, target) !>) _
        return value
    }
    let func = ctx.get_func() !>
    let at = value.exp ?? func.exp
    if !type_can_clone(value.rett, false, Array[Class]{}) {
        at.error("Cannot copy '" + value.rett.compat_display_name() + "' into '" + target.compat_display_name()
            + "': it holds raw memory or a resource released by 'gc_free', and has no '$clone' function to copy it")
    }
    // `$clone` hooks run as on shared data, so they cannot hand back the original's parts
    return value_clone(value, ctx, scope, at, false, false, true, true) !>
}

// A class literal whose values are its fields, not the calls a collection literal makes
fn value_init_sets_fields(value: Value) bool {
    let values = value.values ?! return true
    each values as part {
        if !isset(part.get_init_prop()) : return false
    }
    return true
}

// Data that is already safe to hand out: plain words, strings, shared data, or a fresh copy
fn value_publish_needs_no_copy(value: Value) bool {
    let nn = value.rett.get_non_nullable()
    if nn.is_shared : return true
    if !value.rett.has_gc_refs() && nn.kind != TYPE.closure : return true
    let t = value.type
    if t == VAL.null || t == VAL.string : return true
    let string_class = type_string(nn.build).get_class_or_null()
    if isset(string_class) && nn.get_class_or_null() == string_class : return true
    if t == VAL.call {
        let callee = value.value1 ?! return false
        let func = callee.resolve_call_func() ?! return false
        return func.is_clone_hook || func.name.starts_with("<clone.")
    }
    // An object made from a raw pointer is unsafe code's own claim
    if t == VAL.cast {
        let inner = value.value1 ?! return false
        let inner_nn = inner.rett.get_non_nullable()
        return inner_nn.is_raw_pointer() || inner_nn.kind == TYPE.ptr_of
    }
    return false
}

fn value_is_capture_free_func(value: Value) bool {
    if value.type != VAL.func || isset(value.value1) : return false
    let func = value.func
    return isset(func) && func.capture_free
}

fn func_arg_index(func: Func, decl: Decl) ?uint {
    each func.args as arg, index {
        if arg.decl == decl : return index
    }
    return null
}

// Whether every input of this graph is the method's receiver or local data
// built inside the method: a view of the receiver, not a new publication
fn value_built_from_receiver(value: Value, func: Func) bool {
    // A static method has no receiver to be built from
    if func.args.length == 0 : return false
    let root = value_root_decl(value)
    let origins = value_escape_origins(value)
    // Nothing flowed in from anywhere the method can name: a local that was
    // built here counts, a global or a fresh temporary does not
    if origins.length == 0 : return isset(root) && !isset(func_arg_index(func, root))
    each origins as origin {
        let index = func_arg_index(func, origin)
        if isset(index) && index != 0 : return false
    }
    return true
}

////////////////////////////
// Write effects
////////////////////////////

// Whether a function writes through its parameters is read from its body. A body
// that is not available, or one the LSP does not load, is not known yet
fn func_effects_unavailable_in_lsp(func: Func) bool {
    let options = func.ns.build.options
    return !func.effects_ready
        && (isset(options.lsp) || options.is_fmt)
        && !lsp_should_parse_func_ast(func)
}

fn func_effects_conservative(func: Func) {
    each func.args as arg : arg.may_write = true
    func.computing_effects = false
    func.effects_ready = true
}

fn func_begin_effects(func: Func) {
    each func.args as arg : arg.may_write = false
    func.computing_effects = true
}

fn func_finish_effects(func: Func) {
    func.computing_effects = false
    func.effects_ready = true
}

fn ensure_func_effects(func: Func) !Error {
    if func.effects_ready || func.computing_effects : return
    if func.is_interface {
        // Its implementations feed it at the end of the build (link_interface_effects)
        each func.args as arg : arg.may_write = false
        func.effects_ready = true
        return
    }
    if func.is_extern || !isset(func.body) : func_effects_conservative(func)
}

// `required`: a call site cannot decide without the effects (it would report an
// error), so the body is parsed for it even where the LSP otherwise reads only
// declarations. Errors in such a body belong to its own file and are not raised here.
fn ensure_func_effects_parsed(func: Func, required: bool (false)) !Error {
    ensure_func_effects(func) !>
    if func.effects_ready || func.computing_effects : return

    let saved_body = func.body
    let effects_only = func.ns.build.options.needs_ir() && !func.info_used
    let forced = required && !lsp_should_parse_func_ast(func)
    if forced : func.summary_required = true
    parse_func_ast(func) ! {
        if !forced : throw E
        func_effects_conservative(func)
        return
    }
    if !func.effects_ready {
        // The LSP deliberately skips bodies from unopened files.
        if func_effects_unavailable_in_lsp(func) : return
        func_effects_conservative(func)
        return
    }
    if effects_only && func.parsed_ast {
        prepare_func_reparse(func)
        func.body = saved_body
    }
}

// A body nothing reaches is never queued for parsing, but a parameter of another
// function may wait on it for its write effects. Those bodies are parsed here, and
// again for whatever they wait on in turn.
fn parse_deferred_callees(build: Build) !Error {
    while true {
        let found = false
        each build.lists.units as unit {
            each unit.functions as func {
                if func.effects_ready || func.computing_effects || func.summary_required : continue
                if !func_has_effect_dependents(func) : continue
                func.summary_required = true
                ensure_func_effects_parsed(func, true) !>
                found = true
            }
        }
        if !found : break
    }
}

fn func_has_effect_dependents(func: Func) bool {
    each func.args as arg {
        if isset(arg.write_dependents) : return true
    }
    return false
}

// Every implementation's parameter feeds the interface method's parameter
fn link_interface_effects(build: Build) !Error {
    each build.lists.classes as class {
        each class.interfaces as interface {
            let slot: uint = 0
            while slot < interface.interface_method_count {
                let requirement = interface_method_at(interface, slot)
                slot++
                if !isset(requirement) : continue
                let implementation = class.get_func(requirement.name) ?! continue
                if func_effects_unavailable_in_lsp(implementation) : continue
                ensure_func_effects_parsed(implementation) !>
                ensure_func_effects(requirement) !>
                each requirement.args as target, index {
                    let source = implementation.args.get(index) ! continue
                    let writes = source.write_dependents ?? <{
                        let created = Array[Arg]{}
                        source.write_dependents = created
                        return created
                    }
                    writes.append(target, true)
                }
            }
        }
    }
}

// Writes found in callees reach the parameters that were passed to them
fn resolve_deferred_effects(build: Build) !Error {
    link_interface_effects(build) !>
    parse_deferred_callees(build) !>
    let writes = Array[Arg]{}
    each build.lists.units as unit {
        each unit.functions as func {
            if func_effects_unavailable_in_lsp(func) : continue
            each func.args as arg {
                if arg.may_write : writes.append(arg)
            }
        }
    }
    while true {
        let arg = writes.pop_last() ! break
        let dependents = arg.write_dependents ?! continue
        each dependents as dependent {
            if dependent.may_write : continue
            dependent.may_write = true
            writes.append(dependent)
        }
    }
    each build.lists.units as unit {
        each unit.functions as func {
            if func_effects_unavailable_in_lsp(func) : continue
            // Enum storage is constant: a method may neither change it nor lend it out
            let lends = func.get_rett().is_stack_borrow()
            each func.args as arg {
                let enum_pos = arg.enum_receiver_pos
                if isset(enum_pos) && (arg.may_write || lends) {
                    enum_pos.error("Cannot call a method that modifies or exposes enum storage; copy its underlying value first")
                }
            }
        }
    }
}

fn fixed_array_pointer_compat(source: Type, target: Type) bool {
    let element = source.get_sub_type()
    if !isset(element) : return false
    if target.kind == TYPE.voidptr : return true
    if target.kind != TYPE.ptr_of && target.kind != TYPE.adr_of && target.kind != TYPE.ref_of : return false
    let pointed = target.get_sub_type()
    if !isset(pointed) : return false
    if target.length > source.length : return false
    if isset(source.get_enum()) : return target.length == 1 && pointed.compat_storage(source)
    return pointed.compat_storage(element)
}

fn inline_pointer_compat(source: Type, target: Type) bool {
    if source.is_fixed_array_type() : return fixed_array_pointer_compat(source, target)
    if target.kind == TYPE.voidptr : return true
    if target.kind == TYPE.ptr_of || target.kind == TYPE.adr_of || target.kind == TYPE.ref_of {
        let pointed = target.get_sub_type()
        return isset(pointed) && pointed.compat_storage(source)
    }
    return source.kind == TYPE.struct && target.kind == TYPE.struct
        && isset(source.class) && source.class == target.class
}

// Give borrowed inline storage a frame-lifetime home. Managed owners are copied
// into a dedicated GC root so reassigning the original variable cannot free the
// allocation containing an interior borrow.
fn value_permanent_borrow_root(value: Value, ctx: Context) ?Value {
    let func = ctx.func
    if !isset(func) : return null
    let decl = Decl.new(func, value.rett, false, null)
    decl.is_mut = true
    decl.make_addressable()
    func.all_decls.append(decl)
    let rooted = vgen_decl(decl)
    rooted.exp = value.exp
    rooted.set_pre_value(vgen_assign(vgen_decl(decl), value, ASSIGN_OP.set, ctx.build, value.exp, ctx))
    return rooted
}

fn value_prepare_borrow_storage(value: Value, ctx: Context) ?Value {
    if value.type == VAL.decl {
        let decl = value.decl
        if isset(decl) : decl.make_addressable()
        return value
    }
    if value.type == VAL.global : return value
    if value.type == VAL.array_init || value.type == VAL.class_init {
        return value_permanent_borrow_root(value, ctx)
    }
    if value.type == VAL.ptrv {
        let on = value.value1
        if !isset(on) : return null
        let native = type_native_sequence(on.rett)
        if native.kind == TYPE.array : return null
        let prepared = value_prepare_borrow_storage(on, ctx)
        if !isset(prepared) : return null
        value.value1 = prepared
        return value
    }
    if value.type == VAL.prop {
        let on = value.value1
        if !isset(on) : return null
        // A typed borrow already carries the source lifetime. Taking an
        // interior address through it must not allocate a second stable root;
        // finalizer receivers in particular cannot allocate during gc_free.
        if on.rett.get_non_nullable().kind == TYPE.adr_of || on.rett.get_non_nullable().is_fat_borrow() {
            return value
        } else if on.rett.is_gc_type() {
            let rooted = value_permanent_borrow_root(on, ctx)
            if !isset(rooted) : return null
            value.value1 = rooted
        } else {
            let prepared = value_prepare_borrow_storage(on, ctx)
            if !isset(prepared) : return null
            value.value1 = prepared
        }
        return value
    }
    // Any other inline temporary, such as a struct returned by value, gets a
    // home in the frame like an aggregate literal
    if value.rett.is_inline_type() && !value.assignable() : return value_permanent_borrow_root(value, ctx)
    return null
}

fn value_is_method_receiver(value: Value, scope: Scope) bool {
    if value.type != VAL.decl : return false
    let func = scope.func
    if !isset(func) || !isset(func.class) || func.is_static : return false
    let receiver = func.args.get(0) !? null
    return isset(receiver) && value.decl == receiver.decl
}

fn method_receiver_borrow_compatible(source: Type, target: Type) bool !Error {
    let pointed = target.get_sub_type() ?! return false
    if source.kind == TYPE.ptr_of {
        let source_pointed = source.get_sub_type() ?! return false
        if target.length > 0 && (source.length == 0 || target.length > source.length) : return false
        return pointed.compat(source_pointed)
    }
    if source.is_struct_object() : return pointed.compat(source.inline() !>)
    return false
}

fn value_convert_array_copy(value: Value, target: Type, scope: Scope, ctx: Context) Value !Error {
    if value.rett == target : return value
    if (ir_type(value.rett) !>) == (ir_type(target) !>) : return value
    let source_type = value.rett.get_non_nullable()
    let array_type = target.get_non_nullable()
    if (ir_type(source_type) !>) == (ir_type(array_type) !>) : return vgen_wrap(value, target)
    let at = value.exp ?? (ctx.get_func() !>).exp
    let body = Array[Value]{}
    let source = value_bind_once(value, ctx, at, body)
    let source_element = source_type.get_sub_type() ?! at.bug("Array conversion has no source element")
    let target_element = array_type.get_sub_type() ?! at.bug("Array conversion has no target element")
    let input = value.rett.is_nullable_type() ? value_force_remove_nullable(source) : source
    let elements = Array[Value]{}
    let i: uint = 0
    while i < array_type.length {
        let element = vgen_multi_part(input, i, source_type.storage_view_of(source_element), at)
        let converted = value_try_convert(element, scope, ctx, target_element) !>
        target_element.compat_check(converted.rett, at) !>
        elements.append(converted)
        i++
    }
    let result = vgen_array_init(ctx, elements, array_type, at)
    if target.is_nullable_type() : result = value_make_nullable(result)
    if value.rett.is_nullable_type() {
        result = vgen_this_or_that(vgen_isset_val(source, type_bool(ctx.build)), result, vgen_null(target), target)
    }
    if body.length == 0 : return result
    return vgen_scoped_value(body, result, at)
}

fn value_try_convert(
    v: Value,
    scope: Scope,
    ctx: Context,
    target: Type,
    is_auto: bool (true),
    allow_inline_borrow: bool (false),
    allow_shared_unsafe: bool (false),
    allow_shared_borrow: bool (false)
) Value !Error {
    if target.is_void_type() : return v
    let result = v
    // An error code becomes its name as text, like an enum
    if result.rett.kind == TYPE.error_code && target.get_non_nullable().get_class_or_null() == type_string(ctx.build).get_class_or_null() {
        return value_error_code_name(result, ctx) !>
    }

    // Read-only storage may only become a raw pointer under '@unsafe': the
    // pointer could be written through
    let raw_target = target.get_non_nullable()
    let source_nn0 = result.rett.get_non_nullable()
    if (raw_target.is_raw_pointer() || raw_target.kind == TYPE.ptr_of || raw_target.is_struct_object())
        && !source_nn0.is_raw_pointer() && source_nn0.kind != TYPE.ptr_of && !source_nn0.is_struct_object()
        && value_is_readonly_storage(result, ctx)
    {
        let at = result.exp
        if isset(at) : require_unsafe(at, scope, "Converting read-only storage to a raw pointer") !>
    }

    // A typed pointer is written through without '@unsafe', so one made from an untyped
    // address must be vouched for
    if (raw_target.kind == TYPE.ptr_of || raw_target.is_struct_object()) && source_nn0.is_raw_pointer() {
        let at = result.exp
        if isset(at) : require_unsafe(at, scope, "Converting a raw pointer to '" + raw_target.compat_display_name() + "'") !>
    }

    if target.kind == TYPE.closure && target.is_shared && result.rett.kind == TYPE.closure && !result.rett.is_shared {
        let receiver = result.value1
        let shared_receiver = result.type == VAL.func && isset(receiver)
            && receiver.rett.get_non_nullable().is_shared && !result.is_implicit_borrow()
        if value_is_capture_free_func(result) || shared_receiver {
            if type_has_coroutine_handle(result.rett, Array[Class]{}) {
                result.error("Cannot use this function as '" + target.compat_display_name() + "': a coroutine handle in its signature is bound to the thread that created it")
            }
            result.rett = result.rett.shared_type()
        }
    }

    let target_class = target.get_non_nullable().get_class_or_null()
    let source_class = result.rett.get_non_nullable().get_class_or_null()
    if isset(target_class) && target_class.kind == CLASS_KIND.interface
        && isset(source_class) && source_class.kind == CLASS_KIND.class
        && !result.rett.is_nullable_type()
        && !result.rett.get_non_nullable().is_locked
        // A shared object only becomes a shared interface value
        && (!result.rett.get_non_nullable().is_shared || target.get_non_nullable().is_shared)
        && class_implements_interface(source_class, target_class)
    {
        let adapter = target_class.interface_adapters.get(interface_adapter_key(source_class)) !? null
        if isset(adapter) {
            // An ordinary object becomes a shared or locked interface value through the publish below
            let target_view = target.get_non_nullable()
            let source_view = result.rett.get_non_nullable()
            if (target_view.is_shared || target_view.is_locked) && !source_view.is_shared && !source_view.is_locked {
                let wrapped = vgen_interface_wrap(result, target.plain_type(), adapter, ctx)
                return value_try_convert(wrapped, scope, ctx, target, is_auto, allow_inline_borrow, allow_shared_unsafe, allow_shared_borrow) !>
            }
            return vgen_interface_wrap(result, target, adapter, ctx)
        }
    }

    if result.rett.is_nullable_type() && !target.is_nullable_type() {
        if target.get_non_nullable().kind == TYPE.union {
            let union_value = value_try_union_convert(result, scope, ctx, target, is_auto) !>
            if isset(union_value) : return union_value
        }
        if value_stores_non_null(result, scope) : result = value_force_remove_nullable(result)
    }

    let target_nn = target.get_non_nullable()
    let source_nn = result.rett.get_non_nullable()
    // Strings are immutable: a shared view of one is the same value
    let string_class = type_string(ctx.build).get_class_or_null()
    if isset(string_class) && !result.rett.is_nullable_type() && !target.is_nullable_type()
        && source_nn.get_class_or_null() == string_class && target_nn.get_class_or_null() == string_class
        && source_nn.is_shared != target_nn.is_shared && !source_nn.is_locked && !target_nn.is_locked
    {
        let retyped = vgen_cast(result, target)
        retyped.exp = result.exp
        return retyped
    }
    // An ordinary graph becomes a shared or locked view the same way: it
    // must be unique, and it is published from here on.
    let to_view = (target_nn.is_shared && !source_nn.is_shared)
        || (target_nn.is_locked && !source_nn.is_locked && !source_nn.is_shared)
    let same_slice = target_nn.kind == TYPE.ref_slice && source_nn.kind == TYPE.ref_slice
        && target_nn.is_mut == source_nn.is_mut && target_nn.get_sub_type() == source_nn.get_sub_type()
    // Inline aggregates carrying references become shared the same way: the
    // value is copied, but the references it carries are what get published.
    // Closures keep their own path; a shared closure is built where it is made.
    // A tuple stored into locked data has locked members, and moves in like any other graph
    let source_tuple = source_nn.kind == TYPE.struct && source_nn.is_inline && !isset(source_nn.class)
    if !to_view && source_tuple && target_nn.has_locked_refs() && !source_nn.has_locked_refs()
        && !result.rett.is_nullable_type() && target_nn.compat(source_nn.locked_storage_type())
    {
        if !allow_shared_unsafe && !allow_shared_borrow {
            result = value_publish_copy(result, ctx, scope, target) !>
        }
        return value_shared_view(result, target)
    }
    // A class becomes a shared or locked interface or union in two steps, so the
    // publish below sees the value the plain conversion made
    if to_view && (target_nn.kind == TYPE.interface || target_nn.kind == TYPE.union)
        && target_nn.get_class_or_null() != source_nn.get_class_or_null() {
        let plain = target.plain_type()
        if plain != target {
            let converted = value_try_convert(result, scope, ctx, plain, is_auto, allow_inline_borrow, false, false) !>
            if plain.compat(converted.rett) && converted.rett.get_non_nullable().get_class_or_null() == target_nn.get_class_or_null() {
                return value_try_convert(converted, scope, ctx, target, is_auto, allow_inline_borrow, allow_shared_unsafe, allow_shared_borrow) !>
            }
        }
    }
    let inline_aggregate = target_nn.kind == TYPE.struct || target_nn.kind == TYPE.union || target_nn.is_fixed_array_type()
    let carries_managed_graph = target_nn.is_gc_type() || target_nn.kind == TYPE.interface
        || (inline_aggregate && target_nn.has_gc_refs())
    if to_view
        && (carries_managed_graph || same_slice)
        && target_nn.get_class_or_null() == source_nn.get_class_or_null()
        && (target.is_nullable_type() || !result.rett.is_nullable_type())
    {
        if !allow_shared_unsafe && !allow_shared_borrow {
            // A closure written as a 'shared fn' has its captures checked when
            // it is created. One that only becomes shared because the object
            // holding it was published never got that check, so its captured
            // values could still be mutated from another thread. Locked data
            // runs its closures under the lock only.
            if type_has_coroutine_handle(source_nn, Array[Class]{}) {
                result.error("Cannot publish '" + target.compat_display_name() + "' as shared: it reaches a coroutine handle, which is bound to the thread that created it")
            }
            if !target_nn.is_locked && type_has_unpublishable_closure(source_nn, Array[Class]{}) {
                let closure_prop = type_find_unpublishable_closure(source_nn, Array[Class]{})
                let where = isset(closure_prop)
                    ? "property '" + closure_prop.class.name + "." + (closure_prop.name ?? "?") + "' reaches"
                    : "it reaches"
                result.error("Cannot publish '" + target.compat_display_name() + "' as shared: " + where
                    + " a closure whose captured values were never checked for shared use."
                    + " Declare it as a 'shared fn(...)()' so its captures are checked where the closure is created")
            }
            result = value_publish_copy(result, ctx, scope, target) !>
        }
        return value_shared_view(result, target)
    }

    let union_value = value_try_union_convert(result, scope, ctx, target, is_auto) !>
    if isset(union_value) : return union_value

    if !result.rett.is_nullable_type() {
        let class = value_member_class(result.rett)
        if isset(class) {
            let hook = class_get_to_hook(class, target, is_auto)
            if isset(hook) {
                // A conversion hook is an ordinary method call, so a shared
                // receiver selects the shared variant like anywhere else
                let at = result.exp ?? hook.exp
                act_check_hook(at, hook) !>
                let receiver = value_read_borrowed_receiver(result, scope, ctx, at) !>
                if receiver.rett.is_nullable_type() {
                    at.error("You cannot access properties/functions on a nullable type: " + receiver.rett.compat_display_name())
                }
                hook = func_for_receiver(hook, receiver, at, ctx.func) !>
                let callee = vgen_func(hook, receiver)
                let args = Array[Value]{}
                value_fill_trailing_defaults(hook, call_receiver_skip(callee, hook), args, scope, ctx, at) !>
                value_check_call_args(hook, callee, args, scope, ctx, at) !>
                let call = vgen_call(ctx, callee, args, hook.get_rett(), scope)
                call.exp = result.exp
                result = call
            }
        }
    }

    // Enum values come from their declared items or conversion hooks.
    let target_enum = target.get_enum() ?? target.get_non_nullable().get_enum()
    if isset(target_enum) && result.type != VAL.null && (result.rett.get_enum() ?? result.rett.get_non_nullable().get_enum()) != target_enum {
        result.error("Cannot convert value to enum: '" + target_enum.name + "'")
    }

    let result_nn = result.rett.get_non_nullable()
    let numbers = value_shared_numbers_borrow(result, target)
    if isset(numbers) : return numbers
    // `cond ? a : b` borrows whichever storage it picks: each arm converts on its own
    if result.type == VAL.this_or_that && target_nn.is_fat_borrow() && !result_nn.is_fat_borrow() && result_nn.is_inline {
        let cond = result.value1
        let then_v = result.value2
        let else_v = result.values?.get(0) !? null
        if isset(cond) && isset(then_v) && isset(else_v) {
            let then_b = value_try_convert(then_v, scope, ctx, target, is_auto, allow_inline_borrow, allow_shared_unsafe, allow_shared_borrow) !>
            let else_b = value_try_convert(else_v, scope, ctx, target, is_auto, allow_inline_borrow, allow_shared_unsafe, allow_shared_borrow) !>
            if target.compat(then_b.rett) && target.compat(else_b.rett) {
                let picked = vgen_this_or_that(cond, then_b, else_b, target)
                picked.exp = result.exp
                return picked
            }
        }
    }
    if result_nn.is_fat_borrow() || target_nn.is_fat_borrow() {
        let borrowed = value_convert_borrow(result, scope, ctx, target, allow_inline_borrow) !>
        if isset(borrowed) : return borrowed
    }
    if target_nn.kind == TYPE.adr_of
        && (result_nn.kind == TYPE.ptr_of || result_nn.is_struct_object())
    {
        if !target.is_nullable_type() && value_is_method_receiver(result, scope)
            && (method_receiver_borrow_compatible(result_nn, target_nn) !>)
        {
            let borrowed = vgen_wrap(result, target)
            borrowed.mark_implicit_borrow()
            return borrowed
        }
        result.error("Incompatible types: Cannot convert a raw pointer to a borrowed reference; use '.@cast' for an unsafe conversion")
    }

    if !is_auto && result.rett.kind == TYPE.closure && target.get_non_nullable().kind == TYPE.voidptr {
        let func = value_resolve_func_ref(result)
        if isset(func) && !func.is_literal && value_is_capture_free_func(result) {
            return value_retype_function(result, TYPE.fnptr)
        }
    }

    if !target.is_nullable_type() && !result.rett.is_nullable_type()
        && result.rett.is_raw_pointer() && target.is_uint_type()
    {
        return value_pointer_as_uint(result, target)
    }

    if target_nn.is_fixed_array_type() && result.rett.get_non_nullable().is_fixed_array_type()
        && target.compat(result.rett) {
        return value_convert_array_copy(result, target, scope, ctx) !>
    }

    // An untyped literal adopts a fitting integer target; one that does not fit never converts
    if result.type == VAL.int && target.is_integer_type() && value_is_untyped_int_literal(result, ctx.build) {
        if type_fits_int_literal(target, result.int_val, !result.rett.is_signed_type()) {
            let lit = vgen_int(result.int_val, target)
            lit.exp = result.exp
            return lit
        }
        if is_auto : result.error("Incompatible types: constant does not fit in '" + target.compat_display_name() + "'")
        return result
    }

    if target.compat(result.rett) && target.is_nullable_type() == result.rett.is_nullable_type() {
        return result
    }

    // A known function where a callback over locked elements is expected: its variant taking
    // locked arguments is checked like a method on locked data, so it cannot keep them
    if target_nn.kind == TYPE.closure && value_is_capture_free_func(result) && type_callable_takes_locked(target_nn)
        && !target_nn.compat(result.rett.get_non_nullable())
    {
        let func = result.func
        if isset(func) && func.args_view == 0 && !func.is_literal {
            let at = result.exp ?? ctx.get_func().exp
            let converted = vgen_func(get_func_args_view(func, func, 2, at, ctx.get_func() !? null) !>)
            converted.exp = result.exp
            result = converted
        }
    }
    if result.rett.kind == TYPE.closure && target.kind == TYPE.fnptr {
        if value_is_capture_free_func(result) {
            result = value_retype_function(result, TYPE.fnptr)
        }
    }
    if result.rett.get_non_nullable().kind == TYPE.fnptr && target_nn.kind == TYPE.closure
        && (target.is_nullable_type() || !result.rett.is_nullable_type())
    {
        result = value_fnptr_closure(result, scope, ctx, target_nn.is_shared) !>
    }

    if target.is_nullable_type() {
        let nnt = target.get_non_nullable()
        result = value_try_convert(result, scope, ctx, nnt, is_auto, allow_inline_borrow, allow_shared_unsafe, allow_shared_borrow) !>
        if result.rett.is_nullable_type() : return result
        return vgen_wrap(result, result.rett.nullable())
    }


    if allow_inline_borrow && result.rett.is_inline_type() && !result.rett.is_number_type() && result.rett.kind != TYPE.closure
        && target.get_non_nullable().kind == TYPE.adr_of && inline_pointer_compat(result.rett, target)
    {
        if result.assignable() || result.type == VAL.array_init || result.type == VAL.class_init {
            let storage = value_prepare_borrow_storage(result, ctx)
            if isset(storage) {
                value_clear_borrowed_local_facts(result, scope)
                let borrowed = vgen_ptr_of(storage, target, result.exp)
                borrowed.mark_implicit_borrow()
                return borrowed
            }
        }
    }

    // A pointer view can be copied into fixed inline sequence storage.
    if target.is_fixed_array_type() && (result.rett.kind == TYPE.ptr_of || result.rett.kind == TYPE.adr_of) {
        let target_sub = target.get_sub_type()
        let source = result.rett.get_sub_type()
        if isset(target_sub) && isset(source) {
            let source_sub = source
            let source_size = result.rett.length
            let enough_values = source_size > 0 && target.length <= source_size
            if enough_values && target_sub.compat(source_sub) {
                let copied = vgen_load(result, source_sub.fixed_array(target.length), result.exp)
                return value_convert_array_copy(copied, target, scope, ctx) !>
            }
        }
    }

    // A borrowed struct is copied where the struct itself is expected, as `this[0]` does
    if !result.rett.is_nullable_type() && target_nn.kind == TYPE.struct
        && (result_nn.kind == TYPE.adr_of || (result_nn.kind == TYPE.ref_of && result_nn.length <= 1))
    {
        let pointed = result_nn.get_sub_type()
        let struct_class = target_nn.get_class_or_null()
        if isset(pointed) && isset(struct_class) && struct_class.representation_class().kind == CLASS_KIND.struct
            && pointed.get_class_or_null() == struct_class
        {
            let at = result.exp ?? (ctx.get_func() !>).exp
            let through = value_through_borrow(result, ctx)
            let zero = vgen_int(0, type_from_core(ctx.build, "uint") !>)
            let copied = value_sequence_element_read(vgen_ptrv(through, zero, pointed, at), scope, ctx, at) !>
            return value_try_convert(copied, scope, ctx, target, is_auto, allow_inline_borrow, allow_shared_unsafe, allow_shared_borrow) !>
        }
    }

    // Number → number (widen / signedness / int→float), same as old try_convert
    if result.rett.is_number_type() && target.is_number_type() {
        if result.type == VAL.int && target.is_integer_type() {
            if type_fits_int_literal(target, result.int_val, !result.rett.is_signed_type()) {
                let lit = vgen_int(result.int_val, target)
                lit.exp = result.exp
                return lit
            }
        }
        if result.type == VAL.int && target.is_float_type() {
            let c = vgen_cast(result, target)
            c.exp = result.exp
            return c
        }
        // A float literal takes the width of its target
        if result.type == VAL.float && target.is_float_type() {
            let lit = vgen_float(result.float_val, target)
            lit.exp = result.exp
            return lit
        }

        if result.rett.is_integer_type() && target.is_float_type() {
            return vgen_cast(result, target)
        }
        if result.rett.is_float_type() && target.is_float_type() {
            if result.rett.number_byte_size() < target.number_byte_size() {
                return vgen_cast(result, target)
            }
        }
        // int → wider int, or same size with different signedness
        if result.rett.is_integer_type() && target.is_integer_type() {
            let rs = result.rett.number_byte_size()
            let ts = target.number_byte_size()
            if rs < ts || (rs == ts && result.rett.is_signed_type() != target.is_signed_type()) {
                return vgen_cast(result, target)
            }
        }
        return result
    }

    // Other pointer forms may retype to bare `ptr`; integer casts are explicit.
    if !result.rett.is_nullable_type() && target.is_raw_pointer() {
        if result.rett.is_pointer()
            && (!is_auto || result.rett.is_raw_pointer() || result.rett.kind == TYPE.ptr_of
                || result.rett.kind == TYPE.adr_of || result.rett.is_struct_object())
        {
            return vgen_wrap(result, target)
        }
    }

    // Bare `ptr` → `*T` / `&T`.
    if !result.rett.is_nullable_type() && result.rett.is_raw_pointer()
        && (target.kind == TYPE.ptr_of || target.kind == TYPE.adr_of)
    {
        return vgen_wrap(result, target)
    }
    return result
}

// Pair returned by value_balance_numbers
struct ValuePair {
    left: Value
    right: Value
}

fn value_balance_union_equal(left: Value, right: Value, scope: Scope, ctx: Context) ValuePair !Error {
    let converted = value_try_union_convert(right, scope, ctx, left.rett, true) !>
    if isset(converted) : return ValuePair { left: left, right: converted }
    converted = value_try_union_convert(left, scope, ctx, right.rett, true) !>
    if isset(converted) : return ValuePair { left: converted, right: right }
    return ValuePair { left: left, right: right }
}

////////////////////////////
// Numeric balancing
////////////////////////////

fn value_balance_numbers(left: Value, right: Value, b: Build) ValuePair {
    let t1 = left.rett
    let t2 = right.rett
    if !t1.is_number_type() || !t2.is_number_type() {
        return ValuePair { left: left, right: right }
    }

    // Two constants of different integer types: an untyped literal adopts the other's
    // type; between two literals the one past i64.$max (unsigned) decides
    if left.type == VAL.int && right.type == VAL.int && !fold_integer_types_match(left, right) {
        let left_plain = value_is_untyped_int_literal(left, b) && t1.is_signed_type()
        let right_plain = value_is_untyped_int_literal(right, b) && t2.is_signed_type()
        if right_plain && !left_plain && type_fits_int_literal(t1, right.int_val, false) {
            let lit = vgen_int(right.int_val, t1)
            lit.exp = right.exp
            return ValuePair { left: left, right: lit }
        }
        if left_plain && !right_plain && type_fits_int_literal(t2, left.int_val, false) {
            let lit = vgen_int(left.int_val, t2)
            lit.exp = left.exp
            return ValuePair { left: lit, right: right }
        }
    }

    // Int literal soft-fit toward the other side first
    if left.type == VAL.int && right.type != VAL.int && t2.is_integer_type() {
        if type_fits_int_literal(t2, left.int_val, !t1.is_signed_type()) {
            let lit = vgen_int(left.int_val, t2)
            lit.exp = left.exp
            return ValuePair { left: lit, right: right }
        }
    }
    if right.type == VAL.int && left.type != VAL.int && t1.is_integer_type() {
        if type_fits_int_literal(t1, right.int_val, !t2.is_signed_type()) {
            let lit = vgen_int(right.int_val, t1)
            lit.exp = right.exp
            return ValuePair { left: left, right: lit }
        }
    }
    // An untyped literal next to a float takes that float's width
    if t2.is_float_type() && right.type != VAL.float && value_is_untyped_number_literal(left, b) {
        let lit = vgen_float(left.type == VAL.int ? left.int_val.to(f64) : left.float_val, t2)
        lit.exp = left.exp
        return ValuePair { left: lit, right: right }
    }
    if t1.is_float_type() && left.type != VAL.float && value_is_untyped_number_literal(right, b) {
        let lit = vgen_float(right.type == VAL.int ? right.int_val.to(f64) : right.float_val, t1)
        lit.exp = right.exp
        return ValuePair { left: left, right: lit }
    }

    let is_float = t1.is_float_type() || t2.is_float_type()
    let is_signed = t1.is_signed_type() || t2.is_signed_type()
    let s1 = t1.number_byte_size()
    let s2 = t2.number_byte_size()
    let psz = b.options.target.ptr_size.to(u32)

    let size: u32 = 0
    if is_float {
        size = s1 > s2 ? s1 : s2
    } else {
        // Promote smaller signed-mismatch operands like the old compiler
        let x1 = (s1 < psz && t1.is_signed_type() != is_signed) ? s1 * 2 : s1
        let x2 = (s2 < psz && t2.is_signed_type() != is_signed) ? s2 * 2 : s2
        size = x1 > x2 ? x1 : x2
    }
    if size > psz : return ValuePair { left: left, right: right }

    let common = type_number_sized(b, size, is_float, is_signed)
    if !isset(common) : return ValuePair { left: left, right: right }

    if !t1.compat(common) || t1.is_signed_type() != common.is_signed_type() || t1.number_byte_size() != common.number_byte_size() {
        left = vgen_cast(left, common)
    }
    if !t2.compat(common) || t2.is_signed_type() != common.is_signed_type() || t2.number_byte_size() != common.number_byte_size() {
        right = vgen_cast(right, common)
    }
    return ValuePair { left: left, right: right }
}

fn value_balance_pointer_integer(left: Value, right: Value, b: Build) ValuePair {
    let ptr_uint = type_ptr_uint(b)
    if left.rett.is_pointer() && right.rett.is_integer_type() {
        return ValuePair { left: value_pointer_as_uint(left, ptr_uint), right: vgen_cast(right, ptr_uint) }
    }
    if right.rett.is_pointer() && left.rett.is_integer_type() {
        return ValuePair { left: vgen_cast(left, ptr_uint), right: value_pointer_as_uint(right, ptr_uint) }
    }
    return ValuePair { left: left, right: right }
}

// Reuse the integer payload when inspecting a pointer-preserving bitwise result.
fn value_pointer_as_uint(value: Value, ptr_uint: Type) Value {
    if value.type == VAL.cast && value.rett.is_pointer() {
        let inner = value.value1
        if isset(inner) && inner.rett == ptr_uint : return inner
    }
    return vgen_cast(value, ptr_uint)
}

// Core integer/float type for a size + signedness (1/2/4/8 bytes).
fn type_number_sized(b: Build, size: u32, is_float: bool, is_signed: bool) ?Type {
    if is_float {
        if size <= 4 : return type_from_core_or_null(b, "f32")
        return type_from_core_or_null(b, "f64") ?? type_from_core_or_null(b, "float")
    }
    if is_signed {
        if size <= 1 : return type_from_core_or_null(b, "i8")
        if size <= 2 : return type_from_core_or_null(b, "i16")
        if size <= 4 : return type_from_core_or_null(b, "i32") ?? type_from_core_or_null(b, "int")
        return type_from_core_or_null(b, "i64") ?? type_from_core_or_null(b, "int")
    }
    if size <= 1 : return type_from_core_or_null(b, "u8")
    if size <= 2 : return type_from_core_or_null(b, "u16")
    if size <= 4 : return type_from_core_or_null(b, "u32") ?? type_from_core_or_null(b, "uint")
    return type_from_core_or_null(b, "u64") ?? type_from_core_or_null(b, "uint")
}

fn type_ptr_uint(b: Build) Type {
    return type_number_sized(b, b.options.target.ptr_size.to(u32), false, false) ?? type_int(b)
}

// A number written in the source without a type of its own: a literal, possibly
// negated, parenthesized, or combined with other such literals
fn exp_is_untyped_number(exp: Exp) bool {
    if exp.type != EXP.value : return false
    let kind = exp.value_kind
    if kind == VALUE_KIND.number || kind == VALUE_KIND.hex || kind == VALUE_KIND.octal || kind == VALUE_KIND.float : return true
    // A name, or `ns.NAME`, marked when it resolved to a `value NAME (literal)` constant
    if kind == VALUE_KIND.id || kind == VALUE_KIND.dot : return exp.bool1
    if kind == VALUE_KIND.paren || kind == VALUE_KIND.unary {
        let inner = exp.get(VALUE_EXP.left) ?! return false
        return exp_is_untyped_number(inner)
    }
    if kind == VALUE_KIND.op {
        let left = exp.get(VALUE_EXP.left) ?! return false
        let right = exp.get(VALUE_EXP.right) ?! return false
        return exp_is_untyped_number(left) && exp_is_untyped_number(right)
    }
    return false
}

// An untyped literal that was typed 'int' (or 'uint' past i64.$max) only for lack of a better type
fn value_is_untyped_int_literal(v: Value, b: Build) bool {
    let t = v.rett
    if !t.is_integer_type() || t.number_byte_size() != b.options.target.ptr_size.to(u32) : return false
    let exp = v.exp ?! return false
    return exp_is_untyped_number(exp)
}

// An int or float constant written in the source that has not adopted a type yet
fn value_is_untyped_number_literal(v: Value, b: Build) bool {
    if v.type == VAL.int : return value_is_untyped_int_literal(v, b)
    if v.type != VAL.float || v.rett.number_byte_size() != 8 : return false
    let exp = v.exp ?! return false
    return exp_is_untyped_number(exp)
}

// The type of a ternary whose one side is the constant `literal` and the other a `other`:
// `other` when the constant fits it, else the closest type that holds both
// (u16 for 300 and a u8, i16 for -1 and a u8, float for 1.5 and an integer); null when
// there is none, and the literal keeps its own type
fn type_holding_literal(literal: Value, other: Type, b: Build) ?Type {
    if value_literal_fits(literal, other) : return other
    if !other.is_integer_type() : return null
    if literal.type == VAL.float : return literal.rett
    if literal.type != VAL.int : return null
    let unsigned_literal = !literal.rett.is_signed_type()
    let signed = other.is_signed_type() || (!unsigned_literal && literal.int_val < 0)
    // A signed type holds every value of an unsigned one only when it is wider
    let min_bytes = other.number_byte_size()
    if signed && !other.is_signed_type() : min_bytes = min_bytes * 2
    let bytes: u32 = 1
    while bytes <= 8 {
        if bytes >= min_bytes {
            let candidate = type_number_sized(b, bytes, false, signed)
            if isset(candidate) && type_fits_int_literal(candidate, literal.int_val, unsigned_literal) : return candidate
        }
        bytes = bytes * 2
    }
    return null
}

// Whether the number constant `v` keeps its value as a `t`: 1.5 is no integer, 300 no u8
fn value_literal_fits(v: Value, t: Type) bool {
    if v.type == VAL.float : return t.is_float_type()
    if v.type == VAL.int : return t.is_float_type() || type_fits_int_literal(t, v.int_val, !v.rett.is_signed_type())
    return true
}

// Can the integer constant `v` be represented in integer type `t`? `unsigned`
// says the constant has an unsigned type, so a negative `v` is a value past i64.$max
fn type_fits_int_literal(t: Type, v: int, unsigned: bool) bool {
    if !t.is_integer_type() : return false
    let bits = t.number_byte_size() * 8
    if bits == 0 || bits > 64 : return true
    if unsigned && v < 0 : return bits == 64 && !t.is_signed_type()
    if t.is_signed_type() {
        if bits >= 64 : return true
        if v < 0 : return v >= 0 - (1 << (bits - 1).to(int))
        return v <= (1 << (bits - 1).to(int)) - 1
    }
    if v < 0 : return false
    if bits >= 64 : return true
    return v <= (1 << bits.to(int)) - 1
}

////////////////////////////
// Operator hooks
////////////////////////////

fn class_get_to_hook(class: Class, target: Type, is_auto: bool) ?Func {
    each class.to_hooks as func {
        if is_auto && !func.auto_to : continue
        let fr = func.get_rett()
        if target.compat(fr) {
            let tc = target.get_class_or_null()
            let fc = fr.get_class_or_null()
            if tc == fc : return func
            if !isset(tc) && !isset(fc) : return func
            // A bare `&[T]` view accepts the named slice a hook hands out; a
            // string result is a value of its own, not a view of the source
            if !isset(tc) && target.get_non_nullable().kind == TYPE.ref_slice
                && fc != type_string(target.build).get_class_or_null() : return func
            if target.kind == TYPE.ptr_of && fr.is_raw_pointer() : return func
        }
    }
    return null
}

fn func_call_arg(func: Func) Arg !LookupError {
    let skip: uint = isset(func.class) && !func.is_static ? 1 : 0
    return func.args.get(skip) !>
}

// The `$add`, `$sub`, `$mul` or `$div` hooks of a class
fn class_arith_hooks(class: Class, op: VALUE_OP) Array[Func] {
    if op == VALUE_OP.sub : return class.sub_hooks
    if op == VALUE_OP.mul : return class.mul_hooks
    if op == VALUE_OP.div : return class.div_hooks
    return class.add_hooks
}

fn value_op_has_hook(op: VALUE_OP) bool {
    return op == VALUE_OP.add || op == VALUE_OP.sub || op == VALUE_OP.mul || op == VALUE_OP.div
}

fn class_get_arith_hook(class: Class, op: VALUE_OP, rtype: Type) ?Func {
    let hooks = class_arith_hooks(class, op)
    // Exact static type first, like compare hooks: a mode and its
    // representation type are compatible but pick different hooks.
    each hooks as func {
        let arg = func_call_arg(func) ! continue
        if type_identity_key(arg.type) == type_identity_key(rtype) : return func
    }
    each hooks as func {
        let arg = func_call_arg(func) ! continue
        if arg.type.compat(rtype) : return func
    }

    let rclass = value_member_class(rtype)
    if !isset(rclass) : return null
    each hooks as func {
        let arg = func_call_arg(func) ! continue
        let conversion = class_get_to_hook(rclass, arg.type, true)
        if isset(conversion) : return func
    }
    return null
}

fn value_try_add_hook(left: Value, right: Value, scope: Scope, ctx: Context, at: Exp) ?Value !Error {
    return value_try_arith_hook(left, right, VALUE_OP.add, scope, ctx, at) !>
}

// A `$add` (`+`) or `$sub` (`-`) hook call for `left op right`, if the left
// type defines one for the right type
fn value_try_arith_hook(left: Value, right: Value, op: VALUE_OP, scope: Scope, ctx: Context, at: Exp) ?Value !Error {
    if left.rett.is_nullable_type() || right.rett.is_nullable_type() : return null
    let b = ctx.build

    let l = left
    let r = right
    // `+` with a string on one side converts the other side to a string
    let string_class = op == VALUE_OP.add ? type_string(b).get_class_or_null() : null
    if isset(string_class) {
        let lc = value_member_class(l.rett)
        let rc = value_member_class(r.rett)
        if lc == string_class && rc != string_class {
            r = value_try_convert(r, scope, ctx, type_string(b)) !>
        } else if rc == string_class && lc != string_class {
            l = value_try_convert(l, scope, ctx, type_string(b)) !>
        }
    }

    let hook_class = value_member_class(l.rett)
    if !isset(hook_class) : return null
    let hook = class_get_arith_hook(hook_class, op, r.rett)
    if !isset(hook) {
        let mode_for = hook_class.mode_for_class
        if isset(mode_for) : hook = class_get_arith_hook(mode_for, op, r.rett)
    }
    if !isset(hook) : return null
    act_check_hook(at, hook) !>

    l = value_read_borrowed_receiver(l, scope, ctx, at) !>
    if l.rett.is_nullable_type() {
        at.error("You cannot access properties/functions on a nullable type: " + l.rett.compat_display_name())
    }
    hook = func_for_receiver(hook, l, at, ctx.func) !>
    let callee = vgen_func(hook, l)
    let args = Array[Value]{ r }
    value_check_call_args(hook, callee, args, scope, ctx, at) !>
    let call = vgen_call(ctx, callee, args, hook.get_rett(), scope)
    call.exp = at
    return call
}

fn compare_hook_receiver(type: Type, left_type: Type) Type {
    if type.is_local && type.kind == TYPE.ref_of && left_type.is_inline {
        return type.get_sub_type() ?? type
    }
    return type
}

fn hook_select_compare(hooks: Array[Func], left_type: Type, right_type: Type) ?Func {
    // Preserve the static mode at the call site: an exact hook beats one that
    // matches only because a mode and its representation type are compatible.
    each hooks as func {
        let args = func.args
        let arg1 = args.get(0) ! continue
        let arg2 = args.get(1) ! continue
        if type_identity_key(compare_hook_receiver(arg1.type, left_type)) != type_identity_key(left_type) : continue
        if type_identity_key(arg2.type) != type_identity_key(right_type) : continue
        return func
    }
    each hooks as func {
        let args = func.args
        let arg1 = args.get(0) ! continue
        let arg2 = args.get(1) ! continue
        if !compare_hook_receiver(arg1.type, left_type).compat(left_type) : continue
        if !arg2.type.compat(right_type) : continue
        return func
    }
    return null
}

fn class_get_compare_hook(class: Class, left_type: Type, right_type: Type, op: VALUE_OP) ?Func {
    let hooks: ?Array[Func] = null
    if op == VALUE_OP.eq : hooks = class.eq_hooks
    else if op == VALUE_OP.lt : hooks = class.lt_hooks
    else if op == VALUE_OP.lte : hooks = class.lte_hooks
    else if op == VALUE_OP.gt : hooks = class.gt_hooks
    else if op == VALUE_OP.gte : hooks = class.gte_hooks
    let hook = isset(hooks) ? hook_select_compare(hooks, left_type, right_type) : null
    if isset(hook) : return hook
    // A mode compares like the type it is a mode of unless it overrides the hook.
    let for_class = class.mode_for_class
    if isset(for_class) : return class_get_compare_hook(for_class, left_type, right_type, op)
    return null
}

// `a < b` is `b > a`
fn compare_op_converse(op: VALUE_OP) VALUE_OP {
    if op == VALUE_OP.lt : return VALUE_OP.gt
    if op == VALUE_OP.gt : return VALUE_OP.lt
    if op == VALUE_OP.lte : return VALUE_OP.gte
    if op == VALUE_OP.gte : return VALUE_OP.lte
    return op
}

// `a < b` is `!(a >= b)`
fn compare_op_complement(op: VALUE_OP) VALUE_OP {
    if op == VALUE_OP.lt : return VALUE_OP.gte
    if op == VALUE_OP.gte : return VALUE_OP.lt
    if op == VALUE_OP.gt : return VALUE_OP.lte
    if op == VALUE_OP.lte : return VALUE_OP.gt
    return op
}

// The hook that answers `left op right`: the operator's own hook, or one that gives the
// same answer with the operands swapped and/or the result negated, so a single ordering
// hook serves all four comparisons
struct CompareHook {
    func: ?Func
    swap: bool
    negate: bool
}

fn find_compare_hook(lc: ?Class, rc: ?Class, left_type: Type, right_type: Type, op: VALUE_OP) CompareHook {
    if isset(lc) {
        let direct = class_get_compare_hook(lc, left_type, right_type, op)
        if isset(direct) : return CompareHook { func: direct, swap: false, negate: false }
    }
    if op == VALUE_OP.eq {
        if isset(rc) {
            let swapped = class_get_compare_hook(rc, right_type, left_type, op)
            if isset(swapped) : return CompareHook { func: swapped, swap: true, negate: false }
        }
        return CompareHook { func: null, swap: false, negate: false }
    }
    if isset(rc) {
        let converse = class_get_compare_hook(rc, right_type, left_type, compare_op_converse(op))
        if isset(converse) : return CompareHook { func: converse, swap: true, negate: false }
    }
    if isset(lc) {
        let complement = class_get_compare_hook(lc, left_type, right_type, compare_op_complement(op))
        if isset(complement) : return CompareHook { func: complement, swap: false, negate: true }
    }
    if isset(rc) {
        let both = class_get_compare_hook(rc, right_type, left_type, compare_op_complement(compare_op_converse(op)))
        if isset(both) : return CompareHook { func: both, swap: true, negate: true }
    }
    return CompareHook { func: null, swap: false, negate: false }
}

////////////////////////////
// Operators and comparisons
////////////////////////////

fn value_check_logical_operand(v: Value, at: Exp) !Error {
    if !v.rett.is_bool_type() && !v.never_returns {
        at.error("Expected a value of type 'bool', not: " + v.rett.compat_display_name())
    }
}

// `left` is already lowered, see value_from_op_exp
fn value_from_short_circuit_exp(exp: Exp, left: Value, right_exp: Exp, op: VALUE_OP, scope: Scope, ctx: Context) Value !Error {
    let b = ctx.build
    let is_and = op == VALUE_OP.and
    value_check_logical_operand(left, exp) !>
    let facts = is_and ? left.get_issets() : left.get_not_issets()
    let sub = scope.sub_scope()
    sub.apply_issets(facts)
    let right = value_from_exp(right_exp, sub, ctx.without_suggested_type()) !>
    value_check_logical_operand(right, exp) !>
    // A fact the right side dropped (an assignment inside a value scope) no longer holds
    let removed = sub.not_null_removed
    if isset(removed) && isset(facts) : each removed as decl : facts.remove_value(decl)
    scope.absorb_removed(sub)

    let result = value_try_fold_op(left, right, op, b) ?? vgen_op(left, right, op, type_bool(b))
    result.exp = exp
    value_merge_facts(result, facts, is_and)
    value_merge_facts(result, is_and ? right.get_issets() : right.get_not_issets(), is_and)
    return result
}

fn value_validate_constant_integer_op(left: Value, right: Value, op: VALUE_OP, at: Exp) !Error {
    if !left.rett.is_integer_type() || !right.rett.is_integer_type() : return

    let right_const = value_constant_int(right)

    if (op == VALUE_OP.div || op == VALUE_OP.mod) && isset(right_const) {
        if right_const == 0 {
            at.error("Integer division or remainder by zero is undefined")
        }
        if right_const == -1 && left.rett.is_signed_type() {
            let left_const = value_constant_int(left)
            if isset(left_const) {
                let bits = left.rett.number_byte_size() * 8
                let min: int = -9223372036854775807 - 1
                if bits < 64 : min = 0 - (1 << (bits - 1).to(int))
                if left_const == min {
                    at.error("Signed integer minimum with divisor -1 is undefined for division and remainder")
                }
            }
        }
    }

    if (op == VALUE_OP.shl || op == VALUE_OP.shr) && isset(right_const) {
        let bits = left.rett.number_byte_size() * 8
        if right_const < 0 || right_const >= bits.to(int) {
            at.error("Shift count must be between 0 and " + (bits - 1).to_string())
        }
    }
}

// A bool is not a number: `n + flag`, `flag == 1` and `0 < x < 3` need an explicit
// `.to(int)`. Two bools still compare, and `&`, `|` and `^` combine them.
fn value_check_bool_number_mix(left: Value, right: Value, op: VALUE_OP, exp: Exp) !Error {
    let left_bool = left.rett.get_non_nullable().is_bool_type()
    let right_bool = right.rett.get_non_nullable().is_bool_type()
    if !left_bool && !right_bool : return
    let bitwise = op == VALUE_OP.bit_and || op == VALUE_OP.bit_or || op == VALUE_OP.bit_xor
    if left_bool && right_bool {
        if bitwise || value_op_is_compare(op) : return
    } else {
        // `"on: " + flag` joins text; only a number on the other side is a mix
        let other = left_bool ? right : left
        if !other.rett.get_non_nullable().is_number_type() : return
    }
    exp.error("A bool is not a number: convert it with '.to(int)' to use it in arithmetic or to compare it with a number")
}

fn value_op_is_compare(op: VALUE_OP) bool {
    return op == VALUE_OP.eq || op == VALUE_OP.ne || op == VALUE_OP.lt || op == VALUE_OP.gt || op == VALUE_OP.lte || op == VALUE_OP.gte
}

// The number type an operator's operands are steered towards, if any
fn value_op_numeric_target(ctx: Context) ?Type !Error {
    let suggested_type = ctx.suggested_type ?! return null
    if !suggested_type.is_number_type() : return null
    let number = suggested_type.get_non_nullable()
    let enu = number.get_enum()
    return isset(enu) ? (enu.get_item_type() !>).get_non_nullable() : number
}

fn value_op_left_ctx(op: VALUE_OP, ctx: Context) Context !Error {
    if op == VALUE_OP.and || op == VALUE_OP.or || value_op_is_compare(op) : return ctx.without_suggested_type()
    let numeric_target = value_op_numeric_target(ctx) !>
    return isset(numeric_target) ? ctx.with_suggested_type(numeric_target) : ctx.without_suggested_type()
}

fn value_from_op_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let left_exp = exp.get(VALUE_EXP.left) ?! exp.bug("Missing binary op operands")
    let op = exp.number.@cast(VALUE_OP)
    if left_exp.type != EXP.value || left_exp.value_kind != VALUE_KIND.op {
        let left = value_from_exp(left_exp, scope, value_op_left_ctx(op, ctx) !>) !>
        return value_from_op_left(exp, left, scope, ctx) !>
    }
    // `((a + b) + c) + d` nests on the left: walk the spine and lower it in a
    // loop, so a long generated chain does not recurse once per operand.
    let chain = Array[Exp]{ exp }
    let chain_ctx = Array[Context]{ ctx }
    let left_ctx = value_op_left_ctx(op, ctx) !>
    let leaf = left_exp
    while leaf.type == EXP.value && leaf.value_kind == VALUE_KIND.op {
        chain.append(leaf)
        chain_ctx.append(left_ctx)
        left_ctx = value_op_left_ctx(leaf.number.@cast(VALUE_OP), left_ctx) !>
        leaf = leaf.get(VALUE_EXP.left) ?! leaf.bug("Missing binary op operands")
    }
    let left = value_from_exp(leaf, scope, left_ctx) !>
    // Operator hooks turn the chain into nested calls, which the IR emits
    // recursively: bind every CHAIN_BIND_STEP-th call result to a slot first.
    let body = Array[Value]{}
    let i = chain.length
    while i > 0 {
        i--
        let node = chain.get(i) ! exp.bug("Missing chain node")
        let node_ctx = chain_ctx.get(i) ! exp.bug("Missing chain context")
        left = value_from_op_left(node, left, scope, node_ctx) !>
        if i > 0 && left.type == VAL.call && (chain.length - i) % CHAIN_BIND_STEP == 0 {
            left = value_bind_once(left, ctx, exp, body)
        }
    }
    return body.length > 0 ? vgen_scoped_value(body, left, exp) : left
}
value CHAIN_BIND_STEP (32)

// Lower `exp` with its left operand already lowered as `left`
fn value_from_op_left(exp: Exp, left: Value, scope: Scope, ctx: Context) Value !Error {
    let left_exp = exp.get(VALUE_EXP.left)
    let right_exp = exp.get(VALUE_EXP.right)
    if !isset(left_exp) || !isset(right_exp) : exp.bug("Missing binary op operands")
    let op = exp.number.@cast(VALUE_OP)
    let b = ctx.build

    if op == VALUE_OP.and || op == VALUE_OP.or {
        return value_from_short_circuit_exp(exp, left, right_exp, op, scope, ctx) !>
    }
    if value_op_is_compare(op) {
        return value_from_compare_exp(exp, left, right_exp, op, scope, ctx) !>
    }

    let numeric_target = value_op_numeric_target(ctx) !>
    left.require_result() !>
    left = value_try_remove_nullable(left, scope, ctx) !>

    let left_enum_value = left
    left = value_enum_representation(left) !>

    let left_pointer_kind = left.rett.get_non_nullable().kind
    let left_is_raw_pointer = left.rett.is_pointer()
        && (left_pointer_kind == TYPE.voidptr || left_pointer_kind == TYPE.ptr_of)
    if left_is_raw_pointer && (op == VALUE_OP.add || op == VALUE_OP.sub) {
        let offset = value_from_exp(right_exp, scope, ctx.with_suggested_type(type_int(b))) !>
        offset = value_try_convert(offset, scope, ctx, type_int(b)) !>
        if op == VALUE_OP.sub && offset.rett.is_raw_pointer() {
            let ptr_uint = type_ptr_uint(b)
            let laddr = vgen_cast(left, ptr_uint)
            let raddr = vgen_cast(offset, ptr_uint)
            let v = vgen_op(laddr, raddr, VALUE_OP.sub, ptr_uint)
            v.exp = exp
            return v
        }
        if !offset.rett.is_integer_type() {
            right_exp.error("Pointer offset must be an integer, got: " + offset.rett.compat_display_name())
        }
        if op == VALUE_OP.sub {
            offset = vgen_unary(offset, VALUE_OP.neg, offset.rett)
        }
        return vgen_ptr_offset(left, offset, exp)
    }

    let pointer_result_type: ?Type = null
    if left_is_raw_pointer {
        let ptr_uint = type_ptr_uint(b)
        if op == VALUE_OP.bit_and || op == VALUE_OP.bit_or || op == VALUE_OP.bit_xor {
            pointer_result_type = left.rett
        }
        left = value_pointer_as_uint(left, ptr_uint)
    }

    let right_ctx = isset(numeric_target) ? ctx.with_suggested_type(numeric_target) : (left.rett.is_void_type() ? ctx.without_suggested_type() : ctx.with_suggested_type(left.rett))
    let right = value_from_exp(right_exp, scope, right_ctx) !>
    right.require_result() !>
    right = value_try_remove_nullable(right, scope, ctx) !>

    let right_enum_value = right
    right = value_enum_representation(right) !>
    // `+` with text joins an enum's name, as `%{value}` does
    if op == VALUE_OP.add {
        let string_type = type_string(b)
        let string_class = string_type.get_class_or_null()
        if value_enum_has_text(right_enum_value, string_type) && left.rett.get_class_or_null() == string_class : right = value_try_convert(right_enum_value, scope, ctx, string_type) !>
        if value_enum_has_text(left_enum_value, string_type) && right.rett.get_class_or_null() == string_class : left = value_try_convert(left_enum_value, scope, ctx, string_type) !>
        if right.rett.kind == TYPE.error_code && left.rett.get_class_or_null() == string_class : right = value_error_code_name(right, ctx) !>
        if left.rett.kind == TYPE.error_code && right.rett.get_class_or_null() == string_class : left = value_error_code_name(left, ctx) !>
    }
    value_check_bool_number_mix(left, right, op, exp) !>

    if op == VALUE_OP.shl || op == VALUE_OP.shr {
        if !left.rett.is_integer_type() {
            left_exp.error("Shift operand must be an integer, got: " + left.rett.compat_display_name())
        }
        if !right.rett.is_integer_type() {
            right_exp.error("Shift operand must be an integer, got: " + right.rett.compat_display_name())
        }
    }

    if isset(numeric_target) && exp_is_untyped_number(exp) {
        left = value_try_convert(left, scope, ctx, numeric_target) !>
        right = value_try_convert(right, scope, ctx, numeric_target) !>
        numeric_target.compat_check(left.rett, left_exp) !>
        numeric_target.compat_check(right.rett, right_exp) !>
    } else if isset(numeric_target) && numeric_target.is_integer_type() {
        // A literal that does not fit the other operand takes the hinted type when it fits
        if value_is_untyped_int_literal(left, b) && right.rett.is_integer_type() && right.type != VAL.int
            && !type_fits_int_literal(right.rett, left.int_val, !left.rett.is_signed_type())
            && type_fits_int_literal(numeric_target, left.int_val, !left.rett.is_signed_type()) {
            left = vgen_int(left.int_val, numeric_target)
            left.exp = left_exp
        }
        if value_is_untyped_int_literal(right, b) && left.rett.is_integer_type() && left.type != VAL.int
            && !type_fits_int_literal(left.rett, right.int_val, !right.rett.is_signed_type())
            && type_fits_int_literal(numeric_target, right.int_val, !right.rett.is_signed_type()) {
            right = vgen_int(right.int_val, numeric_target)
            right.exp = right_exp
        }
    }

    value_validate_constant_integer_op(left, right, op, exp) !>
    // Literal arithmetic must fit its type; typed constants wrap like runtime values
    if left.type == VAL.int && right.type == VAL.int && exp_is_untyped_number(exp)
        && fold_integer_overflows(left.int_val, right.int_val, op, left.rett) {
        exp.error("Incompatible types: constant expression does not fit in '" + left.rett.compat_display_name() + "'")
    }

    // An enum only compares with itself: its storage value is not its identity
    let left_enum = left.rett.get_non_nullable().get_enum()
    let right_enum = right.rett.get_non_nullable().get_enum()
    if left_enum != right_enum {
        if isset(left_enum) : left.rett.get_non_nullable().compat_check(right.rett.get_non_nullable(), exp) !>
        right.rett.get_non_nullable().compat_check(left.rett.get_non_nullable(), exp) !>
    }

    // `&`, `|` and `^` of two bools are a bool (value_check_bool_number_mix allows no other op)
    if left.rett.is_bool_type() && right.rett.is_bool_type() {
        let v = vgen_op(left, right, op, type_bool(b))
        v.exp = exp
        return v
    }

    let folded = value_try_fold_op(left, right, op, b)
    if isset(folded) {
        folded.exp = exp
        return folded
    }
    if value_op_has_hook(op) {
        let hooked = value_try_arith_hook(left, right, op, scope, ctx, exp) !>
        if isset(hooked) : return hooked
        let left_class = left.rett.get_class_or_null()
        if isset(left_class) && !left.rett.is_number_type() {
            exp.error("Cannot do math operations on types: '" + left.rett.compat_display_name() + "' <> '" + right.rett.compat_display_name() + "'")
        }
    }
    let balanced = value_balance_numbers(left, right, b)
    left = balanced.left
    right = balanced.right
    value_check_op_compat(left, right, op, exp) !>
    let v = vgen_op(left, right, op, left.rett)
    v.exp = exp
    if isset(pointer_result_type) {
        let pointer = vgen_cast(v, pointer_result_type)
        pointer.exp = exp
        return pointer
    }
    return v
}

fn value_native_comparable(type: Type) bool {
    let t = type.get_non_nullable()
    return t.is_number_type() || t.is_pointer() || t.kind == TYPE.interface || t.kind == TYPE.error_code
}

// A class instance or array: a pointer to an object, not a raw pointer or a number
fn value_is_object_type(type: Type) bool {
    let t = type.get_non_nullable()
    if !t.is_gc_type() || t.kind == TYPE.co : return false
    let c = t.get_class_or_null() ?! return t.kind == TYPE.array
    let kind = c.representation_class().kind
    return kind == CLASS_KIND.class || kind == CLASS_KIND.array
}

fn class_declares_order_hook(class: Class) bool {
    each class.funcs as func {
        let flags = func.flags ?! continue
        if flags.contains("$lt") || flags.contains("$gt") || flags.contains("$lte") || flags.contains("$gte") : return true
    }
    return false
}

// Hook and method queries read what a class declares, but the pipeline may not have
// reached the class yet: register its methods first, and parse the signatures of its `hooks`
fn type_settle_hooks(type: Type, hooks: Array[String]) !Error {
    let current = type.get_class_or_null()
    while isset(current) {
        if current.is_generic_base : return
        // A mode's target is known once it is parsed
        if current.kind == CLASS_KIND.mode : parse_class_properties(current) !>
        else : register_class_methods(current) !>
        each current.funcs as func {
            let flags = func.flags ?! continue
            each hooks as hook {
                if flags.contains(hook) {
                    parse_func_types(func) !>
                    break
                }
            }
        }
        current = current.mode_for_class
    }
}

fn type_can_order(type: Type) bool !Error {
    let t = type.get_non_nullable()
    if t.kind == TYPE.union || t.kind == TYPE.closure : return false
    let object = value_is_object_type(t)
    if value_native_comparable(t) && !object : return true
    let class = t.get_class_or_null() ?! return false
    // An object orders only through a hook. The declared flags tell without parsing its
    // signature, as the class may be in the middle of its own instantiation here
    if object && !isset(class.mode_for_exp) {
        type_settle_hooks(t, Array[String]{}) !>
        return class_declares_order_hook(class)
    }
    type_settle_hooks(t, Array[String]{ "$lt", "$gt", "$lte", "$gte" }) !>
    // Any one ordering hook answers all four comparisons
    return isset(find_compare_hook(class, class, t, t, VALUE_OP.gt).func)
}

// `left_view` / `right_view`: the aggregates' types, whose shared or locked view the parts keep
fn value_structural_equal_part(result: Value, left: Value, right: Value, offset: u32, type: Type,
left_view: Type, right_view: Type, scope: Scope, ctx: Context, at: Exp) Value !Error {
    let b = ctx.build
    let byte_offset = vgen_int(offset.to(int), type_i64(b))
    let left_value = vgen_load(vgen_ptr_offset(left, byte_offset, at), left_view.storage_view_of(type), at)
    let right_value = vgen_load(vgen_ptr_offset(right, byte_offset, at), right_view.storage_view_of(type), at)
    let equal = value_compare_values(left_value, right_value, VALUE_OP.eq, scope, ctx, at) !>
    return vgen_this_or_that(result, equal, vgen_bool(false, type_bool(b)), type_bool(b))
}

// Longer fixed arrays compare in a loop
value FIXED_EQUAL_UNROLL (8)

fn value_structural_equal(left: Value, right: Value, scope: Scope, ctx: Context, at: Exp) Value !Error {
    let b = ctx.build
    let type = left.rett.get_non_nullable()
    let func = ctx.get_func() !>
    let right_type = right.rett.get_non_nullable()
    let left_slot = vgen_scratch_value(func, type, at)
    let right_slot = vgen_scratch_value(func, right_type, at)
    let left_address = vgen_cast(left_slot, type_ptr(b))
    let right_address = vgen_cast(right_slot, type_ptr(b))
    let result = vgen_bool(true, type_bool(b))

    if type.is_fixed_array_type() && type.length > FIXED_EQUAL_UNROLL {
        let member = type.get_sub_type() ?! at.bug("Fixed array comparison has no element type")
        let i64_t = type_i64(b)
        let stride = (member.byte_size() !>).to(int)
        let bool_t = type_bool(b)
        let index = vgen_scratch_storage(func, i64_t)
        let same = vgen_scratch_storage(func, bool_t)
        let left_offset = vgen_op(vgen_decl(index), vgen_int(stride, i64_t), VALUE_OP.mul, i64_t)
        let right_offset = vgen_op(vgen_decl(index), vgen_int(stride, i64_t), VALUE_OP.mul, i64_t)
        let left_value = vgen_load(vgen_ptr_offset(left_address, left_offset, at), type.storage_view_of(member), at)
        let right_value = vgen_load(vgen_ptr_offset(right_address, right_offset, at), right_type.storage_view_of(member), at)
        let equal = value_compare_values(left_value, right_value, VALUE_OP.eq, scope, ctx, at) !>
        let differs = vgen_if(vgen_unary(equal, VALUE_OP.not, bool_t), Array[Value]{
            vgen_assign(vgen_decl(same), vgen_bool(false, bool_t), ASSIGN_OP.set, b, at)
            vgen_break(b, at)
        }, null, b, at)
        let more = vgen_op(vgen_decl(index), vgen_int(type.length.to(int), i64_t), VALUE_OP.lt, bool_t)
        let loop = vgen_while(more, Array[Value]{
            differs
            vgen_assign(vgen_decl(index), vgen_int(1, i64_t), ASSIGN_OP.add, b, at)
        }, b, at)
        let body = Array[Value]{
            vgen_assign(left_slot, left, ASSIGN_OP.set, b, at)
            vgen_assign(right_slot, right, ASSIGN_OP.set, b, at)
            vgen_assign(vgen_decl(index), vgen_int(0, i64_t), ASSIGN_OP.set, b, at)
            vgen_assign(vgen_decl(same), vgen_bool(true, bool_t), ASSIGN_OP.set, b, at)
            loop
        }
        return vgen_scoped_value(body, vgen_decl(same), at)
    }
    if type.is_fixed_array_type() {
        let member = type.get_sub_type() ?! at.bug("Fixed array comparison has no element type")
        let stride = member.byte_size() !>
        let i: u32 = 0
        while i < type.length {
            result = value_structural_equal_part(result, left_address, right_address, stride * i, member, type, right_type, scope, ctx, at) !>
            i++
        }
    } else if type.is_tuple_type() {
        let members = type.get_members() ?! at.bug("Multi-value comparison has no member types")
        let offset: u32 = 0
        each members as member {
            offset = member.ir_align_offset(offset) !>
            result = value_structural_equal_part(result, left_address, right_address, offset, member, type, right_type, scope, ctx, at) !>
            offset += member.byte_size() !>
        }
    } else {
        let class = type.class ?! at.bug("Inline comparison has no class")
        each class.props as prop {
            result = value_structural_equal_part(result, left_address, right_address, prop.offset, prop.type, type, right_type, scope, ctx, at) !>
        }
    }

    let body = Array[Value]{
        vgen_assign(left_slot, left, ASSIGN_OP.set, b, at)
        vgen_assign(right_slot, right, ASSIGN_OP.set, b, at)
    }
    return vgen_scoped_value(body, result, at)
}

fn value_union_equal(left: Value, right: Value, scope: Scope, ctx: Context, at: Exp) Value !Error {
    let b = ctx.build
    let bool_t = type_bool(b)
    let union = left.rett.get_non_nullable()
    let members = union.get_members()
    if !isset(members) : at.bug("Tagged union comparison has no alternatives")
    let func = ctx.get_func() !>
    let left_slot = vgen_scratch_value(func, union, at)
    let right_slot = vgen_scratch_value(func, union, at)
    let result = vgen_bool(false, bool_t)

    each members as member, index {
        let left_active = vgen_union_is(left_slot, index, at)
        let right_active = vgen_union_is(right_slot, index, at)
        let active = vgen_op(left_active, right_active, VALUE_OP.bit_and, bool_t)
        if member.is_null_alt() {
            result = vgen_this_or_that(active, vgen_bool(true, bool_t), result, bool_t)
            continue
        }
        let left_member = vgen_union_extract(left_slot, member, ctx, at) !>
        let right_member = vgen_union_extract(right_slot, member, ctx, at) !>
        let equal = value_compare_values(left_member, right_member, VALUE_OP.eq, scope, ctx, at) !>
        result = vgen_this_or_that(active, equal, result, bool_t)
    }

    let body = Array[Value]{
        vgen_assign(left_slot, left, ASSIGN_OP.set, b, at)
        vgen_assign(right_slot, right, ASSIGN_OP.set, b, at)
    }
    return vgen_scoped_value(body, result, at)
}

fn value_compare_values(left: Value, right: Value, op: VALUE_OP, scope: Scope, ctx: Context, exp: Exp) Value !Error {
    let b = ctx.build
    // `T == String`: whether two types are the same, known while compiling
    let left_type = left.as_type()
    let right_type = right.as_type()
    if isset(left_type) && isset(right_type) && (op == VALUE_OP.eq || op == VALUE_OP.ne) {
        let same = left_type.is_same_type(right_type)
        return vgen_bool(op == VALUE_OP.eq ? same : !same, type_bool(b))
    }
    // Borrows compare by address.
    left = value_borrow_compare_operand(left, ctx)
    right = value_borrow_compare_operand(right, ctx)
    if op == VALUE_OP.eq || op == VALUE_OP.ne {
        let unions = value_balance_union_equal(left, right, scope, ctx) !>
        left = unions.left
        right = unions.right
    }

    // An enum only compares with itself: its storage value is not its identity
    let left_enum = left.rett.get_non_nullable().get_enum()
    let right_enum = right.rett.get_non_nullable().get_enum()
    if left_enum != right_enum {
        if isset(left_enum) : left.rett.get_non_nullable().compat_check(right.rett.get_non_nullable(), exp) !>
        right.rett.get_non_nullable().compat_check(left.rett.get_non_nullable(), exp) !>
    }
    value_check_bool_number_mix(left, right, op, exp) !>

    let folded = value_try_fold_op(left, right, op, b)
    if isset(folded) {
        folded.exp = exp
        return folded
    }

    if left.rett.is_void_type() {
        exp.error("The left value type does not support compare operators: '" + left.rett.compat_display_name() + "'")
    }
    if right.rett.is_void_type() {
        exp.error("The right value type does not support compare operators: '" + right.rett.compat_display_name() + "'")
    }

    let l = value_try_remove_nullable(left, scope, ctx) !>
    let r = value_try_remove_nullable(right, scope, ctx) !>

    let noteq = false
    let cmp_op = op
    if cmp_op == VALUE_OP.ne {
        cmp_op = VALUE_OP.eq
        noteq = true
    }

    // A nullable side is checked and then compared, so both sides are evaluated once, in
    // order, into locals first
    let operand_stores = Array[Value]{}
    if cmp_op == VALUE_OP.eq && (l.rett.is_nullable_type() || r.rett.is_nullable_type()) {
        l = value_compare_operand_once(l, operand_stores, ctx)
        r = value_compare_operand_once(r, operand_stores, ctx)
    }

    if cmp_op != VALUE_OP.eq {
        let left_type = l.rett.get_non_nullable()
        let right_type = r.rett.get_non_nullable()
        if l.rett.is_nullable_type() || left_type.kind == TYPE.union || left_type.kind == TYPE.closure {
            exp.error("The left value type does not support compare operators: '" + l.rett.compat_display_name() + "'")
        }
        if r.rett.is_nullable_type() || right_type.kind == TYPE.union || right_type.kind == TYPE.closure {
            exp.error("The right value type does not support compare operators: '" + r.rett.compat_display_name() + "'")
        }
    }

    let nnl = l.rett.is_nullable_type() ? value_force_remove_nullable(l) : l
    let nnr = r.rett.is_nullable_type() ? value_force_remove_nullable(r) : r

    // A string compares with the text of the other side, as `+` joins it,
    // and a shared string is the same immutable value as a plain one
    let string_class = type_string(b).get_class_or_null()
    if isset(string_class) && !nnl.rett.is_nullable_type() && !nnr.rett.is_nullable_type() {
        let plain_string = type_string(b)
        if nnl.rett.get_class_or_null() == string_class && nnl.rett.is_shared : nnl = vgen_cast(nnl, plain_string)
        if nnr.rett.get_class_or_null() == string_class && nnr.rett.is_shared : nnr = vgen_cast(nnr, plain_string)
        let lsc = nnl.rett.get_class_or_null()
        let rsc = nnr.rett.get_class_or_null()
        if lsc == string_class && rsc != string_class && nnr.rett.is_number_type() : nnr = value_try_convert(nnr, scope, ctx, type_string(b)) !>
        else if rsc == string_class && lsc != string_class && nnl.rett.is_number_type() : nnl = value_try_convert(nnl, scope, ctx, type_string(b)) !>
    }

    // A shared or locked view compares like its plain type
    let found = find_compare_hook(nnl.rett.get_class_or_null(), nnr.rett.get_class_or_null(), type_without_view(nnl.rett), type_without_view(nnr.rett), cmp_op)
    let hook = found.func
    if found.swap {
        let tmp = nnl
        nnl = nnr
        nnr = tmp
        let tmp2 = l
        l = r
        r = tmp2
    }

    let cmp: Value = vgen_op(nnl, nnr, cmp_op, type_bool(b))
    if isset(hook) {
        act_check_hook(exp, hook) !>
        let base = hook
        hook = func_for_receiver(hook, nnl, exp, ctx.func) !>
        // A view on the right is taken by a variant whose argument keeps that view
        let right_view = type_view_kind(nnr.rett)
        if right_view > 0 && !base.is_static && !base.threadsafe {
            hook = get_func_args_view(base, hook, right_view, exp, ctx.func) !>
        }
        let callee = vgen_func(hook, nnl)
        let args = Array[Value]{ nnr }
        value_check_call_args(hook, callee, args, scope, ctx, exp) !>
        cmp = vgen_call(ctx, callee, args, type_bool(b), scope)
        if found.negate : cmp = vgen_unary(cmp, VALUE_OP.not, type_bool(b))
    } else {
        // Without a hook, an object against a number would compare its address
        let obj_left = value_is_object_type(nnl.rett) && nnr.rett.is_number_type()
        if obj_left || (value_is_object_type(nnr.rett) && nnl.rett.is_number_type()) {
            let obj_type = obj_left ? nnl.rett : nnr.rett
            let num_type = obj_left ? nnr.rett : nnl.rett
            exp.error("Type '" + obj_type.compat_display_name() + "' has no hook for this comparison with '" + num_type.compat_display_name() + "'")
        }
        let pointers = value_balance_pointer_integer(nnl, nnr, b)
        nnl = pointers.left
        nnr = pointers.right
        let balanced = value_balance_numbers(nnl, nnr, b)
        nnl = balanced.left
        nnr = balanced.right
        // An object compares with an interface it implements as that interface, the way
        // `Array[Animal].contains(dog)` takes it
        if value_is_interface_type(nnl.rett) && !value_is_interface_type(nnr.rett) {
            nnr = value_try_convert(nnr, scope, ctx, nnl.rett) !>
        } else if value_is_interface_type(nnr.rett) && !value_is_interface_type(nnl.rett) {
            nnl = value_try_convert(nnl, scope, ctx, nnr.rett) !>
        }
        if !nnl.rett.is_void_type() && !nnr.rett.is_void_type() {
            let lt = type_without_view(nnl.rett)
            let rt = type_without_view(nnr.rett)
            if !lt.compat(rt) && !rt.compat(lt) {
                lt.compat_check(rt, exp) !>
            }
        }
        let compare_type = nnl.rett.get_non_nullable().kind
        if compare_type == TYPE.union {
            cmp = value_union_equal(nnl, nnr, scope, ctx, exp) !>
        } else if cmp_op == VALUE_OP.eq
            && nnl.rett.get_non_nullable().is_inline {
            cmp = value_structural_equal(nnl, nnr, scope, ctx, exp) !>
        } else {
            if compare_type != TYPE.closure && !value_native_comparable(nnl.rett) {
                exp.error("The left value type does not support compare operators: '" + nnl.rett.compat_display_name() + "'")
            }
            if nnr.rett.get_non_nullable().kind != TYPE.closure && !value_native_comparable(nnr.rett) {
                exp.error("The right value type does not support compare operators: '" + nnr.rett.compat_display_name() + "'")
            }
            // Objects are equal when they are the same object, but their addresses have no order
            if cmp_op != VALUE_OP.eq {
                let unordered = value_is_object_type(nnl.rett) ? nnl.rett : (value_is_object_type(nnr.rett) ? nnr.rett : null)
                if isset(unordered) {
                    exp.error("Type '" + unordered.compat_display_name() + "' has no order: give it a method marked '$lt' (or '$gt', '$lte', '$gte')")
                }
            }
            cmp = vgen_op(nnl, nnr, cmp_op, type_bool(b))
        }
    }

    if cmp_op == VALUE_OP.eq {
        let bool_t = type_bool(b)
        if l.rett.is_nullable_type() && r.rett.is_nullable_type() {
            let issetl = vgen_isset_val(l, bool_t)
            let issetr = vgen_isset_val(r, bool_t)
            let either_set = vgen_op(issetl, issetr, VALUE_OP.or, bool_t)
            let both_null = vgen_unary(either_set, VALUE_OP.not, bool_t)
            let both_set = vgen_op(issetl, issetr, VALUE_OP.and, bool_t)
            let set_and_eq = vgen_op(both_set, cmp, VALUE_OP.and, bool_t)
            cmp = vgen_op(both_null, set_and_eq, VALUE_OP.or, bool_t)
        } else if l.rett.is_nullable_type() {
            cmp = vgen_op(vgen_isset_val(l, bool_t), cmp, VALUE_OP.and, bool_t)
        } else if r.rett.is_nullable_type() {
            cmp = vgen_op(vgen_isset_val(r, bool_t), cmp, VALUE_OP.and, bool_t)
        }
    }

    if noteq {
        cmp = vgen_unary(cmp, VALUE_OP.not, type_bool(b))
    }
    if operand_stores.length > 0 {
        cmp = vgen_wrap(cmp, cmp.rett)
        cmp.set_pre_value(vgen_block(operand_stores, b, exp))
    }
    cmp.exp = exp
    return cmp
}

// `v` read from a local that `stores` fills, unless it is a variable or a constant already
fn value_compare_operand_once(v: Value, stores: Array[Value], ctx: Context) Value {
    let t = v.type
    if t == VAL.int || t == VAL.float || t == VAL.bool || t == VAL.string || t == VAL.null : return v
    let cached = value_null_op_operand(v, ctx)
    let store = cached.get_pre_value() ?! return cached
    stores.append(store)
    return value_null_op_operand_read(cached)
}

// A shared or locked type as its plain type, which a comparison treats it as
fn type_without_view(type: Type) Type {
    return type_view_kind(type) > 0 ? type.plain_type() : type
}

// 1 for a shared view, 2 for a locked one
fn type_view_kind(type: Type) u8 {
    let nn = type.get_non_nullable()
    if nn.is_locked : return 2
    if nn.is_shared : return 1
    return 0
}

fn value_from_compare_exp(exp: Exp, left: Value, right_exp: Exp, op: VALUE_OP, scope: Scope, ctx: Context) Value !Error {
    // `t.items == .{ 1 }` builds a plain literal, not one published into the view
    let right_ctx = left.rett.is_void_type() ? ctx.without_suggested_type() : ctx.with_suggested_type(type_without_view(left.rett))
    let right = value_from_exp(right_exp, scope, right_ctx) !>
    return value_compare_values(left, right, op, scope, ctx, exp) !>
}

////////////////////////////
// isset and ternary
////////////////////////////

fn vgen_isset_val(on: Value, bool_t: Type) Value {
    return Value {
        type: VAL.isset
        value1: on
        rett: bool_t
        exp: on.exp
    }
}

// ---- isset(v) ----

fn value_from_isset_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let inner_exp = exp.get(VALUE_EXP.left)
    if !isset(inner_exp) : exp.bug("Missing isset operand")
    let on = value_from_exp(inner_exp, scope, ctx.without_suggested_type()) !>
    let b = ctx.build
    let bool_t = type_bool(b)

    if on.rett.is_nullable_type() {
        let v = vgen_isset_val(on, bool_t)
        v.exp = exp
        value_add_isset(v, on)
        return v
    }

    if on.rett.kind == TYPE.union {
        let null_tag = on.rett.union_null_tag()
        if isset(null_tag) {
            let is_null = vgen_union_is(on, null_tag, exp)
            return vgen_unary(is_null, VALUE_OP.not, bool_t)
        }
    }

    let v = vgen_bool(true, bool_t)
    v.exp = exp
    v.set_pre_value(on)
    value_add_isset(v, on)
    return v
}

// ---- ternary / ?? / ?! ----

fn value_from_ternary_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let cond_exp = exp.get(VALUE_EXP.left)
    let then_exp = exp.get(VALUE_EXP.right)
    let else_exp = exp.get(VALUE_EXP.third)
    if !isset(cond_exp) || !isset(then_exp) || !isset(else_exp) : exp.bug("Incomplete ternary")

    let cond = value_from_exp(cond_exp, scope, ctx.with_suggested_type(type_bool(ctx.build))) !>
    if !cond.rett.is_bool_type() && !cond.never_returns {
        exp.error("You can only use '?' after values that return a bool. This value has type: " + cond.rett.compat_display_name())
    }

    let then_scope = scope.sub_scope()
    then_scope.apply_issets(cond.get_issets())
    let v1 = value_from_exp(then_exp, then_scope, ctx) !>
    let suggested_type = ctx.suggested_type
    if isset(suggested_type) && !then_scope.did_return {
        v1 = value_try_convert(v1, then_scope, ctx, suggested_type) !>
    }

    let else_scope = scope.sub_scope()
    else_scope.apply_issets(cond.get_not_issets())
    let else_ctx = ctx
    // A number literal is typed below, from both sides
    if !isset(suggested_type) && !then_scope.did_return && !v1.rett.is_void_type() && !exp_is_untyped_number(else_exp) {
        else_ctx = ctx.with_suggested_type(v1.rett)
    }
    let v2 = value_from_exp(else_exp, else_scope, else_ctx) !>
    if isset(suggested_type) && !else_scope.did_return {
        v2 = value_try_convert(v2, else_scope, ctx, suggested_type) !>
    }
    scope.absorb_removed(then_scope)
    scope.absorb_removed(else_scope)

    if then_scope.did_return || else_scope.did_return {
        if then_scope.did_return && else_scope.did_return : scope.did_return = true
        if !then_scope.did_return : v1 = value_try_remove_nullable(v1, then_scope, ctx) !>
        if !else_scope.did_return : v2 = value_try_remove_nullable(v2, else_scope, ctx) !>
        let rett = then_scope.did_return ? v2.rett : v1.rett
        let v = vgen_this_or_that(cond, v1, v2, rett)
        v.exp = exp
        return v
    }
    if v1.rett.is_void_type() || v2.rett.is_void_type() {
        v1.rett.compat_check(v2.rett, exp) !>
    }

    let l = value_try_remove_nullable(v1, then_scope, ctx) !>
    let r = v2
    if !l.rett.is_nullable_type() {
        r = value_try_remove_nullable(v2, else_scope, ctx) !>
    }
    // `cond ? 0 : n`: a literal takes the type of the other side, whichever side it is
    // on, or the closest type that holds both: `cond ? 300 : small_u8` is a u16
    if !isset(suggested_type) {
        let then_literal = exp_is_untyped_number(then_exp)
        let else_literal = exp_is_untyped_number(else_exp)
        let then_type = l.rett.get_non_nullable()
        let else_type = r.rett.get_non_nullable()
        if then_literal && !else_literal && else_type.is_number_type() {
            let target = type_holding_literal(l, else_type, ctx.build)
            if isset(target) {
                l = value_try_convert(l, then_scope, ctx, target) !>
                r = value_try_convert(r, else_scope, ctx, r.rett.is_nullable_type() ? target.nullable() : target) !>
            }
        }
        if else_literal && !then_literal && then_type.is_number_type() {
            // No type holds both (-1 and a u64): the literal's own type, as on the left
            let target = type_holding_literal(r, then_type, ctx.build) ?? r.rett
            r = value_try_convert(r, else_scope, ctx, target) !>
            l = value_try_convert(l, then_scope, ctx, l.rett.is_nullable_type() ? target.nullable() : target) !>
            // A same-size integer converts without a conversion step; it still becomes the target
            if !l.rett.is_nullable_type() && l.rett != target && target.compat(l.rett) : l = vgen_cast(l, target)
        }
    }
    if r.rett.is_nullable_type() {
        l = value_make_nullable(l)
    } else if l.rett.is_nullable_type() {
        r = value_make_nullable(r)
    }
    r = value_try_convert(r, else_scope, ctx, l.rett) !>
    if !l.rett.is_void_type() && !r.rett.is_void_type() {
        l.rett.compat_check(r.rett, exp) !>
    }

    let v = vgen_this_or_that(cond, l, r, l.rett)
    v.exp = exp
    return v
}

fn value_nullable_operand_ctx(ctx: Context) Context {
    let outer = ctx.suggested_type
    if !isset(outer) : return ctx
    if outer.is_nullable_type() || outer.is_void_type() : return ctx
    return ctx.with_suggested_type(outer.nullable())
}

// The operand of `??` / `?!` is read twice: once by the null check and once as
// the result. Anything but a plain variable is evaluated into a hidden local
// first so that a call operand runs exactly once. The store is the pre-value
// of the returned check operand, which both lowerings emit first; `fresh`
// reads of the local carry no pre-value and can be used any number of times.
fn value_null_op_operand(on: Value, ctx: Context) Value {
    if on.type == VAL.decl || on.type == VAL.global || on.rett.is_void_type() : return on
    let func = ctx.func
    if !isset(func) : return on
    let decl = Decl.new(func, on.rett, false, null)
    func.all_decls.append(decl)
    let cached = vgen_decl(decl)
    cached.exp = on.exp
    cached.set_pre_value(vgen_assign(vgen_decl(decl), on, ASSIGN_OP.set, ctx.build, on.exp, ctx))
    if on.is_implicit_borrow() : cached.mark_implicit_borrow()
    return cached
}

// A read of the local that `value_null_op_operand` created, without the store
fn value_null_op_operand_read(on: Value) Value {
    if on.type != VAL.decl || !isset(on.get_pre_value()) : return on
    let decl = on.decl
    if !isset(decl) : return on
    let read = vgen_decl(decl)
    read.exp = on.exp
    if on.is_implicit_borrow() : read.mark_implicit_borrow()
    // The read is the value that was stored, so it has that value's graph
    let stored = on.get_pre_value()
    let source = isset(stored) ? stored.value2 : null
    if isset(source) : read.set_graph_source(source)
    return read
}

fn value_from_null_coalesce_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let left_exp = exp.get(VALUE_EXP.left)
    let right_exp = exp.get(VALUE_EXP.right)
    if !isset(left_exp) || !isset(right_exp) : exp.bug("Incomplete ??")

    let on = value_from_exp(left_exp, scope, value_nullable_operand_ctx(ctx)) !>
    if !on.rett.is_nullable_type() && !on.never_returns {
        exp.error("You can only use '??' and '?!' on nullable values. Value type is: '" + on.rett.compat_display_name() + "'")
    }

    let alt_scope = scope.sub_scope()
    let alt = value_from_exp(right_exp, alt_scope, ctx.with_suggested_type(on.rett.is_nullable_type() ? on.rett.get_non_nullable() : on.rett)) !>
    on = value_null_op_operand(on, ctx)
    let iss = vgen_isset_val(on, type_bool(ctx.build))
    let left = value_null_op_operand_read(on)
    if alt_scope.did_return || value_stores_non_null(alt, alt_scope) {
        left = value_force_remove_nullable(left)
    }
    if !alt_scope.did_return {
        alt = value_try_convert(alt, alt_scope, ctx, left.rett) !>
        left.rett.compat_check(alt.rett, exp) !>
    }
    let v = vgen_this_or_that(iss, left, alt, left.rett)
    v.exp = exp
    return v
}

fn value_from_null_exit_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let left_exp = exp.get(VALUE_EXP.left)
    let body_exp = exp.get(VALUE_EXP.right)
    if !isset(left_exp) || !isset(body_exp) : exp.bug("Incomplete ?!")

    let on = value_from_exp(left_exp, scope, value_nullable_operand_ctx(ctx)) !>
    if !on.rett.is_nullable_type() && !on.never_returns {
        exp.error("You can only use '??' and '?!' on nullable values. Value type is: '" + on.rett.compat_display_name() + "'")
    }

    let sub = scope.sub_scope()
    let body = value_body_from_block_exp(ctx, sub, body_exp) !>
    if !sub.did_return {
        exp.error("Expected the code after '?!' to end with: return, exit, continue, break or throw")
    }

    on = value_null_op_operand(on, ctx)
    let iss = vgen_isset_val(on, type_bool(ctx.build))
    let nn = value_force_remove_nullable(value_null_op_operand_read(on))
    let not_iss = vgen_unary(iss, VALUE_OP.not, type_bool(ctx.build))
    let ifv = vgen_if(not_iss, Array[Value]{ body }, null, ctx.build, exp)
    let v = vgen_wrap(nn, nn.rett)
    v.set_pre_value(ifv)
    v.exp = exp
    return v
}

value OPTIONAL_CHAIN_STORE_ERROR ("Cannot change a value through '?.': get the value with '?!' or check it with 'isset' first")

// `value?.rest`: `rest` runs on the value when it is set; otherwise the whole chain is null,
// or, for a call without a result, skipped
fn value_from_optional_chain_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let left_exp = exp.get(VALUE_EXP.left)
    let right_exp = exp.get(VALUE_EXP.right)
    if !isset(left_exp) || !isset(right_exp) : exp.bug("Incomplete ?.")
    let b = ctx.build

    // `u?.count++` would change storage that may not exist, like an assignment through `?.`
    if right_exp.type == EXP.value && (right_exp.value_kind == VALUE_KIND.incr || right_exp.value_kind == VALUE_KIND.decr) {
        exp.error(OPTIONAL_CHAIN_STORE_ERROR)
    }
    let on = value_from_exp(left_exp, scope, ctx.without_suggested_type()) !>
    if !on.rett.is_nullable_type() {
        exp.error("'?.' is for a value that can be null, and '" + on.rett.compat_display_name() + "' cannot be: use '.'")
    }
    on = value_null_op_operand(on, ctx)
    let iss = vgen_isset_val(on, type_bool(b))

    let chain_scope = scope.sub_scope()
    chain_scope.chain_receiver = on
    let suggested = ctx.suggested_type
    let rest_ctx = isset(suggested) && suggested.is_nullable_type() ? ctx.with_suggested_type(suggested.get_non_nullable()) : ctx
    let rest = value_from_exp(right_exp, chain_scope, rest_ctx) !>
    if rest.rett.is_void_type() {
        let skipped = vgen_if(iss, Array[Value]{ rest }, null, b, exp)
        skipped.exp = exp
        return skipped
    }
    rest = value_make_nullable(rest)
    let v = vgen_this_or_that(iss, rest, vgen_null(rest.rett), rest.rett)
    v.exp = exp
    return v
}

////////////////////////////
// Blocks
////////////////////////////

fn value_append_body_exps(ctx: Context, scope: Scope, state: ParseState, values: Array[Value], exps: Array[Exp]) !Error {
    each exps as exp {
        let value = body_value_from_exp(ctx, scope, state, exp) !>
        if isset(value) : values.append(value)
    }
}

fn value_body_from_block_exp(ctx: Context, scope: Scope, body_exp: Exp) Value !Error {
    let state = ParseState.new()
    let values = Array[Value]{}
    let members = body_exp.body_exps
    if isset(members) {
        value_append_body_exps(ctx, scope, state, values, members) !>
    } else if body_exp.type == EXP.block {
        let raw = body_exp.get(BLOCK_EXP.body)
        if isset(raw) {
            let pos = raw.pos
            if isset(pos) {
                let p = pos.copy().init_parser()
                let stmts = read_func_stmts(p) !>
                value_append_body_exps(ctx, scope, state, values, stmts) !>
            }
        }
    } else {
        let v = body_value_from_exp(ctx, scope, state, body_exp) !>
        if isset(v) {
            values.append(v)
        }
    }
    return vgen_block(values, ctx.build, body_exp)
}

fn vgen_this_or_that(cond: Value, then_v: Value, else_v: Value, rett: Type) Value {
    let result = Value {
        type: VAL.this_or_that
        value1: cond
        value2: then_v
        values: Array[Value]{ else_v }
        rett: rett
        exp: cond.exp
    }
    if then_v.is_implicit_borrow() || else_v.is_implicit_borrow() : result.mark_implicit_borrow()
    return result
}

fn value_is_interface_type(type: Type) bool {
    let class = type.get_non_nullable().get_class_or_null()
    return isset(class) && class.kind == CLASS_KIND.interface
}

fn type_callable_takes_locked(type: Type) bool {
    let params = type.get_args() ?! return false
    each params as param {
        if param.get_non_nullable().is_locked : return true
    }
    return false
}

// A read-only borrow of plain numbers reads the same whether its storage is shared or not
fn value_shared_numbers_borrow(value: Value, target: Type) ?Value {
    if value.rett.is_nullable_type() || target.is_nullable_type() : return null
    let source = value.rett
    if !source.is_shared || target.is_shared || source.is_locked || target.is_locked : return null
    if source.kind != target.kind || !source.is_fat_borrow() : return null
    if !source.is_readonly_view() || !target.is_readonly_view() : return null
    let element = source.get_sub_type() ?! return null
    let target_element = target.get_sub_type() ?! return null
    if element.has_gc_refs() || !target_element.compat(element) : return null
    let retyped = vgen_cast(value, target)
    retyped.exp = value.exp
    return retyped
}

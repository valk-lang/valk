use helper

fn validate_interface_declaration(interface: Class) !Error {
    if interface.kind != CLASS_KIND.interface || interface.is_generic_base : return
    each interface.funcs as method {
        if !method.parsed_types : parse_func_types(method) !>
        if method.is_generic_base || method.has_generic_args {
            method.exp.error("Interface methods cannot be generic")
        }
    }
}

fn resolve_class_interfaces(class: Class) !Error {
    if class.interfaces_resolved || class.is_generic_base : return
    class.interfaces_resolved = true

    let raw = class.interfaces_exp
    if !isset(raw) : return
    if class.kind != CLASS_KIND.class {
        class.exp.error("Only classes can implement interfaces")
    }

    let i: uint = 0
    while true {
        let interface_exp = raw.get(i)
        if !isset(interface_exp) : break
        let interface_type = type_from_exp(interface_exp, class.scope) !>
        let interface = interface_type.get_non_nullable().get_class_or_null()
        if !isset(interface) {
            interface_exp.error("Type in an 'is' clause must be an interface")
        }
        if interface.kind != CLASS_KIND.interface {
            interface_exp.error("Type in an 'is' clause must be an interface")
        }
        if class.interfaces.contains(interface) {
            interface_exp.error("Interface is implemented more than once: " + interface.pretty_name())
        }

        validate_interface_implementation(class, interface, interface_exp) !>
        class.interfaces.append(interface)
        create_interface_adapter(interface, class) !>
        i++
    }
    class.interfaces_exp = null
}

fn validate_interface_implementation(class: Class, interface: Class, at: Exp) !Error {
    let slot: uint = 0
    while slot < interface.interface_method_count {
        let requirement = interface_method_at(interface, slot)
        if !isset(requirement) : interface.exp.bug("Interface dispatch slot is missing")
        if !requirement.parsed_types : parse_func_types(requirement) !>

        let implementation = class.get_func(requirement.name)
        if !isset(implementation) {
            at.error("Class '" + class.pretty_name() + "' does not implement interface method '" + interface.pretty_name() + "." + requirement.name + "'")
        }
        if !implementation.parsed_types : parse_func_types(implementation) !>
        validate_interface_method_signature(class, interface, requirement, implementation, at) !>
        slot++
    }
}

fn validate_interface_method_signature(class: Class, interface: Class, requirement: Func, implementation: Func, at: Exp) !Error {
    let mismatch = "Method '" + class.pretty_name() + "." + implementation.name
        + "' does not match interface method '" + interface.pretty_name() + "." + requirement.name + "'"

    if implementation.is_static || implementation.is_getter != requirement.is_getter {
        at.error(mismatch)
    }
    if implementation.is_generic_base || implementation.has_generic_args {
        at.error("Interface methods cannot be implemented by generic methods: " + implementation.name)
    }
    if !isset(implementation.body) {
        implementation.exp.error("Interface method implementation must have a body")
    }
    if implementation.args.length != requirement.args.length {
        at.error(mismatch + ". Expected " + (requirement.args.length - 1) + " argument(s), got " + (implementation.args.length - 1))
    }
    if implementation.infinite_args != requirement.infinite_args {
        at.error(mismatch + ". Variadic arguments must be identical")
    }
    if implementation.must_exit || implementation.will_exit || implementation.must_throw {
        at.error(mismatch + ". Control-flow flags are not allowed on interface implementations")
    }

    let i: uint = 1
    while i < requirement.args.length {
        let expected = requirement.args.get(i) ! at.bug("Missing interface argument")
        let actual = implementation.args.get(i) ! at.bug("Missing implementation argument")
        if type_identity_key(expected.type) != type_identity_key(actual.type) {
            at.error(mismatch + ". Argument " + i + " must be '" + expected.type.compat_display_name() + "', got '" + actual.type.compat_display_name() + "'")
        }
        i++
    }

    if type_identity_key(requirement.get_rett()) != type_identity_key(implementation.get_rett()) {
        at.error(mismatch + ". Expected return type '" + requirement.get_rett().compat_display_name()
            + "', got '" + implementation.get_rett().compat_display_name() + "'")
    }
    // An implementation that cannot fail may satisfy a fallible requirement; the vtable gets a thunk
    if implementation.can_error && (!requirement.can_error || requirement.error_type != implementation.error_type) {
        at.error(mismatch + ". Error types must be identical")
    }
}

fn interface_method_at(interface: Class, slot: uint) ?Func {
    each interface.funcs as method {
        if method.is_interface && method.interface_slot == slot : return method
    }
    return null
}

fn class_implements_interface(class: Class, interface: Class) bool {
    if class == interface : return true
    return class.interfaces.contains(interface)
}

fn create_interface_adapter(interface: Class, concrete: Class) Class !Error {
    let key = interface_adapter_key(concrete)
    let cached = interface.interface_adapters.get(key) !? null
    if isset(cached) : return cached

    let identity = interface.ns.pkg.name + ":" + interface.ns.name + ":" + interface.name
        + "<-" + concrete.ns.pkg.name + ":" + concrete.ns.name + ":" + concrete.name
    let adapter = Class {
        unit: concrete.unit
        ns: concrete.ns
        name: "interface_adapter_" + helper.ctxhash(identity)
        display_name: "<" + concrete.pretty_name() + " as " + interface.pretty_name() + ">"
        act: ACT.private
        kind: CLASS_KIND.class
        scope: concrete.scope
        exp: concrete.exp
        interface_for: interface
        interface_concrete: concrete
    }
    interface.interface_adapters.set(key, adapter)
    return adapter
}

fn interface_adapter_key(concrete: Class) String {
    return concrete.ns.pkg.name + ":" + concrete.ns.name + ":" + concrete.name
}

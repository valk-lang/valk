
class Pipeline {
    parse_base_asts: Array[ParseBaseAst] (.{})
    parse_properties: Array[Class] (.{})
    determine_class_sizes: Array[Class] (.{})
    parse_func_asts: Array[Func] (.{})
    parse_func_types: Array[Func] (.{})

    fn run() !Error {
        // Parse base expressions
        while true {
            let item = this.parse_base_asts.pop_last() ! break
            parse_base_ast(item.src, item.ns, item.unit) !>
        }
        // Parse aliasses

        // Parse class properties
        while true {
            let item = this.parse_properties.pop_last() ! break
            parse_class_properties(item) !>
        }

        // Parse func argument & return types

        // Parse func ASTs
    }
}

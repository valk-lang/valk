// Expanding `#loop globals` over the globals that are actually used.
//
// The generated entry initializes every global's default and registers the
// GC-managed ones as roots. Expanding that over *all* globals makes the entry
// reference all of them, which drags in each default's constructor — and those
// pull in code nothing else in the program touches.
//
// So the loop expands over the used globals instead. Which those are is not
// known while a body is being lowered: it follows from what the whole program
// reaches, and the entry is itself part of that. The set therefore starts empty
// and grows — every round marks reachability, and if more globals came into
// use, the functions holding such a loop are lowered again with the larger set.
// It settles because the set only ever grows.

fn resolve_globals_loops(build: Build) !Error {
    let funcs = build.pipeline.globals_loop_funcs
    if funcs.length == 0 : return
    // The language server never lowers, so there is nothing to expand.
    if isset(build.options.lsp) : return

    let previous: uint = 0
    let round: uint = 0
    while true {
        round++
        // The set only grows and is bounded by the number of globals, so this
        // is a runaway rather than a slow case.
        if round > 100 : build.bug("'#loop globals' expansion did not settle")

        mark_reachable(build) !>
        let used = count_used_globals(build)
        if used == previous : break
        previous = used

        each funcs as func : relower_globals_loop_func(func) !>

        // A larger expansion can specialize generics that were not needed
        // before; those land on the queue and have to be lowered here.
        while true {
            let item = build.pipeline.parse_func_asts.pop_last() ! break
            parse_func_ast(item) ! continue
        }
    }

    // Nothing lowers these again, so what only their bodies needed can go.
    each funcs as func {
        let exps = func.pending_exps ?? Array[Exp]{}
        func_release_ast(func, exps)
    }
    funcs.clear()
}

fn count_used_globals(build: Build) uint {
    let count: uint = 0
    each build.lists.globals as global {
        if global.is_used : count++
    }
    return count
}

// Throw away what the previous expansion produced and lower the body again.
// Everything derived from it has to go with it: the recorded references would
// otherwise keep code alive that the new expansion never emits, which is the
// whole point of expanding over a smaller set.
fn relower_globals_loop_func(func: Func) !Error {
    func.functions_used = .{}
    func.globals_used = .{}
    func.strings_used = .{}
    func.info_creates_objects = false
    func.info_calls_unknown_code = false

    // Closure and fnptr adapters live in the ir_code being discarded, so the
    // module no longer holds them and the next pass has to write them again.
    let unit = func.unit
    let dropped = Array[String]{}
    each unit.closure_adapters as owner, name {
        if owner == func : dropped.append(name)
    }
    each dropped as name : unit.closure_adapters.remove(name)
    func.ir_code = ""

    func.parsed_ast = false
    func.body_scope = null
    func.alloca_scope = null
    func.defer_scope = null
    func.user_defer_stack = null
    func.user_defer_pop = null
    // The argument declarations are made once, by parse_func_types, and are
    // not rebuilt by another body pass — so they stay, and only what the body
    // declared goes. They also have to keep their place at the front, since
    // ir_emit_func names declarations by their position here.
    let args_only = Array[Decl]{}
    each func.args as arg : args_only.append(arg.decl, true)
    func.all_decls = args_only
    func.define_decls = .{}
    func.stable_stack_decl = null
    func.test_entry_decl = null
    parse_func_ast(func) !>
}

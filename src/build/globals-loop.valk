
fn resolve_globals_loops(build: Build) !Error {
    let funcs = build.pipeline.globals_loop_funcs
    if funcs.length == 0 : return
    // The language server never lowers, so there is nothing to expand.
    if isset(build.options.lsp) : return

    let previous = Array[Global]{}
    let round: uint = 0
    while true {
        round++
        if round > 100 : build.bug("'#loop globals' expansion did not settle")

        mark_reachable(build) !>
        // Newly parsed bodies can add dependencies without adding globals
        let order = global_init_order(build) !>
        if global_order_equals(order, previous) : break
        previous = order

        each funcs as func : relower_globals_loop_func(func) !>

        while true {
            let item = build.pipeline.reachable_func_asts.pop_last() ! break
            parse_func_ast(item) ! continue
        }
    }

    // Nothing lowers these again, so what only their bodies needed can go.
    each funcs as func {
        let exps = func.pending_exps ?? Array[Exp]{}
        func_release_ast(func, exps)
    }
    funcs.clear()
}

fn global_order_equals(a: Array[Global], b: Array[Global]) bool {
    if a.length != b.length : return false
    each a as global, i {
        if (b.get(i) !? null) != global : return false
    }
    return true
}

// The used globals in initialization order: every global after the globals
// its default reads (directly or through the functions it calls). Defaults
// that call code the compiler cannot see through go last. Ties keep the
// declaration order. Bodies parsed later can extend the dependencies, so the
// caller repeats this until the order settles.
fn global_init_order(build: Build, used_only: bool (true)) Array[Global] !Error {
    let deps = HashMap[Global, Array[Global]]{}
    let unknown = HashMap[Global, bool]{}
    each build.lists.globals as global {
        if used_only && !global.is_used : continue
        let init = global.init_func ?! continue
        let read = Array[Global]{}
        if global_init_reads(init, read) : unknown.set(global, true)
        deps.set(global, read)
    }
    // A default that reads an unknown-ordered global cannot run before it
    let changed = true
    while changed {
        changed = false
        each deps as read, global {
            if unknown.has(global) : continue
            each read as dep {
                if !unknown.has(dep) : continue
                unknown.set(global, true)
                changed = true
                break
            }
        }
    }

    let order = Array[Global]{}
    let state = HashMap[Global, u8]{}
    each build.lists.globals as global {
        if used_only && !global.is_used : continue
        if !unknown.has(global) : global_init_visit(global, deps, state, order, used_only) !>
    }
    each build.lists.globals as global {
        if used_only && !global.is_used : continue
        global_init_visit(global, deps, state, order, used_only) !>
    }
    return order
}

// A build without IR never expands the loop; the cycle check still runs on
// every global so the error does not depend on the build mode.
fn check_global_init_cycles(build: Build) !Error {
    global_init_order(build, false) !>
}

// Depth-first placement, with dependencies first. A dependency still on the
// stack is a cycle.
fn global_init_visit(global: Global, deps: HashMap[Global, Array[Global]], state: HashMap[Global, u8], order: Array[Global], used_only: bool) !Error {
    let seen = state.get(global) !? 0
    if seen == 2 : return
    state.set(global, 1)
    each (deps.get(global) !? Array[Global]{}) as dep {
        // A default reading its own zero value needs no order
        if (used_only && !dep.is_used) || dep == global : continue
        if (state.get(dep) !? 0) == 1 {
            global.exp.error("Initialization cycle: the default value of global '" + global.name + "' reads '" + dep.name + "', and '" + dep.name + "' depends on '" + global.name + "'")
        }
        global_init_visit(dep, deps, state, order, used_only) !>
    }
    state.set(global, 2)
    order.append(global)
}

// Collects the globals an init function reads, through every function it
// calls. Returns true when some call cannot be followed (closures, interfaces).
// Direct calls and reads are known from lowering; IR generation adds the
// helpers it introduces.
fn global_init_reads(init: Func, read: Array[Global]) bool {
    let unknown = false
    let seen = HashMap[Func, bool]{}
    let queue = Array[Func]{ init }
    while true {
        let func = queue.pop_last() ! break
        if seen.has(func) : continue
        seen.set(func, true)
        if func.info_calls_unknown_code : unknown = true
        each func.globals_used as global : read.append(global, true)
        each func.effect_callees as sub {
            if !seen.has(sub) : queue.append(sub)
        }
        each func.functions_used as sub {
            if !seen.has(sub) : queue.append(sub)
        }
    }
    return unknown
}

fn relower_globals_loop_func(func: Func) !Error {
    func.functions_used.clear()
    func.globals_used.clear()
    func.strings_used.clear()
    func.interface_vtables_used = null
    func.info_calls_unknown_code = false
    func.may_suspend = func.suspends_directly

    let unit = func.unit
    let dropped = Array[String]{}
    each unit.closure_adapters as owner, name {
        if owner == func : dropped.append(name)
    }
    each dropped as name : unit.closure_adapters.remove(name)
    func.set_ir_code("")

    func.parsed_ast = false
    func.body_scope = null
    func.alloca_scope = null
    func.defer_scope = null
    func.user_defer_stack = null
    func.user_defer_pop = null
    let args_only = Array[Decl]{}
    each func.args as arg : args_only.append(arg.decl, true)
    func.all_decls = args_only
    func.buffer_pool = .{}
    func.buffers_used = .{}
    func.test_entry_decl = null
    restore_func_generic_scope(func)
    parse_func_ast(func) !>
}

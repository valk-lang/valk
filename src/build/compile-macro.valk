// Compile-time macros (#if / #elif / #else / #end) while walking top-level expressions.
// Conditions are turned into Value trees and must fold to a constant bool.

// State for one parse_base_ast pass (shared across parse_base_exp calls).
class ParseBaseState {
    // For each open #if: true once some branch body has been accepted
    if_taken: Array[bool] (.{})
    // True while skipping a false (or already-taken) branch body
    skip: bool (false)
    // Nested #if / #loop depth while skip is true (0 = at the branch being skipped)
    skip_nest: uint (0)

    static fn new() SELF {
        return SELF {}
    }

    fn is_skipping() bool {
        return this.skip
    }

    fn has_open_if() bool {
        return this.if_taken.length > 0
    }
}

// Handle EXP.macro. Updates skip state for #if / #elif / #else / #end.
// Other macros are ignored while skipping; handled later when active.
fn parse_macro_exp(ns: Namespace, scope: Scope, state: ParseBaseState, exp: Exp) !Error {
    let kind = exp.kind.@cast(MACRO_KIND)

    if kind == MACRO_KIND.if {
        parse_macro_if(ns, scope, state, exp) !>
        return
    }
    if kind == MACRO_KIND.elif {
        parse_macro_elif(ns, scope, state, exp) !>
        return
    }
    if kind == MACRO_KIND.else {
        parse_macro_else(state, exp) !>
        return
    }
    if kind == MACRO_KIND.end {
        parse_macro_end(state, exp) !>
        return
    }

    // Nested #loop inside a skipped region must still nest so #end matches correctly
    if state.is_skipping() {
        if kind == MACRO_KIND.loop {
            state.skip_nest++
        }
        return
    }

    // #print / #error / #loop / #print_type — later
}

fn parse_macro_if(ns: Namespace, scope: Scope, state: ParseBaseState, exp: Exp) !Error {
    if state.skip {
        // Nested #if inside a skipped branch — only track depth
        state.skip_nest++
        return
    }

    let ok = eval_macro_condition(ns, scope, exp) !>
    state.if_taken.append(ok)
    if !ok {
        state.skip = true
        state.skip_nest = 0
    }
}

fn parse_macro_elif(ns: Namespace, scope: Scope, state: ParseBaseState, exp: Exp) !Error {
    if state.skip {
        if state.skip_nest > 0 : return
        // At the #if level we are skipping — maybe this branch matches
        if !state.has_open_if() {
            exp.error("Unexpected '#elif'. There is no matching '#if'")
        }
        let i = state.if_taken.length - 1
        let taken = state.if_taken.get(i) ! exp.bug("Missing #if frame")
        if taken {
            // A prior branch was already accepted; skip this elif body
            state.skip = true
            state.skip_nest = 0
            return
        }
        let ok = eval_macro_condition(ns, scope, exp) !>
        if ok {
            state.if_taken.set(i, true) ! exp.bug("Missing #if frame")
            state.skip = false
        } else {
            state.skip = true
            state.skip_nest = 0
        }
        return
    }

    // Currently in a live branch body — subsequent elif/else bodies are skipped
    if !state.has_open_if() {
        exp.error("Unexpected '#elif'. There is no matching '#if'")
    }
    state.skip = true
    state.skip_nest = 0
}

fn parse_macro_else(state: ParseBaseState, exp: Exp) !Error {
    if state.skip {
        if state.skip_nest > 0 : return
        if !state.has_open_if() {
            exp.error("Unexpected '#else'. There is no matching '#if'")
        }
        let i = state.if_taken.length - 1
        let taken = state.if_taken.get(i) ! exp.bug("Missing #if frame")
        if taken {
            state.skip = true
            state.skip_nest = 0
        } else {
            state.if_taken.set(i, true) ! exp.bug("Missing #if frame")
            state.skip = false
        }
        return
    }

    if !state.has_open_if() {
        exp.error("Unexpected '#else'. There is no matching '#if'")
    }
    // Live branch already taken — skip the else body
    state.skip = true
    state.skip_nest = 0
}

fn parse_macro_end(state: ParseBaseState, exp: Exp) !Error {
    if state.skip {
        if state.skip_nest > 0 {
            state.skip_nest--
            return
        }
        // Matching #end for the branch we were skipping
        if !state.has_open_if() {
            exp.error("Unexpected '#end'. There is no matching '#if' or '#loop'")
        }
        state.if_taken.pop_last() ! exp.bug("Missing #if frame")
        state.skip = false
        return
    }

    if !state.has_open_if() {
        exp.error("Unexpected '#end'. There is no matching '#if' or '#loop'")
    }
    state.if_taken.pop_last() ! exp.bug("Missing #if frame")
}

// Evaluate #if / #elif condition: EXP.value → Value → constant bool.
fn eval_macro_condition(ns: Namespace, scope: Scope, macro_exp: Exp) bool !Error {
    let cond = macro_exp.get(MACRO_EXP.value)
    if !isset(cond) : macro_exp.bug("Missing macro condition value")
    let v = value_from_macro_condition(cond, scope) !>
    return value_const_bool(v, ns.build) !>
}

// Build a Value tree for a compile-time condition without requiring core class types
// (conditions are evaluated while core itself may still be loading).
fn value_from_macro_condition(exp: Exp, scope: Scope) Value !Error {
    if exp.type != EXP.value : exp.bug("Expected EXP.value for macro condition")
    let kind = exp.kind
    let b = exp.src.build

    if kind == VALUE_KIND.paren {
        let inner = exp.get(VALUE_EXP.left)
        if !isset(inner) : exp.bug("Missing paren inner value")
        return value_from_macro_condition(inner, scope) !>
    }

    if kind == VALUE_KIND.number || kind == VALUE_KIND.hex || kind == VALUE_KIND.octal {
        // Avoid type_int (core may still be loading); rett is unused for const-eval
        let text = exp.str1.replace("_", "")
        let n: int = 0
        if kind == VALUE_KIND.hex {
            n = (text.hex_to_int() ! exp.error("Invalid hex integer: " + exp.str1)).@cast(int)
        } else if kind == VALUE_KIND.octal {
            let body = text
            if body.starts_with("0c") || body.starts_with("0C") {
                body = body.part(2, body.length - 2)
            }
            n = (body.octal_to_int() ! exp.error("Invalid octal integer: " + exp.str1)).@cast(int)
        } else {
            n = text.to_int() ! exp.error("Invalid integer: " + exp.str1)
        }
        let v = vgen_int(n, type_any(b))
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.bool {
        let v = vgen_bool(exp.bool1, type_any(b))
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.string {
        let v = vgen_string(strip_quotes(exp.str1), type_any(b))
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.id {
        let v = value_from_id_exp(exp, scope) !>
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.unary {
        let operand_exp = exp.get(VALUE_EXP.left)
        if !isset(operand_exp) : exp.bug("Missing unary operand")
        let operand = value_from_macro_condition(operand_exp, scope) !>
        let op = exp.number.@cast(VALUE_OP)
        if op == VALUE_OP.neg && operand.type == VAL.int {
            operand.int_val = 0 - operand.int_val
            operand.exp = exp
            return operand
        }
        let v = vgen_unary(operand, op)
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.op {
        let left_exp = exp.get(VALUE_EXP.left)
        let right_exp = exp.get(VALUE_EXP.right)
        if !isset(left_exp) || !isset(right_exp) : exp.bug("Missing binary op operands")
        let left = value_from_macro_condition(left_exp, scope) !>
        let right = value_from_macro_condition(right_exp, scope) !>
        let op = exp.number.@cast(VALUE_OP)
        let v = vgen_op(left, right, op, null)
        v.exp = exp
        return v
    }

    exp.error("Cannot use this expression in a compile-time macro condition")
}

// Fold a Value to a compile-time bool. Errors if the value is not constant.
fn value_const_bool(v: Value, b: Build) bool !Error {
    if v.type == VAL.bool : return v.bool_val
    if v.type == VAL.int : return v.int_val != 0
    if v.type == VAL.null : return false

    if v.type == VAL.id {
        // Bare identifier: compile def (true unless value is "0")
        let def = b.cm_defs.get(v.name) !? null
        if !isset(def) {
            v.error("Unknown compile macro definition: '" + v.name + "'")
        }
        return def != "0"
    }

    if v.type == VAL.unary {
        let op = v.op.@cast(VALUE_OP)
        let operand = v.value1
        if !isset(operand) : v.bug("Unary value is missing operand")
        if op == VALUE_OP.not : return !value_const_bool(operand, b) !>
        if op == VALUE_OP.neg {
            if operand.type == VAL.int : return operand.int_val != 0
        }
        v.error("Cannot evaluate unary operator at compile time")
    }

    if v.type == VAL.op {
        let op = v.op.@cast(VALUE_OP)
        let left = v.value1
        let right = v.value2
        if !isset(left) || !isset(right) : v.bug("Binary value is missing operands")

        if op == VALUE_OP.and {
            return value_const_bool(left, b) !> && value_const_bool(right, b) !>
        }
        if op == VALUE_OP.or {
            return value_const_bool(left, b) !> || value_const_bool(right, b) !>
        }
        if op == VALUE_OP.eq {
            return value_const_string(left, b) !> == value_const_string(right, b) !>
        }
        if op == VALUE_OP.ne {
            return value_const_string(left, b) !> != value_const_string(right, b) !>
        }
        // Numeric compares when both sides are integers
        if op == VALUE_OP.lt || op == VALUE_OP.gt || op == VALUE_OP.lte || op == VALUE_OP.gte {
            let li = value_const_int(left, b) !>
            let ri = value_const_int(right, b) !>
            if op == VALUE_OP.lt : return li < ri
            if op == VALUE_OP.gt : return li > ri
            if op == VALUE_OP.lte : return li <= ri
            return li >= ri
        }
        v.error("Cannot evaluate operator at compile time")
    }

    v.error("Cannot evaluate expression at compile time")
}

// Constant string form for == / != (defs, bare words, literals).
fn value_const_string(v: Value, b: Build) String !Error {
    if v.type == VAL.string : return v.string_val
    if v.type == VAL.char : return v.string_val
    if v.type == VAL.bool : return v.bool_val ? "1" : "0"
    if v.type == VAL.int {
        let buf = ByteBuffer.new()
        buf.write_int_ascii(v.int_val)
        return buf.to_string()
    }
    if v.type == VAL.id {
        let def = b.cm_defs.get(v.name) !? null
        if isset(def) : return def
        // Bare word on the right of `OS == win` → the identifier text itself
        return v.name
    }
    v.error("Cannot evaluate expression as a compile-time string")
}

fn value_const_int(v: Value, b: Build) int !Error {
    if v.type == VAL.int : return v.int_val
    if v.type == VAL.bool : return v.bool_val ? 1 : 0
    if v.type == VAL.id {
        let def = b.cm_defs.get(v.name) !? null
        if !isset(def) : v.error("Unknown compile macro definition: '" + v.name + "'")
        return def.to_int() ! v.error("Compile macro definition is not an integer: '" + v.name + "' = '" + def + "'")
    }
    v.error("Cannot evaluate expression as a compile-time integer")
}

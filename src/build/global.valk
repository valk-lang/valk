// Compiler-facing global / shared / @shared object created from EXP.global.
// Type expression is resolved later via Pipeline.parse_global_types.
class Global {
    unit: Unit
    ns: Namespace
    name: String
    act: ACT
    // GLOBAL_KIND: global / shared / at_shared
    kind: GLOBAL_KIND
    // File scope where the global was declared (for type / default resolution)
    scope: Scope
    // Original parse expression (source span / raw AST)
    exp: Exp
    // Sub-expressions from EXP.global (still raw until type stage)
    type_exp: ?Exp (null)
    default_exp: ?Exp (null)
    is_extern: bool (false)
    // True for `shared` and `@shared`
    shared: bool (false)
    // True for `@shared` or `extern shared` (may hold structural types without imut)
    allow_unsafe: bool (false)
    // Resolved type (filled by parse_global_type)
    type: ?Type (null)
    ir_name: String ("")
    // Byte offsets of every statically addressable managed-pointer slot in
    // this global's inline representation. Thread.entry registers these slots
    // with the local collector after initializing the global.
    gc_root_offsets: Array[u32] (.{})
    gc_roots_resolved: bool (false)
    // Reachable from a program entry — see mark_reachable (reachable.valk).
    // Globals nothing reaches are left out of the module.
    is_used: bool (false)

    fn get_type() Type !Error {
        let t = this.type
        if !isset(t) : this.exp.bug("Missing global type (not yet resolved): " + this.name)
        return t
    }

    fn resolve_gc_root_offsets(at: Exp) !Error {
        if this.gc_roots_resolved : return
        let type = this.get_type() !>
        if !(global_collect_gc_root_offsets(type, 0, this.gc_root_offsets) !>) {
            at.error("Tagged unions with managed references inside inline alternatives cannot be stored in globals")
        }
        this.gc_roots_resolved = true
    }

    fn get_gc_root_offsets() Array[u32] !Error {
        this.resolve_gc_root_offsets(this.exp) !>
        return this.gc_root_offsets
    }
}

// Collect stable managed-pointer slots in a by-value representation. A union's
// direct managed alternatives have one dedicated pointer slot, but an inline
// alternative shares raw payload bytes with unrelated alternatives. Those
// conditional slots cannot be put in the flat global-root list safely.
fn global_collect_gc_root_offsets(type: Type, base_offset: u32, out: Array[u32]) bool !Error {
    if type.is_gc_type() {
        out.append(base_offset, true)
        return true
    }

    if type.is_nullable_type() {
        let sub = type.sub_type
        if isset(sub) && !sub.is_pointer_sized() && sub.type != TYPE.fn {
            return global_collect_gc_root_offsets(sub, base_offset + type.ptr_size(), out) !>
        }
    }

    let t = type.get_non_nullable()
    if t.type == TYPE.fn {
        out.append(base_offset + t.ptr_size(), true)
        return true
    }

    if t.type == TYPE.union {
        let layout = t.union_layout() !>
        if layout.has_gc {
            out.append(base_offset + layout.gc_offset(), true)
        }
        let members = t.sub_types
        if isset(members) {
            each members as member {
                if !member.is_gc_type() && member.has_gc_refs() : return false
            }
        }
        return true
    }

    if t.type == TYPE.inline {
        let sub = t.sub_type
        if !isset(sub) : return true
        let class = sub.get_class_or_null()
        if !isset(class) {
            return global_collect_gc_root_offsets(sub, base_offset, out) !>
        }
        class.compute_body_size() !>
        each class.props as prop {
            if !(global_collect_gc_root_offsets(prop.type, base_offset + prop.offset, out) !>) {
                return false
            }
        }
        return true
    }

    if t.type == TYPE.array {
        let sub = t.sub_type
        if !isset(sub) : return true
        let stride = sub.size() !>
        let i: u32 = 0
        while i < t.array_size {
            if !(global_collect_gc_root_offsets(sub, base_offset + stride * i, out) !>) {
                return false
            }
            i++
        }
        return true
    }

    if t.type == TYPE.multi {
        let members = t.sub_types
        if !isset(members) : return true
        let offset: u32 = 0
        each members as member {
            offset = member.ir_align_offset(offset) !>
            if !(global_collect_gc_root_offsets(member, base_offset + offset, out) !>) {
                return false
            }
            offset += member.size() !>
        }
    }
    return true
}

// Resolve GLOBAL_EXP.type into Type and store on the Global.
fn parse_global_type(g: Global) !Error {
    let type_exp = g.type_exp
    if !isset(type_exp) : g.exp.bug("Global is missing a type expression: " + g.name)
    let type = type_from_exp(type_exp, g.scope) !>
    if type.get_non_nullable().type == TYPE.ref {
        type_exp.error("You cannot store references in globals. Type not allowed: " + type.compat_display_name())
    }
    if g.is_extern && type.get_non_nullable().type == TYPE.union {
        type_exp.error("Tagged unions cannot be used for extern globals")
    }
    g.type = type
    g.resolve_gc_root_offsets(type_exp) !>
}

class Global {
    unit: Unit
    ns: Namespace
    name: String
    act: ACT
    // GLOBAL_KIND: global / shared / at_shared
    kind: GLOBAL_KIND
    // File scope where the global was declared (for type / default resolution)
    scope: Scope
    // Original parse expression (source span / raw AST)
    exp: Exp
    // Sub-expressions from EXP.global (still raw until type stage)
    type_exp: ?Exp (null)
    default_exp: ?Exp (null)
    is_extern: bool (false)
    is_export: bool (false)
    // True for `shared` and `@shared`
    shared: bool (false)
    // True for `@shared` or `extern shared` (may hold structural types without imut)
    allow_unsafe: bool (false)
    // Resolved type (filled by parse_global_type)
    type: ?Type (null)
    ir_name: String ("")
    // `@"ir_name"`, the operand form (ir_global_address)
    ir_address: String ("")
    gc_root_offsets: Array[u32] (.{})
    conditional_gc_roots: Array[GlobalConditionalRoot] (.{})
    gc_roots_resolved: bool (false)
    is_used: bool (false)

    fn get_type() Type !Error {
        let t = this.type
        if !isset(t) : this.exp.bug("Missing global type (not yet resolved): " + this.name)
        return t
    }

    fn resolve_gc_root_offsets(at: Exp) !Error {
        if this.gc_roots_resolved : return
        let type = this.get_type() !>
        if !(global_collect_gc_root_offsets(type, 0, this.gc_root_offsets, this.conditional_gc_roots) !>) {
            at.error("Tagged unions with managed references inside inline alternatives cannot be stored in globals")
        }
        this.gc_roots_resolved = true
    }

    fn get_gc_root_offsets() Array[u32] !Error {
        this.resolve_gc_root_offsets(this.exp) !>
        return this.gc_root_offsets
    }

    fn get_conditional_gc_roots() Array[GlobalConditionalRoot] !Error {
        this.resolve_gc_root_offsets(this.exp) !>
        return this.conditional_gc_roots
    }
}

class GlobalConditionalRoot {
    offset: u32
    tag_offset: u32
    tag: uint
}

fn global_collect_gc_root_offsets(
    type: Type,
    base_offset: u32,
    out: Array[u32],
    conditional: Array[GlobalConditionalRoot]
) bool !Error {
    if type.is_gc_type() {
        out.append(base_offset, true)
        return true
    }

    if type.is_nullable_type() {
        let sub = type.get_sub_type()
        if isset(sub) && !sub.is_pointer() && sub.kind != TYPE.closure {
            return global_collect_gc_root_offsets(sub, base_offset + type.ptr_size(), out, conditional) !>
        }
    }

    let t = type.get_non_nullable()
    if t.kind == TYPE.slice {
        out.append(base_offset, true)
        return true
    }
    if t.kind == TYPE.closure {
        out.append(base_offset + t.ptr_size(), true)
        return true
    }

    if t.kind == TYPE.union {
        let layout = t.union_layout() !>
        let members = t.get_members()
        if isset(members) {
            each members as member, tag {
                if member.is_gc_type() || member.get_non_nullable().kind == TYPE.slice {
                    conditional.append(GlobalConditionalRoot {
                        offset: base_offset + layout.payload_offset
                        tag_offset: base_offset
                        tag: tag
                    })
                } else if member.has_gc_refs() : return false
            }
        }
        return true
    }

    if t.is_fixed_array_type() {
        let sub = t.get_sub_type()
        if !isset(sub) : return true
        let stride = sub.byte_size() !>
        let i: u32 = 0
        while i < t.length {
            if !(global_collect_gc_root_offsets(sub, base_offset + stride * i, out, conditional) !>) {
                return false
            }
            i++
        }
        return true
    }

    let inline_class = t.class
    if t.is_inline && isset(inline_class) {
        inline_class.compute_body_size() !>
        each inline_class.props as prop {
            if !(global_collect_gc_root_offsets(prop.type, base_offset + prop.offset, out, conditional) !>) {
                return false
            }
        }
        return true
    }

    if t.is_tuple_type() {
        let members = t.get_members()
        if !isset(members) : return true
        let offset: u32 = 0
        each members as member {
            offset = member.ir_align_offset(offset) !>
            if !(global_collect_gc_root_offsets(member, base_offset + offset, out, conditional) !>) {
                return false
            }
            offset += member.byte_size() !>
        }
    }
    return true
}

// Resolve GLOBAL_EXP.type into Type and store on the Global.
fn parse_global_type(g: Global) !Error {
    let type_exp = g.type_exp
    if !isset(type_exp) : g.exp.bug("Global is missing a type expression: " + g.name)
    let type = type_from_exp(type_exp, g.scope) !>
    if type.get_non_nullable().kind == TYPE.ref_of {
        type_exp.error("You cannot store references in globals. Type not allowed: " + type.compat_display_name())
    }
    if (g.is_extern || g.is_export) && type.get_non_nullable().kind == TYPE.union {
        let linkage = g.is_extern ? "extern" : "export"
        type_exp.error("Tagged unions cannot be used for " + linkage + " globals")
    }
    if g.is_extern && type.has_gc_refs() {
        type_exp.error("GC-managed types are not allowed for extern globals; use an explicit raw-pointer protocol")
    }
    if g.is_export {
        type_validate_export_abi_extensions(type) !>
    }
    g.type = type
    g.resolve_gc_root_offsets(type_exp) !>
}

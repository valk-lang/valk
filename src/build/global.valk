// Compiler-facing global / shared / @shared object created from EXP.global.
// Type expression is resolved later via Pipeline.parse_global_types.
class Global {
    unit: Unit
    ns: Namespace
    name: String
    act: ACT
    // GLOBAL_KIND: global / shared / at_shared
    kind: GLOBAL_KIND
    // File scope where the global was declared (for type / default resolution)
    scope: Scope
    // Original parse expression (source span / raw AST)
    exp: Exp
    // Sub-expressions from EXP.global (still raw until type stage)
    type_exp: ?Exp (null)
    default_exp: ?Exp (null)
    is_extern: bool (false)
    // True for `shared` and `@shared`
    shared: bool (false)
    // True for `@shared` or `extern shared` (may hold structural types without imut)
    allow_unsafe: bool (false)
    // Resolved type (filled by parse_global_type)
    type: ?Type (null)
    // Reachable from a program entry — see mark_reachable (reachable.valk).
    // Globals nothing reaches are left out of the module.
    is_used: bool (false)

    fn get_type() Type !Error {
        let t = this.type
        if !isset(t) : this.exp.bug("Missing global type (not yet resolved): " + this.name)
        return t
    }
}

// Resolve GLOBAL_EXP.type into Type and store on the Global.
fn parse_global_type(g: Global) !Error {
    let type_exp = g.type_exp
    if !isset(type_exp) : g.exp.bug("Global is missing a type expression: " + g.name)
    let type = type_from_exp(type_exp, g.scope) !>
    if type.get_non_nullable().type == TYPE.ref {
        type_exp.error("You cannot store references in globals. Type not allowed: " + type.compat_display_name())
    }
    if g.is_extern && type.get_non_nullable().type == TYPE.union {
        type_exp.error("Tagged unions cannot be used for extern globals")
    }
    if type.get_non_nullable().type == TYPE.union && type.union_has_embedded_gc_refs() {
        type_exp.error("Tagged unions with managed references inside inline alternatives cannot be stored in globals")
    }
    g.type = type
}

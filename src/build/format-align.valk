

// One line of reconstructed output, split at its trailing comment.
class AlignLine {
    code: String
    // The comment, from its `//`, or null when the line has no trailing one.
    comment: ?String (null)
    // Leading whitespace, which has to match for two lines to share a column.
    indent: String ("")
}

fn format_align_comments(text: String) String {
    let lines = text.split("\n")
    let parsed = Array[AlignLine]{}
    each lines as line : parsed.append(align_split_line(line))
    let count = parsed.length

    let columns = Array[uint]{}
    let i: uint = 0
    while i < count {
        let line = parsed.get(i) ! break
        if !isset(line.comment) {
            columns.append(0)
            i++
            continue
        }

        // How far the run reaches, and the widest code in it.
        let end = i + 1
        let width = line.code.bytes
        while end < count {
            let next = parsed.get(end) ! break
            if !isset(next.comment) : break
            if next.indent != line.indent : break
            if next.code.bytes > width : width = next.code.bytes
            end++
        }

        let column = width + 1
        while i < end {
            columns.append(column)
            i++
        }
    }

    let out = ByteBuffer.new(text.bytes + 64)
    i = 0
    while i < count {
        if i > 0 : out.write_byte('\n')
        let line = parsed.get(i) ! break
        out.write_string(line.code)
        let comment = line.comment
        if isset(comment) {
            let column = columns.get(i) !? 0
            let pad = column > line.code.bytes ? column - line.code.bytes : 1
            while pad-- > 0 : out.write_byte(' ')
            out.write_string(comment)
        }
        i++
    }
    return out.to_string()
}

fn align_split_line(line: String) AlignLine {
    let bytes = line.bytes
    let data = line.data
    let indent_end: uint = 0
    while indent_end < bytes {
        let ch = @ptrv(data, u8, indent_end)
        if ch != ' ' && ch != '\t' : break
        indent_end++
    }
    let indent = line.part(0, indent_end)

    let i = indent_end
    let in_string = false
    let in_char = false
    while i < bytes {
        let ch = @ptrv(data, u8, i)
        if in_string || in_char {
            // A backslash hides what follows it, the closing quote included
            if ch == '\\' {
                i += 2
                continue
            }
            if in_string && ch == '"' : in_string = false
            else if in_char && ch == '\'' : in_char = false
            i++
            continue
        }
        if ch == '"' {
            in_string = true
            i++
            continue
        }
        if ch == '\'' {
            in_char = true
            i++
            continue
        }
        if ch == '/' && i + 1 < bytes && @ptrv(data, u8, i + 1) == '/' {
            let code = line.part(0, i).rtrim(" ").rtrim("\t")
            // Nothing but indentation in front of it: a standalone comment
            if code.bytes <= indent_end : break
            return AlignLine {
                code: code
                comment: line.part(i, bytes - i)
                indent: indent
            }
        }
        i++
    }

    return AlignLine {
        code: line
        indent: indent
    }
}

class ErrorType {
    unit: Unit
    ns: Namespace
    name: String
    act: ACT
    exp: Exp
    // File scope for extends id lookup and payload type resolution
    scope: Scope
    // Error code names (own codes first; inherited codes appended during parse)
    codes: Array[String] (.{})
    // How many of `codes` the declaration itself lists
    own_code_count: uint (0)
    // The parents named in `extends (...)`, without their transitive parents
    declared_extends: Array[ErrorType] (.{})
    // Raw EXP.body until parse_error_type
    extends_exp: ?Exp (null) // `(OtherError, ...)`
    payload_exp: ?Exp (null) // `{ name: Type [(default)], ... }`
    // `$global` — registered on Build.scope
    is_global: bool (false)
    // Resolved parents (direct + transitive)
    extends: Array[ErrorType] (.{})
    // Payload field name → Type (own + inherited)
    payload: Map[Type] (.{})
    // Explicit payload defaults: field name → EXP.body `(...)` (only when defined)
    payload_defaults: Map[Exp] (.{})
    // Thread-local transport storage used by the error ABI.
    payload_globals: Map[Global] (.{})
    // When backed by a named tagged union (`fn f() T !MyUnion`)
    union_type: ?Type (null)
    union_has_payload: bool (false)
    union_global: ?Global (null)
    // parse_error_type bookkeeping (handles circular extends)
    parsing: bool (false)
    parsed: bool (false)

    fn is_compat(with: ErrorType) bool {
        if this == with : return true
        if isset(this.union_type) || isset(with.union_type) : return false
        return this.extends.contains(with)
    }
}

class UnionWrapStep {
    union_type: Type
    variant: UnionVariant
}

// Adapts a named tagged union into an ErrorType so it flows through function,
// closure, fnptr, and coroutine signatures with the out-of-band error ABI.
fn error_type_for_union(union_t: Type) ErrorType !Error {
    let c = union_t.get_class_or_null() ?! union_t.build.bug("Named union error is missing its Class")
    let cached = c.error_adapter
    if isset(cached) : return cached

    let variants = c.union_variants ?! c.exp.bug("Named union is missing its variants")
    let codes = Array[String]{}
    let has_payload = false
    each variants as v {
        codes.append(v.name)
        if v.payload_types.length > 0 : has_payload = true
    }

    let uglobal: ?Global = null
    if has_payload {
        let g = Global {
            unit: c.unit
            ns: c.ns
            name: "__error_union_" + c.unit.name + "_" + c.name + "_" + c.exp.i
            act: ACT.private
            kind: GLOBAL_KIND.global
            scope: c.scope
            exp: c.exp
            shared: false
            allow_unsafe: true
            type: union_t
        }
        // Only in unit.globals (not build.lists.globals): the slot is strictly transient
        // between `store; ret` and the caller's immediate `load` into a GC-rooted stack slot.
        c.unit.globals.append(g)
        uglobal = g
    }

    let adapter = ErrorType {
        unit: c.unit
        ns: c.ns
        name: c.pretty_name()
        act: c.act
        exp: c.exp
        scope: c.scope
        codes: codes
        own_code_count: codes.length
        union_type: union_t
        union_has_payload: has_payload
        union_global: uglobal
        parsed: true
    }
    c.error_adapter = adapter
    return adapter
}

fn resolve_error_type_from_id(err_exp: Exp, scope: Scope) ErrorType !Error {
    let idf = resolve_idf_from_id(err_exp, scope) !>
    if idf.type == IDF.error_type {
        let etype = idf.error_type
        if !isset(etype) : err_exp.bug("Error-type idf is missing error_type")
        return etype
    }
    if idf.type == IDF.class {
        let c = idf.class ?! err_exp.bug("Class idf is missing class")
        if c.kind == CLASS_KIND.union && c.is_named_union {
            if c.is_generic_base : err_exp.error("Generic union '" + c.pretty_name() + "' cannot be used as an error type without type arguments")
            let ut = c.get_type() !>
            return error_type_for_union(ut) !>
        }
    }
    if idf.type == IDF.type {
        let t = idf.of_type
        if isset(t) {
            let c = t.get_class_or_null()
            if isset(c) && c.kind == CLASS_KIND.union && c.is_named_union {
                return error_type_for_union(t) !>
            }
        }
    }
    err_exp.error("Identifier must be an error type or named union")
}

// Finds a unique `$auto` wrapping chain from `from` into `to` (outermost step first).
// Direct `$auto` variants take precedence over transitive chains.
fn union_error_wrap_chain(from: Type, to: Type, depth: uint (0)) (?Array[UnionWrapStep], bool) {
    if depth > 8 : return (null, false)
    let to_class = to.get_class_or_null() ?! return (null, false)
    if !to_class.is_named_union : return (null, false)
    let variants = to_class.union_variants ?! return (null, false)
    let from_key = type_identity_key(from)

    // 1. Direct `$auto` match
    each variants as v {
        if !v.is_auto : continue
        if type_identity_key(v.payload_type) == from_key {
            return (Array[UnionWrapStep]{ UnionWrapStep { union_type: to, variant: v } }, false)
        }
    }

    // 2. Transitive `$auto` match through intermediate named unions
    let found: ?Array[UnionWrapStep] = null
    each variants as v {
        if !v.is_auto : continue
        let inner_class = v.payload_type.get_class_or_null()
        if !isset(inner_class) || !inner_class.is_named_union : continue
        let sub, ambig = union_error_wrap_chain(from, v.payload_type, depth + 1)
        if ambig : return (null, true)
        if isset(sub) {
            if isset(found) : return (null, true)
            let full = Array[UnionWrapStep]{ UnionWrapStep { union_type: to, variant: v } }
            each sub as step : full.append(step)
            found = full
        }
    }
    return (found, false)
}

fn wrap_union_with_chain(inner: Value, chain: Array[UnionWrapStep], ctx: Context, at: Exp) Value !Error {
    let current = inner
    let i = chain.length
    while i-- > 0 {
        let step = chain.get(i) ! at.bug("Missing union wrap step")
        current = vgen_union_wrap(current, step.union_type, step.variant.tag, ctx)
            ?! at.bug("Failed to wrap union error via $auto")
        current.exp = at
    }
    return current
}

// Resolve extends + payload. Safe to call multiple times; recurses into parents first.
fn parse_error_type(e: ErrorType) !Error {
    if e.parsed : return
    if e.parsing {
        e.exp.error("Circular extend for error type: " + e.name)
    }
    e.parsing = true
    // Legacy `error` stays quiet until 0.9.0 bootstraps `src/`'s own 4 error declarations.

    let extends_body = e.extends_exp
    if isset(extends_body) {
        parse_error_extends(e, extends_body) !>
    }

    let payload_body = e.payload_exp
    if isset(payload_body) {
        parse_error_payload(e, payload_body) !>
    }

    if e.codes.length == 0 {
        e.exp.error("Error types need to have at least 1 error code defined")
    }

    // A code's value is a hash of its name, so two distinct names in the same
    // family can collide; `error_is` and `match` would then conflate them.
    let seen = Map[String]{}
    each e.codes as code {
        let key = ir_error_code(code).to(String)
        let other = seen.get(key) !? null
        if !isset(other) {
            seen.set(key, code)
            continue
        }
        if other != code {
            e.exp.error("Error codes '" + other + "' and '" + code + "' have the same value; rename one of them")
        }
    }

    e.parsed = true
    e.parsing = false
}

// A coroutine keeps its error's payload until it is awaited, so its fields must be known
fn validate_coroutine_error_type(e: ?ErrorType, at: Exp) !Error {
    if !isset(e) || e.parsed || e.parsing : return
    parse_error_type(e) !>
}

// Parse `extends (A, ns.B, ...)` — lookup error types, merge codes/payloads, record hierarchy.
fn parse_error_extends(e: ErrorType, body: Exp) !Error {
    let pos = body.pos
    if !isset(pos) : body.bug("Error extends body is missing a Pos")
    let p = pos.copy().init_parser()
    let scope = e.scope

    while true {
        if p.next_word_is(")", true, true, true) !> : break

        let id = p.read_id(true, true) !>
        let idf = resolve_idf_from_id(id, scope) !>
        if idf.type != IDF.error_type {
            id.error("Not an error type: " + id.str1)
        }
        let parent = idf.error_type
        if !isset(parent) : id.bug("Error-type idf is missing error_type")

        // Resolve parent first (detects cycles via parsing flag)
        parse_error_type(parent) !>

        if parent.extends.contains(e) {
            id.error("Circular extend for error type: " + e.name + " <> " + parent.name)
        }

        // Direct parent
        if !e.declared_extends.contains(parent) : e.declared_extends.append(parent)
        if !e.extends.contains(parent) {
            e.extends.append(parent)
        }
        // Transitive parents
        each parent.extends as sub {
            if !e.extends.contains(sub) {
                e.extends.append(sub)
            }
        }

        // Merge inherited codes (by name)
        each parent.codes as code {
            if !e.codes.contains(code) {
                e.codes.append(code)
            }
        }

        // Merge inherited payload fields (and any explicit defaults)
        each parent.payload as ptype, pname {
            let pg = parent.payload_globals.get(pname) !? null
            if isset(pg) : e.payload_globals.set(pname, pg)
            let pdef = parent.payload_defaults.get(pname) !? null
            error_add_payload(e, body, pname, ptype, pdef) !>
        }

        // Separator or closing token
        let t = p.tok(true, true) !>
        if t == TOK.sign && p.word_is(")") : break
        if t == TOK.sign && p.word_is(",") {
            let next = p.tok(true, true, false) !>
            if next == TOK.sign && p.word_is(")") {
                p.error("Trailing comma in error extends")
            }
            if next == TOK.sign && p.word_is(",") {
                p.error("Empty item in error extends")
            }
            continue
        }
        p.error("Expected ',' or ')' in error extends, found: '" + p.word() + "'")
    }
}

// Parse `payload { name: Type [(default)], ... }`
fn parse_error_payload(e: ErrorType, body: Exp) !Error {
    let pos = body.pos
    if !isset(pos) : body.bug("Error payload body is missing a Pos")
    let p = pos.copy().init_parser()
    let scope = e.scope

    while true {
        if p.next_word_is("}", true, true, true) !> : break

        let t = p.tok(true, true) !>
        if t != TOK.word {
            p.error("Expected payload field name, found: '" + p.word() + "'")
        }
        let name = p.word()
        p.expect(":", true, false) !>
        let type_exp = read_type_exp(p, true, false) !>
        let of_type = type_from_exp(type_exp, scope) !>
        if of_type.has_locked_refs() {
            type_exp.error("A 'locked' view cannot be stored in an error payload; it is only valid inside its lock block")
        }

        // Optional default: ( ... ) — same form as class props / function args
        let default_exp: ?Exp = null
        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is("(") {
            p.tok(true, true) !>
            default_exp = read_body_exp(p, "(", ")") !>
        }

        error_add_payload(e, body, name, of_type, default_exp) !>

        // Optional comma between fields (also allow bare next field / `}`)
        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is(",") {
            p.tok(true, true) !>
            let next = p.tok(true, true, false) !>
            if next == TOK.sign && p.word_is("}") {
                p.error("Trailing comma in error payload")
            }
            if next == TOK.sign && p.word_is(",") {
                p.error("Empty item in error payload")
            }
        }
    }
}

// Register a payload field; duplicate names must be type-compatible.
fn error_add_payload(e: ErrorType, at: Exp, name: String, of_type: Type, default_exp: ?Exp (null)) !Error {
    if name == "code" {
        at.error("You cannot use 'code' for a payload property name, this is a reserved name")
    }
    if e.codes.contains(name) {
        at.error("The payload property name '" + name + "' is already used as an error code")
    }
    e.payload.get(name) -> existing {
        if existing.compat(of_type) : return
        if of_type.compat(existing) : return
        at.error("Duplicate payload '" + name + "' with incompatible types on error " + e.name)
    }
    e.payload.set(name, of_type)
    if isset(default_exp) : e.payload_defaults.set(name, default_exp)
    error_add_payload_global(e, name, of_type)
}

fn error_add_payload_global(e: ErrorType, name: String, of_type: Type) {
    if e.payload_globals.has(name) : return
    let g = Global {
        unit: e.unit
        ns: e.ns
        name: "__error_payload_" + e.name + "_" + name
        act: ACT.private
        kind: GLOBAL_KIND.global
        scope: e.scope
        exp: e.exp
        shared: false
        allow_unsafe: true
        type: of_type.nullable()
    }
    e.unit.globals.append(g)
    e.ns.build.lists.globals.append(g)
    e.payload_globals.set(name, g)
}

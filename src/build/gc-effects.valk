
// Propagate allocation effects through the call graph, then check the
// gc_free hooks against them.
fn finish_gc_effects(build: Build) !Error {
    propagate_gc_effects(build)
    validate_gc_free_effects(build) !>
    validate_gc_primitive_polls(build) !>
}

// C-26: a poll that collects inside a primitive's raw-move span would free what its moved
// words name, so no function a primitive calls may poll
fn validate_gc_primitive_polls(build: Build) !Error {
    each build.lists.units as unit {
        each unit.functions as func {
            if !func.is_gc_primitive || !func.info_polls : continue
            let via = func.gc_poll_via
            let source = func.gc_poll_source
            let suffix = isset(via) ? " through '" + via.name + "'" : ""
            if isset(source) && source != via && source != func {
                suffix += " (which reaches '" + source.name + "')"
            }
            func.exp.error("A $gc_primitive function cannot reach a loop that polls for GC" + suffix)
        }
    }
}

fn validate_gc_free_effects(build: Build) !Error {
    each build.lists.units as unit {
        each unit.functions as func {
            if !isset(func.class) || func.name != "gc_free" : continue
            if func.info_collects_gc {
                func.exp.error("gc_free cannot trigger garbage collection")
            }
            if func.info_allocates_gc {
                let source = func.gc_allocation_source
                let via = func.gc_allocation_via
                let suffix = isset(via) ? " through '" + via.name + "'" : ""
                if isset(source) && source != via && source != func {
                    suffix += " (which reaches '" + source.name + "')"
                }
                func.exp.error("gc_free cannot allocate GC-managed objects" + suffix)
            }
            if func.info_calls_unknown_code {
                func.exp.error("gc_free cannot call code with unknown allocation effects")
            }
        }
    }
}

fn propagate_gc_effects(build: Build) {
    let queue = Array[Func]{}
    each build.lists.units as unit {
        each unit.functions as func {
            each func.effect_callees as callee : callee.called_by.append(func, true)
            func.info_reaches_gc = func.info_calls_unknown_code || func.info_allocates_gc || func.info_collects_gc
                || func.may_suspend || func.info_polls || func.is_extern || !func.parsed_ast || ir_func_in_gc(func)
            if func.info_reaches_gc : queue.append(func)
        }
    }

    while true {
        let func = queue.pop_last() ! break
        each func.called_by as caller {
            let changed = false
            if func.info_allocates_gc && !caller.info_allocates_gc {
                caller.info_allocates_gc = true
                caller.gc_allocation_source = func.gc_allocation_source ?? func
                caller.gc_allocation_via = func
                changed = true
            }
            if func.info_calls_unknown_code && !caller.info_calls_unknown_code {
                caller.info_calls_unknown_code = true
                changed = true
            }
            if func.info_collects_gc && !caller.info_collects_gc {
                caller.info_collects_gc = true
                changed = true
            }
            // Grove's runtime is trusted: it emits no poll, and its safepoints are the triggers
            if func.info_polls && !caller.info_polls && !ir_func_in_gc(func) {
                caller.info_polls = true
                caller.gc_poll_source = func.gc_poll_source ?? func
                caller.gc_poll_via = func
                changed = true
            }
            if func.info_reaches_gc && !caller.info_reaches_gc {
                caller.info_reaches_gc = true
                changed = true
            }
            if func.may_suspend && !caller.may_suspend {
                caller.may_suspend = true
                changed = true
            }
            if changed : queue.append(caller)
        }
    }

    each build.lists.units as unit {
        each unit.functions as func : func.called_by.clear()
    }
}

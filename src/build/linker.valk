use helper
use valk:core
use valk:fs
use valk:time

// Link the per-Unit objects into a native Linux executable. Other target
// families retain an explicit error until their legacy command shapes are
// ported.
fn link_unit_objects(build: Build) !Error {
    let start = time:microtime()
    let target = build.options.target
    if target.os != "linux" || !target.host_is_target() {
        build.error("The rewritten linker currently supports native Linux builds only")
    }

    let output = build.options.path_out
    if isset(output) : output = helper:resolve(output)
    else : output = helper:add(object_output_dir(build) !>, "out")
    build.options.path_out = output

    let dirs = linux_link_dirs(build)
    let missing = Array[String]{}
    let args = ByteBuffer.new(16384)
    args.write_string("-pie -o \"")
    args.write_string(output)
    args.write_string("\" ")

    each build.options.link_args as arg {
        args.write_string(arg)
        args.write_string(" ")
    }
    each dirs as dir {
        args.write_string("-L\"")
        args.write_string(dir)
        args.write_string("\" ")
    }

    let root = build.options.sysroot ?? "/"
    args.write_string("--sysroot=\"")
    args.write_string(root)
    args.write_string("\" ")
    if target.arch == "x64" {
        args.write_string("-m elf_x86_64 --dynamic-linker /lib64/ld-linux-x86-64.so.2 ")
    } else {
        args.write_string("-m aarch64linux --dynamic-linker /lib/ld-linux-aarch64.so.1 ")
    }
    args.write_string("-l:Scrt1.o -l:crti.o -l:crtbeginS.o ")

    each build.lists.units as unit {
        if unit.path_o.length == 0 : continue
        args.write_string("\"")
        args.write_string(unit.path_o)
        args.write_string("\" ")
    }

    each build.lists.links as link {
        if link.type == LINK_KIND.framework {
            link.exp.error("Framework links are not supported for Linux targets")
        }
        linker_write_lib(args, link.lib, link.type == LINK_KIND.static, dirs, missing)
    }
    each build.options.link_libs as lib {
        linker_write_lib(args, lib, false, dirs, missing)
    }

    args.write_string("-l:crtendS.o -l:crtn.o ")
    each build.options.link_args_append as arg {
        args.write_string(arg)
        args.write_string(" ")
    }

    let argfile = helper:add(object_output_dir(build) !>, "link-args.rsp")
    let text = args.to_string()
    fs:write(argfile, text) ! build.error("Failed to write linker response file: " + argfile)

    let command = "ld \"@" + argfile + "\""
    if build.options.verbose > 1 {
        helper:msg("🔗", "Link cmd: " + command)
        each missing as name : println("> Warn: Library not found: " + name)
        if missing.length == 0 : helper:msg("✅", "All libraries found")
    }
    if build.options.verbose > 2 : println("# Full link args: " + text)

    let code, result = core:exec(command)
    if code != 0 {
        build.error("Failed to link executable\n# Exit code: " + code + "\n# Output: " + result)
    }
    build.stats.link_us = time:microtime() - start
}

fn linux_link_dirs(build: Build) Array[String] {
    let dirs = Array[String]{}
    each build.options.link_dirs as dir : dirs.append(helper:resolve(dir), true)

    if !build.options.no_system_libs {
        dirs.append("/lib64", true)
        dirs.append("/usr/lib64", true)
        dirs.append("/usr/local/lib64", true)
        dirs.append("/usr/lib", true)
        dirs.append("/usr/local/lib", true)
        if build.options.target.arch == "x64" {
            dirs.append("/lib/x86_64-linux-gnu", true)
        } else {
            dirs.append("/lib/aarch64-linux-gnu", true)
        }
    }

    each build.cache.package_dirs as pkg, pkgdir {
        dirs.append(helper:add(helper:add(pkgdir, "libs"), build.options.target.target), true)
        let config = pkg.config
        if !isset(config) : continue
        let configured = config.json.get_or("targets").get_or(build.options.target.target).get_or("link-dirs").array()
        each configured as item {
            let dir = item.string()
            if dir.length > 0 : dirs.append(helper:resolve(helper:add(pkgdir, dir)), true)
        }
    }
    return dirs
}

fn linker_write_lib(out: ByteBuffer, raw_name: String, static: bool, dirs: Array[String], missing: Array[String]) {
    let name = raw_name
    if name.starts_with(":") : name = name.part(1, name.length)
    let strict = name.contains(".")
    let is_path = name.contains("/") || name.contains("\\")

    if static && !strict && !is_path {
        let filename = "lib" + name + ".a"
        let path = linker_find_lib(filename, dirs)
        if isset(path) {
            linker_write_quoted(out, path)
            return
        }
        missing.append(filename, true)
    }

    if is_path {
        linker_write_quoted(out, name)
        return
    }
    if strict {
        let path = linker_find_lib(name, dirs)
        if isset(path) {
            linker_write_quoted(out, path)
        } else {
            missing.append(name, true)
            out.write_string("-l:")
            out.write_string(name)
            out.write_string(" ")
        }
        return
    }
    out.write_string("-l")
    out.write_string(name)
    out.write_string(" ")
}

fn linker_find_lib(name: String, dirs: Array[String]) ?String {
    each dirs as dir {
        let path = helper:add(dir, name)
        if fs:exists(path) : return path
    }
    return null
}

fn linker_write_quoted(out: ByteBuffer, path: String) {
    out.write_string("\"")
    out.write_string(path)
    out.write_string("\" ")
}

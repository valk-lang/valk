use helper

// Compiler-facing class/type object created from an EXP.class expression.
// Holds the same information the parser stored on Exp, but as named fields.
// `kind` is CLASS_KIND (class / struct / slice / pointer / integer / float / boolean / mode)
class Class {
    unit: Unit
    ns: Namespace
    // Export / uniqueness name (`Array__hash` for specializations)
    name: String
    // User-facing name (`Array[String]`); empty → fall back to `name`
    display_name: String ("")
    act: ACT
    kind: CLASS_KIND
    // Scope for members / type resolution (parent is the source-file scope)
    scope: Scope
    // Original parse expression (source span / raw AST)
    exp: Exp
    // Sub-expressions from EXP.class (still raw for later stages)
    generics: ?Exp (null) // EXP.body `[...]` of the declaration
    body: ?Exp (null)     // EXP.body `{...}`
    flags: ?Array[String] (null)
    // Kind-specific header fields
    number_size: u32 (0)         // integer/float size in bytes (`*` stored as 0)
    signed: bool (false)  // integer: signed vs unsigned
    packed: bool (false)  // struct: packed
    is_async: bool (false)
    // Modes / $noNewProperties — extensions may not add properties (own body may)
    no_new_props: bool (false)
    // mode X for Type — raw type exp + resolved target class
    mode_for_exp: ?Exp (null)
    mode_for_class: ?Class (null)
    // Members (declaration order; includes nameless props)
    props: Array[Prop] (.{})
    // Methods / getters (name → Func); not including group methods
    funcs: Map[Func] (.{})
    // `group name { ... }` members
    groups: Map[Group] (.{})
    // `extend ThisClass { ... }` blocks (shared with specializations)
    extends: Array[Extend] (.{})
    // Operator / conversion hooks from method flags ($to, $eq, …)
    to_hooks: Array[Func] (.{})
    eq_hooks: Array[Func] (.{})
    lt_hooks: Array[Func] (.{})
    gt_hooks: Array[Func] (.{})
    lte_hooks: Array[Func] (.{})
    gte_hooks: Array[Func] (.{})
    add_hooks: Array[Func] (.{})
    // Index get/set via `$offset` / `$offset_assign`
    offset: ?Func (null)
    offset_assign: ?Func (null)
    // Class-init list/map hooks: `T{ a, b }` / `T{ k => v }`
    append_hook: ?Func (null)   // `$append`
    set_key_hook: ?Func (null)  // `$set_key`
    // Cached Type for this class (immutable once created; shared by all bare refs)
    // Never created for generic base classes — only for concrete / specialized classes.
    type: ?Type (null)
    // ---- Generics ----
    // True for `class Foo[T, U] { ... }` before specialization
    is_generic_base: bool (false)
    // Ordered generic parameter names from the declaration (`T`, `U`, ...)
    generic_names: ?Array[String] (null)
    // Concrete type args for a specialized instance (`Array[String]` → [String])
    generic_types: ?Array[Type] (null)
    // Base class when this is a specialization
    generic_from: ?Class (null)
    // Cache of specializations: hash(type args) → Class (only on the base)
    generic_cache: ?Map[Class] (null)
    // Size (object / value layout in bytes)
    size: u32 (0)
    size_known: bool (false)
    size_computing: bool (false) // true while resolving; detects recursive deps

    // Pretty name for diagnostics: `X[String]` not the mangled export id.
    fn pretty_name() String {
        if this.display_name.length > 0 : return this.display_name
        return this.name
    }

    // Method/getter lookup with `mode X for Y` fallthrough to Y.
    fn get_func(name: String) ?Func {
        let f = this.funcs.get(name) !? null
        if isset(f) : return f
        let for_class = this.mode_for_class
        if isset(for_class) : return for_class.get_func(name)
        return null
    }

    // Group lookup with mode fallthrough.
    fn get_group(name: String) ?Group {
        let g = this.groups.get(name) !? null
        if isset(g) : return g
        let for_class = this.mode_for_class
        if isset(for_class) : return for_class.get_group(name)
        return null
    }

    // `$append` hook with mode fallthrough (Array, Slice, …).
    fn get_append_hook() ?Func {
        let f = this.append_hook
        if isset(f) : return f
        let for_class = this.mode_for_class
        if isset(for_class) : return for_class.get_append_hook()
        return null
    }

    // `$set_key` hook with mode fallthrough (Map → HashMap, …).
    fn get_set_key_hook() ?Func {
        let f = this.set_key_hook
        if isset(f) : return f
        let for_class = this.mode_for_class
        if isset(for_class) : return for_class.get_set_key_hook()
        return null
    }

    // Find a named property. Nameless props are skipped. Throws .missing if not found.
    // Modes fall through to the wrapped type unless this mode defines a same-named method.
    fn get_prop_by_name(name: String) Prop !LookupError {
        each this.props as prop {
            let n = prop.name
            if isset(n) && n == name : return prop
        }
        let for_class = this.mode_for_class
        if isset(for_class) {
            // Mode method/getter shadows base storage of the same name
            if this.funcs.has(name) : throw .missing
            return for_class.get_prop_by_name(name) !>
        }
        throw .missing
    }

    // Type representing this class. Created once and cached.
    // Must not be used on generic base classes — specialize first.
    fn get_type() Type !Error {
        if this.is_generic_base {
            // Never form a Type for an un-specialized generic base
            this.ns.build.error("(Compiler bug) get_type() on generic base class: " + this.pretty_name())
        }
        let cached = this.type
        if isset(cached) : return cached

        let kind = this.kind
        let t: TYPE = TYPE.class
        if kind == CLASS_KIND.integer : t = TYPE.int
        else if kind == CLASS_KIND.float : t = TYPE.float
        else if kind == CLASS_KIND.boolean : t = TYPE.bool
        else if kind == CLASS_KIND.pointer : t = TYPE.ptr

        let res = Type {
            type: t
            build: this.ns.build
            class: this
            custom_name: this.pretty_name()
        }
        this.type = res
        return res
    }

    // Target pointer size in bytes
    fn ptr_size() u32 {
        return this.ns.build.options.target.ptr_size.to(u32)
    }

    // Size of the class definition/object layout.
    // - integer / float / boolean: fixed number_size (`*` → ptr_size)
    // - class / struct: property layout
    // - mode: layout of the class it wraps
    // - pointer / slice: pointer-sized representation
    //
    // `Type.size()` separately returns ptr_size for a named class/struct value;
    // `<Class>` / `<Struct>` asks for this body layout.
    fn compute_size() u32 !Error {
        let kind = this.kind
        let psz = this.ptr_size()

        if kind == CLASS_KIND.integer || kind == CLASS_KIND.float {
            if this.size_known : return this.size
            let s = this.number_size
            if s == 0 : s = psz
            this.size = s
            this.size_known = true
            return s
        }
        if kind == CLASS_KIND.boolean {
            if this.size_known : return this.size
            this.size = 1
            this.size_known = true
            return 1
        }
        if kind == CLASS_KIND.class || kind == CLASS_KIND.struct {
            return this.compute_body_size() !>
        }
        if kind == CLASS_KIND.mode {
            let for_class = this.mode_for_class
            if !isset(for_class) {
                this.ns.build.bug("Mode target is unresolved while computing size: " + this.name)
            }
            return for_class.compute_size() !>
        }
        if kind == CLASS_KIND.pointer || kind == CLASS_KIND.slice {
            // Reference-sized values — do not walk properties (avoids false recursion)
            return psz
        }

        return psz
    }

    // Object / struct body size: sum of property type sizes, rounded up to pointer
    // alignment. Cached on the class. Detects recursive inline dependencies
    // (e.g. struct A { b: B } / struct B { a: A }).
    fn compute_body_size() u32 !Error {
        if this.size_known : return this.size
        if this.size_computing {
            this.ns.build.error("Cannot determine class size due to recursive type dependencies: " + this.name)
        }
        this.size_computing = true

        let psz = this.ptr_size()
        let total: u32 = 0
        each this.props as prop {
            prop.offset = total
            total += prop.type.size() !>
        }
        // Round up to pointer size (matches classic Valk class layout)
        if total > 0 && total % psz != 0 {
            total += psz - (total % psz)
        }

        this.size = total
        this.size_known = true
        this.size_computing = false
        return total
    }

    // Specialize a generic base with concrete type arguments.
    // Returns a cached instance if this combination was already generated.
    // Sets generic param identifiers on the new class scope.
    fn specialize(gtypes: Array[Type], at: Exp) Class !Error {
        if !this.is_generic_base {
            at.error("Type is not generic: " + this.name)
        }
        let names = this.generic_names
        if !isset(names) : at.bug("Generic base is missing generic_names")
        if gtypes.length != names.length {
            at.error("Generic type '" + this.name + "' expects " + names.length + " type argument(s), got " + gtypes.length)
        }

        let cache = this.generic_cache
        if !isset(cache) {
            let m = Map[Class]{}
            this.generic_cache = m
            cache = m
        }

        let key = generic_types_key(gtypes)
        let existing = cache.get(key) !? null
        if isset(existing) : return existing

        // Parent of the specialized scope: same as the base's parent (source-file scope)
        let parent = this.scope.parent
        let gscope = Scope.new(parent)

        let gclass = Class {
            unit: this.unit
            ns: this.ns
            // Mangled export / cache identity; pretty name is separate for diagnostics
            name: this.name + "__" + key
            display_name: this.pretty_name() + generic_types_display(gtypes)
            act: this.act
            kind: this.kind
            scope: gscope
            exp: this.exp
            generics: this.generics
            body: this.body
            flags: this.flags
            number_size: this.number_size
            signed: this.signed
            packed: this.packed
            is_async: this.is_async
            no_new_props: this.no_new_props
            mode_for_exp: this.mode_for_exp
            // Share extend list with the base (same Extend objects; remapped on parse)
            extends: this.extends
            is_generic_base: false
            generic_names: names
            generic_types: gtypes
            generic_from: this
        }

        // Bind generic parameters as type identifiers in the new class scope
        let i: uint = 0
        each names as gname {
            let gt = gtypes.get(i) ! at.bug("Missing generic type argument")
            gscope.set_idf(gname, Idf.for_type(gt))
            i++
        }
        // SELF points at the specialized class
        gscope.set_idf("SELF", Idf.for_class(gclass))

        cache.set(key, gclass)

        // Parse properties immediately so specializations work during stage-3
        // (type annotations / `X[T].new()` in function bodies) as well as stage-2.
        // parse_func_types / parse_func_ast are idempotent via parsed_* guards, so
        // methods also enqueued on the pipeline remain safe if drained later.
        parse_class_properties(gclass) !>
        each gclass.funcs as f {
            parse_func_types(f) !>
        }
        each gclass.groups as g {
            each g.funcs as f {
                parse_func_types(f) !>
            }
        }

        return gclass
    }
}

// Pretty suffix for specialized generics: `[String, uint]`.
fn generic_types_display(types: Array[Type]) String {
    let buf = ByteBuffer.new()
    buf.write_string("[")
    each types as t, i {
        if i > 0 : buf.write_string(", ")
        buf.write_string(t.compat_display_name())
    }
    buf.write_string("]")
    return buf.to_string()
}

// Stable cache key for a list of concrete generic type arguments.
fn generic_types_key(types: Array[Type]) String {
    let buf = ByteBuffer.new()
    buf.write_string("[")
    each types as t, i {
        if i > 0 : buf.write_string(",")
        type_append_key(t, buf)
    }
    buf.write_string("]")
    return helper:ctxhash(buf.to_string())
}

fn type_append_key(t: Type, buf: ByteBuffer) {
    // Prefer identity of interned types: class name (+ specialization name), wrappers, etc.
    if t.type == TYPE.void {
        buf.write_string("void")
        return
    }
    if t.type == TYPE.any {
        buf.write_string("any")
        return
    }
    if t.type == TYPE.nullable {
        buf.write_string("?")
        let sub = t.sub_type
        if isset(sub) : type_append_key(sub, buf)
        return
    }
    if t.type == TYPE.ptr {
        buf.write_string("*")
        if t.is_slice_ptr : buf.write_string("[]")
        let sub = t.sub_type
        if isset(sub) : type_append_key(sub, buf)
        if t.array_size > 0 {
            buf.write_string("x")
            buf.write_uint_ascii(t.array_size.to(uint))
        }
        return
    }
    if t.type == TYPE.ref {
        buf.write_string("&")
        if t.is_slice_ptr : buf.write_string("[]")
        let sub = t.sub_type
        if isset(sub) : type_append_key(sub, buf)
        return
    }
    if t.type == TYPE.inline {
        buf.write_string("<>")
        let sub = t.sub_type
        if isset(sub) : type_append_key(sub, buf)
        return
    }
    if t.type == TYPE.array {
        buf.write_string("[")
        let sub = t.sub_type
        if isset(sub) : type_append_key(sub, buf)
        buf.write_string("x")
        buf.write_uint_ascii(t.array_size.to(uint))
        buf.write_string("]")
        return
    }
    if t.type == TYPE.multi {
        buf.write_string("(")
        let subs = t.sub_types
        if isset(subs) {
            each subs as st, i {
                if i > 0 : buf.write_string(",")
                type_append_key(st, buf)
            }
        }
        buf.write_string(")")
        return
    }
    let c = t.class
    if isset(c) {
        buf.write_string(c.name)
        // Include resolved generic args if this class is itself a specialization
        let gts = c.generic_types
        if isset(gts) {
            buf.write_string("<")
            each gts as gt, i {
                if i > 0 : buf.write_string(",")
                type_append_key(gt, buf)
            }
            buf.write_string(">")
        }
        return
    }
    buf.write_string("#")
    buf.write_uint_ascii(t.type.@cast(u32).to(uint))
    if t.custom_name.length > 0 {
        buf.write_string(":")
        buf.write_string(t.custom_name)
    }
}

// Compiler-facing class/type object created from an EXP.class expression.
// Holds the same information the parser stored on Exp, but as named fields.
// `kind` is the keyword: class / struct / slice / pointer / integer / float / boolean / mode
class Class {
    unit: Unit
    ns: Namespace
    name: String
    act: ACT
    kind: String
    // Original parse expression (source span / raw AST)
    exp: Exp
    // Sub-expressions from EXP.class (still raw for later stages)
    generics: ?Exp (null) // EXP.body `[...]`
    body: ?Exp (null)     // EXP.body `{...}`
    flags: ?Array[String] (null)
    // Kind-specific header fields
    number_size: u32 (0)         // integer/float size in bytes (`*` stored as 0)
    signed: bool (false)  // integer: signed vs unsigned
    packed: bool (false)  // struct: packed
    is_async: bool (false)
    // Size
    size: u32 (0)
    size_known: bool (false) // Wether we determined the size of class (in bytes)
}

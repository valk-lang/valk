use helper

class Class {
    unit: Unit
    ns: Namespace
    // Export / uniqueness name (`Array__hash` for specializations)
    name: String
    // User-facing name (`Array[String]`); empty → fall back to `name`
    display_name: String ("")
    act: ACT
    kind: CLASS_KIND
    // Scope for members / type resolution (parent is the source-file scope)
    scope: Scope
    // Original parse expression (source span / raw AST)
    exp: Exp
    // Sub-expressions from EXP.class (still raw for later stages)
    generics: ?Exp (null) // EXP.body `[...]` of the declaration
    body: ?Exp (null)     // EXP.body `{...}`
    flags: ?Array[String] (null)
    // Kind-specific header fields
    number_size: u32 (0)         // integer/float size in bytes (`*` stored as 0)
    signed: bool (false)  // integer: signed vs unsigned
    packed: bool (false)  // struct: packed
    is_async: bool (false)
    // Modes / $noNewProperties — extensions may not add properties (own body may)
    no_new_props: bool (false)
    // mode X for Type — raw type exp + resolved target
    mode_for_exp: ?Exp (null)
    mode_for_class: ?Class (null)
    mode_for_type: ?Type (null)
    union_type_exp: ?Exp (null)
    slice_type_exp: ?Exp (null)
    slice_type: ?Type (null)
    // Raw and resolved `is` contracts. Only CLASS_KIND.class uses these.
    interfaces_exp: ?Exp (null)
    interfaces: Array[Class] (.{})
    interfaces_resolved: bool (false)
    // Interface declarations assign each instance method a stable dispatch slot.
    interface_method_count: uint (0)
    // Concrete adapter layouts, keyed by implementing class identity.
    interface_adapters: Map[Class] (.{})
    type_resolving: bool (false)
    // Members (declaration order; includes nameless props)
    props: Array[Prop] (.{})
    // Built lazily because most declaration-only classes never need a name lookup.
    props_by_name: ?Map[Prop] (null)
    // Methods / getters (name → Func); not including group methods
    funcs: Map[Func] (.{})
    // `group name { ... }` members
    groups: Map[Group] (.{})
    // `extend ThisClass { ... }` blocks (shared with specializations)
    extends: Array[Extend] (.{})
    // Operator / conversion hooks from method flags ($to, $eq, …)
    to_hooks: Array[Func] (.{})
    eq_hooks: Array[Func] (.{})
    lt_hooks: Array[Func] (.{})
    gt_hooks: Array[Func] (.{})
    lte_hooks: Array[Func] (.{})
    gte_hooks: Array[Func] (.{})
    add_hooks: Array[Func] (.{})
    // Index get/set via `$offset` / `$offset_assign`
    offset: ?Func (null)
    offset_assign: ?Func (null)
    // Bracket range access: `value[start_index .. length]`.
    range_hook: ?Func (null)  // `$range`
    // Class-init list/map hooks: `T{ a, b }` / `T{ k => v }`
    append_hook: ?Func (null)   // `$append`
    set_key_hook: ?Func (null)  // `$set_key`
    // Static, zero-argument factory used by `T.$default_value`.
    default_hook: ?Func (null)  // `$default`
    clone_hook: ?Func (null)    // `$clone`
    hash_hook: ?Func (null)     // `$hash`
    type: ?Type (null)
    is_generic_base: bool (false)
    // Ordered generic parameter names from the declaration (`T`, `U`, ...)
    generic_names: ?Array[String] (null)
    // Concrete type args for a specialized instance (`Array[String]` → [String])
    generic_types: ?Array[Type] (null)
    // Base class when this is a specialization
    generic_from: ?Class (null)
    // Cache of specializations: hash(type args) → Class (only on the base)
    generic_cache: ?Map[Class] (null)
    // Size (object / value layout in bytes)
    size: u32 (0)
    size_known: bool (false)
    size_computing: bool (false) // true while resolving; detects recursive deps
    props_pending: bool (false) // true between class creation and its property parse
    struct_gc_known: bool (false)
    struct_gc: bool (false)

    // Pretty name for diagnostics: `X[String]` not the mangled export id.
    fn pretty_name() String {
        if this.display_name.length > 0 : return this.display_name
        return this.name
    }

    fn representation_class() Class {
        let class = this
        while class.kind == CLASS_KIND.mode {
            let target = class.mode_for_class
            if !isset(target) : return class
            class = target
        }
        return class
    }

    // Method/getter lookup with `mode X for Y` fallthrough to Y.
    fn get_func(name: String) ?Func {
        let f = this.funcs.get(name) !? null
        if isset(f) : return f
        let for_class = this.mode_for_class
        if isset(for_class) : return for_class.get_func(name)
        return null
    }

    // Group lookup with mode fallthrough.
    fn get_group(name: String) ?Group {
        let g = this.groups.get(name) !? null
        if isset(g) : return g
        let for_class = this.mode_for_class
        if isset(for_class) : return for_class.get_group(name)
        return null
    }

    // `$append` hook with mode fallthrough (Array, Slice, …).
    fn get_append_hook() ?Func {
        let f = this.append_hook
        if isset(f) : return f
        let for_class = this.mode_for_class
        if isset(for_class) : return for_class.get_append_hook()
        return null
    }

    // `$set_key` hook with mode fallthrough (Map → HashMap, …).
    fn get_set_key_hook() ?Func {
        let f = this.set_key_hook
        if isset(f) : return f
        let for_class = this.mode_for_class
        if isset(for_class) : return for_class.get_set_key_hook()
        return null
    }

    fn get_clone_hook() ?Func {
        let f = this.clone_hook
        if isset(f) : return f
        let for_class = this.mode_for_class
        if isset(for_class) : return for_class.get_clone_hook()
        return null
    }

    fn get_hash_hook() ?Func {
        let f = this.hash_hook
        if isset(f) : return f
        let for_class = this.mode_for_class
        if isset(for_class) : return for_class.get_hash_hook()
        return null
    }

    // `$range` hook with mode fallthrough.
    fn get_range_hook() ?Func {
        let f = this.range_hook
        if isset(f) : return f
        let for_class = this.mode_for_class
        if isset(for_class) : return for_class.get_range_hook()
        return null
    }

    fn add_prop(prop: Prop) {
        this.props.append(prop)
        let props_by_name = this.props_by_name
        let name = prop.name
        if isset(props_by_name) && isset(name) : props_by_name.set(name, prop)
    }

    fn get_prop_by_name(name: String) Prop !LookupError {
        let props_by_name = this.props_by_name
        if !isset(props_by_name) {
            let created = Map[Prop]{}
            each this.props as prop {
                let prop_name = prop.name
                if isset(prop_name) : created.set(prop_name, prop)
            }
            this.props_by_name = created
            props_by_name = created
        }
        props_by_name.get(name) -> prop : return prop

        let for_class = this.mode_for_class
        if isset(for_class) {
            // Mode method/getter shadows base storage of the same name
            if this.funcs.has(name) : throw .missing
            return for_class.get_prop_by_name(name) !>
        }
        throw .missing
    }

    fn get_type() Type !Error {
        if this.is_generic_base {
            // Never form a Type for an un-specialized generic base
            this.ns.build.error("(Compiler bug) get_type() on generic base class: " + this.pretty_name())
        }
        let cached = this.type
        if isset(cached) : return cached

        let kind = this.kind
        if kind == CLASS_KIND.union {
            if this.type_resolving {
                this.exp.error("Recursive union alternatives are not allowed: " + this.pretty_name())
            }
            let alternatives = this.union_type_exp
            if !isset(alternatives) : this.exp.bug("Union is missing its alternatives")
            this.type_resolving = true
            let res = type_named_union(this, alternatives) !>
            this.type_resolving = false
            this.type = res
            return res
        }

        let t: TYPE = TYPE.struct
        if kind == CLASS_KIND.interface : t = TYPE.gcptr
        if kind == CLASS_KIND.integer : t = TYPE.int
        else if kind == CLASS_KIND.float : t = TYPE.float
        else if kind == CLASS_KIND.boolean : t = TYPE.bool
        else if kind == CLASS_KIND.pointer : t = TYPE.voidptr
        else if kind == CLASS_KIND.struct : t = TYPE.struct
        else if kind == CLASS_KIND.array : t = TYPE.array
        else if kind == CLASS_KIND.slice : t = TYPE.slice
        else if kind == CLASS_KIND.unbound : t = TYPE.ptr_of

        let info: ?TypeInfo = null
        let length: uint = 0
        let inline = kind == CLASS_KIND.struct
        let unsigned = kind == CLASS_KIND.integer && !this.signed
        if kind == CLASS_KIND.mode {
            if !isset(this.mode_for_type) : resolve_mode_for(this) !>
            let target = this.mode_for_type
            if !isset(target) : this.exp.bug("Mode target type is unresolved")
            t = target.kind
            info = target.info
            length = target.length
            inline = target.is_inline
            unsigned = target.unsigned
        }
        let element = this.slice_type
        if (t == TYPE.array || t == TYPE.slice || kind == CLASS_KIND.unbound) && isset(element) {
            info = UnaryTypeInfo { sub: element }
        }
        let res = Type {
            build: this.ns.build
            kind: t
            class: this
            info: info
            length: length
            custom_name: this.pretty_name()
            unsigned: unsigned
            is_inline: inline
        }
        this.type = res
        return res
    }

    // Target pointer size in bytes
    fn ptr_size() u32 {
        return this.ns.build.options.target.ptr_size.to(u32)
    }

    fn compute_size() u32 !Error {
        let kind = this.kind
        let psz = this.ptr_size()

        if kind == CLASS_KIND.integer || kind == CLASS_KIND.float {
            if this.size_known : return this.size
            let s = this.number_size
            if s == 0 : s = psz
            this.size = s
            this.size_known = true
            return s
        }
        if kind == CLASS_KIND.boolean {
            if this.size_known : return this.size
            this.size = 1
            this.size_known = true
            return 1
        }
        if kind == CLASS_KIND.class || kind == CLASS_KIND.struct || kind == CLASS_KIND.array {
            return this.compute_body_size() !>
        }
        if kind == CLASS_KIND.mode {
            let for_type = this.mode_for_type
            if !isset(for_type) {
                this.ns.build.bug("Mode target is unresolved while computing size: " + this.name)
            }
            return for_type.byte_size() !>
        }
        if kind == CLASS_KIND.pointer || kind == CLASS_KIND.slice || kind == CLASS_KIND.unbound || kind == CLASS_KIND.union || kind == CLASS_KIND.interface {
            // Reference-sized values — do not walk properties (avoids false recursion)
            return psz
        }

        return psz
    }

    fn compute_body_size() u32 !Error {
        if this.size_known : return this.size
        // A class can be asked for its size before the pipeline reaches its own
        // property parse: specializing a generic sizes its type arguments, and
        // that specialization can happen while an earlier class body is being
        // parsed. Parse now, or we would cache a size with the properties missing.
        if this.props_pending && !this.size_computing {
            parse_class_properties(this) !>
            if this.size_known : return this.size
        }
        if this.size_computing {
            this.ns.build.error("Cannot determine class size due to recursive type dependencies: " + this.name)
        }
        this.size_computing = true

        let psz = this.ptr_size()
        let total: u32 = 0
        each this.props as prop {
            if prop.is_slice_data : continue
            let prop_size = prop.type.byte_size() !>
            let alignment = prop.type.storage_alignment() !>
            if !this.packed && alignment > 1 : total = total.round_up(alignment)
            prop.offset = total
            total += prop_size
        }
        // Round up to pointer size (matches classic Valk class layout)
        if total > 0 && total % psz != 0 {
            total += psz - (total % psz)
        }

        this.size = total
        this.size_known = true
        this.size_computing = false
        return total
    }

    fn slice_data_offset() u32 !Error {
        let element = this.slice_type
        if !isset(element) : this.exp.bug("Slice has no element type")
        let offset = this.compute_body_size() !>
        let alignment = element.storage_alignment() !>
        return alignment <= 1 ? offset : offset.round_up(alignment)
    }

    fn specialize(gtypes: Array[Type], at: Exp) Class !Error {
        if !this.is_generic_base {
            at.error("Type is not generic: " + this.name)
        }
        let names = this.generic_names
        if !isset(names) : at.bug("Generic base is missing generic_names")
        if gtypes.length != names.length {
            at.error("Generic type '" + this.name + "' expects " + names.length + " type argument(s), got " + gtypes.length)
        }

        let cache = this.generic_cache
        if !isset(cache) {
            let m = Map[Class]{}
            this.generic_cache = m
            cache = m
        }

        let key = generic_types_key(gtypes)
        let existing = cache.get(key) !? null
        if isset(existing) : return existing

        // Parent of the specialized scope: same as the base's parent (source-file scope)
        let parent = this.scope.parent
        let gscope = Scope.new(parent)

        let gclass = Class {
            unit: this.unit
            ns: this.ns
            // Mangled export / cache identity; pretty name is separate for diagnostics
            name: this.name + "__" + key
            display_name: this.pretty_name() + generic_types_display(gtypes)
            act: this.act
            kind: this.kind
            scope: gscope
            exp: this.exp
            generics: this.generics
            body: this.body
            flags: this.flags
            number_size: this.number_size
            signed: this.signed
            packed: this.packed
            is_async: this.is_async
            no_new_props: this.no_new_props
            mode_for_exp: this.mode_for_exp
            slice_type_exp: this.slice_type_exp
            interfaces_exp: this.interfaces_exp
            // Share extend list with the base (same Extend objects; remapped on parse)
            extends: this.extends
            is_generic_base: false
            generic_names: names
            generic_types: gtypes
            generic_from: this
            props_pending: true
        }

        // Bind generic parameters as type identifiers in the new class scope
        let i: uint = 0
        each names as gname {
            let gt = gtypes.get(i) ! at.bug("Missing generic type argument")
            gscope.set_idf(gname, Idf.for_type(gt))
            i++
        }
        // SELF points at the specialized class
        gscope.set_idf("SELF", Idf.for_class(gclass))

        cache.set(key, gclass)

        parse_class_properties(gclass) !>
        gclass.compute_size() !>
        each gclass.funcs as f {
            parse_func_types(f) !>
        }
        each gclass.groups as g {
            each g.funcs as f {
                parse_func_types(f) !>
            }
        }
        validate_interface_declaration(gclass) !>
        resolve_class_interfaces(gclass) !>
        if this.name == "HashMap" && this.ns.name == "core" {
            let key_type = gtypes.get(0) ! at.bug("HashMap specialization is missing its key type")
            validate_hashmap_key_type(key_type, at) !>
        }

        return gclass
    }
}

fn class_parse_own_func_types(class: Class) !Error {
    each class.funcs as f : parse_func_types(f) !>
    each class.groups as g {
        each g.funcs as f : parse_func_types(f) !>
    }
}

fn validate_hashmap_key_type(key: Type, at: Exp) !Error {
    let class = key.get_direct_class_or_null()
    if isset(class) : class_parse_own_func_types(class) !>
    if key.has_eq() && !key.has_hash() {
        at.error("HashMap keys that define $eq must also define $hash")
    }
}

// Pretty suffix for specialized generics: `[String, uint]`.
fn generic_types_display(types: Array[Type]) String {
    let buf = ByteBuffer.new()
    buf.write_string("[")
    each types as t, i {
        if i > 0 : buf.write_string(", ")
        buf.write_string(t.compat_display_name())
    }
    buf.write_string("]")
    return buf.to_string()
}

// Stable cache key for a list of concrete generic type arguments.
fn generic_types_key(types: Array[Type]) String {
    let buf = ByteBuffer.new()
    buf.write_string("[")
    each types as t, i {
        if i > 0 : buf.write_string(",")
        type_append_key(t, buf)
    }
    buf.write_string("]")
    return helper:ctxhash(buf.to_string())
}

fn type_append_class_key(c: Class, buf: ByteBuffer) {
    let ns = c.ns
    buf.write_string(ns.pkg.name)
    buf.write_string(":")
    buf.write_string(ns.name)
    buf.write_string(":")
    buf.write_string(c.name)
    let gts = c.generic_types
    if !isset(gts) : return
    buf.write_string("<")
    each gts as gt, i {
        if i > 0 : buf.write_string(",")
        type_append_key(gt, buf)
    }
    buf.write_string(">")
}

fn type_append_named_key(ns: Namespace, name: String, buf: ByteBuffer) {
    buf.write_string(ns.pkg.name)
    buf.write_string(":")
    buf.write_string(ns.name)
    buf.write_string(":")
    buf.write_string(name)
}

fn type_append_key(t: Type, buf: ByteBuffer) {
    if t.is_shared : buf.write_string("shared ")
    let enum_info = t.get_enum()
    if isset(enum_info) {
        buf.write_string("enum:")
        type_append_named_key(enum_info.ns, enum_info.name, buf)
        return
    }
    // Prefer identity of interned types: class name (+ specialization name), wrappers, etc.
    if t.kind == TYPE.void {
        buf.write_string("void")
        return
    }
    if t.kind == TYPE.any {
        buf.write_string("any")
        if t.custom_name.length > 0 {
            buf.write_string(":")
            buf.write_string(t.custom_name)
        }
        return
    }
    if t.kind == TYPE.nullable {
        buf.write_string("?")
        let sub = t.get_sub_type()
        if isset(sub) : type_append_key(sub, buf)
        return
    }
    if t.kind == TYPE.ptr_of && !isset(t.class) {
        let sub = t.get_sub_type()
        if t.length == 0 {
            buf.write_string("*[")
            if isset(sub) : type_append_key(sub, buf)
            buf.write_string("]")
            return
        }
        if t.length == 1 {
            buf.write_string("*")
            if isset(sub) : type_append_key(sub, buf)
            return
        }
        buf.write_string("*[")
        if isset(sub) : type_append_key(sub, buf)
        buf.write_string("x")
        buf.write_uint_ascii(t.length)
        buf.write_string("]")
        return
    }
    if t.kind == TYPE.ref_of {
        let sub = t.get_sub_type()
        if t.length == 1 {
            buf.write_string("&")
            if isset(sub) : type_append_key(sub, buf)
            return
        }
        buf.write_string("&[")
        if isset(sub) : type_append_key(sub, buf)
        buf.write_string("x")
        buf.write_uint_ascii(t.length)
        buf.write_string("]")
        return
    }
    if (t.kind == TYPE.array || t.kind == TYPE.slice) && !isset(t.class) {
        buf.write_string(t.kind == TYPE.array ? "array[" : "slice[")
        let sub = t.get_sub_type()
        if isset(sub) : type_append_key(sub, buf)
        if t.length > 0 {
            buf.write_string("x")
            buf.write_uint_ascii(t.length)
        }
        buf.write_string("]")
        return
    }
    if t.kind == TYPE.fixed_array {
        buf.write_string("[")
        let sub = t.get_sub_type()
        if isset(sub) : type_append_key(sub, buf)
        buf.write_string("x")
        buf.write_uint_ascii(t.length)
        buf.write_string("]")
        return
    }
    if t.is_inline && isset(t.class) {
        buf.write_string("<>")
        let c = t.class
        if isset(c) : type_append_class_key(c, buf)
        return
    }
    if t.kind == TYPE.slice && t.is_inline {
        buf.write_string("[")
        let sub = t.get_sub_type()
        if isset(sub) : type_append_key(sub, buf)
        buf.write_string("x")
        buf.write_uint_ascii(t.length)
        buf.write_string("]")
        return
    }
    if t.kind == TYPE.struct && t.is_inline && !isset(t.class) {
        buf.write_string("(")
        let subs = t.get_members()
        if isset(subs) {
            each subs as st, i {
                if i > 0 : buf.write_string(",")
                type_append_key(st, buf)
            }
        }
        buf.write_string(")")
        return
    }
    if t.kind == TYPE.union {
        let union_class = t.class
        if isset(union_class) {
            buf.write_string("named-union:")
            type_append_class_key(union_class, buf)
            return
        }
        buf.write_string("union(")
        let subs = t.get_members()
        if isset(subs) {
            each subs as st, i {
                if i > 0 : buf.write_string("|")
                type_append_key(st, buf)
            }
        }
        buf.write_string(")")
        return
    }
    if t.kind == TYPE.closure || t.kind == TYPE.fnptr || t.kind == TYPE.co {
        buf.write_string("callable:")
        buf.write_uint_ascii(t.kind.@cast(u32).to(uint))
        buf.write_string("(")
        let info = t.get_function_info()
        if isset(info) {
            each info.args as arg, i {
                if i > 0 : buf.write_string(",")
                type_append_key(arg, buf)
            }
        }
        buf.write_string(")(")
        if isset(info) {
            each info.returns as rett, i {
                if i > 0 : buf.write_string(",")
                type_append_key(rett, buf)
            }
        }
        buf.write_string(")")
        let error_type = t.get_error_type()
        if isset(error_type) {
            buf.write_string("!")
            type_append_named_key(error_type.ns, error_type.name, buf)
        }
        return
    }
    let c = t.class
    if isset(c) {
        type_append_class_key(c, buf)
        if t.length > 0 {
            buf.write_string("[x")
            buf.write_uint_ascii(t.length)
            buf.write_string("]")
        }
        return
    }
    buf.write_string("#")
    buf.write_uint_ascii(t.kind.@cast(u32).to(uint))
    if t.custom_name.length > 0 {
        buf.write_string(":")
        buf.write_string(t.custom_name)
    }
}

// Build-wide GC allocator descriptors.
//
// The legacy compiler generated one Pool global per unique object layout and
// reparsed the function containing @INIT_ALLOCATORS whenever a new allocator
// was discovered. The rewrite parses every body, so it records initialization
// sites and fills them once the function-body queue has reached its fixed point.

use helper

class AllocatorCondition {
    offset: u32
    tag: uint
}

class AllocatorProp {
    offset: u32
    conditions: Array[AllocatorCondition] (.{})
}

class Allocator {
    build: Build
    global: Global
    size: u32
    class: Class
    props: Array[AllocatorProp] (.{})
    props_func: ?Func (null)
    onfree: ?Func (null)
    // Pool method an allocation site calls, picked here rather than by name
    // during IR generation.
    pool_get: Func
}

fn allocator_pool_size(b: Build, size: u32) u32 {
    let psz = b.options.target.ptr_size.to(u32)
    let until = 16 * psz
    if size <= until {
        let slots = size / psz
        if size % psz != 0 : slots++
        return slots * psz
    }
    let result = until * 2
    while result < size : result *= 2
    return result
}

fn allocator_copy_conditions(conditions: Array[AllocatorCondition]) Array[AllocatorCondition] {
    let copy = Array[AllocatorCondition]{}
    each conditions as condition : copy.append(condition)
    return copy
}

fn allocator_add_prop(offset: u32, conditions: Array[AllocatorCondition], out: Array[AllocatorProp]) {
    out.append(AllocatorProp {
        offset: offset
        conditions: allocator_copy_conditions(conditions)
    })
}

fn allocator_collect_props(
    type: Type,
    base_offset: u32,
    out: Array[AllocatorProp],
    conditions: Array[AllocatorCondition] (.{})
) !Error {
    if type.is_nullable_type() {
        let sub = type.sub_type
        if isset(sub) && !sub.is_pointer() && sub.type != TYPE.fn {
            // Tagged nullable values reserve one pointer-sized header for the
            // presence bit. This is also the layout emitted by ir_type(), so a
            // nested value has the same address in allocator and stack markers.
            allocator_collect_props(sub, base_offset + type.ptr_size(), out, conditions) !>
            return
        }
    }
    if type.get_non_nullable().type == TYPE.fn {
        allocator_add_prop(base_offset + type.build.options.target.ptr_size.to(u32), conditions, out)
        return
    }
    if type.is_gc_type() {
        allocator_add_prop(base_offset, conditions, out)
        return
    }
    let t = type.get_non_nullable()
    if t.type == TYPE.union {
        let layout = t.union_layout() !>
        if layout.has_gc {
            allocator_add_prop(base_offset + layout.gc_offset(), conditions, out)
        }
        let members = t.sub_types
        if isset(members) {
            each members as member, tag {
                if member.is_gc_type() || !member.has_gc_refs() : continue
                let active = allocator_copy_conditions(conditions)
                active.append(AllocatorCondition {
                    offset: base_offset
                    tag: tag
                })
                allocator_collect_props(
                    member,
                    base_offset + layout.other_offset,
                    out,
                    active
                ) !>
            }
        }
        return
    }
    if t.type == TYPE.inline {
        let sub = t.sub_type
        if !isset(sub) : return
        let class = sub.get_class_or_null()
        if isset(class) {
            class.compute_body_size() !>
            each class.props as prop {
                allocator_collect_props(prop.type, base_offset + prop.offset, out, conditions) !>
            }
        } else {
            allocator_collect_props(sub, base_offset, out, conditions) !>
        }
        return
    }
    if t.type == TYPE.multi {
        let subs = t.sub_types
        if !isset(subs) : return
        let offset: u32 = 0
        each subs as sub {
            offset = sub.ir_align_offset(offset) !>
            allocator_collect_props(sub, base_offset + offset, out, conditions) !>
            offset += sub.size() !>
        }
        return
    }
    if t.type != TYPE.array : return
    let sub = t.sub_type
    if !isset(sub) : return
    let stride = sub.size() !>
    let i: u32 = 0
    while i < t.array_size {
        allocator_collect_props(sub, base_offset + stride * i, out, conditions) !>
        i++
    }
}

// Create a pool for an arbitrary compiler-owned payload. Inline tagged unions
// do not use this path; they are copied directly as value aggregates.
// Pool global for a generated allocator. These belong to gc:Pool's unit and
// namespace, as in the legacy build.
fn allocator_pool_global(b: Build, name: String, at: Exp) Global !Error {
    let pool_idf = valk_idf(b, "gc", "Pool") !>
    let pool_class = pool_idf.class
    if !isset(pool_class) : at.bug("gc:Pool identifier is not a class")
    let g = Global {
        unit: pool_class.unit
        ns: pool_class.ns
        name: name
        act: ACT.private
        kind: GLOBAL_KIND.global
        scope: pool_class.scope
        exp: at
        type: pool_class.get_type() !>
    }
    pool_class.unit.globals.append(g)
    b.lists.globals.append(g)
    return g
}

fn allocator_for_type(ctx: Context, type: Type, at: Exp) Allocator !Error {
    let b = ctx.build
    let layout = type.get_non_nullable()
    let key = "payload:" + type_identity_key(layout)
    let cached = b.cache.allocators.get(key) !? null
    if isset(cached) : return cached

    let size = allocator_pool_size(b, layout.size() !>)
    if size == 0 : at.error("Unknown allocator size for type: " + layout.compat_display_name())

    // Reuse the legacy TaggedUnion class as a namespace owner for generated
    // Pool globals. Its property layout is not used here.
    let box_idf = valk_idf(b, "core", "TaggedUnion") !>
    let box_class = box_idf.class
    if !isset(box_class) : at.bug("core:TaggedUnion is not a class")
    let g = allocator_pool_global(b, "ALC_" + size + "__Payload__" + helper:ctxhash(key), at) !>

    let alc = Allocator {
        build: b
        global: g
        size: size
        class: box_class
        props_func: null
        onfree: null
    }
    allocator_collect_props(layout, 0, alc.props) !>
    b.cache.allocators.set(key, alc)
    b.lists.allocators.append(alc)
    return alc
}

fn allocator_for_class(ctx: Context, class: Class, at: Exp, shared: bool (false)) Allocator !Error {
    let b = ctx.build
    // Class names are only unique inside a namespace. Using the short name here
    // made e.g. json:Parser and template:Parser share one pool even though their
    // sizes and GC-property layouts differ.
    let key = (shared ? "shared:" : "local:") + class.ns.pkg.name + ":" + class.ns.name + ":" + class.name
    let cached = b.cache.allocators.get(key) !? null
    if isset(cached) : return cached

    let size = allocator_pool_size(b, class.compute_body_size() !>)
    if size == 0 : at.error("Unknown allocator size for type: " + class.pretty_name())

    let g = allocator_pool_global(b, "ALC_" + size + "__" + (shared ? "Shared__" : "") + class.name + "__" + helper:ctxhash(key), at) !>

    let pool_class = (g.get_type() !>).get_class_or_null() ?! at.bug("Generated allocator global is not a Pool")
    let onfree = class.get_func("gc_free")
    let get_name = isset(onfree) ? "get_vtable" : "get"
    let pool_get = pool_class.get_func(get_name) ?! at.bug("gc:Pool has no '" + get_name + "' method")
    if !pool_get.parsed_types : parse_func_types(pool_get) !>

    let alc = Allocator {
        build: b
        global: g
        size: size
        class: class
        props_func: class.get_func("_props")
        onfree: onfree
        pool_get: pool_get
    }
    each class.props as prop {
        allocator_collect_props(prop.type, prop.offset, alc.props) !>
    }
    b.cache.allocators.set(key, alc)
    b.lists.allocators.append(alc)
    return alc
}


use helper

class AllocatorCondition {
    offset: u32
    tag: uint
}

class AllocatorProp {
    offset: u32
    conditions: Array[AllocatorCondition] (.{})
    // Grove-MT: the owner word of a fat value (a string, slice or borrow); its data word follows
    fat: bool (false)
}

class Allocator {
    build: Build
    global: Global
    size: u32
    class: Class
    props: Array[AllocatorProp] (.{})
    onfree: ?Func (null)
    // Closure environments: the clone helper registered on the pool
    env_clone: ?Func (null)
    pool_get: Func
}

// The setup function of an allocator's pool: `Pool.setup` fills the pool in place (in TLS) from
// the kind's static descriptor
value ALLOCATOR_SETUP ("setup")

// Class instances take their exact size, at least one word
fn allocator_pool_size(b: Build, size: u32) u32 {
    let psz = b.options.target.ptr_size.to(u32)
    let words = (size + psz - 1) / psz
    return (words > 0 ? words : 1) * psz
}

fn allocator_copy_conditions(conditions: Array[AllocatorCondition]) Array[AllocatorCondition] {
    let copy = Array[AllocatorCondition]{}
    each conditions as condition : copy.append(condition)
    return copy
}

fn allocator_add_prop(offset: u32, conditions: Array[AllocatorCondition], out: Array[AllocatorProp], fat: bool (false)) {
    out.append(AllocatorProp {
        offset: offset
        conditions: allocator_copy_conditions(conditions)
        fat: fat
    })
}

fn allocator_collect_props(
    type: Type,
    base_offset: u32,
    out: Array[AllocatorProp],
    conditions: Array[AllocatorCondition] (.{})
) !Error {
    if type.is_nullable_type() {
        let sub = type.get_sub_type()
        if isset(sub) && !sub.is_pointer() && sub.kind != TYPE.closure && !sub.is_fat_borrow() {
            // The payload holds references only while the presence flag is set
            let present = allocator_copy_conditions(conditions)
            present.append(AllocatorCondition {
                offset: base_offset
                tag: 1
            })
            allocator_collect_props(sub, base_offset + type.ptr_size(), out, present) !>
            return
        }
    }
    if type.get_non_nullable().kind == TYPE.interface {
        allocator_add_prop(base_offset, conditions, out)
        return
    }
    if type.get_non_nullable().kind == TYPE.closure {
        allocator_add_prop(base_offset + type.build.options.target.ptr_size.to(u32), conditions, out)
        return
    }
    if type.is_gc_type() {
        allocator_add_prop(base_offset, conditions, out)
        return
    }
    let t = type.get_non_nullable()
    // Grove-MT: a publication copies a fat value's owner and moves its data word along
    let mt = type.build.grove_mt_mode()
    // A borrow keeps its managed owner in its first word.
    if t.is_fat_borrow() {
        allocator_add_prop(base_offset, conditions, out, mt)
        return
    }
    if t.kind == TYPE.union {
        let layout = t.union_layout() !>
        let members = t.get_members()
        if isset(members) {
            each members as member, tag {
                if !member.has_gc_refs() : continue
                let active = allocator_copy_conditions(conditions)
                active.append(AllocatorCondition {
                    offset: base_offset
                    tag: tag
                })
                allocator_collect_props(
                    member,
                    base_offset + layout.payload_offset,
                    out,
                    active
                ) !>
            }
        }
        return
    }
    if t.is_tuple_type() {
        let subs = t.get_members()
        if !isset(subs) : return
        let offset: u32 = 0
        each subs as sub {
            offset = sub.ir_align_offset(offset) !>
            allocator_collect_props(sub, base_offset + offset, out, conditions) !>
            offset += sub.byte_size() !>
        }
        return
    }
    if t.is_fixed_array_type() {
        let sub = t.get_sub_type()
        if !isset(sub) : return
        let stride = sub.byte_size() !>
        let i: u32 = 0
        while i < t.length {
            allocator_collect_props(sub, base_offset + stride * i, out, conditions) !>
            i++
        }
        return
    }
    let inline_class = t.class
    if t.is_inline && isset(inline_class) {
        inline_class.compute_body_size() !>
        if mt && inline_class.representation_class().kind == CLASS_KIND.slice {
            let owner = inline_class.get_prop_by_name("owner") !? null
            if isset(owner) {
                allocator_add_prop(base_offset + owner.offset, conditions, out, true)
                return
            }
        }
        each inline_class.props as prop {
            allocator_collect_props(prop.type, base_offset + prop.offset, out, conditions) !>
        }
    }
}

// The collector's description of where an allocation keeps managed
// pointers, as the words of a constant (see valk.gc.layout):
//   [kind, data offset, stride, N, G, N offsets, G groups]
// A group is [C, C x (tag offset, tag), M, M offsets]: its offsets hold
// managed pointers only while every tag byte has the given value (a union
// member that is active). Kind 0 is a single object, kind 1 a sequence of
// `stride`-byte elements whose count is the first word of the allocation.
fn allocator_layout_words(props: Array[AllocatorProp], kind: uint, data_offset: uint, stride: uint) Array[uint] {
    let plain = Array[uint]{}
    let group_keys = Array[String]{}
    let groups = Array[Array[uint]]{}
    each props as prop {
        // Offsets are word-aligned; bit 2 marks a fat value's owner word (Grove-MT)
        let word = prop.offset.to(uint) | (prop.fat ? 4 : 0)
        if prop.conditions.length == 0 {
            plain.append(word)
            continue
        }
        let key = ""
        each prop.conditions as condition : key += condition.offset + ":" + condition.tag + ","
        let index = group_keys.index_of(key) !? group_keys.length
        if index == group_keys.length {
            group_keys.append(key)
            let group = Array[uint]{}
            group.append(prop.conditions.length)
            each prop.conditions as condition {
                group.append(condition.offset.to(uint))
                group.append(condition.tag)
            }
            groups.append(group)
        }
        let group = groups.get(index) ! continue
        group.append(word)
    }
    let words = Array[uint]{ kind, data_offset, stride, plain.length, groups.length }
    each plain as offset : words.append(offset)
    each groups as group {
        let conditions = group.get(0) !? 0
        let header = 1 + conditions * 2
        // [C, conditions..., M, offsets...]
        let i: uint = 0
        while i < header {
            words.append(group.get(i) !? 0)
            i++
        }
        words.append(group.length - header)
        while i < group.length {
            words.append(group.get(i) !? 0)
            i++
        }
    }
    return words
}

fn allocator_pool_global(b: Build, name: String, at: Exp) Global !Error {
    let pool_idf = valk_idf(b, "gc", "Pool") !>
    let pool_class = pool_idf.class
    if !isset(pool_class) : at.bug("gc.Pool identifier is not a class")
    let pool_type = pool_class.get_type() !>
    // The pool itself lives in TLS, so the fast path reaches its cursor directly
    let type = pool_type.inline() !>
    let g = Global {
        unit: pool_class.unit
        ns: pool_class.ns
        name: name
        act: ACT.private
        kind: GLOBAL_KIND.global
        scope: pool_class.scope
        exp: at
        type: type
    }
    pool_class.unit.globals.append(g)
    b.lists.globals.append(g)
    return g
}

fn allocator_pool_get(g: Global, name: String, at: Exp) Func !Error {
    let pool_class = (g.get_type() !>).get_class_or_null() ?! at.bug("Generated allocator global is not a Pool")
    let pool_get = pool_class.get_func(name) ?! at.bug("gc.Pool has no '" + name + "' method")
    if !pool_get.parsed_types : parse_func_types(pool_get) !>
    return pool_get
}

fn allocator_for_class(ctx: Context, class: Class, at: Exp) Allocator !Error {
    let b = ctx.build
    let key = class.ns.pkg.identity() + ":" + class.ns.name + ":" + class.name
    let cached = b.cache.allocators.get(key) !? null
    if isset(cached) : return cached

    let size = allocator_pool_size(b, class.compute_body_size() !>)
    if size == 0 : at.error("Unknown allocator size for type: " + class.pretty_name())

    let g = allocator_pool_global(b, "ALC_" + size + "__" + class.name + "__" + helper.ctxhash(key), at) !>

    let onfree = class.get_func("gc_free")
    // The fast path takes the slot size as a constant
    let get_name = isset(onfree) ? "get_vtable_sized" : "get_sized"

    let alc = Allocator {
        build: b
        global: g
        size: size
        class: class
        onfree: onfree
        pool_get: allocator_pool_get(g, get_name, at) !>
    }
    each class.props as prop {
        allocator_collect_props(prop.type, prop.offset, alc.props) !>
    }
    // An array's elements live in `Slice[T]` storage that traces itself; the
    // array only holds the block through its `storage` property.
    b.cache.allocators.set(key, alc)
    b.lists.allocators.append(alc)
    return alc
}

// C-01: the reference words of a class kind in the order the layout table visits them, plain
// words first, then each union member's group (see allocator_layout_words)
fn allocator_visit_order(props: Array[AllocatorProp]) Array[AllocatorProp] {
    let order = Array[AllocatorProp]{}
    let keys = Array[String]{}
    let groups = Array[Array[AllocatorProp]]{}
    each props as prop {
        if prop.conditions.length == 0 {
            order.append(prop)
            continue
        }
        let key = ""
        each prop.conditions as condition : key += condition.offset + ":" + condition.tag + ","
        let index = keys.index_of(key) !? keys.length
        if index == keys.length {
            keys.append(key)
            groups.append(Array[AllocatorProp]{})
        }
        let group = groups.get(index) ! continue
        group.append(prop)
    }
    each groups as group {
        each group as prop : order.append(prop)
    }
    return order
}

// Grove's generated routines of a class kind (THEORY 5.4.5), by the runtime function each
// calls per non-null reference word: mark_T, the window's push, disown_T, the walk window's
// push and scan_T, which visits only the words inside [lo, hi)
fn allocator_routine_callees(b: Build) Array[Func] !Error {
    let names = Array[String]{ "mark_ref", "mark_push_ref", "walk_ref", "walk_push_ref", "update_props" }
    let funcs = Array[Func]{}
    each names as name {
        let func = (valk_idf(b, "gc", name) !>).func ?! b.bug("gc." + name + " is not a function")
        if !func.parsed_types : parse_func_types(func) !>
        funcs.append(func)
    }
    return funcs
}

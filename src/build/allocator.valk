// Build-wide GC allocator descriptors.
//
// The legacy compiler generated one Pool global per unique object layout and
// reparsed the function containing @INIT_ALLOCATORS whenever a new allocator
// was discovered. The rewrite parses every body, so it records initialization
// sites and fills them once the function-body queue has reached its fixed point.

class AllocatorProp {
    offset: u32
}

class Allocator {
    build: Build
    global: Global
    size: u32
    class: Class
    props: Array[AllocatorProp] (.{})
    onfree: ?Func (null)
}

fn allocator_pool_size(b: Build, size: u32) u32 {
    let psz = b.options.target.ptr_size.to(u32)
    let until = 16 * psz
    if size <= until {
        let slots = size / psz
        if size % psz != 0 : slots++
        return slots * psz
    }
    let result = until * 2
    while result < size : result *= 2
    return result
}

fn allocator_collect_props(type: Type, base_offset: u32, out: Array[AllocatorProp]) !Error {
    if type.is_gc_type() {
        out.append(AllocatorProp { offset: base_offset })
        return
    }
    let t = type.get_non_nullable()
    if t.type == TYPE.inline {
        let sub = t.sub_type
        if !isset(sub) : return
        let class = sub.get_class_or_null()
        if isset(class) {
            class.compute_body_size() !>
            each class.props as prop {
                allocator_collect_props(prop.type, base_offset + prop.offset, out) !>
            }
        } else {
            allocator_collect_props(sub, base_offset, out) !>
        }
        return
    }
    if t.type != TYPE.array : return
    let sub = t.sub_type
    if !isset(sub) : return
    let stride = sub.size() !>
    let i: u32 = 0
    while i < t.array_size {
        allocator_collect_props(sub, base_offset + stride * i, out) !>
        i++
    }
}

fn allocator_for_class(ctx: Context, class: Class, at: Exp) Allocator !Error {
    let b = ctx.build
    let cached = b.cache.allocators.get(class.name) !? null
    if isset(cached) : return cached

    let size = allocator_pool_size(b, class.compute_body_size() !>)
    if size == 0 : at.error("Unknown allocator size for type: " + class.pretty_name())

    let pool_idf = valk_idf(b, "gc", "Pool") !>
    let pool_class = pool_idf.class
    if !isset(pool_class) : at.bug("gc:Pool identifier is not a class")
    let pool_type = pool_class.get_type() !>

    // Generated globals belong to gc:Pool's unit/namespace, as in the legacy build.
    let name = "ALC_" + size + "__" + class.name
    let g = Global {
        unit: pool_class.unit
        ns: pool_class.ns
        name: name
        act: ACT.private
        kind: GLOBAL_KIND.global
        scope: pool_class.scope
        exp: at
        type: pool_type
    }
    pool_class.unit.globals.append(g)
    b.lists.globals.append(g)

    let alc = Allocator {
        build: b
        global: g
        size: size
        class: class
        onfree: class.get_func("gc_free")
    }
    each class.props as prop {
        allocator_collect_props(prop.type, prop.offset, alc.props) !>
    }
    b.cache.allocators.set(class.name, alc)
    b.lists.allocators.append(alc)
    return alc
}

// Populate every @INIT_ALLOCATORS site after all allocation sites are known.
fn finalize_allocator_init_sites(b: Build) !Error {
    if b.lists.allocator_init_sites.length == 0 : return

    let pool_idf = valk_idf(b, "gc", "Pool") !>
    let pool_class = pool_idf.class
    if !isset(pool_class) : b.bug("gc:Pool identifier is not a class")
    let init = pool_class.get_func("init")
    if !isset(init) : b.bug("gc:Pool.init is missing")
    if !init.parsed_types : parse_func_types(init) !>

    each b.lists.allocator_init_sites as site {
        let values = Array[Value]{}
        each b.lists.allocators as alc {
            let args = Array[Value]{}
            let size_type = (init.args.get(0) ! site.exp.bug("Pool.init is missing size argument")).type
            args.append(vgen_int(alc.size.to(int), size_type))

            let props_type = (init.args.get(1) ! site.exp.bug("Pool.init is missing props argument")).type
            if alc.props.length > 0 {
                args.append(vgen_allocator_props(alc, props_type, site.exp))
            } else {
                args.append(vgen_null(props_type))
            }

            let onfree_type = (init.args.get(2) ! site.exp.bug("Pool.init is missing onfree argument")).type
            let onfree = alc.onfree
            if isset(onfree) {
                args.append(value_try_convert(vgen_func(onfree), site.scope, site.ctx, onfree_type))
            } else {
                args.append(vgen_null(onfree_type))
            }

            let call = vgen_call(vgen_func(init), args, init.get_rett())
            call.exp = site.exp
            values.append(vgen_assign(vgen_global(alc.global) !>, call, ASSIGN_OP.set, b, site.exp))
        }
        site.value.values = values
    }
}

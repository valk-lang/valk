// Documentation comments: a `///` block directly above a declaration is its
// markdown documentation. The text is read from the source on demand, so
// ordinary builds never copy it.

fn doc_span(exp: ?Exp) ?String {
    let at = exp ?! return null
    return at.src.doc_comment(at.i)
}

// Specializations share the documentation of the declaration they come from.
fn func_doc(func: Func) ?String {
    let f = func
    while true {
        let base = f.generic_from
        if !isset(base) : break
        f = base
    }
    return doc_span(f.exp)
}

// The sentence of a `///` block that starts with "Deprecated", for warnings and hovers
fn deprecation_note(func: Func) ?String {
    let doc = func_doc(func) ?! return null
    let start = doc.index_of("Deprecated") ! return null
    let rest = doc.range(start, doc.bytes - start)
    let end = rest.index_of("\n\n") !? rest.bytes
    let note = rest.range(0, end).replace("\n", " ")
    // "Deprecated: use x." -> "use x."; only the first sentence is quoted
    note = note.range("Deprecated".bytes, note.bytes - "Deprecated".bytes).trim(":").trim(" ")
    let sentence = note.index_of(". ") ! return note
    return note.range(0, sentence + 1)
}

fn class_doc(class: Class) ?String {
    let c = class
    while true {
        let base = c.generic_from
        if !isset(base) : break
        c = base
    }
    return doc_span(c.exp)
}

// A compiler-made property documents itself; a declared one reads its `///` block
fn prop_doc(prop: Prop) ?String {
    let builtin = prop.builtin_doc
    if isset(builtin) : return builtin
    if prop.exp == prop.class.exp : return null
    return doc_span(prop.exp)
}

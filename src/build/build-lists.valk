// Build-wide collections of compiler objects collected during parsing.
class BuildLists {
    // Compilation units in source discovery order; used to assemble module IR.
    units: Array[Unit] (.{})
    // Every namespace created during the build, across all packages. --watch
    // scans these directories for source files that appeared since the build.
    namespaces: Array[Namespace] (.{})
    // `$global` aliases (name → namespace that declared it). Those bind on
    // Build.scope and reuse the target's Idf (or a bare Type), so the binding
    // itself cannot say where it was written; --docs needs that to place it.
    // Names are unique here, since Build.scope rejects duplicates.
    global_alias_ns: Map[Namespace] (.{})
    uses: Array[Use] (.{})
    links: Array[Link] (.{})
    // Free-function `$to` / `$auto` conversion hooks (class hooks live on Class).
    to_hooks: Array[Func] (.{})
    // All globals in declaration discovery order. Compile-time `#loop globals`
    // iterates this list after parse_global_types has resolved every type.
    globals: Array[Global] (.{})
    // Test functions in declaration discovery order. The generated executable
    // entry uses this for `#loop tests as test_func`.
    tests: Array[Func] (.{})
    // Concrete classes whose layouts must be finalized before function IR uses
    // property byte offsets.
    classes: Array[Class] (.{})
    // GC allocators discovered while resolving class construction.
    allocators: Array[Allocator] (.{})
    // Deferred @INIT_ALLOCATORS expansion sites.
    allocator_init_sites: Array[AllocatorInitSite] (.{})
}

class AllocatorInitSite {
    value: Value
    scope: Scope
    ctx: Context
    exp: Exp
}

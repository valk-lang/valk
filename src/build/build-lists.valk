// Build-wide collections of compiler objects collected during parsing.
class BuildLists {
    // Compilation units in source discovery order; used to assemble module IR.
    units: Array[Unit] (.{})
    uses: Array[Use] (.{})
    links: Array[Link] (.{})
    // Free-function `$to` / `$auto` conversion hooks (class hooks live on Class).
    to_hooks: Array[Func] (.{})
    // All globals in declaration discovery order. Compile-time `#loop globals`
    // iterates this list after parse_global_types has resolved every type.
    globals: Array[Global] (.{})
    // GC allocators discovered while resolving class construction.
    allocators: Array[Allocator] (.{})
    // Deferred @INIT_ALLOCATORS expansion sites.
    allocator_init_sites: Array[AllocatorInitSite] (.{})
}

class AllocatorInitSite {
    value: Value
    scope: Scope
    ctx: Context
    exp: Exp
}

extend ByteBuffer {
    + fn append_text(text: String) {
        @unsafe
        this.write_bytes(text.data, text.bytes)
    }

    + fn append_buffer(buffer: ByteBuffer) {
        @unsafe
        this.write_bytes(buffer.data, buffer.length)
    }

    + fn append_buffer_part(buffer: ByteBuffer, length: uint, offset: uint (0)) {
        @unsafe
        if length == 0 || offset > buffer.length : return
        let remaining = buffer.length - offset
        if length > remaining : length = remaining
        this.write_bytes(buffer.data.@offset(offset), length)
    }
}

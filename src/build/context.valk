// Evaluation context when converting EXP → Value.
// Carries contextual information that is not on Scope alone: owning function, suggested type, etc.
// Scope stays separate because nested blocks change scope while Context often stays the same
// (or only the suggested type changes).

class Context {
    build: Build
    // Set when parsing inside a function body (return/break/throw checks, use tracking).
    func: ?Func (null)
    // Expected / suggested type for the value currently being parsed.
    // Used for null typing, class-init fields, return/assign RHS, call args, etc.
    // Cleared (null) for sub-expressions that do not inherit the outer expectation.
    suggested_type: ?Type (null)
    // Set only while resolving the left side of a plain `name = value`, so an
    // identifier can tell a store from a read (see warn_unused_decls). Never
    // inherited: the copies below all clear it, which is what keeps `a[i] = v`
    // from reading as a store to `i`.
    is_store_target: bool (false)
    clone_at: ?Exp (null)
    clone_check_access: bool (true)

    static fn for_build(build: Build) SELF {
        return SELF {
            build: build
        }
    }

    // Compile-time expression evaluation still needs the function attached to
    // its lexical scope: typeof/#if/type sizes may reference local Decl values.
    static fn for_scope(build: Build, scope: Scope) SELF {
        let func = scope.func
        return SELF {
            build: build
            func: func
            clone_at: isset(func) ? func.clone_at : null
            clone_check_access: isset(func) ? func.clone_check_access : true
        }
    }

    static fn for_func(func: Func) SELF {
        return SELF {
            build: func.ns.build
            func: func
            clone_at: func.clone_at
            clone_check_access: func.clone_check_access
        }
    }

    // Shallow copy with a different suggested type (does not mutate self).
    // A Context is never written to after it is built, so a request for the
    // variant it already is hands back the same object instead of a copy.
    fn with_suggested_type(suggested_type: ?Type) SELF {
        if this.suggested_type == suggested_type && !this.is_store_target : return this
        return SELF {
            build: this.build
            func: this.func
            suggested_type: suggested_type
            clone_at: this.clone_at
            clone_check_access: this.clone_check_access
        }
    }

    fn without_suggested_type() SELF {
        if !isset(this.suggested_type) && !this.is_store_target : return this
        return SELF {
            build: this.build
            func: this.func
            suggested_type: null
            clone_at: this.clone_at
            clone_check_access: this.clone_check_access
        }
    }

    // For the destination of an assignment that only stores: the value there
    // before is not read, so an identifier resolved through this does not count
    // as a use of what it holds.
    fn for_store_target() SELF {
        if this.is_store_target && !isset(this.suggested_type) : return this
        return SELF {
            build: this.build
            func: this.func
            suggested_type: null
            is_store_target: true
            clone_at: this.clone_at
            clone_check_access: this.clone_check_access
        }
    }

    fn in_func() bool {
        return isset(this.func)
    }

    fn get_func() Func !Error {
        let f = this.func
        if !isset(f) : this.build.error("Missing function context")
        return f
    }
}

// Evaluation context when converting EXP → Value.
// Carries ambient info that is not on Scope alone: owning function, suggested type, etc.
// Scope stays separate because nested blocks change scope while Context often stays the same
// (or only the suggested type changes).

class Context {
    build: Build
    // Set when parsing inside a function body (return/break/throw checks, use tracking).
    func: ?Func (null)
    // Expected / suggested type for the value currently being parsed.
    // Used for null typing, class-init fields, return/assign RHS, call args, etc.
    // Cleared (null) for sub-expressions that do not inherit the outer expectation.
    type: ?Type (null)

    static fn for_build(build: Build) SELF {
        return SELF {
            build: build
        }
    }

    static fn for_func(func: Func) SELF {
        return SELF {
            build: func.ns.build
            func: func
        }
    }

    // Shallow copy with a different suggested type (does not mutate self).
    fn with_type(type: ?Type) SELF {
        return SELF {
            build: this.build
            func: this.func
            type: type
        }
    }

    fn without_type() SELF {
        return SELF {
            build: this.build
            func: this.func
            type: null
        }
    }

    fn in_func() bool {
        return isset(this.func)
    }

    fn get_func() Func !Error {
        let f = this.func
        if !isset(f) : this.build.error("Missing function context")
        return f
    }
}

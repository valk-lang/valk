
// Turn a top-level Exp into compiler objects (Func, Class, ...).
fn parse_base_exp(ns: Namespace, u: Unit, scope: Scope, exp: Exp) !Error {
    if exp.type == EXP.func {
        parse_func_exp(ns, u, scope, exp) !>
        return
    }
    if exp.type == EXP.class {
        parse_class_exp(ns, u, scope, exp) !>
        return
    }
    // EXP.comment / use / enum / test — later
}

// Scope for a top-level declaration: private stays unit-local; everything else is namespace-visible.
fn base_idf_scope(ns: Namespace, scope: Scope, act: ACT) Scope {
    return act == ACT.private ? scope : ns.scope
}

// Create a Func from EXP.func and register it on the unit + scope.
fn parse_func_exp(ns: Namespace, u: Unit, scope: Scope, exp: Exp) !Error {
    let name = exp.str1
    if name.length == 0 : exp.bug("Function is missing a name")

    let idf_scope = base_idf_scope(ns, scope, exp.act)
    if idf_scope.has_local(name) {
        exp.error("Name already used: " + name)
    }

    let f = Func {
        unit: u
        ns: ns
        name: name
        act: exp.act
        exp: exp
        generics: exp.get(FUNC_EXP.generics)
        args: exp.get(FUNC_EXP.args)
        rett: exp.get(FUNC_EXP.type)
        error: exp.get(FUNC_EXP.error)
        body: exp.get(FUNC_EXP.body)
        flags: exp.list
    }

    u.functions.append(f)
    idf_scope.set_idf(name, Idf.for_func(f))
    ns.build.pipeline.parse_func_asts.append(f)
    ns.build.pipeline.parse_func_types.append(f)
}

// Create a Class from EXP.class and register it on the unit + scope.
fn parse_class_exp(ns: Namespace, u: Unit, scope: Scope, exp: Exp) !Error {
    let name = exp.str1
    if name.length == 0 : exp.bug("Class is missing a name")

    let kind = exp.str2 ?? "class"

    let idf_scope = base_idf_scope(ns, scope, exp.act)
    if idf_scope.has_local(name) {
        exp.error("Name already used: " + name)
    }

    // bool1: integer → signed; struct → packed
    let signed = false
    let packed = false
    if kind == "integer" : signed = exp.bool1
    else if kind == "struct" : packed = exp.bool1

    let c = Class {
        unit: u
        ns: ns
        name: name
        act: exp.act
        kind: kind
        exp: exp
        generics: exp.get(CLASS_EXP.generics)
        body: exp.get(CLASS_EXP.body)
        flags: exp.list
        number_size: exp.number
        signed: signed
        packed: packed
        is_async: exp.bool2
    }

    u.classes.append(c)
    idf_scope.set_idf(name, Idf.for_class(c))
}

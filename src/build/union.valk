
// Tagged unions as generic Values.
//
// A union lowers to `{ i64 tag, [n x u8] payload }` (see
// ir_type_uncached), optionally carried inside a nullable's
// `{ i1 present, [n x u8] pad, … }` wrapper. Every operation below is assembled
// from aggregate, pointer and operator Values, so IR generation only ever sees
// extracts, loads and stores.

// Managed pointers carry ownership tag bits (see lib/src/gc/gc-data.valk),
// written in place by the collector. Mask them off before use.
fn vgen_clean_gc_pointer(on: Value, b: Build) Value {
    let int_t = type_i64(b)
    let raw = vgen_cast(on, int_t)
    let masked = vgen_op(raw, vgen_int(-4, int_t), VALUE_OP.bit_and, int_t)
    let clean = vgen_cast(masked, on.rett)
    raw.exp = on.exp
    masked.exp = on.exp
    clean.exp = on.exp
    return clean
}

// The union aggregate itself; a nullable union carries it in its value slot.
fn vgen_union_inner(on: Value) Value {
    if !on.rett.is_nullable_type() : return on
    return Value {
        type: VAL.wrap
        value1: on
        rett: on.rett.get_non_nullable()
        exp: on.exp
    }
}

// Pack `on` into union `type` as alternative `tag`.
fn vgen_union_wrap(on: Value, type: Type, tag: uint, ctx: Context) ?Value {
    let b = ctx.build
    let union = type.get_non_nullable()
    let layout = union.union_layout() ! return null
    let members = union.sub_types ?! return null
    let member = members.get(tag) ! return null
    let at = on.exp
    let int_t = type_i64(b)

    // A nullable source keeps its own presence; the payload is the bare value.
    let present: ?Value = null
    let payload = on
    if on.rett.is_nullable_type() {
        present = vgen_isset_val(on, type_bool(b))
        payload = vgen_union_inner(on)
    }
    if type_identity_key(payload.rett) != type_identity_key(member) {
        payload = vgen_cast(payload, member)
        payload.exp = at
    }
    let tag_v = vgen_int(tag.@cast(int), int_t)

    let func = ctx.func ?! return null
    let slot = vgen_scratch_value(func, union, at)
    let address = vgen_cast(slot, type_ptr(b))
    address.exp = at
    let payload_address = vgen_ptr_offset(address, vgen_int(layout.payload_offset.to(int), int_t), at)
    let body = Array[Value]{
        vgen_assign(slot, vgen_null(union), ASSIGN_OP.set, b, at)
        vgen_assign(vgen_ptrv(address, vgen_int(0, int_t), int_t, at), tag_v, ASSIGN_OP.set, b, at)
        vgen_assign(vgen_ptrv(payload_address, vgen_int(0, int_t), member, at), payload, ASSIGN_OP.set, b, at)
    }
    let packed = vgen_scoped_value(body, slot, at)

    if !type.is_nullable_type() : return packed
    let pad = vgen_undefined(type_byte_array(b, type.ptr_size() - 1), at)
    let flag = present ?? vgen_bool(true, type_bool(b))
    return vgen_multi(Array[Value]{ flag, pad, packed }, type, at)
}

// `on is <alternative tag>` — tag equality, and presence for a nullable union.
fn vgen_union_is(on: Value, tag: uint, at: ?Exp (null)) Value {
    let b = on.rett.build
    let bool_t = type_bool(b)
    let int_t = type_i64(b)
    let stored = vgen_multi_part(vgen_union_inner(on), 0, int_t, at)
    let matched = vgen_op(stored, vgen_int(tag.@cast(int), int_t), VALUE_OP.eq, bool_t)
    matched.exp = at
    if !on.rett.is_nullable_type() : return matched
    // Both sides are pure reads, so this stays a plain `and` rather than a branch.
    let both = vgen_op(vgen_isset_val(on, bool_t), matched, VALUE_OP.bit_and, bool_t)
    both.exp = at
    return both
}

// Read the active alternative out of `on`.
fn vgen_union_extract(on: Value, member: Type, ctx: Context, at: ?Exp (null)) Value !Error {
    let b = ctx.build
    let union = on.rett.get_non_nullable()
    let layout = union.union_layout() !>
    let inner = vgen_union_inner(on)
    let slot = vgen_scratch_value(ctx.get_func() !>, union, at)
    let body = Array[Value]{ vgen_assign(slot, inner, ASSIGN_OP.set, b, at) }
    let address = vgen_ptr_offset(vgen_cast(slot, type_ptr(b)), vgen_int(layout.payload_offset.to(int), type_i64(b)), at)
    let value = vgen_load(address, member, at)
    if member.is_gc_type() : value = vgen_clean_gc_pointer(value, b)
    return vgen_scoped_value(body, value, at)
}



fn vgen_clean_gc_pointer(on: Value, b: Build) Value {
    let int_t = type_i64(b)
    let raw = vgen_cast(on, int_t)
    let masked = vgen_op(raw, vgen_int(-4, int_t), VALUE_OP.bit_and, int_t)
    let clean = vgen_cast(masked, on.rett)
    raw.exp = on.exp
    masked.exp = on.exp
    clean.exp = on.exp
    return clean
}

// The union aggregate itself; a nullable union carries it in its value slot.
fn vgen_union_inner(on: Value) Value {
    if !on.rett.is_nullable_type() : return on
    return Value {
        type: VAL.wrap
        value1: on
        rett: on.rett.get_non_nullable()
        exp: on.exp
    }
}

// Pack `on` into union `type` as alternative `tag`.
fn vgen_union_wrap(on: Value, type: Type, tag: uint, ctx: Context) ?Value {
    let b = ctx.build
    let union = type.get_non_nullable()
    let layout = union.union_layout() ! return null
    let members = union.get_members() ?! return null
    let member = members.get(tag) ! return null
    let at = on.exp
    let int_t = type_i64(b)
    let tag_t = type_u8(b)

    // A nullable source keeps its own presence; the payload is the bare value.
    let present: ?Value = null
    let payload = on
    if on.rett.is_nullable_type() && !member.is_nullable_type() {
        present = vgen_isset_val(on, type_bool(b))
        payload = vgen_union_inner(on)
    }
    if !member.is_payloadless_alt() && type_identity_key(payload.rett) != type_identity_key(member) {
        payload = vgen_cast(payload, member)
        payload.exp = at
    }
    let tag_v = vgen_int(tag.@cast(int), tag_t)

    let func = ctx.func ?! return null
    let slot = vgen_scratch_value(func, union, at)
    let address = vgen_cast(slot, type_ptr(b))
    address.exp = at
    let payload_address = vgen_ptr_offset(address, vgen_int(layout.payload_offset.to(int), int_t), at)
    let body = Array[Value]{
        vgen_assign(slot, vgen_null(union), ASSIGN_OP.set, b, at)
        vgen_assign(vgen_ptrv(address, vgen_int(0, int_t), tag_t, at), tag_v, ASSIGN_OP.set, b, at)
    }
    // Payloadless alternatives (`null` or unit variants) store only their tag
    if !member.is_payloadless_alt() {
        body.append(vgen_assign(vgen_ptrv(payload_address, vgen_int(0, int_t), member, at), payload, ASSIGN_OP.set, b, at))
    }
    let packed = vgen_scoped_value(body, slot, at)
    packed.set_graph_source(on)

    if !type.is_nullable_type() : return packed
    let pad = vgen_undefined(type_byte_array(b, type.ptr_size() - 1), at)
    let flag = present ?? vgen_bool(true, type_bool(b))
    return vgen_multi(Array[Value]{ flag, pad, packed }, type, at)
}

// `on is <alternative tag>` — tag equality, and presence for a nullable union.
fn vgen_union_is(on: Value, tag: uint, at: ?Exp (null)) Value {
    let b = on.rett.build
    let bool_t = type_bool(b)
    let tag_t = type_u8(b)
    let stored = vgen_multi_part(vgen_union_inner(on), 0, tag_t, at)
    let matched = vgen_op(stored, vgen_int(tag.@cast(int), tag_t), VALUE_OP.eq, bool_t)
    matched.exp = at
    if !on.rett.is_nullable_type() : return matched
    // Both sides are pure reads, so this stays a plain `and` rather than a branch.
    let both = vgen_op(vgen_isset_val(on, bool_t), matched, VALUE_OP.bit_and, bool_t)
    both.exp = at
    return both
}

// Read the active alternative out of `on`.
fn vgen_union_extract(on: Value, member: Type, ctx: Context, at: ?Exp (null)) Value !Error {
    let b = ctx.build
    let union = on.rett.get_non_nullable()
    let layout = union.union_layout() !>
    let inner = vgen_union_inner(on)
    let slot = vgen_scratch_value(ctx.get_func() !>, union, at)
    let body = Array[Value]{ vgen_assign(slot, inner, ASSIGN_OP.set, b, at) }
    let address = vgen_ptr_offset(vgen_cast(slot, type_ptr(b)), vgen_int(layout.payload_offset.to(int), type_i64(b)), at)
    let value = vgen_load(address, member, at)
    if member.is_gc_type() : value = vgen_clean_gc_pointer(value, b)
    return vgen_scoped_value(body, value, at)
}

fn value_from_union_variant_ref(c: Class, name: String, at: Exp, ctx: Context) ?Value !Error {
    if !c.is_named_union : return null
    let resolved_t = c.get_type() !>
    let variant = c.get_union_variant(name) ?! return null
    lsp_goto(at, variant.exp, name) !>
    if variant.payload_types.length == 0 {
        let wrapped = vgen_union_wrap(vgen_null(resolved_t), resolved_t, variant.tag, ctx)
        if !isset(wrapped) {
            if ctx.build.has_errors : throw .error
            at.bug("Failed to build unit union variant")
        }
        wrapped.exp = at
        return wrapped
    }
    let ctor = vgen_dot(vgen_type(resolved_t, ctx.build), name, resolved_t)
    ctor.bool_val = true
    ctor.exp = at
    return ctor
}

fn value_from_union_variant_call(callee: Value, args_exp: ?Exp, scope: Scope, ctx: Context, at: Exp) Value !Error {
    let on = callee.value1 ?! at.bug("Union variant constructor is missing its union type")
    let union_t = on.get_of_type() ?! at.bug("Union variant constructor is missing union of_type")
    let c = union_t.get_class_or_null() ?! at.bug("Named union is missing Class")
    let name = callee.get_name()
    let variant = c.get_union_variant(name) ?! at.error("Union '" + c.pretty_name() + "' has no variant named: '" + name + "'")
    let raw_args = Array[Exp]{}
    if isset(args_exp) {
        let i: uint = 0
        while true {
            let a = args_exp.get(i++)
            if !isset(a) : break
            raw_args.append(a)
        }
    }
    if raw_args.length != variant.payload_types.length {
        at.error("Variant '" + c.pretty_name() + "." + name + "' expects " + variant.payload_types.length + " argument(s), got " + raw_args.length)
    }
    let evaluated = Array[Value]{}
    each raw_args as aexp, i {
        let expected = variant.payload_types.get(i) ! at.bug("Missing union variant payload type")
        let v = value_from_exp(aexp, scope, ctx.with_suggested_type(expected)) !>
        v = value_try_convert(v, scope, ctx, expected) !>
        expected.compat_check(v.rett, aexp) !>
        evaluated.append(v)
    }
    let payload = evaluated.length == 1
        ? (evaluated.get(0) ! at.bug("Missing single variant payload"))
        : vgen_multi(evaluated, variant.payload_type, at)
    let wrapped = vgen_union_wrap(payload, union_t, variant.tag, ctx)
    if !isset(wrapped) {
        if ctx.build.has_errors : throw .error
        at.bug("Failed to pack union variant")
    }
    wrapped.exp = at
    return wrapped
}

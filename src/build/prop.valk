// Compiler-facing class property created from an EXP.prop expression.
// `name` is optional — some properties are nameless (filled in later).
class Prop {
    class: Class
    name: ?String (null)
    act: ACT
    // Original parse expression (source span / raw AST)
    exp: Exp
    // Sub-expressions from EXP.prop (still raw for later stages)
    type: ?Exp (null)     // EXP.type
    default: ?Exp (null)  // EXP.body `(...)` default value
    flags: ?Array[String] (null)
}

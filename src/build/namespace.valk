
use helper
use valk:fs

class Namespace {
    pkg: Pkg
    build: Build
    name: String
    dir: ?String (null)
    files_loaded: bool (false)
    scope: Scope

    // Load a single source file into the pipeline (no-op if already loaded).
    // `format` is set for CLI input files when building with --fmt.
    fn load_file(path: String, format: bool (false)) !Error {
        path = helper:resolve(path)
        if this.build.cache.loaded_files.contains(path) : return
        this.build.cache.loaded_files.append(path)

        let content = fs:read(path) ! this.build.error("Unable to read file: " + path)
        let unit = Unit.new(this.build.cache, path)

        this.build.pipeline.parse_base_asts.append(ParseBaseAst {
            src: Source {
                build: this.build
                content: content
                path: path
                format: format
            }
            unit: unit
            ns: this
        })
    }

    // Load every .valk file in this namespace directory (skips already-loaded paths).
    fn load_files() !Error {
        if this.files_loaded : return
        this.files_loaded = true

        let dir = this.dir
        if !isset(dir) : return

        let files = fs:files_in(dir)
        each files as file {
            if !file.ends_with(".valk") : continue
            this.load_file(file) !>
        }
    }
}

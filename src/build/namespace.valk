
use helper
use valk.fs

class Namespace {
    pkg: Pkg
    build: Build
    name: String
    dir: ?String (null)
    files_loaded: bool (false)
    scope: Scope

    fn load_file(path: String, format: bool (false)) !Error {
        path = helper.resolve(path)
        let loaded = this.build.cache.loaded_files.get(path) !? null
        if isset(loaded) {
            if format : this.build.format_sources.append(loaded, true)
            return
        }

        let content = lsp_file_content(this.build, path)
        if !isset(content) {
            content = fs.read(path) ! this.build.error("Unable to read file: " + path)
        }
        let unit = this.build.get_unit_for_path(path)

        let src = Source {
            build: this.build
            content: content
            path: path
            ns: this
            id: ++this.build.cache.source_count
        }
        let lines = src.line_count()
        this.build.stats.file_LOC += lines
        this.build.stats.parse_LOC += lines
        this.build.cache.loaded_files.set(path, src)
        lsp_register_source(src)
        if format : this.build.format_sources.append(src)

        this.build.pipeline.parse_base_asts.append(ParseBaseAst {
            src: src
            unit: unit
            ns: this
        })
    }

    // Load every .valk file in this namespace directory (skips already-loaded paths).
    fn load_files() !Error {
        if this.files_loaded : return
        this.files_loaded = true

        let dir = this.dir
        if !isset(dir) : return

        let files = (fs.files_in(dir) ! this.build.error("Failed to list namespace directory: " + dir)).sorted(fn(a: String, b: String) bool {
            return a < b
        })
        each files as file {
            if !file.ends_with(".valk") : continue
            this.load_file(file) !>
        }
    }
}


use helper
use valk:fs

class Namespace {
    pkg: Pkg
    build: Build
    name: String
    dir: ?String (null)
    files_loaded: bool (false)
    scope: Scope

    // Load a single source file into the pipeline (no-op if already loaded).
    // `format` is set for CLI input files when building with --fmt.
    fn load_file(path: String, format: bool (false)) !Error {
        path = helper:resolve(path)
        if this.build.cache.loaded_files.contains(path) : return
        this.build.cache.loaded_files.append(path)

        // An editor buffer wins over the file on disk: with the LSP the user's
        // unsaved edits are the version the diagnostics must describe.
        let content = lsp_file_content(this.build, path)
        if !isset(content) {
            content = fs:read(path) ! this.build.error("Unable to read file: " + path)
        }
        let unit = this.build.get_unit_for_path(path)

        let src = Source {
            build: this.build
            content: content
            path: path
            ns: this
            id: ++this.build.cache.source_count
        }
        lsp_register_source(src)
        if format : this.build.format_sources.append(src)

        this.build.pipeline.parse_base_asts.append(ParseBaseAst {
            src: src
            unit: unit
            ns: this
        })
    }

    // Load every .valk file in this namespace directory (skips already-loaded paths).
    fn load_files() !Error {
        if this.files_loaded : return
        this.files_loaded = true

        let dir = this.dir
        if !isset(dir) : return

        // readdir/FindFirstFile do not promise a stable order. The order in
        // which files enter the pipeline also determines declaration and test
        // order, so normalize it for reproducible builds on every platform.
        let files = fs:files_in(dir).sort()
        each files as file {
            if !file.ends_with(".valk") : continue
            this.load_file(file) !>
        }
    }
}

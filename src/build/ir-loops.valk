struct IRLoopBound {
    var_decl: Decl
    bound_decl: ?Decl
    bound_const: uint
    inclusive: bool
}

struct IRLoopGuard {
    seq_decl: Decl
    bound_decl: ?Decl
    bound_const: uint
    inclusive: bool
}

struct IRLoopCounterGuard {
    seq_decl: Decl
    counter_decl: Decl
}

class IRLoopPlan {
    guards: Array[IRLoopGuard]
    bounds: Array[IRLoopBound]
    counter_guards: Array[IRLoopCounterGuard]
    skip_checks: Array[Value]
}

class IRLoopScan {
    ok: bool (true)
    has_continue: bool (false)
    nodes: uint (0)
    ptr_size: uint
    written: Array[Decl] (Array[Decl]{})
    modified: Array[Decl] (Array[Decl]{})
    accesses_seq: Array[Decl] (Array[Decl]{})
    accesses_idx: Array[Decl] (Array[Decl]{})
    accesses_check: Array[?Value] (Array[?Value]{})
    scratch_dst: Array[Decl] (Array[Decl]{})
    scratch_src: Array[Decl] (Array[Decl]{})
}

fn ir_loop_has_decl(list: Array[Decl], decl: Decl) bool {
    each list as item {
        if item == decl : return true
    }
    return false
}

fn ir_loop_unaliased(decl: Decl) bool {
    return !decl.is_bind && !decl.is_captured && !decl.mut_borrowed && !decl.address_taken
}

fn ir_loop_is_uint(type: Type, ptr_size: uint) bool {
    if type.is_nullable_type() || type.kind != TYPE.int || type.is_signed_type() : return false
    let size = type.byte_size() !? 0
    return size.to(uint) == ptr_size
}

fn ir_loop_unwrap(v: Value) Value {
    let cur = v
    while cur.type == VAL.cast || cur.type == VAL.wrap {
        let inner = cur.value1 ?! break
        cur = inner
    }
    return cur
}

fn ir_loop_resolve_scratch(scan: IRLoopScan, decl: Decl) Decl {
    let i = scan.scratch_dst.length
    while i > 0 {
        i--
        let dst = scan.scratch_dst.get(i) !? null
        if isset(dst) && dst == decl {
            return scan.scratch_src.get(i) !? decl
        }
    }
    return decl
}

fn ir_loop_can_guard_seq(type: Type) bool {
    if type.is_nullable_type() || type.is_shared || type.is_locked : return false
    if type.kind == TYPE.ref_slice : return true
    if type.kind == TYPE.array {
        let cls = type.get_class_or_null() ?! return false
        return isset(cls.get_prop_by_name("length") !? null)
    }
    return false
}

fn ir_loop_ref_slice_check_if(index: Value, owner_decl: Decl) ?Value {
    if index.type != VAL.decl : return null
    let checked_decl = index.decl ?! return null
    let pre = index.get_pre_value() ?! return null
    if pre.type != VAL.block : return null
    let stmts = pre.values ?! return null
    if stmts.length != 2 : return null
    let check_if = stmts[1]
    if check_if.type != VAL.if || isset(check_if.value2) : return null
    let cmp = check_if.value1 ?! return null
    if cmp.type != VAL.op || cmp.value_op != VALUE_OP.gte : return null
    let lhs = cmp.value1 ?! return null
    let rhs = cmp.value2 ?! return null
    if lhs.type != VAL.decl || lhs.decl != checked_decl : return null
    if rhs.type != VAL.multi || rhs.int_val != 2 : return null
    let rhs_on = rhs.value1 ?! return null
    if rhs_on.type != VAL.decl || rhs_on.decl != owner_decl : return null
    let then_body = check_if.values ?! return null
    if then_body.length != 1 : return null
    let call = then_body[0]
    if call.type != VAL.call : return null
    let callee = call.value1 ?! return null
    let cf = callee.type == VAL.func ? callee.func : null
    if !isset(cf) || !cf.must_exit : return null
    return check_if
}

fn ir_loop_truncate_decls(list: Array[Decl], target_len: uint) {
    while list.length > target_len {
        list.pop_last() _
    }
}

fn ir_loop_scan(scan: IRLoopScan, value: Value) {
    if !scan.ok : return
    scan.nodes++
    if scan.nodes > 200 || value.region_id != 0 {
        scan.ok = false
        return
    }
    let t = value.type
    if t == VAL.while || t == VAL.lock_block || t == VAL.co || t == VAL.await
        || t == VAL.vscope || t == VAL.return || t == VAL.throw || t == VAL.run_defers
        || t == VAL.allocas || t == VAL.init_allocators || t == VAL.class_init
        || t == VAL.array_init || t == VAL.shared_view || t == VAL.error_handler
        || t == VAL.func || t == VAL.atomic_op || t == VAL.atomic_store || t == VAL.atomic_cas
        || t == VAL.memcpy {
        scan.ok = false
        return
    }
    if t == VAL.continue : scan.has_continue = true
    let pre = value.get_pre_value()
    if isset(pre) : ir_loop_scan(scan, pre)
    if !scan.ok : return

    if t == VAL.op && !isset(value.value2) {
        let target = value.value1
        if isset(target) {
            ir_loop_scan(scan, target)
            if target.type == VAL.decl {
                let d = target.decl
                if isset(d) {
                    if !ir_loop_has_decl(scan.written, d) : scan.written.append(d)
                    if !ir_loop_has_decl(scan.modified, d) : scan.modified.append(d)
                }
            }
        }
        return
    }

    if t == VAL.if {
        let condv = value.value1
        if isset(condv) : ir_loop_scan(scan, condv)
        let base_len = scan.modified.length
        let then_body = value.values
        if isset(then_body) {
            each then_body as stmt : ir_loop_scan(scan, stmt)
        }
        let then_added = Array[Decl]{}
        each base_len .. scan.modified.length - base_len as i {
            let d = scan.modified.get(i) !? null
            if isset(d) : then_added.append(d)
        }
        ir_loop_truncate_decls(scan.modified, base_len)
        let elsev = value.value2
        if isset(elsev) : ir_loop_scan(scan, elsev)
        each then_added as d {
            if !ir_loop_has_decl(scan.modified, d) : scan.modified.append(d)
        }
        return
    }
    if t == VAL.this_or_that {
        let condv = value.value1
        if isset(condv) : ir_loop_scan(scan, condv)
        let base_len = scan.modified.length
        let thenv = value.value2
        if isset(thenv) : ir_loop_scan(scan, thenv)
        let then_added = Array[Decl]{}
        each base_len .. scan.modified.length - base_len as i {
            let d = scan.modified.get(i) !? null
            if isset(d) : then_added.append(d)
        }
        ir_loop_truncate_decls(scan.modified, base_len)
        let elsev = value.values
        if isset(elsev) {
            each elsev as stmt : ir_loop_scan(scan, stmt)
        }
        each then_added as d {
            if !ir_loop_has_decl(scan.modified, d) : scan.modified.append(d)
        }
        return
    }
    if t == VAL.assign {
        let left = value.value1
        let right = value.value2
        if isset(left) : ir_loop_scan(scan, left)
        if isset(right) : ir_loop_scan(scan, right)
        if isset(left) && left.type == VAL.decl {
            let dst = left.decl
            if isset(dst) {
                if !ir_loop_has_decl(scan.written, dst) : scan.written.append(dst)
                if !ir_loop_has_decl(scan.modified, dst) : scan.modified.append(dst)
                if value.assign_op == ASSIGN_OP.set && isset(right) {
                    let unwrapped = ir_loop_unwrap(right)
                    if unwrapped.type == VAL.decl && (ir_loop_is_uint(unwrapped.rett, scan.ptr_size) || ir_loop_can_guard_seq(unwrapped.rett)) {
                        let src = unwrapped.decl
                        if isset(src) && !src.is_bind {
                            scan.scratch_dst.append(dst)
                            scan.scratch_src.append(src)
                        }
                    }
                }
            }
        }
        return
    }
    if t == VAL.ptr_of {
        let target = value.value1
        if isset(target) {
            if target.type == VAL.decl {
                let d = target.decl
                if isset(d) {
                    if !ir_loop_has_decl(scan.written, d) : scan.written.append(d)
                    if !ir_loop_has_decl(scan.modified, d) : scan.modified.append(d)
                }
            }
            ir_loop_scan(scan, target)
        }
        return
    }
    if t == VAL.ptrv {
        let base = value.value1
        let index = value.value2
        if isset(base) : ir_loop_scan(scan, base)
        if isset(index) : ir_loop_scan(scan, index)
        if !scan.ok || !isset(base) || !isset(index) : return
        let base_u = ir_loop_unwrap(base)
        if base_u.type == VAL.multi || base_u.type == VAL.prop {
            let owner = base_u.value1
            if isset(owner) {
                let owner_u = ir_loop_unwrap(owner)
                let raw_seq = owner_u.type == VAL.decl ? owner_u.decl : null
                if isset(raw_seq) {
                    let seq = ir_loop_resolve_scratch(scan, raw_seq)
                    if !seq.is_bind && seq.type.kind == TYPE.ref_slice && !seq.type.is_nullable_type() {
                        let idx_u = ir_loop_unwrap(index)
                        let idx = idx_u.type == VAL.decl ? idx_u.decl : null
                        if isset(idx) {
                            let resolved = ir_loop_resolve_scratch(scan, idx)
                            if !resolved.is_bind {
                                let check_if: ?Value = null
                                if ir_loop_unaliased(seq) && ir_loop_unaliased(resolved)
                                    && ir_loop_is_uint(resolved.type, scan.ptr_size)
                                    && !ir_loop_has_decl(scan.modified, resolved) {
                                    check_if = ir_loop_ref_slice_check_if(index, raw_seq)
                                }
                                scan.accesses_seq.append(seq)
                                scan.accesses_idx.append(resolved)
                                scan.accesses_check.append(check_if)
                            }
                        }
                    }
                }
            }
        }
        return
    }
    if t == VAL.call {
        let callee = value.value1
        if !isset(callee) || callee.type != VAL.func || isset(callee.value1) {
            scan.ok = false
            return
        }
        let cf = callee.func
        if !isset(cf) {
            scan.ok = false
            return
        }
        let is_seq = cf.name.starts_with("<sequence.get.") || cf.name.starts_with("<sequence.set.")
        if !cf.must_exit && !is_seq {
            scan.ok = false
            return
        }
        let args = value.values
        if isset(args) {
            each args as arg : ir_loop_scan(scan, arg)
            if scan.ok && is_seq && args.length >= 2 {
                let a0 = ir_loop_unwrap(args[0])
                let a1 = ir_loop_unwrap(args[1])
                let seq = a0.type == VAL.decl ? a0.decl : null
                let idx = a1.type == VAL.decl ? a1.decl : null
                if isset(seq) && isset(idx) {
                    seq = ir_loop_resolve_scratch(scan, seq)
                    let resolved = ir_loop_resolve_scratch(scan, idx)
                    if !seq.is_bind && !resolved.is_bind && ir_loop_can_guard_seq(seq.type) {
                        scan.accesses_seq.append(seq)
                        scan.accesses_idx.append(resolved)
                        scan.accesses_check.append(null)
                    }
                }
            }
        }
        return
    }
    let v1 = value.value1
    if isset(v1) : ir_loop_scan(scan, v1)
    let v2 = value.value2
    if isset(v2) : ir_loop_scan(scan, v2)
    let list = value.values
    if isset(list) {
        each list as item : ir_loop_scan(scan, item)
    }
}

fn ir_loop_extract_bounds(cond: Value, scan: IRLoopScan, bounds: Array[IRLoopBound]) {
    if cond.type != VAL.op : return
    let op = cond.value_op
    let lhs = cond.value1
    let rhs = cond.value2
    if !isset(lhs) || !isset(rhs) : return
    if op == VALUE_OP.and {
        ir_loop_extract_bounds(lhs, scan, bounds)
        ir_loop_extract_bounds(rhs, scan, bounds)
        return
    }
    let low = lhs
    let high = rhs
    let inclusive = false
    if op == VALUE_OP.lte {
        inclusive = true
    } else if op == VALUE_OP.lt {
        inclusive = false
    } else if op == VALUE_OP.gte {
        low = rhs
        high = lhs
        inclusive = true
    } else if op == VALUE_OP.gt {
        low = rhs
        high = lhs
        inclusive = false
    } else {
        return
    }
    if !ir_loop_is_uint(low.rett, scan.ptr_size) || !ir_loop_is_uint(high.rett, scan.ptr_size) : return
    if low.type != VAL.decl : return
    let var_decl = low.decl ?! return
    if var_decl.is_bind : return
    if high.type == VAL.decl {
        let b_decl = high.decl ?! return
        if b_decl.is_bind || b_decl == var_decl || ir_loop_has_decl(scan.written, b_decl) : return
        bounds.append(IRLoopBound { var_decl: var_decl, bound_decl: b_decl, bound_const: 0, inclusive: inclusive })
    } else if high.type == VAL.int && high.int_val >= 0 {
        bounds.append(IRLoopBound { var_decl: var_decl, bound_decl: null, bound_const: high.int_val.to(uint), inclusive: inclusive })
    }
}

fn ir_loop_is_plus_one(stmt: Value, decl: Decl) bool {
    if stmt.type == VAL.op && !isset(stmt.value2) && stmt.value_op == VALUE_OP.add {
        let on = stmt.value1 ?! return false
        return on.type == VAL.decl && on.decl == decl
    }
    if stmt.type == VAL.assign {
        let left = stmt.value1 ?! return false
        let right = stmt.value2 ?! return false
        if left.type != VAL.decl || left.decl != decl : return false
        if stmt.assign_op == ASSIGN_OP.add {
            return right.type == VAL.int && right.int_val == 1
        }
        if stmt.assign_op == ASSIGN_OP.set && right.type == VAL.op && right.value_op == VALUE_OP.add {
            let a = right.value1 ?! return false
            let b = right.value2 ?! return false
            if a.type == VAL.decl && a.decl == decl && b.type == VAL.int && b.int_val == 1 : return true
            if b.type == VAL.decl && b.decl == decl && a.type == VAL.int && a.int_val == 1 : return true
        }
    }
    return false
}

fn ir_loop_expr_writes_tracked(v: Value, bounds: Array[IRLoopBound], counter: Decl) bool {
    return v.any_node(fn(node: Value) bool {
        let t = node.type
        if t == VAL.assign || (t == VAL.op && !isset(node.rhs)) || t == VAL.ptr_of {
            let target = node.lhs
            if isset(target) && target.type == VAL.decl {
                let d = target.decl
                if isset(d) {
                    if d == counter : return true
                    each bounds as b {
                        if b.var_decl == d : return true
                    }
                }
            }
        }
        return false
    })
}

// Verifies that every path through `stmts` increments at least one bounded var by +1
// (never modifying any bounded var otherwise) and increments `counter` by at most +1.
fn ir_loop_step_check(stmts: Array[Value], bounds: Array[IRLoopBound], counter: Decl) (bool, uint, uint) {
    let min_prog: uint = 0
    let max_k: uint = 0
    each stmts as stmt {
        let ok, sp, sk = ir_loop_step_stmt(stmt, bounds, counter)
        if !ok : return (false, 0, 0)
        min_prog += sp
        max_k += sk
        if max_k > 1 : return (false, 0, 0)
    }
    return (true, min_prog, max_k)
}

fn ir_loop_step_stmt(stmt: Value, bounds: Array[IRLoopBound], counter: Decl) (bool, uint, uint) {
    let pre = stmt.get_pre_value()
    if isset(pre) && ir_loop_expr_writes_tracked(pre, bounds, counter) : return (false, 0, 0)
    if ir_loop_is_plus_one(stmt, counter) : return (true, 0, 1)
    each bounds as b {
        if ir_loop_is_plus_one(stmt, b.var_decl) : return (true, 1, 0)
    }
    if stmt.type == VAL.block {
        let list = stmt.values
        if !isset(list) : return (true, 0, 0)
        return ir_loop_step_check(list, bounds, counter)
    }
    if stmt.type == VAL.if {
        let condv = stmt.value1
        if isset(condv) && ir_loop_expr_writes_tracked(condv, bounds, counter) : return (false, 0, 0)
        let then_list = stmt.values
        let t_ok = true
        let t_prog: uint = 0
        let t_k: uint = 0
        if isset(then_list) {
            let a, b, c = ir_loop_step_check(then_list, bounds, counter)
            t_ok = a
            t_prog = b
            t_k = c
        }
        if !t_ok : return (false, 0, 0)
        let elsev = stmt.value2
        let e_prog: uint = 0
        let e_k: uint = 0
        if isset(elsev) {
            let a, b, c = ir_loop_step_stmt(elsev, bounds, counter)
            if !a : return (false, 0, 0)
            e_prog = b
            e_k = c
        }
        let prog = t_prog < e_prog ? t_prog : e_prog
        let k_inc = t_k > e_k ? t_k : e_k
        return (true, prog, k_inc)
    }
    if ir_loop_expr_writes_tracked(stmt, bounds, counter) : return (false, 0, 0)
    return (true, 0, 0)
}

fn ir_collect_while_plan(ir: IRFunc, value: Value, condv: Value) ?IRLoopPlan {
    let ptr_size = ir.func.ns.build.options.target.ptr_size.to(uint)
    let scan = IRLoopScan { ptr_size: ptr_size }
    ir_loop_scan(scan, condv)
    let cond_writes = scan.written.length
    let body = value.values
    if isset(body) {
        each body as stmt : ir_loop_scan(scan, stmt)
    }
    if !scan.ok || scan.accesses_seq.length == 0 : return null

    let bounds = Array[IRLoopBound]{}
    ir_loop_extract_bounds(condv, scan, bounds)
    if bounds.length == 0 : return null

    let guards = Array[IRLoopGuard]{}
    let counter_guards = Array[IRLoopCounterGuard]{}
    let skip_checks = Array[Value]{}
    each scan.accesses_seq as seq, i {
        if ir_loop_has_decl(scan.written, seq) : continue
        let idx = scan.accesses_idx.get(i) !? null
        if !isset(idx) : continue
        let check_if = scan.accesses_check.get(i) !? null
        let matched_direct = false
        each bounds as b {
            if b.var_decl != idx : continue
            matched_direct = true
            let guard_idx: int = -1
            each guards as g, gi {
                if g.seq_decl == seq && g.bound_decl == b.bound_decl && g.bound_const == b.bound_const && g.inclusive == b.inclusive {
                    guard_idx = gi.to(int)
                    break
                }
            }
            if guard_idx < 0 {
                if guards.length >= 4 : continue
                guard_idx = guards.length.to(int)
                guards.append(IRLoopGuard { seq_decl: seq, bound_decl: b.bound_decl, bound_const: b.bound_const, inclusive: b.inclusive })
            }
            if isset(check_if) && cond_writes == 0 {
                let b_decl = b.bound_decl
                let bound_safe = !isset(b_decl) || ir_loop_unaliased(b_decl)
                if bound_safe : skip_checks.append(check_if)
            }
        }
        if !matched_direct && isset(check_if) && cond_writes == 0 && !scan.has_continue
            && isset(body) && bounds.length <= 2 {
            let bounds_safe = true
            each bounds as b {
                if !ir_loop_unaliased(b.var_decl) : bounds_safe = false
                let b_decl = b.bound_decl
                if isset(b_decl) && !ir_loop_unaliased(b_decl) : bounds_safe = false
            }
            if bounds_safe {
                let ok, min_prog, max_k = ir_loop_step_check(body, bounds, idx)
                if ok && min_prog >= 1 && max_k <= 1 {
                    let exists = false
                    each counter_guards as cg {
                        if cg.seq_decl == seq && cg.counter_decl == idx {
                            exists = true
                            break
                        }
                    }
                    if exists || counter_guards.length < 2 {
                        if !exists {
                            counter_guards.append(IRLoopCounterGuard { seq_decl: seq, counter_decl: idx })
                        }
                        skip_checks.append(check_if)
                    }
                }
            }
        }
    }
    if skip_checks.length == 0 : return null
    return IRLoopPlan { guards: guards, bounds: bounds, counter_guards: counter_guards, skip_checks: skip_checks }
}

fn ir_emit_while_core(ir: IRFunc, value: Value, region_loop: uint) !Error {
    let cond_block = ir.block("while.cond")
    let body_block = ir.block("while.body")
    let after_block = ir.block("while.after")
    let loop_facts = ir.regions
    if isset(loop_facts) && region_loop > 0 : ir.emit_region_patch(REGION_PATCH.loop_init, region_loop)
    ir.jump(cond_block)

    ir.label(cond_block)
    // A round starts: the regions of this loop hold nothing that is still used
    if isset(loop_facts) && region_loop > 0 : ir.emit_region_patch(REGION_PATCH.loop_reset, region_loop)
    let condv = value.value1
    if !isset(condv) : value.bug("IR while is missing its condition")
    ir.loops.append(IRLoop { cond: cond_block, after: after_block, locks: ir.active_locks.length, region_loop: region_loop })
    let cond = ir_emit_value(ir, condv) !>
    let cond_terminated = ir.terminated
    if !cond_terminated {
        ir.cond_jump(cond, body_block, after_block)
        ir.label(body_block)
        ir_emit_values(ir, value.values) !>
        ir.jump(cond_block)
    }
    ir.loops.pop_last() ! value.bug("IR loop stack is empty")

    ir.label(after_block)
    if isset(loop_facts) && region_loop > 0 && !cond_terminated : ir.emit_region_patch(REGION_PATCH.loop_exit, region_loop)
}

fn ir_emit_while(ir: IRFunc, value: Value) !Error {
    let loop_facts = ir.regions
    let region_loop = isset(loop_facts) ? loop_facts.number_of(value) : 0
    let condv = value.value1
    if !isset(condv) : value.bug("IR while is missing its condition")

    let opts = ir.func.ns.build.options
    if opts.optimize && !opts.debug {
        let plan = ir_collect_while_plan(ir, value, condv)
        if isset(plan) {
            let guards = plan.guards
            let counter_guards = plan.counter_guards
            let fast_entry = ir.block("while.fast")
            let slow_entry = ir.block("while.slow")
            let done_block = ir.block("while.done")
            let ptr_int_t = "i" + (opts.target.ptr_size.to(uint) * 8)

            each guards as g {
                let seq_len = ""
                if g.seq_decl.type.kind == TYPE.ref_slice {
                    let len_ptr = ir_field_address(ir, ir_type(g.seq_decl.type) !>, g.seq_decl.ir_name, 2)
                    seq_len = ir_emit_load(ir, ptr_int_t, len_ptr)
                } else {
                    let cls = g.seq_decl.type.get_class_or_null() ?! value.bug("Guarded sequence has no class")
                    let length_prop = cls.get_prop_by_name("length") ! value.bug("Guarded sequence has no length property")
                    let seq_ptr = ir_emit_load(ir, "ptr", g.seq_decl.ir_name)
                    let nonnull = ir_emit_binary_instruction(ir, "icmp ne", "ptr", seq_ptr, "null")
                    let check_len = ir.block("while.guard")
                    ir.cond_jump(nonnull, check_len, slow_entry)
                    ir.label(check_len)
                    let len_ptr = ir_prop_address(ir, seq_ptr, length_prop)
                    seq_len = ir_emit_load(ir, ptr_int_t, len_ptr)
                }
                let b_decl = g.bound_decl
                let bound_val = isset(b_decl) ? ir_emit_load(ir, ptr_int_t, b_decl.ir_name) : g.bound_const.to_string()
                let pred = g.inclusive ? "icmp ult" : "icmp ule"
                let ok = ir_emit_binary_instruction(ir, pred, ptr_int_t, bound_val, seq_len)
                let next_guard = ir.block("while.guard")
                ir.cond_jump(ok, next_guard, slow_entry)
                ir.label(next_guard)
            }

            if counter_guards.length > 0 {
                let slacks = Array[String]{}
                each plan.bounds as b {
                    let v_val = ir_emit_load(ir, ptr_int_t, b.var_decl.ir_name)
                    let b_decl = b.bound_decl
                    let b_val = isset(b_decl) ? ir_emit_load(ir, ptr_int_t, b_decl.ir_name) : b.bound_const.to_string()
                    let enters = ir_emit_binary_instruction(ir, b.inclusive ? "icmp ule" : "icmp ult", ptr_int_t, v_val, b_val)
                    let nb1 = ir.block("while.guard")
                    ir.cond_jump(enters, nb1, slow_entry)
                    ir.label(nb1)
                    let eff_bound = b_val
                    if b.inclusive {
                        let no_wrap = ir_emit_binary_instruction(ir, "icmp ne", ptr_int_t, b_val, "-1")
                        let nb2 = ir.block("while.guard")
                        ir.cond_jump(no_wrap, nb2, slow_entry)
                        ir.label(nb2)
                    } else {
                        eff_bound = ir_emit_binary_instruction(ir, "sub nuw", ptr_int_t, b_val, "1")
                    }
                    slacks.append(ir_emit_binary_instruction(ir, "sub nuw", ptr_int_t, eff_bound, v_val))
                }
                each counter_guards as cg {
                    let len_ptr = ir_field_address(ir, ir_type(cg.seq_decl.type) !>, cg.seq_decl.ir_name, 2)
                    let seq_len = ir_emit_load(ir, ptr_int_t, len_ptr)
                    let k_val = ir_emit_load(ir, ptr_int_t, cg.counter_decl.ir_name)
                    let k_in = ir_emit_binary_instruction(ir, "icmp ult", ptr_int_t, k_val, seq_len)
                    let nb1 = ir.block("while.guard")
                    ir.cond_jump(k_in, nb1, slow_entry)
                    ir.label(nb1)
                    let max_idx = ir_emit_binary_instruction(ir, "sub nuw", ptr_int_t, seq_len, "1")
                    let rem = ir_emit_binary_instruction(ir, "sub nuw", ptr_int_t, max_idx, k_val)
                    each slacks as s, si {
                        let fits = ir_emit_binary_instruction(ir, "icmp ule", ptr_int_t, s, rem)
                        let nb2 = ir.block("while.guard")
                        ir.cond_jump(fits, nb2, slow_entry)
                        ir.label(nb2)
                        if si + 1 < slacks.length {
                            rem = ir_emit_binary_instruction(ir, "sub nuw", ptr_int_t, rem, s)
                        }
                    }
                }
            }
            ir.jump(fast_entry)

            ir.label(fast_entry)
            let prev_skip = ir.skip_checks
            if plan.skip_checks.length > 0 : ir.skip_checks = plan.skip_checks
            ir_emit_while_core(ir, value, 0) !>
            ir.skip_checks = prev_skip
            let fast_reaches = !ir.terminated
            ir.jump(done_block)

            ir.label(slow_entry)
            ir_emit_while_core(ir, value, 0) !>
            let slow_reaches = !ir.terminated
            ir.jump(done_block)

            ir.label(done_block)
            if !fast_reaches && !slow_reaches {
                ir.line("unreachable")
                ir.terminated = true
            }
            return
        }
    }

    ir_emit_while_core(ir, value, region_loop) !>
}

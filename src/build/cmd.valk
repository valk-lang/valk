
use helper
use lsp

enum BUILDTYPE {
    exe
    lib
    doc
    ir
}

class BuildOptions {
    // Build mode / IO
    mode: int (BUILDTYPE.exe)
    target: Target
    verbose: int (0)
    inputs: Array[String] (.{})
    // Always absolute once set (see the `-o` handling below).
    path_out: ?String (null)
    // Set when the build serves an LSP request instead of producing output. The
    // language server needs the front end only, reads edited files from memory
    // rather than disk, and receives parser/type errors as diagnostics.
    lsp: ?lsp:Lsp (null)

    // Flags
    is_test: bool (false)
    is_clean_build: bool (false)
    is_static: bool (false)
    is_watch: bool (false)
    is_fmt: bool (false)
    // Put every source file in one LLVM module (--release / --ir). Cross-file
    // inlining becomes possible and --ir produces a single output file.
    single_unit: bool (false)
    // Compile textual IR to objects with the valkir package instead of LLVM.
    use_valkir: bool (false)
    no_warn: bool (false)
    optimize: bool (true)
    debug: bool (false)
    run_exe: bool (false)
    no_system_libs: bool (false)

    // Value args
    defs: Array[String] (.{})
    filter: ?String (null)
    link_dirs: Array[String] (.{})
    link_libs: Array[String] (.{})
    link_args: Array[String] (.{})
    link_args_append: Array[String] (.{})
    sysroot: ?String (null)
    run_args: Array[String] (.{})

    // Doc flags
    docs_markdown: bool (false)
    docs_no_private: bool (false)

    // --fmt, --docs and the LSP all stop after the front end: they need the
    // parsed declarations, never an LLVM module, object file or link step.
    fn front_end_only() bool {
        return this.is_fmt || this.mode == BUILDTYPE.doc || isset(this.lsp)
    }

    static fn init_from_args(args: Array[String]) BuildOptions !InitError {

        let valid_flags = Array[String]{
            "--help", "-h", "-o", "--target", "--def", "--test", "-t", "--filter", "--run", "-r", "--clean", "-c", "-v", "-vv", "-vvv", "-L", "-l", "--static", "--no-warn", "-nw", "--no-opt", "--docs", "--debug", "-d", "--watch", "-w", "--ir", "--valkir", "--release", "--link-arg", "--link-arg-append", "--sysroot", "--no-system-libs", "--fmt"
        }

        let is_docs = args.contains("--docs")
        if is_docs {
            valid_flags.append_many(Array[String]{ "--markdown", "--no-private" })
        }

        let has_value = Array[String]{ "-o", "--target", "--def", "-L", "-l", "--filter", "--link-arg", "--link-arg-append", "--sysroot" }
        let cli = helper:parse_cli_args(args, valid_flags, has_value)

        if cli.flags.contains("-h") || cli.flags.contains("--help") : help(0)

        if cli.invalid.length > 0 {
            init_error("Unknown build argument: " + cli.invalid.get(0) !? "?")
        }

        let target_str = cli.get_first_values_for("--target") !? null
        let target = get_target(target_str)

        let verbose = 0
        if cli.flags.contains("-v") : verbose = 1
        if cli.flags.contains("-vv") : verbose = 2
        if cli.flags.contains("-vvv") : verbose = 3

        let mode = BUILDTYPE.exe
        if is_docs : mode = BUILDTYPE.doc
        else if args.contains("--ir") : mode = BUILDTYPE.ir

        // Resolved here, not at link time: the object cache directory is keyed
        // on the output path, and `-o app` from two different directories must
        // not share one cache.
        let path_out : ?String = null
        cli.get_first_values_for("-o") -> o : path_out = helper:resolve(o)

        let filter : ?String = null
        cli.get_first_values_for("--filter") -> f : filter = f

        let sysroot : ?String = null
        cli.get_first_values_for("--sysroot") -> s : sysroot = s

        let b = BuildOptions {
            mode: mode
            target: target
            verbose: verbose
            inputs: cli.inputs
            path_out: path_out
            //
            is_test: cli.flags.contains("--test") || cli.flags.contains("-t")
            is_clean_build: cli.flags.contains("--clean") || cli.flags.contains("-c")
            is_static: cli.flags.contains("--static")
            is_watch: cli.flags.contains("--watch") || cli.flags.contains("-w")
            is_fmt: cli.flags.contains("--fmt")
            single_unit: mode == BUILDTYPE.ir || cli.flags.contains("--release")
            use_valkir: cli.flags.contains("--valkir")
            no_warn: cli.flags.contains("--no-warn") || cli.flags.contains("-nw")
            optimize: cli.flags.contains("--no-opt") ? false : true
            debug: cli.flags.contains("--debug") || cli.flags.contains("-d")
            run_exe: cli.flags.contains("--run") || cli.flags.contains("-r")
            no_system_libs: cli.flags.contains("--no-system-libs")
            //
            defs: cli.get_all("--def")
            filter: filter
            link_dirs: cli.get_all("-L")
            link_libs: cli.get_all("-l")
            link_args: cli.get_all("--link-arg")
            link_args_append: cli.get_all("--link-arg-append")
            sysroot: sysroot
            run_args: cli.run_args
            //
            docs_markdown: cli.flags.contains("--markdown")
            docs_no_private: cli.flags.contains("--no-private")
        }

        return b
    }
}

fn build_error(msg: String) $exit {
    println("# Build error")
    println("-----------------------------")
    println(msg)
    println("-----------------------------")
    exit(1)
}

fn help(exit_code: i32) $exit {
    print("\n")
    println("Usage: valk build {.valk-file(s) / directories} -o {outpath}");
    println("       valk build {.valk-file(s) / directories] --run");
    print("\n")

    println("Options:")
    print("\n")
    println("  -o                  Set outpath");
    println("  --run -r            Run program after compiling");
    println("  --watch -w          Watch files & rebuild when files change");
    println("  --test -t           Build tests");
    println("  --filter {name}     Only build tests whose name contains {name}");
    println("  --clean -c          Ignore cache");
    println("  --debug -d          Generate debug info");
    println("  --no-opt            Build without optimizations");
    println("  --no-warn -nw       Disable warning messages");
    println("  --release           Apply all optimizations");
    print("\n");

    println("  --def               Define compile condition variables");
    println("                      Format: VAR1=VAL,VAR2=VAL");
    println("  --target            Compile for a specific os/arch");
    println("                      linux-x64, macos-x64, macos-arm64, win-x64");
    println("  --sysroot           Custom sysroot for the linker");
    println("  --ir                Output LLVM IR");
    println("  --valkir            Compile IR to objects with valkir (no LLVM codegen)");
    print("\n");

    println("  -L {path}           Add link directory");
    println("  -l {name}           Add library to the link command");
    println("  --no-system-libs    Dont include default system library paths");
    println("                      (e.g. /usr/lib or C:/windows/system32)");
    println("  --link-arg          Pass an argument to the linker (before the objects)");
    println("  --link-arg-append   Pass an argument to the linker (after the objects)");
    print("\n");

    println("  --fmt               Format CLI input .valk files in place");
    println("  -v -vv -vvv         Show compile info");
    println("  --help -h           Build command usage info");
    print("\n");

    exit(exit_code)
}

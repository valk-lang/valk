
enum TOK {
    none
    end
    word
    at_word
    char
    string
    sign
    int
    float
    hex
    octal
    flag
    comment
}

class Parser {
    build: Build
    pos: Pos
    word_ptr: ptr (null.@cast(ptr))
    word_len: uint (0)
    new_lines: uint (0)

    fn tok(allow_space: bool, allow_newline: bool, update: bool (true)) int !Error {
        let pos = this.pos
        // Backup
        let i = pos.i
        let line = pos.line
        let col = pos.col
        let word_start = i
        let new_lines: uint = 0
        //
        let t = TOK.end
        // Source content
        let len = pos.src.content.bytes
        let data = pos.src.content.data

        while true {
            // Detect end of file
            if pos.i >= len {
                t = TOK.end
                break
            }

            // Get byte
            let ch = @ptrv(data, u8, pos.i++)
            pos.col++

            // Invalid
            if ch > 126 {
                this.error("Parse error, unsupported character/byte: " + ch)
            }

            // Ignore chars
            if ch < 33 {
                if ch == ' ' || ch == '\r' || ch == '\t' {
                    if !allow_space {
                        pos.i--
                        pos.col--
                        t = TOK.none
                        break
                    }
                    continue
                }
                if ch == '\n' {
                    if !allow_space || !allow_newline {
                        pos.i--
                        pos.col--
                        t = TOK.none
                        break
                    }
                    new_lines++
                    pos.line++
                    pos.col = 1
                    continue
                }
                this.error("Parse error, unsupported character/byte: " + ch)
            }

            // Token starts here (first non-whitespace char already consumed)
            word_start = pos.i - 1

            // Comment (ends before the trailing newline)
            if ch == '/' && @ptrv(data, u8, pos.i) == '/' {
                pos.i++
                pos.col++
                while pos.i < len {
                    if @ptrv(data, u8, pos.i) == '\n' : break
                    pos.i++
                    pos.col++
                }
                t = TOK.comment
                break
            }

            // Word
            if ch.is_alpha() || ch == '_' || ch == '@' || ch == '$' {
                this.skip_word()
                t = ch == '@' ? TOK.at_word : TOK.word
                t = ch == '$' ? TOK.flag : t
                break
            }

            // Number
            if ch.is_number() {
                t = this.skip_number()
                break
            }

            // String
            if ch == '\"' {
                this.skip_string()
                t = TOK.string
                break
            }

            // Char
            if ch == '\'' {
                ch = @ptrv(data, u8, pos.i++)
                pos.col++
                if ch == '\'' {
                    this.error("Missing character between single quotes")
                }
                if ch == '\\' {
                    ch = @ptrv(data, u8, pos.i++)
                    pos.col++
                    if ch == 'r' : ch = '\r'
                    else if ch == 'n' : ch = '\n'
                    else if ch == 't' : ch = '\t'
                    else if ch == 'b' : ch = '\b'
                    else if ch == 'f' : ch = '\f'
                    else if ch == 'v' : ch = '\v'
                    else if ch == 'a' : ch = '\a'
                    else if ch == 'e' : ch = 27
                }
                if ch == 0 {
                    this.error("Unexpected end of file")
                }
                t = TOK.char
                ch = @ptrv(data, u8, pos.i++)
                if ch != '\'' {
                    this.error("Missing single quote, found: '" + ch.to_ascii_string() + "'")
                }
                break
            }

            // Signs
            let next = @ptrv(data, u8, pos.i)
            if ch == '<' && (next == '{' || next == '<' || next == '=') {
                pos.i++
                pos.col++
            } else if ch == '>' && (next == '>' || next == '=') {
                pos.i++
                pos.col++
            } else if ch == '=' && (next == '=' || next == '>') {
                pos.i++
                pos.col++
            } else if ch == '!' && (next == '=' || next == '?' || next == '>' || next == '!') {
                pos.i++
                pos.col++
            } else if ch == '+' && (next == '=' || next == '+') {
                pos.i++
                pos.col++
            } else if ch == '-' && (next == '=' || next == '-' || next == '>') {
                pos.i++
                pos.col++
            } else if ch == '%' && (next == '=') {
                pos.i++
                pos.col++
            } else if ch == '*' && (next == '=') {
                pos.i++
                pos.col++
            } else if ch == '/' && (next == '=') {
                pos.i++
                pos.col++
            } else if ch == '^' && (next == '=') {
                pos.i++
                pos.col++
            } else if ch == '?' && (next == '?' || next == '!') {
                pos.i++
                pos.col++
            } else if ch == '&' && (next == '&' || next == '=') {
                pos.i++
                pos.col++
            } else if ch == '|' && (next == '|' || next == '=') {
                pos.i++
                pos.col++
            } else if ch == '.' && next == '.' && @ptrv(data, u8, pos.i + 1) == '.' {
                pos.i += 2
                pos.col += 2
            }

            // Sign
            t = TOK.sign
            break
        }

        this.word_ptr = data + word_start
        this.word_len = (t == TOK.none || t == TOK.end) ? 0 : (pos.i - word_start)
        this.new_lines = new_lines

        if !update {
            pos.i = i
            pos.line = line
            pos.col = col
        }

        return t
    }

    fn skip_word() {
        let pos = this.pos
        let len = pos.src.content.bytes
        let data = pos.src.content.data

        while pos.i < len {
            let ch = @ptrv(data, u8, pos.i++)
            pos.col++
            if !ch.is_alpha_numeric() && ch != '_' {
                pos.i--
                pos.col--
                break
            }
        }
    }

    fn skip_number() int {
        let pos = this.pos
        let len = pos.src.content.bytes
        let data = pos.src.content.data
        let first = true
        let t = TOK.int
        let prev_ch = @ptrv(data, u8, pos.i - 1)

        while pos.i < len {
            let ch = @ptrv(data, u8, pos.i++)
            pos.col++
            if first && prev_ch == '0' {
                first = false
                if ch == 'x' {
                    t = TOK.hex
                    continue
                }
                if ch == 'c' {
                    t = TOK.octal
                    continue
                }
            }
            if ch == '_' : continue
            if t == TOK.hex {
                if !ch.is_hex() {
                    pos.i--
                    pos.col--
                    break
                }
            } else if t == TOK.octal {
                if !ch.is_octal() {
                    pos.i--
                    pos.col--
                    break
                }
            } else if t == TOK.int {
                if ch == '.' && @ptrv(data, u8, pos.i).is_number() {
                    t = TOK.float
                    continue
                }
                if !ch.is_number() {
                    pos.i--
                    pos.col--
                    break
                }
            } else if t == TOK.float {
                if !ch.is_number() {
                    pos.i--
                    pos.col--
                    break
                }
            }
        }
        return t
    }

    fn skip_string() {
        let pos = this.pos
        let len = pos.src.content.bytes
        let data = pos.src.content.data

        while pos.i < len {
            let ch = @ptrv(data, u8, pos.i++)
            pos.col++
            if ch == '\n' {
                pos.line++
                continue
            }
            if ch == '\\' {
                pos.i++
                pos.col++
                continue
            }
            if ch == '"' {
                break
            }
        }
    }

    fn error(msg: String) !Error $throw {
        this.build.error(msg)
    }
}

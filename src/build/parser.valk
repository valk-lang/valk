use valk:mem

enum TOK {
    none
    end
    word
    at_word
    char
    string
    sign
    int
    float
    hex
    octal
    flag
    comment
}

class Parser {
    build: Build
    pos: Pos
    word_ptr: ptr (null.@cast(ptr))
    word_len: u32 (0)
    // Byte index of the current (last-scanned) token — valid after peek and consume.
    // Prefer this over `pos.i - word_len` (wrong after peek: pos is restored before the token).
    word_i: u32 (0)
    // Newlines skipped before the current token. Read by the formatter
    // (format-tokens.valk) to reproduce the file's line structure.
    new_lines: u32 (0)
    // Byte index just past the last token actually consumed, which is where a
    // construct ends. This is what Exp.set_end wants rather than `pos.i`: looking
    // for what comes next moves the parser over whitespace and comments, and a
    // multiline value expression consumes the comments it looks past
    // (value_peek_token), so `pos.i` can sit lines beyond the construct.
    token_end: u32 (0)
    fn create_exp(type: EXP) Exp {
        return Exp {
            type: type
            src: this.pos.src
            i: this.word_i
            len: this.word_len
        }
    }

    fn tok(allow_space: bool, allow_newline: bool, update: bool (true)) int !Error {
        let pos = this.pos
        // Backup
        let i = pos.i
        let line = pos.line
        let col = pos.col
        let word_start = i
        let new_lines: u32 = 0
        //
        let t = TOK.end
        // Source content
        let len = pos.src.content.bytes
        let data = pos.src.content.data

        while true {
            // Detect end of file
            if pos.i >= len {
                t = TOK.end
                break
            }

            // Get byte
            let ch = @ptrv(data, u8, pos.i++)
            pos.col++

            // Invalid
            if ch > 126 {
                this.error("Parse error, unsupported character/byte: " + ch)
            }

            // Ignore chars
            if ch < 33 {
                if ch == ' ' || ch == '\r' || ch == '\t' {
                    if !allow_space {
                        pos.i--
                        pos.col--
                        t = TOK.none
                        break
                    }
                    continue
                }
                if ch == '\n' {
                    if !allow_space || !allow_newline {
                        pos.i--
                        pos.col--
                        t = TOK.none
                        break
                    }
                    new_lines++
                    pos.line++
                    pos.col = 1
                    continue
                }
                this.error("Parse error, unsupported character/byte: " + ch)
            }

            // Token starts here (first non-whitespace char already consumed)
            word_start = pos.i - 1

            // Comment (ends before the trailing newline)
            if ch == '/' && @ptrv(data, u8, pos.i) == '/' {
                pos.i++
                pos.col++
                while pos.i < len {
                    if @ptrv(data, u8, pos.i) == '\n' : break
                    pos.i++
                    pos.col++
                }
                t = TOK.comment
                break
            }

            // Word
            if ch.is_alpha() || ch == '_' || ch == '@' || ch == '$' {
                this.skip_word()
                t = ch == '@' ? TOK.at_word : TOK.word
                t = ch == '$' ? TOK.flag : t
                break
            }

            // Number
            if ch.is_number() {
                t = this.skip_number()
                break
            }

            // String
            if ch == '\"' {
                this.skip_string()
                t = TOK.string
                break
            }

            // Char
            if ch == '\'' {
                ch = @ptrv(data, u8, pos.i++)
                pos.col++
                if ch == '\'' {
                    this.error("Missing character between single quotes")
                }
                if ch == '\\' {
                    ch = @ptrv(data, u8, pos.i++)
                    pos.col++
                    if ch == 'r' : ch = '\r'
                    else if ch == 'n' : ch = '\n'
                    else if ch == 't' : ch = '\t'
                    else if ch == 'b' : ch = '\b'
                    else if ch == 'f' : ch = '\f'
                    else if ch == 'v' : ch = '\v'
                    else if ch == 'a' : ch = '\a'
                    else if ch == 'e' : ch = 27
                }
                if ch == 0 {
                    this.error("Unexpected end of file")
                }
                t = TOK.char
                ch = @ptrv(data, u8, pos.i++)
                if ch != '\'' {
                    this.error("Missing single quote, found: '" + ch.to_ascii_string() + "'")
                }
                break
            }

            // Signs
            let next = @ptrv(data, u8, pos.i)
            if ch == '<' && (next == '{' || next == '<' || next == '=') {
                pos.i++
                pos.col++
            } else if ch == '>' && (next == '>' || next == '=') {
                pos.i++
                pos.col++
            } else if ch == '=' && (next == '=' || next == '>') {
                pos.i++
                pos.col++
            } else if ch == '!' && (next == '=' || next == '?' || next == '>' || next == '!') {
                pos.i++
                pos.col++
            } else if ch == '+' && (next == '=' || next == '+') {
                pos.i++
                pos.col++
            } else if ch == '-' && (next == '=' || next == '-' || next == '>') {
                pos.i++
                pos.col++
            } else if ch == '%' && (next == '=') {
                pos.i++
                pos.col++
            } else if ch == '*' && (next == '=') {
                pos.i++
                pos.col++
            } else if ch == '/' && (next == '=') {
                pos.i++
                pos.col++
            } else if ch == '^' && (next == '=') {
                pos.i++
                pos.col++
            } else if ch == '?' && (next == '?' || next == '!') {
                pos.i++
                pos.col++
            } else if ch == '&' && (next == '&' || next == '=') {
                pos.i++
                pos.col++
            } else if ch == '|' && (next == '|' || next == '=') {
                pos.i++
                pos.col++
            } else if ch == '.' && next == '.' {
                // Keep `..` together so the value parser stops before a tight
                // range (`items[1..3]`) instead of treating the first dot as
                // member access. A third dot stays on the same token for the
                // existing fixed-array repeat marker (`{ 0... }`).
                pos.i++
                pos.col++
                if @ptrv(data, u8, pos.i) == '.' {
                    pos.i++
                    pos.col++
                }
            }

            // Sign
            t = TOK.sign
            break
        }

        this.word_ptr = data + word_start
        this.word_len = (t == TOK.none || t == TOK.end) ? 0 : (pos.i - word_start)
        this.word_i = word_start.@cast(u32)
        this.new_lines = new_lines

        // A peek moves nothing, and a comment is not part of the construct being
        // parsed, so neither ends one.
        if update && t != TOK.comment && t != TOK.none && t != TOK.end {
            this.token_end = pos.i.@cast(u32)
        }

        if !update {
            pos.i = i
            pos.line = line
            pos.col = col
        }

        return t
    }

    fn skip_word() {
        let pos = this.pos
        let len = pos.src.content.bytes
        let data = pos.src.content.data

        while pos.i < len {
            let ch = @ptrv(data, u8, pos.i++)
            pos.col++
            if !ch.is_alpha_numeric() && ch != '_' {
                pos.i--
                pos.col--
                break
            }
        }
    }

    fn skip_number() int {
        let pos = this.pos
        let len = pos.src.content.bytes
        let data = pos.src.content.data
        let first = true
        let t = TOK.int
        let prev_ch = @ptrv(data, u8, pos.i - 1)

        while pos.i < len {
            let ch = @ptrv(data, u8, pos.i++)
            pos.col++
            if first && prev_ch == '0' {
                first = false
                if ch == 'x' {
                    t = TOK.hex
                    continue
                }
                if ch == 'c' {
                    t = TOK.octal
                    continue
                }
            }
            if ch == '_' : continue
            if t == TOK.hex {
                if !ch.is_hex() {
                    pos.i--
                    pos.col--
                    break
                }
            } else if t == TOK.octal {
                if !ch.is_octal() {
                    pos.i--
                    pos.col--
                    break
                }
            } else if t == TOK.int {
                if ch == '.' && @ptrv(data, u8, pos.i).is_number() {
                    t = TOK.float
                    continue
                }
                if !ch.is_number() {
                    pos.i--
                    pos.col--
                    break
                }
            } else if t == TOK.float {
                if !ch.is_number() {
                    pos.i--
                    pos.col--
                    break
                }
            }
        }
        return t
    }

    fn skip_string() {
        let pos = this.pos
        let len = pos.src.content.bytes
        let data = pos.src.content.data

        while pos.i < len {
            let ch = @ptrv(data, u8, pos.i++)
            pos.col++
            if ch == '\n' {
                pos.line++
                continue
            }
            if ch == '\\' {
                pos.i++
                pos.col++
                continue
            }
            if ch == '"' {
                break
            }
        }
    }

    fn word() String {
        return String.make_from_ptr(this.word_ptr, this.word_len)
    }

    fn word_is(word: String) bool {
        if this.word_len != word.bytes : return false
        return mem:equal(this.word_ptr, word.data, word.bytes)
    }

    fn read_word(allow_space: bool, allow_newline: bool) String !Error {
        let t = this.tok(allow_space, allow_newline) !>
        if t != TOK.word : this.error("Invalid identifier name: '" + this.word() + "' | Expected syntax: [a-zA-Z_]")
        return this.word()
    }

    fn expect(word: String, allow_space: bool, allow_newline: bool) !Error {
        this.tok(allow_space, allow_newline) !>
        if !this.word_is(word) {
            this.error("Expected token: '" + word + "', instead of: '" + this.word() + "'")
        }
    }

    fn next_word_is(word: String, allow_space: bool, allow_newline: bool, update: bool) bool !Error {
        // `tok(..., false)` restores the source position, but it still updates
        // the current-token metadata. Preserve that metadata unless this helper
        // actually consumes the matching next token.
        let prev_word_ptr = this.word_ptr
        let prev_word_len = this.word_len
        let prev_word_i = this.word_i
        let prev_new_lines = this.new_lines
        this.tok(allow_space, allow_newline, false) !>
        if this.word_is(word) {
            if update {
                this.tok(allow_space, allow_newline, true) !>
            } else {
                this.word_ptr = prev_word_ptr
                this.word_len = prev_word_len
                this.word_i = prev_word_i
                this.new_lines = prev_new_lines
            }
            return true
        }
        this.word_ptr = prev_word_ptr
        this.word_len = prev_word_len
        this.word_i = prev_word_i
        this.new_lines = prev_new_lines
        return false
    }

    // Read `name` or `namespace:name`.
    fn read_id(allow_space: bool, allow_newline: bool) Exp !Error {
        let name = this.read_word(allow_space, allow_newline) !>
        let exp = this.create_exp(EXP.id)
        exp.str1 = name

        let t = this.tok(false, false, false) !>
        if t == TOK.sign && this.word_is(":") {
            this.tok(false, false) !>
            // Store namespace name in str2
            exp.str2 = name
            // Read actual name
            exp.str1 = this.read_word(false, false) !>
        }

        exp.set_end(this.token_end)
        return exp
    }

    // Skip tokens until a matching closer. Current token should already be past the opener.
    // When matching `{`/`}`, the vscope opener `<{` also increases depth so its `}` is not
    // treated as the closer for an outer `{` (class/func/macro bodies).
    fn skip_balanced(open: String, close: String) !Error {
        let depth: uint = 1
        while depth > 0 {
            let t = this.tok(true, true) !>
            if t == TOK.end : this.error("Unexpected end of file, missing '" + close + "'")
            if t != TOK.sign : continue
            if this.word_is(open) {
                depth++
            } else if open == "{" && this.word_is("<{") {
                // Value-scope body opener includes `{`
                depth++
            } else if this.word_is(close) {
                depth--
            }
        }
    }

    // Report a parse error at the current token (word_i / word_len span).
    fn error(msg: String) !Error $throw {
        let b = this.build
        b.has_errors = true
        // Span covers the last token read (peek or consume); word_i is its start index.
        let i = this.word_i
        let len = this.word_len
        if len == 0 : i = this.pos.i
        b.messages.append(Message {
            type: MSG.error
            msg: msg
            src: this.pos.src
            i: i
            len: len
        })
        throw .error
    }
}

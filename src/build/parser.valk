use valk.mem

enum TOK {
    none
    end
    word
    at_word
    char
    string
    sign
    int
    float
    hex
    octal
    flag
    comment
}

// Deepest nesting of expressions, types and blocks the compiler accepts: every
// level recurses in the parser and again while lowering, on a bounded stack.
value MAX_NESTING (1000)

class Parser {
    build: Build
    pos: Pos
    word_ptr: ptr (@undefined)
    word_len: u32 (0)
    word_i: u32 (0)
    new_lines: u32 (0)
    token_end: u32 (0)

    peek_valid: bool (false)
    peek_start: u32 (0)
    peek_space: bool (false)
    peek_newline: bool (false)
    peek_tok: TOK (TOK.none)
    peek_word_ptr: ptr (@undefined)
    peek_word_len: u32 (0)
    peek_word_i: u32 (0)
    peek_new_lines: u32 (0)
    peek_end_i: u32 (0)
    peek_end_line: u32 (0)
    peek_end_col: u32 (0)
    fn create_exp(type: EXP) Exp {
        return Exp {
            type: type
            src: this.pos.src
            i: this.word_i
            len: this.word_len
        }
    }

    fn tok(allow_space: bool, allow_newline: bool, update: bool (true)) TOK !Error {
        let pos = this.pos
        if this.peek_valid
            && this.peek_start == pos.i
            && this.peek_space == allow_space
            && this.peek_newline == allow_newline {
            return this.take_peeked(pos, update)
        }
        // Backup
        let i = pos.i
        let line = pos.line
        let col = pos.col
        let word_start = i
        let new_lines: u32 = 0
        //
        let t = TOK.end
        // Source content
        let len = pos.src.content.bytes
        let data = pos.src.content.data
        // Cursor is kept in locals and written back to `pos` after the scan
        let ci = i
        let ccol = col
        let cline = line

        while true {
            // Detect end of file
            if ci >= len {
                t = TOK.end
                break
            }

            // Get byte
            let ch = @ptrv(data, u8, ci++)
            ccol++

            // Invalid
            if ch > 126 {
                pos.i = ci
                this.error("Parse error, unsupported character/byte: " + ch)
            }

            // Ignore chars
            if ch < 33 {
                if ch == ' ' || ch == '\r' || ch == '\t' {
                    if !allow_space {
                        ci--
                        ccol--
                        t = TOK.none
                        break
                    }
                    continue
                }
                if ch == '\n' {
                    if !allow_space || !allow_newline {
                        ci--
                        ccol--
                        t = TOK.none
                        break
                    }
                    new_lines++
                    cline++
                    ccol = 1
                    continue
                }
                pos.i = ci
                this.error("Parse error, unsupported character/byte: " + ch)
            }

            // Token starts here (first non-whitespace char already consumed)
            word_start = ci - 1

            // Comment (ends before the trailing newline)
            if ch == '/' && @ptrv(data, u8, ci) == '/' {
                ci++
                while ci < len {
                    if @ptrv(data, u8, ci) == '\n' : break
                    ci++
                }
                ccol += ci - word_start - 1
                t = TOK.comment
                break
            }

            // Word
            let next = @ptrv(data, u8, ci)
            if ch.is_alpha() || ch == '_' || ((ch == '@' || ch == '$') && (next.is_alpha() || next == '_')) {
                let end = skip_word(data, len, ci)
                ccol += end - ci
                ci = end
                t = ch == '@' ? TOK.at_word : TOK.word
                t = ch == '$' ? TOK.flag : t
                break
            }

            // Number
            if ch.is_number() {
                let end, kind = skip_number(data, len, ci)
                ccol += end - ci
                ci = end
                t = kind
                break
            }

            // String
            if ch == '\"' {
                pos.i = ci
                pos.col = ccol
                pos.line = cline
                // r"..." has no interpolation
                let raw = word_start > 0 && @ptrv(data, u8, word_start - 1) == 'r'
                    && (word_start == 1 || !is_word_byte(@ptrv(data, u8, word_start - 2)))
                this.skip_string(raw) !>
                ci = pos.i
                ccol = pos.col
                cline = pos.line
                t = TOK.string
                break
            }

            // Char
            if ch == '\'' {
                ch = @ptrv(data, u8, ci++)
                ccol++
                if ch == '\'' {
                    pos.i = ci
                    this.error("Missing character between single quotes")
                }
                if ch == '\\' {
                    ch = @ptrv(data, u8, ci++)
                    ccol++
                    if ch == 'r' : ch = '\r'
                    else if ch == 'n' : ch = '\n'
                    else if ch == 't' : ch = '\t'
                    else if ch == 'b' : ch = '\b'
                    else if ch == 'f' : ch = '\f'
                    else if ch == 'v' : ch = '\v'
                    else if ch == 'a' : ch = '\a'
                    else if ch == 'e' : ch = 27
                    else if ch != '0' && ch != '\\' && ch != '\'' && ch != '"' {
                        pos.i = ci
                        this.error("Unknown escape sequence '\\" + ch.to_ascii_string() + "' in character")
                    }
                }
                if ch == 0 {
                    pos.i = ci
                    this.error("Unexpected end of file")
                }
                t = TOK.char
                ch = @ptrv(data, u8, ci++)
                if ch != '\'' {
                    pos.i = ci
                    this.error("Missing single quote, found: '" + ch.to_ascii_string() + "'")
                }
                break
            }

            // Signs: two-byte operators
            let two = false
            if ch == '<' : two = next == '{' || next == '<' || next == '='
            else if ch == '>' : two = next == '>' || next == '='
            else if ch == '=' : two = next == '=' || next == '>'
            else if ch == '!' : two = next == '=' || next == '?' || next == '>' || next == '!'
            else if ch == '+' : two = next == '=' || next == '+'
            else if ch == '-' : two = next == '=' || next == '-' || next == '>'
            else if ch == '?' : two = next == '?' || next == '!'
            else if ch == '&' : two = next == '&' || next == '='
            else if ch == '|' : two = next == '|' || next == '='
            else if ch == '%' || ch == '*' || ch == '/' || ch == '^' : two = next == '='
            else if ch == '@' || ch == '$' : two = next == '['
            else if ch == '.' && next == '.' {
                two = true
                if @ptrv(data, u8, ci + 1) == '.' {
                    ci++
                    ccol++
                }
            }
            if two {
                ci++
                ccol++
            }

            // Sign
            t = TOK.sign
            break
        }

        pos.i = ci
        pos.col = ccol
        pos.line = cline

        this.word_ptr = data + word_start
        this.word_len = (t == TOK.none || t == TOK.end) ? 0 : (ci - word_start)
        this.word_i = word_start.@cast(u32)
        this.new_lines = new_lines

        if update {
            // A comment does not end the construct being parsed.
            if t != TOK.comment && t != TOK.none && t != TOK.end {
                this.token_end = ci.@cast(u32)
            }
            this.peek_valid = false
            return t
        }

        // Remember the scan, then put the position back.
        this.peek_valid = true
        this.peek_start = i.@cast(u32)
        this.peek_space = allow_space
        this.peek_newline = allow_newline
        this.peek_tok = t
        this.peek_word_ptr = this.word_ptr
        this.peek_word_len = this.word_len
        this.peek_word_i = this.word_i
        this.peek_new_lines = new_lines
        this.peek_end_i = ci.@cast(u32)
        this.peek_end_line = cline
        this.peek_end_col = ccol
        pos.i = i
        pos.line = line
        pos.col = col
        return t
    }

    // Replay the remembered scan; consuming it applies the position it reached.
    fn take_peeked(pos: Pos, update: bool) TOK {
        let t = this.peek_tok
        this.word_ptr = this.peek_word_ptr
        this.word_len = this.peek_word_len
        this.word_i = this.peek_word_i
        this.new_lines = this.peek_new_lines
        if !update : return t
        pos.i = this.peek_end_i
        pos.line = this.peek_end_line
        pos.col = this.peek_end_col
        if t != TOK.comment && t != TOK.none && t != TOK.end {
            this.token_end = this.peek_end_i
        }
        this.peek_valid = false
        return t
    }

    fn skip_string(raw: bool (false)) !Error {
        let pos = this.pos
        let len = pos.src.content.bytes
        let data = pos.src.content.data

        while pos.i < len {
            let ch = @ptrv(data, u8, pos.i++)
            pos.col++
            if ch == '\n' {
                pos.line++
                continue
            }
            if ch == '\\' {
                pos.i++
                pos.col++
                continue
            }
            if ch == '"' {
                break
            }
            if !raw && ch == '%' && pos.i < len && @ptrv(data, u8, pos.i) == '{' {
                pos.i++
                pos.col++
                this.skip_interpolation() !>
            }
        }
    }

    // Skips to the '}' that closes a `%{`, passing over nested strings and chars
    fn skip_interpolation() !Error {
        let pos = this.pos
        let len = pos.src.content.bytes
        let data = pos.src.content.data
        let depth: uint = 1
        let start = pos.i

        while pos.i < len {
            let ch = @ptrv(data, u8, pos.i++)
            pos.col++
            if ch == '\n' {
                pos.line++
            } else if ch == '"' {
                this.skip_string() !>
            } else if ch == '\'' {
                let skip: u32 = pos.i < len && @ptrv(data, u8, pos.i) == '\\' ? 3 : 2
                pos.i += skip
                pos.col += skip
            } else if ch == '{' {
                depth++
            } else if ch == '}' {
                if --depth == 0 : return
            }
        }
        pos.i = start
        this.word_i = (start - 2).@cast(u32)
        this.word_len = 2
        this.error("Missing '}' in string interpolation")
    }

    fn word() String {
        @unsafe
        return String.copy_from_ptr(this.word_ptr, this.word_len)
    }

    fn word_is(word: String) bool {
        @unsafe
        if this.word_len != word.bytes : return false
        if this.word_len == 0 : return true
        if this.word_len == 1 {
            return @ptrv(this.word_ptr, u8, 0) == @ptrv(word.data, u8, 0)
        }
        if this.word_len == 2 {
            return @ptrv(this.word_ptr, u8, 0) == @ptrv(word.data, u8, 0)
                && @ptrv(this.word_ptr, u8, 1) == @ptrv(word.data, u8, 1)
        }
        return mem.equals_bytes(this.word_ptr, word.data, word.bytes)
    }

    fn read_word(allow_space: bool, allow_newline: bool) String !Error {
        let t = this.tok(allow_space, allow_newline) !>
        if t != TOK.word : this.error("Invalid identifier name: '" + this.word() + "' | Expected syntax: [a-zA-Z_]")
        return this.word()
    }

    fn expect(word: String, allow_space: bool, allow_newline: bool) !Error {
        this.tok(allow_space, allow_newline) !>
        if !this.word_is(word) {
            this.error("Expected token: '" + word + "', instead of: '" + this.word() + "'")
        }
    }

    fn next_word_is(word: String, allow_space: bool, allow_newline: bool, update: bool) bool !Error {
        let prev_word_ptr = this.word_ptr
        let prev_word_len = this.word_len
        let prev_word_i = this.word_i
        let prev_new_lines = this.new_lines
        this.tok(allow_space, allow_newline, false) !>
        if this.word_is(word) {
            if update {
                this.tok(allow_space, allow_newline, true) !>
            } else {
                this.word_ptr = prev_word_ptr
                this.word_len = prev_word_len
                this.word_i = prev_word_i
                this.new_lines = prev_new_lines
            }
            return true
        }
        this.word_ptr = prev_word_ptr
        this.word_len = prev_word_len
        this.word_i = prev_word_i
        this.new_lines = prev_new_lines
        return false
    }

    // Read `name` or `namespace.name`.
    fn read_id(allow_space: bool, allow_newline: bool) Exp !Error {
        let name = this.read_word(allow_space, allow_newline) !>
        let exp = this.create_exp(EXP.id)
        exp.str1 = name

        let t = this.tok(false, false, false) !>
        if t == TOK.sign && this.word_is(".") {
            this.tok(false, false) !>
            // Store namespace name in str2
            exp.str2 = name
            // Read actual name
            exp.str1 = this.read_word(false, false) !>
        }

        exp.set_end(this.token_end)
        return exp
    }

    fn skip_balanced(open: String, close: String) !Error {
        let depth: uint = 1
        while depth > 0 {
            let t = this.tok(true, true) !>
            if t == TOK.end : this.error("Unexpected end of file, missing '" + close + "'")
            if t != TOK.sign : continue
            if this.word_is(open) {
                depth++
            } else if open == "{" && this.word_is("<{") {
                // Value-scope body opener includes `{`
                depth++
            } else if this.word_is(close) {
                depth--
            }
        }
    }

    // Guards a recursive parse step; pair with `leave_nesting`
    fn enter_nesting(what: String) !Error {
        let b = this.build
        if b.nest_depth >= MAX_NESTING {
            this.error(what + " nesting too deep (limit " + MAX_NESTING + ")")
        }
        if b.stack_exhausted() : this.error(what + " nesting too deep")
        b.nest_depth++
    }
    fn leave_nesting() $inline {
        this.build.nest_depth--
    }

    // Report a parse error at the current token (word_i / word_len span).
    fn error(msg: String) !Error $throw {
        let b = this.build
        b.has_errors = true
        // Span covers the last token read (peek or consume); word_i is its start index.
        let i = this.word_i
        let len = this.word_len
        if len == 0 : i = this.pos.i
        Message {
            build: b
            type: MSG.error
            msg: msg
            src: this.pos.src
            i: i
            len: len
            syntax: true
        }.error()
    }
}

// End index of the identifier that starts before `i`
fn skip_word(data: *[u8], len: uint, i: u32) u32 {
    while i < len {
        if !is_word_byte(@ptrv(data, u8, i)) : break
        i++
    }
    return i
}

fn is_word_byte(ch: u8) bool $inline {
    return ch.is_alpha_numeric() || ch == '_'
}

// End index and token kind of the number whose first digit is at `i - 1`
fn skip_number(data: *[u8], len: uint, i: u32) (u32, TOK) {
    let t = TOK.int
    if @ptrv(data, u8, i - 1) == '0' && i < len {
        let ch = @ptrv(data, u8, i)
        if ch == 'x' {
            t = TOK.hex
            i++
        } else if ch == 'c' {
            t = TOK.octal
            i++
        }
    }
    while i < len {
        let ch = @ptrv(data, u8, i)
        if ch == '_' {
            i++
            continue
        }
        if t == TOK.hex {
            if !ch.is_hex() : break
        } else if t == TOK.octal {
            if !ch.is_octal() : break
        } else if t == TOK.int && ch == '.' && @ptrv(data, u8, i + 1).is_number() {
            t = TOK.float
        } else if (ch == 'e' || ch == 'E') && t != TOK.hex && t != TOK.octal {
            // Exponent: 1e10, 2.5E-3
            let next = i + 1 < len ? @ptrv(data, u8, i + 1) : 0
            let sign = next == '+' || next == '-'
            let digit = sign ? (i + 2 < len ? @ptrv(data, u8, i + 2) : 0) : next
            if !digit.is_number() : break
            t = TOK.float
            i += sign ? 2 : 1
        } else if !ch.is_number() {
            break
        }
        i++
    }
    return (i, t)
}

fn read_exp_flags(p: Parser, exp: Exp, t: TOK, allow_newline: bool, at_words: bool, what: String) TOK !Error {
    if t != TOK.flag && (!at_words || t != TOK.at_word) : return t
    let flags = Array[String]{}
    while t == TOK.flag || (at_words && t == TOK.at_word) {
        p.tok(true, allow_newline) !>
        let flag = p.word()
        if what.length > 0 && !prop_flag_is_known(flag) {
            p.error("Unknown " + what + " flag: " + flag)
        }
        flags.append(flag)
        t = p.tok(true, allow_newline, false) !>
    }
    if flags.length > 0 : exp.list = flags
    return t
}

// Concrete declarations use `{ ... }`; declaration-only contexts use `;`.
fn read_body_or_semicolon(p: Parser, exp: Exp, t: TOK, after: String, signature_only: bool) !Error {
    if signature_only {
        if t != TOK.sign || !p.word_is(";") {
            p.error("Expected ';' after " + after + ", found: '" + p.word() + "'")
        }
        p.tok(true, true) !>
        return
    }

    if t == TOK.sign && p.word_is(";") {
        p.error("Only extern functions and interface members may use a signature-only declaration")
    }
    if t != TOK.sign || !p.word_is("{") {
        p.error("Expected '{' after " + after + ", found: '" + p.word() + "'")
    }
    p.tok(true, true) !>
    exp.set(FUNC_EXP.body, read_body_exp(p, "{", "}") !>)
}

// Called after a comma-delimited item. Consumes its separator or closing token.
fn read_comma_list_next(p: Parser, closer: String, what: String) bool !Error {
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is(closer) {
        p.tok(true, true) !>
        return false
    }
    if t != TOK.sign || !p.word_is(",") {
        p.error("Expected ',' or '" + closer + "' in " + what + ", found: '" + p.word() + "'")
    }

    p.tok(true, true) !>
    t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is(closer) {
        p.error("Trailing comma in " + what)
    }
    if t == TOK.sign && p.word_is(",") {
        p.error("Empty item in " + what)
    }
    return true
}

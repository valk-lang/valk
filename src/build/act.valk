
// Access enforcement:
//   no marker: public in the package, private outside it
//   `-`:       private outside the source
//   `~`:       read-only outside the source
//   `+`:       public everywhere
//   `-~`:      read-only in the namespace, private outside it
//   `-+`:      public in the namespace, private outside it
//   `~+`:      public in the namespace, read-only outside it
//   `-~+`:     public in the namespace, read-only in the package, private outside

fn act_check(at: Exp, act: ACT, defined_in: Exp, is_assign: bool, idf_for: String) !Error {
    let level = act_level(at, act, defined_in)
    if level == ACT.public : return
    if level == ACT.readonly && !is_assign : return

    if level == ACT.readonly {
        at.error("Cannot modify this " + idf_for + " because it's defined as read-only")
    }
    at.error("Cannot access this " + idf_for + " because it's defined as private")
}

// How far a declaration reaches, used to compare an interface implementation
// with the requirement it satisfies. Read-only markers do not narrow the reach.
fn act_reach_rank(act: ACT) uint {
    if act == ACT.public || act == ACT.readonly || act == ACT.readonly_public : return 3
    if act == ACT.undefined : return 2
    return 1
}

fn act_allows(at: Exp, act: ACT, defined_in: Exp, is_assign: bool) bool {
    let level = act_level(at, act, defined_in)
    return level == ACT.public || (level == ACT.readonly && !is_assign)
}

fn act_level(at: Exp, act: ACT, defined_in: Exp) ACT {
    if act == ACT.public || at.src.ignore_access : return ACT.public

    let from_source = access_root_source(at.src)
    let defined_source = access_root_source(defined_in.src)
    if from_source == defined_source : return ACT.public

    let from = from_source.ns
    let def = defined_source.ns
    if !isset(from) || !isset(def) : return ACT.public

    let same_namespace = from == def
    let same_package = from.pkg == def.pkg

    if act == ACT.private : return ACT.private
    if act == ACT.readonly : return ACT.readonly
    if act == ACT.private_readonly {
        return same_namespace ? ACT.readonly : ACT.private
    }
    if act == ACT.private_public {
        return same_namespace ? ACT.public : ACT.private
    }
    if act == ACT.readonly_public {
        return same_namespace ? ACT.public : ACT.readonly
    }
    if act == ACT.private_readonly_public {
        if same_namespace : return ACT.public
        return same_package ? ACT.readonly : ACT.private
    }

    // No marker: public throughout its package, private outside it.
    return same_package ? ACT.public : ACT.private
}

fn access_root_source(src: Source) Source {
    let root = src
    let parent = root.parent
    while isset(parent) {
        root = parent
        parent = root.parent
    }
    return root
}

fn require_sequence_metadata_write(prop: Prop, at: Exp, scope: Scope) !Error {
    if prop.class.kind == CLASS_KIND.slice || prop.class.kind == CLASS_KIND.array {
        require_unsafe(at, scope, "Writing raw sequence metadata") !>
    }
}

// A field or element aliases its inline parent's storage; a local copy does not.
fn value_is_enum_storage(value: Value) bool {
    let type = value.rett.get_non_nullable()
    if type.kind == TYPE.ref_of || type.kind == TYPE.adr_of || type.kind == TYPE.ptr_of {
        let held = type.get_sub_type()
        return isset(held) && isset(held.get_enum()) && held.is_inline_type()
    }
    if !type.is_inline_type() : return false
    if isset(type.get_enum()) : return true
    return value_is_enum_part(value)
}

fn value_is_enum_part(value: Value) bool {
    if value.type != VAL.prop && value.type != VAL.ptrv : return false
    let owner = value.value1 ?! return false
    // Indexing a borrow replaces a whole value, never a piece of its pointee.
    if value.type == VAL.ptrv && !owner.rett.is_inline_type() : return false
    return value_is_enum_storage(owner)
}

fn value_check_enum_part(value: Value, at: Exp) !Error {
    if value_is_enum_part(value) {
        at.error("Cannot modify or borrow part of an enum; copy its underlying value first")
    }
}

fn act_check_assign(left: Value, at: Exp, scope: Scope) !Error {
    value_check_enum_part(left, at) !>
    if left.type == VAL.prop {
        let prop = left.prop
        if !isset(prop) : return
        act_check(at, prop.act, prop.exp, true, "property") !>
        require_sequence_metadata_write(prop, at, scope) !>
        return
    }
    if left.type == VAL.global {
        let g = left.global
        if !isset(g) : return
        act_check(at, g.act, g.exp, true, "global") !>
    }
}

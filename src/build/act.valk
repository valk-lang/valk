// Access enforcement for the `+` (public), `~` (read-only) and `-` (private)
// markers. A declaration without a marker is private, which is also how --docs
// reports it.
//
// Only the package boundary matters. The old build packed three levels into one
// int and defaulted to `act_default` = private, with the namespace and package
// levels both public (build-old/act.valk), so a marker has never restricted the
// package it was written in — it restricts other packages. The per-scope
// `-[ns +, pkg -]` form that could tighten those levels is deliberately not
// supported here: nothing in lib/, src/ or tests/ ever used it.
//
// Top-level names all live on the namespace scope (see base_idf_scope), so
// privacy is enforced at the use site rather than by hiding the name.

// `at` is where the access is written, `defined_in` the declaration's own Exp.
// Both are compared through their Source: a declaration's `ns` is not always the
// namespace it was written in — a method mixed in by `extend Class { ... }` gets
// the extended class's namespace — but its source file always is.
fn act_check(at: Exp, act: ACT, defined_in: Exp, is_assign: bool, idf_for: String) !Error {
    if act_allows(at, act, defined_in, is_assign) : return

    if act == ACT.readonly {
        at.error("Cannot modify this " + idf_for + " because it's defined as read-only")
    }
    at.error("Cannot access this " + idf_for + " because it's defined as private")
}

// The rule itself, as a plain predicate. act_check turns a false result into a
// diagnostic; completion needs the same answer to decide whether to offer a
// name, and must not report anything while doing so.
fn act_allows(at: Exp, act: ACT, defined_in: Exp, is_assign: bool) bool {
    if act == ACT.public : return true
    // Reading a `~` declaration is allowed anywhere; only stores are restricted
    if act == ACT.readonly && !is_assign : return true
    if at.src.ignore_access : return true

    let from = at.src.ns
    let def = defined_in.src.ns
    // Generated code has no file of its own, and so no package to compare
    if !isset(from) || !isset(def) : return true
    return from.pkg == def.pkg
}

// Assignment target of `x = ...` (and `+=` and friends). Reads already passed a
// check when the target was resolved, so this only has to reject the stores that
// a read is allowed to make: `~` read-only properties and globals.
//
// Only the assigned value itself is checked. In `obj.thing.field = x` the outer
// `thing` is read, not written, and was checked as a read.
fn act_check_assign(left: Value, at: Exp) !Error {
    if left.type == VAL.prop {
        let prop = left.prop
        if !isset(prop) : return
        act_check(at, prop.act, prop.exp, true, "property") !>
        return
    }
    if left.type == VAL.global {
        let g = left.global
        if !isset(g) : return
        act_check(at, g.act, g.exp, true, "global") !>
    }
}

// Resolved type kind (from EXP.type forms and class kinds).
enum TYPE {
    void
    class      // class / struct / slice / mode / etc. (class field set)
    int
    float
    bool
    ptr        // *T or *[]
    ref        // &T or &[]
    nullable   // ?T
    inline     // <T>
    array      // [T x N]
    multi      // (T, U, ...)
    fn         // fn(...)(...)
    fnptr      // fnptr(...)(...)
    co         // co(...)
    any
}

// Compiler Type object produced from EXP.type (and similar).
//
// Immutable after creation: type-defining fields are never reassigned.
// Only cache_* slots may be filled later so wrappers can be reused.
class Type {
    type: TYPE
    build: Build
    // Linked class when type is a class/struct/integer/float/boolean/pointer/mode
    class: ?Class (null)
    // Wrapper / element type (?, *, &, inline, array, ...)
    sub_type: ?Type (null)
    // Multi / generics / fn args list
    sub_types: ?Array[Type] (null)
    // Fixed array size, or pointer-info size when relevant
    array_size: u32 (0)
    // Display name (e.g. class name)
    custom_name: String ("")
    // True for *[] / &[] forms
    is_slice_ptr: bool (false)
    // ---- wrapper caches (mutable slots; the Type itself stays fixed) ----
    cache_nullable: ?Type (null)
    cache_pointer: ?Type (null)
    cache_ref: ?Type (null)
    cache_inline: ?Type (null)

    // ?T — cached on this type
    fn nullable() Type {
        let cache = this.cache_nullable
        if isset(cache) : return cache
        let t = Type {
            type: TYPE.nullable
            build: this.build
            sub_type: this
        }
        this.cache_nullable = t
        return t
    }

    // *T — cached on this type
    fn pointer() Type {
        let cache = this.cache_pointer
        if isset(cache) : return cache
        let t = Type {
            type: TYPE.ptr
            build: this.build
            sub_type: this
        }
        this.cache_pointer = t
        return t
    }

    // &T — cached on this type
    fn reference() Type {
        let cache = this.cache_ref
        if isset(cache) : return cache
        let t = Type {
            type: TYPE.ref
            build: this.build
            sub_type: this
        }
        this.cache_ref = t
        return t
    }

    // <T> — cached on this type
    fn inline() Type {
        let cache = this.cache_inline
        if isset(cache) : return cache
        let t = Type {
            type: TYPE.inline
            build: this.build
            sub_type: this
        }
        this.cache_inline = t
        return t
    }
}

// ---- Build-level singleton types ----

fn type_void(b: Build) Type {
    let cache = b.cache.type_void
    if isset(cache) : return cache
    let t = Type {
        type: TYPE.void
        build: b
    }
    b.cache.type_void = t
    return t
}

fn type_any(b: Build) Type {
    let cache = b.cache.type_any
    if isset(cache) : return cache
    let t = Type {
        type: TYPE.any
        build: b
    }
    b.cache.type_any = t
    return t
}

// Convert a structured EXP.type into a Type using `scope` for name lookup.
fn type_from_exp(exp: Exp, scope: Scope) Type !Error {
    if exp.type != EXP.type : exp.bug("Expected EXP.type")
    let form = exp.str1
    let b = exp.src.build

    if form == "void" : return type_void(b)

    if form == "?" {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for '?'")
        return type_from_exp(sub_exp, scope) !>.nullable()
    }

    if form == "*" {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for '*'")
        return type_from_exp(sub_exp, scope) !>.pointer()
    }
    if form == "*[]" {
        // Slice pointers are not cached (size/element vary); build fully initialized.
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for '*[]'")
        let size_s = exp.str2
        let size: u32 = 0
        if isset(size_s) : size = parse_type_size(size_s)
        return Type {
            type: TYPE.ptr
            build: b
            sub_type: type_from_exp(sub_exp, scope) !>
            array_size: size
            is_slice_ptr: true
        }
    }

    if form == "&" {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for '&'")
        return type_from_exp(sub_exp, scope) !>.reference()
    }
    if form == "&[]" {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for '&[]'")
        let size_s = exp.str2
        let size: u32 = 0
        if isset(size_s) : size = parse_type_size(size_s)
        return Type {
            type: TYPE.ref
            build: b
            sub_type: type_from_exp(sub_exp, scope) !>
            array_size: size
            is_slice_ptr: true
        }
    }

    if form == "inline" {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for inline")
        return type_from_exp(sub_exp, scope) !>.inline()
    }

    if form == "notnull" {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for notnull")
        let t = type_from_exp(sub_exp, scope) !>
        // Strip one nullable layer if present
        if t.type == TYPE.nullable {
            let inner = t.sub_type
            if isset(inner) : return inner
        }
        return t
    }

    if form == "array" {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing element type for array")
        let size_s = exp.str2
        let size: u32 = 0
        if isset(size_s) : size = parse_type_size(size_s)
        return Type {
            type: TYPE.array
            build: b
            sub_type: type_from_exp(sub_exp, scope) !>
            array_size: size
        }
    }

    if form == "multi" {
        return type_from_multi_exp(exp, scope) !>
    }

    if form == "fn" || form == "fnptr" {
        let args_types: ?Array[Type] = null
        let args = exp.get(TYPE_EXP.args)
        if isset(args) {
            let args_t = type_from_exp(args, scope) !>
            args_types = args_t.sub_types
        }
        let rett_type: ?Type = null
        let rett = exp.get(TYPE_EXP.rett)
        if isset(rett) {
            rett_type = type_from_exp(rett, scope) !>
        }
        return Type {
            type: form == "fn" ? TYPE.fn : TYPE.fnptr
            build: b
            sub_type: rett_type
            sub_types: args_types
        }
    }

    if form == "co" {
        let rett_type: ?Type = null
        let rett = exp.get(TYPE_EXP.rett)
        if isset(rett) {
            rett_type = type_from_exp(rett, scope) !>
        }
        return Type {
            type: TYPE.co
            build: b
            sub_type: rett_type
        }
    }

    if form == "." {
        exp.error("'.' type is not valid here")
    }

    if form == "named" {
        return type_from_named_exp(exp, scope) !>
    }

    exp.bug("Unknown type form: '" + form + "'")
}

fn type_from_multi_exp(exp: Exp, scope: Scope) Type !Error {
    let b = exp.src.build
    let types = Array[Type]{}
    let i: uint = 0
    while true {
        let sub = exp.get(i)
        if !isset(sub) : break
        types.append(type_from_exp(sub, scope) !>)
        i++
    }
    return Type {
        type: TYPE.multi
        build: b
        sub_types: types
    }
}

fn type_from_named_exp(exp: Exp, scope: Scope) Type !Error {
    let id = exp.get(TYPE_EXP.id)
    if !isset(id) : exp.bug("Named type is missing id")

    let name = id.str1
    let ns_name = id.str2

    // Optional namespace prefix: ns:Name — `ns` must be an IDF.scope from `use`
    let idf: ?Idf = null
    if isset(ns_name) {
        let ns_idf = scope.get_idf(ns_name)
        if !isset(ns_idf) : exp.error("Unknown namespace: " + ns_name)
        if ns_idf.type != IDF.scope {
            exp.error("Expected a namespace before ':', found: " + ns_name)
        }
        let ns_scope = ns_idf.scope
        if !isset(ns_scope) : exp.bug("Scope idf is missing scope")
        idf = ns_scope.get_idf(name)
        if !isset(idf) : exp.error("Unknown type: " + ns_name + ":" + name)
    } else {
        idf = scope.get_idf(name)
        if !isset(idf) : exp.error("Unknown type: " + name)
    }

    let resolved = idf
    if !isset(resolved) : exp.error("Unknown type: " + name)

    // Generic parameter or other bound type (e.g. `T` inside `class Foo[T]`)
    if resolved.type == IDF.type {
        let of_type = resolved.of_type
        if !isset(of_type) : exp.bug("Type idf is missing of_type")
        return of_type
    }

    if resolved.type != IDF.class {
        exp.error("Identifier is not a type: " + name)
    }
    let class = resolved.class
    if !isset(class) : exp.bug("Class idf is missing class")

    // Resolve generic type arguments → specialized Class (never Type of a generic base)
    let gens = exp.get(TYPE_EXP.generics)
    if isset(gens) {
        if !class.is_generic_base {
            exp.error("Type is not generic: " + class.name)
        }
        let gtypes = Array[Type]{}
        let i: uint = 0
        while true {
            let g = gens.get(i)
            if !isset(g) : break
            gtypes.append(type_from_exp(g, scope) !>)
            i++
        }
        let specialized = class.specialize(gtypes, exp) !>
        return specialized.get_type() !>
    }

    if class.is_generic_base {
        exp.error("Generic type '" + class.name + "' requires type arguments")
    }

    // Cached class type (shared for all bare references to this concrete class)
    let base = class.get_type() !>

    // Optional sized form (pointer-info style) — distinct Type wrapper metadata
    let sized = exp.get(TYPE_EXP.type)
    if isset(sized) || isset(exp.str2) {
        let size_s = exp.str2
        let size: u32 = 0
        if isset(size_s) : size = parse_type_size(size_s)
        return Type {
            type: base.type
            build: base.build
            class: class
            custom_name: class.name
            array_size: size
        }
    }

    return base
}

fn parse_type_size(s: String) u32 {
    // Best-effort decimal parse for array/pointer sizes stored as strings
    let n: u32 = 0
    let i: uint = 0
    let bytes = s.bytes
    let data = s.data
    while i < bytes {
        let ch = @ptrv(data, u8, i)
        i++
        if ch < '0' || ch > '9' : break
        n = n * 10 + (ch - '0').to(u32)
    }
    return n
}

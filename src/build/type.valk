// Resolved type kind (from EXP.type forms and class kinds).
enum TYPE : u8 {
    void
    any
    bool
    int
    float
    error_code
    nullable   // ?T
    union      // A | B (inline tagged value)
    array
    slice
    fixed_array
    struct
    voidptr
    gcptr
    ptr_of
    ref_of
    co
    closure
    fnptr      // fnptr(...)(...)
}

class UnaryTypeInfo {
    sub: Type
}

class FunctionTypeInfo {
    args: Array[Type]
    returns: Array[Type]
    error_type: ?ErrorType (null)
}

class UnionTypeInfo {
    members: Array[Type]
}

union TypeInfo : UnaryTypeInfo | UnionTypeInfo | FunctionTypeInfo | ErrorType | Enum {}

class UnionLayout {
    payload_size: u32
    payload_offset: u32 (8)
}

class TypeCache {
    size_computing: bool (false)
    cached_ir_alignment: u32 (1)
    ir_alignment_known: bool (false)
    cached_storage_alignment: u32 (1)
    storage_alignment_known: bool (false)
    cached_gc_root_count: uint (0)
    gc_root_count_known: bool (false)
    cached_has_gc_refs: bool (false)
    has_gc_refs_known: bool (false)
    cached_union_layout: ?UnionLayout (null)
    cached_display_name: ?String (null)
    cached_identity_key: ?String (null)
    cached_ir_type: ?String (null)
    cached_error_abi_type: ?String (null)
    ptr_of: ?Type (null)
    ref_of: ?Type (null)
    inline: ?Type (null)
    non_inline: ?Type (null)
    nullable: ?Type (null)
    array: ?Type (null)
    slice: ?Type (null)
    shared: ?Type (null)
}

// Compiler Type object produced from EXP.type (and similar).
//
// Immutable after creation: type-defining fields are never reassigned.
// Only cache_* / size slots may be filled later so wrappers and sizes can be reused.
class Type {
    build: Build
    class: ?Class (null)
    custom_name: String ("")
    info: ?TypeInfo (null)
    cache: ?TypeCache (null)
    size: uint (0)
    length: uint (0)
    kind: TYPE
    unsigned: bool (false)
    size_known: bool (false)
    is_inline: bool (false)
    is_shared: bool (false)
    error_is_instance: bool (false)

    fn get_unary_info() ?UnaryTypeInfo {
        let info = this.info
        if !isset(info) : return null
        return match info : ?UnaryTypeInfo {
            UnaryTypeInfo as unary => unary
            default => null
        }
    }

    fn get_function_info() ?FunctionTypeInfo {
        let info = this.info
        if !isset(info) : return null
        return match info : ?FunctionTypeInfo {
            FunctionTypeInfo as func => func
            default => null
        }
    }

    fn get_union_info() ?UnionTypeInfo {
        let info = this.info
        if !isset(info) : return null
        return match info : ?UnionTypeInfo {
            UnionTypeInfo as union_info => union_info
            default => null
        }
    }

    fn get_sub_type() ?Type {
        let info = this.get_unary_info()
        return isset(info) ? info.sub : null
    }

    fn get_members() ?Array[Type] {
        let info = this.get_union_info()
        return isset(info) ? info.members : null
    }

    fn get_args() ?Array[Type] {
        let info = this.get_function_info()
        return isset(info) ? info.args : null
    }

    fn get_returns() ?Array[Type] {
        let info = this.get_function_info()
        return isset(info) ? info.returns : null
    }

    fn get_return_type() Type {
        let returns = this.get_returns()
        if !isset(returns) : return type_void(this.build)
        return type_multi(this.build, returns)
    }

    fn get_error_type() ?ErrorType {
        let info = this.info
        if !isset(info) : return null
        return match info : ?ErrorType {
            ErrorType as error_type => error_type
            FunctionTypeInfo as func => func.error_type
            default => null
        }
    }

    fn get_enum() ?Enum {
        let info = this.info
        if !isset(info) : return null
        return match info : ?Enum {
            Enum as enum_info => enum_info
            default => null
        }
    }

    fn get_cache() TypeCache $inline {
        let cache = this.cache
        if isset(cache) : return cache
        let created = TypeCache {}
        this.cache = created
        return created
    }

    fn get_cached_ir_type() ?String $inline {
        let cache = this.cache
        return isset(cache) ? cache.cached_ir_type : null
    }

    fn set_cached_ir_type(value: String) $inline { this.get_cache().cached_ir_type = value }

    fn get_cached_error_abi_type() ?String $inline {
        let cache = this.cache
        return isset(cache) ? cache.cached_error_abi_type : null
    }

    fn set_cached_error_abi_type(value: String) $inline { this.get_cache().cached_error_abi_type = value }

    fn shared_type() Type {
        if this.is_nullable_type() {
            return this.get_non_nullable().shared_type().nullable()
        }
        if this.is_shared : return this
        if !this.is_gc_type() && this.kind != TYPE.closure : return this
        let cached = this.cache
        let shared = isset(cached) ? cached.shared : null
        if isset(shared) : return shared
        let result = Type {
            build: this.build
            kind: this.kind
            is_shared: true
            class: this.class
            info: this.info
            error_is_instance: this.error_is_instance
            length: this.length
            unsigned: this.unsigned
            is_inline: this.is_inline
        }
        this.get_cache().shared = result
        return result
    }

    fn shared_storage_type() Type {
        if this.kind == TYPE.struct && this.is_inline && !isset(this.class) {
            let types = Array[Type]{}
            let sub_types = this.get_members()
            if isset(sub_types) {
                each sub_types as type : types.append(type.shared_storage_type())
            }
            return type_multi(this.build, types, true)
        }
        let string_class = type_string(this.build).get_class_or_null()
        let class = this.get_non_nullable().get_class_or_null()
        let base = class
        while isset(base) && base.kind == CLASS_KIND.mode {
            base = base.mode_for_class
        }
        if isset(string_class) && base == string_class : return this
        return this.shared_type()
    }

    // Target pointer size in bytes
    fn ptr_size() u32 {
        return this.build.options.target.ptr_size.to(u32)
    }

    // Byte size of a value of this type. Cached after the first successful resolve.
    // Throws if a class layout cannot be resolved due to recursive dependencies.
    fn byte_size() u32 !Error {
        if this.size_known : return this.size.to(u32)
        let cache = this.get_cache()
        if cache.size_computing {
            this.build.error("Cannot determine type size due to recursive type dependencies" + this.size_error_label())
        }
        cache.size_computing = true
        let s = this.compute_size() !>
        this.size = s.to(uint)
        this.size_known = true
        cache.size_computing = false
        return s
    }

    fn size_error_label() String {
        let c = this.class
        if isset(c) : return ": " + c.name
        return ""
    }

    // Compute size without caching (caller handles cache / recursion flag).
    fn compute_size() u32 !Error {
        let t = this.kind
        let psz = this.ptr_size()

        if t == TYPE.void : return 0
        if t == TYPE.any : this.build.bug("Cannot size unresolved generic type")
        if this.is_pointer() : return psz
        if t == TYPE.closure : return psz * 2

        // Tagged unions are ordinary value aggregates with a byte tag and an
        // aligned payload large enough for the largest alternative.
        if t == TYPE.union {
            let layout = this.union_layout() !>
            let size = layout.payload_offset + layout.payload_size
            if size % psz != 0 : size += psz - (size % psz)
            return size
        }

        if t == TYPE.nullable {
            let sub = this.get_sub_type()
            if !isset(sub) : return psz
            // A direct pointer uses null as its empty value.
            if sub.is_pointer() : return psz
            // Closures use a null function pointer as their empty state.
            if sub.kind == TYPE.closure : return sub.byte_size() !>
            // The presence field occupies a pointer-sized header even though
            // LLVM represents the flag itself as i1. Round the complete value
            // like LLVM's natural struct layout so fixed-array strides agree.
            let size = psz + (sub.byte_size() !>)
            let alignment = this.ir_alignment() !>
            if alignment > 1 : size = size.round_up(alignment)
            return size
        }

        let inline_class = this.is_inline ? this.get_class_or_null() : null
        if this.is_inline && (t == TYPE.array || isset(inline_class)) {
            let c = inline_class
            if isset(c) && c.kind == CLASS_KIND.mode {
                return c.compute_size() !>
            }
            if isset(c) && (c.kind == CLASS_KIND.struct || c.kind == CLASS_KIND.class || c.kind == CLASS_KIND.array) {
                return c.compute_body_size() !>
            }
            if t == TYPE.array : return psz * 3
        }

        if t == TYPE.struct && this.is_inline && !isset(this.class) {
            let subs = this.get_members()
            if !isset(subs) : this.build.bug("Tuple type is missing members")
            let total: u32 = 0
            each subs as st {
                total = st.ir_align_offset(total) !>
                total += st.byte_size() !>
            }
            let alignment = this.ir_alignment() !>
            if alignment > 1 : total = total.round_up(alignment)
            return total
        }

        if this.is_fixed_array_type() {
            let sub = this.get_sub_type()
            if !isset(sub) : this.build.bug("Inline sequence is missing element type")
            let element_size = sub.byte_size() !>
            if element_size > 0 && this.length > (4294967295 / element_size).to(uint) {
                this.build.error("Fixed inline sequence byte size exceeds 4294967295")
            }
            return element_size * this.length.to(u32)
        }

        // Class-backed types (class / int / float / bool / pointer / …)
        let c = this.class
        if isset(c) {
            if c.kind == CLASS_KIND.class : return psz
            return c.compute_size() !>
        }

        // TYPE.int / float / bool / class without class pointer — should not happen
        if t == TYPE.int || t == TYPE.float || t == TYPE.bool {
            return psz
        }
        if t == TYPE.gcptr || t == TYPE.struct || t == TYPE.slice || t == TYPE.array {
            return psz
        }

        return 0
    }

    fn union_layout() UnionLayout !Error {
        let t = this.get_non_nullable()
        if t.kind != TYPE.union : t.build.bug("Expected tagged union layout")
        let cache = t.cache
        let cached = isset(cache) ? cache.cached_union_layout : null
        if isset(cached) : return cached

        let members = t.get_members() ?! t.build.bug("Tagged union is missing alternatives")
        let payload_size: u32 = 0
        each members as member {
            let size = member.byte_size() !>
            if size > payload_size : payload_size = size
        }
        if payload_size % 8 != 0 : payload_size = payload_size.round_up(8)
        let layout = UnionLayout { payload_size: payload_size }
        t.get_cache().cached_union_layout = layout
        return layout
    }

    // ABI alignment of the LLVM value produced by ir_type(). Keep this
    // separate from class-body layout: inline class bodies are emitted as byte
    // arrays and therefore have LLVM alignment 1, while a natural multi-value
    // must use the exact alignment LLVM assigns to each member.
    fn ir_alignment() u32 !Error {
        let cache = this.get_cache()
        if cache.ir_alignment_known : return cache.cached_ir_alignment
        let alignment = this.compute_ir_alignment() !>
        cache.cached_ir_alignment = alignment
        cache.ir_alignment_known = true
        return alignment
    }

    fn compute_ir_alignment() u32 !Error {
        let t = this.get_non_nullable()
        let psz = this.ptr_size()

        if t.is_pointer() || t.kind == TYPE.closure : return psz
        if t.kind == TYPE.void || t.kind == TYPE.bool || (t.is_inline && isset(t.class) && !t.is_fixed_array_type()) : return 1
        if t.kind == TYPE.error_code : return 4

        if t.kind == TYPE.union {
            return psz < 8 ? psz : 8
        }
        if t.is_fixed_array_type() {
            let sub = t.get_sub_type()
            if !isset(sub) : return 1
            return sub.ir_alignment() !>
        }
        if t.kind == TYPE.struct && t.is_inline && !isset(t.class) {
            let members = t.get_members()
            if !isset(members) : return 1
            let largest: u32 = 1
            each members as member {
                let alignment = member.ir_alignment() !>
                if alignment > largest : largest = alignment
            }
            return largest
        }

        let size = t.byte_size() !>
        if size == 0 : return 1
        let alignment: u32 = 1
        while alignment < size && alignment < psz : alignment *= 2
        return alignment > psz ? psz : alignment
    }

    // Align a byte offset exactly as LLVM does before placing this type in a
    // natural struct. LLVM alignments are powers of two, but round_up also
    // keeps this helper correct for every target-supported scalar size.
    fn ir_align_offset(offset: u32) u32 !Error {
        let alignment = this.ir_alignment() !>
        if alignment <= 1 : return offset
        return offset.round_up(alignment)
    }

    // Preferred alignment when the compiler controls a byte-backed buffer
    // (GC frames, coroutine storage, globals). Unlike ir_alignment(), this
    // looks through inline byte arrays so embedded managed pointers can still
    // land on naturally aligned addresses whenever their field offsets allow.
    fn storage_alignment() u32 !Error {
        let cache = this.get_cache()
        if cache.storage_alignment_known : return cache.cached_storage_alignment
        let alignment = this.compute_storage_alignment() !>
        cache.cached_storage_alignment = alignment
        cache.storage_alignment_known = true
        return alignment
    }

    fn compute_storage_alignment() u32 !Error {
        // Resolve the byte size first so invalid recursive inline layouts fail
        // with the normal diagnostic instead of recursing through this walk.
        this.byte_size() !>
        let t = this.get_non_nullable()
        if t.is_fixed_array_type() {
            let sub = t.get_sub_type()
            if !isset(sub) : return 1
            return sub.storage_alignment() !>
        }
        if t.is_inline && isset(t.class) {
            let class = t.get_class_or_null()
            if !isset(class) : return 1
            let largest: u32 = 1
            each class.props as prop {
                let alignment = prop.type.storage_alignment() !>
                if alignment > largest : largest = alignment
            }
            return largest
        }
        if t.kind == TYPE.struct && t.is_inline && !isset(t.class) {
            let members = t.get_members()
            if !isset(members) : return 1
            let largest: u32 = 1
            each members as member {
                let alignment = member.storage_alignment() !>
                if alignment > largest : largest = alignment
            }
            return largest
        }
        if t.kind == TYPE.union {
            let largest = this.ir_alignment() !>
            let members = t.get_members()
            if isset(members) {
                each members as member {
                    let alignment = member.storage_alignment() !>
                    if alignment > largest : largest = alignment
                }
            }
            return largest
        }
        return this.ir_alignment() !>
    }

    // Nullable values that cannot encode absence in the value itself get an
    // explicit presence flag: `{ i1, [n x u8], <value> }`.
    fn is_tagged_nullable() bool {
        if !this.is_nullable_type() : return false
        let sub = this.get_sub_type()
        if !isset(sub) : return false
        return !sub.is_pointer() && sub.kind != TYPE.closure
    }

    fn is_pointer() bool {
        let t = this.kind
        if t == TYPE.voidptr || t == TYPE.gcptr || t == TYPE.ptr_of || t == TYPE.ref_of || t == TYPE.fnptr || t == TYPE.co {
            return true
        }
        if (t == TYPE.array || t == TYPE.slice || t == TYPE.struct) && !this.is_inline : return true
        if t == TYPE.nullable {
            let sub = this.get_sub_type()
            if isset(sub) : return sub.is_pointer()
            return false
        }
        if this.is_inline : return false
        let c = this.class
        if !isset(c) : return false
        let kind = c.representation_class().kind
        return kind == CLASS_KIND.class || kind == CLASS_KIND.interface || kind == CLASS_KIND.struct
            || kind == CLASS_KIND.slice || kind == CLASS_KIND.array || kind == CLASS_KIND.unbound || kind == CLASS_KIND.pointer
    }

    fn has_unresolved_generic() bool {
        if this.kind == TYPE.any : return true
        let sub = this.get_sub_type()
        if isset(sub) && sub.has_unresolved_generic() : return true
        let subs = this.get_members() ?? this.get_args()
        if isset(subs) {
            each subs as member {
                if member.has_unresolved_generic() : return true
            }
        }
        let returns = this.get_returns()
        if isset(returns) {
            each returns as rett {
                if rett.has_unresolved_generic() : return true
            }
        }
        let c = this.class
        if !isset(c) : return false
        let args = c.generic_types
        if !isset(args) : return false
        each args as arg {
            if arg.has_unresolved_generic() : return true
        }
        return false
    }

    // ---- compile-time meta queries (`T.$is_*`, `T.$has_*`, …) ----

    // Strip one nullable layer (`?T` → `T`). Used by `T.$notnull`.
    fn get_non_nullable() Type {
        if this.kind != TYPE.nullable : return this
        let sub = this.get_sub_type()
        if isset(sub) : return sub
        return this
    }

    // Class backing this type when known (unwraps nullable / inline / one ptr-ref layer).
    fn get_class_or_null() ?Class {
        let t = this.get_non_nullable()
        let c = t.class
        if isset(c) : return c
        if t.kind != TYPE.ptr_of && t.kind != TYPE.ref_of : return null
        let sub = t.get_sub_type()
        return isset(sub) ? sub.get_class_or_null() : null
    }

    fn get_direct_class_or_null() ?Class {
        return this.get_non_nullable().class
    }

    // True if this type is nullable (`?T`). Used by `T.$is_nullable`.
    fn is_nullable_type() bool {
        return this.kind == TYPE.nullable
    }

    fn is_tuple_type() bool {
        return this.kind == TYPE.struct && this.is_inline && !isset(this.class) && isset(this.get_members())
    }

    fn is_fixed_array_type() bool {
        return this.kind == TYPE.fixed_array
    }

    // True if values of this type are stored inline (not a pointer-sized reference).
    // Used by compile-time meta-properties such as `T.$is_inline`.
    fn is_inline_type() bool {
        let t = this.kind
        if this.is_inline || t == TYPE.union : return true
        if t == TYPE.int || t == TYPE.float || t == TYPE.bool : return true
        if t == TYPE.closure : return true
        if t == TYPE.voidptr || t == TYPE.gcptr || t == TYPE.ptr_of || t == TYPE.ref_of
            || t == TYPE.fnptr || t == TYPE.co || t == TYPE.any || t == TYPE.void {
            return false
        }
        if t == TYPE.nullable {
            let sub = this.get_sub_type()
            if isset(sub) : return sub.is_inline_type()
            return false
        }
        let c = this.class
        if isset(c) {
            let kind = c.representation_class().kind
            if kind == CLASS_KIND.struct : return this.is_inline
            if kind == CLASS_KIND.integer || kind == CLASS_KIND.float || kind == CLASS_KIND.boolean : return true
            // class / slice / mode / pointer are reference types
            return false
        }
        return false
    }

    fn is_void_type() bool {
        return this.get_non_nullable().kind == TYPE.void
    }

    fn is_number_kind(type: TYPE, class_kind: CLASS_KIND) bool {
        let t = this.get_non_nullable()
        if t.kind == type : return true
        let c = t.class
        return isset(c) && c.representation_class().kind == class_kind
    }

    fn is_integer_type() bool {
        return this.is_number_kind(TYPE.int, CLASS_KIND.integer)
    }

    fn is_float_type() bool {
        return this.is_number_kind(TYPE.float, CLASS_KIND.float)
    }

    fn is_bool_type() bool {
        return this.is_number_kind(TYPE.bool, CLASS_KIND.boolean)
    }

    // Signed integer (or other class with `signed` set).
    fn is_signed_type() bool {
        let c = this.get_direct_class_or_null()
        if isset(c) : return c.signed
        return false
    }

    // struct or class (layout-bearing object types).
    fn is_structural_type() bool {
        let c = this.get_direct_class_or_null()
        if !isset(c) : return false
        let kind = c.representation_class().kind
        return kind == CLASS_KIND.struct || kind == CLASS_KIND.class
    }

    fn is_struct_object() bool {
        let c = this.get_direct_class_or_null()
        return isset(c) && c.representation_class().kind == CLASS_KIND.struct && !this.is_inline
    }

    // GC-managed object reference.
    //
    // A bare named class type is the language's managed pointer to that
    // object's storage. Structs are inline values; pointer/reference wrappers
    // are raw addresses or borrows:
    //
    //   MyClass  GC-managed object reference
    //   MyStruct inline value
    //   *T       explicit/raw pointer to T
    //   &T       borrowed reference to T
    //
    // The legacy compiler represented the first case as TYPE.ptr_of(TYPE.gcptr).
    // The rewrite represents it directly as TYPE.gcptr, so do not recursively
    // inherit GC-ness through TYPE.ptr_of / TYPE.ref_of.
    fn is_gc_type() bool {
        let t = this.get_non_nullable()
        if t.is_inline : return false
        // A coroutine handle is represented by a managed `coro:Coro` object
        // even though it has its own surface type. Containers and locals that
        // hold `co` values must therefore trace/root the pointer just like a
        // class reference.
        if t.kind == TYPE.co : return true
        if t.kind == TYPE.array || t.kind == TYPE.slice : return !t.is_inline
        if t.kind != TYPE.gcptr && t.kind != TYPE.struct : return false
        let c = t.class
        if !isset(c) : return false
        let kind = c.representation_class().kind
        if kind == CLASS_KIND.class || kind == CLASS_KIND.interface || kind == CLASS_KIND.slice || kind == CLASS_KIND.array : return true
        return false
    }

    // True when a value's representation contains one or more managed
    // pointers. Unlike is_gc_type(), this also covers by-value aggregates such
    // as closures, inline objects, fixed arrays, and tagged unions.
    // Asked for nearly every resolved value and every field an IR walk visits,
    // and answering it walks the whole aggregate.
    fn has_gc_refs() bool {
        let cache = this.get_cache()
        if cache.has_gc_refs_known : return cache.cached_has_gc_refs
        let result = this.compute_has_gc_refs()
        cache.cached_has_gc_refs = result
        cache.has_gc_refs_known = true
        return result
    }

    fn compute_has_gc_refs() bool {
        if this.is_gc_type() : return true
        let t = this.get_non_nullable()
        if t.kind == TYPE.closure : return true
        if t.kind == TYPE.union || (t.kind == TYPE.struct && t.is_inline && !isset(t.class)) {
            let members = t.get_members()
            if !isset(members) : return false
            each members as member {
                if member.has_gc_refs() : return true
            }
            return false
        }
        if t.is_fixed_array_type() {
            let sub = t.get_sub_type()
            return isset(sub) && t.length > 0 && sub.has_gc_refs()
        }
        if !t.is_inline : return false
        let class = t.get_class_or_null()
        if !isset(class) : return false
        each class.props as prop {
            if prop.type.has_gc_refs() : return true
        }
        return false
    }

    // Maximum number of simultaneous GC roots held by this value. A tagged
    // union uses the maximum alternative count because exactly one tag is
    // active; ordinary aggregates sum their independent fields.
    fn gc_root_count() uint !Error {
        let cache = this.get_cache()
        if cache.gc_root_count_known : return cache.cached_gc_root_count
        let count = this.compute_gc_root_count() !>
        cache.cached_gc_root_count = count
        cache.gc_root_count_known = true
        return count
    }

    fn compute_gc_root_count() uint !Error {
        if this.is_gc_type() : return 1
        let t = this.get_non_nullable()
        if t.kind == TYPE.closure : return 1
        if t.kind == TYPE.union {
            let members = t.get_members()
            if !isset(members) : return 0
            let largest: uint = 0
            each members as member {
                let count = member.gc_root_count() !>
                if count > largest : largest = count
            }
            return largest
        }
        if t.is_fixed_array_type() {
            let sub = t.get_sub_type()
            if !isset(sub) : return 0
            return (sub.gc_root_count() !>) * t.length
        }
        if t.kind == TYPE.struct && t.is_inline && !isset(t.class) {
            let members = t.get_members()
            if !isset(members) : return 0
            let count: uint = 0
            each members as member : count += member.gc_root_count() !>
            return count
        }
        if !t.is_inline : return 0
        let class = t.get_class_or_null()
        if !isset(class) : return 0
        let count: uint = 0
        each class.props as prop : count += prop.type.gc_root_count() !>
        return count
    }

    // Bare `ptr` (CLASS_KIND.pointer / void-style pointer), not `*T`.
    fn is_raw_pointer() bool {
        let t = this.get_non_nullable()
        if t.kind == TYPE.voidptr : return true
        if t.kind == TYPE.ptr_of || t.kind == TYPE.ref_of : return false
        // Named pointer classes such as `cstring` have the same raw pointer
        // representation and can fall back to pointer compatibility after
        // conversion hooks have had a chance to run.
        let c = t.class
        return isset(c) && c.kind == CLASS_KIND.pointer
    }

    // True if a `_VTABLE` property is already present on the class.
    fn has_vtable() bool {
        let c = this.get_direct_class_or_null()
        if !isset(c) : return false
        each c.props as prop {
            let n = prop.name
            if isset(n) && n == "_VTABLE" : return true
        }
        return false
    }

    fn is_same_type(other: Type) bool {
        if this.is_shared != other.is_shared : return false
        let ca = this.compat_class()
        let cb = other.compat_class()
        if isset(ca) || isset(cb) : return isset(ca) && isset(cb) && ca == cb
        return type_identity_key(this) == type_identity_key(other)
    }

    // Class used for identity checks — unwraps `mode X for Y` to Y.
    fn compat_class() ?Class {
        let c = this.get_direct_class_or_null()
        if !isset(c) : return null
        return c.representation_class()
    }

    // True for integer / float / bool (including class-backed number types).
    fn is_number_type() bool {
        return this.is_integer_type() || this.is_float_type() || this.is_bool_type()
    }

    // Byte size used for number compatibility (no full layout walk).
    // `*` integer/float sizes use pointer size.
    fn number_byte_size() u32 {
        let t = this.get_non_nullable()
        let c = t.class
        if isset(c) {
            let kind = c.kind
            if kind == CLASS_KIND.integer || kind == CLASS_KIND.float {
                let s = c.number_size
                if s == 0 : return t.ptr_size()
                return s
            }
            if kind == CLASS_KIND.boolean : return 1
        }
        if t.kind == TYPE.bool : return 1
        // Bare TYPE.int / float without class — treat as pointer-sized host int
        if t.kind == TYPE.int || t.kind == TYPE.float : return t.ptr_size()
        // Fallback: cached/compute size when available
        let s = t.byte_size() ! return 0
        return s
    }

    fn compat_inner(other: Type) bool {
        let own = this.get_sub_type() ?! return false
        let theirs = other.get_sub_type() ?! return false
        return own.compat(theirs)
    }

    fn compat_optional_inner(other: Type) bool {
        let own = this.get_sub_type()
        let theirs = other.get_sub_type()
        if !isset(own) || !isset(theirs) : return true
        return own.compat(theirs)
    }

    fn compat_pointer_inner(other: Type) bool {
        let own = this.get_sub_type() ?! return false
        let theirs = other.get_sub_type() ?! return false
        return own.compat(theirs)
    }

    fn compat_pointer(other: Type) bool {
        if !this.compat_min_length(other) : return false
        return this.compat_pointer_inner(other)
    }

    fn compat_array(other: Type) bool {
        if !this.compat_min_length(other) : return false
        return this.compat_inner(other)
    }

    fn compat_min_length(other: Type) bool {
        return this.length == 0 || (other.length > 0 && this.length <= other.length)
    }

    fn compat_multi(other: Type) bool {
        let own = this.get_members() ?! return false
        let theirs = other.get_members() ?! return false
        if own.length != theirs.length : return false
        each own as member, i {
            let other_member = theirs.get(i) ! return false
            if !member.compat(other_member) : return false
        }
        return true
    }

    fn compat_callable(other: Type) bool {
        let own_info = this.get_function_info()
        let their_info = other.get_function_info()
        if !isset(own_info) || !isset(their_info) : return !isset(own_info) && !isset(their_info)
        if !this.type_arrays_compatible(their_info.args, own_info.args) : return false
        if !this.type_arrays_compatible(own_info.returns, their_info.returns) : return false
        let expected_error = own_info.error_type
        let actual_error = their_info.error_type
        if !isset(actual_error) : return true
        return isset(expected_error) && expected_error.is_compat(actual_error)
    }

    fn type_arrays_compatible(expected: Array[Type], actual: Array[Type]) bool {
        if expected.length != actual.length : return false
        each expected as type, i {
            let other = actual.get(i) ! return false
            if !type.compat(other) : return false
        }
        return true
    }

    fn single_multi_member() Type !LookupError {
        if this.kind != TYPE.struct || !this.is_inline || isset(this.class) : throw .missing
        let members = this.get_members() ?! throw .missing
        if members.length != 1 : throw .missing
        return members.get(0) !>
    }

    fn compat_different_kind(other: Type) bool {
        if this.kind == TYPE.struct && this.is_inline && !isset(this.class) {
            let own = this.single_multi_member() !? null
            if isset(own) : return own.compat(other)
        }
        if other.kind == TYPE.struct && other.is_inline && !isset(other.class) {
            let theirs = other.single_multi_member() !? null
            if isset(theirs) : return this.compat(theirs)
        }
        if (this.kind == TYPE.ptr_of && other.kind == TYPE.ref_of)
            || (this.kind == TYPE.ref_of && other.kind == TYPE.ptr_of)
        {
            return this.compat_pointer(other)
        }
        let own_class = this.compat_class()
        let other_class = other.compat_class()
        return isset(own_class) && isset(other_class) && own_class == other_class
    }

    fn compat_same_kind(other: Type) bool {
        let own_enum = this.get_enum()
        if isset(own_enum) && own_enum != other.get_enum() : return false

        let t = this.kind
        if this.is_inline != other.is_inline : return false
        if t == TYPE.ptr_of || t == TYPE.ref_of : return this.compat_pointer(other)
        if t == TYPE.nullable : return this.compat_inner(other)
        if t == TYPE.fixed_array : return this.length == other.length && this.compat_inner(other)
        if t == TYPE.slice && (this.is_fixed_array_type() || other.is_fixed_array_type()) : return this.compat_array(other)
        if t == TYPE.slice && !this.compat_min_length(other) : return false
        if t == TYPE.struct && this.is_inline && !isset(this.class) : return this.compat_multi(other)
        if t == TYPE.closure || t == TYPE.fnptr : return this.compat_callable(other)
        if t == TYPE.co : return this.compat_callable(other)
        if t == TYPE.error_code : return this.get_error_type() == other.get_error_type()

        let own_class = this.compat_class()
        let other_class = other.compat_class()
        if !isset(own_class) && !isset(other_class) : return true
        if isset(own_class) && own_class.kind == CLASS_KIND.interface {
            return isset(other_class) && class_implements_interface(other_class, own_class)
        }
        return own_class == other_class
    }

    // Can a value of type `other` be passed where `this` is expected?
    fn compat(other: Type) bool {
        if this == other : return true
        if this.kind == TYPE.any || other.kind == TYPE.any : return true

        let base = this
        let typ = other
        if base.is_nullable_type() && !typ.is_nullable_type() : base = base.get_non_nullable()
        if base.is_nullable_type() {
            if !typ.is_nullable_type() : return false
            return base.compat_inner(typ)
        }
        if typ.is_nullable_type() : return false

        if base.is_shared != typ.is_shared : return false

        if base.kind == TYPE.union {
            if typ.kind == TYPE.union : return base.union_accepts_union(typ)
            return isset(base.union_member_index(typ) !? null)
        }
        if typ.kind == TYPE.union : return false

        if base.is_raw_pointer() {
            return typ.is_raw_pointer() || typ.kind == TYPE.ptr_of || typ.kind == TYPE.ref_of
                || typ.is_struct_object() || typ.is_integer_type()
        }
        if typ.is_raw_pointer() {
            return base.kind == TYPE.ptr_of || base.kind == TYPE.ref_of || base.is_struct_object() || base.is_integer_type()
        }
        if base.is_number_type() && typ.is_number_type() : return base.compat_numbers(typ)
        if base.kind != typ.kind : return base.compat_different_kind(typ)
        return base.compat_same_kind(typ)
    }

    // Number-only branch of compat: same kind family + same byte size.
    // e.g. int/i32/u32 of equal width are compatible; float widths must match.
    // (Signedness is not required — only storage size.)
    fn compat_numbers(other: Type) bool {
        let a = this.get_non_nullable()
        let b = other.get_non_nullable()

        if a.is_bool_type() || b.is_bool_type() {
            return a.is_bool_type() && b.is_bool_type()
        }
        if a.is_float_type() || b.is_float_type() {
            if !a.is_float_type() || !b.is_float_type() : return false
            return a.number_byte_size() == b.number_byte_size()
        }
        // integers — size only
        if !a.is_integer_type() || !b.is_integer_type() : return false
        return a.number_byte_size() == b.number_byte_size()
    }

    // Report incompatible types at `at` (expected = this, got = other).
    fn compat_check(other: Type, at: Exp) !Error {
        if this.compat(other) : return
        at.error("Incompatible types. Expected '" + this.compat_display_name() + "', got '" + other.compat_display_name() + "'")
    }

    fn compat_display_name() String {
        let cache = this.get_cache()
        let cached = cache.cached_display_name
        if isset(cached) : return cached
        let name = this.compute_compat_display_name()
        cache.cached_display_name = name
        return name
    }

    fn compute_compat_display_name() String {
        let prefix = this.is_shared ? "shared " : ""
        // Class-backed types: always prefer pretty name (`Array[String]`, not mangled id)
        let c = this.class
        if isset(c) {
            if c.representation_class().kind == CLASS_KIND.struct {
                return prefix + (this.is_inline ? "" : "*") + c.pretty_name()
            }
            if this.kind == TYPE.slice && this.length > 0 {
                let sub = this.get_sub_type()
                if isset(sub) : return prefix + "slice[" + sub.compat_display_name() + " x " + this.length + "]"
            }
            if c.kind == CLASS_KIND.unbound && this.length > 0 {
                return prefix + c.pretty_name() + "[x " + this.length + "]"
            }
            // Type-info forms keep their element hint and fixed size.
            let sub = this.get_sub_type()
            if c.kind == CLASS_KIND.pointer && isset(sub) {
                let n = this.length
                if n > 0 : return prefix + c.pretty_name() + "[" + sub.compat_display_name() + " x " + n + "]"
                return prefix + c.pretty_name() + "[" + sub.compat_display_name() + "]"
            }
            return prefix + c.pretty_name()
        }
        if this.kind == TYPE.void : return "void"
        if this.kind == TYPE.error_code {
            let et = this.get_error_type()
            return isset(et) ? et.name : "error_code"
        }
        if this.kind == TYPE.any : return "any"
        if this.kind == TYPE.nullable {
            let sub = this.get_sub_type()
            if isset(sub) : return type_wrapped_display("?", sub)
            return "?"
        }
        if this.kind == TYPE.ptr_of {
            let sub = this.get_sub_type()
            if isset(sub) {
                if this.length > 0 : return "*[" + sub.compat_display_name() + " x " + this.length + "]"
                return type_wrapped_display("*", sub)
            }
            return "*"
        }
        if this.kind == TYPE.ref_of {
            let sub = this.get_sub_type()
            if isset(sub) : return type_wrapped_display("&", sub)
            return "&"
        }
        if this.kind == TYPE.fixed_array {
            let sub = this.get_sub_type()
            return isset(sub) ? "[" + sub.compat_display_name() + " x " + this.length + "]" : "[]"
        }
        if this.kind == TYPE.array {
            let sub = this.get_sub_type()
            return isset(sub) ? "array[" + sub.compat_display_name() + "]" : "array[]"
        }
        if this.kind == TYPE.voidptr : return "*"
        if this.kind == TYPE.slice {
            let sub = this.get_sub_type()
            if isset(sub) {
                let n = this.length
                if n > 0 : return "slice[" + sub.compat_display_name() + " x " + n + "]"
                return "slice[" + sub.compat_display_name() + "]"
            }
            return "slice[]"
        }
        if this.kind == TYPE.struct && this.is_inline && !isset(this.class) {
            let subs = this.get_members()
            if isset(subs) {
                let parts = Array[String]{}
                each subs as st {
                    parts.append(st.compat_display_name())
                }
                return "(" + parts.join(", ") + ")"
            }
            return "()"
        }
        if this.kind == TYPE.union {
            let subs = this.get_members()
            if isset(subs) {
                let parts = Array[String]{}
                each subs as st : parts.append(st.compat_display_name())
                return parts.join(" | ")
            }
            return "union"
        }
        if this.kind == TYPE.closure || this.kind == TYPE.fnptr {
            let name = this.kind == TYPE.closure ? "fn" : "fnptr"
            let func_info = this.get_function_info()
            let parts = Array[String]{}
            if isset(func_info) {
                each func_info.args as at : parts.append(at.compat_display_name())
            }
            let rett_name = "()"
            if isset(func_info) && func_info.returns.length > 0 {
                let return_parts = Array[String]{}
                each func_info.returns as rett : return_parts.append(rett.compat_display_name())
                rett_name = "(" + return_parts.join(", ") + ")"
            }
            let result = prefix + name + "(" + parts.join(", ") + ")" + rett_name
            let error_type = this.get_error_type()
            if isset(error_type) : result += "!" + error_type.name
            return result
        }
        if this.kind == TYPE.co {
            let info = this.get_function_info()
            let parts = Array[String]{}
            if isset(info) {
                each info.returns as rett : parts.append(rett.compat_display_name())
            }
            let result = prefix + "co(" + parts.join(", ") + ")"
            let error_type = this.get_error_type()
            if isset(error_type) : result += "!" + error_type.name
            return result
        }
        return "type"
    }

    fn has_method(name: String) bool {
        // Non-null function values expose `.clone()` via the env `$clone` header.
        // Nullable `?fn` is handled by `$clone` / clone_value's null check.
        if name == "clone" && this.kind == TYPE.closure : return true
        let class = this.get_direct_class_or_null()
        if !isset(class) : return false
        return isset(class.get_func(name))
    }

    // True if a structural copy of this type would share a raw pointer field.
    // Used by clone_value to fall back to a shallow copy instead of erroring.
    fn has_raw_pointer_props() bool {
        let class = this.get_direct_class_or_null()
        if !isset(class) : return false
        if class.kind != CLASS_KIND.struct && class.kind != CLASS_KIND.class : return false
        each class.props as prop {
            if prop.type.is_raw_pointer() : return true
            // Inline aggregates embed their fields in this object.
            if prop.type.get_non_nullable().is_inline && prop.type.has_raw_pointer_props() {
                return true
            }
        }
        return false
    }

    // True if a value of this type can convert (via `compat` or a `$to` hook) to `other`.
    fn can_convert_to(other: Type) bool {
        let a = this.get_non_nullable()
        let b = other.get_non_nullable()
        // Dynamic conversion of an active union alternative is not supported.
        // Claiming the union can convert merely because it accepts `other`
        // would instantiate invalid generic methods.
        if a.kind == TYPE.union {
            return b.kind == TYPE.union && a.union_accepts_union(b)
        }
        let source_class = a.get_class_or_null()
        let target_class = b.get_class_or_null()
        if isset(source_class) && source_class.kind == CLASS_KIND.class
            && isset(target_class) && target_class.kind == CLASS_KIND.interface
            && class_implements_interface(source_class, target_class)
        {
            return true
        }
        // Same type or already assignable counts as a free conversion
        if a.compat(b) : return true
        let class = source_class
        if !isset(class) : return false
        let hook = class_get_to_hook(class, b, false)
        return isset(hook)
    }

    // ?T — cached on this type
    fn nullable() Type {
        // Nullability is idempotent: `?T` and `??T` describe the same type.
        // This matters for named unions that already include `null`, such as
        // json:Value, when a caller writes `?json:Value` explicitly.
        if this.kind == TYPE.nullable : return this
        let cached = this.cache
        let nullable = isset(cached) ? cached.nullable : null
        if isset(nullable) : return nullable
        let t = Type {
            build: this.build
            kind: TYPE.nullable
            info: UnaryTypeInfo { sub: this }
        }
        this.get_cache().nullable = t
        return t
    }

    // *T — cached on this type
    fn pointer(length: uint (0)) Type {
        let cached = this.cache
        let pointer = isset(cached) ? cached.ptr_of : null
        if length == 0 && isset(pointer) : return pointer
        let t = Type {
            build: this.build
            kind: TYPE.ptr_of
            info: UnaryTypeInfo { sub: this }
            length: length
        }
        if length == 0 : this.get_cache().ptr_of = t
        return t
    }

    // &T — cached on this type
    fn reference() Type {
        let cached = this.cache
        let ref = isset(cached) ? cached.ref_of : null
        if isset(ref) : return ref
        let t = Type {
            build: this.build
            kind: TYPE.ref_of
            info: UnaryTypeInfo { sub: this }
        }
        this.get_cache().ref_of = t
        return t
    }

    // Cached aggregate representation.
    fn inline() Type !Error {
        let cached = this.cache
        let inline = isset(cached) ? cached.inline : null
        if isset(inline) : return inline
        if this.kind != TYPE.array && this.kind != TYPE.slice && this.kind != TYPE.struct {
            this.build.bug("Type does not have an inline representation")
        }
        let t = Type {
            build: this.build
            class: this.class
            info: this.info
            length: this.length
            kind: this.kind
            unsigned: this.unsigned
            is_inline: true
            is_shared: this.is_shared
        }
        this.get_cache().inline = t
        t.get_cache().non_inline = this
        return t
    }

    fn non_inline() Type {
        if !this.is_inline : return this
        let cached = this.cache
        let non_inline = isset(cached) ? cached.non_inline : null
        if isset(non_inline) : return non_inline
        let t = Type {
            build: this.build
            class: this.class
            info: this.info
            length: this.length
            kind: this.kind
            unsigned: this.unsigned
            is_shared: this.is_shared
        }
        this.get_cache().non_inline = t
        t.get_cache().inline = this
        return t
    }

    fn array() Type {
        let cached = this.cache
        let array = isset(cached) ? cached.array : null
        if isset(array) : return array
        let t = Type {
            build: this.build
            kind: TYPE.array
            info: UnaryTypeInfo { sub: this }
        }
        this.get_cache().array = t
        return t
    }

    fn slice(length: uint (0)) Type {
        let cached = this.cache
        let slice = isset(cached) ? cached.slice : null
        if !isset(slice) {
            slice = Type {
                build: this.build
                kind: TYPE.slice
                info: UnaryTypeInfo { sub: this }
            }
            this.get_cache().slice = slice
        }
        if length == 0 : return slice
        return Type {
            build: slice.build
            kind: TYPE.slice
            info: slice.info
            length: length
        }
    }

    fn fixed_array(length: uint) Type {
        return Type {
            build: this.build
            kind: TYPE.fixed_array
            info: UnaryTypeInfo { sub: this }
            length: length
            is_inline: true
        }
    }

    // Exact alternative lookup. Union construction deliberately uses type
    // identity rather than broad representation compatibility: otherwise a
    // value could silently select the wrong tag in unions such as int | uint.
    fn union_member_index(other: Type) uint !LookupError {
        let t = this.get_non_nullable()
        if t.kind != TYPE.union : throw .missing
        let members = t.get_members() ?! throw .missing
        let key = type_identity_key(other.get_non_nullable())
        let first: uint = 0
        let after = members.length
        while first < after {
            let i = first + (after - first) / 2
            let member_key = type_identity_key(members.get(i) !>)
            if member_key == key : return i
            if member_key < key : first = i + 1
            else : after = i
        }
        throw .missing
    }

    fn union_accepts_union(other: Type) bool {
        let own_class = this.get_non_nullable().class
        let other_class = other.get_non_nullable().class
        if isset(own_class) || isset(other_class) {
            return isset(own_class) && isset(other_class) && own_class == other_class
        }
        let members = other.get_non_nullable().get_members()
        if !isset(members) : return false
        let own = this.get_non_nullable().get_members()
        if !isset(own) : return false
        if own.length != members.length : return false
        each own as member, i {
            let other_member = members.get(i) ! return false
            if type_identity_key(member) != type_identity_key(other_member) : return false
        }
        return true
    }
}

fn type_wrapped_display(prefix: String, sub: Type) String {
    let name = sub.compat_display_name()
    return sub.get_non_nullable().kind == TYPE.union ? prefix + "(" + name + ")" : prefix + name
}

// ---- Build-level singleton types ----

////////////////////////////
// Type constructors
////////////////////////////

fn type_void(b: Build) Type {
    let cache = b.cache.type_void
    if isset(cache) : return cache
    let t = Type {
        build: b
        kind: TYPE.void
    }
    b.cache.type_void = t
    return t
}

// Multi-return / multi-value type `(T, U, …)`. Single element (unless force) folds to that type.
fn type_multi(b: Build, types: Array[Type], force_multi: bool (false)) Type {
    if types.length == 0 && !force_multi : return type_void(b)
    if types.length == 1 && !force_multi {
        return types.get(0) !? type_void(b)
    }
    return Type {
        build: b
        kind: TYPE.struct
        info: UnionTypeInfo { members: types }
        is_inline: true
    }
}

fn type_identity_key(type: Type) String {
    let cache = type.get_cache()
    let cached = cache.cached_identity_key
    if isset(cached) : return cached
    let out = ByteBuffer.new()
    type_append_key(type, out)
    let key = out.to_string()
    cache.cached_identity_key = key
    return key
}

// Normalize a structural tagged union: flatten nested unions, lift nullable
// members to the whole union, remove exact duplicates, and sort by stable type
// identity so A | B and B | A use the same runtime tag ordering.
fn type_union(b: Build, input: Array[Type], at: Exp, owner: ?Class (null)) Type !Error {
    let members = Array[Type]{}
    let nullable = false

    each input as original {
        let member = original
        if member.is_nullable_type() {
            nullable = true
            member = member.get_non_nullable()
        }
        // Anonymous unions are structural and flatten into a surrounding union.
        // A named union is one nominal alternative and retains its own tag/identity.
        if member.kind == TYPE.union && !isset(member.class) {
            let nested = member.get_members()
            if isset(nested) {
                each nested as item : members.append(item)
            }
        } else {
            if member.is_void_type() : at.error("A union cannot contain void")
            if member.kind == TYPE.any : at.error("A union cannot contain any")
            // Every statically-sized value can be a union alternative. Values
            // are copied into the union's shared inline payload; layout
            // resolution is deferred until all class bodies have been parsed.
            members.append(member)
        }
    }

    members.sort(fn(a: Type, b: Type) bool {
        return type_identity_key(a) > type_identity_key(b)
    })
    let sorted = Array[Type]{}
    let previous = ""
    let first = true
    each members as member {
        let key = type_identity_key(member)
        if !first && key == previous : continue
        sorted.append(member)
        previous = key
        first = false
    }

    if sorted.length == 0 : at.error("A union must contain at least one type")
    if sorted.length > 256 : at.error("A union cannot contain more than 256 types")
    if sorted.length == 1 && !isset(owner) {
        let only = sorted.get(0) !? type_void(b)
        return nullable ? only.nullable() : only
    }
    let result = Type {
        build: b
        kind: TYPE.union
        info: UnionTypeInfo { members: sorted }
        class: owner
    }
    if nullable {
        let wrapped = result.nullable()
        if isset(owner) : wrapped.class = owner
        return wrapped
    }
    return result
}

fn type_union_from_exp(exp: Exp, scope: Scope, owner: ?Class (null)) Type !Error {
    let members = Array[Type]{}
    let has_null = false
    let i: uint = 0
    while true {
        let member_exp = exp.get(i)
        if !isset(member_exp) : break
        if member_exp.kind == TYPE_KIND.null {
            has_null = true
        } else {
            members.append(type_from_exp(member_exp, scope) !>)
        }
        i++
    }

    let b = exp.src.build
    if isset(owner) : b = owner.ns.build
    let result = type_union(b, members, exp, owner) !>
    if has_null && !result.is_nullable_type() {
        let wrapped = result.nullable()
        if isset(owner) : wrapped.class = owner
        return wrapped
    }
    return result
}

// Resolve a named union without collapsing its final non-null alternative.
fn type_named_union(owner: Class, exp: Exp) Type !Error {
    if exp.type != EXP.type || exp.kind != TYPE_KIND.union {
        exp.bug("Named union alternatives are not a union type expression")
    }
    return type_union_from_exp(exp, owner.scope, owner) !>
}

fn type_any(b: Build) Type {
    let cache = b.cache.type_any
    if isset(cache) : return cache
    let t = Type {
        build: b
        kind: TYPE.any
    }
    b.cache.type_any = t
    return t
}

// Primitive types (no Class). Used before valk:core classes are registered.
fn type_prim_int(b: Build) Type {
    let cache = b.cache.type_prim_int
    if isset(cache) : return cache
    let t = Type {
        build: b
        kind: TYPE.int
    }
    b.cache.type_prim_int = t
    return t
}

fn type_prim_string(b: Build) Type {
    let cache = b.cache.type_prim_string
    if isset(cache) : return cache
    let t = Type {
        build: b
        kind: TYPE.gcptr
    }
    b.cache.type_prim_string = t
    return t
}

fn type_prim_bool(b: Build) Type {
    let cache = b.cache.type_prim_bool
    if isset(cache) : return cache
    let t = Type {
        build: b
        kind: TYPE.bool
    }
    b.cache.type_prim_bool = t
    return t
}

////////////////////////////
// Named core types
////////////////////////////

// Look up a class by name in valk:core (always loaded in Build.run) and return its Type.
// Results are cached on BuildCache.core_types by name. Missing classes are a compiler bug.
fn type_from_core(b: Build, name: String) Type !Error {
    let cached = b.cache.core_types.get(name) !? null
    if isset(cached) : return cached

    let idf = valk_idf(b, "core", name) !>
    if idf.type != IDF.class : b.bug("Identifier in valk:core is not a class: " + name)
    let c = idf.class
    if !isset(c) : b.bug("Class idf is missing class for: " + name)
    let t = c.get_type() !>
    b.cache.core_types.set(name, t)
    return t
}

// Look up a concrete class in a namespace from the built-in `valk` package.
fn type_from_valk_namespace(b: Build, ns_name: String, name: String) Type !Error {
    let idf = valk_idf(b, ns_name, name) !>
    if idf.type != IDF.class : b.bug("Identifier in valk:" + ns_name + " is not a class: " + name)
    let c = idf.class
    if !isset(c) : b.bug("Class idf is missing class for: " + ns_name + ":" + name)
    return c.get_type() !>
}

// Soft core lookup: returns null if the class is not registered yet (no error).
fn type_from_core_or_null(b: Build, name: String) ?Type {
    let cached = b.cache.core_types.get(name) !? null
    if isset(cached) : return cached

    // $global core classes live on Build.scope once parse_class_exp has run
    let idf = b.scope.get_idf(name)
    if !isset(idf) : return null
    if idf.type != IDF.class : return null
    let c = idf.class
    if !isset(c) : return null
    if c.is_generic_base : return null
    let t = c.get_type() ! return null
    b.cache.core_types.set(name, t)
    return t
}

// Prefer real core class; fall back to primitive stand-in before core is parsed.
fn type_int(b: Build) Type {
    let t = type_from_core_or_null(b, "int")
    if isset(t) : return t
    return type_prim_int(b)
}
fn type_float(b: Build) Type !Error {
    return type_from_core(b, "float") !>
}
fn type_bool(b: Build) Type {
    let t = type_from_core_or_null(b, "bool")
    if isset(t) : return t
    return type_prim_bool(b)
}

fn type_i64(b: Build) Type {
    let t = type_from_core_or_null(b, "i64")
    if isset(t) : return t
    return type_prim_int(b)
}

fn type_u8(b: Build) Type {
    return type_from_core_or_null(b, "u8") ?? type_prim_int(b)
}

// Raw byte storage: the untyped payload slot of a union and the padding
// between a nullable's presence flag and its value.
fn type_byte_array(b: Build, size: u32) Type {
    let key = size.to_str()
    let cached = b.cache.byte_array_types.get(key) !? null
    if isset(cached) : return cached
    let sub = type_from_core_or_null(b, "u8") ?? type_prim_int(b)
    let t = Type {
        build: b
        kind: TYPE.fixed_array
        info: UnaryTypeInfo { sub: sub }
        length: size.to(uint)
        is_inline: true
    }
    b.cache.byte_array_types.set(key, t)
    return t
}
fn type_string(b: Build) Type {
    let t = type_from_core_or_null(b, "String")
    if isset(t) : return t
    return type_prim_string(b)
}

// `.code` / `TypeName.code` (is_instance false) or a caught-error binding `E` (true).
fn type_error_code(et: ErrorType, is_instance: bool (false)) Type {
    return Type {
        build: et.ns.build
        kind: TYPE.error_code
        info: et
        error_is_instance: is_instance
    }
}

// Raw `ptr` (void-style pointer class from core, or a bare TYPE.voidptr stand-in).
fn type_ptr(b: Build) Type {
    let t = type_from_core_or_null(b, "ptr")
    if isset(t) : return t
    let cache = b.cache.type_prim_ptr
    if isset(cache) : return cache
    let prim = Type {
        build: b
        kind: TYPE.voidptr
    }
    b.cache.type_prim_ptr = prim
    return prim
}

fn type_ptr_of(b: Build, sub: Type) Type {
    let base = type_ptr(b)
    return Type {
        build: b
        kind: TYPE.ptr_of
        class: base.class
        info: UnaryTypeInfo { sub: sub }
    }
}

fn type_from_inner_exp(exp: Exp, scope: Scope, missing: String) Type !Error {
    let inner = exp.get(TYPE_EXP.type)
    if !isset(inner) : exp.bug(missing)
    return type_from_exp(inner, scope) !>
}

fn type_error_from_exp(exp: Exp, scope: Scope) ?ErrorType !Error {
    let err_exp = exp.get(TYPE_EXP.error)
    if !isset(err_exp) : return null
    let idf = resolve_idf_from_id(err_exp, scope) !>
    if idf.type != IDF.error_type : err_exp.error("Identifier must be an error type")
    let error_type = idf.error_type
    if !isset(error_type) : err_exp.bug("Error-type idf is missing error_type")
    return error_type
}

fn type_validate_sequence_element(sub: Type, at: Exp) !Error {
    if sub.is_void_type() : at.error("Sequence element type cannot be void")
}

fn type_callable_from_exp(exp: Exp, scope: Scope, kind: TYPE) Type !Error {
    let args = Array[Type]{}
    let args_exp = exp.get(TYPE_EXP.args)
    if kind != TYPE.co && isset(args_exp) {
        args = (type_from_multi_exp(args_exp, scope, true) !>).get_members() ?? Array[Type]{}
        each args as arg {
            if arg.is_void_type() : exp.error("Callable arguments cannot be void")
        }
    }

    let returns = Array[Type]{}
    let rett_exp = exp.get(TYPE_EXP.rett)
    if isset(rett_exp) {
        let rett = type_from_exp(rett_exp, scope) !>
        let members = rett.get_members()
        if rett.kind == TYPE.struct && rett.is_inline && !isset(rett.class) && isset(members) {
            each members as member {
                if member.is_void_type() : exp.error("Callable return lists cannot contain void")
                returns.append(member)
            }
        } else if !rett.is_void_type() {
            returns.append(rett)
        }
    }
    let error_type = type_error_from_exp(exp, scope) !>

    return Type {
        build: exp.src.build
        kind: kind
        info: FunctionTypeInfo {
            args: args
            returns: returns
            error_type: error_type
        }
    }
}

fn type_callable(b: Build, kind: TYPE, args: Array[Type], rett: Type, error_type: ?ErrorType, shared: bool (false)) Type {
    let returns = Array[Type]{}
    let members = rett.get_members()
    if rett.kind == TYPE.struct && rett.is_inline && !isset(rett.class) && isset(members) {
        each members as member : returns.append(member)
    } else if !rett.is_void_type() {
        returns.append(rett)
    }
    return Type {
        build: b
        kind: kind
        info: FunctionTypeInfo {
            args: args
            returns: returns
            error_type: error_type
        }
        is_shared: shared
    }
}

////////////////////////////
// Type expressions
////////////////////////////

// Convert a structured EXP.type into a Type using `scope` for name lookup.
// `.` resolves to `suggested_type` when the surrounding value context provides one.
fn type_validate_struct_gc_storage(type: Type, at: Exp) !Error {
    let class = type_find_unsafe_struct_pointer(type)
    if isset(class) {
        at.error("Struct pointer type '*" + class.pretty_name() + "' contains managed references; store it inline or use a class")
    }
}

fn type_find_unsafe_struct_pointer(type: Type) ?Class {
    let t = type.get_non_nullable()
    if t.kind == TYPE.ptr_of || t.kind == TYPE.ref_of || t.kind == TYPE.voidptr : return null

    let class = t.class
    if !t.is_inline && isset(class) && class.kind == CLASS_KIND.struct {
        if struct_pointer_has_gc(class) : return class
        return null
    }
    if t.kind == TYPE.union || t.is_tuple_type() {
        let members = t.get_members()
        if !isset(members) : return null
        each members as member {
            let unsafe = type_find_unsafe_struct_pointer(member)
            if isset(unsafe) : return unsafe
        }
        return null
    }
    if t.kind == TYPE.array || t.kind == TYPE.slice || t.kind == TYPE.fixed_array {
        let sub = t.get_sub_type()
        return isset(sub) ? type_find_unsafe_struct_pointer(sub) : null
    }
    if t.is_inline && isset(class) {
        each class.props as prop {
            let unsafe = type_find_unsafe_struct_pointer(prop.type)
            if isset(unsafe) : return unsafe
        }
    }
    return null
}

fn struct_graph_has_gc(class: Class, seen: Array[Class]) bool {
    if seen.contains(class) : return false
    seen.append(class)
    each class.props as prop {
        if struct_graph_type_has_gc(prop.type, seen) : return true
    }
    return false
}

fn struct_pointer_has_gc(class: Class) bool {
    if class.struct_gc_known : return class.struct_gc
    let result = struct_graph_has_gc(class, Array[Class]{})
    class.struct_gc = result
    class.struct_gc_known = true
    return result
}

fn struct_graph_type_has_gc(type: Type, seen: Array[Class]) bool {
    let t = type.get_non_nullable()
    if t.kind == TYPE.ptr_of || t.kind == TYPE.ref_of || t.kind == TYPE.voidptr : return false
    if t.is_gc_type() || t.kind == TYPE.closure : return true
    if t.kind == TYPE.union || t.is_tuple_type() {
        let members = t.get_members()
        if !isset(members) : return false
        each members as member {
            if struct_graph_type_has_gc(member, seen) : return true
        }
        return false
    }
    if t.is_fixed_array_type() {
        let sub = t.get_sub_type()
        return isset(sub) && struct_graph_type_has_gc(sub, seen)
    }
    let class = t.class
    if isset(class) && class.kind == CLASS_KIND.struct {
        return struct_graph_has_gc(class, seen)
    }
    return false
}

fn type_from_exp(exp: Exp, scope: Scope, suggested_type: ?Type (null)) Type !Error {
    let build = exp.src.build
    let outer = build.type_parse_depth == 0
    build.type_parse_depth++
    let type = type_from_exp_unchecked(exp, scope, suggested_type) !>
    build.type_parse_depth--
    if outer && type.build.struct_gc_validation_ready {
        type_validate_struct_gc_storage(type, exp) !>
    }
    return type
}

fn type_from_exp_unchecked(exp: Exp, scope: Scope, suggested_type: ?Type (null)) Type !Error {
    if exp.type != EXP.type : exp.bug("Expected EXP.type")
    let kind = exp.kind
    let b = exp.src.build

    if kind == TYPE_KIND.void : return type_void(b)

    if kind == TYPE_KIND.null {
        exp.error("'null' can only be used as an alternative in a tagged union")
    }

    if kind == TYPE_KIND.nullable {
        let inner = type_from_inner_exp(exp, scope, "Missing inner type for '?'") !>
        if inner.is_void_type() : exp.error("'void' cannot be nullable")
        return inner.nullable()
    }

    if kind == TYPE_KIND.shared {
        let inner = type_from_inner_exp(exp, scope, "Missing inner type for 'shared'") !>
        if inner.is_nullable_type() {
            return inner.get_non_nullable().shared_type().nullable()
        }
        return inner.shared_type()
    }

    if kind == TYPE_KIND.ptr {
        let inner = type_from_inner_exp(exp, scope, "Missing inner type for '*'") !>
        if inner.is_void_type() : exp.error("Use 'ptr' for an untyped pointer instead of '*void'")
        if inner.kind == TYPE.fixed_array {
            let element = inner.get_sub_type()
            if !isset(element) : exp.bug("Fixed array type is missing its element type")
            return element.pointer(inner.length)
        }
        if inner.is_inline && inner.kind == TYPE.struct : return inner.non_inline()
        return inner.pointer()
    }
    if kind == TYPE_KIND.ref {
        let inner = type_from_inner_exp(exp, scope, "Missing inner type for '&'") !>
        if inner.is_void_type() : exp.error("You cannot reference a value of type 'void'")
        return inner.reference()
    }

    if kind == TYPE_KIND.inline {
        exp.error("The '<T>' inline type syntax has been removed; struct types are inline by default")
    }

    if kind == TYPE_KIND.notnull {
        let t = type_from_inner_exp(exp, scope, "Missing inner type for notnull") !>
        // Strip one nullable layer if present
        if t.kind == TYPE.nullable {
            let inner = t.get_sub_type()
            if isset(inner) : return inner
        }
        return t
    }

    if kind == TYPE_KIND.typeof {
        // typeof(value) in type position → result type of the value expression
        let val_exp = exp.get(TYPE_EXP.type)
        if !isset(val_exp) : exp.bug("Missing typeof operand")
        let v = value_from_exp(val_exp, scope, Context.for_scope(b, scope)) !>
        return v.rett
    }

    if kind == TYPE_KIND.dynamic_array {
        let sub = type_from_inner_exp(exp, scope, "Missing element type for array") !>
        type_validate_sequence_element(sub, exp) !>
        return sub.array()
    }

    if kind == TYPE_KIND.slice {
        let sub = type_from_inner_exp(exp, scope, "Missing element type for slice") !>
        type_validate_sequence_element(sub, exp) !>
        return sub.slice(resolve_type_size(exp, scope) !>.to(uint))
    }

    if kind == TYPE_KIND.fixed_array {
        let sub = type_from_inner_exp(exp, scope, "Missing element type for fixed array") !>
        type_validate_sequence_element(sub, exp) !>
        return sub.fixed_array(resolve_type_size(exp, scope) !>.to(uint))
    }

    if kind == TYPE_KIND.multi {
        return type_from_multi_exp(exp, scope) !>
    }

    if kind == TYPE_KIND.union {
        return type_union_from_exp(exp, scope) !>
    }

    if kind == TYPE_KIND.fn || kind == TYPE_KIND.fnptr || kind == TYPE_KIND.co {
        let resolved_kind = kind == TYPE_KIND.fn ? TYPE.closure : kind == TYPE_KIND.fnptr ? TYPE.fnptr : TYPE.co
        return type_callable_from_exp(exp, scope, resolved_kind) !>
    }

    if kind == TYPE_KIND.suggested {
        if !isset(suggested_type) {
            exp.error("'.' type is not valid here")
        }
        return suggested_type
    }

    if kind == TYPE_KIND.named {
        return type_from_named_exp(exp, scope) !>
    }

    exp.bug("Unknown type kind: " + kind)
}

fn type_from_multi_exp(exp: Exp, scope: Scope, force_multi: bool (false)) Type !Error {
    let b = exp.src.build
    let types = Array[Type]{}
    let i: uint = 0
    while true {
        let sub = exp.get(i)
        if !isset(sub) : break
        types.append(type_from_exp(sub, scope) !>)
        i++
    }
    if types.length > 1 {
        each types as type {
            if type.is_void_type() : exp.error("Multi-value types cannot contain void")
        }
    }
    return type_multi(b, types, force_multi)
}

fn type_from_named_exp(exp: Exp, scope: Scope) Type !Error {
    let id = exp.get(TYPE_EXP.id)
    if !isset(id) : exp.bug("Named type is missing id")

    let name = id.str1
    let ns_name = id.str2

    // Optional namespace prefix: ns:Name — `ns` must be an IDF.scope from `use`
    let idf: ?Idf = null
    if isset(ns_name) {
        let ns_idf = scope.get_scope_idf(ns_name)
        if !isset(ns_idf) : exp.error("Unknown namespace: " + ns_name)
        let ns_scope = ns_idf.scope
        if !isset(ns_scope) : exp.bug("Scope idf is missing scope")
        // LSP: a type position completes from the same scope as a value position;
        // the client filters out what cannot be a type by the kind we report.
        lsp_complete_scope(id, ns_scope) !>
        idf = ns_scope.get_idf(name)
        if !isset(idf) : exp.error("Unknown type: " + ns_name + ":" + name)
    } else {
        lsp_complete_scope(id, scope) !>
        idf = scope.get_idf(name)
        if !isset(idf) : exp.error("Unknown type: " + name)
    }

    let resolved = idf
    if !isset(resolved) : exp.error("Unknown type: " + name)

    // LSP: jump to the declaration of the named type
    lsp_goto_idf(id, resolved) !>
    // LSP: hover in a type position. Reported before the brackets are applied,
    // so the cursor on `Array` in `Array[String]` describes the base.
    lsp_hover_idf(id, resolved) !>

    // Generic parameter or other bound type (e.g. `T` inside `class Foo[T]`)
    if resolved.type == IDF.type {
        let of_type = resolved.of_type
        if !isset(of_type) : exp.bug("Type idf is missing of_type")
        return of_type
    }

    // Property metadata bound by `#loop properties T as prop` is usable as
    // the property's declared type (`Generic[prop]`, casts, declarations, …).
    if resolved.type == IDF.property {
        let prop = resolved.prop
        if !isset(prop) : exp.bug("Property idf is missing Prop")
        return prop.type
    }

    // enum Name { ... }
    if resolved.type == IDF.enum {
        let enu = resolved.enum
        if !isset(enu) : exp.bug("Enum idf is missing enum")
        act_check(exp, enu.act, enu.exp, false, "enum") !>
        return enu.get_type() !>
    }

    if resolved.type != IDF.class {
        exp.error("Identifier is not a type: " + name)
    }
    let class = resolved.class
    if !isset(class) : exp.bug("Class idf is missing class")
    // Naming a type is an access too. Without this, `let x: PrivateClass` and
    // private types in signatures slip past the value-position check. Internal
    // helpers (type_from_core / type_from_valk_namespace) resolve classes
    // directly and never reach here, so they are unaffected.
    act_check(exp, class.act, class.exp, false, "class") !>

    // Brackets after a named type are generic args or a sequence size `x N`.
    // AST parse always stores the first `[...]` (without `x N`) in TYPE_EXP.generics.
    // Only at resolve time do we know if the class is generic.
    let gens = exp.get(TYPE_EXP.generics)
    let is_sequence = class.kind == CLASS_KIND.array || class.kind == CLASS_KIND.slice || class.kind == CLASS_KIND.unbound

    // Resolve base class type (specialize generics when present)
    if isset(gens) && class.is_generic_base {
        let gtypes = Array[Type]{}
        let i: uint = 0
        while true {
            let g = gens.get(i)
            if !isset(g) : break
            gtypes.append(type_from_exp(g, scope) !>)
            i++
        }
        if is_sequence && gtypes.length > 0 {
            let element = gtypes.get(0) !? type_void(exp.src.build)
            type_validate_sequence_element(element, exp) !>
        }
        class = class.specialize(gtypes, exp) !>
    } else if isset(gens) {
        if is_sequence {
            exp.error("Named sequence type '" + class.pretty_name() + "' already declares its element type; use '" + class.pretty_name() + "[x N]' to specify a length")
        }
        if class.kind == CLASS_KIND.pointer {
            exp.error("Void pointer types cannot have element information; use '*T' instead")
        }
        exp.error("Type is not generic: " + class.name)
    } else if class.is_generic_base {
        exp.error("Generic type '" + class.name + "' requires type arguments")
    }

    let base = class.get_type() !>

    let size_exp = exp.get(TYPE_EXP.size)
    if isset(size_exp) && !is_sequence {
        exp.error("Type '" + class.pretty_name() + "' does not support a length")
    }
    if isset(size_exp) && class.kind == CLASS_KIND.array {
        exp.error("Dynamic array type '" + class.pretty_name() + "' does not support a fixed length")
    }
    if isset(size_exp) {
        let size: u32 = 0
        size = resolve_type_size(exp, scope) !>
        let sub = base.get_sub_type()
        return Type {
            build: base.build
            kind: base.kind
            class: class
            info: isset(sub) ? UnaryTypeInfo { sub: sub } : null
            length: size.to(uint)
            unsigned: base.unsigned
            is_inline: base.is_inline
            is_shared: base.is_shared
        }
    }

    return base
}

// Evaluate TYPE_EXP.size (a value expression) to a non-negative compile-time integer.
fn resolve_type_size(exp: Exp, scope: Scope) u32 !Error {
    let size_exp = exp.get(TYPE_EXP.size)
    if !isset(size_exp) : return 0
    let v = value_from_exp(size_exp, scope, Context.for_scope(exp.src.build, scope)) !>
    if v.type != VAL.int {
        size_exp.error("Type size must be a compile-time integer")
    }
    if v.int_val < 0 {
        size_exp.error("Type size must not be negative")
    }
    if v.int_val == 0 {
        size_exp.error("Type size must be greater than zero")
    }
    if v.int_val > 4294967295 {
        size_exp.error("Type size must not exceed 4294967295")
    }
    return v.int_val.to(u32)
}

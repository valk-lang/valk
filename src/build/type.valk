// Resolved type kind (from EXP.type forms and class kinds).
enum TYPE {
    void
    class      // class / struct / slice / mode / etc. (class field set)
    int
    float
    bool
    ptr        // *T or *[]
    ref        // &T or &[]
    nullable   // ?T
    inline     // <T>
    array      // [T x N]
    multi      // (T, U, ...)
    fn         // fn(...)(...)
    fnptr      // fnptr(...)(...)
    co         // co(...)
    any
    // Error code value: `.code`, `TypeName.code`, or a caught error binding (`E`).
    // error_type identifies which ErrorType; error_is_instance distinguishes a caught
    // error binding (payload fields readable) from a plain comparable code value.
    error_code
}

// Compiler Type object produced from EXP.type (and similar).
//
// Immutable after creation: type-defining fields are never reassigned.
// Only cache_* / size slots may be filled later so wrappers and sizes can be reused.
class Type {
    type: TYPE
    build: Build
    // Linked class when type is a class/struct/integer/float/boolean/pointer/mode
    class: ?Class (null)
    // Linked enum when this Type is an enum (or item type tagged as enum)
    enum: ?Enum (null)
    // TYPE.error_code: which ErrorType, and whether this is a caught-error binding
    // (payload fields readable) vs a plain comparable code value.
    error_type: ?ErrorType (null)
    error_is_instance: bool (false)
    // Wrapper / element type (?, *, &, inline, array, ...)
    sub_type: ?Type (null)
    // Multi / generics / fn args list
    sub_types: ?Array[Type] (null)
    // Fixed array size, or pointer-info size when relevant
    array_size: u32 (0)
    // Display name (e.g. class name)
    custom_name: String ("")
    // True for *[] / &[] forms
    is_slice_ptr: bool (false)
    // ---- size cache (filled once by size()) ----
    cached_size: u32 (0)
    size_known: bool (false)
    size_computing: bool (false) // true while resolving; detects recursive deps
    // ---- wrapper caches (mutable slots; the Type itself stays fixed) ----
    cache_nullable: ?Type (null)
    cache_pointer: ?Type (null)
    cache_ref: ?Type (null)
    cache_inline: ?Type (null)

    // Target pointer size in bytes
    fn ptr_size() u32 {
        return this.build.options.target.ptr_size.to(u32)
    }

    // Byte size of a value of this type. Cached after the first successful resolve.
    // Throws if a class layout cannot be resolved due to recursive dependencies.
    fn size() u32 !Error {
        if this.size_known : return this.cached_size
        if this.size_computing {
            this.build.error("Cannot determine type size due to recursive type dependencies" + this.size_error_label())
        }
        this.size_computing = true
        let s = this.compute_size() !>
        this.cached_size = s
        this.size_known = true
        this.size_computing = false
        return s
    }

    fn size_error_label() String {
        if this.custom_name.length > 0 : return ": " + this.custom_name
        let c = this.class
        if isset(c) : return ": " + c.name
        return ""
    }

    // Compute size without caching (caller handles cache / recursion flag).
    fn compute_size() u32 !Error {
        let t = this.type
        let psz = this.ptr_size()

        if t == TYPE.void : return 0
        if t == TYPE.any : return psz

        // Pointer-sized type kinds
        if t == TYPE.ptr || t == TYPE.ref || t == TYPE.fn || t == TYPE.fnptr || t == TYPE.co {
            return psz
        }

        if t == TYPE.nullable {
            let sub = this.sub_type
            if !isset(sub) : return psz
            // Nullable of a pointer-sized type stays pointer-sized
            if sub.is_pointer_sized() : return psz
            // Nullable inline value: value size (tag handled elsewhere if needed)
            return sub.size() !>
        }

        if t == TYPE.inline {
            let sub = this.sub_type
            if !isset(sub) : this.build.bug("Inline type is missing sub_type")
            return sub.size() !>
        }

        if t == TYPE.array {
            let sub = this.sub_type
            if !isset(sub) : this.build.bug("Array type is missing sub_type")
            let n = this.array_size
            if n == 0 : return 0
            return sub.size() !> * n
        }

        if t == TYPE.multi {
            let subs = this.sub_types
            if !isset(subs) : this.build.bug("Multi type is missing sub_types")
            let total: u32 = 0
            each subs as st {
                total += st.size() !>
            }
            return total
        }

        // Class-backed types (class / struct / int / float / bool / pointer / …)
        let c = this.class
        if isset(c) {
            return c.compute_size() !>
        }

        // TYPE.int / float / bool / class without class pointer — should not happen
        if t == TYPE.int || t == TYPE.float || t == TYPE.bool {
            return psz
        }
        if t == TYPE.class {
            return psz
        }

        return 0
    }

    // True if this type is stored as a pointer-sized word (no recursive layout).
    fn is_pointer_sized() bool {
        let t = this.type
        if t == TYPE.ptr || t == TYPE.ref || t == TYPE.fn || t == TYPE.fnptr || t == TYPE.co || t == TYPE.any {
            return true
        }
        if t == TYPE.nullable {
            let sub = this.sub_type
            if isset(sub) : return sub.is_pointer_sized()
            return true
        }
        // GC class / slice / mode / pointer-kind are reference-sized
        let c = this.class
        if isset(c) {
            let kind = c.kind
            if kind == CLASS_KIND.class || kind == CLASS_KIND.slice || kind == CLASS_KIND.mode || kind == CLASS_KIND.pointer {
                return true
            }
        }
        return false
    }

    // ---- compile-time meta queries (`T.$is_*`, `T.$has_*`, …) ----

    // Strip one nullable layer (`?T` → `T`). Used by `T.$notnull`.
    fn get_non_nullable() Type {
        if this.type != TYPE.nullable : return this
        let sub = this.sub_type
        if isset(sub) : return sub
        return this
    }

    // Class backing this type when known (unwraps nullable / inline / one ptr-ref layer).
    fn get_class_or_null() ?Class {
        let t = this.get_non_nullable()
        let c = t.class
        if isset(c) : return c
        // `<Struct>` stores the class on the inner type
        if t.type == TYPE.inline {
            let sub = t.sub_type
            if isset(sub) : return sub.get_class_or_null()
        }
        if t.type == TYPE.ptr || t.type == TYPE.ref {
            let sub = t.sub_type
            if isset(sub) : return sub.get_class_or_null()
        }
        return null
    }

    // True if this type is nullable (`?T`). Used by `T.$is_nullable`.
    fn is_nullable_type() bool {
        return this.type == TYPE.nullable
    }

    // True if values of this type are stored inline (not a pointer-sized reference).
    // Used by compile-time meta-properties such as `T.$is_inline`.
    fn is_inline_type() bool {
        let t = this.type
        if t == TYPE.array || t == TYPE.inline || t == TYPE.multi : return true
        if t == TYPE.int || t == TYPE.float || t == TYPE.bool : return true
        if t == TYPE.ptr || t == TYPE.ref || t == TYPE.fn || t == TYPE.fnptr || t == TYPE.co || t == TYPE.any || t == TYPE.void {
            return false
        }
        if t == TYPE.nullable {
            let sub = this.sub_type
            if isset(sub) : return sub.is_inline_type()
            return false
        }
        // TYPE.class (and class-backed forms): only structs and number-like kinds are inline
        let c = this.class
        if isset(c) {
            let kind = c.kind
            if kind == CLASS_KIND.struct : return true
            if kind == CLASS_KIND.integer || kind == CLASS_KIND.float || kind == CLASS_KIND.boolean : return true
            // class / slice / mode / pointer are reference types
            return false
        }
        return false
    }

    // `T.$is_inline` compile-time meta-property, as used by the standard library
    // (e.g. `Array.sort`'s `#if !T.$is_inline`). Unlike `is_inline_type()` — the
    // internal "stored by value, not GC/pointer-boxed" concept, which also covers plain
    // scalars — this means "a large-ish value type that isn't a trivially-swapped
    // scalar": struct / fixed array / inline, but not int / float / bool.
    fn is_meta_inline_type() bool {
        let t = this.type
        if t == TYPE.int || t == TYPE.float || t == TYPE.bool : return false
        if t == TYPE.nullable {
            let sub = this.sub_type
            if isset(sub) : return sub.is_meta_inline_type()
            return false
        }
        let c = this.class
        if isset(c) {
            let kind = c.kind
            if kind == CLASS_KIND.integer || kind == CLASS_KIND.float || kind == CLASS_KIND.boolean : return false
        }
        return this.is_inline_type()
    }

    fn is_void_type() bool {
        return this.get_non_nullable().type == TYPE.void
    }

    fn is_integer_type() bool {
        let t = this.get_non_nullable()
        if t.type == TYPE.int : return true
        let c = t.class
        return isset(c) && c.kind == CLASS_KIND.integer
    }

    fn is_float_type() bool {
        let t = this.get_non_nullable()
        if t.type == TYPE.float : return true
        let c = t.class
        return isset(c) && c.kind == CLASS_KIND.float
    }

    fn is_bool_type() bool {
        let t = this.get_non_nullable()
        if t.type == TYPE.bool : return true
        let c = t.class
        return isset(c) && c.kind == CLASS_KIND.boolean
    }

    // Signed integer (or other class with `signed` set).
    fn is_signed_type() bool {
        let c = this.get_class_or_null()
        if isset(c) : return c.signed
        return false
    }

    // struct or class (layout-bearing object types).
    fn is_structural_type() bool {
        let c = this.get_class_or_null()
        if !isset(c) : return false
        return c.kind == CLASS_KIND.struct || c.kind == CLASS_KIND.class
    }

    // GC-managed reference type (class / slice / mode).
    fn is_gc_type() bool {
        let t = this.get_non_nullable()
        if t.type == TYPE.ptr || t.type == TYPE.ref {
            let sub = t.sub_type
            if isset(sub) : return sub.is_gc_type()
            return false
        }
        let c = t.class
        if !isset(c) : return false
        let kind = c.kind
        return kind == CLASS_KIND.class || kind == CLASS_KIND.slice || kind == CLASS_KIND.mode
    }

    // Pointer-like storage: explicit ptr/ref/fn, or reference-class kinds.
    fn is_pointer_type() bool {
        let t = this.type
        if t == TYPE.ptr || t == TYPE.ref || t == TYPE.fn || t == TYPE.fnptr || t == TYPE.co {
            return true
        }
        if t == TYPE.nullable {
            let sub = this.sub_type
            if isset(sub) : return sub.is_pointer_type()
            return false
        }
        let c = this.class
        if isset(c) {
            let kind = c.kind
            return kind == CLASS_KIND.class || kind == CLASS_KIND.slice || kind == CLASS_KIND.mode || kind == CLASS_KIND.pointer
        }
        return false
    }

    // Bare `ptr` (CLASS_KIND.pointer / void-style pointer), not `*T`.
    fn is_raw_pointer_type() bool {
        if this.type != TYPE.ptr : return false
        // `*T` / `*[T]` always carry a pointed-to sub_type
        if isset(this.sub_type) : return false
        return true
    }

    // True if a `_VTABLE` property is already present on the class.
    fn has_vtable() bool {
        let c = this.get_class_or_null()
        if !isset(c) : return false
        each c.props as prop {
            let n = prop.name
            if isset(n) && n == "_VTABLE" : return true
        }
        return false
    }

    // Same class identity after stripping nullability (old `is_type_of_class`).
    fn is_type_of_class(other: Type) bool {
        let ca = this.compat_class()
        let cb = other.compat_class()
        return isset(ca) && isset(cb) && ca == cb
    }

    // Class used for identity checks — unwraps `mode X for Y` to Y.
    fn compat_class() ?Class {
        let c = this.get_class_or_null()
        if !isset(c) : return null
        let mode_for = c.mode_for_class
        if isset(mode_for) : return mode_for
        return c
    }

    // True for integer / float / bool (including class-backed number types).
    fn is_number_type() bool {
        return this.is_integer_type() || this.is_float_type() || this.is_bool_type()
    }

    // Byte size used for number compatibility (no full layout walk).
    // `*` integer/float sizes use pointer size.
    fn number_byte_size() u32 {
        let t = this.get_non_nullable()
        let c = t.class
        if isset(c) {
            let kind = c.kind
            if kind == CLASS_KIND.integer || kind == CLASS_KIND.float {
                let s = c.number_size
                if s == 0 : return t.ptr_size()
                return s
            }
            if kind == CLASS_KIND.boolean : return 1
        }
        if t.type == TYPE.bool : return 1
        // Bare TYPE.int / float without class — treat as pointer-sized host int
        if t.type == TYPE.int || t.type == TYPE.float : return t.ptr_size()
        // Fallback: cached/compute size when available
        let s = t.size() ! return 0
        return s
    }

    // Can a value of type `other` be passed where `this` is expected?
    // (Mirrors old `Type.compat` — assignability / parameter matching.)
    //
    // Numbers: same kind (int/float/bool) and same byte size; integers also need
    // matching signedness (old rule). Classes compare by identity (modes unwrap).
    fn compat(other: Type, ignore_imut: bool (false)) bool {
        if this == other : return true

        // `any` is permissive (docs / incomplete generics)
        if this.type == TYPE.any || other.type == TYPE.any : return true

        let base = this
        let typ = other

        // Expected `?X` accepts non-null `X`
        if base.is_nullable_type() && !typ.is_nullable_type() {
            base = base.get_non_nullable()
        }

        // Both nullable: compare inners
        if base.is_nullable_type() {
            if !typ.is_nullable_type() : return false
            let bs = base.sub_type
            let ts = typ.sub_type
            if !isset(bs) || !isset(ts) : return false
            return bs.compat(ts, ignore_imut)
        }

        // Numbers: same numeric kind + same byte size (not class identity)
        if base.is_number_type() && typ.is_number_type() {
            return base.compat_numbers(typ)
        }

        // Kind mismatch — allow &T ↔ *T (same as old)
        if base.type != typ.type {
            // A single-element `(T)` multi (e.g. a `fn()(T)` return clause) is just `T`.
            if base.type == TYPE.multi {
                let bs = base.sub_types
                if isset(bs) && bs.length == 1 {
                    let only = bs.get(0) !? null
                    if isset(only) : return only.compat(typ, ignore_imut)
                }
            }
            if typ.type == TYPE.multi {
                let ts = typ.sub_types
                if isset(ts) && ts.length == 1 {
                    let only = ts.get(0) !? null
                    if isset(only) : return base.compat(only, ignore_imut)
                }
            }
            if base.type == TYPE.ref && typ.type == TYPE.ptr {
                // fall through to pointer-style sub compare
            } else if base.type == TYPE.ptr && typ.type == TYPE.ref {
                // fall through
            } else if base.type == TYPE.class || typ.type == TYPE.class {
                // class vs non-class already failed number path
                let bc = base.compat_class()
                let tc = typ.compat_class()
                if isset(bc) && isset(tc) && bc == tc : return true
                return false
            } else {
                return false
            }
        }

        // Enums: when the *expected* type is an enum, actual must be the same enum
        // (old rule). A plain underlying type on the expected side still accepts
        // enum-tagged values (e.g. String accepts Enum2:String).
        let be = base.enum
        if isset(be) {
            if be != typ.enum : return false
        }

        // *T / &T — compare pointed-to types
        if base.type == TYPE.ptr || base.type == TYPE.ref {
            let bs = base.sub_type
            let ts = typ.sub_type
            if !isset(bs) || !isset(ts) : return false
            // slice-ptr flag: require both or neither when either is set
            if base.is_slice_ptr != typ.is_slice_ptr : return false
            return bs.compat(ts, ignore_imut)
        }

        // Inline <T>
        if base.type == TYPE.inline {
            let bs = base.sub_type
            let ts = typ.sub_type
            if !isset(bs) || !isset(ts) : return false
            return bs.compat(ts, ignore_imut)
        }

        // Fixed arrays [T x N]
        if base.type == TYPE.array {
            let bs = base.sub_type
            let ts = typ.sub_type
            if !isset(bs) || !isset(ts) : return false
            // If both sizes known and non-zero, base must not require a larger array
            if base.array_size > 0 && typ.array_size > 0 && base.array_size > typ.array_size {
                return false
            }
            return bs.compat(ts, ignore_imut)
        }

        // Multi (T, U, …)
        if base.type == TYPE.multi {
            let bs = base.sub_types
            let ts = typ.sub_types
            if !isset(bs) || !isset(ts) : return false
            if bs.length != ts.length : return false
            each bs as bt, i {
                let ot = ts.get(i) ! return false
                if !bt.compat(ot, ignore_imut) : return false
            }
            return true
        }

        // Function types — arity and arg/rett compatibility (simplified)
        if base.type == TYPE.fn || base.type == TYPE.fnptr {
            if typ.type != base.type : return false
            let bs = base.sub_types
            let ts = typ.sub_types
            if isset(bs) || isset(ts) {
                if !isset(bs) || !isset(ts) : return false
                if bs.length != ts.length : return false
                // First N-1 are args (contravariant: expected arg accepts actual), last is rett
                // Without a fixed split, require pairwise compat both ways for now
                each bs as bt, i {
                    let ot = ts.get(i) ! return false
                    if !bt.compat(ot, ignore_imut) && !ot.compat(bt, ignore_imut) : return false
                }
            }
            return true
        }

        // co(…) — compare return-type list when present
        if base.type == TYPE.co {
            if typ.type != TYPE.co : return false
            let bs = base.sub_types
            let ts = typ.sub_types
            if isset(ts) && ts.length > 0 {
                if !isset(bs) : return false
                if bs.length != ts.length : return false
                each bs as bt, i {
                    let ot = ts.get(i) ! return false
                    if !bt.compat(ot, ignore_imut) : return false
                }
            }
            return true
        }

        // Error code values: same ErrorType (regardless of instance/plain-code flavor)
        if base.type == TYPE.error_code {
            if typ.type != TYPE.error_code : return false
            return base.error_type == typ.error_type
        }

        // Class / struct / slice / mode / pointer-kind: same class identity
        let base_class = base.compat_class()
        let type_class = typ.compat_class()
        if isset(base_class) || isset(type_class) {
            if base_class != type_class : return false
            return true
        }

        // void / other primitives with no class
        if base.type == TYPE.void : return typ.type == TYPE.void

        return true
    }

    // Number-only branch of compat: same kind family + same byte size.
    // e.g. int/i32/u32 of equal width are compatible; float widths must match.
    // (Signedness is not required — only storage size.)
    fn compat_numbers(other: Type) bool {
        let a = this.get_non_nullable()
        let b = other.get_non_nullable()

        if a.is_bool_type() || b.is_bool_type() {
            return a.is_bool_type() && b.is_bool_type()
        }
        if a.is_float_type() || b.is_float_type() {
            if !a.is_float_type() || !b.is_float_type() : return false
            return a.number_byte_size() == b.number_byte_size()
        }
        // integers — size only
        if !a.is_integer_type() || !b.is_integer_type() : return false
        return a.number_byte_size() == b.number_byte_size()
    }

    // Alias used by meta `$is_compatible_with` and payload checks.
    fn is_compatible_with(other: Type) bool {
        return this.compat(other)
    }

    // Report incompatible types at `at` (expected = this, got = other).
    fn compat_check(other: Type, at: Exp) !Error {
        if this.compat(other) : return
        at.error("Incompatible types. Expected '" + this.compat_display_name() + "', got '" + other.compat_display_name() + "'")
    }

    fn compat_display_name() String {
        // Class-backed types: always prefer pretty name (`Array[String]`, not mangled id)
        let c = this.class
        if isset(c) : return c.pretty_name()
        if this.custom_name.length > 0 : return this.custom_name
        if this.type == TYPE.void : return "void"
        if this.type == TYPE.error_code {
            let et = this.error_type
            return isset(et) ? et.name : "error_code"
        }
        if this.type == TYPE.any : return "any"
        if this.type == TYPE.nullable {
            let sub = this.sub_type
            if isset(sub) : return "?" + sub.compat_display_name()
            return "?"
        }
        if this.type == TYPE.ptr {
            let sub = this.sub_type
            if isset(sub) : return "*" + sub.compat_display_name()
            return "*"
        }
        if this.type == TYPE.ref {
            let sub = this.sub_type
            if isset(sub) : return "&" + sub.compat_display_name()
            return "&"
        }
        if this.type == TYPE.inline {
            let sub = this.sub_type
            if isset(sub) : return "<" + sub.compat_display_name() + ">"
            return "<>"
        }
        if this.type == TYPE.array {
            let sub = this.sub_type
            if isset(sub) {
                let n = this.array_size
                if n > 0 : return "[" + sub.compat_display_name() + " x " + n + "]"
                return "[" + sub.compat_display_name() + "]"
            }
            return "[]"
        }
        if this.type == TYPE.multi {
            let subs = this.sub_types
            if isset(subs) {
                let parts = Array[String]{}
                each subs as st {
                    parts.append(st.compat_display_name())
                }
                return "(" + parts.join(", ") + ")"
            }
            return "()"
        }
        if this.type == TYPE.fn || this.type == TYPE.fnptr {
            let name = this.type == TYPE.fn ? "fn" : "fnptr"
            let args = this.sub_types
            let parts = Array[String]{}
            if isset(args) {
                each args as at : parts.append(at.compat_display_name())
            }
            // rett (when set) is already a TYPE.multi and self-parenthesizes.
            let rett = this.sub_type
            return name + "(" + parts.join(", ") + ")" + (isset(rett) ? rett.compat_display_name() : "()")
        }
        return "type"
    }

    // Method lookup not wired on Class yet — always false for now.
    fn has_method(name: String) bool {
        return false
    }

    // True if a value of this type can convert (via `compat` or a `$to` hook) to `other`.
    fn can_convert_to(other: Type) bool {
        let a = this.get_non_nullable()
        let b = other.get_non_nullable()
        // Same type or already assignable counts as a free conversion
        if a.compat(b) : return true
        let class = a.get_class_or_null()
        if !isset(class) : return false
        let hook = class_get_to_hook(class, b, false)
        return isset(hook)
    }

    // ?T — cached on this type
    fn nullable() Type {
        let cache = this.cache_nullable
        if isset(cache) : return cache
        let t = Type {
            type: TYPE.nullable
            build: this.build
            sub_type: this
        }
        this.cache_nullable = t
        return t
    }

    // *T — cached on this type
    fn pointer() Type {
        let cache = this.cache_pointer
        if isset(cache) : return cache
        let t = Type {
            type: TYPE.ptr
            build: this.build
            sub_type: this
        }
        this.cache_pointer = t
        return t
    }

    // &T — cached on this type
    fn reference() Type {
        let cache = this.cache_ref
        if isset(cache) : return cache
        let t = Type {
            type: TYPE.ref
            build: this.build
            sub_type: this
        }
        this.cache_ref = t
        return t
    }

    // <T> — cached on this type
    fn inline() Type {
        let cache = this.cache_inline
        if isset(cache) : return cache
        let t = Type {
            type: TYPE.inline
            build: this.build
            sub_type: this
        }
        this.cache_inline = t
        return t
    }
}

// ---- Build-level singleton types ----

fn type_void(b: Build) Type {
    let cache = b.cache.type_void
    if isset(cache) : return cache
    let t = Type {
        type: TYPE.void
        build: b
    }
    b.cache.type_void = t
    return t
}

// Multi-return / multi-value type `(T, U, …)`. Single element (unless force) folds to that type.
fn type_multi(b: Build, types: Array[Type], force_multi: bool (false)) Type {
    if types.length == 0 : return type_void(b)
    if types.length == 1 && !force_multi {
        return types.get(0) !? type_void(b)
    }
    return Type {
        type: TYPE.multi
        build: b
        sub_types: types
    }
}

fn type_any(b: Build) Type {
    let cache = b.cache.type_any
    if isset(cache) : return cache
    let t = Type {
        type: TYPE.any
        build: b
    }
    b.cache.type_any = t
    return t
}

// Primitive types (no Class). Used before valk:core classes are registered.
fn type_prim_int(b: Build) Type {
    let cache = b.cache.type_prim_int
    if isset(cache) : return cache
    let t = Type {
        type: TYPE.int
        build: b
        custom_name: "int"
    }
    b.cache.type_prim_int = t
    return t
}

fn type_prim_string(b: Build) Type {
    let cache = b.cache.type_prim_string
    if isset(cache) : return cache
    let t = Type {
        type: TYPE.class
        build: b
        custom_name: "String"
    }
    b.cache.type_prim_string = t
    return t
}

fn type_prim_bool(b: Build) Type {
    let cache = b.cache.type_prim_bool
    if isset(cache) : return cache
    let t = Type {
        type: TYPE.bool
        build: b
        custom_name: "bool"
    }
    b.cache.type_prim_bool = t
    return t
}

// Look up a class by name in valk:core (always loaded in Build.run) and return its Type.
// Results are cached on BuildCache.core_types by name. Missing classes are a compiler bug.
fn type_from_core(b: Build, name: String) Type !Error {
    let cached = b.cache.core_types.get(name) !? null
    if isset(cached) : return cached

    let main = b.main_pkg ?! b.bug("Main package not found when looking up core type: " + name)
    let valk = main.sub_pkgs.get("valk") !? null
    if !isset(valk) : b.bug("valk package not loaded (needed for core type: " + name + ")")
    let core = valk.namespaces.get("core") !? null
    if !isset(core) : b.bug("valk:core namespace not loaded (needed for core type: " + name + ")")
    let idf = core.scope.get_idf(name)
    if !isset(idf) : b.bug("Missing class in valk:core: " + name)
    if idf.type != IDF.class : b.bug("Identifier in valk:core is not a class: " + name)
    let c = idf.class
    if !isset(c) : b.bug("Class idf is missing class for: " + name)
    let t = c.get_type() !>
    b.cache.core_types.set(name, t)
    return t
}

// Soft core lookup: returns null if the class is not registered yet (no error).
fn type_from_core_or_null(b: Build, name: String) ?Type {
    let cached = b.cache.core_types.get(name) !? null
    if isset(cached) : return cached

    // $global core classes live on Build.scope once parse_class_exp has run
    let idf = b.scope.get_idf(name)
    if !isset(idf) : return null
    if idf.type != IDF.class : return null
    let c = idf.class
    if !isset(c) : return null
    if c.is_generic_base : return null
    let t = c.get_type() ! return null
    b.cache.core_types.set(name, t)
    return t
}

// Prefer real core class; fall back to primitive stand-in before core is parsed.
fn type_int(b: Build) Type {
    let t = type_from_core_or_null(b, "int")
    if isset(t) : return t
    return type_prim_int(b)
}
fn type_float(b: Build) Type !Error {
    return type_from_core(b, "float") !>
}
fn type_bool(b: Build) Type {
    let t = type_from_core_or_null(b, "bool")
    if isset(t) : return t
    return type_prim_bool(b)
}
fn type_string(b: Build) Type {
    let t = type_from_core_or_null(b, "String")
    if isset(t) : return t
    return type_prim_string(b)
}

// `.code` / `TypeName.code` (is_instance false) or a caught-error binding `E` (true).
fn type_error_code(et: ErrorType, is_instance: bool (false)) Type {
    return Type {
        type: TYPE.error_code
        build: et.ns.build
        error_type: et
        error_is_instance: is_instance
    }
}

// Raw `ptr` (void-style pointer class from core, or a bare TYPE.ptr stand-in).
fn type_ptr(b: Build) Type {
    let t = type_from_core_or_null(b, "ptr")
    if isset(t) : return t
    let cache = b.cache.type_prim_ptr
    if isset(cache) : return cache
    let prim = Type {
        type: TYPE.ptr
        build: b
        custom_name: "ptr"
    }
    b.cache.type_prim_ptr = prim
    return prim
}

// Convert a structured EXP.type into a Type using `scope` for name lookup.
fn type_from_exp(exp: Exp, scope: Scope) Type !Error {
    if exp.type != EXP.type : exp.bug("Expected EXP.type")
    let kind = exp.kind
    let b = exp.src.build

    if kind == TYPE_KIND.void : return type_void(b)

    if kind == TYPE_KIND.nullable {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for '?'")
        return type_from_exp(sub_exp, scope) !>.nullable()
    }

    if kind == TYPE_KIND.ptr {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for '*'")
        return type_from_exp(sub_exp, scope) !>.pointer()
    }
    if kind == TYPE_KIND.ptr_slice {
        // Slice pointers are not cached (size/element vary); build fully initialized.
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for '*[]'")
        let size = resolve_type_size(exp, scope) !>
        return Type {
            type: TYPE.ptr
            build: b
            sub_type: type_from_exp(sub_exp, scope) !>
            array_size: size
            is_slice_ptr: true
        }
    }

    if kind == TYPE_KIND.ref {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for '&'")
        return type_from_exp(sub_exp, scope) !>.reference()
    }
    if kind == TYPE_KIND.ref_slice {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for '&[]'")
        let size = resolve_type_size(exp, scope) !>
        return Type {
            type: TYPE.ref
            build: b
            sub_type: type_from_exp(sub_exp, scope) !>
            array_size: size
            is_slice_ptr: true
        }
    }

    if kind == TYPE_KIND.inline {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for inline")
        return type_from_exp(sub_exp, scope) !>.inline()
    }

    if kind == TYPE_KIND.notnull {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing inner type for notnull")
        let t = type_from_exp(sub_exp, scope) !>
        // Strip one nullable layer if present
        if t.type == TYPE.nullable {
            let inner = t.sub_type
            if isset(inner) : return inner
        }
        return t
    }

    if kind == TYPE_KIND.typeof {
        // typeof(value) in type position → result type of the value expression
        let val_exp = exp.get(TYPE_EXP.type)
        if !isset(val_exp) : exp.bug("Missing typeof operand")
        let v = value_from_exp(val_exp, scope, Context.for_build(b)) !>
        return v.rett
    }

    if kind == TYPE_KIND.array {
        let sub_exp = exp.get(TYPE_EXP.type)
        if !isset(sub_exp) : exp.bug("Missing element type for array")
        let size = resolve_type_size(exp, scope) !>
        if size == 0 : exp.error("Array size must be larger than 0")
        return Type {
            type: TYPE.array
            build: b
            sub_type: type_from_exp(sub_exp, scope) !>
            array_size: size
        }
    }

    if kind == TYPE_KIND.multi {
        return type_from_multi_exp(exp, scope) !>
    }

    if kind == TYPE_KIND.fn || kind == TYPE_KIND.fnptr {
        let args_types: ?Array[Type] = null
        let args = exp.get(TYPE_EXP.args)
        if isset(args) {
            let args_t = type_from_exp(args, scope) !>
            args_types = args_t.sub_types
        }
        let rett_type: ?Type = null
        let rett = exp.get(TYPE_EXP.rett)
        if isset(rett) {
            rett_type = type_from_exp(rett, scope) !>
        }
        // Reuses the same `error_type` field TYPE.error_code uses: the ErrorType this
        // function value can throw, when declared (`fn(...)(...) !ErrorName`).
        let fn_error_type: ?ErrorType = null
        let err_exp = exp.get(TYPE_EXP.error)
        if isset(err_exp) {
            let idf = resolve_idf_from_id(err_exp, scope) !>
            if idf.type != IDF.error_type {
                err_exp.error("Identifier must be an error type")
            }
            fn_error_type = idf.error_type
            if !isset(fn_error_type) : err_exp.bug("Error-type idf is missing error_type")
        }
        return Type {
            type: kind == TYPE_KIND.fn ? TYPE.fn : TYPE.fnptr
            build: b
            sub_type: rett_type
            sub_types: args_types
            error_type: fn_error_type
        }
    }

    if kind == TYPE_KIND.co {
        let rett_type: ?Type = null
        let rett = exp.get(TYPE_EXP.rett)
        if isset(rett) {
            rett_type = type_from_exp(rett, scope) !>
        }
        return Type {
            type: TYPE.co
            build: b
            sub_type: rett_type
        }
    }

    if kind == TYPE_KIND.error_dot {
        exp.error("'.' type is not valid here")
    }

    if kind == TYPE_KIND.named {
        return type_from_named_exp(exp, scope) !>
    }

    exp.bug("Unknown type kind: " + kind)
}

fn type_from_multi_exp(exp: Exp, scope: Scope) Type !Error {
    let b = exp.src.build
    let types = Array[Type]{}
    let i: uint = 0
    while true {
        let sub = exp.get(i)
        if !isset(sub) : break
        types.append(type_from_exp(sub, scope) !>)
        i++
    }
    return Type {
        type: TYPE.multi
        build: b
        sub_types: types
    }
}

fn type_from_named_exp(exp: Exp, scope: Scope) Type !Error {
    let id = exp.get(TYPE_EXP.id)
    if !isset(id) : exp.bug("Named type is missing id")

    let name = id.str1
    let ns_name = id.str2

    // Optional namespace prefix: ns:Name — `ns` must be an IDF.scope from `use`
    let idf: ?Idf = null
    if isset(ns_name) {
        let ns_idf = scope.get_idf(ns_name)
        if !isset(ns_idf) : exp.error("Unknown namespace: " + ns_name)
        if ns_idf.type != IDF.scope {
            exp.error("Expected a namespace before ':', found: " + ns_name)
        }
        let ns_scope = ns_idf.scope
        if !isset(ns_scope) : exp.bug("Scope idf is missing scope")
        idf = ns_scope.get_idf(name)
        if !isset(idf) : exp.error("Unknown type: " + ns_name + ":" + name)
    } else {
        idf = scope.get_idf(name)
        if !isset(idf) : exp.error("Unknown type: " + name)
    }

    let resolved = idf
    if !isset(resolved) : exp.error("Unknown type: " + name)

    // Generic parameter or other bound type (e.g. `T` inside `class Foo[T]`)
    if resolved.type == IDF.type {
        let of_type = resolved.of_type
        if !isset(of_type) : exp.bug("Type idf is missing of_type")
        return of_type
    }

    // enum Name { ... }
    if resolved.type == IDF.enum {
        let enu = resolved.enum
        if !isset(enu) : exp.bug("Enum idf is missing enum")
        return enu.get_type() !>
    }

    if resolved.type != IDF.class {
        exp.error("Identifier is not a type: " + name)
    }
    let class = resolved.class
    if !isset(class) : exp.bug("Class idf is missing class")

    // Brackets after a named type are either:
    //   - generic args: Array[T], Map[K, V]
    //   - pointer-info: ptr[u8], ptr[Array[?Coro]], cstring[u8 x N], Foo[T][u8]
    // AST parse always stores the first `[...]` (without `x N`) in TYPE_EXP.generics.
    // Only at resolve time do we know if the class is generic.
    let gens = exp.get(TYPE_EXP.generics)
    // second `[...]` after generics, or sized `[T x N]` via TYPE_EXP.type / str2
    let ptr_info = exp.get(TYPE_EXP.type)

    // Resolve base class type (specialize generics when present)
    if isset(gens) && class.is_generic_base {
        let gtypes = Array[Type]{}
        let i: uint = 0
        while true {
            let g = gens.get(i)
            if !isset(g) : break
            gtypes.append(type_from_exp(g, scope) !>)
            i++
        }
        class = class.specialize(gtypes, exp) !>
    } else if isset(gens) {
        // Non-generic with `[T]` → pointer-info hint (e.g. ptr[u8], ptr[Array[Foo]])
        let g0 = gens.get(0)
        if !isset(g0) : exp.bug("Empty type brackets")
        if isset(gens.get(1)) {
            exp.error("Type is not generic: " + class.name)
        }
        if isset(ptr_info) {
            exp.error("Unexpected extra type brackets after non-generic type: " + class.name)
        }
        ptr_info = g0
    } else if class.is_generic_base {
        exp.error("Generic type '" + class.name + "' requires type arguments")
    }

    let base = class.get_type() !>

    // Optional pointer-info: sub_type hint and/or fixed size (matches classic read_pointer_info)
    let size_exp = exp.get(TYPE_EXP.size)
    if isset(ptr_info) || isset(size_exp) {
        let size: u32 = 0
        if isset(size_exp) : size = resolve_type_size(exp, scope) !>
        let sub: ?Type = null
        if isset(ptr_info) : sub = type_from_exp(ptr_info, scope) !>
        return Type {
            type: base.type
            build: base.build
            class: class
            custom_name: class.pretty_name()
            sub_type: sub
            array_size: size
        }
    }

    return base
}

// Evaluate TYPE_EXP.size (a value expression) to a non-negative compile-time integer.
fn resolve_type_size(exp: Exp, scope: Scope) u32 !Error {
    let size_exp = exp.get(TYPE_EXP.size)
    if !isset(size_exp) : return 0
    let v = value_from_exp(size_exp, scope, Context.for_build(exp.src.build)) !>
    if v.type != VAL.int {
        size_exp.error("Type size must be a compile-time integer")
    }
    if v.int_val < 0 {
        size_exp.error("Type size must not be negative")
    }
    return v.int_val.to(u32)
}

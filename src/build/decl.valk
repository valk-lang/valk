// Local / argument variable declaration.
// Bound into scopes as IDF.decl so bodies can look up `name` → typed storage.

class Decl {
    // Function whose frame owns this declaration. Captured declarations are
    // represented by a separate is_bind argument owned by the inner function.
    owner: Func
    name: ?String (null)
    type: Type
    // Where this variable was declared, for "go to definition" on a local. Set
    // for the named declarations a user can navigate to (`let`, `each` bindings,
    // arguments); the compiler's own temporaries leave it null.
    exp: ?Exp (null)
    // True when this is a function argument (vs. body local)
    is_arg: bool
    // GC-tracked value (for stack maps / later IR)
    is_gc: bool
    // Mutable storage (inline/struct args are mut by default in the classic compiler)
    is_mut: bool (false)
    // Closure bind / buffer / other IR-facing flags (filled later)
    is_bind: bool (false)
    is_buffer: bool (false)
    is_used: bool (false)
    // Referenced somewhere that reads it, as opposed to only being assigned to.
    // Set at the same place as is_used, minus the destination of a plain `=`.
    is_read: bool (false)
    must_be_stable: bool (false)
    // IR naming (filled when lowering)
    ir_name: String ("-nameless-")
    offset: uint (0)
    // Byte offset of this declaration's value in the function's GC frame.
    // The frame stores the value itself; its generated marker understands the
    // declaration's type and extracts managed pointers from inline values.
    gc_stack_offset: ?uint (null)
    // Internal scratch allocas are used only while packing/unpacking a value
    // and never survive an allocating operation.
    skip_gc_field_roots: bool (false)
    // Whether anything that reaches this `fn` declaration carries captured data.
    // A named function stores a null there and needs no root, and one needless
    // root is enough to force a GC stack frame onto a function that would
    // otherwise have none. Assignments merge the referenced Func.capture_free.
    closure_holds_captures: bool (false)
    // Caught-error `E` bindings snapshot payload globals into handler-local
    // declarations so nested fallible calls cannot overwrite the payload.
    error_payloads: ?Map[Decl] (null)

    static fn new(owner: Func, type: Type, is_arg: bool, name: ?String (null)) Decl {
        return Decl {
            owner: owner
            type: type
            name: name
            is_arg: is_arg
            is_gc: type.is_gc_type()
            // Inline values need a mutable slot (classic Valk rule)
            is_mut: type.is_inline_type()
        }
    }

    fn make_stable() {
        if !this.is_gc {
            this.must_be_stable = true
            this.is_mut = true
        }
    }
}

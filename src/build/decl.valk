
class Decl {
    owner: Func
    name: ?String (null)
    type: Type
    exp: ?Exp (null)
    // True when this is a function argument (vs. body local)
    is_arg: bool
    // GC-tracked value (for stack maps / later IR)
    is_gc: bool
    // Mutable storage (inline/struct args are mut by default in the classic compiler)
    is_mut: bool (false)
    is_bind: bool (false)
    // Hidden binding stored in a shared closure environment.
    is_shared_capture: bool (false)
    capture_index: uint (0)
    // Compiler-generated temporary holding a value across an allocation
    is_buffer: bool (false)
    is_used: bool (false)
    is_read: bool (false)
    // IR naming (filled when lowering)
    ir_name: String ("-nameless-")
    gc_stack_offset: ?uint (null)
    skip_gc_field_roots: bool (false)
    closure_holds_captures: bool (false)
    implicit_borrow: bool (false)
    is_captured: bool (false)
    // Internal provenance used to prove that a managed graph has no mutable aliases.
    // This is deliberately not represented in the source type system.
    unique_graph: bool (false)
    // A call result whose return-uniqueness summary is resolved only if this
    // local is later required to be unique.
    unique_source: ?Value (null)
    computing_unique_source: bool (false)
    unique_published: bool (false)
    unique_dependents: Array[Decl] (.{})
    escape_origins: Array[Decl] (.{})
    input_origins: Array[Decl] (.{})
    pending_effect_args: ?Array[Arg] (null)
    pending_effect_positions: ?Array[Pos] (null)
    error_payloads: ?Map[Decl] (null)

    static fn new(owner: Func, type: Type, is_arg: bool, name: ?String (null)) Decl {
        return Decl {
            owner: owner
            type: type
            name: name
            is_arg: is_arg
            is_gc: type.is_gc_type()
            // Inline values need a mutable slot (classic Valk rule)
            is_mut: type.is_inline_type()
        }
    }

    fn make_addressable() {
        if !this.is_gc {
            this.is_mut = true
        }
    }
}


fn func_may_drop_gc_stack(func: Func) bool {
    // The language server generates no IR, so there is nothing here to decide.
    if isset(func.ns.build.options.lsp) : return false

    // Already disqualified by its own body.
    if func.info_creates_objects || func.info_calls_unknown_code : return false

    if func.is_literal : return false

    if func.is_entrance : return false

    // Nothing to win when the frame holds no roots to begin with.
    return func.gc_decl_count > 0
}

fn finish_deferred_gc_funcs(build: Build) !Error {
    let deferred = build.pipeline.deferred_gc_funcs
    propagate_gc_effects(build)
    validate_gc_free_effects(build) !>

    if deferred.length == 0 : return

    each deferred as func {
        let regenerate = false
        func.storage_effects_ready = true
        if !func.info_creates_objects && !func.info_calls_unknown_code
            && !func.disable_gc_stack {
            func.disable_gc_stack = true
            regenerate = true
        }
        if func.stable_alloca_size > 0 {
            func.native_address_storage = true
            regenerate = true
        }
        if regenerate {
            func_regenerate_ir(func) !>
        } else {
            // Not lowered again, so the body expression it held can go too.
            func.body = null
        }
    }
    deferred.clear()
}

fn validate_gc_free_effects(build: Build) !Error {
    each build.lists.units as unit {
        each unit.functions as func {
            if !isset(func.class) || func.name != "gc_free" : continue
            if func.info_collects_gc {
                func.exp.error("gc_free cannot trigger garbage collection")
            }
            if func.info_allocates_gc {
                let source = func.gc_allocation_source
                let via = func.gc_allocation_via
                let suffix = isset(via) ? " through '" + via.name + "'" : ""
                if isset(source) && source != via && source != func {
                    suffix += " (which reaches '" + source.name + "')"
                }
                func.exp.error("gc_free cannot allocate GC-managed objects" + suffix)
            }
            if func.info_calls_unknown_code {
                func.exp.error("gc_free cannot call code with unknown allocation effects")
            }
        }
    }
}

fn propagate_gc_effects(build: Build) {
    let queue = Array[Func]{}
    each build.lists.units as unit {
        each unit.functions as func {
            each func.effect_callees as callee : callee.called_by.append(func, true)
            if func.info_creates_objects || func.info_calls_unknown_code
                || func.info_allocates_gc || func.info_collects_gc
                || func.may_suspend {
                queue.append(func)
            }
        }
    }

    while true {
        let func = queue.pop_last() ! break
        each func.called_by as caller {
            let changed = false
            if func.info_creates_objects && !caller.info_creates_objects {
                caller.info_creates_objects = true
                changed = true
            }
            if func.info_allocates_gc && !caller.info_allocates_gc {
                caller.info_allocates_gc = true
                caller.gc_allocation_source = func.gc_allocation_source ?? func
                caller.gc_allocation_via = func
                changed = true
            }
            if func.info_calls_unknown_code && !caller.info_calls_unknown_code {
                caller.info_calls_unknown_code = true
                changed = true
            }
            if func.info_collects_gc && !caller.info_collects_gc {
                caller.info_collects_gc = true
                changed = true
            }
            if func.may_suspend && !caller.may_suspend {
                caller.may_suspend = true
                changed = true
            }
            if changed : queue.append(caller)
        }
    }

    each build.lists.units as unit {
        each unit.functions as func : func.called_by = .{}
    }
}

fn func_regenerate_ir(func: Func) !Error {
    prepare_func_reparse(func)
    parse_func_ast(func) !>
}

fn prepare_func_reparse(func: Func) {
    let args_only = Array[Decl]{}
    restore_func_generic_scope(func)
    each func.args as arg {
        arg.decl.address_taken = false
        arg.decl.must_be_stable = false
        func.arg_scope.set_idf(arg.name, Idf.for_decl(arg.decl))
        args_only.append(arg.decl, true)
    }
    func.all_decls = args_only
    func.define_decls = .{}
    func.stable_stack_decl = null
    func.test_entry_decl = null
    func.user_defer_stack = null
    func.user_defer_pop = null

    func.functions_used = .{}
    func.globals_used = .{}
    func.strings_used = .{}

    let unit = func.unit
    let dropped = Array[String]{}
    each unit.closure_adapters as owner, name {
        if owner == func : dropped.append(name)
    }
    each dropped as name : unit.closure_adapters.remove(name)
    func.set_ir_code("")

    func.parsed_ast = false
}

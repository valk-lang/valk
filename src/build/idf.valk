// Idf/IDF = identifier for

enum IDF {
    func
    class
    scope  // namespace (and similar) scope, e.g. from `use`
    type   // bound type (e.g. generic parameter T → concrete Type)
    value  // compile-time constant value (macro defs: OS, ARCH, --def, …)
    trait
    global
}

class Idf {
    type: IDF
    func: ?Func (null)
    class: ?Class (null)
    scope: ?Scope (null)
    of_type: ?Type (null)
    value: ?Value (null)
    trait: ?Trait (null)
    global: ?Global (null)

    static fn for_func(func: Func) Idf {
        return Idf {
            type: IDF.func
            func: func
        }
    }

    static fn for_class(class: Class) Idf {
        return Idf {
            type: IDF.class
            class: class
        }
    }

    static fn for_scope(scope: Scope) Idf {
        return Idf {
            type: IDF.scope
            scope: scope
        }
    }

    static fn for_type(of_type: Type) Idf {
        return Idf {
            type: IDF.type
            of_type: of_type
        }
    }

    static fn for_value(value: Value) Idf {
        return Idf {
            type: IDF.value
            value: value
        }
    }

    static fn for_trait(trait: Trait) Idf {
        return Idf {
            type: IDF.trait
            trait: trait
        }
    }

    static fn for_global(g: Global) Idf {
        return Idf {
            type: IDF.global
            global: g
        }
    }
}

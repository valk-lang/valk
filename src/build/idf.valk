// Idf/IDF = identifier for

enum IDF {
    func
    class
}

class Idf {
    type: IDF
    func: ?Func (null)
    class: ?Class (null)

    static fn for_func(func: Func) Idf {
        return Idf {
            type: IDF.func
            func: func
        }
    }

    static fn for_class(class: Class) Idf {
        return Idf {
            type: IDF.class
            class: class
        }
    }
}

// Idf/IDF = identifier for

enum IDF {
    func
    class
    scope  // namespace (and similar) scope, e.g. from `use`
    type   // bound type (e.g. generic parameter T → concrete Type; `type Name (T)`)
    value  // compile-time constant value (macro defs: OS, ARCH, --def, …)
    value_expr // deferred value expression (`value Name (expr)`) — Exp, evaluated on use
    decl   // local / argument variable (Decl)
    trait
    global
    property // compile-time class property metadata from #loop properties
    error_type
    enum
}

class Idf {
    type: IDF
    func: ?Func (null)
    class: ?Class (null)
    scope: ?Scope (null)
    of_type: ?Type (null)
    value: ?Value (null)
    value_exp: ?Exp (null) // IDF.value_expr
    decl: ?Decl (null)
    trait: ?Trait (null)
    global: ?Global (null)
    prop: ?Prop (null)
    error_type: ?ErrorType (null)
    enum: ?Enum (null)

    static fn for_func(func: Func) Idf {
        return Idf {
            type: IDF.func
            func: func
        }
    }

    static fn for_class(class: Class) Idf {
        return Idf {
            type: IDF.class
            class: class
        }
    }

    static fn for_scope(scope: Scope) Idf {
        return Idf {
            type: IDF.scope
            scope: scope
        }
    }

    static fn for_type(of_type: Type) Idf {
        return Idf {
            type: IDF.type
            of_type: of_type
        }
    }

    static fn for_value(value: Value) Idf {
        return Idf {
            type: IDF.value
            value: value
        }
    }

    static fn for_value_expr(value_exp: Exp, scope: Scope) Idf {
        return Idf {
            type: IDF.value_expr
            value_exp: value_exp
            scope: scope
        }
    }

    static fn for_decl(decl: Decl) Idf {
        return Idf {
            type: IDF.decl
            decl: decl
        }
    }

    static fn for_trait(trait: Trait) Idf {
        return Idf {
            type: IDF.trait
            trait: trait
        }
    }

    static fn for_global(g: Global) Idf {
        return Idf {
            type: IDF.global
            global: g
        }
    }

    static fn for_property(prop: Prop) Idf {
        return Idf {
            type: IDF.property
            prop: prop
        }
    }

    static fn for_object_property(prop: Prop, value: Value) Idf {
        return Idf {
            type: IDF.property
            prop: prop
            value: value
        }
    }

    static fn for_error_type(e: ErrorType) Idf {
        return Idf {
            type: IDF.error_type
            error_type: e
        }
    }

    static fn for_enum(enu: Enum) Idf {
        return Idf {
            type: IDF.enum
            enum: enu
        }
    }

}

// Look up an identifier in the built-in valk package, caching successful lookups by
// namespace and name. Namespaces must already be loaded by the pipeline/use resolver.
fn valk_idf(b: Build, ns_name: String, name: String) Idf !Error {
    let ns_cache = b.cache.valk_idf_cache.get(ns_name) !? null
    if isset(ns_cache) {
        let cached = ns_cache.get(name) !? null
        if isset(cached) : return cached
    } else {
        ns_cache = Map[Idf]{}
        b.cache.valk_idf_cache.set(ns_name, ns_cache)
    }

    let main = b.main_pkg ?! b.bug("Main package not found when looking up valk:" + ns_name + ":" + name)
    let valk = main.sub_pkgs.get("valk") !? null
    if !isset(valk) : b.bug("valk package not loaded when looking up valk:" + ns_name + ":" + name)
    let ns = valk.namespaces.get(ns_name) !? null
    if !isset(ns) : b.bug("valk:" + ns_name + " namespace not loaded")
    let idf = ns.scope.get_idf(name)
    if !isset(idf) : b.bug("Missing identifier in valk:" + ns_name + ": " + name)

    ns_cache.set(name, idf)
    return idf
}

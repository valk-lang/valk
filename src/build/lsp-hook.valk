
use lsp


fn lsp_file_content(b: Build, path: String) ?String {
    let l = b.options.lsp ?! return null
    return l.file_content.get(path) !? null
}

fn lsp_register_source(src: Source) {
    let b = src.build
    let l = b.options.lsp ?! return
    let path = src.path ?! return
    if path != l.file : return
    // line/col of 0 means "no cursor" — a didSave diagnostics request
    if l.line == 0 : return
    b.lsp_src = src
    b.lsp_cursor = lsp.lsp_offset_for(src.content, l.line.to(u32), l.col.to(u32))
}

fn lsp_at(exp: Exp) bool {
    let b = exp.src.build
    let src = b.lsp_src ?! return false
    if exp.src != src : return false
    let cursor = b.lsp_cursor
    return exp.i <= cursor && cursor <= exp.i + exp.len
}

fn lsp_completion_at(src: Source, i: u32) bool {
    let b = src.build
    let lsp_src = b.lsp_src ?! return false
    if src != lsp_src : return false
    let l = b.options.lsp ?! return false
    if l.request != lsp.req_completion : return false
    return b.lsp_cursor == i
}

fn lsp_for(at: Exp, request: int) ?lsp.Lsp {
    let b = at.src.build
    if !isset(b.lsp_src) : return null
    let l = b.options.lsp ?! return null
    if l.request != request : return null
    if !lsp_at(at) : return null
    return l
}

// ########################################
// GO TO DEFINITION
// ########################################

fn lsp_goto(at: Exp, target: ?Exp, name: String) !Error {
    let b = at.src.build
    // Finding references: every place a name resolves to a declaration
    if b.lsp_collect_refs {
        let def = target ?! return
        b.lsp_refs.append(LspRef { at: at, target: def, name: name })
        return
    }
    let l = lsp_for(at, lsp.req_definition) ?! return
    let def = target ?! return
    l.send_definition(def)
    at.src.build.lsp_stop()
}

fn lsp_goto_idf(at: Exp, idf: Idf, name: String) !Error {
    lsp_sem_record_idf(at, idf, name)
    lsp_goto(at, idf_def_exp(idf), name) !>
}

class LspInlayHint {
    src: Source
    offset: u32
    label: String
    kind: int
    padding_left: bool (false)
    padding_right: bool (false)
}

class LspSemToken {
    offset: u32
    len: u32
    token_type: u32
    modifiers: u32 (0)
}

fn lsp_word_char(ch: u8) bool {
    return ch.is_alpha_numeric() || ch == '_'
}

fn lsp_find_word_range(content: String, word: String, from: u32, to: u32, last: bool) u32 {
    let result = u32.$max
    if word.bytes == 0 : return result
    let end = to.to(uint)
    if end > content.bytes : end = content.bytes
    let i = from.to(uint)
    while i + word.bytes <= end {
        let hit = content.range(i, word.bytes) == word
        let before_ok = i == 0 || !lsp_word_char(content.get(i - 1))
        let after_ok = i + word.bytes >= content.bytes || !lsp_word_char(content.get(i + word.bytes))
        if hit && before_ok && after_ok {
            result = i.to(u32)
            if !last : return result
        }
        i++
    }
    return result
}

fn lsp_let_inlay_hint(exp: Exp, value_exp: Exp, name: String, decl_type: Type) {
    let b = exp.src.build
    let l = b.options.lsp ?! return
    if l.request != lsp.req_inlay_hint : return
    if name == "_" || name.bytes == 0 : return
    if decl_type.is_void_type() : return

    let at = message_resolve(exp.src, exp.i)
    let path = at.src.path ?! return
    if path != l.file : return

    // Skip trivial literals and casts/constructors where the type is already obvious
    if value_exp.type == EXP.value {
        let vk = value_exp.value_kind
        if vk == VALUE_KIND.number || vk == VALUE_KIND.float || vk == VALUE_KIND.hex
            || vk == VALUE_KIND.octal || vk == VALUE_KIND.string || vk == VALUE_KIND.char
            || vk == VALUE_KIND.bool || vk == VALUE_KIND.null || vk == VALUE_KIND.class_init
            || vk == VALUE_KIND.cast {
            return
        }
    }

    let type_name = decl_type.compat_display_name()
    if type_name.bytes == 0 : return
    let rhs_at = message_resolve(value_exp.src, value_exp.i)
    if rhs_at.src == at.src {
        let rhs_text = at.src.content.range(rhs_at.i, value_exp.len).trim(" ")
        if rhs_text.starts_with(type_name + "{") || rhs_text.starts_with(type_name + " {")
            || rhs_text.starts_with(type_name + ".new(")
            || rhs_text.contains(".to(" + type_name + ")")
            || rhs_text.contains("@cast(" + type_name + ")") {
            return
        }
    }

    let search_end = at.i + exp.len
    if rhs_at.src == at.src && rhs_at.i > at.i && rhs_at.i < search_end : search_end = rhs_at.i
    let word_pos = lsp_find_word_range(at.src.content, name, at.i, search_end, false)
    if word_pos == u32.$max : return

    b.lsp_inlay_hints.append(LspInlayHint {
        src: at.src
        offset: word_pos + name.bytes.to(u32)
        label: ": " + type_name
        kind: 1
    })
}

fn lsp_call_inlay_hints(call_func: ?Func, skip: uint, args_exp: ?Exp, explicit: uint) {
    let func = call_func ?! return
    let list = args_exp ?! return
    if explicit < 2 : return
    let b = list.src.build
    let l = b.options.lsp ?! return
    if l.request != lsp.req_inlay_hint : return

    let call_src = message_resolve(list.src, list.i)
    let path = call_src.src.path ?! return
    if path != l.file : return

    let i: uint = 0
    while i < explicit {
        let a = list.get(i)
        if !isset(a) : break
        i++
        if a.type == EXP.value && (a.value_kind == VALUE_KIND.named_arg || a.value_kind == VALUE_KIND.spread) : continue
        let param = func.args.get(skip + i - 1) !? null
        if !isset(param) || param.implicit || isset(param.variadic) : continue
        let pname = param.name
        if pname.bytes == 0 || pname == "_" : continue

        let arg_at = message_resolve(a.src, a.i)
        if arg_at.src != call_src.src : continue
        let arg_text = arg_at.src.content.range(arg_at.i, a.len).trim(" ")
        if arg_text == pname || arg_text.ends_with("." + pname) : continue

        b.lsp_inlay_hints.append(LspInlayHint {
            src: arg_at.src
            offset: arg_at.i
            label: pname + ":"
            kind: 2
            padding_right: true
        })
    }
}

fn lsp_sem_record(at: Exp, name: String, token_type: int, modifiers: int, last_word: bool) {
    let b = at.src.build
    let l = b.options.lsp ?! return
    if l.request != lsp.req_semantic_tokens : return
    let res = message_resolve(at.src, at.i)
    let path = res.src.path ?! return
    if path != l.file : return
    let found = lsp_find_word_range(res.src.content, name, res.i, res.i + at.len, last_word)
    if found == u32.$max : return
    b.lsp_sem_tokens.append(LspSemToken {
        offset: found
        len: name.bytes.to(u32)
        token_type: token_type.to(u32)
        modifiers: modifiers.to(u32)
    })
}

fn lsp_sem_record_offset(src: Source, offset: u32, len: u32, token_type: int, modifiers: int) {
    let b = src.build
    let l = b.options.lsp ?! return
    if l.request != lsp.req_semantic_tokens : return
    let path = src.path ?! return
    if path != l.file : return
    b.lsp_sem_tokens.append(LspSemToken {
        offset: offset
        len: len
        token_type: token_type.to(u32)
        modifiers: modifiers.to(u32)
    })
}

fn lsp_sem_record_func(at: Exp, f: Func, name: String) {
    let kind = isset(f.class) ? lsp.sem_method : lsp.sem_function
    let mods = (isset(f.class) && f.is_static) ? lsp.sem_mod_static : 0
    lsp_sem_record(at, name, kind, mods, true)
}

fn lsp_sem_record_idf(at: Exp, idf: Idf, name: String) {
    let b = at.src.build
    let l = b.options.lsp ?! return
    if l.request != lsp.req_semantic_tokens : return

    if idf.type == IDF.func {
        let f = idf.func ?! return
        lsp_sem_record_func(at, f, name)
        return
    }
    if idf.type == IDF.class {
        let c = idf.class ?! return
        let kind = c.kind == CLASS_KIND.struct ? lsp.sem_struct
            : (c.kind == CLASS_KIND.interface || c.kind == CLASS_KIND.union || c.kind == CLASS_KIND.mode ? lsp.sem_type : lsp.sem_class)
        lsp_sem_record(at, name, kind, 0, true)
        return
    }
    if idf.type == IDF.enum || idf.type == IDF.error_type {
        lsp_sem_record(at, name, lsp.sem_enum, 0, true)
        return
    }
    if idf.type == IDF.trait || idf.type == IDF.type {
        lsp_sem_record(at, name, lsp.sem_type, 0, true)
        return
    }
    if idf.type == IDF.scope {
        lsp_sem_record(at, name, lsp.sem_namespace, 0, true)
        return
    }
    if idf.type == IDF.property {
        lsp_sem_record(at, name, lsp.sem_property, 0, true)
        return
    }
    if idf.type == IDF.global {
        lsp_sem_record(at, name, lsp.sem_variable, 0, true)
        return
    }
    if idf.type == IDF.value || idf.type == IDF.value_expr {
        lsp_sem_record(at, name, lsp.sem_variable, lsp.sem_mod_readonly, true)
        return
    }
    if idf.type == IDF.decl {
        let d = idf.decl ?! return
        let kind = d.is_arg ? lsp.sem_parameter : lsp.sem_variable
        let mods = d.is_written ? 0 : lsp.sem_mod_readonly
        lsp_sem_record(at, name, kind, mods, true)
        return
    }
}

// A use of a name, `at`, and the declaration it resolves to
class LspRef {
    at: Exp
    target: Exp
    name: String
}

// The declaration span behind an identifier, or null when it has none.
fn idf_def_exp(idf: Idf) ?Exp {
    if idf.type == IDF.func {
        let f = idf.func
        if isset(f) : return f.exp
    } else if idf.type == IDF.class {
        let c = idf.class
        if isset(c) : return c.exp
    } else if idf.type == IDF.global {
        let g = idf.global
        if isset(g) : return g.exp
    } else if idf.type == IDF.enum {
        let e = idf.enum
        if isset(e) : return e.exp
    } else if idf.type == IDF.error_type {
        let et = idf.error_type
        if isset(et) : return et.exp
    } else if idf.type == IDF.trait {
        let t = idf.trait
        if isset(t) : return t.exp
    } else if idf.type == IDF.property {
        let p = idf.prop
        if isset(p) : return p.exp
    } else if idf.type == IDF.decl {
        let d = idf.decl
        if isset(d) : return d.exp
    } else if idf.type == IDF.value_expr {
        return idf.value_exp
    } else if idf.type == IDF.type {
        let t = idf.of_type
        if isset(t) {
            let c = t.class
            if isset(c) : return c.exp
        }
    }
    return null
}

// ########################################
// HOVER
// ########################################

fn lsp_hover(at: Exp, v: Value) !Error {
    let l = lsp_for(at, lsp.req_hover) ?! return
    l.send_hover(hover_text(v), at, hover_doc(v))
    at.src.build.lsp_stop()
}

fn lsp_hover_idf(at: Exp, idf: Idf) !Error {
    let l = lsp_for(at, lsp.req_hover) ?! return
    let text = idf_hover_text(idf)
    if text.length == 0 : return
    l.send_hover(text, at, idf_doc(idf))
    at.src.build.lsp_stop()
}

fn hover_text(v: Value) String {
    if v.type == VAL.func {
        let f = v.func
        if isset(f) : return func_named_signature(f, call_receiver_skip(v, f))
    }
    // A type used as a value (`String`, `Enum1`, a class) describes itself
    if v.type == VAL.type {
        let t = v.get_of_type()
        if isset(t) {
            let e = t.get_enum()
            if isset(e) : return "enum " + e.name
            let et = t.get_error_type()
            if isset(et) : return "error " + et.name
            let c = t.class
            if isset(c) && (t.kind == TYPE.gcptr || t.kind == TYPE.interface) : return class_declaration_text(c)
            return t.compat_display_name()
        }
        let c = v.get_class_ref()
        if isset(c) : return class_declaration_text(c)
    }
    return v.rett.compat_display_name()
}

fn func_named_signature(f: Func, skip: uint (0)) String {
    let label = func_signature_label(f, skip)
    let text = "fn " + f.name + label.range(2, label.bytes - 2)
    if f.is_deprecated : text += " $deprecated"
    return text
}

fn hover_doc(v: Value) ?String {
    if v.type == VAL.func {
        let f = v.func
        if isset(f) : return func_doc(f)
    }
    if v.type == VAL.type {
        let t = v.get_of_type()
        if isset(t) {
            let c = t.class
            if isset(c) : return class_doc(c)
        }
        let c = v.get_class_ref()
        if isset(c) : return class_doc(c)
    }
    return null
}

fn idf_doc(idf: Idf) ?String {
    if idf.type == IDF.func {
        let f = idf.func
        if isset(f) : return func_doc(f)
    } else if idf.type == IDF.class {
        let c = idf.class
        if isset(c) : return class_doc(c)
    } else if idf.type == IDF.global {
        let g = idf.global
        if isset(g) : return doc_span(g.exp)
    } else if idf.type == IDF.property {
        let p = idf.prop
        if isset(p) : return prop_doc(p)
    } else if idf.type == IDF.enum {
        let e = idf.enum
        if isset(e) : return doc_span(e.exp)
    } else if idf.type == IDF.error_type {
        let et = idf.error_type
        if isset(et) : return doc_span(et.exp)
    }
    return null
}

fn idf_hover_text(idf: Idf) String {
    if idf.type == IDF.func {
        let f = idf.func
        if isset(f) : return func_named_signature(f)
    } else if idf.type == IDF.class {
        let c = idf.class
        if isset(c) : return class_declaration_text(c)
    } else if idf.type == IDF.enum {
        let e = idf.enum
        if isset(e) : return "enum " + e.name
    } else if idf.type == IDF.error_type {
        let et = idf.error_type
        if isset(et) : return "error " + et.name
    } else if idf.type == IDF.trait {
        let t = idf.trait
        if isset(t) : return "trait " + t.name
    } else if idf.type == IDF.type {
        let t = idf.of_type
        if isset(t) : return t.compat_display_name()
    } else if idf.type == IDF.global {
        let g = idf.global
        if isset(g) {
            let gt = g.type
            if isset(gt) : return "global " + g.name + ": " + gt.compat_display_name()
            return "global " + g.name
        }
    } else if idf.type == IDF.property {
        let p = idf.prop
        if isset(p) : return (p.name ?? "") + ": " + p.type.compat_display_name()
    } else if idf.type == IDF.decl {
        let d = idf.decl
        if isset(d) : return d.type.compat_display_name()
    }
    return ""
}

fn class_declaration_text(c: Class) String {
    let kind = c.kind
    if kind == CLASS_KIND.union : return "union " + c.pretty_name()
    if kind == CLASS_KIND.interface : return "interface " + c.pretty_name()
    if kind == CLASS_KIND.struct : return "struct " + c.pretty_name()
    if kind == CLASS_KIND.slice || kind == CLASS_KIND.array || kind == CLASS_KIND.unbound {
        let element = c.slice_type
        let keyword = kind == CLASS_KIND.array ? "array" : kind == CLASS_KIND.slice ? "slice" : "unbound"
        return keyword + " " + c.pretty_name() + " of " + (isset(element) ? element.compat_display_name() : "?")
    }
    if kind == CLASS_KIND.mode : return "mode " + c.pretty_name()
    if kind == CLASS_KIND.class : return "class " + c.pretty_name()
    return c.pretty_name()
}

// ########################################
// COMPLETION
// ########################################

fn lsp_visible_idfs(scope: Scope) Map[Idf] {
    let out = Map[Idf]{}
    let s = scope
    while true {
        let idfs = s.identifiers
        if isset(idfs) {
            each idfs as idf, name {
                if !out.has(name) : out.set(name, idf)
            }
        }
        let parent = s.parent
        if !isset(parent) : break
        s = parent
    }
    return out
}

// Names in scope at `at`, filtered to what `at` is actually allowed to use.
fn lsp_complete_scope(at: Exp, scope: Scope) !Error {
    let l = lsp_for(at, lsp.req_completion) ?! return
    let items = Array[lsp.Completion]{}
    each lsp_visible_idfs(scope) as idf, name {
        // Compiler-made names such as the `&` slice class cannot be written as identifiers
        if name.bytes == 0 : continue
        let first = name.get(0)
        if !first.is_alpha() && first != '_' : continue
        if !lsp_idf_allowed(at, idf) : continue
        let idf_func = idf.func
        items.append(lsp.Completion {
            type: lsp.completion_kind_for_idf(idf)
            label: name
            deprecated: idf.type == IDF.func && isset(idf_func) && idf_func.is_deprecated
        })
    }
    l.send_completion(items)
    at.src.build.lsp_stop()
}

fn lsp_idf_allowed(at: Exp, idf: Idf) bool {
    let def = idf_def_exp(idf) ?! return true
    return act_allows(at, idf_act(idf), def, false)
}

fn idf_act(idf: Idf) ACT {
    if idf.type == IDF.func {
        let f = idf.func
        if isset(f) : return f.act
    } else if idf.type == IDF.class {
        let c = idf.class
        if isset(c) : return c.act
    } else if idf.type == IDF.global {
        let g = idf.global
        if isset(g) : return g.act
    } else if idf.type == IDF.enum {
        let e = idf.enum
        if isset(e) : return e.act
    } else if idf.type == IDF.error_type {
        let et = idf.error_type
        if isset(et) : return et.act
    } else if idf.type == IDF.trait {
        let t = idf.trait
        if isset(t) : return t.act
    } else if idf.type == IDF.property {
        let p = idf.prop
        if isset(p) : return p.act
    }
    // Locals, bound types and compile-time values carry no marker
    return ACT.public
}

fn lsp_complete_class(at: Exp, class: Class) !Error {
    let l = lsp_for(at, lsp.req_completion) ?! return
    let items = Array[lsp.Completion]{}
    let seen = Array[String]{}

    let c = class
    while true {
        each c.funcs as func, name {
            if seen.contains(name) : continue
            seen.append(name)
            if !act_allows(at, func.act, func.exp, false) : continue
            items.append(lsp.Completion {
                type: func.is_getter ? lsp.ck_property : lsp.ck_method
                label: name
                deprecated: func.is_deprecated
            })
        }
        each c.props as prop {
            let name = prop.name
            if !isset(name) : continue
            if seen.contains(name) : continue
            seen.append(name)
            if !act_allows(at, prop.act, prop.exp, false) : continue
            items.append(lsp.Completion {
                type: lsp.ck_field
                label: name
            })
        }
        each c.groups as group, name {
            if seen.contains(name) : continue
            seen.append(name)
            items.append(lsp.Completion {
                type: lsp.ck_module
                label: name
            })
        }
        let for_class = c.mode_for_class
        if !isset(for_class) : break
        c = for_class
    }

    l.send_completion(items)
    at.src.build.lsp_stop()
}

fn lsp_complete_group(at: Exp, group: Group) !Error {
    let l = lsp_for(at, lsp.req_completion) ?! return
    let items = Array[lsp.Completion]{}
    each group.funcs as func, name {
        if !act_allows(at, func.act, func.exp, false) : continue
        items.append(lsp.Completion {
            type: func.is_getter ? lsp.ck_property : lsp.ck_method
            label: name
            deprecated: func.is_deprecated
        })
    }
    l.send_completion(items)
    at.src.build.lsp_stop()
}

fn lsp_complete_enum(at: Exp, enu: Enum) !Error {
    let l = lsp_for(at, lsp.req_completion) ?! return
    let items = Array[lsp.Completion]{}
    each enu.items as item {
        items.append(lsp.Completion {
            type: lsp.ck_enum_member
            label: item.name
        })
    }
    l.send_completion(items)
    at.src.build.lsp_stop()
}

fn lsp_complete_error_codes(at: Exp, et: ErrorType) !Error {
    let l = lsp_for(at, lsp.req_completion) ?! return
    let items = Array[lsp.Completion]{}
    each et.codes as code {
        items.append(lsp.Completion {
            type: lsp.ck_enum_member
            label: code
        })
    }
    each et.payload as type, name {
        items.append(lsp.Completion {
            type: lsp.ck_field
            label: name
        })
    }
    l.send_completion(items)
    at.src.build.lsp_stop()
}

// After an error code: its one method
fn lsp_complete_error_code_value(at: Exp) !Error {
    let l = lsp_for(at, lsp.req_completion) ?! return
    let items = Array[lsp.Completion]{ lsp.Completion {
        type: lsp.ck_method
        label: "name"
        insert: "name()"
        detail: "() String"
    } }
    l.send_completion(items)
    at.src.build.lsp_stop()
}

// ########################################
// SIGNATURE HELP
// ########################################

fn lsp_sig_help_call(at: Exp, func: Func, args_exp: ?Exp, skip: uint) !Error {
    let l = lsp_for(at, lsp.req_sig_help) ?! return
    let parts = func_arg_labels(func, skip)
    l.send_sig_help(func_signature_label(func, skip), parts, lsp_active_arg(args_exp, at.src.build.lsp_cursor))
    at.src.build.lsp_stop()
}

fn lsp_active_arg(args_exp: ?Exp, cursor: u32) uint {
    let args = args_exp ?! return 0
    let i: uint = 0
    while true {
        let arg = args.get(i)
        if !isset(arg) : break
        if cursor <= arg.i + arg.len : return i
        i++
    }
    return i
}

// `fn(name: Type, …) Rett !ErrorType`, as it would be written in source.
fn func_signature_label(func: Func, skip: uint (0)) String {
    let label = "fn(" + func_arg_labels(func, skip).join(", ") + ")"
    let rett = func.get_rett()
    if !rett.is_void_type() : label += " " + rett.compat_display_name()
    let et = func.error_type
    if isset(et) : label += " !" + et.name
    return label
}

fn func_arg_labels(func: Func, skip: uint (0)) Array[String] {
    let parts = Array[String]{}
    each func.args as arg, i {
        if i < skip : continue
        let variadic = arg.variadic
        parts.append(arg.name + ": " + (isset(variadic) ? "..." + variadic.compat_display_name() : arg.type.compat_display_name()))
    }
    return parts
}

fn lsp_should_parse_func_ast(func: Func) bool {
    return func.check_required || lsp_parses_bodies_in(func.ns.build, func.exp.src)
}

// Whether the LSP looks inside function and test bodies of this source: only for the
// requested file and files open in the editor. Everything else is declarations only.
fn lsp_parses_bodies_in(b: Build, src: Source) bool {
    let parent = src.parent
    while isset(parent) {
        src = parent
        parent = src.parent
    }
    // Formatting checks the syntax of the formatted files only
    if b.options.is_fmt && !isset(b.options.lsp) {
        each b.format_sources as formatted {
            if formatted == src : return true
        }
        return false
    }
    let l = b.options.lsp ?! return true
    // Finding references reads every body of the package
    if b.lsp_collect_refs {
        let ns = src.ns
        return isset(ns) && ns.pkg == b.main_pkg
    }
    let path = src.path ?! return true
    if l.request == lsp.req_diagnostics || l.request == lsp.req_none {
        return path == l.file || l.file_content.has(path)
    }
    return path == l.file
}

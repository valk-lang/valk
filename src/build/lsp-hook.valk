
use lsp

// Integration points for the language server. The server drives an ordinary
// Build (front end only, see BuildOptions.front_end_only) and gets its answers
// from the same resolution the compiler already performs, so it can never
// disagree with the compiler about what an identifier means.
//
// Two mechanisms are used:
//
// Diagnostics need no cursor. The build simply runs and Build.messages holds
// what it found; the server converts those to publishDiagnostics.
//
// Definition, completion and signature help are cursor requests. The cursor's
// byte offset in its file is resolved once, when that file is loaded, and every
// hook site then asks lsp_at(exp) whether the expression under resolution is
// the one the cursor is in. Because the resolver visits sub-expressions before
// their parents (the left of `a.b` resolves before the dot), the innermost
// expression containing the cursor is always the first to match. Once a hook
// has responded it calls Build.lsp_stop to unwind the rest of the build.

// Content for a file being loaded. Editors send buffers that have not been
// written to disk, so an open file must be read from the server rather than the
// file system or the LSP would report errors for code the user already fixed.
fn lsp_file_content(b: Build, path: String) ?String {
    let l = b.options.lsp ?! return null
    return l.file_content.get(path) !? null
}

// Called for every Source as it is created. When this is the file a cursor
// request refers to, record it together with the cursor's byte offset.
fn lsp_register_source(src: Source) {
    let b = src.build
    let l = b.options.lsp ?! return
    let path = src.path ?! return
    if path != l.file : return
    // line/col of 0 means "no cursor" — a didSave diagnostics request
    if l.line == 0 : return
    b.lsp_src = src
    b.lsp_cursor = lsp:lsp_offset_for(src.content, l.line.to(u32), l.col.to(u32))
}

// True when the cursor of the active request lies within `exp`. The end is
// inclusive: after typing an identifier the caret sits just past its last byte,
// and that still means "this identifier".
fn lsp_at(exp: Exp) bool {
    let b = exp.src.build
    let src = b.lsp_src ?! return false
    if exp.src != src : return false
    let cursor = b.lsp_cursor
    return exp.i <= cursor && cursor <= exp.i + exp.len
}

// True when a completion request's cursor sits exactly at byte `i` of `src`.
//
// The parser uses this to accept the incomplete expressions that completion is
// always asked about: `a.` and `ns:` are what the user has typed at the moment
// they want to see the members of `a` or of `ns`, and both are syntax errors.
// Rather than teach the parser general error recovery, it keeps such an
// expression only when the cursor is exactly at the point of truncation, so no
// ordinary build can take this path.
fn lsp_completion_at(src: Source, i: u32) bool {
    let b = src.build
    let lsp_src = b.lsp_src ?! return false
    if src != lsp_src : return false
    let l = b.options.lsp ?! return false
    if l.request != lsp:req_completion : return false
    return b.lsp_cursor == i
}

// The active server, but only when it is serving `request` and the cursor is
// inside `at`. Every hook below starts here, so a build with no LSP attached
// pays one null check per site.
fn lsp_for(at: Exp, request: int) ?lsp:Lsp {
    let b = at.src.build
    if !isset(b.lsp_src) : return null
    let l = b.options.lsp ?! return null
    if l.request != request : return null
    if !lsp_at(at) : return null
    return l
}

// ########################################
// GO TO DEFINITION
// ########################################

// Answer a definition request at `at` with the span of `target`, then stop the
// build. A null target means the declaration has no span to jump to (a compiler
// temporary, or a primitive with no source), which is not an error: the server
// replies with an empty result.
fn lsp_goto(at: Exp, target: ?Exp) !Error {
    let l = lsp_for(at, lsp:req_definition) ?! return
    let def = target ?! return
    l.send_definition(def)
    at.src.build.lsp_stop()
}

fn lsp_goto_idf(at: Exp, idf: Idf) !Error {
    lsp_goto(at, idf_def_exp(idf)) !>
}

// The declaration span behind an identifier, or null when it has none.
fn idf_def_exp(idf: Idf) ?Exp {
    if idf.type == IDF.func {
        let f = idf.func
        if isset(f) : return f.exp
    } else if idf.type == IDF.class {
        let c = idf.class
        if isset(c) : return c.exp
    } else if idf.type == IDF.global {
        let g = idf.global
        if isset(g) : return g.exp
    } else if idf.type == IDF.enum {
        let e = idf.enum
        if isset(e) : return e.exp
    } else if idf.type == IDF.error_type {
        let et = idf.error_type
        if isset(et) : return et.exp
    } else if idf.type == IDF.trait {
        let t = idf.trait
        if isset(t) : return t.exp
    } else if idf.type == IDF.property {
        let p = idf.prop
        if isset(p) : return p.exp
    } else if idf.type == IDF.decl {
        let d = idf.decl
        if isset(d) : return d.exp
    } else if idf.type == IDF.value_expr {
        return idf.value_exp
    } else if idf.type == IDF.type {
        // A bound type points at its class when it has one; generic parameters
        // and primitives have no declaration of their own.
        let t = idf.of_type
        if isset(t) {
            let c = t.class
            if isset(c) : return c.exp
        }
    }
    return null
}

// ########################################
// HOVER
// ########################################

// What the expression under the cursor resolved to. The text is deliberately
// derived from the resolved Value rather than from the source, so it shows the
// compiler's conclusion — including an inferred type the user never wrote.
fn lsp_hover(at: Exp, v: Value) !Error {
    let l = lsp_for(at, lsp:req_hover) ?! return
    l.send_hover(hover_text(v), at)
    at.src.build.lsp_stop()
}

// Hover for a name in a type position. There is no Value to describe there, and
// the identifier may be a class, enum, error type or bound generic parameter, so
// it is described from the Idf the same way a value position is described from
// its Value.
fn lsp_hover_idf(at: Exp, idf: Idf) !Error {
    let l = lsp_for(at, lsp:req_hover) ?! return
    let text = idf_hover_text(idf)
    if text.length == 0 : return
    l.send_hover(text, at)
    at.src.build.lsp_stop()
}

fn hover_text(v: Value) String {
    // A function reference shows its signature rather than the opaque `fn(...)`
    // type, and its name, which the type alone does not carry.
    if v.type == VAL.func {
        let f = v.func
        if isset(f) : return func_named_signature(f, call_receiver_skip(v, f))
    }
    // A type used as a value (`String`, `Enum1`, a class) describes itself
    if v.type == VAL.type {
        let t = v.get_of_type()
        if isset(t) {
            // An enum's Type reports its underlying representation (`int`), which
            // is not what naming the enum means to a reader.
            let e = t.get_enum()
            if isset(e) : return "enum " + e.name
            let et = t.get_error_type()
            if isset(et) : return "error " + et.name
            // Named a class directly, so describe it the same way a type position
            // does. Wrapper types (`?T`, `*T`, multi) have no class and fall
            // through to their written form.
            let c = t.class
    if isset(c) && t.kind == TYPE.gcptr : return class_declaration_text(c)
            return t.compat_display_name()
        }
        let c = v.get_class_ref()
        if isset(c) : return class_declaration_text(c)
    }
    return v.rett.compat_display_name()
}

// `fn name(args) Rett !Err`. func_signature_label produces the anonymous form
// starting with "fn(", so the name is spliced in after it.
fn func_named_signature(f: Func, skip: uint (0)) String {
    let label = func_signature_label(f, skip)
    return "fn " + f.name + label.part(2, label.bytes - 2)
}

fn idf_hover_text(idf: Idf) String {
    if idf.type == IDF.func {
        let f = idf.func
        if isset(f) : return func_named_signature(f)
    } else if idf.type == IDF.class {
        let c = idf.class
        if isset(c) : return class_declaration_text(c)
    } else if idf.type == IDF.enum {
        let e = idf.enum
        if isset(e) : return "enum " + e.name
    } else if idf.type == IDF.error_type {
        let et = idf.error_type
        if isset(et) : return "error " + et.name
    } else if idf.type == IDF.trait {
        let t = idf.trait
        if isset(t) : return "trait " + t.name
    } else if idf.type == IDF.type {
        let t = idf.of_type
        if isset(t) : return t.compat_display_name()
    } else if idf.type == IDF.global {
        let g = idf.global
        if isset(g) {
            let gt = g.type
            if isset(gt) : return "global " + g.name + ": " + gt.compat_display_name()
            return "global " + g.name
        }
    } else if idf.type == IDF.property {
        let p = idf.prop
        if isset(p) : return (p.name ?? "") + ": " + p.type.compat_display_name()
    } else if idf.type == IDF.decl {
        let d = idf.decl
        if isset(d) : return d.type.compat_display_name()
    }
    return ""
}

// How a class would be introduced in source, so a struct or slice does not read
// as a class. The number and pointer kinds are the built-in primitives: `uint`
// and `bool` are classes internally, but "class uint" is noise to a reader, so
// they are shown bare.
fn class_declaration_text(c: Class) String {
    let kind = c.kind
    if kind == CLASS_KIND.union : return "union " + c.pretty_name()
    if kind == CLASS_KIND.interface : return "interface " + c.pretty_name()
    if kind == CLASS_KIND.struct : return "struct " + c.pretty_name()
    if kind == CLASS_KIND.slice || kind == CLASS_KIND.array {
        let element = c.slice_type
        let keyword = kind == CLASS_KIND.array ? "array" : "slice"
        return keyword + " " + c.pretty_name() + " of " + (isset(element) ? element.compat_display_name() : "?")
    }
    if kind == CLASS_KIND.mode : return "mode " + c.pretty_name()
    if kind == CLASS_KIND.class : return "class " + c.pretty_name()
    return c.pretty_name()
}

// ########################################
// COMPLETION
// ########################################

// Identifiers visible at `scope`, with the nearest declaration of a name
// shadowing any outer one, matching how get_idf resolves.
fn lsp_visible_idfs(scope: Scope) Map[Idf] {
    let out = Map[Idf]{}
    let s = scope
    while true {
        let idfs = s.identifiers
        if isset(idfs) {
            each idfs as idf, name {
                if !out.has(name) : out.set(name, idf)
            }
        }
        let parent = s.parent
        if !isset(parent) : break
        s = parent
    }
    return out
}

// Names in scope at `at`, filtered to what `at` is actually allowed to use.
fn lsp_complete_scope(at: Exp, scope: Scope) !Error {
    let l = lsp_for(at, lsp:req_completion) ?! return
    let items = Array[lsp:Completion]{}
    each lsp_visible_idfs(scope) as idf, name {
        if !lsp_idf_allowed(at, idf) : continue
        items.append(lsp:Completion {
            type: lsp:completion_kind_for_idf(idf)
            label: name
        })
    }
    l.send_completion(items)
    at.src.build.lsp_stop()
}

fn lsp_idf_allowed(at: Exp, idf: Idf) bool {
    let def = idf_def_exp(idf) ?! return true
    return act_allows(at, idf_act(idf), def, false)
}

fn idf_act(idf: Idf) ACT {
    if idf.type == IDF.func {
        let f = idf.func
        if isset(f) : return f.act
    } else if idf.type == IDF.class {
        let c = idf.class
        if isset(c) : return c.act
    } else if idf.type == IDF.global {
        let g = idf.global
        if isset(g) : return g.act
    } else if idf.type == IDF.enum {
        let e = idf.enum
        if isset(e) : return e.act
    } else if idf.type == IDF.error_type {
        let et = idf.error_type
        if isset(et) : return et.act
    } else if idf.type == IDF.trait {
        let t = idf.trait
        if isset(t) : return t.act
    } else if idf.type == IDF.property {
        let p = idf.prop
        if isset(p) : return p.act
    }
    // Locals, bound types and compile-time values carry no marker
    return ACT.public
}

// Members of `class` reachable through a dot at `at`: methods and getters,
// properties, then groups.
//
// A `mode X for Y` class resolves members it does not define on Y (see
// get_func / get_prop_by_name), so the completion list follows that chain too —
// otherwise a mode would appear to have almost no members. A method on the mode
// shadows same-named storage on the wrapped class, exactly as lookup does.
fn lsp_complete_class(at: Exp, class: Class) !Error {
    let l = lsp_for(at, lsp:req_completion) ?! return
    let items = Array[lsp:Completion]{}
    let seen = Array[String]{}

    let c = class
    while true {
        each c.funcs as func, name {
            if seen.contains(name) : continue
            seen.append(name)
            if !act_allows(at, func.act, func.exp, false) : continue
            items.append(lsp:Completion {
                type: func.is_getter ? lsp:ck_property : lsp:ck_method
                label: name
            })
        }
        each c.props as prop {
            let name = prop.name
            if !isset(name) : continue
            if seen.contains(name) : continue
            seen.append(name)
            if !act_allows(at, prop.act, prop.exp, false) : continue
            items.append(lsp:Completion {
                type: lsp:ck_field
                label: name
            })
        }
        each c.groups as group, name {
            if seen.contains(name) : continue
            seen.append(name)
            items.append(lsp:Completion {
                type: lsp:ck_module
                label: name
            })
        }
        let for_class = c.mode_for_class
        if !isset(for_class) : break
        c = for_class
    }

    l.send_completion(items)
    at.src.build.lsp_stop()
}

fn lsp_complete_group(at: Exp, group: Group) !Error {
    let l = lsp_for(at, lsp:req_completion) ?! return
    let items = Array[lsp:Completion]{}
    each group.funcs as func, name {
        if !act_allows(at, func.act, func.exp, false) : continue
        items.append(lsp:Completion {
            type: func.is_getter ? lsp:ck_property : lsp:ck_method
            label: name
        })
    }
    l.send_completion(items)
    at.src.build.lsp_stop()
}

fn lsp_complete_enum(at: Exp, enu: Enum) !Error {
    let l = lsp_for(at, lsp:req_completion) ?! return
    let items = Array[lsp:Completion]{}
    each enu.items as item {
        items.append(lsp:Completion {
            type: lsp:ck_enum_member
            label: item.name
        })
    }
    l.send_completion(items)
    at.src.build.lsp_stop()
}

fn lsp_complete_error_codes(at: Exp, et: ErrorType) !Error {
    let l = lsp_for(at, lsp:req_completion) ?! return
    let items = Array[lsp:Completion]{}
    each et.codes as code {
        items.append(lsp:Completion {
            type: lsp:ck_enum_member
            label: code
        })
    }
    each et.payload as type, name {
        items.append(lsp:Completion {
            type: lsp:ck_field
            label: name
        })
    }
    l.send_completion(items)
    at.src.build.lsp_stop()
}

// ########################################
// SIGNATURE HELP
// ########################################

// Signature help for a call the cursor is inside. `skip` is how many of the
// function's leading arguments the call site does not write out (the receiver of
// an instance method), so both the label and the highlighted argument describe
// the call as it appears in source.
fn lsp_sig_help_call(at: Exp, func: Func, args_exp: ?Exp, skip: uint) !Error {
    let l = lsp_for(at, lsp:req_sig_help) ?! return
    let parts = func_arg_labels(func, skip)
    l.send_sig_help(func_signature_label(func, skip), parts, lsp_active_arg(args_exp, at.src.build.lsp_cursor))
    at.src.build.lsp_stop()
}

// Index of the written argument the cursor is in. Past the end of every argument
// means the user is typing the next one, which is the index after the last.
fn lsp_active_arg(args_exp: ?Exp, cursor: u32) uint {
    let args = args_exp ?! return 0
    let i: uint = 0
    while true {
        let arg = args.get(i)
        if !isset(arg) : break
        if cursor <= arg.i + arg.len : return i
        i++
    }
    return i
}

// `fn(name: Type, …) Rett !ErrorType`, as it would be written in source.
fn func_signature_label(func: Func, skip: uint (0)) String {
    let label = "fn(" + func_arg_labels(func, skip).join(", ") + ")"
    let rett = func.get_rett()
    if !rett.is_void_type() : label += " " + rett.compat_display_name()
    let et = func.error_type
    if isset(et) : label += " !" + et.name
    return label
}

fn func_arg_labels(func: Func, skip: uint (0)) Array[String] {
    let parts = Array[String]{}
    each func.args as arg, i {
        if i < skip : continue
        parts.append(arg.name + ": " + arg.type.compat_display_name())
    }
    return parts
}


// Access type
enum ACT : u8 {
    undefined (0)
    private (1)
    readonly (2)
    public (4)
}

// Expression type
enum EXP {
    // Base expressions
    use
    func
    test
    class
    enum
    // Common
    id
    type
    body // {...} <{ ... } [...] (...)
    comment
    // Class body members
    prop
    group
    // Func expressions
    let
    if
    while
}

// Indices into Exp.sub_exps (one enum per EXP kind so slots stay dense)
enum FUNC_EXP : uint {
    generics
    args
    type
    error
    body
}
enum CLASS_EXP : uint {
    generics
    body
}
enum TEST_EXP : uint {
    body
}
enum ENUM_EXP : uint {
    type
    body
}
enum USE_EXP : uint {
    id
}
// Class property: name: Type [(default)] [flags]
enum PROP_EXP : uint {
    type
    default
}
// Class group: group name { ... }
enum GROUP_EXP : uint {
    body
}
// Nested content for EXP.type (str1 holds the type form: "named", "?", "*", "&", ...)
enum TYPE_EXP : uint {
    type
    id
    generics
    args
    rett
    error
}


// Access type
enum ACT : u8 {
    undefined (0)
    private (1)
    readonly (2)
    public (4)
}

// Expression type
enum EXP {
    // Base expressions
    use
    func
    test
    class
    enum
    macro // #if / #elif / #else / #end / #loop / ...
    global // global / shared / @shared
    alias // alias Name for Id
    alias_type // type Name (Type)
    alias_value // value Name (Value)
    // Common
    id
    type
    value
    body // {...} <{ ... } [...] (...)
    comment
    // Class body members
    prop
    group
    // Func expressions
    let
    if
    while
}

// ---- Exp.kind discriminators (u8; one family per EXP type) ----

// EXP.class / Class.kind
enum CLASS_KIND : u8 {
    class
    struct
    slice
    pointer
    integer
    float
    boolean
    mode
}

// EXP.global — keyword form
// allow_unsafe later: kind == at_shared || (is_extern && kind == shared)
enum GLOBAL_KIND : u8 {
    global
    shared
    at_shared
}

// EXP.macro — #keyword
enum MACRO_KIND : u8 {
    if
    elif
    else
    end
    loop
    print
    error
    print_type
    print_value_type
}

// EXP.func — regular fn vs getter
enum FUNC_KIND : u8 {
    fn
    get
}

// EXP.type form (replaces former str1 form tags)
enum TYPE_KIND : u8 {
    named
    void
    nullable // ?
    ptr      // *
    ptr_slice // *[]
    ref      // &
    ref_slice // &[]
    inline
    array
    multi
    fn
    fnptr
    co
    notnull
    error_dot // .
}

// EXP.value form (replaces former str1 form tags)
// For op/unary, `number` holds VALUE_OP.
// For number/string/char/bool literals, `str1` holds the source text.
// For bool, `bool1` is the value; str1 unused.
// For id, VALUE_EXP.left → EXP.id
// For dot, str1 = prop name
enum VALUE_KIND : u8 {
    id
    number
    float
    hex
    octal
    string
    char
    bool
    null
    op
    unary
    call
    paren
    dot
    multi
}

// Operators for VALUE_KIND.op / VALUE_KIND.unary (stored in Exp.number)
enum VALUE_OP : u8 {
    // unary
    not
    neg
    // compare
    eq
    ne
    lt
    gt
    lte
    gte
    // arithmetic
    add
    sub
    mul
    div
    mod
    // logic
    and
    or
}

// Indices into Exp.sub_exps (one enum per EXP type so slots stay dense)
enum FUNC_EXP : uint {
    generics
    args
    type
    error
    body
}
enum CLASS_EXP : uint {
    generics
    body
}
enum TEST_EXP : uint {
    body
}
enum ENUM_EXP : uint {
    type
    body
}
enum USE_EXP : uint {
    id
}
// Global / shared / @shared: name: Type [(default)]
// str1 = name; kind = GLOBAL_KIND; bool2 = is_extern
enum GLOBAL_EXP : uint {
    type
    default
}
// alias Name for Id — str1 = name
enum ALIAS_EXP : uint {
    id
}
// type Name (Type) — str1 = name
enum ALIAS_TYPE_EXP : uint {
    type
}
// value Name (Value) — str1 = name
enum ALIAS_VALUE_EXP : uint {
    value
}
// Class property: name: Type [(default)] [flags]
enum PROP_EXP : uint {
    type
    default
}
// Class group: group name { ... }
enum GROUP_EXP : uint {
    body
}
// Nested content for EXP.type (kind = TYPE_KIND)
enum TYPE_EXP : uint {
    type
    id
    generics
    args
    rett
    error
}
// Compile macro directive (kind = MACRO_KIND)
// str2 = string literal for #print / #error
// list = remaining words for #loop
enum MACRO_EXP : uint {
    value // condition for #if / #elif (EXP.value)
}
// Nested content for EXP.value (kind = VALUE_KIND)
enum VALUE_EXP : uint {
    left  // binary left, unary operand, paren inner, call callee, dot left, id
    right // binary right, call args (multi)
}

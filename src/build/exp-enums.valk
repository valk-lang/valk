
// Access type
enum ACT : u8 {
    undefined (0)
    private (1)
    readonly (2)
    public (4)
}

// Expression type
enum EXP {
    // Base expressions
    use
    func
    test
    class
    enum
    macro // #if / #elif / #else / #end / #loop / ...
    // Common
    id
    type
    value
    body // {...} <{ ... } [...] (...)
    comment
    // Class body members
    prop
    group
    // Func expressions
    let
    if
    while
}

// Indices into Exp.sub_exps (one enum per EXP kind so slots stay dense)
enum FUNC_EXP : uint {
    generics
    args
    type
    error
    body
}
enum CLASS_EXP : uint {
    generics
    body
}
enum TEST_EXP : uint {
    body
}
enum ENUM_EXP : uint {
    type
    body
}
enum USE_EXP : uint {
    id
}
// Class property: name: Type [(default)] [flags]
enum PROP_EXP : uint {
    type
    default
}
// Class group: group name { ... }
enum GROUP_EXP : uint {
    body
}
// Nested content for EXP.type (str1 holds the type form: "named", "?", "*", "&", ...)
enum TYPE_EXP : uint {
    type
    id
    generics
    args
    rett
    error
}
// Compile macro directive: #if / #elif / #else / #end / #loop / ...
// str1 = keyword ("if", "elif", "else", "end", "loop", "print", "error", ...)
// str2 = string literal for #print / #error
// list = remaining words for #loop (kind + names)
enum MACRO_EXP : uint {
    value // condition for #if / #elif (EXP.value)
}
// Nested content for EXP.value (str1 holds the form).
//   "id"     — left = EXP.id
//   "number"/"float"/"hex"/"octal"/"string"/"char"/"bool" — str2 = literal text
//   "null"
//   "op"     — str2 = operator, left/right
//   "unary"  — str2 = operator, left = operand
//   "call"   — left = callee, right = args (form "multi")
//   "paren"  — left = inner
//   "dot"    — str2 = prop name, left = object
//   "multi"  — sequential sub_exps (call argument list)
enum VALUE_EXP : uint {
    left  // binary left, unary operand, paren inner, call callee, dot left, id
    right // binary right, call args (multi)
}

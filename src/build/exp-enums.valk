
// Access type
enum ACT : u8 {
    undefined (0)
    private (1)
    readonly (2)
    public (4)
}

// Expression type
enum EXP {
    // Base expressions
    use
    func
    test
    class
    enum
    // Common
    id
    body // {...} <{ ... } [...] (...)
    // Func expressions
    let
    if
    while
}

// Indices into Exp.sub_exps (one enum per EXP kind so slots stay dense)
enum FUNC_EXP : uint {
    generics
    args
    body
}
enum CLASS_EXP : uint {
    generics
    body
}
enum TEST_EXP : uint {
    body
}
enum ENUM_EXP : uint {
    body
}
enum USE_EXP : uint {
    id
}


// Access type
enum ACT : u8 {
    undefined (0)
    private (1)
    readonly (2)
    public (4)
}

// Expression type
enum EXP {
    // Base expressions
    use
    func
    test
    class
    enum
    macro // #if / #elif / #else / #end / #loop / ...
    global // global / shared / @shared
    alias // alias Name for Id [$global]
    alias_type // type Name (Type) [$global]
    alias_value // value Name (Value) [$global]
    link // link ["dynamic"|"static"|"framework"] "lib"
    error // error Name (codes) [extends (...)] [payload {...}] [$global]
    ignore_access // @ignore_access (file-level; sets Source.ignore_access)
    trait // trait Name[T]? { ... }
    trait_use // class-body `use Trait` / `use Trait[T]` (mix trait members into class)
    // Top-level: extend Class [ [T, U] ] { members }
    // Adds members to an existing class (methods, props unless $noNewProperties, …)
    extend
    // Common
    id
    type
    value
    body // {...} <{ ... } [...] (...)
    // Class body members
    prop
    group
    // Function-body statements (created by read_func_body_exps)
    let       // let name[: Type], ... = value
    if        // if cond { } / if cond : stmt [else ...]
    while     // while cond { } / while cond : stmt
    return    // return [value]
    defer     // defer call — run the call when the enclosing function exits
    assign    // lvalue (=|+=|-=|…) value
    stmt      // expression statement (value used for side effects)
    block     // `{ ... }` nested block (body_exps)
    each      // each on [skip n] as name[, name...] { } / each … : stmt (codegen later)
    throw     // throw … (later)
    break
    continue
    allocas   // @allocas — splice the function's entry allocas at this point
    init_allocators // @INIT_ALLOCATORS — initialize all generated GC allocators
    ir_comment // ir_comment("...") — preserved for generated LLVM output
}

// ---- Exp.kind discriminators (u8; one family per EXP type) ----

// EXP.class / Class.kind
enum CLASS_KIND : u8 {
    class
    struct
    slice
    pointer
    integer
    float
    boolean
    mode
}

// EXP.global — keyword form
// allow_unsafe later: kind == at_shared || (is_extern && kind == shared)
enum GLOBAL_KIND : u8 {
    global
    shared
    at_shared
}

// EXP.link / Link.type — optional keyword after `link`
// `auto` means no keyword: dynamic unless the build is static
enum LINK_KIND : u8 {
    auto
    dynamic
    static
    framework
}

// EXP.macro — #keyword
enum MACRO_KIND : u8 {
    if
    elif
    else
    end
    loop
    print
    error
}

// EXP.func — regular fn vs getter
enum FUNC_KIND : u8 {
    fn
    get
}

// EXP.type form (replaces former str1 form tags)
enum TYPE_KIND : u8 {
    named
    void
    null // only valid as a union alternative; normalizes to outer nullability
    nullable // ?
    ptr      // *
    ptr_slice // *[]
    ref      // &
    ref_slice // &[]
    inline
    array
    multi
    union // A | B
    fn
    fnptr
    co
    notnull
    typeof // typeof(value) — TYPE_EXP.type holds EXP.value
    suggested // .
}

// EXP.value form (replaces former str1 form tags)
// For op/unary, `number` holds VALUE_OP.
// For number/string/char/bool literals, `str1` holds the source text.
// For bool, `bool1` is the value; str1 unused.
// For id, VALUE_EXP.left → EXP.id
// For dot, str1 = prop name
// For typeof, left = operand value
enum VALUE_KIND : u8 {
    id
    number
    float
    hex
    octal
    string // str1 = quoted token; bool1 = raw `r"..."` prefix
    char
    bool
    null // bare `null` (needs ctx type) or `null[Type]` (left = EXP.type)
    undefined // @undefined — leave destination storage uninitialized
    memcpy // @memcpy(from, to, length)
    op
    unary
    call
    paren
    dot
    multi
    // Fixed-array initializer repeat marker: `{ value... }`.
    // Only valid inside an array initializer; repeats the preceding value/group to its size.
    repeat
    cast // value.@cast(Type) — left = value, right = EXP.type
    typeof // typeof(value) — left = value; resolves to VAL.type of value.rett
    size_of // size_of(Type) — left = EXP.type; folds to VAL.int
    // Postfix/prefix ++ / -- : left = operand; bool1 = true if prefix
    incr
    decr
    // Error code literal: `.range` / `.missing` (str1 = code name)
    error_code
    // Class / struct init: Type { … } or bare { … }
    // left = type/id value (optional for bare; type from the suggestion at lower)
    // right = EXP.body `{...}` — re-parsed as fields or array elems at lower
    class_init
    // Index / generic args: value[…] — left = base, right = EXP.body `[...]`
    // Lowering re-parses the body as types (specialize) or a value (index).
    // Tight `[` (no space), same as method calls.
    offset
    // @ptrv(ptr, Type, offset?) — right = EXP.body `(...)`; re-parsed at lower
    // (value, type, optional value). Result element type is the Type arg.
    ptrv
    // @ref(assignable) — right = EXP.body `(...)`; re-parsed as a single value.
    // Result is a raw ptr to the lvalue.
    ref_of
    // cond ? then : else — left=cond, right=then, third=else
    ternary
    // left ?? right — null-coalesce; left must be nullable
    null_coalesce
    // left ?! body — null-or-exit; left nullable; right = EXP.block (or single-stmt block)
    null_exit
    // isset(value) — left = operand; folds to bool + tracks Decl issets
    isset
    // Error handler after a fallible call (and later offsets).
    // left = call/value; number = ERRH_KIND; right = alt value / block / success body
    // For ERRH.success, list = bound names; right = body block
    error_handler
    // Value scope: `<{ ... }` — left = EXP.body `{...}` (after `<{` opener).
    // Returns produce the value (phi of all return paths); not a function return.
    vscope
    // Anonymous function literal: `fn(args) rett! { body }`. Sub-exps indexed by
    // FUNC_LIT_EXP (needs 4 slots — more than the generic left/right/third).
    func_lit
    // `co <call>` — launch a coroutine; left = the call expression.
    co
    // `await <task>` — left = the task expression. Followed by an optional error-handler
    // suffix (parsed inline here, same as after a call/offset — see try_read_error_handler).
    await
    // `error_is(code, name, ...)` builtin — left = code value; list = bare code names.
    error_is
    // `match on [: Type] { case => body ... }`
    // left = matched value, right = optional result type, third = raw `{...}` body
    match
    // `#embed("path")` — str1 = path, resolved relative to the containing package's
    // root dir at Stage 3; folds to a String constant with the file's content.
    embed
    // `#embed_dir("path")` — str1 = path; folds to a HashMap[String, String] constant
    // (relative file path → content) for every file under the directory.
    embed_dir
}

// Sub-expressions for VALUE_KIND.func_lit (indices into Exp.sub_exps)
enum FUNC_LIT_EXP : uint {
    args  // EXP.body `(...)`
    type  // EXP.type — optional return type
    error // EXP.id — optional error type after `!`
    body  // EXP.body `{...}`
}

// Discriminator for VALUE_KIND.error_handler (stored in Exp.number)
enum ERRH_KIND : u8 {
    block     // call ! { ... } / call ! stmt
    value     // call !? alt
    pass      // call !>  (rethrow / pass to caller)
    panic     // call !!
    ignore    // call _
    success   // call -> name { ... } / call -> (a, b) { ... }
}

// Class-init body item kind (stored in Exp.number on each multi child)
enum CLASS_INIT_ITEM : u8 {
    field // prop: value  — str1 = name, left = value
    elem  // value        — left = value  ($append)
    pair  // key => value — left = key, right = value  ($set_key)
}

// Operators for VALUE_KIND.op / VALUE_KIND.unary (stored in Exp.number)
enum VALUE_OP : u8 {
    // unary
    not
    neg
    bit_not // ~
    ref_of  // &lvalue — address-of, yields &T (distinct from @ref, which yields raw ptr)
    // compare
    eq
    ne
    lt
    gt
    lte
    gte
    // arithmetic
    add
    sub
    mul
    div
    mod
    // bitwise
    bit_and
    bit_or
    bit_xor
    shl
    shr
    // logic
    and
    or
}

// Indices into Exp.sub_exps (one enum per EXP type so slots stay dense)
enum FUNC_EXP : uint {
    generics
    args
    type
    error
    body
}
// EXP.class — str1 = name; kind = CLASS_KIND
// mode: CLASS_EXP.mode_for = EXP.type after `for`
enum CLASS_EXP : uint {
    generics
    body
    mode_for // EXP.type — only for CLASS_KIND.mode (`for Type`)
}
enum TEST_EXP : uint {
    body
}
enum ENUM_EXP : uint {
    type
    body
}
enum USE_EXP : uint {
    id
}
// Global / shared / @shared: name: Type [(default)]
// str1 = name; kind = GLOBAL_KIND; bool2 = is_extern
enum GLOBAL_EXP : uint {
    type
    default
}
// alias Name for Id [$global] — str1 = name; bool1 = $global
enum ALIAS_EXP : uint {
    id
}
// type Name (Type) [$global] — str1 = name; body is raw EXP.body `(...)` (parsed later); bool1 = $global
enum ALIAS_TYPE_EXP : uint {
    body
}
// value Name (Value) [$global] — str1 = name; body is raw EXP.body `(...)` (parsed later); bool1 = $global
enum ALIAS_VALUE_EXP : uint {
    body
}
// error Name (codes) [extends (...)] [payload {...}] [$global]
// str1 = name; list = error code names; bool1 = $global
// extends / payload bodies are raw EXP.body (types resolved later)
enum ERROR_EXP : uint {
    extends // EXP.body `(...)`
    payload // EXP.body `{...}`
}
// Class property: name: Type [(default)] [flags]
enum PROP_EXP : uint {
    type
    default
}
// Class group: group name { ... }
enum GROUP_EXP : uint {
    body
}
// trait Name[T]? { ... } — str1 = name
enum TRAIT_EXP : uint {
    generics // EXP.body `[...]`
    body     // EXP.body `{...}`
}
// Class-body `use Trait` / `use Trait[T, U]`
enum TRAIT_USE_EXP : uint {
    id       // EXP.id
    generics // multi TYPE_KIND.multi of type args (optional)
}
// Top-level `extend Class [ [T, U] ] { ... }`
// Generic names remapped for the extend body (must match target class arity).
enum EXTEND_EXP : uint {
    id       // EXP.id of class being extended
    generics // EXP.body `[...]` of name remaps (optional; required if class is generic)
    body     // EXP.body `{...}`
}
// Nested content for EXP.type (kind = TYPE_KIND)
enum TYPE_EXP : uint {
    type
    id
    generics
    args
    rett
    error
    size // EXP.value — compile-time size after `x` (e.g. [T x N], ptr[T x size_of(U)])
}
// Compile macro directive (kind = MACRO_KIND)
// str2 = string literal for #print / #error
// list = remaining words for #loop
enum MACRO_EXP : uint {
    value // condition for #if / #elif (EXP.value)
}
// Nested content for EXP.value (kind = VALUE_KIND)
enum VALUE_EXP : uint {
    left  // binary left, unary operand, paren inner, call callee, dot left, id, null[Type]
    // binary right, call args (multi), ternary then, ?? right, error-handler payload,
    // and for VALUE_KIND.id: optional multi TYPE of generic args (`X[T, U]`)
    right
    third // ternary else branch
}
enum MATCH_EXP : uint {
    on
    type
    body
}
// Function-body statement sub-expressions
// EXP.let: list = names; LET_EXP.types multi optional; LET_EXP.value = EXP.value
enum LET_EXP : uint {
    types // multi of optional EXP.type per name (null = infer)
    value // RHS EXP.value
}
// EXP.if
enum IF_EXP : uint {
    cond
    then_body // EXP.block or single statement
    else_body // EXP.block / EXP.if / statement (optional)
}
// EXP.while
enum WHILE_EXP : uint {
    cond
    body
}
// EXP.each — list = variable names as written (`as a, b, i`); whether the last
// name is the index value is resolved later, against the iterated type(s).
enum EACH_EXP : uint {
    on    // value being iterated
    skip  // optional start-index value
    body  // EXP.block or single statement
}
// EXP.return — RETURN_EXP.value optional
enum RETURN_EXP : uint {
    value
}
// EXP.defer — DEFER_EXP.value is the call/error-handler expression to run.
enum DEFER_EXP : uint {
    value
}
// EXP.assign — str1 = op text ("=", "+=", …); kind = ASSIGN_OP
enum ASSIGN_EXP : uint {
    left  // EXP.value (lvalue)
    right // EXP.value
}
// EXP.stmt — single value expression as a statement
enum STMT_EXP : uint {
    value
}
// EXP.block — sequential statements in body_exps (when format) or re-read from body span
// Also used as then/else/while bodies: EXP.body span of `{...}` contents via BLOCK_EXP.body
enum BLOCK_EXP : uint {
    body // EXP.body `{...}` raw span (statements parsed later / nested)
}

// Assignment operator for EXP.assign.kind
enum ASSIGN_OP : u8 {
    set    // =
    add    // +=
    sub    // -=
    mul    // *=
    div    // /=
    mod    // %=
    bit_and // &=
    bit_or  // |=
    bit_xor // ^=
}

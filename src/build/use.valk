// Compiler-facing `use` statement created from EXP.use.
// `is_used` tracks whether the import is referenced (for unused-use warnings later).
class Use {
    unit: Unit
    ns: Namespace
    exp: Exp
    // Target id expression (namespace / path)
    id: ?Exp (null)
    // Optional `as alias` name
    alias: ?String (null)
    // Namespace resolved and loaded from the id
    target_ns: ?Namespace (null)
    is_used: bool (false)
}

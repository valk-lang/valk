
fn mark_reachable(build: Build) !Error {
    mark_reachable_roots(build) !>

    while mark_allocator_helpers(build) !> {}
}

fn mark_reachable_roots(build: Build) !Error {
    each build.lists.units as unit {
        unit.is_used = false
        unit.string_used.set_all(false)
        each unit.functions as func {
            func.info_used = false
            func.used_from = null
        }
    }
    each build.lists.globals as global : global.is_used = false

    mark_export_roots(build) !>

    if build.options.mode == BUILDTYPE.lib {
        mark_library_roots(build) !>
    } else {
        each build.lists.units as unit {
            each unit.functions as func {
                if func.is_entrance && func_ir_name(func) == "main" : mark_func_used(func)
            }
        }
        let main_func = build.main_func
        if isset(main_func) : mark_func_used(main_func)
    }

}

fn mark_export_roots(build: Build) !Error {
    let names = Map[bool]{}
    each build.lists.units as unit {
        each unit.functions as func {
            if !func.is_export : continue
            if names.has(func.name) : func.exp.error("Exported symbol name is already used: " + func.name)
            names.set(func.name, true)
            mark_func_used(func)
        }
    }
    each build.lists.globals as global {
        if !global.is_export : continue
        if names.has(global.name) : global.exp.error("Exported symbol name is already used: " + global.name)
        names.set(global.name, true)
        mark_global_used(global)
    }
}

fn mark_library_roots(build: Build) !Error {
    let main_pkg = build.main_pkg ?! build.bug("Missing main package")
    each build.lists.units as unit {
        each unit.functions as func {
            if func.ns.pkg == main_pkg : mark_func_used(func)
        }
    }
    each build.lists.globals as global {
        if global.ns.pkg == main_pkg : mark_global_used(global)
    }
}

fn mark_allocator_helpers(build: Build) bool !Error {
    let found = false
    each build.lists.allocator_init_sites as site {
        let owner = site.ctx.func ?! continue
        if !owner.info_used : continue
        each build.lists.allocators as allocator {
            let global = allocator.global
            if !global.is_used : continue
            let pool_class = (global.get_type() !>).get_class_or_null()
            if !isset(pool_class) : build.bug("Generated allocator global is not a Pool")
            let init = pool_class.get_func(allocator_setup_name(build))
            if isset(init) && mark_func_used(init) : found = true
            let onfree = allocator.onfree
            if isset(onfree) && mark_func_used(onfree) : found = true
            let env_clone = allocator.env_clone
            if isset(env_clone) && mark_func_used(env_clone) : found = true
        }
        if build.grove_mode() {
            each (allocator_routine_callees(build) !>) as callee {
                if mark_func_used(callee) : found = true
            }
        }
    }
    return found
}

fn mark_func_used(func: Func) bool {
    if func.info_used : return false
    let queue = Array[Func]{}
    queue.append(func)
    while true {
        let item = queue.pop_last() ! break
        if item.info_used : continue
        item.info_used = true
        if !item.parsed_ast : item.ns.build.pipeline.reachable_func_asts.append(item, true)
        if !item.is_extern : item.unit.is_used = true

        each item.strings_used as index : item.unit.string_used.set_expand(index, true, false)
        each item.globals_used as global : mark_global_used(global)
        each item.functions_used as sub {
            if sub.info_used : continue
            if !isset(sub.used_from) : sub.used_from = item
            queue.append(sub)
        }
    }
    return true
}

fn mark_global_used(global: Global) {
    if global.is_used : return
    global.is_used = true
    if !global.is_extern : global.unit.is_used = true
}

// M1: a Grove program that can start a thread is built in MT mode. Under `--gc auto` it is
// built with Valk's collector instead (until Grove-MT becomes the default)
fn check_grove_reachable(build: Build) !Error {
    if !build.grove_mode() || build.grove_mt_mode() : return
    each build.lists.units as unit {
        each unit.functions as func {
            if !func.info_used : continue
            if !is_thread_start(func) && !(func.is_entrance && !entrance_is_gc_free(func)) : continue
            if build.gc_auto() : build.gc_fallback = true
            else if build.options.grove_mt : build.error("A thread start is reachable through '" + func_user_name(func) + "': Grove's single-threaded mode (GROVE_MT=0) cannot build this program")
            else : build.gc_restart_mt = true
            throw .error
        }
    }
}

// M1: a raw thread entry (other than a Valk thread's own) that allocates nothing, calls into
// no GC code and no unknown code; such a call tree gets no polls and no native brackets
fn entrance_is_gc_free(entry: Func) bool {
    if is_thread_entry(entry) : return true
    let seen = Array[Func]{}
    let queue = Array[Func]{ entry }
    while true {
        let func = queue.pop_last() ! break
        if seen.contains(func) : continue
        seen.append(func)
        if func.is_extern : continue
        if func.info_allocates_gc || func.info_calls_unknown_code || func.info_collects_gc || func.may_suspend : return false
        if ir_func_in_gc(func) || !func.parsed_ast : return false
        each func.effect_callees as callee : queue.append(callee)
    }
    return true
}

// The program's entry, and Thread[T].entry and thread_entry[T], which run only behind Thread.start
fn is_thread_entry(func: Func) bool {
    // The program's own entry runs on the main thread
    if func.name == "__valk_main__" : return true
    if func.ns.name != "thread" || func.ns.pkg.name != "valk" : return false
    return func.name == "entry" || func.name == "thread_entry"
}

fn is_thread_start(func: Func) bool {
    if func.name != "start" : return false
    let class = func.class ?! return false
    let base = class.generic_from ?? class
    return base.name == "Thread" && base.ns.name == "thread" && base.ns.pkg.name == "valk"
}

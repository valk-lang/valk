////////////////////////////
// Type constructors
////////////////////////////

fn type_void(b: Build) Type {
    let cache = b.cache.type_void
    if isset(cache) : return cache
    let t = Type {
        build: b
        kind: TYPE.void
    }
    b.cache.type_void = t
    return t
}

// Multi-return / multi-value type `(T, U, …)`. Single element (unless force) folds to that type.
fn type_multi(b: Build, types: Array[Type], force_multi: bool (false)) Type {
    if types.length == 0 && !force_multi : return type_void(b)
    if types.length == 1 && !force_multi {
        return types.get(0) !? type_void(b)
    }
    return Type {
        build: b
        kind: TYPE.struct
        info: UnionTypeInfo { members: types }
        is_inline: true
    }
}

fn type_identity_key(type: Type) String {
    let cache = type.get_cache()
    let cached = cache.cached_identity_key
    if isset(cached) : return cached
    let out = ByteBuffer.new()
    type_append_key(type, out)
    let key = out.to_string()
    cache.cached_identity_key = key
    return key
}

fn type_union(b: Build, input: Array[Type], at: Exp, owner: ?Class (null)) Type !Error {
    let members = Array[Type]{}

    each input as member {
        // Nullability belongs to the whole union: `?U`, never an alternative
        if member.is_nullable_type() {
            at.error("A union alternative cannot be nullable; use '?' on the union type instead of on '" + member.compat_display_name() + "'")
        }
        if isset(owner) && member.class == owner {
            at.error("A union cannot contain itself; put it in a container such as 'Array[" + owner.pretty_name() + "]'")
        }
        // A named union is a type of its own: it cannot be one of the
        // alternatives, only its alternatives can
        if member.kind == TYPE.union && isset(member.class) {
            at.error("A union alternative cannot be a union; list the alternatives of '" + member.compat_display_name() + "' here instead")
        }
        if member.kind == TYPE.union && !isset(member.class) {
            let nested = member.get_members()
            if isset(nested) {
                each nested as item : members.append(item)
            }
        } else {
            if member.is_void_type() && !member.is_null_alt() : at.error("A union cannot contain void")
            if member.kind == TYPE.any : at.error("A union cannot contain any")
            if member.is_vector_type() : at.error("A union cannot contain a vector")
            members.append(member)
        }
    }

    members.sort(fn(a: Type, b: Type) bool {
        return type_identity_key(a) > type_identity_key(b)
    })
    let sorted = Array[Type]{}
    let previous = ""
    let first = true
    each members as member {
        let key = type_identity_key(member)
        if !first && key == previous : continue
        sorted.append(member)
        previous = key
        first = false
    }

    if sorted.length == 0 : at.error("A union must contain at least one type")
    if sorted.length > 256 : at.error("A union cannot contain more than 256 types")
    if sorted.length == 1 && !isset(owner) {
        return sorted.get(0) !? type_void(b)
    }
    return Type {
        build: b
        kind: TYPE.union
        info: UnionTypeInfo { members: sorted }
        class: owner
    }
}

// Whether `t` stores the union `owner` inline: in a fixed array or a tuple. Structs that do are
// reported by the size check.
fn type_holds_inline(t: Type, owner: Class) bool {
    if t.kind == TYPE.union && t.class == owner : return true
    if t.kind == TYPE.fixed_array {
        let sub = t.get_sub_type()
        return isset(sub) && type_holds_inline(sub, owner)
    }
    if t.is_tuple_type() {
        let members = t.get_members() ?! return false
        each members as member {
            if type_holds_inline(member, owner) : return true
        }
    }
    return false
}

fn type_null_alt(b: Build) Type {
    return Type {
        build: b
        kind: TYPE.void
        custom_name: "null"
    }
}

fn type_union_from_exp(exp: Exp, scope: Scope, owner: ?Class (null)) Type !Error {
    let b = exp.src.build
    if isset(owner) : b = owner.ns.build
    let members = Array[Type]{}
    let has_null = false
    let i: uint = 0
    while true {
        let member_exp = exp.get(i)
        if !isset(member_exp) : break
        if member_exp.type_kind == TYPE_KIND.null {
            if has_null : member_exp.error("Duplicate union alternative: null")
            has_null = true
            members.append(type_null_alt(b))
        } else {
            let member = type_from_exp(member_exp, scope) !>
            let key = type_identity_key(member)
            each members as existing {
                if type_identity_key(existing) == key {
                    member_exp.error("Duplicate union alternative: " + member.compat_display_name())
                }
            }
            members.append(member)
        }
        i++
    }

    return type_union(b, members, exp, owner) !>
}

// Resolve a named union without collapsing its final non-null alternative.
fn type_named_union(owner: Class, exp: Exp) Type !Error {
    if exp.type != EXP.type || exp.type_kind != TYPE_KIND.union {
        exp.bug("Named union alternatives are not a union type expression")
    }
    return type_union_from_exp(exp, owner.scope, owner) !>
}

fn type_any(b: Build) Type {
    let cache = b.cache.type_any
    if isset(cache) : return cache
    let t = Type {
        build: b
        kind: TYPE.any
    }
    b.cache.type_any = t
    return t
}

// Primitive types (no Class). Used before valk.core classes are registered.
fn type_prim_int(b: Build) Type {
    let cache = b.cache.type_prim_int
    if isset(cache) : return cache
    let t = Type {
        build: b
        kind: TYPE.int
    }
    b.cache.type_prim_int = t
    return t
}

fn type_prim_string(b: Build) Type {
    let cache = b.cache.type_prim_string
    if isset(cache) : return cache
    let t = Type {
        build: b
        kind: TYPE.gcptr
    }
    b.cache.type_prim_string = t
    return t
}

fn type_prim_bool(b: Build) Type {
    let cache = b.cache.type_prim_bool
    if isset(cache) : return cache
    let t = Type {
        build: b
        kind: TYPE.bool
    }
    b.cache.type_prim_bool = t
    return t
}

////////////////////////////
// Named core types
////////////////////////////

fn type_from_core(b: Build, name: String) Type !Error {
    let cached = b.cache.core_types.get(name) !? null
    if isset(cached) : return cached

    let idf = valk_idf(b, "core", name) !>
    if idf.type != IDF.class : b.bug("Identifier in valk.core is not a class: " + name)
    let c = idf.class
    if !isset(c) : b.bug("Class idf is missing class for: " + name)
    let t = c.get_type() !>
    b.cache.core_types.set(name, t)
    return t
}

// Look up a concrete class in a namespace from the built-in `valk` package.
fn type_from_valk_namespace(b: Build, ns_name: String, name: String) Type !Error {
    let idf = valk_idf(b, ns_name, name) !>
    if idf.type != IDF.class : b.bug("Identifier in valk:" + ns_name + " is not a class: " + name)
    let c = idf.class
    if !isset(c) : b.bug("Class idf is missing class for: " + ns_name + ":" + name)
    return c.get_type() !>
}

// Soft core lookup: returns null if the class is not registered yet (no error).
fn type_from_core_or_null(b: Build, name: String) ?Type {
    let cached = b.cache.core_types.get(name) !? null
    if isset(cached) : return cached

    // $global core classes live on Build.scope once parse_class_exp has run
    let idf = b.scope.get_idf(name)
    if !isset(idf) : return null
    if idf.type != IDF.class : return null
    let c = idf.class
    if !isset(c) : return null
    if c.is_generic_base : return null
    let t = c.get_type() ! return null
    b.cache.core_types.set(name, t)
    return t
}

// Prefer real core class; fall back to primitive stand-in before core is parsed.
fn type_int(b: Build) Type {
    let t = type_from_core_or_null(b, "int")
    if isset(t) : return t
    return type_prim_int(b)
}
fn type_float(b: Build) Type !Error {
    return type_from_core(b, "float") !>
}
fn type_bool(b: Build) Type {
    let t = type_from_core_or_null(b, "bool")
    if isset(t) : return t
    return type_prim_bool(b)
}

fn type_i64(b: Build) Type {
    let t = type_from_core_or_null(b, "i64")
    if isset(t) : return t
    return type_prim_int(b)
}

fn type_u8(b: Build) Type {
    return type_from_core_or_null(b, "u8") ?? type_prim_int(b)
}

// `mode char for u8` in core; falls back to the base so the compiler still
// builds against a std lib that has no char mode yet.
fn type_char(b: Build) Type {
    return type_from_core_or_null(b, "char") ?? type_u8(b)
}

fn type_byte_array(b: Build, size: u32) Type {
    let key = size.to_string()
    let cached = b.cache.byte_array_types.get(key) !? null
    if isset(cached) : return cached
    let sub = type_from_core_or_null(b, "u8") ?? type_prim_int(b)
    let t = Type {
        build: b
        kind: TYPE.fixed_array
        info: UnaryTypeInfo { sub: sub }
        length: size.to(uint)
        is_inline: true
    }
    b.cache.byte_array_types.set(key, t)
    return t
}
fn type_string(b: Build) Type {
    let t = type_from_core_or_null(b, "String")
    if isset(t) : return t
    return type_prim_string(b)
}

// `.code` / `TypeName.code` (is_instance false) or a caught-error binding `E` (true).
fn type_error_code(et: ErrorType, is_instance: bool (false)) Type {
    return Type {
        build: et.ns.build
        kind: TYPE.error_code
        info: et
        error_is_instance: is_instance
    }
}

// Raw `ptr` (void-style pointer class from core, or a bare TYPE.voidptr stand-in).
fn type_ptr(b: Build) Type {
    let t = type_from_core_or_null(b, "ptr")
    if isset(t) : return t
    let cache = b.cache.type_prim_ptr
    if isset(cache) : return cache
    let prim = Type {
        build: b
        kind: TYPE.voidptr
    }
    b.cache.type_prim_ptr = prim
    return prim
}

fn type_from_inner_exp(exp: Exp, scope: Scope, missing: String) Type !Error {
    let inner = exp.get(TYPE_EXP.type)
    if !isset(inner) : exp.bug(missing)
    return type_from_exp(inner, scope) !>
}

fn type_error_from_exp(exp: Exp, scope: Scope) ?ErrorType !Error {
    let err_exp = exp.get(TYPE_EXP.error)
    if !isset(err_exp) : return null
    let idf = resolve_idf_from_id(err_exp, scope) !>
    if idf.type != IDF.error_type : err_exp.error("Identifier must be an error type")
    let error_type = idf.error_type
    if !isset(error_type) : err_exp.bug("Error-type idf is missing error_type")
    return error_type
}

fn type_validate_sequence_element(sub: Type, at: Exp) !Error {
    if sub.is_void_type() : at.error("Sequence element type cannot be void")
}

fn type_callable_from_exp(exp: Exp, scope: Scope, kind: TYPE) Type !Error {
    let args = Array[Type]{}
    let args_exp = exp.get(TYPE_EXP.args)
    if kind != TYPE.co && isset(args_exp) {
        args = (type_from_multi_exp(args_exp, scope, true) !>).get_members() ?? Array[Type]{}
        each args as arg {
            if arg.is_void_type() : exp.error("Callable arguments cannot be void")
        }
    }

    let returns = Array[Type]{}
    let rett_exp = exp.get(TYPE_EXP.rett)
    if isset(rett_exp) {
        let rett = type_from_exp(rett_exp, scope) !>
        let members = rett.get_members()
        if rett.kind == TYPE.struct && rett.is_inline && !isset(rett.class) && isset(members) {
            each members as member {
                if member.is_void_type() : exp.error("Callable return lists cannot contain void")
                returns.append(member)
            }
        } else if !rett.is_void_type() {
            returns.append(rett)
        }
    }
    let error_type = type_error_from_exp(exp, scope) !>
    if kind == TYPE.co {
        validate_coroutine_error_type(error_type, exp) !>
    }

    return Type {
        build: exp.src.build
        kind: kind
        info: FunctionTypeInfo {
            args: args
            returns: returns
            error_type: error_type
        }
    }
}

fn type_callable(b: Build, kind: TYPE, args: Array[Type], rett: Type, error_type: ?ErrorType, shared: bool (false)) Type {
    let returns = Array[Type]{}
    let members = rett.get_members()
    if rett.kind == TYPE.struct && rett.is_inline && !isset(rett.class) && isset(members) {
        each members as member : returns.append(member)
    } else if !rett.is_void_type() {
        returns.append(rett)
    }
    return Type {
        build: b
        kind: kind
        info: FunctionTypeInfo {
            args: args
            returns: returns
            error_type: error_type
        }
        is_shared: shared
    }
}

////////////////////////////
// Type expressions
////////////////////////////

fn type_validate_struct_gc_storage(type: Type, at: Exp) !Error {
    let class = type_find_unsafe_struct_pointer(type, Array[Class]{})
    if isset(class) {
        at.error("Struct pointer type '*" + class.pretty_name() + "' contains managed references; store it inline or use a class")
    }
}

// A closure reachable in 'type' that is not itself a shared callable cannot be
// published: it would become shared without its captures ever being checked,
// unlike a closure written as a 'shared fn' in the first place.
fn type_has_unpublishable_closure(type: Type, seen: Array[Class]) bool {
    let t = type.get_non_nullable()
    if t.is_shared : return false
    if t.kind == TYPE.ptr_of || t.kind == TYPE.adr_of || t.kind == TYPE.voidptr || t.kind == TYPE.ref_of : return false
    if t.kind == TYPE.closure : return true

    if t.kind == TYPE.union || t.is_tuple_type() {
        // A named union can contain itself through a container
        let named = t.class
        if isset(named) {
            if seen.contains(named) : return false
            seen.append(named)
        }
        let members = t.get_members()
        if !isset(members) : return false
        each members as member {
            if type_has_unpublishable_closure(member, seen) : return true
        }
        return false
    }
    if t.kind == TYPE.array || t.kind == TYPE.ref_slice || t.is_fixed_array_type() {
        let sub = t.get_sub_type()
        return isset(sub) && type_has_unpublishable_closure(sub, seen)
    }

    let class = t.get_class_or_null()
    if !isset(class) : return false
    if seen.contains(class) || class_is_lock(class) : return false
    seen.append(class)
    each class.props as prop {
        if type_has_unpublishable_closure(prop.type, seen) : return true
    }
    return false
}

// The value behind a `Lock` is only used while the lock is held, and what is stored there
// must be a unique graph, so its closures need no shared check
fn class_is_lock(class: Class) bool {
    let base = class.generic_from ?! return false
    let lock = valk_idf(class.ns.build, "core", "Lock") ! return false
    return lock.class == base
}

// A coroutine handle belongs to the thread that runs it, so it can never be
// published or carried by a shared callable
fn type_has_coroutine_handle(type: Type, seen: Array[Class]) bool {
    let t = type.get_non_nullable()
    if t.kind == TYPE.co : return true
    if t.kind == TYPE.ptr_of || t.kind == TYPE.adr_of || t.kind == TYPE.voidptr || t.kind == TYPE.ref_of : return false
    if t.kind == TYPE.closure || t.kind == TYPE.fnptr {
        if type_has_coroutine_handle(t.get_return_type(), seen) : return true
        let args = t.get_args()
        if !isset(args) : return false
        each args as arg {
            if type_has_coroutine_handle(arg, seen) : return true
        }
        return false
    }
    if t.kind == TYPE.union || t.is_tuple_type() {
        // A named union can contain itself through a container
        let named = t.class
        if isset(named) {
            if seen.contains(named) : return false
            seen.append(named)
        }
        let members = t.get_members()
        if !isset(members) : return false
        each members as member {
            if type_has_coroutine_handle(member, seen) : return true
        }
        return false
    }
    if t.kind == TYPE.array || t.kind == TYPE.ref_slice || t.is_fixed_array_type() {
        let sub = t.get_sub_type()
        return isset(sub) && type_has_coroutine_handle(sub, seen)
    }
    let class = t.get_class_or_null()
    if !isset(class) : return false
    if seen.contains(class) : return false
    seen.append(class)
    each class.props as prop {
        if type_has_coroutine_handle(prop.type, seen) : return true
    }
    return false
}

// The property that reaches the offending closure, for the diagnostic. Null
// when the closure is the published value itself rather than a member of it.
fn type_find_unpublishable_closure(type: Type, seen: Array[Class]) ?Prop {
    let t = type.get_non_nullable()
    if t.is_shared : return null
    if t.kind == TYPE.union || t.is_tuple_type() {
        // A named union can contain itself through a container
        let named = t.class
        if isset(named) {
            if seen.contains(named) : return null
            seen.append(named)
        }
        let members = t.get_members()
        if !isset(members) : return null
        each members as member {
            let found = type_find_unpublishable_closure(member, seen)
            if isset(found) : return found
        }
        return null
    }
    if t.kind == TYPE.array || t.kind == TYPE.ref_slice || t.is_fixed_array_type() {
        let sub = t.get_sub_type()
        return isset(sub) ? type_find_unpublishable_closure(sub, seen) : null
    }
    let class = t.get_class_or_null()
    if !isset(class) : return null
    if seen.contains(class) || class_is_lock(class) : return null
    seen.append(class)
    each class.props as prop {
        if type_has_unpublishable_closure(prop.type, Array[Class]{}) : return prop
    }
    return null
}

// `seen` keeps a struct that (wrongly) contains itself inline from recursing
// forever: the size error for it is reported elsewhere.
fn type_find_unsafe_struct_pointer(type: Type, seen: Array[Class]) ?Class {
    let t = type.get_non_nullable()
    if t.kind == TYPE.ptr_of || t.kind == TYPE.adr_of || t.kind == TYPE.voidptr || t.kind == TYPE.ref_of : return null

    let class = t.class
    if !t.is_inline && isset(class) && class.kind == CLASS_KIND.struct {
        if struct_pointer_has_gc(class) : return class
        return null
    }
    if t.kind == TYPE.union || t.is_tuple_type() {
        let members = t.get_members()
        if !isset(members) : return null
        // A named union can contain itself through a container
        if isset(class) {
            if seen.contains(class) : return null
            seen.append(class)
        }
        each members as member {
            let unsafe = type_find_unsafe_struct_pointer(member, seen)
            if isset(unsafe) : return unsafe
        }
        return null
    }
    if t.kind == TYPE.array || t.kind == TYPE.ref_slice || t.kind == TYPE.fixed_array {
        let sub = t.get_sub_type()
        return isset(sub) ? type_find_unsafe_struct_pointer(sub, seen) : null
    }
    if t.is_inline && isset(class) {
        if seen.contains(class) : return null
        seen.append(class)
        each class.props as prop {
            let unsafe = type_find_unsafe_struct_pointer(prop.type, seen)
            if isset(unsafe) : return unsafe
        }
    }
    return null
}

fn struct_graph_has_gc(class: Class, seen: Array[Class]) bool {
    if seen.contains(class) : return false
    seen.append(class)
    each class.props as prop {
        if struct_graph_type_has_gc(prop.type, seen) : return true
    }
    return false
}

fn struct_pointer_has_gc(class: Class) bool {
    if class.struct_gc_known : return class.struct_gc
    let result = struct_graph_has_gc(class, Array[Class]{})
    class.struct_gc = result
    class.struct_gc_known = true
    return result
}

fn struct_graph_type_has_gc(type: Type, seen: Array[Class]) bool {
    let t = type.get_non_nullable()
    if t.kind == TYPE.ptr_of || t.kind == TYPE.adr_of || t.kind == TYPE.voidptr : return false
    if t.is_gc_type() || t.kind == TYPE.closure || t.is_fat_borrow() || t.kind == TYPE.interface : return true
    if t.kind == TYPE.union || t.is_tuple_type() {
        let members = t.get_members()
        if !isset(members) : return false
        each members as member {
            if struct_graph_type_has_gc(member, seen) : return true
        }
        return false
    }
    if t.is_fixed_array_type() {
        let sub = t.get_sub_type()
        return isset(sub) && struct_graph_type_has_gc(sub, seen)
    }
    let class = t.class
    if isset(class) && class.kind == CLASS_KIND.struct {
        return struct_graph_has_gc(class, seen)
    }
    return false
}

// A view of an inline aggregate depends on whether it carries references:
// parse the properties of the structs it holds inline before deciding
fn type_parse_aggregate_props(type: Type, seen: Array[Class]) !Error {
    let t = type.get_non_nullable()
    if t.is_gc_type() : return
    if t.kind == TYPE.union || t.is_tuple_type() {
        let members = t.get_members()
        if isset(members) {
            each members as member : type_parse_aggregate_props(member, seen) !>
        }
        return
    }
    if t.is_fixed_array_type() {
        let sub = t.get_sub_type()
        if isset(sub) : type_parse_aggregate_props(sub, seen) !>
        return
    }
    let class = t.class
    if !t.is_inline || !isset(class) || class.kind != CLASS_KIND.struct || seen.contains(class) : return
    seen.append(class)
    if class.props_pending && !class.is_generic_base : parse_class_properties(class) !>
    each class.props as prop : type_parse_aggregate_props(prop.type, seen) !>
}

fn type_from_exp(exp: Exp, scope: Scope, suggested_type: ?Type (null)) Type !Error {
    let build = exp.src.build
    let outer = build.type_parse_depth == 0
    build.type_parse_depth++
    let type = type_from_exp_unchecked(exp, scope, suggested_type) !>
    build.type_parse_depth--
    if outer && type.build.struct_gc_validation_ready {
        type_validate_struct_gc_storage(type, exp) !>
    }
    return type
}

fn type_from_exp_unchecked(exp: Exp, scope: Scope, suggested_type: ?Type (null)) Type !Error {
    if exp.type != EXP.type : exp.bug("Expected EXP.type")
    let kind = exp.type_kind
    let b = exp.src.build

    if kind == TYPE_KIND.void : return type_void(b)

    if kind == TYPE_KIND.null {
        exp.error("'null' can only be used as an alternative in a tagged union")
    }

    if kind == TYPE_KIND.nullable {
        let inner = type_from_inner_exp(exp, scope, "Missing inner type for '?'") !>
        if inner.is_void_type() : exp.error("'void' cannot be nullable")
        return inner.nullable()
    }

    if kind == TYPE_KIND.shared {
        let inner = type_from_inner_exp(exp, scope, "Missing inner type for 'atomic'") !>
        if exp.bool1 : type_warn_shared_spelling(exp)
        type_parse_aggregate_props(inner, Array[Class]{}) !>
        if inner.is_nullable_type() {
            return inner.get_non_nullable().shared_type().nullable()
        }
        return inner.shared_type()
    }

    if kind == TYPE_KIND.local {
        let inner = type_from_inner_exp(exp, scope, "Missing inner type for 'local'") !>
        let nn = inner.get_non_nullable()
        let class = nn.get_class_or_null()
        if (nn.kind != TYPE.ref_of && nn.kind != TYPE.ref_slice) || (isset(class) && class.representation_class().immutable) {
            exp.error("The 'local' modifier applies to a borrow type, not '" + inner.compat_display_name() + "'")
        }
        return inner.local_type()
    }

    if kind == TYPE_KIND.locked {
        let inner = type_from_inner_exp(exp, scope, "Missing inner type for 'locked'") !>
        type_parse_aggregate_props(inner, Array[Class]{}) !>
        if inner.is_nullable_type() {
            return inner.get_non_nullable().locked_type().nullable()
        }
        return inner.locked_type()
    }


    if kind == TYPE_KIND.ptr {
        let inner = type_from_inner_exp(exp, scope, "Missing inner type for '*'") !>
        if inner.is_void_type() : exp.error("Use 'ptr' for an untyped pointer instead of '*void'")
        if exp.bool2 {
            let size_exp = exp.get(TYPE_EXP.size)
            if isset(size_exp) : return inner.pointer(resolve_type_size(exp, scope) !>.to(uint), false)
            return inner.pointer(0, false)
        }
        if inner.is_inline && inner.kind == TYPE.struct : return inner.non_inline()
        return inner.pointer()
    }
    if kind == TYPE_KIND.ref {
        let inner = type_from_inner_exp(exp, scope, "Missing inner type for '&'") !>
        if inner.is_void_type() : exp.error("You cannot reference a value of type 'void'")
        if exp.bool3 {
            // `local &T`, `local &[T]` / `local &[T x N]`: a frame borrow that cannot escape
            if exp.bool2 {
                let size_exp = exp.get(TYPE_EXP.size)
                if isset(size_exp) {
                    let bounded = inner.local_ref(resolve_type_size(exp, scope) !>.to(uint), false)
                    return exp.bool1 ? bounded.mut_type() : bounded
                }
                type_validate_sequence_element(inner, exp) !>
                let borrow = inner.local_ref_slice()
                return exp.bool1 ? borrow.mut_type() : borrow
            }
            let borrow = inner.local_ref()
            return exp.bool1 ? borrow.mut_type() : borrow
        }
        let borrow = inner.reference()
        if exp.bool2 {
            let size_exp = exp.get(TYPE_EXP.size)
            if isset(size_exp) : borrow = inner.reference(resolve_type_size(exp, scope) !>.to(uint), false)
            else {
                type_validate_sequence_element(inner, exp) !>
                borrow = inner.ref_slice()
            }
        }
        return exp.bool1 ? borrow.mut_type() : borrow
    }

    if kind == TYPE_KIND.inline {
        exp.error("The '<T>' inline type syntax has been removed; struct types are inline by default")
    }

    if kind == TYPE_KIND.nonnull {
        let t = type_from_inner_exp(exp, scope, "Missing inner type for nonnull") !>
        // Strip one nullable layer if present
        if t.kind == TYPE.nullable {
            let inner = t.get_sub_type()
            if isset(inner) : return inner
        }
        return t
    }

    if kind == TYPE_KIND.typeof {
        // typeof(value) in type position → result type of the value expression
        let val_exp = exp.get(TYPE_EXP.type)
        if !isset(val_exp) : exp.bug("Missing typeof operand")
        let v = value_from_exp(val_exp, scope, Context.for_scope(b, scope)) !>
        return v.rett
    }

    if kind == TYPE_KIND.dynamic_array {
        let sub = type_from_inner_exp(exp, scope, "Missing element type for array") !>
        type_validate_sequence_element(sub, exp) !>
        return sub.array()
    }

    if kind == TYPE_KIND.fixed_array {
        let sub = type_from_inner_exp(exp, scope, "Missing element type for fixed array") !>
        type_validate_sequence_element(sub, exp) !>
        return sub.fixed_array(resolve_type_size(exp, scope) !>.to(uint))
    }

    if kind == TYPE_KIND.multi {
        return type_from_multi_exp(exp, scope) !>
    }

    if kind == TYPE_KIND.union {
        return type_union_from_exp(exp, scope) !>
    }

    if kind == TYPE_KIND.fn || kind == TYPE_KIND.fnptr || kind == TYPE_KIND.co {
        let resolved_kind = kind == TYPE_KIND.fn ? TYPE.closure : kind == TYPE_KIND.fnptr ? TYPE.fnptr : TYPE.co
        return type_callable_from_exp(exp, scope, resolved_kind) !>
    }

    if kind == TYPE_KIND.suggested {
        if !isset(suggested_type) {
            exp.error("'.' type is not valid here")
        }
        return suggested_type
    }

    if kind == TYPE_KIND.named {
        return type_from_named_exp(exp, scope) !>
    }

    exp.bug("Unknown type kind: " + kind)
}

fn type_from_multi_exp(exp: Exp, scope: Scope, force_multi: bool (false)) Type !Error {
    let b = exp.src.build
    let types = Array[Type]{}
    let i: uint = 0
    while true {
        let sub = exp.get(i)
        if !isset(sub) : break
        types.append(type_from_exp(sub, scope) !>)
        i++
    }
    if types.length > 1 {
        each types as type {
            if type.is_void_type() : exp.error("Multi-value types cannot contain void")
        }
    }
    return type_multi(b, types, force_multi)
}

fn type_from_named_exp(exp: Exp, scope: Scope) Type !Error {
    let id = exp.get(TYPE_EXP.id)
    if !isset(id) : exp.bug("Named type is missing id")

    let name = id.str1
    let ns_name = id.str2

    // Optional namespace prefix: ns.Name — `ns` must be an IDF.scope from `use`
    let idf: ?Idf = null
    if isset(ns_name) {
        let ns_idf = scope.get_scope_idf(ns_name)
        if !isset(ns_idf) : exp.error("Unknown namespace: " + ns_name)
        let ns_scope = ns_idf.scope
        if !isset(ns_scope) : exp.bug("Scope idf is missing scope")
        lsp_complete_scope(id, ns_scope) !>
        idf = ns_scope.get_idf(name)
        if !isset(idf) && (resolve_pending_alias(id.src.build, name, ns_scope, id) !>) : idf = ns_scope.get_idf(name)
        if !isset(idf) : exp.error("Unknown type: " + ns_name + "." + name)
    } else {
        lsp_complete_scope(id, scope) !>
        idf = scope.get_idf(name)
        if !isset(idf) && (resolve_pending_alias(id.src.build, name, scope, id) !>) : idf = scope.get_idf(name)
        if !isset(idf) {
            let vector = type_vector_from_name(id.src.build, name) !>
            if isset(vector) : return vector
            exp.error("Unknown type: " + name)
        }
    }

    let resolved = idf
    if !isset(resolved) : exp.error("Unknown type: " + name)

    // LSP: jump to the declaration of the named type
    lsp_goto_idf(id, resolved, name) !>
    lsp_hover_idf(id, resolved) !>

    alias_check_idf(exp, resolved) !>

    // Generic parameter or other bound type (e.g. `T` inside `class Foo[T]`)
    if resolved.type == IDF.type {
        let of_type = resolved.of_type
        if !isset(of_type) : exp.bug("Type idf is missing of_type")
        return of_type
    }

    if resolved.type == IDF.property {
        let prop = resolved.prop
        if !isset(prop) : exp.bug("Property idf is missing Prop")
        return prop.type
    }

    // enum Name { ... }
    if resolved.type == IDF.enum {
        let enu = resolved.enum
        if !isset(enu) : exp.bug("Enum idf is missing enum")
        act_check(exp, enu.act, enu.exp, false, "enum") !>
        return enu.get_type() !>
    }

    if resolved.type != IDF.class {
        exp.error("Identifier is not a type: " + name)
    }
    let class = resolved.class
    if !isset(class) : exp.bug("Class idf is missing class")
    act_check(exp, class.act, class.exp, false, "class") !>

    let gens = exp.get(TYPE_EXP.generics)
    let is_sequence = class.kind == CLASS_KIND.array || class.kind == CLASS_KIND.slice || class.kind == CLASS_KIND.unbound

    // Resolve base class type (specialize generics when present)
    if isset(gens) && class.is_generic_base {
        let gtypes = resolve_generic_args_from_multi(gens, class.generic_params, class.scope.parent, scope) !>
        if is_sequence && gtypes.length > 0 {
            let element = gtypes.get(0) !? type_void(exp.src.build)
            type_validate_sequence_element(element, exp) !>
        }
        class = class.specialize(gtypes, exp) !>
    } else if isset(gens) {
        if is_sequence {
            exp.error("Named sequence type '" + class.pretty_name() + "' already declares its element type; use '" + class.pretty_name() + "[x N]' to specify a length")
        }
        if class.kind == CLASS_KIND.pointer {
            exp.error("Void pointer types cannot have element information; use '*T' instead")
        }
        exp.error("Type is not generic: " + class.name)
    } else if class.is_generic_base {
        exp.error("Generic type '" + class.name + "' requires type arguments")
    }

    let base = class.get_type() !>

    let size_exp = exp.get(TYPE_EXP.size)
    if isset(size_exp) && !is_sequence {
        exp.error("Type '" + class.pretty_name() + "' does not support a length")
    }
    if isset(size_exp) && class.kind == CLASS_KIND.array {
        exp.error("Dynamic array type '" + class.pretty_name() + "' does not support a fixed length")
    }
    if isset(size_exp) {
        let size: u32 = 0
        size = resolve_type_size(exp, scope) !>
        let sub = base.get_sub_type()
        return Type {
            build: base.build
            kind: base.kind
            class: class
            info: isset(sub) ? UnaryTypeInfo { sub: sub } : null
            length: size.to(uint)
            unsigned: base.unsigned
            is_inline: base.is_inline
            is_shared: base.is_shared
            is_locked: base.is_locked
        }
    }

    return base
}

// Largest fixed array (1 GB): its storage is materialized in every frame or
// object holding it.
value MAX_FIXED_ARRAY_BYTES (1024 * 1024 * 1024)

// Evaluate TYPE_EXP.size (a value expression) to a non-negative compile-time integer.
fn resolve_type_size(exp: Exp, scope: Scope) u32 !Error {
    let size_exp = exp.get(TYPE_EXP.size)
    if !isset(size_exp) : return 0
    let v = value_from_exp(size_exp, scope, Context.for_scope(exp.src.build, scope)) !>
    if v.type != VAL.int {
        size_exp.error("Type size must be a compile-time integer")
    }
    if v.int_val < 0 {
        size_exp.error("Type size must not be negative")
    }
    if v.int_val == 0 {
        size_exp.error("Type size must be greater than zero")
    }
    if v.int_val > MAX_FIXED_ARRAY_BYTES.to(int) {
        size_exp.error("Type size must not exceed " + MAX_FIXED_ARRAY_BYTES)
    }
    return v.int_val.to(u32)
}

fn validate_const_generic_type(t: Type, at: Exp) !Error {
    if t.is_nullable_type() || (!t.is_bool_type() && !t.is_integer_type() && !t.is_string_type()) {
        at.error("Compile-time generic parameter type must be 'bool', an integer type, or 'String', got: " + t.compat_display_name())
    }
}

fn resolve_const_generic_param_type(param: GenericParam, param_scope: ?Scope, fallback_scope: Scope, at: Exp) Type !Error {
    let texp = param.type_exp ?! at.bug("Const generic parameter is missing its type: " + param.name)
    let expected = type_from_exp(texp, param_scope ?? fallback_scope) !>
    validate_const_generic_type(expected, texp) !>
    return expected
}

fn eval_const_generic_arg(arg_exp: Exp, expected: Type, scope: Scope) Type !Error {
    let b = arg_exp.src.build
    let val_exp = arg_exp
    if arg_exp.type == EXP.type {
        // Bare identifier (`N`, `ns.N`) parsed as TYPE_KIND.named in type position
        if arg_exp.type_kind == TYPE_KIND.named && !isset(arg_exp.get(TYPE_EXP.generics)) && !isset(arg_exp.get(TYPE_EXP.size)) {
            let id = arg_exp.get(TYPE_EXP.id)
            if isset(id) {
                let id_val = Exp {
                    type: EXP.value
                    kind: VALUE_KIND.id
                    src: arg_exp.src
                    i: arg_exp.i
                    len: arg_exp.len
                }
                id_val.set(VALUE_EXP.left, id)
                val_exp = id_val
            } else {
                arg_exp.error("Expected a compile-time constant of type '" + expected.compat_display_name() + "'")
            }
        } else {
            arg_exp.error("Expected a compile-time constant of type '" + expected.compat_display_name() + "'")
        }
    }
    let ctx = Context.for_scope(b, scope).with_suggested_type(expected)
    let v = value_from_exp(val_exp, scope, ctx) !>
    if expected.is_bool_type() {
        if v.type != VAL.bool {
            arg_exp.error("Compile-time generic argument must be a constant 'bool', got '" + v.rett.compat_display_name() + "'")
        }
        let norm = Value {
            type: VAL.bool
            rett: expected
            bool_val: v.bool_val
        }
        return type_const_val(b, norm)
    }
    if expected.is_integer_type() {
        if v.type != VAL.int {
            arg_exp.error("Compile-time generic argument must be a constant integer of type '" + expected.compat_display_name() + "', got '" + v.rett.compat_display_name() + "'")
        }
        if !type_fits_int_literal(expected, v.int_val, !v.rett.is_signed_type()) {
            arg_exp.error("Compile-time generic argument " + const_val_display(v) + " does not fit in type '" + expected.compat_display_name() + "'")
        }
        let norm = Value {
            type: VAL.int
            rett: expected
            int_val: v.int_val
        }
        return type_const_val(b, norm)
    }
    if expected.is_string_type() {
        if v.type != VAL.string {
            arg_exp.error("Compile-time generic argument must be a constant 'String', got '" + v.rett.compat_display_name() + "'")
        }
        let norm = Value {
            type: VAL.string
            rett: expected
        }
        norm.set_string(v.get_string())
        return type_const_val(b, norm)
    }
    arg_exp.error("Unsupported compile-time generic parameter type: " + expected.compat_display_name())
}

fn resolve_generic_arg(arg_exp: Exp, param: ?GenericParam, param_scope: ?Scope, arg_scope: Scope) Type !Error {
    if isset(param) && param.is_const {
        let expected = resolve_const_generic_param_type(param, param_scope, arg_scope, arg_exp) !>
        return eval_const_generic_arg(arg_exp, expected, arg_scope) !>
    }
    if arg_exp.type != EXP.type {
        arg_exp.error("Expected a type argument" + (isset(param) ? " for generic parameter '" + param.name + "'" : ""))
    }
    return type_from_exp(arg_exp, arg_scope) !>
}

fn resolve_generic_args_from_exps(exps: Array[Exp], params: ?Array[GenericParam], param_scope: ?Scope, arg_scope: Scope) Array[Type] !Error {
    let gtypes = Array[Type]{}
    each exps as arg_exp, i {
        let param = isset(params) ? (params.get(i) !? null) : null
        gtypes.append(resolve_generic_arg(arg_exp, param, param_scope, arg_scope) !>)
    }
    return gtypes
}

fn resolve_generic_args_from_multi(gens: Exp, params: ?Array[GenericParam], param_scope: ?Scope, arg_scope: Scope) Array[Type] !Error {
    let gtypes = Array[Type]{}
    let i: uint = 0
    while true {
        let g = gens.get(i)
        if !isset(g) : break
        let param = isset(params) ? (params.get(i) !? null) : null
        gtypes.append(resolve_generic_arg(g, param, param_scope, arg_scope) !>)
        i++
    }
    return gtypes
}

fn validate_generic_arg_kinds(params: ?Array[GenericParam], gtypes: Array[Type], param_scope: ?Scope, at: Exp) !Error {
    let plist = params ?! return
    each plist as param, i {
        let gt = gtypes.get(i) ! break
        if param.is_const {
            if gt.kind != TYPE.const_val {
                at.error("Generic parameter '" + param.name + "' expects a compile-time constant value, got type '" + gt.compat_display_name() + "'")
            }
            let cval = gt.get_const_val() ?! at.bug("Const generic type is missing its value")
            let texp = param.type_exp
            if isset(texp) && isset(param_scope) {
                let expected = type_from_exp(texp, param_scope) !>
                validate_const_generic_type(expected, texp) !>
                if expected.is_bool_type() && cval.type != VAL.bool {
                    at.error("Generic parameter '" + param.name + "' expects 'bool', got '" + cval.rett.compat_display_name() + "'")
                } else if expected.is_string_type() && cval.type != VAL.string {
                    at.error("Generic parameter '" + param.name + "' expects 'String', got '" + cval.rett.compat_display_name() + "'")
                } else if expected.is_integer_type() {
                    if cval.type != VAL.int {
                        at.error("Generic parameter '" + param.name + "' expects '" + expected.compat_display_name() + "', got '" + cval.rett.compat_display_name() + "'")
                    }
                    if !type_fits_int_literal(expected, cval.int_val, !cval.rett.is_signed_type()) {
                        at.error("Compile-time generic argument " + const_val_display(cval) + " does not fit in type '" + expected.compat_display_name() + "'")
                    }
                    if !expected.compat(cval.rett) || !cval.rett.compat(expected) {
                        let norm = Value {
                            type: VAL.int
                            rett: expected
                            int_val: cval.int_val
                        }
                        gtypes.set(i, type_const_val(at.src.build, norm)) _
                    }
                }
            }
        } else if gt.kind == TYPE.const_val {
            at.error("Generic parameter '" + param.name + "' expects a type argument, got constant value '" + gt.compat_display_name() + "'")
        }
    }
    check_generic_constraints(params, gtypes, param_scope, at, true) !>
}

fn check_generic_constraints(params: ?Array[GenericParam], gtypes: Array[Type], param_scope: ?Scope, at: Exp, report_errors: bool) bool !Error {
    let plist = params ?! return true
    let has_any = false
    each plist as p {
        let cs = p.constraints
        if isset(cs) && cs.length > 0 {
            has_any = true
            break
        }
    }
    if !has_any : return true

    let cscope = isset(param_scope) ? param_scope.sub_scope() : Scope.new(null)
    each plist as p, i {
        let gt = gtypes.get(i) ! break
        bind_generic_param(cscope, p.name, gt)
    }

    each plist as param, i {
        let cs = param.constraints ?! continue
        if cs.length == 0 : continue
        let gt = gtypes.get(i) ! break
        // Documentation placeholders (`TYPE.any` with generic param name) skip runtime bound checks
        if gt.kind == TYPE.any && !gt.custom_name.is_empty() : continue

        each cs as constraint {
            if constraint.flag.bytes > 0 {
                let flag = constraint.flag
                let ok = false
                if flag == "$eq" {
                    type_settle_hooks(gt, Array[String]{ "$eq" }) !>
                    ok = gt.has_eq()
                } else if flag == "$hash" {
                    type_settle_hooks(gt, Array[String]{ "$hash" }) !>
                    ok = gt.has_hash() || type_auto_hashable(gt, true)
                } else if flag == "$order" {
                    ok = type_can_order(gt) !>
                } else if flag == "$integer" {
                    ok = !gt.is_nullable_type() && gt.is_integer_type()
                } else if flag == "$float" {
                    ok = !gt.is_nullable_type() && gt.is_float_type()
                } else if flag == "$number" {
                    ok = !gt.is_nullable_type() && (gt.is_integer_type() || gt.is_float_type())
                }
                if !ok {
                    if !report_errors : return false
                    at.error("Type '" + gt.compat_display_name() + "' does not satisfy generic constraint '" + flag + "' on parameter '" + param.name + "'")
                }
                continue
            }

            let texp = constraint.type_exp ?! continue
            let ctype = type_from_exp(texp, cscope) !>
            let iface = ctype.get_non_nullable().get_class_or_null()
            if !isset(iface) || iface.kind != CLASS_KIND.interface || ctype.is_nullable_type() {
                texp.error("Generic constraint for '" + param.name + "' must be an interface or built-in bound ($eq, $hash, $order, $integer, $float, $number), got '" + ctype.compat_display_name() + "'")
            }

            let ok = false
            if !gt.is_nullable_type() {
                let gt_class = gt.get_class_or_null()
                if isset(gt_class) {
                    resolve_class_interfaces(gt_class) !>
                    ok = class_implements_interface(gt_class, iface)
                }
            }
            if !ok {
                if !report_errors : return false
                at.error("Type '" + gt.compat_display_name() + "' does not satisfy generic constraint '" + ctype.compat_display_name() + "' on parameter '" + param.name + "'")
            }
        }
    }
    return true
}

// Under a shared view the type arguments are read-only either way: `shared Array[Item]` and
// `shared Array[shared Item]` are the same data
fn classes_same_when_shared(a: Class, b: Class) bool {
    let base = a.generic_from ?! return false
    if base != b.generic_from : return false
    let types_a = a.generic_types ?! return false
    let types_b = b.generic_types ?! return false
    if types_a.length != types_b.length : return false
    each types_a as type, i {
        let other = types_b.get(i) ! return false
        let view_a = type.storage_view_type(false)
        let view_b = other.storage_view_type(false)
        if !view_a.compat(view_b) || !view_b.compat(view_a) : return false
    }
    return true
}

// `shared T` is the old spelling of `atomic T`
fn type_warn_shared_spelling(exp: Exp) {
    warn_deprecated_spelling(exp, "'shared T' is deprecated: write 'atomic T'")
}

// An old spelling warns in the main package only, never about a dependency
fn warn_deprecated_spelling(exp: Exp, msg: String) {
    let b = exp.src.build
    if b.options.no_warn_deprecated : return
    let ns = exp.src.ns ?! return
    if ns.pkg != b.main_pkg : return
    exp.warn(msg)
}

////////////////////////////
// Vector types
////////////////////////////

// `u8x16`, `i32x4`, `f64x2`, ...: a sized number name, `x`, a lane count. The whole vector
// is 64 to 512 bits. Null for any other name
fn type_vector_from_name(b: Build, name: String) ?Type !Error {
    let x = name.index_of("x") ! return null
    if x < 2 || x + 1 >= name.bytes : return null
    let element_name = name.range(0, x)
    let first = element_name[0]
    if first != 'u' && first != 'i' && first != 'f' : return null
    let bits_text = element_name.range(1, x - 1)
    if !type_vector_digits(bits_text) : return null
    let bits = bits_text.to_uint() ! return null
    if bits != 8 && bits != 16 && bits != 32 && bits != 64 : return null
    if first == 'f' && bits < 32 : return null
    let lanes_text = name.range(x + 1, name.bytes - x - 1)
    if !type_vector_digits(lanes_text) : return null
    let lanes = lanes_text.to_uint() ! return null
    let total = bits * lanes
    if total != 64 && total != 128 && total != 256 && total != 512 : return null
    let element = type_from_core_or_null(b, element_name) ?! return null
    return element.vector(lanes)
}

fn type_vector_digits(text: String) bool {
    if text.bytes == 0 || text[0] == '0' : return false
    each text as ch {
        if !ch.is_number() : return false
    }
    return true
}

// The mask a comparison of `vector` values gives: signed integers of the element width
fn type_vector_mask(vector: Type) Type !Error {
    let element = vector.vector_element()
    let bits = (element.byte_size() !>).to(uint) * 8
    let mask_element = type_from_core(vector.build, "i" + bits) !>
    return mask_element.vector(vector.length)
}

// One variant inside an enum body: `name` or `name (value)`.
class EnumItem {
    name: String
    // Optional default value body `(...)` still raw until a later value stage
    value: ?Exp (null)
    resolving: bool (false)
}

class Enum {
    unit: Unit
    ns: Namespace
    name: String
    act: ACT
    exp: Exp
    // File scope for type / value resolution
    scope: Scope
    // Optional `: Type` after the name
    type_exp: ?Exp (null)
    body: ?Exp (null)
    // Body variants in declaration order
    items: Array[EnumItem] (.{})
    // Resolved types (lazy via get_type / get_item_type)
    item_type: ?Type (null)
    type: ?Type (null)
    zero_checked: bool (false)
    zero_allowed: bool (true)
    // The methods of the enum (`extend Color`, `name`, `items`, `from_name`), a mode over the item type
    methods: ?Class (null)

    fn allows_zero(ctx: Context, at: Exp) bool !Error {
        if this.zero_checked : return this.zero_allowed
        this.zero_checked = true
        // Unknown member expressions do not prove that zero is invalid.
        let allowed = false
        each this.items as item {
            let value = value_from_enum_item(this, item.name, at, this.scope, ctx) !>
            if value.type == VAL.int : allowed = allowed || value.int_val == 0
            else if value.type == VAL.float : allowed = allowed || value.float_val == 0.0
            else if value.type == VAL.bool : allowed = allowed || !value.bool_val
            else : allowed = true
        }
        this.zero_allowed = allowed
        this.zero_checked = true
        return allowed
    }

    // Underlying representation type (default: int).
    fn get_item_type() Type !Error {
        let cached = this.item_type
        if isset(cached) : return cached
        let te = this.type_exp
        if isset(te) {
            let t = type_from_exp(te, this.scope) !>
            // Nested enum types are not allowed
            if isset(t.get_enum()) {
                te.error("You cannot use an enum type as the type for another enum")
            }
            this.item_type = t
            return t
        }
        let t = type_int(this.ns.build)
        this.item_type = t
        return t
    }

    // Type used for values of this enum (item type tagged with this Enum).
    fn get_type() Type !Error {
        let cached = this.type
        if isset(cached) : return cached
        let item = this.get_item_type() !>
        let t = Type {
            build: item.build
            kind: item.kind
            class: item.class
            enum_info: this
            custom_name: this.name
            info: item.info
            size: item.size
            length: item.length
            unsigned: item.unsigned
            size_known: item.size_known
            is_inline: item.is_inline
            is_shared: item.is_shared
            error_is_instance: item.error_is_instance
        }
        this.type = t
        let methods = this.methods
        if isset(methods) {
            methods.type = t
            methods.mode_for_type = item
            methods.mode_for_class = item.class
        }
        return t
    }
}

// The members every enum gets, as source for the class body of its methods. `name` and
// `from_name` need items that compare with `==`.
fn enum_generated_methods(enu: Enum, item: Type) String {
    let out = ByteBuffer.new(512)
    let string_class = type_string(item.build).get_class_or_null()
    let is_text = isset(string_class) && item.get_class_or_null() == string_class && !item.is_nullable_type()
    let comparable = item.is_integer_type() || item.is_float_type() || item.is_bool_type() || is_text
    if comparable {
        // A text enum already is its text: `to(String)` keeps giving the value
        if is_text {
            out.write("    /// The name of the item as written in the enum; `to(String)` gives its text value.\n")
            out.write("    + fn name() String {\n")
        } else {
            out.write("    /// The name of the item as written in the enum; also what `to(String)` and `\%{value}` give.\n")
            out.write("    + fn name() String $auto {\n")
        }
        each enu.items as it : out.write("        if this == SELF." + it.name + " : return \"" + it.name + "\"\n")
        out.write("        return \"\"\n    }\n")
        out.write("    /// The item named `name`; throws `missing` when the enum has none by that name.\n")
        out.write("    + static fn from_name(name: String) SELF !LookupError {\n")
        each enu.items as it : out.write("        if name == \"" + it.name + "\" : return SELF." + it.name + "\n")
        out.write("        throw .missing\n    }\n")
    }
    out.write("    /// Every item of the enum, in declaration order.\n")
    out.write("    + static fn items() Array[SELF] {\n        return Array[SELF]{")
    each enu.items as it, i {
        out.write(i == 0 ? " " : ", ")
        out.write("SELF." + it.name)
    }
    out.write(" }\n    }\n}\n")
    return out.to_string()
}

// Parse enum body members into items: `name` or `name (value)`.
fn parse_enum_body_items(body: Exp) Array[EnumItem] !Error {
    let pos = body.pos
    if !isset(pos) : body.bug("Enum body is missing a Pos")
    let p = pos.copy().init_parser()
    let items = Array[EnumItem]{}
    let seen = Map[bool]{}

    while true {
        let t = p.tok(true, true) !>
        if t == TOK.sign && p.word_is("}") : break
        if t == TOK.end : body.error("Unexpected end of file in enum body")
        // Skip line comments inside the body
        if t == TOK.comment : continue

        if t != TOK.word {
            p.error("Expected enum item name, found: '" + p.word() + "'")
        }
        let name = p.word()
        if seen.has(name) {
            p.error("Duplicate enum item name: " + name)
        }
        seen.set(name, true)

        // Optional value: ( ... )
        let value: ?Exp = null
        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is("(") {
            p.tok(true, true) !>
            value = read_body_exp(p, "(", ")") !>
        }

        items.append(EnumItem {
            name: name
            value: value
        })

        // Optional comma between items
        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is(",") {
            p.tok(true, true) !>
            let next = p.tok(true, true, false) !>
            if next == TOK.sign && p.word_is("}") {
                p.error("Trailing comma in enum body")
            }
            if next == TOK.sign && p.word_is(",") {
                p.error("Empty item in enum body")
            }
        }
    }
    return items
}

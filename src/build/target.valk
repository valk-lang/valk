
class Target {
    host_os: String
    host_arch: String
    os: String
    arch: String
    target: String
    ptr_size: int
}

fn get_target(target_str: ?String) Target {
    let host_os = default_os()
    let host_arch = default_arch()
    let target = target_str ?? (host_os + "-" + host_arch)

    let valid = Array[String]{ "win-x64", "linux-x64", "linux-arm64", "macos-x64", "macos-arm64" }
    if !valid.contains(target) {
        let supported = ""
        each valid as item, i {
            if i > 0 : supported += ", "
            supported += item
        }
        build_error("Invalid target: " + target + "\nSupported: " + supported)
    }

    let split = target.split("-")
    let os = split.get(0) ! exit(1)
    let arch = split.get(1) ! exit(1)

    return Target {
        host_os: host_os
        host_arch: host_arch
        os: os
        arch: arch
        target: target
        ptr_size: 8
    }
}

fn default_os() String {
    #if OS == win
    return "win"
    #elif OS == linux
    return "linux"
    #elif OS == macos
    return "macos"
    #else
    return "unknown"
    #end
}

fn default_arch() String {
    #if ARCH == x64
    return "x64"
    #elif ARCH == arm64
    return "arm64"
    #else
    return "unknown"
    #end
}

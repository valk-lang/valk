
use helper
use valk:fs
use valk:time
use valk:gc

class Build {
    options: BuildOptions
    cache: BuildCache
    pipeline: Pipeline
    lists: BuildLists
    stats: BuildStats
    //
    main_pkg: ?Pkg (null)
    scope: Scope (.new())
    // Messages
    messages: Array[Message] (.{})
    has_errors: bool (false)

    // ########################################
    // INIT
    // ########################################

    static fn init(options: BuildOptions) Build {
        let b = Build {
            options: options
            cache: BuildCache {}
            pipeline: Pipeline {}
            lists: BuildLists {}
            stats: BuildStats {}
        }
        b.set_macro_defs()
        return b
    }

    // Register compile-time macro defs as Values on Build.scope (looked up like any id).
    // OS/ARCH are strings; flag-style defs are bools so `#if TEST` resolves via value_from_exp.
    fn set_macro_defs() {
        let o = this.options
        this.set_macro_def_string("OS", o.target.os)
        this.set_macro_def_string("ARCH", o.target.arch)
        this.set_macro_def_bool("TEST", o.is_test)
        this.set_macro_def_bool("STATIC", o.is_static)
        this.set_macro_def_bool("GC_DEBUG", false)
        this.set_macro_def_bool("DEBUG", o.debug)

        each o.defs as def {
            let parts = def.split(",")
            each parts as pair {
                pair = pair.trim(" ")
                if pair.length == 0 : continue
                let kv = pair.split("=")
                if kv.length == 1 {
                    this.set_macro_def_bool(pair, true)
                } else {
                    let name = kv.pop_first() ! continue
                    let val = kv.join("=")
                    // "0" / "1" → bool so `#if NAME` works; anything else stays a string
                    if val == "0" {
                        this.set_macro_def_bool(name, false)
                    } else if val == "1" {
                        this.set_macro_def_bool(name, true)
                    } else {
                        this.set_macro_def_string(name, val)
                    }
                }
            }
        }
    }

    fn set_macro_def_string(name: String, val: String) {
        // Primitive string type: core String may not exist yet at Build.init time
        let v = vgen_string(val, type_prim_string(this))
        this.scope.set_idf(name, Idf.for_value(v))
    }

    fn set_macro_def_bool(name: String, val: bool) {
        let v = vgen_bool(val, type_prim_bool(this))
        this.scope.set_idf(name, Idf.for_value(v))
    }

    static fn init_from_args(args: Array[String]) Build !InitError {
        let options = BuildOptions.init_from_args(args) !>
        return Build.init(options)
    }

    // ########################################
    // RUN
    // ########################################

    fn run() !Error {
        let start = time:microtime()

        // Always collect stats, even when a stage fails (caller ignores the error
        // and uses print_results()).
        this.run_stages() ! {
            this.collect_build_stats(start)
            throw .error
        }
        this.collect_build_stats(start)
    }

    fn run_stages() !Error {
        let input_files = this.parse_inputs() !>

        // Always load built-in valk:core (stdlib primitives used throughout the compiler).
        let main_pkg = this.main_pkg ?! this.error("Main package not found (bug)")
        let valk = main_pkg.load_sub_pkg("valk") !>
        valk.load_namespace("core") !>

        each input_files as file {
            let ns = this.get_namespace_for_file(file) !>
            // Always load the CLI input file itself (deduped via cache.loaded_files).
            ns.load_file(file) !>
            // Then load the rest of the namespace (same-file paths are skipped).
            ns.load_files() !>
        }

        this.pipeline.run() !>
    }

    // Fill `stats` with duration and peak memory (LOC is updated during parse).
    fn collect_build_stats(start: uint) {
        this.stats.duration_us = time:microtime() - start
        this.stats.mem_peak = gc:mem_usage_peak
    }

    // Report outcome after run(): first error if any, otherwise warnings then stats.
    // Exits the process when there is an error.
    fn print_results() {
        each this.messages as m {
            if m.type == MSG.error {
                m.print()
                exit(1)
            }
        }

        if !this.options.no_warn {
            each this.messages as m {
                if m.type == MSG.warning {
                    m.print()
                }
            }
        }

        this.stats.print()
    }

    // Resolve CLI inputs into files/dirs, determine the main package, and return the input files.
    fn parse_inputs() Array[String] !Error {
        let input_dirs = Array[String]{}
        let input_files = Array[String]{}
        each this.options.inputs as input {
            let path = helper:resolve(input)
            if !fs:exists(path) : this.error("File/directory not found: " + path)
            if path.ends_with(".valk") {
                input_files.append(path, true)
                continue
            }
            if fs:is_dir(path) {
                input_dirs.append(path)
                continue
            }
            this.error("Invalid file/directory: " + input)
        }
        if input_files.length == 0 && input_dirs.length == 0 {
            input_dirs.append(fs:cwd())
        }

        // Determine which package (if any) each input belongs to
        let main_pkg : ?Pkg = null
        each input_dirs as dir {
            let pkg = this.find_pkg_for_path(dir)
            if isset(pkg) {
                if isset(main_pkg) && main_pkg != pkg {
                    this.error("Build command contains files from 2 different packages. You can only build 1 package and dependent packages must be included via a valk.json config.")
                }
                main_pkg = pkg
            }
        }
        each input_files as file {
            let pkg = this.find_pkg_for_path(file)
            if isset(pkg) {
                if isset(main_pkg) && main_pkg != pkg {
                    this.error("Build command contains files from 2 different packages. You can only build 1 package and dependent packages must be included via a valk.json config.")
                }
                main_pkg = pkg
                pkg.name = "main"
            }
        }

        // Loose files outside a package still need a main package to hang namespaces on
        if !isset(main_pkg) : main_pkg = Pkg.new_main(this)

        this.main_pkg = main_pkg
        return input_files
    }

    // ########################################
    // MESSAGES
    // ########################################

    fn error(msg: String) !Error $throw {
        this.has_errors = true
        this.messages.append(Message {
            type: MSG.error
            msg: msg
        })
        throw .error
    }

    // Like error, for situations that should be impossible if the compiler is correct.
    fn bug(msg: String) !Error $throw {
        this.error("(Compiler bug) " + msg)
    }

    fn warn(msg: String) {
        this.messages.append(Message {
            type: MSG.warning
            msg: msg
        })
    }

    // ########################################
    // PACKAGES
    // ########################################

    // Find the package for a file or directory path.
    // Walks parent directories for a valk.json, then checks the path lies within that package's source dir.
    // Returns null when there is no package, or the path is outside the package source tree.
    fn find_pkg_for_path(path: String) ?Pkg {
        path = helper:resolve(path)
        let dir = fs:is_dir(path) ? path : fs:dir_of(path)
        let pkg = this.find_closest_pkg(dir)
        if !isset(pkg) : return null
        if pkg.contains_path(path) : return pkg
        return null
    }

    // Walk dir and parents until a directory containing valk.json is found.
    fn find_closest_pkg(dir: String) ?Pkg {
        dir = helper:resolve(dir)
        this.cache.package_dirs.get(dir) -> pkg : return pkg

        if this.is_pkg_dir(dir) {
            let pkg = Pkg.new(this, dir)
            this.cache.package_dirs.set(dir, pkg)
            return pkg
        }

        let parent = fs:dir_of(dir)
        if parent == dir : return null

        let pkg = this.find_closest_pkg(parent)
        if isset(pkg) : this.cache.package_dirs.set(dir, pkg)
        return pkg
    }

    fn is_pkg_dir(dir: String) bool {
        return fs:exists(helper:add(dir, "valk.json"))
    }

    // ########################################
    // NAMESPACES
    // ########################################

    // Resolve which namespace a source file belongs to from its path under the package src dir.
    fn get_namespace_for_file(path: String) Namespace !Error {
        path = helper:resolve(path)
        let pkg = this.find_pkg_for_path(path) ?? (this.main_pkg ?! this.error("Main package not found (bug)"))
        let dir = fs:dir_of(path)
        let srcdir = pkg.srcdir
        if !isset(srcdir) : return pkg.get_namespace("main") !>
        if srcdir == dir : return pkg.get_namespace("main") !>

        let rel = dir.part(srcdir.length, dir.length - srcdir.length).trim("/").trim("\\")
        return pkg.get_namespace(rel) !>
    }
}

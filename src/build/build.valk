
use helper
use valk:fs

class Build {
    options: BuildOptions
    pkg_by_dir: Map[Pkg] (.{})
    main_pkg: ?Pkg (null)

    static fn init(options: BuildOptions) Build {
        return Build {
            options: options
        }
    }

    static fn init_from_args(args: Array[String]) Build !InitError {
        let options = BuildOptions.init_from_args(args) !>
        return Build.init(options)
    }

    fn run() {
        let input_files = this.parse_inputs()
    }

    // Resolve CLI inputs into files/dirs, determine the main package, and return the input files.
    fn parse_inputs() Array[String] {
        let input_dirs = Array[String]{}
        let input_files = Array[String]{}
        each this.options.inputs as input {
            let path = helper:resolve(input)
            if !fs:exists(path) : build_error("File/directory not found: " + path)
            if path.ends_with(".valk") {
                input_files.append(path, true)
                continue
            }
            if fs:is_dir(path) {
                input_dirs.append(path)
                continue
            }
            build_error("Invalid file/directory: " + input)
        }
        if input_files.length == 0 && input_dirs.length == 0 {
            input_dirs.append(fs:cwd())
        }

        // Determine which package (if any) each input belongs to
        let main_pkg : ?Pkg = null
        each input_dirs as dir {
            let pkg = this.find_pkg_for_path(dir)
            if isset(pkg) {
                if isset(main_pkg) && main_pkg != pkg {
                    build_error("Build command contains files from 2 different packages. You can only build 1 package and dependent packages must be included via a valk.json config.")
                }
                main_pkg = pkg
            }
        }
        each input_files as file {
            let pkg = this.find_pkg_for_path(file)
            if isset(pkg) {
                if isset(main_pkg) && main_pkg != pkg {
                    build_error("Build command contains files from 2 different packages. You can only build 1 package and dependent packages must be included via a valk.json config.")
                }
                main_pkg = pkg
                pkg.name = "main"
            }
        }

        this.main_pkg = main_pkg
        return input_files
    }

    // Find the package for a file or directory path.
    // Walks parent directories for a valk.json, then checks the path lies within that package's source dir.
    // Returns null when there is no package, or the path is outside the package source tree.
    fn find_pkg_for_path(path: String) ?Pkg {
        path = helper:resolve(path)
        let dir = fs:is_dir(path) ? path : fs:dir_of(path)
        let pkg = this.find_closest_pkg(dir)
        if !isset(pkg) : return null
        if pkg.contains_path(path) : return pkg
        return null
    }

    // Walk dir and parents until a directory containing valk.json is found.
    fn find_closest_pkg(dir: String) ?Pkg {
        dir = helper:resolve(dir)
        this.pkg_by_dir.get(dir) -> pkg : return pkg

        if this.is_pkg_dir(dir) {
            let pkg = Pkg.new(this, dir)
            this.pkg_by_dir.set(dir, pkg)
            return pkg
        }

        let parent = fs:dir_of(dir)
        if parent == dir : return null

        let pkg = this.find_closest_pkg(parent)
        if isset(pkg) : this.pkg_by_dir.set(dir, pkg)
        return pkg
    }

    fn is_pkg_dir(dir: String) bool {
        return fs:exists(helper:add(dir, "valk.json"))
    }
}

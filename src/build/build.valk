
class BuildCache {
}

class BuildLists {
}

class BuildStats {
}

class Pipeline {
    build: ?Build (null)
}

class Build {
    options: BuildOptions
    cache: BuildCache
    pipeline: Pipeline
    lists: BuildLists
    stats: BuildStats

    static fn init(options: BuildOptions) Build {
        let build = Build {
            options: options
            cache: BuildCache {}
            pipeline: Pipeline {}
            lists: BuildLists {}
            stats: BuildStats {}
        }
        build.pipeline.build = build
        return build
    }

    static fn init_from_args(args: Array[String]) Build !InitError {
        let options = BuildOptions.init_from_args(args) !>
        return Build.init(options)
    }

    static fn from_args(args: Array[String]) {
        let options = BuildOptions.init_from_args(args) ! build_error(E.msg)
        let build = Build.init(options)
        build.run()
    }

    fn run() {
    }
}


use helper
use doc
use valk:core
use valk:fs
use valk:time
use valk:gc

class Build {
    options: BuildOptions
    cache: BuildCache
    pipeline: Pipeline
    lists: BuildLists
    stats: BuildStats
    //
    main_pkg: ?Pkg (null)
    // The application's `fn main`, recorded while its signature is parsed. The
    // entry template needs its return type to decide whether main supplies the
    // process exit code (see the MAIN_EXIT_CODE macro def).
    main_func: ?Func (null)
    scope: Scope (.new())
    // Messages
    messages: Array[Message] (.{})
    has_errors: bool (false)
    // Sources loaded with --fmt (print after pipeline so body_exps exist)
    format_sources: Array[Source] (.{})
    // Non-source files the build read (#embed / #embed_dir targets), so --watch
    // also rebuilds when an embedded asset changes.
    watch_files: Array[String] (.{})
    // LSP: the Source of the file a cursor request refers to, and the cursor's
    // byte offset within it. Resolved once when that file is loaded so the
    // per-Exp hit test is a pointer compare plus two integer compares rather
    // than a path comparison. Null/0 for every build that is not serving a
    // cursor request (including diagnostics, which need no cursor).
    lsp_src: ?Source (null)
    lsp_cursor: u32 (0)
    // Set once a cursor request has been answered, which also aborts the build.
    lsp_answered: bool (false)

    // ########################################
    // INIT
    // ########################################

    static fn init(options: BuildOptions) Build {
        let b = Build {
            options: options
            cache: BuildCache {}
            pipeline: Pipeline {}
            lists: BuildLists {}
            stats: BuildStats {}
        }
        b.pipeline.build = b
        b.set_macro_defs()
        return b
    }

    // Register compile-time macro defs as Values on Build.scope (looked up like any id).
    // OS/ARCH are strings; flag-style defs are bools so `#if TEST` resolves via value_from_exp.
    fn set_macro_defs() {
        let o = this.options
        this.set_macro_def_string("OS", o.target.os)
        this.set_macro_def_string("ARCH", o.target.arch)
        this.set_macro_def_bool("TEST", o.is_test)
        this.set_macro_def_bool("STATIC", o.is_static)
        this.set_macro_def_bool("GC_DEBUG", false)
        // Replaced once main's return type is known (see Pipeline.run)
        this.set_macro_def_bool("MAIN_EXIT_CODE", false)
        this.set_macro_def_bool("DEBUG", o.debug)

        each o.defs as def {
            let parts = def.split(",")
            each parts as pair {
                pair = pair.trim(" ")
                if pair.length == 0 : continue
                let kv = pair.split("=")
                if kv.length == 1 {
                    this.set_macro_def_bool(pair, true)
                } else {
                    let name = kv.pop_first() ! continue
                    let val = kv.join("=")
                    // "0" / "1" → bool so `#if NAME` works; anything else stays a string
                    if val == "0" {
                        this.set_macro_def_bool(name, false)
                    } else if val == "1" {
                        this.set_macro_def_bool(name, true)
                    } else {
                        this.set_macro_def_string(name, val)
                    }
                }
            }
        }
    }

    fn set_macro_def_string(name: String, val: String) {
        // Primitive string type: core String may not exist yet at Build.init time
        let v = vgen_string(val, type_prim_string(this))
        this.scope.set_idf(name, Idf.for_value(v))
    }

    fn set_macro_def_bool(name: String, val: bool) {
        let v = vgen_bool(val, type_prim_bool(this))
        this.scope.set_idf(name, Idf.for_value(v))
    }

    static fn init_from_args(args: Array[String]) Build !InitError {
        let options = BuildOptions.init_from_args(args) !>
        return Build.init(options)
    }

    // Entry point for the `valk build` CLI: parse the arguments, then either
    // build once or hand over to the --watch loop.
    static fn from_args(args: Array[String]) {
        let options = BuildOptions.init_from_args(args) ! build_error(E.msg)
        if options.is_watch {
            build_watch(options)
            return
        }
        let b = Build.init(options)
        b.run() ! { }
        b.print_results()
    }

    // ########################################
    // RUN
    // ########################################

    fn run() !Error {
        let start = time:microtime()

        // Always collect stats, even when a stage fails (caller ignores the error
        // and uses print_results()).
        this.run_stages() ! {
            this.collect_build_stats(start)
            throw .error
        }
        this.collect_build_stats(start)
    }

    fn run_stages() !Error {
        // Front-end timing includes input/package loading, every pipeline
        // queue, function AST, and per-function IR generation. Unit module
        // assembly/verification is timed with object generation below.
        let func_ir_start = time:microtime()
        let input_files = this.parse_inputs() !>

        // Always load built-in valk:core (stdlib primitives used throughout the compiler).
        let main_pkg = this.main_pkg ?! this.error("Main package not found (bug)")
        let valk = main_pkg.load_sub_pkg("valk") !>
        valk.load_namespace("core") !>

        each input_files as file {
            let ns = this.get_namespace_for_file(file) !>
            // Always load the CLI input file itself (deduped via cache.loaded_files).
            // With --fmt, only these direct input Sources get format = true.
            ns.load_file(file, this.options.is_fmt) !>
            // Then load the rest of the namespace (same-file paths are skipped).
            ns.load_files() !>
        }

        // The entry template exists to be linked into an executable. The LSP
        // links nothing, and pulling it in would report a missing `fn main` for
        // every library file the user opens.
        if !this.options.is_fmt && !isset(this.options.lsp) && this.options.mode == BUILDTYPE.exe {
            let main_ns = main_pkg.get_namespace("main") !>
            main_ns.load_file(helper:add(helper:add(helper:valk_lib_dir(), "templates"), "main-new.valk")) !>
        }

        // --docs documents a package, not an entry point: pull in every namespace
        // rather than only what the input files reach through `use`.
        if this.options.mode == BUILDTYPE.doc {
            main_pkg.load_all_namespaces() !>
        }

        this.pipeline.run() !>

        // The pipeline timer ends after function AST lowering and per-function
        // IR generation. Unit assembly/verification is part of object work.
        this.stats.func_ir_us = time:microtime() - func_ir_start

        // Formatting and doc generation only need the structured Exp trees and
        // deliberately do not enter code generation/verification.
        let object_start = time:microtime()
        if !this.options.front_end_only() {
            generate_unit_modules(this) !>
            let mode = this.options.mode
            if mode == BUILDTYPE.exe || mode == BUILDTYPE.lib {
                emit_unit_objects(this) !>
                this.stats.object_us = time:microtime() - object_start
                link_unit_objects(this) !>
            } else {
                this.stats.object_us = time:microtime() - object_start
                if mode == BUILDTYPE.ir : this.write_ir_output() !>
            }
        }

        // Format in place after class/func bodies have body_exps filled
        each this.format_sources as src {
            src.write_format() !>
        }
    }

    // --ir: write the module, or print it when there is no output path. --ir
    // implies single_unit, so the whole program is one module.
    fn write_ir_output() !Error {
        let path = this.options.path_out
        if isset(path) {
            path = helper:resolve(path)
            if !path.ends_with(".ll") && !path.ends_with(".ir") : path += ".ll"
            this.options.path_out = path
        }
        each this.lists.units as unit {
            if unit.ir_code.length == 0 : continue
            if isset(path) {
                fs:write(path, unit.ir_code) ! this.error("Failed to write LLVM IR: " + path)
            } else {
                println(unit.ir_code)
            }
        }
    }

    // Fill `stats` with duration and peak memory (LOC is updated during parse).
    fn collect_build_stats(start: uint) {
        this.stats.duration_us = time:microtime() - start
        this.stats.mem_peak = gc:mem_usage_peak
    }

    // Report outcome after run(): first error if any, otherwise warnings then
    // stats. Exits the process when there is an error, and with --run replaces
    // this process' exit code with the built program's.
    fn print_results() {
        if !this.print_messages() : exit(1)

        let o = this.options
        if o.mode == BUILDTYPE.doc {
            doc:doc_gen(this)
            return
        }
        if o.mode == BUILDTYPE.ir {
            this.stats.print(o.verbose, false)
            let path = o.path_out
            if isset(path) : helper:msg("✅", "IR output: " + path)
            return
        }
        if o.run_exe && !o.is_fmt && o.mode == BUILDTYPE.exe {
            this.stats.print(o.verbose, false)
            this.run_output()
            return
        }
        this.stats.print(o.verbose)
    }

    // Print the first error, or every warning when the build succeeded.
    // Returns false when the build failed.
    fn print_messages() bool {
        each this.messages as m {
            if m.type == MSG.error {
                m.print()
                return false
            }
        }
        if !this.options.no_warn {
            each this.messages as m {
                if m.type == MSG.warning : m.print()
            }
        }
        return true
    }

    // --run: execute the linked program with the args after `--`, then exit with
    // its exit code.
    fn run_output() {
        let path = this.options.path_out
        if !isset(path) : return
        if !this.options.target.host_is_target() {
            helper:msg("❌", "Cannot run a program built for " + this.options.target.target + " on this machine")
            return
        }
        let cmd = "\"" + path + "\""
        each this.options.run_args as arg {
            cmd += " \"" + arg + "\""
        }
        let code = core:exec(cmd, true)
        exit(code)
    }

    // Resolve CLI inputs into files/dirs, determine the main package, and return the input files.
    // Directory inputs are expanded to `.valk` files (same as old build):
    // - package root (has valk.json) → list files in that package's source dir
    // - any other dir → list `.valk` files in that dir (non-recursive)
    fn parse_inputs() Array[String] !Error {
        let input_dirs = Array[String]{}
        let input_files = Array[String]{}
        each this.options.inputs as input {
            let path = helper:resolve(input)
            if !fs:exists(path) : this.error("File/directory not found: " + path)
            if path.ends_with(".valk") {
                input_files.append(path, true)
                continue
            }
            if fs:is_dir(path) {
                input_dirs.append(path)
                continue
            }
            this.error("Invalid file/directory: " + input)
        }
        if input_files.length == 0 && input_dirs.length == 0 {
            input_dirs.append(fs:cwd())
        }

        let main_pkg : ?Pkg = null

        // Expand directory inputs into concrete source files
        each input_dirs as dir {
            dir = helper:resolve(dir)
            let files_from = dir
            if this.is_pkg_dir(dir) {
                let pkg = this.find_closest_pkg(dir)
                if !isset(pkg) : this.error("Cannot find package for directory: " + dir)
                if isset(main_pkg) && main_pkg != pkg {
                    this.error("Build command contains files from 2 different packages. You can only build 1 package and dependent packages must be included via a valk.json config.")
                }
                main_pkg = pkg
                let srcdir = pkg.srcdir
                if !isset(srcdir) : this.error("Missing package source directory: " + dir)
                files_from = srcdir
            }
            // Non-recursive: namespaces load via `use` / load_files, not by walking the tree
            let files = fs:files_in(files_from, false, true, false)
            each files as file {
                if file.ends_with(".valk") : input_files.append(file, true)
            }
        }

        // Determine which package (if any) each input file belongs to
        each input_files as file {
            let pkg = this.find_pkg_for_path(file)
            if isset(pkg) {
                if isset(main_pkg) && main_pkg != pkg {
                    this.error("Build command contains files from 2 different packages. You can only build 1 package and dependent packages must be included via a valk.json config.")
                }
                main_pkg = pkg
                pkg.name = "main"
            }
        }

        // Loose files outside a package still need a main package to hang namespaces on
        if !isset(main_pkg) : main_pkg = Pkg.new_main(this)

        this.main_pkg = main_pkg
        return input_files
    }

    // ########################################
    // MESSAGES
    // ########################################

    fn error(msg: String) !Error $throw {
        this.has_errors = true
        this.messages.append(Message {
            type: MSG.error
            msg: msg
        })
        throw .error
    }

    // Abort the build after the LSP has answered a cursor request. Everything
    // past the cursor is work whose result is already sent, so this unwinds
    // through the same `!>` chain as a real error but appends no Message: the
    // server distinguishes the two on lsp_answered and stays silent.
    fn lsp_stop() !Error $throw {
        this.lsp_answered = true
        throw .error
    }

    // Like error, for situations that should be impossible if the compiler is correct.
    fn bug(msg: String) !Error $throw {
        this.error("(Compiler bug) " + msg)
    }

    fn warn(msg: String) {
        this.messages.append(Message {
            type: MSG.warning
            msg: msg
        })
    }

    // ########################################
    // UNITS
    // ########################################

    // One Unit per source file, except with --release / --ir where every file
    // shares a single LLVM module. Each Func/Global belongs to exactly one Unit
    // (generic instances follow their base), so no definition is emitted twice;
    // symbol *names* do need the source id in this mode, see ir_name_prefix.
    fn get_unit_for_path(path: String) Unit {
        if this.options.single_unit {
            let shared = this.cache.single_unit
            if isset(shared) : return shared
            // Fixed name: no per-file names exist in this mode, so it is unique
            shared = Unit { name: "valk-release" }
            this.cache.used_unit_names.append(shared.name)
            this.cache.single_unit = shared
            this.lists.units.append(shared)
            return shared
        }
        let unit = Unit.new(this.cache, path)
        this.lists.units.append(unit)
        return unit
    }

    // ########################################
    // PACKAGES
    // ########################################

    // Find the package for a file or directory path.
    // Walks parent directories for a valk.json, then checks the path lies within that package's source dir.
    // Returns null when there is no package, or the path is outside the package source tree.
    fn find_pkg_for_path(path: String) ?Pkg {
        path = helper:resolve(path)
        let dir = fs:is_dir(path) ? path : fs:dir_of(path)
        let pkg = this.find_closest_pkg(dir)
        if !isset(pkg) : return null
        if pkg.contains_path(path) : return pkg
        return null
    }

    // Walk dir and parents until a directory containing valk.json is found.
    fn find_closest_pkg(dir: String) ?Pkg {
        dir = helper:resolve(dir)
        this.cache.package_dirs.get(dir) -> pkg : return pkg

        if this.is_pkg_dir(dir) {
            let pkg = Pkg.new(this, dir)
            this.cache.package_dirs.set(dir, pkg)
            return pkg
        }

        let parent = fs:dir_of(dir)
        if parent == dir : return null

        let pkg = this.find_closest_pkg(parent)
        if isset(pkg) : this.cache.package_dirs.set(dir, pkg)
        return pkg
    }

    fn is_pkg_dir(dir: String) bool {
        return fs:exists(helper:add(dir, "valk.json"))
    }

    // ########################################
    // NAMESPACES
    // ########################################

    // Resolve which namespace a source file belongs to from its path under the package src dir.
    fn get_namespace_for_file(path: String) Namespace !Error {
        path = helper:resolve(path)
        let pkg = this.find_pkg_for_path(path) ?? (this.main_pkg ?! this.error("Main package not found (bug)"))
        let dir = fs:dir_of(path)
        let srcdir = pkg.srcdir
        if !isset(srcdir) : return pkg.get_namespace("main") !>
        if srcdir == dir : return pkg.get_namespace("main") !>

        let rel = dir.part(srcdir.length, dir.length - srcdir.length).trim("/").trim("\\")
        return pkg.get_namespace(rel) !>
    }
}

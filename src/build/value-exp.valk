// Parse a value into a structured EXP.value expression tree.
// Used for macro conditions (`#if OS == win`) and later for full expression AST.
//
// Forms (str1 unless noted): see VALUE_EXP in exp-enums.valk.
// `allow_newline` controls whether the expression may span lines (false for #if conditions).

fn read_value_exp(p: Parser, allow_newline: bool (false)) Exp !Error {
    return read_value_or(p, allow_newline) !>
}

// ||
fn read_value_or(p: Parser, allow_newline: bool) Exp !Error {
    let left = read_value_and(p, allow_newline) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign || !p.word_is("||") : break
        p.tok(true, allow_newline) !>
        let right = read_value_and(p, allow_newline) !>
        left = make_value_op(p, left, "||", right)
    }
    return left
}

// &&
fn read_value_and(p: Parser, allow_newline: bool) Exp !Error {
    let left = read_value_cmp(p, allow_newline) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign || !p.word_is("&&") : break
        p.tok(true, allow_newline) !>
        let right = read_value_cmp(p, allow_newline) !>
        left = make_value_op(p, left, "&&", right)
    }
    return left
}

// == != < > <= >=
fn read_value_cmp(p: Parser, allow_newline: bool) Exp !Error {
    let left = read_value_add(p, allow_newline) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign : break
        let op = p.word()
        if op != "==" && op != "!=" && op != "<" && op != ">" && op != "<=" && op != ">=" : break
        p.tok(true, allow_newline) !>
        let right = read_value_add(p, allow_newline) !>
        left = make_value_op(p, left, op, right)
    }
    return left
}

// + -
fn read_value_add(p: Parser, allow_newline: bool) Exp !Error {
    let left = read_value_mul(p, allow_newline) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign : break
        let op = p.word()
        if op != "+" && op != "-" : break
        p.tok(true, allow_newline) !>
        let right = read_value_mul(p, allow_newline) !>
        left = make_value_op(p, left, op, right)
    }
    return left
}

// * / %
fn read_value_mul(p: Parser, allow_newline: bool) Exp !Error {
    let left = read_value_unary(p, allow_newline) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign : break
        let op = p.word()
        if op != "*" && op != "/" && op != "%" : break
        p.tok(true, allow_newline) !>
        let right = read_value_unary(p, allow_newline) !>
        left = make_value_op(p, left, op, right)
    }
    return left
}

// ! - (unary)
fn read_value_unary(p: Parser, allow_newline: bool) Exp !Error {
    let t = p.tok(true, allow_newline, false) !>
    if t == TOK.sign && p.word_is("!") {
        p.tok(true, allow_newline) !>
        let exp = p.create_exp(EXP.value)
        // Include the `!` in the span
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        exp.str1 = "unary"
        exp.str2 = "!"
        let operand = read_value_unary(p, allow_newline) !>
        exp.set(VALUE_EXP.left, operand)
        exp.set_end(p.pos.i)
        return exp
    }
    if t == TOK.sign && p.word_is("-") {
        // Unary minus only when followed by a number (same rule as the old parser)
        p.tok(true, allow_newline) !>
        let t2 = p.tok(false, false, false) !>
        if t2 == TOK.int || t2 == TOK.float || t2 == TOK.hex || t2 == TOK.octal {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 && p.pos.i >= p.word_len {
                exp.i = p.pos.i - p.word_len
            }
            exp.str1 = "unary"
            exp.str2 = "-"
            let operand = read_value_primary(p, allow_newline) !>
            exp.set(VALUE_EXP.left, operand)
            exp.set_end(p.pos.i)
            return exp
        }
        p.error("Expected a number after unary '-', found: '" + p.word() + "'")
    }
    return read_value_postfix(p, allow_newline) !>
}

// Postfix: call `(...)` and `.name`
fn read_value_postfix(p: Parser, allow_newline: bool) Exp !Error {
    let v = read_value_primary(p, allow_newline) !>
    while true {
        let t = p.tok(false, false, false) !>
        if t == TOK.sign && p.word_is("(") {
            v = read_value_call(p, v) !>
            continue
        }
        if t == TOK.sign && p.word_is(".") {
            p.tok(false, false) !>
            let name = p.read_word(false, false) !>
            let exp = p.create_exp(EXP.value)
            exp.i = v.i
            exp.str1 = "dot"
            exp.str2 = name
            exp.set(VALUE_EXP.left, v)
            exp.set_end(p.pos.i)
            v = exp
            continue
        }
        break
    }
    return v
}

fn read_value_primary(p: Parser, allow_newline: bool) Exp !Error {
    let t = p.tok(true, allow_newline) !>

    if t == TOK.sign && p.word_is("(") {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        exp.str1 = "paren"
        exp.set(VALUE_EXP.left, read_value_exp(p, true) !>)
        p.expect(")", true, allow_newline) !>
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.int || t == TOK.float || t == TOK.hex || t == TOK.octal {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        if t == TOK.int : exp.str1 = "number"
        else if t == TOK.float : exp.str1 = "float"
        else if t == TOK.hex : exp.str1 = "hex"
        else : exp.str1 = "octal"
        exp.str2 = p.word()
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.string {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        exp.str1 = "string"
        exp.str2 = p.word()
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.char {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        exp.str1 = "char"
        exp.str2 = p.word()
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.word || t == TOK.at_word {
        // true / false / null
        if p.word_is("true") || p.word_is("false") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 && p.pos.i >= p.word_len {
                exp.i = p.pos.i - p.word_len
            }
            exp.str1 = "bool"
            exp.str2 = p.word()
            exp.set_end(p.pos.i)
            return exp
        }
        if p.word_is("null") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 && p.pos.i >= p.word_len {
                exp.i = p.pos.i - p.word_len
            }
            exp.str1 = "null"
            exp.set_end(p.pos.i)
            return exp
        }

        // Identifier (optional ns:name) as form "id" with VALUE_EXP.left → EXP.id
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        exp.str1 = "id"
        let id = p.create_exp(EXP.id)
        id.i = exp.i
        id.str1 = p.word()
        let t2 = p.tok(false, false, false) !>
        if t2 == TOK.sign && p.word_is(":") {
            p.tok(false, false) !>
            id.str2 = id.str1
            id.str1 = p.read_word(false, false) !>
        }
        id.set_end(p.pos.i)
        exp.set(VALUE_EXP.left, id)
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.end || t == TOK.none {
        p.error("Expected a value expression")
    }
    p.error("Unexpected token in value expression: '" + p.word() + "'")
}

// Current token is `(` after a callee value. Build form "call".
fn read_value_call(p: Parser, callee: Exp) Exp !Error {
    p.expect("(", false, false) !>
    let exp = p.create_exp(EXP.value)
    exp.i = callee.i
    exp.str1 = "call"
    exp.set(VALUE_EXP.left, callee)

    let args = p.create_exp(EXP.value)
    args.str1 = "multi"
    let index: uint = 0
    let t = p.tok(true, true, false) !>
    if !(t == TOK.sign && p.word_is(")")) {
        while true {
            args.set(index++, read_value_exp(p, true) !>)
            t = p.tok(true, true, false) !>
            if t == TOK.sign && p.word_is(")") : break
            if t == TOK.sign && p.word_is(",") {
                p.tok(true, true) !>
                continue
            }
            p.error("Expected ',' or ')' in call arguments, found: '" + p.word() + "'")
        }
    }
    p.expect(")", true, true) !>
    args.set_end(p.pos.i)
    exp.set(VALUE_EXP.right, args)
    exp.set_end(p.pos.i)
    return exp
}

fn make_value_op(p: Parser, left: Exp, op: String, right: Exp) Exp {
    let exp = p.create_exp(EXP.value)
    exp.i = left.i
    exp.str1 = "op"
    exp.str2 = op
    exp.set(VALUE_EXP.left, left)
    exp.set(VALUE_EXP.right, right)
    exp.set_end(right.i + right.len)
    return exp
}

// Parse a value into a structured EXP.value expression tree.
// Exp.kind = VALUE_KIND; for op/unary, Exp.number = VALUE_OP.
//
// `allow_newline` — whether the expression may span lines (false for #if conditions).
// `allow_class_init` — whether `Type { fields }` may attach as a value postfix.
//   false for if/while/each conditions so `{` always starts the statement body.
//   Use parentheses to opt in: `if (Node { a: 1 }).ok { … }`.

fn read_value_exp(p: Parser, allow_newline: bool (false), allow_class_init: bool (true)) Exp !Error {
    // Lowest: ?? / ?! then ternary ? : then || …
    return read_value_null_ops(p, allow_newline, allow_class_init) !>
}

// Precedence (low → high): ??/?!  ternary  ||  &&  cmp  |  ^  &  <<>>  +-  */%  unary  postfix
//
// left ?? right  |  left ?! body
fn read_value_null_ops(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_ternary(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign : break
        if p.word_is("??") {
            p.tok(true, allow_newline) !>
            let right = read_value_null_ops(p, allow_newline, allow_class_init) !>
            let exp = p.create_exp(EXP.value)
            exp.i = left.i
            exp.kind = VALUE_KIND.null_coalesce
            exp.set(VALUE_EXP.left, left)
            exp.set(VALUE_EXP.right, right)
            exp.set_end(p.pos.i)
            left = exp
            continue
        }
        if p.word_is("?!") {
            p.tok(true, allow_newline) !>
            let body = read_null_exit_body(p) !>
            let exp = p.create_exp(EXP.value)
            exp.i = left.i
            exp.kind = VALUE_KIND.null_exit
            exp.set(VALUE_EXP.left, left)
            exp.set(VALUE_EXP.right, body)
            exp.set_end(p.pos.i)
            left = exp
            continue
        }
        break
    }
    return left
}

// cond ? then : else  (right-associative via full recursive then/else)
fn read_value_ternary(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_or(p, allow_newline, allow_class_init) !>
    let t = p.tok(true, allow_newline, false) !>
    // Bare `?` only (not `??` / `?!` — those are multi-char tokens)
    if t == TOK.sign && p.word_is("?") {
        p.tok(true, allow_newline) !>
        let then_exp = read_value_exp(p, allow_newline, allow_class_init) !>
        p.expect(":", true, allow_newline) !>
        let else_exp = read_value_exp(p, allow_newline, allow_class_init) !>
        let exp = p.create_exp(EXP.value)
        exp.i = left.i
        exp.kind = VALUE_KIND.ternary
        exp.set(VALUE_EXP.left, left)
        exp.set(VALUE_EXP.right, then_exp)
        exp.set(VALUE_EXP.third, else_exp)
        exp.set_end(p.pos.i)
        return exp
    }
    return left
}

// ||
fn read_value_or(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_and(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign || !p.word_is("||") : break
        p.tok(true, allow_newline) !>
        let right = read_value_and(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, VALUE_OP.or, right)
    }
    return left
}

// &&
fn read_value_and(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_cmp(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign || !p.word_is("&&") : break
        p.tok(true, allow_newline) !>
        let right = read_value_cmp(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, VALUE_OP.and, right)
    }
    return left
}

// == != < > <= >=
fn read_value_cmp(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_bit_or(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign : break
        let op: VALUE_OP = VALUE_OP.eq
        if p.word_is("==") : op = VALUE_OP.eq
        else if p.word_is("!=") : op = VALUE_OP.ne
        else if p.word_is("<=") : op = VALUE_OP.lte
        else if p.word_is(">=") : op = VALUE_OP.gte
        else if p.word_is("<") : op = VALUE_OP.lt
        else if p.word_is(">") : op = VALUE_OP.gt
        else : break
        p.tok(true, allow_newline) !>
        let right = read_value_bit_or(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, op, right)
    }
    return left
}

// |
fn read_value_bit_or(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_bit_xor(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign || !p.word_is("|") : break
        p.tok(true, allow_newline) !>
        let right = read_value_bit_xor(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, VALUE_OP.bit_or, right)
    }
    return left
}

// ^
fn read_value_bit_xor(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_bit_and(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign || !p.word_is("^") : break
        p.tok(true, allow_newline) !>
        let right = read_value_bit_and(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, VALUE_OP.bit_xor, right)
    }
    return left
}

// &
fn read_value_bit_and(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_shift(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign || !p.word_is("&") : break
        p.tok(true, allow_newline) !>
        let right = read_value_shift(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, VALUE_OP.bit_and, right)
    }
    return left
}

// << >>
fn read_value_shift(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_add(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign : break
        let op: VALUE_OP = VALUE_OP.shl
        if p.word_is("<<") : op = VALUE_OP.shl
        else if p.word_is(">>") : op = VALUE_OP.shr
        else : break
        p.tok(true, allow_newline) !>
        let right = read_value_add(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, op, right)
    }
    return left
}

// + -
fn read_value_add(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_mul(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign : break
        let op: VALUE_OP = VALUE_OP.add
        if p.word_is("+") : op = VALUE_OP.add
        else if p.word_is("-") : op = VALUE_OP.sub
        else : break
        p.tok(true, allow_newline) !>
        let right = read_value_mul(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, op, right)
    }
    return left
}

// * / %
fn read_value_mul(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_unary(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign : break
        let op: VALUE_OP = VALUE_OP.mul
        if p.word_is("*") : op = VALUE_OP.mul
        else if p.word_is("/") : op = VALUE_OP.div
        else if p.word_is("%") : op = VALUE_OP.mod
        else : break
        p.tok(true, allow_newline) !>
        let right = read_value_unary(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, op, right)
    }
    return left
}

// ! ~ - ++ -- (unary / prefix)
fn read_value_unary(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let t = p.tok(true, allow_newline, false) !>
    if t == TOK.sign && (p.word_is("++") || p.word_is("--")) {
        let is_incr = p.word_is("++")
        p.tok(true, allow_newline) !>
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = is_incr ? VALUE_KIND.incr : VALUE_KIND.decr
        exp.bool1 = true // prefix
        exp.set(VALUE_EXP.left, read_value_unary(p, allow_newline, allow_class_init) !>)
        exp.set_end(p.pos.i)
        return exp
    }
    if t == TOK.sign && p.word_is("!") {
        p.tok(true, allow_newline) !>
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.unary
        exp.number = VALUE_OP.not
        let operand = read_value_unary(p, allow_newline, allow_class_init) !>
        exp.set(VALUE_EXP.left, operand)
        exp.set_end(p.pos.i)
        return exp
    }
    if t == TOK.sign && p.word_is("~") {
        p.tok(true, allow_newline) !>
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.unary
        exp.number = VALUE_OP.bit_not
        let operand = read_value_unary(p, allow_newline, allow_class_init) !>
        exp.set(VALUE_EXP.left, operand)
        exp.set_end(p.pos.i)
        return exp
    }
    if t == TOK.sign && p.word_is("-") {
        // Unary minus only when followed by a number (same rule as the old parser)
        p.tok(true, allow_newline) !>
        let t2 = p.tok(false, false, false) !>
        if t2 == TOK.int || t2 == TOK.float || t2 == TOK.hex || t2 == TOK.octal {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
            exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.unary
            exp.number = VALUE_OP.neg
            let operand = read_value_primary(p, allow_newline) !>
            exp.set(VALUE_EXP.left, operand)
            exp.set_end(p.pos.i)
            return apply_value_postfix(p, exp, allow_class_init) !>
        }
        p.error("Expected a number after unary '-', found: '" + p.word() + "'")
    }
    return read_value_postfix(p, allow_newline, allow_class_init) !>
}

// Postfix: call / .name / ++ -- / optional class init
fn read_value_postfix(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let v = read_value_primary(p, allow_newline) !>
    return apply_value_postfix(p, v, allow_class_init) !>
}

// Attach `.member` / `.@cast(Type)` / `(args)` / `[index]` / error-handlers / `++` / `--` / `{ fields }` to a value.
// Class init only when `allow_class_init` (off for if/while conditions).
// Error handlers allow a space before the token (`f() !`, `f() !? alt`) but not a newline.
fn apply_value_postfix(p: Parser, v: Exp, allow_class_init: bool) Exp !Error {
    while true {
        // Tight postfix: no space before `(`, `.`, `[`, `++`, `--`
        let t = p.tok(false, false, false) !>
        if t == TOK.sign && p.word_is("(") {
            v = read_value_call(p, v) !>
            // Optional error handler immediately after the call (space ok, newline not)
            let handled = try_read_error_handler(p, v) !>
            if isset(handled) : v = handled
            continue
        }
        if t == TOK.sign && p.word_is("[") {
            v = read_value_offset(p, v) !>
            // Optional error handler immediately after the offset (space ok, newline not)
            let handled = try_read_error_handler(p, v) !>
            if isset(handled) : v = handled
            continue
        }
        if t == TOK.sign && (p.word_is("++") || p.word_is("--")) {
            let is_incr = p.word_is("++")
            p.tok(false, false) !>
            let exp = p.create_exp(EXP.value)
            exp.i = v.i
            exp.kind = is_incr ? VALUE_KIND.incr : VALUE_KIND.decr
            exp.bool1 = false // postfix
            exp.set(VALUE_EXP.left, v)
            exp.set_end(p.pos.i)
            v = exp
            continue
        }
        if t == TOK.sign && p.word_is(".") {
            p.tok(false, false) !>
            let tn = p.tok(false, false) !>
            if tn != TOK.word && tn != TOK.at_word && tn != TOK.flag {
                p.error("Expected property or method name after '.', found: '" + p.word() + "'")
            }
            if p.word_is("@cast") {
                p.expect("(", false, false) !>
                let exp = p.create_exp(EXP.value)
                exp.i = v.i
                exp.kind = VALUE_KIND.cast
                exp.set(VALUE_EXP.left, v)
                exp.set(VALUE_EXP.right, read_type_exp(p, true, true) !>)
                p.expect(")", true, true) !>
                exp.set_end(p.pos.i)
                v = exp
                continue
            }
            let name = p.word()
            let exp = p.create_exp(EXP.value)
            exp.i = v.i
            exp.kind = VALUE_KIND.dot
            exp.str1 = name
            exp.set(VALUE_EXP.left, v)
            exp.set_end(p.pos.i)
            v = exp
            continue
        }

        // Class init: space/newline allowed before `{` (e.g. `Node { … }`).
        // Disabled in statement conditions so `if x {` / `while x {` keep `{` as body.
        if allow_class_init {
            t = p.tok(true, true, false) !>
            if t == TOK.sign && p.word_is("{") {
                v = read_value_class_init(p, v) !>
                continue
            }
        }
        break
    }
    return v
}

// Current token is tight `[` after a value.
// Captures `[...]` as EXP.body; lower re-parses as type list or value index.
fn read_value_offset(p: Parser, left: Exp) Exp !Error {
    p.expect("[", false, false) !>
    let exp = p.create_exp(EXP.value)
    exp.i = left.i
    exp.kind = VALUE_KIND.offset
    exp.set(VALUE_EXP.left, left)
    exp.set(VALUE_EXP.right, read_body_exp(p, "[", "]") !>)
    exp.set_end(p.pos.i)
    return exp
}

// `Type { … }` — left is the type/id expression already parsed.
// Body is captured raw; fields are parsed at lower once the class is known.
fn read_value_class_init(p: Parser, left: Exp) Exp !Error {
    p.expect("{", true, true) !>
    let exp = p.create_exp(EXP.value)
    exp.i = left.i
    exp.kind = VALUE_KIND.class_init
    exp.set(VALUE_EXP.left, left)
    exp.set(VALUE_EXP.right, read_body_exp(p, "{", "}") !>)
    exp.set_end(p.pos.i)
    return exp
}

// Anonymous function literal (closure): `fn(args) rett! { body }`. `fn` already consumed.
// No name / generics / flags — those aren't meaningful for an inline literal.
fn read_value_func_lit_exp(p: Parser) Exp !Error {
    let exp = p.create_exp(EXP.value)
    if p.word_len > 0 {
        exp.i = p.word_i
    }
    exp.kind = VALUE_KIND.func_lit

    // Arguments body () — required
    p.expect("(", true, false) !>
    exp.set(FUNC_LIT_EXP.args, read_body_exp(p, "(", ")") !>)

    // Optional return type: a plain type or `(T, U)` (read_type_exp handles both,
    // same as top-level `fn` signatures).
    let t = p.tok(true, true, false) !>
    if !(t == TOK.sign && (p.word_is("{") || p.word_is("!"))) {
        exp.set(FUNC_LIT_EXP.type, read_type_exp(p) !>)
        t = p.tok(true, true, false) !>
    }

    // Optional error type: !ErrorName
    if t == TOK.sign && p.word_is("!") {
        p.tok(true, true) !>
        exp.set(FUNC_LIT_EXP.error, p.read_id(false, false) !>)
        t = p.tok(true, true, false) !>
    }

    if t == TOK.sign && p.word_is("{") {
        p.tok(true, true) !>
        exp.set(FUNC_LIT_EXP.body, read_body_exp(p, "{", "}") !>)
    } else {
        p.error("Expected '{' after function literal signature, found: '" + p.word() + "'")
    }
    exp.set_end(p.pos.i)
    return exp
}

// Bare `{ … }` value — body captured raw; ambient type at lower chooses
// class-init fields vs fixed-array elements (no content peeking).
// `{` already consumed.
fn read_value_inline_init(p: Parser) Exp !Error {
    let exp = p.create_exp(EXP.value)
    if p.word_len > 0 {
        exp.i = p.word_i
    }
    exp.kind = VALUE_KIND.class_init
    // No left — type from ambient at lower
    exp.set(VALUE_EXP.right, read_body_exp(p, "{", "}") !>)
    exp.set_end(p.pos.i)
    return exp
}

// After `{` already consumed (or body re-parse at interior): class-init items until `}`.
//
// Three item forms (mixed field + list/map is rejected at lower):
//   1. `prop: Value`     — field (str1 = name, left = value, number = CLASS_INIT_ITEM.field)
//   2. `Value`           — element for $append (left = value, number = CLASS_INIT_ITEM.elem)
//   3. `Value => Value`  — pair for $set_key (left = key, right = val, number = CLASS_INIT_ITEM.pair)
fn read_class_init_fields(p: Parser) Exp !Error {
    let fields = p.create_exp(EXP.value)
    fields.kind = VALUE_KIND.multi
    let fi: uint = 0
    let keep_comments = p.pos.src.format

    while true {
        let t = p.tok(true, true, false) !>
        if t == TOK.end : p.error("Unexpected end of file in class init, missing '}'")
        if t == TOK.sign && p.word_is("}") {
            p.tok(true, true) !>
            break
        }
        if t == TOK.comment {
            if keep_comments {
                p.tok(true, true) !>
                fields.set(fi, read_comment_exp(p))
                fi++
            } else {
                p.tok(true, true) !>
            }
            continue
        }
        if t == TOK.sign && p.word_is(",") {
            p.tok(true, true) !>
            continue
        }

        // Field: bare `name:` (peek with a throwaway parser so we don't consume a value start)
        if class_init_starts_with_field(p) !> {
            p.tok(true, true) !> // name
            let fname = p.word()
            let name_i = p.word_i
            p.expect(":", true, false) !>
            let field = p.create_exp(EXP.value)
            field.i = name_i
            field.kind = VALUE_KIND.id
            field.number = CLASS_INIT_ITEM.field
            field.str1 = fname
            field.set(VALUE_EXP.left, read_value_exp(p, true, true) !>)
            field.set_end(p.pos.i)
            fields.set(fi, field)
            fi++
        } else {
            // Element or pair
            let val = read_value_exp(p, true, true) !>
            fields.set(fi, read_class_init_value_or_pair(p, val) !>)
            fi++
        }

        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is(",") {
            p.tok(true, true) !>
            continue
        }
        // Newline-separated items
    }
    return fields
}

// True when next tokens are `name :` (property field), not a value expression.
fn class_init_starts_with_field(p: Parser) bool !Error {
    let sub = p.pos.copy().init_parser()
    let t = sub.tok(true, true, false) !>
    if t != TOK.word && t != TOK.at_word : return false
    sub.tok(true, true) !> // consume name
    // `:` on the same logical item — allow space, not typically newline for fields
    let t2 = sub.tok(true, false, false) !>
    return t2 == TOK.sign && sub.word_is(":")
}

// After a value: `=> right` → pair, else element.
fn read_class_init_value_or_pair(p: Parser, left: Exp) Exp !Error {
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is("=>") {
        p.tok(true, true) !>
        let item = p.create_exp(EXP.value)
        item.i = left.i
        item.kind = VALUE_KIND.multi
        item.number = CLASS_INIT_ITEM.pair
        item.set(VALUE_EXP.left, left)
        item.set(VALUE_EXP.right, read_value_exp(p, true, true) !>)
        item.set_end(p.pos.i)
        return item
    }
    let item = p.create_exp(EXP.value)
    item.i = left.i
    item.kind = VALUE_KIND.multi
    item.number = CLASS_INIT_ITEM.elem
    item.set(VALUE_EXP.left, left)
    item.set_end(p.pos.i)
    return item
}

// After `{` already consumed: parse positional values until `}`.
fn read_array_init_elements(p: Parser) Exp !Error {
    let elems = p.create_exp(EXP.value)
    elems.kind = VALUE_KIND.multi
    let ei: uint = 0
    let keep_comments = p.pos.src.format

    while true {
        let t = p.tok(true, true, false) !>
        if t == TOK.end : p.error("Unexpected end of file in array init, missing '}'")
        if t == TOK.sign && p.word_is("}") {
            p.tok(true, true) !>
            break
        }
        if t == TOK.comment {
            if keep_comments {
                p.tok(true, true) !>
                elems.set(ei, read_comment_exp(p))
                ei++
            } else {
                p.tok(true, true) !>
            }
            continue
        }
        if t == TOK.sign && p.word_is(",") {
            p.tok(true, true) !>
            continue
        }

        elems.set(ei, read_value_exp(p, true, true) !>)
        ei++

        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is(",") {
            p.tok(true, true) !>
            continue
        }
        // Newline-separated elements
    }
    return elems
}

fn read_value_primary(p: Parser, allow_newline: bool) Exp !Error {
    let t = p.tok(true, allow_newline) !>

    // `.{ … }` — inferred-type literal (ambient type at lower), same as bare `{ … }`
    if t == TOK.sign && p.word_is(".") {
        let i0 = p.word_i
        let tn0 = p.tok(false, false) !>
        if tn0 == TOK.sign && p.word_is("{") {
            let exp = read_value_inline_init(p) !>
            exp.i = i0
            return exp
        }

        // Error code: `.name` (used with throw / error payloads)
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = i0
        }
        exp.kind = VALUE_KIND.error_code
        if tn0 != TOK.word && tn0 != TOK.at_word {
            p.error("Expected error code name after '.', found: '" + p.word() + "'")
        }
        exp.str1 = p.word()
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.sign && p.word_is("(") {
        // `(value)` grouping or `(a, b, …)` multi-value
        let first = read_value_exp(p, true, true) !>
        let t2 = p.tok(true, true, false) !>
        if t2 == TOK.sign && p.word_is(",") {
            // Multi-value: (a, b, …)
            let multi = p.create_exp(EXP.value)
            if p.word_len > 0 {
                multi.i = first.i
            }
            multi.kind = VALUE_KIND.multi
            multi.set(0, first)
            let mi: uint = 1
            while true {
                p.tok(true, true) !> // consume `,`
                multi.set(mi, read_value_exp(p, true, true) !>)
                mi++
                t2 = p.tok(true, true, false) !>
                if t2 == TOK.sign && p.word_is(",") : continue
                break
            }
            p.expect(")", true, allow_newline) !>
            multi.set_end(p.pos.i)
            return multi
        }
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = first.i
        }
        exp.kind = VALUE_KIND.paren
        // Inside `(…)` class init is always allowed (opt-in for conditions)
        exp.set(VALUE_EXP.left, first)
        p.expect(")", true, allow_newline) !>
        exp.set_end(p.pos.i)
        return exp
    }

    // Value scope: `<{ ... }`
    if t == TOK.sign && p.word_is("<{") {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.vscope
        // Opener `<{` already consumed; capture interior until matching `}`
        exp.set(VALUE_EXP.left, read_body_exp(p, "{", "}") !>)
        exp.set_end(p.pos.i)
        return exp
    }

    // Bare `{ fields }` / `{ elems }` — type from ambient at lower (inline struct / fixed array)
    if t == TOK.sign && p.word_is("{") {
        return read_value_inline_init(p) !>
    }

    if t == TOK.int || t == TOK.float || t == TOK.hex || t == TOK.octal {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        if t == TOK.int : exp.kind = VALUE_KIND.number
        else if t == TOK.float : exp.kind = VALUE_KIND.float
        else if t == TOK.hex : exp.kind = VALUE_KIND.hex
        else : exp.kind = VALUE_KIND.octal
        exp.str1 = p.word()
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.string {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.string
        exp.str1 = p.word()
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.char {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.char
        exp.str1 = p.word()
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.word || t == TOK.at_word {
        // Builtins with fixed arg shapes: capture `(...)` body; re-parse at lower.
        if t == TOK.at_word && p.word_is("@ptrv") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
                exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.ptrv
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.right, read_body_exp(p, "(", ")") !>)
            exp.set_end(p.pos.i)
            return exp
        }
        if t == TOK.at_word && p.word_is("@ref") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
                exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.ref_of
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.right, read_body_exp(p, "(", ")") !>)
            exp.set_end(p.pos.i)
            return exp
        }

        // Only claim `fn` as the function-literal keyword when it's actually followed by
        // an argument list — otherwise it's a plain identifier (e.g. a variable named `fn`).
        if p.word_is("fn") && p.next_word_is("(", true, false, false) !> {
            return read_value_func_lit_exp(p) !>
        }

        if p.word_is("true") || p.word_is("false") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
            exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.bool
            exp.bool1 = p.word_is("true")
            exp.set_end(p.pos.i)
            return exp
        }
        if p.word_is("null") {
            // `null` or `null[Type]` (explicit type when no ambient suggestion)
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
            exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.null
            // Optional `null[Type]` — no space between `null` and `[` (same as old)
            if p.next_word_is("[", false, false, true) !> {
                exp.set(VALUE_EXP.left, read_type_exp(p, true, true) !>)
                p.expect("]", true, true) !>
            }
            exp.set_end(p.pos.i)
            return exp
        }
        if p.word_is("typeof") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
            exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.typeof
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.left, read_value_exp(p, true, true) !>)
            p.expect(")", true, allow_newline) !>
            exp.set_end(p.pos.i)
            return exp
        }

        if p.word_is("size_of") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
            exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.size_of
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.left, read_type_exp(p, true, true) !>)
            p.expect(")", true, allow_newline) !>
            exp.set_end(p.pos.i)
            return exp
        }

        if p.word_is("isset") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
            exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.isset
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.left, read_value_exp(p, true, true) !>)
            p.expect(")", true, allow_newline) !>
            exp.set_end(p.pos.i)
            return exp
        }

        // Identifier (optional ns:name) — VALUE_EXP.left → EXP.id
        // Generic type args and index are postfix `[…]` (see apply_value_postfix /
        // VALUE_KIND.offset) so `x[0]` is not mistaken for type arguments.
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.id
        let id = p.create_exp(EXP.id)
        id.i = exp.i
        id.str1 = p.word()
        let t2 = p.tok(false, false, false) !>
        if t2 == TOK.sign && p.word_is(":") {
            p.tok(false, false) !>
            id.str2 = id.str1
            id.str1 = p.read_word(false, false) !>
        }
        id.set_end(p.pos.i)
        exp.set(VALUE_EXP.left, id)
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.end || t == TOK.none {
        p.error("Expected a value expression")
    }
    p.error("Unexpected token in value expression: '" + p.word() + "'")
}

// After `[` on a value id: comma-separated type arguments until `]`.
// Used for generic class/func specialization (`Array[String]`, `foo[T]`).
fn read_value_type_args(p: Parser) Exp !Error {
    let generics = p.create_exp(EXP.type)
    generics.kind = TYPE_KIND.multi
    let i: uint = 0
    while true {
        let t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is("]") {
            p.tok(true, true) !>
            break
        }
        if i > 0 {
            p.expect(",", true, true) !>
        }
        if t == TOK.end || t == TOK.none {
            p.error("Expected type or ']' in type arguments")
        }
        generics.set(i, read_type_exp(p, true, true) !>)
        i++
    }
    generics.set_end(p.pos.i)
    return generics
}

// Current token is `(` after a callee value. Build VALUE_KIND.call.
// Args always allow class init (`foo(Node { a: 1 })`).
fn read_value_call(p: Parser, callee: Exp) Exp !Error {
    p.expect("(", false, false) !>
    let exp = p.create_exp(EXP.value)
    exp.i = callee.i
    exp.kind = VALUE_KIND.call
    exp.set(VALUE_EXP.left, callee)

    let args = p.create_exp(EXP.value)
    args.kind = VALUE_KIND.multi
    let index: uint = 0
    let t = p.tok(true, true, false) !>
    if !(t == TOK.sign && p.word_is(")")) {
        while true {
            args.set(index++, read_value_exp(p, true, true) !>)
            t = p.tok(true, true, false) !>
            if t == TOK.sign && p.word_is(")") : break
            if t == TOK.sign && p.word_is(",") {
                p.tok(true, true) !>
                continue
            }
            p.error("Expected ',' or ')' in call arguments, found: '" + p.word() + "'")
        }
    }
    p.expect(")", true, true) !>
    args.set_end(p.pos.i)
    exp.set(VALUE_EXP.right, args)
    exp.set_end(p.pos.i)
    return exp
}

fn make_value_op(p: Parser, left: Exp, op: VALUE_OP, right: Exp) Exp {
    let exp = p.create_exp(EXP.value)
    exp.i = left.i
    exp.kind = VALUE_KIND.op
    exp.number = op
    exp.set(VALUE_EXP.left, left)
    exp.set(VALUE_EXP.right, right)
    exp.set_end(right.i + right.len)
    return exp
}

// Body after `?!` or `!` error handler: `{ ... }` or a single statement.
fn read_null_exit_body(p: Parser) Exp !Error {
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is("{") {
        return read_block_exp(p) !>
    }
    // Single statement (must exit: return / throw / break / continue / exit)
    let exp = p.create_exp(EXP.block)
    exp.bool1 = true // single-statement form
    let stmt = read_func_stmt_exp(p) !>
    exp.body_exps = Array[Exp]{ stmt }
    exp.i = stmt.i
    exp.set_end(p.pos.i)
    return exp
}

// If the next token is an error-handler marker after a call, parse and wrap `on`.
// Returns null when no handler is present (caller may apply default pass later).
// Space allowed before marker; newline is not (matches old `next_is_one_of(..., true, false)`).
fn try_read_error_handler(p: Parser, on: Exp) ?Exp !Error {
    let t = p.tok(true, false, false) !>
    if t == TOK.sign {
        if p.word_is("!?") {
            p.tok(true, false) !>
            let exp = p.create_exp(EXP.value)
            exp.i = on.i
            exp.kind = VALUE_KIND.error_handler
            exp.number = ERRH_KIND.value
            exp.set(VALUE_EXP.left, on)
            exp.set(VALUE_EXP.right, read_value_exp(p, true, true) !>)
            exp.set_end(p.pos.i)
            return exp
        }
        if p.word_is("!>") {
            p.tok(true, false) !>
            let exp = p.create_exp(EXP.value)
            exp.i = on.i
            exp.kind = VALUE_KIND.error_handler
            exp.number = ERRH_KIND.pass
            exp.set(VALUE_EXP.left, on)
            exp.set_end(p.pos.i)
            return exp
        }
        if p.word_is("!!") {
            p.tok(true, false) !>
            let exp = p.create_exp(EXP.value)
            exp.i = on.i
            exp.kind = VALUE_KIND.error_handler
            exp.number = ERRH_KIND.panic
            exp.set(VALUE_EXP.left, on)
            exp.set_end(p.pos.i)
            return exp
        }
        if p.word_is("!") {
            p.tok(true, false) !>
            let exp = p.create_exp(EXP.value)
            exp.i = on.i
            exp.kind = VALUE_KIND.error_handler
            exp.number = ERRH_KIND.block
            exp.set(VALUE_EXP.left, on)
            exp.set(VALUE_EXP.right, read_null_exit_body(p) !>)
            exp.set_end(p.pos.i)
            return exp
        }
        if p.word_is("->") {
            p.tok(true, false) !>
            return read_success_handler_exp(p, on) !>
        }
    }
    if t == TOK.word && p.word_is("_") {
        p.tok(true, false) !>
        let exp = p.create_exp(EXP.value)
        exp.i = on.i
        exp.kind = VALUE_KIND.error_handler
        exp.number = ERRH_KIND.ignore
        exp.set(VALUE_EXP.left, on)
        exp.set_end(p.pos.i)
        return exp
    }
    return null
}

// `call -> name { body }` / `call -> (a, b) { body }` / `call -> name : stmt`
fn read_success_handler_exp(p: Parser, on: Exp) Exp !Error {
    let exp = p.create_exp(EXP.value)
    exp.i = on.i
    exp.kind = VALUE_KIND.error_handler
    exp.number = ERRH_KIND.success
    exp.set(VALUE_EXP.left, on)

    let names = Array[String]{}
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is("(") {
        p.tok(true, true) !>
        while true {
            names.append(p.read_word(true, true) !>)
            t = p.tok(true, true, false) !>
            if t == TOK.sign && p.word_is(")") {
                p.tok(true, true) !>
                break
            }
            if t == TOK.sign && p.word_is(",") {
                p.tok(true, true) !>
                continue
            }
            p.error("Expected ',' or ')' in success-handler names, found: '" + p.word() + "'")
        }
    } else {
        // Optional single name; body may start with `{` or `:` without a name for void… but
        // old requires at least one return value + name. Keep name optional for parse then check later.
        if t == TOK.word {
            names.append(p.read_word(true, true) !>)
        }
    }
    exp.list = names
    exp.set(VALUE_EXP.right, read_then_body_exp(p) !>)
    exp.set_end(p.pos.i)
    return exp
}

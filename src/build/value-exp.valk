// Parse a value into a structured EXP.value expression tree.
// Exp.kind = VALUE_KIND; for op/unary, Exp.number = VALUE_OP.
//
// `allow_newline` — whether the expression may span lines (false for #if conditions).
// `allow_class_init` — whether `Type { fields }` may attach as a value postfix.
//   false for if/while/each conditions so `{` always starts the statement body.
//   Use parentheses to opt in: `if (Node { a: 1 }).ok { … }`.

fn read_value_exp(p: Parser, allow_newline: bool (false), allow_class_init: bool (true)) Exp !Error {
    return read_value_or(p, allow_newline, allow_class_init) !>
}

// Precedence (low → high): ||  &&  cmp  |  ^  &  <<>>  +-  */%  unary  postfix
//
// ||
fn read_value_or(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_and(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign || !p.word_is("||") : break
        p.tok(true, allow_newline) !>
        let right = read_value_and(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, VALUE_OP.or, right)
    }
    return left
}

// &&
fn read_value_and(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_cmp(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign || !p.word_is("&&") : break
        p.tok(true, allow_newline) !>
        let right = read_value_cmp(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, VALUE_OP.and, right)
    }
    return left
}

// == != < > <= >=
fn read_value_cmp(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_bit_or(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign : break
        let op: VALUE_OP = VALUE_OP.eq
        if p.word_is("==") : op = VALUE_OP.eq
        else if p.word_is("!=") : op = VALUE_OP.ne
        else if p.word_is("<=") : op = VALUE_OP.lte
        else if p.word_is(">=") : op = VALUE_OP.gte
        else if p.word_is("<") : op = VALUE_OP.lt
        else if p.word_is(">") : op = VALUE_OP.gt
        else : break
        p.tok(true, allow_newline) !>
        let right = read_value_bit_or(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, op, right)
    }
    return left
}

// |
fn read_value_bit_or(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_bit_xor(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign || !p.word_is("|") : break
        p.tok(true, allow_newline) !>
        let right = read_value_bit_xor(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, VALUE_OP.bit_or, right)
    }
    return left
}

// ^
fn read_value_bit_xor(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_bit_and(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign || !p.word_is("^") : break
        p.tok(true, allow_newline) !>
        let right = read_value_bit_and(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, VALUE_OP.bit_xor, right)
    }
    return left
}

// &
fn read_value_bit_and(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_shift(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign || !p.word_is("&") : break
        p.tok(true, allow_newline) !>
        let right = read_value_shift(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, VALUE_OP.bit_and, right)
    }
    return left
}

// << >>
fn read_value_shift(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_add(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign : break
        let op: VALUE_OP = VALUE_OP.shl
        if p.word_is("<<") : op = VALUE_OP.shl
        else if p.word_is(">>") : op = VALUE_OP.shr
        else : break
        p.tok(true, allow_newline) !>
        let right = read_value_add(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, op, right)
    }
    return left
}

// + -
fn read_value_add(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_mul(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign : break
        let op: VALUE_OP = VALUE_OP.add
        if p.word_is("+") : op = VALUE_OP.add
        else if p.word_is("-") : op = VALUE_OP.sub
        else : break
        p.tok(true, allow_newline) !>
        let right = read_value_mul(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, op, right)
    }
    return left
}

// * / %
fn read_value_mul(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_unary(p, allow_newline, allow_class_init) !>
    while true {
        let t = p.tok(true, allow_newline, false) !>
        if t != TOK.sign : break
        let op: VALUE_OP = VALUE_OP.mul
        if p.word_is("*") : op = VALUE_OP.mul
        else if p.word_is("/") : op = VALUE_OP.div
        else if p.word_is("%") : op = VALUE_OP.mod
        else : break
        p.tok(true, allow_newline) !>
        let right = read_value_unary(p, allow_newline, allow_class_init) !>
        left = make_value_op(p, left, op, right)
    }
    return left
}

// ! ~ - ++ -- (unary / prefix)
fn read_value_unary(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let t = p.tok(true, allow_newline, false) !>
    if t == TOK.sign && (p.word_is("++") || p.word_is("--")) {
        let is_incr = p.word_is("++")
        p.tok(true, allow_newline) !>
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        exp.kind = is_incr ? VALUE_KIND.incr : VALUE_KIND.decr
        exp.bool1 = true // prefix
        exp.set(VALUE_EXP.left, read_value_unary(p, allow_newline, allow_class_init) !>)
        exp.set_end(p.pos.i)
        return exp
    }
    if t == TOK.sign && p.word_is("!") {
        p.tok(true, allow_newline) !>
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        exp.kind = VALUE_KIND.unary
        exp.number = VALUE_OP.not
        let operand = read_value_unary(p, allow_newline, allow_class_init) !>
        exp.set(VALUE_EXP.left, operand)
        exp.set_end(p.pos.i)
        return exp
    }
    if t == TOK.sign && p.word_is("~") {
        p.tok(true, allow_newline) !>
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        exp.kind = VALUE_KIND.unary
        exp.number = VALUE_OP.bit_not
        let operand = read_value_unary(p, allow_newline, allow_class_init) !>
        exp.set(VALUE_EXP.left, operand)
        exp.set_end(p.pos.i)
        return exp
    }
    if t == TOK.sign && p.word_is("-") {
        // Unary minus only when followed by a number (same rule as the old parser)
        p.tok(true, allow_newline) !>
        let t2 = p.tok(false, false, false) !>
        if t2 == TOK.int || t2 == TOK.float || t2 == TOK.hex || t2 == TOK.octal {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 && p.pos.i >= p.word_len {
                exp.i = p.pos.i - p.word_len
            }
            exp.kind = VALUE_KIND.unary
            exp.number = VALUE_OP.neg
            let operand = read_value_primary(p, allow_newline) !>
            exp.set(VALUE_EXP.left, operand)
            exp.set_end(p.pos.i)
            return apply_value_postfix(p, exp, allow_class_init) !>
        }
        p.error("Expected a number after unary '-', found: '" + p.word() + "'")
    }
    return read_value_postfix(p, allow_newline, allow_class_init) !>
}

// Postfix: call / .name / ++ -- / optional class init
fn read_value_postfix(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let v = read_value_primary(p, allow_newline) !>
    return apply_value_postfix(p, v, allow_class_init) !>
}

// Attach `.member` / `.@cast(Type)` / `(args)` / `++` / `--` / `{ fields }` to a value.
// Class init only when `allow_class_init` (off for if/while conditions).
fn apply_value_postfix(p: Parser, v: Exp, allow_class_init: bool) Exp !Error {
    while true {
        // Tight postfix: no space before `(`, `.`, `++`, `--`
        let t = p.tok(false, false, false) !>
        if t == TOK.sign && p.word_is("(") {
            v = read_value_call(p, v) !>
            continue
        }
        if t == TOK.sign && (p.word_is("++") || p.word_is("--")) {
            let is_incr = p.word_is("++")
            p.tok(false, false) !>
            let exp = p.create_exp(EXP.value)
            exp.i = v.i
            exp.kind = is_incr ? VALUE_KIND.incr : VALUE_KIND.decr
            exp.bool1 = false // postfix
            exp.set(VALUE_EXP.left, v)
            exp.set_end(p.pos.i)
            v = exp
            continue
        }
        if t == TOK.sign && p.word_is(".") {
            p.tok(false, false) !>
            let tn = p.tok(false, false) !>
            if tn != TOK.word && tn != TOK.at_word && tn != TOK.flag {
                p.error("Expected property or method name after '.', found: '" + p.word() + "'")
            }
            if p.word_is("@cast") {
                p.expect("(", false, false) !>
                let exp = p.create_exp(EXP.value)
                exp.i = v.i
                exp.kind = VALUE_KIND.cast
                exp.set(VALUE_EXP.left, v)
                exp.set(VALUE_EXP.right, read_type_exp(p, true, true) !>)
                p.expect(")", true, true) !>
                exp.set_end(p.pos.i)
                v = exp
                continue
            }
            let name = p.word()
            let exp = p.create_exp(EXP.value)
            exp.i = v.i
            exp.kind = VALUE_KIND.dot
            exp.str1 = name
            exp.set(VALUE_EXP.left, v)
            exp.set_end(p.pos.i)
            v = exp
            continue
        }

        // Class init: space/newline allowed before `{` (e.g. `Node { … }`).
        // Disabled in statement conditions so `if x {` / `while x {` keep `{` as body.
        if allow_class_init {
            t = p.tok(true, true, false) !>
            if t == TOK.sign && p.word_is("{") {
                v = read_value_class_init(p, v) !>
                continue
            }
        }
        break
    }
    return v
}

// `Type { prop: value, … }` — left is the type/id expression already parsed.
// Field values always allow nested class init.
fn read_value_class_init(p: Parser, left: Exp) Exp !Error {
    p.expect("{", true, true) !>
    let exp = p.create_exp(EXP.value)
    exp.i = left.i
    exp.kind = VALUE_KIND.class_init
    exp.set(VALUE_EXP.left, left)

    let fields = p.create_exp(EXP.value)
    fields.kind = VALUE_KIND.multi
    let fi: uint = 0

    while true {
        let t = p.tok(true, true, false) !>
        if t == TOK.end : p.error("Unexpected end of file in class init, missing '}'")
        if t == TOK.sign && p.word_is("}") {
            p.tok(true, true) !>
            break
        }
        if t == TOK.comment {
            // Keep comments when formatting so they are not dropped from the AST
            if left.src.format {
                p.tok(true, true) !>
                fields.set(fi, read_comment_exp(p))
                fi++
            } else {
                p.tok(true, true) !>
            }
            continue
        }
        if t != TOK.word {
            p.error("Expected property name in class init, found: '" + p.word() + "'")
        }
        p.tok(true, true) !> // consume name
        let fname = p.word()
        p.expect(":", true, false) !>

        let field = p.create_exp(EXP.value)
        field.kind = VALUE_KIND.id // marker; str1 = prop name, left = value
        field.str1 = fname
        field.set(VALUE_EXP.left, read_value_exp(p, true, true) !>)
        fields.set(fi, field)
        fi++

        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is(",") {
            p.tok(true, true) !>
            continue
        }
        // Newline-separated fields: next prop name or `}`
    }

    exp.set(VALUE_EXP.right, fields)
    exp.set_end(p.pos.i)
    return exp
}

fn read_value_primary(p: Parser, allow_newline: bool) Exp !Error {
    let t = p.tok(true, allow_newline) !>

    // Error code: `.name` (used with throw / error payloads)
    if t == TOK.sign && p.word_is(".") {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        exp.kind = VALUE_KIND.error_code
        let tn = p.tok(false, false) !>
        if tn != TOK.word && tn != TOK.at_word {
            p.error("Expected error code name after '.', found: '" + p.word() + "'")
        }
        exp.str1 = p.word()
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.sign && p.word_is("(") {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        exp.kind = VALUE_KIND.paren
        // Inside `(…)` class init is always allowed (opt-in for conditions)
        exp.set(VALUE_EXP.left, read_value_exp(p, true, true) !>)
        p.expect(")", true, allow_newline) !>
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.int || t == TOK.float || t == TOK.hex || t == TOK.octal {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        if t == TOK.int : exp.kind = VALUE_KIND.number
        else if t == TOK.float : exp.kind = VALUE_KIND.float
        else if t == TOK.hex : exp.kind = VALUE_KIND.hex
        else : exp.kind = VALUE_KIND.octal
        exp.str1 = p.word()
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.string {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        exp.kind = VALUE_KIND.string
        exp.str1 = p.word()
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.char {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        exp.kind = VALUE_KIND.char
        exp.str1 = p.word()
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.word || t == TOK.at_word {
        if p.word_is("true") || p.word_is("false") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 && p.pos.i >= p.word_len {
                exp.i = p.pos.i - p.word_len
            }
            exp.kind = VALUE_KIND.bool
            exp.bool1 = p.word_is("true")
            exp.set_end(p.pos.i)
            return exp
        }
        if p.word_is("null") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 && p.pos.i >= p.word_len {
                exp.i = p.pos.i - p.word_len
            }
            exp.kind = VALUE_KIND.null
            exp.set_end(p.pos.i)
            return exp
        }
        if p.word_is("typeof") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 && p.pos.i >= p.word_len {
                exp.i = p.pos.i - p.word_len
            }
            exp.kind = VALUE_KIND.typeof
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.left, read_value_exp(p, true, true) !>)
            p.expect(")", true, allow_newline) !>
            exp.set_end(p.pos.i)
            return exp
        }

        if p.word_is("size_of") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 && p.pos.i >= p.word_len {
                exp.i = p.pos.i - p.word_len
            }
            exp.kind = VALUE_KIND.size_of
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.left, read_type_exp(p, true, true) !>)
            p.expect(")", true, allow_newline) !>
            exp.set_end(p.pos.i)
            return exp
        }

        // Identifier (optional ns:name) — VALUE_EXP.left → EXP.id
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 && p.pos.i >= p.word_len {
            exp.i = p.pos.i - p.word_len
        }
        exp.kind = VALUE_KIND.id
        let id = p.create_exp(EXP.id)
        id.i = exp.i
        id.str1 = p.word()
        let t2 = p.tok(false, false, false) !>
        if t2 == TOK.sign && p.word_is(":") {
            p.tok(false, false) !>
            id.str2 = id.str1
            id.str1 = p.read_word(false, false) !>
        }
        id.set_end(p.pos.i)
        exp.set(VALUE_EXP.left, id)
        exp.set_end(p.pos.i)
        return exp
    }

    if t == TOK.end || t == TOK.none {
        p.error("Expected a value expression")
    }
    p.error("Unexpected token in value expression: '" + p.word() + "'")
}

// Current token is `(` after a callee value. Build VALUE_KIND.call.
// Args always allow class init (`foo(Node { a: 1 })`).
fn read_value_call(p: Parser, callee: Exp) Exp !Error {
    p.expect("(", false, false) !>
    let exp = p.create_exp(EXP.value)
    exp.i = callee.i
    exp.kind = VALUE_KIND.call
    exp.set(VALUE_EXP.left, callee)

    let args = p.create_exp(EXP.value)
    args.kind = VALUE_KIND.multi
    let index: uint = 0
    let t = p.tok(true, true, false) !>
    if !(t == TOK.sign && p.word_is(")")) {
        while true {
            args.set(index++, read_value_exp(p, true, true) !>)
            t = p.tok(true, true, false) !>
            if t == TOK.sign && p.word_is(")") : break
            if t == TOK.sign && p.word_is(",") {
                p.tok(true, true) !>
                continue
            }
            p.error("Expected ',' or ')' in call arguments, found: '" + p.word() + "'")
        }
    }
    p.expect(")", true, true) !>
    args.set_end(p.pos.i)
    exp.set(VALUE_EXP.right, args)
    exp.set_end(p.pos.i)
    return exp
}

fn make_value_op(p: Parser, left: Exp, op: VALUE_OP, right: Exp) Exp {
    let exp = p.create_exp(EXP.value)
    exp.i = left.i
    exp.kind = VALUE_KIND.op
    exp.number = op
    exp.set(VALUE_EXP.left, left)
    exp.set(VALUE_EXP.right, right)
    exp.set_end(right.i + right.len)
    return exp
}

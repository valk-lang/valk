
////////////////////////////
// Precedence chain
////////////////////////////

fn read_value_exp(p: Parser, allow_newline: bool (false), allow_class_init: bool (true)) Exp !Error {
    // Lowest: ?? / ?! then ternary ? : then || …
    return read_value_null_ops(p, allow_newline, allow_class_init) !>
}

fn value_peek_token(p: Parser, allow_newline: bool) int !Error {
    let t = p.tok(true, allow_newline, false) !>
    while t == TOK.comment {
        if !allow_newline : break
        p.tok(true, true) !>
        t = p.tok(true, true, false) !>
    }
    return t
}

fn read_value_null_ops(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_ternary(p, allow_newline, allow_class_init) !>
    while true {
        let t = value_peek_token(p, allow_newline) !>
        if t != TOK.sign : break
        if p.word_is("??") {
            p.tok(true, allow_newline) !>
            let right = read_value_null_ops(p, allow_newline, allow_class_init) !>
            let exp = p.create_exp(EXP.value)
            exp.i = left.i
            exp.kind = VALUE_KIND.null_coalesce
            exp.set(VALUE_EXP.left, left)
            exp.set(VALUE_EXP.right, right)
            exp.set_end(p.token_end)
            left = exp
            continue
        }
        if p.word_is("?!") {
            p.tok(true, allow_newline) !>
            let body = read_null_exit_body(p) !>
            let exp = p.create_exp(EXP.value)
            exp.i = left.i
            exp.kind = VALUE_KIND.null_exit
            exp.set(VALUE_EXP.left, left)
            exp.set(VALUE_EXP.right, body)
            exp.set_end(p.token_end)
            left = exp
            continue
        }
        break
    }
    return left
}

// cond ? then : else  (right-associative via full recursive then/else)
fn read_value_ternary(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_binary(p, PREC_OR, allow_newline, allow_class_init) !>
    let t = value_peek_token(p, allow_newline) !>
    // Bare `?` only (not `??` / `?!` — those are multi-char tokens)
    if t == TOK.sign && p.word_is("?") {
        p.tok(true, allow_newline) !>
        let then_exp = read_value_exp(p, allow_newline, allow_class_init) !>
        p.expect(":", true, allow_newline) !>
        let else_exp = read_value_exp(p, allow_newline, allow_class_init) !>
        let exp = p.create_exp(EXP.value)
        exp.i = left.i
        exp.kind = VALUE_KIND.ternary
        exp.set(VALUE_EXP.left, left)
        exp.set(VALUE_EXP.right, then_exp)
        exp.set(VALUE_EXP.third, else_exp)
        exp.set_end(p.token_end)
        return exp
    }
    return left
}

// Binary operator precedence, from the loosest (`||`) to the tightest (`* / %`).
// `read_value_binary` climbs these in one loop instead of one call per level.
value PREC_OR (1)
value PREC_AND (2)
value PREC_CMP (3)
value PREC_BIT_OR (4)
value PREC_BIT_XOR (5)
value PREC_BIT_AND (6)
value PREC_SHIFT (7)
value PREC_ADD (8)
value PREC_MUL (9)

// Return `(precedence << 8) | VALUE_OP`, or 0 when the current safe token is
// not a binary operator.
fn value_binary_op(p: Parser) uint {
    if p.word_is("||") : return (PREC_OR << 8) | VALUE_OP.or
    if p.word_is("&&") : return (PREC_AND << 8) | VALUE_OP.and
    if p.word_is("==") : return (PREC_CMP << 8) | VALUE_OP.eq
    if p.word_is("!=") : return (PREC_CMP << 8) | VALUE_OP.ne
    if p.word_is("<=") : return (PREC_CMP << 8) | VALUE_OP.lte
    if p.word_is(">=") : return (PREC_CMP << 8) | VALUE_OP.gte
    if p.word_is("<") : return (PREC_CMP << 8) | VALUE_OP.lt
    if p.word_is(">") : return (PREC_CMP << 8) | VALUE_OP.gt
    if p.word_is("|") : return (PREC_BIT_OR << 8) | VALUE_OP.bit_or
    if p.word_is("^") : return (PREC_BIT_XOR << 8) | VALUE_OP.bit_xor
    if p.word_is("&") : return (PREC_BIT_AND << 8) | VALUE_OP.bit_and
    if p.word_is("<<") : return (PREC_SHIFT << 8) | VALUE_OP.shl
    if p.word_is(">>") : return (PREC_SHIFT << 8) | VALUE_OP.shr
    if p.word_is("+") : return (PREC_ADD << 8) | VALUE_OP.add
    if p.word_is("-") : return (PREC_ADD << 8) | VALUE_OP.sub
    if p.word_is("*") : return (PREC_MUL << 8) | VALUE_OP.mul
    if p.word_is("/") : return (PREC_MUL << 8) | VALUE_OP.div
    if p.word_is("%") : return (PREC_MUL << 8) | VALUE_OP.mod
    return 0
}

// || && == != < > <= >= | ^ & << >> + - * / %  (all left associative)
fn read_value_binary(p: Parser, min_prec: uint, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let left = read_value_unary(p, allow_newline, allow_class_init) !>
    while true {
        let t = value_peek_token(p, allow_newline) !>
        if t != TOK.sign : break
        let found = value_binary_op(p)
        if found == 0 : break
        let prec = found >> 8
        if prec < min_prec : break
        p.tok(true, allow_newline) !>
        let right = read_value_binary(p, prec + 1, allow_newline, allow_class_init) !>
        let op = found & 0xff
        left = make_value_op(p, left, op.@cast(VALUE_OP), right)
    }
    return left
}

// ! ~ - ++ -- (unary / prefix)
fn read_value_unary(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let t = value_peek_token(p, allow_newline) !>
    if t == TOK.sign && (p.word_is("++") || p.word_is("--")) {
        let is_incr = p.word_is("++")
        p.tok(true, allow_newline) !>
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = is_incr ? VALUE_KIND.incr : VALUE_KIND.decr
        exp.bool1 = true // prefix
        exp.set(VALUE_EXP.left, read_value_unary(p, allow_newline, allow_class_init) !>)
        exp.set_end(p.token_end)
        return exp
    }
    if t == TOK.sign && p.word_is("!") {
        p.tok(true, allow_newline) !>
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.unary
        exp.number = VALUE_OP.not
        let operand = read_value_unary(p, allow_newline, allow_class_init) !>
        exp.set(VALUE_EXP.left, operand)
        exp.set_end(p.token_end)
        return exp
    }
    if t == TOK.sign && p.word_is("~") {
        p.tok(true, allow_newline) !>
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.unary
        exp.number = VALUE_OP.bit_not
        let operand = read_value_unary(p, allow_newline, allow_class_init) !>
        exp.set(VALUE_EXP.left, operand)
        exp.set_end(p.token_end)
        return exp
    }
    if t == TOK.sign && p.word_is("&") {
        // Address-of: `&lvalue` → &T (distinct from `@ref(lvalue)`, which yields raw ptr)
        p.tok(true, allow_newline) !>
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.unary
        exp.number = VALUE_OP.ref_of
        let operand = read_value_unary(p, allow_newline, allow_class_init) !>
        exp.set(VALUE_EXP.left, operand)
        exp.set_end(p.token_end)
        return exp
    }
    if t == TOK.sign && p.word_is("-") {
        p.tok(true, allow_newline) !>
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.unary
        exp.number = VALUE_OP.neg
        exp.set(VALUE_EXP.left, read_value_unary(p, allow_newline, allow_class_init) !>)
        exp.set_end(p.token_end)
        return exp
    }
    return read_value_postfix(p, allow_newline, allow_class_init) !>
}

////////////////////////////
// Postfix
////////////////////////////

// Postfix: call / .name / ++ -- / optional class init
fn read_value_postfix(p: Parser, allow_newline: bool, allow_class_init: bool) Exp !Error {
    let v = read_value_primary(p, allow_newline) !>
    return apply_value_postfix(p, v, allow_class_init) !>
}

fn apply_value_postfix(p: Parser, v: Exp, allow_class_init: bool) Exp !Error {
    while true {
        // Tight postfix: no space before `(`, `.`, `[`, `++`, `--`
        let t = p.tok(false, false, false) !>
        if t == TOK.sign && p.word_is("(") {
            v = read_value_call(p, v) !>
            // Optional error handler immediately after the call (space ok, newline not)
            let handled = try_read_error_handler(p, v) !>
            if isset(handled) : v = handled
            continue
        }
        if t == TOK.sign && p.word_is("[") {
            v = read_value_offset(p, v) !>
            // Optional error handler immediately after the offset (space ok, newline not)
            let handled = try_read_error_handler(p, v) !>
            if isset(handled) : v = handled
            continue
        }
        if t == TOK.sign && (p.word_is("++") || p.word_is("--")) {
            let is_incr = p.word_is("++")
            p.tok(false, false) !>
            let exp = p.create_exp(EXP.value)
            exp.i = v.i
            exp.kind = is_incr ? VALUE_KIND.incr : VALUE_KIND.decr
            exp.bool1 = false // postfix
            exp.set(VALUE_EXP.left, v)
            exp.set_end(p.token_end)
            v = exp
            continue
        }
        if t == TOK.sign && p.word_is(".") {
            p.tok(false, false) !>
            // End of the dot itself, which is where a completion cursor sits
            let after_dot = p.pos.i
            let tn = p.tok(false, false) !>
            if tn != TOK.word && tn != TOK.at_word && tn != TOK.flag {
                if lsp_completion_at(p.pos.src, after_dot) {
                    let exp = p.create_exp(EXP.value)
                    exp.i = v.i
                    exp.kind = VALUE_KIND.dot
                    exp.str1 = ""
                    exp.set(VALUE_EXP.left, v)
                    exp.set_end(after_dot)
                    return exp
                }
                p.error("Expected property or method name after '.', found: '" + p.word() + "'")
            }
            if p.word_is("@cast") {
                p.expect("(", false, false) !>
                let exp = p.create_exp(EXP.value)
                exp.i = v.i
                exp.kind = VALUE_KIND.cast
                exp.set(VALUE_EXP.left, v)
                exp.set(VALUE_EXP.right, read_type_exp(p, true, true) !>)
                p.expect(")", true, true) !>
                exp.set_end(p.token_end)
                v = exp
                continue
            }
            let name = p.word()
            let exp = p.create_exp(EXP.value)
            exp.i = v.i
            exp.kind = VALUE_KIND.dot
            exp.str1 = name
            exp.set(VALUE_EXP.left, v)
            exp.set_end(p.token_end)
            v = exp
            // A property getter may be fallible, just like an explicit call.
            let handled = try_read_error_handler(p, v) !>
            if isset(handled) : v = handled
            continue
        }

        if allow_class_init {
            t = p.tok(true, false, false) !>
            if t == TOK.sign && p.word_is("{") {
                v = read_value_class_init(p, v) !>
                continue
            }
        }
        break
    }
    return v
}

fn read_value_offset(p: Parser, left: Exp) Exp !Error {
    p.expect("[", false, false) !>
    let exp = p.create_exp(EXP.value)
    exp.i = left.i
    exp.kind = VALUE_KIND.offset
    exp.set(VALUE_EXP.left, left)
    exp.set(VALUE_EXP.right, read_body_exp(p, "[", "]") !>)
    exp.set_end(p.token_end)
    return exp
}

////////////////////////////
// Initializers
////////////////////////////

fn read_value_class_init(p: Parser, left: Exp) Exp !Error {
    p.expect("{", true, true) !>
    let exp = p.create_exp(EXP.value)
    exp.i = left.i
    exp.kind = VALUE_KIND.class_init
    exp.set(VALUE_EXP.left, left)
    exp.set(VALUE_EXP.right, read_body_exp(p, "{", "}") !>)
    exp.set_end(p.token_end)
    return exp
}

fn read_value_func_lit_exp(p: Parser) Exp !Error {
    let exp = p.create_exp(EXP.value)
    if p.word_len > 0 {
        exp.i = p.word_i
    }
    exp.kind = VALUE_KIND.func_lit

    // Arguments body () — required
    p.expect("(", true, false) !>
    exp.set(FUNC_LIT_EXP.args, read_body_exp(p, "(", ")") !>)

    let t = p.tok(true, true, false) !>
    if !(t == TOK.sign && (p.word_is("{") || p.word_is("!"))) {
        exp.set(FUNC_LIT_EXP.type, read_type_exp(p) !>)
        t = p.tok(true, true, false) !>
    }

    // Optional error type: !ErrorName
    if t == TOK.sign && p.word_is("!") {
        p.tok(true, true) !>
        exp.set(FUNC_LIT_EXP.error, p.read_id(false, false) !>)
        t = p.tok(true, true, false) !>
    }

    if t == TOK.sign && p.word_is("{") {
        p.tok(true, true) !>
        exp.set(FUNC_LIT_EXP.body, read_body_exp(p, "{", "}") !>)
    } else {
        p.error("Expected '{' after function literal signature, found: '" + p.word() + "'")
    }
    exp.set_end(p.token_end)
    return exp
}

fn read_value_inline_init(p: Parser, contextual: bool (false)) Exp !Error {
    let exp = p.create_exp(EXP.value)
    if p.word_len > 0 {
        exp.i = p.word_i
    }
    exp.kind = VALUE_KIND.class_init
    exp.bool1 = contextual
    // No left — type from the suggestion at lower
    exp.set(VALUE_EXP.right, read_body_exp(p, "{", "}") !>)
    exp.set_end(p.token_end)
    return exp
}

fn read_init_item_start(p: Parser, what: String) bool !Error {
    while true {
        let t = p.tok(true, true, false) !>
        if t == TOK.end : p.error("Unexpected end of file in " + what + ", missing '}'")
        if t == TOK.sign && p.word_is("}") {
            p.tok(true, true) !>
            return false
        }
        if t == TOK.comment {
            p.tok(true, true) !>
            continue
        }
        if t == TOK.sign && p.word_is(",") {
            p.error("Empty item in " + what)
        }
        return true
    }
}

fn read_class_init_fields(p: Parser) Exp !Error {
    let fields = p.create_exp(EXP.value)
    fields.kind = VALUE_KIND.multi
    let fi : uint = 0

    while true {
        if !(read_init_item_start(p, "class init") !>) : break
        let t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is("#") {
            p.tok(true, true) !>
            fields.set(fi, read_macro_exp(p) !>)
            fi++
            continue
        }

        // Field: bare `name:` (peek with a throwaway parser so we don't consume a value start)
        if class_init_starts_with_field(p) !> {
            p.tok(true, true) !> // name
            let fname = p.word()
            let name_i = p.word_i
            p.expect(":", true, false) !>
            let field = p.create_exp(EXP.value)
            field.i = name_i
            field.kind = VALUE_KIND.id
            field.number = CLASS_INIT_ITEM.field
            field.bool2 = true // formatter: this is a class-init item
            field.str1 = fname
            field.set(VALUE_EXP.left, read_value_exp(p, false, true) !>)
            field.set_end(p.token_end)
            fields.set(fi, field)
            fi++
        } else {
            let val = read_value_exp(p, true, true) !>
            fields.set(fi, read_class_init_value_or_pair(p, val) !>)
            fi++
        }

        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is(",") {
            p.tok(true, true) !>
            continue
        }
        // Newline-separated items
    }
    return fields
}

// True when next tokens are `name :` (property field), not a value expression.
fn class_init_starts_with_field(p: Parser) bool !Error {
    let sub = p.pos.copy().init_parser()
    let t = sub.tok(true, true, false) !>
    if t != TOK.word && t != TOK.at_word : return false
    sub.tok(true, true) !> // consume name
    // `:` on the same logical item — allow space, not typically newline for fields
    let t2 = sub.tok(true, false, false) !>
    return t2 == TOK.sign && sub.word_is(":")
}

// After a value: `=> right` → pair, else element.
fn read_class_init_value_or_pair(p: Parser, left: Exp) Exp !Error {
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is("=>") {
        p.tok(true, true) !>
        let item = p.create_exp(EXP.value)
        item.i = left.i
        item.kind = VALUE_KIND.multi
        item.number = CLASS_INIT_ITEM.pair
        item.bool2 = true // formatter: this is a class-init item
        item.set(VALUE_EXP.left, left)
        item.set(VALUE_EXP.right, read_value_exp(p, false, true) !>)
        item.set_end(p.token_end)
        return item
    }
    let item = p.create_exp(EXP.value)
    item.i = left.i
    item.kind = VALUE_KIND.multi
    item.number = CLASS_INIT_ITEM.elem
    item.bool2 = true // formatter: this is a class-init item
    item.set(VALUE_EXP.left, left)
    item.set_end(p.token_end)
    return item
}

// After `{` already consumed: parse positional values until `}`.
fn read_array_init_elements(p: Parser) Exp !Error {
    let elems = p.create_exp(EXP.value)
    elems.kind = VALUE_KIND.multi
    let ei : uint = 0

    while true {
        if !(read_init_item_start(p, "array init") !>) : break
        let t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is("...") {
            let repeat = p.create_exp(EXP.value)
            repeat.kind = VALUE_KIND.repeat
            p.tok(true, true) !>
            repeat.set_end(p.token_end)
            elems.set(ei, repeat)
            ei++
            continue
        }

        elems.set(ei, read_value_exp(p, true, true) !>)
        ei++

        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is(",") {
            p.tok(true, true) !>
            let next = p.tok(true, true, false) !>
            if next == TOK.sign && p.word_is("}") {
                p.error("Trailing comma in array init")
            }
            continue
        }
        // Newline-separated elements
    }
    return elems
}

////////////////////////////
// Primary values
////////////////////////////

fn read_value_primary(p: Parser, allow_newline: bool) Exp !Error {
    let t = p.tok(true, allow_newline) !>

    // Explicit typed value: `T { ... }`.
    if t == TOK.sign && p.word_is("<") {
        let type_exp = p.create_exp(EXP.type)
        if p.word_len > 0 : type_exp.i = p.word_i
        finish_inline_type(p, type_exp) !>

        p.expect("{", true, true) !>
        let exp = p.create_exp(EXP.value)
        exp.i = type_exp.i
        exp.kind = VALUE_KIND.class_init
        exp.set(VALUE_EXP.left, type_exp)
        exp.set(VALUE_EXP.right, read_body_exp(p, "{", "}") !>)
        exp.set_end(p.token_end)
        return exp
    }

    // Explicit fixed inline sequence value: `[T x N]{ ... }`.
    if t == TOK.sign && p.word_is("[") {
        let type_exp = p.create_exp(EXP.type)
        if p.word_len > 0 : type_exp.i = p.word_i
        type_exp.bool2 = true
        finish_sequence_type(p, type_exp, TYPE_KIND.fixed_array) !>

        p.expect("{", true, true) !>
        let exp = p.create_exp(EXP.value)
        exp.i = type_exp.i
        exp.kind = VALUE_KIND.class_init
        exp.set(VALUE_EXP.left, type_exp)
        exp.set(VALUE_EXP.right, read_body_exp(p, "{", "}") !>)
        exp.set_end(p.token_end)
        return exp
    }

    // `.{ … }` — contextual initializer expression.
    if t == TOK.sign && p.word_is(".") {
        let i0 = p.word_i
        let tn0 = p.tok(false, false) !>
        if tn0 == TOK.sign && p.word_is("{") {
            let exp = read_value_inline_init(p, true) !>
            exp.i = i0
            return exp
        }

        // Error code: `.name` (used with throw / error payloads)
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = i0
        }
        exp.kind = VALUE_KIND.error_code
        if tn0 != TOK.word && tn0 != TOK.at_word {
            p.error("Expected error code name after '.', found: '" + p.word() + "'")
        }
        exp.str1 = p.word()
        exp.set_end(p.token_end)
        return exp
    }

    if t == TOK.sign && p.word_is("(") {
        // `(value)` grouping or `(a, b, …)` multi-value
        let first = read_value_exp(p, true, true) !>
        let t2 = p.tok(true, true, false) !>
        if t2 == TOK.sign && p.word_is(",") {
            // Multi-value: (a, b, …)
            let multi = p.create_exp(EXP.value)
            if p.word_len > 0 {
                multi.i = first.i
            }
            multi.kind = VALUE_KIND.multi
            multi.set(0, first)
            let mi : uint = 1
            while true {
                p.tok(true, true) !> // consume `,`
                t2 = p.tok(true, true, false) !>
                if t2 == TOK.sign && p.word_is(")") {
                    p.error("Trailing comma in multi-value expression")
                }
                if t2 == TOK.sign && p.word_is(",") {
                    p.error("Empty item in multi-value expression")
                }
                multi.set(mi, read_value_exp(p, true, true) !>)
                mi++
                t2 = p.tok(true, true, false) !>
                if t2 == TOK.sign && p.word_is(",") : continue
                if t2 == TOK.sign && p.word_is(")") {
                    p.tok(true, true) !>
                    break
                }
                p.error("Expected ',' or ')' in multi-value expression, found: '" + p.word() + "'")
            }
            multi.set_end(p.token_end)
            return multi
        }
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = first.i
        }
        exp.kind = VALUE_KIND.paren
        // Inside `(…)` class init is always allowed (opt-in for conditions)
        exp.set(VALUE_EXP.left, first)
        p.expect(")", true, allow_newline) !>
        exp.set_end(p.token_end)
        return exp
    }

    // Value scope: `<{ ... }`
    if t == TOK.sign && p.word_is("<{") {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.vscope
        // Opener `<{` already consumed; capture interior until matching `}`
        exp.set(VALUE_EXP.left, read_body_exp(p, "{", "}") !>)
        exp.set_end(p.token_end)
        return exp
    }

    // Bare `{ fields }` / `{ elems }` — direct-destination initializer shorthand.
    if t == TOK.sign && p.word_is("{") {
        return read_value_inline_init(p) !>
    }

    // `#embed("path")` / `#embed_dir("path")` — compile-time file embedding
    if t == TOK.sign && p.word_is("#") {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        // Macro-name word immediately after `#` (no space), same convention as #if/#end
        let tn = p.tok(false, false) !>
        if tn != TOK.word {
            p.error("Expected 'embed' or 'embed_dir' after '#', found: '" + p.word() + "'")
        }
        if p.word_is("embed") {
            exp.kind = VALUE_KIND.embed
        } else if p.word_is("embed_dir") {
            exp.kind = VALUE_KIND.embed_dir
        } else {
            p.error("Unknown compile-time value macro: '#" + p.word() + "'")
        }
        p.expect("(", false, false) !>
        let t2 = p.tok(true, false) !>
        if t2 != TOK.string {
            p.error("Expected a string path, found: '" + p.word() + "'")
        }
        exp.str1 = strip_quotes(p.word())
        p.expect(")", true, allow_newline) !>
        exp.set_end(p.token_end)
        return exp
    }

    if t == TOK.int || t == TOK.float || t == TOK.hex || t == TOK.octal {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        if t == TOK.int : exp.kind = VALUE_KIND.number
        else if t == TOK.float : exp.kind = VALUE_KIND.float
        else if t == TOK.hex : exp.kind = VALUE_KIND.hex
        else : exp.kind = VALUE_KIND.octal
        exp.str1 = p.word()
        exp.set_end(p.token_end)
        return exp
    }

    if t == TOK.string {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.string
        exp.str1 = p.word()
        exp.set_end(p.token_end)
        return exp
    }

    if t == TOK.char {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.char
        exp.str1 = p.word()
        exp.set_end(p.token_end)
        return exp
    }

    // `$clone(value)` — deep-copy intrinsic (see VALUE_KIND.clone).
    if t == TOK.flag && p.word_is("$clone") {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 : exp.i = p.word_i
        exp.kind = VALUE_KIND.clone
        p.expect("(", false, false) !>
        exp.set(VALUE_EXP.left, read_value_exp(p, true, true) !>)
        p.expect(")", true, allow_newline) !>
        exp.set_end(p.token_end)
        return exp
    }

    // `$hash(value)` — hash intrinsic used by HashMap keys (see VALUE_KIND.hash).
    if t == TOK.flag && p.word_is("$hash") {
        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 : exp.i = p.word_i
        exp.kind = VALUE_KIND.hash
        p.expect("(", false, false) !>
        exp.set(VALUE_EXP.left, read_value_exp(p, true, true) !>)
        p.expect(")", true, allow_newline) !>
        exp.set_end(p.token_end)
        return exp
    }

    if t == TOK.word || t == TOK.at_word {
        if t == TOK.word && p.word_is("_") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 : exp.i = p.word_i
            exp.kind = VALUE_KIND.noop
            exp.set_end(p.token_end)
            return exp
        }
        if t == TOK.at_word && p.word_is("@undefined") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 : exp.i = p.word_i
            exp.kind = VALUE_KIND.undefined
            exp.set_end(p.token_end)
            return exp
        }
        if t == TOK.at_word && p.word_is("@memcpy") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 : exp.i = p.word_i
            exp.kind = VALUE_KIND.memcpy
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.right, read_body_exp(p, "(", ")") !>)
            exp.set_end(p.token_end)
            return exp
        }

        if t == TOK.word && p.word_is("r") {
            let raw_i = p.word_i
            let sub = p.pos.copy().init_parser()
            let next = sub.tok(false, false, false) !>
            if next == TOK.string {
                p.tok(false, false) !>
                let exp = p.create_exp(EXP.value)
                exp.i = raw_i
                exp.kind = VALUE_KIND.string
                exp.bool1 = true
                exp.str1 = p.word()
                exp.set_end(p.token_end)
                return exp
            }
        }

        if t == TOK.word && p.word_is("match") {
            return read_match_exp(p) !>
        }

        // Builtins with fixed arg shapes: capture `(...)` body; re-parse at lower.
        if t == TOK.at_word && p.word_is("@ptrv") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
                exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.ptrv
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.right, read_body_exp(p, "(", ")") !>)
            exp.set_end(p.token_end)
            return exp
        }
        if t == TOK.at_word && p.word_is("@ref") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
                exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.ref_of
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.right, read_body_exp(p, "(", ")") !>)
            exp.set_end(p.token_end)
            return exp
        }

        if p.word_is("fn") && p.next_word_is("(", true, false, false) !> {
            return read_value_func_lit_exp(p) !>
        }

        if p.word_is("true") || p.word_is("false") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
                exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.bool
            exp.bool1 = p.word_is("true")
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("null") {
            // `null` or `null[Type]` (explicit type when no suggested type)
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
                exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.null
            // Optional `null[Type]` — no space between `null` and `[` (same as old)
            if p.next_word_is("[", false, false, true) !> {
                exp.set(VALUE_EXP.left, read_type_exp(p, true, true) !>)
                p.expect("]", true, true) !>
            }
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("typeof") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
                exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.typeof
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.left, read_value_exp(p, true, true) !>)
            p.expect(")", true, allow_newline) !>
            exp.set_end(p.token_end)
            return exp
        }

        if p.word_is("size_of") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
                exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.size_of
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.left, read_type_exp(p, true, true) !>)
            p.expect(")", true, allow_newline) !>
            exp.set_end(p.token_end)
            return exp
        }

        if p.word_is("isset") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
                exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.isset
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.left, read_value_exp(p, true, true) !>)
            p.expect(")", true, allow_newline) !>
            exp.set_end(p.token_end)
            return exp
        }

        if p.word_is("is_defined") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 : exp.i = p.word_i
            exp.kind = VALUE_KIND.is_defined
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.left, p.read_id(true, true) !>)
            p.expect(")", true, allow_newline) !>
            exp.set_end(p.token_end)
            return exp
        }

        // `co <call>` — launch a coroutine from a function-call expression
        if p.word_is("co") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
                exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.co
            exp.set(VALUE_EXP.left, read_value_unary(p, allow_newline, true) !>)
            exp.set_end(p.token_end)
            return exp
        }

        // `await <task>` — optionally followed by an error-handler suffix, same as a call
        if p.word_is("await") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
                exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.await
            exp.set(VALUE_EXP.left, read_value_unary(p, allow_newline, true) !>)
            exp.set_end(p.token_end)
            let handled = try_read_error_handler(p, exp) !>
            if isset(handled) : return handled
            return exp
        }

        // `error_is(code, name, name, ...)` — bare-word code-name comparison builtin
        if p.word_is("error_is") {
            let exp = p.create_exp(EXP.value)
            if p.word_len > 0 {
                exp.i = p.word_i
            }
            exp.kind = VALUE_KIND.error_is
            p.expect("(", false, false) !>
            exp.set(VALUE_EXP.left, read_value_exp(p, true, true) !>)
            let names = Array[String]{}
            p.expect(",", true, true) !>
            while true {
                let next = p.tok(true, true, false) !>
                if next == TOK.sign && p.word_is(")") {
                    p.error("'error_is' expects an error code name after ','")
                }
                if next == TOK.sign && p.word_is(",") {
                    p.error("Empty item in error_is arguments")
                }
                names.append(p.read_word(true, true) !>)
                if !(read_comma_list_next(p, ")", "error_is arguments") !>) : break
            }
            if names.length == 0 {
                p.error("'error_is' expects at least one error code name")
            }
            exp.list = names
            exp.set_end(p.token_end)
            return exp
        }

        let exp = p.create_exp(EXP.value)
        if p.word_len > 0 {
            exp.i = p.word_i
        }
        exp.kind = VALUE_KIND.id
        let id = p.create_exp(EXP.id)
        id.i = exp.i
        id.str1 = p.word()
        id.set_end(p.token_end)
        exp.set(VALUE_EXP.left, id)
        exp.set_end(p.token_end)
        return exp
    }

    if t == TOK.end || t == TOK.none {
        p.error("Expected a value expression")
    }
    p.error("Unexpected token in value expression: '" + p.word() + "'")
}

fn read_match_exp(p: Parser) Exp !Error {
    let exp = p.create_exp(EXP.value)
    exp.i = p.word_i
    exp.kind = VALUE_KIND.match

    exp.set(MATCH_EXP.on, read_value_exp(p, true, false) !>)
    let t = p.tok(true, false, false) !>
    if t == TOK.sign && p.word_is(":") {
        p.tok(true, false) !>
        exp.set(MATCH_EXP.type, read_type_exp(p, true, true) !>)
    }
    p.expect("{", true, true) !>
    exp.set(MATCH_EXP.body, read_body_exp(p, "{", "}") !>)
    exp.set_end(p.token_end)
    return exp
}

////////////////////////////
// Calls and error handlers
////////////////////////////

fn read_value_call(p: Parser, callee: Exp) Exp !Error {
    p.expect("(", false, false) !>
    let exp = p.create_exp(EXP.value)
    exp.i = callee.i
    exp.kind = VALUE_KIND.call
    exp.set(VALUE_EXP.left, callee)

    let args = p.create_exp(EXP.value)
    args.kind = VALUE_KIND.multi
    let index : uint = 0
    let t = p.tok(true, true, false) !>
    if !(t == TOK.sign && p.word_is(")")) {
        while true {
            args.set(index++, read_value_exp(p, true, true) !>)
            if !(read_comma_list_next(p, ")", "call arguments") !>) : break
        }
    } else {
        p.tok(true, true) !>
    }
    args.set_end(p.token_end)
    exp.set(VALUE_EXP.right, args)
    exp.set_end(p.token_end)
    return exp
}

fn make_value_op(p: Parser, left: Exp, op: VALUE_OP, right: Exp) Exp {
    let exp = p.create_exp(EXP.value)
    exp.i = left.i
    exp.kind = VALUE_KIND.op
    exp.number = op
    exp.set(VALUE_EXP.left, left)
    exp.set(VALUE_EXP.right, right)
    exp.set_end(right.i + right.len)
    return exp
}

// Body after `?!` or `!` error handler: `{ ... }` or a single statement.
fn read_null_exit_body(p: Parser) Exp !Error {
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is("{") {
        return read_block_exp(p) !>
    }
    // Single statement (must exit: return / throw / break / continue / exit)
    let exp = p.create_exp(EXP.block)
    exp.bool1 = true // single-statement form
    let stmt = read_func_stmt_exp(p) !>
    exp.body_exps = Array[Exp]{stmt}
    exp.i = stmt.i
    exp.set_end(p.token_end)
    return exp
}

fn try_read_error_handler(p: Parser, on: Exp) ?Exp !Error {
    let t = p.tok(true, false, false) !>
    if t == TOK.sign {
        if p.word_is("!?") {
            p.tok(true, false) !>
            let exp = p.create_exp(EXP.value)
            exp.i = on.i
            exp.kind = VALUE_KIND.error_handler
            exp.number = ERRH_KIND.value
            exp.set(VALUE_EXP.left, on)
            exp.set(VALUE_EXP.right, read_value_exp(p, true, true) !>)
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("!>") {
            p.tok(true, false) !>
            let exp = p.create_exp(EXP.value)
            exp.i = on.i
            exp.kind = VALUE_KIND.error_handler
            exp.number = ERRH_KIND.pass
            exp.set(VALUE_EXP.left, on)
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("!!") {
            p.tok(true, false) !>
            let exp = p.create_exp(EXP.value)
            exp.i = on.i
            exp.kind = VALUE_KIND.error_handler
            exp.number = ERRH_KIND.panic
            exp.set(VALUE_EXP.left, on)
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("!") {
            p.tok(true, false) !>
            let exp = p.create_exp(EXP.value)
            exp.i = on.i
            exp.kind = VALUE_KIND.error_handler
            exp.number = ERRH_KIND.block
            exp.set(VALUE_EXP.left, on)
            exp.set(VALUE_EXP.right, read_null_exit_body(p) !>)
            exp.set_end(p.token_end)
            return exp
        }
        if p.word_is("->") {
            p.tok(true, false) !>
            return read_success_handler_exp(p, on) !>
        }
    }
    if t == TOK.word && p.word_is("_") {
        p.tok(true, false) !>
        let exp = p.create_exp(EXP.value)
        exp.i = on.i
        exp.kind = VALUE_KIND.error_handler
        exp.number = ERRH_KIND.ignore
        exp.set(VALUE_EXP.left, on)
        exp.set_end(p.token_end)
        return exp
    }
    return null
}

// `call -> name { body }` / `call -> (a, b) { body }` / `call -> name : stmt`
fn read_success_handler_exp(p: Parser, on: Exp) Exp !Error {
    let exp = p.create_exp(EXP.value)
    exp.i = on.i
    exp.kind = VALUE_KIND.error_handler
    exp.number = ERRH_KIND.success
    exp.set(VALUE_EXP.left, on)

    let names = Array[String]{}
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is("(") {
        p.tok(true, true) !>
        while true {
            names.append(p.read_word(true, true) !>)
            if !(read_comma_list_next(p, ")", "success-handler names") !>) : break
        }
    } else {
        if t == TOK.word {
            names.append(p.read_word(true, true) !>)
        }
    }
    exp.list = names
    exp.set(VALUE_EXP.right, read_then_body_exp(p) !>)
    exp.set_end(p.token_end)
    return exp
}

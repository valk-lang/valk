// Declaration macro: `macro name scope(...) <{...}> | {...}`
// Class macros are also stored on Class.macros keyed by the first pattern token.
class Macro {
    name: String
    act: ACT
    exp: Exp
    // Pattern + output still raw EXP (expansion is a later stage)
    pattern: ?Exp (null) // EXP.macro_scope
    output: ?Exp (null)  // EXP.body
    // true when output is `<{...}>` (value/vscope form)
    is_value: bool (false)
    // true when defined inside a class body
    is_class_macro: bool (false)
    class: ?Class (null)
    // Scope for captures / expansion
    scope: Scope
}

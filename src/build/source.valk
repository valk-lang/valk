use valk.fs

class Source {
    build: Build
    content: String
    path: ?String (null)
    parent: ?Source (null)
    parent_offset: u32 (0)
    ns: ?Namespace (null)
    id: uint (0)
    // Set by top-level `@ignore_access` — access checks are skipped for this file
    ignore_access: bool (false)
    skipped_code: bool (false)
    // Byte offset of each line start; built once on first line lookup.
    line_starts: ?Array[u32] (null)

    fn start() Pos {
        return Pos { src: this }
    }

    fn line_count() uint {
        let length = this.content.bytes
        if length == 0 : return 0
        let starts = this.get_line_starts()
        let lines = starts.length
        if @ptrv(this.content.data, u8, length - 1) == '\n' : lines--
        return lines
    }

    fn get_line_starts() Array[u32] {
        let starts = this.line_starts
        if isset(starts) : return starts
        let data = this.content.data
        let bytes = this.content.bytes
        let result = Array[u32]{ 0 }
        let i: uint = 0
        while i < bytes {
            if @ptrv(data, u8, i++) == '\n' : result.append(i.to(u32))
        }
        this.line_starts = result
        return result
    }

    // Index into line_starts of the line holding byte `i` (0-based)
    fn line_index(i: u32) uint {
        let starts = this.get_line_starts()
        let lo: uint = 0
        let hi = starts.length
        while hi - lo > 1 {
            let mid = (lo + hi) / 2
            if (starts.get(mid) !? 0) <= i : lo = mid
            else : hi = mid
        }
        return lo
    }

    // 1-based line number holding byte index `i`
    fn line_of(i: u32) u32 {
        return this.line_index(i).to(u32) + 1
    }

    // Line/column (1-based) and line span for byte index `i`
    fn line_col(i: u32) LineCol {
        let bytes = this.content.bytes
        if i.to(uint) > bytes : i = bytes.to(u32)
        let index = this.line_index(i)
        let starts = this.get_line_starts()
        let line_start = starts.get(index) !? 0
        // Excludes the newline itself
        let line_end = index + 1 < starts.length ? (starts.get(index + 1) !? 0).to(uint) - 1 : bytes
        return LineCol {
            line: index.to(u32) + 1
            col: i - line_start + 1
            line_start: line_start
            line_len: (line_end - line_start.to(uint)).to(u32)
        }
    }

    // Reformat this file and overwrite it in place.
    fn write_format() !Error {
        let content = format_tokens(this) !>
        let path = this.path ?! this.build.error("Cannot format source without a path")
        fs.write(path, content) ! this.build.error("Failed to write formatted file: " + path)
    }

    // Documentation of the declaration that starts at byte `i`: the contiguous
    // `///` block directly above it, with the marker and one following space
    // removed. A blank line, or any other line, detaches the block; `////` is an
    // ordinary comment. Returns null when the declaration is undocumented.
    fn doc_comment(i: u32) ?String {
        let bytes = this.content.bytes
        let data = this.content.data
        let index = this.line_index(i.to(uint) > bytes ? bytes.to(u32) : i)
        let starts = this.get_line_starts()
        let lines = Array[String]{}
        let current = index
        while current > 0 {
            current--
            let from = (starts.get(current) !? 0).to(uint)
            let to = current + 1 < starts.length ? (starts.get(current + 1) !? 0).to(uint) : bytes
            let p = from
            while p < to {
                let ch = @ptrv(data, u8, p)
                if ch != ' ' && ch != '\t' : break
                p++
            }
            if p + 3 <= to && @ptrv(data, u8, p) == '/' && @ptrv(data, u8, p + 1) == '/'
                && @ptrv(data, u8, p + 2) == '/' && (p + 3 == to || @ptrv(data, u8, p + 3) != '/') {
                let body = p + 3
                // Trailing whitespace is not part of the documented text
                let end = to
                while end > body {
                    let ch = @ptrv(data, u8, end - 1)
                    if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n' : break
                    end--
                }
                let start = body < end && @ptrv(data, u8, body) == ' ' ? body + 1 : body
                lines.append(this.content.part(start, end - start))
                continue
            }
            // Attributes of the documented declaration may sit above it
            if p < to && @ptrv(data, u8, p) == '@' : continue
            break
        }
        if lines.length == 0 : return null
        let out = ""
        let n = lines.length
        while n > 0 {
            n--
            if out.length > 0 : out += "\n"
            out += lines.get(n) !? ""
        }
        return out
    }
}

fn require_unsafe(at: Exp, scope: Scope, feature: String) !Error {
    if scope.mark_unsafe_used() || at.src.build.options.ignore_unsafe : return
    at.error(feature + " requires '@unsafe' in this scope")
}

class Pos {
    src: Source
    i: u32 (0) // index
    line: u32 (1)
    col: u32 (1)

    fn copy() Pos {
        return Pos {
            src: this.src
            i: this.i
            line: this.line
            col: this.col
        }
    }

    fn init_parser() Parser {
        return Parser {
            build: this.src.build
            pos: this
        }
    }

    fn message(msg: String) Message {
        return Message {
            build: this.src.build
            type: MSG.error
            msg: msg
            src: this.src
            i: this.i
        }
    }

    fn error(msg: String) !Error $throw {
        this.message(msg).error()
    }
}

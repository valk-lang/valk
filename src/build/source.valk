
class Source {
    build: Build
    content: String
    path: ?String (null)
    format: bool (false)
    // Top-level EXPs when format=true (printed after bodies are parsed)
    format_exps: ?Array[Exp] (null)
    // Set by top-level `@ignore_access` — access checks are skipped for this file
    ignore_access: bool (false)

    fn start() Pos {
        return Pos { src: this }
    }

    // Reconstruct and print source from format_exps (after pipeline filled body_exps).
    fn print_format() {
        let exps = this.format_exps ?! return
        let result = ByteBuffer.new()
        each exps as exp {
            exp.format(result, 0)
        }
        result.write_string("\n")
        println(result)
    }
}

class Pos {
    src: Source
    i: u32 (0) // index
    line: u32 (1)
    col: u32 (1)

    fn copy() Pos {
        return Pos {
            src: this.src
            i: this.i
            line: this.line
            col: this.col
        }
    }

    fn init_parser() Parser {
        return Parser {
            build: this.src.build
            pos: this
        }
    }
}

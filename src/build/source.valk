
class Source {
    build: Build
    content: String
    path: ?String (null)

    fn start() Pos {
        return Pos { src: this }
    }
}

class Pos {
    src: Source
    i: uint (0) // index
    line: uint (1)
    col: uint (1)

    fn init_parser() Parser {
        return Parser {
            build: this.src.build
            pos: this
        }
    }
}

use valk:fs

class Source {
    build: Build
    content: String
    path: ?String (null)
    // Unique per loaded file. Symbol names include it when every file shares one
    // LLVM module (--release / --ir), where the unit name alone no longer keeps
    // same-named declarations from different files apart.
    id: uint (0)
    format: bool (false)
    // Top-level EXPs when format=true (written back after bodies are parsed)
    format_exps: ?Array[Exp] (null)
    // Set by top-level `@ignore_access` — access checks are skipped for this file
    ignore_access: bool (false)

    fn start() Pos {
        return Pos { src: this }
    }

    // Reconstruct source from format_exps and overwrite the original file in place.
    fn write_format() !Error {
        let exps = this.format_exps ?! return
        let path = this.path ?! this.build.error("Cannot format source without a path")
        let result = ByteBuffer.new()
        each exps as exp {
            exp.format(result, 0)
        }
        result.write_string("\n")
        fs:write(path, result.to_string()) ! this.build.error("Failed to write formatted file: " + path)
    }
}

class Pos {
    src: Source
    i: u32 (0) // index
    line: u32 (1)
    col: u32 (1)

    fn copy() Pos {
        return Pos {
            src: this.src
            i: this.i
            line: this.line
            col: this.col
        }
    }

    fn init_parser() Parser {
        return Parser {
            build: this.src.build
            pos: this
        }
    }
}

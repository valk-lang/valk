use valk:fs

class Source {
    build: Build
    content: String
    path: ?String (null)
    // A `%{...}` interpolation is parsed from its own Source holding just the
    // expression text, so positions inside it are relative to that text. `parent`
    // is the file it was written in and `parent_offset` where the expression
    // starts there, which is what diagnostics report. Nested interpolations chain.
    parent: ?Source (null)
    parent_offset: u32 (0)
    // Namespace this file was loaded into. Access checks use the Source itself
    // for `-` / `~` boundaries and its namespace for combined-marker and package
    // boundaries.
    // A declaration's own `ns` is not always the namespace it was written in (a
    // method mixed in by `extend` carries the extended class's namespace), but
    // its source file always is.
    // Null for generated sources with no file of their own.
    ns: ?Namespace (null)
    // Unique per loaded file. Symbol names include it when every file shares one
    // IR module (--release / --ir), where the unit name alone no longer keeps
    // same-named declarations from different files apart.
    id: uint (0)
    // Set by top-level `@ignore_access` — access checks are skipped for this file
    ignore_access: bool (false)
    // Set when a compile macro excluded part of this file from the build. What
    // the excluded code would have referenced is unknown, so the warnings about
    // things nothing refers to say nothing about this file (see warn.valk).
    skipped_code: bool (false)

    fn start() Pos {
        return Pos { src: this }
    }

    // Number of physical lines in this source. A final newline terminates the
    // preceding line; it does not introduce an additional empty line.
    fn line_count() uint {
        let length = this.content.bytes
        if length == 0 : return 0
        let data = this.content.data
        let lines: uint = 0
        let i: uint = 0
        while i < length {
            if @ptrv(data, u8, i) == '\n' : lines++
            i++
        }
        if @ptrv(data, u8, length - 1) != '\n' : lines++
        return lines
    }

    // Reformat this file and overwrite it in place.
    fn write_format() !Error {
        let content = format_tokens(this) !>
        let path = this.path ?! this.build.error("Cannot format source without a path")
        fs:write(path, content) ! this.build.error("Failed to write formatted file: " + path)
    }
}

class Pos {
    src: Source
    i: u32 (0) // index
    line: u32 (1)
    col: u32 (1)

    fn copy() Pos {
        return Pos {
            src: this.src
            i: this.i
            line: this.line
            col: this.col
        }
    }

    fn init_parser() Parser {
        return Parser {
            build: this.src.build
            pos: this
        }
    }
}

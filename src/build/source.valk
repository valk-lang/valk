
class Source {
    build: Build
    content: String
    path: ?String (null)

    fn start() Pos {
        return Pos { src: this }
    }
}

class Pos {
    src: Source
    i: u32 (0) // index
    line: u32 (1)
    col: u32 (1)

    fn copy() Pos {
        return Pos {
            src: this.src
            i: this.i
            line: this.line
            col: this.col
        }
    }

    fn init_parser() Parser {
        return Parser {
            build: this.src.build
            pos: this
        }
    }
}

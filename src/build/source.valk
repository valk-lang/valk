use valk:fs

class Source {
    build: Build
    content: String
    path: ?String (null)
    parent: ?Source (null)
    parent_offset: u32 (0)
    ns: ?Namespace (null)
    id: uint (0)
    // Set by top-level `@ignore_access` — access checks are skipped for this file
    ignore_access: bool (false)
    skipped_code: bool (false)

    fn start() Pos {
        return Pos { src: this }
    }

    fn line_count() uint {
        let length = this.content.bytes
        if length == 0 : return 0
        let data = this.content.data
        let lines: uint = 0
        let i: uint = 0
        while i < length {
            if @ptrv(data, u8, i) == '\n' : lines++
            i++
        }
        if @ptrv(data, u8, length - 1) != '\n' : lines++
        return lines
    }

    // Reformat this file and overwrite it in place.
    fn write_format() !Error {
        let content = format_tokens(this) !>
        let path = this.path ?! this.build.error("Cannot format source without a path")
        fs:write(path, content) ! this.build.error("Failed to write formatted file: " + path)
    }
}

fn require_unsafe(at: Exp, scope: Scope, feature: String) !Error {
    if scope.mark_unsafe_used() || at.src.build.options.ignore_unsafe : return
    at.error(feature + " requires '@unsafe' in this scope")
}

class Pos {
    src: Source
    i: u32 (0) // index
    line: u32 (1)
    col: u32 (1)

    fn copy() Pos {
        return Pos {
            src: this.src
            i: this.i
            line: this.line
            col: this.col
        }
    }

    fn init_parser() Parser {
        return Parser {
            build: this.src.build
            pos: this
        }
    }

    fn error(msg: String) !Error $throw {
        let b = this.src.build
        b.has_errors = true
        b.messages.append(Message {
            type: MSG.error
            msg: msg
            src: this.src
            i: this.i
        })
        throw .error
    }
}

use valk:fs

class Source {
    build: Build
    content: String
    path: ?String (null)
    // A `%{...}` interpolation is parsed from its own Source holding just the
    // expression text, so positions inside it are relative to that text. `parent`
    // is the file it was written in and `parent_offset` where the expression
    // starts there, which is what diagnostics report. Nested interpolations chain.
    parent: ?Source (null)
    parent_offset: u32 (0)
    // Namespace this file was loaded into. Access checks read it from both sides
    // of an access to compare packages: a declaration's own `ns` is not always the
    // namespace it was written in (a method mixed in by `extend` carries the
    // extended class's namespace), but its source file always is.
    // Null for generated sources with no file of their own.
    ns: ?Namespace (null)
    // Unique per loaded file. Symbol names include it when every file shares one
    // LLVM module (--release / --ir), where the unit name alone no longer keeps
    // same-named declarations from different files apart.
    id: uint (0)
    format: bool (false)
    // Top-level EXPs when format=true (written back after bodies are parsed)
    format_exps: ?Array[Exp] (null)
    // Set by top-level `@ignore_access` — access checks are skipped for this file
    ignore_access: bool (false)
    // Set when a compile macro excluded part of this file from the build. What
    // the excluded code would have referenced is unknown, so the warnings about
    // things nothing refers to say nothing about this file (see warn.valk).
    skipped_code: bool (false)

    fn start() Pos {
        return Pos { src: this }
    }

    // Reconstruct source text from format_exps. Null when this source was not
    // loaded for formatting, so there is no Exp tree to rebuild from.
    //
    // Only meaningful once function and class bodies have been parsed, and only
    // when the build had no errors: a body that failed to resolve has no
    // body_exps, and reconstructing from that would silently drop code.
    fn format_to_string() ?String {
        let exps = this.format_exps ?! return null
        let result = ByteBuffer.new()
        each exps as exp {
            exp.format(result, 0)
        }
        result.write_string("\n")
        return result.to_string()
    }

    // Reconstruct source from format_exps and overwrite the original file in place.
    fn write_format() !Error {
        let content = this.format_to_string() ?! return
        let path = this.path ?! this.build.error("Cannot format source without a path")
        fs:write(path, content) ! this.build.error("Failed to write formatted file: " + path)
    }
}

class Pos {
    src: Source
    i: u32 (0) // index
    line: u32 (1)
    col: u32 (1)

    fn copy() Pos {
        return Pos {
            src: this.src
            i: this.i
            line: this.line
            col: this.col
        }
    }

    fn init_parser() Parser {
        return Parser {
            build: this.src.build
            pos: this
        }
    }
}

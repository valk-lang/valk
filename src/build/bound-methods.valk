// A local used only as a call target needs its receiver, not a closure object.
class BoundMethodLocal {
    decl: Decl
    init: ?Value (null)
    calls: Array[Value] (.{})
    valid: bool (true)
}

fn func_elide_bound_environments(func: Func) {
    let candidates: ?HashMap[Decl, BoundMethodLocal] = null
    each func.all_decls as decl {
        if decl.type.kind != TYPE.closure || !decl.implicit_borrow || decl.is_arg
            || decl.is_written || decl.is_captured || decl.is_buffer : continue
        if !isset(candidates) : candidates = .{}
        candidates.set(decl, BoundMethodLocal { decl: decl })
    }
    if !isset(candidates) : return
    let scope = func.body_scope ?! return
    let visited = HashMap[Value, bool]{}
    each scope.values as value : bound_method_scan(value, candidates, visited)
    let cleanup = func.defer_scope
    if isset(cleanup) {
        each cleanup.values as value : bound_method_scan(value, candidates, visited)
    }

    each candidates as candidate {
        let init = candidate.init
        if !candidate.valid || !isset(init) : continue
        let binding = init.value2 ?! continue
        let receiver = binding.value1 ?! continue
        let method = binding.func ?! continue
        if binding.type != VAL.func || method.is_literal || method.is_static || method.is_interface
            || !receiver.rett.is_stack_borrow() || isset(binding.get_pre_value()) : continue
        let saved = Decl.new(func, receiver.rett, false, null)
        saved.exp = candidate.decl.exp
        each func.all_decls as decl, i {
            if decl == candidate.decl : func.all_decls.set(i, saved) _
        }
        init.value1 = vgen_decl(saved)
        init.value2 = receiver
        each candidate.calls as call {
            let target = vgen_func(method, vgen_decl(saved))
            target.exp = binding.exp
            call.value1 = target
            call.op = CALL_KIND.direct
        }
    }
}

fn bound_method_scan(value: Value, candidates: HashMap[Decl, BoundMethodLocal], visited: HashMap[Value, bool]) {
    // Check each use even when the same value node appears in several places.
    if value.type == VAL.decl {
        let decl = value.decl
        if isset(decl) {
            candidates.get(decl) -> candidate : candidate.valid = false
        }
    }
    if visited.has(value) : return
    visited.set(value, true)

    let first = value.value1
    let handled_first = false
    if isset(first) && first.type == VAL.decl && !isset(first.get_pre_value()) {
        let decl = first.decl
        let candidate = isset(decl) ? (candidates.get(decl) !? null) : null
        if isset(candidate) {
            if value.type == VAL.assign {
                if isset(candidate.init) || value.op != ASSIGN_OP.set : candidate.valid = false
                candidate.init = value
                handled_first = true
            } else if value.type == VAL.call && value.op == CALL_KIND.closure {
                candidate.calls.append(value)
                handled_first = true
            }
        }
    }
    if isset(first) && !handled_first : bound_method_scan(first, candidates, visited)
    let second = value.value2
    if isset(second) : bound_method_scan(second, candidates, visited)
    let values = value.values
    if isset(values) {
        each values as child : bound_method_scan(child, candidates, visited)
    }
    let pre = value.get_pre_value()
    if isset(pre) : bound_method_scan(pre, candidates, visited)
    let checked = value.get_checked_read()
    if isset(checked) : bound_method_scan(checked, candidates, visited)
}


class BuildCache {
    // Lazily-created directory for per-Unit object files.
    object_dir: String ("")
    package_dirs: Map[Pkg] (.{})
    // Absolute source paths already loaded. A map keeps namespace fan-out and
    // LSP dependency checks O(1) instead of scanning every previously loaded
    // file.
    loaded_files: Map[bool] (.{})
    // Hands out Source.id values
    source_count: uint (0)
    used_unit_names: Array[String] (.{})
    // The one Unit every source file shares when options.single_unit is set.
    single_unit: ?Unit (null)
    // Resolved identifiers from the built-in valk package.
    // Outer key: namespace name; inner key: identifier name.
    valk_idf_cache: Map[Map[Idf]] (.{})
    // One generated GC allocator per concrete class layout.
    allocators: Map[Allocator] (.{})
    // Singleton types shared across the whole build (immutable once created)
    type_void: ?Type (null)
    type_any: ?Type (null)
    // Primitive stand-ins used before valk:core classes (int/String/bool) are registered.
    // Needed for #if macro evaluation and compile-def Values during early parse.
    type_prim_int: ?Type (null)
    type_prim_string: ?Type (null)
    type_prim_bool: ?Type (null)
    type_prim_ptr: ?Type (null)
    // Core class types by name (int, String, …) from type_from_core
    core_types: Map[Type] (.{})
    // Raw `[n x u8]` payload storage, by byte length.
    byte_array_types: Map[Type] (.{})
    // Value-AST helper: clone a function capture env via its `$clone` header.
    fn_env_clone_caller: ?Func (null)
}

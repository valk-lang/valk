
// Expression
class Exp {
    type: EXP
    str1: String ("")
    str2: ?String (null)
    pos: ?Pos (null)
    list: ?Array[String] (null)
    sub_exps: ?Array[?Exp] (null)
    body_exps: ?Array[Exp] (null)
    // Source info
    src: Source
    i: u32
    len: u32
    //
    bool1: bool (false)
    bool2: bool (false)
    bool3: bool (false)
    number: u32 (0)
    act: ACT (ACT.undefined)
    // Discriminator for the current EXP type (TYPE_KIND, VALUE_KIND, CLASS_KIND, …)
    kind: u8 (0)

    ////////////////////////////
    // Set index / length
    ////////////////////////////

    fn set_end(index: u32) {
        this.len = index > this.i ? (index - this.i) : 0
    }

    ////////////////////////////
    // Errors
    ////////////////////////////

    // Same as Build.error, but attaches this expression's source span to the Message.
    fn error(msg: String) !Error $throw {
        let b = this.src.build
        b.has_errors = true
        b.messages.append(Message {
            type: MSG.error
            msg: msg
            src: this.src
            i: this.i
            len: this.len
        })
        throw .error
    }

    // Like Exp.error, for situations that should be impossible if the compiler is correct.
    fn bug(msg: String) !Error $throw {
        this.error("(Compiler bug) " + msg)
    }

    fn warn(msg: String) {
        let b = this.src.build
        let key = msg + "@" + this.src.id + ":" + this.i
        if b.warned_spans.has(key) : return
        b.warned_spans.set(key, true)
        b.messages.append(Message {
            type: MSG.warning
            msg: msg
            src: this.src
            i: this.i
            len: this.len
        })
    }

    ////////////////////////////
    // Get/set sub expressions
    ////////////////////////////

    fn set(index: uint, exp: ?Exp) {
        let subs = this.sub_exps ?? <{
            let a = Array[?Exp]{}
            this.sub_exps = a
            return a
        }
        subs.set_expand(index, exp, null)
    }
    fn get(index: uint) ?Exp {
        let subs = this.sub_exps ?! return null
        return subs.get(index) !? null
    }

    fn copy_tree() Exp {
        let copy = Exp {
            type: this.type
            str1: this.str1
            str2: this.str2
            pos: this.pos
            list: this.list
            src: this.src
            i: this.i
            len: this.len
            bool1: this.bool1
            bool2: this.bool2
            bool3: this.bool3
            number: this.number
            act: this.act
            kind: this.kind
        }
        let subs = this.sub_exps
        if isset(subs) {
            let copied = Array[?Exp]{}
            each subs as sub : copied.append(isset(sub) ? sub.copy_tree() : null)
            copy.sub_exps = copied
        }
        let body = this.body_exps
        if isset(body) {
            let copied = Array[Exp]{}
            each body as exp : copied.append(exp.copy_tree())
            copy.body_exps = copied
        }
        return copy
    }

    fn release_children() {
        let subs = this.sub_exps
        if isset(subs) {
            each subs as sub {
                if isset(sub) : sub.release_children()
            }
            this.sub_exps = null
        }
        let body = this.body_exps
        if isset(body) {
            each body as sub : sub.release_children()
            this.body_exps = null
        }
    }
}

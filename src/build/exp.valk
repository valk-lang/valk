
// Expression
class Exp {
    type: EXP
    str1: String ("")
    str2: ?String (null)
    pos: ?Pos (null)
    list: ?Array[String] (null)
    sub_exps: ?Array[?Exp] (null)
    body_exps: ?Array[Exp] (null) // Stores body exps here if src.format == true
    // Source info
    src: Source
    i: u32
    len: u32
    new_lines: u32 (0) // newlines before this exp when parsed
    //
    bool1: bool (false)
    bool2: bool (false)
    number: u32 (0)
    act: ACT (ACT.undefined)
    // Discriminator for the current EXP type (TYPE_KIND, VALUE_KIND, CLASS_KIND, …)
    kind: u8 (0)

    ////////////////////////////
    // Set index / length
    ////////////////////////////

    fn set_end(index: u32) {
        this.len = index > this.i ? (index - this.i) : 0
    }

    ////////////////////////////
    // Errors
    ////////////////////////////

    // Same as Build.error, but attaches this expression's source span to the Message.
    fn error(msg: String) !Error $throw {
        let b = this.src.build
        b.has_errors = true
        b.messages.append(Message {
            type: MSG.error
            msg: msg
            src: this.src
            i: this.i
            len: this.len
        })
        throw .error
    }

    // Like Exp.error, for situations that should be impossible if the compiler is correct.
    fn bug(msg: String) !Error $throw {
        this.error("(Compiler bug) " + msg)
    }

    ////////////////////////////
    // Get/set sub expressions
    ////////////////////////////

    fn set(index: uint, exp: ?Exp) {
        let subs = this.sub_exps ?? <{
            let a = Array[?Exp]{}
            this.sub_exps = a
            return a
        }
        subs.set_expand(index, exp, null)
    }
    fn get(index: uint) ?Exp {
        let subs = this.sub_exps ?! return null
        return subs.get(index) !? null
    }

    ////////////////////////////
    // Format
    ////////////////////////////

    // Reconstruct source-like text. `depth` is scope depth: 1 → 4 spaces, 2 → 8, ...
    fn format(result: ByteBuffer, depth: uint) {
        if this.type == EXP.use : this.format_use(result, depth)
        else if this.type == EXP.func : this.format_func(result, depth)
        else if this.type == EXP.test : this.format_test(result, depth)
        else if this.type == EXP.class : this.format_class(result, depth)
        else if this.type == EXP.enum : this.format_enum(result, depth)
        else if this.type == EXP.macro : this.format_macro(result, depth)
        else if this.type == EXP.global : this.format_global(result, depth)
        else if this.type == EXP.alias : this.format_alias(result, depth)
        else if this.type == EXP.alias_type : this.format_alias_type(result, depth)
        else if this.type == EXP.alias_value : this.format_alias_value(result, depth)
        else if this.type == EXP.link : this.format_link(result, depth)
        else if this.type == EXP.error : this.format_error(result, depth)
        else if this.type == EXP.ignore_access : this.format_ignore_access(result, depth)
        else if this.type == EXP.trait : this.format_trait(result, depth)
        else if this.type == EXP.trait_use : this.format_trait_use(result, depth)
        else if this.type == EXP.extend : this.format_extend(result, depth)
        else if this.type == EXP.macro_def : this.format_macro_def(result, depth)
        else if this.type == EXP.macro_scope : this.format_macro_scope(result, depth)
        else if this.type == EXP.macro_part : this.format_macro_part(result, depth)
        else if this.type == EXP.id : this.format_id(result, depth)
        else if this.type == EXP.type : this.format_type(result, depth)
        else if this.type == EXP.value : this.format_value(result, depth)
        else if this.type == EXP.body : this.format_body(result, depth)
        else if this.type == EXP.comment : this.format_comment(result, depth)
        // let / if / while not formatted yet
    }

    // Leading newlines before this expression (capped at 2 for formatting).
    fn format_newlines(result: ByteBuffer) {
        let n = this.new_lines
        if n > 2 : n = 2
        while n > 0 {
            result.write_byte('\n')
            n--
        }
    }

    // Write `depth * 4` leading spaces (start of a line).
    fn format_indent(result: ByteBuffer, depth: uint) {
        while depth-- > 0 {
            result.write_string("    ")
        }
    }

    fn format_act(result: ByteBuffer) {
        if this.act == ACT.public : result.write_string("+ ")
        else if this.act == ACT.private : result.write_string("- ")
        else if this.act == ACT.readonly : result.write_string("~ ")
    }

    fn format_sub(result: ByteBuffer, index: uint, depth: uint) {
        let sub = this.get(index)
        if isset(sub) : sub.format(result, depth)
    }

    // Body spans store from after the opener through the closer; prepend the opener.
    // Interior is copied verbatim (original indent preserved).
    fn format_body(result: ByteBuffer, depth: uint) {
        let content = this.src.content.part(this.i, this.len)
        if content.length == 0 {
            result.write_string("{}")
            return
        }
        let last = content.get(content.length - 1)
        if last == ')' : result.write_string("(")
        else if last == ']' : result.write_string("[")
        else if last == '}' : result.write_string("{")
        result.write_string(content)
    }

    fn format_id(result: ByteBuffer, depth: uint) {
        let ns = this.str2
        if isset(ns) {
            result.write_string(ns)
            result.write_string(":")
        }
        result.write_string(this.str1)
    }

    fn format_comment(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        result.write_string(this.str1)
    }

    fn format_use(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        result.write_string("use ")
        this.format_sub(result, USE_EXP.id, depth)
        let alias = this.str2
        if isset(alias) {
            result.write_string(" as ")
            result.write_string(alias)
        }
    }

    fn format_link(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        result.write_string("link ")
        let kind = this.kind.@cast(LINK_KIND)
        if kind == LINK_KIND.dynamic : result.write_string("dynamic ")
        else if kind == LINK_KIND.static : result.write_string("static ")
        else if kind == LINK_KIND.framework : result.write_string("framework ")
        result.write_string("\"")
        result.write_string(this.str1)
        result.write_string("\"")
    }

    fn format_error(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        this.format_act(result)
        result.write_string("error ")
        result.write_string(this.str1)
        result.write_string(" (")
        let codes = this.list
        if isset(codes) {
            each codes as code, i {
                if i > 0 : result.write_string(", ")
                result.write_string(code)
            }
        }
        result.write_string(")")
        let ext = this.get(ERROR_EXP.extends)
        if isset(ext) {
            result.write_string(" extends ")
            ext.format(result, depth)
        }
        let payload = this.get(ERROR_EXP.payload)
        if isset(payload) {
            result.write_string(" payload ")
            payload.format(result, depth)
        }
        if this.bool1 : result.write_string(" $global")
    }

    fn format_ignore_access(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        result.write_string("@ignore_access")
    }

    fn format_trait(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        this.format_act(result)
        result.write_string("trait ")
        result.write_string(this.str1)
        this.format_sub(result, TRAIT_EXP.generics, depth)
        result.write_string(" ")
        this.format_sub(result, TRAIT_EXP.body, depth)
    }

    fn format_trait_use(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        result.write_string("use ")
        this.format_sub(result, TRAIT_USE_EXP.id, depth)
        let gens = this.get(TRAIT_USE_EXP.generics)
        if isset(gens) {
            result.write_string("[")
            let i: uint = 0
            while true {
                let g = gens.get(i)
                if !isset(g) : break
                if i > 0 : result.write_string(", ")
                g.format(result, depth)
                i++
            }
            result.write_string("]")
        }
    }

    fn format_extend(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        result.write_string("extend ")
        this.format_sub(result, EXTEND_EXP.id, depth)
        this.format_sub(result, EXTEND_EXP.generics, depth)
        result.write_string(" ")
        this.format_sub(result, EXTEND_EXP.body, depth)
    }

    fn format_macro_def(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        this.format_act(result)
        result.write_string("macro ")
        // Named macros print the name; token-named / scope-open-as-name omit it when
        // the name equals the scope open tag (nameless form: macro scope("{", ...)).
        let pattern = this.get(MACRO_DEF_EXP.pattern)
        let omit_name = false
        if this.bool1 && isset(pattern) && pattern.str1 == this.str1 {
            omit_name = true
        }
        if !omit_name {
            if this.bool1 {
                result.write_string("\"")
                result.write_string(this.str1)
                result.write_string("\"")
            } else {
                result.write_string(this.str1)
            }
            result.write_string(" ")
        }
        this.format_sub(result, MACRO_DEF_EXP.pattern, depth)
        result.write_string(" ")
        if this.bool2 : result.write_string("<")
        this.format_sub(result, MACRO_DEF_EXP.output, depth)
    }

    fn format_macro_scope(result: ByteBuffer, depth: uint) {
        result.write_string("scope(\"")
        result.write_string(this.str1)
        result.write_string("\", ")
        let parts = this.get(MACRO_SCOPE_EXP.parts)
        if isset(parts) {
            let i: uint = 0
            while true {
                let part = parts.get(i)
                if !isset(part) : break
                if i > 0 : result.write_string(" ")
                part.format(result, depth)
                i++
            }
        }
        if this.bool1 {
            let items = this.list
            if isset(items) && items.length >= 2 {
                result.write_string(", \"")
                result.write_string(items.get(0) !? "")
                result.write_string("\" as ")
                result.write_string(items.get(1) !? "")
            }
        }
        result.write_string(")")
    }

    fn format_macro_part(result: ByteBuffer, depth: uint) {
        let kind = this.kind.@cast(MACRO_PART_KIND)
        if kind == MACRO_PART_KIND.token {
            result.write_string("\"")
            result.write_string(this.str1)
            result.write_string("\"")
            return
        }
        let suggest = this.get(MACRO_PART_EXP.suggest)
        if isset(suggest) {
            result.write_string("suggest(")
            suggest.format(result, depth)
            result.write_string(") ")
        }
        if kind == MACRO_PART_KIND.value {
            result.write_string("V:")
            result.write_string(this.str1)
        } else if kind == MACRO_PART_KIND.type {
            result.write_string("T:")
            result.write_string(this.str1)
        }
    }

    fn format_func(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        this.format_act(result)
        // bool2 = is_extern
        if this.bool2 : result.write_string("extern ")
        if this.kind == FUNC_KIND.get {
            result.write_string("get ")
        } else {
            result.write_string("fn ")
        }
        result.write_string(this.str1)
        this.format_sub(result, FUNC_EXP.generics, depth)
        this.format_sub(result, FUNC_EXP.args, depth)

        let rett = this.get(FUNC_EXP.type)
        if isset(rett) {
            result.write_string(" ")
            rett.format(result, depth)
        }

        let err = this.get(FUNC_EXP.error)
        if isset(err) {
            result.write_string("!")
            err.format(result, depth)
        }

        let flags = this.list
        if isset(flags) {
            each flags as f {
                result.write_string(" ")
                result.write_string(f)
            }
        }

        let body = this.get(FUNC_EXP.body)
        if isset(body) {
            result.write_string(" ")
            body.format(result, depth)
        } else {
            result.write_string(";")
        }
    }

    fn format_test(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        result.write_string("test ")
        result.write_string(this.str1)
        result.write_string(" ")
        this.format_sub(result, TEST_EXP.body, depth)
    }

    fn format_class(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        this.format_act(result)
        let kind = this.kind
        result.write_string(class_kind_name(kind))
        result.write_string(" ")
        result.write_string(this.str1)
        this.format_sub(result, CLASS_EXP.generics, depth)

        if kind == CLASS_KIND.integer {
            result.write_string(" ")
            result.write_string(this.bool1 ? "signed" : "unsigned")
            result.write_string(" ")
            this.format_class_size(result)
        } else if kind == CLASS_KIND.float {
            result.write_string(" ")
            this.format_class_size(result)
        } else if kind == CLASS_KIND.struct && this.bool1 {
            result.write_string(" packed")
        } else if kind == CLASS_KIND.mode {
            result.write_string(" for ")
            this.format_sub(result, CLASS_EXP.mode_for, depth)
        }

        if this.bool2 {
            result.write_string(" @async")
        }

        let flags = this.list
        if isset(flags) {
            each flags as f {
                result.write_string(" ")
                result.write_string(f)
            }
        }

        result.write_string(" ")
        this.format_sub(result, CLASS_EXP.body, depth)
    }

    fn format_class_size(result: ByteBuffer) {
        if this.number == 0 {
            result.write_string("*")
        } else {
            result.write_uint_ascii(this.number)
        }
    }

    fn format_enum(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        this.format_act(result)
        result.write_string("enum ")
        result.write_string(this.str1)
        let t = this.get(ENUM_EXP.type)
        if isset(t) {
            result.write_string(":")
            t.format(result, depth)
        }
        result.write_string(" ")
        this.format_sub(result, ENUM_EXP.body, depth)
    }

    fn format_global(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        this.format_act(result)
        // bool2 = is_extern
        if this.bool2 : result.write_string("extern ")
        result.write_string(global_kind_name(this.kind))
        result.write_string(" ")
        result.write_string(this.str1)
        result.write_string(": ")
        this.format_sub(result, GLOBAL_EXP.type, depth)
        let def = this.get(GLOBAL_EXP.default)
        if isset(def) {
            result.write_string(" ")
            def.format(result, depth)
        }
    }

    fn format_alias(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        this.format_act(result)
        result.write_string("alias ")
        result.write_string(this.str1)
        result.write_string(" for ")
        this.format_sub(result, ALIAS_EXP.id, depth)
    }

    fn format_alias_type(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        this.format_act(result)
        result.write_string("type ")
        result.write_string(this.str1)
        result.write_string(" ")
        this.format_sub(result, ALIAS_TYPE_EXP.body, depth)
    }

    fn format_alias_value(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        this.format_act(result)
        result.write_string("value ")
        result.write_string(this.str1)
        result.write_string(" ")
        this.format_sub(result, ALIAS_VALUE_EXP.body, depth)
    }

    fn format_macro(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        result.write_string("#")
        result.write_string(macro_kind_name(this.kind))
        let kind = this.kind
        if kind == MACRO_KIND.if || kind == MACRO_KIND.elif {
            result.write_string(" ")
            this.format_sub(result, MACRO_EXP.value, depth)
        } else if kind == MACRO_KIND.print_type || kind == MACRO_KIND.print_value_type {
            this.format_sub(result, MACRO_EXP.value, depth)
        } else if kind == MACRO_KIND.print || kind == MACRO_KIND.error {
            let s = this.str2
            if isset(s) {
                result.write_string(" ")
                result.write_string(s)
            }
        } else if kind == MACRO_KIND.loop {
            let words = this.list
            if isset(words) {
                each words as w {
                    result.write_string(" ")
                    result.write_string(w)
                }
            }
        }
    }

    fn format_value(result: ByteBuffer, depth: uint) {
        let kind = this.kind
        if kind == VALUE_KIND.id {
            this.format_sub(result, VALUE_EXP.left, depth)
            return
        }
        if kind == VALUE_KIND.number || kind == VALUE_KIND.float || kind == VALUE_KIND.hex || kind == VALUE_KIND.octal || kind == VALUE_KIND.string || kind == VALUE_KIND.char {
            result.write_string(this.str1)
            return
        }
        if kind == VALUE_KIND.bool {
            result.write_string(this.bool1 ? "true" : "false")
            return
        }
        if kind == VALUE_KIND.null {
            result.write_string("null")
            return
        }
        if kind == VALUE_KIND.op {
            this.format_sub(result, VALUE_EXP.left, depth)
            result.write_string(" ")
            result.write_string(value_op_name(this.number))
            result.write_string(" ")
            this.format_sub(result, VALUE_EXP.right, depth)
            return
        }
        if kind == VALUE_KIND.unary {
            result.write_string(value_op_name(this.number))
            this.format_sub(result, VALUE_EXP.left, depth)
            return
        }
        if kind == VALUE_KIND.paren {
            result.write_string("(")
            this.format_sub(result, VALUE_EXP.left, depth)
            result.write_string(")")
            return
        }
        if kind == VALUE_KIND.dot {
            this.format_sub(result, VALUE_EXP.left, depth)
            result.write_string(".")
            result.write_string(this.str1)
            return
        }
        if kind == VALUE_KIND.cast {
            this.format_sub(result, VALUE_EXP.left, depth)
            result.write_string(".@cast(")
            this.format_sub(result, VALUE_EXP.right, depth)
            result.write_string(")")
            return
        }
        if kind == VALUE_KIND.call {
            this.format_sub(result, VALUE_EXP.left, depth)
            result.write_string("(")
            let args = this.get(VALUE_EXP.right)
            if isset(args) : args.format_value_list(result, depth)
            result.write_string(")")
            return
        }
        if kind == VALUE_KIND.typeof {
            result.write_string("typeof(")
            this.format_sub(result, VALUE_EXP.left, depth)
            result.write_string(")")
            return
        }
        if kind == VALUE_KIND.size_of {
            result.write_string("size_of(")
            this.format_sub(result, VALUE_EXP.left, depth)
            result.write_string(")")
            return
        }
        if kind == VALUE_KIND.multi {
            this.format_value_list(result, depth)
            return
        }
        if kind == VALUE_KIND.incr || kind == VALUE_KIND.decr {
            let op = kind == VALUE_KIND.incr ? "++" : "--"
            if this.bool1 {
                // prefix
                result.write_string(op)
                this.format_sub(result, VALUE_EXP.left, depth)
            } else {
                // postfix
                this.format_sub(result, VALUE_EXP.left, depth)
                result.write_string(op)
            }
            return
        }
        if kind == VALUE_KIND.error_code {
            result.write_string(".")
            result.write_string(this.str1)
            return
        }
        if kind == VALUE_KIND.class_init {
            this.format_sub(result, VALUE_EXP.left, depth)
            result.write_string(" {")
            let fields = this.get(VALUE_EXP.right)
            if isset(fields) {
                let subs = fields.sub_exps
                if isset(subs) {
                    let first = true
                    each subs as field {
                        if !isset(field) : continue
                        if !first : result.write_string(",")
                        first = false
                        result.write_string(" ")
                        result.write_string(field.str1)
                        result.write_string(": ")
                        field.format_sub(result, VALUE_EXP.left, depth)
                    }
                    if !first : result.write_string(" ")
                }
            }
            result.write_string("}")
            return
        }
    }

    // Format sequential sub_exps as comma-separated values (call args).
    fn format_value_list(result: ByteBuffer, depth: uint) {
        let subs = this.sub_exps ?! return
        let first = true
        each subs as sub {
            if !isset(sub) : continue
            if !first : result.write_string(", ")
            first = false
            sub.format(result, depth)
        }
    }

    fn format_type(result: ByteBuffer, depth: uint) {
        let kind = this.kind
        if kind == TYPE_KIND.void {
            result.write_string("void")
            return
        }
        if kind == TYPE_KIND.error_dot {
            result.write_string(".")
            return
        }
        if kind == TYPE_KIND.nullable {
            result.write_string("?")
            this.format_sub(result, TYPE_EXP.type, depth)
            return
        }
        if kind == TYPE_KIND.ptr {
            result.write_string("*")
            this.format_sub(result, TYPE_EXP.type, depth)
            return
        }
        if kind == TYPE_KIND.ref {
            result.write_string("&")
            this.format_sub(result, TYPE_EXP.type, depth)
            return
        }
        if kind == TYPE_KIND.ptr_slice || kind == TYPE_KIND.ref_slice {
            result.write_string(kind == TYPE_KIND.ptr_slice ? "*" : "&")
            result.write_string("[")
            this.format_sub(result, TYPE_EXP.type, depth)
            let size = this.get(TYPE_EXP.size)
            if isset(size) {
                result.write_string(" x ")
                size.format(result, depth)
            }
            result.write_string("]")
            return
        }
        if kind == TYPE_KIND.inline {
            result.write_string("<")
            this.format_sub(result, TYPE_EXP.type, depth)
            result.write_string(">")
            return
        }
        if kind == TYPE_KIND.array {
            result.write_string("[")
            this.format_sub(result, TYPE_EXP.type, depth)
            result.write_string(" x ")
            let size = this.get(TYPE_EXP.size)
            if isset(size) : size.format(result, depth)
            else : result.write_string("0")
            result.write_string("]")
            return
        }
        if kind == TYPE_KIND.multi {
            result.write_string("(")
            this.format_type_list(result, depth)
            result.write_string(")")
            return
        }
        if kind == TYPE_KIND.fn || kind == TYPE_KIND.fnptr {
            result.write_string(kind == TYPE_KIND.fn ? "fn" : "fnptr")
            this.format_sub(result, TYPE_EXP.args, depth)
            this.format_sub(result, TYPE_EXP.rett, depth)
            let err = this.get(TYPE_EXP.error)
            if isset(err) {
                result.write_string("!")
                err.format(result, depth)
            }
            let flags = this.list
            if isset(flags) {
                each flags as f {
                    result.write_string(" ")
                    result.write_string(f)
                }
            }
            return
        }
        if kind == TYPE_KIND.co {
            result.write_string("co")
            this.format_sub(result, TYPE_EXP.rett, depth)
            let err = this.get(TYPE_EXP.error)
            if isset(err) {
                result.write_string("!")
                err.format(result, depth)
            }
            return
        }
        if kind == TYPE_KIND.notnull {
            result.write_string("notnull(")
            this.format_sub(result, TYPE_EXP.type, depth)
            result.write_string(")")
            return
        }
        if kind == TYPE_KIND.typeof {
            result.write_string("typeof(")
            this.format_sub(result, TYPE_EXP.type, depth)
            result.write_string(")")
            return
        }
        if kind == TYPE_KIND.named {
            this.format_sub(result, TYPE_EXP.id, depth)
            let gens = this.get(TYPE_EXP.generics)
            if isset(gens) {
                result.write_string("[")
                gens.format_type_list(result, depth)
                result.write_string("]")
            }
            let inner = this.get(TYPE_EXP.type)
            if isset(inner) {
                result.write_string("[")
                inner.format(result, depth)
                let size = this.get(TYPE_EXP.size)
                if isset(size) {
                    result.write_string(" x ")
                    size.format(result, depth)
                }
                result.write_string("]")
            }
            return
        }
    }

    // Format sequential sub_exps as comma-separated types (for multi / generics list).
    fn format_type_list(result: ByteBuffer, depth: uint) {
        let subs = this.sub_exps ?! return
        let first = true
        each subs as sub {
            if !isset(sub) : continue
            if !first : result.write_string(",")
            first = false
            sub.format(result, depth)
        }
    }
}

// ---- kind → source keyword (format / diagnostics only) ----

fn class_kind_name(kind: u8) String {
    if kind == CLASS_KIND.class : return "class"
    if kind == CLASS_KIND.struct : return "struct"
    if kind == CLASS_KIND.slice : return "slice"
    if kind == CLASS_KIND.pointer : return "pointer"
    if kind == CLASS_KIND.integer : return "integer"
    if kind == CLASS_KIND.float : return "float"
    if kind == CLASS_KIND.boolean : return "boolean"
    if kind == CLASS_KIND.mode : return "mode"
    return "class"
}

fn global_kind_name(kind: u8) String {
    if kind == GLOBAL_KIND.shared : return "shared"
    if kind == GLOBAL_KIND.at_shared : return "@shared"
    return "global"
}

fn macro_kind_name(kind: u8) String {
    if kind == MACRO_KIND.if : return "if"
    if kind == MACRO_KIND.elif : return "elif"
    if kind == MACRO_KIND.else : return "else"
    if kind == MACRO_KIND.end : return "end"
    if kind == MACRO_KIND.loop : return "loop"
    if kind == MACRO_KIND.print : return "print"
    if kind == MACRO_KIND.error : return "error"
    if kind == MACRO_KIND.print_type : return "print_type"
    if kind == MACRO_KIND.print_value_type : return "print_value_type"
    return "?"
}

fn value_op_name(op: u32) String {
    if op == VALUE_OP.not : return "!"
    if op == VALUE_OP.neg : return "-"
    if op == VALUE_OP.bit_not : return "~"
    if op == VALUE_OP.eq : return "=="
    if op == VALUE_OP.ne : return "!="
    if op == VALUE_OP.lt : return "<"
    if op == VALUE_OP.gt : return ">"
    if op == VALUE_OP.lte : return "<="
    if op == VALUE_OP.gte : return ">="
    if op == VALUE_OP.add : return "+"
    if op == VALUE_OP.sub : return "-"
    if op == VALUE_OP.mul : return "*"
    if op == VALUE_OP.div : return "/"
    if op == VALUE_OP.mod : return "%"
    if op == VALUE_OP.bit_and : return "&"
    if op == VALUE_OP.bit_or : return "|"
    if op == VALUE_OP.bit_xor : return "^"
    if op == VALUE_OP.shl : return "<<"
    if op == VALUE_OP.shr : return ">>"
    if op == VALUE_OP.and : return "&&"
    if op == VALUE_OP.or : return "||"
    return "?"
}


// Expression
// Field order keeps the small fields together so an Exp fits a 128-byte slot
class Exp {
    str1: String ("")
    str2: ?String (null)
    pos: ?Pos (null)
    list: ?Array[String] (null)
    // Sub-expression slots 0 and 1 are inline; the rest (type and
    // declaration headers) live in sub_more at index - 2
    sub0: ?Exp (null)
    sub1: ?Exp (null)
    sub_more: ?Array[?Exp] (null)
    body_exps: ?Array[Exp] (null)
    // Source info
    src: Source
    i: u32
    len: u32
    //
    number: u32 (0)
    type: EXP
    act: ACT (ACT.undefined)
    // Discriminator for the current EXP type (TYPE_KIND, VALUE_KIND, CLASS_KIND, …)
    kind: u8 (0)
    bool1: bool (false)
    bool2: bool (false)
    bool3: bool (false)

    // Typed views of `kind`, one per EXP family
    get type_kind: TYPE_KIND $inline { return this.kind.@cast(TYPE_KIND) }
    get value_kind: VALUE_KIND $inline { return this.kind.@cast(VALUE_KIND) }
    get macro_kind: MACRO_KIND $inline { return this.kind.@cast(MACRO_KIND) }
    get func_kind: FUNC_KIND $inline { return this.kind.@cast(FUNC_KIND) }

    ////////////////////////////
    // Set index / length
    ////////////////////////////

    fn set_end(index: u32) {
        this.len = index > this.i ? (index - this.i) : 0
    }

    fn line_count() uint {
        if this.len == 0 : return 0
        return this.src.line_index(this.i + this.len - 1) - this.src.line_index(this.i) + 1
    }

    ////////////////////////////
    // Errors
    ////////////////////////////

    // A diagnostic at this expression's span, to extend and then report
    fn message(msg: String) Message {
        return Message {
            build: this.src.build
            type: MSG.error
            msg: msg
            src: this.src
            i: this.i
            len: this.len
        }
    }

    // Same as Build.error, but attaches this expression's source span to the Message.
    fn error(msg: String) !Error $throw {
        this.message(msg).error()
    }

    // Like Exp.error, for situations that should be impossible if the compiler is correct.
    fn bug(msg: String) !Error $throw {
        this.error("(Compiler bug) " + msg)
    }

    fn warn(msg: String) {
        this.message(msg).warn()
    }

    ////////////////////////////
    // Get/set sub expressions
    ////////////////////////////

    fn set(index: uint, exp: ?Exp) {
        if index == 0 {
            this.sub0 = exp
        } else if index == 1 {
            this.sub1 = exp
        } else {
            let more = this.sub_more ?? <{
                let a = Array[?Exp]{}
                this.sub_more = a
                return a
            }
            more.set_expand(index - 2, exp, null)
        }
    }
    fn get(index: uint) ?Exp {
        if index == 0 : return this.sub0
        if index == 1 : return this.sub1
        let more = this.sub_more ?! return null
        return more.get(index - 2) !? null
    }
    // Number of sub-expression slots, for iteration with get()
    fn sub_count() uint {
        let more = this.sub_more
        return isset(more) ? more.length + 2 : 2
    }
    fn clear_subs() {
        this.sub0 = null
        this.sub1 = null
        this.sub_more = null
    }

    fn copy_tree() Exp {
        let copy = Exp {
            type: this.type
            str1: this.str1
            str2: this.str2
            pos: this.pos
            list: this.list
            src: this.src
            i: this.i
            len: this.len
            bool1: this.bool1
            bool2: this.bool2
            bool3: this.bool3
            number: this.number
            act: this.act
            kind: this.kind
        }
        let sub0 = this.sub0
        if isset(sub0) : copy.sub0 = sub0.copy_tree()
        let sub1 = this.sub1
        if isset(sub1) : copy.sub1 = sub1.copy_tree()
        let more = this.sub_more
        if isset(more) {
            let copied = Array[?Exp]{}
            each more as sub : copied.append(isset(sub) ? sub.copy_tree() : null)
            copy.sub_more = copied
        }
        let body = this.body_exps
        if isset(body) {
            let copied = Array[Exp]{}
            each body as exp : copied.append(exp.copy_tree())
            copy.body_exps = copied
        }
        return copy
    }

    fn release_children() {
        let sub0 = this.sub0
        if isset(sub0) : sub0.release_children()
        let sub1 = this.sub1
        if isset(sub1) : sub1.release_children()
        let more = this.sub_more
        if isset(more) {
            each more as sub {
                if isset(sub) : sub.release_children()
            }
        }
        this.clear_subs()
        let body = this.body_exps
        if isset(body) {
            each body as sub : sub.release_children()
            this.body_exps = null
        }
    }
}

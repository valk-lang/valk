
// Expression
class Exp {
    type: EXP
    str1: String ("")
    str2: ?String (null)
    pos: ?Pos (null)
    list: ?Array[String] (null)
    sub_exps: ?Array[?Exp] (null)
    // Source info
    src: Source
    i: u32
    len: u32
    //
    bool1: bool (false)
    bool2: bool (false)
    act: ACT (ACT.undefined)

    ////////////////////////////
    // Set index / length
    ////////////////////////////

    fn set_end(index: u32) {
        this.len = index > this.i ? (index - this.i) : 0
    }

    ////////////////////////////
    // Get/set sub expressions
    ////////////////////////////

    fn set(index: uint, exp: ?Exp) {
        let subs = this.sub_exps ?? <{
            let a = Array[?Exp]{}
            this.sub_exps = a
            return a
        }
        subs.set_expand(index, exp, null)
    }
    fn get(index: uint) ?Exp {
        let subs = this.sub_exps ?! return null
        return subs.get(index) !? null
    }
}


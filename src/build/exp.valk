
// Expression
class Exp {
    type: EXP
    str1: String ("")
    str2: ?String (null)
    pos: ?Pos (null)
    list: ?Array[String] (null)
    sub_exps: ?Array[?Exp] (null)
    body_exps: ?Array[Exp] (null) // Stores body exps here if src.format == true
    // Source info
    src: Source
    i: u32
    len: u32
    new_lines: u32 (0) // newlines before this exp when parsed
    //
    bool1: bool (false)
    bool2: bool (false)
    number: u32 (0)
    act: ACT (ACT.undefined)

    ////////////////////////////
    // Set index / length
    ////////////////////////////

    fn set_end(index: u32) {
        this.len = index > this.i ? (index - this.i) : 0
    }

    ////////////////////////////
    // Errors
    ////////////////////////////

    // Same as Build.error, but attaches this expression's source span to the Message.
    fn error(msg: String) !Error $throw {
        let b = this.src.build
        b.has_errors = true
        b.messages.append(Message {
            type: MSG.error
            msg: msg
            src: this.src
            i: this.i
            len: this.len
        })
        throw .error
    }

    // Like Exp.error, for situations that should be impossible if the compiler is correct.
    fn bug(msg: String) !Error $throw {
        this.error("(Compiler bug) " + msg)
    }

    ////////////////////////////
    // Get/set sub expressions
    ////////////////////////////

    fn set(index: uint, exp: ?Exp) {
        let subs = this.sub_exps ?? <{
            let a = Array[?Exp]{}
            this.sub_exps = a
            return a
        }
        subs.set_expand(index, exp, null)
    }
    fn get(index: uint) ?Exp {
        let subs = this.sub_exps ?! return null
        return subs.get(index) !? null
    }

    ////////////////////////////
    // Format
    ////////////////////////////

    // Reconstruct source-like text. `depth` is scope depth: 1 → 4 spaces, 2 → 8, ...
    fn format(result: ByteBuffer, depth: uint) {
        if this.type == EXP.use : this.format_use(result, depth)
        else if this.type == EXP.func : this.format_func(result, depth)
        else if this.type == EXP.test : this.format_test(result, depth)
        else if this.type == EXP.class : this.format_class(result, depth)
        else if this.type == EXP.enum : this.format_enum(result, depth)
        else if this.type == EXP.id : this.format_id(result, depth)
        else if this.type == EXP.type : this.format_type(result, depth)
        else if this.type == EXP.body : this.format_body(result, depth)
        else if this.type == EXP.comment : this.format_comment(result, depth)
        // let / if / while not formatted yet
    }

    // Leading newlines before this expression (capped at 2 for formatting).
    fn format_newlines(result: ByteBuffer) {
        let n = this.new_lines
        if n > 2 : n = 2
        while n > 0 {
            result.write_byte('\n')
            n--
        }
    }

    // Write `depth * 4` leading spaces (start of a line).
    fn format_indent(result: ByteBuffer, depth: uint) {
        while depth-- > 0 {
            result.write_string("    ")
        }
    }

    fn format_space(result: ByteBuffer) {
        result.write_string(" ")
    }

    fn format_act(result: ByteBuffer) {
        if this.act == ACT.public : result.write_string("+ ")
        else if this.act == ACT.private : result.write_string("- ")
        else if this.act == ACT.readonly : result.write_string("~ ")
    }

    fn format_sub(result: ByteBuffer, index: uint, depth: uint) {
        let sub = this.get(index)
        if isset(sub) : sub.format(result, depth)
    }

    // Body spans store from after the opener through the closer; prepend the opener.
    // Interior is copied verbatim (original indent preserved).
    fn format_body(result: ByteBuffer, depth: uint) {
        let content = this.src.content.part(this.i, this.len)
        if content.length == 0 {
            result.write_string("{}")
            return
        }
        let last = content.get(content.length - 1)
        if last == ')' : result.write_string("(")
        else if last == ']' : result.write_string("[")
        else if last == '}' : result.write_string("{")
        result.write_string(content)
    }

    fn format_id(result: ByteBuffer, depth: uint) {
        let ns = this.str2
        if isset(ns) {
            result.write_string(ns)
            result.write_string(":")
        }
        result.write_string(this.str1)
    }

    fn format_comment(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        result.write_string(this.str1)
    }

    fn format_use(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        result.write_string("use ")
        this.format_sub(result, USE_EXP.id, depth)
        let alias = this.str2
        if isset(alias) {
            result.write_string(" as ")
            result.write_string(alias)
        }
    }

    fn format_func(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        this.format_act(result)
        result.write_string("fn ")
        result.write_string(this.str1)
        this.format_sub(result, FUNC_EXP.generics, depth)
        this.format_sub(result, FUNC_EXP.args, depth)

        let rett = this.get(FUNC_EXP.type)
        if isset(rett) {
            this.format_space(result)
            rett.format(result, depth)
        }

        let err = this.get(FUNC_EXP.error)
        if isset(err) {
            result.write_string("!")
            err.format(result, depth)
        }

        let flags = this.list
        if isset(flags) {
            each flags as f {
                this.format_space(result)
                result.write_string(f)
            }
        }

        let body = this.get(FUNC_EXP.body)
        if isset(body) {
            this.format_space(result)
            body.format(result, depth)
        } else {
            result.write_string(";")
        }
    }

    fn format_test(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        result.write_string("test ")
        result.write_string(this.str1)
        this.format_space(result)
        this.format_sub(result, TEST_EXP.body, depth)
    }

    fn format_class(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        this.format_act(result)
        let kind = this.str2 ?? "class"
        result.write_string(kind)
        this.format_space(result)
        result.write_string(this.str1)
        this.format_sub(result, CLASS_EXP.generics, depth)

        if kind == "integer" {
            this.format_space(result)
            result.write_string(this.bool1 ? "signed" : "unsigned")
            this.format_space(result)
            this.format_class_size(result)
        } else if kind == "float" {
            this.format_space(result)
            this.format_class_size(result)
        } else if kind == "struct" && this.bool1 {
            result.write_string(" packed")
        }

        if this.bool2 {
            result.write_string(" @async")
        }

        let flags = this.list
        if isset(flags) {
            each flags as f {
                this.format_space(result)
                result.write_string(f)
            }
        }

        this.format_space(result)
        this.format_sub(result, CLASS_EXP.body, depth)
    }

    fn format_class_size(result: ByteBuffer) {
        if this.number == 0 {
            result.write_string("*")
        } else {
            result.write_uint_ascii(this.number)
        }
    }

    fn format_enum(result: ByteBuffer, depth: uint) {
        this.format_newlines(result)
        this.format_indent(result, depth)
        this.format_act(result)
        result.write_string("enum ")
        result.write_string(this.str1)
        let t = this.get(ENUM_EXP.type)
        if isset(t) {
            result.write_string(":")
            t.format(result, depth)
        }
        this.format_space(result)
        this.format_sub(result, ENUM_EXP.body, depth)
    }

    fn format_type(result: ByteBuffer, depth: uint) {
        let form = this.str1
        if form == "void" || form == "." {
            result.write_string(form)
            return
        }
        if form == "?" || form == "*" || form == "&" {
            result.write_string(form)
            this.format_sub(result, TYPE_EXP.type, depth)
            return
        }
        if form == "*[]" || form == "&[]" {
            result.write_string(form == "*[]" ? "*" : "&")
            result.write_string("[")
            this.format_sub(result, TYPE_EXP.type, depth)
            let size = this.str2
            if isset(size) {
                result.write_string(" x ")
                result.write_string(size)
            }
            result.write_string("]")
            return
        }
        if form == "inline" {
            result.write_string("<")
            this.format_sub(result, TYPE_EXP.type, depth)
            result.write_string(">")
            return
        }
        if form == "array" {
            result.write_string("[")
            this.format_sub(result, TYPE_EXP.type, depth)
            result.write_string(" x ")
            result.write_string(this.str2 ?? "0")
            result.write_string("]")
            return
        }
        if form == "multi" {
            result.write_string("(")
            this.format_type_list(result, depth)
            result.write_string(")")
            return
        }
        if form == "fn" || form == "fnptr" {
            result.write_string(form)
            this.format_sub(result, TYPE_EXP.args, depth)
            this.format_sub(result, TYPE_EXP.rett, depth)
            let err = this.get(TYPE_EXP.error)
            if isset(err) {
                result.write_string("!")
                err.format(result, depth)
            }
            let flags = this.list
            if isset(flags) {
                each flags as f {
                    this.format_space(result)
                    result.write_string(f)
                }
            }
            return
        }
        if form == "co" {
            result.write_string("co")
            this.format_sub(result, TYPE_EXP.rett, depth)
            let err = this.get(TYPE_EXP.error)
            if isset(err) {
                result.write_string("!")
                err.format(result, depth)
            }
            return
        }
        if form == "notnull" {
            result.write_string("notnull(")
            this.format_sub(result, TYPE_EXP.type, depth)
            result.write_string(")")
            return
        }
        if form == "named" {
            this.format_sub(result, TYPE_EXP.id, depth)
            let gens = this.get(TYPE_EXP.generics)
            if isset(gens) {
                result.write_string("[")
                gens.format_type_list(result, depth)
                result.write_string("]")
            }
            let inner = this.get(TYPE_EXP.type)
            if isset(inner) {
                result.write_string("[")
                inner.format(result, depth)
                let size = this.str2
                if isset(size) {
                    result.write_string(" x ")
                    result.write_string(size)
                }
                result.write_string("]")
            }
            return
        }
        result.write_string(form)
    }

    // Format sequential sub_exps as comma-separated types (for multi / generics list).
    fn format_type_list(result: ByteBuffer, depth: uint) {
        let subs = this.sub_exps ?! return
        let first = true
        each subs as sub {
            if !isset(sub) : continue
            if !first : result.write_string(",")
            first = false
            sub.format(result, depth)
        }
    }
}

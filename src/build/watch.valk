
use helper
use valk.core
use valk.fs
use valk.time
use valk.gc

fn build_watch(options: BuildOptions) {
    // Modification time per watched path, from the moment the build read it
    let modtimes = Map[uint]{}
    let files = Array[String]{}
    let dirs = Array[String]{}
    // The program started by --run, so it can be stopped before it gets relinked
    let running : ?core.Process = null

    while true {
        if isset(running) {
            running.stop() ! {
                helper.error_msg("⚠️", "Failed to stop the previous process")
            }
            running = null
        }

        println("=======================================")
        running = watch_run_build(options, files, dirs, modtimes)

        gc.collect()
        if options.verbose > 0 {
            let mb = gc.mem_usage_shared.to(float) / 1024 / 1024
            helper.msg("📈", "Watcher memory usage: " + mb.to_string(2, false) + " mb")
        }

        if files.length == 0 {
            helper.error_msg("❌", "No files to watch")
            exit(1)
        }

        watch_wait_for_change(files, dirs, modtimes)
        helper.msg("♻️", "Files changed - rebuild")
    }
}

fn watch_run_build(options: BuildOptions, files: Array[String], dirs: Array[String], modtimes: Map[uint]) ?core.Process {
    let b = Build.init(options)
    b.run() ! { }
    let ok = b.print_messages()
    b.stats.print(options.verbose, ok)

    // Sources actually loaded, plus #embed targets.
    files.clear()
    each b.cache.loaded_files as _, path : files.append(path, true)
    each b.watch_files as path : files.append(path, true)
    each files as path : modtimes.set(path, helper.modified_time(path) !? 0)

    dirs.clear()
    each b.lists.namespaces as ns {
        let dir = ns.dir
        if isset(dir) : dirs.append(dir, true)
    }

    if !ok || !options.run_exe || options.mode != BUILDTYPE.exe : return null

    let path = b.options.path_out
    if !isset(path) : return null
    helper.msg("⚡", "Run: " + path)
    let p = core.Process.run(path, options.run_args, true) !? null
    if !isset(p) : helper.error_msg("❌", "Failed to run: " + path)
    return p
}

fn watch_wait_for_change(files: Array[String], dirs: Array[String], modtimes: Map[uint]) {
    let watcher = fs.Watcher.new() ! {
        watch_wait_poll(files, dirs, modtimes)
        return
    }
    defer watcher.close() _

    let file_set = HashSet[String]{}
    let dir_set = HashSet[String]{}
    let watch_dirs = HashSet[String]{}

    each dirs as dir {
        let resolved = fs.resolve(dir)
        dir_set.add(resolved)
        watch_dirs.add(resolved)
    }
    each files as file {
        let resolved = fs.resolve(file)
        file_set.add(resolved)
        let parent = fs.dir_of(resolved)
        if parent.bytes > 0 : watch_dirs.add(parent)
    }

    let watched_any = false
    each watch_dirs as dir {
        watcher.add(dir) ! continue
        watched_any = true
    }

    if !watched_any {
        watch_wait_poll(files, dirs, modtimes)
        return
    }

    // Catch edits or new files that landed between reading sources and registering watches
    if watch_has_change(files, dirs, modtimes) : return

    while true {
        let ev = watcher.next(0) ! {
            watch_wait_poll(files, dirs, modtimes)
            return
        }
        if !isset(ev) : continue

        let path = fs.resolve(ev.path)
        let relevant = false
        if file_set.has(path) {
            if ev.kind == fs.WatchEventKind.remove {
                helper.msg("ℹ️", "File removed: " + path)
            }
            relevant = true
        } else if path.ends_with(".valk") && dir_set.has(fs.dir_of(path)) {
            if !file_set.has(path) {
                helper.msg("ℹ️", "New file: " + path)
            }
            relevant = true
        } else if watch_dirs.has(path) {
            relevant = watch_has_change(files, dirs, modtimes)
        }

        if relevant {
            watch_debounce(watcher)
            return
        }
    }
}

// Coalesce bursty editor writes (temp file + rename + close) into one rebuild
fn watch_debounce(watcher: fs.Watcher) {
    let deadline = time.mono_ms() + 120
    while true {
        let now = time.mono_ms()
        if now >= deadline : return
        let rem = deadline - now
        let wait: uint = rem < 40 ? rem : 40
        let ev = watcher.next(wait) !? null
        if !isset(ev) : return
    }
}

fn watch_has_change(files: Array[String], dirs: Array[String], modtimes: Map[uint]) bool {
    if watch_find_new_files(files, dirs, modtimes) : return true
    each files as file {
        let mod = helper.modified_time(file) ! {
            helper.msg("ℹ️", "File removed: " + file)
            return true
        }
        if mod != (modtimes.get(file) !? 0) : return true
    }
    return false
}

fn watch_wait_poll(files: Array[String], dirs: Array[String], modtimes: Map[uint]) {
    let count = 0
    while true {
        if count++ % 4 == 0 {
            if watch_find_new_files(files, dirs, modtimes) : return
        }
        each files as file {
            let mod = helper.modified_time(file) ! {
                helper.msg("ℹ️", "File removed: " + file)
                return
            }
            if mod != (modtimes.get(file) !? 0) : return
        }
        time.sleep_ms(500)
    }
}

// True when a watched directory gained a .valk file the last build never saw.
fn watch_find_new_files(files: Array[String], dirs: Array[String], modtimes: Map[uint]) bool {
    let found = false
    each dirs as dir {
        let dir_files = fs.files_in(dir, false, true, false) !? Array[String]{}
        each dir_files as path {
            if !path.ends_with(".valk") : continue
            if files.contains(path) : continue
            helper.msg("ℹ️", "New file: " + path)
            files.append(path)
            modtimes.set(path, helper.modified_time(path) !? 0)
            found = true
        }
    }
    return found
}

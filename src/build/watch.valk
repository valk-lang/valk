
use helper
use valk.core
use valk.fs
use valk.time
use valk.gc

fn build_watch(options: BuildOptions) {
    // Modification time per watched path, from the moment the build read it
    let modtimes = Map[uint]{}
    let files = Array[String]{}
    let dirs = Array[String]{}
    // The program started by --run, so it can be stopped before it gets relinked
    let running : ?core.Process = null

    while true {
        if isset(running) {
            running.stop() ! {
                helper.msg("⚠️", "Failed to stop the previous process")
            }
            running = null
        }

        println("=======================================")
        running = watch_run_build(options, files, dirs, modtimes)

        gc.collect()
        if options.verbose > 0 {
            let mb = gc.mem_usage_shared.to(float) / 1024 / 1024
            helper.msg("📈", "Watcher memory usage: " + mb + " mb")
        }

        if files.length == 0 {
            helper.msg("❌", "No files to watch")
            exit(1)
        }

        watch_wait_for_change(files, dirs, modtimes)
        helper.msg("♻️", "Files changed - rebuild")
    }
}

fn watch_run_build(options: BuildOptions, files: Array[String], dirs: Array[String], modtimes: Map[uint]) ?core.Process {
    let b = Build.init(options)
    b.run() ! { }
    let ok = b.print_messages()
    b.stats.print(options.verbose, ok)

    // Sources actually loaded, plus #embed targets.
    files.clear()
    each b.cache.loaded_files as _, path : files.append(path, true)
    each b.watch_files as path : files.append(path, true)
    each files as path : modtimes.set(path, helper.modified_time(path) !? 0)

    dirs.clear()
    each b.lists.namespaces as ns {
        let dir = ns.dir
        if isset(dir) : dirs.append(dir, true)
    }

    if !ok || !options.run_exe || options.mode != BUILDTYPE.exe : return null

    let path = b.options.path_out
    if !isset(path) : return null
    helper.msg("⚡", "Run: " + path)
    let p = core.Process.run(path, options.run_args, true) !? null
    if !isset(p) : helper.msg("❌", "Failed to run: " + path)
    return p
}

fn watch_wait_for_change(files: Array[String], dirs: Array[String], modtimes: Map[uint]) {
    let count = 0
    while true {
        if count++ % 4 == 0 {
            if watch_find_new_files(files, dirs, modtimes) : return
        }
        each files as file {
            let mod = helper.modified_time(file) ! {
                helper.msg("ℹ️", "File removed: " + file)
                return
            }
            if mod != (modtimes.get(file) !? 0) : return
        }
        time.sleep_ms(500)
    }
}

// True when a watched directory gained a .valk file the last build never saw.
fn watch_find_new_files(files: Array[String], dirs: Array[String], modtimes: Map[uint]) bool {
    let found = false
    each dirs as dir {
        let dir_files = fs.files_in(dir, false, true, false) !? Array[String]{}
        each dir_files as path {
            if !path.ends_with(".valk") : continue
            if files.contains(path) : continue
            helper.msg("ℹ️", "New file: " + path)
            files.append(path)
            modtimes.set(path, helper.modified_time(path) !? 0)
            found = true
        }
    }
    return found
}

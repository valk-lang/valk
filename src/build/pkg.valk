use helper
use valk.fs
use valk.json

class Pkg {
    build: Build
    dir: ?String (null)
    srcdir: ?String (null)
    config: ?helper.Config (null)
    name: String ("main")
    // Package whose dependency config declared the name this one was loaded as
    parent: ?Pkg (null)
    // `"parse": "all"` in the config that loads this package: every body is parsed and
    // checked, not only what the program reaches
    parse_all: bool (false)
    namespaces: Map[Namespace] (.{})
    // Dependency packages loaded from this package (by dependency name)
    sub_pkgs: Map[Pkg] (.{})
    scope: Scope

    static fn new(b: Build, dir: String) Pkg !Error {
        dir = helper.resolve(dir)

        let srcdir = helper.add(dir, "src")
        let config_path = helper.add(dir, "valk.json")
        let config = helper.Config.load(config_path) ! {
            b.error("Invalid JSON in '" + config_path + "': " + E.message + " (byte " + E.at_index + ")")
        }
        if isset(config) {
            validate_config(b, config) !>
            check_valk_min(b, config, dir)
            let src = config.json.get("src")
            match src {
                String as path => srcdir = helper.resolve(helper.add(dir, path))
                default => {}
            }
        }

        let pkg = Pkg {
            build: b
            dir: dir
            srcdir: srcdir
            config: config
            scope: b.scope.sub_scope()
        }
        pkg.load_config_defs()
        b.cache.package_dirs.set(dir, pkg)
        return pkg
    }

    fn load_config_defs() {
        let config = this.config ?! return
        let defs = config.json.get("define").object.values
        each defs as value, name {
            match value {
                bool as enabled => this.build.set_macro_def_bool_in(this.scope, name, enabled)
                String as text => this.build.set_package_def_value_in(this.scope, name, text)
                default => {}
            }
        }
        this.build.set_cli_macro_defs_in(this.scope)
    }

    // Package with no filesystem root (used when building loose files outside a valk.json package).
    static fn new_main(b: Build) Pkg {
        return Pkg {
            build: b
            name: "main"
            scope: b.scope.sub_scope()
        }
    }

    // True if path is the package source root or a path inside it.
    fn contains_path(path: String) bool {
        path = helper.resolve(path)
        let srcdir = this.srcdir
        if !isset(srcdir) : return false
        if path == srcdir : return true
        return path.starts_with(srcdir + fs.PATH_DIV)
    }

    // True if `name` is a dependency package (or the built-in `valk` / `main` packages).
    fn pkg_exists(name: String) bool {
        if name == "valk" || name == "main" : return true
        let config = this.config
        if !isset(config) : return false
        return config.has_pkg(name)
    }

    // Resolve the filesystem directory for a dependency package name.
    fn sub_pkg_dir(name: String) String !Error {
        if name == "valk" : return helper.valk_lib_dir()

        let config = this.config
        if !isset(config) {
            this.build.error("Cannot load package '" + name + "', missing config file")
        }
        let d = config.get_package_dir(name) ! {
            if E.code == E.nosrc : this.build.error("The package named '" + name + "' has no valid 'src' defined in your dependencies")
            if E.code == E.noversion : this.build.error("The package named '" + name + "' has no valid 'version' defined in your dependencies")
            if E.code == E.invalidsrc : this.build.error(E.msg)
            this.build.error("No package named '" + name + "' found in your dependencies")
        }
        if !fs.exists(d) {
            this.build.error("Have you installed all your dependencies? Package directory not found: " + d)
        }
        return d
    }

    // Load a dependency package by name (sub-package of this package).
    // A namespace of this package, loaded or not: the directory or the file the
    // loader would read for that name.
    fn has_local_namespace(name: String) bool {
        if this.namespaces.has(name) : return true
        let src = this.srcdir
        if !isset(src) : return false
        if fs.is_dir(helper.add(src, name)) : return true
        return fs.exists(helper.add(src, name + ".valk"))
    }

    // Identity used in generated symbol names and type keys. Two dependencies
    // that share an alias but live in different directories are different
    // packages, so a package under the main package keeps its path relative to
    // it and a package outside it keeps the chain of dependency names that
    // reached it. Both forms avoid the checkout location, and the built-in
    // library is a singleton, so it always keeps its name.
    fn identity() String {
        if this.name == "valk" : return this.name
        let main = this.build.main_pkg
        if !isset(main) : return this.name
        let root = main.dir
        let dir = this.dir
        if !isset(root) || !isset(dir) : return this.name
        let prefix = root + fs.PATH_DIV
        if dir.starts_with(prefix) : return "." + fs.PATH_DIV + dir.range(prefix.length, dir.length - prefix.length)
        let parent = this.parent
        if !isset(parent) : return this.name
        return parent.identity() + fs.PATH_DIV + this.name
    }

    fn load_sub_pkg(name: String) Pkg !Error {
        if name == "main" {
            return this.build.main_pkg ?! this.build.error("Missing 'main' package (bug)")
        }

        this.sub_pkgs.get(name) -> existing : return existing

        let dir = this.sub_pkg_dir(name) !>
        dir = helper.resolve(dir)

        // Reuse package if this directory was already loaded under another name/path.
        this.build.cache.package_dirs.get(dir) -> existing {
            this.sub_pkgs.set(name, existing)
            if existing.name == "main" || name == "valk" : existing.name = name
            if !isset(existing.parent) : existing.parent = this
            if this.config_parses_all(name) : existing.parse_all = true
            return existing
        }

        let pkg = Pkg.new(this.build, dir) !>
        pkg.name = name
        pkg.parent = this
        pkg.parse_all = this.config_parses_all(name)
        this.sub_pkgs.set(name, pkg)
        return pkg
    }

    // Whether this package's config asks for every body of the dependency `name` to be
    // parsed: `"dependencies": { name: { "parse": "all" } }`, or `"valk": { "parse": "all" }`
    // for the standard library
    fn config_parses_all(name: String) bool {
        let config = this.config ?! return false
        let entry = name == "valk" ? config.json.get("valk") : config.json.get("dependencies").get(name)
        return (entry.get("parse").string_value() !? "") == "all"
    }

    fn load_all_namespaces() !Error {
        let srcdir = this.srcdir
        if !isset(srcdir) : return
        this.load_namespace("main", false) !>
        let dirs = fs.files_in(srcdir, true, false, true, true) ! this.build.error("Failed to list package directory: " + srcdir)
        each dirs as dir {
            this.load_namespace(dir, false) !>
        }
    }

    // Resolve namespace and load its source files into the pipeline.
    fn load_namespace(name: String, must_exist: bool (true)) Namespace !Error {
        let ns = this.get_namespace(name, must_exist) !>
        ns.load_files() !>
        return ns
    }

    // Where the namespace `name` lives: config.namespaces, else {srcdir}/{name}; null
    // without a source directory
    fn namespace_dir(name: String) ?String {
        let srcdir = this.srcdir
        if !isset(srcdir) : return null
        let dir: String = (name == "main") ? srcdir : helper.add(srcdir, name)
        let config = this.config
        let pkg_dir = this.dir
        if isset(config) && isset(pkg_dir) {
            let rel = config.get_nsc_dir(name)
            if isset(rel) : dir = helper.resolve(helper.add(pkg_dir, rel))
        }
        return dir
    }

    fn get_namespace(name: String, must_exist: bool (true)) Namespace !Error {
        this.namespaces.get(name) -> ns : return ns

        let srcdir = this.srcdir
        if !isset(srcdir) {
            if name == "main" {
                let ns = Namespace {
                    pkg: this
                    name: name
                    build: this.build
                    scope: this.scope.sub_scope()
                }
                this.namespaces.set(name, ns)
                this.build.lists.namespaces.append(ns)
                return ns
            }
            this.build.error("You cannot load a namespace without having a `valk.json` config. This config defines where your namespaces are located. Default location: {config-dir}/src/{namespace}")
        }

        let dir = this.namespace_dir(name) ?? srcdir
        if must_exist && !fs.is_dir(dir) {
            this.build.error("Cannot find the '" + name + "' namespace directory: " + dir)
        }

        let ns = Namespace {
            pkg: this
            name: name
            build: this.build
            dir: dir
            scope: this.scope.sub_scope()
        }
        this.namespaces.set(name, ns)
        this.build.lists.namespaces.append(ns)
        return ns
    }
}

// Check the field types the compiler reads from valk.json.
fn validate_config(b: Build, config: helper.Config) !Error {
    let root = config.json
    if root.kind != json.Kind.object : b.error("Invalid config '" + config.path + "': expected a JSON object at the top level")
    config_expect(b, config, "src", root.get("src"), json.Kind.string) !>
    config_expect(b, config, "define", root.get("define"), json.Kind.object) !>
    config_expect(b, config, "namespaces", root.get("namespaces"), json.Kind.object) !>
    config_expect(b, config, "targets", root.get("targets"), json.Kind.object) !>
    let deps = root.get("dependencies")
    config_expect(b, config, "dependencies", deps, json.Kind.object) !>
    each deps.object.values as dep, name {
        config_expect(b, config, "dependencies." + name, dep, json.Kind.object) !>
        config_expect_parse(b, config, "dependencies." + name + ".parse", dep.get("parse")) !>
    }
    let vars = root.get("vars")
    config_expect(b, config, "vars", vars, json.Kind.object) !>
    each vars.object.values as value, name {
        config_expect_text_or_list(b, config, "vars." + name, value) !>
    }

    let make = root.get("make")
    config_expect(b, config, "make", make, json.Kind.object) !>
    each make.object.values as target, name {
        // A target is a line to run, a list of lines, or an object that says more
        if target.kind == json.Kind.string || target.kind == json.Kind.array {
            config_expect_lines(b, config, "make." + name, target) !>
            continue
        }
        config_expect(b, config, "make." + name, target, json.Kind.object) !>
        config_expect(b, config, "make." + name + ".dir", target.get("dir"), json.Kind.string) !>
        config_expect(b, config, "make." + name + ".args", target.get("args"), json.Kind.string) !>
        config_expect_lines(b, config, "make." + name + ".cmd", target.get("cmd")) !>
        config_expect_text_or_list(b, config, "make." + name + ".needs", target.get("needs")) !>
        config_expect_bool(b, config, "make." + name + ".global", target.get("global")) !>
    }

    let require = root.get("require")
    config_expect(b, config, "require", require, json.Kind.object) !>
    config_expect(b, config, "require.valk", require.get("valk"), json.Kind.object) !>
    config_expect(b, config, "require.valk.min", require.get("valk").get("min"), json.Kind.string) !>

    let stdlib = root.get("valk")
    config_expect(b, config, "valk", stdlib, json.Kind.object) !>
    config_expect_parse(b, config, "valk.parse", stdlib.get("parse")) !>
    each root.get("namespaces").object.values as dir, name {
        config_expect(b, config, "namespaces." + name, dir, json.Kind.string) !>
    }
}

// `"require": { "valk": { "min": "0.7.7" } }` newer than this compiler is a warning, not an
// error: the package may still build, and the warning explains it when it does not
fn check_valk_min(b: Build, config: helper.Config, dir: String) {
    let min = config.json.get("require").get("valk").get("min").string_value() !? ""
    if min.is_empty() : return
    let name = config.json.get("name").string_value() !? fs.basename(dir)
    if !isset(version_is_older(min, min)) {
        b.warn("Package '" + name + "' has an invalid 'require.valk.min' version: " + min)
        return
    }
    // A compiler built without a release version has nothing to compare
    let older = version_is_older(VERSION, min) ?! return
    if older {
        b.message("Package '" + name + "' requires valk " + min + " or newer, this is valk " + VERSION).with_code("valk-min").warn()
    }
}

// Whether version `a` is older than `b`; null when one of them is not `major.minor.patch`
fn version_is_older(a: String, b: String) ?bool {
    let x = a.split(".")
    let y = b.split(".")
    if x.length != 3 || y.length != 3 : return null
    each 0 .. 3 as i {
        let p = x[i].to(uint) ! return null
        let q = y[i].to(uint) ! return null
        if p != q : return p < q
    }
    return false
}

// `"parse"` chooses how much of a dependency is parsed: `"used"` (the default) only what
// the program reaches, `"all"` every body
fn config_expect_parse(b: Build, config: helper.Config, key: String, value: json.Value) !Error {
    if value.kind == json.Kind.null : return
    config_expect(b, config, key, value, json.Kind.string) !>
    let mode = value.string_value() !? ""
    if mode == "all" || mode == "used" : return
    b.error("Invalid config '" + config.path + "': '" + key + "' must be \"used\" or \"all\", got \"" + mode + "\"")
}

// A value that is a string, or a list of strings
fn config_expect_text_or_list(b: Build, config: helper.Config, key: String, value: json.Value) !Error {
    if value.kind == json.Kind.null || value.kind == json.Kind.string : return
    if value.kind == json.Kind.array {
        each value.array.values as item, i {
            config_expect(b, config, key + "." + i, item, json.Kind.string) !>
        }
        return
    }
    b.error("Invalid config '" + config.path + "': '" + key + "' must be a string or a list of strings, got " + value.kind_name())
}

// The lines of a command: a line, a list of lines, or a line written per platform
fn config_expect_lines(b: Build, config: helper.Config, key: String, value: json.Value) !Error {
    if value.kind == json.Kind.null || value.kind == json.Kind.string : return
    if value.kind == json.Kind.object {
        config_expect_platforms(b, config, key, value) !>
        return
    }
    if value.kind == json.Kind.array {
        each value.array.values as item, i {
            if item.kind == json.Kind.object {
                config_expect_platforms(b, config, key + "." + i, item) !>
                continue
            }
            config_expect(b, config, key + "." + i, item, json.Kind.string) !>
        }
        return
    }
    b.error("Invalid config '" + config.path + "': '" + key + "' must be a line, a list of lines, or a line per platform, got " + value.kind_name())
}

fn config_expect_platforms(b: Build, config: helper.Config, key: String, value: json.Value) !Error {
    let known = Array[String]{ "default", "linux", "macos", "win", "linux-x64", "linux-arm64", "macos-x64", "macos-arm64", "win-x64" }
    each value.object.values as line, name {
        config_expect(b, config, key + "." + name, line, json.Kind.string) !>
        if known.contains(name) : continue
        b.error("Invalid config '" + config.path + "': '" + key + "' has no platform '" + name + "'. It takes: " + known.join(", "))
    }
}

fn config_expect_bool(b: Build, config: helper.Config, key: String, value: json.Value) !Error {
    if value.kind == json.Kind.null || value.kind == json.Kind.bool : return
    b.error("Invalid config '" + config.path + "': '" + key + "' must be true or false, got " + value.kind_name())
}

fn config_expect(b: Build, config: helper.Config, key: String, value: json.Value, kind: json.Kind) !Error {
    if value.kind == json.Kind.null || value.kind == kind : return
    let expected = kind == json.Kind.string ? "string" : "object"
    b.error("Invalid config '" + config.path + "': '" + key + "' must be a JSON " + expected + ", got " + value.kind_name())
}


class Extend {
    // Target class — set when the extend is resolved
    class: ?Class (null)
    ns: Namespace
    exp: Exp
    // File scope where the extend was written (lookup of Class id already done)
    scope: Scope
    // Remapped generic param names for the body (`extend B[X]` → ["X"])
    generic_names: ?Array[String] (null)
    body: ?Exp (null)
}

// Defer resolution until classes (and aliases) exist.
fn parse_extend_exp(ns: Namespace, u: Unit, scope: Scope, exp: Exp) !Error {
    let e = Extend {
        ns: ns
        exp: exp
        scope: scope
        body: exp.get(EXTEND_EXP.body)
    }
    // Stash generics body for resolve; names parsed once the class is known
    let gens = exp.get(EXTEND_EXP.generics)
    if isset(gens) {
        let unresolved_body = e.body
        if isset(unresolved_body) : u.unresolved_generic_bodies.append(unresolved_body)
        // Parsed early so resolve only validates count against the class
        e.generic_names = parse_class_generic_names(gens) !>
    }
    ns.build.pipeline.parse_extends.append(e)
}

// Resolve target class and attach this extend to `class.extends`.
fn resolve_extend(e: Extend) !Error {
    let exp = e.exp
    let id = exp.get(EXTEND_EXP.id)
    if !isset(id) : exp.bug("Extend is missing class id")

    let idf = resolve_idf_from_id(id, e.scope) !>
    if idf.type != IDF.class {
        id.error("Identifier does not represent a class")
    }
    let class = idf.class
    if !isset(class) : id.bug("Class idf is missing class")

    let base_names = class.generic_names
    let g_names = e.generic_names
    if isset(base_names) {
        if !isset(g_names) {
            exp.error("Generic class '" + class.name + "' requires type parameter names in extend (e.g. extend " + class.name + "[T] { ... })")
        }
        if g_names.length != base_names.length {
            exp.error("Generic class '" + class.name + "' expects " + base_names.length + " type parameter name(s), got " + g_names.length)
        }
    } else if isset(g_names) {
        exp.error("Class '" + class.name + "' is not generic")
    }

    // The bracket declares the parameter names the body uses, positionally; a
    // concrete type there would bind a name and extend every instantiation.
    if isset(g_names) {
        each g_names as name {
            let known = e.scope.get_idf(name)
            if !isset(known) : continue
            if known.type == IDF.decl || known.type == IDF.func : continue
            exp.error("'extend' brackets declare the parameter names used in the body, so '"
                + name + "' cannot be an existing type. Use a name that is not a type, such as 'T'")
        }
    }

    e.class = class
    class.extends.append(e)

    // A specialization made before this extend was attached (a `type` alias naming
    // `Array[X]` resolves before the extend stage) parsed its members already: give it
    // the extend's methods now, as `specialize` does for the extends it finds
    let cache = class.generic_cache
    if !isset(cache) : return
    // Parsing an extend's signatures can create specializations, which then already
    // include this extend; only the ones that exist now need it
    let existing = cache.values()
    each existing as gclass {
        if gclass.props_pending : continue
        parse_class_extend(gclass, e) !>
        each gclass.funcs as f : parse_func_types(f) !>
        each gclass.groups as g {
            each g.funcs as f : parse_func_types(f) !>
        }
    }
}

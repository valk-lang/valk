
class Extend {
    // Target class — set when the extend is resolved
    class: ?Class (null)
    ns: Namespace
    exp: Exp
    // File scope where the extend was written (lookup of Class id already done)
    scope: Scope
    // Remapped generic param names for the body (`extend B[X]` → ["X"])
    generic_names: ?Array[String] (null)
    body: ?Exp (null)
}

// Defer resolution until classes (and aliases) exist.
fn parse_extend_exp(ns: Namespace, u: Unit, scope: Scope, exp: Exp) !Error {
    let e = Extend {
        ns: ns
        exp: exp
        scope: scope
        body: exp.get(EXTEND_EXP.body)
    }
    // Stash generics body for resolve; names parsed once the class is known
    let gens = exp.get(EXTEND_EXP.generics)
    if isset(gens) {
        // Parsed early so resolve only validates count against the class
        e.generic_names = parse_class_generic_names(gens) !>
    }
    ns.build.pipeline.parse_extends.append(e)
}

// Resolve target class and attach this extend to `class.extends`.
fn resolve_extend(e: Extend) !Error {
    let exp = e.exp
    let id = exp.get(EXTEND_EXP.id)
    if !isset(id) : exp.bug("Extend is missing class id")

    let idf = resolve_idf_from_id(id, e.scope) !>
    if idf.type != IDF.class {
        id.error("Identifier does not represent a class")
    }
    let class = idf.class
    if !isset(class) : id.bug("Class idf is missing class")

    let base_names = class.generic_names
    let g_names = e.generic_names
    if isset(base_names) {
        if !isset(g_names) {
            exp.error("Generic class '" + class.name + "' requires type parameter names in extend (e.g. extend " + class.name + "[T] { ... })")
        }
        if g_names.length != base_names.length {
            exp.error("Generic class '" + class.name + "' expects " + base_names.length + " type parameter name(s), got " + g_names.length)
        }
    } else if isset(g_names) {
        exp.error("Class '" + class.name + "' is not generic")
    }

    e.class = class
    class.extends.append(e)
}

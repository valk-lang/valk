////////////////////////////
// Class initializers
////////////////////////////

class ClassInitItems {
    fields: Array[Exp] (.{})
    field_scopes: Array[Scope] (.{})
    elems: Array[Exp] (.{})
    pairs: Array[Exp] (.{})
}

fn property_loop_type(scope: Scope, name: String, at: Exp) Type !Error {
    let idf = scope.get_idf(name)
    if !isset(idf) : at.error("Unknown type in '#loop properties': " + name)
    if idf.type == IDF.type {
        let t = idf.of_type
        if !isset(t) : at.bug("Type idf is missing of_type")
        return t
    }
    if idf.type == IDF.class {
        let class = idf.class
        if !isset(class) : at.bug("Class idf is missing Class")
        return class.get_type() !>
    }
    if idf.type == IDF.property {
        let prop = idf.prop
        if !isset(prop) : at.bug("Property idf is missing Prop")
        return prop.type
    }
    at.error("Identifier is not a type in '#loop properties': " + name)
}

fn class_init_find_loop_end(items: Exp, start: uint, at: Exp) uint !Error {
    let depth: uint = 0
    let i = start + 1
    while true {
        let item = items.get(i)
        if !isset(item) : at.error("Missing '#end' for '#loop properties'")
        if item.type == EXP.macro {
            let kind = item.kind.@cast(MACRO_KIND)
            if kind == MACRO_KIND.loop || kind == MACRO_KIND.if {
                depth++
            } else if kind == MACRO_KIND.end {
                if depth == 0 : return i
                depth--
            }
        }
        i++
    }
}

fn append_class_init_item_range(out: ClassInitItems, items: Exp, start: uint, end: uint, scope: Scope, ctx: Context) !Error {
    let state = ParseState.new()
    let i = start
    while i < end {
        let item = items.get(i)
        if !isset(item) : break
        if item.type == EXP.macro {
            let kind = item.kind.@cast(MACRO_KIND)
            if kind == MACRO_KIND.loop && !state.is_skipping() {
                let close = class_init_find_loop_end(items, i, item) !>
                let words = item.list
                if !isset(words) {
                    item.error("Expected '#loop properties TYPE as PROPERTY' or '#loop object VALUE as PROPERTY'")
                }
                let loop_kind = words.get(0) !? ""
                if words.length != 4 || (words.get(2) !? "") != "as" {
                    item.error("Expected '#loop properties TYPE as PROPERTY' or '#loop object VALUE as PROPERTY'")
                }
                let prop_name = words.get(3) ! item.bug("Missing property-loop binding")

                if loop_kind == "object" {
                    let value_name = words.get(1) ! item.bug("Missing object-loop value")
                    let idf = scope.get_idf(value_name) ?! item.error("Expected a variable after '#loop object'")
                    if idf.type != IDF.decl {
                        item.error("Expected a variable after '#loop object'")
                    }
                    let decl = idf.decl
                    if !isset(decl) : item.bug("Object-loop variable is missing its declaration")
                    let owner_class = decl.type.get_non_nullable().get_class_or_null()
                    if isset(owner_class) {
                        let owner = vgen_decl(decl)
                        each owner_class.props as prop {
                            let iter_scope = scope.sub_scope()
                            iter_scope.func = scope.func
                            iter_scope.set_idf(prop_name, Idf.for_object_property(prop, vgen_prop(prop, owner, ctx)))
                            append_class_init_item_range(out, items, i + 1, close, iter_scope, ctx) !>
                        }
                    }
                    i = close + 1
                    continue
                }
                if loop_kind != "properties" {
                    item.error("Unknown '#loop' kind in a class initializer: " + loop_kind)
                }
                let type_name = words.get(1) ! item.bug("Missing property-loop type")
                let type = property_loop_type(scope, type_name, item) !>
                let class = type.get_non_nullable().get_class_or_null()
                if isset(class) {
                    each class.props as prop {
                        let iter_scope = scope.sub_scope()
                        iter_scope.func = scope.func
                        iter_scope.set_idf(prop_name, Idf.for_property(prop))
                        append_class_init_item_range(out, items, i + 1, close, iter_scope, ctx) !>
                    }
                }
                i = close + 1
                continue
            }
            let func = ctx.get_func() !>
            parse_macro_exp(func.ns, scope, state, item) !>
            i++
            continue
        }
        if state.is_skipping() {
            i++
            continue
        }
        let ik = item.number.@cast(CLASS_INIT_ITEM)
        if ik == CLASS_INIT_ITEM.field || item.str1.length > 0 {
            out.fields.append(item)
            out.field_scopes.append(scope)
        } else if ik == CLASS_INIT_ITEM.pair {
            out.pairs.append(item)
        } else if ik == CLASS_INIT_ITEM.elem {
            out.elems.append(item)
        } else {
            item.error("Invalid class init item")
        }
        i++
    }
    if state.has_open_if() || state.is_skipping() {
        items.error("Missing '#end' inside class initializer")
    }
}

fn value_from_class_init_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let body = exp.get(VALUE_EXP.right)
    if !isset(body) : exp.bug("class_init is missing body")
    if body.type != EXP.body : exp.bug("class_init body must be EXP.body")

    let left_exp = exp.get(VALUE_EXP.left)
    let suggested = ctx.suggested_type
    if !isset(left_exp) && isset(suggested) {
        let suggested_nn = suggested.get_non_nullable()
        // A literal for shared or locked data is built as ordinary data and then converted,
        // which copies what it was given from elsewhere
        let plain = suggested.plain_type()
        if (suggested_nn.is_shared || suggested_nn.is_locked) && plain != suggested && suggested.has_gc_refs() {
            let built = value_from_class_init_exp(exp, scope, ctx.with_suggested_type(plain)) !>
            return value_try_convert(built, scope, ctx, suggested) !>
        }
        // `.{ a, b }` for a `local &[T]` destination (an argument, usually): the
        // elements fill an inline `[T x N]` that the frame lends for the call
        if suggested_nn.kind == TYPE.ref_slice && suggested_nn.is_local {
            let element = suggested_nn.get_sub_type()
            if isset(element) {
                let elems = parse_body_as_array_init_elements(body) !>
                let count: uint = 0
                while true {
                    let elem = elems.get(count)
                    if !isset(elem) : break
                    if elem.type == EXP.value && elem.value_kind == VALUE_KIND.repeat {
                        elem.error("A repeated value needs a size; write '[T x N]{ v... }' and pass that")
                    }
                    count++
                }
                if count == 0 : exp.error("An empty '.{}' has no storage to borrow; pass an empty array or a '[T x 0]' value")
                return value_from_array_init_body(exp, body, element.fixed_array(count), scope, ctx) !>
            }
        }
        if suggested_nn.kind == TYPE.adr_of || suggested_nn.is_bare_borrow() {
            exp.error("'.{}' cannot initialize a borrowed reference; initialize an inline value and borrow it with '&'")
        }
        if suggested_nn.is_struct_object() {
            let class = suggested_nn.get_direct_class_or_null()
            let name = isset(class) ? class.pretty_name() : "T"
            exp.error("'.{}' cannot initialize a pointer; use mem.new[" + name + "]() for manual heap allocation")
        }
    }

    if !isset(left_exp) && !exp.bool1 && !ctx.is_direct_init {
        exp.error("A bare '{ ... }' initializer requires direct destination storage; use '.{ ... }' in expression contexts")
    }
    let class: ?Class = null
    let rett: ?Type = null
    let left_val: ?Value = null

    if isset(left_exp) && left_exp.type == EXP.type {
        rett = type_from_exp(left_exp, scope) !>
        if rett.is_fixed_array_type() {
            return value_from_array_init_body(exp, body, rett, scope, ctx) !>
        }
        // A literal always has a value: `T { .. }` with `T` = `?S` builds an `S`
        rett = rett.get_non_nullable()
        class = rett.get_class_or_null()
        if !isset(class) : exp.error("Class init requires a class or struct type before '{'")
    }

    // `.code { field: value, ... }` — error payload construction, not a class/struct init.
    if isset(left_exp) && left_exp.type == EXP.value && left_exp.value_kind == VALUE_KIND.typehint_member {
        return value_from_error_payload_init_exp(exp, scope, ctx, left_exp) !>
    }

    // Bare `{ … }` with a suggested fixed array → element list (positional only)
    if !isset(left_exp) {
        let suggested_type = ctx.suggested_type
        if isset(suggested_type) {
            let atype = suggested_type.get_non_nullable()
            if atype.is_fixed_array_type() {
                return value_from_array_init_body(exp, body, suggested_type, scope, ctx) !>
            }
        }
    }

    if isset(left_exp) {
        if left_exp.type != EXP.type {
            left_val = value_from_exp(left_exp, scope, ctx.without_suggested_type()) !>
        }
        // `E { field: value, ... }` — rethrow keeping E's runtime code, patch payload.
        if isset(left_val) {
            let left_et_t = left_val.rett.get_non_nullable()
            if left_et_t.kind == TYPE.error_code && left_et_t.error_is_instance {
                return value_from_error_rethrow_payload_exp(exp, scope, ctx, left_val) !>
            }
            class = left_val.as_class_for_init()
            if !isset(class) {
                exp.error("Class init requires a class or struct type before '{'")
            }
            if left_val.type == VAL.type {
                let explicit = left_val.get_of_type()
                if isset(explicit) : rett = explicit.get_non_nullable()
            }
        }
    } else {
        // Bare `{ fields }` — need a suggested type (assign / prop field / arg / return)
        let suggested_type = ctx.suggested_type
        if !isset(suggested_type) {
            exp.error("You cannot use '{' here. It can only be used for defining the starting value for inline types. E.g. let myvar: [u8 x 2] = { 6, 7 }")
        }
        // Suggested class type (e.g. Array[String] default `.{}`) — hook/field init
        let suggested_class = suggested_type.get_non_nullable().get_class_or_null()
        if isset(suggested_class) {
            class = suggested_class
            rett = suggested_type.get_non_nullable()
        } else {
            class = class_from_inline_init_type(suggested_type)
            if !isset(class) {
                exp.error("The '{' token can only be used to define initialization values for inline struct, fixed arrays, or class types. Not for: " + suggested_type.compat_display_name())
            }
            // Keep the suggested type (e.g. `IIS1`) so assign/compat match without extra convert
            rett = suggested_type
        }
    }

    let target_class = class ?! exp.bug("Class initializer has no resolved class")
    let items_exp, count_exp = parse_body_as_slice_init(body) !>
    let expanded = ClassInitItems {}
    append_class_init_item_range(expanded, items_exp, 0, 4294967295, scope, ctx) !>
    let elem_exps = expanded.elems
    let pair_exps = expanded.pairs
    let field_exps = expanded.fields

    let has_fields = field_exps.length > 0
    let has_elems = elem_exps.length > 0
    let has_pairs = pair_exps.length > 0
    if has_fields && (has_elems || has_pairs) {
        exp.error("Cannot mix property fields with list/map entries in the same class init")
    }
    if has_elems && has_pairs {
        exp.error("Cannot mix list entries and map entries (`=>`) in the same class init")
    }

    if target_class.is_generic_base {
        exp.error("Generic type '" + target_class.name + "' requires type arguments")
    }
    if target_class.kind == CLASS_KIND.interface {
        exp.error("Interfaces cannot be constructed directly")
    }
    if !isset(rett) {
        rett = target_class.get_type() !>
    } else if rett.get_non_nullable().is_shared {
        rett = target_class.get_type() !>
    }
    let init_class = target_class
    while init_class.kind == CLASS_KIND.mode {
        let for_class = init_class.mode_for_class
        if !isset(for_class) : exp.bug("Mode target is unresolved during class initialization")
        init_class = for_class
    }

    // Field-only (or empty) structural / default construct
    if !has_elems && !has_pairs {
        let fvals = HashMap[Prop, Value]{}
        // An object built from shared or locked parts is a view of those parts: 1 shared, 2 locked
        let literal_view: u8 = 0
        each field_exps as fexp, field_i {
            let field_scope = expanded.field_scopes.get(field_i) ! exp.bug("Missing class-init field scope")
            let fname = fexp.str1
            let field_idf = field_scope.get_idf(fname)
            let prop: ?Prop = null
            if isset(field_idf) && field_idf.type == IDF.property {
                let loop_prop = field_idf.prop
                if !isset(loop_prop) : fexp.bug("Property idf is missing Prop")
                let loop_name = loop_prop.name
                if isset(loop_name) {
                    fname = loop_name
                    prop = init_class.get_prop_by_name(loop_name) !? null
                } else if loop_prop.class == init_class {
                    prop = loop_prop
                }
            }
            if !isset(prop) : prop = init_class.get_prop_by_name(fname) !? null
            if !isset(prop) {
                fexp.error("There's no property named: '" + fname + "' on '" + init_class.pretty_name() + "'")
            }
            if fvals.has(prop) {
                fexp.error("Property '" + (prop.name ?? fname) + "' is already set in this class initializer")
            }
            if prop.is_slice_data : fexp.error("Slice data is computed and cannot be initialized")
            act_check(fexp, prop.act, prop.exp, true, "property") !>
            require_sequence_metadata_write(prop, fexp, field_scope) !>
            let vexp = fexp.get(VALUE_EXP.left)
            if !isset(vexp) : fexp.bug("class_init field is missing value")
            let field_type = prop.type
            let fv = value_from_exp(vexp, field_scope, ctx.with_suggested_type(field_type).for_direct_init()) !>
            let given = fv.rett.get_non_nullable()
            let given_view: u8 = given.is_locked || fv.rett.has_locked_refs() ? 2 : (given.is_shared ? 1 : 0)
            // A struct holding references is a view of its parts the same way
            let struct_view = rett.get_non_nullable().kind == TYPE.struct && rett.get_non_nullable().is_inline && rett.has_gc_refs()
            if given_view > 0 && (rett.is_gc_type() || struct_view) && !field_type.get_non_nullable().is_shared && !field_type.get_non_nullable().is_locked
                && field_type.storage_view_type(given_view == 2).compat(fv.rett) {
                if given_view > literal_view : literal_view = given_view
                fv = vgen_cast(fv, field_type)
                fv.exp = vexp
            }
            if fv.type != VAL.undefined {
                fv = value_try_convert(fv, field_scope, ctx, field_type) !>
                value_compat_check(field_type, fv, vexp) !>
                if fv.is_implicit_borrow() {
                    vexp.error("An implicit pointer borrow cannot be stored in an object: the address would outlive the value")
                }
                // A `$atomic` object is atomic data from the start: what it is given is published
                if init_class.atomic {
                    fv = value_publish_part(fv, ctx, field_scope, field_type.shared_type()) !>
                }
            }
            fvals.set(prop, fv)
        }

        let unzeroed_slice = false
        if init_class.kind == CLASS_KIND.slice {
            let elem = init_class.slice_type
            let data_prop = init_class.get_prop_by_name("data") !? null
            if isset(elem) && !elem.has_gc_refs() && isset(data_prop) {
                let dv = fvals.get(data_prop) !? null
                if isset(dv) && dv.type == VAL.undefined {
                    fvals.remove(data_prop)
                    unzeroed_slice = true
                }
            }
        }
        let built = class_init_construct(init_class, rett, fvals, scope, ctx, exp) !>
        if unzeroed_slice : built.bool_val = true
        if literal_view == 0 : return built
        return value_shared_view(built, rett.view_type(literal_view == 2))
    }

    // `Type{ v x n }`: the class's static `fill(count, value)`
    if isset(count_exp) {
        if has_pairs || has_fields || elem_exps.length != 1 {
            count_exp.error("'{ v x n }' repeats one value; list the entries without 'x n' instead")
        }
        let elem_exp = elem_exps.get(0) ! exp.bug("class init count without a value")
        return value_from_class_init_fill(target_class, rett, elem_exp, count_exp, scope, ctx, exp) !>
    }

    // List / map init: construct empty, then $append / $set_key
    return value_from_class_init_hooks(target_class, rett, elem_exps, pair_exps, scope, ctx, exp) !>
}

// `Array[T]{ v x n }` — calls the class's `static fn fill(count: uint, value: T)`
fn value_from_class_init_fill(class: Class, rett: Type, elem_exp: Exp, count_exp: Exp, scope: Scope, ctx: Context, at: Exp) Value !Error {
    let fill_f = class.get_func("fill")
    if !isset(fill_f) || !fill_f.is_static {
        at.error("Type '" + class.pretty_name() + "' has no static 'fill(count, value)' function (needed for '{ v x n }')")
    }
    if !fill_f.parsed_types : parse_func_types(fill_f) !>
    let uint_t = type_from_core(ctx.build, "uint") !>
    let count = value_from_exp(count_exp, scope, ctx.with_suggested_type(uint_t)) !>
    count = value_try_convert(count, scope, ctx, uint_t) !>
    uint_t.compat_check(count.rett, count_exp) !>
    let vexp = elem_exp.get(VALUE_EXP.left) ?! elem_exp.bug("element is missing its value")
    let vtype = class_hook_param_type(fill_f, 1)
    let vctx = isset(vtype) ? ctx.with_suggested_type(vtype) : ctx.without_suggested_type()
    let value = value_from_exp(vexp, scope, vctx) !>
    if isset(vtype) && !value.rett.is_void_type() : value = value_try_convert(value, scope, ctx, vtype) !>
    let callee = vgen_func(fill_f)
    let args = Array[Value]{ count, value }
    value_check_call_args(fill_f, callee, args, scope, ctx, at) !>
    let call = vgen_call(ctx, callee, args, fill_f.get_rett(), scope)
    call.exp = at
    if call.rett != rett && rett.compat(call.rett) : return vgen_wrap(call, rett)
    return call
}

// The core `slice &[T]` class specialized for one element type: the methods
// and the storage layout behind every bare `&[T]`.
fn bare_slice_class(b: Build, element: Type, at: Exp) Class !Error {
    let idf = valk_idf(b, "core", "&") !>
    let base = idf.class ?! at.bug("core '&' is not a class")
    return base.specialize(Array[Type]{ element }, at) !>
}

// A value typed as the `slice &[T]` class becomes the plain `mut &[T]` it is
fn value_retype_bare_slice(value: Value, rett: Type, at: Exp) Value {
    let retyped = vgen_cast(value, value.rett.is_nullable_type() ? rett.nullable() : rett)
    retyped.exp = at
    return retyped
}

// Zero-filled storage of `count` elements, owned by the result.
fn bare_slice_alloc(class: Class, rett: Type, count: Value, scope: Scope, ctx: Context, at: Exp, unzeroed: bool (false)) Value !Error {
    let fields = HashMap[Prop, Value]{}
    let length_prop = class.get_prop_by_name("length") ! at.bug("Bare slice class has no 'length'")
    fields.set(length_prop, count)
    let init = class_init_construct(class, class.get_type() !>, fields, scope, ctx, at) !>
    if unzeroed : init.bool_val = true
    return value_retype_bare_slice(init, rett, at)
}

// All-zero bytes are a valid value: numbers, and aggregates of them.
fn type_zero_is_valid(type: Type) bool {
    let t = type.get_non_nullable()
    if type.is_nullable_type() : return true
    return !t.has_gc_refs() && !t.is_pointer() && t.kind != TYPE.interface && t.kind != TYPE.closure
}

// `[T]{ a, b }` lists the elements, `[T]{ v x n }` repeats v n times,
// `[T]{ null x n }` leaves the storage zeroed and `[T]{ owner:, data:, length: }`
// describes existing storage. Every form is a fresh `mut &[T]`.
fn value_from_slice_init_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let b = ctx.build
    let type_exp = exp.get(VALUE_EXP.left) ?! exp.bug("slice_init is missing its element type")
    let body = exp.get(VALUE_EXP.right) ?! exp.bug("slice_init is missing its body")
    let element = type_from_exp(type_exp, scope) !>
    type_validate_sequence_element(element, type_exp) !>
    let class = bare_slice_class(b, element, exp) !>
    let class_type = class.get_type() !>
    let rett = element.ref_slice().mut_type()
    let uint_t = type_from_core(b, "uint") !>

    let items_exp, count_exp = parse_body_as_slice_init(body) !>
    let expanded = ClassInitItems {}
    append_class_init_item_range(expanded, items_exp, 0, 4294967295, scope, ctx) !>
    if expanded.pairs.length > 0 : exp.error("A slice has no map entries")
    let elems = expanded.elems
    let fields = expanded.fields

    if fields.length > 0 {
        if elems.length > 0 : exp.error("Cannot mix fields with list entries in a slice initializer")
        if isset(count_exp) : count_exp.error("A view over existing storage has no count; drop 'x n'")
        require_unsafe(exp, scope, "A view over existing storage") !>
        let fvals = HashMap[Prop, Value]{}
        // A view over shared or locked storage keeps that view
        let func = ctx.func
        let shared_view = isset(func) && func.is_shared_receiver
        let locked_view = isset(func) && func.is_locked_receiver
        each fields as fexp, i {
            let field_scope = expanded.field_scopes.get(i) ! exp.bug("Missing slice-init field scope")
            let name = fexp.str1
            if name != "owner" && name != "data" && name != "length" {
                fexp.error("A view is described by 'owner', 'data' and 'length', not '" + name + "'")
            }
            let prop = class.get_prop_by_name(name) ! fexp.bug("Bare slice class is missing '" + name + "'")
            if fvals.has(prop) : fexp.error("'" + name + "' is already set in this view")
            let vexp = fexp.get(VALUE_EXP.left) ?! fexp.bug("slice-init field is missing its value")
            let fv = value_from_exp(vexp, field_scope, ctx.with_suggested_type(prop.type).for_direct_init()) !>
            fv = value_try_convert(fv, field_scope, ctx, prop.type) !>
            let owner_t = fv.rett.get_non_nullable()
            if name == "owner" && (owner_t.is_shared || owner_t.is_locked) && prop.type.compat(fv.rett.plain_type()) {
                if owner_t.is_shared : shared_view = true
                else : locked_view = true
                fv = vgen_cast(fv, prop.type)
            }
            prop.type.compat_check(fv.rett, vexp) !>
            fvals.set(prop, fv)
        }
        if fvals.length != 3 : exp.error("A view over existing storage needs 'owner', 'data' and 'length'")
        let view = vgen_class_init(ctx, class, fvals, class_type, exp) !>
        let view_t = shared_view ? rett.shared_type() : (locked_view ? rett.locked_type() : rett)
        return value_retype_bare_slice(view, view_t, exp)
    }

    if isset(count_exp) {
        let count = value_from_exp(count_exp, scope, ctx.with_suggested_type(uint_t)) !>
        count = value_try_convert(count, scope, ctx, uint_t) !>
        uint_t.compat_check(count.rett, count_exp) !>
        if elems.length > 1 {
            exp.error("'[T]{ v x n }' repeats one value; list the elements without 'x n' instead")
        }
        let elem_exp = elems.get(0) ! exp.bug("slice count without a value")
        let vexp = elem_exp.get(VALUE_EXP.left) ?! elem_exp.bug("element is missing its value")
        let fill: ?Value = null
        let unzeroed = false
        if vexp.type == EXP.value && vexp.value_kind == VALUE_KIND.undefined && !element.has_gc_refs() {
            require_unsafe(exp, scope, "Uninitialized slice storage") !>
            unzeroed = true
        } else if vexp.type == EXP.value && vexp.value_kind == VALUE_KIND.null && !element.is_nullable_type() {
            // Zeroed storage: valid only when a zero slot is a valid element
            if !type_zero_is_valid(element) {
                require_unsafe(exp, scope, "Zeroed storage of '" + element.compat_display_name() + "' elements") !>
            }
        } else {
            let ev = value_from_exp(vexp, scope, ctx.with_suggested_type(element)) !>
            ev = value_try_convert(ev, scope, ctx, element) !>
            element.compat_check(ev.rett, vexp) !>
            // Fresh storage is already zero
            let is_zero = (ev.type == VAL.int && ev.int_val == 0) || (ev.type == VAL.float && ev.float_val == 0.0) || (ev.type == VAL.bool && !ev.bool_val) || ev.type == VAL.null
            if !is_zero : fill = ev
        }
        if !isset(fill) : return bare_slice_alloc(class, rett, count, scope, ctx, exp, unzeroed) !>
        let fill_f = class.get_func("fill") ?! exp.bug("Bare slice class has no 'fill'")
        if !fill_f.parsed_types : parse_func_types(fill_f) !>
        let callee = vgen_func(fill_f)
        let args = Array[Value]{ count, fill }
        value_check_call_args(fill_f, callee, args, scope, ctx, exp) !>
        let call = vgen_call(ctx, callee, args, fill_f.get_rett(), scope)
        call.exp = exp
        return value_retype_bare_slice(call, rett, exp)
    }

    let storage = bare_slice_alloc(class, rett, vgen_int(elems.length.to(int), uint_t), scope, ctx, exp, elems.length > 0 && !element.has_gc_refs()) !>
    if elems.length == 0 : return storage
    let write_f = class.get_func("write_init") ?! exp.bug("Bare slice class has no 'write_init'")
    if !write_f.parsed_types : parse_func_types(write_f) !>
    let setup = Array[Value]{}
    let rooted = value_bind_once(storage, ctx, exp, setup, true)
    each elems as eexp, i {
        let vexp = eexp.get(VALUE_EXP.left) ?! eexp.bug("element is missing its value")
        let ev = value_from_exp(vexp, scope, ctx.with_suggested_type(element)) !>
        ev = value_try_convert(ev, scope, ctx, element) !>
        element.compat_check(ev.rett, vexp) !>
        let receiver = vgen_cast(rooted, class_type)
        receiver.exp = exp
        let callee = vgen_func(write_f, receiver)
        let args = Array[Value]{ vgen_int(i.to(int), uint_t), ev }
        value_check_call_args(write_f, callee, args, scope, ctx, eexp) !>
        let call = vgen_call(ctx, callee, args, write_f.get_rett(), scope)
        call.exp = eexp
        setup.append(call)
    }
    let literal = vgen_scoped_value(setup, rooted, exp)
    literal.ensure_meta().literal_items = true
    return literal
}

// `Array[T]{ a, b }` / `Map[T]{ k => v }` — empty construct + hook calls.
fn value_from_class_init_hooks(class: Class, rett: Type, elem_exps: Array[Exp], pair_exps: Array[Exp], scope: Scope, ctx: Context, at: Exp) Value !Error {
    let construct = class_default_construct(class, rett, scope, ctx, at) !>
    // A struct is changed in place by its hooks, so it lives in a local every hook reaches;
    // the value itself would hand each hook a copy of its own
    let local: ?Decl = null
    let setup = Array[Value]{}
    if !construct.rett.is_gc_type() {
        let func = ctx.get_func() !>
        let decl = Decl.new(func, construct.rett, false, null)
        func.all_decls.append(decl)
        setup.append(vgen_assign(vgen_decl(decl), construct, ASSIGN_OP.set, ctx.build, at, ctx))
        local = decl
    }
    let chain = isset(local) ? vgen_decl(local) : class_init_hook_base(ctx, construct)

    let hooks = Array[Value]{}
    if elem_exps.length > 0 {
        let append_f = class.get_append_hook()
        if !isset(append_f) {
            at.error("Type '" + class.pretty_name() + "' has no '$append' hook (needed for list-style class init)")
        }
        act_check(at, append_f.act, append_f.exp, false, "function '" + append_f.name + "'") !>
        if !append_f.parsed_types : parse_func_types(append_f) !>
        each elem_exps as eexp {
            let vexp = eexp.get(VALUE_EXP.left)
            if !isset(vexp) : eexp.bug("element missing value")
            let ect = ctx.without_suggested_type()
            let atype = class_hook_param_type(append_f, 0)
            if isset(atype) : ect = ctx.with_suggested_type(atype)
            let ev = value_from_exp(vexp, scope, ect) !>
            if isset(atype) && !ev.rett.is_void_type() {
                ev = value_try_convert(ev, scope, ctx, atype) !>
            }
            let callee = isset(local) ? value_bind_method(append_f, class_init_local_receiver(local, eexp), ctx, eexp) : vgen_func(append_f, class_init_hook_receiver(chain))
            let args = Array[Value]{ ev }
            value_fill_trailing_defaults(append_f, call_receiver_skip(callee, append_f), args, scope, ctx, eexp) !>
            value_check_call_args(append_f, callee, args, scope, ctx, eexp) !>
            let call = vgen_call(ctx, callee, args, append_f.get_rett(), scope)
            call.exp = eexp
            hooks.append(call)
            // Chain when append returns SELF
            if class_init_hook_chains(chain, call, rett) : chain = call
        }
    } else {
        let set_f = class.get_set_key_hook()
        if !isset(set_f) {
            at.error("Type '" + class.pretty_name() + "' has no '$set_key' hook (needed for map-style class init)")
        }
        act_check(at, set_f.act, set_f.exp, false, "function '" + set_f.name + "'") !>
        if !set_f.parsed_types : parse_func_types(set_f) !>
        each pair_exps as pexp {
            let kexp = pexp.get(VALUE_EXP.left)
            if !isset(kexp) : pexp.bug("pair missing key")
            let vexp = pexp.get(VALUE_EXP.right)
            if !isset(vexp) : pexp.bug("pair missing value")
            let kt = class_hook_param_type(set_f, 0)
            let vt = class_hook_param_type(set_f, 1)
            let kctx = ctx.without_suggested_type()
            let vctx = ctx.without_suggested_type()
            if isset(kt) : kctx = ctx.with_suggested_type(kt)
            if isset(vt) : vctx = ctx.with_suggested_type(vt)
            let kv = value_from_exp(kexp, scope, kctx) !>
            let vv = value_from_exp(vexp, scope, vctx) !>
            if isset(kt) && !kv.rett.is_void_type() : kv = value_try_convert(kv, scope, ctx, kt) !>
            if isset(vt) && !vv.rett.is_void_type() : vv = value_try_convert(vv, scope, ctx, vt) !>
            let callee = isset(local) ? value_bind_method(set_f, class_init_local_receiver(local, pexp), ctx, pexp) : vgen_func(set_f, class_init_hook_receiver(chain))
            let args = Array[Value]{ kv, vv }
            value_fill_trailing_defaults(set_f, call_receiver_skip(callee, set_f), args, scope, ctx, pexp) !>
            value_check_call_args(set_f, callee, args, scope, ctx, pexp) !>
            let call = vgen_call(ctx, callee, args, set_f.get_rett(), scope)
            call.exp = pexp
            hooks.append(call)
            if class_init_hook_chains(chain, call, rett) : chain = call
        }
    }

    if isset(local) {
        setup.append_many(hooks)
        let result = vgen_decl(local)
        result.exp = at
        return vgen_scoped_value(setup, result, at)
    }
    let v = Value {
        type: VAL.class_init
        value1: chain
        values: hooks
        rett: rett
        exp: at
    }
    v.set_class_ref(class)
    return v
}

fn class_init_construct(class: Class, rett: Type, fields: HashMap[Prop, Value], scope: Scope, ctx: Context, at: Exp) Value !Error {
    let missing = Array[String]{}
    each class.props as prop {
        if prop.is_slice_data || fields.has(prop) : continue
        let field_type = prop.type
        let default_body = prop.default
        if prop.zero_default && !isset(default_body) : continue
        let field: ?Value = null
        let default_at = prop.exp
        if isset(default_body) {
            let default_exp = parse_body_as_value_exp(default_body) !>
            let default_scope = prop.class.scope.sub_scope()
            default_scope.func = scope.func
            field = value_from_exp(default_exp, default_scope, ctx.with_suggested_type(field_type).for_direct_init()) !>
            default_at = default_exp
        } else if type_has_generated_default(field_type, ctx.build) {
            field = value_generate_default(field_type, scope, ctx, prop.exp) !>
        } else {
            let name = prop.name
            if isset(name) : missing.append(name)
            continue
        }
        let value = field ?! prop.exp.bug("Property default did not produce a value")
        if value.type == VAL.undefined : continue
        value = value_try_convert(value, scope, ctx, field_type) !>
        field_type.compat_check(value.rett, default_at) !>
        fields.set(prop, value)
    }
    if missing.length > 0 : class_init_missing_fields_error(at, class, missing) !>
    return vgen_class_init(ctx, class, fields, rett, at) !>
}

fn class_init_missing_fields_error(at: Exp, class: Class, missing: Array[String]) !Error {
    let fields = ""
    each missing as name, i {
        if i > 0 : fields += ", "
        fields += "'" + name + "'"
    }
    let noun = missing.length == 1 ? "field" : "fields"
    at.error("Missing " + noun + " in class initializer for '" + class.pretty_name() + "': " + fields + ". Provide " + (missing.length == 1 ? "it" : "them") + ", or declare a default on the property")
}

// Empty instance used as the base for list/map hooks.
fn class_default_construct(class: Class, rett: Type, scope: Scope, ctx: Context, at: Exp) Value !Error {
    let init_class = class
    while init_class.kind == CLASS_KIND.mode {
        let for_class = init_class.mode_for_class
        if !isset(for_class) : at.bug("Mode target is unresolved during class initialization")
        init_class = for_class
    }
    return class_init_construct(init_class, rett, HashMap[Prop, Value]{}, scope, ctx, at) !>
}

// Param type of a method after implicit `this` (instance) or without (static).
fn class_hook_param_type(f: Func, i: uint) ?Type {
    let params = f.args
    let skip: uint = 0
    if isset(f.class) && !f.is_static : skip = 1 // this
    let pi = skip + i
    if pi >= params.length : return null
    let p = params.get(pi) !? null
    if !isset(p) : return null
    if p.is_generic : return null
    return p.type
}

// Bare `{ v0, v1, ... }` for fixed arrays — body re-parsed as element values.
fn value_from_array_init_body(exp: Exp, body: Exp, suggested_type: Type, scope: Scope, ctx: Context) Value !Error {
    let atype = suggested_type.get_non_nullable()
    let sub = atype.get_sub_type()
    if !isset(sub) : exp.bug("Array type is missing sub_type")
    let size = atype.length
    if size < 1 : exp.error("Array size is 0 (bug)")

    let elems_exp = parse_body_as_array_init_elements(body) !>
    let values = Array[Value]{}
    // `v...`: a single value fills the rest without being repeated per element
    let fill = false
    let i: uint = 0
    while true {
        let eexp = elems_exp.get(i)
        if !isset(eexp) : break
        if eexp.type == EXP.value && eexp.value_kind == VALUE_KIND.repeat {
            if values.length == 0 : eexp.error("No value to repeat")
            fill = values.length < size
            i++
            continue
        }
        if fill || values.length >= size {
            eexp.error("Too many values")
        }
        // One entry is one element; a tuple held as one value stays one element,
        // exactly like an element of a dynamic array
        let ev = value_from_exp(eexp, scope, ctx.with_suggested_type(sub).for_direct_init()) !>
        if ev.type != VAL.undefined {
            ev = value_try_convert(ev, scope, ctx, sub) !>
            let at = ev.exp
            if isset(at) : sub.compat_check(ev.rett, at) !>
            else : sub.compat_check(ev.rett, eexp) !>
            values.append(ev)
        }
        i++
    }
    if !fill && values.length < size {
        exp.error("Missing array values. Expected amount '" + size + "', but found '" + values.length + "'")
    }

    return vgen_array_init(ctx, values, suggested_type, exp, fill)
}

////////////////////////////
// Match
////////////////////////////

// Compare enum constants when their equality can be decided while compiling.
// -1 means unknown, keeping exhaustiveness conservative for values such as
// pointers whose identity is only known at runtime.
fn enum_match_values_equal(left: Value, right: Value) int {
    if left.type == VAL.int && right.type == VAL.int : return left.int_val == right.int_val ? 1 : 0
    if left.type == VAL.float && right.type == VAL.float : return left.float_val == right.float_val ? 1 : 0
    if left.type == VAL.bool && right.type == VAL.bool : return left.bool_val == right.bool_val ? 1 : 0
    if left.type == VAL.string && right.type == VAL.string : return left.get_string() == right.get_string() ? 1 : 0
    if left.type == VAL.null && right.type == VAL.null : return 1

    if left.type == VAL.array_init && right.type == VAL.array_init {
        let left_values = left.values
        let right_values = right.values
        if !isset(left_values) || !isset(right_values) : return -1
        if left.bool_val != right.bool_val : return -1
        if left_values.length != right_values.length : return 0
        each left_values as left_value, i {
            let right_value = right_values.get(i) !? null
            if !isset(right_value) : return -1
            let equal = enum_match_values_equal(left_value, right_value)
            if equal < 0 : return -1
            if equal == 0 : return 0
        }
        return 1
    }

    return -1
}

// The items of `enu` that no case covers
fn enum_match_missing(enu: Enum, covered: Array[Value], ctx: Context, at: Exp) Array[String] !Error {
    let missing = Array[String]{}
    each enu.items as enum_item {
        let declared = value_from_enum_item(enu, enum_item.name, at, enu.scope, ctx) !>
        let found = false
        each covered as case_value {
            let equal = enum_match_values_equal(declared, case_value)
            if equal == 1 {
                found = true
                break
            }
        }
        if !found : missing.append(enum_item.name)
    }
    return missing
}

// Lower `match on [: Type] { case => ... }`.
fn value_from_match_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let on_exp = exp.get(MATCH_EXP.on)
    if !isset(on_exp) : exp.bug("match is missing its input value")
    let body = exp.get(MATCH_EXP.body)
    if !isset(body) : exp.bug("match is missing its body")

    let on = value_from_exp(on_exp, scope, ctx.without_suggested_type()) !>
    let result_type_exp = exp.get(MATCH_EXP.type)
    let result_type: ?Type = null
    if isset(result_type_exp) : result_type = type_from_exp(result_type_exp, scope) !>

    let pos = body.pos
    if !isset(pos) : body.bug("match body is missing a position")
    let p = pos.copy().init_parser()
    p.in_match_arms = true
    let cases = Array[Value]{}
    let found_default = false
    let covered_union_members = Array[Type]{}
    let covered_union_tags = Array[uint]{}
    let covered_union_null = false
    let covered_irrefutable = false
    let union_type_before_null: ?Exp = null
    let union_type: ?Type = null
    let enum_type = on.rett.get_non_nullable().get_enum()
    let subject_nullable = on.rett.is_nullable_type() && !value_stores_non_null(on, scope)
    let covered_enum_values = Array[Value]{}
    let covered_null_case = false
    let on_non_nullable = on.rett.get_non_nullable()
    let error_type: ?ErrorType = on_non_nullable.kind == TYPE.error_code && !on_non_nullable.error_is_instance ? on_non_nullable.get_error_type() : null
    let covered_error_codes = Array[String]{}
    let covered_true = false
    let covered_false = false
    if on_non_nullable.kind == TYPE.union : union_type = on_non_nullable
    let is_named_union = isset(union_type) && union_type.is_named_variant_union()
    // An interface value is matched by the class it holds: `Class as name =>`
    let interface_class = on_non_nullable.kind == TYPE.interface ? on_non_nullable.get_class_or_null() : null
    if isset(interface_class) && interface_class.kind != CLASS_KIND.interface : interface_class = null
    let covered_interface_classes = Array[Class]{}
    let all_cases_return = true
    // Once a `null` case is handled, the subject is known to hold a value in
    // the arms that follow, the same way `if !isset(x)` narrows a decl.
    let narrow_decl: ?Decl = on.type == VAL.decl ? on.decl : null

    while true {
        let t = p.tok(true, true, false) !>
        if t == TOK.end || (t == TOK.sign && p.word_is("}")) {
            if t != TOK.end : p.tok(true, true) !>
            break
        }
        if t == TOK.comment {
            p.tok(true, true) !>
            continue
        }
        if found_default {
            p.error("You cannot define cases after the 'default' case. You should move the 'default' case to the bottom of the list.")
        }

        let cond: ?Value = null
        let bound_name: ?String = null
        let bound_type: ?Type = null
        let bool_t = type_bool(ctx.build)
        let case_scope = scope.sub_scope()
        if covered_null_case && isset(narrow_decl) : case_scope.mark_not_null(narrow_decl)
        let bind_assigns = Array[Value]{}
        // What this case covers; it counts for exhaustiveness and duplicates only without a guard
        let pending_union_members = Array[Type]{}
        let pending_union_tags = Array[uint]{}
        let pending_union_null = false
        let pending_irrefutable = false
        let pending_enum_values = Array[Value]{}
        let pending_null_case = false
        let pending_error_codes = Array[String]{}
        let pending_true = false
        let pending_false = false
        let pending_interface_classes = Array[Class]{}
        let pattern_count: uint = 0
        // `_ if cond =>`: any value, for a guard on its own
        let wildcard = t == TOK.word && p.word_is("_")
        let is_default = t == TOK.word && p.word_is("default")
        if is_default {
            p.tok(true, true) !>
            found_default = true
        } else if wildcard {
            p.tok(true, true) !>
            cond = vgen_bool(true, bool_t)
        } else {
          // Several patterns, `a, b =>`, match when any of them does
          while true {
            pattern_count++
            let pattern_cond: ?Value = null
            let raw_item_exp: ?Exp = null
            let raw_item: ?Value = null
            let range_count: ?Value = null
            let range_count_exp: ?Exp = null
            let pt = p.tok(true, true, false) !>

            // Named tagged-union variants: `.variant`, `.variant(...)`, `Union.variant(...)`, `null`
            if is_named_union && !(pt == TOK.word && p.word_is("null")) {
                let pat = parse_match_pat(p) !>
                if pat.kind != MATCH_PAT.variant {
                    pat.exp.error("Named tagged union '" + on_non_nullable.compat_display_name() + "' must be matched by variant (e.g. '.variant' or '.variant(...)')")
                }
                if on.rett.is_nullable_type() && !covered_union_null && !pending_union_null && !isset(union_type_before_null) {
                    union_type_before_null = pat.exp
                }
                let ev = eval_match_pat(on, pat, case_scope, scope, ctx, on, true) !>
                let tag = ev.variant_tag ?! pat.exp.bug("Named union pattern is missing variant tag")
                if covered_union_tags.contains(tag) || (ev.irrefutable && pending_union_tags.contains(tag)) {
                    pat.exp.error("Duplicate tagged-union variant case: ." + pat.name)
                }
                if ev.irrefutable : pending_union_tags.append(tag)
                each ev.assigns as a : bind_assigns.append(a)
                raw_item_exp = pat.exp
                pattern_cond = ev.cond ?? vgen_bool(true, bool_t)
            } else if !isset(union_type) && !isset(interface_class) && (match_arm_starts_struct_or_tuple_pat(p, on_non_nullable) !>) {
                // Direct tuple `(a, b)` or struct/class `Point { x, y }` / `.{ x, y }` destructuring
                let pat = parse_match_pat(p) !>
                let ev = eval_match_pat(on, pat, case_scope, scope, ctx, on, true) !>
                each ev.assigns as a : bind_assigns.append(a)
                if ev.irrefutable : pending_irrefutable = true
                raw_item_exp = pat.exp
                pattern_cond = ev.cond ?? vgen_bool(true, bool_t)
            } else {
                // A tagged union is matched by type, and `(A, B)` is a type: a
                // leading `(` is one there, while elsewhere it starts a value.
                let struct_pat_head = (isset(union_type) || isset(interface_class)) && (match_word_followed_by_brace(p) !>)
                if struct_pat_head || (pt == TOK.sign && (p.word_is("<") || p.word_is("[") || p.word_is("*") || p.word_is("&")
                    || (isset(union_type) && p.word_is("(")))) {
                    let type_exp = read_type_exp(p, true, !struct_pat_head) !>
                    let item_type = type_from_exp(type_exp, scope) !>
                    raw_item_exp = type_exp
                    raw_item = vgen_type(item_type, ctx.build)
                    raw_item.exp = type_exp
                } else {
                    let value_exp = read_value_exp(p, true, false) !>
                    let is_null_case = value_exp.type == EXP.value && value_exp.value_kind == VALUE_KIND.null
                    let item_ctx = (isset(union_type) || isset(interface_class)) && !is_null_case ? ctx.without_suggested_type() : ctx.with_suggested_type(on.rett)
                    raw_item_exp = value_exp
                    raw_item = value_from_exp(value_exp, scope, item_ctx) !>
                    // `start .. count`: count numbers from start on, as in `each` and slices
                    let rt = p.tok(true, true, false) !>
                    if rt == TOK.sign && p.word_is("..") {
                        p.tok(true, true) !>
                        let count_exp = read_value_exp(p, true, false) !>
                        range_count_exp = count_exp
                        range_count = value_from_exp(count_exp, scope, ctx.with_suggested_type(on.rett)) !>
                    }
                }
            }
            let item_exp = raw_item_exp ?! exp.bug("Union match case is missing its expression")
            if !isset(pattern_cond) {
            let item = raw_item ?! exp.bug("Union match case is missing its value")
            let is_null_case = item_exp.type == EXP.value && item_exp.value_kind == VALUE_KIND.null
            if isset(range_count) && (isset(union_type) || isset(interface_class) || isset(enum_type) || isset(error_type) || !on_non_nullable.is_integer_type()) {
                item_exp.error("A range case 'start .. count' only matches integers")
            }
            if isset(union_type) && is_null_case {
                // Covers the union's `null` alternative and, for a nullable subject, the missing value
                let null_tag = union_type.union_null_tag()
                if !subject_nullable && !isset(null_tag) {
                    item_exp.error("This tagged union has no 'null' alternative and cannot be null")
                }
                if covered_union_null || pending_union_null : item_exp.error("Duplicate tagged-union null case")
                pending_union_null = true
                if isset(null_tag) {
                    let members = union_type.get_members() ?! exp.bug("Tagged union is missing alternatives")
                    pending_union_members.append(members.get(null_tag) ! exp.bug("Tagged union null alternative is missing"))
                    pattern_cond = vgen_union_is(on, null_tag, item_exp)
                    if subject_nullable {
                        let missing = vgen_unary(vgen_isset_val(on, bool_t), VALUE_OP.not, bool_t)
                        pattern_cond = vgen_op(missing, vgen_union_is(on, null_tag, item_exp), VALUE_OP.or, bool_t)
                    }
                } else {
                    pattern_cond = vgen_op(on, item, VALUE_OP.eq, bool_t)
                }
            } else if isset(union_type) && item.type == VAL.type {
                if on.rett.is_nullable_type() && !covered_union_null && !pending_union_null && !isset(union_type_before_null) {
                    union_type_before_null = item_exp
                }
                let member = item.get_of_type()
                if !isset(member) : item_exp.bug("Union match type is missing its represented type")
                let tag = union_type.union_member_index(member) !? null
                if !isset(tag) {
                    item_exp.error("Type '" + member.compat_display_name() + "' is not an alternative of '" + union_type.compat_display_name() + "'")
                }
                each covered_union_members as covered {
                    if type_identity_key(covered) == type_identity_key(member) {
                        item_exp.error("Duplicate tagged-union match case: " + member.compat_display_name())
                    }
                }
                each pending_union_members as covered {
                    if type_identity_key(covered) == type_identity_key(member) {
                        item_exp.error("Duplicate tagged-union match case: " + member.compat_display_name())
                    }
                }
                bound_type = member
                pattern_cond = vgen_union_is(on, tag, item_exp)
                let member_irrefutable = true

                let next = p.tok(true, true, false) !>
                if next == TOK.sign && p.word_is("{") {
                    let spat = parse_match_struct_pat(p, null, p.pos.i) !>
                    let extracted = vgen_union_extract(on, on.rett.storage_view_of(member), ctx, item_exp) !>
                    let ev = eval_match_pat(extracted, spat, case_scope, scope, ctx, on) !>
                    pattern_cond = match_pat_and(pattern_cond, ev.cond, bool_t)
                    each ev.assigns as a : bind_assigns.append(a)
                    member_irrefutable = ev.irrefutable
                } else if next == TOK.word && p.word_is("as") {
                    p.tok(true, true) !>
                    let bt = p.tok(true, true, false) !>
                    if bt == TOK.sign && (p.word_is("(") || p.word_is("{") || p.word_is(".")) {
                        let dpat = parse_match_pat(p) !>
                        let extracted = vgen_union_extract(on, on.rett.storage_view_of(member), ctx, item_exp) !>
                        let ev = eval_match_pat(extracted, dpat, case_scope, scope, ctx, on) !>
                        pattern_cond = match_pat_and(pattern_cond, ev.cond, bool_t)
                        each ev.assigns as a : bind_assigns.append(a)
                        member_irrefutable = ev.irrefutable
                    } else {
                        bound_name = p.read_word(true, true) !>
                    }
                }
                if member_irrefutable : pending_union_members.append(member)
            } else if isset(union_type) {
                item_exp.error("Tagged unions must be matched by type")
            } else if isset(interface_class) && item.type == VAL.type {
                let concrete_type = item.get_of_type() ?! item_exp.bug("Interface match type is missing its represented type")
                let concrete = concrete_type.get_class_or_null()
                if !isset(concrete) || (concrete.kind != CLASS_KIND.class && concrete.kind != CLASS_KIND.struct) || concrete_type.is_nullable_type() {
                    item_exp.error("An interface is matched by the class or struct it holds: write a type name, optionally followed by 'as name'")
                }
                resolve_class_interfaces(concrete) !>
                if !class_implements_interface(concrete, interface_class) {
                    let label = concrete.kind == CLASS_KIND.struct ? "Struct '" : "Class '"
                    item_exp.error(label + concrete.pretty_name() + "' does not implement '" + interface_class.pretty_name() + "', so this case can never match")
                }
                if covered_interface_classes.contains(concrete) || pending_interface_classes.contains(concrete) {
                    item_exp.error("Duplicate interface match case: " + concrete.pretty_name())
                }
                bound_type = concrete_type
                let adapter = interface_class.interface_adapters.get(interface_adapter_key(concrete)) !? null
                pattern_cond = vgen_is_a(on, adapter, ctx.build, item_exp)
                let class_irrefutable = true

                let next = p.tok(true, true, false) !>
                if next == TOK.sign && p.word_is("{") {
                    let spat = parse_match_struct_pat(p, null, p.pos.i) !>
                    let extracted = vgen_interface_object(on, on.rett.storage_view_of(concrete_type), item_exp)
                    let ev = eval_match_pat(extracted, spat, case_scope, scope, ctx, on) !>
                    pattern_cond = match_pat_and(pattern_cond, ev.cond, bool_t)
                    each ev.assigns as a : bind_assigns.append(a)
                    class_irrefutable = ev.irrefutable
                } else if next == TOK.word && p.word_is("as") {
                    p.tok(true, true) !>
                    let bt = p.tok(true, true, false) !>
                    if bt == TOK.sign && (p.word_is("(") || p.word_is("{") || p.word_is(".")) {
                        let dpat = parse_match_pat(p) !>
                        let extracted = vgen_interface_object(on, on.rett.storage_view_of(concrete_type), item_exp)
                        let ev = eval_match_pat(extracted, dpat, case_scope, scope, ctx, on) !>
                        pattern_cond = match_pat_and(pattern_cond, ev.cond, bool_t)
                        each ev.assigns as a : bind_assigns.append(a)
                        class_irrefutable = ev.irrefutable
                    } else {
                        bound_name = p.read_word(true, true) !>
                    }
                }
                if class_irrefutable : pending_interface_classes.append(concrete)
            } else if is_null_case && on.rett.is_nullable_type() {
                if covered_null_case || pending_null_case : item_exp.error("Duplicate match case: null is already handled")
                pending_null_case = true
                pattern_cond = vgen_unary(vgen_isset_val(on, bool_t), VALUE_OP.not, bool_t)
            } else {
                // A nullable subject matches a value only when it holds one
                let subject = on.rett.is_nullable_type() ? value_force_remove_nullable(on) : on
                item = value_try_convert(item, scope, ctx, subject.rett) !>
                subject.rett.compat_check(item.rett, item_exp) !>
                let count = range_count
                if isset(count) {
                    let count_at = range_count_exp ?! exp.bug("Match range is missing its count expression")
                    if item.type != VAL.int || count.type != VAL.int {
                        item_exp.error("A range case needs numbers known while compiling: 'start .. count'")
                    }
                    if count.int_val <= 0 : count_at.error("A range case needs a count of at least 1")
                    let last_val = item.int_val + (count.int_val - 1)
                    let from = value_compare_values(subject, item, VALUE_OP.gte, scope, ctx, item_exp) !>
                    pattern_cond = from
                    // A range past the type's largest value covers everything from its start
                    if type_fits_int_literal(subject.rett.get_non_nullable(), last_val, false) {
                        let last = vgen_int(last_val, subject.rett)
                        last.exp = count_at
                        last = value_try_convert(last, scope, ctx, subject.rett) !>
                        subject.rett.compat_check(last.rett, count_at) !>
                        let to = value_compare_values(subject, last, VALUE_OP.lte, scope, ctx, item_exp) !>
                        pattern_cond = vgen_op(from, to, VALUE_OP.and, bool_t)
                    }
                } else {
                    if subject.rett.is_bool_type() && item.type == VAL.bool {
                        if item.bool_val : pending_true = true
                        else : pending_false = true
                    }
                    if isset(enum_type) {
                        each covered_enum_values as covered {
                            if enum_match_values_equal(covered, item) == 1 {
                                item_exp.error("Duplicate enum match case: this value is already handled")
                            }
                        }
                        each pending_enum_values as covered {
                            if enum_match_values_equal(covered, item) == 1 {
                                item_exp.error("Duplicate enum match case: this value is already handled")
                            }
                        }
                        pending_enum_values.append(item)
                    }
                    if isset(error_type) && item.type == VAL.error_value && item.get_string().length > 0 {
                        let code = item.get_string()
                        if covered_error_codes.contains(code) || pending_error_codes.contains(code) {
                            item_exp.error("Duplicate error code match case: '" + code + "' is already handled")
                        }
                        pending_error_codes.append(code)
                    }
                    pattern_cond = value_compare_values(subject, item, VALUE_OP.eq, scope, ctx, item_exp) !>
                }
                let matched = pattern_cond ?! exp.bug("Match case is missing its condition")
                if subject != on {
                    pattern_cond = vgen_op(vgen_isset_val(on, bool_t), matched, VALUE_OP.and, bool_t)
                }
            }
            }
            let pc = pattern_cond ?! exp.bug("Match case is missing its condition")
            pc.exp = item_exp
            if (isset(bound_name) || bind_assigns.length > 0) && pattern_count > 1 {
                if isset(bound_name) : item_exp.error("A case with several patterns cannot bind a name with 'as'")
                item_exp.error("A case with several patterns cannot bind names")
            }
            let before = cond
            if isset(before) {
                let either = vgen_op(before, pc, VALUE_OP.or, bool_t)
                either.exp = item_exp
                cond = either
            } else {
                cond = pc
            }
            let sep = p.tok(true, true, false) !>
            if sep == TOK.sign && p.word_is(",") {
                if isset(bound_name) : item_exp.error("A case with several patterns cannot bind a name with 'as'")
                if bind_assigns.length > 0 : item_exp.error("A case with several patterns cannot bind names")
                p.tok(true, true) !>
                continue
            }
            break
          }
        }

        // A guard: the case matches only when the condition after `if` holds too
        let guard_exp: ?Exp = null
        let gt = p.tok(true, true, false) !>
        if gt == TOK.word && p.word_is("if") {
            if is_default : p.error("A 'default' case takes every value that is left and cannot have an 'if' guard")
            p.tok(true, true) !>
            guard_exp = read_value_exp(p, true, false) !>
        } else {
            if wildcard : p.error("'_' matches every value and needs a guard: '_ if condition =>'; write 'default' for the rest")
            each pending_union_members as member : covered_union_members.append(member)
            each pending_union_tags as tag : covered_union_tags.append(tag)
            if pending_union_null : covered_union_null = true
            if pending_irrefutable : covered_irrefutable = true
            each pending_enum_values as value : covered_enum_values.append(value)
            if pending_null_case : covered_null_case = true
            each pending_error_codes as code : covered_error_codes.append(code)
            if pending_true : covered_true = true
            if pending_false : covered_false = true
            each pending_interface_classes as class : covered_interface_classes.append(class)
        }

        p.expect("=>", true, true) !>
        if covered_null_case && isset(narrow_decl) : case_scope.mark_not_null(narrow_decl)
        let case_prefix = Array[Value]{}
        if isset(bound_name) && bound_name != "_" {
            let member = bound_type ?! exp.bug("Union match binding is missing its type")
            // A payload pulled out of a shared union keeps the shared view
            member = on.rett.storage_view_of(member)
            if case_scope.has_local(bound_name) : exp.error("Name already used: " + bound_name)
            let decl = Decl.new(ctx.get_func() !>, member, false, bound_name)
            decl.exp = exp
            decl.lock_scope = scope_find_lock(scope)
            decl.escape_origins = value_escape_origins(on)
            case_scope.add_decl(decl)
            case_scope.set_idf(bound_name, Idf.for_decl(decl))
            let extracted = isset(interface_class) ? vgen_interface_object(on, member, exp) : (vgen_union_extract(on, member, ctx, exp) !>)
            bind_assigns.append(vgen_assign(vgen_decl(decl), extracted, ASSIGN_OP.set, ctx.build, exp))
        }
        let guard_at = guard_exp
        if isset(guard_at) {
            let guard = value_from_exp(guard_at, case_scope, ctx.with_suggested_type(bool_t)) !>
            guard = value_try_convert(guard, case_scope, ctx, bool_t) !>
            bool_t.compat_check(guard.rett, guard_at) !>
            // Names are bound before the guard reads them
            if bind_assigns.length > 0 : guard = vgen_scoped_value(bind_assigns, guard, guard_at)
            let base = cond ?! exp.bug("Guarded match case is missing its condition")
            let both = vgen_op(base, guard, VALUE_OP.and, bool_t)
            both.exp = guard_at
            cond = both
        } else {
            each bind_assigns as assign : case_prefix.append(assign)
        }
        let casev = Value {
            type: VAL.block
            value1: cond
            bool_val: is_default
            rett: result_type ?? type_void(ctx.build)
            exp: exp
            values: case_prefix
        }

        let arm_tok = p.tok(true, true, false) !>
        let arm_exits = arm_tok == TOK.word && (p.word_is("throw") || p.word_is("return") || p.word_is("break") || p.word_is("continue"))
        let arm_block = arm_tok == TOK.sign && p.word_is("{")
        if isset(result_type) && !arm_exits {
            let value_exp = read_value_exp(p, true, true) !>
            if arm_block {
                value_exp.error("A case of a value 'match' gives an expression: write a block as '<{ ... return value }', or an object as '.{ ... }'")
            }
            let value = value_from_exp(value_exp, case_scope, ctx.with_suggested_type(result_type)) !>
            if case_scope.did_return {
                // An arm that never yields, like `panic(...)`
                case_prefix.append(value)
            } else {
                // A match used as a value produces one; it does not end the path.
                all_cases_return = false
                value = value_try_convert(value, case_scope, ctx, result_type) !>
                result_type.compat_check(value.rett, value_exp) !>
                casev.value2 = value
            }
        } else {
            let stmt_exp = read_func_stmt_exp(p) !>
            let state = ParseState.new()
            let value = body_value_from_exp(ctx, case_scope, state, stmt_exp) !>
            if isset(value) : case_prefix.append(value)
            if !case_scope.did_return : all_cases_return = false
        }
        scope.absorb_removed(case_scope)
        cases.append(casev)
    }

    if cases.length == 0 {
        exp.error("The match statement must have atleast 1 case")
    }
    if !found_default && covered_union_null && isset(union_type_before_null) {
        let null_order = union_type_before_null ?! exp.bug("Union null-order expression is missing")
        null_order.error("The null case must come before type cases when matching a nullable tagged union")
    }
    if !found_default {
        let exhaustive = false
        // What the cases leave out, for the error; empty for types with open-ended values
        let missing = Array[String]{}
        if isset(union_type) {
            if is_named_union {
                let c = union_type.get_class_or_null()
                let variants = isset(c) ? c.union_variants : null
                if isset(variants) {
                    exhaustive = covered_union_tags.length == variants.length
                        && (!subject_nullable || covered_union_null)
                    each variants as v {
                        if !covered_union_tags.contains(v.tag) : missing.append("." + v.name)
                    }
                    if subject_nullable && !covered_union_null : missing.append("null")
                }
            } else {
                let union_members = union_type.get_members()
                if isset(union_members) {
                    exhaustive = covered_union_members.length == union_members.length
                        && (!subject_nullable || covered_union_null)
                    each union_members as member {
                        let found = false
                        each covered_union_members as covered {
                            if covered.compat_display_name() == member.compat_display_name() : found = true
                        }
                        if !found : missing.append(member.compat_display_name())
                    }
                    if subject_nullable && !covered_union_null : missing.append("null")
                }
            }
        } else if covered_irrefutable {
            if subject_nullable && !covered_null_case : missing.append("null")
            exhaustive = missing.length == 0
        } else if isset(enum_type) {
            missing = enum_match_missing(enum_type, covered_enum_values, ctx, exp) !>
            if subject_nullable && !covered_null_case : missing.append("null")
            exhaustive = enum_type.items.length > 0 && missing.length == 0
        } else if isset(error_type) {
            each error_type.codes as code {
                if !covered_error_codes.contains(code) : missing.append(code)
            }
            if subject_nullable && !covered_null_case : missing.append("null")
            exhaustive = missing.length == 0
        } else if on_non_nullable.is_bool_type() {
            if !covered_true : missing.append("true")
            if !covered_false : missing.append("false")
            if subject_nullable && !covered_null_case : missing.append("null")
            exhaustive = missing.length == 0
        }
        if !exhaustive {
            if missing.length > 0 {
                exp.error("The match does not cover: " + missing.join(", ") + ". Add cases for them or a 'default' case")
            }
            exp.error("The match statement must have a 'default' case because it does not cover all values")
        }
        if isset(enum_type) {
            let invalid = value_panic_call(ctx, "Invalid enum value in exhaustive match", exp) !>
            cases.append(Value {
                type: VAL.block
                bool_val: true
                rett: result_type ?? type_void(ctx.build)
                value2: isset(result_type) ? invalid : null
                values: isset(result_type) ? Array[Value]{} : Array[Value]{ invalid }
                exp: exp
            })
        } else {
            let last = cases.get(cases.length - 1) !? null
            if isset(last) : last.bool_val = true
        }
    }
    if all_cases_return : scope.did_return = true

    return Value {
        type: VAL.match
        value1: on
        values: cases
        rett: result_type ?? type_void(ctx.build)
        exp: exp
    }
}

// Class/struct usable for bare `{ fields }` from the suggested type.
fn class_from_inline_init_type(t: Type) ?Class {
    let nn = t.get_non_nullable()
    if nn.is_inline {
        return nn.class
    }
    // Direct structural type (less common for bare init; named form usually used)
    let c = nn.get_class_or_null()
    if !isset(c) : return null
    if c.kind == CLASS_KIND.struct || c.kind == CLASS_KIND.class : return c
    return null
}

// ---- helpers ----

// The getter a value calls, for `x.name` where `name` is a getter
fn value_getter_of_call(v: Value) ?Func {
    if v.type != VAL.call : return null
    let callee = v.value1 ?! return null
    if callee.type != VAL.func : return null
    let f = callee.func ?! return null
    return f.is_getter ? f : null
}



// Construct Value objects without an Exp (used by value_from_exp and later IR).

////////////////////////////
// Literals
////////////////////////////

fn vgen_undefined(type: Type, at: ?Exp (null)) Value {
    return Value {
        type: VAL.undefined
        rett: type
        exp: at
    }
}

fn vgen_int(value: int, type: Type) Value {
    return Value {
        type: VAL.int
        int_val: value
        rett: type
    }
}

fn vgen_float(value: f64, type: Type) Value {
    return Value {
        type: VAL.float
        rett: type
        float_val: value
    }
}

fn vgen_bool(value: bool, type: Type) Value {
    return Value {
        type: VAL.bool
        bool_val: value
        rett: type
    }
}

fn vgen_string(value: String, type: Type) Value {
    let result = Value {
        type: VAL.string
        rett: type
    }
    result.set_string(value)
    return result
}

fn vgen_null(type: Type) Value {
    return Value {
        type: VAL.null
        rett: type
    }
}

////////////////////////////
// Scratch storage
////////////////////////////

fn vgen_scratch_decl(ctx: Context, result: Value, type: Type) {
    let func = ctx.func ?! return
    result.decl = vgen_scratch_storage(func, type)
}

fn vgen_scratch_value(func: Func, type: Type, at: ?Exp (null)) Value {
    let v = vgen_decl(vgen_scratch_storage(func, type))
    v.exp = at
    return v
}

fn vgen_scratch_storage(func: Func, type: Type) Decl {
    let storage = Decl.new(func, type, false, null)
    storage.is_mut = true
    storage.skip_gc_field_roots = true
    func.all_decls.append(storage)
    return storage
}

////////////////////////////
// Interfaces
////////////////////////////

fn vgen_interface_wrap(on: Value, interface_type: Type, adapter: Class, ctx: Context) Value {
    let func = ctx.func
    if isset(func) && !func.no_buffers && on.needs_buffer() {
        on = buffer_value(ctx, func, on)
    }

    let result = Value {
        type: VAL.interface_wrap
        value1: on
        rett: interface_type
        exp: on.exp
    }
    result.set_class_ref(adapter)
    return result
}

fn vgen_is_a(on: Value, adapter: ?Class, b: Build, at: Exp) Value {
    let result = Value {
        type: VAL.is_a
        value1: on
        rett: type_bool(b)
        exp: at
    }
    result.set_class_ref(adapter)
    return result
}

fn vgen_default_value(type: Type) Value {
    if type.is_nullable_type() : return vgen_null(type)
    if type.is_float_type() : return vgen_float(0, type)
    if type.is_integer_type() : return vgen_int(0, type)
    if type.is_bool_type() : return vgen_bool(false, type)
    return vgen_null(type.nullable())
}

////////////////////////////
// References
////////////////////////////

// Resolved free/static/bound function reference.
fn vgen_func(func: Func, receiver: ?Value (null)) Value {
    if func.is_static : receiver = null
    return Value {
        type: VAL.func
        func: func
        value1: receiver
        rett: func.get_value_type(isset(receiver))
    }
}

// Local / argument variable reference.
fn vgen_decl(decl: Decl) Value {
    return Value {
        type: VAL.decl
        decl: decl
        rett: decl.type
    }
}

// Compile-time type value: `T` / `String` as a value. rett is String; actual Type in of_type.
fn vgen_type(of_type: Type, b: Build) Value {
    let result = Value {
        type: VAL.type
        rett: type_string(b)
    }
    result.set_of_type(of_type)
    result.set_string(of_type.custom_name)
    return result
}

fn vgen_dot(on: Value, name: String, type: Type) Value {
    let result = Value {
        type: VAL.member
        value1: on
        rett: type
    }
    result.set_name(name)
    return result
}

// Object property load/store target: `on.prop`.
fn vgen_prop(prop: Prop, on: Value, ctx: ?Context (null)) Value {
    let result = Value {
        type: VAL.prop
        value1: on
        prop: prop
        rett: prop.type
    }
    if prop.type.has_gc_refs() && !prop.type.is_gc_type() && isset(ctx) {
        vgen_scratch_decl(ctx, result, prop.type)
    }
    return result
}

// Global / shared variable reference.
fn vgen_global(g: Global) Value !Error {
    return Value {
        type: VAL.global
        global: g
        rett: g.get_type() !>
    }
}

////////////////////////////
// Operators
////////////////////////////

// Binary operator.
fn vgen_op(left: Value, right: Value, op: VALUE_OP, rett: Type) Value {
    return Value {
        type: VAL.op
        op: op
        value1: left
        value2: right
        rett: rett
    }
}

// Unary operator (`!`, `-`, …).
fn vgen_unary(operand: Value, op: VALUE_OP, rett: Type) Value {
    return Value {
        type: VAL.unary
        op: op
        value1: operand
        rett: rett
    }
}

////////////////////////////
// Temporary GC roots
////////////////////////////

fn buffer_types_match(pooled: Type, requested: Type) bool {
    if pooled == requested : return true
    if pooled.is_gc_type() && requested.is_gc_type() : return true
    return type_identity_key(pooled) == type_identity_key(requested)
}

fn func_take_buffer(func: Func, type: Type) Decl {
    each func.buffer_pool as decl, i {
        if !buffer_types_match(decl.type, type) : continue
        func.buffer_pool.remove(i)
        func.buffers_used.append(decl)
        return decl
    }

    let decl = Decl.new(func, type, false, null)
    decl.is_buffer = true
    func.all_decls.append(decl)
    func.buffers_used.append(decl)
    return decl
}

fn func_release_buffers(func: Func, first: uint (0)) {
    while func.buffers_used.length > first {
        let i = func.buffers_used.length - 1
        let decl = func.buffers_used.get(i) ! break
        func.buffers_used.remove(i)
        func.buffer_pool.append(decl)
    }
}

fn vgen_buffer_decl(decl: Decl, type: Type) Value {
    let value = vgen_decl(decl)
    value.rett = type
    return value
}

fn buffer_value(ctx: Context, func: Func, value: Value) Value {
    let decl = func_take_buffer(func, value.rett)
    let buffered = vgen_buffer_decl(decl, value.rett)
    buffered.exp = value.exp
    buffered.set_pre_value(vgen_assign(vgen_buffer_decl(decl, value.rett), value, ASSIGN_OP.set, ctx.build, value.exp))
    return buffered
}

fn buffer_values(ctx: Context, values: Array[Value]) {
    let func = ctx.func
    if !isset(func) : return
    if func.no_buffers : return
    each values as v, i {
        if v.needs_buffer() : values.set(i, buffer_value(ctx, func, v)) _
    }
}

////////////////////////////
// Calls and atomics
////////////////////////////

// Function / method call. Pass `type_void(b)` when the return type is unknown.
fn vgen_call(ctx: Context, callee: Value, args: Array[Value], rett: Type, scope: ?Scope (null)) Value {
    buffer_values(ctx, args)
    let call_func = callee.resolve_call_func()
    if isset(scope) && isset(call_func) && (call_func.must_exit || call_func.will_exit) {
        scope.did_return = true
    }
    let call_kind = CALL_KIND.direct
    if isset(call_func) && call_func.is_interface {
        call_kind = CALL_KIND.interface_dispatch
    } else if callee.rett.get_non_nullable().kind == TYPE.closure {
        if callee.type != VAL.func || (isset(call_func) && call_func.is_literal) {
            call_kind = CALL_KIND.closure
        }
    }
    let owner = ctx.func
    if isset(owner) {
        // panic is explicitly permitted in finalizers. It never returns, so
        // its shutdown path does not become part of the caller's effects.
        let is_panic = isset(call_func) && call_func.ns.pkg.name == "valk"
            && call_func.ns.name == "core" && call_func.name == "panic"
        if call_kind == CALL_KIND.direct && isset(call_func) && !is_panic {
            owner.effect_callees.append(call_func, true)
        } else if !is_panic {
            owner.info_calls_unknown_code = true
            owner.note_suspend()
        }
    }
    return Value {
        type: VAL.call
        value1: callee
        values: args
        op: call_kind
        rett: rett
    }
}

fn vgen_atomic_op(left: Value, right: Value, op: VALUE_OP, at: ?Exp (null)) Value {
    return Value {
        type: VAL.atomic_op
        value1: left
        value2: right
        op: op
        rett: left.rett
        exp: at
    }
}

fn vgen_atomic_store(left: Value, right: Value, at: ?Exp (null)) Value {
    return Value {
        type: VAL.atomic_store
        value1: left
        value2: right
        rett: left.rett
        exp: at
    }
}

fn vgen_atomic_load(left: Value, at: ?Exp (null)) Value {
    return Value {
        type: VAL.atomic_load
        value1: left
        rett: left.rett
        exp: at
    }
}

fn vgen_memcpy(values: Array[Value], b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.memcpy
        values: values
        rett: type_void(b)
        exp: at
    }
}

// `on.@cast(Type)`.
fn vgen_cast(on: Value, type: Type) Value {
    return Value {
        type: VAL.cast
        value1: on
        rett: type
    }
}

////////////////////////////
// Aggregates and memory
////////////////////////////

// Class / struct init. `fields` is keyed by Prop so unnamed properties work.
fn vgen_class_init(ctx: Context, class: Class, fields: HashMap[Prop, Value], rett: Type, at: ?Exp (null)) Value !Error {
    let func = ctx.func
    let field_list = Array[Value]{}
    each fields as field, prop {
        if field.type == VAL.undefined : continue
        if isset(func) && !func.no_buffers && field.rett.has_gc_refs() {
            if field.type != VAL.decl && field.type != VAL.null && field.type != VAL.string {
                field = buffer_value(ctx, func, field)
            }
        }
        field.set_init_prop(prop)
        field_list.append(field)
    }

    let result = Value {
        type: VAL.class_init
        values: field_list
        rett: rett
        exp: at
    }
    result.set_class_ref(class)
    if class.kind == CLASS_KIND.class || class.kind == CLASS_KIND.array {
        let exp = at
        if !isset(exp) : ctx.build.bug("GC class init is missing its source expression")
        if class.compute_body_size() !> > 0 {
            result.set_allocator(allocator_for_class(ctx, class, exp) !>)
            if isset(func) : func.note_gc_allocation()
        }
    } else if class.kind == CLASS_KIND.slice {
        if isset(func) : func.note_gc_allocation()
    }
    return result
}

// Fixed-array init `{ a, b, ... }`. `elements` are in index order.
fn vgen_array_init(ctx: Context, elements: Array[Value], rett: Type, at: ?Exp (null)) Value {
    let func = ctx.func
    if isset(func) && !func.no_buffers {
        each elements as element, i {
            if !element.rett.has_gc_refs() : continue
            if element.type == VAL.decl || element.type == VAL.null || element.type == VAL.string || element.type == VAL.undefined {
                continue
            }
            elements.set(i, buffer_value(ctx, func, element)) _
        }
    }
    return Value {
        type: VAL.array_init
        values: elements
        rett: rett
        exp: at
    }
}

// Element access `on[index]` or `@ptrv(on, T, index)`. `rett` is the element type.
fn vgen_ptrv(on: Value, index: Value, rett: Type, at: ?Exp (null)) Value {
    return Value {
        type: VAL.ptrv
        value1: on
        value2: index
        rett: rett
        exp: at
    }
}

fn vgen_ptr_offset(on: Value, offset: Value, at: ?Exp (null)) Value {
    let result = Value {
        type: VAL.ptr_offset
        value1: on
        value2: offset
        rett: type_ptr(on.rett.build)
        exp: at
    }
    if on.is_implicit_borrow() : result.mark_implicit_borrow()
    return result
}

// `@ref(lvalue)` — address-of; rett is raw `ptr` (or *T when known).
fn vgen_ptr_of(on: Value, rett: Type, at: ?Exp (null)) Value {
    return Value {
        type: VAL.ptr_of
        value1: on
        rett: rett
        exp: at
    }
}

// Copy an inline value out of pointer/reference storage.
fn vgen_load(on: Value, rett: Type, at: ?Exp (null)) Value {
    return Value {
        type: VAL.load
        value1: on
        rett: rett
        exp: at
    }
}

// ---- Function-body values (rett = void) ----

fn vgen_decl_initializers(decls: Array[Decl], inits: Array[Value], b: Build, at: ?Exp (null)) Value {
    let statements = Array[Value]{}
    each decls as decl, i {
        let init = inits.get(i) ! continue
        statements.append(vgen_assign(vgen_decl(decl), init, ASSIGN_OP.set, b, at))
    }
    return vgen_block(statements, b, at)
}

////////////////////////////
// Assignment
////////////////////////////

fn vgen_assign(
    left: Value,
    right: Value,
    op: ASSIGN_OP,
    b: Build,
    at: ?Exp (null),
    ctx: ?Context (null)
) Value {
    if left.type == VAL.decl {
        let decl = left.decl
        if isset(decl) && right.is_implicit_borrow() : decl.implicit_borrow = true
        if isset(decl) && !decl.closure_holds_captures && decl.type.get_non_nullable().kind == TYPE.closure {
            let assigned_func = right.func
            if right.type != VAL.func || isset(right.value1) || !isset(assigned_func) || !assigned_func.capture_free {
                decl.closure_holds_captures = true
            }
        }
    }
    if right.needs_buffer() && left.rett.has_gc_refs() && !left.rett.is_gc_type() && isset(ctx) {
        let func = ctx.func
        let needs_runtime = false
        if left.type == VAL.prop {
            let owner = left.value1
            needs_runtime = isset(owner) && owner.rett.is_gc_type()
        } else if left.type == VAL.global {
            let global = left.global
            needs_runtime = isset(global) && global.shared
        }
        if needs_runtime && isset(func) && !func.no_buffers {
            right = buffer_value(ctx, func, right)
        }
    }
    return Value {
        type: VAL.assign
        value1: left
        value2: right
        op: op
        rett: type_void(b)
        exp: at
    }
}

////////////////////////////
// Control flow
////////////////////////////

// if/while/block: body sequences live in `values`; else branch is optional value2 (usually VAL.block).
fn vgen_if(cond: Value, then_body: Array[Value], else_body: ?Value, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.if
        value1: cond
        values: then_body
        value2: else_body
        rett: type_void(b)
        exp: at
    }
}

fn vgen_while(cond: Value, body: Array[Value], b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.while
        value1: cond
        values: body
        rett: type_void(b)
        exp: at
    }
}

fn vgen_block(body: Array[Value], b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.block
        values: body
        rett: type_void(b)
        exp: at
    }
}

fn vgen_scoped_value(body: Array[Value], result: Value, at: ?Exp (null)) Value {
    let value = Value {
        type: VAL.block
        values: body
        value1: result
        rett: result.rett
        exp: at
    }
    if result.is_implicit_borrow() : value.mark_implicit_borrow()
    return value
}

fn vgen_return(value: ?Value, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.return
        value1: value
        rett: type_void(b)
        exp: at
    }
}

fn vgen_throw(value: Value, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.throw
        value1: value
        rett: type_void(b)
        exp: at
    }
}

fn vgen_break(b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.break
        rett: type_void(b)
        exp: at
    }
}

fn vgen_continue(b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.continue
        rett: type_void(b)
        exp: at
    }
}

fn vgen_run_defers(stack: Decl, pop: Func, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.run_defers
        value1: vgen_decl(stack)
        func: pop
        rett: type_void(b)
        exp: at
    }
}

////////////////////////////
// Generated function scaffolding
////////////////////////////

fn vgen_allocas(values: Array[Value], b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.allocas
        values: values
        rett: type_void(b)
        exp: at
    }
}

fn vgen_init_allocators(scope: Scope, ctx: Context, at: Exp) Value {
    let result = Value {
        type: VAL.init_allocators
        int_val: ctx.build.lists.allocator_init_sites.length.to(int)
        rett: type_void(ctx.build)
        exp: at
    }
    ctx.build.lists.allocator_init_sites.append(AllocatorInitSite {
        value: result
        scope: scope
        ctx: ctx
        exp: at
    })
    return result
}

fn vgen_decl_offset(decl: Decl, b: Build) Value {
    return Value {
        type: VAL.decl_offset
        decl: decl
        rett: type_void(b)
    }
}

fn vgen_gc_stack_init(size: uint, count: uint, b: Build) Value {
    return Value {
        type: VAL.gc_stack_init
        int_val: size.to(int)
        value1: vgen_int(count.to(int), type_int(b))
        rett: type_void(b)
    }
}

fn vgen_gc_stack_defer(b: Build) Value {
    return Value {
        type: VAL.gc_stack_defer
        rett: type_void(b)
    }
}

fn vgen_gc_root_clear(decl: Decl, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.gc_root_clear
        decl: decl
        rett: type_void(b)
        exp: at
    }
}

fn vgen_ir_comment(comment: String, b: Build, at: ?Exp (null)) Value {
    let result = Value {
        type: VAL.ir_comment
        rett: type_void(b)
        exp: at
    }
    result.set_string(comment)
    return result
}

////////////////////////////
// Value scopes
////////////////////////////

// Phi of control-flow values (e.g. all `return`s inside a vscope).
fn vgen_phi(values: Array[Value], rett: Type, at: ?Exp (null)) Value {
    let result = Value {
        type: VAL.phi
        values: values
        rett: rett
        exp: at
    }
    each values as value {
        if value.is_implicit_borrow() {
            result.mark_implicit_borrow()
            break
        }
    }
    return result
}

// Value scope `<{...}`: body statements + phi of return values.
fn vgen_vscope(body: Array[Value], phi: Value, at: ?Exp (null)) Value {
    let result = Value {
        type: VAL.vscope
        values: body
        value1: phi
        rett: phi.rett
        exp: at
    }
    if phi.is_implicit_borrow() : result.mark_implicit_borrow()
    return result
}

fn vgen_multi(values: Array[Value], rett: Type, at: ?Exp (null)) Value {
    return Value {
        type: VAL.multi
        values: values
        rett: rett
        exp: at
    }
}

fn vgen_multi_part(on: Value, index: uint, rett: Type, at: ?Exp (null)) Value {
    let result = Value {
        type: VAL.multi
        int_val: index.@cast(int)
        value1: on
        rett: rett
        exp: at ?? on.exp
    }
    result.set_name("part")
    return result
}

// Multi-value group `(a, b, …)` — used for multi returns and multi lets.
fn vgen_grouped_values(b: Build, values: Array[Value], force: bool (false)) Value {
    if values.length == 1 && !force {
        let first = values.get(0) !? null
        if isset(first) : return first
    }
    let types = Array[Type]{}
    each values as val {
        types.append(val.rett)
    }
    let rett = type_multi(b, types, force)
    return Value {
        type: VAL.multi
        values: values
        rett: rett
    }
}


// Construct Value objects without an Exp (used by value_from_exp and later IR).

fn vgen_undefined(b: Build) Value {
    return Value {
        type: VAL.undefined
        rett: type_void(b)
    }
}

fn vgen_int(value: int, type: Type) Value {
    return Value {
        type: VAL.int
        int_val: value
        rett: type
    }
}

fn vgen_float(value: f64, type: Type) Value {
    return Value {
        type: VAL.float
        float_val: value
        rett: type
    }
}

fn vgen_bool(value: bool, type: Type) Value {
    return Value {
        type: VAL.bool
        bool_val: value
        rett: type
    }
}

fn vgen_string(value: String, type: Type) Value {
    return Value {
        type: VAL.string
        string_val: value
        rett: type
    }
}

// Char literals are stored as both the source text and the integer code unit.
fn vgen_char(code: int, text: String, type: Type) Value {
    return Value {
        type: VAL.char
        int_val: code
        string_val: text
        rett: type
    }
}

fn vgen_null(type: Type) Value {
    return Value {
        type: VAL.null
        rett: type
    }
}

// Identifier reference. Optional namespace, resolved Idf, and result type.
// Pass `type_void(b)` when the type is not yet known.
fn vgen_id(name: String, ns_name: ?String (null), idf: ?Idf (null), type: Type) Value {
    return Value {
        type: VAL.id
        name: name
        ns_name: ns_name
        idf: idf
        rett: type
    }
}

// Local / argument variable reference.
fn vgen_decl(decl: Decl) Value {
    return Value {
        type: VAL.decl
        decl: decl
        name: decl.name ?? ""
        rett: decl.type
        idf: Idf.for_decl(decl)
    }
}

// Compile-time type value: `T` / `String` as a value. rett is String; actual Type in of_type.
fn vgen_type(of_type: Type, b: Build) Value {
    return Value {
        type: VAL.type
        of_type: of_type
        rett: type_string(b)
        string_val: of_type.custom_name
    }
}

// Property / method name access: `on.name` (still VAL.id with value1 = receiver).
// Pass `type_void(b)` when the member type is not yet known.
// Resolved object fields use `vgen_prop` (VAL.prop) instead.
fn vgen_dot(on: Value, name: String, type: Type) Value {
    return Value {
        type: VAL.id
        name: name
        value1: on
        rett: type
    }
}

// Object property load/store target: `on.prop`.
fn vgen_prop(prop: Prop, on: Value) Value {
    return Value {
        type: VAL.prop
        value1: on
        prop: prop
        name: prop.name ?? ""
        rett: prop.type
    }
}

// Binary operator.
fn vgen_op(left: Value, right: Value, op: VALUE_OP, rett: Type) Value {
    return Value {
        type: VAL.op
        op: op
        value1: left
        value2: right
        rett: rett
    }
}

// Unary operator (`!`, `-`, …).
fn vgen_unary(operand: Value, op: VALUE_OP, rett: Type) Value {
    return Value {
        type: VAL.unary
        op: op
        value1: operand
        rett: rett
    }
}

// Function / method call. Pass `type_void(b)` when the return type is unknown.
fn vgen_call(callee: Value, args: Array[Value], rett: Type) Value {
    return Value {
        type: VAL.call
        value1: callee
        values: args
        rett: rett
    }
}

// `on.@cast(Type)`.
fn vgen_cast(on: Value, type: Type) Value {
    return Value {
        type: VAL.cast
        value1: on
        cast_type: type
        rett: type
    }
}

// Grouping (usually folded away; kept for completeness).
fn vgen_paren(inner: Value) Value {
    return Value {
        type: VAL.paren
        value1: inner
        rett: inner.rett
    }
}

// Multi-value list (call argument packs, multi returns, …).
fn vgen_multi(values: Array[Value], rett: Type) Value {
    return Value {
        type: VAL.multi
        values: values
        rett: rett
    }
}

// Class / struct init. `fields` entries have `.name` = property name.
fn vgen_class_init(class: Class, fields: Array[Value], rett: Type, at: ?Exp (null)) Value {
    return Value {
        type: VAL.class_init
        values: fields
        rett: rett
        of_type: rett
        exp: at
        // Keep class identity via of_type.class (on rett)
    }
}

// ---- Function-body values (rett = void) ----

fn vgen_declare(decls: Array[Decl], inits: Array[Value], b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.declare
        decls: decls
        values: inits
        rett: type_void(b)
        exp: at
    }
}

fn vgen_assign(left: Value, right: Value, op: ASSIGN_OP, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.assign
        value1: left
        value2: right
        op: op
        rett: type_void(b)
        exp: at
    }
}

// if/while/block: body sequences live in `values`; else branch is optional value2 (usually VAL.block).
fn vgen_if(cond: Value, then_body: Array[Value], else_body: ?Value, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.if
        value1: cond
        values: then_body
        value2: else_body
        rett: type_void(b)
        exp: at
    }
}

fn vgen_while(cond: Value, body: Array[Value], b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.while
        value1: cond
        values: body
        rett: type_void(b)
        exp: at
    }
}

fn vgen_block(body: Array[Value], b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.block
        values: body
        rett: type_void(b)
        exp: at
    }
}

fn vgen_return(value: ?Value, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.return
        value1: value
        rett: type_void(b)
        exp: at
    }
}

fn vgen_throw(value: Value, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.throw
        value1: value
        rett: type_void(b)
        exp: at
    }
}

fn vgen_break(b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.break
        rett: type_void(b)
        exp: at
    }
}

fn vgen_continue(b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.continue
        rett: type_void(b)
        exp: at
    }
}

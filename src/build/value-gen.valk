
// Construct Value objects without an Exp (used by value_from_exp and later IR).

////////////////////////////
// Literals
////////////////////////////

// A value that is never read: an unresolved expression, or padding inside an
// aggregate (where the type is the padding's own storage).
fn vgen_undefined(type: Type, at: ?Exp (null)) Value {
    return Value {
        type: VAL.undefined
        rett: type
        exp: at
    }
}

fn vgen_int(value: int, type: Type) Value {
    return Value {
        type: VAL.int
        int_val: value
        rett: type
    }
}

fn vgen_float(value: f64, type: Type) Value {
    return Value {
        type: VAL.float
        float_val: value
        rett: type
    }
}

fn vgen_bool(value: bool, type: Type) Value {
    return Value {
        type: VAL.bool
        bool_val: value
        rett: type
    }
}

fn vgen_string(value: String, type: Type) Value {
    return Value {
        type: VAL.string
        string_val: value
        rett: type
    }
}

fn vgen_null(type: Type) Value {
    return Value {
        type: VAL.null
        rett: type
    }
}

////////////////////////////
// Scratch storage
////////////////////////////

// Addressable scratch for a by-value aggregate. One slot per source expression,
// so a construction inside a loop does not grow the native stack per iteration.
fn vgen_scratch_decl(ctx: Context, result: Value, type: Type) {
    let func = ctx.func ?! return
    result.decl = vgen_scratch_storage(func, type)
}

// The same slot as an ordinary local value, for lowerings that read and write
// it with plain assignments.
fn vgen_scratch_value(func: Func, type: Type, at: ?Exp (null)) Value {
    let v = vgen_decl(vgen_scratch_storage(func, type))
    v.exp = at
    return v
}

fn vgen_scratch_storage(func: Func, type: Type) Decl {
    let storage = Decl.new(func, type, false, null)
    storage.is_mut = true
    storage.skip_gc_field_roots = true
    func.all_decls.append(storage)
    return storage
}

////////////////////////////
// Interfaces
////////////////////////////

fn vgen_interface_wrap(on: Value, interface_type: Type, adapter: Class, ctx: Context) Value {
    // Allocating the adapter can collect, so retain a freshly-created concrete
    // object in the caller's GC frame until it has been stored in the box.
    let func = ctx.func
    if isset(func) && !func.no_buffers && on.needs_buffer() {
        on = buffer_value(ctx, func, on)
    }

    let fields = Array[Value]{ on }
    let concrete = on.rett.get_non_nullable().get_class_or_null() ?! return on
    let interface = interface_type.get_non_nullable().get_class_or_null() ?! return on
    let slot: uint = 0
    while slot < interface.interface_method_count {
        let requirement = interface_method_at(interface, slot) ?! return on
        let implementation = concrete.get_func(requirement.name) ?! return on
        // A dispatch slot stores only the code pointer. The adapter's object
        // field supplies the receiver at the eventual indirect call.
        fields.append(Value {
            type: VAL.interface_method
            func: implementation
            rett: type_ptr(ctx.build)
        })
        slot++
    }
    // The adapter is an ordinary object: object field first, dispatch slots after.
    return vgen_class_init(ctx, adapter, fields, interface_type, on.exp) ! return on
}

// Best-effort "zero value" for a type — numeric types get 0/0.0, bool gets false,
// everything else wraps in nullable and returns null. Used as the implicit fallback
// for a fallible `[]` offset access that has no explicit error handler.
fn vgen_default_value(type: Type) Value {
    // Nullable scalar types default to null, not to a present zero value.
    // is_integer_type()/is_float_type()/is_bool_type() intentionally look
    // through nullable wrappers, so this check must come first.
    if type.is_nullable_type() : return vgen_null(type)
    if type.is_float_type() : return vgen_float(0, type)
    if type.is_integer_type() : return vgen_int(0, type)
    if type.is_bool_type() : return vgen_bool(false, type)
    return vgen_null(type.nullable())
}

////////////////////////////
// References
////////////////////////////

// Resolved free/static/bound function reference.
fn vgen_func(func: Func, receiver: ?Value (null)) Value {
    // Static functions are selected through a type in source, but that type is
    // not a runtime receiver. Only instance methods retain a bound value.
    if func.is_static : receiver = null
    return Value {
        type: VAL.func
        func: func
        name: func.name
        value1: receiver
        rett: func.get_value_type(isset(receiver))
    }
}

// Local / argument variable reference.
fn vgen_decl(decl: Decl) Value {
    return Value {
        type: VAL.decl
        decl: decl
        name: decl.name ?? ""
        rett: decl.type
    }
}

// Compile-time type value: `T` / `String` as a value. rett is String; actual Type in of_type.
fn vgen_type(of_type: Type, b: Build) Value {
    return Value {
        type: VAL.type
        of_type: of_type
        rett: type_string(b)
        string_val: of_type.custom_name
    }
}

// Builtin/meta member access after the receiver has been resolved.
// Pass `type_void(b)` when the member type is not yet known.
// Resolved object fields use `vgen_prop` (VAL.prop) instead.
fn vgen_dot(on: Value, name: String, type: Type) Value {
    return Value {
        type: VAL.member
        name: name
        value1: on
        rett: type
    }
}

// Object property load/store target: `on.prop`.
fn vgen_prop(prop: Prop, on: Value, ctx: ?Context (null)) Value {
    let result = Value {
        type: VAL.prop
        value1: on
        prop: prop
        name: prop.name ?? ""
        rett: prop.type
    }
    if prop.type.has_gc_refs() && !prop.type.is_gc_type() && isset(ctx) {
        vgen_scratch_decl(ctx, result, prop.type)
    }
    return result
}

// Global / shared variable reference.
fn vgen_global(g: Global) Value !Error {
    return Value {
        type: VAL.global
        global: g
        name: g.name
        rett: g.get_type() !>
    }
}

////////////////////////////
// Operators
////////////////////////////

// Binary operator.
fn vgen_op(left: Value, right: Value, op: VALUE_OP, rett: Type) Value {
    return Value {
        type: VAL.op
        op: op
        value1: left
        value2: right
        rett: rett
    }
}

// Unary operator (`!`, `-`, …).
fn vgen_unary(operand: Value, op: VALUE_OP, rett: Type) Value {
    return Value {
        type: VAL.unary
        op: op
        value1: operand
        rett: rett
    }
}

////////////////////////////
// Temporary GC roots
////////////////////////////

// Pointer-valued managed references all use one traced pointer word. Other
// buffers may only reuse storage with the exact same type/layout.
fn buffer_types_match(pooled: Type, requested: Type) bool {
    if pooled == requested : return true
    if pooled.is_gc_type() && requested.is_gc_type() : return true
    return type_identity_key(pooled) == type_identity_key(requested)
}

fn func_take_buffer(func: Func, type: Type) Decl {
    each func.buffer_pool as decl, i {
        if !buffer_types_match(decl.type, type) : continue
        func.buffer_pool.remove(i)
        func.buffers_used.append(decl)
        return decl
    }

    let decl = Decl.new(func, type, false, null)
    decl.is_buffer = true
    func.all_decls.append(decl)
    func.buffers_used.append(decl)
    return decl
}

// Return the temporary declarations acquired since this statement's nesting
// marker, leaving any enclosing statement's buffers checked out.
fn func_release_buffers(func: Func, first: uint (0)) {
    while func.buffers_used.length > first {
        let i = func.buffers_used.length - 1
        let decl = func.buffers_used.get(i) ! break
        func.buffers_used.remove(i)
        func.buffer_pool.append(decl)
    }
}

// A reused pointer buffer retains the type it was allocated with because old
// Values still reference that Decl. Give each new reference the requested
// semantic type; all managed pointer types have the same physical IR storage.
fn vgen_buffer_decl(decl: Decl, type: Type) Value {
    let value = vgen_decl(decl)
    value.rett = type
    return value
}

// Spill a GC-tracked value into a pooled gc-stack-rooted decl so it survives
// sibling argument evaluation that may trigger a collection.
fn buffer_value(ctx: Context, func: Func, value: Value) Value {
    let decl = func_take_buffer(func, value.rett)
    let buffered = vgen_buffer_decl(decl, value.rett)
    buffered.exp = value.exp
    buffered.pre_value = vgen_assign(vgen_buffer_decl(decl, value.rett), value, ASSIGN_OP.set, ctx.build, value.exp)
    return buffered
}

// Spill every GC-tracked value in place. vgen_call runs this over every argument
// list, so callers assembling a call spill only the receiver.
fn buffer_values(ctx: Context, values: Array[Value]) {
    let func = ctx.func
    if !isset(func) : return
    if func.no_buffers : return
    each values as v, i {
        if v.needs_buffer() : values.set(i, buffer_value(ctx, func, v)) _
    }
}

////////////////////////////
// Calls and atomics
////////////////////////////

// Function / method call. Pass `type_void(b)` when the return type is unknown.
fn vgen_call(ctx: Context, callee: Value, args: Array[Value], rett: Type, scope: ?Scope (null)) Value {
    buffer_values(ctx, args)
    let call_func = callee.resolve_call_func()
    if isset(scope) && isset(call_func) && (call_func.must_exit || call_func.will_exit) {
        scope.did_return = true
    }
    let call_kind = CALL_KIND.direct
    if isset(call_func) && call_func.is_interface {
        call_kind = CALL_KIND.interface_dispatch
    } else if callee.rett.get_non_nullable().type == TYPE.fn {
        if callee.type != VAL.func || (isset(call_func) && call_func.is_literal) {
            call_kind = CALL_KIND.closure
        }
    }
    return Value {
        type: VAL.call
        value1: callee
        values: args
        op: call_kind
        rett: rett
    }
}

fn vgen_atomic_op(left: Value, right: Value, op: VALUE_OP, at: ?Exp (null)) Value {
    return Value {
        type: VAL.atomic_op
        value1: left
        value2: right
        op: op
        rett: left.rett
        exp: at
    }
}

fn vgen_atomic_store(left: Value, right: Value, at: ?Exp (null)) Value {
    return Value {
        type: VAL.atomic_store
        value1: left
        value2: right
        rett: left.rett
        exp: at
    }
}

fn vgen_atomic_load(left: Value, at: ?Exp (null)) Value {
    return Value {
        type: VAL.atomic_load
        value1: left
        rett: left.rett
        exp: at
    }
}

fn vgen_memcpy(values: Array[Value], b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.memcpy
        values: values
        rett: type_void(b)
        exp: at
    }
}

// `on.@cast(Type)`.
fn vgen_cast(on: Value, type: Type) Value {
    return Value {
        type: VAL.cast
        value1: on
        rett: type
    }
}

////////////////////////////
// Aggregates and memory
////////////////////////////

// Class / struct init. `fields` entries have `.name` = property name.
fn vgen_class_init(ctx: Context, class: Class, fields: Array[Value], rett: Type, at: ?Exp (null)) Value !Error {
    // Evaluate GC field values into tracked stack declarations before the
    // object allocation. The new object is not visible to the collector yet,
    // so its fields can subsequently be initialized with plain stores.
    let func = ctx.func
    if isset(func) && !func.no_buffers {
        each fields as field, i {
            if !field.rett.has_gc_refs() : continue
            // These values are already rooted or cannot trigger an allocation.
            // @undefined must remain absent rather than exposing an arbitrary
            // pointer to the stack scanner.
            if field.type == VAL.decl || field.type == VAL.null || field.type == VAL.string || field.type == VAL.undefined {
                continue
            }
            let buffered = buffer_value(ctx, func, field)
            buffered.name = field.name
            fields.set(i, buffered) _
        }
    }

    let result = Value {
        type: VAL.class_init
        values: fields
        rett: rett
        of_type: rett
        class_ref: class
        exp: at
        // Keep class identity via of_type.class (on rett)
    }
    if class.kind == CLASS_KIND.class || class.kind == CLASS_KIND.slice {
        let exp = at
        if !isset(exp) : ctx.build.bug("GC class init is missing its source expression")
        // Zero-sized classes use the legacy null-object representation and do
        // not consume a Pool allocator.
        if class.compute_body_size() !> > 0 {
            result.allocator = allocator_for_class(ctx, class, exp) !>
        }
    }
    if rett.get_non_nullable().shared && rett.is_gc_type() {
        let func = ctx.func
        let exp = at
        if !isset(func) || !isset(exp) : return result
        let scope = func.body_scope
        if !isset(scope) : return result
        let decl = Decl.new(func, rett, false)
        decl.is_mut = true
        func.all_decls.append(decl)
        let stored = vgen_decl(decl)
        let body = Array[Value]{ vgen_assign(stored, result, ASSIGN_OP.set, ctx.build, exp) }
        body.append(gc_helper_call(ctx, scope, exp, "share_null_check", Array[Value]{ vgen_cast(stored, type_ptr(ctx.build)) }) !>)
        return vgen_scoped_value(body, stored, exp)
    }
    return result
}

// Fixed-array init `{ a, b, ... }`. `elements` are in index order.
fn vgen_array_init(ctx: Context, elements: Array[Value], rett: Type, at: ?Exp (null)) Value {
    let func = ctx.func
    if isset(func) && !func.no_buffers {
        each elements as element, i {
            if !element.rett.has_gc_refs() : continue
            if element.type == VAL.decl || element.type == VAL.null || element.type == VAL.string || element.type == VAL.undefined {
                continue
            }
            elements.set(i, buffer_value(ctx, func, element)) _
        }
    }
    return Value {
        type: VAL.array_init
        values: elements
        rett: rett
        of_type: rett
        exp: at
    }
}

// Element access `on[index]` or `@ptrv(on, T, index)`. `rett` is the element type.
fn vgen_ptrv(on: Value, index: Value, rett: Type, at: ?Exp (null)) Value {
    return Value {
        type: VAL.ptrv
        value1: on
        value2: index
        rett: rett
        of_type: rett
        exp: at
    }
}

fn vgen_ptr_offset(on: Value, offset: Value, at: ?Exp (null)) Value {
    return Value {
        type: VAL.ptr_offset
        value1: on
        value2: offset
        // Pointer offsets are byte-address operations and yield the canonical
        // void-pointer type, matching the classic compiler. `type_ptr` prefers
        // core:ptr and only uses the primitive stand-in before core is parsed.
        rett: type_ptr(on.rett.build)
        exp: at
    }
}

// `@ref(lvalue)` — address-of; rett is raw `ptr` (or *T when known).
fn vgen_ptr_of(on: Value, rett: Type, at: ?Exp (null)) Value {
    return Value {
        type: VAL.ptr_of
        value1: on
        rett: rett
        exp: at
    }
}

// Copy an inline value out of pointer/reference storage.
fn vgen_load(on: Value, rett: Type, at: ?Exp (null)) Value {
    return Value {
        type: VAL.load
        value1: on
        rett: rett
        of_type: rett
        exp: at
    }
}

// ---- Function-body values (rett = void) ----

// Local allocation/ownership lives on Scope/Func. The executable AST contains
// only the stores for declarations that actually have an initializer.
fn vgen_decl_initializers(decls: Array[Decl], inits: Array[Value], b: Build, at: ?Exp (null)) Value {
    let statements = Array[Value]{}
    each decls as decl, i {
        let init = inits.get(i) ! continue
        statements.append(vgen_assign(vgen_decl(decl), init, ASSIGN_OP.set, b, at))
    }
    return vgen_block(statements, b, at)
}

////////////////////////////
// Assignment
////////////////////////////

fn vgen_assign(
    left: Value,
    right: Value,
    op: ASSIGN_OP,
    b: Build,
    at: ?Exp (null),
    ctx: ?Context (null)
) Value {
    if left.type == VAL.decl {
        let decl = left.decl
        if isset(decl) && !decl.closure_holds_captures && decl.type.get_non_nullable().type == TYPE.fn {
            let assigned_func = right.func
            if right.type != VAL.func || isset(right.value1) || !isset(assigned_func) || !assigned_func.capture_free {
                decl.closure_holds_captures = true
            }
        }
    }
    // Updating by-value object storage can require several GC bookkeeping
    // calls. Keep an aggregate RHS rooted until every embedded reference has
    // been accepted. A direct managed pointer still uses the established
    // single-call path and must not gain an extra GC-stack lifetime here.
    if right.needs_buffer() && left.rett.has_gc_refs() && !left.rett.is_gc_type() && isset(ctx) {
        let func = ctx.func
        let needs_runtime = false
        if left.type == VAL.prop {
            let owner = left.value1
            needs_runtime = isset(owner) && owner.rett.is_gc_type()
        } else if left.type == VAL.global {
            let global = left.global
            needs_runtime = isset(global) && global.shared
        }
        if needs_runtime && isset(func) && !func.no_buffers {
            right = buffer_value(ctx, func, right)
        }
    }
    return Value {
        type: VAL.assign
        value1: left
        value2: right
        op: op
        rett: type_void(b)
        exp: at
    }
}

////////////////////////////
// Control flow
////////////////////////////

// if/while/block: body sequences live in `values`; else branch is optional value2 (usually VAL.block).
fn vgen_if(cond: Value, then_body: Array[Value], else_body: ?Value, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.if
        value1: cond
        values: then_body
        value2: else_body
        rett: type_void(b)
        exp: at
    }
}

fn vgen_while(cond: Value, body: Array[Value], b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.while
        value1: cond
        values: body
        rett: type_void(b)
        exp: at
    }
}

fn vgen_block(body: Array[Value], b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.block
        values: body
        rett: type_void(b)
        exp: at
    }
}

// Statements followed by the value they produce — the building block for any
// lowering that has to set something up before it can name its result.
fn vgen_scoped_value(body: Array[Value], result: Value, at: ?Exp (null)) Value {
    return Value {
        type: VAL.block
        values: body
        value1: result
        rett: result.rett
        exp: at
    }
}

fn vgen_return(value: ?Value, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.return
        value1: value
        rett: type_void(b)
        exp: at
    }
}

fn vgen_throw(value: Value, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.throw
        value1: value
        rett: type_void(b)
        exp: at
    }
}

fn vgen_break(b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.break
        rett: type_void(b)
        exp: at
    }
}

fn vgen_continue(b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.continue
        rett: type_void(b)
        exp: at
    }
}

fn vgen_run_defers(stack: Decl, pop: Func, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.run_defers
        value1: vgen_decl(stack)
        func: pop
        rett: type_void(b)
        exp: at
    }
}

////////////////////////////
// Generated function scaffolding
////////////////////////////

fn vgen_allocas(values: Array[Value], b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.allocas
        values: values
        rett: type_void(b)
        exp: at
    }
}

fn vgen_init_allocators(scope: Scope, ctx: Context, at: Exp) Value {
    let result = Value {
        type: VAL.init_allocators
        int_val: ctx.build.lists.allocator_init_sites.length.to(int)
        rett: type_void(ctx.build)
        exp: at
    }
    ctx.build.lists.allocator_init_sites.append(AllocatorInitSite {
        value: result
        scope: scope
        ctx: ctx
        exp: at
    })
    return result
}

fn vgen_decl_offset(decl: Decl, b: Build) Value {
    return Value {
        type: VAL.decl_offset
        decl: decl
        rett: type_void(b)
    }
}

fn vgen_gc_stack_init(size: uint, count: uint, b: Build) Value {
    return Value {
        type: VAL.gc_stack_init
        int_val: size.to(int)
        value1: vgen_int(count.to(int), type_int(b))
        rett: type_void(b)
    }
}

fn vgen_gc_stack_defer(b: Build) Value {
    return Value {
        type: VAL.gc_stack_defer
        rett: type_void(b)
    }
}

fn vgen_stable_stack_init(decl: Decl, size: uint, b: Build) Value {
    return Value {
        type: VAL.stable_stack_init
        decl: decl
        int_val: size.to(int)
        rett: type_void(b)
    }
}

fn vgen_ir_comment(comment: String, b: Build, at: ?Exp (null)) Value {
    return Value {
        type: VAL.ir_comment
        string_val: comment
        rett: type_void(b)
        exp: at
    }
}

////////////////////////////
// Value scopes
////////////////////////////

// Phi of control-flow values (e.g. all `return`s inside a vscope).
fn vgen_phi(values: Array[Value], rett: Type, at: ?Exp (null)) Value {
    return Value {
        type: VAL.phi
        values: values
        rett: rett
        exp: at
    }
}

// Value scope `<{...}`: body statements + phi of return values.
fn vgen_vscope(body: Array[Value], phi: Value, at: ?Exp (null)) Value {
    return Value {
        type: VAL.vscope
        values: body
        value1: phi
        rett: phi.rett
        exp: at
    }
}

// Inline aggregate built from its elements, in IR field order. Any type whose
// IR form is a struct — fn pairs, multi returns, tagged nullables — is assembled
// with this; pad fields are vgen_undefined values of the padding type.
fn vgen_multi(values: Array[Value], rett: Type, at: ?Exp (null)) Value {
    return Value {
        type: VAL.multi
        values: values
        rett: rett
        exp: at
    }
}

// Element `index` of an inline aggregate value. The source is emitted once and
// reused across the parts taken from it.
fn vgen_multi_part(on: Value, index: uint, rett: Type, at: ?Exp (null)) Value {
    return Value {
        type: VAL.multi
        name: "part"
        int_val: index.@cast(int)
        value1: on
        rett: rett
        exp: at ?? on.exp
    }
}

// Multi-value group `(a, b, …)` — used for multi returns and multi lets.
fn vgen_grouped_values(b: Build, values: Array[Value], force: bool (false)) Value {
    if values.length == 1 && !force {
        let first = values.get(0) !? null
        if isset(first) : return first
    }
    let types = Array[Type]{}
    each values as val {
        types.append(val.rett)
    }
    let rett = type_multi(b, types, force)
    return Value {
        type: VAL.multi
        values: values
        rett: rett
    }
}

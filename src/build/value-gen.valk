
// Construct Value objects without an Exp (used by value_from_exp and later IR).

fn vgen_undefined(b: Build) Value {
    return Value {
        type: VAL.undefined
        rett: type_void(b)
    }
}

fn vgen_int(value: int, type: Type) Value {
    return Value {
        type: VAL.int
        int_val: value
        rett: type
    }
}

fn vgen_float(value: f64, type: Type) Value {
    return Value {
        type: VAL.float
        float_val: value
        rett: type
    }
}

fn vgen_bool(value: bool, type: Type) Value {
    return Value {
        type: VAL.bool
        bool_val: value
        rett: type
    }
}

fn vgen_string(value: String, type: Type) Value {
    return Value {
        type: VAL.string
        string_val: value
        rett: type
    }
}

// Char literals are stored as both the source text and the integer code unit.
fn vgen_char(code: int, text: String, type: Type) Value {
    return Value {
        type: VAL.char
        int_val: code
        string_val: text
        rett: type
    }
}

fn vgen_null(type: Type) Value {
    return Value {
        type: VAL.null
        rett: type
    }
}

// Identifier reference. Optional namespace, resolved Idf, and result type.
fn vgen_id(name: String, ns_name: ?String (null), idf: ?Idf (null), type: ?Type (null)) Value {
    return Value {
        type: VAL.id
        name: name
        ns_name: ns_name
        idf: idf
        rett: type
    }
}

// Compile-time type value: `T` / `String` as a value. rett is String; actual Type in of_type.
fn vgen_type(of_type: Type, b: Build) Value {
    return Value {
        type: VAL.type
        of_type: of_type
        rett: type_string(b)
        string_val: of_type.custom_name
    }
}

// Property / method name access: `on.name` (still VAL.id with value1 = receiver).
fn vgen_dot(on: Value, name: String, type: ?Type (null)) Value {
    return Value {
        type: VAL.id
        name: name
        value1: on
        rett: type
    }
}

// Binary operator.
fn vgen_op(left: Value, right: Value, op: VALUE_OP, rett: ?Type (null)) Value {
    return Value {
        type: VAL.op
        op: op
        value1: left
        value2: right
        rett: rett ?? left.rett
    }
}

// Unary operator (`!`, `-`, …).
fn vgen_unary(operand: Value, op: VALUE_OP, rett: ?Type (null)) Value {
    return Value {
        type: VAL.unary
        op: op
        value1: operand
        rett: rett ?? operand.rett
    }
}

// Function / method call. `rett` optional until signature typing is done.
fn vgen_call(callee: Value, args: Array[Value], rett: ?Type (null)) Value {
    return Value {
        type: VAL.call
        value1: callee
        values: args
        rett: rett
    }
}

// `on.@cast(Type)`.
fn vgen_cast(on: Value, type: Type) Value {
    return Value {
        type: VAL.cast
        value1: on
        cast_type: type
        rett: type
    }
}

// Grouping (usually folded away; kept for completeness).
fn vgen_paren(inner: Value) Value {
    return Value {
        type: VAL.paren
        value1: inner
        rett: inner.rett
    }
}

// Multi-value list (call argument packs, multi returns, …).
fn vgen_multi(values: Array[Value], rett: ?Type (null)) Value {
    return Value {
        type: VAL.multi
        values: values
        rett: rett
    }
}

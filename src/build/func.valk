// Compiler-facing function object created from an EXP.func expression.
// Raw signature EXPs are resolved by pipeline.parse_func_types.

class Arg {
    name: String
    type: Type
    // Default value still raw: EXP.body `(...)` when present
    default: ?Exp (null)
    is_generic: bool (false)
    generic_name: String ("")
}

class Func {
    unit: Unit
    ns: Namespace
    name: String
    act: ACT
    // Original parse expression (source span / raw AST)
    exp: Exp
    // Scope for argument names + signature type resolution
    // (parent = file scope for free funcs, class/trait scope for methods)
    arg_scope: Scope
    // Sub-expressions from EXP.func (still raw until type stage)
    generics: ?Exp (null) // EXP.body `[...]`
    args_exp: ?Exp (null) // EXP.body `(...)` (null for getters)
    rett_exp: ?Exp (null) // EXP.type
    error: ?Exp (null)    // EXP.id (error type after `!`)
    body: ?Exp (null)     // EXP.body `{...}` (null when signature-only `;`)
    flags: ?Array[String] (null)
    // Resolved signature (filled by parse_func_types)
    args: Array[Arg] (.{})
    rett: ?Type (null) // null → void
    infinite_args: bool (false) // `@infinite` in arg list
    parsed_types: bool (false)
    // Generic declaration: `fn foo[T, U](...)`
    is_generic_base: bool (false)
    generic_names: ?Array[String] (null)
    // `test "name" { ... }` — no args; only built when options.is_test
    is_test: bool (false)
    test_name: String ("")
    // Method / getter fields (null class ⇒ free function)
    class: ?Class (null)
    group: ?Group (null)
    is_static: bool (false)
    is_getter: bool (false) // `get name: Type { ... }`

    fn get_rett() Type {
        let r = this.rett
        if isset(r) : return r
        return type_void(this.ns.build)
    }
}

// Resolve argument list + return type from raw EXP fields on Func.
fn parse_func_types(func: Func) !Error {
    if func.parsed_types : return
    func.parsed_types = true

    // Bind generic type parameters on arg_scope before reading types
    bind_func_generics(func) !>

    // Instance methods / getters: implicit `this` first
    let owner = func.class
    if isset(owner) && !func.is_static {
        let this_type = owner.get_type() !>
        func.args.append(Arg {
            name: "this"
            type: this_type
        })
    }

    // Arguments from EXP.body `(...)` — getters have none
    if !func.is_getter {
        let args_body = func.args_exp
        if isset(args_body) {
            parse_func_args_body(func, args_body) !>
        }
    }

    // Return type (optional; void when omitted)
    let rett_exp = func.rett_exp
    if isset(rett_exp) {
        func.rett = type_from_exp(rett_exp, func.arg_scope) !>
    } else {
        func.rett = type_void(func.ns.build)
    }

    // Error type after `!` — left as EXP.id until error types are resolved on Func
}

// Parse `fn name[T, U]` generic names and bind each as IDF.type on arg_scope.
fn bind_func_generics(func: Func) !Error {
    let body = func.generics
    if !isset(body) : return
    let names = parse_class_generic_names(body) !>
    func.generic_names = names
    func.is_generic_base = true
    let b = func.ns.build
    each names as gname {
        // Fresh type param (not the shared type_any cache)
        let t = Type {
            type: TYPE.any
            build: b
            custom_name: gname
        }
        func.arg_scope.set_idf(gname, Idf.for_type(t))
    }
}

// Parse contents of the arguments body: name: Type [(default)], ... [@infinite]
fn parse_func_args_body(func: Func, body: Exp) !Error {
    let pos = body.pos
    if !isset(pos) : body.bug("Function args body is missing a Pos")
    let p = pos.copy().init_parser()
    let scope = func.arg_scope

    while true {
        let t = p.tok(true, true) !>
        if t == TOK.sign && p.word_is(")") : break
        if t == TOK.end : body.error("Unexpected end of file in function arguments")

        // @infinite — must be last before `)`
        if t == TOK.at_word && p.word_is("@infinite") {
            func.infinite_args = true
            p.expect(")", true, true) !>
            break
        }

        if t != TOK.word {
            p.error("Invalid argument name: '" + p.word() + "'")
        }
        let name = p.word()
        if scope.has_local(name) {
            p.error("Duplicate argument name: " + name)
        }

        p.expect(":", true, true) !>

        // Type: normal type, or `$G` for generic arg type (method-style)
        let is_generic = false
        let generic_name = ""
        let arg_type = type_any(func.ns.build)
        t = p.tok(true, true, false) !>
        if t == TOK.flag {
            p.tok(true, true) !>
            let full_name = p.word()
            let gname = full_name.ltrim("$")
            if gname.length == 0 : p.error("Empty generic argument name")
            is_generic = true
            generic_name = gname
            // Placeholder until generic-arg specialization exists (not the shared type_any cache)
            arg_type = Type {
                type: TYPE.any
                build: func.ns.build
                custom_name: full_name
            }
        } else {
            let type_exp = read_type_exp(p, true, true) !>
            arg_type = type_from_exp(type_exp, scope) !>
        }

        // Optional default: ( ... )
        let default: ?Exp = null
        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is("(") {
            p.tok(true, true) !>
            default = read_body_exp(p, "(", ")") !>
        }

        // Skip void-typed args (old compiler does the same)
        if arg_type.type != TYPE.void {
            let arg = Arg {
                name: name
                type: arg_type
                default: default
                is_generic: is_generic
                generic_name: generic_name
            }
            func.args.append(arg)
        }

        t = p.tok(true, true) !>
        if t == TOK.sign && p.word_is(",") : continue
        if t == TOK.sign && p.word_is(")") : break
        p.error("Expected ',' or ')' in function arguments, found: '" + p.word() + "'")
    }
}

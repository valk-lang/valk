use helper


class Arg {
    name: String
    type: Type
    // Storage for the argument; bound as IDF.decl on Func.arg_scope
    decl: Decl
    // Default value still raw: EXP.body `(...)` when present
    default: ?Exp (null)
    // `$G` style generic arg type (inferred from call-site values)
    is_generic: bool (false)
    generic_name: String ("")
    // Body-derived effect: data reachable through this argument may outlive the call.
    may_escape: bool (true)
    // The body may introduce an external mutable alias into its reachable graph.
    invalidates_unique: bool (true)
    // Effect edges point from a callee argument to caller arguments whose data
    // was passed through it. They also make recursive call graphs finite.
    escape_dependents: ?Array[Arg] (null)
    unique_dependents: ?Array[Arg] (null)
    cannot_escape_pos: ?Pos (null)
    cannot_invalidate_unique_pos: ?Pos (null)
    cannot_shared_borrow_pos: ?Pos (null)
}

class FuncGenerated {
    ir_name: String ("")
    ir_address: String ("")
    ir_code: String ("")
    value_type: ?Type (null)
    bound_value_type: ?Type (null)
}

class Func {
    unit: Unit
    ns: Namespace
    name: String
    act: ACT
    // Original parse expression (source span / raw AST)
    exp: Exp
    arg_scope: Scope
    // Sub-expressions from EXP.func (still raw until type stage)
    generics: ?Exp (null) // EXP.body `[...]`
    args_exp: ?Exp (null) // EXP.body `(...)` (null for getters)
    rett_exp: ?Exp (null) // EXP.type
    error: ?Exp (null)    // EXP.id (error type after `!`)
    body: ?Exp (null)     // EXP.body `{...}` (null when signature-only `;`)
    flags: ?Array[String] (null)
    // Resolved signature (filled by parse_func_types)
    args: Array[Arg] (.{})
    rett: ?Type (null) // null → void
    error_type: ?ErrorType (null)
    can_error: bool (false)
    infinite_args: bool (false) // `@infinite` in arg list
    parsed_types: bool (false)
    // ---- Generics: `fn foo[T, U](...)` ----
    is_generic_base: bool (false)
    generic_names: ?Array[String] (null)
    // Concrete type args for a specialization (`foo[String]` → [String type])
    generic_types: ?Array[Type] (null)
    // Base when this is a specialization
    generic_from: ?Func (null)
    // Cache of specializations (only on the base): key → Func
    generic_cache: ?Map[Func] (null)
    // `$G` arg-type generics (inferred at call site)
    has_generic_args: bool (false)
    generic_arg_names: Array[String] (.{})
    generic_args_defined: bool (false)
    // Map name → Type for both [T] and $G bindings (specializations)
    generic_type_map: ?Map[Type] (null)
    // ---- Flags / linkage ----
    is_extern: bool (false)
    is_export: bool (false)
    is_entrance: bool (false)
    must_exit: bool (false)   // $exit
    will_exit: bool (false)   // @willexit
    must_throw: bool (false)  // $throw
    is_hot: bool (false)      // $hot
    is_inline: bool (false)   // $inline
    is_global: bool (false)   // $global (free funcs only)
    info_calls_unknown_code: bool (false)
    info_creates_objects: bool (false)
    // functions_used inverted, built during that propagation.
    called_by: Array[Func] (.{})
    disable_gc_stack: bool (false)
    pending_exps: ?Array[Exp] (null)
    has_globals_loop: bool (false)
    auto_to: bool (false)     // $auto (also registers as $to)
    no_buffers: bool (false)  // @nobuffers
    shared_unsafe: bool (false)
    skip_ast: bool (false)    // generic-arg bases (and similar) skip body parse until specialized
    is_test: bool (false)
    // `synctest` functions run only after all previously-started tests finish.
    is_sync: bool (false)
    test_name: String ("")
    // Local TestEntry initialized for a `test` body and used by assert().
    test_entry_decl: ?Decl (null)
    // Method / getter fields (null class ⇒ free function)
    class: ?Class (null)
    group: ?Group (null)
    is_static: bool (false)
    is_getter: bool (false) // `get name: Type { ... }`
    mutates_receiver: bool (false)
    unique_summary_ready: bool (false)
    computing_unique_summary: bool (false)
    returns_unique_graph: bool (false)
    unique_return_args: Array[uint] (.{})
    unique_summary_saw_return: bool (false)
    is_shared_receiver: bool (false)
    shared_receiver_func: ?Func (null)
    is_clone_hook: bool (false)
    clone_at: ?Exp (null)
    clone_check_access: bool (true)
    clone_variants: Map[Func] (.{})
    // Signature-only interface method and its stable slot in the interface adapter.
    is_interface: bool (false)
    interface_slot: uint (0)
    // ---- Function body AST (parse_func_asts) ----
    parsed_ast: bool (false)
    // Body scope: parent = arg_scope; holds locals + body Values
    body_scope: ?Scope (null)
    alloca_scope: ?Scope (null)
    defer_scope: ?Scope (null)
    user_defer_stack: ?Decl (null)
    user_defer_pop: ?Func (null)
    all_decls: Array[Decl] (.{})
    define_decls: Array[Decl] (.{})
    buffer_pool: Array[Decl] (.{})
    buffers_used: Array[Decl] (.{})
    gc_decl_count: uint (0)
    alloca_size: uint (0)
    stable_alloca_size: uint (0)
    stable_stack_decl: ?Decl (null)
    is_literal: bool (false)
    // A shared literal publishes one capture environment for concurrent readers.
    is_shared: bool (false)
    // Cleared as soon as identifier resolution captures an outer declaration.
    capture_free: bool (true)
    capture_decls: Array[Decl] (.{})
    capture_args: Array[Decl] (.{})
    // GC-allocated binding data for a closure, prepared after body resolution.
    capture_class: ?Class (null)
    capture_allocator: ?Allocator (null)
    capture_header_size: u32 (0)
    // Value-AST clone helper for this literal's capture env (generated on demand).
    capture_clone_func: ?Func (null)
    // Textual LLVM generated immediately after func_finish_ast.
    generated: ?FuncGenerated (null)
    functions_used: Array[Func] (.{})
    globals_used: Array[Global] (.{})
    // Indices into this function's own Unit.string_values.
    strings_used: Array[uint] (.{})
    info_used: bool (false)

    fn get_generated() FuncGenerated $inline {
        let generated = this.generated
        if isset(generated) : return generated
        let created = FuncGenerated {}
        this.generated = created
        return created
    }

    fn get_ir_name() String $inline {
        let generated = this.generated
        return isset(generated) ? generated.ir_name : ""
    }

    fn set_ir_name(value: String) $inline { this.get_generated().ir_name = value }

    fn get_ir_address() String $inline {
        let generated = this.generated
        return isset(generated) ? generated.ir_address : ""
    }

    fn set_ir_address(value: String) $inline { this.get_generated().ir_address = value }

    fn get_ir_code() String $inline {
        let generated = this.generated
        return isset(generated) ? generated.ir_code : ""
    }

    fn set_ir_code(value: String) $inline { this.get_generated().ir_code = value }

    fn get_rett() Type {
        let r = this.rett
        if isset(r) : return r
        return type_void(this.ns.build)
    }

    fn get_value_type(bound_receiver: bool (false)) Type {
        let generated = this.generated
        let cached = !isset(generated)
            ? null[?Type]
            : (bound_receiver ? generated.bound_value_type : generated.value_type)
        if isset(cached) : return cached
        let arg_types = Array[Type]{}
        let skip_this = bound_receiver && isset(this.class) && !this.is_static
        each this.args as arg, i {
            if skip_this && i == 0 : continue
            arg_types.append(arg.type)
        }
        let result = type_callable(this.ns.build, TYPE.closure, arg_types, this.get_rett(), this.error_type)
        let cache = this.get_generated()
        if bound_receiver : cache.bound_value_type = result
        else : cache.value_type = result
        return result
    }

    fn specialize(gtypes: Array[Type], at: Exp) Func !Error {
        if !this.is_generic_base {
            at.error("Function is not generic: " + this.name)
        }
        let names = this.generic_names
        if !isset(names) : at.bug("Generic base is missing generic_names")
        if gtypes.length != names.length {
            at.error("Generic function '" + this.name + "' expects " + names.length + " type argument(s), got " + gtypes.length)
        }
        return get_func_generic(this, gtypes, null) !>
    }

    fn specialize_generic_args(extra_names: Array[String], extra_types: Array[Type], at: Exp) Func !Error {
        if !this.has_generic_args && !this.is_generic_base {
            at.error("Function has no generic parameters: " + this.name)
        }
        if extra_names.length != extra_types.length {
            at.bug("generic arg name/type length mismatch")
        }
        // Combine fixed [T] types (if already a specialization) with $G types
        let all_types = Array[Type]{}
        let fixed = this.generic_types
        if isset(fixed) {
            each fixed as t : all_types.append(t)
        } else if this.is_generic_base {
            at.error("Generic function '" + this.name + "' requires type arguments before call")
        }
        each extra_types as t : all_types.append(t)

        // Base for the cache is always the generic root
        let base = this.generic_from ?? this
        return get_func_generic(base, all_types, extra_names) !>
    }
}

// Resolve argument list + return type + error type + flags from raw EXP fields.
fn parse_func_types(func: Func) !Error {
    if func.parsed_types : return
    func.parsed_types = true

    // Generic bases only bind type-param names; full signature needs specialization
    if func.is_generic_base {
        bind_func_generics(func) !>
        let flags = func.flags
        if isset(flags) && flags.contains("$default") {
            func.exp.error("Functions marked with $default cannot declare generic parameters")
        }
        if isset(flags) && flags.contains("$clone") {
            func.exp.error("Functions marked with $clone cannot declare generic parameters")
        }
        return
    }

    // Bind [T] params (specialization already placed concrete types on arg_scope)
    bind_func_generics(func) !>

    // Instance methods / getters: implicit `this` first
    let owner = func.class
    if isset(owner) && !func.is_static {
        let this_type = owner.get_type() !>
        if owner.representation_class().kind == CLASS_KIND.struct : this_type = this_type.non_inline()
        if func.is_shared_receiver : this_type = this_type.shared_type()
        append_func_arg(func, "this", this_type)
    }

    // Arguments from EXP.body `(...)` — getters have none
    if !func.is_getter {
        let args_body = func.args_exp
        if isset(args_body) {
            parse_func_args_body(func, args_body) !>
        }
    }
    if func.is_export && func.has_generic_args {
        func.exp.error("Exported functions cannot declare generic parameters")
    }

    if func.has_generic_args && !func.generic_args_defined {
        each func.generic_arg_names as gname {
            let t = Type {
                build: func.ns.build
                kind: TYPE.any
                custom_name: gname
            }
            func.arg_scope.set_idf(gname, Idf.for_type(t))
        }
    }

    if func.name == "main"
        && !isset(func.class)
        && func.ns.pkg == func.ns.build.main_pkg
        && func.ns.build.options.mode != BUILDTYPE.lib {
        if func.args.length > 1 {
            func.exp.error("The 'main' function has too many arguments (max: 1)")
        }
        func.ns.build.main_func = func

        let array_idf = valk_idf(func.ns.build, "core", "Array") !>
        if array_idf.type != IDF.class {
            func.exp.bug("Identifier in valk:core is not a class: Array")
        }
        let array_class = array_idf.class
        if !isset(array_class) : func.exp.bug("Array class idf is missing its class")
        let cli_type = array_class.specialize(Array[Type]{ type_string(func.ns.build) }, func.exp) !>
        let cli_array = cli_type.get_type() !>

        let existing = func.args.get(0) !? null
        if isset(existing) {
            if !cli_array.compat(existing.type) {
                func.exp.error("The first argument of 'main' must be of type: " + cli_array.compat_display_name() + ", instead of: " + existing.type.compat_display_name())
            }
        } else {
            append_func_arg(func, "cli_args", cli_array)
        }
    }

    if func.is_test {
        append_func_arg(func, "test_results", type_from_core(func.ns.build, "TestResults") !>)
    }

    // Return type (optional; void when omitted)
    let rett_exp = func.rett_exp
    if isset(rett_exp) {
        func.rett = type_from_exp(rett_exp, func.arg_scope) !>
    } else {
        func.rett = type_void(func.ns.build)
    }

    if func.is_extern || func.is_export {
        let linkage = func.is_extern ? "extern" : "export"
        each func.args as arg {
            if arg.type.get_non_nullable().kind == TYPE.union {
                func.exp.error("Tagged unions cannot be used in " + linkage + " function signatures")
            }
        }
        let extern_rett = func.get_rett()
        if extern_rett.get_non_nullable().kind == TYPE.union {
            func.exp.error("Tagged unions cannot be used in " + linkage + " function signatures")
        }
    }
    if func.is_extern {
        each func.args as arg {
            if arg.type.has_borrowed_refs() {
                func.exp.error("Borrowed references are not allowed in extern function signatures; use a raw pointer type")
            }
            if arg.type.has_gc_refs() {
                func.exp.error("GC-managed types are not allowed in extern function signatures; use an explicit raw-pointer protocol")
            }
        }
        let extern_rett = func.get_rett()
        if extern_rett.has_borrowed_refs() {
            func.exp.error("Borrowed references are not allowed in extern function signatures; use a raw pointer type")
        }
        if extern_rett.has_gc_refs() {
            func.exp.error("GC-managed types are not allowed in extern function signatures; use an explicit raw-pointer protocol")
        }
    }
    // Error payloads are part of the exported function's ABI graph.
    resolve_func_error_type(func) !>
    if func.is_export {
        each func.args as arg {
            type_validate_export_abi_extensions(arg.type) !>
        }
        type_validate_export_abi_extensions(func.get_rett()) !>
        let error_type = func.error_type
        if isset(error_type) {
            parse_error_type(error_type) !>
            each error_type.payload as payload_type {
                type_validate_export_abi_extensions(payload_type) !>
            }
        }
    }

    // Flags: $exit, $throw, $global, $offset, …
    apply_func_flags(func) !>

    // Array/Slice get/set remain source-compatible wrappers, but indexing no
    // longer depends on their former offset flags. Preserve set's mutation
    // contract for direct calls and shared-receiver diagnostics.
    if isset(owner) && (owner.kind == CLASS_KIND.array || owner.kind == CLASS_KIND.slice)
        && func.name == "set" {
        func.mutates_receiver = true
    }

    // Bind each arg (including `this`) as IDF.decl on arg_scope for body lookup
    bind_func_arg_decls(func) !>
}

fn get_func_shared_receiver(base: Func) Func !Error {
    if base.is_shared_receiver : return base
    let cached = base.shared_receiver_func
    if isset(cached) : return cached
    let func = get_func_shared_variant(base) !>
    base.shared_receiver_func = func
    return func
}

fn get_func_shared_variant(base: Func) Func !Error {
    let scope = Scope.new(base.arg_scope.parent)
    let generics: ?Exp = null
    let args_exp: ?Exp = null
    let rett_exp: ?Exp = null
    let error: ?Exp = null
    let body: ?Exp = null
    let source = base.generics
    if isset(source) : generics = source.copy_tree()
    source = base.args_exp
    if isset(source) : args_exp = source.copy_tree()
    source = base.rett_exp
    if isset(source) : rett_exp = source.copy_tree()
    source = base.error
    if isset(source) : error = source.copy_tree()
    source = base.body
    if isset(source) : body = source.copy_tree()
    let func = Func {
        unit: base.unit
        ns: base.ns
        name: base.name + "__shared"
        act: base.act
        exp: base.exp
        arg_scope: scope
        generics: generics
        args_exp: args_exp
        rett_exp: rett_exp
        error: error
        body: body
        generic_names: base.generic_names
        generic_types: base.generic_types
        generic_from: base.generic_from
        generic_args_defined: base.generic_args_defined
        generic_type_map: base.generic_type_map
        generic_arg_names: base.generic_arg_names
        is_extern: base.is_extern
        is_export: base.is_export
        is_entrance: base.is_entrance
        must_exit: base.must_exit
        will_exit: base.will_exit
        must_throw: base.must_throw
        is_hot: base.is_hot
        is_inline: base.is_inline
        is_global: base.is_global
        info_calls_unknown_code: base.info_calls_unknown_code
        auto_to: base.auto_to
        no_buffers: base.no_buffers
        shared_unsafe: base.shared_unsafe
        class: base.class
        group: base.group
        is_static: base.is_static
        is_getter: base.is_getter
        mutates_receiver: base.mutates_receiver
        is_interface: base.is_interface
        interface_slot: base.interface_slot
        is_shared_receiver: true
        is_clone_hook: base.is_clone_hook
    }
    let generic_map = base.generic_type_map
    if isset(generic_map) {
        each generic_map as type, name : scope.set_idf(name, Idf.for_type(type))
    }
    let owner = base.class
    if isset(owner) && !owner.is_generic_base {
        scope.set_idf("SELF", Idf.for_class(owner))
    }

    parse_func_types(func) !>
    if (isset(owner) && owner.offset == base) || base.name == "_next" {
        let rett = func.rett
        if isset(rett) : func.rett = rett.shared_storage_type()
    }
    func.unit.functions.append(func)
    if !func.skip_ast : func.ns.build.pipeline.parse_func_asts.append(func)
    return func
}

fn get_func_clone_variant(base: Func, at: Exp, check_access: bool) Func !Error {
    let key = at.src.id + ":" + at.i + ":" + check_access
    base.clone_variants.get(key) -> cached : return cached

    let scope = Scope.new(base.arg_scope.parent)
    let func = Func {
        unit: base.unit
        ns: base.ns
        name: base.name + "__clone_" + helper:ctxhash(key)
        act: base.act
        exp: base.exp
        arg_scope: scope
        generics: base.generics
        args_exp: base.args_exp
        rett_exp: base.rett_exp
        error: base.error
        body: base.body
        generic_names: base.generic_names
        generic_types: base.generic_types
        generic_from: base.generic_from
        generic_args_defined: base.generic_args_defined
        generic_type_map: base.generic_type_map
        generic_arg_names: base.generic_arg_names
        is_extern: base.is_extern
        is_export: base.is_export
        is_entrance: base.is_entrance
        must_exit: base.must_exit
        will_exit: base.will_exit
        must_throw: base.must_throw
        is_hot: base.is_hot
        is_inline: base.is_inline
        is_global: base.is_global
        info_calls_unknown_code: base.info_calls_unknown_code
        auto_to: base.auto_to
        no_buffers: base.no_buffers
        shared_unsafe: base.shared_unsafe
        class: base.class
        group: base.group
        is_static: base.is_static
        is_getter: base.is_getter
        mutates_receiver: base.mutates_receiver
        is_shared_receiver: base.is_shared_receiver
        is_clone_hook: true
        clone_at: at
        clone_check_access: check_access
    }
    base.clone_variants.set(key, func)
    let generic_map = base.generic_type_map
    if isset(generic_map) {
        each generic_map as type, name : scope.set_idf(name, Idf.for_type(type))
    }
    let owner = base.class
    if isset(owner) && !owner.is_generic_base {
        scope.set_idf("SELF", Idf.for_class(owner))
    }

    parse_func_types(func) !>
    func.unit.functions.append(func)
    if !func.skip_ast : func.ns.build.pipeline.parse_func_asts.append(func)
    return func
}

// Look up EXP.id error type and store on Func.
fn resolve_func_error_type(func: Func) !Error {
    let err_exp = func.error
    if !isset(err_exp) : return

    let idf = resolve_idf_from_id(err_exp, func.arg_scope) !>
    if idf.type != IDF.error_type {
        err_exp.error("Identifier must be an error type")
    }
    let etype = idf.error_type
    if !isset(etype) : err_exp.bug("Error-type idf is missing error_type")
    func.error_type = etype
    func.can_error = true
}

// Apply signature flags collected on EXP.func.list / Func.flags.
fn apply_func_flags(func: Func) !Error {
    let flags = func.flags
    if !isset(flags) : return

    let owner = func.class
    let b = func.ns.build
    let at = func.exp

    each flags as flag {
        if flag == "$entrance" {
            func.is_entrance = true
        } else if flag == "$exit" {
            func.must_exit = true
        } else if flag == "@willexit" {
            func.will_exit = true
        } else if flag == "$throw" {
            func.must_throw = true
        } else if flag == "$hot" {
            func.is_hot = true
        } else if flag == "$inline" {
            func.is_inline = true
        } else if flag == "$global" {
            if isset(owner) {
                at.error("'$global' is only valid on free functions, not methods")
            }
            func.is_global = true
            // Visible everywhere (like $global classes)
            b.scope.set_idf(func.name, Idf.for_func(func))
        } else if flag == "$undefined" {
            func.info_calls_unknown_code = true
        } else if flag == "$offset" {
            if !isset(owner) : at.error("'$offset' is only valid on class methods")
            validate_hook_func(func, flag, 1, true) !>
            if isset(owner.offset) {
                at.error("Multiple functions marked with $offset for the same type")
            }
            owner.offset = func
        } else if flag == "$offset_assign" {
            if !isset(owner) : at.error("'$offset_assign' is only valid on class methods")
            validate_mutating_hook_func(func, owner, flag, 2, true) !>
            func.mutates_receiver = true
            if isset(owner.offset_assign) {
                at.error("Multiple functions marked with $offset_assign for the same type")
            }
            owner.offset_assign = func
        } else if flag == "$range" {
            if !isset(owner) : at.error("'$range' is only valid on class methods")
            validate_range_hook_func(func) !>
            if isset(owner.range_hook) {
                at.error("Multiple functions marked with $range for the same type")
            }
            owner.range_hook = func
        } else if flag == "$append" {
            if !isset(owner) : at.error("'$append' is only valid on class methods")
            validate_collection_hook_func(func, owner, flag, 1) !>
            func.mutates_receiver = true
            if isset(owner.append_hook) {
                at.error("Multiple functions marked with $append for the same type")
            }
            owner.append_hook = func
        } else if flag == "$set_key" {
            if !isset(owner) : at.error("'$set_key' is only valid on class methods")
            validate_collection_hook_func(func, owner, flag, 2) !>
            func.mutates_receiver = true
            if isset(owner.set_key_hook) {
                at.error("Multiple functions marked with $set_key for the same type")
            }
            owner.set_key_hook = func
        } else if flag == "$default" {
            if !isset(owner) : at.error("'$default' is only valid on class functions")
            validate_default_hook_func(func, owner) !>
            if isset(owner.default_hook) {
                at.error("Multiple functions marked with $default for the same type")
            }
            owner.default_hook = func
        } else if flag == "$clone" {
            if !isset(owner) : at.error("'$clone' is only valid on class methods")
            validate_clone_hook_func(func, owner) !>
            if isset(owner.clone_hook) {
                at.error("Multiple functions marked with $clone for the same type")
            }
            func.is_clone_hook = true
            owner.clone_hook = func
        } else if flag == "$to" || flag == "$auto" {
            if !isset(owner) : at.error("'" + flag + "' is only valid on class methods")
            if flag == "$auto" : func.auto_to = true
            validate_hook_func(func, flag, 0) !>
            owner.to_hooks.append(func)
        } else if flag == "$eq" {
            if !isset(owner) : at.error("'$eq' is only valid on class methods")
            validate_compare_hook_func(func, flag) !>
            owner.eq_hooks.append(func)
        } else if flag == "$lt" {
            if !isset(owner) : at.error("'$lt' is only valid on class methods")
            validate_compare_hook_func(func, flag) !>
            owner.lt_hooks.append(func)
        } else if flag == "$gt" {
            if !isset(owner) : at.error("'$gt' is only valid on class methods")
            validate_compare_hook_func(func, flag) !>
            owner.gt_hooks.append(func)
        } else if flag == "$lte" {
            if !isset(owner) : at.error("'$lte' is only valid on class methods")
            validate_compare_hook_func(func, flag) !>
            owner.lte_hooks.append(func)
        } else if flag == "$gte" {
            if !isset(owner) : at.error("'$gte' is only valid on class methods")
            validate_compare_hook_func(func, flag) !>
            owner.gte_hooks.append(func)
        } else if flag == "$add" {
            if !isset(owner) : at.error("'$add' is only valid on class methods")
            validate_hook_func(func, "$add", 1) !>
            owner.add_hooks.append(func)
        } else if flag == "@nobuffers" {
            func.no_buffers = true
        } else if flag == "@shared_unsafe" {
            if !isset(owner) || func.is_static : at.error("'@shared_unsafe' is only valid on instance methods")
            func.shared_unsafe = true
        } else {
            at.error("Unknown function flag: " + flag)
        }
    }
}

fn validate_default_hook_func(func: Func, owner: Class) !Error {
    let at = func.exp
    if !func.is_static {
        at.error("Functions marked with $default must be static")
    }
    each func.args as arg {
        if !isset(arg.default) {
            at.error("Argument '" + arg.name + "' of a function marked with $default must have a default value")
        }
    }
    if func.can_error {
        at.error("Functions marked with $default cannot return an error")
    }
    let expected = owner.get_type() !>
    let actual = func.get_rett()
    if actual != expected {
        at.error("Functions marked with $default must return '" + expected.compat_display_name() + "', got '" + actual.compat_display_name() + "'")
    }
}

fn validate_clone_hook_func(func: Func, owner: Class) !Error {
    let at = func.exp
    validate_instance_hook_func(func, "$clone") !>
    if func.args.length != 1 {
        at.error("Functions marked with $clone cannot have arguments")
    }
    if func.can_error {
        at.error("Functions marked with $clone cannot return an error")
    }
    let expected = owner.get_type() !>
    let actual = func.get_rett()
    if actual != expected {
        at.error("Functions marked with $clone must return '" + expected.compat_display_name() + "', got '" + actual.compat_display_name() + "'")
    }
}

fn validate_hook_func(func: Func, flag_name: String, argc: uint, can_error: bool (false)) !Error {
    let at = func.exp
    validate_instance_hook_func(func, flag_name) !>
    // args include implicit `this`
    if func.args.length != (argc + 1) {
        at.error("Functions marked with " + flag_name + " must have " + argc + " argument(s)")
    }
    let rett = func.get_rett()
    if rett.is_void_type() {
        at.error("Functions marked with " + flag_name + " must return a value")
    }
    if rett.is_tuple_type() {
        let subs = rett.get_members()
        if isset(subs) && subs.length > 1 {
            at.error("Functions marked with " + flag_name + " must return only 1 value")
        }
    }
    if !can_error && func.can_error {
        at.error("Functions marked with " + flag_name + " cannot return an error")
    }
}

fn validate_instance_hook_func(func: Func, flag_name: String) !Error {
    if func.is_static : func.exp.error("Functions marked with " + flag_name + " cannot be static")
}

fn validate_mutating_hook_func(func: Func, owner: Class, flag_name: String, argc: uint, can_error: bool (false)) !Error {
    validate_instance_hook_func(func, flag_name) !>
    if func.args.length != argc + 1 {
        func.exp.error("Functions marked with " + flag_name + " must have " + argc + " argument(s)")
    }
    if !can_error && func.can_error {
        func.exp.error("Functions marked with " + flag_name + " cannot return an error")
    }
    let rett = func.get_rett()
    let expected = owner.get_type() !>
    if !rett.is_void_type() && !expected.compat(rett) {
        func.exp.error("Functions marked with " + flag_name + " must return void or '" + expected.compat_display_name() + "'")
    }
}

fn validate_collection_hook_func(func: Func, owner: Class, flag_name: String, argc: uint) !Error {
    validate_instance_hook_func(func, flag_name) !>
    if func.args.length < argc + 1 {
        func.exp.error("Functions marked with " + flag_name + " must have at least " + argc + " argument(s)")
    }
    let i = argc + 1
    while i < func.args.length {
        let arg = func.args.get(i) ! func.exp.bug("Collection hook argument is missing")
        if !isset(arg.default) {
            func.exp.error("Trailing argument '" + arg.name + "' of a function marked with " + flag_name + " must have a default value")
        }
        i++
    }
    if func.can_error : func.exp.error("Functions marked with " + flag_name + " cannot return an error")
    let rett = func.get_rett()
    let expected = owner.get_type() !>
    if !rett.is_void_type() && !expected.compat(rett) {
        func.exp.error("Functions marked with " + flag_name + " must return void or '" + expected.compat_display_name() + "'")
    }
}

fn validate_compare_hook_func(func: Func, flag_name: String) !Error {
    validate_hook_func(func, flag_name, 1) !>
    if !func.get_rett().is_bool_type() {
        func.exp.error("Functions marked with " + flag_name + " must return bool")
    }
}

fn validate_range_hook_func(func: Func) !Error {
    validate_hook_func(func, "$range", 2, true) !>

    let at = func.exp
    let uint_t = type_from_core(func.ns.build, "uint") !>
    let start_index = func.args.get(1) ! at.bug("'$range' function is missing its 'start_index' parameter")
    let length = func.args.get(2) ! at.bug("'$range' function is missing its 'length' parameter")
    if start_index.type != uint_t || length.type != uint_t {
        at.error("Functions marked with $range must have arguments (start_index: uint, length: uint)")
    }
}

// Create Decl for each arg and bind name → IDF.decl on arg_scope.
fn bind_func_arg_decls(func: Func) !Error {
    each func.args as arg {
        let decl = arg.decl
        let name = arg.name
        if func.arg_scope.has_local(name) {
            func.exp.error("Duplicate argument name: " + name)
        }
        if !isset(decl.exp) : decl.exp = func.exp
        func.arg_scope.set_idf(name, Idf.for_decl(decl))
        func.all_decls.append(decl, true)
    }
}

// Append a typed argument (creates Decl). Does not bind into scope yet.
fn append_func_arg(func: Func, name: String, type: Type, default: ?Exp (null), is_generic: bool (false), generic_name: String ("")) Arg {
    let decl = Decl.new(func, type, true, name)
    decl.implicit_borrow = type.has_borrowed_refs()
    let arg = Arg {
        name: name
        type: type
        decl: decl
        default: default
        is_generic: is_generic
        generic_name: generic_name
    }
    func.args.append(arg)
    return arg
}

fn bind_func_generics(func: Func) !Error {
    let body = func.generics
    if !isset(body) : return

    // Names may already be set when created as a specialization
    let names = func.generic_names
    if !isset(names) {
        names = parse_class_generic_names(body) !>
        func.generic_names = names
    }

    // Specialization: types already bound by get_func_generic
    if isset(func.generic_from) || func.generic_args_defined : return

    // Generic base: only placeholders
    if func.is_generic_base {
        let b = func.ns.build
        each names as gname {
            let t = Type {
                build: b
                kind: TYPE.any
                custom_name: gname
            }
            func.arg_scope.set_idf(gname, Idf.for_type(t))
        }
        return
    }

    let b = func.ns.build
    each names as gname {
        let t = Type {
            build: b
            kind: TYPE.any
            custom_name: gname
        }
        func.arg_scope.set_idf(gname, Idf.for_type(t))
    }
}

// Parse contents of the arguments body: name: Type [(default)], ... [@infinite]
fn parse_func_args_body(func: Func, body: Exp) !Error {
    let pos = body.pos
    if !isset(pos) : body.bug("Function args body is missing a Pos")
    let p = pos.copy().init_parser()
    let scope = func.arg_scope

    while true {
        let t = p.tok(true, true) !>
        if t == TOK.sign && p.word_is(")") : break
        if t == TOK.end : body.error("Unexpected end of file in function arguments")

        // @infinite — must be last before `)`
        if t == TOK.at_word && p.word_is("@infinite") {
            func.infinite_args = true
            p.expect(")", true, true) !>
            break
        }

        if t != TOK.word {
            p.error("Invalid argument name: '" + p.word() + "'")
        }
        let name = p.word()
        // Avoid colliding with already-bound names (generic type params, earlier args)
        if scope.has_local(name) {
            p.error("Duplicate argument name: " + name)
        }
        each func.args as existing {
            if existing.name == name : p.error("Duplicate argument name: " + name)
        }

        p.expect(":", true, true) !>

        // Type: normal type, or `$G` for generic arg type (call-site inference)
        let is_generic = false
        let generic_name = ""
        let arg_type = type_any(func.ns.build)
        t = p.tok(true, true, false) !>
        if t == TOK.flag {
            p.tok(true, true) !>
            let full_name = p.word()
            let gname = full_name.ltrim("$")
            if gname.length == 0 : p.error("Empty generic argument name")

            if func.generic_args_defined {
                // Specialization: look up concrete type for this $G name
                let gmap = func.generic_type_map
                if !isset(gmap) : p.error("(Compiler bug) Missing generic_type_map for specialized generic-arg func")
                let gt = gmap.get(gname) ! p.error("(Compiler bug) Missing argument generic type: " + gname)
                arg_type = gt
            } else {
                // Base: placeholder + track name for later specialization
                let gnames = func.generic_names
                if func.generic_arg_names.contains(gname) {
                    p.error("Duplicate generic name: " + gname)
                }
                if isset(gnames) {
                    each gnames as existing {
                        if existing == gname : p.error("Duplicate generic name: " + gname)
                    }
                }
                func.generic_arg_names.append(gname)
                is_generic = true
                generic_name = gname
                arg_type = Type {
                    build: func.ns.build
                    kind: TYPE.any
                    custom_name: full_name
                }
                func.has_generic_args = true
                func.skip_ast = true
            }
        } else {
            let type_exp = read_type_exp(p, true, true) !>
            arg_type = type_from_exp(type_exp, scope) !>
            if type_exp.kind == TYPE_KIND.void {
                type_exp.error("Function arguments cannot be void")
            }
        }

        // Optional default: ( ... )
        let default: ?Exp = null
        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is("(") {
            p.tok(true, true) !>
            default = read_body_exp(p, "(", ")") !>
        }

        // Skip void-typed args (old compiler does the same)
        if arg_type.kind != TYPE.void {
            append_func_arg(func, name, arg_type, default, is_generic, generic_name)
        }

        t = p.tok(true, true) !>
        if t == TOK.sign && p.word_is(",") : continue
        if t == TOK.sign && p.word_is(")") : break
        p.error("Expected ',' or ')' in function arguments, found: '" + p.word() + "'")
    }
}

fn restore_func_generic_scope(func: Func) {
    let gmap = func.generic_type_map
    if isset(gmap) {
        let names = func.generic_names
        if isset(names) {
            each names as name {
                gmap.get(name) -> type : func.arg_scope.set_idf(name, Idf.for_type(type))
            }
        }
        each func.generic_arg_names as name {
            gmap.get(name) -> type : func.arg_scope.set_idf(name, Idf.for_type(type))
        }
    }

    let owner = func.class
    if isset(owner) && !owner.is_generic_base {
        func.arg_scope.set_idf("SELF", Idf.for_class(owner))
    }
}

fn get_func_generic(base: Func, types: Array[Type], generic_arg_names: ?Array[String]) Func !Error {
    if !base.is_generic_base && !base.has_generic_args {
        base.exp.bug("get_func_generic on non-generic function: " + base.name)
    }

    let cache = base.generic_cache
    if !isset(cache) {
        let m = Map[Func]{}
        base.generic_cache = m
        cache = m
    }

    let key = generic_types_key(types)
    let existing = cache.get(key) !? null
    if isset(existing) : return existing

    // Parent of specialized arg_scope: same as the base's parent
    let parent = base.arg_scope.parent
    let gscope = Scope.new(parent)

    let gfunc = Func {
        unit: base.unit
        ns: base.ns
        name: base.name + "__" + key
        act: base.act
        exp: base.exp
        arg_scope: gscope
        generics: base.generics
        args_exp: base.args_exp
        rett_exp: base.rett_exp
        error: base.error
        body: base.body
        flags: base.flags
        is_generic_base: false
        generic_names: base.generic_names
        generic_types: types
        generic_from: base
        generic_args_defined: isset(generic_arg_names)
        has_generic_args: false // specialized — concrete types
        skip_ast: false
        is_extern: base.is_extern
        is_export: base.is_export
        is_entrance: base.is_entrance
        must_exit: base.must_exit
        will_exit: base.will_exit
        must_throw: base.must_throw
        is_hot: base.is_hot
        is_inline: base.is_inline
        is_global: base.is_global
        info_calls_unknown_code: base.info_calls_unknown_code
        auto_to: base.auto_to
        no_buffers: base.no_buffers
        shared_unsafe: base.shared_unsafe
        is_test: base.is_test
        is_sync: base.is_sync
        test_name: base.test_name
        class: base.class
        group: base.group
        is_static: base.is_static
        is_getter: base.is_getter
        mutates_receiver: base.mutates_receiver
    }

    // Bind type params: [T, U] names then `$G` names
    let gmap = Map[Type]{}
    gfunc.generic_type_map = gmap
    let k: uint = 0
    let names = base.generic_names
    if isset(names) {
        each names as gname {
            let type = types.get(k) ! base.exp.bug("Missing generic type argument for: " + gname)
            gmap.set(gname, type)
            gscope.set_idf(gname, Idf.for_type(type))
            k++
        }
    }
    if isset(generic_arg_names) {
        each generic_arg_names as gname {
            let type = types.get(k) ! base.exp.bug("Missing generic-arg type for: " + gname)
            gmap.set(gname, type)
            gscope.set_idf(gname, Idf.for_type(type))
            k++
        }
        gfunc.generic_arg_names = generic_arg_names
    }

    // SELF for methods (class scope may already have it; rebind for clarity)
    let owner = gfunc.class
    if isset(owner) && !owner.is_generic_base {
        gscope.set_idf("SELF", Idf.for_class(owner))
    }

    cache.set(key, gfunc)

    // Parse full signature with concrete bindings
    parse_func_types(gfunc) !>

    // Track on unit + AST pipeline (like a normal function)
    gfunc.unit.functions.append(gfunc)
    if !gfunc.skip_ast {
        gfunc.ns.build.pipeline.parse_func_asts.append(gfunc)
    }

    return gfunc
}

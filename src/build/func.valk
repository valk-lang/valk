// Compiler-facing function object created from an EXP.func expression.
// Raw signature EXPs are resolved by pipeline.parse_func_types.

class Arg {
    name: String
    type: Type
    // Storage for the argument; bound as IDF.decl on Func.arg_scope
    decl: Decl
    // Default value still raw: EXP.body `(...)` when present
    default: ?Exp (null)
    // `$G` style generic arg type (inferred from call-site values)
    is_generic: bool (false)
    generic_name: String ("")
}

class Func {
    unit: Unit
    ns: Namespace
    name: String
    act: ACT
    // Original parse expression (source span / raw AST)
    exp: Exp
    // Scope for argument names + signature type resolution
    // (parent = file scope for free funcs, class/trait/extend scope for methods)
    arg_scope: Scope
    // Sub-expressions from EXP.func (still raw until type stage)
    generics: ?Exp (null) // EXP.body `[...]`
    args_exp: ?Exp (null) // EXP.body `(...)` (null for getters)
    rett_exp: ?Exp (null) // EXP.type
    error: ?Exp (null)    // EXP.id (error type after `!`)
    body: ?Exp (null)     // EXP.body `{...}` (null when signature-only `;`)
    flags: ?Array[String] (null)
    // Resolved signature (filled by parse_func_types)
    args: Array[Arg] (.{})
    rett: ?Type (null) // null → void
    error_type: ?ErrorType (null)
    can_error: bool (false)
    infinite_args: bool (false) // `@infinite` in arg list
    parsed_types: bool (false)
    // ---- Generics: `fn foo[T, U](...)` ----
    is_generic_base: bool (false)
    generic_names: ?Array[String] (null)
    // Concrete type args for a specialization (`foo[String]` → [String type])
    generic_types: ?Array[Type] (null)
    // Base when this is a specialization
    generic_from: ?Func (null)
    // Cache of specializations (only on the base): key → Func
    generic_cache: ?Map[Func] (null)
    // `$G` arg-type generics (inferred at call site)
    has_generic_args: bool (false)
    generic_arg_names: Array[String] (.{})
    // When true, `$G` names already have concrete types in generic_types map-by-name
    // (kept as ordered list parallel to extra types after [T] types)
    generic_args_defined: bool (false)
    // Map name → Type for both [T] and $G bindings (specializations)
    generic_type_map: ?Map[Type] (null)
    // ---- Flags / linkage ----
    is_extern: bool (false)
    is_entrance: bool (false)
    must_exit: bool (false)   // $exit
    will_exit: bool (false)   // @willexit
    must_throw: bool (false)  // $throw
    is_hot: bool (false)      // $hot
    is_inline: bool (false)   // $inline
    is_global: bool (false)   // $global (free funcs only)
    // ---- GC stack elision (gc-stack.valk) ----
    // Set while this function's IR is generated: it allocates, or it hands
    // control somewhere the compiler cannot follow. Either one means a
    // collection can happen while its frame is live. Propagated from callee to
    // caller once every body has been lowered.
    info_calls_unknown_code: bool (false)
    info_creates_objects: bool (false)
    // functions_used inverted, built during that propagation.
    called_by: Array[Func] (.{})
    // Nothing reachable from here allocates, so the collector never has to see
    // this frame: locals go in plain allocas and no GC frame is opened.
    disable_gc_stack: bool (false)
    // Body statements, retained only while this function waits for the call
    // graph, for the release that normally ends parse_func_ast.
    pending_exps: ?Array[Exp] (null)
    // Contains a `#loop globals`, which expands over the globals known to be
    // used — a set that only settles once everything has been lowered. Such a
    // function keeps its body and is lowered again as that set grows
    // (globals-loop.valk).
    has_globals_loop: bool (false)
    auto_to: bool (false)     // $auto (also registers as $to)
    no_buffers: bool (false)  // @nobuffers
    skip_ast: bool (false)    // generic-arg bases (and similar) skip body parse until specialized
    // `test "name" { ... }` — receives an implicit TestResults argument;
    // only built when options.is_test
    is_test: bool (false)
    test_name: String ("")
    // Local TestEntry initialized for a `test` body and used by assert().
    test_entry_decl: ?Decl (null)
    // Method / getter fields (null class ⇒ free function)
    class: ?Class (null)
    group: ?Group (null)
    is_static: bool (false)
    is_getter: bool (false) // `get name: Type { ... }`
    // ---- Function body AST (parse_func_asts) ----
    parsed_ast: bool (false)
    // Body scope: parent = arg_scope; holds locals + body Values
    body_scope: ?Scope (null)
    // Generated scopes finalized after the complete body AST is known.
    // alloca_scope runs at function entry, or at @allocas for $entrance functions.
    // defer_scope is consumed by later lowering on every function exit.
    alloca_scope: ?Scope (null)
    defer_scope: ?Scope (null)
    all_decls: Array[Decl] (.{})
    define_decls: Array[Decl] (.{})
    gc_decl_count: uint (0)
    alloca_size: uint (0)
    stable_alloca_size: uint (0)
    stable_stack_decl: ?Decl (null)
    // True for anonymous `fn(...) {...}` value literals (VALUE_KIND.func_lit) — only these
    // can capture outer locals; top-level fns/methods are lexically closed and never do.
    is_literal: bool (false)
    // Cached fn→fnptr eligibility (computed once; only meaningful when is_literal).
    captures: ?bool (null)
    // GC-allocated binding data for a closure, prepared after body resolution.
    capture_decls: Array[Decl] (.{})
    capture_class: ?Class (null)
    capture_allocator: ?Allocator (null)
    // Textual LLVM generated immediately after func_finish_ast.
    ir_name: String ("")
    ir_code: String ("")
    // ---- Reachability (reachable.valk) ----
    // What this function's generated IR refers to. Filled while that IR is
    // written, which is where every reference is finally known: some are only
    // introduced by lowering (pool allocation, panics, coroutine helpers) and
    // have no expression in the body.
    functions_used: Array[Func] (.{})
    globals_used: Array[Global] (.{})
    // Indices into this function's own Unit.string_values.
    strings_used: Array[uint] (.{})
    // Reachable from a program entry. Everything else is left out of the
    // module, so LLVM never compiles it.
    info_used: bool (false)

    fn get_rett() Type {
        let r = this.rett
        if isset(r) : return r
        return type_void(this.ns.build)
    }

    // Type of a function used as a value. Bound instance-method references omit
    // their implicit `this` argument; static and free functions include all args.
    fn get_value_type(bound_receiver: bool (false)) Type {
        let arg_types = Array[Type]{}
        let skip_this = bound_receiver && isset(this.class) && !this.is_static
        each this.args as arg, i {
            if skip_this && i == 0 : continue
            arg_types.append(arg.type)
        }
        return Type {
            type: TYPE.fn
            build: this.ns.build
            sub_type: this.get_rett()
            sub_types: arg_types
            error_type: this.error_type
        }
    }

    // Specialize `fn foo[T, U]` with concrete type arguments.
    // Returns a cached instance when this combination was already generated.
    fn specialize(gtypes: Array[Type], at: Exp) Func !Error {
        if !this.is_generic_base {
            at.error("Function is not generic: " + this.name)
        }
        let names = this.generic_names
        if !isset(names) : at.bug("Generic base is missing generic_names")
        if gtypes.length != names.length {
            at.error("Generic function '" + this.name + "' expects " + names.length + " type argument(s), got " + gtypes.length)
        }
        return get_func_generic(this, gtypes, null) !>
    }

    // Specialize a `$G` generic-arg function (optionally after [T] types).
    // `extra_names` / `extra_types` are the `$G` names and inferred types from the call.
    fn specialize_generic_args(extra_names: Array[String], extra_types: Array[Type], at: Exp) Func !Error {
        if !this.has_generic_args && !this.is_generic_base {
            at.error("Function has no generic parameters: " + this.name)
        }
        if extra_names.length != extra_types.length {
            at.bug("generic arg name/type length mismatch")
        }
        // Combine fixed [T] types (if already a specialization) with $G types
        let all_types = Array[Type]{}
        let fixed = this.generic_types
        if isset(fixed) {
            each fixed as t : all_types.append(t)
        } else if this.is_generic_base {
            at.error("Generic function '" + this.name + "' requires type arguments before call")
        }
        each extra_types as t : all_types.append(t)

        // Base for the cache is always the generic root
        let base = this.generic_from ?? this
        return get_func_generic(base, all_types, extra_names) !>
    }
}

// Resolve argument list + return type + error type + flags from raw EXP fields.
fn parse_func_types(func: Func) !Error {
    if func.parsed_types : return
    func.parsed_types = true

    // Generic bases only bind type-param names; full signature needs specialization
    if func.is_generic_base {
        bind_func_generics(func) !>
        return
    }

    // Bind [T] params (specialization already placed concrete types on arg_scope)
    bind_func_generics(func) !>

    // Instance methods / getters: implicit `this` first
    let owner = func.class
    if isset(owner) && !func.is_static {
        let this_type = owner.get_type() !>
        append_func_arg(func, "this", this_type)
    }

    // Arguments from EXP.body `(...)` — getters have none
    if !func.is_getter {
        let args_body = func.args_exp
        if isset(args_body) {
            parse_func_args_body(func, args_body) !>
        }
    }

    // The application's `main` receives the command-line arguments.  This is
    // an implicit part of the language entry-point contract: `fn main() {}`
    // is equivalent to `fn main(args: Array[String]) {}`.  Keep the check and
    // insertion here, after ordinary arguments have been parsed, so the
    // generated template can always call `main(args)` while still reporting
    // malformed user signatures at the declaration site.
    if func.name == "main" && !isset(func.class) && func.ns.pkg == func.ns.build.main_pkg {
        if func.args.length > 1 {
            func.exp.error("The 'main' function has too many arguments (max: 1)")
        }
        func.ns.build.main_func = func

        let array_idf = valk_idf(func.ns.build, "core", "Array") !>
        if array_idf.type != IDF.class {
            func.exp.bug("Identifier in valk:core is not a class: Array")
        }
        let array_class = array_idf.class
        if !isset(array_class) : func.exp.bug("Array class idf is missing its class")
        let cli_type = array_class.specialize(Array[Type]{ type_string(func.ns.build) }, func.exp) !>
        let cli_array = cli_type.get_type() !>

        let existing = func.args.get(0) !? null
        if isset(existing) {
            if !cli_array.compat(existing.type) {
                func.exp.error("The first argument of 'main' must be of type: " + cli_array.compat_display_name() + ", instead of: " + existing.type.compat_display_name())
            }
        } else {
            append_func_arg(func, "cli_args", cli_array)
        }
    }

    if func.is_test {
        append_func_arg(func, "test_results", type_from_core(func.ns.build, "TestResults") !>)
    }

    // Return type (optional; void when omitted)
    let rett_exp = func.rett_exp
    if isset(rett_exp) {
        func.rett = type_from_exp(rett_exp, func.arg_scope) !>
    } else {
        func.rett = type_void(func.ns.build)
    }

    // Error type after `!ErrorName`
    resolve_func_error_type(func) !>

    // Flags: $exit, $throw, $global, $offset, …
    apply_func_flags(func) !>

    // Bind each arg (including `this`) as IDF.decl on arg_scope for body lookup
    bind_func_arg_decls(func) !>
}

// Look up EXP.id error type and store on Func.
fn resolve_func_error_type(func: Func) !Error {
    let err_exp = func.error
    if !isset(err_exp) : return

    let idf = resolve_idf_from_id(err_exp, func.arg_scope) !>
    if idf.type != IDF.error_type {
        err_exp.error("Identifier must be an error type")
    }
    let etype = idf.error_type
    if !isset(etype) : err_exp.bug("Error-type idf is missing error_type")
    func.error_type = etype
    func.can_error = true
}

// Apply signature flags collected on EXP.func.list / Func.flags.
fn apply_func_flags(func: Func) !Error {
    let flags = func.flags
    if !isset(flags) : return

    let owner = func.class
    let b = func.ns.build
    let at = func.exp

    each flags as flag {
        if flag == "$entrance" {
            func.is_entrance = true
        } else if flag == "$exit" {
            func.must_exit = true
        } else if flag == "@willexit" {
            func.will_exit = true
        } else if flag == "$throw" {
            func.must_throw = true
        } else if flag == "$hot" {
            func.is_hot = true
        } else if flag == "$inline" {
            func.is_inline = true
        } else if flag == "$global" {
            if isset(owner) {
                at.error("'$global' is only valid on free functions, not methods")
            }
            func.is_global = true
            // Visible everywhere (like $global classes)
            b.scope.set_idf(func.name, Idf.for_func(func))
        } else if flag == "$undefined" {
            func.info_calls_unknown_code = true
        } else if flag == "$offset" {
            if !isset(owner) : at.error("'$offset' is only valid on class methods")
            if isset(owner.offset) {
                at.error("Multiple functions marked with $offset for the same type")
            }
            owner.offset = func
        } else if flag == "$offset_assign" {
            if !isset(owner) : at.error("'$offset_assign' is only valid on class methods")
            if isset(owner.offset_assign) {
                at.error("Multiple functions marked with $offset_assign for the same type")
            }
            owner.offset_assign = func
        } else if flag == "$append" {
            if !isset(owner) : at.error("'$append' is only valid on class methods")
            if isset(owner.append_hook) {
                at.error("Multiple functions marked with $append for the same type")
            }
            owner.append_hook = func
        } else if flag == "$set_key" {
            if !isset(owner) : at.error("'$set_key' is only valid on class methods")
            if isset(owner.set_key_hook) {
                at.error("Multiple functions marked with $set_key for the same type")
            }
            owner.set_key_hook = func
        } else if flag == "$to" || flag == "$auto" {
            if flag == "$auto" : func.auto_to = true
            validate_hook_func(func, "$to", 0) !>
            if isset(owner) : owner.to_hooks.append(func)
            else : b.lists.to_hooks.append(func)
        } else if flag == "$eq" {
            if !isset(owner) : at.error("'$eq' is only valid on class methods")
            validate_hook_func(func, "$eq", 1) !>
            owner.eq_hooks.append(func)
        } else if flag == "$lt" {
            if !isset(owner) : at.error("'$lt' is only valid on class methods")
            validate_hook_func(func, "$lt", 1) !>
            owner.lt_hooks.append(func)
        } else if flag == "$gt" {
            if !isset(owner) : at.error("'$gt' is only valid on class methods")
            validate_hook_func(func, "$gt", 1) !>
            owner.gt_hooks.append(func)
        } else if flag == "$lte" {
            if !isset(owner) : at.error("'$lte' is only valid on class methods")
            validate_hook_func(func, "$lte", 1) !>
            owner.lte_hooks.append(func)
        } else if flag == "$gte" {
            if !isset(owner) : at.error("'$gte' is only valid on class methods")
            validate_hook_func(func, "$gte", 1) !>
            owner.gte_hooks.append(func)
        } else if flag == "$add" {
            if !isset(owner) : at.error("'$add' is only valid on class methods")
            validate_hook_func(func, "$add", 1) !>
            owner.add_hooks.append(func)
        } else if flag == "@nobuffers" {
            func.no_buffers = true
        } else {
            at.error("Unknown function flag: " + flag)
        }
    }
}

// Hook functions: instance methods with a fixed extra-arg count and a single return value.
// `argc` is the number of explicit args (excluding implicit `this`).
fn validate_hook_func(func: Func, flag_name: String, argc: uint) !Error {
    let at = func.exp
    if func.is_static : at.error("Functions marked with " + flag_name + " cannot be static")
    // args include implicit `this`
    if func.args.length != (argc + 1) {
        at.error("Functions marked with " + flag_name + " must have " + argc + " argument(s)")
    }
    let rett = func.get_rett()
    if rett.is_void_type() {
        at.error("Functions marked with " + flag_name + " must return a value")
    }
    if rett.type == TYPE.multi {
        let subs = rett.sub_types
        if isset(subs) && subs.length > 1 {
            at.error("Functions marked with " + flag_name + " must return only 1 value")
        }
    }
    if argc == 1 && func.can_error {
        at.error("Functions marked with " + flag_name + " should never throw an error")
    }
}

// Create Decl for each arg and bind name → IDF.decl on arg_scope.
fn bind_func_arg_decls(func: Func) !Error {
    each func.args as arg {
        let decl = arg.decl
        let name = arg.name
        if func.arg_scope.has_local(name) {
            // `this` / args should not collide with generic type names (different IDF kinds),
            // but duplicate arg names are already rejected while parsing.
            func.exp.error("Duplicate argument name: " + name)
        }
        // An argument has no span of its own by the time it is bound, and the
        // signature is where a reader wants to land anyway.
        if !isset(decl.exp) : decl.exp = func.exp
        func.arg_scope.set_idf(name, Idf.for_decl(decl))
        func.all_decls.append(decl, true)
    }
}

// Append a typed argument (creates Decl). Does not bind into scope yet.
fn append_func_arg(func: Func, name: String, type: Type, default: ?Exp (null), is_generic: bool (false), generic_name: String ("")) Arg {
    let decl = Decl.new(type, true, name)
    let arg = Arg {
        name: name
        type: type
        decl: decl
        default: default
        is_generic: is_generic
        generic_name: generic_name
    }
    func.args.append(arg)
    return arg
}

// Parse `fn name[T, U]` generic names.
// - Base: bind each name as TYPE.any placeholder on arg_scope
// - Specialization: concrete types are already on arg_scope / generic_type_map
fn bind_func_generics(func: Func) !Error {
    let body = func.generics
    if !isset(body) : return

    // Names may already be set when created as a specialization
    let names = func.generic_names
    if !isset(names) {
        names = parse_class_generic_names(body) !>
        func.generic_names = names
    }

    // Specialization: types already bound by get_func_generic
    if isset(func.generic_from) || func.generic_args_defined : return

    // Generic base: only placeholders
    if func.is_generic_base {
        let b = func.ns.build
        each names as gname {
            let t = Type {
                type: TYPE.any
                build: b
                custom_name: gname
            }
            func.arg_scope.set_idf(gname, Idf.for_type(t))
        }
        return
    }

    // Non-base with generics body but no specialization data — treat like base placeholders
    // (should not happen for normal paths)
    let b = func.ns.build
    each names as gname {
        let t = Type {
            type: TYPE.any
            build: b
            custom_name: gname
        }
        func.arg_scope.set_idf(gname, Idf.for_type(t))
    }
}

// Parse contents of the arguments body: name: Type [(default)], ... [@infinite]
fn parse_func_args_body(func: Func, body: Exp) !Error {
    let pos = body.pos
    if !isset(pos) : body.bug("Function args body is missing a Pos")
    let p = pos.copy().init_parser()
    let scope = func.arg_scope

    while true {
        let t = p.tok(true, true) !>
        if t == TOK.sign && p.word_is(")") : break
        if t == TOK.end : body.error("Unexpected end of file in function arguments")

        // @infinite — must be last before `)`
        if t == TOK.at_word && p.word_is("@infinite") {
            func.infinite_args = true
            p.expect(")", true, true) !>
            break
        }

        if t != TOK.word {
            p.error("Invalid argument name: '" + p.word() + "'")
        }
        let name = p.word()
        // Avoid colliding with already-bound names (generic type params, earlier args)
        if scope.has_local(name) {
            p.error("Duplicate argument name: " + name)
        }
        // Also reject duplicate among args not yet bound (this already bound via has_local
        // once decls are set — during parse only check prior args)
        each func.args as existing {
            if existing.name == name : p.error("Duplicate argument name: " + name)
        }

        p.expect(":", true, true) !>

        // Type: normal type, or `$G` for generic arg type (call-site inference)
        let is_generic = false
        let generic_name = ""
        let arg_type = type_any(func.ns.build)
        t = p.tok(true, true, false) !>
        if t == TOK.flag {
            p.tok(true, true) !>
            let full_name = p.word()
            let gname = full_name.ltrim("$")
            if gname.length == 0 : p.error("Empty generic argument name")

            if func.generic_args_defined {
                // Specialization: look up concrete type for this $G name
                let gmap = func.generic_type_map
                if !isset(gmap) : p.error("(Compiler bug) Missing generic_type_map for specialized generic-arg func")
                let gt = gmap.get(gname) ! p.error("(Compiler bug) Missing argument generic type: " + gname)
                arg_type = gt
            } else {
                // Base: placeholder + track name for later specialization
                let gnames = func.generic_names
                if func.generic_arg_names.contains(gname) {
                    p.error("Duplicate generic name: " + gname)
                }
                if isset(gnames) {
                    each gnames as existing {
                        if existing == gname : p.error("Duplicate generic name: " + gname)
                    }
                }
                func.generic_arg_names.append(gname)
                is_generic = true
                generic_name = gname
                arg_type = Type {
                    type: TYPE.any
                    build: func.ns.build
                    custom_name: full_name
                }
                func.has_generic_args = true
                func.skip_ast = true
            }
        } else {
            let type_exp = read_type_exp(p, true, true) !>
            arg_type = type_from_exp(type_exp, scope) !>
        }

        // Optional default: ( ... )
        let default: ?Exp = null
        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is("(") {
            p.tok(true, true) !>
            default = read_body_exp(p, "(", ")") !>
        }

        // Skip void-typed args (old compiler does the same)
        if arg_type.type != TYPE.void {
            append_func_arg(func, name, arg_type, default, is_generic, generic_name)
        }

        t = p.tok(true, true) !>
        if t == TOK.sign && p.word_is(",") : continue
        if t == TOK.sign && p.word_is(")") : break
        p.error("Expected ',' or ')' in function arguments, found: '" + p.word() + "'")
    }
}

// Create (or reuse) a specialized Func for a generic base.
// `types` is the full list: first the [T, U] types, then any `$G` inferred types.
// `generic_arg_names` is non-null when `$G` names are included at the end of `types`.
fn get_func_generic(base: Func, types: Array[Type], generic_arg_names: ?Array[String]) Func !Error {
    if !base.is_generic_base && !base.has_generic_args {
        base.exp.bug("get_func_generic on non-generic function: " + base.name)
    }

    let cache = base.generic_cache
    if !isset(cache) {
        let m = Map[Func]{}
        base.generic_cache = m
        cache = m
    }

    let key = generic_types_key(types)
    let existing = cache.get(key) !? null
    if isset(existing) : return existing

    // Parent of specialized arg_scope: same as the base's parent
    let parent = base.arg_scope.parent
    let gscope = Scope.new(parent)

    let gfunc = Func {
        unit: base.unit
        ns: base.ns
        name: base.name + "__" + key
        act: base.act
        exp: base.exp
        arg_scope: gscope
        generics: base.generics
        args_exp: base.args_exp
        rett_exp: base.rett_exp
        error: base.error
        body: base.body
        flags: base.flags
        is_generic_base: false
        generic_names: base.generic_names
        generic_types: types
        generic_from: base
        generic_args_defined: isset(generic_arg_names)
        has_generic_args: false // specialized — concrete types
        skip_ast: false
        is_extern: base.is_extern
        is_entrance: base.is_entrance
        must_exit: base.must_exit
        will_exit: base.will_exit
        must_throw: base.must_throw
        is_hot: base.is_hot
        is_inline: base.is_inline
        is_global: base.is_global
        info_calls_unknown_code: base.info_calls_unknown_code
        auto_to: base.auto_to
        no_buffers: base.no_buffers
        is_test: base.is_test
        test_name: base.test_name
        class: base.class
        group: base.group
        is_static: base.is_static
        is_getter: base.is_getter
    }

    // Bind type params: [T, U] names then `$G` names
    let gmap = Map[Type]{}
    gfunc.generic_type_map = gmap
    let k: uint = 0
    let names = base.generic_names
    if isset(names) {
        each names as gname {
            let type = types.get(k) ! base.exp.bug("Missing generic type argument for: " + gname)
            gmap.set(gname, type)
            gscope.set_idf(gname, Idf.for_type(type))
            k++
        }
    }
    if isset(generic_arg_names) {
        each generic_arg_names as gname {
            let type = types.get(k) ! base.exp.bug("Missing generic-arg type for: " + gname)
            gmap.set(gname, type)
            gscope.set_idf(gname, Idf.for_type(type))
            k++
        }
        gfunc.generic_arg_names = generic_arg_names
    }

    // SELF for methods (class scope may already have it; rebind for clarity)
    let owner = gfunc.class
    if isset(owner) && !owner.is_generic_base {
        gscope.set_idf("SELF", Idf.for_class(owner))
    }

    cache.set(key, gfunc)

    // Parse full signature with concrete bindings
    parse_func_types(gfunc) !>

    // Track on unit + AST pipeline (like a normal function)
    gfunc.unit.functions.append(gfunc)
    if !gfunc.skip_ast {
        gfunc.ns.build.pipeline.parse_func_asts.append(gfunc)
    }

    return gfunc
}

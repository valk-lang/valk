use helper
use valk:fs

value EFFECT_SUMMARY_VERSION ("1")

fn func_effect_signature(func: Func) String {
    let out = func.is_getter ? "get:" : "fn:"
    out += func.infinite_args ? "variadic:" : "fixed:"
    out += func.ns.pkg.name + ":" + func.ns.name + ":"
    let owner = func.class
    if isset(owner) : out += type_identity_key(owner.get_type() !? type_void(func.ns.build))
    out += ":" + func.name + "("
    each func.args as arg, i {
        if i > 0 : out += ","
        out += type_identity_key(arg.type)
    }
    out += ")->" + type_identity_key(func.get_rett())
    let error_type = func.error_type
    if isset(error_type) {
        out += "!" + error_type.ns.pkg.name + ":" + error_type.ns.name + ":" + error_type.name
    }
    return out
}

fn func_effect_signature_hash(func: Func) String {
    return helper:ctxhash(func_effect_signature(func))
}

fn func_effect_key(func: Func) String {
    return helper:ctxhash("func|" + func_effect_signature(func))
}

fn func_effect_body_hash(func: Func) String {
    let body = func.body ?! return ""
    if body.len == 0 : return ""
    return helper:ctxhash(body.src.content.part(body.i, body.len))
}

fn func_record_effect_dependency(caller: ?Func, callee: Func) {
    if !isset(caller) || !caller.computing_unique_summary : return
    caller.effect_dependencies.append(callee, true)
}

fn func_effect_bits(func: Func, invalidates: bool) String {
    let bits = ""
    each func.args as arg {
        bits += (invalidates ? arg.invalidates_unique : arg.may_escape) ? "1" : "0"
    }
    return bits
}

fn func_effect_return_args(func: Func) String {
    let out = ""
    each func.unique_return_args as index, i {
        if i > 0 : out += ","
        out += index
    }
    return out
}

fn func_effect_dependency_hash(func: Func) String {
    return helper:ctxhash(func_effect_dependency_entries(func))
}

fn func_effect_dependency_entries(func: Func) String {
    let material = ""
    each func.effect_dependencies as dependency {
        material += func_effect_key(dependency) + ":"
        if dependency == func : material += "self"
        else if dependency.effect_summary_hash.length > 0 : material += dependency.effect_summary_hash
        else : material += "unknown"
        material += ","
    }
    return material
}

fn func_effect_summary_material(func: Func, dependency_hash: String) String {
    return func_effect_signature_hash(func)
        + "|" + func.effect_body_hash
        + "|" + dependency_hash
        + "|" + func_effect_bits(func, false)
        + "|" + func_effect_bits(func, true)
        + "|" + (func.returns_unique_graph ? "1" : "0")
        + "|" + func_effect_return_args(func)
}

fn func_effect_finalize_hash(func: Func) {
    let dependency_hash = func_effect_dependency_hash(func)
    func.effect_summary_hash = helper:ctxhash(func_effect_summary_material(func, dependency_hash))
}

fn func_effect_artifact_row(func: Func) String {
    let dependency_entries = func_effect_dependency_entries(func)
    let dependency_hash = func_effect_dependency_hash(func)
    return func_effect_key(func)
        + "|" + func_effect_signature_hash(func)
        + "|" + func.effect_body_hash
        + "|" + dependency_entries
        + "|" + dependency_hash
        + "|" + func_effect_bits(func, false)
        + "|" + func_effect_bits(func, true)
        + "|" + (func.returns_unique_graph ? "1" : "0")
        + "|" + func_effect_return_args(func)
        + "|" + func.effect_summary_hash
}

fn effect_artifact_header() String {
    return "VALK_EFFECTS|" + EFFECT_SUMMARY_VERSION + "|" + VERSION
}

fn load_effect_cache_artifact(build: Build) !Error {
    if build.cache.effect_artifact_loaded : return
    build.cache.effect_artifact_loaded = true
    let path = helper:add(object_output_dir(build) !>, "effects.meta")
    if !fs:exists(path) : return
    let content = fs:read(path) ! return
    let lines = content.split("\n")
    let header = lines.get(0) !? ""
    if header != effect_artifact_header() : return
    each lines as line, i {
        if i == 0 || line.length == 0 : continue
        let parts = line.split("|")
        if parts.length != 10 : continue
        let key = parts.get(0) !? ""
        if key.length > 0 : build.cache.effect_rows.set(key, line)
    }
}

fn effect_apply_bits(func: Func, escapes: String, invalidates: String) bool {
    if escapes.bytes != func.args.length || invalidates.bytes != func.args.length : return false
    each func.args as arg, i {
        let escape = @ptrv(escapes.data, u8, i)
        let invalidate = @ptrv(invalidates.data, u8, i)
        if (escape != '0' && escape != '1') || (invalidate != '0' && invalidate != '1') : return false
        arg.may_escape = escape == '1'
        arg.invalidates_unique = invalidate == '1'
    }
    return true
}

fn find_effect_dependency(build: Build, key: String) ?Func !Error {
    each build.lists.units as unit {
        each unit.functions as func {
            if !func.parsed_types : parse_func_types(func) !>
            if func_effect_key(func) == key : return func
        }
    }
    return null
}

fn validate_effect_dependencies(func: Func, entries: String, expected_hash: String) bool !Error {
    if helper:ctxhash(entries) != expected_hash : return false
    if entries.length == 0 : return true
    each entries.rtrim(",").split(",") as entry {
        let pair = entry.split(":")
        if pair.length != 2 : return false
        let key = pair.get(0) !? ""
        let hash = pair.get(1) !? ""
        if key.length == 0 || hash.length == 0 || hash == "unknown" : return false
        if hash == "self" {
            if key != func_effect_key(func) : return false
            continue
        }
        let dependency = find_effect_dependency(func.ns.build, key) !>
        if !isset(dependency) : return false
        ensure_func_unique_summary(dependency) !>
        if !dependency.effect_summary_analyzed || dependency.effect_summary_hash != hash : return false
        func.effect_dependencies.append(dependency, true)
    }
    return true
}

fn func_effect_end_load(func: Func) {
    func.computing_unique_summary = false
}

fn func_try_load_effect_summary(func: Func) bool !Error {
    load_effect_cache_artifact(func.ns.build) !>
    let row = func.ns.build.cache.effect_rows.get(func_effect_key(func)) !? null
    if !isset(row) : return false
    let parts = row.split("|")
    if parts.length != 10 : return false
    let signature = parts.get(1) !? ""
    let body_hash = parts.get(2) !? ""
    let dependency_entries = parts.get(3) !? ""
    let dependency_hash = parts.get(4) !? ""
    let escapes = parts.get(5) !? ""
    let invalidates = parts.get(6) !? ""
    let returns_unique = parts.get(7) !? ""
    let return_args = parts.get(8) !? ""
    let summary_hash = parts.get(9) !? ""
    if signature != func_effect_signature_hash(func) : return false
    if returns_unique != "0" && returns_unique != "1" : return false

    func.computing_unique_summary = true
    defer func_effect_end_load(func)
    func.effect_dependencies.clear()
    if !(validate_effect_dependencies(func, dependency_entries, dependency_hash) !>) : return false
    func.effect_body_hash = body_hash
    if !(effect_apply_bits(func, escapes, invalidates)) : return false
    func.returns_unique_graph = returns_unique == "1"
    func.unique_return_args.clear()
    if return_args.length > 0 {
        each return_args.split(",") as item {
            let index = item.to_uint() ! return false
            if index >= func.args.length : return false
            func.unique_return_args.append(index, true)
        }
    }
    let expected = helper:ctxhash(func_effect_summary_material(func, dependency_hash))
    if expected != summary_hash : return false
    func.effect_summary_hash = summary_hash
    func.effect_summary_analyzed = true
    func.effect_loaded_from_artifact = true
    func.unique_summary_ready = true
    return true
}

fn write_effect_cache_artifacts(build: Build) !Error {
    let dir = object_output_dir(build) !>
    let content = effect_artifact_header() + "\n"
    each build.lists.units as unit {
        each unit.functions as func {
            if !func.unique_summary_ready || !func.effect_summary_analyzed : continue
            content += func_effect_artifact_row(func) + "\n"
        }
    }
    let path = helper:add(dir, "effects.meta")
    if helper:file_has_same_content(path, content) : return
    fs:write(path, content) ! build.error("Failed to write effect summary artifact")
}

fn write_effect_library_artifact(build: Build) !Error {
    let output = build.options.path_out ?! return
    let content = effect_artifact_header() + "\n"
    each build.lists.units as unit {
        each unit.functions as func {
            if !func.is_export || !func.unique_summary_ready || !func.effect_summary_analyzed : continue
            content += func_effect_artifact_row(func) + "\n"
        }
    }
    fs:write(output + ".effects", content) ! build.error("Failed to write library effect summary artifact")
}

use helper
use valk:fs

// Compiler-facing value produced from an EXP.value expression tree.
// Mirrors the old Value idea, but is filled from the structured Exp AST
// (value_from_exp) rather than while tokenizing.

// Everything in a function body is a Value — including control flow.
// if / while / let / return / assign / block have rett = void (side-effecting).
enum VAL : u8 {
    undefined
    int
    float
    bool
    string
    null
    func     // resolved function reference; value1 = optional bound receiver
    // Raw concrete method entry stored in an interface adapter. Unlike a
    // function value, materializing this pointer does not execute unknown code.
    interface_method
    member   // resolved receiver + builtin/meta member name
    decl     // local / argument variable (Decl)
    prop     // object property access; value1 = receiver; prop = Prop
    global   // global / shared variable (Global)
    property_meta // compile-time Prop value bound by #loop properties
    type     // compile-time type value (of_type); rett is String; props like .$is_inline
    op       // binary op (VALUE_OP in .op); left/right in value1/value2
    unary    // unary op (VALUE_OP in .op); operand in value1
    call     // callee in value1; args in values
    cast     // value.@cast(Type); value1 = on, rett = target Type
    paren    // grouping; value1 = inner (usually folded away)
    multi    // argument list only (values array); not a runtime value alone
    // Class / struct construction: Type { prop: value, ... }
    // value1 = type side; values = field inits (each Value.name = prop name)
    class_init
    // Fixed-array construction: { v0, v1, ... } — values = elements; rett = array type
    array_init
    // Match expression/statement: value1 = matched value; values = case blocks.
    // Each case block has value1 = condition (null for default), value2 = result value.
    match
    // Error code value: `.code` / `TypeName.code` / `E.code` / `E.name` (no payload), or
    // `throw .code { field: value, ... }` (payload). string_val = code name ("" for the
    // dynamic `E.code`); values = payload field inits when present (each Value.name = field
    // name); rett = TYPE.error_code Type identifying the ErrorType.
    error_value
    // Element access / @ptrv: value1 = base, value2 = index; rett = element type
    ptrv
    // Raw pointer byte offset: value1 = pointer, value2 = signed byte offset
    ptr_offset
    // @ref(lvalue): value1 = address-of target; rett = ptr
    ptr_of
    // Load/copy an inline value through ptr/ref; value1 = pointer, rett = inline type
    load
    // cond ? a : b  /  a ?? b  — value1=cond (or isset), value2=then, values=[else]
    this_or_that
    // isset(v) — value1=operand; rett=bool; may set .issets
    isset
    // Type-only wrap (nullable strip/add); value1=inner
    wrap
    // Tagged-union operations. union_wrap stores value1 under tag int_val;
    // union_is tests it; union_extract reads the known active alternative.
    union_wrap
    union_is
    union_extract
    // GC-aware operations on by-value storage with embedded managed fields.
    property_get
    property_init
    property_update
    property_clear
    property_trace
    // Concrete class widened to an interface adapter box. value1 is the object,
    // values are object + raw method entry points, class_ref is the adapter layout.
    interface_wrap
    // Atomic read/modify/write primitives. atomic_op stores VALUE_OP in `.op`.
    atomic_op
    atomic_store
    atomic_load
    // Raw memory copy: values = [source ptr, destination ptr, byte length].
    memcpy
    // Fallible call with handler applied — value1=success value, value2=handler side-effect tree
    // (IR lowers to error-check + branch). op = ERRH_KIND.
    error_handler
    // `co <call>` — value1 = the launched call; rett = TYPE.co wrapping its return/error
    co
    // `await <task>` — value1 = the task value; rett = the unwrapped return type;
    // can_error/error_type carried from the task's TYPE.co, same as a fallible call
    await
    // ---- Function-body / control-flow values (typically rett = void) ----
    assign   // lvalue op= rvalue; op = ASSIGN_OP
    if       // value1=cond; values=then body; value2=else block (optional VAL.block)
    while    // value1=cond; values=body
    block    // sequential values (nested `{ ... }` or then/else body)
    return   // value1=optional return value
    throw    // value1=thrown value
    break
    continue
    // $entrance-only marker: emit the function's collected stack allocations here.
    allocas
    // Emit initialization for every GC allocator generated by the program.
    // Kept as a marker because allocator discovery/codegen happens after front-end parsing.
    init_allocators
    // Generated function setup/defer values, finalized after body parsing.
    decl_offset
    gc_stack_init
    gc_stack_defer
    // Execute the function's runtime stack of deferred closures in LIFO order.
    run_defers
    stable_stack_init
    ir_comment
    // Value scope `<{...}`: values = body statements; value1 = phi of return values
    vscope
    // Phi of multiple control-flow values (vscope returns, …); values = arms
    phi
}

class Value {
    type: VAL
    // Result type of this value — never null; use void when there is no value
    // (control-flow, incomplete/unresolved expressions, statement forms).
    rett: Type
    // Source expression (for errors / spans)
    exp: ?Exp (null)
    // Children
    value1: ?Value (null)
    value2: ?Value (null)
    values: ?Array[Value] (null)
    // Operators: VALUE_OP for op/unary; ASSIGN_OP for VAL.assign; ERRH_KIND for error_handler
    op: u8 (0)
    // Literal payloads
    int_val: int (0)
    float_val: f64 (0)
    bool_val: bool (false)
    string_val: String ("")
    // Identifier
    name: String ("")
    // VAL.decl — single decl reference
    decl: ?Decl (null)
    // VAL.prop — object field (`on.prop`); receiver is value1
    prop: ?Prop (null)
    // VAL.global — global / shared storage
    global: ?Global (null)
    allocator: ?Allocator (null)
    // VAL.func — resolved function declaration
    func: ?Func (null)
    // VAL.member — selected class group awaiting the next dotted method name
    group: ?Group (null)
    // VAL.type — unspecialized generic class base before `[T, ...]`
    class_ref: ?Class (null)
    // VAL.type: the actual Type this compile-time value represents
    of_type: ?Type (null)
    // Flow-sensitive nullability (from isset / && / !)
    issets: ?Array[Decl] (null)
    not_issets: ?Array[Decl] (null)
    // Fallible call metadata (before error handler trims it)
    can_error: bool (false)
    error_type: ?ErrorType (null)
    // Side-effect / pre-value chain (old this_but_that / error-check scaffolding)
    pre_value: ?Value (null)

    // Report an error at this value's source span when available.
    fn error(msg: String) !Error $throw {
        let e = this.exp
        if isset(e) : e.error(msg)
        // Fallback without span
        throw .error
    }

    fn bug(msg: String) !Error $throw {
        this.error("(Compiler bug) " + msg)
    }

    // True when this value can appear on the left of `=` / `+=` / …
    // Locals, object properties, globals, and fixed-array / pointer index (ptrv).
    fn assignable() bool {
        let t = this.type
        return t == VAL.decl || t == VAL.prop || t == VAL.global || t == VAL.ptrv
    }

    // True when this value must be spilled into a GC-stack-rooted decl before
    // being used as a call argument. Without this, evaluating a sibling
    // argument that can trigger an allocation may collect an already-computed
    // GC-tracked argument that only lives in an SSA register.
    fn needs_buffer() bool {
        if this.type == VAL.null : return false
        if this.type == VAL.decl : return false
        if this.type == VAL.string : return false
        return this.rett.has_gc_refs()
    }

    // Multi-return / multi-value unpack: VAL.multi → values array; vscope/phi via value1.
    fn unroll() Array[Value] {
        if this.type == VAL.multi {
            let vals = this.values
            if isset(vals) : return vals
        }
        // Keep the value scope itself as the runtime producer. Its VAL.phi is
        // merge metadata; IR builds the actual phi while emitting the body.
        if this.type == VAL.vscope {
            if this.rett.type == TYPE.multi {
                let subs = this.rett.sub_types
                if isset(subs) {
                    let out = Array[Value]{}
                    each subs as st, i {
                        out.append(Value {
                            type: VAL.multi
                            name: "part"
                            int_val: i.@cast(int)
                            value1: this
                            rett: st
                            exp: this.exp
                        })
                    }
                    return out
                }
            }
            return Array[Value]{ this }
        }
        if this.type == VAL.phi {
            // Phi of multi values still multi; single-value phi is one arm
            let vals = this.values
            if isset(vals) && vals.length > 0 {
                let first = vals.get(0) !? null
                if isset(first) && first.type == VAL.multi : return first.unroll()
                // Multi rett without stored multi value: one extract per subtype
                if this.rett.type == TYPE.multi {
                    let subs = this.rett.sub_types
                    if isset(subs) {
                        let out = Array[Value]{}
                        each subs as st, i {
                            // Placeholder extracts for let-unpack; IR fills later
                            out.append(Value {
                                type: VAL.multi
                                name: "phi_part"
                                int_val: i.@cast(int)
                                value1: this
                                rett: st
                                exp: this.exp
                            })
                        }
                        return out
                    }
                }
            }
        }
        // Multi-typed value without VAL.multi (e.g. call returning (T,U))
        if this.rett.type == TYPE.multi {
            let subs = this.rett.sub_types
            if isset(subs) {
                let out = Array[Value]{}
                each subs as st, i {
                    out.append(Value {
                        type: VAL.multi
                        name: "part"
                        int_val: i.@cast(int)
                        value1: this
                        rett: st
                        exp: this.exp
                    })
                }
                return out
            }
        }
        return Array[Value]{ this }
    }

    // Success value of a fallible call (errors trimmed conceptually).
    fn trim_errors() Value {
        if !this.can_error : return this
        return Value {
            type: this.type
            rett: this.rett
            exp: this.exp
            value1: this.value1
            value2: this.value2
            values: this.values
            op: this.op
            int_val: this.int_val
            float_val: this.float_val
            bool_val: this.bool_val
            string_val: this.string_val
            name: this.name
            decl: this.decl
            func: this.func
            of_type: this.of_type
            can_error: false
            error_type: null
            pre_value: this
        }
    }

    // Class / type id on the left of `Type { fields }` init.
    fn as_class_for_init() ?Class {
        if this.type != VAL.type : return null
        let t = this.of_type
        if isset(t) {
            let c = t.class
            if isset(c) : return c
            // A nullable type names the same class, and initializing one
            // produces a value the nullable accepts. This reaches here through
            // a generic parameter bound to `?X`, where `$is_structural` already
            // reports the underlying class (see clone_value in valk:core).
            return t.get_non_nullable().class
        }
        return this.class_ref
    }

    // Extract Type from a compile-time VAL.type value.
    fn as_type() ?Type {
        if this.type == VAL.type : return this.of_type
        return null
    }

    // Extract a name from a compile-time string value.
    fn as_name() ?String {
        if this.type == VAL.string : return this.string_val
        return null
    }

    // Constant string form for folding == / != (null if not foldable as string).
    fn fold_string() ?String {
        if this.type == VAL.string : return this.string_val
        if this.type == VAL.bool : return this.bool_val ? "1" : "0"
        if this.type == VAL.int {
            let buf = ByteBuffer.new()
            buf.write_int_ascii(this.int_val)
            return buf.to_string()
        }
        return null
    }

    // Resolve the Func being called from this callee Value, if known.
    fn resolve_call_func() ?Func {
        if this.type != VAL.func : return null
        return this.func
    }
}

// Convert a structured EXP.value into a Value.
// `scope` for name lookup; `ctx` for the function and suggested type.
// Sub-expressions that do not inherit the outer expectation use `ctx.without_suggested_type()`.
fn value_from_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    if exp.type != EXP.value : exp.bug("Expected EXP.value")
    let kind = exp.kind
    let b = ctx.build

    if kind == VALUE_KIND.paren {
        let inner = exp.get(VALUE_EXP.left)
        if !isset(inner) : exp.bug("Missing paren inner value")
        // Parentheses preserve the suggested type
        return value_from_exp(inner, scope, ctx) !>
    }

    if kind == VALUE_KIND.number || kind == VALUE_KIND.hex || kind == VALUE_KIND.octal {
        let v = value_from_int_literal(exp, b) !>
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.float {
        let v = value_from_float_literal(exp, b) !>
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.bool {
        let v = vgen_bool(exp.bool1, type_bool(b))
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.null {
        // Type from `null[Type]`, else suggested type (assign/return/arg/prop/let, …).
        // Same as old build: never invent `any`.
        let nt: ?Type = null
        let type_exp = exp.get(VALUE_EXP.left)
        if isset(type_exp) {
            nt = type_from_exp(type_exp, scope) !>
        } else {
            nt = ctx.suggested_type
        }
        if !isset(nt) {
            exp.error("Missing type hint. This is required to generate a 'null' value. You can also use 'null[Type]' to suggest a type (e.g. null[?String])")
        }
        let null_t = nt.is_nullable_type() ? nt : nt.nullable()
        let v = vgen_null(null_t)
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.undefined {
        let v = vgen_undefined(b)
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.noop {
        // A no-op is a void expression statement. Lower it to an empty block so
        // IR emission has no instruction to generate while flow analysis keeps
        // the surrounding path open.
        return vgen_block(Array[Value]{}, b, exp)
    }
    if kind == VALUE_KIND.memcpy {
        return value_from_memcpy_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.string {
        return value_from_string_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.char {
        // Character literals are integer constants at Value level. EXP retains
        // VALUE_KIND.char and its quoted source token for formatting.
        let v = vgen_int(char_literal_byte(exp.str1), type_int(b))
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.id {
        let v = value_from_id_exp(exp, scope, ctx) !>
        v.exp = exp
        // LSP: hover reports what this identifier resolved to. Placed after
        // resolution so the answer is the compiler's own conclusion, and on the
        // way out so a nested expression under the cursor reports first.
        lsp_hover(exp, v) !>
        return v
    }

    // size_of(Type) → VAL.int with the type's byte size
    if kind == VALUE_KIND.size_of {
        let type_exp = exp.get(VALUE_EXP.left)
        if !isset(type_exp) : exp.bug("Missing size_of type operand")
        let t = type_from_exp(type_exp, scope) !>
        let bytes = t.size() !>
        let v = vgen_int(bytes.to(int), type_int(b))
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.unary {
        let operand_exp = exp.get(VALUE_EXP.left)
        if !isset(operand_exp) : exp.bug("Missing unary operand")
        let operand = value_from_exp(operand_exp, scope, ctx.without_suggested_type()) !>
        let op = exp.number.@cast(VALUE_OP)
        if op == VALUE_OP.ref_of {
            // Only local/global variables — not object properties (matches the classic
            // compiler: taking a stable address of a property isn't supported).
            let ref: ?Value = operand
            while isset(ref) && (ref.type == VAL.ptrv || ref.type == VAL.ptr_of) {
                ref = ref.value1
            }
            let is_var = isset(ref) && (ref.type == VAL.decl || ref.type == VAL.global)
            if !is_var {
                exp.error("The '&' operator can only be used on local/global variables")
            }
            act_check_assign(operand, exp) !>
            if isset(ref) && ref.type == VAL.decl {
                let decl = ref.decl
                if isset(decl) : decl.make_stable()
            }
            let v = vgen_ptr_of(operand, operand.rett.reference(), exp)
            return v
        }
        // Fold constants when possible
        if op == VALUE_OP.neg {
            if operand.type == VAL.int {
                operand.int_val = 0 - operand.int_val
                operand.exp = exp
                return operand
            }
            if operand.type == VAL.float {
                operand.float_val = 0.0 - operand.float_val
                operand.exp = exp
                return operand
            }
        }
        if op == VALUE_OP.not && operand.type == VAL.bool {
            let v = vgen_bool(!operand.bool_val, type_bool(b))
            v.exp = exp
            return v
        }
        if op == VALUE_OP.bit_not && operand.type == VAL.int {
            // Two's-complement bitwise not (host may not support `~` token)
            operand.int_val = (0 - 1) ^ operand.int_val
            operand.exp = exp
            return operand
        }
        if op == VALUE_OP.not {
            if !operand.rett.is_bool_type() {
                exp.error("Expected a value of type 'bool' after '!', the value type we found was: " + operand.rett.compat_display_name())
            }
            let v = vgen_unary(operand, op, type_bool(b))
            v.exp = exp
            // Flip issets when only one side is tracked (matches old !isset behavior)
            let is_list = operand.issets
            let not_list = operand.not_issets
            let is_count = (isset(is_list) ? is_list.length : 0) + (isset(not_list) ? not_list.length : 0)
            if is_count == 1 {
                v.issets = not_list
                v.not_issets = is_list
            }
            return v
        }
        let v = vgen_unary(operand, op, operand.rett)
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.op {
        return value_from_op_exp(exp, scope, ctx) !>
    }

    if kind == VALUE_KIND.call {
        return value_from_call_exp(exp, scope, ctx) !>
    }

    if kind == VALUE_KIND.ternary {
        return value_from_ternary_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.null_coalesce {
        return value_from_null_coalesce_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.null_exit {
        return value_from_null_exit_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.isset {
        return value_from_isset_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.error_handler {
        return value_from_error_handler_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.match {
        return value_from_match_exp(exp, scope, ctx) !>
    }

    if kind == VALUE_KIND.cast {
        let on_exp = exp.get(VALUE_EXP.left)
        let type_exp = exp.get(VALUE_EXP.right)
        if !isset(on_exp) : exp.bug("Missing cast value")
        if !isset(type_exp) : exp.bug("Missing cast type")
        let cast_t = type_from_exp(type_exp, scope, ctx.suggested_type) !>
        // Suggest cast target for the value (`null.@cast(Node)` needs a type for null)
        let on = value_from_exp(on_exp, scope, ctx.with_suggested_type(cast_t)) !>
        let v = vgen_cast(on, cast_t)
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.dot {
        let v = value_from_dot_exp(exp, scope, ctx) !>
        lsp_hover(exp, v) !>
        return v
    }

    if kind == VALUE_KIND.typeof {
        // typeof(value) → VAL.type of the value's result type (rett)
        let inner_exp = exp.get(VALUE_EXP.left)
        if !isset(inner_exp) : exp.bug("Missing typeof operand")
        let inner = value_from_exp(inner_exp, scope, ctx.without_suggested_type()) !>
        let v = value_as_rett_type(inner, exp, b) !>
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.multi {
        // Multi-value `(a, b, …)` or bare multi list (call args)
        let args = Array[Value]{}
        let i: uint = 0
        // Suggested multi type suggests each part (return / let / assign)
        let suggested_type = ctx.suggested_type
        let part_types: ?Array[Type] = null
        if isset(suggested_type) && suggested_type.type == TYPE.multi {
            part_types = suggested_type.sub_types
        }
        while true {
            let a = exp.get(i)
            if !isset(a) : break
            let part_ctx = ctx.without_suggested_type()
            let pt: ?Type = null
            if isset(part_types) {
                pt = part_types.get(i) !? null
                if isset(pt) : part_ctx = ctx.with_suggested_type(pt)
            }
            let av = value_from_exp(a, scope, part_ctx) !>
            // Convert each part toward suggested multi slot (e.g. int → String via $to)
            if isset(pt) && !av.rett.is_void_type() && !pt.is_void_type() {
                av = value_try_convert(av, scope, ctx, pt)
            }
            args.append(av)
            i++
        }
        let v = vgen_grouped_values(b, args)
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.incr || kind == VALUE_KIND.decr {
        let operand_exp = exp.get(VALUE_EXP.left)
        if !isset(operand_exp) : exp.bug("Missing ++/-- operand")
        let operand = value_from_exp(operand_exp, scope, ctx.without_suggested_type()) !>
        act_check_assign(operand, exp) !>
        value_mark_mutable(operand)
        // Result type matches operand (int-like); full assignability checks later
        let v = Value {
            type: VAL.op
            op: kind == VALUE_KIND.incr ? VALUE_OP.add : VALUE_OP.sub
            value1: operand
            rett: operand.rett
            exp: exp
            bool_val: exp.bool1 // prefix flag stashed for IR later
        }
        return v
    }

    if kind == VALUE_KIND.error_code {
        // Suggested-type shorthand: `.new(...)`, `.from(...)`, etc. The parser
        // uses the same leading-dot node as error codes; semantic context decides.
        let suggested_type = ctx.suggested_type
        if isset(suggested_type) {
            let class = suggested_type.get_non_nullable().get_class_or_null()
            if isset(class) {
                let func = class.get_func(exp.str1)
                if isset(func) && func.is_static {
                    let member = vgen_func(func)
                    member.exp = exp
                    return member
                }
            }
        }

        // Bare `.code` — implied ErrorType comes from the enclosing function's `!ErrorName`.
        let func = ctx.func
        if !isset(func) : exp.error("An error code ('." + exp.str1 + "') can only be used inside a function")
        let et = func.error_type
        if !isset(et) : exp.error("Throwing an error but your function has no error type")
        return value_from_error_code_item(et, exp.str1, exp) !>
    }

    if kind == VALUE_KIND.class_init {
        return value_from_class_init_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.offset {
        return value_from_offset_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.ptrv {
        return value_from_ptrv_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.ref_of {
        return value_from_ref_of_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.vscope {
        return value_from_vscope_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.func_lit {
        return value_from_func_lit_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.co {
        return value_from_co_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.await {
        return value_from_await_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.error_is {
        return value_from_error_is_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.embed {
        return value_from_embed_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.embed_dir {
        return value_from_embed_dir_exp(exp, scope, ctx) !>
    }
    exp.bug("Unknown value kind: " + kind)
}

// Package-root-relative base dir for `#embed`/`#embed_dir` (matches the classic
// compiler: paths resolve against the containing package's directory, not the
// individual file's directory or the process cwd).
fn embed_base_dir(ctx: Context) String !Error {
    let func = ctx.get_func() !>
    let dir = func.ns.pkg.dir
    return dir ?? fs:cwd()
}

// `#embed("path")` — read a file at compile time and embed its content as a String
// constant.
fn value_from_embed_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let b = ctx.build
    let base = embed_base_dir(ctx) !>
    let full = helper:resolve(exp.str1, base)
    if !fs:exists(full) {
        exp.error("Embed file not found: " + full)
    }
    let content = fs:read(full) ! exp.error("Failed to read embed file: " + full)
    b.watch_files.append(full, true)
    let v = vgen_string(content, type_string(b))
    v.exp = exp
    return v
}

// `#embed_dir("path")` — read every file under a directory at compile time and embed
// them as a HashMap[String, String] (relative path → content) constant.
//
// Builds `$set_key` hook-call Values directly (mirroring value_from_class_init_hooks),
// with each file's raw bytes going straight into vgen_string. Deliberately does NOT
// synthesize `"..."` source text and re-parse it: this compiler's string-literal
// resolution (strip_quotes in this file) never unescapes `\n` / `\"` / `\\` etc., so any
// embedded content containing a quote, backslash, or control character would come back
// out wrong (or fail to parse) if round-tripped through a source-text literal.
fn value_from_embed_dir_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let b = ctx.build
    let base = embed_base_dir(ctx) !>
    let dir = helper:resolve(exp.str1, base)
    if !fs:is_dir(dir) {
        exp.error("Embed directory not found: " + dir)
    }

    let idf = b.scope.get_idf("HashMap")
    if !isset(idf) : exp.bug("HashMap class not found (needed for #embed_dir)")
    if idf.type != IDF.class : exp.bug("HashMap is not a class")
    let map_base = idf.class
    if !isset(map_base) : exp.bug("HashMap idf is missing class")
    let str_t = type_string(b)
    let map_class = map_base.specialize(Array[Type]{ str_t, str_t }, exp) !>
    let rett = map_class.get_type() !>

    let construct = class_empty_construct(map_class, rett, scope, ctx, exp) !>
    let set_f = map_class.get_set_key_hook()
    if !isset(set_f) : exp.bug("HashMap has no '$set_key' hook")
    if !set_f.parsed_types : parse_func_types(set_f) !>

    let files = fs:files_in(dir, true, true, false, "")
    // The directory itself too: its mtime changes when files are added/removed
    b.watch_files.append(dir, true)
    each files as file {
        let full = fs:add(dir, file)
        let content = fs:read(full) ! exp.error("Error reading embed file: " + full)
        b.watch_files.append(full, true)
        let kv = vgen_string(file.replace("\\", "/"), str_t)
        let vv = vgen_string(content, str_t)
        let callee = vgen_func(set_f, construct)
        let args = Array[Value]{ kv, vv }
        let call = vgen_call(ctx, callee, args, set_f.get_rett())
        call.exp = exp
        if !call.rett.is_void_type() && call.rett.compat(rett) {
            construct = call
        }
    }

    let v = Value {
        type: VAL.class_init
        value1: construct
        rett: rett
        exp: exp
    }
    return v
}

// `co <call>` — launch a coroutine. Evaluates the call raw (no default error-pass; the
// error surfaces at `await` time instead) and wraps its return/error as `co(T)`.
fn value_from_co_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let enclosing = ctx.get_func() !>
    let call_exp = exp.get(VALUE_EXP.left)
    if !isset(call_exp) : exp.bug("'co' is missing a call expression")
    if call_exp.type != EXP.value || call_exp.kind != VALUE_KIND.call {
        call_exp.error("'co' can only be used on a function call")
    }
    let call = value_from_call_raw(call_exp, scope, ctx) !>
    let callee = call.value1
    if !isset(callee) : exp.bug("'co' call has no callable")
    if callee.rett.get_non_nullable().type == TYPE.fn {
        let decl = Decl.new(callee.rett, false, null)
        decl.is_buffer = true
        enclosing.all_decls.append(decl)
        let buffered = vgen_decl(decl)
        buffered.exp = exp
        buffered.pre_value = vgen_assign(vgen_decl(decl), callee, ASSIGN_OP.set, ctx.build, exp)
        call.value1 = buffered
    }

    let sub_type: ?Type = null
    if !call.rett.is_void_type() : sub_type = call.rett
    let co_type = Type {
        type: TYPE.co
        build: ctx.build
        sub_type: sub_type
        error_type: call.error_type
    }
    let helper_name = "valk.coro." + enclosing.unit.name + "." + enclosing.unit.coro_count++
    let v = Value {
        type: VAL.co
        value1: call
        rett: co_type
        exp: exp
        name: helper_name
    }
    return v
}

// `error_is(code, name, name, ...)` — true if `code` equals any of the named codes on
// its own ErrorType. Bare code names, not expressions (matches the classic compiler).
fn value_from_error_is_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let b = ctx.build
    let code_exp = exp.get(VALUE_EXP.left)
    if !isset(code_exp) : exp.bug("'error_is' is missing a code value")
    let code = value_from_exp(code_exp, scope, ctx.without_suggested_type()) !>
    let et = code.rett.get_non_nullable().error_type
    if !isset(et) {
        code_exp.error("'error_is' expects an error-code value as its first argument, got: " + code.rett.compat_display_name())
    }
    let names = exp.list
    if !isset(names) : exp.bug("'error_is' is missing code names")

    let result: ?Value = null
    each names as name {
        let candidate = value_from_error_code_item(et, name, exp) !>
        let cmp = vgen_op(code, candidate, VALUE_OP.eq, type_bool(b))
        cmp.exp = exp
        result = isset(result) ? vgen_op(result, cmp, VALUE_OP.or, type_bool(b)) : cmp
    }
    let v = result ?? vgen_bool(false, type_bool(b))
    v.exp = exp
    return v
}

// Recursively collect Decl references across a resolved body-Value tree. Ownership
// comes from Func.all_decls; local declarations are not executable AST values.
fn value_tree_collect_decls(v: Value, used: Array[Decl]) {
    if v.type == VAL.decl {
        let d = v.decl
        if isset(d) && !used.contains(d) : used.append(d)
    }
    // Nested closure construction must be able to supply the nested
    // environment's captures.
    if v.type == VAL.func {
        let nested = v.func
        if isset(nested) && nested.is_literal {
            each nested.capture_decls as d {
                if !used.contains(d) : used.append(d)
            }
        }
    }
    let v1 = v.value1
    if isset(v1) : value_tree_collect_decls(v1, used)
    let v2 = v.value2
    if isset(v2) : value_tree_collect_decls(v2, used)
    let vs = v.values
    if isset(vs) {
        each vs as sub : value_tree_collect_decls(sub, used)
    }
    let pv = v.pre_value
    if isset(pv) : value_tree_collect_decls(pv, used)
}

// True if a closure literal's body references any Decl it doesn't itself own (args or
// its own `let` bindings) — i.e. it captures something from an enclosing scope, and so
// can never convert to a bare `fnptr` (matches the classic compiler: a non-capturing
// literal is just a raw function pointer; a capturing one never is). Top-level fns and
// methods are lexically closed and can never capture, so this is always false for them.
fn func_has_captures(f: Func) bool {
    if !f.is_literal : return false
    let cached = f.captures
    if isset(cached) : return cached

    let owned = f.all_decls
    let used = Array[Decl]{}
    let scope = f.body_scope
    if isset(scope) {
        each scope.values as v : value_tree_collect_decls(v, used)
    }

    let has_cap = false
    each used as d {
        if !owned.contains(d) {
            has_cap = true
            f.capture_decls.append(d)
        }
    }
    f.captures = has_cap
    return has_cap
}

// Build the typed GC data object used by a closure. The function pointer lives
// in the inline fn value; this object contains bindings only.
fn func_prepare_closure(f: Func) !Error {
    if isset(f.capture_class) : return
    if f.is_literal : func_has_captures(f)

    // A closure's environment is GC-managed and can outlive the stack frame
    // that created it. Borrowed references therefore cannot be captured.
    each f.capture_decls as decl {
        if decl.type.get_non_nullable().type == TYPE.ref {
            f.exp.error("You cannot bind references in closures. Type not allowed: " + decl.type.compat_display_name())
        }
    }

    let class = Class {
        unit: f.unit
        ns: f.ns
        // The function name distinguishes synthetic closures created from the
        // same source expression by separate generic specializations.
        name: "closure_env_" + f.unit.name + "_" + helper:ctxhash(f.name) + "_" + f.exp.i
        display_name: "<closure binding data>"
        act: ACT.private
        kind: CLASS_KIND.class
        scope: f.arg_scope
        exp: f.exp
    }
    if isset(f.class) && !f.is_static {
        let receiver_arg = f.args.get(0) !? null
        if !isset(receiver_arg) : f.exp.bug("Instance closure target has no receiver argument")
        class.props.append(Prop {
            class: class
            name: "receiver"
            act: ACT.private
            exp: f.exp
            type: receiver_arg.type
        })
    }
    each f.capture_decls as decl, i {
        class.props.append(Prop {
            class: class
            name: "capture_" + i
            act: ACT.private
            exp: f.exp
            type: decl.type
        })
    }
    let capture_size = class.compute_body_size() !>
    f.capture_class = class
    if capture_size > 0 {
        f.capture_allocator = allocator_for_class(Context.for_func(f), class, f.exp) !>
    }
}

// The Func a value directly references.
fn value_resolve_func_ref(v: Value) ?Func {
    if v.type != VAL.func : return null
    return v.func
}

// `fn(args) rett! { body }` — anonymous function literal (closure). Builds a synthetic
// Func with its own arg/body scopes, parented on the enclosing scope.
fn value_from_func_lit_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let b = ctx.build
    let enclosing = ctx.get_func() !>
    let args_exp = exp.get(FUNC_LIT_EXP.args)
    if !isset(args_exp) : exp.bug("Function literal is missing an argument list")

    let f = Func {
        unit: enclosing.unit
        ns: enclosing.ns
        name: "<anonymous>"
        act: ACT.private
        exp: exp
        arg_scope: scope.sub_scope()
        args_exp: args_exp
        rett_exp: exp.get(FUNC_LIT_EXP.type)
        error: exp.get(FUNC_LIT_EXP.error)
        body: exp.get(FUNC_LIT_EXP.body)
        is_literal: true
    }
    f.arg_scope.func = f
    // Function literals are real functions owned by the containing source
    // unit. Register them so their generated IR definition is emitted.
    f.unit.functions.append(f)
    parse_func_types(f) !>
    parse_func_ast(f) !>

    let arg_types = Array[Type]{}
    each f.args as a : arg_types.append(a.type)

    // Store the natural return type: void, T, or a multi-value type.
    let sub_type = f.get_rett()

    let fn_type = Type {
        type: TYPE.fn
        build: b
        sub_type: sub_type
        sub_types: arg_types
        error_type: f.error_type
    }

    let v = vgen_func(f)
    v.rett = fn_type
    v.exp = exp
    return v
}

// `<{ ... }` — body re-parsed as statements; returns form the value (phi).
fn value_from_vscope_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let body = exp.get(VALUE_EXP.left)
    if !isset(body) : exp.bug("vscope is missing body")
    if body.type != EXP.body : exp.bug("vscope body must be EXP.body")

    let returns = Array[Value]{}
    let sub = scope.sub_scope()
    sub.vscope_returns = returns
    // Seed result type from the suggested type (assign / !? alt / let type / …)
    let suggested_type = ctx.suggested_type
    if isset(suggested_type) : sub.vscope_rett = suggested_type

    let state = ParseState.new()
    let stmts = Array[Value]{}
    let p = body_parser(body) !>
    let members = read_func_stmts(p) !>
    each members as mem {
        let v = body_value_from_exp(ctx, sub, state, mem) !>
        if isset(v) : stmts.append(v)
    }
    if state.has_open_if() || state.is_skipping() {
        exp.error("Missing compile macro '#end' in value scope")
    }

    let rett = sub.vscope_rett
    if !isset(rett) || returns.length == 0 || !sub.did_return {
        exp.error("Value scope did not return a value")
    }
    // Unwrap the collected returns for the phi. Reading them here (rather than
    // collecting values alongside the statements) keeps a single source of truth,
    // so a widened return can never disagree with what IR emits.
    let retvs = Array[Value]{}
    each returns as ret {
        let rv = ret.value1
        if !isset(rv) : exp.bug("Value scope return has no value")
        retvs.append(rv)
    }
    let phi = vgen_phi(retvs, rett, exp)
    return vgen_vscope(stmts, phi, exp)
}

// @ptrv(on, Type, offset?) — body re-parsed as value, type, optional value.
fn value_from_ptrv_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let body = exp.get(VALUE_EXP.right)
    if !isset(body) : exp.bug("@ptrv is missing body")
    if body.type != EXP.body : exp.bug("@ptrv body must be EXP.body")

    let b = ctx.build
    let p = body_parser(body) !>

    let on_exp = read_value_exp(p, true, true) !>
    p.expect(",", true, true) !>
    let type_exp = read_type_exp(p, true, true) !>

    let offset_exp: ?Exp = null
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is(",") {
        p.tok(true, true) !>
        offset_exp = read_value_exp(p, true, true) !>
        p.expect(")", true, true) !>
    } else {
        p.expect(")", true, true) !>
    }

    let ptr_t = type_ptr(b)
    let on = value_from_exp(on_exp, scope, ctx.without_suggested_type()) !>
    on = value_try_convert(on, scope, ctx, ptr_t)
    ptr_t.compat_check(on.rett, on_exp) !>

    let elem = type_from_exp(type_exp, scope) !>

    let offset = vgen_int(0, type_int(b))
    if isset(offset_exp) {
        offset = value_from_exp(offset_exp, scope, ctx.with_suggested_type(type_int(b))) !>
        if !offset.rett.is_integer_type() {
            offset_exp.error("Expected a number value, not: " + offset.rett.compat_display_name())
        }
    }

    return vgen_ptrv(on, offset, elem, exp)
}

// @memcpy(from, to, length) — both addresses are raw-pointer compatible and
// length uses core:uint, matching the LLVM intrinsic and legacy compiler.
fn value_from_memcpy_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let body = exp.get(VALUE_EXP.right)
    if !isset(body) : exp.bug("@memcpy is missing its argument body")
    let arg_exps = parse_body_as_value_list(body) !>
    if arg_exps.length != 3 {
        exp.error("@memcpy expects 3 arguments, got " + arg_exps.length)
    }

    let ptr_t = type_ptr(ctx.build)
    let uint_t = type_from_core(ctx.build, "uint") !>
    let values = Array[Value]{}
    each arg_exps as arg_exp, i {
        let target = i < 2 ? ptr_t : uint_t
        let value = value_from_exp(arg_exp, scope, ctx.with_suggested_type(target)) !>
        value = value_try_convert(value, scope, ctx, target)
        target.compat_check(value.rett, arg_exp) !>
        values.append(value)
    }
    return vgen_memcpy(values, ctx.build, exp)
}

// @ref(assignable) — body is a single lvalue; result is raw ptr.
fn value_from_ref_of_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let body = exp.get(VALUE_EXP.right)
    if !isset(body) : exp.bug("@ref is missing body")
    if body.type != EXP.body : exp.bug("@ref body must be EXP.body")

    let on_exp = parse_body_as_value_exp(body) !>
    let on = value_from_exp(on_exp, scope, ctx.without_suggested_type()) !>
    if !on.assignable() {
        exp.error("Cannot use '@ref on this value. It can only be used on assignable values, like variable names or object properties.")
    }
    act_check_assign(on, exp) !>

    // A raw pointer to a local may outlive a coroutine suspension (or be
    // passed to another thread). Keep that local in the stable stack storage
    // just like the typed `&` operator does, otherwise restoring a coroutine's
    // copied stack can discard writes made through the pointer.
    let target: ?Value = on
    while isset(target) && (target.type == VAL.ptrv || target.type == VAL.ptr_of) {
        target = target.value1
    }
    if isset(target) && target.type == VAL.decl {
        let decl = target.decl
        if isset(decl) : decl.make_stable()
    }

    // Old @ref always yields raw `ptr` (not &T).
    let rett = type_ptr(ctx.build)
    return vgen_ptr_of(on, rett, exp)
}

// Re-parse the captured `[...]` body once its receiver is known not to be a
// generic declaration. Requiring the closing bracket here also prevents an
// invalid `value[a, b]` from being silently accepted as `value[a]`.
// A single index is returned directly. Only an actual range needs one extra
// AST node, so ordinary indexing keeps its previous allocation profile.
fn parse_offset_access(body: Exp) Exp !Error {
    let p = body_parser(body) !>
    let start = read_value_exp(p, true, true) !>
    let t = p.tok(true, true, false) !>

    if t == TOK.sign && p.word_is("]") {
        p.tok(true, true) !>
        return start
    }

    if t == TOK.sign && p.word_is("..") {
        p.tok(true, true) !>
        let length = read_value_exp(p, true, true) !>
        p.expect("]", true, true) !>
        let range = p.create_exp(EXP.value)
        range.i = start.i
        range.kind = VALUE_KIND.bracket_range
        range.set(VALUE_EXP.left, start)
        range.set(VALUE_EXP.right, length)
        range.set_end(p.token_end)
        return range
    }

    p.error("Expected '..' or ']' in offset, found: '" + p.word() + "'")
}

// `base[…]` — body is EXP.body; re-parse as type list (specialize), a single
// index, or a range.
// Bare/unwrapped entry point: raw offset access, then apply the implicit default-value
// fallback when the resolved access is fallible and not already wrapped by an explicit
// error handler (`!?`, `! {}`, …) — see value_from_call_raw for the wrapped case.
fn value_from_offset_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let v = value_from_offset_raw_exp(exp, scope, ctx) !>
    if v.can_error : return value_apply_offset_default(v, scope, ctx, exp) !>
    return v
}

// No explicit handler after `[]` — fall back to a default/zero value instead of
// rethrowing (matches Array/Map `[]` semantics: an out-of-bounds read yields the
// zero value / null, it does not propagate an error to the caller).
fn value_apply_offset_default(call: Value, scope: Scope, ctx: Context, at: Exp) Value !Error {
    let left = call.trim_errors()
    let default_v = vgen_default_value(left.rett)
    return value_error_result(call, default_v, default_v.rett, ERRH_KIND.value, at)
}

// Mode-fallthrough lookup for the `$offset` get hook.
fn resolve_offset_get_func(class: Class) ?Func {
    let f = class.offset
    if isset(f) : return f
    let for_class = class.mode_for_class
    if isset(for_class) : return resolve_offset_get_func(for_class)
    return null
}

// Mode-fallthrough lookup for the `$offset_assign` set hook.
fn resolve_offset_assign_func(class: Class) ?Func {
    let f = class.offset_assign
    if isset(f) : return f
    let for_class = class.mode_for_class
    if isset(for_class) : return resolve_offset_assign_func(for_class)
    return null
}

// Same as value_from_offset_exp but without the implicit default-value fallback —
// used both as the main entry point (wrapped there) and directly by value_from_call_raw
// when an explicit error handler already wraps the access.
fn value_from_offset_raw_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let left_exp = exp.get(VALUE_EXP.left)
    if !isset(left_exp) : exp.bug("offset is missing base")
    let body = exp.get(VALUE_EXP.right)
    if !isset(body) : exp.bug("offset is missing body")
    if body.type != EXP.body : exp.bug("offset body must be EXP.body")

    let on = value_from_exp(left_exp, scope, ctx.without_suggested_type()) !>
    let b = ctx.build

    // Generic class specialize: `HashMap[String, uint]` / `X[String]`
    let gen_class = offset_generic_class(on)
    if isset(gen_class) {
        let type_exps = parse_body_as_type_list(body) !>
        if type_exps.length == 0 {
            exp.error("Generic type '" + gen_class.name + "' requires type arguments")
        }
        let gtypes = Array[Type]{}
        each type_exps as te {
            gtypes.append(type_from_exp(te, scope) !>)
        }
        let c = gen_class.specialize(gtypes, exp) !>
        let v = vgen_type(c.get_type() !>, b)
        v.exp = exp
        return v
    }

    // Generic free function: `foo[T]`
    let gen_func = offset_generic_func(on)
    if isset(gen_func) {
        let type_exps = parse_body_as_type_list(body) !>
        if type_exps.length == 0 {
            exp.error("Generic function '" + gen_func.name + "' requires type arguments")
        }
        let gtypes = Array[Type]{}
        each type_exps as te {
            gtypes.append(type_from_exp(te, scope) !>)
        }
        let f = gen_func.specialize(gtypes, exp) !>
        let v = vgen_func(f)
        v.exp = exp
        return v
    }

    let access = parse_offset_access(body) !>
    let on_t = on.rett.get_non_nullable()
    if access.kind == VALUE_KIND.bracket_range {
        let start_exp = access.get(VALUE_EXP.left)
        let length_exp = access.get(VALUE_EXP.right)
        if !isset(start_exp) || !isset(length_exp) : access.bug("Bracket range is missing an argument")
        let on_class = on_t.get_class_or_null()
        if !isset(on_class) {
            exp.error("Type: '" + on.rett.compat_display_name() + "' has no '$range' function")
        }
        let range_func = on_class.get_range_hook()
        if !isset(range_func) {
            exp.error("Type: '" + on.rett.compat_display_name() + "' has no '$range' function")
        }
        if on.rett.is_nullable_type() {
            exp.error("Cannot use '[]' on a nullable value: " + on.rett.compat_display_name())
        }

        // `$range` signatures are validated when their flag is registered, so
        // both arguments always receive the canonical uint suggestion/conversion.
        let uint_t = type_from_core(b, "uint") !>
        let start_index = value_from_exp(start_exp, scope, ctx.with_suggested_type(uint_t)) !>
        let length = value_from_exp(length_exp, scope, ctx.with_suggested_type(uint_t)) !>
        let args = Array[Value]{ start_index, length }
        let callee = vgen_func(range_func, on)
        value_check_call_args(range_func, callee, args, scope, ctx, exp) !>
        value_buffer_call_receiver(callee, ctx)
        value_buffer_call_args(args, ctx)
        let call = vgen_call(ctx, callee, args, range_func.get_rett())
        call.exp = exp
        if range_func.can_error {
            call.can_error = true
            call.error_type = range_func.error_type
        }
        return call
    }

    // Index / offset — body is a single value expression.
    let index_exp = access
    let index = value_from_exp(index_exp, scope, ctx.without_suggested_type()) !>

    // Fixed array `[T x N]`
    if on_t.type == TYPE.array {
        let sub = on_t.sub_type
        if !isset(sub) : exp.bug("Array type is missing sub_type")
        if !index.rett.is_integer_type() {
            index_exp.error("Invalid offset, expected an integer value instead of: " + index.rett.compat_display_name())
        }
        let size = on_t.array_size
        if size > 0 && index.type == VAL.int {
            if index.int_val < 0 || index.int_val.@cast(uint) >= size.@cast(uint) {
                exp.error("Out of bounds. You are asking for index '" + index.int_val + "' on type: " + on_t.compat_display_name() + ". The last index is: " + (size - 1))
            }
        }
        return vgen_ptrv(on, index, sub, exp)
    }

    // *T / &T with known element type
    if on_t.type == TYPE.ptr || on_t.type == TYPE.ref {
        let sub = on_t.sub_type
        if isset(sub) {
            if !index.rett.is_integer_type() {
                index_exp.error("Invalid offset, expected an integer value instead of: " + index.rett.compat_display_name())
            }
            return vgen_ptrv(on, index, sub, exp)
        }
    }

    // Class `$offset` hook, e.g. `Array[T].get(index: uint) T !LookupError`.
    let on_class = on_t.get_class_or_null()
    if isset(on_class) {
        let get_func = resolve_offset_get_func(on_class)
        if isset(get_func) {
            if on.rett.is_nullable_type() {
                let nullable_class = on.rett.get_non_nullable().class
                if !isset(nullable_class) {
                    exp.error("Cannot use '[]' on a nullable value: " + on.rett.compat_display_name())
                } else if nullable_class.kind != CLASS_KIND.union {
                    exp.error("Cannot use '[]' on a nullable value: " + on.rett.compat_display_name())
                }
            }
            let arg_skip: uint = 0
            if isset(get_func.class) && !get_func.is_static : arg_skip = 1
            let index_arg = get_func.args.get(arg_skip) ! exp.bug("'$offset' function is missing its index parameter")
            index = value_try_convert(index, scope, ctx, index_arg.type)
            index_arg.type.compat_check(index.rett, index_exp) !>

            let callee = vgen_func(get_func, on)
            let call = vgen_call(ctx, callee, Array[Value]{ index }, get_func.get_rett())
            call.exp = exp
            if get_func.can_error {
                call.can_error = true
                call.error_type = get_func.error_type
            }
            return call
        }
    }

    exp.error("Type: '" + on.rett.compat_display_name() + "' has no '[]' get offset function")
}

// `on[index] = value` — only handled here when `on` resolves to a class with a
// `$offset_assign` hook; fixed arrays / pointers return null so the caller falls
// through to the normal assignable (VAL.ptrv) path.
fn value_from_offset_assign_exp(ctx: Context, scope: Scope, left_exp: Exp, right_exp: Exp, at: Exp) ?Value !Error {
    let base_exp = left_exp.get(VALUE_EXP.left)
    if !isset(base_exp) : left_exp.bug("offset is missing base")
    let body = left_exp.get(VALUE_EXP.right)
    if !isset(body) : left_exp.bug("offset is missing body")
    if body.type != EXP.body : left_exp.bug("offset body must be EXP.body")

    let access = parse_offset_access(body) !>
    if access.kind == VALUE_KIND.bracket_range {
        left_exp.error("Cannot assign to a bracket range")
    }

    let on = value_from_exp(base_exp, scope, ctx.without_suggested_type()) !>
    let on_t = on.rett.get_non_nullable()
    // Fixed array / pointer targets use the existing assignable (VAL.ptrv) path.
    if on_t.type == TYPE.array || on_t.type == TYPE.ptr || on_t.type == TYPE.ref : return null

    let on_class = on_t.get_class_or_null()
    if !isset(on_class) : return null
    let set_func = resolve_offset_assign_func(on_class)
    if !isset(set_func) : return null

    if on.rett.is_nullable_type() {
        left_exp.error("Cannot use '[]' on a nullable value: " + on.rett.compat_display_name())
    }

    let index_exp = access
    let index = value_from_exp(index_exp, scope, ctx.without_suggested_type()) !>

    let arg_skip: uint = 0
    if isset(set_func.class) && !set_func.is_static : arg_skip = 1
    let index_arg = set_func.args.get(arg_skip) ! at.bug("'$offset_assign' function is missing its index parameter")
    index = value_try_convert(index, scope, ctx, index_arg.type)
    index_arg.type.compat_check(index.rett, index_exp) !>

    let value_arg = set_func.args.get(arg_skip + 1) ! at.bug("'$offset_assign' function is missing its value parameter")
    let right = value_from_exp(right_exp, scope, ctx.with_suggested_type(value_arg.type)) !>
    right = value_try_convert(right, scope, ctx, value_arg.type)
    value_arg.type.compat_check(right.rett, right_exp) !>

    let callee = vgen_func(set_func, on)
    let call = vgen_call(ctx, callee, Array[Value]{ index, right }, set_func.get_rett())
    call.exp = at
    if set_func.can_error {
        call.can_error = true
        call.error_type = set_func.error_type
        // Unhandled `[]=` errors are silently ignored (out-of-range writes are a no-op),
        // matching the implicit default-value fallback for reads.
        return value_apply_error_ignore(call, at, ctx)
    }
    return call
}

// Generic class base from a value left of `[T, …]`.
fn offset_generic_class(on: Value) ?Class {
    if on.type == VAL.type {
        let base = on.class_ref
        if isset(base) && base.is_generic_base : return base
        let t = on.of_type
        if !isset(t) : return null
        let c = t.class
        if isset(c) && c.is_generic_base : return c
    }
    return null
}

// Generic free-function base from a value left of `[T, …]`.
fn offset_generic_func(on: Value) ?Func {
    if on.type != VAL.func : return null
    let f = on.func
    if isset(f) && f.is_generic_base : return f
    return null
}

// Type { … } or bare { … } — right is EXP.body.
// Body items: `prop: v` (fields), `v` ($append), `k => v` ($set_key).
class ClassInitItems {
    fields: Array[Exp] (.{})
    field_scopes: Array[Scope] (.{})
    elems: Array[Exp] (.{})
    pairs: Array[Exp] (.{})
}

fn property_loop_type(scope: Scope, name: String, at: Exp) Type !Error {
    let idf = scope.get_idf(name)
    if !isset(idf) : at.error("Unknown type in '#loop properties': " + name)
    if idf.type == IDF.type {
        let t = idf.of_type
        if !isset(t) : at.bug("Type idf is missing of_type")
        return t
    }
    if idf.type == IDF.class {
        let class = idf.class
        if !isset(class) : at.bug("Class idf is missing Class")
        return class.get_type() !>
    }
    if idf.type == IDF.property {
        let prop = idf.prop
        if !isset(prop) : at.bug("Property idf is missing Prop")
        return prop.type
    }
    at.error("Identifier is not a type in '#loop properties': " + name)
}

fn class_init_find_loop_end(items: Exp, start: uint, at: Exp) uint !Error {
    let depth: uint = 0
    let i = start + 1
    while true {
        let item = items.get(i)
        if !isset(item) : at.error("Missing '#end' for '#loop properties'")
        if item.type == EXP.macro {
            let kind = item.kind.@cast(MACRO_KIND)
            if kind == MACRO_KIND.loop || kind == MACRO_KIND.if {
                depth++
            } else if kind == MACRO_KIND.end {
                if depth == 0 : return i
                depth--
            }
        }
        i++
    }
}

fn append_class_init_item_range(out: ClassInitItems, items: Exp, start: uint, end: uint, scope: Scope, ctx: Context) !Error {
    let state = ParseState.new()
    let i = start
    while i < end {
        let item = items.get(i)
        if !isset(item) : break
        if item.type == EXP.macro {
            let kind = item.kind.@cast(MACRO_KIND)
            if kind == MACRO_KIND.loop && !state.is_skipping() {
                let close = class_init_find_loop_end(items, i, item) !>
                let words = item.list
                if !isset(words) {
                    item.error("Expected '#loop properties TYPE as PROPERTY' or '#loop object VALUE as PROPERTY'")
                }
                let loop_kind = words.get(0) !? ""
                if words.length != 4 || (words.get(2) !? "") != "as" {
                    item.error("Expected '#loop properties TYPE as PROPERTY' or '#loop object VALUE as PROPERTY'")
                }
                let prop_name = words.get(3) ! item.bug("Missing property-loop binding")

                // `object` binds each property *of a value*, so the field it
                // writes carries that value's property as its initializer —
                // which is what copying one object into a new one needs
                // (see clone_value in valk:core).
                if loop_kind == "object" {
                    let value_name = words.get(1) ! item.bug("Missing object-loop value")
                    let idf = scope.get_idf(value_name) ?! item.error("Expected a variable after '#loop object'")
                    if idf.type != IDF.decl {
                        item.error("Expected a variable after '#loop object'")
                    }
                    let decl = idf.decl
                    if !isset(decl) : item.bug("Object-loop variable is missing its declaration")
                    let owner_class = decl.type.get_non_nullable().get_class_or_null()
                    if isset(owner_class) {
                        let owner = vgen_decl(decl)
                        each owner_class.props as prop {
                            let iter_scope = scope.sub_scope()
                            iter_scope.func = scope.func
                            iter_scope.set_idf(prop_name, Idf.for_object_property(prop, vgen_prop(prop, owner, ctx)))
                            append_class_init_item_range(out, items, i + 1, close, iter_scope, ctx) !>
                        }
                    }
                    i = close + 1
                    continue
                }
                if loop_kind != "properties" {
                    item.error("Unknown '#loop' kind in a class initializer: " + loop_kind)
                }
                let type_name = words.get(1) ! item.bug("Missing property-loop type")
                let type = property_loop_type(scope, type_name, item) !>
                let class = type.get_non_nullable().get_class_or_null()
                if isset(class) {
                    each class.props as prop {
                        let iter_scope = scope.sub_scope()
                        iter_scope.func = scope.func
                        iter_scope.set_idf(prop_name, Idf.for_property(prop))
                        append_class_init_item_range(out, items, i + 1, close, iter_scope, ctx) !>
                    }
                }
                i = close + 1
                continue
            }
            let func = ctx.get_func() !>
            parse_macro_exp(func.ns, scope, state, item) !>
            i++
            continue
        }
        if state.is_skipping() {
            i++
            continue
        }
        let ik = item.number.@cast(CLASS_INIT_ITEM)
        if ik == CLASS_INIT_ITEM.field || item.str1.length > 0 {
            out.fields.append(item)
            out.field_scopes.append(scope)
        } else if ik == CLASS_INIT_ITEM.pair {
            out.pairs.append(item)
        } else if ik == CLASS_INIT_ITEM.elem {
            out.elems.append(item)
        } else {
            item.error("Invalid class init item")
        }
        i++
    }
    if state.has_open_if() || state.is_skipping() {
        items.error("Missing '#end' inside class initializer")
    }
}

fn value_from_class_init_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let body = exp.get(VALUE_EXP.right)
    if !isset(body) : exp.bug("class_init is missing body")
    if body.type != EXP.body : exp.bug("class_init body must be EXP.body")

    let left_exp = exp.get(VALUE_EXP.left)

    // Explicit fixed-array literal: `[T x N]{ ... }`.
    if isset(left_exp) && left_exp.type == EXP.type && left_exp.kind == TYPE_KIND.array {
        let array_type = type_from_exp(left_exp, scope) !>
        return value_from_array_init_body(exp, body, array_type, scope, ctx) !>
    }

    // `.code { field: value, ... }` — error payload construction, not a class/struct init.
    if isset(left_exp) && left_exp.type == EXP.value && left_exp.kind == VALUE_KIND.error_code {
        return value_from_error_payload_init_exp(exp, scope, ctx, left_exp) !>
    }

    // Bare `{ … }` with a suggested fixed array → element list (positional only)
    if !isset(left_exp) {
        let suggested_type = ctx.suggested_type
        if isset(suggested_type) {
            let atype = suggested_type.get_non_nullable()
            if atype.type == TYPE.array {
                return value_from_array_init_body(exp, body, suggested_type, scope, ctx) !>
            }
        }
    }

    let class: ?Class = null
    let rett: ?Type = null
    let left_val: ?Value = null

    if isset(left_exp) {
        left_val = value_from_exp(left_exp, scope, ctx.without_suggested_type()) !>
        class = left_val.as_class_for_init()
        if !isset(class) {
            exp.error("Class init requires a class or struct type before '{'")
        }
    } else {
        // Bare `{ fields }` — need a suggested type (assign / prop field / arg / return)
        let suggested_type = ctx.suggested_type
        if !isset(suggested_type) {
            exp.error("You cannot use '{' here. It can only be used for defining the starting value for inline types. E.g. let myvar: [u8 x 2] = { 6, 7 }")
        }
        // Suggested class type (e.g. Array[String] default `.{}`) — hook/field init
        let suggested_class = suggested_type.get_non_nullable().get_class_or_null()
        if isset(suggested_class) {
            class = suggested_class
            // An object literal always produces an object, so it is never null even
            // when the expectation was `?T` (`let d: ?Map[V] = …` then `d = .{}`).
            // Keeping the nullable suggestion here would report the fresh object as
            // possibly-null and defeat the narrowing on assignment.
            rett = suggested_type.get_non_nullable()
        } else {
            class = class_from_inline_init_type(suggested_type)
            if !isset(class) {
                exp.error("The '{' token can only be used to define initialization values for inline struct, fixed arrays, or class types. Not for: " + suggested_type.compat_display_name())
            }
            // Keep the suggested type (e.g. `<IIS1>`) so assign/compat match without extra convert
            rett = suggested_type
        }
    }

    let items_exp = parse_body_as_class_init_fields(body) !>
    let expanded = ClassInitItems {}
    append_class_init_item_range(expanded, items_exp, 0, 4294967295, scope, ctx) !>
    let elem_exps = expanded.elems
    let pair_exps = expanded.pairs
    let field_exps = expanded.fields

    let has_fields = field_exps.length > 0
    let has_elems = elem_exps.length > 0
    let has_pairs = pair_exps.length > 0
    if has_fields && (has_elems || has_pairs) {
        exp.error("Cannot mix property fields with list/map entries in the same class init")
    }
    if has_elems && has_pairs {
        exp.error("Cannot mix list entries and map entries (`=>`) in the same class init")
    }

    // Generic class initializers require explicit type arguments. Suggested-type
    // initialization uses `.{...}` and is resolved before reaching this branch.
    if class.is_generic_base {
        exp.error("Generic type '" + class.name + "' requires type arguments")
    }
    if class.kind == CLASS_KIND.interface {
        exp.error("Interfaces cannot be constructed directly")
    }
    if !isset(rett) {
        rett = class.get_type() !>
    }
    // A mode has the same runtime representation as the type it wraps.
    // Construction must therefore allocate and initialize that underlying
    // class while retaining the mode Type as the expression result.
    let init_class = class
    while init_class.kind == CLASS_KIND.mode {
        let for_class = init_class.mode_for_class
        if !isset(for_class) : exp.bug("Mode target is unresolved during class initialization")
        init_class = for_class
    }

    // Field-only (or empty) structural / default construct
    if !has_elems && !has_pairs {
        // An empty class initializer uses its static new() constructor. Inside
        // that constructor, `SELF{}` is the raw allocation step and must not
        // recurse. Structs remain direct aggregate initialization.
        if field_exps.length == 0 && class.kind == CLASS_KIND.class {
            let new_func = class.get_func("new")
            let current_func = ctx.func
            if isset(new_func) && new_func.is_static && (!isset(current_func) || current_func != new_func) {
                return class_empty_construct(class, rett, scope, ctx, exp) !>
            }
        }
        let fvals = Array[Value]{}
        each field_exps as fexp, field_i {
            let field_scope = expanded.field_scopes.get(field_i) ! exp.bug("Missing class-init field scope")
            let fname = fexp.str1
            let field_idf = field_scope.get_idf(fname)
            if isset(field_idf) && field_idf.type == IDF.property {
                let loop_prop = field_idf.prop
                if !isset(loop_prop) : fexp.bug("Property idf is missing Prop")
                let loop_name = loop_prop.name
                if !isset(loop_name) : fexp.bug("Loop property has no name")
                fname = loop_name
            }
            let vexp = fexp.get(VALUE_EXP.left)
            if !isset(vexp) : fexp.bug("class_init field is missing value")
            let prop = init_class.get_prop_by_name(fname) !? null
            if !isset(prop) && init_class.props.length > 0 {
                let has_named = false
                each init_class.props as p {
                    if isset(p.name) : has_named = true
                }
                if has_named {
                    fexp.error("There's no property named: '" + fname + "'")
                }
            }
            // Setting a field is a store, so `~` read-only rejects it too
            if isset(prop) : act_check(fexp, prop.act, prop.exp, true, "property") !>
            let field_ctx = ctx.without_suggested_type()
            if isset(prop) : field_ctx = ctx.with_suggested_type(prop.type)
            let fv = value_from_exp(vexp, field_scope, field_ctx) !>
            if isset(prop) {
                fv = value_try_convert(fv, field_scope, ctx, prop.type)
                prop.type.compat_check(fv.rett, vexp) !>
            }
            fv.name = fname
            fvals.append(fv)
        }

        // Unspecified fields with declaration defaults are evaluated before
        // allocation just like explicit fields. A non-null property whose type
        // defines `$default` uses that hook as its generated default. Nullable
        // properties deliberately keep their zero/null representation instead
        // of invoking the wrapped type's hook. vgen_class_init then buffers GC
        // values and performs the final plain stores into the new object.
        each init_class.props as prop {
            let prop_name = prop.name
            if !isset(prop_name) : continue
            let already_set = false
            each fvals as field {
                if field.name == prop_name {
                    already_set = true
                    break
                }
            }
            if already_set : continue
            let default_body = prop.default
            let fv: ?Value = null
            let default_at = prop.exp
            if isset(default_body) {
                let default_exp = parse_body_as_value_exp(default_body) !>
                let default_scope = prop.class.scope.sub_scope()
                default_scope.func = scope.func
                fv = value_from_exp(default_exp, default_scope, ctx.with_suggested_type(prop.type)) !>
                default_at = default_exp
            } else {
                if prop.type.is_nullable_type() : continue
                let prop_class = prop.type.get_class_or_null()
                if !isset(prop_class) : continue
                if !isset(prop_class.default_hook) : continue
                fv = value_generate_default(prop.type, scope, ctx, prop.exp) !>
            }
            let field_value = fv ?! prop.exp.bug("Property default did not produce a value")
            // `@undefined` deliberately contributes no initialization store.
            if field_value.type == VAL.undefined : continue
            field_value = value_try_convert(field_value, scope, ctx, prop.type)
            prop.type.compat_check(field_value.rett, default_at) !>
            field_value.name = prop_name
            fvals.append(field_value)
        }
        return vgen_class_init(ctx, init_class, fvals, rett, exp) !>
    }

    // List / map init: construct empty, then $append / $set_key
    return value_from_class_init_hooks(class, rett, elem_exps, pair_exps, scope, ctx, exp) !>
}

// `Array[T]{ a, b }` / `Map[T]{ k => v }` — empty construct + hook calls.
fn value_from_class_init_hooks(class: Class, rett: Type, elem_exps: Array[Exp], pair_exps: Array[Exp], scope: Scope, ctx: Context, at: Exp) Value !Error {
    let construct = class_empty_construct(class, rett, scope, ctx, at) !>

    let hooks = Array[Value]{}
    if elem_exps.length > 0 {
        let append_f = class.get_append_hook()
        if !isset(append_f) {
            at.error("Type '" + class.pretty_name() + "' has no '$append' hook (needed for list-style class init)")
        }
        if !append_f.parsed_types : parse_func_types(append_f) !>
        each elem_exps as eexp {
            let vexp = eexp.get(VALUE_EXP.left)
            if !isset(vexp) : eexp.bug("element missing value")
            let ect = ctx.without_suggested_type()
            let atype = class_hook_param_type(append_f, 0)
            if isset(atype) : ect = ctx.with_suggested_type(atype)
            let ev = value_from_exp(vexp, scope, ect) !>
            if isset(atype) && !ev.rett.is_void_type() {
                ev = value_try_convert(ev, scope, ctx, atype)
            }
            let callee = vgen_func(append_f, construct)
            let args = Array[Value]{ ev }
            value_fill_trailing_defaults(append_f, call_receiver_skip(callee, append_f), args, scope, ctx, eexp) !>
            value_check_call_args(append_f, callee, args, scope, ctx, eexp) !>
            let call = vgen_call(ctx, callee, args, append_f.get_rett())
            call.exp = eexp
            hooks.append(call)
            // Chain when append returns SELF
            if !call.rett.is_void_type() && call.rett.compat(rett) {
                construct = call
            }
        }
    } else {
        let set_f = class.get_set_key_hook()
        if !isset(set_f) {
            at.error("Type '" + class.pretty_name() + "' has no '$set_key' hook (needed for map-style class init)")
        }
        if !set_f.parsed_types : parse_func_types(set_f) !>
        each pair_exps as pexp {
            let kexp = pexp.get(VALUE_EXP.left)
            if !isset(kexp) : pexp.bug("pair missing key")
            let vexp = pexp.get(VALUE_EXP.right)
            if !isset(vexp) : pexp.bug("pair missing value")
            let kt = class_hook_param_type(set_f, 0)
            let vt = class_hook_param_type(set_f, 1)
            let kctx = ctx.without_suggested_type()
            let vctx = ctx.without_suggested_type()
            if isset(kt) : kctx = ctx.with_suggested_type(kt)
            if isset(vt) : vctx = ctx.with_suggested_type(vt)
            let kv = value_from_exp(kexp, scope, kctx) !>
            let vv = value_from_exp(vexp, scope, vctx) !>
            if isset(kt) && !kv.rett.is_void_type() : kv = value_try_convert(kv, scope, ctx, kt)
            if isset(vt) && !vv.rett.is_void_type() : vv = value_try_convert(vv, scope, ctx, vt)
            let callee = vgen_func(set_f, construct)
            let args = Array[Value]{ kv, vv }
            value_fill_trailing_defaults(set_f, call_receiver_skip(callee, set_f), args, scope, ctx, pexp) !>
            value_check_call_args(set_f, callee, args, scope, ctx, pexp) !>
            let call = vgen_call(ctx, callee, args, set_f.get_rett())
            call.exp = pexp
            hooks.append(call)
            if !call.rett.is_void_type() && call.rett.compat(rett) {
                construct = call
            }
        }
    }

    // Represent as class_init-like value: value1 = final object, values = hook side-effects
    // (IR can emit construct then calls; typecheck only needs rett).
    let v = Value {
        type: VAL.class_init
        value1: construct
        values: hooks
        rett: rett
        exp: at
    }
    return v
}

// Empty instance: prefer static `new()` (defaults allowed), else empty field class_init.
fn class_empty_construct(class: Class, rett: Type, scope: Scope, ctx: Context, at: Exp) Value !Error {
    let f = class.get_func("new")
    if isset(f) && f.is_static {
        if !f.parsed_types : parse_func_types(f) !>
        let callee = vgen_func(f)
        let args = value_from_call_args(callee, f, null, scope, ctx, at) !>
        value_check_call_args(f, callee, args, scope, ctx, at) !>
        let call = vgen_call(ctx, callee, args, f.get_rett())
        call.exp = at
        if call.rett.is_void_type() : call.rett = rett
        return call
    }
    return vgen_class_init(ctx, class, Array[Value]{}, rett, at) !>
}

// Param type of a method after implicit `this` (instance) or without (static).
fn class_hook_param_type(f: Func, i: uint) ?Type {
    let params = f.args
    let skip: uint = 0
    if isset(f.class) && !f.is_static : skip = 1 // this
    let pi = skip + i
    if pi >= params.length : return null
    let p = params.get(pi) !? null
    if !isset(p) : return null
    if p.is_generic : return null
    return p.type
}

// Bare `{ v0, v1, ... }` for fixed arrays — body re-parsed as element values.
fn value_from_array_init_body(exp: Exp, body: Exp, suggested_type: Type, scope: Scope, ctx: Context) Value !Error {
    let atype = suggested_type.get_non_nullable()
    let sub = atype.sub_type
    if !isset(sub) : exp.bug("Array type is missing sub_type")
    let size = atype.array_size
    if size < 1 : exp.error("Array size is 0 (bug)")

    let elems_exp = parse_body_as_array_init_elements(body) !>
    let values = Array[Value]{}
    let last_values: ?Array[Value] = null
    let i: uint = 0
    while true {
        let eexp = elems_exp.get(i)
        if !isset(eexp) : break
        if eexp.type == EXP.value && eexp.kind == VALUE_KIND.repeat {
            if !isset(last_values) : eexp.error("No value to repeat")
            if last_values.length == 0 : eexp.error("No value to repeat")
            while values.length < size {
                each last_values as last {
                    if values.length == size : break
                    values.append(last)
                }
            }
            i++
            continue
        }
        if values.length >= size {
            eexp.error("Too many values")
        }
        let ev = value_from_exp(eexp, scope, ctx.with_suggested_type(sub)) !>
        let unrolled = ev.unroll()
        let converted = Array[Value]{}
        each unrolled as item {
            if values.length >= size {
                eexp.error("Too many values")
            }
            if item.type != VAL.undefined {
                item = value_try_convert(item, scope, ctx, sub)
                let at = item.exp
                if isset(at) : sub.compat_check(item.rett, at) !>
                else : sub.compat_check(item.rett, eexp) !>
            }
            values.append(item)
            converted.append(item)
        }
        last_values = converted
        i++
    }
    if values.length < size {
        exp.error("Missing array values. Expected amount '" + size + "', but found '" + values.length + "'")
    }

    return vgen_array_init(ctx, values, suggested_type, exp)
}

// Lower `match on [: Type] { case => ... }`.
fn value_from_match_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let on_exp = exp.get(MATCH_EXP.on)
    if !isset(on_exp) : exp.bug("match is missing its input value")
    let body = exp.get(MATCH_EXP.body)
    if !isset(body) : exp.bug("match is missing its body")

    let on = value_from_exp(on_exp, scope, ctx.without_suggested_type()) !>
    let result_type_exp = exp.get(MATCH_EXP.type)
    let result_type: ?Type = null
    if isset(result_type_exp) : result_type = type_from_exp(result_type_exp, scope) !>

    let pos = body.pos
    if !isset(pos) : body.bug("match body is missing a position")
    let p = pos.copy().init_parser()
    let cases = Array[Value]{}
    let found_default = false
    let covered_union_members = Array[Type]{}
    let covered_union_null = false
    let union_type_before_null: ?Exp = null
    let union_type: ?Type = null
    let on_non_nullable = on.rett.get_non_nullable()
    if on_non_nullable.type == TYPE.union : union_type = on_non_nullable
    // A match either has a `default` arm or exhaustively covers a tagged union.
    // In both cases, when every arm ends the path the match does too — which is
    // what lets a function end on one (see parse_func_ast).
    let all_cases_return = true

    while true {
        let t = p.tok(true, true, false) !>
        if t == TOK.end || (t == TOK.sign && p.word_is("}")) {
            if t != TOK.end : p.tok(true, true) !>
            break
        }
        if t == TOK.comment {
            p.tok(true, true) !>
            continue
        }
        if found_default {
            p.error("You cannot define cases after the 'default' case. You should move the 'default' case to the bottom of the list.")
        }

        let cond: ?Value = null
        let bound_name: ?String = null
        let bound_type: ?Type = null
        let bound_tag: ?uint = null
        let is_default = t == TOK.word && p.word_is("default")
        if is_default {
            p.tok(true, true) !>
            found_default = true
        } else {
            // Most type cases are identifiers (`String`, `MyStruct`) and are
            // parsed as ordinary values that resolve to VAL.type. Structural
            // types such as `<MyStruct>` and `[T x N]` start with punctuation,
            // so parse those directly as a type expression here.
            let raw_item_exp: ?Exp = null
            let raw_item: ?Value = null
            if t == TOK.sign && (p.word_is("<") || p.word_is("[") || p.word_is("*") || p.word_is("&")) {
                let type_exp = read_type_exp(p, true, true) !>
                let item_type = type_from_exp(type_exp, scope) !>
                raw_item_exp = type_exp
                raw_item = vgen_type(item_type, ctx.build)
                raw_item.exp = type_exp
            } else {
                let value_exp = read_value_exp(p, true, false) !>
                let is_null_case = value_exp.type == EXP.value && value_exp.kind == VALUE_KIND.null
                let item_ctx = isset(union_type) && !is_null_case ? ctx.without_suggested_type() : ctx.with_suggested_type(on.rett)
                raw_item_exp = value_exp
                raw_item = value_from_exp(value_exp, scope, item_ctx) !>
            }
            let item_exp = raw_item_exp ?! exp.bug("Union match case is missing its expression")
            let item = raw_item ?! exp.bug("Union match case is missing its value")
            let is_null_case = item_exp.type == EXP.value && item_exp.kind == VALUE_KIND.null
            if isset(union_type) && is_null_case {
                if !on.rett.is_nullable_type() {
                    item_exp.error("A non-nullable tagged union cannot match null")
                }
                if covered_union_null : item_exp.error("Duplicate tagged-union null case")
                covered_union_null = true
                cond = vgen_op(on, item, VALUE_OP.eq, type_bool(ctx.build))
                cond.exp = item_exp
            } else if isset(union_type) && item.type == VAL.type {
                if on.rett.is_nullable_type() && !covered_union_null && !isset(union_type_before_null) {
                    union_type_before_null = item_exp
                }
                let member = item.of_type
                if !isset(member) : item_exp.bug("Union match type is missing its represented type")
                let tag = union_type.union_member_index(member)
                if !isset(tag) {
                    item_exp.error("Type '" + member.compat_display_name() + "' is not an alternative of '" + union_type.compat_display_name() + "'")
                }
                each covered_union_members as covered {
                    if type_identity_key(covered) == type_identity_key(member) {
                        item_exp.error("Duplicate tagged-union match case: " + member.compat_display_name())
                    }
                }
                covered_union_members.append(member)
                bound_type = member
                bound_tag = tag
                cond = vgen_union_is(on, member, tag, item_exp)

                let next = p.tok(true, true, false) !>
                if next == TOK.word && p.word_is("as") {
                    p.tok(true, true) !>
                    bound_name = p.read_word(true, true) !>
                }
            } else if isset(union_type) {
                item_exp.error("Tagged unions must be matched by type")
            } else {
                item = value_try_convert(item, scope, ctx, on.rett)
                on.rett.compat_check(item.rett, item_exp) !>
                cond = vgen_op(on, item, VALUE_OP.eq, type_bool(ctx.build))
                cond.exp = item_exp
            }
        }

        p.expect("=>", true, true) !>
        let case_scope = scope.sub_scope()
        let case_prefix = Array[Value]{}
        if isset(bound_name) && bound_name != "_" {
            let member = bound_type ?! exp.bug("Union match binding is missing its type")
            let tag = bound_tag ?! exp.bug("Union match binding is missing its tag")
            if case_scope.has_local(bound_name) : exp.error("Name already used: " + bound_name)
            let decl = Decl.new(member, false, bound_name)
            decl.exp = exp
            case_scope.add_decl(decl)
            case_scope.set_idf(bound_name, Idf.for_decl(decl))
            let extracted = vgen_union_extract(on, member, tag, ctx, exp)
            case_prefix.append(vgen_assign(vgen_decl(decl), extracted, ASSIGN_OP.set, ctx.build, exp))
        }
        let casev = Value {
            type: VAL.block
            value1: cond
            bool_val: is_default
            rett: result_type ?? type_void(ctx.build)
            exp: exp
            values: case_prefix
        }

        if isset(result_type) {
            // A match used as a value produces one; it does not end the path.
            all_cases_return = false
            let value_exp = read_value_exp(p, true, true) !>
            let value = value_from_exp(value_exp, case_scope, ctx.with_suggested_type(result_type)) !>
            value = value_try_convert(value, case_scope, ctx, result_type)
            result_type.compat_check(value.rett, value_exp) !>
            casev.value2 = value
        } else {
            let stmt_exp = read_func_stmt_exp(p) !>
            let state = ParseState.new()
            let value = body_value_from_exp(ctx, case_scope, state, stmt_exp) !>
            if isset(value) : case_prefix.append(value)
            if !case_scope.did_return : all_cases_return = false
        }
        cases.append(casev)
    }

    if cases.length == 0 {
        exp.error("The match statement must have atleast 1 case")
    }
    // An explicit null arm must still precede type arms when there is no
    // default arm. A default arm covers null implicitly, so requiring a
    // duplicate null arm would only add noise to otherwise exhaustive code.
    if !found_default && covered_union_null && isset(union_type_before_null) {
        let null_order = union_type_before_null ?! exp.bug("Union null-order expression is missing")
        null_order.error("The null case must come before type cases when matching a nullable tagged union")
    }
    if !found_default {
        let exhaustive_union = false
        if isset(union_type) {
            let union_members = union_type.sub_types
            if isset(union_members) {
                exhaustive_union = covered_union_members.length == union_members.length
                    && (!on.rett.is_nullable_type() || covered_union_null)
            }
        }
        if !exhaustive_union {
            exp.error("The match statement must have a 'default' case because it does not cover all values")
        }
        // Once every other tag failed, the final covered alternative is
        // guaranteed. Mark it as the IR default to avoid an impossible fallthrough.
        let last = cases.get(cases.length - 1) !? null
        if isset(last) : last.bool_val = true
    }
    if all_cases_return : scope.did_return = true

    return Value {
        type: VAL.match
        value1: on
        values: cases
        rett: result_type ?? type_void(ctx.build)
        exp: exp
    }
}

// Class/struct usable for bare `{ fields }` from the suggested type (`<Struct>`, struct, class).
fn class_from_inline_init_type(t: Type) ?Class {
    let nn = t.get_non_nullable()
    if nn.type == TYPE.inline {
        let sub = nn.sub_type
        if !isset(sub) : return null
        return sub.get_class_or_null()
    }
    // Direct structural type (less common for bare init; named form usually used)
    let c = nn.get_class_or_null()
    if !isset(c) : return null
    if c.kind == CLASS_KIND.struct || c.kind == CLASS_KIND.class : return c
    return null
}

// ---- helpers ----

fn value_from_int_literal(exp: Exp, b: Build) Value !Error {
    let text = exp.str1.replace("_", "")
    let n: int = 0
    if exp.kind == VALUE_KIND.hex {
        n = (text.hex_to_int() ! exp.error("Invalid hex integer: " + exp.str1)).@cast(int)
    } else if exp.kind == VALUE_KIND.octal {
        // Source form is 0c… — strip leading 0c/0C if present for octal_to_int
        let body = text
        if body.starts_with("0c") || body.starts_with("0C") {
            body = body.part(2, body.length - 2)
        }
        n = (body.octal_to_int() ! exp.error("Invalid octal integer: " + exp.str1)).@cast(int)
    } else {
        n = text.to_int() ! exp.error("Invalid integer: " + exp.str1)
    }
    return vgen_int(n, type_int(b))
}

fn value_from_float_literal(exp: Exp, b: Build) Value !Error {
    let text = exp.str1.replace("_", "")
    let n = text.to_float() ! exp.error("Invalid float: " + exp.str1)
    return vgen_float(n, type_float(b) !>)
}

fn value_from_id_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let id = exp.get(VALUE_EXP.left)
    if !isset(id) : exp.bug("Missing id sub-expression")
    let name = id.str1
    let ns_name = id.str2
    let b = ctx.build
    // Optional `Id[T, U]` type arguments (VALUE_EXP.right multi TYPE)
    let gens = exp.get(VALUE_EXP.right)

    // Source-location compile-time values. These are intrinsic identifiers,
    // matching the classic compiler, and therefore resolve before lexical IDs.
    if !isset(ns_name) && (name == "__FILE__" || name == "__DIR__") {
        if isset(gens) : exp.error("Unexpected type arguments on: " + name)
        let path = exp.src.path
        if !isset(path) {
            exp.error("Cannot resolve " + name + " for source without a file path")
        }
        let value = name == "__DIR__" ? fs:dir_of(path) : path
        let v = vgen_string(value, type_string(b))
        v.exp = exp
        return v
    }

    let idf: ?Idf = null
    if isset(ns_name) {
        let ns_idf = scope.get_scope_idf(ns_name)
        if !isset(ns_idf) : exp.error("Unknown namespace: " + ns_name)
        let ns_scope = ns_idf.scope
        if !isset(ns_scope) : exp.bug("Scope idf is missing scope")
        // LSP: `ns:` offers that namespace's members. Runs before the lookup so a
        // half-typed name still completes.
        lsp_complete_scope(exp, ns_scope) !>
        idf = ns_scope.get_idf(name)
        if !isset(idf) : exp.error("Unknown identifier: " + ns_name + ":" + name)
    } else {
        // LSP: everything visible here. Deliberately before the lookup — during
        // completion the name under the cursor is usually a prefix that does not
        // resolve yet, and the client filters the list itself.
        lsp_complete_scope(exp, scope) !>
        idf = scope.get_idf(name)
        // Unresolved ids are allowed here (e.g. other value aliases); later stages resolve
    }

    // LSP: jump to whatever the compiler just decided this name refers to
    if isset(idf) : lsp_goto_idf(exp, idf) !>

    // Locals / arguments → VAL.decl with known type
    if isset(idf) && idf.type == IDF.decl {
        if isset(gens) : exp.error("Unexpected type arguments on variable: " + name)
        let d = idf.decl
        if !isset(d) : exp.bug("Decl idf is missing decl")
        // The one place a variable is reached by the name the user wrote, so also
        // where an unused declaration stops being unused. Compiler-generated
        // references go through vgen_decl directly and do not count.
        d.is_used = true
        if !ctx.is_store_target : d.is_read = true
        let v = vgen_decl(d)
        v.exp = exp
        return v
    }

    // Globals / shared → VAL.global (assignable, typed)
    if isset(idf) && idf.type == IDF.global {
        if isset(gens) : exp.error("Unexpected type arguments on global: " + name)
        let g = idf.global
        if !isset(g) : exp.bug("Global idf is missing global")
        // Stores are checked at the assignment site, where is_assign is known
        act_check(exp, g.act, g.exp, false, "global") !>
        let v = vgen_global(g) !>
        v.exp = exp
        return v
    }

    // Compile-time class-property metadata from `#loop properties`.
    if isset(idf) && idf.type == IDF.property {
        if isset(gens) : exp.error("Unexpected type arguments on property metadata: " + name)
        let prop = idf.prop
        if !isset(prop) : exp.bug("Property idf is missing Prop")
        let runtime_value = idf.value
        let v = Value {
            type: VAL.property_meta
            rett: isset(runtime_value) ? prop.type : type_string(b)
            prop: prop
            value1: runtime_value
            string_val: prop.name ?? ""
            exp: exp
        }
        return v
    }

    // Compile-time constants (macro defs on Build.scope) fold to their Value
    if isset(idf) && idf.type == IDF.value {
        if isset(gens) : exp.error("Unexpected type arguments on value: " + name)
        let bound = idf.value
        if !isset(bound) : exp.bug("Value idf is missing value")
        // String compile definitions are installed during Build.init, before
        // core:String has been parsed, so their stored type is the bootstrap
        // stand-in. At the point of use core is available: expose the value as
        // the canonical String type so normal hooks, methods and compatibility
        // checks see literals and definitions as the same type.
        let bound_type = bound.type == VAL.string
            ? type_string(b)
            : (bound.type == VAL.int ? type_int(b) : bound.rett)
        // Return a shallow copy so we can attach this use's source span
        let v = Value {
            type: bound.type
            rett: bound_type
            exp: exp
            int_val: bound.int_val
            float_val: bound.float_val
            bool_val: bound.bool_val
            string_val: bound.string_val
            name: bound.name
            of_type: bound.of_type
            decl: bound.decl
        }
        return v
    }

    // `value Name (expr)` — evaluate the stored expression in this scope
    if isset(idf) && idf.type == IDF.value_expr {
        if isset(gens) : exp.error("Unexpected type arguments on value: " + name)
        let value_exp = idf.value_exp
        if !isset(value_exp) : exp.bug("Value-expr idf is missing value_exp")
        let value_scope = idf.scope ?? scope
        // Keep the suggested type type so e.g. a null alias can inherit the use-site expectation
        let v = value_from_exp(value_exp, value_scope, ctx) !>
        let suggested_type = ctx.suggested_type
        if isset(suggested_type) {
            v = value_try_convert(v, scope, ctx, suggested_type)
        }
        v.exp = exp
        return v
    }

    // Type identifiers → VAL.type (generic params, concrete classes)
    // rett is String; the actual Type lives in of_type for meta-props like .$is_inline
    if isset(idf) && idf.type == IDF.type {
        let of_type = idf.of_type
        if !isset(of_type) : exp.bug("Type idf is missing of_type")
        // If the bound type is a generic class, allow `T[U]` only when of_type is a class base
        let c = of_type.class
        if isset(gens) {
            if isset(c) && c.is_generic_base {
                let gtypes = value_resolve_type_args(gens, scope) !>
                c = c.specialize(gtypes, exp) !>
                of_type = c.get_type() !>
            } else {
                exp.error("Type is not generic: " + name)
            }
        }
        let v = vgen_type(of_type, b)
        v.exp = exp
        return v
    }
    if isset(idf) && idf.type == IDF.class {
        let c = idf.class
        if isset(c) {
            act_check(exp, c.act, c.exp, false, "class") !>
            if c.is_generic_base {
                if isset(gens) {
                    // Legacy: type args still attached on id (if any)
                    let gtypes = value_resolve_type_args(gens, scope) !>
                    c = c.specialize(gtypes, exp) !>
                } else {
                    // Bare generic base — postfix `Type[T]` specializes via VALUE_KIND.offset.
                    // Cannot call get_type() on an un-specialized base.
                    let v = Value {
                        type: VAL.type
                        class_ref: c
                        name: name
                        rett: type_string(b)
                    }
                    v.exp = exp
                    return v
                }
            } else if isset(gens) {
                exp.error("Type is not generic: " + c.name)
            }
            let of_type = c.get_type() !>
            let v = vgen_type(of_type, b)
            v.exp = exp
            return v
        }
    }

    // Enum type as value: `Enum1` / `Enum2` — `.item` resolves via of_type.enum
    if isset(idf) && idf.type == IDF.enum {
        if isset(gens) : exp.error("Unexpected type arguments on enum: " + name)
        let enu = idf.enum
        if !isset(enu) : exp.bug("Enum idf is missing enum")
        act_check(exp, enu.act, enu.exp, false, "enum") !>
        let of_type = enu.get_type() !>
        let v = vgen_type(of_type, b)
        v.exp = exp
        return v
    }

    // Error type as value: `TestError` — `.code` resolves via of_type.error_type
    if isset(idf) && idf.type == IDF.error_type {
        if isset(gens) : exp.error("Unexpected type arguments on error type: " + name)
        let et = idf.error_type
        if !isset(et) : exp.bug("Error-type idf is missing error_type")
        act_check(exp, et.act, et.exp, false, "error type") !>
        parse_error_type(et) !>
        let v = vgen_type(type_error_code(et), b)
        v.exp = exp
        return v
    }

    // Generic free function: `foo[T]` → specialized Func id
    if isset(idf) && idf.type == IDF.func {
        let f = idf.func
        if isset(f) && f.is_generic_base {
            if !isset(gens) {
                // Leave base for call-site specialization when possible
            } else {
                let gtypes = value_resolve_type_args(gens, scope) !>
                f = f.specialize(gtypes, exp) !>
                idf = Idf.for_func(f)
            }
        } else if isset(gens) {
            exp.error("Function is not generic: " + name)
        }
    } else if isset(gens) {
        exp.error("Unexpected type arguments on: " + name)
    }

    if isset(idf) && idf.type == IDF.func {
        let f = idf.func
        if !isset(f) : exp.bug("Function idf is missing func")
        // Specializations carry the base's act and Exp, so this covers `foo[T]` too
        act_check(exp, f.act, f.exp, false, "function") !>
        let v = vgen_func(f)
        v.exp = exp
        return v
    }
    exp.error("Unknown identifier: " + name)
}

// Resolve multi TYPE_KIND type-argument list from a value id's `[T, U]`.
fn value_resolve_type_args(gens: Exp, scope: Scope) Array[Type] !Error {
    let gtypes = Array[Type]{}
    let i: uint = 0
    while true {
        let g = gens.get(i)
        if !isset(g) : break
        gtypes.append(type_from_exp(g, scope) !>)
        i++
    }
    return gtypes
}

// VAL.type for a value's result type (`typeof(v)` / `v.$type`).
fn value_as_rett_type(on: Value, at: Exp, b: Build) Value !Error {
    return vgen_type(on.rett, b)
}

// `left.name` — type meta, static members, instance methods/getters, or object props.
fn value_from_dot_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let b = ctx.build
    let on_exp = exp.get(VALUE_EXP.left)
    if !isset(on_exp) : exp.bug("Missing dot left value")
    let on = value_from_exp(on_exp, scope, ctx.without_suggested_type()) !>
    let name = exp.str1

    // A property-loop binding uses the ordinary `$` meta API. As a runtime
    // value its String representation is the property's name.
    if on.type == VAL.property_meta {
        let prop = on.prop
        if !isset(prop) : exp.bug("Property metadata value is missing Prop")
        if name == "$type" {
            let v = vgen_type(prop.type, b)
            v.exp = exp
            return v
        }
        if name == "name" {
            let v = vgen_string(prop.name ?? "", type_string(b))
            v.exp = exp
            return v
        }
        if name == "$default_value" {
            let body = prop.default
            if isset(body) {
                let default_exp = parse_body_as_value_exp(body) !>
                let default_scope = prop.class.scope.sub_scope()
                default_scope.func = scope.func
                let v = value_from_exp(default_exp, default_scope, ctx.with_suggested_type(prop.type)) !>
                v = value_try_convert(v, scope, ctx, prop.type)
                prop.type.compat_check(v.rett, default_exp) !>
                v.exp = exp
                return v
            }
            return value_generate_default(prop.type, scope, ctx, exp) !>
        }
        if name == "$has_default_value" {
            let has_default = isset(prop.default) || type_has_generated_default(prop.type, b)
            let v = vgen_bool(has_default, type_bool(b))
            v.exp = exp
            return v
        }
        if name == "$has_explicit_default_value" {
            let v = vgen_bool(isset(prop.default), type_bool(b))
            v.exp = exp
            return v
        }
        if name == "name" || name == "type" || name == "default" {
            exp.error("Property loop values use '$type', '$default_value', '$has_default_value', and '$has_explicit_default_value'; plain '." + name + "' is not supported")
        }
    }

    // `value.group.method` / `Type.group.method`: the preceding dot retains
    // the selected group so this dot resolves within that group's functions.
    let selected_group = on.group
    if isset(selected_group) {
        lsp_complete_group(exp, selected_group) !>
        let f = selected_group.funcs.get(name) !? null
        if isset(f) {
            act_check(exp, f.act, f.exp, false, "function") !>
            lsp_goto(exp, f.exp) !>
            let receiver: ?Value = null
            if !f.is_static {
                receiver = on.value1
                if !isset(receiver) : exp.bug("Instance group member is missing its receiver")
            }
            if f.is_getter {
                let callee = vgen_func(f, receiver)
                callee.exp = exp
                let call = vgen_call(ctx, callee, Array[Value]{}, f.get_rett())
                call.exp = exp
                if f.can_error {
                    call.can_error = true
                    call.error_type = f.error_type
                }
                return call
            }
            let v = vgen_func(f, receiver)
            v.exp = exp
            return v
        }
    }

    // Any value: .$type → VAL.type of its result type (same as typeof)
    if name == "$type" {
        let v = value_as_rett_type(on, exp, b) !>
        v.exp = exp
        return v
    }

    // Globals prefer their declared initializer; other values synthesize a
    // default from their result type.
    if name == "$default_value" {
        return value_from_default_value(on, scope, ctx, exp) !>
    }

    // Compile-time global storage query. This deliberately checks the Value
    // kind rather than its result type: only a global declaration has a
    // statically-known `global` versus `shared` storage class.
    if name == "$is_shared_global" {
        if on.type != VAL.global {
            exp.error("The '$is_shared_global' token can only be used on global values")
        }
        let global = on.global
        if !isset(global) : exp.bug("VAL.global is missing its Global")
        let v = vgen_bool(global.shared, type_bool(b))
        v.exp = exp
        return v
    }

    // Whether `$default_value` can produce a value. This has the same meaning
    // for globals as for all other values: an explicit initializer or a
    // synthesizable type default makes it available.
    if name == "$has_default_value" {
        let default_type = value_default_target_type(on, exp) !>
        let has_default = type_has_generated_default(default_type, b)
        if on.type == VAL.global {
            let global = on.global
            if !isset(global) : exp.bug("VAL.global is missing its Global")
            if isset(global.default_exp) : has_default = true
        }
        let v = vgen_bool(has_default, type_bool(b))
        v.exp = exp
        return v
    }

    // Whether the parsed declaration/property itself supplied an initializer,
    // independent of whether a type-level default can be synthesized.
    if name == "$has_explicit_default_value" {
        let explicit = false
        if on.type == VAL.global {
            let global = on.global
            if !isset(global) : exp.bug("VAL.global is missing its Global")
            explicit = isset(global.default_exp)
        }
        let v = vgen_bool(explicit, type_bool(b))
        v.exp = exp
        return v
    }

    // Compile-time type meta-properties + static members / enum items
    if on.type == VAL.type {
        let folded = value_type_prop(on, name, exp, b) !>
        if isset(folded) {
            folded.exp = exp
            return folded
        }
        // Method-style meta (`T.$can_convert_to`, `$has_method`, …) returns null from
        // value_type_prop so the call site can fold via value_type_method.
        // Never treat `$…` as enum variants (e.g. Array[LT] with T = enum LT).
        if name.starts_with("$") {
            let v = vgen_dot(on, name, type_bool(b))
            v.exp = exp
            return v
        }
        let t = on.of_type
        if isset(t) {
            // Enum member: `Enum1.a`
            let enu = t.enum
            if isset(enu) {
                lsp_complete_enum(exp, enu) !>
                return value_from_enum_item(enu, name, exp, scope, ctx) !>
            }
            // Error code constant: `TestError.err2`
            let et = t.error_type
            if isset(et) {
                lsp_complete_error_codes(exp, et) !>
                return value_from_error_code_item(et, name, exp) !>
            }
            // Static method / member on a class type (modes fall through to wrapped type)
            let c = t.get_class_or_null()
            if isset(c) {
                lsp_complete_class(exp, c) !>
                let f = c.get_func(name)
                if isset(f) {
                    if c.kind == CLASS_KIND.interface && !f.is_static {
                        exp.error("Interface methods require an interface value")
                    }
                    act_check(exp, f.act, f.exp, false, "function") !>
                    lsp_goto(exp, f.exp) !>
                    let v = vgen_func(f)
                    v.exp = exp
                    return v
                }
                let g = c.get_group(name)
                if isset(g) {
                    let v = vgen_dot(on, name, on.rett)
                    v.group = g
                    v.exp = exp
                    return v
                }
            }
        }
        let v = vgen_dot(on, name, type_void(b))
        v.exp = exp
        return v
    }

    // Soft: unresolved left — keep as open dot
    if on.rett.is_void_type() {
        let v = vgen_dot(on, name, type_void(b))
        v.exp = exp
        return v
    }

    // Instance access requires a non-null class value
    // A named union containing `null` is represented by a nullable inline value,
    // but its methods receive that complete value and may handle `null` in a
    // match. Other nullable values still require an isset/?! check first.
    let nullable_union_class = on.rett.get_non_nullable().class
    let declared_union_type: ?Type = isset(nullable_union_class) ? nullable_union_class.type : null
    let nullable_union_receiver = on.rett.is_nullable_type()
        && isset(nullable_union_class)
        && nullable_union_class.kind == CLASS_KIND.union
        && isset(declared_union_type)
        && on.rett == declared_union_type
    let on_nn = nullable_union_receiver ? on : value_try_remove_nullable(on, scope, ctx)
    if on_nn.rett.is_nullable_type() && !nullable_union_receiver {
        exp.error("You cannot access properties/functions on a nullable type: " + on_nn.rett.compat_display_name())
    }

    // Runtime GC state: class_value.$is_shared reads the shared flag stored in
    // the GC header immediately before the object pointer.
    if name == "$is_shared" {
        return value_from_is_shared(on_nn, exp, b) !>
    }

    // Caught-error binding (`E`): `.code` (the actual thrown code), a named code
    // constant (`E.err2`, matching `TypeName.code`), or a payload field (`E.message`).
    let on_et_t = on_nn.rett
    if on_et_t.type == TYPE.error_code && on_et_t.error_is_instance {
        let et = on_et_t.error_type
        if !isset(et) : exp.bug("Error-instance type is missing error_type")
        // LSP: `E.` offers the payload fields and code constants
        lsp_complete_error_codes(exp, et) !>
        if name == "code" {
            if on_nn.type != VAL.decl : exp.bug("Caught error code is not backed by a declaration")
            let decl = on_nn.decl
            if !isset(decl) : exp.bug("Caught error code declaration is missing")
            let v = vgen_decl(decl)
            v.rett = type_error_code(et)
            v.exp = exp
            return v
        }
        let ptype = et.payload.get(name) !? null
        if isset(ptype) {
            let caught_decl = on_nn.decl
            if isset(caught_decl) {
                let payloads = caught_decl.error_payloads
                if isset(payloads) {
                    let payload_decl = payloads.get(name) !? null
                    if isset(payload_decl) {
                        let v = vgen_decl(payload_decl)
                        v.rett = ptype
                        v.exp = exp
                        return v
                    }
                }
            }
            let global = et.payload_globals.get(name) !? null
            if !isset(global) : exp.bug("Error payload global is missing: " + et.name + "." + name)
            let v = vgen_global(global) !>
            v.rett = ptype
            v.exp = exp
            return v
        }
        if et.codes.contains(name) {
            return value_from_error_code_item(et, name, exp) !>
        }
        exp.error("Error type '" + et.name + "' has no payload field or code named: '" + name + "'")
    }

    let on_class = on_nn.rett.get_class_or_null()
    if isset(on_class) {
        // LSP: members of the value on the left of the dot
        lsp_complete_class(exp, on_class) !>

        // Inside a group, an unqualified call on `this` resolves in that group
        // before falling back to the class-level member with the same name.
        // Otherwise `utf8.get()` calling `this.part()` incorrectly selected
        // String.part() instead of String.utf8.part().
        let current_func = ctx.func
        let current_group: ?Group = isset(current_func) ? current_func.group : null
        if isset(current_func) && isset(current_group) && on_nn.type == VAL.decl {
            let receiver_arg = current_func.args.get(0) !? null
            if isset(receiver_arg) && on_nn.decl == receiver_arg.decl {
                let group_func = current_group.funcs.get(name) !? null
                if isset(group_func) {
                    if group_func.is_getter {
                        let callee = vgen_func(group_func, on_nn)
                        callee.exp = exp
                        let call = vgen_call(ctx, callee, Array[Value]{}, group_func.get_rett())
                        call.exp = exp
                        if group_func.can_error {
                            call.can_error = true
                            call.error_type = group_func.error_type
                        }
                        return call
                    }
                    let v = vgen_func(group_func, on_nn)
                    v.exp = exp
                    return v
                }
            }
        }

        // Methods / getters (modes fall through to `mode_for_class`)
        let f = on_class.get_func(name)
        if isset(f) {
            act_check(exp, f.act, f.exp, false, "function") !>
            lsp_goto(exp, f.exp) !>
            if f.is_getter {
                // Getter call with implicit this (no arg list in source)
                let callee = vgen_func(f, on_nn)
                callee.exp = exp
                let call = vgen_call(ctx, callee, Array[Value]{}, f.get_rett())
                call.exp = exp
                if f.can_error {
                    call.can_error = true
                    call.error_type = f.error_type
                }
                return call
            }
            // Bound method reference for a later call.
            let v = vgen_func(f, on_nn)
            v.exp = exp
            return v
        }

        // Properties — assignable VAL.prop (modes fall through to wrapped props)
        let prop = on_class.get_prop_by_name(name) !? null
        if isset(prop) {
            // Read only: a store through this prop is checked at the assignment site
            act_check(exp, prop.act, prop.exp, false, "property") !>
            lsp_goto(exp, prop.exp) !>
            let v = vgen_prop(prop, on_nn, ctx)
            v.exp = exp
            return v
        }

        // Groups: leave as open dot for now (group method calls later)
        let g = on_class.get_group(name)
        if isset(g) {
            let v = vgen_dot(on_nn, name, on_nn.rett)
            v.group = g
            v.exp = exp
            return v
        }
    }

    // Built-in conversion: `.to(Type)` / `.$to(Type)` — folded at the call site.
    // Real methods/props named `to` take precedence (checked above).
    if name == "to" || name == "$to" {
        let v = vgen_dot(on_nn, name, type_void(b))
        v.exp = exp
        return v
    }

    if !isset(on_class) {
        exp.error("Cannot access properties/functions on this type: " + on_nn.rett.compat_display_name())
    }
    exp.error("Type '" + on_class.pretty_name() + "' has no property or method named: '" + name + "'")
}

fn value_from_default_value(on: Value, scope: Scope, ctx: Context, at: Exp) Value !Error {
    let target = value_default_target_type(on, at) !>

    if on.type == VAL.global {
        let global = on.global
        if !isset(global) : at.bug("VAL.global is missing its Global")
        let default_body = global.default_exp
        if isset(default_body) {
            let default_exp = parse_body_as_value_exp(default_body) !>
            // Resolve identifiers at the declaration site while retaining the
            // current function context for generated calls and conversions.
            let default_scope = global.scope.sub_scope()
            default_scope.func = scope.func
            let value = value_from_exp(default_exp, default_scope, ctx.with_suggested_type(target)) !>
            if value.type != VAL.undefined {
                value = value_try_convert(value, scope, ctx, target)
                target.compat_check(value.rett, default_exp) !>
            }
            value.exp = at
            return value
        }
    }

    return value_generate_default(target, scope, ctx, at) !>
}

// A type expression is represented as VAL.type with String as its runtime
// result type. Default meta operations must use the represented Type instead;
// ordinary values continue to use their own result type.
fn value_default_target_type(on: Value, at: Exp) Type !Error {
    if on.type != VAL.type : return on.rett
    let target = on.of_type
    if isset(target) : return target
    let base = on.class_ref
    if isset(base) && base.is_generic_base {
        at.error("Generic type '" + base.pretty_name() + "' requires type arguments before '$default_value'")
    }
    at.bug("Type value is missing its represented type")
}

// Generate the literal zero/default value for a resolved type. Fixed arrays
// recursively default their element type and fill every slot with that value,
// equivalent to source syntax such as `{ null... }`.
fn value_generate_default(target: Type, scope: Scope, ctx: Context, at: Exp) Value !Error {
    let value: ?Value = null
    if target.is_nullable_type() {
        value = vgen_null(target)
    } else if target.is_float_type() {
        value = vgen_float(0, target)
    } else if target.is_integer_type() {
        value = vgen_int(0, target)
    } else if target.is_bool_type() {
        value = vgen_bool(false, target)
    } else if target.type == TYPE.array {
        let sub = target.sub_type
        if !isset(sub) : at.bug("Array type is missing sub_type")
        let values = Array[Value]{}
        let i: u32 = 0
        while i < target.array_size {
            values.append(value_generate_default(sub, scope, ctx, at) !>)
            i++
        }
        value = vgen_array_init(ctx, values, target, at)
    } else {
        let string_class = type_string(ctx.build).get_class_or_null()
        let target_class = target.get_class_or_null()
        if isset(string_class) && target_class == string_class {
            value = vgen_string("", target)
        } else if isset(target_class) {
            let hook = target_class.default_hook
            if isset(hook) {
                if !hook.parsed_types : parse_func_types(hook) !>
                let callee = vgen_func(hook)
                // Materialize the hook's argument defaults through the normal
                // omitted-argument path. This preserves declaration-scope
                // lookup, suggested types, conversions, and argument checks.
                let args = value_from_call_args(callee, hook, null, scope, ctx, at) !>
                value_check_call_args(hook, callee, args, scope, ctx, at) !>
                let call = vgen_call(ctx, callee, args, hook.get_rett())
                call.exp = at
                value = call
            }
        }
    }

    if !isset(value) {
        at.error("Cannot generate a default value for type: " + target.compat_display_name())
    }
    value.exp = at
    return value
}

// Keep `$has_default_value` in lockstep with `value_generate_default` without
// invoking the error-producing generation path merely to test capability.
fn type_has_generated_default(target: Type, b: Build) bool {
    if target.is_nullable_type() : return true
    if target.is_float_type() : return true
    if target.is_integer_type() : return true
    if target.is_bool_type() : return true
    if target.type == TYPE.array {
        let sub = target.sub_type
        return isset(sub) && type_has_generated_default(sub, b)
    }
    let string_class = type_string(b).get_class_or_null()
    let target_class = target.get_class_or_null()
    if isset(string_class) && target_class == string_class : return true
    return isset(target_class) && isset(target_class.default_hook)
}

// `value.$is_shared` — test the shared bit in the GC header.
// This mirrors the classic compiler: flags live at byte offset -4 and bit 2
// (`4`) identifies an object managed by the shared GC.
fn value_from_is_shared(on: Value, at: Exp, b: Build) Value !Error {
    if !on.rett.is_gc_type() {
        at.error("The '$is_shared' token can only be used on 'class' types. Not on: " + on.rett.compat_display_name())
    }
    if on.rett.is_nullable_type() {
        at.error("The '$is_shared' token cannot be used on null-able types. Your type: " + on.rett.compat_display_name())
    }

    let type_u8 = type_from_core(b, "u8") !>
    let offset = vgen_int(-4, type_int(b))
    let flags = vgen_ptrv(on, offset, type_u8, at)
    let shared_bit = vgen_int(4, type_u8)
    let mask = vgen_op(flags, shared_bit, VALUE_OP.bit_and, type_u8)
    mask.exp = at
    let cmp = vgen_op(mask, vgen_int(4, type_u8), VALUE_OP.eq, type_bool(b))
    cmp.exp = at
    return cmp
}

// `.code` / `TypeName.code` / `E.name` — a named, payload-less error code constant.
fn value_from_error_code_item(et: ErrorType, name: String, at: Exp) Value !Error {
    if !et.codes.contains(name) {
        at.error("Error type '" + et.name + "' does not have an error code named: '" + name + "'")
    }
    return Value {
        type: VAL.error_value
        string_val: name
        rett: type_error_code(et)
        exp: at
    }
}

// `throw .code { field: value, ... }` — payload construction. `left_exp` is the
// VALUE_KIND.error_code operand of the class-init (`{ ... }` is the field body).
// Only the bare `.code` form is supported here (qualified `TypeName.code { ... }` isn't
// used anywhere in practice — qualified codes are only ever thrown without a payload).
fn value_from_error_payload_init_exp(exp: Exp, scope: Scope, ctx: Context, left_exp: Exp) Value !Error {
    let func = ctx.get_func() !>
    let et = func.error_type
    if !isset(et) : left_exp.error("Throwing an error but your function has no error type")
    let name = left_exp.str1
    if !et.codes.contains(name) {
        left_exp.error("Error type '" + et.name + "' does not have an error code named: '" + name + "'")
    }

    let body = exp.get(VALUE_EXP.right)
    if !isset(body) : exp.bug("Error payload init is missing body")
    if body.type != EXP.body : exp.bug("Error payload init body must be EXP.body")

    let items_exp = parse_body_as_class_init_fields(body) !>
    let values = Array[Value]{}
    let i: uint = 0
    while true {
        let item = items_exp.get(i)
        if !isset(item) : break
        let ik = item.number.@cast(CLASS_INIT_ITEM)
        if ik != CLASS_INIT_ITEM.field {
            item.error("Error payload fields must be named (e.g. 'field: value')")
        }
        let fname = item.str1
        let ftype = et.payload.get(fname) !? null
        if !isset(ftype) {
            item.error("Error type '" + et.name + "' has no payload field named: '" + fname + "'")
        }
        let vexp = item.get(VALUE_EXP.left)
        if !isset(vexp) : item.bug("Payload field is missing a value")
        let fv = value_from_exp(vexp, scope, ctx.with_suggested_type(ftype)) !>
        if fv.type != VAL.undefined {
            fv = value_try_convert(fv, scope, ctx, ftype)
            ftype.compat_check(fv.rett, item) !>
        }
        fv.name = fname
        values.append(fv)
        i++
    }

    let result = Value {
        type: VAL.error_value
        string_val: name
        values: values
        rett: type_error_code(et)
        exp: exp
    }
    value_complete_error_payload(result, scope, ctx, exp) !>
    return result
}

// Fill payload fields omitted by a throw:
// 1. Fields already on a compatible caught `E` are passed through.
// 2. Fields with an explicit payload default (`name: Type (value)`) use that default.
// 3. Everything else is a compile error.
// Language-generated defaults (empty string / zero / null) are only applied when
// *passing* an error to a wider type (`!>` / `ir_default_pass_payloads`).
fn value_complete_error_payload(value: Value, scope: Scope, ctx: Context, at: Exp) !Error {
    let et = value.rett.get_non_nullable().error_type
    if !isset(et) : at.error("This is not an error value")
    if et.payload.length == 0 : return

    let values = value.values ?? Array[Value]{}
    value.values = values
    let provided = Map[bool]{}
    each values as field : provided.set(field.name, true)

    let caught_type: ?ErrorType = null
    let caught_decl: ?Decl = null
    let eidf = scope.get_idf("E")
    if isset(eidf) {
        let decl = eidf.decl
        if isset(decl) {
            caught_decl = decl
            caught_type = decl.type.get_non_nullable().error_type
        }
    }

    each et.payload as ptype, name {
        if provided.has(name) : continue
        if isset(caught_type) && et.is_compat(caught_type) && caught_type.payload.has(name) {
            let payloads: ?Map[Decl] = null
            if isset(caught_decl) : payloads = caught_decl.error_payloads
            if isset(payloads) {
                let payload_decl = payloads.get(name) !? null
                if isset(payload_decl) {
                    let inherited = vgen_decl(payload_decl)
                    inherited.rett = ptype
                    inherited.name = name
                    values.append(inherited)
                    continue
                }
            }
        }
        let default_body = et.payload_defaults.get(name) !? null
        if isset(default_body) {
            let fallback = value_from_error_payload_default(et, name, ptype, default_body, scope, ctx, at) !>
            values.append(fallback)
            continue
        }
        at.error("Missing error payload field '" + name + "' for " + et.name + ". Provide it in the throw, give it a default in the error payload, or pass the error with '!>'.")
    }
}

// Evaluate an explicit payload field default declared as `name: Type ( ... )`.
// Identifiers resolve at the error-type declaration site; the current function
// context is kept for generated calls and conversions (same as prop/global defaults).
fn value_from_error_payload_default(et: ErrorType, name: String, ptype: Type, default_body: Exp, scope: Scope, ctx: Context, at: Exp) Value !Error {
    let default_exp = parse_body_as_value_exp(default_body) !>
    let default_scope = et.scope.sub_scope()
    default_scope.func = scope.func
    let fallback = value_from_exp(default_exp, default_scope, ctx.with_suggested_type(ptype)) !>
    if fallback.type != VAL.undefined {
        fallback = value_try_convert(fallback, scope, ctx, ptype)
        ptype.compat_check(fallback.rett, default_exp) !>
    }
    fallback.name = name
    fallback.exp = at
    return fallback
}

// `EnumName.item` — resolve the variant to a typed constant value.
fn value_from_enum_item(enu: Enum, name: String, at: Exp, scope: Scope, ctx: Context) Value !Error {
    let item: ?EnumItem = null
    each enu.items as it {
        if it.name == name {
            item = it
            break
        }
    }
    if !isset(item) {
        at.error("Enum " + enu.name + " does not have a value named: '" + name + "'")
    }

    let etype = enu.get_type() !>
    let value_body = item.value
    if isset(value_body) {
        // Explicit `(value)` — parse as a value expression with enum type suggestion
        let pos = value_body.pos
        if !isset(pos) : value_body.bug("Enum item value is missing a Pos")
        let p = pos.copy().init_parser()
        let vexp = read_value_exp(p, true, true) !>
        let v = value_from_exp(vexp, enu.scope, ctx.with_suggested_type(etype)) !>
        v = value_try_convert(v, enu.scope, ctx, etype)
        // Tag result type as this enum
        v.rett = etype
        v.exp = at
        return v
    }

    // Implicit integer ordinal: first free ints skipping explicit values (old parse_enum_type)
    let used = Map[bool]{}
    each enu.items as it {
        let vb = it.value
        if !isset(vb) : continue
        // Only pre-scan integer literals for occupancy; full eval is deferred
        let pos = vb.pos
        if !isset(pos) : continue
        let p = pos.copy().init_parser()
        let t = p.tok(true, true, false) !>
        if t == TOK.int || t == TOK.hex || t == TOK.octal {
            let vexp = read_value_exp(p, true, true) !>
            let lit = value_from_exp(vexp, enu.scope, ctx.with_suggested_type(type_int(ctx.build))) !>
            if lit.type == VAL.int {
                used.set("" + lit.int_val, true)
            }
        }
    }
    let i: int = 0
    each enu.items as it {
        if it.name == name {
            while used.has("" + i) {
                i++
            }
            let v = vgen_int(i, etype)
            v.exp = at
            return v
        }
        if !isset(it.value) {
            while used.has("" + i) {
                i++
            }
            used.set("" + i, true)
            i++
        }
    }
    at.bug("Enum item not found after scan: " + name)
}

// Pure meta-properties on VAL.type (`T.$is_inline` → bool, `T.$notnull` → VAL.type).
// Returns null for method-style meta that must be folded at the call site.
fn value_type_prop(on: Value, name: String, at: Exp, b: Build) ?Value !Error {
    let t = on.of_type
    if !isset(t) : at.bug("VAL.type is missing of_type")

    // Type-returning
    if name == "$notnull" {
        return vgen_type(t.get_non_nullable(), b)
    }

    // Integer: same as size_of(T)
    if name == "$size" {
        let bytes = t.size() !>
        return vgen_int(bytes.to(int), type_int(b))
    }

    // Bool queries
    if name == "$is_inline" : return vgen_bool(t.is_meta_inline_type(), type_bool(b))
    if name == "$is_nullable" : return vgen_bool(t.is_nullable_type(), type_bool(b))
    if name == "$is_void" : return vgen_bool(t.is_void_type(), type_bool(b))
    if name == "$is_integer" : return vgen_bool(t.is_integer_type(), type_bool(b))
    if name == "$is_float" : return vgen_bool(t.is_float_type(), type_bool(b))
    if name == "$is_bool" : return vgen_bool(t.is_bool_type(), type_bool(b))
    if name == "$is_signed" : return vgen_bool(t.is_signed_type(), type_bool(b))
    if name == "$is_structural" : return vgen_bool(t.is_structural_type(), type_bool(b))
    if name == "$is_gc" : return vgen_bool(t.is_gc_type(), type_bool(b))
    if name == "$has_gc_refs" : return vgen_bool(t.has_gc_refs(), type_bool(b))
    if name == "$is_pointer" : return vgen_bool(t.is_pointer_type(), type_bool(b))
    if name == "$is_raw_pointer" : return vgen_bool(t.is_raw_pointer_type(), type_bool(b))
    if name == "$has_vtable" : return vgen_bool(t.has_vtable(), type_bool(b))

    // Method-style meta: keep as `.name` so `.(args)` folds via value_type_method
    if name == "$can_convert_to" : return null
    if name == "$is_type_of" : return null
    if name == "$has_method" : return null
    if name == "$is_compatible_with" : return null

    // Unknown `$…` meta on a type
    if name.starts_with("$") {
        at.error("Unknown type property: '" + name + "'")
    }
    // Normal name (e.g. static method `Node.tree`) — not a type meta-prop
    return null
}

// Type meta-method calls: T.$can_convert_to(U) / T.$is_type_of(U) / T.$has_method(name) / …
fn value_type_method(on: Value, name: String, args: Array[Value], at: Exp, b: Build) Value !Error {
    let t = on.of_type
    if !isset(t) : at.bug("VAL.type is missing of_type")

    if name == "$can_convert_to" {
        if args.length != 1 {
            at.error("'.$can_convert_to' expects 1 type argument, got " + args.length)
        }
        // Other type optional: unresolved → false (conversion hooks not ready)
        let other = (args.get(0) ! at.bug("Missing $can_convert_to arg")).as_type()
        if !isset(other) : return vgen_bool(false, type_bool(b))
        return vgen_bool(t.can_convert_to(other), type_bool(b))
    }

    if name == "$is_type_of" {
        if args.length != 1 {
            at.error("'.$is_type_of' expects 1 type argument, got " + args.length)
        }
        let other = (args.get(0) ! at.bug("Missing $is_type_of arg")).as_type()
        if !isset(other) : return vgen_bool(false, type_bool(b))
        return vgen_bool(t.is_type_of_class(other), type_bool(b))
    }

    if name == "$is_compatible_with" {
        if args.length != 1 {
            at.error("'.$is_compatible_with' expects 1 type argument, got " + args.length)
        }
        let other = (args.get(0) ! at.bug("Missing $is_compatible_with arg")).as_type()
        if !isset(other) : return vgen_bool(false, type_bool(b))
        return vgen_bool(t.is_compatible_with(other), type_bool(b))
    }

    if name == "$has_method" {
        if args.length != 1 {
            at.error("'.$has_method' expects 1 name argument, got " + args.length)
        }
        let mname = (args.get(0) ! at.bug("Missing $has_method arg")).as_name()
        if !isset(mname) : return vgen_bool(false, type_bool(b))
        return vgen_bool(t.has_method(mname), type_bool(b))
    }

    at.error("Unknown type method: '" + name + "'")
}

// Fold a binary op when both sides are compile-time constants. Returns null if not foldable.
fn value_try_fold_op(left: Value, right: Value, op: VALUE_OP, b: Build) ?Value {
    if op == VALUE_OP.and {
        if left.type == VAL.bool && right.type == VAL.bool {
            return vgen_bool(left.bool_val && right.bool_val, type_bool(b))
        }
        return null
    }
    if op == VALUE_OP.or {
        if left.type == VAL.bool && right.type == VAL.bool {
            return vgen_bool(left.bool_val || right.bool_val, type_bool(b))
        }
        return null
    }

    if op == VALUE_OP.eq || op == VALUE_OP.ne {
        // String-ish compare (macro defs, bare words like `win` in `OS == win`)
        let ls = left.fold_string()
        let rs = right.fold_string()
        if isset(ls) && isset(rs) {
            let eq = ls == rs
            return vgen_bool(op == VALUE_OP.eq ? eq : !eq, type_bool(b))
        }
        // Integer compare
        if left.type == VAL.int && right.type == VAL.int {
            let eq = left.int_val == right.int_val
            return vgen_bool(op == VALUE_OP.eq ? eq : !eq, type_bool(b))
        }
        // Bool compare
        if left.type == VAL.bool && right.type == VAL.bool {
            let eq = left.bool_val == right.bool_val
            return vgen_bool(op == VALUE_OP.eq ? eq : !eq, type_bool(b))
        }
        return null
    }

    if op == VALUE_OP.lt || op == VALUE_OP.gt || op == VALUE_OP.lte || op == VALUE_OP.gte {
        if left.type == VAL.int && right.type == VAL.int {
            let ok = false
            if op == VALUE_OP.lt : ok = left.int_val < right.int_val
            else if op == VALUE_OP.gt : ok = left.int_val > right.int_val
            else if op == VALUE_OP.lte : ok = left.int_val <= right.int_val
            else : ok = left.int_val >= right.int_val
            return vgen_bool(ok, type_bool(b))
        }
        return null
    }

    if left.type == VAL.int && right.type == VAL.int {
        let l = left.int_val
        let r = right.int_val
        if op == VALUE_OP.add : return vgen_int(l + r, left.rett)
        if op == VALUE_OP.sub : return vgen_int(l - r, left.rett)
        if op == VALUE_OP.mul : return vgen_int(l * r, left.rett)
        if op == VALUE_OP.div && r != 0 : return vgen_int(l / r, left.rett)
        if op == VALUE_OP.mod && r != 0 : return vgen_int(l % r, left.rett)
        if op == VALUE_OP.bit_and : return vgen_int(l & r, left.rett)
        if op == VALUE_OP.bit_or : return vgen_int(l | r, left.rett)
        if op == VALUE_OP.bit_xor : return vgen_int(l ^ r, left.rett)
        if op == VALUE_OP.shl : return vgen_int(l << r, left.rett)
        if op == VALUE_OP.shr : return vgen_int(l >> r, left.rett)
    }

    return null
}

// ---- Operator / call type checks ----

// Ensure left/right operand types are compatible for `op`.
// Skips when either side is still void (incomplete / unresolved).
// - && / || : both bool
// - compare / arithmetic / bitwise : right must be assignable to left's type
fn value_check_op_compat(left: Value, right: Value, op: VALUE_OP, at: Exp) !Error {
    let lt = left.rett
    let rt = right.rett
    if lt.is_void_type() || rt.is_void_type() : return

    if op == VALUE_OP.and || op == VALUE_OP.or {
        if !lt.is_bool_type() {
            at.error("Left operand of logical operator must be bool")
        }
        if !rt.is_bool_type() {
            at.error("Right operand of logical operator must be bool")
        }
        return
    }

    // Compare and arithmetic/bitwise: operands must be compatible
    // (old: l.rett.compat_check(r.rett) — expected left, got right)
    if !lt.compat(rt) {
        if op == VALUE_OP.eq || op == VALUE_OP.ne || op == VALUE_OP.lt || op == VALUE_OP.gt || op == VALUE_OP.lte || op == VALUE_OP.gte {
            if rt.compat(lt) : return
        }
        lt.compat_check(rt, at) !>
    }
}

// Check call arity and each argument against Func.args.
// Skips implicit `this` for instance methods (receiver is not in `args`).
// Applies `value_try_convert` in place (int literals → i32, etc.) then compat_check.
// Soft: void rett on an arg means incomplete typing — that slot is not checked.
fn value_check_call_args(func: Func, callee: Value, args: Array[Value], scope: Scope, ctx: Context, at: Exp) !Error {
    // Ensure signature types are resolved
    if !func.parsed_types {
        parse_func_types(func) !>
    }

    let params = func.args
    // Instance methods have `this` as first arg; call args are the remaining ones
    let skip: uint = 0
    if isset(func.class) && !func.is_static {
        let on = callee.value1
        if isset(on) && on.type != VAL.type {
            skip = 1
        }
    }

    let max_params = params.length > skip ? params.length - skip : 0

    // Required positional width ends at the final parameter without a default.
    // A default in the middle still needs `_` when a later required arg is supplied.
    let required: uint = 0
    let pi: uint = skip
    while pi < params.length {
        let p = params.get(pi) ! break
        if !isset(p.default) : required = (pi - skip) + 1
        pi++
    }

    if args.length < required {
        at.error("Not enough arguments for '" + func.name + "' (expected at least " + required + ", got " + args.length + ")")
    }
    if !func.infinite_args && args.length > max_params {
        at.error("Too many arguments for '" + func.name + "' (expected at most " + max_params + ", got " + args.length + ")")
    }

    let i: uint = 0
    while i < args.length {
        let param_i = skip + i
        let param: ?Arg = null
        if param_i < params.length {
            param = params.get(param_i) !? null
        } else if func.infinite_args && params.length > 0 {
            param = params.get(params.length - 1) !? null
        }
        if !isset(param) : break

        let av = args.get(i) ! break
        if !param.is_generic {
            // Convert first (literal int → i32, nullable strip, $to hooks, …)
            av = value_try_convert(av, scope, ctx, param.type)
            args.set(i, av) ! at.bug("value_check_call_args: args.set out of range")
            let avt = av.rett
            if !avt.is_void_type() {
                // Nullable arguments require a flow proof before passing to a
                // non-nullable parameter. Type.compat intentionally remains
                // representation-oriented, so enforce this safety rule here.
                if !param.type.is_nullable_type() && avt.is_nullable_type() {
                    let proven = false
                    if av.type == VAL.decl {
                        let d = av.decl
                        if isset(d) : proven = scope.not_null_check_relied(d)
                    }
                    if !proven : at.error("Incompatible types. Expected '" + param.type.compat_display_name() + "', got '" + avt.compat_display_name() + "'")
                }
                param.type.compat_check(avt, at) !>
            }
        }
        i++
    }
}

// Strip surrounding quotes from a string/char token (keeps escapes as written).
fn strip_quotes(s: String) String {
    if s.length >= 2 {
        let first = s.get(0)
        let last = s.get(s.length - 1)
        if (first == '"' && last == '"') || (first == '\'' && last == '\'') {
            return s.part(1, s.length - 2)
        }
    }
    return s
}

// Parse ordinary string interpolation (`%name` / `%{ expression }`) and lower it
// through the normal String `$add` hook. Raw strings deliberately bypass both
// interpolation and escape processing.
fn value_from_string_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let string_type = type_string(ctx.build)
    let inner = strip_quotes(exp.str1)
    if exp.bool1 || !inner.contains("%") {
        let text = exp.bool1 ? inner : inner.unescape()
        let v = vgen_string(text, string_type)
        v.exp = exp
        return v
    }

    let result = vgen_string("", string_type)
    result.exp = exp
    let literal_start: uint = 0
    let i: uint = 0
    while i < inner.length {
        if inner.get(i) == '\\' && i + 1 < inner.length {
            i += 2
            continue
        }
        if inner.get(i) != '%' {
            i++
            continue
        }

        let marker = i
        let expr_start = i + 1
        let expr_end = expr_start
        if expr_start >= inner.length {
            i++
            continue
        }

        if inner.get(expr_start) == '{' {
            expr_start++
            expr_end = expr_start
            let depth: uint = 1
            while expr_end < inner.length && depth > 0 {
                let ch = inner.get(expr_end)
                if ch == '{' : depth++
                else if ch == '}' : depth--
                if depth > 0 : expr_end++
            }
            if depth != 0 : exp.error("Missing '}' in string interpolation")
        } else {
            let ch = inner.get(expr_end)
            if !ch.is_alpha() && ch != '_' {
                i++
                continue
            }
            expr_end++
            while expr_end < inner.length {
                let next = inner.get(expr_end)
                if !next.is_alpha() && !next.is_number() && next != '_' : break
                expr_end++
            }
        }

        if marker > literal_start {
            let literal = inner.part(literal_start, marker - literal_start).unescape()
            let added = value_try_add_hook(result, vgen_string(literal, string_type), scope, ctx, exp) !>
            if !isset(added) : exp.bug("String does not have a compatible '$add' hook")
            result = added
        }

        let expression = inner.part(expr_start, expr_end - expr_start)
        // Where this expression starts in the file: the literal's own offset, past
        // the opening quote when strip_quotes removed one, plus the offset within
        // the literal's content. Diagnostics resolve through this (see Message.print).
        let quote_len: u32 = exp.str1.length > inner.length ? 1 : 0
        let source = Source {
            build: ctx.build
            content: expression
            path: exp.src.path
            parent: exp.src
            parent_offset: exp.i + quote_len + expr_start.to(u32)
            ns: exp.src.ns
            id: exp.src.id
            ignore_access: exp.src.ignore_access
        }
        let parser = source.start().init_parser()
        let value_exp = read_value_exp(parser, true, true) !>
        let part = value_from_exp(value_exp, scope, ctx.without_suggested_type()) !>
        part = value_try_convert(part, scope, ctx, string_type)
        string_type.compat_check(part.rett, exp) !>
        let added = value_try_add_hook(result, part, scope, ctx, exp) !>
        if !isset(added) : exp.bug("String does not have a compatible '$add' hook")
        result = added

        if inner.get(expr_start - 1) == '{' {
            i = expr_end + 1
        } else {
            i = expr_end
        }
        literal_start = i
    }

    if literal_start < inner.length {
        let literal = inner.part(literal_start, inner.length - literal_start).unescape()
        let added = value_try_add_hook(result, vgen_string(literal, string_type), scope, ctx, exp) !>
        if !isset(added) : exp.bug("String does not have a compatible '$add' hook")
        result = added
    }
    result.exp = exp
    return result
}

// Best-effort single-byte value from a char token like 'a' or '\n'.
fn char_literal_byte(s: String) int {
    let inner = strip_quotes(s)
    if inner.length == 0 : return 0
    if inner.get(0) == '\\' && inner.length >= 2 {
        let e = inner.get(1)
        if e == 'n' : return '\n'
        if e == 't' : return '\t'
        if e == 'r' : return '\r'
        if e == 'b' : return 8
        if e == 'f' : return 12
        if e == 'a' : return 7
        if e == 'v' : return 11
        if e == '0' : return 0
        if e == '\\' : return '\\'
        if e == '\'' : return '\''
        if e == '"' : return '"'
        return e
    }
    return inner.get(0)
}

use helper
use valk.fs


enum CALL_KIND : u8 {
    direct
    closure
    interface_dispatch
}

enum VAL : u8 {
    undefined
    int
    float
    bool
    string
    null
    func     // resolved function reference; value1 = optional bound receiver
    interface_wrap
    is_a
    interface_object
    member   // resolved receiver + builtin/meta member name
    decl     // local / argument variable (Decl)
    prop     // object property access; value1 = receiver; prop = Prop
    global   // global / shared variable (Global)
    property_meta // compile-time Prop value bound by #loop properties
    type     // compile-time type value (of_type); rett is String; props like .$is_inline
    op       // binary op (VALUE_OP in .op); left/right in value1/value2
    unary    // unary op (VALUE_OP in .op); operand in value1
    call     // callee in value1; args in values; CALL_KIND in op
    error_success
    cast     // value.@cast(Type); value1 = on, rett = target Type
    multi    // argument list only (values array); not a runtime value alone
    class_init
    // Fixed-array construction: { v0, v1, ... } — values = elements; rett = array type
    // bool_val: the last element repeats to fill the length (`v...`)
    array_init
    match
    // Element access / @ptrv: value1 = base, value2 = index; rett = element type
    ptrv
    // Raw pointer byte offset: value1 = pointer, value2 = signed byte offset
    ptr_offset
    // @ref(lvalue): value1 = address-of target; rett = ptr
    ptr_of
    // Load/copy an inline value through ptr/ref; value1 = pointer, rett = inline type
    load
    // cond ? a : b  /  a ?? b  — value1=cond (or isset), value2=then, values=[else]
    this_or_that
    // isset(v) — value1=operand; rett=bool; may set .issets
    isset
    // Type-only wrap (nullable strip/add); value1=inner
    wrap
    // Read-only shared view; value1=ordinary class value, published to shared GC
    shared_view
    // Atomic read/modify/write primitives. atomic_op stores VALUE_OP in `.op`.
    atomic_op
    atomic_store
    atomic_load
    atomic_cas
    // Raw memory copy: values = [source ptr, destination ptr, byte length].
    memcpy
    // A CPU-level builtin such as $leading_zeros; the string holds its name
    intrinsic
    error_handler
    // `co <call>` — value1 = the launched call; rett = TYPE.co wrapping its return/error
    co
    await
    // ---- Function-body / control-flow values (typically rett = void) ----
    assign   // lvalue op= rvalue; op = ASSIGN_OP
    if       // value1=cond; values=then body; value2=else block (optional VAL.block)
    while    // value1=cond; values=body
    block    // sequential values (nested `{ ... }` or then/else body)
    return   // value1=optional return value
    throw    // value1=thrown value
    break
    continue
    // $entrance-only marker: emit the function's collected stack allocations here.
    allocas
    init_allocators
    // Execute the function's runtime stack of deferred closures in LIFO order.
    run_defers
    // `lock` block: value1 = acquire prelude, value2 = release call, values = body
    lock_block
    ir_comment
    // Value scope `<{...}`: values = body statements; value1 = phi of return values
    vscope
    // Phi of multiple control-flow values (vscope returns, …); values = arms
    phi
}

class ValueMeta {
    name: String ("")
    string_val: String ("")
    allocator: ?Allocator (null)
    group: ?Group (null)
    class_ref: ?Class (null)
    of_type: ?Type (null)
    issets: ?Array[Decl] (null)
    not_issets: ?Array[Decl] (null)
    error_type: ?ErrorType (null)
    pre_value: ?Value (null)
    checked_read: ?Value (null)
    // Original graph before lowering into temporary storage.
    graph_source: ?Value (null)
    // An Array element read out by value: writes into it are lost
    copied_element: bool (false)
    // Inline storage a call returned; a write into it is lost
    call_result_copy: bool (false)
    // An element read through a read-only borrow: its slot may not be written
    readonly_element: bool (false)
    init_prop: ?Prop (null)
    implicit_borrow: bool (false)
    reads_storage: bool (false)
    // A struct receiver borrowed out of a closure's captured copy
    captured_receiver: ?Decl (null)
    // An argument for a `local` parameter that may be frame storage
    lent_local: bool (false)
    // Locked plain data lent to a `local` parameter: a `local` result stays under the lock
    lent_locked: bool (false)
    // An element of a sequence's storage, for the IR's alias tags
    element_slot: bool (false)
    // A bounds-checked borrow slot whose GEP is inbounds (without element TBAA)
    inbounds_slot: bool (false)
}

class Value {
    type: VAL
    rett: Type
    // Source expression (for errors / spans)
    exp: ?Exp (null)
    // Children
    value1: ?Value (null)
    value2: ?Value (null)
    values: ?Array[Value] (null)
    op: u8 (0)
    // Typed views of `op`, one per VAL family
    get value_op: VALUE_OP $inline { return this.op.@cast(VALUE_OP) }
    get assign_op: ASSIGN_OP $inline { return this.op.@cast(ASSIGN_OP) }
    get call_kind: CALL_KIND $inline { return this.op.@cast(CALL_KIND) }
    get errh_kind: ERRH_KIND $inline { return this.op.@cast(ERRH_KIND) }
    // Typed views of overloaded child slots
    get cond: ?Value $inline { return this.value1 }
    get then_body: ?Array[Value] $inline { return this.values }
    get else_body: ?Value $inline { return this.value2 }
    get lhs: ?Value $inline { return this.value1 }
    get rhs: ?Value $inline { return this.value2 }
    get callee: ?Value $inline { return this.value1 }
    get call_args: ?Array[Value] $inline { return this.values }
    // Literal payloads
    int_val: int (0)
    float_val: f64 (0)
    bool_val: bool (false)
    meta: ?ValueMeta (null)
    // VAL.decl — single decl reference
    decl: ?Decl (null)
    // VAL.prop — object field (`on.prop`); receiver is value1
    prop: ?Prop (null)
    // VAL.global — global / shared storage
    global: ?Global (null)
    // VAL.func — resolved function declaration
    func: ?Func (null)
    // Fallible call metadata (before error handler trims it)
    can_error: bool (false)
    never_returns: bool (false)
    // Regions: the number of an object, call or loop in the facts of its function
    region_id: u32 (0)

    fn require_result() !Error {
        if this.rett.is_void_type() && !this.never_returns && this.type != VAL.undefined {
            if this.type == VAL.match {
                this.error("A 'match' gives a value only with the type after its subject, like 'match x : String { ... }'")
            }
            // `x ! { ... }` whose block carries on has no value on the error path
            let call = this.get_pre_value()
            if this.type == VAL.error_handler && this.op == ERRH_KIND.block.to(u8) && isset(call) && !call.rett.is_void_type() {
                let handler = this.value2
                let at = isset(handler) ? handler.exp ?? this.exp : this.exp
                if isset(at) : at.error("This error handler carries on, so there is no value when the call fails: end it with 'return', 'throw', 'break', 'continue' or a panic, or give a default with '!? value'")
            }
            this.error("A void expression does not produce a value")
        }
        if this.type == VAL.member && this.bool_val {
            let on = this.value1
            let union_t = isset(on) ? on.get_of_type() : null
            let c = isset(union_t) ? union_t.get_class_or_null() : null
            let variant = isset(c) ? c.get_union_variant(this.get_name()) : null
            if isset(c) && isset(variant) {
                this.error("Variant '" + c.pretty_name() + "." + variant.name + "' expects " + variant.payload_types.length + " payload argument(s)")
            }
        }
        if this.type == VAL.func {
            let f = this.func
            if isset(f) && (f.is_generic_base || f.has_generic_args) {
                this.error(value_generic_base_message(f))
            }
        }
        if this.type == VAL.type {
            this.error("A type is not a value; use it with a compile-time member such as 'Type.$default_value'")
        }
    }

    fn get_graph_source() ?Value {
        let data = this.meta
        return isset(data) ? data.graph_source : null
    }
    fn set_graph_source(value: Value) { this.ensure_meta().graph_source = value }

    fn reads_storage() bool {
        let data = this.meta
        return isset(data) && data.reads_storage
    }
    fn set_reads_storage() {
        this.ensure_meta().reads_storage = true
    }

    fn ensure_meta() ValueMeta $inline {
        let data = this.meta
        if isset(data) : return data
        let created = ValueMeta {}
        this.meta = created
        return created
    }

    fn get_name() String $inline {
        let data = this.meta
        if isset(data) && data.name != "" : return data.name
        let t = this.type
        if t == VAL.func {
            let func = this.func
            if isset(func) : return func.name
        } else if t == VAL.decl {
            let decl = this.decl
            if isset(decl) : return decl.name ?? ""
        } else if t == VAL.prop || t == VAL.property_meta {
            let prop = this.prop
            if isset(prop) : return prop.name ?? ""
        } else if t == VAL.global {
            let global = this.global
            if isset(global) : return global.name
        }
        return ""
    }

    fn set_name(name: String) $inline { this.ensure_meta().name = name }
    fn get_init_prop() ?Prop $inline {
        let data = this.meta
        return isset(data) ? data.init_prop : null
    }
    fn set_init_prop(prop: Prop) $inline { this.ensure_meta().init_prop = prop }
    fn get_string() String $inline {
        let data = this.meta
        return isset(data) ? data.string_val : ""
    }
    fn set_string(value: String) $inline { this.ensure_meta().string_val = value }
    fn get_allocator() ?Allocator $inline {
        let data = this.meta
        return isset(data) ? data.allocator : null
    }
    fn set_allocator(value: ?Allocator) $inline { this.ensure_meta().allocator = value }
    fn get_group() ?Group $inline {
        let data = this.meta
        return isset(data) ? data.group : null
    }
    fn set_group(value: ?Group) $inline { this.ensure_meta().group = value }
    fn get_class_ref() ?Class $inline {
        let data = this.meta
        return isset(data) ? data.class_ref : null
    }
    fn set_class_ref(value: ?Class) $inline { this.ensure_meta().class_ref = value }
    fn get_of_type() ?Type $inline {
        let data = this.meta
        return isset(data) ? data.of_type : null
    }
    fn set_of_type(value: ?Type) $inline { this.ensure_meta().of_type = value }
    fn get_issets() ?Array[Decl] $inline {
        let data = this.meta
        return isset(data) ? data.issets : null
    }
    fn set_issets(value: ?Array[Decl]) $inline { this.ensure_meta().issets = value }
    fn get_not_issets() ?Array[Decl] $inline {
        let data = this.meta
        return isset(data) ? data.not_issets : null
    }
    fn set_not_issets(value: ?Array[Decl]) $inline { this.ensure_meta().not_issets = value }
    fn get_error_type() ?ErrorType $inline {
        let data = this.meta
        return isset(data) ? data.error_type : null
    }
    fn set_error_type(value: ?ErrorType) $inline { this.ensure_meta().error_type = value }
    fn get_pre_value() ?Value $inline {
        let data = this.meta
        return isset(data) ? data.pre_value : null
    }
    fn set_pre_value(value: ?Value) $inline { this.ensure_meta().pre_value = value }
    fn get_checked_read() ?Value $inline {
        let data = this.meta
        return isset(data) ? data.checked_read : null
    }
    fn set_checked_read(value: Value) $inline { this.ensure_meta().checked_read = value }

    fn is_implicit_borrow() bool $inline {
        if this.rett.has_borrowed_refs() : return true
        let data = this.meta
        if isset(data) && data.implicit_borrow : return true
        if this.type != VAL.decl : return false
        let decl = this.decl
        return isset(decl) && decl.implicit_borrow
    }

    fn mark_implicit_borrow() $inline { this.ensure_meta().implicit_borrow = true }

    // Report an error at this value's source span when available.
    fn error(msg: String) !Error $throw {
        let e = this.exp
        if isset(e) : e.error(msg)
        // Fallback without span: still report, never fail silently
        this.rett.build.error(msg)
    }

    fn bug(msg: String) !Error $throw {
        this.error("(Compiler bug) " + msg)
    }

    fn assignable() bool {
        let t = this.type
        if t == VAL.prop {
            let prop = this.prop
            return isset(prop) && !prop.is_slice_data
        }
        return t == VAL.decl || t == VAL.global || t == VAL.ptrv
    }

    fn unroll() Array[Value] {
        let vals = this.values
        if this.type == VAL.multi && isset(vals) && this.rett.is_tuple_type() : return vals
        // A phi of multi values unrolls through its first arm.
        if this.type == VAL.phi && isset(vals) {
            let first = vals.get(0) !? null
            if isset(first) && first.type == VAL.multi : return first.unroll()
        }
        let parts = this.multi_parts()
        if isset(parts) : return parts
        return Array[Value]{ this }
    }

    // One extract per subtype of a multi-valued producer.
    fn multi_parts() ?Array[Value] {
        if !this.rett.is_tuple_type() : return null
        let subs = this.rett.get_members() ?! return null
        let out = Array[Value]{}
        each subs as st, i {
            let part = Value {
                type: VAL.multi
                int_val: i.@cast(int)
                value1: this
                rett: st
                exp: this.exp
            }
            part.set_name("part")
            out.append(part)
        }
        return out
    }

    // Explicit success projection of a fallible value.
    fn success_value() Value {
        if !this.can_error : return this
        return Value {
            type: VAL.error_success
            value1: this
            rett: this.rett
            exp: this.exp
        }
    }

    // Class / type id on the left of `Type { fields }` init.
    fn as_class_for_init() ?Class {
        if this.type != VAL.type : return null
        let t = this.get_of_type()
        if isset(t) {
            let c = t.class
            if isset(c) : return c
            return t.get_non_nullable().class
        }
        return this.get_class_ref()
    }

    // Extract Type from a compile-time VAL.type value.
    fn as_type() ?Type {
        if this.type == VAL.type : return this.get_of_type()
        return null
    }

    // Extract a name from a compile-time string value.
    fn as_name() ?String {
        if this.type == VAL.string : return this.get_string()
        return null
    }

    // Constant string form for folding == / != (null if not foldable as string).
    fn fold_string() ?String {
        if this.type == VAL.string : return this.get_string()
        if this.type == VAL.bool : return this.bool_val ? "1" : "0"
        if this.type == VAL.int {
            let buf = ByteBuffer.new()
            buf.write_int_ascii(this.int_val)
            return buf.to_string()
        }
        return null
    }

    // Resolve the Func being called from this callee Value, if known.
    fn resolve_call_func() ?Func {
        if this.type != VAL.func : return null
        return this.func
    }

    // Visits direct children in evaluation order; stops early when `visit` returns true
    fn any_child(visit: fn(Value)(bool), include_pre: bool (true)) bool {
        if include_pre {
            let pre = this.get_pre_value()
            if isset(pre) && visit(pre) : return true
        }
        let v1 = this.value1
        if isset(v1) && visit(v1) : return true
        if this.type == VAL.if || this.type == VAL.lock_block {
            let list = this.values
            if isset(list) {
                each list as item {
                    if visit(item) : return true
                }
            }
            let v2 = this.value2
            if isset(v2) && visit(v2) : return true
            return false
        }
        let v2 = this.value2
        if isset(v2) && visit(v2) : return true
        let list = this.values
        if isset(list) {
            each list as item {
                if visit(item) : return true
            }
        }
        return false
    }

    // Recursively visits `this` and every descendant; stops early when `visit` returns true
    fn any_node(visit: fn(Value)(bool)) bool {
        if visit(this) : return true
        return this.any_child(fn(child: Value) bool { return child.any_node(visit) })
    }

    // Folds over every direct child in evaluation order
    fn fold_children[R](init: R, step: fn(R, Value)(R), include_pre: bool (true)) R {
        let acc = init
        if include_pre {
            let pre = this.get_pre_value()
            if isset(pre) : acc = step(acc, pre)
        }
        let v1 = this.value1
        if isset(v1) : acc = step(acc, v1)
        if this.type == VAL.if || this.type == VAL.lock_block {
            let list = this.values
            if isset(list) {
                each list as item : acc = step(acc, item)
            }
            let v2 = this.value2
            if isset(v2) : acc = step(acc, v2)
            return acc
        }
        let v2 = this.value2
        if isset(v2) : acc = step(acc, v2)
        let list = this.values
        if isset(list) {
            each list as item : acc = step(acc, item)
        }
        return acc
    }
}

////////////////////////////
// Expression dispatch
////////////////////////////

fn value_from_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let b = ctx.build
    if b.nest_depth >= MAX_NESTING {
        exp.error("Expression nesting too deep (limit " + MAX_NESTING + ")")
    }
    if b.stack_exhausted() : exp.error("Expression nesting too deep")
    b.nest_depth++
    let did_return = scope.did_return
    scope.did_return = false
    let value = value_from_exp_inner(exp, scope, ctx) ! {
        b.nest_depth--
        scope.did_return = did_return
        throw E
    }
    b.nest_depth--
    value.never_returns = value.never_returns || scope.did_return
    scope.did_return = did_return || value.never_returns
    let group = value.get_group()
    if isset(group) && !ctx.is_group_receiver {
        exp.error("'" + group.name + "' is a group of functions, not a value. Use one of its functions instead")
    }
    return value
}

fn value_from_exp_inner(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    if exp.type != EXP.value : exp.bug("Expected EXP.value")
    let kind = exp.value_kind
    let b = ctx.build

    if kind == VALUE_KIND.paren {
        let inner = exp.get(VALUE_EXP.left)
        if !isset(inner) : exp.bug("Missing paren inner value")
        // Parentheses preserve the suggested type
        return value_from_exp(inner, scope, ctx) !>
    }

    if kind == VALUE_KIND.number || kind == VALUE_KIND.hex || kind == VALUE_KIND.octal {
        let v = value_from_int_literal(exp, b) !>
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.float {
        let v = value_from_float_literal(exp, b) !>
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.bool {
        let v = vgen_bool(exp.bool1, type_bool(b))
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.null {
        let nt: ?Type = null
        let type_exp = exp.get(VALUE_EXP.left)
        if isset(type_exp) {
            nt = type_from_exp(type_exp, scope) !>
        } else {
            nt = ctx.suggested_type
        }
        if !isset(nt) {
            exp.error("Missing type hint. This is required to generate a 'null' value. You can also use 'null[Type]' to suggest a type (e.g. null[?String])")
        }
        let null_t = nt.is_nullable_type() ? nt : nt.nullable()
        let v = vgen_null(null_t)
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.undefined {
        let v = vgen_undefined(type_void(b))
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.noop {
        return vgen_block(Array[Value]{}, b, exp)
    }
    if kind == VALUE_KIND.memcpy {
        return value_from_memcpy_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.intrinsic {
        return value_from_intrinsic_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.clone {
        return value_from_clone_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.copy {
        return value_from_copy_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.hash {
        return value_from_hash_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.named_arg : exp.error("'" + exp.str1 + ": value' names an argument of a function call")
    if kind == VALUE_KIND.spread : exp.error("'...values' passes an array as the variadic values of a function call")
    if kind == VALUE_KIND.string {
        return value_from_string_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.char {
        let v = vgen_int(char_literal_byte(exp.str1), type_char(b))
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.id {
        let v = value_from_id_exp(exp, scope, ctx) !>
        v.exp = exp
        lsp_hover(exp, v) !>
        return v
    }

    // size_of(Type) → VAL.int with the type's byte size
    if kind == VALUE_KIND.size_of {
        let type_exp = exp.get(VALUE_EXP.left)
        if !isset(type_exp) : exp.bug("Missing size_of type operand")
        let t = type_from_exp(type_exp, scope) !>
        let bytes = t.byte_size() !>
        let v = vgen_int(bytes.to(int), type_int(b))
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.unary {
        let operand_exp = exp.get(VALUE_EXP.left)
        if !isset(operand_exp) : exp.bug("Missing unary operand")
        let op = exp.number.@cast(VALUE_OP)
        let operand = vgen_undefined(type_void(b), exp)
        if op == VALUE_OP.ref_of && operand_exp.type == EXP.value && operand_exp.value_kind == VALUE_KIND.offset {
            // `&sequence[i]` and `&sequence[a..b]`: an element of an array,
            // a slice, or `&[T]` is borrowed with the storage block as owner.
            let base_exp = operand_exp.get(VALUE_EXP.left) ?! operand_exp.bug("offset is missing base")
            let on = value_from_exp(base_exp, scope, ctx.without_suggested_type()) !>
            on = value_fixed_array_range_base(on, operand_exp, scope, ctx, exp) !>
            let element_borrow = value_borrow_sequence_element(on, operand_exp, scope, ctx, exp, true) !>
            if isset(element_borrow) : return element_borrow
            operand = value_from_offset_on(on, operand_exp, scope, ctx) !>
        } else {
            operand = value_from_exp(operand_exp, scope, ctx.without_suggested_type()) !>
        }
        if op == VALUE_OP.ref_of {
            if !operand.assignable() {
                exp.error("The '&' operator can only be used on assignable storage")
            }
            act_check_assign(operand, exp, scope) !>
            value_check_shared_address(operand, exp) !>
            return value_borrow_of(operand, scope, ctx, exp, true) !>
        }
        // Fold constants when possible
        operand = value_enum_representation(operand) !>
        if op == VALUE_OP.neg {
            let element = operand.rett.vector_element()
            if !element.is_integer_type() && !element.is_float_type() {
                exp.error("Expected an integer or float after unary '-', the value type we found was: " + operand.rett.compat_display_name())
            }
            if operand.type == VAL.int {
                // A negative literal is never unsigned: only the signed minimum survives negation
                if !operand.rett.is_signed_type() && exp_is_untyped_number(operand_exp) {
                    if operand.int_val != (-9223372036854775807 - 1) : exp.error("Integer literal is out of range")
                    let v = vgen_int(operand.int_val, type_int(b))
                    v.exp = exp
                    return v
                }
                operand.int_val = fold_integer_to_width(0 - operand.int_val, operand.rett)
                operand.exp = exp
                return operand
            }
            if operand.type == VAL.float {
                // Flip the sign bit: '0 - x' would turn -0.0 into +0.0
                operand.float_val = operand.float_val * -1.0
                operand.exp = exp
                return operand
            }
        }
        if op == VALUE_OP.not && operand.type == VAL.bool {
            let v = vgen_bool(!operand.bool_val, type_bool(b))
            v.exp = exp
            return v
        }
        if op == VALUE_OP.bit_not && operand.type == VAL.int {
            operand.int_val = fold_integer_to_width(~operand.int_val, operand.rett)
            operand.exp = exp
            return operand
        }
        if op == VALUE_OP.bit_not && operand.rett.is_vector_type() && !operand.rett.vector_element().is_integer_type() {
            exp.error("'~' needs an integer vector, got: " + operand.rett.compat_display_name())
        }
        if op == VALUE_OP.not {
            if !operand.rett.is_bool_type() {
                exp.error("Expected a value of type 'bool' after '!', the value type we found was: " + operand.rett.compat_display_name())
            }
            let v = vgen_unary(operand, op, type_bool(b))
            v.exp = exp
            // Flip issets when only one side is tracked (matches old !isset behavior)
            let is_list = operand.get_issets()
            let not_list = operand.get_not_issets()
            let is_count = (isset(is_list) ? is_list.length : 0) + (isset(not_list) ? not_list.length : 0)
            if is_count == 1 {
                v.set_issets(not_list)
                v.set_not_issets(is_list)
            }
            return v
        }
        let v = vgen_unary(operand, op, operand.rett)
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.op {
        return value_from_op_exp(exp, scope, ctx) !>
    }

    if kind == VALUE_KIND.is_a {
        let on_exp = exp.get(VALUE_EXP.left)
        let type_exp = exp.get(VALUE_EXP.right)
        if !isset(on_exp) || !isset(type_exp) : exp.bug("is_a is missing an operand")
        let on = value_from_exp(on_exp, scope, ctx.without_suggested_type()) !>
        // A borrow of an interface value is not itself one: it has no vtable
        // word to compare, so the test only applies to the value itself.
        let on_nn = on.rett.get_non_nullable()
        let interface = on_nn.kind == TYPE.interface ? on_nn.get_class_or_null() : null
        if !isset(interface) || interface.kind != CLASS_KIND.interface {
            on_exp.error("The left side of 'is_a' must be an interface value")
        }
        let target = type_from_exp(type_exp, scope) !>
        if target.is_nullable_type() : type_exp.error("The type after 'is_a' cannot be nullable")
        let concrete = target.get_class_or_null()
        if !isset(concrete) || (concrete.kind != CLASS_KIND.class && concrete.kind != CLASS_KIND.struct) {
            type_exp.error("The type after 'is_a' must be a class or struct")
        }
        resolve_class_interfaces(concrete) !>
        let adapter: ?Class = null
        if class_implements_interface(concrete, interface) {
            adapter = interface.interface_adapters.get(interface_adapter_key(concrete)) !? null
        }
        return vgen_is_a(on, adapter, b, exp)
    }

    if kind == VALUE_KIND.is_variant {
        let on_exp = exp.get(VALUE_EXP.left)
        let var_exp = exp.get(VALUE_EXP.right)
        if !isset(on_exp) || !isset(var_exp) : exp.bug("is_variant is missing an operand")
        let on = value_from_exp(on_exp, scope, ctx.without_suggested_type()) !>
        let on_nn = on.rett.get_non_nullable()
        let c = on_nn.kind == TYPE.union ? on_nn.get_class_or_null() : null
        if !isset(c) || !c.is_named_union {
            on_exp.error("The left side of 'is .' must be a named union value")
        }
        let vname = var_exp.str1
        let variant = c.get_union_variant(vname)
        if !isset(variant) {
            var_exp.error("Union '" + c.pretty_name() + "' has no variant named '" + vname + "'")
        }
        lsp_hover_union_variant(var_exp, c, variant) !>
        lsp_goto(var_exp, variant.exp, vname) !>
        return vgen_union_is(on, variant.tag, exp)
    }

    if kind == VALUE_KIND.call {
        return value_from_call_exp(exp, scope, ctx) !>
    }

    if kind == VALUE_KIND.ternary {
        return value_from_ternary_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.null_coalesce {
        return value_from_null_coalesce_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.null_exit {
        return value_from_null_exit_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.optional_chain {
        return value_from_optional_chain_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.chain_receiver {
        let on = scope.find_chain_receiver() ?! exp.bug("'?.' is missing the value it checked")
        let v = value_force_remove_nullable(value_null_op_operand_read(on))
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.isset {
        return value_from_isset_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.is_defined {
        let id = exp.get(VALUE_EXP.left)
        if !isset(id) : exp.bug("Missing is_defined identifier")
        let defined = false
        let ns_name = id.str2
        if isset(ns_name) {
            let ns_idf = scope.get_scope_idf(ns_name)
            if isset(ns_idf) {
                let ns_scope = ns_idf.scope
                if !isset(ns_scope) : exp.bug("Scope idf is missing scope")
                defined = isset(ns_scope.get_idf(id.str1))
            }
        } else {
            defined = isset(scope.get_idf(id.str1)) || id.str1 == "__PATH__" || id.str1 == "__FILE__" || id.str1 == "__DIR__" || id.str1 == "__LINE__"
        }
        let v = vgen_bool(defined, type_bool(b))
        v.exp = exp
        return v
    }
    if kind == VALUE_KIND.error_handler {
        return value_from_error_handler_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.match {
        return value_from_match_exp(exp, scope, ctx) !>
    }

    if kind == VALUE_KIND.cast {
        let on_exp = exp.get(VALUE_EXP.left)
        let type_exp = exp.get(VALUE_EXP.right)
        if !isset(on_exp) : exp.bug("Missing cast value")
        if !isset(type_exp) : exp.bug("Missing cast type")
        let cast_t = type_from_exp(type_exp, scope, ctx.suggested_type) !>
        // Suggest cast target for the value (`null.@cast(Node)` needs a type for null)
        let cast_ctx = cast_t.get_non_nullable().is_shared ? ctx.without_suggested_type() : ctx.with_suggested_type(cast_t)
        let on = value_from_exp(on_exp, scope, cast_ctx) !>
        if cast_t.get_non_nullable().is_fat_borrow() || on.rett.get_non_nullable().is_fat_borrow() {
            let borrowed = value_cast_borrow(on, cast_t, scope, ctx, exp) !>
            if isset(borrowed) {
                borrowed.exp = exp
                return borrowed
            }
        }
        if !ir_cast_is_representable(on.rett, cast_t) !> {
            exp.error("Cannot @cast '" + on.rett.compat_display_name() + "' to '" + cast_t.compat_display_name() + "': the two representations have different sizes")
        }
        let v = vgen_cast(on, cast_t)
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.dot {
        let v = value_from_dot_exp(exp, scope, ctx) !>
        lsp_hover(exp, v) !>
        return v
    }

    if kind == VALUE_KIND.typeof {
        // typeof(value) → VAL.type of the value's result type (rett)
        let inner_exp = exp.get(VALUE_EXP.left)
        if !isset(inner_exp) : exp.bug("Missing typeof operand")
        let inner = value_from_exp(inner_exp, scope, ctx.without_suggested_type()) !>
        let v = value_as_rett_type(inner, exp, b) !>
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.multi {
        // Multi-value `(a, b, …)` or bare multi list (call args)
        let args = Array[Value]{}
        let i: uint = 0
        // Suggested multi type suggests each part (return / let / assign)
        let suggested_type = ctx.suggested_type
        let part_types: ?Array[Type] = null
        if isset(suggested_type) && suggested_type.is_tuple_type() {
            part_types = suggested_type.get_members()
        }
        while true {
            let a = exp.get(i)
            if !isset(a) : break
            let part_ctx = ctx.without_suggested_type()
            let pt: ?Type = null
            if isset(part_types) {
                pt = part_types.get(i) !? null
                if isset(pt) : part_ctx = ctx.with_suggested_type(pt)
            }
            let av = value_from_exp(a, scope, part_ctx) !>
            av.require_result() !>
            // Convert each part toward suggested multi slot (e.g. int → String via $to)
            if isset(pt) && !av.rett.is_void_type() && !pt.is_void_type() {
                av = value_try_convert(av, scope, ctx, pt) !>
            }
            args.append(av)
            i++
        }
        let v = vgen_grouped_values(b, args)
        v.exp = exp
        return v
    }

    if kind == VALUE_KIND.incr || kind == VALUE_KIND.decr {
        let operand_exp = exp.get(VALUE_EXP.left)
        if !isset(operand_exp) : exp.bug("Missing ++/-- operand")
        let operand = value_from_exp(operand_exp, scope, ctx.without_suggested_type()) !>
        if isset(operand.rett.get_enum()) {
            exp.error("Cannot increment or decrement an enum; assign a declared enum value")
        }
        let getter = value_getter_of_call(operand)
        if isset(getter) {
            exp.error("Cannot increment or decrement '" + getter.name + "': it is a getter; with a setter, write '+= 1' or '-= 1'")
        }
        if !operand.assignable() {
            if operand_exp.type == EXP.value && operand_exp.value_kind == VALUE_KIND.offset {
                exp.error("Cannot increment or decrement an element read through an '$offset' hook; write '+= 1' or '-= 1'")
            }
            exp.error("Cannot increment or decrement a value that is not assignable")
        }
        if operand.rett.is_nullable_type() && !value_stores_non_null(operand, scope) {
            exp.error("Cannot increment or decrement a nullable value; check it with isset first")
        }
        if value_is_copied_element(operand) {
            exp.error("Cannot change an element copied out of an Array; borrow it with '&arr[i]' or store the element back with '.set'")
        }
        if value_is_call_result_copy(operand) : exp.error(CALL_RESULT_COPY_ERROR)
        if value_in_readonly_view(operand, ctx) : exp.error("Cannot change storage through a read-only borrow; " + value_readonly_hint(operand, ctx))
        value_check_captured_write(operand, exp) !>
        act_check_assign(operand, exp, scope) !>
        value_mark_mutable(operand)
        value_check_shared_store(operand, exp) !>
        let op = kind == VALUE_KIND.incr ? VALUE_OP.add : VALUE_OP.sub
        if value_is_shared_storage(operand) && operand.rett.is_integer_type() {
            let one = vgen_int(1, operand.rett)
            let atomic = vgen_atomic_op(operand, one, op, exp)
            if exp.bool1 : return vgen_op(atomic, one, op, operand.rett)
            return atomic
        }
        // Result type matches operand (int-like); full assignability checks later
        let v = Value {
            type: VAL.op
            op: op
            value1: operand
            rett: operand.rett
            exp: exp
            bool_val: exp.bool1 // prefix flag stashed for IR later
        }
        return v
    }

    if kind == VALUE_KIND.typehint_member {
        // `.name` names something of the type the value is expected to have: an enum member, a
        // union variant, or a static function of a class
        let suggested_type = ctx.suggested_type
        if isset(suggested_type) {
            let target = suggested_type.get_non_nullable()
            // Enum member: `let color: Color = .red`
            let enu = target.get_enum()
            if isset(enu) {
                lsp_complete_enum(exp, enu) !>
                return value_from_enum_item(enu, exp.str1, exp, scope, ctx) !>
            }
            let class = target.get_class_or_null()
            if isset(class) {
                let variant = value_from_union_variant_ref(class, exp.str1, exp, ctx) !>
                if isset(variant) : return variant
                let func = class.get_func(exp.str1)
                if isset(func) && func.is_static {
                    let member = vgen_func(func)
                    member.exp = exp
                    return member
                }
            }
        }

        typehint_member_has_no_type(exp, suggested_type)
    }

    if kind == VALUE_KIND.class_init {
        return value_from_class_init_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.slice_init {
        return value_from_slice_init_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.offset {
        return value_from_offset_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.ptrv {
        return value_from_ptrv_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.ref_of {
        return value_from_ref_of_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.vscope {
        return value_from_vscope_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.func_lit {
        return value_from_func_lit_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.co {
        return value_from_co_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.await {
        return value_from_await_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.embed {
        return value_from_embed_exp(exp, scope, ctx) !>
    }
    if kind == VALUE_KIND.embed_dir {
        return value_from_embed_dir_exp(exp, scope, ctx) !>
    }
    exp.bug("Unknown value kind: " + kind)
}

////////////////////////////
// Embeds and coroutines
////////////////////////////

fn embed_base_dir(ctx: Context) String !Error {
    let func = ctx.get_func() !>
    let dir = func.ns.pkg.dir
    return dir ?? (fs.cwd() ! func.exp.error("Cannot find the current directory"))
}

fn value_from_embed_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let b = ctx.build
    let base = embed_base_dir(ctx) !>
    let full = helper.resolve(exp.str1, base)
    if !fs.exists(full) {
        exp.error("Embed file not found: " + full)
    }
    let content = fs.read(full) ! exp.error("Failed to read embed file: " + full)
    b.watch_files.append(full, true)
    let v = vgen_string(content, type_string(b))
    v.exp = exp
    return v
}

fn value_from_embed_dir_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let b = ctx.build
    let base = embed_base_dir(ctx) !>
    let dir = helper.resolve(exp.str1, base)
    if !fs.is_dir(dir) {
        exp.error("Embed directory not found: " + dir)
    }

    let idf = b.scope.get_idf("HashMap")
    if !isset(idf) : exp.bug("HashMap class not found (needed for #embed_dir)")
    if idf.type != IDF.class : exp.bug("HashMap is not a class")
    let map_base = idf.class
    if !isset(map_base) : exp.bug("HashMap idf is missing class")
    let str_t = type_string(b)
    let map_class = map_base.specialize(Array[Type]{ str_t, str_t }, exp) !>
    let rett = map_class.get_type() !>

    let construct = class_default_construct(map_class, rett, scope, ctx, exp) !>
    let set_f = map_class.get_set_key_hook()
    if !isset(set_f) : exp.bug("HashMap has no '$set_key' hook")
    if !set_f.parsed_types : parse_func_types(set_f) !>

    let files = fs.files_in(dir, true, true, false, true) ! exp.error("Failed to list embed directory: " + dir)
    // The directory itself too: its mtime changes when files are added/removed
    b.watch_files.append(dir, true)
    let chain = class_init_hook_base(ctx, construct)
    let hooks = Array[Value]{}
    each files as file {
        let full = fs.add(dir, file)
        let content = fs.read(full) ! exp.error("Error reading embed file: " + full)
        b.watch_files.append(full, true)
        let kv = vgen_string(file.replace("\\", "/"), str_t)
        let vv = vgen_string(content, str_t)
        let callee = vgen_func(set_f, class_init_hook_receiver(chain))
        let args = Array[Value]{ kv, vv }
        let call = vgen_call(ctx, callee, args, set_f.get_rett(), scope)
        call.exp = exp
        hooks.append(call)
        if class_init_hook_chains(chain, call, rett) : chain = call
    }

    let v = Value {
        type: VAL.class_init
        value1: chain
        values: hooks
        rett: rett
        exp: exp
    }
    return v
}

// Hook-style initializers (`Map{ k => v }`, `Array{ a, b }`, `#embed_dir`)
// call `$set_key` / `$append` on a fresh allocation. Those hooks allocate, so
// a collection can run in the middle of the chain; a heap receiver must be
// rooted in a frame buffer until the last hook is done, exactly like the
// receiver of a hand-written `Map{}.set(k, v).set(k2, v2)` chain. Inline
// aggregates (slices, structs) keep nesting: their hooks return a new value.
fn class_init_hook_base(ctx: Context, construct: Value) Value {
    let func = ctx.func ?! return construct
    if func.no_buffers || !construct.rett.is_gc_type() : return construct
    return buffer_value(ctx, func, construct)
}

// Each hook reads the rooted buffer; only an unbuffered chain nests the calls.
fn class_init_hook_receiver(chain: Value) Value {
    let decl = chain.decl ?! return chain
    if chain.type != VAL.decl : return chain
    return vgen_buffer_decl(decl, chain.rett)
}

// The local of a struct literal as the receiver of one hook; the position lets it be borrowed
fn class_init_local_receiver(local: Decl, at: Exp) Value {
    let read = vgen_decl(local)
    read.exp = at
    return read
}

fn class_init_hook_chains(chain: Value, call: Value, rett: Type) bool {
    if chain.type == VAL.decl && isset(chain.decl) : return false
    return !call.rett.is_void_type() && call.rett.compat(rett)
}

fn value_from_co_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let enclosing = ctx.get_func() !>
    enclosing.note_gc_allocation()
    enclosing.note_explicit_suspend()
    let call_exp = exp.get(VALUE_EXP.left)
    if !isset(call_exp) : exp.bug("'co' is missing a call expression")
    if call_exp.type != EXP.value || call_exp.value_kind != VALUE_KIND.call {
        call_exp.error("'co' can only be used on a function call")
    }
    let call = value_from_call_raw(call_exp, scope, ctx, true) !>
    let callee = call.value1
    if !isset(callee) : exp.bug("'co' call has no callable")
    value_check_co_lock_escape(call, callee, exp) !>
    if callee.rett.get_non_nullable().kind == TYPE.closure {
        call.value1 = buffer_value(ctx, enclosing, callee)
        call.op = CALL_KIND.closure
    }

    let error_type = call.get_error_type()
    let co_type = type_callable(ctx.build, TYPE.co, Array[Type]{}, call.rett, error_type)
    let helper_name = "valk.coro." + enclosing.unit.name + "." + enclosing.unit.coro_count++
    let v = Value {
        type: VAL.co
        value1: call
        rett: co_type
        exp: exp
    }
    v.set_name(helper_name)
    return v
}

fn value_check_co_lock_escape(call: Value, callee: Value, at: Exp) !Error {
    let receiver = callee.type == VAL.func ? callee.value1 : null
    if isset(receiver) : value_check_co_arg(receiver, at) !>
    if callee.type != VAL.func {
        // A bound stack method reached through a variable or a parameter
        value_check_co_arg(callee, at) !>
    }
    let args = call.values
    if !isset(args) : return
    each args as arg : value_check_co_arg(arg, at) !>
}

fn value_check_co_arg(arg: Value, at: Exp) !Error {
    if arg.rett.has_locked_refs() {
        at.error("A locked view cannot be handed to a coroutine; it is only valid inside its lock block")
    }
    // The coroutine may outlive the frame that owns the borrowed storage
    if arg.is_implicit_borrow() {
        at.error("A stack borrow cannot be handed to a coroutine; it may outlive the frame that owns the storage. Use an owned borrow ('&object.field') or pass a copy")
    }
}

////////////////////////////
// Closures and captures
////////////////////////////

fn func_prepare_closure(f: Func) !Error {
    if isset(f.capture_class) : return

    each f.capture_decls as decl {
        if decl.type.has_borrowed_refs() {
            f.exp.error("You cannot bind stack borrows in closures. Type not allowed: " + decl.type.compat_display_name())
        }
    }

    let class = Class {
        unit: f.unit
        ns: f.ns
        name: "closure_env_" + helper.ctxhash(func_ir_name(f))
        display_name: "<closure binding data>"
        closure_env: true
        act: ACT.private
        kind: CLASS_KIND.class
        scope: f.arg_scope
        exp: f.exp
    }
    if isset(f.class) && !f.is_static {
        let receiver_arg = f.args.get(0) !? null
        if !isset(receiver_arg) : f.exp.bug("Instance closure target has no receiver argument")
        class.add_prop(Prop {
            class: class
            name: "receiver"
            act: ACT.private
            exp: f.exp
            type: receiver_arg.type
        })
        each f.capture_args as capt {
            capt.capture_index = capt.capture_index + 1
        }
    }
    each f.capture_args as decl, i {
        class.add_prop(Prop {
            class: class
            name: "capture_" + i
            act: ACT.private
            exp: f.exp
            type: decl.type
        })
    }
    let capture_size = class.compute_body_size() !>
    let header: u32 = f.is_shared ? 0 : f.ns.build.options.target.ptr_size.to(u32)
    f.capture_class = class
    if capture_size > 0 {
        if header > 0 {
            each class.props as prop {
                prop.offset = prop.offset + header
            }
        }
        class.size = capture_size + header
        f.capture_header_size = header
        let allocator = allocator_for_class(Context.for_func(f), class, f.exp) !>
        f.capture_allocator = allocator
        // A deferred closure only lives in its function's defer stack and is never cloned
        if !f.is_shared && !f.is_defer : ensure_closure_clone_func(f) !>
        allocator.env_clone = f.capture_clone_func
    }
}

// The Func a value directly references.
fn value_resolve_func_ref(v: Value) ?Func {
    if v.type != VAL.func : return null
    return v.func
}

fn func_capture_decl(func: Func, decl: Decl, name: String, at: Exp) Decl !Error {
    if decl.owner == func : return decl
    if !func.is_literal {
        // A default argument runs at the call site, where the callee's parameters do not exist
        at.error("A default value cannot use the parameter '" + name + "': give it a value that does not depend on other parameters, or compute it in the function body")
    }

    let parent_scope = func.arg_scope.parent
    if !isset(parent_scope) : at.bug("Closure has no enclosing scope: " + name)
    let parent = parent_scope.func
    if !isset(parent) : at.bug("Closure has no enclosing function: " + name)

    let source = decl
    if source.owner != parent {
        source = func_capture_decl(parent, source, name, at) !>
    }
    if source.type.has_locked_refs() {
        if func.is_defer : at.error("A deferred call runs when the function ends, after the lock block, so it cannot use a locked view")
        at.error("A locked view cannot be captured by a closure; it is only valid inside its lock block")
    }
    source.is_captured = true
    if source.implicit_borrow {
        at.error("An implicit pointer borrow cannot be captured: the address would outlive the value")
    }

    let local_idf = func.arg_scope.identifiers
    if isset(local_idf) {
        let existing_idf = local_idf.get(name)
        if isset(existing_idf) && existing_idf.type == IDF.decl {
            let existing = existing_idf.decl
            if isset(existing) && existing.owner == func && existing.is_bind {
                return existing
            }
        }
    }

    let captured_type = source.type
    if func.is_shared && (source.type.has_gc_refs() || source.type.get_non_nullable().kind == TYPE.closure)
        && !type_refs_all_shared(source.type)
    {
        at.error("An atomic function cannot capture non-atomic data of type '" + source.type.compat_display_name() + "'; a mutable alias remains")
    }
    let captured = Decl.new(func, captured_type, true, name)
    captured.exp = source.exp
    captured.is_bind = true
    captured.is_shared_capture = func.is_shared
    captured.capture_index = func.capture_args.length
    func.capture_free = false
    func.capture_decls.append(source)
    func.capture_args.append(captured)
    // Freshly created, so it cannot already be listed.
    func.all_decls.append(captured)
    func.arg_scope.set_idf(name, Idf.for_decl(captured))

    if parent_scope.not_null_check(source) : func.arg_scope.mark_not_null(captured)
    return captured
}

fn value_from_func_lit_exp(exp: Exp, scope: Scope, ctx: Context) Value !Error {
    let b = ctx.build
    let enclosing = ctx.get_func() !>
    let args_exp = exp.get(FUNC_LIT_EXP.args)
    if !isset(args_exp) : exp.bug("Function literal is missing an argument list")

    let suggested = ctx.suggested_type
    let shared = isset(suggested) && suggested.get_non_nullable().kind == TYPE.closure && suggested.get_non_nullable().is_shared
    let f = Func {
        unit: enclosing.unit
        ns: enclosing.ns
        name: "<anonymous>_" + helper.ctxhash(func_ir_name(enclosing))
        act: ACT.private
        exp: exp
        literal_owner: enclosing
        arg_scope: scope.sub_scope()
        args_exp: args_exp
        rett_exp: exp.get(FUNC_LIT_EXP.type)
        error: exp.get(FUNC_LIT_EXP.error)
        body: exp.get(FUNC_LIT_EXP.body)
        is_literal: true
        is_shared: shared
    }
    // The function type expected here gives the parameter types and return type the
    // literal leaves out
    if isset(suggested) {
        let expected = suggested.get_non_nullable()
        if expected.kind == TYPE.closure || expected.kind == TYPE.fnptr {
            let known = Array[Type]{}
            each expected.get_args() ?? Array[Type]{} as arg_type {
                if type_has_placeholder(arg_type) : break
                known.append(arg_type)
            }
            f.literal_arg_types = known
            let expected_rett = expected.get_return_type()
            if !expected_rett.is_void_type() && !type_has_placeholder(expected_rett) : f.literal_rett = expected_rett
            else if type_has_placeholder(expected_rett) : f.literal_rett_open = true
        }
    }
    f.arg_scope.func = f
    f.info_used = enclosing.info_used
    f.unit.functions.append(f)
    parse_func_types(f) !>
    if shared {
        let thread_bound = type_has_coroutine_handle(f.get_rett(), Array[Class]{})
        each f.args as a : if type_has_coroutine_handle(a.type, Array[Class]{}) : thread_bound = true
        if thread_bound : exp.error("An atomic function cannot take or return a coroutine handle; it is bound to the thread that created it")
    }
    parse_func_ast(f) !>
    if !f.capture_free : enclosing.note_gc_allocation()

    let arg_types = Array[Type]{}
    each f.args as a : arg_types.append(a.type)

    // Store the natural return type: void, T, or a multi-value type.
    let sub_type = f.get_rett()

    let fn_type = type_callable(b, TYPE.closure, arg_types, sub_type, f.error_type, shared)

    let v = vgen_func(f)
    v.rett = fn_type
    v.exp = exp
    return v
}


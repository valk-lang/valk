// Resolve function bodies into a sequence of Values on the body Scope.
//
// Everything in a function body is a Value — including if/while/let/return/assign.
// Control-flow values have rett = void (side effects only).
//
// Prerequisites: parse_func_types (args + this bound as IDF.decl on arg_scope).

////////////////////////////
// Body resolution entry
////////////////////////////

fn parse_func_ast(func: Func) !Error {
    if func.parsed_ast : return
    if func.skip_ast || func.is_generic_base : return

    func.parsed_ast = true

    let body = func.body
    if !isset(body) : return

    // Body scope parents arg_scope (args + this already bound as IDF.decl)
    let scope = func.arg_scope.sub_scope()
    scope.func = func
    func.body_scope = scope
    let alloca_scope = scope.sub_scope()
    let defer_scope = scope.sub_scope()
    func.alloca_scope = alloca_scope
    func.defer_scope = defer_scope

    let rett = func.get_rett()
    if !rett.is_void_type() : scope.must_return = true
    if func.must_exit : scope.must_exit = true
    if func.must_throw : scope.must_throw = true

    let ctx = Context.for_func(func)
    if func.is_test {
        test_init_scope(func, scope, ctx) !>
    }
    let exps = read_func_body_exps(body) !>
    let state = ParseState.new()
    append_body_exp_range(ctx, scope, state, exps, 0, exps.length) !>
    if state.has_open_if() || state.is_skipping() {
        body.error("Missing compile macro '#end' in function body")
    }
    // A function that returns a value has to do so on every path. `did_return`
    // is set by whatever ended the last one — a return, a throw, an `if` whose
    // branches all end, a match whose arms all do, a `while true` nothing breaks
    // out of, or a call that never comes back. Reaching here without it means
    // the body runs off the end and hands back whatever was in the register.
    if scope.must_return && !scope.did_return && !scope.must_exit && !scope.must_throw {
        body.error("Missing 'return' statement")
    }
    func_finish_ast(func) !>
    warn_unused_decls(func)

    // Capture registration happens while identifier expressions are resolved;
    // prepare the resulting environment before IR and AST release.
    if func.is_literal : func_prepare_closure(func) !>

    // The LSP answers from the resolved AST and never links anything, so IR for
    // every function in the project would be pure overhead on each keystroke.
    if !isset(func.ns.build.options.lsp) : generate_func_ir(func) !>

    // Lowered again whenever the used-globals set grows, so nothing its body
    // needs may be released yet (see globals-loop.valk).
    if func.has_globals_loop {
        func.pending_exps = exps
        return
    }

    // A function that allocates nothing itself may still be able to drop its GC
    // stack frame, which depends on everything it calls and so cannot be
    // settled yet. Such a function keeps its resolved body until the second
    // pass has the answer (see gc-stack.valk).
    if func_may_drop_gc_stack(func) {
        // Released like any other function. What the second pass needs is the
        // body expression alone — read_func_body_exps re-reads the statements
        // from source through its Pos — so holding a function back costs one
        // node rather than its resolved graph, and a large program does not
        // pay for this in memory (see gc-stack.valk).
        let body_exp = func.body
        func_release_ast(func, exps)
        func.body = body_exp
        func.ns.build.pipeline.deferred_gc_funcs.append(func)
        return
    }

    func_release_ast(func, exps)
}

// Drop everything only the resolved body needed. Held back for a function whose
// IR may still be regenerated without its GC stack frame.
fn func_release_ast(func: Func, exps: Array[Exp]) {
    func_release_exps(func, exps)

    // IR generation consumed the executable body and local-storage plan.
    // Calls only need the retained Func signature from this point onward.
    func.body_scope = null
    func.alloca_scope = null
    func.defer_scope = null
    func.user_defer_stack = null
    func.user_defer_pop = null
    func.all_decls = .{}
    func.define_decls = .{}
    func.buffer_pool = .{}
    func.buffers_used = .{}
    func.test_entry_decl = null
    func.stable_stack_decl = null
}

// The half of the release that a second lowering pass does not stand in the way
// of: expressions and name lookup are finished with once a body is resolved,
// while the Values and declarations are what that pass re-emits from. Splitting
// it keeps a function that is only waiting for the call graph (gc-stack.valk)
// from holding on to its whole parse tree as well.
fn func_release_exps(func: Func, exps: Array[Exp]) {
    func.pending_exps = null
    each exps as exp : exp.release_children()
    // Signature/body EXPs have been resolved into Func fields, Args, Types,
    // and body_scope Values. Keep only func.exp itself as a diagnostic span.
    // Generic bases are skipped above and retain their raw AST for future
    // specializations.
    func.exp.sub_exps = null
    func.generics = null
    func.args_exp = null
    func.rett_exp = null
    func.error = null
    func.body = null

    // Name lookup and nullable-flow state are parse-time only. Declarations
    // are retained by Func.all_decls/args and referenced directly by Values.
    func.arg_scope.identifiers = null
    func.arg_scope.decls.clear()
    func.arg_scope.not_null.clear()
    let scope = func.body_scope
    if isset(scope) {
        scope.identifiers = null
        scope.decls.clear()
        scope.not_null.clear()
    }
}

////////////////////////////
// Function-local storage
////////////////////////////

fn decl_needs_gc_stack_storage(decl: Decl) bool {
    if decl.skip_gc_field_roots : return false
    if decl.is_gc {
        if decl.is_buffer : return true
        // Immutable managed arguments remain rooted by their caller.
        return !decl.is_arg || decl.is_mut
    }
    if decl.type.get_non_nullable().type == TYPE.fn {
        // Arguments may contain captures supplied by unknown callers. Locals
        // need the slot only once a captured closure can reach them.
        return decl.is_arg || decl.closure_holds_captures
    }
    return decl.type.has_gc_refs()
}

fn decl_assign_gc_stack_storage(decl: Decl, offset: uint) uint !Error {
    let size = (decl.type.size() !>).to(uint)
    let alignment = decl.type.storage_alignment() !>.to(uint)
    if alignment > 0 : offset = offset.round_up(alignment)
    decl.gc_stack_offset = offset
    return offset + size
}

// Finalize function-local storage after the complete AST has marked declarations
// used/mutable/stable. Mirrors the legacy FuncAST alloca/defer scope generation.
fn func_finish_ast(func: Func) !Error {
    let b = func.ns.build
    let psz = b.options.target.ptr_size.to(uint)
    let alloca_size: uint = 0
    let stable_size: uint = 0
    let gc_count: uint = 0

    // Without a GC stack there are no roots to record, so every declaration
    // takes the plain path below and gc_count stays at zero.
    let roots = !func.disable_gc_stack

    each func.all_decls as decl {
        // Arguments survive a second lowering pass, so never retain offsets
        // from the discarded frame.
        decl.gc_stack_offset = null
        // Hidden capture arguments are properties of the closure environment,
        // not independent frame storage.
        if decl.is_bind : continue
        if decl.must_be_stable {
            decl.offset = stable_size
            let size = decl.type.size() !>.to(uint)
            stable_size += size.round_up(psz)
        } else if roots && decl_needs_gc_stack_storage(decl) {
            alloca_size = decl_assign_gc_stack_storage(decl, alloca_size) !>
            gc_count++
            // Each declaration is visited once, so it is listed at most once.
            func.define_decls.append(decl)
            continue
        }
        if decl.is_mut : func.define_decls.append(decl)
    }

    if stable_size > 0 {
        let decl = Decl.new(func, type_ptr(b), false, "valk_stable_stack")
        decl.ir_name = "\%valk_stable_stack"
        let root_offset = alloca_size.round_up(psz)
        decl.gc_stack_offset = root_offset
        alloca_size = root_offset + psz
        func.define_decls.append(decl)
        func.stable_stack_decl = decl
        gc_count++
    }

    func.alloca_size = alloca_size
    func.stable_alloca_size = stable_size
    func.gc_decl_count = gc_count

    let alloca_scope = func.alloca_scope
    let defer_scope = func.defer_scope
    let body_scope = func.body_scope
    if !isset(alloca_scope) || !isset(defer_scope) || !isset(body_scope) {
        func.exp.bug("Function setup scopes are missing: " + func.name)
    }

    if func.is_test {
        test_finish_scope(func, defer_scope) !>
    }

    if gc_count > 0 {
        alloca_scope.append_value(vgen_ir_comment("INCREASE GC STACK", b))
        alloca_scope.append_value(vgen_gc_stack_init(alloca_size, gc_count, b))
        if !func.is_entrance {
            defer_scope.append_value(vgen_ir_comment("REDUCE GC STACK", b))
            defer_scope.append_value(vgen_gc_stack_defer(b))
        }
    }
    // Everything else sets the stable stack up in the entry block, before the
    // argument stores that may target it (see ir_emit_func). An entrance
    // function must first install the GC frame that roots this allocation.
    if stable_size > 0 && func.is_entrance {
        let decl = func.stable_stack_decl
        if !isset(decl) : func.exp.bug("Stable stack declaration is missing")
        alloca_scope.append_value(vgen_ir_comment("STABLE STACK", b))
        alloca_scope.append_value(vgen_stable_stack_init(decl, stable_size, b))
    }
    if func.define_decls.length > 0 {
        alloca_scope.append_value(vgen_ir_comment("INIT LOCAL VARIABLES", b))
    }
    each func.define_decls as decl {
        alloca_scope.append_value(vgen_decl_offset(decl, b))
    }
    if func.define_decls.length > 0 {
        alloca_scope.append_value(vgen_ir_comment("END LOCAL VARIABLES", b))
    }

    // Entrance functions explicitly choose the splice point with @allocas.
    // Every other function executes the generated scope before its parsed body.
    if !func.is_entrance {
        body_scope.values.prepend(vgen_allocas(alloca_scope.values, b))
    }
}

////////////////////////////
// Statement temporaries
////////////////////////////

fn append_buffer_clears(ctx: Context, values: Array[Value], func: Func, first: uint, at: ?Exp) {
    let i = first
    while i < func.buffers_used.length {
        let decl = func.buffers_used.get(i) ! break
        i++
        // Direct managed references can keep a large object graph alive and
        // make every later collection walk it. Clear those roots explicitly;
        // aggregate buffers may retain their value until the frame exits.
        if !decl.is_gc : continue
        values.append(vgen_assign(
            vgen_decl(decl),
            vgen_null(decl.type),
            ASSIGN_OP.set,
            ctx.build,
            at
        ))
    }
}

// True when releasing back to `first` would leave a managed object rooted for
// the rest of the frame. Asked first so a statement needing no clears builds no
// block wrapper. Same handful of entries the clear loop walks; keeping the count
// instead would mean threading a second mark through every caller.
fn buffers_need_clear(func: Func, first: uint) bool {
    let i = first
    while i < func.buffers_used.length {
        let decl = func.buffers_used.get(i) ! return false
        if decl.is_gc : return true
        i++
    }
    return false
}

fn finish_body_value_buffers(ctx: Context, func: Func, first: uint, at: Exp, value: ?Value) ?Value {
    if !buffers_need_clear(func, first) {
        func_release_buffers(func, first)
        return value
    }

    let statements = Array[Value]{}
    if isset(value) : statements.append(value)
    append_buffer_clears(ctx, statements, func, first, at)
    func_release_buffers(func, first)
    return vgen_block(statements, ctx.build, at)
}

////////////////////////////
// Body expression ranges
////////////////////////////

// Lower a contiguous body-expression range. `#loop globals G T` recursively
// lowers its enclosed range once for every Global, with G and T rebound for
// that iteration.
fn append_body_exp_range(ctx: Context, scope: Scope, state: ParseState, exps: Array[Exp], start: uint, end: uint) !Error {
    let i = start
    while i < end {
        let exp = exps.get(i) ! ctx.build.bug("Missing function-body expression")
        if exp.type == EXP.macro && exp.kind == MACRO_KIND.loop && !state.is_skipping() {
            state.saw_macro = true
            let close = find_macro_loop_end(exps, i, end, exp) !>
            let words = exp.list
            let loop_kind = isset(words) ? (words.get(0) !? "") : ""
            if loop_kind == "globals" {
                append_globals_loop(ctx, scope, exps, i + 1, close, exp) !>
            } else if loop_kind == "gc_roots" {
                append_gc_roots_loop(ctx, scope, exps, i + 1, close, exp) !>
            } else if loop_kind == "tests" {
                append_tests_loop(ctx, scope, exps, i + 1, close, exp) !>
            } else if loop_kind == "object" {
                append_object_loop(ctx, scope, exps, i + 1, close, exp) !>
            } else if loop_kind == "properties" {
                append_properties_loop(ctx, scope, exps, i + 1, close, exp) !>
            } else {
                exp.error("Unknown '#loop' kind: " + loop_kind)
            }
            i = close + 1
            continue
        }
        let v = body_value_from_exp(ctx, scope, state, exp) !>
        if isset(v) : scope.append_value(v)
        i++
    }
}

fn append_gc_roots_loop(ctx: Context, scope: Scope, exps: Array[Exp], start: uint, end: uint, loop_exp: Exp) !Error {
    let words = loop_exp.list
    if !isset(words) {
        loop_exp.error("Expected '#loop gc_roots GLOBAL OFFSET'")
    }
    if words.length != 3 || (words.get(0) !? "") != "gc_roots" {
        loop_exp.error("Expected '#loop gc_roots GLOBAL OFFSET'")
    }
    let global_name = words.get(1) ! loop_exp.bug("Missing #loop gc_roots global")
    let offset_name = words.get(2) ! loop_exp.bug("Missing #loop gc_roots offset binding")
    let idf = scope.get_idf(global_name)
    if !isset(idf) {
        loop_exp.error("Expected a global after '#loop gc_roots'")
    }
    if idf.type != IDF.global {
        loop_exp.error("Expected a global after '#loop gc_roots'")
    }
    let global = idf.global
    if !isset(global) : loop_exp.bug("GC-roots loop global binding is missing its global")
    let offsets = global.get_gc_root_offsets() !>

    each offsets as offset {
        let iter_scope = scope.sub_scope()
        iter_scope.set_idf(offset_name, Idf.for_value(vgen_int(offset.to(int), type_int(ctx.build))))
        let iter_state = ParseState.new()
        append_body_exp_range(ctx, iter_scope, iter_state, exps, start, end) !>
        if iter_state.has_open_if() || iter_state.is_skipping() {
            loop_exp.error("Missing compile macro '#end' inside '#loop gc_roots'")
        }
        each iter_scope.values as v {
            scope.append_value(v)
        }
    }
}

// Find the #end paired with a #loop. Nested #if and #loop directives both
// consume their own #end.
fn find_macro_loop_end(exps: Array[Exp], start: uint, end: uint, loop_exp: Exp) uint !Error {
    let depth: uint = 0
    let i = start + 1
    while i < end {
        let exp = exps.get(i) ! loop_exp.bug("Missing function-body expression")
        if exp.type == EXP.macro {
            let kind = exp.kind.@cast(MACRO_KIND)
            if kind == MACRO_KIND.if || kind == MACRO_KIND.loop {
                depth++
            } else if kind == MACRO_KIND.end {
                if depth == 0 : return i
                depth--
            }
        }
        i++
    }
    loop_exp.error("Missing compile macro '#end' for '#loop'")
}

fn append_globals_loop(ctx: Context, scope: Scope, exps: Array[Exp], start: uint, end: uint, loop_exp: Exp) !Error {
    let words = loop_exp.list
    if !isset(words) {
        loop_exp.error("Expected '#loop globals GLOBAL TYPE'")
    }
    if words.length != 3 {
        loop_exp.error("Expected '#loop globals GLOBAL TYPE'")
    }
    let loop_kind = words.get(0) !? ""
    if loop_kind != "globals" {
        loop_exp.error("Expected '#loop globals GLOBAL TYPE'")
    }
    let global_name = words.get(1) ! loop_exp.bug("Missing #loop global binding")
    let type_name = words.get(2) ! loop_exp.bug("Missing #loop type binding")

    let owner = ctx.func
    if isset(owner) && !owner.has_globals_loop {
        owner.has_globals_loop = true
        ctx.build.pipeline.globals_loop_funcs.append(owner, true)
    }

    // Only the globals something actually uses. Which those are is not known
    // while this runs — the set starts empty and this function is lowered
    // again as it grows (see resolve_globals_loops).
    each ctx.build.lists.globals as global {
        if !global.is_used : continue
        let iter_scope = scope.sub_scope()
        iter_scope.set_idf(global_name, Idf.for_global(global))
        iter_scope.set_idf(type_name, Idf.for_type(global.get_type() !>))
        let iter_state = ParseState.new()
        append_body_exp_range(ctx, iter_scope, iter_state, exps, start, end) !>
        if iter_state.has_open_if() || iter_state.is_skipping() {
            loop_exp.error("Missing compile macro '#end' inside '#loop globals'")
        }
        each iter_scope.values as v {
            scope.append_value(v)
        }
    }
}

fn append_object_loop(ctx: Context, scope: Scope, exps: Array[Exp], start: uint, end: uint, loop_exp: Exp) !Error {
    let words = loop_exp.list
    if !isset(words) {
        loop_exp.error("Expected '#loop object VALUE as PROPERTY'")
    }
    if words.length != 4 || (words.get(0) !? "") != "object" || (words.get(2) !? "") != "as" {
        loop_exp.error("Expected '#loop object VALUE as PROPERTY'")
    }
    let value_name = words.get(1) ! loop_exp.bug("Missing object-loop value")
    let prop_name = words.get(3) ! loop_exp.bug("Missing object-loop binding")
    let idf = scope.get_idf(value_name)
    if !isset(idf) {
        loop_exp.error("Expected a variable after '#loop object'")
    }
    if idf.type != IDF.decl {
        loop_exp.error("Expected a variable after '#loop object'")
    }
    let decl = idf.decl
    if !isset(decl) : loop_exp.bug("Object-loop variable is missing its declaration")
    let class = decl.type.get_non_nullable().get_class_or_null()
    if !isset(class) : return
    let owner = vgen_decl(decl)

    each class.props as prop {
        let iter_scope = scope.sub_scope()
        iter_scope.func = scope.func
        iter_scope.set_idf(prop_name, Idf.for_object_property(prop, vgen_prop(prop, owner)))
        let iter_state = ParseState.new()
        append_body_exp_range(ctx, iter_scope, iter_state, exps, start, end) !>
        if iter_state.has_open_if() || iter_state.is_skipping() {
            loop_exp.error("Missing compile macro '#end' inside '#loop object'")
        }
        each iter_scope.values as v {
            scope.append_value(v)
        }
    }
}

fn append_tests_loop(ctx: Context, scope: Scope, exps: Array[Exp], start: uint, end: uint, loop_exp: Exp) !Error {
    let words = loop_exp.list
    if !isset(words) {
        loop_exp.error("Expected '#loop tests as TEST_FUNC'")
    }
    if words.length != 3 || (words.get(0) !? "") != "tests" || (words.get(1) !? "") != "as" {
        loop_exp.error("Expected '#loop tests as TEST_FUNC'")
    }
    let func_name = words.get(2) ! loop_exp.bug("Missing #loop test binding")

    each ctx.build.lists.tests as func {
        let iter_scope = scope.sub_scope()
        iter_scope.func = scope.func
        iter_scope.set_idf(func_name, Idf.for_func(func))
        iter_scope.set_idf("TEST_IS_SYNC", Idf.for_value(vgen_bool(func.is_sync, type_bool(ctx.build))))
        let iter_state = ParseState.new()
        append_body_exp_range(ctx, iter_scope, iter_state, exps, start, end) !>
        if iter_state.has_open_if() || iter_state.is_skipping() {
            loop_exp.error("Missing compile macro '#end' inside '#loop tests'")
        }
        each iter_scope.values as v {
            scope.append_value(v)
        }
    }
}

fn append_properties_loop(ctx: Context, scope: Scope, exps: Array[Exp], start: uint, end: uint, loop_exp: Exp) !Error {
    let words = loop_exp.list
    if !isset(words) {
        loop_exp.error("Expected '#loop properties TYPE as PROPERTY'")
    }
    if words.length != 4 || (words.get(0) !? "") != "properties" || (words.get(2) !? "") != "as" {
        loop_exp.error("Expected '#loop properties TYPE as PROPERTY'")
    }
    let type_name = words.get(1) ! loop_exp.bug("Missing property-loop type")
    let prop_name = words.get(3) ! loop_exp.bug("Missing property-loop binding")
    let type = property_loop_type(scope, type_name, loop_exp) !>
    let class = type.get_non_nullable().get_class_or_null()
    if !isset(class) : return

    each class.props as prop {
        let iter_scope = scope.sub_scope()
        iter_scope.func = scope.func
        iter_scope.set_idf(prop_name, Idf.for_property(prop))
        let iter_state = ParseState.new()
        append_body_exp_range(ctx, iter_scope, iter_state, exps, start, end) !>
        if iter_state.has_open_if() || iter_state.is_skipping() {
            loop_exp.error("Missing compile macro '#end' inside '#loop properties'")
        }
        each iter_scope.values as v {
            scope.append_value(v)
        }
    }
}

////////////////////////////
// Statement lowering
////////////////////////////

// Convert one body-level EXP into a Value. Returns null for comments / skipped #if.
fn body_value_from_exp(ctx: Context, scope: Scope, state: ParseState, exp: Exp) ?Value !Error {
    let func = ctx.get_func() !>
    let first = func.buffers_used.length
    let value = body_value_from_exp_inner(ctx, scope, state, exp) !>
    return finish_body_value_buffers(ctx, func, first, exp, value)
}

fn body_value_from_exp_inner(ctx: Context, scope: Scope, state: ParseState, exp: Exp) ?Value !Error {
    if exp.type == EXP.macro {
        let func = ctx.get_func() !>
        state.saw_macro = true
        parse_macro_exp(func.ns, scope, state, exp) !>
        return null
    }
    if state.is_skipping() : return null

    // Every statement of every block passes through here, and `did_return` is set
    // by whatever ended the path before this one, so this is where dead code is
    // visible. Macros, skipped branches and comments are already out above.
    if scope.did_return && !state.saw_macro : warn_unreachable(ctx, scope, exp)

    if exp.type == EXP.let : return value_from_let_exp(ctx, scope, exp) !>
    if exp.type == EXP.return : return value_from_return_exp(ctx, scope, exp) !>
    if exp.type == EXP.defer : return value_from_defer_exp(ctx, scope, exp) !>
    if exp.type == EXP.assign : return value_from_assign_exp(ctx, scope, exp) !>
    if exp.type == EXP.stmt {
        return value_from_stmt_exp(ctx, scope, exp) !>
    }
    if exp.type == EXP.if : return value_from_if_exp(ctx, scope, state, exp) !>
    if exp.type == EXP.while : return value_from_while_exp(ctx, scope, state, exp) !>
    if exp.type == EXP.each : return value_from_each_exp(ctx, scope, state, exp) !>
    if exp.type == EXP.block : return value_from_block_exp(ctx, scope, state, exp) !>
    if exp.type == EXP.break {
        if !scope_has_loop(scope, ctx.func) {
            exp.error("Using 'break' without being inside a loop")
        }
        // `break` terminates this control-flow path. This lets an enclosing
        // `if !isset(x)` carry the false-branch non-null proof forward.
        scope.did_return = true
        scope_mark_break(scope, ctx.func)
        return vgen_break(ctx.build, exp)
    }
    if exp.type == EXP.continue {
        if !scope_has_loop(scope, ctx.func) {
            exp.error("Using 'continue' without being inside a loop")
        }
        // Same path-termination semantics as break for flow analysis.
        scope.did_return = true
        return vgen_continue(ctx.build, exp)
    }
    if exp.type == EXP.allocas {
        let func = ctx.get_func() !>
        if !func.is_entrance {
            exp.error("@allocas can only be used inside a function that's flagged with $entrance")
        }
        let alloca_scope = func.alloca_scope
        if !isset(alloca_scope) : exp.bug("Function is missing its generated alloca scope")
        return vgen_allocas(alloca_scope.values, ctx.build, exp)
    }
    if exp.type == EXP.init_allocators {
        return vgen_init_allocators(scope, ctx, exp)
    }
    if exp.type == EXP.ir_comment {
        return vgen_ir_comment(strip_quotes(exp.str1), ctx.build, exp)
    }
    if exp.type == EXP.throw : return value_from_throw_exp(ctx, scope, exp) !>

    // Already an EXP.value used as a statement
    if exp.type == EXP.value {
        return value_from_exp(exp, scope, ctx.without_suggested_type()) !>
    }

    exp.bug("Unhandled body expression type: " + exp.type)
}

// ---- Body value constructors ----

// Reject a loop body that relies on a non-null fact established before the loop while
// also assigning that declaration a possibly-null value.
//
// The body is parsed with the entry facts in place, which is correct for the first
// iteration only: after `x = null` runs, the next iteration starts with x unset, so any
// earlier use in the body was checked against a fact that no longer holds. Rather than
// re-analysing the body (parsing builds decls and values, so it cannot simply run
// twice), the body records which entry facts it actually consulted; the two sets
// intersecting is exactly the unsound case. A body that invalidates a fact it never
// relied on is fine, and so is one that re-proves the fact inside the loop.
fn scope_check_loop_trusted_facts(body_scope: Scope, exp: Exp) !Error {
    each body_scope.loop_trusted as decl {
        if !body_scope.loop_invalidated.contains(decl) : continue
        let name = decl.name ?? "value"
        exp.error("'" + name + "' is used as a non-null value inside this loop, but the loop also assigns it a possibly-null value. The check before the loop only covers the first iteration — check it inside the loop instead (e.g. with 'isset').")
    }
}

// Drop the non-null facts a loop body invalidates, keeping the rest.
//
// A loop runs zero or more times and can leave through `break`, so a fact established
// before it only survives when the body never assigns the declaration a possibly-null
// value. The body's sticky record (loop_invalidated) is what matters, not its final
// state: `if c { x = null; break }` followed by `x = "b"` ends the body with the fact
// re-established, yet the break edge leaves the loop with x null.
//
// Note the body is parsed with these facts still in place, so code inside the loop
// trusts them; a body that invalidates a fact only after using it can still defeat
// that. Closing it needs a loop fixed-point (or a pre-pass over the body's assignment
// targets) and is unchanged here — this decides only what holds after the loop.
fn scope_clear_facts_invalidated_by(scope: Scope, body_scope: Scope) {
    let loop_facts = scope.not_null.copy()
    each loop_facts as decl {
        if body_scope.loop_invalidated.contains(decl) : scope.clear_not_null(decl)
    }
}

fn value_from_let_exp(ctx: Context, scope: Scope, exp: Exp) Value !Error {
    let b = ctx.build
    let names = exp.list
    if !isset(names) : exp.bug("let is missing names")
    if names.length == 0 : exp.bug("let is missing names")

    let types_exp = exp.get(LET_EXP.types)
    let value_exp = exp.get(LET_EXP.value)
    if !isset(value_exp) : exp.bug("let is missing RHS value")

    // Single declared type becomes a suggestion for the whole RHS (null, class init, …)
    let rhs_ctx = ctx.without_suggested_type()
    if isset(types_exp) && names.length == 1 {
        let te = types_exp.get(0)
        if isset(te) && te.type == EXP.type {
            rhs_ctx = ctx.with_suggested_type(type_from_exp(te, scope) !>)
        }
    }

    let rhs = value_from_exp(value_exp, scope, rhs_ctx) !>
    let rhs_parts = rhs.unroll()

    if names.length > rhs_parts.length {
        exp.error("Right side of '=' does not return enough values for the declared variables")
    }

    let statements = Array[Value]{}
    let i: uint = 0
    each names as name {
        let part = rhs_parts.get(i) ! exp.error("Missing value for variable '" + name + "'")
        let part_is_non_null = value_stores_non_null(part, scope)
        // Inferred declarations must keep the resolved RHS type. A void RHS is
        // rejected below unless an explicit declaration type replaces it
        // (notably `let x: T = @undefined`).
        let decl_type = part.rett
        if isset(types_exp) {
            let te = types_exp.get(i)
            if isset(te) && te.type == EXP.type {
                let explicit = type_from_exp(te, scope) !>
                if !part.rett.is_void_type() {
                    // Apply int→ptr / number widen / $to before requiring exact compat
                    part = value_try_convert(part, scope, ctx, explicit)
                    // Prefer RHS value span for errors (not the whole `let` line)
                    let at = part.exp ?? exp
                    explicit.compat_check(part.rett, at) !>
                }
                decl_type = explicit
            }
        }
        if decl_type.is_void_type() {
            exp.error("You cannot declare a variable of type 'void'")
        }

        if name != "_" {
            if scope.has_local(name) {
                exp.error("Name already used in this scope: " + name)
            }
            let decl = Decl.new(ctx.get_func() !>, decl_type, false, name)
            decl.exp = exp
            scope.add_decl(decl)
            scope.set_idf(name, Idf.for_decl(decl))
            if part.type != VAL.undefined {
                statements.append(vgen_assign(vgen_decl(decl), part, ASSIGN_OP.set, b, exp))
                if part_is_non_null : scope.mark_not_null(decl)
            }
        } else if part.type != VAL.undefined {
            // `_` still evaluates its RHS, but has no destination storage.
            statements.append(part)
        }
        i++
    }

    return vgen_block(statements, b, exp)
}

fn value_from_return_exp(ctx: Context, scope: Scope, exp: Exp) Value !Error {
    let b = ctx.build
    let value_exp = exp.get(RETURN_EXP.value)

    // `return` inside `<{...}` yields a value for the vscope (not the function).
    let vscope = scope.find_vscope()
    if isset(vscope) {
        return value_from_vscope_return_exp(ctx, scope, vscope, exp, value_exp) !>
    }

    let func = ctx.get_func() !>
    if func.must_exit || func.will_exit {
        exp.error("You cannot use 'return' in a function that's marked with '$exit'")
    }

    let rett = func.get_rett()
    let retv: ?Value = null

    if rett.is_void_type() {
        if isset(value_exp) {
            exp.error("Function returns void; 'return' must not have a value")
        }
    } else {
        if !isset(value_exp) {
            exp.error("Function must return a value of type matching the signature")
        }
        retv = value_from_exp(value_exp, scope, ctx.with_suggested_type(rett)) !>
        // Skip when returned type is still void (incomplete typing)
        if !retv.rett.is_void_type() {
            retv = value_try_convert(retv, scope, ctx, rett)
            let at = retv.exp ?? exp
            rett.compat_check(retv.rett, at) !>
        }
    }

    scope.did_return = true
    return vgen_return(retv, b, exp)
}

////////////////////////////
// Defer
////////////////////////////

// Register a deferred call. Each execution creates a zero-argument closure,
// which snapshots the locals it uses, and appends it to a hidden function-local
// stack. This makes defer inside conditions and loops dynamic while keeping the
// cleanup path shared by return, throw, error propagation, and fallthrough.
fn value_from_defer_exp(ctx: Context, scope: Scope, exp: Exp) Value !Error {
    let value_exp = exp.get(DEFER_EXP.value)
    if !isset(value_exp) : exp.error("Expected a function call after 'defer'")
    if !defer_exp_is_call(value_exp) {
        value_exp.error("'defer' expects a function call")
    }

    let func = ctx.get_func() !>
    let closure = make_defer_closure(func, scope, value_exp, exp) !>
    let stack = ensure_user_defer_stack(func, exp) !>
    let stack_class = stack.type.get_class_or_null()
    if !isset(stack_class) : exp.bug("Deferred-call stack has no Array class")
    let append = stack_class.get_func("append")
    if !isset(append) : exp.bug("Array[fn()].append is missing")
    if !append.parsed_types : parse_func_types(append) !>

    // Array.append has an optional `unique` argument, but generated calls use
    // the complete ABI directly, so supply its default explicitly.
    let call = vgen_call(
        ctx,
        vgen_func(append, vgen_decl(stack)),
        Array[Value]{ closure, vgen_bool(false, type_bool(ctx.build)) },
        append.get_rett(),
        scope
    )
    call.exp = exp
    return call
}

fn defer_exp_is_call(exp: Exp) bool {
    if exp.type != EXP.value : return false
    if exp.kind == VALUE_KIND.call : return true
    if exp.kind != VALUE_KIND.error_handler : return false
    let call = exp.get(VALUE_EXP.left)
    return isset(call) && call.type == EXP.value && call.kind == VALUE_KIND.call
}

// Create the hidden Array[fn()()] on first use and splice its initialization
// into the function prologue. The cleanup marker is inserted before the test
// result and GC-frame cleanup values that func_finish_ast appends later.
fn ensure_user_defer_stack(func: Func, at: Exp) Decl !Error {
    let existing = func.user_defer_stack
    if isset(existing) : return existing

    let b = func.ns.build
    let closure_type = Type {
        type: TYPE.fn
        build: b
        sub_type: type_void(b)
        sub_types: Array[Type]{}
    }
    let array_idf = valk_idf(b, "core", "Array") !>
    let array_base = array_idf.class
    if !isset(array_base) : at.bug("valk:core:Array is missing")
    let array_class = array_base.specialize(Array[Type]{ closure_type }, at) !>
    let stack_type = array_class.get_type() !>

    let body_scope = func.body_scope
    let alloca_scope = func.alloca_scope
    let defer_scope = func.defer_scope
    if !isset(body_scope) || !isset(alloca_scope) || !isset(defer_scope) {
        at.bug("Function scopes are missing while creating a defer stack")
    }
    let stack = Decl.new(func, stack_type, false)
    body_scope.add_decl(stack)
    func.user_defer_stack = stack

    let new_func = array_class.get_func("new")
    let pop_func = array_class.get_func("pop_last")
    if !isset(new_func) || !isset(pop_func) {
        at.bug("Array[fn()] is missing new() or pop_last()")
    }
    if !new_func.parsed_types : parse_func_types(new_func) !>
    if !pop_func.parsed_types : parse_func_types(pop_func) !>
    func.user_defer_pop = pop_func

    let init = vgen_call(
        Context.for_func(func),
        vgen_func(new_func),
        Array[Value]{ vgen_int(0, type_from_core(b, "uint") !>) },
        new_func.get_rett(),
        alloca_scope
    )
    init.exp = at
    alloca_scope.append_value(vgen_assign(vgen_decl(stack), init, ASSIGN_OP.set, b, at))
    defer_scope.append_value(vgen_run_defers(stack, pop_func, b, at))
    return stack
}

// A defer registration is represented as an ordinary closure. Resolve its call
// in that closure's context so identifier evaluation creates hidden capture
// arguments directly, just as it does for a source-level function literal.
fn make_defer_closure(owner: Func, scope: Scope, deferred_exp: Exp, at: Exp) Value !Error {
    let arg_scope = scope.sub_scope()
    let func = Func {
        unit: owner.unit
        ns: owner.ns
        // Include the owning specialization. A defer in a generic function is
        // lowered once per concrete Func, while its source offset stays the
        // same; the owner name keeps those LLVM symbols distinct.
        name: "<defer." + owner.name + ">"
        act: ACT.private
        exp: at
        arg_scope: arg_scope
        is_literal: true
        parsed_types: true
        parsed_ast: true
    }
    arg_scope.func = func
    let body_scope = arg_scope.sub_scope()
    body_scope.func = func
    let inner_ctx = Context.for_func(func).without_suggested_type()
    let first_buffer = func.buffers_used.length
    let deferred_value: ?Value = null
    if deferred_exp.type == EXP.value && deferred_exp.kind == VALUE_KIND.call {
        // A bare fallible call must be diagnosed as an invalid defer, not
        // automatically passed through the synthetic closure.
        deferred_value = value_from_call_raw(deferred_exp, body_scope, inner_ctx) !>
    } else {
        deferred_value = value_from_exp(deferred_exp, body_scope, inner_ctx) !>
    }
    let deferred = deferred_value ?! deferred_exp.bug("Deferred call did not produce a value")
    if deferred.can_error || (deferred.type == VAL.error_handler && deferred.op == ERRH_KIND.pass) {
        deferred_exp.error("A deferred call must handle its error before the function exits")
    }
    body_scope.append_value(deferred)
    append_buffer_clears(inner_ctx, body_scope.values, func, first_buffer, deferred_exp)
    func_release_buffers(func, first_buffer)
    func.body_scope = body_scope
    func.alloca_scope = body_scope.sub_scope()
    func.defer_scope = body_scope.sub_scope()
    owner.unit.functions.append(func)

    func_finish_ast(func) !>
    func_prepare_closure(func) !>
    if !isset(owner.ns.build.options.lsp) : generate_func_ir(func) !>

    let closure = vgen_func(func)
    closure.exp = at
    return closure
}

////////////////////////////
// Value scopes and assignment
////////////////////////////

// Return from a value scope: collect into vscope_returns / unify vscope_rett.
fn value_from_vscope_return_exp(ctx: Context, scope: Scope, vscope: Scope, exp: Exp, value_exp: ?Exp) Value !Error {
    let b = ctx.build
    if !isset(value_exp) {
        exp.error("Value scope return must have a value")
    }
    let returns = vscope.vscope_returns ?! exp.bug("Missing value scope return values")
    let known = vscope.vscope_rett
    let ret_ctx = ctx.without_suggested_type()
    if isset(known) : ret_ctx = ctx.with_suggested_type(known)

    let retv = value_from_exp(value_exp, scope, ret_ctx) !>
    if isset(known) {
        if !retv.rett.is_void_type() && !known.is_void_type() {
            // A branch returning a nullable value widens the result to `?T`, even when
            // the expectation came from a declaration or an argument. The mismatch is
            // then reported where the scope is used — `let x: String = <{ … }` points at
            // the assignment — instead of being buried on an inner return.
            // Returns collected before the widening are re-wrapped so every incoming
            // edge of the phi carries the widened representation: `?T` and `T` differ
            // for inline types, so this cannot be a rett-only change.
            if retv.rett.is_nullable_type() && !known.is_nullable_type() {
                known = known.nullable()
                vscope.vscope_rett = known
                each returns as prev {
                    let pv = prev.value1
                    if !isset(pv) : exp.bug("Value scope return has no value")
                    prev.value1 = value_make_nullable(pv, prev.exp ?? exp) !>
                }
            }
            retv = value_try_convert(retv, scope, ctx, known)
            let at = retv.exp ?? exp
            known.compat_check(retv.rett, at) !>
        }
    } else {
        retv = value_try_remove_nullable(retv, scope, ctx)
        vscope.vscope_rett = retv.rett
    }
    scope.did_return = true
    // Represent as a return of the value (IR later jumps to vscope after-block)
    let ret = vgen_return(retv, b, exp)
    returns.append(ret)
    return ret
}

fn value_from_assign_exp(ctx: Context, scope: Scope, exp: Exp) Value !Error {
    let b = ctx.build
    let left_exp = exp.get(ASSIGN_EXP.left)
    let right_exp = exp.get(ASSIGN_EXP.right)
    if !isset(left_exp) || !isset(right_exp) : exp.bug("assign is missing operands")

    // `on[index] = value` on a class with a `$offset_assign` hook — bypass the
    // read/assignable path entirely and call the hook directly.
    if left_exp.type == EXP.value && left_exp.kind == VALUE_KIND.offset && exp.kind.@cast(ASSIGN_OP) == ASSIGN_OP.set {
        let handled = value_from_offset_assign_exp(ctx, scope, left_exp, right_exp, exp) !>
        if isset(handled) : return handled
    }

    // `name = value` overwrites without reading, so the destination is resolved in
    // a context that says so. Only a bare name and only a plain `=`: a compound
    // operator reads the old value first, and any other lvalue form (`x.f`, `x[i]`)
    // reads what it navigates through.
    let op = exp.kind.@cast(ASSIGN_OP)
    let left_ctx = ctx.without_suggested_type()
    if op == ASSIGN_OP.set && left_exp.type == EXP.value && left_exp.kind == VALUE_KIND.id {
        left_ctx = ctx.for_store_target()
    }
    let left = value_from_exp(left_exp, scope, left_ctx) !>
    let pointer_offset_assign = left.rett.get_non_nullable().type == TYPE.ptr && (op == ASSIGN_OP.add || op == ASSIGN_OP.sub)
    // Suggest the left-hand type for the RHS (null, class init, etc.)
    let right_ctx = ctx.without_suggested_type()
    if pointer_offset_assign : right_ctx = ctx.with_suggested_type(type_int(b))
    else if !left.rett.is_void_type() : right_ctx = ctx.with_suggested_type(left.rett)
    let right = value_from_exp(right_exp, scope, right_ctx) !>
    // `@undefined` means that no store is emitted. This is deliberately not a
    // value of the destination type; it retains `void` as its return type.
    if right.type == VAL.undefined {
        return vgen_block(Array[Value]{}, b, exp)
    }
    // Preserve whether the source expression is definitely non-null. Converting
    // it for assignment to `?T` wraps its result type as nullable, but the stored
    // value is still known to be set on this path.
    let right_is_non_null = value_stores_non_null(right, scope)

    if !left.assignable() {
        exp.error("Left side of assignment is not assignable")
    }
    act_check_assign(left, exp) !>
    value_mark_mutable(left)

    // Storing `null` drops a reference, which the collector observes: the point of
    // `x = null` is the store itself, so it is not a dead one even when nothing
    // reads x afterwards. Counted as a use so warn_unused_decls stays quiet.
    if right.type == VAL.null && left.type == VAL.decl {
        let ld = left.decl
        if isset(ld) : ld.is_read = true
    }

    // Compound `+=` uses the same `$add` resolution as `left + right`, then
    // stores the hook result. The classic compiler lowered compound operators
    // through value_handle_op before creating its plain assignment token.
    if op == ASSIGN_OP.add {
        let hook_left = value_try_remove_nullable(left, scope, ctx)
        let hook_right = value_try_remove_nullable(right, scope, ctx)
        let hooked = value_try_add_hook(hook_left, hook_right, scope, ctx, exp) !>
        if isset(hooked) {
            right = hooked
            op = ASSIGN_OP.set
        } else if !pointer_offset_assign {
            let left_class = left.rett.get_class_or_null()
            if isset(left_class) && !left.rett.is_number_type() {
                exp.error("Cannot do math operations on types: '" + left.rett.compat_display_name() + "' <> '" + right.rett.compat_display_name() + "'")
            }
        }
    }

    if !left.rett.is_void_type() && !right.rett.is_void_type() {
        if pointer_offset_assign {
            right = value_try_convert(right, scope, ctx, type_int(b))
            if !right.rett.is_integer_type() {
                right_exp.error("Pointer offset must be an integer, got: " + right.rett.compat_display_name())
            }
            if op == ASSIGN_OP.sub {
                right = vgen_unary(right, VALUE_OP.neg, right.rett)
            }
            right = vgen_ptr_offset(left, right, exp)
            op = ASSIGN_OP.set
        } else {
            right = value_try_convert(right, scope, ctx, left.rett)
            let at = right.exp ?? exp
            left.rett.compat_check(right.rett, at) !>
        }
    }

    // A direct assignment of a non-null value proves the local non-null for the
    // remainder of this control-flow path.
    if op == ASSIGN_OP.set && left.type == VAL.decl && right_is_non_null {
        let decl = left.decl
        if isset(decl) : scope.mark_not_null(decl)
    } else if op == ASSIGN_OP.set && left.type == VAL.decl {
        let decl = left.decl
        if isset(decl) : scope.clear_not_null(decl)
    }

    return vgen_assign(left, right, op, b, exp, ctx)
}

fn value_from_stmt_exp(ctx: Context, scope: Scope, exp: Exp) Value !Error {
    // Expression statement — the value itself (call, etc.); not wrapped
    let value_exp = exp.get(STMT_EXP.value)
    if !isset(value_exp) : exp.bug("statement is missing value")
    return value_from_exp(value_exp, scope, ctx.without_suggested_type()) !>
}

////////////////////////////
// Control flow
////////////////////////////

fn value_from_if_exp(ctx: Context, scope: Scope, state: ParseState, exp: Exp) Value !Error {
    let b = ctx.build
    let cond_exp = exp.get(IF_EXP.cond)
    if !isset(cond_exp) : exp.bug("if is missing condition")
    let cond = value_from_exp(cond_exp, scope, ctx.with_suggested_type(type_bool(b))) !>
    let cr = cond.rett
    if !cr.is_void_type() && !cr.is_bool_type() && cr.type != TYPE.any {
        exp.error("The if condition value must be of type bool")
    }

    // True branch: decls proven non-null by isset / && in the condition
    let then_scope = scope.sub_scope()
    then_scope.apply_issets(cond.issets)
    let then_body = exp.get(IF_EXP.then_body)
    let then_vals = Array[Value]{}
    if isset(then_body) {
        then_vals = body_values_from_nested(ctx, then_scope, state, then_body) !>
    }

    let else_v: ?Value = null
    // Even without a written else, model the false path so its not-isset facts
    // can be intersected with facts established by the true branch.
    let es = scope.sub_scope()
    es.apply_issets(cond.not_issets)
    let else_body = exp.get(IF_EXP.else_body)
    if isset(else_body) {
        // False branch: not_issets from `||` / `!isset` style conditions
        let else_vals = body_values_from_nested(ctx, es, state, else_body) !>
        else_v = vgen_block(else_vals, b, else_body)
        if then_scope.did_return && es.did_return {
            scope.did_return = true
        }
    }

    // A fact invalidated on a reachable path cannot survive the if: after
    // `if c { x = null }` the declaration is only maybe-set again. Each branch
    // scope records its final state, so a branch that assigns null and later
    // re-assigns non-null reports the fact, not the invalidation. Clearing runs
    // before the merge below so a fact both branches re-establish still wins.
    if !then_scope.did_return {
        each then_scope.not_null_removed as decl {
            scope.clear_not_null(decl)
        }
    }
    if !es.did_return {
        each es.not_null_removed as decl {
            scope.clear_not_null(decl)
        }
    }

    // Facts after the if are those guaranteed by every reachable branch.
    if then_scope.did_return {
        scope.apply_issets(es.not_null)
    } else if es.did_return {
        scope.apply_issets(then_scope.not_null)
    } else {
        let common = Array[Decl]{}
        each then_scope.not_null as decl {
            if es.not_null_check(decl) : common.append(decl, true)
        }
        each es.not_null as decl {
            if then_scope.not_null_check(decl) : common.append(decl, true)
        }
        scope.apply_issets(common)
    }

    return vgen_if(cond, then_vals, else_v, b, exp)
}

fn value_from_while_exp(ctx: Context, scope: Scope, state: ParseState, exp: Exp) Value !Error {
    let b = ctx.build
    let cond_exp = exp.get(WHILE_EXP.cond)
    if !isset(cond_exp) : exp.bug("while is missing condition")
    let cond = value_from_exp(cond_exp, scope, ctx.with_suggested_type(type_bool(b))) !>
    let cr = cond.rett
    if !cr.is_void_type() && !cr.is_bool_type() && cr.type != TYPE.any {
        exp.error("The while condition value must be of type bool")
    }

    // Body runs only when condition is true — apply isset proofs
    let body_scope = scope.sub_scope()
    body_scope.is_loop = true
    body_scope.apply_issets(cond.issets)
    let body_exp = exp.get(WHILE_EXP.body)
    let body_vals = Array[Value]{}
    if isset(body_exp) {
        body_vals = body_values_from_nested(ctx, body_scope, state, body_exp) !>
    }
    scope_check_loop_trusted_facts(body_scope, exp) !>
    scope_clear_facts_invalidated_by(scope, body_scope)
    // `while true` with nothing breaking out of it never reaches the statement
    // after it: the only ways out are `return`, a throw, or leaving the process.
    if cond.type == VAL.bool && cond.bool_val && !body_scope.did_break {
        scope.did_return = true
    }
    return vgen_while(cond, body_vals, b, exp)
}

// `each on [skip n] as name[, name...] { ... }` / `each ... : stmt`
//
// Desugars to:
//   let __on = on
//   let __i: index_type = skip ?? 0
//   while true {
//     let name1[, name2, ...][, index_name] = __on._next(__i) ! { break }
//     __i += 1
//     <body>
//   }
// The index-advance runs before <body> so an early `continue` in the body still
// advances the loop (there is no loop-aware lowering for `continue` to rely on).
fn value_from_each_exp(ctx: Context, scope: Scope, state: ParseState, exp: Exp) Value !Error {
    let b = ctx.build
    let on_exp = exp.get(EACH_EXP.on)
    if !isset(on_exp) : exp.bug("each is missing the iterated value")

    let on = value_from_exp(on_exp, scope, ctx.without_suggested_type()) !>
    let on_nn = value_try_remove_nullable(on, scope, ctx)
    if on_nn.rett.is_nullable_type() {
        on_exp.error("Cannot use 'each' on a nullable type: " + on_nn.rett.compat_display_name())
    }
    let class = on_nn.rett.get_class_or_null()
    if !isset(class) {
        on_exp.error("Cannot use 'each' on type: " + on_nn.rett.compat_display_name())
    }
    let next_func = class.get_func("_next")
    if !isset(next_func) {
        on_exp.error("Cannot use 'each' on type '" + on_nn.rett.compat_display_name() + "'. This type does not have a '_next' function")
    }
    // `_next`'s args include an implicit `this` first for instance methods.
    let next_arg_skip: uint = 0
    if isset(next_func.class) && !next_func.is_static : next_arg_skip = 1
    let index_arg = next_func.args.get(next_arg_skip) ! exp.bug("'_next' is missing its index parameter")
    let index_type = index_arg.type

    let names = exp.list
    if !isset(names) : exp.bug("each is missing variable names")
    if names.length == 0 : exp.bug("each is missing variable names")

    let item_rett = next_func.get_rett()
    let item_types = Array[Type]{}
    if item_rett.type == TYPE.multi {
        let subs = item_rett.sub_types
        if isset(subs) : item_types = subs
    }
    if item_types.length == 0 : item_types.append(item_rett)

    if names.length > item_types.length + 1 {
        exp.error("Too many variables for this each statement")
    }
    let has_index_name = names.length == item_types.length + 1
    let item_names_count = has_index_name ? names.length - 1 : names.length

    // Scope holding the `on` / index temporaries around the while loop.
    let each_scope = scope.sub_scope()

    let on_decl = Decl.new(ctx.get_func() !>, on_nn.rett, false, null)
    each_scope.add_decl(on_decl)
    let on_init = vgen_assign(vgen_decl(on_decl), on_nn, ASSIGN_OP.set, b, exp)

    let index_decl = Decl.new(ctx.get_func() !>, index_type, false, null)
    index_decl.is_mut = true
    each_scope.add_decl(index_decl)

    let start_value = vgen_int(0, index_type)
    let skip_exp = exp.get(EACH_EXP.skip)
    if isset(skip_exp) {
        let skip_v = value_from_exp(skip_exp, scope, ctx.with_suggested_type(index_type)) !>
        if !skip_v.rett.is_integer_type() {
            skip_exp.error("Expected an integer value for 'skip', not: " + skip_v.rett.compat_display_name())
        }
        skip_v = value_try_convert(skip_v, scope, ctx, index_type)
        index_type.compat_check(skip_v.rett, skip_exp) !>
        start_value = skip_v
    }
    let index_init = vgen_assign(vgen_decl(index_decl), start_value, ASSIGN_OP.set, b, exp)

    // Loop body scope: item/index names declared here are visible to the user body.
    let body_scope = each_scope.sub_scope()
    body_scope.is_loop = true

    let callee = vgen_func(next_func, vgen_decl(on_decl))
    let next_call = vgen_call(ctx, callee, Array[Value]{ vgen_decl(index_decl) }, item_rett, body_scope)
    next_call.exp = exp
    next_call.can_error = true
    next_call.error_type = next_func.error_type

    let handled = value_error_result(next_call, vgen_break(b, exp), item_rett, ERRH_KIND.block, exp)
    let item_parts = handled.unroll()

    let bind_decls = Array[Decl]{}
    let bind_inits = Array[Value]{}
    let i: uint = 0
    while i < item_names_count {
        let name = names.get(i) ! exp.bug("Missing each variable name")
        let part = item_parts.get(i) ! exp.error("Missing value for variable '" + name + "'")
        let item_type = item_types.get(i) ! exp.bug("Missing each item type")
        let decl = Decl.new(ctx.get_func() !>, item_type, false, name)
        decl.exp = exp
        bind_decls.append(decl)
        bind_inits.append(part)
        body_scope.add_decl(decl)
        body_scope.set_idf(name, Idf.for_decl(decl))
        i++
    }
    if has_index_name {
        let index_name = names.get(names.length - 1) ! exp.bug("Missing each index name")
        let index_user_decl = Decl.new(ctx.get_func() !>, index_type, false, index_name)
        index_user_decl.exp = exp
        bind_decls.append(index_user_decl)
        bind_inits.append(vgen_decl(index_decl))
        body_scope.add_decl(index_user_decl)
        body_scope.set_idf(index_name, Idf.for_decl(index_user_decl))
    }
    let bind_init = vgen_decl_initializers(bind_decls, bind_inits, b, exp)

    let advance = vgen_assign(vgen_decl(index_decl), vgen_int(1, index_type), ASSIGN_OP.add, b, exp)

    let body_exp = exp.get(EACH_EXP.body)
    let user_vals = Array[Value]{}
    if isset(body_exp) {
        user_vals = body_values_from_nested(ctx, body_scope, state, body_exp) !>
    }

    scope_check_loop_trusted_facts(body_scope, exp) !>
    scope_clear_facts_invalidated_by(scope, body_scope)

    let body_vals = Array[Value]{ bind_init, advance }
    body_vals.append_many(user_vals)

    let loop = vgen_while(vgen_bool(true, type_bool(b)), body_vals, b, exp)

    return vgen_block(Array[Value]{ on_init, index_init, loop }, b, exp)
}

fn value_from_block_exp(ctx: Context, scope: Scope, state: ParseState, exp: Exp) Value !Error {
    let b = ctx.build
    let body = scope.sub_scope()
    let vals = body_values_from_nested(ctx, body, state, exp) !>
    if body.did_return : scope.did_return = true
    return vgen_block(vals, b, exp)
}

fn value_from_throw_exp(ctx: Context, scope: Scope, exp: Exp) Value !Error {
    let b = ctx.build
    let func = ctx.get_func() !>
    if func.must_exit {
        exp.error("You cannot 'throw' in a function that's flagged with '$exit'")
    }
    let value_exp = exp.get(RETURN_EXP.value)
    if !isset(value_exp) : exp.bug("throw is missing value")
    let v = value_from_exp(value_exp, scope, ctx.without_suggested_type()) !>
    let thrown_type = v.rett.get_non_nullable().error_type
    if !isset(thrown_type) {
        value_exp.error("This is not an error. Value type: " + v.rett.compat_display_name())
    }
    let expected = func.error_type
    if !isset(expected) {
        exp.error("Throwing an error but your function has no error type")
    }
    if !expected.is_compat(thrown_type) {
        exp.error("Error types are not compatible: " + expected.name + " <> " + thrown_type.name)
    }
    if v.type == VAL.error_value {
        value_complete_error_payload(v, scope, ctx, exp) !>
    } else {
        // `throw E` / `throw E.code` — keep the runtime code, complete payload for
        // the caller's error type (inherit from E, explicit defaults, or error).
        let result = Value {
            type: VAL.error_value
            string_val: ""
            value1: v
            values: Array[Value]{}
            rett: type_error_code(expected)
            exp: exp
        }
        value_complete_error_payload(result, scope, ctx, exp) !>
        v = result
    }
    scope.did_return = true
    return vgen_throw(v, b, exp)
}

////////////////////////////
// Scope helpers
////////////////////////////

// A closure may be nested lexically inside a loop, but its break/continue must
// not target that outer loop. Scope.func identifies the function boundary.
fn scope_has_loop(scope: Scope, func: ?Func) bool {
    let current: ?Scope = scope
    while isset(current) {
        let owner = current.func
        if isset(owner) && owner != func : break
        if current.is_loop : return true
        current = current.parent
    }
    return false
}

// Record a `break` on the loop it leaves. Same walk as scope_has_loop, which
// has already established that there is one.
fn scope_mark_break(scope: Scope, func: ?Func) {
    let current: ?Scope = scope
    while isset(current) {
        let owner = current.func
        if isset(owner) && owner != func : return
        if current.is_loop {
            current.did_break = true
            return
        }
        current = current.parent
    }
}

// Collect Values for a then/else/while/block nested body.
fn body_values_from_nested(ctx: Context, scope: Scope, state: ParseState, exp: Exp) Array[Value] !Error {
    let out = Array[Value]{}

    if exp.type == EXP.if {
        let v = body_value_from_exp(ctx, scope, state, exp) !>
        if isset(v) : out.append(v)
        return out
    }

    if exp.type == EXP.block {
        let members = exp.body_exps
        if isset(members) {
            each members as mem {
                let v = body_value_from_exp(ctx, scope, state, mem) !>
                if isset(v) : out.append(v)
            }
            return out
        }
        let body = exp.get(BLOCK_EXP.body)
        if isset(body) {
            let exps = read_func_body_exps(body) !>
            each exps as mem {
                let v = body_value_from_exp(ctx, scope, state, mem) !>
                if isset(v) : out.append(v)
            }
        }
        return out
    }

    let v = body_value_from_exp(ctx, scope, state, exp) !>
    if isset(v) : out.append(v)
    return out
}

// Parse a function body into structured statement EXPs (no scope resolution yet).
// parse_func_ast turns each EXP into a Value (if/while/let are void Values).

// Read statements from a body EXP (`{ ... }` interior — pos is after `{`).
fn read_func_body_exps(body: Exp) Array[Exp] !Error {
    let pos = body.pos
    if !isset(pos) : body.bug("Function body is missing a Pos")
    let p = pos.copy().init_parser()
    let exps = read_func_stmts(p) !>
    if body.src.format : body.body_exps = exps
    return exps
}

// Read statements until end of body span (EOF of the body slice) or a top-level `}`.
fn read_func_stmts(p: Parser) Array[Exp] !Error {
    let exps = Array[Exp]{}
    while true {
        let t = p.tok(true, true, false) !>
        if t == TOK.end : break
        if t == TOK.sign && p.word_is("}") : break
        if t == TOK.comment {
            p.tok(true, true) !>
            exps.append(read_comment_exp(p))
            continue
        }
        if t == TOK.sign && p.word_is(";") {
            p.tok(true, true) !>
            continue
        }
        exps.append(read_func_stmt_exp(p) !>)
    }
    return exps
}

// Parse one statement starting at the current (unconsumed) token.
fn read_func_stmt_exp(p: Parser) Exp !Error {
    let new_lines = p.new_lines
    // Peek: `update=false` rewinds past skipped whitespace, so branches that need a
    // tight next token (e.g. `#if`) must re-consume with allow_space/newline first.
    let t = p.tok(true, true, false) !>

    // Compile macros: #if / #elif / #else / #end / #loop / …
    // `read_macro_exp` expects `#` already consumed (same contract as top-level parse).
    if t == TOK.sign && p.word_is("#") {
        p.tok(true, true) !> // consume `#` after peek restore
        let exp = read_macro_exp(p) !>
        exp.new_lines = new_lines
        return exp
    }

    // Nested block `{ ... }`
    if t == TOK.sign && p.word_is("{") {
        let exp = read_block_exp(p) !>
        exp.new_lines = new_lines
        return exp
    }

    if t == TOK.word {
        if p.word_is("let") {
            let exp = read_let_exp(p) !>
            exp.new_lines = new_lines
            return exp
        }
        if p.word_is("return") {
            let exp = read_return_exp(p) !>
            exp.new_lines = new_lines
            return exp
        }
        if p.word_is("if") {
            let exp = read_if_exp(p) !>
            exp.new_lines = new_lines
            return exp
        }
        if p.word_is("while") {
            let exp = read_while_exp(p) !>
            exp.new_lines = new_lines
            return exp
        }
        if p.word_is("break") {
            p.tok(true, true) !>
            let exp = p.create_exp(EXP.break)
            if p.word_len > 0 {
            exp.i = p.word_i
            }
            exp.set_end(p.pos.i)
            exp.new_lines = new_lines
            return exp
        }
        if p.word_is("continue") {
            p.tok(true, true) !>
            let exp = p.create_exp(EXP.continue)
            if p.word_len > 0 {
            exp.i = p.word_i
            }
            exp.set_end(p.pos.i)
            exp.new_lines = new_lines
            return exp
        }
        if p.word_is("throw") {
            let exp = read_throw_exp(p) !>
            exp.new_lines = new_lines
            return exp
        }
    }

    // Expression statement or assignment
    let left = read_value_exp(p, true) !>
    t = p.tok(true, true, false) !>
    if t == TOK.sign && is_assign_op_word(p) {
        let op_kind = assign_op_from_word(p)
        p.tok(true, true) !> // consume assign operator
        let exp = p.create_exp(EXP.assign)
        exp.i = left.i
        exp.kind = op_kind
        exp.set(ASSIGN_EXP.left, left)
        exp.set(ASSIGN_EXP.right, read_value_exp(p, true) !>)
        exp.set_end(p.pos.i)
        exp.new_lines = new_lines
        return exp
    }

    let exp = p.create_exp(EXP.stmt)
    exp.i = left.i
    exp.set(STMT_EXP.value, left)
    exp.set_end(p.pos.i)
    exp.new_lines = new_lines
    return exp
}

fn is_assign_op_word(p: Parser) bool {
    return p.word_is("=") || p.word_is("+=") || p.word_is("-=") || p.word_is("*=") || p.word_is("/=") || p.word_is("%=") || p.word_is("&=") || p.word_is("|=") || p.word_is("^=")
}

// Precondition: current word is an assignment operator.
fn assign_op_from_word(p: Parser) ASSIGN_OP {
    if p.word_is("+=") : return ASSIGN_OP.add
    if p.word_is("-=") : return ASSIGN_OP.sub
    if p.word_is("*=") : return ASSIGN_OP.mul
    if p.word_is("/=") : return ASSIGN_OP.div
    if p.word_is("%=") : return ASSIGN_OP.mod
    if p.word_is("&=") : return ASSIGN_OP.bit_and
    if p.word_is("|=") : return ASSIGN_OP.bit_or
    if p.word_is("^=") : return ASSIGN_OP.bit_xor
    return ASSIGN_OP.set
}

// `let a, b: T = value`
fn read_let_exp(p: Parser) Exp !Error {
    let exp = p.create_exp(EXP.let)
    if p.word_len > 0 {
            exp.i = p.word_i
    }
    p.tok(true, true) !> // consume `let`

    let names = Array[String]{}
    let types = p.create_exp(EXP.value)
    types.kind = VALUE_KIND.multi
    let ti: uint = 0

    while true {
        let name = p.read_word(true, true) !>
        names.append(name)

        let t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is(":") {
            p.tok(true, true) !>
            types.set(ti, read_type_exp(p, true, true) !>)
        } else {
            types.set(ti, null)
        }
        ti++

        t = p.tok(true, true, false) !>
        if t == TOK.sign && p.word_is(",") {
            p.tok(true, true) !>
            continue
        }
        break
    }

    exp.list = names
    exp.set(LET_EXP.types, types)
    p.expect("=", true, true) !>
    exp.set(LET_EXP.value, read_value_exp(p, true) !>)
    exp.set_end(p.pos.i)
    return exp
}

// `throw .code` / `throw value` — value is EXP.value (often VALUE_KIND.error_code)
fn read_throw_exp(p: Parser) Exp !Error {
    let exp = p.create_exp(EXP.throw)
    if p.word_len > 0 {
            exp.i = p.word_i
    }
    p.tok(true, true) !> // `throw`
    exp.set(RETURN_EXP.value, read_value_exp(p, true) !>) // reuse slot for thrown value
    exp.set_end(p.pos.i)
    return exp
}

// `return` or `return value`
fn read_return_exp(p: Parser) Exp !Error {
    let exp = p.create_exp(EXP.return)
    if p.word_len > 0 {
            exp.i = p.word_i
    }
    p.tok(true, true) !> // consume `return`

    let t = p.tok(true, true, false) !>
    if t == TOK.end {
        exp.set_end(p.pos.i)
        return exp
    }
    if t == TOK.sign && (p.word_is("}") || p.word_is(";")) {
        exp.set_end(p.pos.i)
        return exp
    }
    exp.set(RETURN_EXP.value, read_value_exp(p, true) !>)
    exp.set_end(p.pos.i)
    return exp
}

// `if cond { ... } [else if … | else { … }]` or `if cond : stmt`
fn read_if_exp(p: Parser) Exp !Error {
    let exp = p.create_exp(EXP.if)
    if p.word_len > 0 {
            exp.i = p.word_i
    }
    p.tok(true, true) !> // `if`

    // Condition: no class-init postfix so `{` is the if body (use `(Type {…})` to opt in)
    exp.set(IF_EXP.cond, read_value_exp(p, true, false) !>)
    exp.set(IF_EXP.then_body, read_then_body_exp(p) !>)

    let t = p.tok(true, true, false) !>
    if t == TOK.word && p.word_is("else") {
        p.tok(true, true) !>
        t = p.tok(true, true, false) !>
        if t == TOK.word && p.word_is("if") {
            exp.set(IF_EXP.else_body, read_if_exp(p) !>)
        } else {
            exp.set(IF_EXP.else_body, read_then_body_exp(p) !>)
        }
    }

    exp.set_end(p.pos.i)
    return exp
}

// `while cond { ... }` or `while cond : stmt`
fn read_while_exp(p: Parser) Exp !Error {
    let exp = p.create_exp(EXP.while)
    if p.word_len > 0 {
            exp.i = p.word_i
    }
    p.tok(true, true) !> // `while`
    // Condition: no class-init postfix so `{` is the while body
    exp.set(WHILE_EXP.cond, read_value_exp(p, true, false) !>)
    exp.set(WHILE_EXP.body, read_then_body_exp(p) !>)
    exp.set_end(p.pos.i)
    return exp
}

// `{ ... }` block or `: single-stmt` body used by if/while.
fn read_then_body_exp(p: Parser) Exp !Error {
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is("{") {
        return read_block_exp(p) !>
    }
    if t == TOK.sign && p.word_is(":") {
        p.tok(true, true) !>
        let exp = p.create_exp(EXP.block)
        exp.bool1 = true // single-statement form
        let stmt = read_func_stmt_exp(p) !>
        exp.body_exps = Array[Exp]{ stmt }
        exp.i = stmt.i
        exp.set_end(p.pos.i)
        return exp
    }
    p.error("Expected '{' or ':' after condition, found: '" + p.word() + "'")
}

// `{ ... }` — parse interior into body_exps.
fn read_block_exp(p: Parser) Exp !Error {
    let exp = p.create_exp(EXP.block)
    if p.word_len > 0 {
            exp.i = p.word_i
    }
    p.expect("{", true, true) !>
    let body = read_body_exp(p, "{", "}") !>
    exp.set(BLOCK_EXP.body, body)
    let pos = body.pos
    if isset(pos) {
        let sp = pos.copy().init_parser()
        let members = read_func_stmts(sp) !>
        exp.body_exps = members
        if body.src.format : body.body_exps = members
    }
    exp.set_end(p.pos.i)
    return exp
}

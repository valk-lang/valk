use helper
use valk.fs

class Unit {
    name: String
    functions: Array[Func] (.{})
    globals: Array[Global] (.{})
    extern_functions: Array[Func] (.{})
    extern_globals: Array[Global] (.{})
    unresolved_generic_bodies: Array[Exp] (.{})
    // Test bodies a build without --test skips: an import they use is still used
    skipped_test_bodies: Array[Exp] (.{})
    // String literals are deduplicated per IR module.
    strings: Map[uint] (.{})
    // LLVM intrinsics the functions of this unit call, as `declare` lines
    llvm_declares: Map[bool] (.{})
    string_values: Array[String] (.{})
    // Parallel to string_values: whether a reachable function refers to it.
    string_used: Array[bool] (.{})
    // Any reachable function or global lives here — see reachable.valk.
    is_used: bool (false)
    // One Unit maps to one IR module and, later, one object file.
    ir_code: String ("")
    path_o: String ("")
    path_ir: String ("")
    // A release unit may be emitted as several objects (see object_parts): this many
    object_parts: uint (1)
    // Unique suffix for private coroutine trampolines generated in this module.
    coro_count: uint (0)
    // --debug: source file of the module, and the metadata ids given to its functions
    path: String ("")
    debug_ids: uint (0)
    closure_adapters: Map[Func] (.{})

    static fn new(cache: BuildCache, path: String) Unit {
        let base = fs.basename(path).rtrim(".valk") + "_" + helper.ctxhash(path)
        let name = base
        let n = 1
        while cache.used_unit_names.contains(name) {
            name = base + "-" + n
            n++
        }
        cache.used_unit_names.append(name)
        return Unit {
            name: name
            path: path
        }
    }

    fn add_string(value: String) uint {
        this.strings.get(value) -> existing : return existing
        let index = this.string_values.length
        this.string_values.append(value)
        this.string_used.append(false)
        this.strings.set(value, index)
        return index
    }
}

// The object files a unit was emitted as: `unit.o`, then `unit.1.o` ... for parallel code generation
fn unit_object_paths(unit: Unit) Array[String] {
    let paths = Array[String]{}
    if unit.path_o.length == 0 : return paths
    paths.append(unit.path_o)
    let i: uint = 1
    while i < unit.object_parts {
        paths.append(object_part_path(unit.path_o, i))
        i++
    }
    return paths
}

fn object_part_path(path_o: String, part: uint) String {
    if part == 0 : return path_o
    return path_o.range(0, path_o.bytes - 2) + "." + part + ".o"
}

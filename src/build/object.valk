use llvm
// use valkir
use helper
use valk:fs

// Emit one native object for every Unit/LLVM module. Linking deliberately
// remains a separate stage.
fn emit_unit_objects(build: Build) !Error {
    // if build.options.use_valkir {
    //     emit_unit_objects_valkir(build) !>
    //     return
    // }
    emit_unit_objects_llvm(build) !>
}

// LLVM backend: parse textual IR, optionally optimize, write a relocatable object.
fn emit_unit_objects_llvm(build: Build) !Error {
    llvm_init_object_target(build.options.target)
    let machine = llvm_create_object_target(build) !>

    each build.lists.units as unit {
        if prepare_unit_object(build, unit) !> : continue
        build.print_verbose(3, "> Generating object file: " + unit.path_o)
        emit_unit_object(build, unit, machine) !>
        commit_unit_object_cache(build, unit) !>
    }

    llvm:LLVMDisposeTargetMachine(machine)
}


use helper
use valk.core
use valk.fs
use valk.thread
use valk.time
use llvm

class ObjectTask {
    unit_name: String
    ir_code: String
    path_o: String
    path_ir: String
    llvm_triple: String
    cpu: String
    clang_command: String
    // Keep shared integers before byte-sized fields for legacy compilers.
    duration_us: uint (0)
    optimize: bool
    // --debug: locals stay in their stack slots, where a debugger finds them
    debug: bool
    // Objects to emit in parallel after the one optimization pass (1 = whole unit at once)
    parts_wanted: uint (1)
    // Objects actually written: `path_o`, then `object_part_path(path_o, 1..)`
    parts: uint (1)
    optimize_us: uint (0)
    emit_us: uint (0)
    // The IR cache could not be updated; the next build redoes this unit.
    cache_skipped: bool (false)

    fn run() ?String {
        let start = time.mono_us()
        if this.clang_command.length > 0 {
            let code, output = core.exec(this.clang_command)
            if code != 0 {
                return this.finish(start, this.failure("clang failed while emitting unit '" + this.unit_name + "':\n# Exit code: " + code + "\n# Output: " + output))
            }
        } else {
            let error = llvm_emit_object(this)
            if isset(error) : return this.finish(start, this.failure(error))
        }

        this.write_cached_ir()
        return this.finish(start, null)
    }

    // A failed cache write never fails the build. The content lands in a
    // private file first, so concurrent builds never see a partial file.
    fn write_cached_ir() {
        let path = this.path_ir + "-prev"
        let tmp = path + "." + String.random(12)
        if !this.replace_cached_ir(tmp, path) {
            fs.delete_file(tmp) _
            this.cache_skipped = true
        }
    }

    fn replace_cached_ir(tmp: String, path: String) bool {
        fs.write(tmp, this.ir_code) ! return false
        #if OS == "win"
        fs.delete_file(path) _
        #end
        fs.move(tmp, path) ! return false
        return true
    }

    fn finish(start: uint, error: ?String) ?String {
        this.duration_us = time.mono_us() - start
        return error
    }

    fn failure(message: String) String {
        if this.clang_command.length == 0 : fs.write(this.path_ir, this.ir_code) _
        return message + "\nIR: " + this.path_ir
    }
}

// The completed task indexes: mutable shared state lives in a Lock
class ObjectThreadCompletionQueue $atomic {
    gate: thread.ThreadSuspendGate (.new())
    completed: Lock[Array[uint]] (.new(.{}) !!)

    fn push(index: uint) {
        lock this.completed as c : c.append(index)
        this.gate.signal()
    }

    fn pop() ?uint {
        lock this.completed as c : return c.pop_first() !? null
    }

    fn is_empty() bool {
        lock this.completed as c : return c.length == 0
    }

    fn await_next() uint {
        while true {
            let index = this.pop()
            if isset(index) : return index
            this.gate.wait(fn() bool { return this.is_empty() })
        }
    }
}

class ObjectThreadGroup {
    state: shared ObjectThreadCompletionQueue (.{})
    workers: Array[thread.Thread[?String]] (.new())
    pending: uint (0)

    static fn new() SELF {
        return SELF {}
    }

    fn start(index: uint, task: shared ObjectTask) bool {
        let state = this.state
        let worker = thread.Thread[?String].start(fn() ?String {
            let result = task.run()
            state.push(index)
            return result
        }) ! { return false }
        this.workers.append(worker)
        this.pending++
        return true
    }

    fn has_pending() bool {
        return this.pending > 0
    }

    fn await_next() (uint, ?String) {
        let index = this.state.await_next()
        let worker = this.workers.get(index) ! { panic("Object thread group received an invalid completion index") }
        let result = worker.await()
        this.pending--
        return (index, result)
    }
}

fn emit_unit_objects(build: Build) !Error {
    let tasks = Array[shared ObjectTask]{}
    let units = Array[Unit]{}

    if !build.options.use_clang {
        llvm_init_object_target(build.options.target)
        llvm_check_cpu(build) !>
    }

    each build.lists.units as unit {
        if prepare_unit_object(build, unit) !> : continue
        let command = ""
        if build.options.use_clang {
            command = clang_object_command(build, unit)
            build.print_verbose(3, "# " + command)
        }
        tasks.append(ObjectTask {
            unit_name: unit.name
            ir_code: unit.ir_code
            path_o: unit.path_o
            path_ir: unit.path_ir
            llvm_triple: ir_target_triple(build.options.target)
            cpu: build.options.cpu
            clang_command: command
            optimize: build.options.optimize
            debug: build.options.debug
            parts_wanted: object_parts_wanted(build)
        })
        units.append(unit)
    }

    run_object_tasks(build, tasks, units) !>
}

// A release unit is one module, optimized once as a whole; its machine code is then generated
// in parallel, one object per part. Debug builds keep one object per unit
fn object_parts_wanted(build: Build) uint {
    if !build.options.optimize || build.options.debug || build.options.use_clang : return 1
    let threads = core.cpu_thread_count()
    if threads < 2 : return 1
    return threads > 16 ? 16 : threads
}

fn run_object_tasks(build: Build, tasks: Array[shared ObjectTask], units: Array[Unit]) !Error {
    let group = ObjectThreadGroup.new()
    let errors = Array[String]{}
    let next = 0
    let stopped = false

    while next < tasks.length && next < 8 {
        let task = tasks.get(next) ! build.error("Missing object generation task (bug)")
        if !group.start(next, task) {
            errors.append("Failed to start object generation thread")
            stopped = true
            break
        }
        next++
    }

    while group.has_pending() {
        let index, error = group.await_next()
        let task = tasks.get(index) ! build.error("Missing completed object generation task (bug)")
        let duration_ms = task.duration_us.to(float) / 1000
        build.print_verbose(3, "> Object task: " + duration_ms.to_string(2, false) + "ms: " + task.path_ir)
        if task.cache_skipped : build.print_verbose(2, "# IR cache not updated for unit: " + task.unit_name)
        if isset(error) {
            errors.append(error)
            stopped = true
        } else {
            let unit = units.get(index) ! build.error("Missing object generation unit (bug)")
            unit.ir_code = ""
            unit.object_parts = task.parts
            object_parts_record(unit, task.parts)
            if task.parts > 1 : build.print_verbose(3, "> Unit '" + unit.name + "' emitted as " + task.parts + " objects; optimize " + (task.optimize_us / 1000) + "ms, emit " + (task.emit_us / 1000) + "ms")
        }

        if !stopped && next < tasks.length {
            let next_task = tasks.get(next) ! build.error("Missing object generation task (bug)")
            if group.start(next, next_task) {
                next++
            } else {
                errors.append("Failed to start object generation thread")
                stopped = true
            }
        }
    }

    if errors.length > 0 : build.error(errors.join("\n\n"))
}

fn clang_object_command(build: Build, unit: Unit) String {
    let target = build.options.target
    let cmd = "clang -c -x ir \""
    cmd += unit.path_ir
    cmd += "\" -o \""
    cmd += unit.path_o
    cmd += "\" --target="
    cmd += ir_target_triple(target)
    if target.os != "win" : cmd += " -fPIC"
    // No -g: with --debug the IR carries its own debug metadata, which clang keeps.
    cmd += build.options.optimize ? " -O3" : " -O0"
    if build.options.cpu != "generic" : cmd += (target.arch == "arm64" ? " -mcpu=" : " -march=") + build.options.cpu
    if target.arch == "x64" : cmd += " -mllvm " + X86_LOOP_ALIGN_OPTION
    return cmd
}

fn prepare_unit_object(build: Build, unit: Unit) bool !Error {
    if unit.ir_code.length == 0 : return true
    let dir = object_output_dir(build) !>
    unit.path_o = helper.add(dir, unit.name + ".o")
    unit.path_ir = helper.add(dir, unit.name + ".ir")

    let path_prev = unit.path_ir + "-prev"
    let unchanged = !build.options.is_clean_build
        && fs.exists(unit.path_o)
        && helper.file_has_same_content(path_prev, unit.ir_code)
        && object_parts_cached(unit)
    if unchanged {
        unit.ir_code = ""
        return true
    }

    // clang reads the IR from disk; the LLVM backend only writes it when emitting fails
    if build.options.use_clang : fs.write(unit.path_ir, unit.ir_code) ! build.error("Failed to write IR: " + unit.path_ir)
    return false
}

// The number of objects a cached unit was emitted as lives next to it in `unit.o-parts`;
// without it the object may be an incomplete part of an interrupted build
fn object_parts_cached(unit: Unit) bool {
    let text = fs.read(unit.path_o + "-parts") ! return false
    let parts = text.trim().to_uint() ! return false
    if parts == 0 : return false
    let i: uint = 1
    while i < parts {
        if !fs.exists(object_part_path(unit.path_o, i)) : return false
        i++
    }
    unit.object_parts = parts
    return true
}

fn object_parts_record(unit: Unit, parts: uint) {
    let manifest = unit.path_o + "-parts"
    fs.write(manifest, parts.to_string()) _
    // Objects of an earlier build with more parts would be stale
    let i = parts > 1 ? parts : 1
    while fs.exists(object_part_path(unit.path_o, i)) {
        fs.delete_file(object_part_path(unit.path_o, i)) _
        i++
    }
}

fn object_output_dir(build: Build) String !Error {
    if build.cache.object_dir.length > 0 : return build.cache.object_dir

    let home = fs.home_dir() ! build.error("Cannot find the home directory for the object cache")
    let root = helper.add(home, ".valk")
    if !fs.is_dir(root) : fs.create_dir(root) ! build.error("Failed to create object cache directory: " + root)
    root = helper.add(root, "cache")
    if !fs.is_dir(root) : fs.create_dir(root) ! build.error("Failed to create object cache directory: " + root)

    let identity = build.options.path_out ?? (fs.cwd() ! build.error("Cannot find the current directory"))
    identity += "|"
    if build.options.mode == BUILDTYPE.lib : identity += "lib"
    else if build.options.mode == BUILDTYPE.ir : identity += "ir"
    else : identity += "exe"
    identity += "|"
    identity += build.options.target.target
    identity += build.options.optimize ? "|opt" : "|no-opt"
    if build.options.cpu != "generic" : identity += "|cpu:" + build.options.cpu
    if build.options.debug : identity += "|debug"
    identity += build.options.is_test ? "|test" : "|no-test"
    if build.options.use_clang : identity += "|clang"
    else : identity += "|llvm"
    identity += "|"
    identity += VERSION
    let dir = helper.add(root, helper.ctxhash(identity))
    if !fs.is_dir(dir) : fs.create_dir(dir) ! build.error("Failed to create object cache directory: " + dir)
    write_cache_stamp(helper.add(dir, CACHE_USED_STAMP), time.unix_ms())
    build.cache.object_dir = dir
    build.print_verbose(1, "📦 Cache directory: " + dir)
    return dir
}

////////////////////////////
// Cache upkeep
////////////////////////////

value CACHE_USED_STAMP ("last-used")
value CACHE_TRIM_STAMP ("last-trim")
value CACHE_MINUTE_MS (60 * 1000)
value CACHE_HOUR_MS (60 * CACHE_MINUTE_MS)
value CACHE_TRIM_BUDGET_MS (200)
// A cache directory that no build used for this long is removed
value CACHE_KEEP_MS (5 * 24 * CACHE_HOUR_MS)

fn write_cache_stamp(path: String, now_ms: uint) {
    fs.write(path, now_ms.to(String)) _
}

fn read_cache_stamp(path: String) ?uint {
    let text = fs.read(path) !? ""
    if text.length == 0 : return null
    return text.to(uint) !? null
}

// Files of units this build no longer has are removed. Runs while the build holds the cache lock.
fn prune_unit_cache(build: Build) {
    let dir = build.cache.object_dir
    if dir.length == 0 : return
    let keep = HashSet[String]{}
    keep.add("cache.lock")
    keep.add(CACHE_USED_STAMP)
    each build.lists.units as unit {
        keep.add(unit.name + ".o")
        keep.add(unit.name + ".ir-prev")
        if build.options.use_clang : keep.add(unit.name + ".ir")
        // The parts of a unit emitted in parallel, and their count
        keep.add(unit.name + ".o-parts")
        let i: uint = 1
        while i < unit.object_parts {
            keep.add(unit.name + "." + i + ".o")
            i++
        }
    }
    let names = fs.files_in(dir, false, true, false, true) ! return
    each names as name {
        if !keep.has(name) : fs.delete_file(helper.add(dir, name)) _
    }
}

// Once an hour, cache directories that no build used recently are removed. A build spends at
// most CACHE_TRIM_BUDGET_MS on it; what is left goes at a build a minute later
fn trim_object_cache(build: Build) {
    let dir = build.cache.object_dir
    if dir.length == 0 : return
    let root = fs.dir_of(dir)
    let now = time.unix_ms()
    let trim_stamp = helper.add(root, CACHE_TRIM_STAMP)
    let last = read_cache_stamp(trim_stamp)
    if isset(last) && last <= now && now - last < CACHE_HOUR_MS : return
    write_cache_stamp(trim_stamp, now)

    let start = time.mono_ms()
    let names = fs.files_in(root, false, false, true, true) ! return
    let removed: uint = 0
    each names as name {
        let path = helper.add(root, name)
        if path == dir || !cache_dir_unused(path, now) : continue
        if time.mono_ms() - start >= CACHE_TRIM_BUDGET_MS {
            write_cache_stamp(trim_stamp, now - CACHE_HOUR_MS + CACHE_MINUTE_MS)
            break
        }
        if remove_cache_dir(path, now) : removed++
    }
    if removed > 0 : build.print_verbose(1, "📦 Removed " + removed + " unused cache directories")
}

// The `last-used` stamp's time, or the directory's for caches older than the stamp
fn cache_dir_unused(path: String, now: uint) bool {
    let used = fs.modified_time(helper.add(path, CACHE_USED_STAMP)) !? (fs.modified_time(path) !? 0)
    return cache_expired(used / 1000000, now)
}

fn cache_expired(used: uint, now: uint) bool {
    // A stamp from a clock that ran ahead counts as unused once it is far off
    if used > now : return used - now >= CACHE_KEEP_MS
    return now - used >= CACHE_KEEP_MS
}

// A build that uses the directory holds its lock, and one that starts stamps it first
fn remove_cache_dir(path: String, now: uint) bool {
    let lock_path = helper.add(path, "cache.lock")
    let lock = fs.try_lock(lock_path) !? null
    if !isset(lock) : return false
    // Taking the lock touched the directory, so only a stamp written since then counts
    let stamp = fs.modified_time(helper.add(path, CACHE_USED_STAMP)) !? 0
    let unused = stamp == 0 || cache_expired(stamp / 1000000, now)
    if unused {
        let names = fs.files_in(path, false, true, true, true) !? Array[String]{}
        each names as name {
            if name != "cache.lock" : fs.delete_all(helper.add(path, name)) _
        }
    }
    lock.unlock() _
    if !unused : return false
    fs.delete_file(lock_path) _
    fs.delete_dir(path) _
    return true
}

// The target machine for a task, or an error message
fn llvm_create_machine(task: shared ObjectTask) (?llvm.LLVMTargetMachineRef, ?String) {
    @unsafe
    let target: ?llvm.LLVMTargetRef = null
    let message: ?cstring = null
    if llvm.LLVMGetTargetFromTriple(task.llvm_triple.data_cstring, @ref(target), @ref(message)) {
        let detail = llvm_message_text(message)
        if isset(message) : llvm.LLVMDisposeMessage(message)
        return (null, "LLVM could not select target '" + task.llvm_triple + "': " + detail)
    }
    if !isset(target) : return (null, "LLVM did not create a target for: " + task.llvm_triple)

    // "native" asks LLVM for the compiling machine's CPU and features
    let cpu = task.cpu
    let features = ""
    if cpu == "native" {
        let host_cpu = llvm.LLVMGetHostCPUName()
        let host_features = llvm.LLVMGetHostCPUFeatures()
        cpu = host_cpu
        features = host_features
        llvm.LLVMDisposeMessage(host_cpu)
        llvm.LLVMDisposeMessage(host_features)
    }
    let level: i32 = task.optimize ? llvm.LLVMCodeGenLevelAggressive : (task.debug ? llvm.LLVMCodeGenLevelNone : llvm.LLVMCodeGenLevelDefault)
    let machine = llvm.LLVMCreateTargetMachine(target, task.llvm_triple.data_cstring, cpu.data_cstring, features.data_cstring, level, llvm.LLVMRelocPIC, llvm.LLVMCodeModelDefault)
    if !isset(machine) : return (null, "LLVM failed to create a target machine for: " + task.llvm_triple)
    return (machine, null)
}

fn llvm_emit_object(task: shared ObjectTask) ?String {
    @unsafe
    let machine, machine_error = llvm_create_machine(task)
    if !isset(machine) : return machine_error ?? "LLVM failed to create a target machine"
    let message: ?cstring = null

    let context = llvm.LLVMContextCreate()
    let name = task.unit_name + ".ll"
    let buffer = llvm.LLVMCreateMemoryBufferWithMemoryRangeCopy(task.ir_code.data, task.ir_code.bytes, name.data_cstring)
    let module: ?llvm.LLVMModuleRef = null
    message = null

    if llvm.LLVMParseIRInContext(context, buffer, @ref(module), @ref(message)) {
        let detail = llvm_message_text(message)
        if isset(message) : llvm.LLVMDisposeMessage(message)
        llvm.LLVMContextDispose(context)
        llvm.LLVMDisposeTargetMachine(machine)
        return "LLVM IR parse failed while emitting unit '" + task.unit_name + "':\n" + detail
    }
    if !isset(module) {
        llvm.LLVMContextDispose(context)
        llvm.LLVMDisposeTargetMachine(machine)
        return "LLVM IR parser did not create a module while emitting unit: " + task.unit_name
    }

    message = null
    if llvm.LLVMVerifyModule(module, llvm.LLVMReturnStatusAction, @ref(message)) {
        let detail = llvm_message_text(message)
        if isset(message) : llvm.LLVMDisposeMessage(message)
        llvm.LLVMDisposeModule(module)
        llvm.LLVMContextDispose(context)
        llvm.LLVMDisposeTargetMachine(machine)
        return "LLVM IR verification failed while emitting unit '" + task.unit_name + "':\n" + detail
    }
    if isset(message) {
        llvm.LLVMDisposeMessage(message)
        message = null
    }

    llvm_configure_object_module(module, machine, task.llvm_triple)
    let optimize_start = time.mono_us()
    let opt_error = llvm_optimize_object_module(module, machine, task.optimize, task.debug)
    if isset(opt_error) {
        llvm.LLVMDisposeModule(module)
        llvm.LLVMContextDispose(context)
        llvm.LLVMDisposeTargetMachine(machine)
        return "LLVM optimization failed for unit '" + task.unit_name + "':\n" + opt_error
    }
    task.optimize_us = time.mono_us() - optimize_start

    let emit_start = time.mono_us()
    if task.parts_wanted > 1 {
        let assignment = llvm_partition_module(module, task.parts_wanted, task.unit_name)
        if assignment.parts > 1 {
            // The optimized module as bitcode, which every part's thread reads on its own
            let bitcode_buffer = llvm.LLVMWriteBitcodeToMemoryBuffer(module)
            let bitcode = [u8]{ owner: null, data: llvm.LLVMGetBufferStart(bitcode_buffer).@cast(*[u8]), length: llvm.LLVMGetBufferSize(bitcode_buffer) }.to_string()
            llvm.LLVMDisposeMemoryBuffer(bitcode_buffer)
            llvm.LLVMDisposeModule(module)
            llvm.LLVMContextDispose(context)
            llvm.LLVMDisposeTargetMachine(machine)
            let error = llvm_emit_partitions(task, bitcode, assignment)
            task.emit_us = time.mono_us() - emit_start
            if isset(error) : return error
            task.parts = assignment.parts
            return null
        }
    }

    if llvm.LLVMTargetMachineEmitToFile(machine, module, task.path_o.data_cstring, llvm.LLVMObjectFile, @ref(message)) {
        let detail = llvm_message_text(message)
        if isset(message) : llvm.LLVMDisposeMessage(message)
        llvm.LLVMDisposeModule(module)
        llvm.LLVMContextDispose(context)
        llvm.LLVMDisposeTargetMachine(machine)
        return "LLVM failed to emit object for unit '" + task.unit_name + "':\n" + detail
    }

    if isset(message) : llvm.LLVMDisposeMessage(message)
    llvm.LLVMDisposeModule(module)
    llvm.LLVMContextDispose(context)
    llvm.LLVMDisposeTargetMachine(machine)
    task.emit_us = time.mono_us() - emit_start
    return null
}

// Which part emits each function of the module, in module order (one byte per function);
// `parts` is 1 when the module is better emitted whole
class ObjectPartition {
    parts: uint (1)
    functions: String ("")
}

// At least this many defined functions before splitting the code generation
value OBJECT_PARTITION_MIN_FUNCTIONS (64)

// Prepares the optimized module for emission in parts. Every defined function and global
// gets a linkage that another object can refer to (hidden visibility keeps calls direct),
// and the functions are dealt to the parts by their size
fn llvm_partition_module(module: llvm.LLVMModuleRef, parts_wanted: uint, unit_name: String) ObjectPartition {
    @unsafe
    let result = ObjectPartition {}
    // An alias must point at a definition in its own object; none are emitted, but be safe
    if isset(llvm.LLVMGetFirstGlobalAlias(module)) : return result
    let weights = Array[uint]{}
    let func = llvm.LLVMGetFirstFunction(module)
    while isset(func) {
        if llvm.LLVMIsDeclaration(func) : weights.append(0)
        else : weights.append(llvm.LLVMCountBasicBlocks(func).to(uint) + 1)
        func = llvm.LLVMGetNextFunction(func)
    }
    let defined: uint = 0
    each weights as w : if w > 0 : defined++
    if defined < OBJECT_PARTITION_MIN_FUNCTIONS : return result
    let parts = parts_wanted
    if parts > defined / 16 : parts = defined / 16
    if parts < 2 : return result

    let local_index: uint = 0
    func = llvm.LLVMGetFirstFunction(module)
    while isset(func) {
        if !llvm.LLVMIsDeclaration(func) && llvm_externalize(func, unit_name, local_index) : local_index++
        func = llvm.LLVMGetNextFunction(func)
    }
    let global = llvm.LLVMGetFirstGlobal(module)
    while isset(global) {
        if !llvm.LLVMIsDeclaration(global) && llvm.LLVMGetLinkage(global) != llvm.LLVMAppendingLinkage {
            if llvm_externalize(global, unit_name, local_index) : local_index++
        }
        global = llvm.LLVMGetNextGlobal(global)
    }

    // Greedy: each function goes to the part with the least weight so far
    let loads = Array[uint]{ 0 x parts }
    let assignment = ByteBuffer.new(weights.length)
    each weights as w {
        let lightest: uint = 0
        let i: uint = 1
        while i < parts {
            if loads[i] < loads[lightest] : lightest = i
            i++
        }
        loads[lightest] += w
        assignment.write_byte(lightest.to(u8))
    }
    result.parts = parts
    result.functions = assignment.to_string()
    return result
}

// A local symbol becomes a hidden external one. Its name gets the unit's name in front: local
// names such as `valk.str.0` repeat in every unit, and two partitioned units would both
// define them. Returns whether the symbol was local (`index` names an unnamed one)
fn llvm_externalize(global: llvm.LLVMValueRef, unit_name: String, index: uint) bool {
    @unsafe
    let linkage = llvm.LLVMGetLinkage(global)
    if linkage != llvm.LLVMInternalLinkage && linkage != llvm.LLVMPrivateLinkage : return false
    let length: uint = 0
    let data = llvm.LLVMGetValueName2(global, @ref(length))
    let name = unit_name + "." + (length > 0 ? [u8]{ owner: null, data: data.@cast(*[u8]), length: length }.to_string() : "local." + index)
    llvm.LLVMSetValueName2(global, name.data, name.bytes)
    llvm.LLVMSetLinkage(global, llvm.LLVMExternalLinkage)
    llvm.LLVMSetVisibility(global, llvm.LLVMHiddenVisibility)
    return true
}

class ObjectPartTask {
    task: shared ObjectTask
    bitcode: String
    assignment: String
    part: uint
    // Held while the part reads the whole module and drops the other parts' bodies
    read_lock: core.SyncMutex
}

// At most this many parts hold the whole module at once: a large unit's module is big (the
// release test suite's took 11 GB with every part reading it at the same time)
value OBJECT_PARTS_READING (3)

// Emits every part: the others on their own threads, part 0 on this one
fn llvm_emit_partitions(task: shared ObjectTask, bitcode: String, assignment: ObjectPartition) ?String {
    let workers = Array[thread.Thread[?String]]{}
    let locks = Array[core.SyncMutex]{}
    while locks.length < OBJECT_PARTS_READING : locks.append(core.SyncMutex.new())
    let i: uint = 1
    while i < assignment.parts {
        let lock = locks.get(i % OBJECT_PARTS_READING) ! return "Object part has no read lock"
        let part: shared ObjectPartTask = ObjectPartTask { task: task, bitcode: bitcode, assignment: assignment.functions, part: i, read_lock: lock }
        let worker = thread.Thread[?String].start(fn() ?String {
            return llvm_emit_part(part)
        }) ! return "Failed to start a code generation thread"
        workers.append(worker)
        i++
    }
    let first_lock = locks.get(0) ! return "Object part has no read lock"
    let first: shared ObjectPartTask = ObjectPartTask { task: task, bitcode: bitcode, assignment: assignment.functions, part: 0, read_lock: first_lock }
    let error = llvm_emit_part(first)
    each workers as worker {
        let result = worker.await()
        if isset(result) && !isset(error) : error = result
    }
    return error
}

// One part: the whole optimized module, with the functions and globals of the other parts
// marked `available_externally`, which the code generator does not emit
fn llvm_emit_part(part: shared ObjectPartTask) ?String {
    @unsafe
    let task = part.task
    let machine, machine_error = llvm_create_machine(task)
    if !isset(machine) : return machine_error ?? "LLVM failed to create a target machine"
    let context = llvm.LLVMContextCreate()
    let name = task.unit_name + ".bc"
    part.read_lock.lock()
    let buffer = llvm.LLVMCreateMemoryBufferWithMemoryRangeCopy(part.bitcode.data, part.bitcode.bytes, name.data_cstring)
    let module: ?llvm.LLVMModuleRef = null
    if llvm.LLVMParseBitcodeInContext2(context, buffer, @ref(module)) || !isset(module) {
        part.read_lock.unlock()
        llvm.LLVMDisposeMemoryBuffer(buffer)
        llvm.LLVMContextDispose(context)
        llvm.LLVMDisposeTargetMachine(machine)
        return "LLVM could not read back the optimized unit '" + task.unit_name + "' for part " + part.part
    }
    // The other parts' functions become declarations: a body would still go through the
    // IR passes of code generation, which was most of a part's time
    let assignment = part.assignment
    let index: uint = 0
    let func = llvm.LLVMGetFirstFunction(module)
    while isset(func) {
        let next = llvm.LLVMGetNextFunction(func)
        if !llvm.LLVMIsDeclaration(func) && assignment[index].to(uint) != part.part : llvm_strip_body(module, func)
        index++
        func = next
    }
    part.read_lock.unlock()
    if part.part != 0 {
        // Globals are emitted by part 0; the appending ones (constructor lists) only exist there
        let global = llvm.LLVMGetFirstGlobal(module)
        while isset(global) {
            let next = llvm.LLVMGetNextGlobal(global)
            if !llvm.LLVMIsDeclaration(global) {
                if llvm.LLVMGetLinkage(global) == llvm.LLVMAppendingLinkage : llvm.LLVMDeleteGlobal(global)
                else : llvm.LLVMSetLinkage(global, llvm.LLVMAvailableExternallyLinkage)
            }
            global = next
        }
    }
    let path = object_part_path(task.path_o, part.part)
    let message: ?cstring = null
    let error: ?String = null
    if llvm.LLVMTargetMachineEmitToFile(machine, module, path.data_cstring, llvm.LLVMObjectFile, @ref(message)) {
        error = "LLVM failed to emit object part " + part.part + " of unit '" + task.unit_name + "':\n" + llvm_message_text(message)
    }
    if isset(message) : llvm.LLVMDisposeMessage(message)
    llvm.LLVMDisposeModule(module)
    llvm.LLVMDisposeMemoryBuffer(buffer)
    llvm.LLVMContextDispose(context)
    llvm.LLVMDisposeTargetMachine(machine)
    return error
}

// Replaces a defined function by a declaration with the same name, type, calling convention,
// attributes and visibility, so calls to it keep their ABI and resolve to the other part
fn llvm_strip_body(module: llvm.LLVMModuleRef, func: llvm.LLVMValueRef) {
    @unsafe
    let name_length: uint = 0
    let name_data = llvm.LLVMGetValueName2(func, @ref(name_length))
    let name = [u8]{ owner: null, data: name_data.@cast(*[u8]), length: name_length }.to_string()
    let decl = llvm.LLVMAddFunction(module, "".data_cstring, llvm.LLVMGlobalGetValueType(func))
    llvm.LLVMSetFunctionCallConv(decl, llvm.LLVMGetFunctionCallConv(func))
    llvm.LLVMSetVisibility(decl, llvm.LLVMGetVisibility(func))
    let params = llvm.LLVMCountParams(func)
    let index: u32 = 0
    while index <= params + 1 {
        // Function attributes, then the return value, then each parameter
        let at: u32 = index == 0 ? llvm.LLVMAttributeFunctionIndex : index - 1
        let count = llvm.LLVMGetAttributeCountAtIndex(func, at)
        if count > 0 {
            let attrs = Array[llvm.LLVMAttributeRef].new(count.to(uint))
            llvm.LLVMGetAttributesAtIndex(func, at, attrs.items().@cast(ptr))
            let i: uint = 0
            while i < count.to(uint) {
                llvm.LLVMAddAttributeAtIndex(decl, at, @ptrv(attrs.items(), llvm.LLVMAttributeRef, i))
                i++
            }
        }
        index++
    }
    llvm.LLVMReplaceAllUsesWith(func, decl)
    llvm.LLVMDeleteFunction(func)
    llvm.LLVMSetValueName2(decl, name.data, name.bytes)
}

// A CPU name LLVM does not know ends in a fatal error on x86, deep inside code
// generation. One tiny module compiled first, on this thread, reports it in one place
fn llvm_check_cpu(build: Build) !Error {
    @unsafe
    llvm.LLVMInstallFatalErrorHandler(llvm_fatal_error.@cast(ptr))
    let cpu = build.options.cpu
    if cpu == "generic" : return
    fatal_cpu_hint = cpu
    let dir = object_output_dir(build) !>
    let probe: shared ObjectTask = ObjectTask {
        unit_name: "cpu-probe"
        ir_code: "define void @valk_cpu_probe() {\n  ret void\n}\n"
        path_o: helper.add(dir, "cpu-probe.o")
        path_ir: ""
        llvm_triple: ir_target_triple(build.options.target)
        cpu: cpu
        clang_command: ""
        optimize: false
        debug: false
    }
    let error = llvm_emit_object(probe)
    fs.delete_file(probe.path_o) _
    fatal_cpu_hint = ""
    if isset(error) : build.error("LLVM cannot compile for CPU '" + cpu + "': " + error)
}

global fatal_cpu_hint: String ("")

fn llvm_fatal_error(reason: cstring) {
    let message: String = reason
    if fatal_cpu_hint != "" {
        build_error("LLVM cannot compile for CPU '" + fatal_cpu_hint + "': " + message + "\nUse an LLVM CPU name such as x86-64-v3 or apple-m1, or native for this machine")
    }
    build_error("LLVM: " + message)
}

fn llvm_message_text(message: ?cstring) String {
    if !isset(message) : return "<no LLVM diagnostic>"
    return message
}

fn llvm_configure_object_module(module: llvm.LLVMModuleRef, machine: llvm.LLVMTargetMachineRef, triple: String) {
    @unsafe
    llvm.LLVMSetTarget(module, triple.data_cstring)
    let layout = llvm.LLVMCreateTargetDataLayout(machine)
    let text = llvm.LLVMCopyStringRepOfTargetData(layout)
    llvm.LLVMSetDataLayout(module, text)
    llvm.LLVMDisposeMessage(text)
    llvm.LLVMDisposeTargetData(layout)
}

// Unoptimized builds still run two passes: `always-inline` is what makes the
// `$inline` flag mean anything, and `mem2reg` promotes the alloca-per-local.
// A debug build keeps the locals in memory for the debugger.
fn llvm_optimize_object_module(module: llvm.LLVMModuleRef, machine: llvm.LLVMTargetMachineRef, optimize: bool, debug: bool) ?String {
    @unsafe
    let options = llvm.LLVMCreatePassBuilderOptions()
    // Off by default in the C API, on in clang and opt from -O2
    if optimize : llvm.LLVMPassBuilderOptionsSetSLPVectorization(options, 1)
    let passes = optimize ? "default<O3>" : (debug ? "always-inline" : "always-inline,function(mem2reg)")
    let error = llvm.LLVMRunPasses(module, passes.data_cstring, machine, options)
    llvm.LLVMDisposePassBuilderOptions(options)
    if !isset(error) : return null
    let message = llvm.LLVMGetErrorMessage(error)
    let detail: String = message
    llvm.LLVMDisposeErrorMessage(message)
    return detail
}

global llvm_options_set: bool (false)
// Innermost loops start on 32 bytes: a hot loop crossing a fetch block can cost a third more cycles
value X86_LOOP_ALIGN_OPTION ("-x86-experimental-pref-innermost-loop-alignment=5")

fn llvm_init_object_target(target: Target) {
    if target.arch == "x64" {
        llvm.LLVMInitializeX86TargetInfo()
        llvm.LLVMInitializeX86Target()
        llvm.LLVMInitializeX86TargetMC()
        llvm.LLVMInitializeX86AsmPrinter()
        // Inline asm ($cpuid, $xgetbv) needs the parser
        llvm.LLVMInitializeX86AsmParser()
        if !llvm_options_set {
            llvm_options_set = true
            @unsafe
            let a0 = "valk"
            let argv = [cstring x 2]{ a0.data_cstring, X86_LOOP_ALIGN_OPTION.data_cstring }
            llvm.LLVMParseCommandLineOptions(2, @ref(argv), null)
        }
    } else {
        llvm.LLVMInitializeAArch64TargetInfo()
        llvm.LLVMInitializeAArch64Target()
        llvm.LLVMInitializeAArch64TargetMC()
        llvm.LLVMInitializeAArch64AsmPrinter()
        llvm.LLVMInitializeAArch64AsmParser()
    }
}

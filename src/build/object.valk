use helper
use valk.core
use valk.fs
use valk.thread
use valk.time
use llvm

class ObjectTask {
    unit_name: String
    ir_code: String
    path_o: String
    path_ir: String
    llvm_triple: String
    cpu: String
    clang_command: String
    // Keep shared integers before byte-sized fields for legacy compilers.
    duration_us: uint (0)
    optimize: bool
    // --debug: locals stay in their stack slots, where a debugger finds them
    debug: bool
    // The IR cache could not be updated; the next build redoes this unit.
    cache_skipped: bool (false)

    fn run() ?String {
        let start = time.mono_us()
        if this.clang_command.length > 0 {
            let code, output = core.exec(this.clang_command)
            if code != 0 {
                return this.finish(start, this.failure("clang failed while emitting unit '" + this.unit_name + "':\n# Exit code: " + code + "\n# Output: " + output))
            }
        } else {
            let error = llvm_emit_object(this)
            if isset(error) : return this.finish(start, this.failure(error))
        }

        this.write_cached_ir()
        return this.finish(start, null)
    }

    // A failed cache write never fails the build. The content lands in a
    // private file first, so concurrent builds never see a partial file.
    fn write_cached_ir() {
        let path = this.path_ir + "-prev"
        let tmp = path + "." + String.random(12)
        if !this.replace_cached_ir(tmp, path) {
            fs.delete_file(tmp) _
            this.cache_skipped = true
        }
    }

    fn replace_cached_ir(tmp: String, path: String) bool {
        fs.write(tmp, this.ir_code) ! return false
        #if OS == "win"
        fs.delete_file(path) _
        #end
        fs.move(tmp, path) ! return false
        return true
    }

    fn finish(start: uint, error: ?String) ?String {
        this.duration_us = time.mono_us() - start
        return error
    }

    fn failure(message: String) String {
        if this.clang_command.length == 0 : fs.write(this.path_ir, this.ir_code) _
        return message + "\nIR: " + this.path_ir
    }
}

class ObjectThreadCompletionQueue {
    mutex: shared core.SyncMutex (.new())
    gate: shared thread.ThreadSuspendGate (.new())
    completed: Array[uint] (.new())

    fn push(index: uint) @shared_unsafe {
        this.mutex.lock()
        this.completed.append(index)
        this.mutex.unlock()
        this.gate.signal()
    }

    fn pop() ?uint @shared_unsafe {
        this.mutex.lock()
        let index: ?uint = this.completed.pop_first() !? null
        this.mutex.unlock()
        return index
    }

    fn is_empty() bool @shared_unsafe {
        this.mutex.lock()
        let empty = this.completed.length == 0
        this.mutex.unlock()
        return empty
    }

    fn await_next() uint @shared_unsafe {
        while true {
            let index = this.pop()
            if isset(index) : return index
            this.gate.wait(fn() bool { return this.is_empty() })
        }
    }
}

class ObjectThreadGroup {
    state: shared ObjectThreadCompletionQueue (.{})
    workers: Array[thread.Thread[?String]] (.new())
    pending: uint (0)

    static fn new() SELF {
        return SELF {}
    }

    fn start(index: uint, task: shared ObjectTask) bool {
        let state = this.state
        let worker = thread.Thread[?String].start(fn() ?String {
            let result = task.run()
            state.push(index)
            return result
        }) ! { return false }
        this.workers.append(worker)
        this.pending++
        return true
    }

    fn has_pending() bool {
        return this.pending > 0
    }

    fn await_next() (uint, ?String) {
        let index = this.state.await_next()
        let worker = this.workers.get(index) ! { panic("Object thread group received an invalid completion index") }
        let result = worker.await()
        this.pending--
        return (index, result)
    }
}

fn emit_unit_objects(build: Build) !Error {
    let tasks = Array[shared ObjectTask]{}
    let units = Array[Unit]{}

    if !build.options.use_clang {
        llvm_init_object_target(build.options.target)
        llvm_check_cpu(build) !>
    }

    each build.lists.units as unit {
        if prepare_unit_object(build, unit) !> : continue
        let command = ""
        if build.options.use_clang {
            command = clang_object_command(build, unit)
            build.print_verbose(3, "# " + command)
        }
        tasks.append(ObjectTask {
            unit_name: unit.name
            ir_code: unit.ir_code
            path_o: unit.path_o
            path_ir: unit.path_ir
            llvm_triple: ir_target_triple(build.options.target)
            cpu: build.options.cpu
            clang_command: command
            optimize: build.options.optimize
            debug: build.options.debug
        })
        units.append(unit)
    }

    run_object_tasks(build, tasks, units) !>
}

fn run_object_tasks(build: Build, tasks: Array[shared ObjectTask], units: Array[Unit]) !Error {
    let group = ObjectThreadGroup.new()
    let errors = Array[String]{}
    let next = 0
    let stopped = false

    while next < tasks.length && next < 8 {
        let task = tasks.get(next) ! build.error("Missing object generation task (bug)")
        if !group.start(next, task) {
            errors.append("Failed to start object generation thread")
            stopped = true
            break
        }
        next++
    }

    while group.has_pending() {
        let index, error = group.await_next()
        let task = tasks.get(index) ! build.error("Missing completed object generation task (bug)")
        let duration_ms = task.duration_us.to(float) / 1000
        build.print_verbose(3, "> Object task: " + duration_ms.to_string(2, false) + "ms: " + task.path_ir)
        if task.cache_skipped : build.print_verbose(2, "# IR cache not updated for unit: " + task.unit_name)
        if isset(error) {
            errors.append(error)
            stopped = true
        } else {
            let unit = units.get(index) ! build.error("Missing object generation unit (bug)")
            unit.ir_code = ""
        }

        if !stopped && next < tasks.length {
            let next_task = tasks.get(next) ! build.error("Missing object generation task (bug)")
            if group.start(next, next_task) {
                next++
            } else {
                errors.append("Failed to start object generation thread")
                stopped = true
            }
        }
    }

    if errors.length > 0 : build.error(errors.join("\n\n"))
}

fn clang_object_command(build: Build, unit: Unit) String {
    let target = build.options.target
    let cmd = "clang -c -x ir \""
    cmd += unit.path_ir
    cmd += "\" -o \""
    cmd += unit.path_o
    cmd += "\" --target="
    cmd += ir_target_triple(target)
    if target.os != "win" : cmd += " -fPIC"
    // No -g: with --debug the IR carries its own debug metadata, which clang keeps.
    cmd += build.options.optimize ? " -O3" : " -O0"
    if build.options.cpu != "generic" : cmd += (target.arch == "arm64" ? " -mcpu=" : " -march=") + build.options.cpu
    return cmd
}

fn prepare_unit_object(build: Build, unit: Unit) bool !Error {
    if unit.ir_code.length == 0 : return true
    let dir = object_output_dir(build) !>
    unit.path_o = helper.add(dir, unit.name + ".o")
    unit.path_ir = helper.add(dir, unit.name + ".ir")

    let path_prev = unit.path_ir + "-prev"
    let unchanged = !build.options.is_clean_build
        && fs.exists(unit.path_o)
        && helper.file_has_same_content(path_prev, unit.ir_code)
    if unchanged {
        unit.ir_code = ""
        return true
    }

    // clang reads the IR from disk; the LLVM backend only writes it when emitting fails
    if build.options.use_clang : fs.write(unit.path_ir, unit.ir_code) ! build.error("Failed to write IR: " + unit.path_ir)
    return false
}

fn object_output_dir(build: Build) String !Error {
    if build.cache.object_dir.length > 0 : return build.cache.object_dir

    let home = fs.home_dir() ! build.error("Cannot find the home directory for the object cache")
    let root = helper.add(home, ".valk")
    if !fs.is_dir(root) : fs.create_dir(root) ! build.error("Failed to create object cache directory: " + root)
    root = helper.add(root, "cache")
    if !fs.is_dir(root) : fs.create_dir(root) ! build.error("Failed to create object cache directory: " + root)

    let identity = build.options.path_out ?? (fs.cwd() ! build.error("Cannot find the current directory"))
    identity += "|"
    if build.options.mode == BUILDTYPE.lib : identity += "lib"
    else if build.options.mode == BUILDTYPE.ir : identity += "ir"
    else : identity += "exe"
    identity += "|"
    identity += build.options.target.target
    identity += build.options.optimize ? "|opt" : "|no-opt"
    if build.options.cpu != "generic" : identity += "|cpu:" + build.options.cpu
    if build.options.debug : identity += "|debug"
    identity += build.options.is_test ? "|test" : "|no-test"
    if build.options.use_clang : identity += "|clang"
    else : identity += "|llvm"
    identity += "|"
    identity += VERSION
    let dir = helper.add(root, helper.ctxhash(identity))
    if !fs.is_dir(dir) : fs.create_dir(dir) ! build.error("Failed to create object cache directory: " + dir)
    write_cache_stamp(helper.add(dir, CACHE_USED_STAMP), time.unix_ms())
    build.cache.object_dir = dir
    build.print_verbose(1, "📦 Cache directory: " + dir)
    return dir
}

////////////////////////////
// Cache upkeep
////////////////////////////

value CACHE_USED_STAMP ("last-used")
value CACHE_TRIM_STAMP ("last-trim")
value CACHE_MINUTE_MS (60 * 1000)
value CACHE_HOUR_MS (60 * CACHE_MINUTE_MS)
value CACHE_TRIM_BUDGET_MS (200)
// A cache directory that no build used for this long is removed
value CACHE_KEEP_MS (5 * 24 * CACHE_HOUR_MS)

fn write_cache_stamp(path: String, now_ms: uint) {
    fs.write(path, now_ms.to(String)) _
}

fn read_cache_stamp(path: String) ?uint {
    let text = fs.read(path) !? ""
    if text.length == 0 : return null
    return text.to(uint) !? null
}

// Files of units this build no longer has are removed. Runs while the build holds the cache lock.
fn prune_unit_cache(build: Build) {
    let dir = build.cache.object_dir
    if dir.length == 0 : return
    let keep = HashSet[String]{}
    keep.add("cache.lock")
    keep.add(CACHE_USED_STAMP)
    each build.lists.units as unit {
        keep.add(unit.name + ".o")
        keep.add(unit.name + ".ir-prev")
        if build.options.use_clang : keep.add(unit.name + ".ir")
    }
    let names = fs.files_in(dir, false, true, false, true) ! return
    each names as name {
        if !keep.has(name) : fs.delete_file(helper.add(dir, name)) _
    }
}

// Once an hour, cache directories that no build used recently are removed. A build spends at
// most CACHE_TRIM_BUDGET_MS on it; what is left goes at a build a minute later
fn trim_object_cache(build: Build) {
    let dir = build.cache.object_dir
    if dir.length == 0 : return
    let root = fs.dir_of(dir)
    let now = time.unix_ms()
    let trim_stamp = helper.add(root, CACHE_TRIM_STAMP)
    let last = read_cache_stamp(trim_stamp)
    if isset(last) && last <= now && now - last < CACHE_HOUR_MS : return
    write_cache_stamp(trim_stamp, now)

    let start = time.mono_ms()
    let names = fs.files_in(root, false, false, true, true) ! return
    let removed: uint = 0
    each names as name {
        let path = helper.add(root, name)
        if path == dir || !cache_dir_unused(path, now) : continue
        if time.mono_ms() - start >= CACHE_TRIM_BUDGET_MS {
            write_cache_stamp(trim_stamp, now - CACHE_HOUR_MS + CACHE_MINUTE_MS)
            break
        }
        if remove_cache_dir(path, now) : removed++
    }
    if removed > 0 : build.print_verbose(1, "📦 Removed " + removed + " unused cache directories")
}

// The `last-used` stamp's time, or the directory's for caches older than the stamp
fn cache_dir_unused(path: String, now: uint) bool {
    let used = fs.modified_time(helper.add(path, CACHE_USED_STAMP)) !? (fs.modified_time(path) !? 0)
    return cache_expired(used / 1000000, now)
}

fn cache_expired(used: uint, now: uint) bool {
    // A stamp from a clock that ran ahead counts as unused once it is far off
    if used > now : return used - now >= CACHE_KEEP_MS
    return now - used >= CACHE_KEEP_MS
}

// A build that uses the directory holds its lock, and one that starts stamps it first
fn remove_cache_dir(path: String, now: uint) bool {
    let lock_path = helper.add(path, "cache.lock")
    let lock = fs.try_lock(lock_path) !? null
    if !isset(lock) : return false
    // Taking the lock touched the directory, so only a stamp written since then counts
    let stamp = fs.modified_time(helper.add(path, CACHE_USED_STAMP)) !? 0
    let unused = stamp == 0 || cache_expired(stamp / 1000000, now)
    if unused {
        let names = fs.files_in(path, false, true, true, true) !? Array[String]{}
        each names as name {
            if name != "cache.lock" : fs.delete_all(helper.add(path, name)) _
        }
    }
    lock.unlock() _
    if !unused : return false
    fs.delete_file(lock_path) _
    fs.delete_dir(path) _
    return true
}

fn llvm_emit_object(task: shared ObjectTask) ?String {
    @unsafe
    let target: ?llvm.LLVMTargetRef = null
    let message: ?cstring = null
    if llvm.LLVMGetTargetFromTriple(task.llvm_triple.data_cstring, @ref(target), @ref(message)) {
        let detail = llvm_message_text(message)
        if isset(message) : llvm.LLVMDisposeMessage(message)
        return "LLVM could not select target '" + task.llvm_triple + "': " + detail
    }
    if !isset(target) : return "LLVM did not create a target for: " + task.llvm_triple

    // "native" asks LLVM for the compiling machine's CPU and features
    let cpu = task.cpu
    let features = ""
    if cpu == "native" {
        let host_cpu = llvm.LLVMGetHostCPUName()
        let host_features = llvm.LLVMGetHostCPUFeatures()
        cpu = host_cpu
        features = host_features
        llvm.LLVMDisposeMessage(host_cpu)
        llvm.LLVMDisposeMessage(host_features)
    }
    let level: i32 = task.optimize ? llvm.LLVMCodeGenLevelAggressive : (task.debug ? llvm.LLVMCodeGenLevelNone : llvm.LLVMCodeGenLevelDefault)
    let machine = llvm.LLVMCreateTargetMachine(target, task.llvm_triple.data_cstring, cpu.data_cstring, features.data_cstring, level, llvm.LLVMRelocPIC, llvm.LLVMCodeModelDefault)
    if !isset(machine) : return "LLVM failed to create a target machine for: " + task.llvm_triple

    let context = llvm.LLVMContextCreate()
    let name = task.unit_name + ".ll"
    let buffer = llvm.LLVMCreateMemoryBufferWithMemoryRangeCopy(task.ir_code.data, task.ir_code.bytes, name.data_cstring)
    let module: ?llvm.LLVMModuleRef = null
    message = null

    if llvm.LLVMParseIRInContext(context, buffer, @ref(module), @ref(message)) {
        let detail = llvm_message_text(message)
        if isset(message) : llvm.LLVMDisposeMessage(message)
        llvm.LLVMContextDispose(context)
        llvm.LLVMDisposeTargetMachine(machine)
        return "LLVM IR parse failed while emitting unit '" + task.unit_name + "':\n" + detail
    }
    if !isset(module) {
        llvm.LLVMContextDispose(context)
        llvm.LLVMDisposeTargetMachine(machine)
        return "LLVM IR parser did not create a module while emitting unit: " + task.unit_name
    }

    message = null
    if llvm.LLVMVerifyModule(module, llvm.LLVMReturnStatusAction, @ref(message)) {
        let detail = llvm_message_text(message)
        if isset(message) : llvm.LLVMDisposeMessage(message)
        llvm.LLVMDisposeModule(module)
        llvm.LLVMContextDispose(context)
        llvm.LLVMDisposeTargetMachine(machine)
        return "LLVM IR verification failed while emitting unit '" + task.unit_name + "':\n" + detail
    }
    if isset(message) {
        llvm.LLVMDisposeMessage(message)
        message = null
    }

    llvm_configure_object_module(module, machine, task.llvm_triple)
    let opt_error = llvm_optimize_object_module(module, machine, task.optimize, task.debug)
    if isset(opt_error) {
        llvm.LLVMDisposeModule(module)
        llvm.LLVMContextDispose(context)
        llvm.LLVMDisposeTargetMachine(machine)
        return "LLVM optimization failed for unit '" + task.unit_name + "':\n" + opt_error
    }

    if llvm.LLVMTargetMachineEmitToFile(machine, module, task.path_o.data_cstring, llvm.LLVMObjectFile, @ref(message)) {
        let detail = llvm_message_text(message)
        if isset(message) : llvm.LLVMDisposeMessage(message)
        llvm.LLVMDisposeModule(module)
        llvm.LLVMContextDispose(context)
        llvm.LLVMDisposeTargetMachine(machine)
        return "LLVM failed to emit object for unit '" + task.unit_name + "':\n" + detail
    }

    if isset(message) : llvm.LLVMDisposeMessage(message)
    llvm.LLVMDisposeModule(module)
    llvm.LLVMContextDispose(context)
    llvm.LLVMDisposeTargetMachine(machine)
    return null
}

// A CPU name LLVM does not know ends in a fatal error on x86, deep inside code
// generation. One tiny module compiled first, on this thread, reports it in one place
fn llvm_check_cpu(build: Build) !Error {
    @unsafe
    llvm.LLVMInstallFatalErrorHandler(llvm_fatal_error.@cast(ptr))
    let cpu = build.options.cpu
    if cpu == "generic" : return
    fatal_cpu_hint = cpu
    let dir = object_output_dir(build) !>
    let probe: shared ObjectTask = ObjectTask {
        unit_name: "cpu-probe"
        ir_code: "define void @valk_cpu_probe() {\n  ret void\n}\n"
        path_o: helper.add(dir, "cpu-probe.o")
        path_ir: ""
        llvm_triple: ir_target_triple(build.options.target)
        cpu: cpu
        clang_command: ""
        optimize: false
        debug: false
    }
    let error = llvm_emit_object(probe)
    fs.delete_file(probe.path_o) _
    fatal_cpu_hint = ""
    if isset(error) : build.error("LLVM cannot compile for CPU '" + cpu + "': " + error)
}

global fatal_cpu_hint: String ("")

fn llvm_fatal_error(reason: cstring) {
    let message: String = reason
    if fatal_cpu_hint != "" {
        build_error("LLVM cannot compile for CPU '" + fatal_cpu_hint + "': " + message + "\nUse an LLVM CPU name such as x86-64-v3 or apple-m1, or native for this machine")
    }
    build_error("LLVM: " + message)
}

fn llvm_message_text(message: ?cstring) String {
    if !isset(message) : return "<no LLVM diagnostic>"
    return message
}

fn llvm_configure_object_module(module: llvm.LLVMModuleRef, machine: llvm.LLVMTargetMachineRef, triple: String) {
    @unsafe
    llvm.LLVMSetTarget(module, triple.data_cstring)
    let layout = llvm.LLVMCreateTargetDataLayout(machine)
    let text = llvm.LLVMCopyStringRepOfTargetData(layout)
    llvm.LLVMSetDataLayout(module, text)
    llvm.LLVMDisposeMessage(text)
    llvm.LLVMDisposeTargetData(layout)
}

// Unoptimized builds still run two passes: `always-inline` is what makes the
// `$inline` flag mean anything, and `mem2reg` promotes the alloca-per-local.
// A debug build keeps the locals in memory for the debugger.
fn llvm_optimize_object_module(module: llvm.LLVMModuleRef, machine: llvm.LLVMTargetMachineRef, optimize: bool, debug: bool) ?String {
    @unsafe
    let options = llvm.LLVMCreatePassBuilderOptions()
    let passes = optimize ? "default<O3>" : (debug ? "always-inline" : "always-inline,function(mem2reg)")
    let error = llvm.LLVMRunPasses(module, passes.data_cstring, machine, options)
    llvm.LLVMDisposePassBuilderOptions(options)
    if !isset(error) : return null
    let message = llvm.LLVMGetErrorMessage(error)
    let detail: String = message
    llvm.LLVMDisposeErrorMessage(message)
    return detail
}

fn llvm_init_object_target(target: Target) {
    if target.arch == "x64" {
        llvm.LLVMInitializeX86TargetInfo()
        llvm.LLVMInitializeX86Target()
        llvm.LLVMInitializeX86TargetMC()
        llvm.LLVMInitializeX86AsmPrinter()
    } else {
        llvm.LLVMInitializeAArch64TargetInfo()
        llvm.LLVMInitializeAArch64Target()
        llvm.LLVMInitializeAArch64TargetMC()
        llvm.LLVMInitializeAArch64AsmPrinter()
    }
}

use valkir
use helper
use valk:core
use valk:fs

// Emit one native object for every Unit/IR module. Linking deliberately
// remains a separate stage.
fn emit_unit_objects(build: Build) !Error {
    if build.options.use_clang {
        emit_unit_objects_clang(build) !>
        return
    }
    emit_unit_objects_valkir(build) !>
}

// Default backend: valkir turns the textual IR into a relocatable object
// in-process, so a build needs no external toolchain besides the linker.
fn emit_unit_objects_valkir(build: Build) !Error {
    let target = valkir:Target.parse(build.options.target.target) ! {
        build.error("valkir does not support target: " + build.options.target.target)
    }

    each build.lists.units as unit {
        if prepare_unit_object(build, unit) !> : continue
        build.print_verbose(3, "> Generating object file: " + unit.path_o)
        valkir:compile(unit.ir_code, unit.path_o, target) ! {
            emit_fail_with_ir(build, unit, "valkir failed while emitting unit '" + unit.name + "':\n" + E.message) !>
        }
        commit_unit_object_cache(build, unit) !>
    }
}

// --clang backend: same cache layout, but each unit's IR file is handed to a
// `clang` on PATH. One process per unit, and it is clang that decides how the
// IR is optimized and encoded.
fn emit_unit_objects_clang(build: Build) !Error {
    each build.lists.units as unit {
        if prepare_unit_object(build, unit) !> : continue
        build.print_verbose(3, "> Generating object file (clang): " + unit.path_o)
        let command = clang_object_command(build, unit)
        build.print_verbose(3, "# " + command)
        let code, output = core:exec(command)
        if code != 0 {
            emit_fail_with_ir(build, unit, "clang failed while emitting unit '" + unit.name + "':\n# Exit code: " + code + "\n# Output: " + output) !>
        }
        commit_unit_object_cache(build, unit) !>
    }
}

// The IR file was already written by prepare_unit_object. `-x ir` is required
// because the extension is `.ir`, and the explicit triple keeps cross builds
// from following the host default.
fn clang_object_command(build: Build, unit: Unit) String {
    let target = build.options.target
    let cmd = "clang -c -x ir \""
    cmd += unit.path_ir
    cmd += "\" -o \""
    cmd += unit.path_o
    cmd += "\" --target="
    cmd += ir_target_triple(target)
    // The linker builds a PIE; Windows objects are position independent anyway
    // and clang rejects the flag as unused there.
    if target.os != "win" : cmd += " -fPIC"
    // No -g: the generated IR carries no debug metadata for clang to keep.
    cmd += build.options.optimize ? " -O3" : " -O0"
    return cmd
}

// path_ir       — IR about to be compiled (written before emit; kept on failure)
// path_ir-prev  — IR that produced path_o (updated only after a successful emit)
// Returns true when the object is already up to date (or the unit has no IR).
fn prepare_unit_object(build: Build, unit: Unit) bool !Error {
    if unit.ir_code.length == 0 : return true
    let dir = object_output_dir(build) !>
    unit.path_o = helper:add(dir, unit.name + ".o")
    unit.path_ir = helper:add(dir, unit.name + ".ir")

    let path_prev = unit.path_ir + "-prev"
    let unchanged = !build.options.is_clean_build
        && fs:exists(unit.path_o)
        && helper:file_has_same_content(path_prev, unit.ir_code)
    if unchanged {
        unit.ir_code = ""
        return true
    }

    fs:write(unit.path_ir, unit.ir_code) ! build.error("Failed to write IR: " + unit.path_ir)
    return false
}

// Mark the object as matching this IR after a successful emit.
fn commit_unit_object_cache(build: Build, unit: Unit) !Error {
    let path_prev = unit.path_ir + "-prev"
    fs:write(path_prev, unit.ir_code) ! build.error("Failed to write cached IR: " + path_prev)
    // The parsed AST was already released after per-function IR emission,
    // and executable builds no longer need the textual module after its
    // object has been produced.
    unit.ir_code = ""
}

// path_ir was already written by prepare_unit_object; include it in the error.
fn emit_fail_with_ir(build: Build, unit: Unit, msg: String) !Error {
    build.error(msg + "\nIR: " + unit.path_ir)
}

fn object_output_dir(build: Build) String !Error {
    if build.cache.object_dir.length > 0 : return build.cache.object_dir

    let home = fs:home_dir() ! build.error("Cannot find the home directory for the object cache")
    let root = helper:add(home, ".valk")
    if !fs:is_dir(root) : fs:mkdir(root) ! build.error("Failed to create object cache directory: " + root)
    root = helper:add(root, "cache")
    if !fs:is_dir(root) : fs:mkdir(root) ! build.error("Failed to create object cache directory: " + root)

    let identity = build.options.path_out ?? fs:cwd()
    identity += "|"
    if build.options.mode == BUILDTYPE.lib : identity += "lib"
    else if build.options.mode == BUILDTYPE.ir : identity += "ir"
    else : identity += "exe"
    identity += "|"
    identity += build.options.target.target
    identity += build.options.optimize ? "|opt" : "|no-opt"
    identity += build.options.debug ? "|debug" : "|no-debug"
    identity += build.options.is_test ? "|test" : "|no-test"
    // Keep the valkir and clang object caches separate so switching backends
    // never reuses an object produced by the other.
    identity += build.options.use_clang ? "|clang" : "|valkir"
    // Same IR does not mean same object: the compiler that turns one into the
    // other is an input too. Without this, a codegen change is invisible to
    // every unit whose IR text happens not to have moved.
    identity += "|"
    identity += VERSION
    let dir = helper:add(root, helper:ctxhash(identity))
    if !fs:is_dir(dir) : fs:mkdir(dir) ! build.error("Failed to create object cache directory: " + dir)
    build.cache.object_dir = dir
    build.print_verbose(1, "📦 Cache directory: " + dir)
    return dir
}

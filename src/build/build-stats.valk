use helper

// Collected during / after a build.
class BuildStats {
    // Lines of code counted while tokenizing
    LOC: uint (0)
    // Wall-clock duration of Build.run in microseconds
    duration_us: uint (0)
    // Peak GC memory usage in bytes
    mem_peak: uint (0)

    // Print LOC, peak memory, and duration.
    fn print() {
        if this.LOC > 0 {
            helper:msg("📝", "LOC: " + this.LOC)
        }
        let mem_mb = this.mem_peak.to(float) / 1024 / 1024
        let seconds = this.duration_us.to(float) / 1000000
        helper:msg("📈", "Compiler memory usage: " + mem_mb + " mb")
        helper:msg("✅", "Compiled in " + seconds + "s")
    }
}

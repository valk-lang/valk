use helper

// Collected during / after a build.
class BuildStats {
    // Lines of code counted while tokenizing
    LOC: uint (0)
    // Wall-clock duration of Build.run in microseconds
    duration_us: uint (0)
    // Time spent resolving function bodies and generating their LLVM IR.
    func_ir_us: uint (0)
    // Time spent converting LLVM modules into native object files.
    object_us: uint (0)
    // Time spent linking the object files into the final output.
    link_us: uint (0)
    // Peak GC memory usage in bytes
    mem_peak: uint (0)

    // Print LOC, peak memory, and duration. Detailed phase timings are shown
    // for verbose builds; the normal summary remains compact. `summary` is off
    // when the caller reports the outcome itself (--ir / --run).
    fn print(verbose: uint (0), summary: bool (true)) {
        let mem_mb = this.mem_peak.to(float) / 1024 / 1024
        let seconds = this.duration_us.to(float) / 1000000
        if verbose > 0 {
            if this.LOC > 0 {
                helper:msg("📝", "LOC: " + this.LOC)
            }
            let func_seconds = this.func_ir_us.to(float) / 1000000
            let object_seconds = this.object_us.to(float) / 1000000
            let link_seconds = this.link_us.to(float) / 1000000
            helper:msg("⌚️", "Function AST + IR: " + func_seconds + "s")
            helper:msg("⌚️", "Object generation: " + object_seconds + "s")
            helper:msg("⌚️", "Linking: " + link_seconds + "s")
            helper:msg("📈", "Compiler memory usage: " + mem_mb + " mb")
        }
        if summary : helper:msg("✅", "Compiled in " + seconds + "s")
    }
}

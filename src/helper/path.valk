
use valk.fs

fn valk_lib_dir() String {
    return resolve(add(fs.exe_dir() ! panic("Cannot find the compiler directory"), "lib"))
}

fn resolve(path: String, cwd: ?String (null)) String {
    // Use correct slashes
    path = path.replace(fs.PATH_DIV_REPLACE, fs.PATH_DIV)
    // Remove double slashes (except at start)
    if path.contains(fs.PATH_DIV_TWICE) {
        let starts_with_div2 = path.starts_with(fs.PATH_DIV_TWICE)
        while path.contains(fs.PATH_DIV_TWICE) : path = path.replace(fs.PATH_DIV_TWICE, fs.PATH_DIV)
        if starts_with_div2 : path = fs.PATH_DIV + path
    }
    // Replace dots
    cwd = cwd ?? (fs.cwd() ! panic("Cannot find the current directory"))
    if path == "." : path = cwd
    else if path.starts_with(fs.PATH_DOT_DIV) : path = add(cwd, path.part(1, path.length - 1))
    else if (path.get(0) != '/' && path.get(1) != ':') && !path.starts_with("\\\\wsl.") : path = add(cwd, path)
    if path.contains("..") || path.contains(fs.PATH_DOT_DIV) || path.contains(fs.PATH_DIV_DOT) {
        path = fs.realpath(path) ! panic("Cannot resolve path: " + path)
    }
    // Consistency
    if path.ends_with(fs.PATH_DIV) : path = path.rtrim(fs.PATH_DIV)
    if path.is_empty() : path = fs.PATH_DIV
    return path
}

fn add(dir: String, fn: String) String {
    return fs.add(dir, fn)
}

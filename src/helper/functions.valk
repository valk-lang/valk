
use valk.ansi
use valk.io
use valk.core

fn msg(emoji: String, msg: String) {
    if ansi.supported() {
        println(emoji + " " + msg)
    } else {
        println("> " + msg)
    }
}

// `msg` on stderr, for errors and warnings
fn error_msg(emoji: String, msg: String) {
    eprintln(ansi.supported() ? emoji + " " + msg : "> " + msg)
}

fn eprintln(text: String) {
    io.stderr().write(text + "\n") _
}

#if OS == "win"
extern fn _isatty(fd: i32) i32;
#else
extern fn isatty(fd: i32) i32;
#end

// Colors only for a terminal, and never when NO_COLOR is set
fn color_output() bool {
    let no_color = core.getenv("NO_COLOR") !? ""
    if !no_color.is_empty() || !ansi.supported() : return false
    #if OS == "win"
    return _isatty(1) != 0
    #else
    return isatty(1) != 0
    #end
}

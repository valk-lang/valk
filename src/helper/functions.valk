
use valk.ansi
use valk.io

fn msg(emoji: String, msg: String) {
    if ansi.supported() {
        println(emoji + " " + msg)
    } else {
        println("> " + msg)
    }
}

// `msg` on stderr, for errors and warnings
fn error_msg(emoji: String, msg: String) {
    eprintln(ansi.supported() ? emoji + " " + msg : "> " + msg)
}

fn eprintln(text: String) {
    io.stderr().write(text + "\n") _
}


+ union PkgLookupError {
    missing(String)
    nosrc(String)
    noversion(String)
    invalidsrc(String)

    + get msg: String {
        return match this : String {
            .missing(m) => m
            .nosrc(m) => m
            .noversion(m) => m
            .invalidsrc(m) => m
        }
    }
}

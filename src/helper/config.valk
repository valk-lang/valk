
use valk.json
use valk.fs
use helper

class Config {
    json: json.Value
    path: String
    dir: String

    static fn load(path: String) ?Config !json.ParseError {
        let content = fs.read(path) ! {
            return null
        }
        let j = json.decode(content) !>
        return Config {
            json: j
            path: path
            dir: fs.dir_of(path)
        }
    }

    fn has_pkg(name: String) bool {
        return this.json.get("dependencies").object.has(name)
    }

    fn get_package_dir(name: String) String !PkgLookupError {
        let dep = this.json.get("dependencies").object.get(name) ! throw .missing("Dependency '%name' not found")
        let src = dep.get("src").string_value() !? ""
        if src.is_empty() : throw .nosrc("Dependency '%name' has an empty 'src'")

        if src.starts_with(".") {
            return helper.add(this.dir, src)
        } else if src.starts_with("github.com/") {
            let project = src.range("github.com/".length, src.length)
            let parts = project.split("/")
            let user = parts.get(0) ! throw .invalidsrc("Invalid github.com dependency 'src' for '%name'")
            let repo = parts.get(1) ! throw .invalidsrc("Invalid github.com dependency 'src' for '%name'")
            let assoc = "github-" + user + "-" + repo

            let current = dep.get("current").string_value() !? ""
            if current.is_empty() : current = dep.get("version").string_value() !? ""
            if !SELF.is_valid_version(current) : throw .noversion("Dependency '%name' has an invalid version")
            let vendor = helper.add(this.dir, "vendor")
            let dir = helper.add(helper.add(vendor, assoc), current)
            if !fs.exists(dir) {
                let nested = helper.add(helper.add(vendor, src), current)
                if fs.exists(nested) : return nested
                // '@' cannot appear in a github user or repo name: ./vendor/github-{user}@{repo}/{version}
                let at = helper.add(helper.add(vendor, "github-" + user + "@" + repo), current)
                if fs.exists(at) : return at
                // Legacy: ./vendor/github.com.{user}.{repo}/{version}
                let dotted = helper.add(helper.add(vendor, src.replace("/", ".")), current)
                if fs.exists(dotted) : return dotted
            }
            return dir
        }

        throw .invalidsrc("Invalid dependency 'src' for '%name': use a relative directory starting with '.', or 'github.com/{user}/{repo}' for a package on GitHub")
    }

    fn get_nsc_dir(name: String) ?String {
        let dir = this.json.get("namespaces").get(name).string_value() !? ""
        if dir.bytes == 0 : return null
        return dir
    }

    static fn is_valid_version(v: String) bool {
        let parts = v.split(".")
        if parts.length != 3 : return false
        (parts.get(0) !? "0").to_uint() ! return false
        (parts.get(1) !? "0").to_uint() ! return false
        (parts.get(2) !? "0").to_uint() ! return false
        return true
    }
}

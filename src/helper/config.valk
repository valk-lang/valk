
use valk:json
use valk:fs
use helper

class Config{
    json: json:Value
    path: String
    dir: String

    static fn load(path: String) ?Config !json:ParseError {
        let content = fs:read(path) ! {
            return null
        }
        let j = json:decode(content) !>
        return Config {
            json: j
            path: path
            dir: fs:dir_of(path)
        }
    }

    fn has_pkg(name: String) bool {
        return this.json.get("dependencies").object().values.has(name)
    }

    fn get_package_dir(name: String) String !PkgLookupError {
        let deps = this.json.get("dependencies").object().values
        let dep = deps.get(name) ! throw .missing { msg: "Dependency '%name' not found" }
        let src = dep.get("src").string()
        if src.is_empty() : throw .nosrc { msg: "Dependency '%name' has an empty 'src'" }

        if src.starts_with(".") {
            return helper:add(this.dir, src)
        } else if src.starts_with("github.com/") {
            let project = src.part("github.com/".length, src.length)
            let parts = project.split("/")
            let user = parts.get(0) ! throw .invalidsrc { msg: "Invalid github.com dependency 'src' for '%name'" }
            let repo = parts.get(1) ! throw .invalidsrc { msg: "Invalid github.com dependency 'src' for '%name'" }
            let assoc = "github-" + user + "-" + repo

            let current = dep.get("current").string()
            if current.is_empty() : current = dep.get("version").string()
            if !SELF.is_valid_version(current) : throw .noversion { msg: "Dependency '%name' has an invalid version" }
            let vendor = helper:add(this.dir, "vendor")
            let dir = helper:add(helper:add(vendor, assoc), current)
            if !fs:exists(dir) {
                let nested = helper:add(helper:add(vendor, src), current)
                if fs:exists(nested) : return nested
                // '@' cannot appear in a github user or repo name: ./vendor/github-{user}@{repo}/{version}
                let at = helper:add(helper:add(vendor, "github-" + user + "@" + repo), current)
                if fs:exists(at) : return at
                // Legacy: ./vendor/github.com.{user}.{repo}/{version}
                let dotted = helper:add(helper:add(vendor, src.replace("/", ".")), current)
                if fs:exists(dotted) : return dotted
            }
            return dir
        }

        throw .invalidsrc { msg: "Invalid depedency 'src' for '%name'. It should start with either '.' for a directory or 'github.com/' for a package on github." }
    }

    fn get_nsc_dir(name: String) ?String {
        let dir = this.json.get("namespaces").get(name).string()
        if dir.bytes == 0 : return null
        return dir
    }

    static fn is_valid_version(v: String) bool {
        let parts = v.split(".")
        if parts.length != 3 : return false
        (parts.get(0) !? "0").to_uint() ! return false
        (parts.get(1) !? "0").to_uint() ! return false
        (parts.get(2) !? "0").to_uint() ! return false
        return true
    }

    static fn find_for_fc(path: fs:Path) ?SELF {
        path = path.resolve().pop()
        while true {
            let cfg_path = path.add("/valk.json")
            if fs:exists(cfg_path) : return SELF.load(cfg_path) !? null

            let before = path
            path = path.pop()
            if path == before : break
        }
        return null
    }
    fn get_fc_namespace(path: fs:Path) ?String {
        let namespaces = this.json.get("namespaces").object().values
        each namespaces as ns, name {
            match ns {
                String as _ => {
                    let dir = this.get_nsc_dir(name)
                    if isset(dir) {
                        dir = helper:resolve(helper:add(this.dir, dir)) + fs:PATH_DIV
                        if path.starts_with(dir) {
                            return name
                        }
                    }
                }
                default => {}
            }
        }
        return null
    }
}

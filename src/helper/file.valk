
use valk.fs
use valk.io
use valk.mem
use valk.ext
use valk.time

// `CreateFileA` comes from the standard library's `ext`: one C symbol may only
// have one prototype in a program. Locking has no stdlib API yet.
#if OS != win
extern fn flock(fd: i32, operation: i32) i32;
#end

@ignore_access

fn lock_acquire(path: String) io.Fd !LookupError {
    #if OS == win
    @unsafe
    while true {
        let handle = ext.CreateFileA(path.data_cstring, ext.GENERIC_READ | ext.GENERIC_WRITE, 0, null, ext.OPEN_ALWAYS, ext.FILE_ATTRIBUTE_NORMAL, 0)
        if handle != ext.INVALID_HANDLE_VALUE : return handle
        time.sleep_ms(20)
    }
    throw .missing
    #else
    let fd = fs.open(path, fs.OpenOptions {
        write: true
        append: true
        create: true
    }) ! throw .missing
    if flock(fd, ext.LOCK_EX) != 0 {
        io.close(fd) ! {}
        throw .missing
    }
    return fd
    #end
}

fn lock_release(handle: io.Fd) {
    #if OS == win
    ext.CloseHandle(handle)
    #else
    // Closing the descriptor drops the lock with it.
    io.close(handle) ! {}
    #end
}

fn file_has_same_content(path: String, content: String) bool {
    @unsafe

    let len = content.length
    let fd = fs.open(path) ! return false
    defer io.close(fd) ! {}
    let pos : uint = 0
    let str_data = content.data
    let buf : [u8 x 10240] = @undefined

    while pos < len {
        let read_size: uint = 10240
        if read_size > len - pos : read_size = len - pos
        let readcount = io.read_bytes(fd, &buf, read_size, pos) ! {
            return false
        }
        if readcount == 0 {
            return false
        }
        if !mem.equal_bytes(&buf, str_data + pos, readcount) {
            return false
        }
        pos += readcount
    }

    let trailing = io.read_bytes(fd, &buf, 1, pos) ! {
        return false
    }
    return trailing == 0
}

+ fn modified_time(path: String) uint !LookupError {
    // The standard library reads the time on every OS
    return fs.modified_time(path) ! throw .missing
}

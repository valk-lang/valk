
use valk:fs
use valk:io
use valk:mem
use valk:ext
use valk:time

#if OS == win
extern fn CreateFileA(path: cstring, access: u32, share_mode: u32, lpSecurityAttributes: ?ptr, dwCreationDisposition: u32, dwFlagsAndAttributes: u32, hTemplateFile: ext:HANDLE) ext:HANDLE;
extern fn GetFileTime(file: ext:HANDLE, created_at: ?*ext:libc_FILETIME, last_access_at: ?*ext:libc_FILETIME, modified_at: ?*ext:libc_FILETIME) i32;
#else
extern fn flock(fd: i32, operation: i32) i32;
#end

@ignore_access

fn lock_acquire(path: String) io:FD !LookupError {
    #if OS == win
    while true {
        let handle = CreateFileA(path.data_cstring, ext:GENERIC_READ | ext:GENERIC_WRITE, 0, null, ext:OPEN_ALWAYS, ext:FILE_ATTRIBUTE_NORMAL, 0)
        if handle != ext:INVALID_HANDLE_VALUE : return handle
        time:sleep_ms(20)
    }
    throw .missing
    #else
    let fd = fs:open_extend(path, true, true, true) ! throw .missing
    if flock(fd, ext:LOCK_EX) != 0 {
        io:close(fd) ! { }
        throw .missing
    }
    return fd
    #end
}

fn lock_release(handle: io:FD) !LookupError {
    #if OS == win
    if ext:CloseHandle(handle) == 0 : throw .missing
    #else
    // Closing the descriptor drops the lock with it.
    io:close(handle) ! throw .missing
    #end
}

fn file_has_same_content(path: String, content: String) bool {

    let len = content.length
    let fd = fs:open(path, false, false) ! return false
    let pos : uint = 0
    let str_data = content.data
    let buf : [u8 x 10240] = @undefined

    while pos < len {
        let read_size: uint = 10240
        if read_size > len - pos : read_size = len - pos
        let readcount = io:read_to_ptr(fd, &buf, read_size, pos) ! {
            io:close(fd) ! { }
            return false
        }
        if readcount == 0 {
            io:close(fd) ! { }
            return false
        }
        if !mem:equal(&buf, str_data + pos, readcount) {
            io:close(fd) ! { }
            return false
        }
        pos += readcount
    }

    let trailing = io:read_to_ptr(fd, &buf, 1, pos) ! {
        io:close(fd) ! { }
        return false
    }
    io:close(fd) ! return false
    return trailing == 0
}

+ fn modified_time(path: String) uint !LookupError {
    #if OS == win
    let ftMod : ext:libc_FILETIME = @undefined
    let hndl = CreateFileA(path.data_cstring, ext:FILE_READ_ATTRIBUTES, ext:FILE_SHARE_READ | ext:FILE_SHARE_WRITE, null, ext:OPEN_EXISTING, ext:FILE_FLAG_BACKUP_SEMANTICS, 0)
    if hndl == ext:INVALID_HANDLE_VALUE : throw .missing
    if GetFileTime(hndl, null, null, @ref(ftMod)) == 0 : throw .missing
    // FILETIME = 100-ns ticks since 1601-01-01 UTC
    let ticks : u64 = (ftMod.dwHighDateTime.@cast(u64) << 32) | ftMod.dwLowDateTime
    // Subtract difference between 1601-01-01 and 1970-01-01
    let ns100 = ticks - 116444736000000000
    return ns100 * 100 // to nanoseconds
    #else
    return fs:modified_time(path) ! throw .missing
    #end
}

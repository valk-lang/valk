
use valk.fs
use valk.io
use valk.mem
use valk.ext
use valk.time


@ignore_access

// The build's object-cache lock, released by `lock_release` or at exit
fn lock_acquire(path: String) fs.FileLock !LookupError {
    return fs.lock(path) ! throw .missing
}

fn lock_release(lock: fs.FileLock) {
    lock.unlock() ! {}
}

fn file_has_same_content(path: String, content: String) bool {
    @unsafe

    let len = content.length
    let fd = fs.open(path) ! return false
    defer io.close(fd) ! {}
    let pos : uint = 0
    let buf : [u8 x 10240] = @undefined
    let window: local mut &[u8] = &buf

    while pos < len {
        let read_size: uint = 10240
        if read_size > len - pos : read_size = len - pos
        let readcount = io.read(fd, window.view(0, read_size), pos) ! return false
        if readcount == 0 : return false
        if !mem.equals(window.view(0, readcount), content.view(pos, readcount)) : return false
        pos += readcount
    }

    let trailing = io.read(fd, window.view(0, 1), pos) ! return false
    return trailing == 0
}

+ fn modified_time(path: String) uint !LookupError {
    // The standard library reads the time on every OS
    return fs.modified_time(path) ! throw .missing
}


// A 128-bit content hash, printed as 22 base62 characters.
//
// The output keys things where a collision is a miscompile, not a slowdown:
// object cache directories and unit/object filenames, generic instantiation
// keys, allocator and interface-adapter symbol names, and runtime error codes.
// Inputs are short (paths, type keys), so clarity beats block-at-a-time speed.

// 11 base62 digits per lane: 62^11 > 2^65, so a full u64 survives intact.
fn ctxhash(content: String) String {
    let mix = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".data
    let lane1, lane2 = ctxhash_128(content)
    let buf : [u8 x 22] = @undefined

    let i: uint = 0
    while i < 11 {
        @ptrv(buf, u8, i) = @ptrv(mix, u8, (lane1 % 62).to(uint))
        lane1 /= 62
        i++
    }
    while i < 22 {
        @ptrv(buf, u8, i) = @ptrv(mix, u8, (lane2 % 62).to(uint))
        lane2 /= 62
        i++
    }
    return String.make_from_ptr(buf, 22)
}

fn ctxhash_u32(content: String) u32 {
    let lane1, lane2 = ctxhash_128(content)
    return (lane1 ^ lane2).to(u32)
}

// Two lanes absorb every byte, then a finalizer avalanches each into the other,
// so any single-byte change reaches every character of the printed hash.
fn ctxhash_128(content: String) (u64, u64) {
    let data = content.data
    let len = content.bytes

    // FNV-1a offset basis / prime, and the golden-ratio constant.
    let lane1: u64 = 14695981039346656037
    let lane2: u64 = 11400714819323198485
    let fnv_prime: u64 = 1099511628211

    let pos: uint = 0
    while pos < len {
        let ch = @ptrv(data, u8, pos++).to(u64)
        lane1 = (lane1 ^ ch) * fnv_prime
        // Feeding lane1 back in keeps the lanes from drifting into the same
        // state for inputs that only differ in length.
        lane2 = ctxhash_rotl(lane2 + ch + 1, 29) ^ lane1
    }

    lane1 = ctxhash_mix(lane1 ^ len)
    lane2 = ctxhash_mix(lane2 ^ ctxhash_rotl(lane1, 32))
    lane1 = ctxhash_mix(lane1 + lane2)
    return (lane1, lane2)
}

// murmur3 64-bit finalizer
fn ctxhash_mix(x: u64) u64 {
    x ^= x >> 33
    x *= 18397679294719823053
    x ^= x >> 29
    x *= 14181476777654086739
    x ^= x >> 32
    return x
}

fn ctxhash_rotl(x: u64, bits: u64) u64 {
    return (x << bits) | (x >> (64 - bits))
}

use build
use helper

@ignore_access

fn completion_action(args: Array[String]) i32 {
    let shell = args.get(0) !? ""
    if shell == "bash" : print(completion_bash())
    else if shell == "zsh" : print(completion_zsh())
    else if shell == "fish" : print(completion_fish())
    else {
        helper.eprintln("Usage: valk completion {bash|zsh|fish}")
        return 1
    }
    return 0
}

fn completion_commands() String {
    return "build run make ls doc fmt lsp version completion"
}

// The options of `valk build`, also accepted by `run` and `doc`
fn completion_build_options() String {
    return "-o --run -r --watch -w --test -t --filter --clean -c --opt --no-warn -nw --no-warn-deprecated --parse-all --ignore-unsafe --lint --release --debug -d --def --target --ir --lib --static --static-lib --clang -L -l --no-system-libs --stdlib --link-arg --link-arg-append --sysroot --fmt --check -v -vv -vvv --help -h"
}

fn completion_bash() String {
    return "# valk completion for bash: valk completion bash > /etc/bash_completion.d/valk\n" +
        "_valk() {\n" +
        "    local cur=\"${COMP_WORDS[COMP_CWORD]}\" prev=\"${COMP_WORDS[COMP_CWORD-1]}\"\n" +
        "    if [ \"$COMP_CWORD\" -eq 1 ]; then\n" +
        "        COMPREPLY=($(compgen -W \"" + completion_commands() + "\" -- \"$cur\"))\n" +
        "        return\n" +
        "    fi\n" +
        "    case \"${COMP_WORDS[1]}\" in\n" +
        "        make|ls)\n" +
        "            if [ \"$COMP_CWORD\" -eq 2 ]; then\n" +
        "                COMPREPLY=($(compgen -W \"$(valk ls --names 2>/dev/null)\" -- \"$cur\"))\n" +
        "                return\n" +
        "            fi ;;\n" +
        "        completion) COMPREPLY=($(compgen -W \"bash zsh fish\" -- \"$cur\")); return ;;\n" +
        "        version|lsp) return ;;\n" +
        "    esac\n" +
        "    case \"$prev\" in\n" +
        "        --target) COMPREPLY=($(compgen -W \"" + build.supported_targets().join(" ") + "\" -- \"$cur\")); return ;;\n" +
        "        -o|--stdlib|-L|--sysroot) COMPREPLY=(); return ;;\n" +
        "    esac\n" +
        "    if [[ \"$cur\" == -* ]]; then\n" +
        "        COMPREPLY=($(compgen -W \"" + completion_build_options() + "\" -- \"$cur\"))\n" +
        "    fi\n" +
        "}\n" +
        "complete -o default -F _valk valk\n"
}

fn completion_zsh() String {
    return "#compdef valk\n" +
        "# valk completion for zsh: valk completion zsh > ~/.zfunc/_valk (with ~/.zfunc in fpath)\n" +
        "_valk() {\n" +
        "    if (( CURRENT == 2 )); then\n" +
        "        compadd -- " + completion_commands() + "\n" +
        "        return\n" +
        "    fi\n" +
        "    case $words[2] in\n" +
        "        make|ls)\n" +
        "            if (( CURRENT == 3 )); then\n" +
        "                compadd -- ${(f)\"$(valk ls --names 2>/dev/null)\"}\n" +
        "                return\n" +
        "            fi ;;\n" +
        "        completion) compadd -- bash zsh fish; return ;;\n" +
        "        version|lsp) return ;;\n" +
        "    esac\n" +
        "    case $words[CURRENT-1] in\n" +
        "        --target) compadd -- " + build.supported_targets().join(" ") + "; return ;;\n" +
        "        -o|--stdlib|-L|--sysroot) _files; return ;;\n" +
        "    esac\n" +
        "    if [[ $PREFIX == -* ]]; then\n" +
        "        compadd -- " + completion_build_options() + "\n" +
        "    else\n" +
        "        _files\n" +
        "    fi\n" +
        "}\n" +
        "if [ \"$funcstack[1]\" = \"_valk\" ]; then\n" +
        "    _valk \"$@\"\n" +
        "else\n" +
        "    compdef _valk valk\n" +
        "fi\n"
}

fn completion_fish() String {
    return "# valk completion for fish: valk completion fish > ~/.config/fish/completions/valk.fish\n" +
        "complete -c valk -f\n" +
        "complete -c valk -n __fish_use_subcommand -a \"" + completion_commands() + "\"\n" +
        "complete -c valk -n \"__fish_seen_subcommand_from make ls\" -a \"(valk ls --names 2>/dev/null)\"\n" +
        "complete -c valk -n \"__fish_seen_subcommand_from completion\" -a \"bash zsh fish\"\n" +
        "complete -c valk -n \"__fish_seen_subcommand_from build run doc fmt; and not __fish_prev_arg_in --target\" -F -a \"" + completion_build_options() + "\"\n" +
        "complete -c valk -n \"__fish_seen_subcommand_from build run doc; and __fish_prev_arg_in --target\" -f -a \"" + build.supported_targets().join(" ") + "\"\n"
}


use valk.http

fn fast(req: http.Context, res: http.ResponseWriter) {
    res.respond(200, "text/html", "Hello, World!")
}

fn main() {
    let host = "127.0.0.1"
    let port : u16 = 9000
    println("HTTP server - http://" + host + ":" + port)
    http.serve_fast(host, port, fast, 8) ! panic("Failed to start server")
}

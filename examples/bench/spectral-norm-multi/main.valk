use valk:thread

fn eval_a(i: uint, j: uint) float {
    let ij = i + j
    return ((ij * (ij + 1) / 2) + i + 1).to(float)
}

fn multiply_range(input: shared Array[float], start: uint, end: uint, transpose: bool) Array[float] {
    let output = Array[float].new(end - start)
    let i = start
    while i < end {
        let sum : float = 0
        let j : uint = 0
        while j < input.length {
            let value = input.get(j) !!
            if transpose {
                sum += value / eval_a(j, i)
            } else {
                sum += value / eval_a(i, j)
            }
            j++
        }
        output.append(sum)
        i++
    }
    return output
}

fn multiply(input: shared Array[float], transpose: bool, worker_count: uint) Array[float] {
    let length = input.length
    let chunk_size = (length + worker_count - 1) / worker_count
    let group = thread:ThreadGroup[Array[float]].new()

    let worker : uint = 0
    while worker < worker_count {
        let range_start = worker * chunk_size
        if range_start >= length : break
        let range_end = range_start + chunk_size
        if range_end > length : range_end = length
        group.start(fn() Array[float] {
            return multiply_range(input, range_start, range_end, transpose)
        }) ! panic("Failed to start spectral-norm worker")
        worker++
    }

    let output = Array[float].new(length)
    let i : uint = 0
    while i < length {
        output.append(0.0)
        i++
    }

    while group.has_pending() {
        let index, values = group.await_next()
        let offset = index * chunk_size
        let value_index : uint = 0
        while value_index < values.length {
            output.set(offset + value_index, values.get(value_index) !!) !!
            value_index++
        }
    }
    return output
}

fn multiply_ata(input: shared Array[float], worker_count: uint) Array[float] {
    let temporary : shared Array[float] = multiply(input, false, worker_count)
    return multiply(temporary, true, worker_count)
}

fn square_root(value: float) float {
    let result = value
    let i : uint = 0
    while i < 12 {
        result = (result + value / result) * 0.5
        i++
    }
    return result
}

fn parse_positive(args: Array[String], index: uint, fallback: uint) uint {
    args.get(index) -> value {
        let parsed = value.to_int() ! panic("Invalid number: %value")
        if parsed < 1 : panic("Input must be positive")
        return parsed.to(uint)
    }
    return fallback
}

fn main(args: Array[String]) {
    let n = parse_positive(args, 1, 8000)
    let worker_count = parse_positive(args, 2, 4)
    if worker_count > n : worker_count = n

    let initial = Array[float].new(n)
    let i : uint = 0
    while i < n {
        initial.append(1.0)
        i++
    }

    let u : shared Array[float] = initial
    let v : shared Array[float] = Array[float].new()
    i = 0
    while i < 10 {
        v = multiply_ata(u, worker_count)
        u = multiply_ata(v, worker_count)
        i++
    }

    let uv : float = 0
    let vv : float = 0
    i = 0
    while i < n {
        let u_value = u.get(i) !!
        let v_value = v.get(i) !!
        uv += u_value * v_value
        vv += v_value * v_value
        i++
    }

    println(square_root(uv / vv).to_string(9))
}

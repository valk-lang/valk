fn eval_a(i: uint, j: uint) float {
    let ij = i + j
    return ((ij * (ij + 1) / 2) + i + 1).to(float)
}

use valk.mem
use valk.math

fn multiply_a(output: *[float], input: *[float], length: uint) {
    @unsafe
    let i: uint = 0
    while i < length {
        let sum: float = 0
        let j: uint = 0
        while j < length {
            sum += input[j] / eval_a(i, j)
            j++
        }
        output[i] = sum
        i++
    }
}

fn multiply_at(output: *[float], input: *[float], length: uint) {
    @unsafe
    let i: uint = 0
    while i < length {
        let sum: float = 0
        let j: uint = 0
        while j < length {
            sum += input[j] / eval_a(j, i)
            j++
        }
        output[i] = sum
        i++
    }
}

fn multiply_ata(output: *[float], input: *[float], temporary: *[float], length: uint) {
    multiply_a(temporary, input, length)
    multiply_at(output, temporary, length)
}

fn main(args: Array[String]) {
    @unsafe
    let n: uint = 8000
    args.get(1) -> value {
        let parsed = value.to_int() ! panic("Invalid number: %value")
        if parsed < 1 : panic("Input must be positive")
        n = parsed.to(uint)
    }

    let bytes = n * size_of(float)
    let u: *[float] = mem.alloc(bytes)
    let v: *[float] = mem.alloc(bytes)
    let temporary: *[float] = mem.alloc(bytes)
    defer mem.free(temporary)
    defer mem.free(v)
    defer mem.free(u)
    let i: uint = 0
    while i < n {
        u[i] = 1.0
        v[i] = 1.0
        temporary[i] = 0.0
        i++
    }

    i = 0
    while i < 10 {
        multiply_ata(v, u, temporary, n)
        multiply_ata(u, v, temporary, n)
        i++
    }

    let uv: float = 0
    let vv: float = 0
    i = 0
    while i < n {
        uv += u[i] * v[i]
        vv += v[i] * v[i]
        i++
    }

    println(math.sqrt(uv / vv).to_string(9))
}

fn eval_a(i: uint, j: uint) float {
    let ij = i + j
    return ((ij * (ij + 1) / 2) + i + 1).to(float)
}

use valk.math

fn multiply_a(output: &mut [float], input: &[float]) {
    let length = output.length
    let i: uint = 0
    while i < length {
        let sum: float = 0
        let j: uint = 0
        while j < length {
            sum += input[j] / eval_a(i, j)
            j++
        }
        output[i] = sum
        i++
    }
}

fn multiply_at(output: &mut [float], input: &[float]) {
    let length = output.length
    let i: uint = 0
    while i < length {
        let sum: float = 0
        let j: uint = 0
        while j < length {
            sum += input[j] / eval_a(j, i)
            j++
        }
        output[i] = sum
        i++
    }
}

fn multiply_ata(output: &mut [float], input: &[float], temporary: &mut [float]) {
    multiply_a(temporary, input)
    multiply_at(output, temporary)
}

test "Spectral norm: matrix products" {
    let input = [float]{ 1.0 x 2 }
    let output = [float]{ 0.0 x 2 }
    let temporary = [float]{ 0.0 x 2 }

    multiply_a(output, input)
    assert(math.abs(output[0] - 1.5) < 0.000000000001)
    assert(math.abs(output[1] - 8.0 / 15.0) < 0.000000000001)
    multiply_at(output, input)
    assert(math.abs(output[0] - 4.0 / 3.0) < 0.000000000001)
    assert(math.abs(output[1] - 0.7) < 0.000000000001)
    multiply_ata(output, input, temporary)
    assert(math.abs(output[0] - 151.0 / 90.0) < 0.000000000001)
    assert(math.abs(output[1] - 257.0 / 300.0) < 0.000000000001)
    assert(input[0] == 1.0 && input[1] == 1.0)
}

fn main(args: Array[String]) {
    let n: uint = 8000
    args.get(1) -> value {
        let parsed = value.to_int() ! panic("Invalid number: %value")
        if parsed < 1 : panic("Input must be positive")
        n = parsed.to(uint)
    }

    let u = [float]{ 1.0 x n }
    let v = [float]{ 1.0 x n }
    let temporary = [float]{ 0.0 x n }

    let i: uint = 0
    while i < 10 {
        multiply_ata(v, u, temporary)
        multiply_ata(u, v, temporary)
        i++
    }

    let uv: float = 0
    let vv: float = 0
    i = 0
    while i < n {
        let u_value = u[i]
        let v_value = v[i]
        uv += u_value * v_value
        vv += v_value * v_value
        i++
    }

    println(math.sqrt(uv / vv).to_string(9))
}

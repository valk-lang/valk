fn eval_a(i: uint, j: uint) float {
    let ij = i + j
    return ((ij * (ij + 1) / 2) + i + 1).to(float)
}

use valk.math

fn multiply_a(output: Slice[float], input: Slice[float]) {
    let length = output.length
    let i: uint = 0
    while i < length {
        let sum: float = 0
        let j: uint = 0
        while j < length {
            sum += (input[j] !!) / eval_a(i, j)
            j++
        }
        output.set(i, sum) !!
        i++
    }
}

fn multiply_at(output: Slice[float], input: Slice[float]) {
    let length = output.length
    let i: uint = 0
    while i < length {
        let sum: float = 0
        let j: uint = 0
        while j < length {
            sum += (input[j] !!) / eval_a(j, i)
            j++
        }
        output.set(i, sum) !!
        i++
    }
}

fn multiply_ata(output: Slice[float], input: Slice[float], temporary: Slice[float]) {
    multiply_a(temporary, input)
    multiply_at(output, temporary)
}

fn main(args: Array[String]) {
    let n: uint = 8000
    args.get(1) -> value {
        let parsed = value.to_int() ! panic("Invalid number: %value")
        if parsed < 1 : panic("Input must be positive")
        n = parsed.to(uint)
    }

    let u = Slice[float].new(n, 1.0)
    let v = Slice[float].new(n, 1.0)
    let temporary = Slice[float].new(n, 0.0)

    let i: uint = 0
    while i < 10 {
        multiply_ata(v, u, temporary)
        multiply_ata(u, v, temporary)
        i++
    }

    let uv: float = 0
    let vv: float = 0
    i = 0
    while i < n {
        let u_value = u[i] !!
        let v_value = v[i] !!
        uv += u_value * v_value
        vv += v_value * v_value
        i++
    }

    println(math.sqrt(uv / vv).to_string(9))
}

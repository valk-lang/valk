use valk:json
use valk:time
use valk:gc

fn decode(input: String) json:Value {
    return json:parse(input) ! panic("JSON parser rejected benchmark input")
}

fn walk_array(array: json:ArrayValue) uint {
    let total = 1.to(uint)
    each array.values as item : total += walk(item)
    return total
}

fn walk_object(object: json:ObjectValue) uint {
    let total = 1.to(uint)
    each object.values as item, key : total += key.bytes + walk(item)
    return total
}

fn walk(value: json:Value) uint {
    return match value : uint {
        null => 1
        String as text => 1 + text.bytes
        int as number => 1 + number.to(uint)
        float as number => 1 + number.to(uint)
        bool as enabled => enabled ? 2 : 1
        json:ArrayValue as array => walk_array(array)
        json:ObjectValue as object => walk_object(object)
    }
}

fn benchmark(input: String, amount: uint) {
    let warmup: uint = 5
    while warmup-- > 0 {
        let value = decode(input)
        json:stringify(value)
    }

    gc:collect()
    let decoded: json:Value = null
    let start = time:microtime()
    let i = amount
    while i-- > 0 : decoded = decode(input)
    let elapsed = time:microtime() - start
    println("decode: %elapsed us total, %{ elapsed * 1000 / amount } ns/op")

    let encoded = ""
    start = time:microtime()
    i = amount
    while i-- > 0 : encoded = json:stringify(decoded)
    elapsed = time:microtime() - start
    println("encode: %elapsed us total, %{ elapsed * 1000 / amount } ns/op, %{encoded.bytes} bytes")

    let traversal_count = amount * 100
    let checksum: uint = 0
    start = time:microtime()
    i = traversal_count
    while i-- > 0 : checksum += walk(decoded)
    elapsed = time:microtime() - start
    println("traverse: %elapsed us total, %{ elapsed * 1000 / traversal_count } ns/op, checksum %checksum")
}

fn memory(input: String, count: uint) {
    gc:collect()
    gc:collect()
    let before = gc:mem_usage()
    let retained = Array[json:Value]{}
    let i = count
    while i-- > 0 : retained.append(decode(input))
    gc:collect()
    let used = gc:mem_usage() - before
    println("retained memory: %used bytes for %{retained.length} documents, %{ used / count } bytes/document")
}

fn main(args: Array[String]) {
    let mode = args.get(1) !? "time"
    let amount: uint = 500
    args.get(2) -> text: amount = (text.to_int() !? 500).to(uint)
    if amount == 0 : amount = 1

    let input = #embed("tests/assets/parse.json")
    println("JSON benchmark: %mode, %{input.bytes} input bytes")
    if mode == "time" : benchmark(input, amount)
    else if mode == "memory" : memory(input, amount)
    else : println("usage: bench-json <time|memory> [iterations]")
}

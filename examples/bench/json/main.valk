use valk:json

global source : String ("{\"name\":\"Alice\",\"age\":30,\"email\":\"alice@example.com\"}")

fn parse_amount(args: Array[String]) uint {
    args.get(1) -> value {
        let amount = value.to_int() ! panic("Invalid amount: %value")
        if amount < 1 : panic("Amount must be positive")
        return amount.to(uint)
    }
    return 2_000_000
}

fn main(args: Array[String]) {
    let amount = parse_amount(args)
    let document : ?json:Value = null

    let i = amount
    while i-->0 {
        document = json:decode(source) ! panic("Invalid JSON")
    }

    if !isset(document) : panic("Missing decoded value")
    let name = document.get("name").string()
    let age = document.get("age").int()
    let email = document.get("email").string()

    let encoded = ""
    i = amount
    while i-->0 {
        encoded = json:encode(document)
    }

    println("%name|%age|%email")
    println(encoded.length)
}

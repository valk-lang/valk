class Node {
    hash: ?int
    value: ?int
    left: ?Node
    right: ?Node

    static fn tree(depth: int) Node {
        if depth <= 0 : return Node {value: 1}
        return Node {
            left: Node.tree(depth - 1)
            right: Node.tree(depth - 1)
        }
    }

    fn calculate_hash() {
        if isset(this.hash) : return
        let value = this.value
        if isset(value) {
            this.hash = value
            return
        }

        let left = this.left
        let right = this.right
        if !isset(left) || !isset(right) : return
        left.calculate_hash()
        right.calculate_hash()
        let merged : int = left.get_hash() + right.get_hash()
        this.hash = merged
    }

    fn get_hash() int {
        return this.hash ?? -1
    }

    fn check() bool {
        if !isset(this.hash) : return false
        if isset(this.value) : return true
        let left = this.left
        let right = this.right
        return isset(left) && isset(right) && left.check() && right.check()
    }
}

fn main(args: Array[String]) {
    let min_depth = 4
    let max_depth = 5
    args.get(1) -> value: max_depth = value.to_int() ! panic("Invalid number: %value")
    if min_depth + 2 > max_depth : max_depth = min_depth + 2

    let stretch_depth = max_depth + 1
    let stretch_tree = Node.tree(stretch_depth)
    stretch_tree.calculate_hash()
    println("stretch tree of depth %stretch_depth\t root hash: %{stretch_tree.get_hash()} check: %{stretch_tree.check()}")

    let long_lived_tree = Node.tree(max_depth)

    let depth = min_depth
    while depth <= max_depth {
        let iterations = 1 << (max_depth - depth + min_depth)
        let sum : int = 0
        let i = 0
        while i++<iterations {
            let tree = Node.tree(depth)
            tree.calculate_hash()
            sum += tree.get_hash()
        }
        println("%iterations\t trees of depth %depth\t root hash sum: %sum")
        depth += 2
    }

    long_lived_tree.calculate_hash()
    println("long lived tree of depth %max_depth\t root hash: %{long_lived_tree.get_hash()} check: %{long_lived_tree.check()}")
}

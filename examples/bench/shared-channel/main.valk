use valk.sync
use valk.thread

class Message {
    id: uint
    text: String
    values: Array[uint]
}

fn produce(channel: shared sync.Channel[shared Message], first: uint, count: uint) {
    let i : uint = 0
    while i < count {
        let id = first + i
        let values = Array[uint].new(8)
        let j : uint = 0
        while j < 8 {
            values.append(id + j)
            j++
        }
        channel.send(Message { id: id, text: id.to_string(), values: values }) ! panic("send failed")
        i++
    }
    channel.close()
}

fn consume(channel: shared sync.Channel[shared Message]) uint {
    let total : uint = 0
    each channel as message {
        total += message.id + message.text.length
        each message.values as value {
            total += value
        }
    }
    return total
}

fn main(args: Array[String]) {
    let count : uint = 1000000
    args.get(1) -> value: count = value.to_uint() ! panic("Invalid number: %value")

    let consumers = thread.ThreadGroup[uint].new()
    let producers = Array[thread.Thread[void]].new()
    let p : uint = 0
    while p < 4 {
        let channel: shared sync.Channel[shared Message] = sync.Channel[shared Message].new(1024) ! panic("init")
        let first = p * count
        producers.append(thread.start(fn() {
            produce(channel, first, count)
        }) ! panic("Failed to start producer"))
        consumers.start(fn() uint {
            return consume(channel)
        }) ! panic("Failed to start consumer")
        p++
    }
    each producers as producer {
        producer.await()
    }
    let total : uint = 0
    while consumers.has_pending() {
        let _, result = consumers.await_next() !!
        total += result
    }
    println("messages: %{count * 4}, checksum: %total")
}

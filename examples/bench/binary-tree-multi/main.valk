use valk.thread

class Node {
    left: ?Node
    right: ?Node

    static fn tree(depth: int) Node {
        if depth == 0 : return Node {}
        return Node {
            left: Node.tree(depth - 1)
            right: Node.tree(depth - 1)
        }
    }

    fn check() uint {
        let result : uint = 1
        let left = this.left
        let right = this.right
        if isset(left) && isset(right) : result += left.check() + right.check()
        return result
    }
}

struct TreeResult {
    iterations: uint
    depth: int
    check: uint
}

fn check_depth(depth: int, iterations: uint) TreeResult {
    let check : uint = 0
    let i : uint = 0
    while i++<iterations {
        check += Node.tree(depth).check()
    }
    return .{iterations: iterations, depth: depth, check: check}
}

fn main(args: Array[String]) {
    let min_depth = 4
    let max_depth = 5
    args.get(1) -> value: max_depth = value.to_int() ! panic("Invalid number: %value")
    if min_depth + 2 >max_depth : max_depth = min_depth + 2

    let stretch_depth = max_depth + 1
    let stretch_check = Node.tree(stretch_depth).check()
    println("stretch tree of depth %stretch_depth\t check: %stretch_check")

    let long_lived = Node.tree(max_depth)
    let group = thread.ThreadGroup[TreeResult].new()
    let results = Array[?TreeResult].new()

    let depth = min_depth
    while depth <= max_depth {
        let iterations = (1 << (max_depth - depth + min_depth)).to(uint)
        results.append(null)
        group.start(fn() TreeResult {
            return check_depth(depth, iterations)
        }) ! panic("Failed to start binary-tree worker")
        depth += 2
    }

    while group.has_pending() {
        let index, result = group.await_next()
        results.set(index, result) !!
    }

    each results as result {
        if !isset(result) : panic("Binary-tree worker did not return a result")
        println("%{result.iterations}\t trees of depth %{result.depth}\t check: %{result.check}")
    }

    println("long lived tree of depth %max_depth\t check: %{long_lived.check()}")
}

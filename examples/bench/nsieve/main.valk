use valk.mem

fn nsieve(limit: uint) {
    let flags: *[u8] = mem.alloc(limit)
    defer mem.free(flags)
    flags.fill_bytes(1, limit)

    let count: uint = 0
    let i: uint = 2
    while i < limit {
        if flags[i] != 0 {
            count++
            let composite = i << 1
            while composite < limit {
                flags[composite] = 0
                composite += i
            }
        }
        i++
    }

    let limit_string = limit.to_string().pad_left(' ', 8)
    let count_string = count.to_string().pad_left(' ', 8)
    println("Primes up to %limit_string %count_string")
}

fn main(args: Array[String]) {
    let n: int = 12
    args.get(1) -> value : n = value.to_int() ! panic("Invalid number: %value")
    if n < 2 || n > 20 : panic("Input must be between 2 and 20")

    let i: int = 0
    while i < 3 {
        nsieve(10_000 << (n - i).to(uint))
        i++
    }
}

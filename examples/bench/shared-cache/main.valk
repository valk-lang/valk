use valk.thread

class Entry {
    key: uint
    name: String
    data: Array[uint]
}

fn entry(key: uint) Entry {
    let data = Array[uint].new(16)
    let i : uint = 0
    while i < 16 {
        data.append(key * 31 + i)
        i++
    }
    return Entry { key: key, name: "entry" + key, data: data }
}

fn work(cache: shared Lock[HashMap[uint, shared Entry]], slots: uint, seed: uint, operations: uint) uint {
    let total : uint = 0
    let r = seed
    let i : uint = 0
    while i < operations {
        r = (r * 1103515245 + 12345) % 2147483648
        let key = r % slots
        if r % 10 == 0 {
            let fresh: shared Entry = entry(key)
            lock cache as c {
                c.set(key, fresh)
            }
        } else {
            let found: ?shared Entry = null
            lock cache as c {
                found = c.get(key) !? null
            }
            if isset(found) {
                total += found.key + found.name.length
                each found.data as value {
                    total += value
                }
            }
        }
        i++
    }
    return total
}

fn main(args: Array[String]) {
    let slots : uint = 100000
    let operations : uint = 2000000
    args.get(1) -> value: slots = value.to_uint() ! panic("Invalid number: %value")
    args.get(2) -> value: operations = value.to_uint() ! panic("Invalid number: %value")

    let initial = HashMap[uint, shared Entry].new(slots)
    let i : uint = 0
    while i < slots {
        initial.set(i, entry(i))
        i++
    }
    let cache: shared Lock[HashMap[uint, shared Entry]] = .new(initial) !!

    let group = thread.ThreadGroup[uint].new()
    let t : uint = 0
    while t < 4 {
        let seed = t + 1
        group.start(fn() uint {
            return work(cache, slots, seed, operations)
        }) ! panic("Failed to start worker")
        t++
    }
    let total : uint = 0
    while group.has_pending() {
        let _, result = group.await_next() !!
        total += result
    }
    println("slots: %slots, operations: %{operations * 4}, checksum: %total")
}

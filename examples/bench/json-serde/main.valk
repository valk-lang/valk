use valk:crypto
use valk:fs
use valk:json

class GeoData {
    type: String
    features: Array[Feature] (.{})
}

class Feature {
    type: String
    properties: Properties
    geometry: Geometry
}

class Properties {
    name: String
}

class Geometry {
    type: String
    coordinates: Array[Array[Array[float]]] (.{})
}

fn main(args: Array[String]) {
    let file_name = "sample"
    let count : uint = 10
    args.get(1) -> value: file_name = value
    args.get(2) -> value {
        let parsed = value.to_int() ! panic("Invalid iteration count: %value")
        if parsed < 0 : panic("Iteration count cannot be negative")
        count = parsed.to(uint)
    }

    let path = fs:add(__DIR__, "/%file_name.json")
    let input = fs:read(path) ! panic("Unable to read %path")
    let document = json:decode_to[GeoData](input) ! panic("Invalid JSON in %path")
    println(crypto:md5_encode(json:encode(document)))

    let documents = Array[GeoData].new(count)
    let i : uint = 0
    while i++<count {
        documents.append(json:decode_to[GeoData](input) ! panic("Invalid JSON in %path"))
    }
    println(crypto:md5_encode(json:encode(documents)))
}

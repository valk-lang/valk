fn fannkuch(n: uint) (int, uint) {
    let permutations: [uint x 16] = {0...}
    let work: [uint x 16] = {0...}
    let counts: [uint x 16] = {0...}

    let i: uint = 0
    while i < n {
        permutations[i] = i
        i++
    }

    let checksum: int = 0
    let maximum: uint = 0
    let permutation_index: uint = 0
    let r = n

    while true {
        while r != 1 {
            counts[r - 1] = r
            r--
        }

        i = 0
        while i < n {
            work[i] = permutations[i]
            i++
        }

        let flips: uint = 0
        let first = work[0]
        while first != 0 {
            let left: uint = 0
            let right = first
            while left < right {
                let value = work[left]
                work[left] = work[right]
                work[right] = value
                left++
                right--
            }
            flips++
            first = work[0]
        }

        if flips > maximum : maximum = flips
        if permutation_index % 2 == 0 {
            checksum += flips.to(int)
        } else {
            checksum -= flips.to(int)
        }

        while true {
            if r == n : return (checksum, maximum)

            let first_permutation = permutations[0]
            i = 0
            while i < r {
                permutations[i] = permutations[i + 1]
                i++
            }
            permutations[r] = first_permutation
            counts[r]--
            if counts[r] > 0 : break
            r++
        }
        permutation_index++
    }
}

fn main(args: Array[String]) {
    let n: uint = 11
    args.get(1) -> value {
        let parsed = value.to_int() ! panic("Invalid number: %value")
        if parsed < 1 || parsed > 16 : panic("Input must be between 1 and 16")
        n = parsed.to(uint)
    }

    let checksum, maximum = fannkuch(n)
    println(checksum)
    println("Pfannkuchen(%n) = %maximum")
}

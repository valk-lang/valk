use valk.thread

fn words(count: uint) Array[String] {
    let result = Array[String].new(count)
    let i : uint = 0
    while i < count {
        result.append("word" + i)
        i++
    }
    return result
}

fn work(counts: shared Lock[HashMap[String, uint]], keys: shared Array[String], seed: uint, updates: uint) {
    let r = seed
    let i : uint = 0
    while i < updates {
        r = (r * 1103515245 + 12345) % 2147483648
        let key = keys.get(r % keys.length) !!
        lock counts as c {
            c.set(key, (c.get(key) !? 0) + 1)
        }
        i++
    }
}

fn main(args: Array[String]) {
    let count : uint = 10000
    let updates : uint = 2000000
    args.get(1) -> value: count = value.to_uint() ! panic("Invalid number: %value")
    args.get(2) -> value: updates = value.to_uint() ! panic("Invalid number: %value")

    let keys: shared Array[String] = words(count)
    let counts: shared Lock[HashMap[String, uint]] = .new(HashMap[String, uint].new(count)) !!

    let workers = Array[thread.Thread[void]].new()
    let t : uint = 0
    while t < 4 {
        let seed = t + 1
        workers.append(thread.start(fn() {
            work(counts, keys, seed, updates)
        }) ! panic("Failed to start worker"))
        t++
    }
    each workers as worker {
        worker.await()
    }

    let total : uint = 0
    let most : uint = 0
    lock counts as c {
        each c as value {
            total += value
            if value > most : most = value
        }
    }
    println("keys: %count, updates: %total, most: %most")
}

use valk.thread

class User {
    id: uint
    name: String
    tags: Array[String]
    score: uint
}

class Hit {
    id: uint
    score: uint
}

fn build(count: uint) HashMap[String, User] {
    let users = HashMap[String, User].new(count)
    let i : uint = 0
    while i < count {
        let name = "user" + i
        users.set(name, User {
            id: i
            name: name
            tags: Array[String]{ "tag" + (i % 7), "tag" + (i % 13) }
            score: i * 7 % 1000
        })
        i++
    }
    return users
}

fn names(count: uint) Array[String] {
    let result = Array[String].new(count)
    let i : uint = 0
    while i < count {
        result.append("user" + i)
        i++
    }
    return result
}

fn work(users: shared HashMap[String, User], keys: shared Array[String], seed: uint, lookups: uint) uint {
    let total : uint = 0
    let hits = Array[Hit].new(1000)
    let r = seed
    let i : uint = 0
    while i < lookups {
        r = (r * 1103515245 + 12345) % 2147483648
        let key = keys.get(r % keys.length) !!
        let user = users.get(key) !!
        total += user.score + user.name.length + user.tags.length
        hits.append(Hit { id: user.id, score: user.score })
        if hits.length == 1000 : hits.clear()
        i++
    }
    return total
}

fn main(args: Array[String]) {
    let count : uint = 200000
    let lookups : uint = 5000000
    args.get(1) -> value: count = value.to_uint() ! panic("Invalid number: %value")
    args.get(2) -> value: lookups = value.to_uint() ! panic("Invalid number: %value")

    let users: shared HashMap[String, User] = build(count)
    let keys: shared Array[String] = names(count)

    let group = thread.ThreadGroup[uint].new()
    let t : uint = 0
    while t < 4 {
        let seed = t + 1
        group.start(fn() uint {
            return work(users, keys, seed, lookups)
        }) ! panic("Failed to start worker")
        t++
    }
    let total : uint = 0
    while group.has_pending() {
        let _, result = group.await_next() !!
        total += result
    }
    println("users: %count, lookups: %{lookups * 4}, checksum: %total")
}

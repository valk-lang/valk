use valk.sync
use valk.thread

class Message {
    id: uint
    room: uint
    body: String
    mentions: Array[uint]
}

fn render(message: shared Message) uint {
    let sum : uint = message.id + message.room
    each message.body as byte {
        sum += byte
    }
    each message.mentions as user {
        sum += user
    }
    return sum
}

fn subscriber(inbox: shared sync.Channel[shared Message]) uint {
    let total : uint = 0
    each inbox as message {
        total += render(message)
    }
    return total
}

fn main(args: Array[String]) {
    let count : uint = 500000
    args.get(1) -> value: count = value.to_uint() ! panic("Invalid number: %value")

    let text = "The quick brown fox jumps over the lazy dog. "
    let inboxes = Array[shared sync.Channel[shared Message]].new()
    let group = thread.ThreadGroup[uint].new()
    let s : uint = 0
    while s < 4 {
        let inbox: shared sync.Channel[shared Message] = sync.Channel[shared Message].new(1024) ! panic("init")
        inboxes.append(inbox)
        group.start(fn() uint {
            return subscriber(inbox)
        }) ! panic("Failed to start subscriber")
        s++
    }

    let i : uint = 0
    while i < count {
        let body = text + text + text + "message " + i
        let mentions = Array[uint]{ i % 100, i % 1000 }
        let message: shared Message = Message { id: i, room: i % 10, body: body, mentions: mentions }
        each inboxes as inbox {
            inbox.send(message) ! panic("send failed")
        }
        i++
    }
    each inboxes as inbox {
        inbox.close()
    }

    let total : uint = 0
    while group.has_pending() {
        let _, result = group.await_next() !!
        total += result
    }
    println("messages: %count, subscribers: 4, checksum: %total")
}

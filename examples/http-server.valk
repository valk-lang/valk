use valk.http

fn handler(req: http.Request) http.Response {
    return http.Response.html("Hello world!")
}

fn fast(req: http.Context, res: http.ResponseWriter) {
    res.respond(200, "text/html", "Hello world!")
}

fn main() {
    let s = http.Server.new("127.0.0.1", 9000).fast(fast)
    s.show_info = true
    s.start() ! { println("Failed to start http server"); return }

    // Or, as a one-liner:
    // http.serve("127.0.0.1", 9000, handler) ! return
}

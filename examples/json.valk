
use valk:json

class A {
    msg: String ("Hello")
    b: B (B{})
}
class B {
    msg: String ("World")
}

fn main() {
    let a = A{}
    // Converting our object to json string
    let pretty = true
    let str = json:stringify(json:from(a), pretty)
    println(str)
    // {
    //     "msg": "Hello",
    //     "b": {
    //         "msg": "World"
    //     }
    // }

    // Convert json string back to your type
    // First convert it to a json:Value
    let json_value = json:parse(str) ! panic("Invalid json syntax")
    // And now convert your json:Value to A
    let a2 = json:from_value[A](json_value) ! panic("Invalid JSON data")
    // Check result
    println(a2.msg + " " + a2.b.msg) // Prints: Hello world
}

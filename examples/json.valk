
use valk.json

class A {
    msg: String ("Hello")
    b: B (B{})
}
class B {
    msg: String ("World")
}

fn main() {
    let a = A{}
    // Converting our object to a json string (pretty printed)
    let str = json.encode(a, true)
    println(str)
    // {
    //     "msg": "Hello",
    //     "b": {
    //         "msg": "World"
    //     }
    // }

    // Convert the json string back to your type
    let a2 = json.decode_to[A](str) ! panic("Invalid JSON data")
    println(a2.msg + " " + a2.b.msg) // Prints: Hello World

    // Or read it without a type
    let value = json.decode(str) ! panic("Invalid json syntax")
    println(value["b"]["msg"].string) // Prints: World
}

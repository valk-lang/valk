{
    "use": "0.7.6",
    "define": {
        "VERSION": "0.7.7"
    },
    "make": {
        "compiler": {
            "dir": ".",
            "args": "-o ./valk -vv $LINK"
        },
        "install": {
            "needs": "compiler",
            "cmd": [
                "rm -rf ~/.vman/versions/$VERSION/",
                "mkdir -p ~/.vman/versions/$VERSION/",
                "cp ./valk ~/.vman/versions/$VERSION/valk",
                "cp -r ./lib ~/.vman/versions/$VERSION/",
                "rm -f ~/.vman/bin/valk",
                "ln -s ~/.vman/versions/$VERSION/valk ~/.vman/bin/valk"
            ]
        },
        "uninstall": "vman unuse $VERSION",
        "test": {
            "needs": "compiler",
            "cmd": [
                "mkdir -p ./debug",
                "./valk build ./tests $TEST_FLAGS -o ./debug/test-core",
                "./debug/test-core"
            ]
        },
        "test-release": {
            "needs": "compiler",
            "cmd": [
                "mkdir -p ./debug",
                "./valk build ./tests $TEST_FLAGS --release -o ./debug/test-release",
                "./debug/test-release"
            ]
        },
        "test-cli": {
            "needs": "compiler",
            "cmd": "bash ./tests/cli/run.sh"
        },
        "test-lsp": {
            "needs": "compiler",
            "cmd": "bash ./tests/lsp/run.sh"
        },
        "test-fmt": {
            "needs": "compiler",
            "cmd": "bash ./tests/fmt/run.sh"
        },
        "test-compile-errors": {
            "needs": "compiler",
            "cmd": "bash ./tests/compile-errors/run.sh"
        },
        "test-diagnostics": {
            "needs": "compiler",
            "cmd": "bash ./tests/diagnostics/run.sh"
        },
        "test-exit-code": {
            "needs": "compiler",
            "cmd": "bash ./tests/exit-code/run.sh"
        },
        "test-codegen": {
            "needs": "compiler",
            "cmd": "bash ./tests/codegen/run.sh"
        },
        "test-deps": {
            "needs": "compiler",
            "cmd": "bash ./tests/deps/run.sh"
        },
        "test-library": {
            "needs": "compiler",
            "cmd": "bash ./tests/library/run.sh"
        },
        "test-extend-access": {
            "needs": "compiler",
            "cmd": "bash ./tests/extend-access/run.sh"
        },
        "test-doc": {
            "needs": "compiler",
            "cmd": "bash ./tests/doc/run.sh"
        },
        "test-examples": {
            "needs": "compiler",
            "cmd": "bash ./tests/examples/run.sh"
        },
        "test-http2": {
            "needs": "compiler",
            "cmd": "bash ./tests/http2/run.sh"
        },
        "test-api-compat": {
            "needs": "compiler",
            "cmd": "bash ./tests/api-compat/run.sh"
        },
        "test-fmt-corpus": {
            "needs": "compiler",
            "cmd": "bash ./tests/fmt/corpus.sh"
        },
        "test-all": {
            "needs": [
                "test",
                "test-compile-errors",
                "test-diagnostics",
                "test-exit-code",
                "test-cli",
                "test-lsp",
                "test-fmt",
                "test-fmt-corpus",
                "test-codegen",
                "test-deps",
                "test-library",
                "test-extend-access",
                "test-doc",
                "test-examples",
                "test-http2",
                "test-api-compat"
            ],
            "cmd": "echo '# Everything passed'"
        },
        "test-native": {
            "needs": [
                "test",
                "test-library",
                "test-exit-code",
                "test-cli",
                "test-lsp",
                "test-diagnostics",
                "test-deps"
            ],
            "cmd": "echo '# The host suites passed'"
        },
        "test-cross": {
            "needs": "compiler",
            "cmd": [
                "mkdir -p ./debug",
                "for t in $IR_TARGETS; do [ $t = linux-x64 ] && continue; ./valk build ./tests $TEST_FLAGS -o ./debug/test-$t --target $t || exit $?; done"
            ]
        },
        "test-cross-ir": {
            "needs": "compiler",
            "cmd": [
                "mkdir -p ./debug",
                "for t in $IR_TARGETS; do [ $t = linux-x64 ] && continue; ./valk build ./tests $TEST_FLAGS -o ./debug/test-$t-ir --target $t --ir --clean || exit $?; done"
            ]
        },
        "test-win": {
            "needs": "compiler",
            "cmd": [
                "mkdir -p ./debug",
                "./valk build ./tests $TEST_FLAGS -o ./debug/test-win.exe --target win-x64",
                "./debug/test-win.exe"
            ]
        },
        "test-gc-shared-stress": {
            "needs": "compiler",
            "cmd": [
                "mkdir -p ./debug",
                "./valk build ./tests/src/gc-shared.valk $TEST_FLAGS -o ./debug/test-gc-shared-stress",
                "run=0; while [ $run -lt 10 ]; do run=$((run + 1)); echo \"Shared GC stress run $run/10\"; ./debug/test-gc-shared-stress || exit $?; done"
            ]
        },
        "lib-lint": {
            "dir": "lib",
            "args": "--lint"
        },
        "lib-lint-cross": {
            "needs": "compiler",
            "cmd": "for t in $IR_TARGETS; do echo \"# Lint lib ($t)\"; ./valk build ./lib --lint --target $t || exit $?; done"
        },
        "static": {
            "dir": ".",
            "args": "-o ./valk -vv --static $LINK"
        },
        "valkexe": {
            "dir": ".",
            "args": "-o ./valk.exe -vv --target win-x64 --static -L toolchains/libraries/win-llvm-22-x64/lib"
        },
        "debug": {
            "needs": "compiler",
            "cmd": "gdb --args valk build . -o ./valk2 -vv $LINK"
        },
        "profile": {
            "cmd": "valgrind --tool=callgrind --dump-instr=yes --simulate-cache=yes --collect-jumps=yes valk build . -o ./valk3 -vv $LINK"
        },
        "watchtest": {
            "needs": "compiler",
            "cmd": "./valk build ./tests $TEST_FLAGS -o ./debug/test-all -w -v"
        },
        "docs": {
            "needs": "compiler",
            "cmd": [
                "./valk doc lib/ -o docs/api.md --markdown --no-private --target linux-x64",
                "./valk doc lib/ -o docs/api-full.md --markdown --no-private --full --target linux-x64"
            ]
        },
        "api-baseline": {
            "needs": "compiler",
            "cmd": [
                "mkdir -p ./debug",
                "./valk doc $HOME/.vman/versions/${STABLE:-0.7.0}/lib --stdlib $HOME/.vman/versions/${STABLE:-0.7.0}/lib -o ./debug/api-stable.json --no-private --target linux-x64",
                "./valk build ./tests/api-compat/check.valk -o ./debug/api-check --no-warn",
                "./debug/api-check --write ./tests/api-compat/baseline.json ./debug/api-stable.json"
            ]
        },
        "bench-json": {
            "needs": "compiler",
            "cmd": [
                "mkdir -p ./debug",
                "./valk build ./examples/bench/json/main.valk --release -o ./debug/bench-json",
                "./debug/bench-json ${BENCH_JSON_ITERATIONS:-2000000}"
            ]
        },
        "toolchains": {
            "cmd": [
                "chmod +x ./misc/toolchains/setup.sh",
                "./misc/toolchains/setup.sh"
            ]
        },
        "asm": {
            "cmd": [
                "clang-22 -c ./misc/asm/coro/x64.s --target=x86_64-pc-linux-gnu -o ./lib/libs/linux-x64/valk-stack-swap.o",
                "clang-22 -c ./misc/asm/coro/x64.s --target=x86_64-apple-darwin -o ./lib/libs/macos-x64/valk-stack-swap.o",
                "clang-22 -c ./misc/asm/coro/x64-win.s --target=x86_64-pc-windows-msvc -o ./lib/libs/win-x64/valk-stack-swap.o",
                "clang-22 -c ./misc/asm/coro/arm64.s --target=arm64-apple-darwin -o ./lib/libs/macos-arm64/valk-stack-swap.o"
            ]
        },
        "clean": {
            "cmd": [
                {
                    "win": "del /q valk.exe valk2 valk3 2>nul",
                    "default": "rm -f ./valk ./valk2 ./valk3 ./valk.exe"
                },
                {
                    "win": "rmdir /s /q debug 2>nul",
                    "default": "rm -rf ./debug"
                }
            ]
        }
    },
    "vars": {
        "LINK": "-L toolchains/libraries/linux-llvm-22-x64/lib -L $(dirname $(g++ -print-file-name=libstdc++.a))",
        "TEST_FLAGS": "--test --def \"DEF_TEST=TestValue\" --def \"GC_DEBUG=1\" --no-warn-deprecated -vv",
        "IR_TARGETS": [
            "linux-x64",
            "macos-x64",
            "macos-arm64",
            "win-x64"
        ]
    }
}

class Trait {
    unit: Unit
    ns: Namespace
    name: String
    act: ACT
    exp: Exp
    // Declaration scope parent is the source-file scope
    scope: Scope
    generics: ?Exp (null) // EXP.body `[...]` if generic
    body: ?Exp (null)     // EXP.body `{...}`
    // Ordered generic parameter names (`T`, `U`, ...)
    generic_names: ?Array[String] (null)
    // Active body members (props, funcs, …) after #if filtering — no macro directives
    exps: Array[Exp] (.{})

    // Expressions to mix into a class body (already #if-resolved).
    fn get_exps() Array[Exp] {
        return this.exps
    }
}

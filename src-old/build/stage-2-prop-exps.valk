fn parse_class_body_exps(class: Class) Array[Exp] !Error {
    let body = class.body
    if !isset(body) : return Array[Exp]{}
    let pos = body.pos
    if !isset(pos) : body.bug("Class body is missing a Pos")
    let p = pos.copy().init_parser()
    let exps = read_class_body_exps(p) !>
    return exps
}

// Read class-body members until a top-level `}`.
fn read_class_body_exps(p: Parser) Array[Exp] !Error {
    let exps = Array[Exp]{}
    while true {
        let t = p.tok(true, true) !>
        if t == TOK.end : p.error("Unexpected end of file in class body, missing '}'")
        if t == TOK.sign && p.word_is("}") : break
        if t == TOK.comment {
            continue
        }
        if t == TOK.sign && p.word_is(";") : continue
        exps.append(read_class_member_exp(p, t) !>)
    }
    return exps
}

// Parse one class-body member. `t` is the already-read first token.
fn read_class_member_exp(p: Parser, t: int) Exp !Error {

    // Compile macros: #if / #elif / #else / #end / ...
    if t == TOK.sign && p.word_is("#") {
        let exp = read_macro_exp(p) !>
        return exp
    }

    // Optional access marker, including -~, -+, ~+ and -~+.
    let act: ACT = ACT.undefined
    if t == TOK.sign && (p.word_is("+") || p.word_is("-") || p.word_is("~")) {
        act = read_act_sign(p) !>
        t = p.tok(true, false) !>
    }

    if t != TOK.word && t != TOK.at_word {
        p.error("Unexpected token in class body: '" + p.word() + "'")
    }

    // First word: property name, or keyword (fn / get / static / group / ...)
    let w1 = p.word()

    // Property: name :
    let t2 = p.tok(true, false, false) !>
    if t2 == TOK.sign && p.word_is(":") {
        let exp = read_prop_exp(p, act, w1) !>
        return exp
    }

    // Keywords may be prefixed: static fn|get
    let is_static = false

    if w1 == "static" {
        is_static = true
        t = p.tok(true, false) !>
        if t != TOK.word : p.error("Expected 'fn' or 'get' after 'static', found: '" + p.word() + "'")
        w1 = p.word()
    }

    if w1 == "fn" {
        let exp = read_func_exp(p, act, is_static) !>
        return exp
    }
    if w1 == "get" {
        let exp = read_getter_exp(p, act, is_static) !>
        return exp
    }
    if w1 == "macro" {
        p.error("Declaration macros (`macro …`) were removed; use `$append` / `$set_key` hooks for class-init lists")
    }
    if w1 == "group" {
        if is_static : p.error("Invalid modifiers before 'group'")
        let exp = read_group_exp(p, act) !>
        return exp
    }
    // Class-body trait mix-in: `use Trait` / `use Trait[T]` (not `use: Type` property)
    if w1 == "use" {
        if is_static : p.error("Invalid modifiers before 'use'")
        let exp = read_trait_use_exp(p) !>
        return exp
    }

    p.error("Unexpected token in class body: '" + w1 + "'")
}

fn prop_flag_is_known(flag: String) bool {
    return false
}

fn read_prop_exp(p: Parser, act: ACT, name: String) Exp !Error {
    let exp = p.create_exp(EXP.prop)
    exp.act = act
    exp.str1 = name

    p.expect(":", true, false) !>
    exp.set(PROP_EXP.type, read_type_exp(p, false, true) !>)

    // Optional default value: ( ... )
    let t = p.tok(true, true, false) !>
    if t == TOK.sign && p.word_is("(") {
        p.tok(true, true) !>
        exp.set(PROP_EXP.default, read_body_exp(p, "(", ")") !>)
        t = p.tok(true, true, false) !>
    }

    read_exp_flags(p, exp, t, true, true, "property") !>

    exp.set_end(p.token_end)
    return exp
}

fn read_getter_exp(p: Parser, act: ACT, is_static: bool) Exp !Error {
    let exp = p.create_exp(EXP.func)
    exp.act = act
    exp.kind = FUNC_KIND.get
    exp.bool1 = is_static
    exp.str1 = p.read_word(true, false) !>

    p.expect(":", true, true) !>
    exp.set(FUNC_EXP.type, read_type_exp(p, true, true) !>)

    let t = p.tok(true, true, false) !>
    t = read_exp_flags(p, exp, t, true, true, "") !>
    read_body_or_semicolon(p, exp, t, "getter type") !>
    exp.set_end(p.token_end)
    return exp
}

// Current token is `group`. Form: group name { ... }
fn read_group_exp(p: Parser, act: ACT) Exp !Error {
    let exp = p.create_exp(EXP.group)
    exp.act = act
    exp.str1 = p.read_word(true, false) !>
    p.expect("{", true, true) !>
    exp.set(GROUP_EXP.body, read_body_exp(p, "{", "}") !>)
    exp.set_end(p.token_end)
    return exp
}


use build
use valk:json

extend Lsp {
    fn definition() {
        this.build_at_cursor()
    }

    fn send_definition(exp: build:Exp) {
        let at = build:message_resolve(exp.src, exp.i)
        let path = at.src.path
        if !isset(path) : return
        let loc = lsp_line_col(at.src.content, at.i)

        let resp = json:new_object()
        let res = json:new_object()
        resp.set("id", this.id)
        resp.set("result", res)

        res.set("uri", "file://" + path)
        res.set("range", json_range(loc.line, loc.col, loc.line, loc.col))

        this.respond(resp)
    }
}

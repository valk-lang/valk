
# Root-level build binaries (extensionless: valk, valk-new, valk-fmt-test, …)
# Git cannot match "ELF binary"; ignore every extensionless root file, then
# re-include known source/meta files without extensions.
/*
!/*/
!/*.*
!/Makefile
!/LICENSE
!/Dockerfile
!/Justfile
!/Procfile
!/.gitignore

# Local / build output dirs (re-ignored after !/*/ above)
/debug/
/dist/
/vendor/

*.Indentifier
**/*.Indentifier
callgrind.*
*.xz
*.gz

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex
*.Identifier

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf


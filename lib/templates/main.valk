@unsafe
@ignore_access

use valk.gc
use valk.core
use valk.coro

#if OS == "win"
use valk.io
use valk.ext
#end

fn __valk_main__(argc: i32, argv: ptr) i32 $entrance {
    coro.gc_stack_sp = null
    gc.thread_init(true)

    @allocas

    ir_comment("INIT GLOBALS")
    #loop globals G T
    #if G.$has_explicit_default_value
    G = G.$default_value
    #end
    #end
    ir_comment("END GLOBALS")

    gc.mem_usage_shared = 0
    gc.mem_usage_peak = 0

    #if OS == "win"
    io.set_mode(0, io.Mode.binary) ! panic("Failed to configure standard input")
    io.set_mode(1, io.Mode.binary) ! panic("Failed to configure standard output")
    ext.SetConsoleOutputCP(65001)
    #end

    let args = Array[String].new(8)
    let i = 0
    while i < argc {
        let arg = @ptrv(argv, cstring, i++)
        args.append(arg)
    }
    core.cli_args = args

    ir_comment("REGISTER GC GLOBALS")
    #loop globals G T
    #loop gc_roots G ROOT_OFFSET
    gc.gc.globals.add_ptr(@ref(G).$offset(ROOT_OFFSET))
    #end
    #loop gc_conditional_roots G ROOT_OFFSET TAG_OFFSET TAG
    gc.gc.add_conditional_global(@ref(G).$offset(ROOT_OFFSET), @ref(G).$offset(TAG_OFFSET), TAG)
    #end
    #end
    ir_comment("END GC GLOBALS")

    gc.gc.state = gc.GcState.idle

    #if TEST
    await co valk_run_all_tests()
    #elif MAIN_EXIT_CODE
    let code = await co main(args)
    #if OS == "win"
    io.iocp_close()
    #end
    return code.to(i32)
    #else
    await co main(args)
    #end

    #if OS == "win"
    io.iocp_close()
    #end
    return 0
}

#if TEST
fn valk_run_all_tests() {
    let results = core.TestResults {}
    let tests = Array[co].new(64)

    // Run regular tests concurrently.
    #loop tests as test_func
    #if !TEST_IS_SYNC
    tests.append(co test_func(results))
    #end
    #end

    each tests as test {
        await test
    }

    // Run synctests sequentially after every regular test has finished.
    #loop tests as test_func
    #if TEST_IS_SYNC
    await co test_func(results)
    #end
    #end

    results.print()

    if !results.passed() {
        exit(1)
    }
}
#end

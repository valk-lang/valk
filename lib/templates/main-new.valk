
@ignore_access

use valk:gc
use valk:core
use valk:coro

#if OS == "win"
use valk:io
#end

fn __valk_main__(argc: i32, argv: ptr) i32 $entrance {
    coro:gc_stack_sp = null
    gc:thread_init(true)

    @allocas

    gc:mem_usage_shared = 0
    gc:mem_usage_peak = 0

    #if OS == "win"
    io:set_mode(0, io:MODE.binary)
    io:set_mode(1, io:MODE.binary)
    #end

    let args = Array[String].new(8)
    let i = 0
    while i < argc {
        let arg = @ptrv(argv, cstring, i++)
        args.append(arg)
    }
    core:cli_args = args

    ir_comment("INIT GLOBALS")
    #loop globals G T
    #if G.$has_default_value
    G = G.$default_value
    #end
    #if T.$is_gc
    gc:gc.globals.add_ptr(@ref(G))
    #end
    #end
    ir_comment("END GLOBALS")

    // Keep collection disabled while validating the rewrite backend. This lets
    // the full runtime suite expose codegen issues independently of the GC
    // ownership work, which is handled as a separate final pass.
    gc:gc.disable = true

    #if TEST
    await co valk_run_all_tests()
    #else
    await co main(args)
    #end

    return 0
}

#if TEST
fn valk_run_all_tests() {
    let results = core:TestResults{}

    #loop tests as test_func
    test_func(results)
    #end

    results.print()
    if !results.passed() {
        exit(1)
    }
}
#end

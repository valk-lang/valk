
@ignore_access

use valk:gc
use valk:core
use valk:coro

#if OS == "win"
use valk:io
#end

fn __valk_main__(argc: i32, argv: ptr) i32 $entrance {
    coro:gc_stack_sp = null
    gc:thread_init(true)

    @allocas

    ir_comment("INIT GLOBALS")
    #loop globals G T
    #if G.$has_explicit_default_value
    G = G.$default_value
    #end
    #end
    ir_comment("END GLOBALS")

    gc:mem_usage_shared = 0
    gc:mem_usage_peak = 0

    #if OS == "win"
    io:set_mode(0, io:MODE.binary)
    io:set_mode(1, io:MODE.binary)
    #end

    let args = Array[String].new(8)
    let i = 0
    while i < argc {
        let arg = @ptrv(argv, cstring, i++)
        args.append(arg)
    }
    core:cli_args = args

    ir_comment("REGISTER GC GLOBALS")
    #loop globals G T
    #if T.$is_gc
    gc:gc.globals.add_ptr(@ref(G))
    #end
    #end
    ir_comment("END GC GLOBALS")

    gc:gc.disable = false

    #if TEST
    await co valk_run_all_tests()
    #elif MAIN_EXIT_CODE
    // `fn main() i32` supplies the process exit code; a void `fn main()` exits 0.
    // MAIN_EXIT_CODE is set by the compiler once main's return type is known.
    let code = await co main(args)
    return code.to(i32)
    #else
    await co main(args)
    #end

    return 0
}

#if TEST
fn valk_run_all_tests() {
    let results = core:TestResults{}

    #loop tests as test_func
    test_func(results)
    #end

    results.print()
    if !results.passed() {
        exit(1)
    }
}
#end


use core
use ext

global ansi_supported: u8 (0)

/// Returns whether standard output shows ANSI escape codes as colors.
///
/// False when `NO_COLOR` is set to a non-empty value. True when `FORCE_COLOR` or
/// `CLICOLOR_FORCE` is set to anything but `0`, for logs that keep colors such as CI output.
/// Otherwise standard output must be a terminal, not a pipe or a file, and `TERM` must
/// contain `xterm`, `vt`, `ansi`, `linux`, `screen` or `tmux`. The answer is cached after
/// the first call.
+ fn supported() bool {
    if ansi_supported > 0 : return ansi_supported == 1
    let supported = detect(stdout_is_terminal())
    ansi_supported = supported ? 1 : 2
    return supported
}

fn detect(terminal: bool) bool {
    let no_color = core.getenv("NO_COLOR") !? ""
    if no_color.bytes > 0 : return false
    if forced("FORCE_COLOR") || forced("CLICOLOR_FORCE") : return true
    if !terminal : return false
    let term = core.getenv("TERM") !? ""
    return term.contains("xterm") || term.contains("vt") || term.contains("ansi")
        || term.contains("linux") || term.contains("screen") || term.contains("tmux")
}

fn forced(name: String) bool {
    let value = core.getenv(name) !? ""
    return value.bytes > 0 && value != "0"
}

fn stdout_is_terminal() bool {
    #if OS == "win"
    return ext._isatty(1) != 0
    #else
    return ext.isatty(1) != 0
    #end
}

#if TEST
/// Test hook: `supported()` without the cache, for a given answer to whether stdout is a terminal.
+ fn detect_for_test(terminal: bool) bool {
    return detect(terminal)
}
#end

/// Returns whether the console output expects UTF-8.
///
/// On Windows this checks that the console output code page is 65001; elsewhere it is
/// always true.
+ fn utf8_supported() bool {
    #if OS == "win"
    return ext.GetConsoleOutputCP() == 65001
    #else
    return true
    #end
}

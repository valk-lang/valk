use io
use mem

// DEFLATE encoding (RFC 1951): LZ77 matching over a 32 KiB window with
// hash chains (greedy for levels 1-3, lazy for 4-9 as in zlib), then one
// Huffman block per block of symbols using whichever of stored, fixed or
// dynamic codes is smallest

value deflate_window (32768)
value deflate_window_mask (32767)
value deflate_hash_bits (15)
value deflate_min_match (4)
value deflate_max_match (258)
value deflate_block_symbols (65000)
value deflate_end_of_block (256)

// zlib's per-level search parameters: a match of `good` bytes cuts the chain
// search to a quarter, matches of `lazy` bytes are not improved on (levels 1-3:
// longer matches skip hashing their bytes), `nice` stops the search and
// `chain` limits the chain entries tried
global deflate_good: [u16 x 10] ({ 0, 4, 4, 4, 4, 8, 8, 8, 32, 32 })
global deflate_lazy: [u16 x 10] ({ 0, 4, 5, 6, 4, 16, 16, 32, 128, 258 })
global deflate_nice: [u16 x 10] ({ 0, 8, 16, 32, 16, 32, 128, 128, 258, 258 })
global deflate_chain: [u16 x 10] ({ 0, 4, 8, 32, 16, 32, 128, 256, 1024, 4096 })

// Symbol of each match length - 3, and of each distance - 1 (below 256) or
// 256 + ((distance - 1) >> 7)
global deflate_length_code: [u8 x 256] ({ 0... })
global deflate_dist_code: [u8 x 512] ({ 0... })
global deflate_tables_ready: bool (false)
global deflate_fixed_lit: Codes (Codes {})
global deflate_fixed_dist: Codes (Codes {})

fn deflate_init_tables() {
    @unsafe
    let code: uint = 0
    while code < 29 {
        let base = length_base[code].to(uint) - 3
        let n: uint = 1 << length_extra[code].to(uint)
        let i: uint = 0
        while i < n && base + i < 256 {
            deflate_length_code[base + i] = code.to(u8)
            i++
        }
        code++
    }
    code = 0
    while code < 30 {
        let d = dist_base[code].to(uint) - 1
        let end = d + (1 << dist_extra[code].to(uint))
        while d < end {
            let index = d < 256 ? d : 256 + (d >> 7)
            deflate_dist_code[index] = code.to(u8)
            d++
        }
        code++
    }
    deflate_fixed_lit.set_fixed(true)
    deflate_fixed_dist.set_fixed(false)
    deflate_tables_ready = true
}

// Adds `pos` to its hash chain and returns the previous head (position + 1)
fn deflate_insert(data: ptr, head: ptr, prev: ptr, shift: uint, pos: uint) uint $inline {
    @unsafe
    let h = ((@ptrv(data.@offset(pos), u32).to(uint) * 2654435761) & 0xffffffff) >> shift
    let first = @ptrv(head, u32, h)
    // The distance back to the previous position, 0 when none is in reach
    let d = pos + 1 - first.to(uint)
    @ptrv(prev, u16, pos & deflate_window_mask) = (first == 0 || d > deflate_window) ? 0 : d.to(u16)
    @ptrv(head, u32, h) = (pos + 1).to(u32)
    return first.to(uint)
}

// Records a match as symbol `n`: (1 << 31) | (length code << 26) |
// (distance code << 21) | (distance extra bits << 5) | length extra bits
fn deflate_tally_match(symbols: ptr, n: uint, lit_freq: ptr, dist_freq: ptr, length: uint, distance: uint) $inline {
    @unsafe
    let lc = @ptrv(@ref(deflate_length_code).@cast(ptr), u8, length - 3).to(uint)
    let d = distance - 1
    let ds = @ptrv(@ref(deflate_dist_code).@cast(ptr), u8, d < 256 ? d : 256 + (d >> 7)).to(uint)
    let length_bits = length - @ptrv(@ref(length_base).@cast(ptr), u16, lc).to(uint)
    let dist_bits = distance - @ptrv(@ref(dist_base).@cast(ptr), u16, ds).to(uint)
    @ptrv(symbols, u32, n) = ((1 << 31) | (lc << 26) | (ds << 21) | (dist_bits << 5) | length_bits).to(u32)
    @ptrv(lit_freq, u32, 257 + lc) = @ptrv(lit_freq, u32, 257 + lc) + 1
    @ptrv(dist_freq, u32, ds) = @ptrv(dist_freq, u32, ds) + 1
}

/// The compression level used when none is given, a balance of speed and size.
+ value COMPRESS_DEFAULT_LEVEL (6)

// Writes bits least significant first into a ByteBuffer; `bit_count` stays
// below 32 between calls
struct BitWriter {
    out: ByteBuffer
    bit_buf: uint (0)
    bit_count: uint (0)

    // `value` must fit in `count` bits, at most 32
    fn put_bits(value: uint, count: uint) {
        @unsafe
        this.bit_buf = this.bit_buf | (value << this.bit_count)
        this.bit_count += count
        if this.bit_count >= 32 {
            this.out.write_u32_le((this.bit_buf & 0xffffffff).to(u32))
            this.bit_buf = this.bit_buf >> 32
            this.bit_count -= 32
        }
    }

    // Pads to a byte boundary and writes the buffered bytes
    fn flush() {
        @unsafe
        while this.bit_count > 0 {
            this.out.write_byte((this.bit_buf & 0xff).to(u8))
            this.bit_buf = this.bit_buf >> 8
            this.bit_count = this.bit_count > 8 ? this.bit_count - 8 : 0
        }
        this.bit_buf = 0
    }
}

// Code lengths and codes for one alphabet
struct Codes {
    lengths: [u8 x 288] ({ 0... })
    codes: [u16 x 288] ({ 0... })
    // How many codes have each length
    counts: [u16 x 16] ({ 0... })

    // Length-limited Huffman code lengths from symbol frequencies
    fn assign_lengths(freq: ptr, n: uint, max_length: uint) {
        @unsafe
        mem.clear_bytes(@ref(this.lengths).@cast(ptr), 288)
        mem.clear_bytes(@ref(this.counts).@cast(ptr), 32)
        // Used symbols sorted by frequency, ties by symbol. Frequencies fit
        // 16 bits: a block has at most 65000 symbols
        let order = [u16 x 288]{ 0... }
        let used: uint = 0
        let i: uint = 0
        while i < n {
            if @ptrv(freq, u32, i) != 0 {
                order[used] = i.to(u16)
                used++
            }
            i++
        }
        if used == 0 : return
        if used == 1 {
            this.lengths[order[0].to(uint)] = 1
            this.counts[1] = 1
            return
        }
        if used <= 32 {
            // Insertion sort
            i = 1
            while i < used {
                let sym = order[i]
                let f = @ptrv(freq, u32, sym.to(uint))
                let k = i
                while k > 0 && @ptrv(freq, u32, order[k - 1].to(uint)) > f {
                    order[k] = order[k - 1]
                    k--
                }
                order[k] = sym
                i++
            }
        } else {
            // Stable radix sort on the low, then the high byte
            let other = [u16 x 288]{ 0... }
            let from = @ref(order).@cast(ptr)
            let to = @ref(other).@cast(ptr)
            let shift: uint = 0
            while shift < 16 {
                let buckets = [u16 x 256]{ 0... }
                i = 0
                while i < used {
                    let b = (@ptrv(freq, u32, @ptrv(from, u16, i).to(uint)).to(uint) >> shift) & 255
                    buckets[b] = buckets[b] + 1
                    i++
                }
                let sum: u16 = 0
                i = 0
                while i < 256 {
                    let c = buckets[i]
                    buckets[i] = sum
                    sum += c
                    i++
                }
                i = 0
                while i < used {
                    let sym = @ptrv(from, u16, i)
                    let b = (@ptrv(freq, u32, sym.to(uint)).to(uint) >> shift) & 255
                    @ptrv(to, u16, buckets[b].to(uint)) = sym
                    buckets[b] = buckets[b] + 1
                    i++
                }
                let t = from
                from = to
                to = t
                shift += 8
            }
            // Two passes leave the result back in `order`
        }
        // Huffman tree: leaves are items 0..used, internal nodes follow.
        // Both the sorted leaves and the created nodes form queues in
        // increasing weight, so the two lightest items are at the fronts
        let weights = [uint x 576]{ 0... }
        let parent = [u16 x 576]{ 0... }
        let has_parent = [u8 x 576]{ 0... }
        i = 0
        while i < used {
            weights[i] = @ptrv(freq, u32, order[i].to(uint)).to(uint)
            i++
        }
        let queue = [u16 x 288]{ 0... }
        let queue_head: uint = 0
        let queue_len: uint = 0
        let leaf: uint = 0
        let next_node = used
        while (used - leaf) + (queue_len - queue_head) >= 2 {
            let picked = [uint x 2]{ 0... }
            let p: uint = 0
            while p < 2 {
                let take_leaf = leaf < used
                if take_leaf && queue_head < queue_len {
                    take_leaf = weights[leaf] <= weights[queue[queue_head].to(uint)]
                }
                if take_leaf {
                    picked[p] = leaf
                    leaf++
                } else {
                    picked[p] = queue[queue_head].to(uint)
                    queue_head++
                }
                p++
            }
            let node = next_node
            next_node++
            weights[node] = weights[picked[0]] + weights[picked[1]]
            parent[picked[0]] = node.to(u16)
            parent[picked[1]] = node.to(u16)
            has_parent[picked[0]] = 1
            has_parent[picked[1]] = 1
            queue[queue_len] = node.to(u16)
            queue_len++
        }
        // Depth of every leaf, capped at max_length
        let count = [uint x 16]{ 0... }
        i = 0
        while i < used {
            let depth: uint = 0
            let item = i
            while has_parent[item] != 0 {
                item = parent[item].to(uint)
                depth++
            }
            if depth > max_length : depth = max_length
            count[depth] = count[depth] + 1
            i++
        }
        // Restore the Kraft equality after capping (miniz's method)
        let total: uint = 0
        let l: uint = 1
        while l <= max_length {
            total += count[l] << (max_length - l)
            l++
        }
        while total != (1 << max_length) {
            count[max_length] = count[max_length] - 1
            l = max_length - 1
            while l > 0 {
                if count[l] > 0 {
                    count[l] = count[l] - 1
                    count[l + 1] = count[l + 1] + 2
                    break
                }
                l--
            }
            total--
        }
        // Rarest symbols get the longest lengths
        let length: uint = max_length
        let remaining = count[length]
        i = 0
        while i < used {
            while remaining == 0 {
                length--
                remaining = count[length]
            }
            this.lengths[order[i].to(uint)] = length.to(u8)
            remaining--
            i++
        }
        i = 1
        while i <= max_length {
            this.counts[i] = count[i].to(u16)
            i++
        }
    }

    // The fixed codes of RFC 1951: literal/length when `lit`, else distance
    fn set_fixed(lit: bool) {
        @unsafe
        mem.clear_bytes(@ref(this.counts).@cast(ptr), 32)
        let i: uint = 0
        if lit {
            while i < 144 : this.lengths[i++] = 8
            while i < 256 : this.lengths[i++] = 9
            while i < 280 : this.lengths[i++] = 7
            while i < 288 : this.lengths[i++] = 8
            this.counts[7] = 24
            this.counts[8] = 152
            this.counts[9] = 112
            this.assign_codes(288)
            return
        }
        while i < 30 : this.lengths[i++] = 5
        this.counts[5] = 30
        this.assign_codes(30)
    }

    // Canonical codes from the lengths, bit-reversed: the stream stores
    // Huffman codes most significant bit first
    fn assign_codes(n: uint) {
        @unsafe
        let next = [uint x 16]{ 0... }
        let code: uint = 0
        let len: uint = 1
        while len < 16 {
            code = (code + (len > 1 ? this.counts[len - 1].to(uint) : 0)) << 1
            next[len] = code
            len++
        }
        let i: uint = 0
        while i < n {
            let l = this.lengths[i].to(uint)
            if l != 0 {
                this.codes[i] = reverse_bits(next[l], l).to(u16)
                next[l] = next[l] + 1
            }
            i++
        }
    }
}

// Compresses a buffer whose first `history` bytes were already emitted (they
// only serve as match sources)
class Deflater {
    level: uint
    good: uint (0)
    lazy: uint (0)
    nice: uint (0)
    max_chain: uint (0)
    // Hash chains: the last position + 1 per hash (0 is empty), and per
    // window slot the u16 distance to the previous position with the same
    // hash (0 is none). Only the first 1 << (32 - hash_shift) heads are used
    head: ptr (mem.calloc((1 << deflate_hash_bits) * 4))
    prev: ptr (mem.calloc(deflate_window * 2))
    hash_shift: uint (32 - deflate_hash_bits)
    // Positions before this one are in the hash chains
    hashed: uint (0)
    // Block symbols: literal < 256, or a match as `deflate_tally_match` stores it
    symbols: ptr (mem.calloc(deflate_block_symbols * 4))
    symbol_count: uint (0)
    lit_freq: ptr (mem.calloc(288 * 4))
    dist_freq: ptr (mem.calloc(32 * 4))
    lit_codes: Codes (Codes {})
    dist_codes: Codes (Codes {})
    // The planned dynamic header: code length symbols, their extra bits at
    // offset 320, and their code
    header_symbols: ptr (mem.calloc(640))
    header_count: uint (0)
    header_hclen: uint (0)
    header_codes: Codes (Codes {})
    writer: BitWriter
    // The farthest a match may reach back
    max_distance: uint (deflate_window)
    // Lazy levels (4-9) switch chains, see `longest_match`
    switch_chains: bool (false)
    // Distance of the match `longest_match` found
    match_distance: uint (0)

    static fn new(out: ByteBuffer, level: uint) Deflater {
        @unsafe
        let d = Deflater {
            level: 0
            writer: BitWriter { out: out }
        }
        d.set_level(level)
        return d
    }

    fn gc_free() {
        @unsafe
        mem.free(this.head)
        mem.free(this.prev)
        mem.free(this.symbols)
        mem.free(this.lit_freq)
        mem.free(this.dist_freq)
        mem.free(this.header_symbols)
    }

    fn set_level(level: uint) {
        @unsafe
        if level > 9 : level = 9
        this.level = level
        this.good = deflate_good[level].to(uint)
        this.lazy = deflate_lazy[level].to(uint)
        this.nice = deflate_nice[level].to(uint)
        this.max_chain = deflate_chain[level].to(uint)
        this.switch_chains = level >= 4
    }

    // Empties the hash chains for new input of `length` bytes (uint.$max when
    // unknown). Short inputs use fewer heads, so less is cleared and probed.
    // The previous-position table needs no clearing: chains start at a head
    // and every entry they reach was written for the current input
    fn begin(length: uint) {
        @unsafe
        let bits: uint = 9
        while bits < deflate_hash_bits && (1 << bits) < length : bits++
        this.hash_shift = 32 - bits
        this.hashed = 0
        if this.level > 0 : mem.clear_bytes(this.head, (1 << bits) * 4)
    }

    // Moves the hash chains `shift` bytes down, after the caller dropped that
    // many bytes from the front of its buffer
    fn slide(shift: uint) {
        @unsafe
        let s = shift.to(u32)
        let i: uint = 0
        let heads: uint = 1 << (32 - this.hash_shift)
        let head = this.head
        while i < heads {
            let v = @ptrv(head, u32, i)
            @ptrv(head, u32, i) = v > s ? v - s : 0
            i++
        }
        this.hashed = this.hashed > shift ? this.hashed - shift : 0
    }

    // Compresses data[start..length) with data[0..start) as history, after
    // `begin`. The last block is marked final when `final` is set
    fn compress_range(data: ptr, length: uint, start: uint, final: bool) {
        @unsafe
        if this.level == 0 {
            this.write_stored_blocks(data, start, length, final)
            return
        }
        if !deflate_tables_ready : deflate_init_tables()
        // History positions take part in matching
        let pos = this.hashed
        while pos < start && pos + deflate_min_match <= length {
            deflate_insert(data, this.head, this.prev, this.hash_shift, pos)
            pos++
        }
        if this.level <= 3 : this.compress_fast(data, length, start, final)
        else : this.compress_lazy(data, length, start, final)
        this.hashed = length >= deflate_min_match ? length - deflate_min_match + 1 : 0
    }

    // Greedy matching: each position takes the longest match found there.
    // The hot loops keep the symbol count and tables in locals
    fn compress_fast(data: ptr, length: uint, start: uint, final: bool) {
        @unsafe
        let pos = start
        let block_start = start
        let max_insert = this.lazy
        let head = this.head
        let prev = this.prev
        let shift = this.hash_shift
        let symbols = this.symbols
        let lit_freq = this.lit_freq
        let dist_freq = this.dist_freq
        let n = this.symbol_count
        while pos < length {
            let left = length - pos
            let len: uint = 0
            if left >= deflate_min_match {
                let cur = deflate_insert(data, head, prev, shift, pos)
                if cur != 0 : len = this.longest_match(data, pos, cur, deflate_min_match - 1, left > deflate_max_match ? deflate_max_match : left)
            }
            if len != 0 {
                deflate_tally_match(symbols, n, lit_freq, dist_freq, len, this.match_distance)
                n++
                let end = pos + len
                pos++
                if len <= max_insert {
                    while pos < end && pos + deflate_min_match <= length {
                        deflate_insert(data, head, prev, shift, pos)
                        pos++
                    }
                }
                pos = end
            } else {
                let byte = @ptrv(data, u8, pos)
                @ptrv(symbols, u32, n) = byte.to(u32)
                n++
                @ptrv(lit_freq, u32, byte) = @ptrv(lit_freq, u32, byte) + 1
                pos++
            }
            if n >= deflate_block_symbols {
                this.symbol_count = n
                this.write_block(data, block_start, pos, false)
                n = 0
                block_start = pos
            }
        }
        this.symbol_count = n
        this.write_block(data, block_start, length, final)
    }

    // Lazy matching: a match is only taken when the next position has no
    // longer one; otherwise its first byte becomes a literal
    fn compress_lazy(data: ptr, length: uint, start: uint, final: bool) {
        @unsafe
        let pos = start
        let block_start = start
        let max_lazy = this.lazy
        let head = this.head
        let prev = this.prev
        let shift = this.hash_shift
        let symbols = this.symbols
        let lit_freq = this.lit_freq
        let dist_freq = this.dist_freq
        let n = this.symbol_count
        // The match found at pos - 1, and whether that byte awaits a symbol
        let prev_length: uint = 0
        let prev_distance: uint = 0
        let pending = false
        while pos < length {
            let left = length - pos
            let len: uint = 0
            if left >= deflate_min_match {
                let cur = deflate_insert(data, head, prev, shift, pos)
                if cur != 0 && prev_length < max_lazy {
                    let limit = left > deflate_max_match ? deflate_max_match : left
                    let best = prev_length < deflate_min_match ? deflate_min_match - 1 : prev_length
                    if best < limit : len = this.longest_match(data, pos, cur, best, limit)
                }
            }
            if prev_length != 0 && len == 0 {
                deflate_tally_match(symbols, n, lit_freq, dist_freq, prev_length, prev_distance)
                n++
                // pos is hashed already
                let end = pos - 1 + prev_length
                pos++
                while pos < end && pos + deflate_min_match <= length {
                    deflate_insert(data, head, prev, shift, pos)
                    pos++
                }
                pos = end
                prev_length = 0
                pending = false
            } else {
                if pending {
                    let byte = @ptrv(data, u8, pos - 1)
                    @ptrv(symbols, u32, n) = byte.to(u32)
                    n++
                    @ptrv(lit_freq, u32, byte) = @ptrv(lit_freq, u32, byte) + 1
                }
                pending = true
                prev_length = len
                prev_distance = this.match_distance
                pos++
            }
            if n >= deflate_block_symbols {
                let covered = pending ? pos - 1 : pos
                this.symbol_count = n
                this.write_block(data, block_start, covered, false)
                n = 0
                block_start = covered
            }
        }
        if pending {
            let byte = @ptrv(data, u8, pos - 1)
            @ptrv(symbols, u32, n) = byte.to(u32)
            n++
            @ptrv(lit_freq, u32, byte) = @ptrv(lit_freq, u32, byte) + 1
        }
        this.symbol_count = n
        this.write_block(data, block_start, length, final)
    }

    // The longest match at `pos` along the chain from `cur` (position + 1)
    // that is longer than `best` and at most `limit` (> best, >= 4) bytes;
    // 0 when there is none. Sets `match_distance`
    // With `switch_chains`, after each improvement the search continues on
    // the chain of whichever 4 bytes of the match reach furthest back: any
    // longer match contains them at the same offset (zlib-ng's slow search)
    fn longest_match(data: ptr, pos: uint, cur: uint, best: uint, limit: uint) uint $inline {
        @unsafe
        let chain = this.max_chain
        if best >= this.good : chain = chain >> 2
        let nice = this.nice
        if nice > limit : nice = limit
        let max_distance = this.max_distance
        let switch_chains = this.switch_chains
        let prev = this.prev
        let scan = data.@offset(pos)
        let first = @ptrv(scan, u32)
        let found: uint = 0
        // The chain walked holds `node`; candidates start `offset` bytes before it
        let node = cur - 1
        let offset: uint = 0
        while true {
            let candidate = node - offset
            let distance = pos - candidate
            if distance > max_distance : break
            let other = data.@offset(candidate)
            // Checking the bytes that would make the match longer first
            // rules most candidates out cheaply
            if @ptrv(other.@offset(best - 3), u32) == @ptrv(scan.@offset(best - 3), u32) && @ptrv(other, u32) == first {
                let n: uint = 4
                while true {
                    if n + 8 > limit {
                        while n < limit && @ptrv(other, u8, n) == @ptrv(scan, u8, n) : n++
                        break
                    }
                    let diff = @ptrv(other.@offset(n), u64) ^ @ptrv(scan.@offset(n), u64)
                    if diff != 0 {
                        n += diff.trailing_zeros() >> 3
                        break
                    }
                    n += 8
                }
                if n > best {
                    best = n
                    found = n
                    this.match_distance = distance
                    if n >= nice : break
                    if switch_chains {
                        // Only positions before `pos` are in the chains
                        let last = n - 4
                        if last >= distance : last = distance - 1
                        let next_start: uint = uint.$max
                        let i: uint = 0
                        while i <= last {
                            let at = candidate + i
                            let back = @ptrv(prev, u16, at & deflate_window_mask).to(uint)
                            // No earlier copy of these 4 bytes: nothing longer exists
                            if back == 0 || back > at || at - back < i {
                                next_start = uint.$max
                                break
                            }
                            let start = at - back - i
                            if start < next_start {
                                next_start = start
                                node = at - back
                                offset = i
                            }
                            i++
                        }
                        if next_start == uint.$max : break
                        // The newest copy of the 4 bytes ending one past the
                        // match, when it is older than that
                        let end_offset = n - 3
                        let h = ((@ptrv(scan.@offset(end_offset), u32).to(uint) * 2654435761) & 0xffffffff) >> this.hash_shift
                        let newest = @ptrv(this.head, u32, h).to(uint)
                        if newest > end_offset {
                            let start = newest - 1 - end_offset
                            if start < next_start {
                                node = newest - 1
                                offset = end_offset
                            }
                        }
                        chain--
                        if chain == 0 : break
                        continue
                    }
                }
            }
            chain--
            if chain == 0 : break
            let back = @ptrv(prev, u16, node & deflate_window_mask).to(uint)
            if back == 0 || back + offset > node : break
            node -= back
        }
        return found
    }

    fn write_stored_blocks(data: ptr, start: uint, end: uint, final: bool) {
        @unsafe
        let pos = start
        while true {
            let count = end - pos
            if count > 65535 : count = 65535
            let last = final && pos + count == end
            this.writer.put_bits(last ? 1 : 0, 1)
            this.writer.put_bits(0, 2)
            this.writer.flush()
            let out = this.writer.out
            out.write_u16_le(count.to(u16))
            out.write_u16_le((count ^ 0xffff).to(u16))
            out.reserve(count)
            mem.copy_bytes(data.@offset(pos), out.view_spare(count).data, count)
            out.skip(count)
            pos += count
            if pos >= end : break
        }
    }

    // Emits the buffered symbols as the smallest of a stored, fixed or
    // dynamic block; data[start..end) are the bytes they encode
    fn write_block(data: ptr, start: uint, end: uint, final: bool) {
        @unsafe
        let lit_end = this.lit_freq.@offset(deflate_end_of_block * 4)
        @ptrv(lit_end, u32) = 1

        // Dynamic code lengths and their cost
        this.lit_codes.assign_lengths(this.lit_freq, 286, 15)
        this.dist_codes.assign_lengths(this.dist_freq, 30, 15)
        let dynamic_bits = this.plan_dynamic_header() + this.symbol_bits(@ref(this.lit_codes), @ref(this.dist_codes))
        let fixed_bits = 3 + this.symbol_bits(@ref(deflate_fixed_lit), @ref(deflate_fixed_dist))
        let stored_bits = (end - start) * 8 + 40 * ((end - start) / 65535 + 1)

        if stored_bits <= dynamic_bits && stored_bits <= fixed_bits {
            this.write_stored_blocks(data, start, end, final)
        } else if fixed_bits <= dynamic_bits {
            this.writer.put_bits(final ? 1 : 0, 1)
            this.writer.put_bits(1, 2)
            this.write_symbols(@ref(deflate_fixed_lit), @ref(deflate_fixed_dist))
        } else {
            this.writer.put_bits(final ? 1 : 0, 1)
            this.writer.put_bits(2, 2)
            this.write_dynamic_header()
            this.write_symbols(@ref(this.lit_codes), @ref(this.dist_codes))
        }
        if final : this.writer.flush()

        this.symbol_count = 0
        mem.clear_bytes(this.lit_freq, 288 * 4)
        mem.clear_bytes(this.dist_freq, 32 * 4)
    }

    // Bits the symbols take with these codes
    fn symbol_bits(lit: *Codes, dist: *Codes) uint {
        @unsafe
        let bits: uint = 0
        let lengths = @ref(lit.lengths).@cast(ptr)
        let i: uint = 0
        while i < 286 {
            let f = @ptrv(this.lit_freq, u32, i).to(uint)
            if f != 0 {
                bits += f * @ptrv(lengths, u8, i).to(uint)
                if i >= 257 : bits += f * length_extra[i - 257].to(uint)
            }
            i++
        }
        lengths = @ref(dist.lengths).@cast(ptr)
        i = 0
        while i < 30 {
            let f = @ptrv(this.dist_freq, u32, i).to(uint)
            if f != 0 : bits += f * (@ptrv(lengths, u8, i).to(uint) + dist_extra[i].to(uint))
            i++
        }
        return bits
    }

    fn write_symbols(lit: *Codes, dist: *Codes) {
        @unsafe
        let count = this.symbol_count
        let out = this.writer.out
        out.reserve(count * 6 + 16)
        let dst = out.data.@offset(out.length)
        let written: uint = 0
        let bits = this.writer.bit_buf
        let nbits = this.writer.bit_count
        let symbols = this.symbols
        let lit_code = @ref(lit.codes).@cast(ptr)
        let lit_len = @ref(lit.lengths).@cast(ptr)
        let dist_code = @ref(dist.codes).@cast(ptr)
        let dist_len = @ref(dist.lengths).@cast(ptr)
        let len_extra = @ref(length_extra).@cast(ptr)
        let d_extra = @ref(dist_extra).@cast(ptr)
        let i: uint = 0
        while i < count {
            let s = @ptrv(symbols, u32, i).to(uint)
            if s < 256 {
                bits = bits | (@ptrv(lit_code, u16, s).to(uint) << (nbits & 63))
                nbits += @ptrv(lit_len, u8, s).to(uint)
            } else {
                let lc = (s >> 26) & 31
                let ds = (s >> 21) & 31
                let sym = 257 + lc
                bits = bits | (@ptrv(lit_code, u16, sym).to(uint) << (nbits & 63))
                nbits += @ptrv(lit_len, u8, sym).to(uint)
                bits = bits | ((s & 31) << (nbits & 63))
                nbits += @ptrv(len_extra, u8, lc).to(uint)
                // At most 31 + 15 + 5 bits: make room for the distance
                @ptrv(dst.@offset(written), u64) = bits.to(u64)
                let bytes = nbits >> 3
                written += bytes
                bits = bits >> ((bytes << 3) & 63)
                nbits = nbits & 7
                bits = bits | (@ptrv(dist_code, u16, ds).to(uint) << nbits)
                nbits += @ptrv(dist_len, u8, ds).to(uint)
                bits = bits | (((s >> 5) & 0x1fff) << (nbits & 63))
                nbits += @ptrv(d_extra, u8, ds).to(uint)
            }
            if nbits >= 32 {
                @ptrv(dst.@offset(written), u64) = bits.to(u64)
                let bytes = nbits >> 3
                written += bytes
                bits = bits >> ((bytes << 3) & 63)
                nbits = nbits & 7
            }
            i++
        }
        out.skip(written)
        this.writer.bit_buf = bits
        this.writer.bit_count = nbits
        this.writer.put_bits(@ptrv(lit_code, u16, deflate_end_of_block).to(uint), @ptrv(lit_len, u8, deflate_end_of_block).to(uint))
    }

    // The run-length encoded code lengths of both alphabets: symbols 0-15
    // are lengths, 16 repeats the previous length, 17 and 18 repeat zero
    fn code_length_symbols(out: ptr, extra: ptr) uint {
        @unsafe
        let hlit = this.hlit()
        let hdist = this.hdist()
        let total = hlit + hdist
        let n: uint = 0
        let i: uint = 0
        while i < total {
            let l = i < hlit ? this.lit_codes.lengths[i].to(uint) : this.dist_codes.lengths[i - hlit].to(uint)
            let run: uint = 1
            while i + run < total {
                let next = i + run < hlit ? this.lit_codes.lengths[i + run].to(uint) : this.dist_codes.lengths[i + run - hlit].to(uint)
                if next != l : break
                run++
            }
            if l == 0 && run >= 3 {
                if run > 138 : run = 138
                if run <= 10 {
                    @ptrv(out, u8, n) = 17
                    @ptrv(extra, u8, n) = (run - 3).to(u8)
                } else {
                    @ptrv(out, u8, n) = 18
                    @ptrv(extra, u8, n) = (run - 11).to(u8)
                }
                n++
                i += run
                continue
            }
            if l != 0 && run >= 4 {
                @ptrv(out, u8, n) = l.to(u8)
                @ptrv(extra, u8, n) = 0
                n++
                run--
                if run > 6 : run = 6
                @ptrv(out, u8, n) = 16
                @ptrv(extra, u8, n) = (run - 3).to(u8)
                n++
                i += run + 1
                continue
            }
            @ptrv(out, u8, n) = l.to(u8)
            @ptrv(extra, u8, n) = 0
            n++
            i++
        }
        return n
    }

    fn hlit() uint {
        @unsafe
        let n: uint = 286
        while n > 257 && this.lit_codes.lengths[n - 1] == 0 : n--
        return n
    }

    fn hdist() uint {
        @unsafe
        let n: uint = 30
        while n > 1 && this.dist_codes.lengths[n - 1] == 0 : n--
        return n
    }

    // Prepares the dynamic block header: the run-length encoded code lengths
    // and their code. Returns its size in bits
    fn plan_dynamic_header() uint {
        @unsafe
        let symbols = this.header_symbols
        let extra = symbols.@offset(320)
        let count = this.code_length_symbols(symbols, extra)
        this.header_count = count
        let freq = [u32 x 19]{ 0... }
        let i: uint = 0
        while i < count {
            let s = @ptrv(symbols, u8, i).to(uint)
            freq[s] = freq[s] + 1
            i++
        }
        let codes = @ref(this.header_codes)
        codes.assign_lengths(@ref(freq).@cast(ptr), 19, 7)
        let hclen: uint = 19
        while hclen > 4 && codes.lengths[code_length_order[hclen - 1].to(uint)] == 0 : hclen--
        this.header_hclen = hclen
        let bits: uint = 3 + 5 + 5 + 4 + hclen * 3
        i = 0
        while i < 19 {
            let f = freq[i].to(uint)
            if f != 0 {
                bits += f * codes.lengths[i].to(uint)
                if i == 16 : bits += f * 2
                else if i == 17 : bits += f * 3
                else if i == 18 : bits += f * 7
            }
            i++
        }
        return bits
    }

    fn write_dynamic_header() {
        @unsafe
        let codes = @ref(this.header_codes)
        codes.assign_codes(19)
        let hlit = this.hlit()
        let hdist = this.hdist()
        this.lit_codes.assign_codes(hlit)
        this.dist_codes.assign_codes(hdist)

        let hclen = this.header_hclen
        this.writer.put_bits(hlit - 257, 5)
        this.writer.put_bits(hdist - 1, 5)
        this.writer.put_bits(hclen - 4, 4)
        let i: uint = 0
        while i < hclen {
            this.writer.put_bits(codes.lengths[code_length_order[i].to(uint)].to(uint), 3)
            i++
        }
        let symbols = this.header_symbols
        let extra = symbols.@offset(320)
        let count = this.header_count
        i = 0
        while i < count {
            let s = @ptrv(symbols, u8, i).to(uint)
            this.writer.put_bits(codes.codes[s].to(uint), codes.lengths[s].to(uint))
            let e = @ptrv(extra, u8, i).to(uint)
            if s == 16 : this.writer.put_bits(e, 2)
            else if s == 17 : this.writer.put_bits(e, 3)
            else if s == 18 : this.writer.put_bits(e, 7)
            i++
        }
    }
}

use core

// General-purpose checksums: CRC-32 (IEEE 802.3, as used by gzip, zip and
// PNG) and Adler-32 (zlib). Both take a running value so that data can be
// checksummed in pieces

// Slicing-by-16 tables, built once before main: table 0 is the classic
// byte-at-a-time table, table k advances a byte through k more zero bytes
@shared crc32_tables: [[u32 x 256] x 16] (crc32_make_tables())

fn crc32_make_tables() [[u32 x 256] x 16] {
    let tables: [[u32 x 256] x 16] = @undefined
    let i: uint = 0
    while i < 256 {
        let c = i.to(u32)
        let k: uint = 0
        while k < 8 {
            c = (c & 1) != 0 ? 0xedb88320 ^ (c >> 1) : c >> 1
            k++
        }
        tables[0][i] = c
        i++
    }
    i = 0
    while i < 256 {
        let c = tables[0][i]
        let t: uint = 1
        while t < 16 {
            c = tables[0][(c & 0xff).to(uint)] ^ (c >> 8)
            tables[t][i] = c
            t++
        }
        i++
    }
    return tables
}

fn load_le32(data: *[u8], at: uint) u32 $inline {
    @unsafe
    return data[at].to(u32) | (data[at + 1].to(u32) << 8) | (data[at + 2].to(u32) << 16) | (data[at + 3].to(u32) << 24)
}

/// Returns the CRC-32 (IEEE 802.3, as in gzip, zip and PNG) of `data`.
///
/// To checksum data in pieces, pass the previous result as `crc`:
///
/// ```valk
/// let crc = compress.crc32(first)
/// crc = compress.crc32(second, crc)
/// ```
+ fn crc32(data: local &[u8], crc: u32 (0)) u32 {
    @unsafe
    let t = @ref(crc32_tables)
    let c = crc ^ 0xffffffff
    let p = data.data
    let left = data.length
    #if ARCH == "x64"
    if left >= 64 && core.cpu_has(.pclmul) {
        let folded = left & ~(15).to(uint)
        c = crc32_fold_pclmul(data.view(0, folded), c)
        p = p.@offset(folded)
        left -= folded
    }
    #end
    while left >= 16 {
        let w0 = load_le32(p, 0) ^ c
        let w1 = load_le32(p, 4)
        let w2 = load_le32(p, 8)
        let w3 = load_le32(p, 12)
        c = t[15][(w0 & 0xff).to(uint)] ^ t[14][((w0 >> 8) & 0xff).to(uint)] ^ t[13][((w0 >> 16) & 0xff).to(uint)] ^ t[12][(w0 >> 24).to(uint)]
            ^ t[11][(w1 & 0xff).to(uint)] ^ t[10][((w1 >> 8) & 0xff).to(uint)] ^ t[9][((w1 >> 16) & 0xff).to(uint)] ^ t[8][(w1 >> 24).to(uint)]
            ^ t[7][(w2 & 0xff).to(uint)] ^ t[6][((w2 >> 8) & 0xff).to(uint)] ^ t[5][((w2 >> 16) & 0xff).to(uint)] ^ t[4][(w2 >> 24).to(uint)]
            ^ t[3][(w3 & 0xff).to(uint)] ^ t[2][((w3 >> 8) & 0xff).to(uint)] ^ t[1][((w3 >> 16) & 0xff).to(uint)] ^ t[0][(w3 >> 24).to(uint)]
        p = p.@offset(16)
        left -= 16
    }
    while left > 0 {
        c = t[0][((c ^ p[0].to(u32)) & 0xff).to(uint)] ^ (c >> 8)
        p = p.@offset(1)
        left--
    }
    return c ^ 0xffffffff
}

#if ARCH == "x64"
// Carry-less multiply folding (Intel's "Fast CRC Computation Using PCLMULQDQ", with the
// constants of Linux's crc32-pclmul for the reflected gzip polynomial). `data` is a multiple
// of 16 bytes, at least 64; `c` and the result are the CRC register, not inverted
fn crc32_fold_pclmul(data: local &[u8], c: u32) u32 $target_pclmul {
    let k1: u64 = 0x154442bd4
    let k2: u64 = 0x1c6e41596
    let k3: u64 = 0x1751997d0
    let k4: u64 = 0xccaa009e
    let k5: u64 = 0x163cd6124
    let poly: u64 = 0x1db710641
    let mu: u64 = 0x1f7011641
    let low32: u64 = 0xffffffff
    let length = data.length
    let x1 = crc32_load(data, 0) ^ $insert($splat[u64x2](0), 0, c.to(u64))
    let x2 = crc32_load(data, 16)
    let x3 = crc32_load(data, 32)
    let x4 = crc32_load(data, 48)
    let at: uint = 64
    // Four lanes of 128 bits move 512 bits ahead per step
    while at + 64 <= length {
        x1 = crc32_fold(x1, k1, k2) ^ crc32_load(data, at)
        x2 = crc32_fold(x2, k1, k2) ^ crc32_load(data, at + 16)
        x3 = crc32_fold(x3, k1, k2) ^ crc32_load(data, at + 32)
        x4 = crc32_fold(x4, k1, k2) ^ crc32_load(data, at + 48)
        at += 64
    }
    // Into one lane, then the rest 128 bits at a time
    x1 = crc32_fold(x1, k3, k4) ^ x2
    x1 = crc32_fold(x1, k3, k4) ^ x3
    x1 = crc32_fold(x1, k3, k4) ^ x4
    while at + 16 <= length {
        x1 = crc32_fold(x1, k3, k4) ^ crc32_load(data, at)
        at += 16
    }
    // 128 to 64 bits, 64 to 32, then Barrett reduction
    let low = $extract(x1, 0)
    let high = $extract(x1, 1)
    let t = $clmul(low, k4)
    let a0 = high ^ $extract(t, 0)
    let a1 = $extract(t, 1)
    let m = $clmul(a0 & low32, k5)
    let b0 = $extract(m, 0) ^ ((a0 >> 32) | (a1 << 32))
    let q = $extract($clmul(b0 & low32, mu), 0) & low32
    let r = $extract($clmul(q, poly), 0) ^ b0
    return (r >> 32).to(u32)
}

fn crc32_load(data: local &[u8], at: uint) u64x2 $target_pclmul {
    return $bitcast[u64x2]($load[u8x16](data, at))
}

fn crc32_fold(x: u64x2, k_low: u64, k_high: u64) u64x2 $target_pclmul {
    return $clmul($extract(x, 0), k_low) ^ $clmul($extract(x, 1), k_high)
}
#end

/// Returns the Adler-32 checksum (as in zlib) of `data`.
///
/// To checksum data in pieces, pass the previous result as `adler`; the default 1 starts a
/// new checksum.
+ fn adler32(data: local &[u8], adler: u32 (1)) u32 {
    @unsafe
    let a: uint = (adler & 0xffff).to(uint)
    let b: uint = (adler >> 16).to(uint)
    let p = data.data
    let left = data.length
    while left > 0 {
        // The modulo is deferred over 5552 bytes, the most before 32-bit sums could overflow
        let n: uint = left < 5552 ? left : 5552
        left -= n
        // 16 bytes per step, with no chain from byte to byte: `sums` adds up the bytes
        // per position and `prior` adds up `sums` before each step, which is what `b`
        // gains from the bytes of earlier steps
        let sums: [u32 x 16] = { 0... }
        let prior: [u32 x 16] = { 0... }
        let steps: uint = n / 16
        let s: uint = 0
        while s < steps {
            let j: uint = 0
            while j < 16 {
                prior[j] += sums[j]
                sums[j] += p[j].to(u32)
                j++
            }
            p = p.@offset(16)
            s++
        }
        n -= steps * 16
        b += steps * 16 * a
        let j: uint = 0
        while j < 16 {
            b += 16 * prior[j].to(uint) + (16 - j) * sums[j].to(uint)
            a += sums[j].to(uint)
            j++
        }
        while n > 0 {
            a += p[0].to(uint)
            b += a
            p = p.@offset(1)
            n--
        }
        a = a % 65521
        b = b % 65521
    }
    return ((b << 16) | a).to(u32)
}

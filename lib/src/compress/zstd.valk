use io

// Public Zstandard (RFC 8878) API

global thread_zstd_enc: ?ZstdEncoder (null)

fn get_zstd_encoder() ZstdEncoder {
    let enc = thread_zstd_enc
    if isset(enc) : return enc
    let made = ZstdEncoder {}
    thread_zstd_enc = made
    return made
}

// Appends Zstd frame(s) for `data` into `out`
fn zstd_append(data: local &[u8], out: ByteBuffer, level: uint) {
    let lvl = level > 9 ? 9 : level
    let enc = get_zstd_encoder()
    if data.length == 0 {
        enc.encode_frame(data, out, lvl)
        return
    }
    // Split multi-gigabyte inputs into 256 MiB frames so hash positions fit in u32
    let max_frame: uint = 256 * 1024 * 1024
    let off: uint = 0
    while off < data.length {
        let take = data.length - off
        if take > max_frame : take = max_frame
        enc.encode_frame(data.view(off, take), out, lvl)
        off += take
    }
}

/// Returns `data` compressed in the Zstandard (RFC 8878) format at `level` (0 stores, 1 is
/// fastest, 9 is smallest).
///
/// Levels above 9 act as 9.
+ fn zstd(data: local &[u8], level: uint (ZSTD_DEFAULT_LEVEL)) String {
    let out = ByteBuffer.new(data.length / 4 + 64)
    zstd_append(data, out, level)
    return buffer_result(out)
}

/// Returns the decompressed contents of Zstandard (RFC 8878) `data`.
///
/// `max_size` limits the output in bytes (0 means unlimited); guard against decompression
/// bombs with it when `data` is untrusted. Throws `invalid_input` on malformed data or
/// preset dictionaries, `checksum` on a content checksum mismatch, `truncated` when the
/// data ends early and `too_large` when the output would exceed `max_size`. Concatenated
/// frames and skippable frames are supported.
+ fn unzstd(data: local &[u8], max_size: uint (0)) String !CompressError {
    let out = ByteBuffer.new(data.length * 3 + 64)
    let dec = ZstdDecoder {
        in_data: data.data
        in_len: data.length
        out: out
        limit: max_size == 0 ? uint.$max : max_size
    }
    dec.decode_all() !>
    return buffer_result(out)
}

/// Writes `data` compressed in the Zstandard (RFC 8878) format at `level` to `out` and
/// returns the bytes written.
+ fn zstd_into(data: local &[u8], out: io.Writer, level: uint (ZSTD_DEFAULT_LEVEL)) uint !io.IoError {
    match out {
        ByteBuffer as buffer => {
            let before = buffer.length
            zstd_append(data, buffer, level)
            return buffer.length - before
        }
        default => {}
    }
    let buf = ByteBuffer.new(data.length / 4 + 64)
    zstd_append(data, buf, level)
    let view = buf.view(0, buf.length)
    let total: uint = 0
    while view.length > 0 {
        let written = out.write(view) !>
        if written == 0 || written > view.length : throw .write
        total += written
        view = view.view(written, view.length - written)
    }
    return total
}

/// Writes the decompressed contents of Zstandard (RFC 8878) `data` to `out` and returns
/// the bytes written.
///
/// Takes the same `max_size` and throws the same errors as `unzstd`, plus the writer's
/// error when `out` fails; output written before a failure stays written.
+ fn unzstd_into(data: local &[u8], out: io.Writer, max_size: uint (0)) uint !CompressError {
    let buf = ByteBuffer.new(data.length * 3 + 64)
    let dec = ZstdDecoder {
        in_data: data.data
        in_len: data.length
        out: buf
        limit: max_size == 0 ? uint.$max : max_size
    }
    dec.decode_all() !>
    let view = buf.view(0, buf.length)
    let total: uint = 0
    while view.length > 0 {
        let written = out.write(view) !>
        if written == 0 || written > view.length : throw .write
        total += written
        view = view.view(written, view.length - written)
    }
    return total
}

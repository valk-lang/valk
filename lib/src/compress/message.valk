// Per-message DEFLATE as WebSocket permessage-deflate uses it (RFC 7692): a
// message is raw DEFLATE ending in a sync flush, sent without the flush's
// 00 00 ff ff tail. The coders are kept per thread; callers keep only their
// own buffers, so a connection costs no coder memory

global thread_deflater_value: ?Deflater (null)
global message_inflater: ?Inflater (null)
global deflater_idle: ByteBuffer (ByteBuffer.new(0))

// The calling thread's deflater, set to `level`; one-shot compression and
// messages use it between `begin` and resetting `writer.out` to `deflater_idle`
fn thread_deflater(level: uint) Deflater {
    @unsafe
    let deflater = thread_deflater_value
    if !isset(deflater) {
        deflater = Deflater.new(deflater_idle, level)
        thread_deflater_value = deflater
    }
    if deflater.level != level : deflater.set_level(level)
    deflater.max_distance = deflate_window
    return deflater
}

// Appends `data` compressed to `out`, without the tail. Matches reach back at
// most `1 << window_bits` bytes and never into earlier messages
fn deflate_message(data: local &[u8], out: ByteBuffer, level: uint, window_bits: uint) {
    @unsafe
    let deflater = thread_deflater(level > 9 ? 9 : level)
    deflater.max_distance = 1 << window_bits
    deflater.writer.out = out
    deflater.begin(data.length)
    deflater.compress_range(data.data, data.length, 0, false)
    // Sync flush: an empty stored block, whose LEN/NLEN are the tail
    deflater.write_stored_blocks(data.data, 0, 0, false)
    out.truncate(out.length - 4)
    deflater.writer.out = deflater_idle
}

// Decompresses one message, `data` with the 00 00 ff ff tail appended, onto
// the end of `out`. Bytes already in `out` are the history that matches may
// refer to (context takeover); clear it for independent messages. Throws
// `too_large` when more than `max_size` bytes (0: no limit) would be added
fn inflate_message(data: ByteBuffer, out: ByteBuffer, max_size: uint) !CompressError {
    @unsafe
    let inflater = message_inflater
    if !isset(inflater) {
        inflater = Inflater {
            source: ByteReader.new("")
            input: deflater_idle
            out: deflater_idle
            fixed_input: true
        }
        message_inflater = inflater
    }
    inflater.input = data
    inflater.in_pos = 0
    inflater.in_len = data.length
    inflater.bit_buf = 0
    inflater.bit_count = 0
    inflater.out = out
    inflater.out_pos = out.length
    inflater.phase = INFLATE_PHASE.block_header
    inflater.last_block = false
    let limit = max_size == 0 ? uint.$max : out.length + max_size
    inflater.produce_all(limit) ! {
        inflater.input = deflater_idle
        inflater.out = deflater_idle
        throw E
    }
    inflater.input = deflater_idle
    inflater.out = deflater_idle
}

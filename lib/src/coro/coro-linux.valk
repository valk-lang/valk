// Linux coroutine backend: io_uring.

#if OS == "linux"

use ext
use io
use gc

// Completions of operations no coroutine waits for (see `io.side_user_data`). The low bits of
// their payload name a channel of this thread, the rest is the channel owner's
value SIDE_CHANNEL_BITS (6)
value SIDE_CHANNELS (64)

struct SideEvent {
    data: uint
    res: i32
    flags: u32
}

// One owner's queue of side events, and the coroutine that waits for them
class SideChannel {
    id: uint
    events: Array[SideEvent] (.new(64))
    waiter: ?Coro (null)

    // The payload of a side event for this channel, carrying `data` (24 bits)
    fn payload(data: uint) uint {
        return this.id | (data << SIDE_CHANNEL_BITS)
    }

    // Waits until events are queued, or until `wake`
    fn wait() {
        if this.events.length > 0 : return
        let current = current_coro ?! return
        this.waiter = current
        current.yield()
    }

    fn wake() {
        let waiter = this.waiter ?! return
        this.waiter = null
        run_coros.append(waiter)
    }

    // Events for the channel are dropped from now on; its waiter wakes
    fn close() {
        if (side_channels.get(this.id) !? null) == this : side_channels.set(this.id, null) _
        this.wake()
    }
}

global side_channels: Array[?SideChannel] (.{})
// Ids are handed out in turn, so a late event of a closed channel does not reach a new one
global side_next: uint (1)

// A new channel of this thread; null when all are taken
fn side_channel() ?SideChannel {
    while side_channels.length < SIDE_CHANNELS : side_channels.append(null)
    let tries: uint = 0
    while tries++ < SIDE_CHANNELS {
        let id = side_next
        side_next = side_next % (SIDE_CHANNELS - 1) + 1
        if isset(side_channels.get(id) !? null) : continue
        let channel = SideChannel { id: id }
        side_channels.set(id, channel) _
        return channel
    }
    return null
}

fn side_event(payload: uint, res: i32, flags: u32) {
    let id = payload & (SIDE_CHANNELS - 1)
    if id == 0 : return
    let channel = (side_channels.get(id) !? null) ?! return
    channel.events.append(SideEvent { data: payload >> SIDE_CHANNEL_BITS, res: res, flags: flags })
    channel.wake()
}

extend Coro {
    timeout_ts: io.kernel_timespec (@undefined)

    fn sleep(ns: uint) {
        // The timeout is armed through a signed timespec, so a longer sleep is
        // chained out of the longest chunks that still fit it
        let limit = int.$max.to(uint)
        while true {
            let part = ns > limit ? limit : ns
            let sqe = io.sqe(this) ! panic("Failed to schedule coroutine sleep")
            let nsec = part.to(int)
            this.timeout_ts = {
                tv_sec: nsec / 1_000_000_000
                tv_nsec: (nsec % 1_000_000_000)
            }
            io.io_uring_prep_timeout(sqe, &this.timeout_ts, 0, 0)
            this.yield()
            if part == ns : break
            ns -= part
        }
    }

    // Drain io_uring completions, blocking when no coroutines are runnable.
    static fn wait_for_events() {
        @unsafe
        let ring = io.uring() ! panic("Failed to initialize io_uring: the locked-memory limit leaves no room for a ring")
        // With nothing to run, the entries go out with the wait below, in one system call
        if io.uring_unsubmitted > 0 && run_coros.length > 0 : io.uring_submit(ring)
        expire_parks()
        while true {
            let cqe: ?*ext.io_uring_cqe = null
            if run_coros.length == 0 {
                // A park deadline bounds the wait
                let wait_ms = park_wait_ms()
                gc.unlock()
                if wait_ms == uint.$max && io.uring_unsubmitted > 0 {
                    // The doorbell read may have been queued again in this loop
                    let submitted = ext.io_uring_submit_and_wait(ring, 1)
                    if submitted == 0 - ext.EINTR : submitted = 0
                    io.uring_record_submitted(submitted)
                    io.io_uring_peek_cqe(ring, @ref(cqe))
                } else if wait_ms == uint.$max {
                    io.io_uring_wait_cqe(ring, @ref(cqe))
                } else {
                    if io.uring_unsubmitted > 0 : io.uring_submit(ring)
                    let ts = io.kernel_timespec { tv_sec: (wait_ms / 1000).to(i64), tv_nsec: ((wait_ms % 1000) * 1_000_000).to(i64) }
                    let err = ext.io_uring_wait_cqe_timeout(ring, @ref(cqe), @ref(ts))
                    if err < 0 && err != 0 - ext.ETIME && err != 0 - ext.EINTR : panic("Failed to wait for an io_uring completion")
                }
                gc.lock()
            } else {
                io.io_uring_peek_cqe(ring, @ref(cqe))
            }
            if !isset(cqe) {
                break
            }
            //
            let user_data = cqe.user_data
            if io.is_side_event(user_data) {
                let res = cqe.res
                let flags = cqe.flags
                io.io_uring_cqe_seen(ring, cqe)
                side_event((user_data >> 34).to(uint), res, flags)
                continue
            }
            if user_data == HOME_EVENT.to(u64) {
                // Another thread woke coroutines of this one
                let res = cqe.res
                io.io_uring_cqe_seen(ring, cqe)
                home_event(res)
                continue
            }
            let timeout_tag = user_data & 3
            let coro = take_kernel_event(user_data.to(uint))
            if !isset(coro) {
                io.io_uring_cqe_seen(ring, cqe)
                continue
            }
            // Read `done` before disarming: the last event may release the
            // global root, and no field is touched after that.
            let done = coro.done
            coro.disarm_kernel_event()
            if done {
                io.io_uring_cqe_seen(ring, cqe)
                continue
            }
            if timeout_tag == 1 {
                // Linked timeout completion. ETIME: the timeout fired and
                // the linked operation was cancelled by the kernel, so its
                // completion is stale now — resolve both arms (this bumps
                // the generation and invalidates the counterpart) and wake
                // with a timeout. ECANCELED: the operation completed first
                // and cancelled this timeout; the operation's completion
                // wakes the coroutine, nothing to do here.
                if cqe.res == 0 - ext.ETIME {
                    coro.disarm_kernel_event()
                    coro.poll_event = io.POLL_TIMEOUT
                    coro.completion_res = 0 - ext.ETIMEDOUT
                    run_coros.append(coro)
                }
            } else if timeout_tag == 3 {
                // A send linked to a read (net.send_then_recv): the read's completion
                // wakes the coroutine, and a failed send cancels that read
            } else if timeout_tag == 2 && cqe.res == 0 - ext.ECANCELED {
                // The operation was cancelled because the linked timeout
                // fired — the timeout completion is stale now. Resolve both
                // arms and wake with a timeout.
                coro.disarm_kernel_event()
                coro.poll_event = io.POLL_TIMEOUT
                coro.completion_res = 0 - ext.ETIMEDOUT
                run_coros.append(coro)
            } else {
                // The operation completed; the linked timeout (if any) was
                // cancelled by the kernel and its completion is stale after
                // the disarm below.
                if timeout_tag == 2 : coro.disarm_kernel_event()
                // A negative result is an error like EBADF, not an event mask:
                // as a mask it would satisfy every predicate at once
                coro.poll_event = cqe.res < 0 ? ext.POLLERR : cqe.res.@cast(io.PollEvent)
                coro.completion_res = cqe.res
                run_coros.append(coro)
            }
            io.io_uring_cqe_seen(ring, cqe)
        }
    }
}

#end

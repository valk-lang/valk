
// Starting size of a scratch buffer. It grows if a caller needs more and then
// stays that size for the life of its coroutine
- value TEMP_BUFFER_SIZE (512)

// Used only when there is no current coroutine. Safe to share across such
// callers because suspending requires a coroutine: 'io.await_fd' panics
// without one, so nothing can run in between while this buffer is held
- global thread_temp_buffer: ByteBuffer (.new(TEMP_BUFFER_SIZE))

// An empty scratch buffer belonging to the current coroutine, so that two
// coroutines never share one and suspending inside a write is safe. Falls back
// to a per-thread buffer outside a coroutine.
//
// Unmarked on purpose: available across this package, not to user code.
//
// It is valid until the same coroutine asks again: use it and let it go, never
// hold it across a call that might want one too.
fn temp_buffer() ByteBuffer {
    let coro = current_coro
    if !isset(coro) {
        let shared_buf = thread_temp_buffer
        shared_buf.clear()
        return shared_buf
    }
    let buf = coro.temp_buffer
    if !isset(buf) {
        buf = ByteBuffer.new(TEMP_BUFFER_SIZE)
        coro.temp_buffer = buf
    }
    buf.clear()
    return buf
}

fn yield() {
    let coro = current_coro
    if isset(coro) : coro.yield()
}

/// Moves the current coroutine to the back of the run queue and suspends it.
///
/// Every coroutine scheduled before it runs first. Does nothing outside a coroutine.
+ fn await_last() {
    let coro = current_coro
    if isset(coro) : coro.await_last()
}

/// Waits until `coro` has finished; returns at once when it already has.
///
/// Inside a coroutine it suspends the caller; outside one it runs the scheduler until
/// `coro` is done. Panics when a coroutine awaits itself or the awaits form a cycle.
+ fn await_coro(coro: Coro) {
    let current = current_coro
    if isset(current) : current.await_coro(coro)
    else : Coro.loop(coro)
}

fn throw(code: u32) {
    let current = current_coro
    if isset(current) {
        current.error_code = code
        current.complete()
        return
    }
    panic("Using 'coro.throw' without being inside a coroutine")
}


use ext
use core
use coro
use mem
use gc
use io

global current_coro: ?Coro
global g_coros: Array[?Coro] (.new(16))
// Generations per g_coros slot. Bumped whenever a slot's last kernel event is
// consumed or the slot is released, so every kernel event id that was handed
// out for a slot becomes invalid the moment its coroutine may go away.
global g_coro_gens: Array[uint] (.new(16))
global g_coro_indexes: core.Pool[uint] (.new(16))
global g_coro_count: uint
global run_coros: Array[Coro] (.new(16))
global next_run_coros: Array[Coro] (.new(16))

#if OS == "win"
global main_fiber: ?ptr
#else
global main_state: CoroState (@undefined)
#end

#if OS == "macos"
global timer_id: uint
global io_timeout_coros: Array[Coro] (.new(16))
#end

#if OS == "win"
global cport: ?ptr
global sleep_coros: Array[Coro] (.new(16))
global io_timeout_coros: Array[Coro] (.new(16))
#end

#if OS != "win"
struct CoroState {
    rsp: ptr
}
#end
class Coro {
    // Args & results
    args: ptr
    gc_args: Array[gc.GcPtr] (.{})
    // Coro state
    #if OS == "win"
    fiber: ?ptr
    #else
    state: CoroState (@undefined)
    stack_allocation: ptr (@undefined)
    #end
    backup_gc_sp: ?ptr (null)
    //
    start_func: fnptr()()
    handler: fn()()
    follow_up: ?Coro
    g_list_index: uint (0)
    g_root_released: bool (false)
    // Error result
    error_code: u32 (0)
    // async results
    poll_event: io.PollEvent (0)
    completion_res: i64 (0)
    #if OS == "linux"
    timeout_ts: io.kernel_timespec (@undefined)
    timed_io_active: bool (false)
    timed_io_cancel_pending: bool (false)
    timed_io_timeout_canceled: bool (false)
    #elif OS == "macos"
    io_wait_active: bool (false)
    io_wait_timed_out: bool (false)
    io_wait_fd: FD
    io_deadline_ms: uint (0)
    #elif OS == "win"
    sleep_deadline_ms: u64 (0)
    iocp_ready: bool (false)
    // Reusable IOCP state, see io.overlap(). At most two operations are ever
    // in flight for one coroutine, so two slots cover every path.
    overlap_a: ?io.Overlap (null)
    overlap_b: ?io.Overlap (null)
    io_deadline_ms: u64 (0)
    io_timeout_fd: FD
    io_timeout_overlap: ?ptr
    io_timed_out: bool (false)
    #end

    #if OS != "win"
    kernel_event_count: u8 (0)

    // Counts kernel events that are armed and whose completion is still owed.
    // The global root in g_coros is only released once the coroutine is done
    // AND no event can trigger anymore, so the kernel can never complete an
    // event for a coroutine that was freed.
    + fn arm_kernel_event() {
        if this.kernel_event_count == 255 : panic("Too many pending kernel events for one coroutine")
        this.kernel_event_count++
    }

    + fn disarm_kernel_event() {
        if this.kernel_event_count == 0 : return
        this.kernel_event_count--
        if this.kernel_event_count == 0 {
            // The last armed event was consumed or cancelled. Events that the
            // kernel may still deliver for it (deleted/cancelled) are stale:
            // invalidate their ids so they can never reach this coroutine.
            let index = this.g_list_index
            g_coro_gens.set(index, (g_coro_gens.get(index) !? 0) + 1) _
            if this.done : this.release_global_root()
        }
    }

    // Event id handed to the kernel for this coroutine: generation + slot
    // index + tag. Resolving an id validates the generation, so completions
    // that arrive after the coroutine disarmed or was released resolve to
    // null instead of dereferencing a dangling (or recycled) object.
    + fn event_id() uint {
        let index = this.g_list_index
        return (g_coro_gens.get(index) !? 0) << 34 | index << 2
    }
    #end

    fn release_global_root() {
        if this.g_root_released : return
        this.g_root_released = true
        let index = this.g_list_index
        // Invalidate ids of events that may still be in flight for this slot
        g_coro_gens.set(index, (g_coro_gens.get(index) !? 0) + 1) _
        g_coros.set(index, null) _
        g_coro_indexes.add(index)
    }

    #if OS == "macos"
    fn arm_io_timeout(fd: FD, timeout_ms: uint) {
        this.io_wait_active = true
        this.io_wait_timed_out = false
        this.io_wait_fd = fd
        this.io_deadline_ms = 0
        if timeout_ms == 0 : return
        this.io_deadline_ms = mac_mstime() + timeout_ms
        io_timeout_coros.append(this)
    }

    fn disarm_io_timeout() {
        if this.io_deadline_ms == 0 : return
        this.io_deadline_ms = 0
        io_timeout_coros.remove_value(this)
    }
    #elif OS == "win"
    fn arm_io_timeout(fd: FD, overlap: ptr, timeout_ms: uint) {
        this.io_timed_out = false
        if timeout_ms == 0 : return
        this.io_timeout_fd = fd
        this.io_timeout_overlap = overlap
        this.io_deadline_ms = ext.GetTickCount64() + timeout_ms
        io_timeout_coros.append(this)
    }

    fn disarm_io_timeout() {
        if this.io_deadline_ms != 0 {
            this.io_deadline_ms = 0
            io_timeout_coros.remove_value(this)
        }
        this.io_timeout_overlap = null
    }
    #end
    //
    started: bool (false)
    active: bool (false)
    freed: bool (false)
    done: bool (false)

    static fn new(handler: fn()(), start_func: ptr, args_size: uint) SELF {
        #if OS != "win"
        let stack_allocation = stack_alloc()
        #end
        let coro = Coro {
            args: mem.alloc(args_size)
            #if OS != "win"
            stack_allocation: stack_allocation
            #end
            //
            start_func: start_func.@cast(fnptr()())
            handler: handler
        }

        #if OS == "win"
        ensure_main_fiber()
        coro.fiber = ext.CreateFiberEx(
            STACK_INITIAL_SIZE,
            STACK_SIZE,
            ext.FIBER_FLAG_FLOAT_SWITCH,
            win_coro_entry.@cast(ptr),
            coro.@cast(ptr)
        )
        if !isset(coro.fiber) : panic("Failed to allocate coroutine stack")
        #end

        let indexes = g_coro_indexes
        if indexes.count == 0 {
            let index = g_coros.length
            g_coros.append(coro)
            g_coro_gens.append(0)
            coro.g_list_index = index
        } else {
            let index = indexes.get() !? 0
            g_coros.set(index, coro) _
            coro.g_list_index = index
        }

        run_coros.append(coro)

        g_coro_count++

        return coro
    }

    fn gc_free() {
        this.free_stacks()
        mem.free(this.args)
    }

    #if OS == "win"
    // Hand out an overlap that the kernel is done with. A slot is only free
    // once its completion packet was dequeued, so an overlap can never be
    // reused while an operation still points at it; if both slots are busy we
    // fall back to a fresh one.
    fn take_overlap() io.Overlap {
        let a = this.overlap_a
        if !isset(a) {
            a = io.Overlap {}
            this.overlap_a = a
            return a
        }
        if !a.base.in_use : return a

        let b = this.overlap_b
        if !isset(b) {
            b = io.Overlap {}
            this.overlap_b = b
            return b
        }
        if !b.base.in_use : return b

        return io.Overlap {}
    }
    #end

    fn free_stacks() {
        if this.freed : return
        this.freed = true
        #if OS == "win"
        let fiber = this.fiber
        if isset(fiber) {
            this.fiber = null
            ext.DeleteFiber(fiber)
        }
        #else
        stack_free(this.stack_allocation)
        #end
    }

    #if OS != "win"
    fn init_stack(base: ptr) {
        #if ARCH == "x64"
        let return_addr_space = 2 * size_of(ptr)
        let regs = 6
        #elif ARCH == "arm64"
        let return_addr_space = size_of(ptr)
        let regs = 19
        #else
        #error "Unsupported OS: coroutines"
        #end

        let stack_start = base - (regs * size_of(ptr)) - return_addr_space
        // Make sure stack is 16 byte aligned (ptr size)
        let misalignment: uint = stack_start & 0xF
        stack_start -= misalignment

        mem.clear(stack_start, regs * size_of(ptr))

        @ptrv(stack_start, ptr, regs) = this.start_func.@cast(ptr)
        this.state.rsp = stack_start
    }
    #end

    //////////////
    // AWAIT
    //////////////

    fn await_coro(coro: Coro) {
        if coro.done : return
        let ob = coro
        let ref = ob.follow_up
        while isset(ref) {
            ob = ref
            ref = ref.follow_up
        }
        ob.follow_up = this
        this.yield()
    }

    fn sleep(ns: uint) {
        #if OS == "linux"
        let sqe = io.sqe(this) ! panic("Failed to schedule coroutine sleep")
        let nsec = ns.to(int)
        this.timeout_ts = {
            tv_sec: nsec / 1_000_000_000
            tv_nsec: (nsec % 1_000_000_000)
        }
        io.io_uring_prep_timeout(sqe, &this.timeout_ts, 0, 0)

        #elif OS == "macos"
        let ms = ns.to(i64) / 1_000_000
        let ev: ext.kEvent = @undefined
        this.arm_kernel_event()
        io.EV_SET(&ev, timer_id++, io.EVFILT_TIMER, io.EV_ADD | io.EV_ENABLE | io.EV_ONESHOT, 0, ms, this.event_id().@cast(ptr))
        let kq = io.kqueue()
        if !io.kqueue_change(kq, &ev) {
            this.disarm_kernel_event()
            panic("Failed to schedule coroutine sleep")
        }

        #else
        let delay_ms = (ns.to(u64) + 999_999) / 1_000_000
        this.sleep_deadline_ms = ext.GetTickCount64() + delay_ms
        sleep_coros.append(this)
        #end
        this.yield()
        #if OS == "win"
        this.sleep_deadline_ms = 0
        #end
    }

    fn await_last() {
        run_coros.append(this)
        this.yield()
    }

    //////////////
    // FLOW
    //////////////

    fn yield() $undefined {
        #if OS == "win"
        let fiber = main_fiber
        if !isset(fiber) : panic("Coroutine thread is not a fiber")
        SELF.switch_fiber(fiber)
        #else
        SELF.swap(&this.state, &main_state)
        #end
    }

    #if OS == "win"
    static fn switch_fiber(to: ptr) $suspend $undefined {
        ext.SwitchToFiber(to)
    }
    #else
    static fn swap(from: ptr, to: ptr) $suspend $undefined {
        ext.valk_stack_swap(from, to)
    }
    #end

    fn resume() $undefined {
        if this.done : return

        current_coro = this

        gc_stack_sp_backup = gc_stack_sp
        this.active = true

        #if OS == "win"
        if !this.started : this.started = true
        gc_stack_sp = this.backup_gc_sp
        let fiber = this.fiber
        if !isset(fiber) : panic("Coroutine fiber was released before completion")
        SELF.switch_fiber(fiber)
        #else
        let sp = this.stack_allocation + STACK_ALLOC_SIZE - size_of(ptr)
        if this.started {
            gc_stack_sp = this.backup_gc_sp
        } else {
            // Init stack
            gc_stack_sp = null
            this.init_stack(sp)
            this.started = true
        }

        // Swap
        SELF.swap(&main_state, &this.state)
        #end

        // Restore backup
        if !this.done {
            this.backup_gc_sp = gc_stack_sp
        }

        // Restore the scheduler's GC context.
        this.active = false
        gc_stack_sp = gc_stack_sp_backup
        current_coro = null

        if this.done {
            // Clean up
            this.free_stacks()

            // Next
            let next = this.follow_up
            if isset(next) {
                this.follow_up = null
                run_coros.append(next)
            }
        }
    }

    fn complete() {
        this.done = true
        this.handler = fn() {}
        current_coro = null
        g_coro_count--
        #if OS != "win"
        if this.kernel_event_count == 0 : this.release_global_root()
        #else
        this.release_global_root()
        #end

        this.yield()
    }

    //////////////
    // LOOP
    //////////////

    static fn loop(until: ?Coro (null)) {
        // Done check
        if isset(until) && until.done : return

        #if OS == "linux"
        let ring = io.uring()
        #elif OS == "macos"
        let kq = io.kqueue()
        #elif OS == "win"
        let cport = io.iocp()
        #end

        while true {
            let scheduled_coros = run_coros
            run_coros = next_run_coros
            next_run_coros = scheduled_coros
            run_coros.clear()

            each scheduled_coros as coro {
                coro.resume()
            }
            scheduled_coros.clear()

            // Done check
            if isset(until) && until.done : break

            // Wait for poll coros
            #if OS == "linux"
            if io.uring_unsubmitted > 0 : io.uring_submit(ring)
            #end

            gc.collect_if_threshold_almost_reached()
            #if OS == "linux"
            while true {
                let cqe: ?*ext.io_uring_cqe = null
                if run_coros.length == 0 {
                    gc.unlock()
                    io.io_uring_wait_cqe(ring, &cqe)
                    gc.lock()
                } else {
                    io.io_uring_peek_cqe(ring, &cqe)
                }
                if !isset(cqe) {
                    break
                }
                //
                let user_data = cqe.user_data
                let timeout_tag = user_data & 3
                let coro = take_kernel_event(user_data.to(uint))
                if !isset(coro) {
                    io.io_uring_cqe_seen(ring, cqe)
                    continue
                }
                // Read `done` before disarming: the last event may release the
                // global root, and no field is touched after that.
                let done = coro.done
                coro.disarm_kernel_event()
                if done {
                    io.io_uring_cqe_seen(ring, cqe)
                    continue
                }
                if timeout_tag == 1 {
                    if !coro.timed_io_active {
                        io.io_uring_cqe_seen(ring, cqe)
                        continue
                    }
                    if cqe.res == 0 - ext.ETIME {
                        coro.timed_io_active = false
                        coro.poll_event = io.POLL_TIMEOUT
                        coro.completion_res = 0 - ext.ETIMEDOUT
                        run_coros.append(coro)
                    } else if cqe.res == 0 - ext.ECANCELED {
                        if coro.timed_io_cancel_pending {
                            coro.timed_io_active = false
                            coro.completion_res = 0 - ext.ECANCELED
                            run_coros.append(coro)
                        } else {
                            coro.timed_io_timeout_canceled = true
                        }
                    }
                } else if timeout_tag == 2 {
                    if coro.timed_io_active {
                        if cqe.res == 0 - ext.ECANCELED && !coro.timed_io_timeout_canceled {
                            coro.timed_io_cancel_pending = true
                        } else {
                            coro.timed_io_active = false
                            coro.poll_event = cqe.res.@cast(io.PollEvent)
                            coro.completion_res = cqe.res
                            run_coros.append(coro)
                        }
                    }
                } else {
                    run_coros.append(coro)
                    coro.poll_event = cqe.res.@cast(io.PollEvent)
                    coro.completion_res = cqe.res
                }
                io.io_uring_cqe_seen(ring, cqe)
            }
            #elif OS == "macos"
            let events: [ext.kEvent x 64] = @undefined
            gc.unlock()
            let timeout: ?*ext.libc_gen_timespec = null
            if run_coros.length > 0 {
                let t: ext.libc_timespec = { tv_sec: 0, tv_nsec: 0 }
                timeout = @ref(t)
            } else {
                let has_timeout, wait_ms = mac_io_timeout()
                if has_timeout {
                    let t: ext.libc_timespec = {
                        tv_sec: (wait_ms / 1000).to(int)
                        tv_nsec: ((wait_ms % 1000) * 1_000_000).to(int)
                    }
                    timeout = @ref(t)
                }
            }
            let nevents = ext.kevent(kq, null, 0, @ref(events[0]), 64, timeout)
            gc.lock()
            if nevents < 0 && ext.get_errno() != ext.EINTR : panic("Coroutine event wait failed")
            while nevents-- > 0 {
                let ev = events[nevents]
                let coro = take_kernel_event(ev.udata.@cast(uint))
                if !isset(coro) : continue
                // Read `done` before disarming, see the linux loop
                let done = coro.done
                coro.disarm_kernel_event()
                if done : continue
                if ev.filter == io.EVFILT_READ || ev.filter == io.EVFILT_WRITE {
                    if !coro.io_wait_active || ev.ident != coro.io_wait_fd : continue
                    coro.disarm_io_timeout()
                    coro.io_wait_active = false
                    coro.io_wait_timed_out = false
                    if ev.filter == io.EVFILT_READ {
                        coro.poll_event = ext.POLLIN
                        coro.completion_res = ev.data
                        if (ev.flags & io.EV_EOF) == io.EV_EOF : coro.poll_event = coro.poll_event | ext.POLLHUP
                    } else if ev.filter == io.EVFILT_WRITE {
                        coro.poll_event = ext.POLLOUT
                        coro.completion_res = ev.data
                        if (ev.flags & io.EV_EOF) == io.EV_EOF : coro.poll_event = coro.poll_event | ext.POLLHUP
                    }
                } else {
                    if ev.filter != io.EVFILT_TIMER : continue
                }
                run_coros.append(coro)
            }
            mac_wake_io_timeouts()

            #elif OS == "win"
            win_wake_sleepers()
            win_cancel_io_timeouts()
            let first = run_coros.length == 0
            let wait_ms = first ? win_next_timeout() : 0

            let bytes: u32 = 0
            let key: uint = 0
            let ov: ?io.Overlap = null
            let result: ext.BOOL = 0
            if wait_ms == 0 {
                result = ext.GetQueuedCompletionStatus(cport.@cast(ptr), @ref(bytes), @ref(key), @ref(ov), 0)
            } else {
                gc.unlock()
                result = ext.GetQueuedCompletionStatus(cport.@cast(ptr), @ref(bytes), @ref(key), @ref(ov), wait_ms)
                gc.lock()
            }

            while true {
                if !isset(ov) {
                    // A packet without an overlap carries the coroutine in its
                    // completion key, see io.wake_coro()
                    if result == 0 || key == 0 {
                        if result == 0 && ext.GetLastError() != ext.WAIT_TIMEOUT {
                            panic("GetQueuedCompletionStatus failed")
                        }
                        break
                    }
                    let coro = key.@cast(Coro)
                    if !coro.iocp_ready {
                        coro.iocp_ready = true
                        run_coros.append(coro)
                    }
                } else {
                    let coro = ov.base.coro.@cast(Coro)
                    ov.base.completed = true
                    // The kernel is done with it, so the slot can be reused
                    ov.base.in_use = false
                    coro.completion_res = bytes
                    if !ov.base.cancel_requested {
                        coro.poll_event = coro.poll_event | io.completion_event(ov, result != 0)
                    }
                    if !coro.iocp_ready {
                        coro.iocp_ready = true
                        run_coros.append(coro)
                    }
                }

                bytes = 0
                key = 0
                ov = null
                result = ext.GetQueuedCompletionStatus(cport.@cast(ptr), @ref(bytes), @ref(key), @ref(ov), 0)
            }

            #else
            panic("Unsupported OS for: coroutine loop")
            #end
        }
    }
}

#if OS != "win"
fn take_kernel_event(tagged_id: uint) ?Coro {
    let index = (tagged_id >> 2) & 0xFFFFFFFF
    let coro = g_coros.get(index) !? null
    if !isset(coro) : return null
    // Generation check: rejects stale ids of a disarmed/released coroutine and
    // of a new coroutine that reused this slot
    if coro.event_id() != (tagged_id & (~3).to(uint)) : return null
    return coro
}

#if TEST
+ fn kernel_event_lifetime_for_test() bool {
    let completed = Coro {
        args: mem.alloc(0)
        start_func: kernel_event_test_noop
        handler: fn() {}
        freed: true
        done: true
    }
    let index = g_coros.length
    completed.g_list_index = index
    g_coros.append(completed)
    g_coro_gens.append(0)
    completed.arm_kernel_event()
    completed.arm_kernel_event()

    let first_id = completed.event_id() | 1
    if take_kernel_event(first_id) != completed : return false
    completed.disarm_kernel_event()
    if completed.kernel_event_count != 1 : return false
    if !isset(g_coros.get(index) !? null) : return false

    let second_id = completed.event_id() | 2
    if take_kernel_event(second_id) != completed : return false
    completed.disarm_kernel_event()
    if completed.kernel_event_count != 0 : return false
    // Fully disarmed + done: the root must be released and the ids invalidated
    if isset(g_coros.get(index) !? null) : return false
    if !completed.g_root_released : return false
    return !isset(take_kernel_event(first_id)) && !isset(take_kernel_event(second_id))
}

fn kernel_event_test_noop() {}
#end
#end

#if OS == "macos"
fn mac_mstime() uint {
    let tv: ext.libc_timeval = @undefined
    if ext.gettimeofday(@ref(tv), null) != 0 : panic("Failed to read system time")
    return tv.tv_sec.to(uint) * 1000 + tv.tv_usec.to(uint) / 1000
}

fn mac_io_timeout() (bool, uint) {
    if io_timeout_coros.length == 0 : return (false, 0)
    let now = mac_mstime()
    let nearest: uint = 0
    each io_timeout_coros as coro {
        let deadline = coro.io_deadline_ms
        if deadline == 0 : continue
        if deadline <= now : return (true, 0)
        if nearest == 0 || deadline < nearest : nearest = deadline
    }
    if nearest == 0 : return (false, 0)
    return (true, nearest - now)
}

fn mac_wake_io_timeouts() {
    let now = mac_mstime()
    let i: uint = 0
    while i < io_timeout_coros.length {
        let coro = io_timeout_coros.get(i) !? null
        if !isset(coro) || !coro.io_wait_active || coro.io_deadline_ms == 0 {
            io_timeout_coros.remove(i)
            continue
        }
        if coro.io_deadline_ms > now {
            i++
            continue
        }
        io_timeout_coros.remove(i)
        coro.io_deadline_ms = 0
        coro.io_wait_active = false
        coro.io_wait_timed_out = true
        coro.poll_event = io.POLL_TIMEOUT
        coro.completion_res = 0 - ext.ETIMEDOUT
        run_coros.append(coro)
    }
}
#end

#if OS == "win"
fn ensure_main_fiber() {
    if isset(main_fiber) : return
    main_fiber = ext.ConvertThreadToFiberEx(null, ext.FIBER_FLAG_FLOAT_SWITCH)
    if !isset(main_fiber) : panic("Failed to initialize coroutine thread fiber")
}

fn win_coro_entry(value: ptr) {
    let coro = value.@cast(Coro)
    coro.start_func()
    panic("Coroutine entry returned without completing")
}

fn win_wake_sleepers() {
    let now = ext.GetTickCount64()
    let i: uint = 0
    while i < sleep_coros.length {
        let coro = sleep_coros.get(i) !? null
        if !isset(coro) {
            sleep_coros.remove(i)
            continue
        }
        if coro.done || coro.sleep_deadline_ms <= now {
            sleep_coros.remove(i)
            if !coro.done : run_coros.append(coro)
            continue
        }
        i++
    }
}

fn win_sleep_timeout() u32 {
    if sleep_coros.length == 0 : return ext.INFINITE
    let now = ext.GetTickCount64()
    let nearest: u64 = 0
    each sleep_coros as coro {
        if coro.done : continue
        if coro.sleep_deadline_ms <= now : return 0
        if nearest == 0 || coro.sleep_deadline_ms < nearest : nearest = coro.sleep_deadline_ms
    }
    if nearest == 0 : return ext.INFINITE
    let delay = nearest - now
    if delay > 0xffffffff : return 0xffffffff
    return delay.to(u32)
}

fn win_io_timeout() u32 {
    if io_timeout_coros.length == 0 : return ext.INFINITE
    let now = ext.GetTickCount64()
    let nearest: u64 = 0
    each io_timeout_coros as coro {
        let deadline = coro.io_deadline_ms
        if deadline == 0 : continue
        if deadline <= now : return 0
        if nearest == 0 || deadline < nearest : nearest = deadline
    }
    if nearest == 0 : return ext.INFINITE
    let delay = nearest - now
    if delay > 0xffffffff : return 0xffffffff
    return delay.to(u32)
}

fn win_next_timeout() u32 {
    let sleep_timeout = win_sleep_timeout()
    let io_timeout = win_io_timeout()
    return sleep_timeout < io_timeout ? sleep_timeout : io_timeout
}

fn win_cancel_io_timeouts() {
    let now = ext.GetTickCount64()
    let i: uint = 0
    while i < io_timeout_coros.length {
        let coro = io_timeout_coros.get(i) !? null
        if !isset(coro) || coro.done || coro.io_deadline_ms == 0 {
            io_timeout_coros.remove(i)
            continue
        }
        if coro.io_deadline_ms > now {
            i++
            continue
        }
        io_timeout_coros.remove(i)
        coro.io_deadline_ms = 0
        coro.io_timed_out = true
        let overlap = coro.io_timeout_overlap
        if isset(overlap) && ext.CancelIoEx(coro.io_timeout_fd, overlap) == 0 && ext.GetLastError() != ext.ERROR_NOT_FOUND {
            panic("Failed to cancel timed out I/O")
        }
    }
}
#end

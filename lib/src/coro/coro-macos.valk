// macOS coroutine backend: kqueue. I/O waits and timeouts are both kernel
// events (EVFILT_READ/WRITE + oneshot EVFILT_TIMER), so the event wait blocks
// until the kernel reports an event.

#if OS == "macos"

use ext
use io
use gc

global timer_id: uint

extend Coro {
    io_wait_active: bool (false)
    io_wait_timed_out: bool (false)
    io_wait_fd: Fd
    io_wait_event_id: uint (0)
    io_timer_ident: uint (0)
    io_wait_read_armed: bool (false)
    io_wait_write_armed: bool (false)
    io_wait_timer_armed: bool (false)

    fn sleep(ns: uint) {
        @unsafe
        let ms = ns.to(i64) / 1_000_000
        let ev: ext.kEvent = @undefined
        this.arm_kernel_event()
        io.EV_SET(&ev, timer_id++, io.EVFILT_TIMER, io.EV_ADD | io.EV_ENABLE | io.EV_ONESHOT, 0, ms, this.event_id().@cast(ptr))
        let kq = io.kqueue()
        if !io.kqueue_change(kq, &ev) {
            this.disarm_kernel_event()
            panic("Failed to schedule coroutine sleep")
        }
        this.yield()
    }

    // Dequeue one batch of kqueue events and wake their coroutines.
    static fn wait_for_events() {
        let kq = io.kqueue()
        let events: [ext.kEvent x 64] = @undefined
        gc.unlock()
        let timeout: ?*ext.libc_gen_timespec = null
        if run_coros.length > 0 {
            let t: ext.libc_timespec = { tv_sec: 0, tv_nsec: 0 }
            timeout = @ref(t)
        }
        let nevents = ext.kevent(kq, null, 0, @ref(events[0]), 64, timeout)
        gc.lock()
        if nevents < 0 && ext.get_errno() != ext.EINTR : panic("Coroutine event wait failed")
        while nevents-- > 0 {
            let ev = events[nevents]
            let coro = take_kernel_event(ev.udata.@cast(uint))
            if !isset(coro) : continue
            // Read `done` before disarming, see the linux backend
            let done = coro.done
            if ev.filter == io.EVFILT_READ || ev.filter == io.EVFILT_WRITE {
                if ev.ident != coro.io_wait_fd : continue
                if ev.filter == io.EVFILT_READ {
                    if !coro.io_wait_read_armed : continue
                    coro.io_wait_read_armed = false
                } else if ev.filter == io.EVFILT_WRITE {
                    if !coro.io_wait_write_armed : continue
                    coro.io_wait_write_armed = false
                }
                io.kqueue_delete_wait(kq, coro.io_wait_fd, ev.filter, ev.udata.@cast(uint))
                coro.disarm_kernel_event()
                if done : continue
                coro.completion_res = ev.data
                if (ev.flags & (io.EV_VANISHED | io.EV_ERROR)) != 0 {
                    coro.poll_event = coro.poll_event | ext.POLLHUP | ext.POLLERR
                } else {
                    coro.poll_event = coro.poll_event | (ev.filter == io.EVFILT_READ ? ext.POLLIN : ext.POLLOUT)
                    if (ev.flags & io.EV_EOF) != 0 : coro.poll_event = coro.poll_event | ext.POLLHUP
                }
                // A second fd filter can be returned in this same batch. It
                // still contributes readiness, but only the first event wakes
                // the coroutine.
                if !coro.io_wait_active : continue
                coro.io_wait_active = false
            } else if ev.filter == io.EVFILT_TIMER {
                coro.disarm_kernel_event()
                if done : continue
                if (ev.udata.@cast(uint) & 1) == 1 {
                    if !coro.io_wait_timer_armed : continue
                    coro.io_wait_timer_armed = false
                    // Timed-out I/O wait; the fd event was deleted by the
                    // coroutine when it resumes
                    if !coro.io_wait_active : continue
                    coro.io_wait_active = false
                    coro.io_wait_timed_out = true
                    coro.poll_event = io.POLL_TIMEOUT
                    coro.completion_res = 0 - ext.ETIMEDOUT
                }
                // Tag 0 is a plain sleep timer wake
            } else {
                continue
            }
            run_coros.append(coro)
        }
    }
}

#end

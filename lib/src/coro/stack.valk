use ext
use core

value STACK_SIZE (1024 * 1024)
// The program's main coroutine gets the size a native main thread would have
+ value MAIN_STACK_SIZE (8 * 1024 * 1024)
value STACK_INITIAL_SIZE (32 * 1024)
// 16 KiB covers the largest page size used by the supported targets.
value STACK_GUARD_SIZE (16 * 1024)

// Stack size of the next coroutine when set; consumed by Coro.new
+ global next_stack_size: uint (0)

#if OS != "win"
value ALT_STACK_SIZE (64 * 1024)
value STACK_FAULT_MARGIN (64 * 1024)

// Lowest address of this thread's native stack
global thread_stack_low: uint (0)

fn map_anonymous() i32 {
    #if OS == "linux"
    return 0x20
    #else
    return 0x1000
    #end
}

// Installs the alternate signal stack of this thread and, once, the fault
// handler that reports a stack overflow instead of crashing
+ fn stack_guard_init(is_main: bool, stack_low: uint) {
    @unsafe
    thread_stack_low = stack_low
    let alt = ext.mmap(null, ALT_STACK_SIZE, 0x1 | 0x2, 0x2 | map_anonymous(), -1, 0)
    let alt_address: uint = alt
    if alt_address + 1 == 0 : return
    let alt_stack = ext.stack_t { sp: alt, size: ALT_STACK_SIZE }
    if ext.sigaltstack(@ref(alt_stack), null) != 0 : return
    if !is_main : return
    let action = ext.sigaction_t {
        handler: stack_fault_handler.@cast(ptr)
        flags: ext.SA_SIGINFO | ext.SA_ONSTACK | ext.SA_NODEFER
    }
    ext.sigaction(ext.SIGSEGV, @ref(action), null)
    ext.sigaction(ext.SIGBUS, @ref(action), null)
}

fn stack_fault_handler(sig: i32, info: ptr, context: ptr) {
    @unsafe
    // si_addr: offset 16 in the linux siginfo_t, 24 on macOS
    #if OS == "linux"
    let address: uint = @ptrv(info, uint, 2)
    #else
    let address: uint = @ptrv(info, uint, 3)
    #end
    if stack_fault_is_overflow(address) {
        let msg = "Stack overflow\n"
        core.cleanup_warning_write(msg.data, msg.length)
        ext._exit(1)
    }
    // Any other fault: restore the default action, the retry then ends the process normally
    let default_action = ext.sigaction_t { handler: null.@cast(ptr) }
    ext.sigaction(sig, @ref(default_action), null)
}

fn stack_fault_is_overflow(address: uint) bool {
    let coro = current_coro
    if isset(coro) {
        let base: uint = coro.stack_allocation
        if address >= base - STACK_FAULT_MARGIN && address < base + STACK_GUARD_SIZE : return true
    }
    let low = thread_stack_low
    if low == 0 : return false
    return address >= low - STACK_FAULT_MARGIN && address < low + STACK_GUARD_SIZE
}

// `size` includes the guard page; pages are committed lazily
@unsafe
fn stack_alloc(size: uint) ptr {
    let allocation = ext.mmap(null, size, 0x1 | 0x2, 0x2 | map_anonymous(), -1, 0)
    let allocation_address: uint = allocation
    if allocation_address + 1 == 0 : panic("Failed to allocate coroutine stack")
    if ext.mprotect(allocation, STACK_GUARD_SIZE, 0) != 0 {
        ext.munmap(allocation, size)
        panic("Failed to protect coroutine stack")
    }
    return allocation
}

fn stack_free(allocation: ptr, size: uint) {
    if ext.munmap(allocation, size) != 0 {
        panic("Failed to release coroutine stack")
    }
}
#end

#if OS == "win"
value EXCEPTION_STACK_OVERFLOW (0xC00000FD)

// Reports a stack overflow instead of the silent crash exit code
+ fn stack_guard_init(is_main: bool, stack_low: uint) {
    @unsafe
    // Room for the handler to run on this thread's stack after an overflow
    let guarantee: u32 = 64 * 1024
    ext.SetThreadStackGuarantee(@ref(guarantee))
    if !is_main : return
    ext.AddVectoredExceptionHandler(1, stack_fault_handler.@cast(ptr))
}

fn stack_fault_handler(info: ptr) i32 {
    @unsafe
    let record: ptr = @ptrv(info, ptr, 0)
    let code: u32 = @ptrv(record, u32, 0)
    if code == EXCEPTION_STACK_OVERFLOW {
        let msg = "Stack overflow\n"
        core.cleanup_warning_write(msg.data, msg.length)
        ext._exit(1)
    }
    // EXCEPTION_CONTINUE_SEARCH
    return 0
}
#end

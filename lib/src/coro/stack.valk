
use ext

value STACK_SIZE (1024 * 1024)
value STACK_INITIAL_SIZE (32 * 1024)
// 16 KiB covers the largest page size used by the supported targets.
value STACK_GUARD_SIZE (16 * 1024)
value STACK_ALLOC_SIZE (STACK_SIZE + STACK_GUARD_SIZE)

#if OS != "win"
fn stack_alloc() ptr {
    let map_anonymous: i32 = 0
    #if OS == "linux"
    map_anonymous = 0x20
    #else
    map_anonymous = 0x1000
    #end
    let allocation = ext.mmap(null, STACK_ALLOC_SIZE, 0x1 | 0x2, 0x2 | map_anonymous, -1, 0)
    let allocation_address: uint = allocation
    if allocation_address + 1 == 0 : panic("Failed to allocate coroutine stack")
    if ext.mprotect(allocation, STACK_GUARD_SIZE, 0) != 0 {
        ext.munmap(allocation, STACK_ALLOC_SIZE)
        panic("Failed to protect coroutine stack")
    }
    return allocation
}

fn stack_free(allocation: ptr) {
    if ext.munmap(allocation, STACK_ALLOC_SIZE) != 0 {
        panic("Failed to release coroutine stack")
    }
}
#end

// GC stack
global gc_stack_sp : ?ptr (@undefined)
// Backup
global gc_stack_sp_backup : ?ptr (@undefined)

use core

// Pattern syntax tree. `NodeKind` is stored as a number in `Node.kind`

value NODE_EMPTY (0)
value NODE_CHAR (1)
value NODE_SET (2)
value NODE_ANY (3)
value NODE_CONCAT (4)
value NODE_ALT (5)
value NODE_REPEAT (6)
value NODE_GROUP (7)
value NODE_ASSERT (8)

value ASSERT_LINE_START (0)
value ASSERT_LINE_END (1)
value ASSERT_TEXT_START (2)
value ASSERT_TEXT_END (3)
value ASSERT_WORD (4)
value ASSERT_NOT_WORD (5)

value FLAG_CASELESS (1)
value FLAG_MULTILINE (2)
value FLAG_DOTALL (4)

value REPEAT_UNBOUNDED (uint.$max)
value REPEAT_LIMIT (1000)

class Node {
    kind: uint
    // NODE_CHAR: the code point; NODE_ASSERT: the assertion; NODE_ANY: flags
    code: u32 (0)
    assert: uint (0)
    set: ?CharSet (null)
    children: Array[Node] (.{})
    // NODE_REPEAT
    min: uint (0)
    max: uint (0)
    greedy: bool (true)
    // NODE_GROUP: capture index, 0 = not capturing
    group: uint (0)
    // Flags in effect where this node was parsed (for `i` on chars and sets)
    flags: uint (0)
}

// A set of code points as sorted, merged inclusive ranges plus an ASCII
// lookup table; `negated` inverts the test
class CharSet {
    ranges: Array[u32] (.{})
    negated: bool (false)
    ascii: [u8 x 128] ({ 0... })

    fn add(low: u32, high: u32) {
        this.ranges.append(low)
        this.ranges.append(high)
    }

    fn add_set(other: CharSet) {
        let i: uint = 0
        while i < other.ranges.length {
            this.add(other.ranges[i], other.ranges[i + 1])
            i += 2
        }
    }

    // Sorts and merges the ranges and fills the ASCII table
    fn finish() {
        let count = this.ranges.length / 2
        // Insertion sort on pairs; sets are small
        let i: uint = 1
        while i < count {
            let low = this.ranges[i * 2]
            let high = this.ranges[i * 2 + 1]
            let j = i
            while j > 0 && this.ranges[(j - 1) * 2] > low {
                this.ranges[j * 2] = this.ranges[(j - 1) * 2]
                this.ranges[j * 2 + 1] = this.ranges[(j - 1) * 2 + 1]
                j--
            }
            this.ranges[j * 2] = low
            this.ranges[j * 2 + 1] = high
            i++
        }
        let merged = Array[u32]{}
        i = 0
        while i < count {
            let low = this.ranges[i * 2]
            let high = this.ranges[i * 2 + 1]
            if merged.length > 0 && merged[merged.length - 1] + 1 >= low {
                if high > merged[merged.length - 1] : merged[merged.length - 1] = high
            } else {
                merged.append(low)
                merged.append(high)
            }
            i++
        }
        this.ranges = merged
        let c: u32 = 0
        while c < 128 {
            this.ascii[c.to(uint)] = this.in_ranges(c) != this.negated ? 1 : 0
            c++
        }
    }

    fn in_ranges(code: u32) bool {
        let ranges = this.ranges
        let low: uint = 0
        let high = ranges.length / 2
        while low < high {
            let mid = (low + high) / 2
            if code < ranges[mid * 2] : high = mid
            else if code > ranges[mid * 2 + 1] : low = mid + 1
            else : return true
        }
        return false
    }

    fn has(code: u32) bool $inline {
        if code < 128 : return this.ascii[code.to(uint)] == 1
        return this.in_ranges(code) != this.negated
    }
}

use core
use mem

// Pike VM: runs every thread of the NFA in lock step over the input, so the
// time is bounded by (input length × program length) whatever the pattern.
// Threads are ordered by priority, which gives leftmost-first (Perl-style)
// match selection

value SLOT_UNSET (uint.$max)

class ThreadList {
    // Program counters of the live threads, in priority order
    pcs: Array[uint]
    threads: uint (0)
    // Capture slots of every thread, `slots` values per thread
    caps: Array[uint]
    // Sparse set of program counters visited in this step
    dense: Array[uint]
    sparse: Array[uint]
    count: uint (0)

    static fn new(program_length: uint, slots: uint) SELF {
        return SELF {
            pcs: Array[uint]{ 0 x program_length }
            caps: Array[uint]{ SLOT_UNSET x (program_length * slots) }
            dense: Array[uint]{ 0 x program_length }
            sparse: Array[uint]{ 0 x program_length }
        }
    }

    fn clear() $inline {
        this.count = 0
        this.threads = 0
    }

    fn contains(pc: uint) bool $inline {
        let i = this.sparse[pc]
        return i < this.count && this.dense[i] == pc
    }

    fn add(pc: uint) $inline {
        this.sparse[pc] = this.count
        this.dense[this.count] = pc
        this.count++
    }
}

// Closure stack entries: a program counter, or `RESTORE_BIT | slot`
// preceded by the value to put back
value RESTORE_BIT (1 << 62)
// Most visited bits the backtracker allocates: program length × span length
value BACKTRACK_BITS_MAX (1 << 18)

class Vm {
    program: Array[Inst]
    slots: uint
    text: String
    multiline: bool
    current: ThreadList
    next: ThreadList
    scratch: Array[uint]
    stack: Array[uint]
    matched: bool (false)
    result: Array[uint]
    // Bytes that can begin a match; empty when every byte can
    first: Array[u8]
    // Backtracker state: visited (pc, position) bits and its own stack
    visited: Array[uint] (.{})
    bt_stack: Array[uint] (.{})

    static fn new(program: Array[Inst], slots: uint) SELF {
        return SELF {
            program: program
            slots: slots
            text: ""
            multiline: false
            current: ThreadList.new(program.length, slots)
            next: ThreadList.new(program.length, slots)
            stack: Array[uint]{ 0 x (program.length * 3 + 8) }
            scratch: Array[uint]{ SLOT_UNSET x slots }
            result: Array[uint]{ SLOT_UNSET x slots }
            first: first_bytes(program)
        }
    }

    // Searches `text` from `start`; `anchored` only allows a match at
    // `start`; `prefix` (when set) must begin every match. Returns the
    // capture slots or null
    fn exec(text: String, start: uint, anchored: bool, prefix: ?String) ?Array[uint] {
        this.text = text
        this.matched = false
        this.current.clear()
        this.next.clear()
        let length = text.bytes
        let pos = start
        if isset(prefix) && !anchored {
            pos = text.index_of(prefix, pos) ! return null
        }
        while true {
            // No thread survived: the visited set is stale, reset it
            if this.current.threads == 0 : this.current.clear()
            if !this.matched && (!anchored || pos == start) {
                if this.current.threads == 0 && !anchored && pos > start {
                    // Nothing alive: jump to the next possible start
                    if isset(prefix) {
                        let found = text.index_of(prefix, pos) ! return null
                        pos = found
                    } else if this.first.length > 0 {
                        let first = this.first
                        while pos < length && first[text[pos].to(uint)] == 0 : pos++
                    }
                }
                let i: uint = 0
                while i < this.slots {
                    this.scratch[i] = SLOT_UNSET
                    i++
                }
                this.add_thread(this.current, 0, pos)
            }
            if this.current.threads == 0 {
                if this.matched || anchored || pos >= length : break
                // A whole character: a match never starts inside one
                pos += char_width(text, pos)
                continue
            }
            let code: u32 = 0
            let width: uint = 0
            let at_end = pos >= length
            if !at_end {
                let byte = text[pos]
                if byte < 0x80 {
                    code = byte.to(u32)
                    width = 1
                } else {
                    let ch = core.unicode_read(text, pos)
                    code = ch.code
                    width = ch.count
                }
            }
            this.step(pos, at_end, code, width)
            let swap = this.current
            this.current = this.next
            this.next = swap
            this.next.clear()
            if at_end : break
            pos += width
        }
        if !this.matched : return null
        return this.result.copy()
    }

    fn step(pos: uint, at_end: bool, code: u32, width: uint) {
        let list = this.current
        let program = this.program
        let slots = this.slots
        let count = list.threads
        let t: uint = 0
        while t < count {
            let pc = list.pcs[t]
            let inst = program[pc]
            let op = inst.op
            if op == OP_MATCH {
                // Lower-priority threads are cut
                let i: uint = 0
                let base = t * slots
                while i < slots {
                    this.result[i] = list.caps[base + i]
                    i++
                }
                this.matched = true
                break
            }
            if at_end {
                t++
                continue
            }
            let ok = false
            if op == OP_CHAR : ok = code == inst.code
            else if op == OP_SET {
                let set = inst.set
                if isset(set) : ok = set.has(code)
            } else if op == OP_ANY : ok = code != 10
            else if op == OP_ANY_NL : ok = true
            if ok {
                let i: uint = 0
                let base = t * slots
                while i < slots {
                    this.scratch[i] = list.caps[base + i]
                    i++
                }
                this.add_thread(this.next, pc + 1, pos + width)
            }
            t++
        }
    }

    // Follows the epsilon closure from `pc` at `pos`, appending consuming
    // instructions to `list` with the captures in `scratch`
    fn add_thread(list: ThreadList, start_pc: uint, pos: uint) {
        let program = this.program
        let slots = this.slots
        // Fast path: a consuming instruction with nothing to follow
        let first = program[start_pc]
        if first.op < OP_SPLIT {
            if list.contains(start_pc) : return
            list.add(start_pc)
            this.push_thread(list, start_pc)
            return
        }
        let stack = this.stack
        let top: uint = 0
        stack[top++] = start_pc
        while top > 0 {
            let entry = stack[--top]
            if (entry & RESTORE_BIT) != 0 {
                this.scratch[entry & ~RESTORE_BIT] = stack[--top]
                continue
            }
            let pc = entry
            if list.contains(pc) : continue
            list.add(pc)
            let inst = program[pc]
            let op = inst.op
            if op == OP_JMP {
                stack[top++] = inst.x
            } else if op == OP_SPLIT {
                stack[top++] = inst.y
                stack[top++] = inst.x
            } else if op == OP_SAVE {
                stack[top++] = this.scratch[inst.x]
                stack[top++] = RESTORE_BIT | inst.x
                this.scratch[inst.x] = pos
                stack[top++] = pc + 1
            } else if op == OP_ASSERT {
                if this.check_assert(inst.x, pos) : stack[top++] = pc + 1
            } else {
                this.push_thread(list, pc)
            }
        }
    }

    fn push_thread(list: ThreadList, pc: uint) $inline {
        let index = list.threads
        list.pcs[index] = pc
        let base = index * this.slots
        let i: uint = 0
        while i < this.slots {
            list.caps[base + i] = this.scratch[i]
            i++
        }
        list.threads = index + 1
    }

    // Bounded backtracker for a match the DFAs located: finds the groups of
    // the leftmost-first match from `start` to `end`. Every (pc, position)
    // pair runs once, so the time is bounded like the VM's. Returns null when
    // the span is too large for the visited bits or the match found does not
    // end at `end`; the Pike VM decides then
    fn exec_span(text: String, start: uint, end: uint) ?Array[uint] {
        @unsafe
        let program = this.program
        let positions = end - start + 1
        let bits = program.length * positions
        if bits > BACKTRACK_BITS_MAX : return null
        let words = (bits + 63) / 64
        // Every visited pair pushes at most two entries, plus the first frame
        let depth = bits * 2 + 2
        if this.visited.length < words : this.visited = Array[uint]{ 0 x words }
        if this.bt_stack.length < depth : this.bt_stack = Array[uint]{ 0 x depth }
        let visited = this.visited.items()
        let stack = this.bt_stack.items()
        let scratch = this.scratch.items()
        let insts = program.items()
        let bytes = text.data
        mem.clear_bytes(visited.@cast(ptr), words * size_of(uint))
        let i: uint = 0
        while i < this.slots {
            scratch[i] = SLOT_UNSET
            i++
        }
        this.text = text
        let top: uint = 0
        stack[top++] = start
        stack[top++] = 0
        while top > 0 {
            let entry = stack[--top]
            if (entry & RESTORE_BIT) != 0 {
                scratch[entry & ~RESTORE_BIT] = stack[--top]
                continue
            }
            let pc = entry
            let pos = stack[--top]
            while true {
                let bit = pc * positions + (pos - start)
                let word = bit >> 6
                let mask = 1.to(uint) << (bit & 63)
                if (visited[word] & mask) != 0 : break
                visited[word] = visited[word] | mask
                let inst = insts[pc]
                let op = inst.op
                if op < OP_SPLIT {
                    if pos >= end : break
                    let byte = bytes[pos]
                    let code = byte.to(u32)
                    let width: uint = 1
                    if byte >= 0x80 {
                        let ch = core.unicode_read(text, pos)
                        code = ch.code
                        width = ch.count
                        if pos + width > end : break
                    }
                    let ok = false
                    if op == OP_CHAR : ok = code == inst.code
                    else if op == OP_SET {
                        let set = inst.set
                        if isset(set) : ok = set.has(code)
                    } else if op == OP_ANY : ok = code != 10
                    else : ok = true
                    if !ok : break
                    pos += width
                    pc++
                } else if op == OP_JMP {
                    pc = inst.x
                } else if op == OP_SPLIT {
                    stack[top++] = pos
                    stack[top++] = inst.y
                    pc = inst.x
                } else if op == OP_SAVE {
                    stack[top++] = scratch[inst.x]
                    stack[top++] = RESTORE_BIT | inst.x
                    scratch[inst.x] = pos
                    pc++
                } else if op == OP_ASSERT {
                    if !this.check_assert(inst.x, pos) : break
                    pc++
                } else {
                    if pos != end : return null
                    return this.scratch.copy()
                }
            }
        }
        return null
    }

    fn check_assert(kind: uint, pos: uint) bool {
        let text = this.text
        let length = text.bytes
        if kind == ASSERT_TEXT_START : return pos == 0
        if kind == ASSERT_TEXT_END : return pos == length
        if kind == ASSERT_LINE_START : return pos == 0 || text[pos - 1] == 10
        if kind == ASSERT_LINE_END : return pos == length || text[pos] == 10
        let before = pos > 0 && is_word_byte(text[pos - 1])
        let after = pos < length && is_word_byte(text[pos])
        let boundary = before != after
        if kind == ASSERT_WORD : return boundary
        return !boundary
    }
}

fn is_word_byte(b: u8) bool $inline {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_'
}


// The table of bytes that can start a match, or an empty array when the
// pattern can match the empty string or start with any character
fn first_bytes(program: Array[Inst]) Array[u8] {
    let table = Array[u8]{ 0 x 256 }
    let visited = Array[u8]{ 0 x program.length }
    let stack = Array[uint]{ 0 }
    while stack.length > 0 {
        let pc = stack.pop_last() ! break
        if visited[pc] == 1 : continue
        visited[pc] = 1
        let inst = program[pc]
        let op = inst.op
        if op == OP_JMP {
            stack.append(inst.x)
        } else if op == OP_SPLIT {
            stack.append(inst.x)
            stack.append(inst.y)
        } else if op == OP_SAVE || op == OP_ASSERT {
            stack.append(pc + 1)
        } else if op == OP_CHAR {
            if inst.code < 128 : table[inst.code.to(uint)] = 1
            else : mark_high(table)
        } else if op == OP_SET {
            let set = inst.set
            if !isset(set) : return Array[u8]{}
            let b: uint = 0
            while b < 128 {
                if set.ascii[b] == 1 : table[b] = 1
                b++
            }
            // Anything non-ASCII may be in the set; be conservative
            if set.negated || set.ranges.length == 0 || set.ranges[set.ranges.length - 1] >= 128 : mark_high(table)
        } else {
            // ANY, ANY_NL or MATCH: no skipping possible
            return Array[u8]{}
        }
    }
    return table
}

fn mark_high(table: Array[u8]) {
    let b: uint = 128
    while b < 256 {
        table[b] = 1
        b++
    }
}


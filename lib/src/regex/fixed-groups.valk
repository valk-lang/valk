// Groups whose place follows from the match itself: in `\{\{(.*?)\}\}` the group starts 2 bytes
// after the match starts and ends 2 bytes before it ends, whatever the text, so a search that
// knows the match needs no pass for its groups. A pattern gets this when every group lies at a
// fixed distance from an edge of the match or of a group around it.

// A place is `distance` bytes after the start of the match, or before its end with this bit
value FIXED_FROM_END (1 << 62)
value FIXED_UNKNOWN (uint.$max)

// The byte width of what `n` matches when it is always the same, else FIXED_UNKNOWN.
// Only literal ASCII has one: `.` and sets can match a character of any width, and a
// caseless letter can match a wider one (k and the Kelvin sign)
fn fixed_width(n: Node) uint {
    let kind = n.kind
    if kind == NODE_EMPTY || kind == NODE_ASSERT : return 0
    if kind == NODE_CHAR {
        if (n.flags & FLAG_CASELESS) != 0 || n.code >= 0x80 : return FIXED_UNKNOWN
        return 1
    }
    if kind == NODE_GROUP : return fixed_width(n.children[0])
    if kind == NODE_CONCAT {
        let total: uint = 0
        each n.children as child {
            let width = fixed_width(child)
            if width == FIXED_UNKNOWN : return FIXED_UNKNOWN
            total += width
        }
        return total
    }
    return FIXED_UNKNOWN
}

fn fixed_after(place: uint, width: uint) uint {
    if place == FIXED_UNKNOWN || width == FIXED_UNKNOWN : return FIXED_UNKNOWN
    return (place & FIXED_FROM_END) != 0 ? place - width : place + width
}

fn fixed_before(place: uint, width: uint) uint {
    if place == FIXED_UNKNOWN || width == FIXED_UNKNOWN : return FIXED_UNKNOWN
    // A place counted from the start can only move left when the distance allows it
    if (place & FIXED_FROM_END) != 0 : return place + width
    return place >= width ? place - width : FIXED_UNKNOWN
}

fn has_capture(n: Node) bool {
    if n.kind == NODE_GROUP && n.group > 0 : return true
    each n.children as child {
        if has_capture(child) : return true
    }
    return false
}

// Records the slots of the groups in `n`, which lies between the two places; false when a
// group's place does not follow
fn assign_fixed_slots(n: Node, start: uint, end: uint, slots: Array[uint]) bool {
    if !has_capture(n) : return true
    let kind = n.kind
    if kind == NODE_GROUP {
        if n.group > 0 {
            if start == FIXED_UNKNOWN || end == FIXED_UNKNOWN : return false
            slots[n.group * 2] = start
            slots[n.group * 2 + 1] = end
        }
        return assign_fixed_slots(n.children[0], start, end, slots)
    }
    if kind != NODE_CONCAT : return false

    let children = n.children
    let count = children.length
    // The place each child starts, counted from the left, and ends, counted from the right
    let starts = Array[uint]{ FIXED_UNKNOWN x count }
    let ends = Array[uint]{ FIXED_UNKNOWN x count }
    let place = start
    each 0 .. count as i {
        starts[i] = place
        place = fixed_after(place, fixed_width(children[i]))
    }
    place = end
    let i = count
    while i > 0 {
        i--
        ends[i] = place
        place = fixed_before(place, fixed_width(children[i]))
    }
    each 0 .. count as c {
        let child_start = starts[c]
        if child_start == FIXED_UNKNOWN && c > 0 : child_start = ends[c - 1]
        let child_end = ends[c]
        if child_end == FIXED_UNKNOWN && c + 1 < count : child_end = starts[c + 1]
        if !assign_fixed_slots(children[c], child_start, child_end, slots) : return false
    }
    return true
}

// The places of all the capture slots after the first two, null when one does not follow
fn fixed_group_slots(node: Node, groups: uint) ?Array[uint] {
    if groups == 0 : return null
    let slots = Array[uint]{ FIXED_UNKNOWN x (groups + 1) * 2 }
    if !assign_fixed_slots(node, 0, FIXED_FROM_END, slots) : return null
    each 2 .. groups * 2 as slot {
        if slots[slot] == FIXED_UNKNOWN : return null
    }
    return slots
}

fn resolve_fixed_slots(fixed: Array[uint], begin: uint, end: uint) &[uint] {
    let slots = [uint]{ 0 x fixed.length }
    slots[0] = begin
    slots[1] = end
    each 2 .. fixed.length - 2 as slot {
        let place = fixed[slot]
        slots[slot] = (place & FIXED_FROM_END) != 0 ? end - (place - FIXED_FROM_END) : begin + place
    }
    return slots
}

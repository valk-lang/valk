use core

// Compiles the syntax tree to a program for the Pike VM

value OP_CHAR (0)
value OP_SET (1)
value OP_ANY (2)
value OP_ANY_NL (3)
value OP_SPLIT (4)
value OP_JMP (5)
value OP_SAVE (6)
value OP_ASSERT (7)
value OP_MATCH (8)

value PROGRAM_LIMIT (50000)

class Inst {
    op: uint
    code: u32 (0)
    set: ?CharSet (null)
    // SPLIT: x is tried first; JMP: x; SAVE: slot in x; ASSERT: kind in x
    x: uint (0)
    y: uint (0)
}

class Compiler {
    program: Array[Inst] (.{})

    static fn compile(node: Node, groups: uint) Array[Inst] !RegexError {
        let c = Compiler {}
        c.emit(Inst { op: OP_SAVE, x: 0 })
        c.node(node) !>
        c.emit(Inst { op: OP_SAVE, x: 1 })
        c.emit(Inst { op: OP_MATCH })
        return c.program
    }

    fn emit(inst: Inst) uint !RegexError {
        if this.program.length >= PROGRAM_LIMIT : throw .too_large { message: "Pattern compiles to too many instructions" }
        this.program.append(inst)
        return this.program.length - 1
    }

    fn node(n: Node) !RegexError {
        let kind = n.kind
        if kind == NODE_EMPTY : return
        if kind == NODE_CHAR {
            if (n.flags & FLAG_CASELESS) != 0 {
                let variants = case_variants(n.code)
                if variants.length > 1 {
                    let set = CharSet {}
                    each variants as v : set.add(v, v)
                    set.finish()
                    this.emit(Inst { op: OP_SET, set: set }) !>
                    return
                }
            }
            this.emit(Inst { op: OP_CHAR, code: n.code }) !>
            return
        }
        if kind == NODE_SET {
            let set = n.set
            if isset(set) {
                if (n.flags & FLAG_CASELESS) != 0 : set = caseless_set(set)
                this.emit(Inst { op: OP_SET, set: set }) !>
            }
            return
        }
        if kind == NODE_ANY {
            this.emit(Inst { op: (n.flags & FLAG_DOTALL) != 0 ? OP_ANY_NL : OP_ANY }) !>
            return
        }
        if kind == NODE_ASSERT {
            this.emit(Inst { op: OP_ASSERT, x: n.assert }) !>
            return
        }
        if kind == NODE_CONCAT {
            each n.children as child : this.node(child) !>
            return
        }
        if kind == NODE_GROUP {
            if n.group > 0 : this.emit(Inst { op: OP_SAVE, x: n.group * 2 }) !>
            this.node(n.children[0]) !>
            if n.group > 0 : this.emit(Inst { op: OP_SAVE, x: n.group * 2 + 1 }) !>
            return
        }
        if kind == NODE_ALT {
            // SPLIT L1, L2; L1: a; JMP end; L2: SPLIT ...; last: z
            let jumps = Array[uint]{}
            let count = n.children.length
            let i: uint = 0
            while i < count {
                if i + 1 < count {
                    let split = this.emit(Inst { op: OP_SPLIT }) !>
                    this.program[split].x = this.program.length
                    this.node(n.children[i]) !>
                    jumps.append(this.emit(Inst { op: OP_JMP }) !>)
                    this.program[split].y = this.program.length
                } else {
                    this.node(n.children[i]) !>
                }
                i++
            }
            each jumps as j : this.program[j].x = this.program.length
            return
        }
        if kind == NODE_REPEAT {
            let child = n.children[0]
            let i: uint = 0
            while i < n.min {
                this.node(child) !>
                i++
            }
            if n.max == REPEAT_UNBOUNDED {
                // L: SPLIT body, end; body; JMP L
                let split = this.emit(Inst { op: OP_SPLIT }) !>
                let body = this.program.length
                this.node(child) !>
                this.emit(Inst { op: OP_JMP, x: split }) !>
                this.set_split(split, body, this.program.length, n.greedy)
            } else {
                // (max - min) nested optionals: SPLIT body, end; body; SPLIT ...
                let splits = Array[uint]{}
                let count = n.max - n.min
                i = 0
                while i < count {
                    let split = this.emit(Inst { op: OP_SPLIT }) !>
                    splits.append(split)
                    let body = this.program.length
                    this.node(child) !>
                    this.program[split].x = body
                    i++
                }
                each splits as s : this.set_split(s, this.program[s].x, this.program.length, n.greedy)
            }
            return
        }
        panic("Unknown regex node")
    }

    fn set_split(index: uint, body: uint, end: uint, greedy: bool) {
        let inst = this.program[index]
        if greedy {
            inst.x = body
            inst.y = end
        } else {
            inst.x = end
            inst.y = body
        }
    }
}

// The code point plus its simple upper and lower case forms
fn case_variants(code: u32) Array[u32] {
    let out = Array[u32]{ code }
    if code < 128 {
        if code >= 'a' && code <= 'z' : out.append(code - 32)
        else if code >= 'A' && code <= 'Z' : out.append(code + 32)
        return out
    }
    let buf = ByteBuffer.new(8)
    if core.unicode_has_lower_mapping(code) {
        if core.unicode_write_map(code, core.unicode_lower_ranges, core.unicode_lower_singles, core.unicode_lower_expansions, core.unicode_lower_expansion_values, buf) {
            let mapped = core.unicode_read(buf.to_string(), 0)
            if mapped.valid && mapped.count == buf.length && mapped.code != code : out.append(mapped.code)
        }
    }
    buf.clear()
    if core.unicode_has_upper_mapping(code) {
        if core.unicode_write_map(code, core.unicode_upper_ranges, core.unicode_upper_singles, core.unicode_upper_expansions, core.unicode_upper_expansion_values, buf) {
            let mapped = core.unicode_read(buf.to_string(), 0)
            if mapped.valid && mapped.count == buf.length && mapped.code != code && !out.contains(mapped.code) : out.append(mapped.code)
        }
    }
    return out
}

// Adds the other case of every ASCII letter in the set, and of single
// non-ASCII code points
fn caseless_set(set: CharSet) CharSet {
    let out = CharSet { negated: set.negated }
    let i: uint = 0
    while i < set.ranges.length {
        let low = set.ranges[i]
        let high = set.ranges[i + 1]
        out.add(low, high)
        // ASCII letters inside the range
        let a_low = low > 'a' ? low : 'a'
        let a_high = high < 'z' ? high : 'z'
        if a_low <= a_high : out.add(a_low - 32, a_high - 32)
        let u_low = low > 'A' ? low : 'A'
        let u_high = high < 'Z' ? high : 'Z'
        if u_low <= u_high : out.add(u_low + 32, u_high + 32)
        if low == high && low >= 128 {
            each case_variants(low) as v : out.add(v, v)
        }
        i += 2
    }
    out.finish()
    return out
}

use core

// A compiled pattern. See docs: Regular expressions
+ class Regex {
    + pattern: String
    - program: Array[Inst]
    - groups: uint
    - names: Array[String]
    - prefix: ?String (null)
    - anchored: bool (false)
    - vm: ?Vm (null)

    // Flags: `i` case-insensitive, `m` multi-line `^`/`$`, `s` dot matches
    // newline
    + static fn new(pattern: String, flags: String ("")) SELF !RegexError {
        let flag_bits: uint = 0
        let i: uint = 0
        while i < flags.bytes {
            let f = flags[i]
            if f == 'i' : flag_bits = flag_bits | FLAG_CASELESS
            else if f == 'm' : flag_bits = flag_bits | FLAG_MULTILINE
            else if f == 's' : flag_bits = flag_bits | FLAG_DOTALL
            else : throw .syntax { message: "Unknown flag '" + flags.part(i, 1) + "'" }
            i++
        }
        let node, groups, names = Parser.parse(pattern, flag_bits) !>
        let program = Compiler.compile(node, groups) !>
        let regex = SELF {
            pattern: pattern
            program: program
            groups: groups
            names: names
        }
        regex.prefix = literal_prefix(node)
        regex.anchored = starts_anchored(node)
        return regex
    }

    // Number of capture groups, not counting the whole match
    + fn group_count() uint { return this.groups }

    // Names of the capture groups, "" for unnamed ones, index 0 is ""
    + fn group_names() Array[String] {
        let out = Array[String]{ "" }
        out.append_many(this.names)
        return out
    }

    // The index of a named group
    + fn group_index(name: String) uint !LookupError {
        let i: uint = 0
        while i < this.names.length {
            if this.names[i] == name : return i + 1
            i++
        }
        throw .missing
    }

    + fn is_match(text: String) bool {
        return isset(this.run(text, 0, false))
    }

    // The leftmost match at or after byte offset `start`
    + fn find(text: String, start: uint (0)) ?Match {
        let slots = this.run(text, start, false)
        if !isset(slots) : return null
        return Match { text: text, slots: slots, regex: this }
    }

    // A match that begins exactly at `start`
    + fn match_at(text: String, start: uint (0)) ?Match {
        let slots = this.run(text, start, true)
        if !isset(slots) : return null
        return Match { text: text, slots: slots, regex: this }
    }

    // Every non-overlapping match, at most `limit` (0 = all)
    + fn find_all(text: String, limit: uint (0)) Array[Match] {
        let out = Array[Match]{}
        let pos: uint = 0
        while pos <= text.bytes {
            let m = this.find(text, pos)
            if !isset(m) : break
            out.append(m)
            if limit > 0 && out.length >= limit : break
            pos = m.end
            if m.end == m.start : pos += char_width(text, pos)
        }
        return out
    }

    // Replaces matches with `replacement`, where `$1`, `${1}`, `${name}`
    // insert groups, `$0` the match and `$$` a dollar; `limit` 0 = all
    + fn replace(text: String, replacement: String, limit: uint (0)) String {
        return this.replace_with(text, fn(m: Match) String { return m.expand(replacement) }, limit)
    }

    // Replaces matches with what `func` returns for each
    + fn replace_with(text: String, func: fn(Match)(String), limit: uint (0)) String {
        let out = ByteBuffer.new(text.bytes)
        let pos: uint = 0
        let last: uint = 0
        let count: uint = 0
        while pos <= text.bytes {
            let m = this.find(text, pos)
            if !isset(m) : break
            out.write(text.view(last, m.start - last))
            out.write(func(m))
            last = m.end
            count++
            if limit > 0 && count >= limit : break
            pos = m.end
            if m.end == m.start {
                let width = char_width(text, pos)
                if pos < text.bytes : out.write(text.view(pos, width))
                pos += width
                last = pos
            }
        }
        if last < text.bytes : out.write(text.view(last, text.bytes - last))
        return out.to_string()
    }

    // Splits `text` on the matches; at most `limit` pieces (0 = all)
    + fn split(text: String, limit: uint (0)) Array[String] {
        let out = Array[String]{}
        let pos: uint = 0
        let last: uint = 0
        while pos <= text.bytes {
            if limit > 0 && out.length + 1 >= limit : break
            let m = this.find(text, pos)
            if !isset(m) : break
            if m.end == m.start {
                // An empty match splits between characters, never at the
                // ends or right after the previous match
                if m.start == 0 || m.start >= text.bytes || m.start == last {
                    pos = m.start + char_width(text, m.start)
                    continue
                }
                out.append(text.part(last, m.start - last))
                last = m.start
                pos = m.start + char_width(text, m.start)
                continue
            }
            out.append(text.part(last, m.start - last))
            last = m.end
            pos = m.end
        }
        out.append(text.part(last, text.bytes - last))
        return out
    }

    fn run(text: String, start: uint, anchored: bool) ?Array[uint] {
        if start > text.bytes : return null
        if this.anchored && start > 0 && !anchored : return null
        let vm = this.vm
        if !isset(vm) {
            vm = Vm.new(this.program, (this.groups + 1) * 2)
            this.vm = vm
        }
        return vm.exec(text, start, anchored || this.anchored, this.prefix)
    }
}

// One match: the whole match is group 0
+ class Match {
    + text: String
    - slots: Array[uint]
    - regex: Regex

    // Byte offsets of the whole match
    + get start: uint { return this.slots[0] }
    + get end: uint { return this.slots[1] }

    + fn str() String {
        return this.text.part(this.slots[0], this.slots[1] - this.slots[0])
    }

    // The text of group `index`; null when the group did not take part
    + fn get(index: uint) ?String {
        if index > this.regex.groups : return null
        let s = this.slots[index * 2]
        let e = this.slots[index * 2 + 1]
        if s == SLOT_UNSET || e == SLOT_UNSET : return null
        return this.text.part(s, e - s)
    }

    // The text of a named group
    + fn named(name: String) ?String {
        let index = this.regex.group_index(name) ! return null
        return this.get(index)
    }

    // Byte offsets of group `index`
    + fn range(index: uint) (uint, uint) !LookupError {
        if index > this.regex.groups : throw .missing
        let s = this.slots[index * 2]
        let e = this.slots[index * 2 + 1]
        if s == SLOT_UNSET || e == SLOT_UNSET : throw .missing
        return (s, e)
    }

    // Number of groups including the whole match
    + fn count() uint { return this.regex.groups + 1 }

    // Fills `$1`, `${name}`, `$0` and `$$` in `template`
    + fn expand(template: String) String {
        let out = ByteBuffer.new(template.bytes + 16)
        let i: uint = 0
        let length = template.bytes
        while i < length {
            let c = template[i]
            if c != '$' || i + 1 >= length {
                out.write_byte(c)
                i++
                continue
            }
            let n = template[i + 1]
            if n == '$' {
                out.write_byte('$')
                i += 2
                continue
            }
            let name_start = i + 1
            let name_end = name_start
            let braced = n == '{'
            if braced {
                name_start++
                name_end = name_start
                while name_end < length && template[name_end] != '}' : name_end++
                if name_end >= length {
                    out.write_byte(c)
                    i++
                    continue
                }
            } else {
                while name_end < length && is_word_byte(template[name_end]) : name_end++
            }
            let name = template.part(name_start, name_end - name_start)
            if name.bytes == 0 {
                out.write_byte(c)
                i++
                continue
            }
            let value = this.lookup(name)
            if isset(value) : out.write(value)
            i = braced ? name_end + 1 : name_end
        }
        return out.to_string()
    }

    fn lookup(name: String) ?String {
        if name.is_integer() {
            let index = name.to_uint() ! return null
            return this.get(index)
        }
        return this.named(name)
    }
}

// Escapes `text` so it matches itself
+ fn escape(text: String) String {
    let out = ByteBuffer.new(text.bytes + 8)
    let i: uint = 0
    while i < text.bytes {
        let c = text[i]
        if c == '\\' || c == '.' || c == '+' || c == '*' || c == '?' || c == '(' || c == ')' || c == '[' || c == ']' || c == '{' || c == '}' || c == '|' || c == '^' || c == '$' {
            out.write_byte('\\')
        }
        out.write_byte(c)
        i++
    }
    return out.to_string()
}

// Compiles and matches in one go
+ fn is_match(pattern: String, text: String) bool !RegexError {
    return (Regex.new(pattern) !>).is_match(text)
}

fn char_width(text: String, pos: uint) uint {
    if pos >= text.bytes : return 1
    return core.unicode_read(text, pos).count
}

// The literal every match must start with, or null
fn literal_prefix(node: Node) ?String {
    let buf = ByteBuffer.new(16)
    let n = node
    while true {
        if n.kind == NODE_GROUP {
            n = n.children[0]
            continue
        }
        break
    }
    // ASCII only: an invalid byte in the text reads as the code point of
    // its value, which a UTF-8 encoded prefix would not find
    if n.kind == NODE_CHAR {
        if (n.flags & FLAG_CASELESS) != 0 || n.code >= 0x80 : return null
        buf.write_byte(n.code.to(u8))
    } else if n.kind == NODE_CONCAT {
        each n.children as child {
            let c = child
            while c.kind == NODE_GROUP : c = c.children[0]
            if c.kind == NODE_ASSERT && buf.length == 0 : continue
            if c.kind != NODE_CHAR || (c.flags & FLAG_CASELESS) != 0 || c.code >= 0x80 : break
            buf.write_byte(c.code.to(u8))
        }
    }
    if buf.length == 0 : return null
    return buf.to_string()
}

fn starts_anchored(node: Node) bool {
    let n = node
    while true {
        if n.kind == NODE_GROUP {
            n = n.children[0]
        } else if n.kind == NODE_CONCAT && n.children.length > 0 {
            n = n.children[0]
        } else {
            break
        }
    }
    return n.kind == NODE_ASSERT && n.assert == ASSERT_TEXT_START
}

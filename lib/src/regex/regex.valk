use core

// Every thread of the matcher carries a capture slot per program counter, and the two
// thread lists are sized `program length * (groups + 1) * 2`. A pattern whose slots would
// be more than this is refused at compile time rather than allocated: a few thousand
// groups in one pattern are an attack, not a regex.
value CAPTURE_SLOT_LIMIT (8000000)

/// A compiled regular expression, matched without backtracking.
///
/// The engine is a Pike VM: matching takes time proportional to the text length times the
/// pattern size, and backreferences and lookaround are not supported. Offsets are byte offsets into the text. `$` without the `m` flag matches only
/// at the very end of the text, and `\b`, `\w` and `\d` are ASCII-only. A `Regex` keeps a
/// matcher cache that every match call reuses, so do not use one object from several
/// threads at once.
///
/// ```valk
/// let re = regex.Regex.new("(?P<user>\\w+)@(?P<host>[\\w.]+)") ! panic("bad pattern")
/// let m = re.find("mail me@example.com") ?! return
/// println(m.named("host") ?? "") // example.com
/// ```
+ class Regex {
    /// The source pattern the regex was compiled from.
    + pattern: String
    - program: Array[Inst]
    - groups: uint
    - names: Array[String]
    - prefix: ?String (null)
    - anchored: bool (false)
    - vm: ?Vm (null)

    /// Compiles `pattern` with the given `flags`.
    ///
    /// Flags: `i` case-insensitive, `m` makes `^`/`$` match at line boundaries, `s` lets `.`
    /// match a newline. Throws `RegexError.syntax` for a malformed pattern or unknown flag,
    /// `unsupported` for backreferences, lookaround and `\p{...}` classes, and `too_large`
    /// when the compiled program exceeds the instruction limit or the capture slots for
    /// its groups would be too many. The payload carries a `message` and byte `position`.
    + static fn new(pattern: String, flags: String ("")) SELF !RegexError {
        let flag_bits: uint = 0
        let i: uint = 0
        while i < flags.bytes {
            let f = flags[i]
            if f == 'i' : flag_bits = flag_bits | FLAG_CASELESS
            else if f == 'm' : flag_bits = flag_bits | FLAG_MULTILINE
            else if f == 's' : flag_bits = flag_bits | FLAG_DOTALL
            else : throw .syntax { message: "Unknown flag '" + flags.range(i, 1) + "'" }
            i++
        }
        let node, groups, names = Parser.parse(pattern, flag_bits) !>
        let program = Compiler.compile(node, groups) !>
        if (groups + 1) * 2 * program.length > CAPTURE_SLOT_LIMIT {
            throw .too_large { message: "Pattern has too many capture groups for its size" }
        }
        let regex = SELF {
            pattern: pattern
            program: program
            groups: groups
            names: names
        }
        regex.prefix = literal_prefix(node)
        regex.anchored = starts_anchored(node)
        return regex
    }

    /// Returns the number of capture groups, not counting the whole match.
    + fn group_count() uint { return this.groups }

    /// Returns the name of each group by group index, `""` for unnamed groups.
    ///
    /// Index 0 is the whole match and is always `""`; the array is a fresh copy.
    + fn group_names() Array[String] {
        let out = Array[String]{ "" }
        out.append_many(this.names)
        return out
    }

    /// Returns the group index of the group called `name`.
    ///
    /// Throws `LookupError` when no group has that name.
    + fn group_index(name: String) uint !LookupError {
        let i: uint = 0
        while i < this.names.length {
            if this.names[i] == name : return i + 1
            i++
        }
        throw .missing
    }

    /// Returns whether the pattern matches anywhere in `text`.
    + fn is_match(text: String) bool {
        return isset(this.run(text, 0, false))
    }

    /// Returns the leftmost match that starts at or after byte offset `start`, or `null`.
    ///
    /// The text before `start` still counts for `\b` and multi-line `^`. A pattern that starts
    /// with `^` (without `m`) or `\A` finds nothing when `start` is above 0. Returns `null`
    /// when `start` is past the end of `text`.
    + fn find(text: String, start: uint (0)) ?Match {
        let slots = this.run(text, start, false)
        if !isset(slots) : return null
        return Match { text: text, slots: slots, regex: this }
    }

    /// Returns the match that begins exactly at byte offset `start`, or `null`.
    + fn match_at(text: String, start: uint (0)) ?Match {
        let slots = this.run(text, start, true)
        if !isset(slots) : return null
        return Match { text: text, slots: slots, regex: this }
    }

    /// Returns every non-overlapping match from left to right, at most `limit` (0 means all).
    ///
    /// After an empty match the search continues one character further.
    + fn find_all(text: String, limit: uint (0)) Array[Match] {
        let out = Array[Match]{}
        let pos: uint = 0
        while pos <= text.bytes {
            let m = this.find(text, pos)
            if !isset(m) : break
            out.append(m)
            if limit > 0 && out.length >= limit : break
            pos = m.end
            if m.end == m.start : pos += char_width(text, pos)
        }
        return out
    }

    /// Returns `text` with the matches replaced by `replacement`, at most `limit` (0 means all).
    ///
    /// The replacement is expanded per match like `Match.expand`: `$1`, `${1}` and `${name}`
    /// insert a group, `$0` the whole match and `$$` a dollar sign.
    + fn replace(text: String, replacement: String, limit: uint (0)) String {
        return this.replace_with(text, fn(m: Match) String { return m.expand(replacement) }, limit)
    }

    /// Returns `text` with each match replaced by what `func` returns for it.
    ///
    /// Replaces at most `limit` matches (0 means all); the rest of the text is copied as is.
    + fn replace_with(text: String, func: fn(Match)(String), limit: uint (0)) String {
        let out = ByteBuffer.new(text.bytes)
        let pos: uint = 0
        let last: uint = 0
        let count: uint = 0
        while pos <= text.bytes {
            let m = this.find(text, pos)
            if !isset(m) : break
            out.write(text.view(last, m.start - last))
            out.write(func(m))
            last = m.end
            count++
            if limit > 0 && count >= limit : break
            pos = m.end
            if m.end == m.start {
                let width = char_width(text, pos)
                if pos < text.bytes : out.write(text.view(pos, width))
                pos += width
                last = pos
            }
        }
        if last < text.bytes : out.write(text.view(last, text.bytes - last))
        return out.to_string()
    }

    /// Splits `text` at the matches into at most `limit` pieces (0 means all).
    ///
    /// The last piece holds the rest of the text. An empty match splits between two
    /// characters, never at either end of the text or right after the previous split.
    + fn split(text: String, limit: uint (0)) Array[String] {
        let out = Array[String]{}
        let pos: uint = 0
        let last: uint = 0
        while pos <= text.bytes {
            if limit > 0 && out.length + 1 >= limit : break
            let m = this.find(text, pos)
            if !isset(m) : break
            if m.end == m.start {
                // An empty match splits between characters, never at the
                // ends or right after the previous match
                if m.start == 0 || m.start >= text.bytes || m.start == last {
                    pos = m.start + char_width(text, m.start)
                    continue
                }
                out.append(text.range(last, m.start - last))
                last = m.start
                pos = m.start + char_width(text, m.start)
                continue
            }
            out.append(text.range(last, m.start - last))
            last = m.end
            pos = m.end
        }
        out.append(text.range(last, text.bytes - last))
        return out
    }

    fn run(text: String, start: uint, anchored: bool) ?Array[uint] {
        if start > text.bytes : return null
        if this.anchored && start > 0 && !anchored : return null
        let vm = this.vm
        if !isset(vm) {
            vm = Vm.new(this.program, (this.groups + 1) * 2)
            this.vm = vm
        }
        return vm.exec(text, start, anchored || this.anchored, this.prefix)
    }
}

/// One match of a `Regex` in a text; group 0 is the whole match.
+ class Match {
    /// The text that was searched, not only the matched part.
    + text: String
    - slots: Array[uint]
    - regex: Regex

    /// Byte offset in `text` where the whole match starts.
    + get start: uint { return this.slots[0] }
    /// Byte offset in `text` just past the end of the whole match.
    + get end: uint { return this.slots[1] }

    /// Returns the text of the whole match.
    + fn str() String {
        return this.text.range(this.slots[0], this.slots[1] - this.slots[0])
    }

    /// Returns the text of group `index`.
    ///
    /// Returns `null` when the group did not take part in the match or does not exist.
    + fn get(index: uint) ?String {
        if index > this.regex.groups : return null
        let s = this.slots[index * 2]
        let e = this.slots[index * 2 + 1]
        if s == SLOT_UNSET || e == SLOT_UNSET : return null
        return this.text.range(s, e - s)
    }

    /// Returns the text of the group called `name`.
    ///
    /// Returns `null` when no group has that name or the group did not take part in the match.
    + fn named(name: String) ?String {
        let index = this.regex.group_index(name) ! return null
        return this.get(index)
    }

    /// Returns the start and end byte offsets of group `index`.
    ///
    /// Throws `LookupError` when the group does not exist or did not take part in the match.
    + fn range(index: uint) (uint, uint) !LookupError {
        if index > this.regex.groups : throw .missing
        let s = this.slots[index * 2]
        let e = this.slots[index * 2 + 1]
        if s == SLOT_UNSET || e == SLOT_UNSET : throw .missing
        return (s, e)
    }

    /// Returns the number of groups including the whole match.
    + fn count() uint { return this.regex.groups + 1 }

    /// Returns `template` with group references replaced by the group texts of this match.
    ///
    /// `$1` or `${1}` insert a group by index, `$name` or `${name}` by name, `$0` the whole
    /// match and `$$` a dollar sign. An unbraced reference takes all following word
    /// characters, so `$1st` looks up a group named `1st`; write `${1}st` instead. Unknown
    /// groups and groups that did not take part insert nothing. A `$` not followed by a
    /// reference is copied as is.
    + fn expand(template: String) String {
        let out = ByteBuffer.new(template.bytes + 16)
        let i: uint = 0
        let length = template.bytes
        while i < length {
            let c = template[i]
            if c != '$' || i + 1 >= length {
                out.write_byte(c)
                i++
                continue
            }
            let n = template[i + 1]
            if n == '$' {
                out.write_byte('$')
                i += 2
                continue
            }
            let name_start = i + 1
            let name_end = name_start
            let braced = n == '{'
            if braced {
                name_start++
                name_end = name_start
                while name_end < length && template[name_end] != '}' : name_end++
                if name_end >= length {
                    out.write_byte(c)
                    i++
                    continue
                }
            } else {
                while name_end < length && is_word_byte(template[name_end]) : name_end++
            }
            let name = template.range(name_start, name_end - name_start)
            if name.bytes == 0 {
                out.write_byte(c)
                i++
                continue
            }
            let value = this.lookup(name)
            if isset(value) : out.write(value)
            i = braced ? name_end + 1 : name_end
        }
        return out.to_string()
    }

    fn lookup(name: String) ?String {
        if name.is_integer() {
            let index = name.to_uint() ! return null
            return this.get(index)
        }
        return this.named(name)
    }
}

/// Returns `text` with every regex metacharacter escaped, so the result matches `text` literally.
+ fn escape(text: String) String {
    let out = ByteBuffer.new(text.bytes + 8)
    let i: uint = 0
    while i < text.bytes {
        let c = text[i]
        if c == '\\' || c == '.' || c == '+' || c == '*' || c == '?' || c == '(' || c == ')' || c == '[' || c == ']' || c == '{' || c == '}' || c == '|' || c == '^' || c == '$' {
            out.write_byte('\\')
        }
        out.write_byte(c)
        i++
    }
    return out.to_string()
}

/// Returns whether `pattern` matches anywhere in `text`, compiling the pattern on every call.
///
/// Throws `RegexError` when the pattern does not compile; see `Regex.new`.
+ fn is_match(pattern: String, text: String) bool !RegexError {
    return (Regex.new(pattern) !>).is_match(text)
}

fn char_width(text: String, pos: uint) uint {
    if pos >= text.bytes : return 1
    return core.unicode_read(text, pos).count
}

// The literal every match must start with, or null
fn literal_prefix(node: Node) ?String {
    let buf = ByteBuffer.new(16)
    let n = node
    while true {
        if n.kind == NODE_GROUP {
            n = n.children[0]
            continue
        }
        break
    }
    // ASCII only: an invalid byte in the text reads as the code point of
    // its value, which a UTF-8 encoded prefix would not find
    if n.kind == NODE_CHAR {
        if (n.flags & FLAG_CASELESS) != 0 || n.code >= 0x80 : return null
        buf.write_byte(n.code.to(u8))
    } else if n.kind == NODE_CONCAT {
        each n.children as child {
            let c = child
            while c.kind == NODE_GROUP : c = c.children[0]
            if c.kind == NODE_ASSERT && buf.length == 0 : continue
            if c.kind != NODE_CHAR || (c.flags & FLAG_CASELESS) != 0 || c.code >= 0x80 : break
            buf.write_byte(c.code.to(u8))
        }
    }
    if buf.length == 0 : return null
    return buf.to_string()
}

fn starts_anchored(node: Node) bool {
    let n = node
    while true {
        if n.kind == NODE_GROUP {
            n = n.children[0]
        } else if n.kind == NODE_CONCAT && n.children.length > 0 {
            n = n.children[0]
        } else {
            break
        }
    }
    return n.kind == NODE_ASSERT && n.assert == ASSERT_TEXT_START
}

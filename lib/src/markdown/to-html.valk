
use html
use url

+ class ToHtmlOptions {
    + code_class: ?String (null)
    + paragraph_class: ?String (null)
    // The schemes a link or image may use. Every other scheme (javascript:, data:,
    // vbscript:, file:, ...) is dropped. A URL that carries no scheme at all — `/x`,
    // `./x`, `#anchor`, `?query`, `//host/x` — is relative and stays allowed.
    + allowed_schemes: Array[String] (.{ "http", "https", "mailto" })
}

+ fn to_html(md: String, options: ?ToHtmlOptions (null)) String {
    let html = ByteBuffer.new(1024)
    let lines = md.split("\n")
    let state = State {}
    // Options
    let opts = options ?? ToHtmlOptions {}
    let pclass = opts.paragraph_class
    if isset(pclass) : state.paragraph_class = pclass
    let code_class = opts.code_class
    if isset(code_class) : state.code_class = code_class
    // Schemes are matched against the lowercased scheme url.parse reports, so they are
    // normalized once here rather than on every link.
    each opts.allowed_schemes as scheme {
        state.allowed_schemes.append(scheme.lower())
    }
    //
    handle_lines(html, state, lines)
    return html
}

// Markdown carries no raw HTML: every character that could open a tag, close an
// attribute or start a character reference has to reach the output escaped. `&` goes
// through along with < > " because a browser decodes the character references in an
// attribute value exactly once — a source `javascript&colon;alert(1)` that kept its
// bare `&` would reach the URL parser as `javascript:alert(1)`. Escaping `&` first
// makes every entity in the output inert.
fn escape_text(text: String) String {
    let options = html.SanitizeOptions {
        escape_ampersand: true,
    }
    return html.sanitize(text, options)
}

fn url_is_allowed(target: String, allowed: Array[String]) bool {
    let scheme = url.parse(url_as_browser_sees(target)).scheme
    if scheme.is_empty() : return true // relative, fragment or query reference
    return allowed.contains(scheme)
}

// The WHATWG basic URL parser drops every ASCII tab and newline from its input and
// trims leading/trailing C0 control and space before it looks for a scheme, so a
// browser reads `java<TAB>script:x` and `   javascript:x` as `javascript:x`. An
// allow-list that judged the bytes in front of it would pass both.
fn url_as_browser_sees(target: String) String {
    let len = target.length
    let buf = ByteBuffer.new(len)
    let i: uint = 0
    while i < len {
        let ch = target.get(i++)
        if ch == '\t' || ch == '\n' || ch == '\r' : continue
        buf.write_byte(ch)
    }
    let trimmed: String = buf
    let from: uint = 0
    let until = trimmed.length
    while from < until && trimmed.get(from) <= ' ' { from++ }
    while until > from && trimmed.get(until - 1) <= ' ' { until-- }
    return trimmed.part(from, until - from)
}

enum LT: uint {
    empty
    text
    code
    h1 h2 h3 h4 h5 h6
    hr // 9
    blockquote
    ul1 ul2 ul3
    ol
    li
    title
}

fn line_type(line: String) LT {
    if line.is_empty() : return LT.empty
    if line.starts_with("```") : return LT.code
    if line.starts_with("# ") : return LT.h1
    if line.starts_with("## ") : return LT.h2
    if line.starts_with("### ") : return LT.h3
    if line.starts_with("#### ") : return LT.h4
    if line.starts_with("##### ") : return LT.h5
    if line.starts_with("###### ") : return LT.h6
    if line.starts_with("---") : return LT.hr
    if line.starts_with("___") : return LT.hr
    if line.starts_with("***") : return LT.hr
    if line.starts_with(">") : return LT.blockquote
    if line.starts_with("- ") : return LT.ul1
    if line.starts_with("+ ") : return LT.ul2
    if line.starts_with("* ") : return LT.ul3
    if line.starts_with("--") : return LT.title
    if line.starts_with("==") : return LT.title
    if is_numbered_li(line) : return LT.ol
    return LT.text
}

class State {
    scopes: Array[LT] (.{})
    li_starts: Array[uint] (.{})
    text_lines: Array[String] (.{})
    allowed_schemes: Array[String] (.{})
    offset: uint (0)
    paragraph_class: ?String (null)
    code_class: ?String (null)
    use_para: bool (true)
}

fn handle_lines(html: ByteBuffer, state: State, lines: Array[String]) {
    each lines as line, lindex {
        let current = state.scopes.get(state.scopes.length - 1) !? LT.empty

        if current == LT.code {
            if trim_whitespace(line) == "```" {
                state.scopes.pop_last() _
                html.write_string("</code></pre>")
            } else {
                html.write_string(escape_text(line))
                html.write_byte('\n')
            }
            continue
        }

        state.offset = 0
        line = parse_scope(html, line, state)

        while true {
            let lt = line_type(line)
            let current = state.scopes.get(state.scopes.length - 1) !? LT.empty

            // Check invalid <hr>
            if lt == LT.hr || line.starts_with("==") || line.starts_with("--") {
                let fch = line.get(0)
                let i = 2
                while i < line.length {
                    let ch = line.get(i++)
                    if ch != fch && ch != ' ' {
                        lt = LT.text
                        break
                    }
                }
            }

            // Header
            if lt != LT.text && (line.starts_with("==") || line.starts_with("--")) {
                if state.text_lines.length > 0 {
                    state.use_para = true
                    let title = state.text_lines.pop_last() ! continue
                    dump_text(state, html)
                    indent(state, html)
                    if line.starts_with("=") : html.write_string("<h1>%title</h1>")
                    else : html.write_string("<h2>%title</h2>")
                    break
                }
                lt = LT.text
            }

            // Dump text
            if lt != LT.text && state.text_lines.length > 0 {
                state.use_para = true
                dump_text(state, html)
            }

            if lt == LT.empty : break

            if lt == LT.blockquote {
                indent(state, html)
                html.write_string("<blockquote>")
                line = skip_part_and_spaces(state, line, 1)
                state.scopes.append(lt)
                continue
            }
            if lt >= LT.ul1 && lt <= LT.ul3 {
                line = skip_part_and_spaces(state, line, 2)
                state.use_para = false
                if current != lt {
                    indent(state, html)
                    html.write_string("<ul>")
                    state.scopes.append(lt)
                }
                state.li_starts.append(state.offset)
                indent(state, html)
                html.write_string("<li>")
                state.scopes.append(LT.li)
                continue
            }
            if lt == LT.ol {
                if current == LT.ol || line.starts_with("1.") {
                    let offset = (line.index_of(".") !? 1) + 2
                    line = skip_part_and_spaces(state, line, offset)
                    state.use_para = false
                    if current != lt {
                        indent(state, html)
                        html.write_string("<ol>")
                        state.scopes.append(lt)
                    }
                    state.li_starts.append(state.offset)
                    indent(state, html)
                    html.write_string("<li>")
                    state.scopes.append(LT.li)
                    continue
                }
                lt = LT.text
            }

            if lt >= LT.h1 && lt <= LT.h6 {
                indent(state, html)
                let nr = (lt - LT.h1) + 1
                line = line.part(nr + 1, line.length)
                html.write_string("<h")
                html.write_uint_ascii(nr)
                html.write_string(">")
                html.write_string(escape_text(line))
                html.write_string("</h")
                html.write_uint_ascii(nr)
                html.write_string(">")
                break
            }

            if lt == LT.code {
                indent(state, html)
                let code_class = state.code_class
                if isset(code_class) {
                    let class_name = escape_text(code_class)
                    html.write_string("<pre><code class=\"%{class_name}\">")
                } else {
                    html.write_string("<pre><code>")
                }
                state.scopes.append(lt)
                break
            }

            if lt == LT.text {
                state.text_lines.append(escape_text(line))
                break
            }

            if lt == LT.hr {
                indent(state, html)
                html.write_string("<hr/>")
                break
            }

            panic("Unhandled markdown type (bug): " + lt)
        }
    }

    dump_text(state, html)
    close_scopes(state, html, 0)
}

fn line_format_all(line: String, allowed: Array[String]) String {
    line = line_format(line, "``", "``", "<code>", "</code>")
    line = line_format(line, "`", "`", "<code>", "</code>")
    line = line_format(line, "***", "***", "<em><strong>", "</strong></em>")
    line = line_format(line, "___", "___", "<em><strong>", "</strong></em>", true)
    line = line_format(line, "__*", "*__", "<em><strong>", "</strong></em>", true)
    line = line_format(line, "**_", "_**", "<em><strong>", "</strong></em>", true)
    line = line_format(line, "**", "**", "<strong>", "</strong>")
    line = line_format(line, "__", "__", "<strong>", "</strong>", true)
    line = line_format(line, "*", "*", "<em>", "</em>")
    line = line_format(line, "~~", "~~", "<del>", "</del>")

    // Links
    while true {
        let is_image = false
        let p1 = line.index_of_byte('[') ! break
        if p1 > 0 && line.get(p1 - 1) == '!' : is_image = true
        let p2 = find_end_scope(line, p1 + 1, '[', ']') ! break
        if line.get(p2 + 1) != '(' : break
        let p3 = find_end_scope(line, p2 + 2, '(', ')') ! break
        //
        let s1 = line.part(0, p1 - is_image.to(u8))
        let label = line.part(p1 + 1, p2 - p1 - 1)
        let url = line.part(p2 + 2, p3 - p2 - 2)
        let s2 = line.part(p3 + 1, line.length - p3 - 1)
        // Both the label and the target already went through the escaper with the
        // line they were cut out of, so they are attribute-safe as they stand.
        let safe_target = url_is_allowed(url, allowed)
        if is_image {
            // An image with a target the reader will never fetch is dropped rather
            // than emitted as a broken icon; `alt` is the attribute that names it,
            // `label` never existed in HTML.
            if safe_target : line = "%s1<img src=\"%url\" alt=\"%label\"/>%s2"
            else : line = "%s1%s2"
        } else {
            label = line_format_all(label, allowed)
            // A link whose target cannot be followed loses the anchor and keeps its
            // text, which is what the reader can still act on.
            if safe_target : line = "%s1<a href=\"%url\">%label</a>%s2"
            else : line = "%s1%label%s2"
        }
    }

    return line
}

fn find_end_scope(line: String, start: uint, char_start: u8, char_end: u8) uint !LookupError {
    let depth = 1
    let i = start
    while i < line.length {
        let ch = line.get(i)
        if ch == char_start : depth++
        else if ch == char_end {
            if depth-- == 0 : throw .missing
            if depth == 0 {
                return i
            }
        }
        i++
    }
    throw .missing
}

fn line_format(line: String, find1: String, find2: String, before: String, after: String, no_ascii: bool (false)) String {
    let fl1 = find1.length
    let fl2 = find2.length
    while true {
        let p1 = line.index_of(find1) ! break
        if p1 > 0 && no_ascii && line.get(p1 - 1).is_alpha_numeric() : break
        let p2 = line.index_of(find2, p1 + 1) ! break
        if p2 + fl2 < line.length && no_ascii && line.get(p2 + fl2).is_alpha_numeric() : break
        let s1 = line.part(0, p1)
        let s2 = line.part(p1 + fl1, p2 - p1 - fl1)
        let s3 = line.part(p2 + fl2, line.length - p2 - fl2)
        line = "%s1%before%s2%after%s3"
    }
    return line
}

fn is_numbered_li(line: String) bool {
    let i: uint = 0
    while true {
        let ch = line.get(i++)
        if ch.is_number() : continue
        if ch == '.' && line.get(i) == ' ' && i > 1 : return true
        return false
    }
    return false
}

fn parse_scope(html: ByteBuffer, line: String, state: State) String {
    let current = state.scopes.get(state.scopes.length - 1) !? LT.empty

    if current == LT.code : return line

    // Check leading whitespace
    let linespaces: uint = 0
    let whitespace_chars: uint = 0
    let i = 0
    while true {
        let ch = line.get(i++)
        if ch == ' ' { linespaces++; whitespace_chars++ }
        else if ch == '\t' { linespaces += 3; whitespace_chars++ }
        else : break
    }

    // Spaces until in list item
    let scope_same_count = 0
    let cut = 0
    each state.li_starts as pos {
        if linespaces >= pos {
            cut = pos
            while true {
                let scope = state.scopes.get(scope_same_count++) ! break
                if scope == LT.li : break
            }
        }
    }
    if cut > 0 : line = line.part(cut, line.length)
    state.offset = cut

    // Progress scopes
    i = 0
    while i < line.length {
        let ch = line.get(i++)
        if ch == ' ' || ch == '\t' : continue
        if ch == '>' && (state.scopes.get(scope_same_count) !? LT.empty) == LT.blockquote {
            scope_same_count++
            continue
        }
        i--
        break
    }
    line = line.part(i, line.length)
    state.offset += i

    // Get type of line remainder
    let type = line_type(line)
    if type >= LT.ul1 && type <= LT.ol {
        current = state.scopes.get(scope_same_count) !? LT.empty
        if type == current : scope_same_count++
    }

    // Close un-used scopes
    close_scopes(state, html, scope_same_count)

    return line
}

fn close_scopes(state: State, html: ByteBuffer, keep: uint) {
    let amount = state.scopes.length - keep
    if amount > 0 : dump_text(state, html)
    //
    while amount-- > 0 {
        let scope = state.scopes.pop_last() ! panic("Missing scope (bug)")

        if state.use_para {
            indent(state, html)
        } else {
            state.use_para = true
        }

        if scope == LT.blockquote : html.write_string("</blockquote>")
        else if scope == LT.code : html.write_string("</code></pre>")
        else if scope == LT.li {
            state.li_starts.pop_last() _
            html.write_string("</li>")
        }
        else if scope >= LT.ul1 && scope <= LT.ul3 : html.write_string("</ul>")
        else if scope == LT.ol : html.write_string("</ol>")
        else : panic("Unknown scope (bug): " + scope)
    }
}

fn trim_whitespace(line: String) String {
    let len = line.length
    let from = 0
    let until = len
    while from < len {
        let ch = line.get(from)
        if !ch.is_whitespace() : break
        from++
    }
    while until > from {
        let ch = line.get(until - 1)
        if !ch.is_whitespace() : break
        until--
    }
    return line.part(from, until - from)
}

fn skip_part_and_spaces(state: State, line: String, start: uint) String {
    let i = start
    let len = line.length
    while i < len {
        let ch = line.get(i)
        if ch != ' ' && ch != '\t' : break
        i++
    }
    state.offset += i
    return line.part(i, line.length)
}

fn dump_text(state: State, html: ByteBuffer) {
    if state.text_lines.length == 0 : return
    if state.use_para {
        let pclass = state.paragraph_class
        indent(state, html)
        if isset(pclass) {
            let class_name = escape_text(pclass)
            html.write_string("<p class=\"%{class_name}\">")
        } else {
            html.write_string("<p>")
        }
    }
    each state.text_lines as text, index {
        if index > 0 : html.write_string("<br>")
        html.write_string(line_format_all(text, state.allowed_schemes))
    }
    if state.use_para {
        html.write_string("</p>")
    }
    state.text_lines.clear()
}

fn indent(state: State, html: ByteBuffer) {
    html.write_string("\n")
    each state.li_starts as li {
        html.write_string("  ")
    }
}

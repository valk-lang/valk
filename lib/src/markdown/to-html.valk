
use html

value MAX_DEPTH (64)

/// Options for `to_html`.
+ class ToHtmlOptions {
    /// The `class` attribute given to the `<code>` element of every fenced code block.
    + code_class: ?String (null)
    /// The `class` attribute given to every `<p>` element.
    + paragraph_class: ?String (null)
    /// The URL schemes a link or image may use; case does not matter.
    ///
    /// A link to any other scheme (`javascript:`, `data:`, `file:`, ...) loses its anchor and
    /// keeps its text, and such an image is dropped. A URL without a scheme (`/x`, `./x`,
    /// `#anchor`, `?query`, `//host/x`) is relative and always allowed.
    + allowed_schemes: Array[String] (.{ "http", "https", "mailto" })
}

/// Converts the markdown text `md` to an HTML fragment.
///
/// Supports `#` and underlined headings, paragraphs, `>` quotes, `-`/`+`/`*` and `1.`
/// lists, fenced code blocks, `---` rules, inline code, `*` emphasis, `**`/`__` bold,
/// `~~` strikethrough, links and images. Raw HTML is not supported: every `<`, `>`, `"`,
/// `'` and `&` in the input is escaped, so the output is safe to embed. Lines of one
/// paragraph are joined with `<br>`, headings get no inline formatting, and an ordered list
/// must start at `1.`. Quotes and lists nest at most 64 levels deep; deeper markers stay text.
+ fn to_html(md: String, options: ?ToHtmlOptions (null)) String {
    let html = ByteBuffer.new(1024)
    let lines = md.split("\n")
    let state = State {}
    // Options
    let opts = options ?? ToHtmlOptions {}
    let pclass = opts.paragraph_class
    if isset(pclass) : state.paragraph_class = pclass
    let code_class = opts.code_class
    if isset(code_class) : state.code_class = code_class
    // Schemes are matched against the lowercased scheme url.parse reports, so they are
    // normalized once here rather than on every link.
    each opts.allowed_schemes as scheme {
        state.allowed_schemes.append(scheme.lower())
    }
    //
    handle_lines(html, state, lines)
    return html
}

// Markdown carries no raw HTML: every character that could open a tag, close an
// attribute or start a character reference has to reach the output escaped. `&` goes
// through along with < > " because a browser decodes the character references in an
// attribute value exactly once — a source `javascript&colon;alert(1)` that kept its
// bare `&` would reach the URL parser as `javascript:alert(1)`. Escaping `&` first
// makes every entity in the output inert.
fn escape_text(text: String) String {
    let options = html.EscapeOptions {
        escape_ampersand: true,
    }
    return html.escape(text, options)
}

fn url_is_allowed(target: String, allowed: Array[String]) bool {
    return html.url_is_allowed(target, allowed)
}

enum LT: uint {
    empty
    text
    code
    h1 h2 h3 h4 h5 h6
    hr // 9
    blockquote
    ul1 ul2 ul3
    ol
    li
    title
}

fn line_type(line: String) LT {
    if line.is_empty() : return LT.empty
    if line.starts_with("```") : return LT.code
    if line.starts_with("# ") : return LT.h1
    if line.starts_with("## ") : return LT.h2
    if line.starts_with("### ") : return LT.h3
    if line.starts_with("#### ") : return LT.h4
    if line.starts_with("##### ") : return LT.h5
    if line.starts_with("###### ") : return LT.h6
    if line.starts_with("---") : return LT.hr
    if line.starts_with("___") : return LT.hr
    if line.starts_with("***") : return LT.hr
    if line.starts_with(">") : return LT.blockquote
    if line.starts_with("- ") : return LT.ul1
    if line.starts_with("+ ") : return LT.ul2
    if line.starts_with("* ") : return LT.ul3
    if line.starts_with("--") : return LT.title
    if line.starts_with("==") : return LT.title
    if is_numbered_li(line) : return LT.ol
    return LT.text
}

class State {
    scopes: Array[LT] (.{})
    li_starts: Array[uint] (.{})
    text_lines: Array[String] (.{})
    allowed_schemes: Array[String] (.{})
    offset: uint (0)
    paragraph_class: ?String (null)
    code_class: ?String (null)
    use_para: bool (true)
}

fn handle_lines(html: ByteBuffer, state: State, lines: Array[String]) {
    each lines as line, lindex {
        let current = state.scopes.get(state.scopes.length - 1) !? LT.empty

        if current == LT.code {
            if trim_whitespace(line) == "```" {
                state.scopes.pop_last() _
                html.write("</code></pre>")
            } else {
                html.write(escape_text(line))
                html.write_byte('\n')
            }
            continue
        }

        state.offset = 0
        line = parse_scope(html, line, state)

        while true {
            let lt = line_type(line)
            let current = state.scopes.get(state.scopes.length - 1) !? LT.empty
            // Markers past the nesting limit stay literal text: the output grows with
            // the square of the depth otherwise
            if state.scopes.length >= MAX_DEPTH && (lt == LT.blockquote || (lt >= LT.ul1 && lt <= LT.ol)) : lt = LT.text

            // Check invalid <hr>
            if lt == LT.hr || line.starts_with("==") || line.starts_with("--") {
                let fch = line.get(0)
                let i = 2
                while i < line.length {
                    let ch = line.get(i++)
                    if ch != fch && ch != ' ' {
                        lt = LT.text
                        break
                    }
                }
            }

            // Header
            if lt != LT.text && (line.starts_with("==") || line.starts_with("--")) {
                if state.text_lines.length > 0 {
                    state.use_para = true
                    let title = state.text_lines.pop_last() ! continue
                    dump_text(state, html)
                    indent(state, html)
                    if line.starts_with("=") : html.write("<h1>%title</h1>")
                    else : html.write("<h2>%title</h2>")
                    break
                }
                lt = LT.text
            }

            // Dump text
            if lt != LT.text && state.text_lines.length > 0 {
                state.use_para = true
                dump_text(state, html)
            }

            if lt == LT.empty : break

            if lt == LT.blockquote {
                indent(state, html)
                html.write("<blockquote>")
                line = skip_part_and_spaces(state, line, 1)
                state.scopes.append(lt)
                continue
            }
            if lt >= LT.ul1 && lt <= LT.ul3 {
                line = skip_part_and_spaces(state, line, 2)
                state.use_para = false
                if current != lt {
                    indent(state, html)
                    html.write("<ul>")
                    state.scopes.append(lt)
                }
                state.li_starts.append(state.offset)
                indent(state, html)
                html.write("<li>")
                state.scopes.append(LT.li)
                continue
            }
            if lt == LT.ol {
                if current == LT.ol || line.starts_with("1.") {
                    let offset = (line.index_of(".") !? 1) + 2
                    line = skip_part_and_spaces(state, line, offset)
                    state.use_para = false
                    if current != lt {
                        indent(state, html)
                        html.write("<ol>")
                        state.scopes.append(lt)
                    }
                    state.li_starts.append(state.offset)
                    indent(state, html)
                    html.write("<li>")
                    state.scopes.append(LT.li)
                    continue
                }
                lt = LT.text
            }

            if lt >= LT.h1 && lt <= LT.h6 {
                indent(state, html)
                let nr = (lt - LT.h1) + 1
                line = line.range(nr + 1, line.length)
                html.write("<h")
                html.write_uint_ascii(nr)
                html.write(">")
                html.write(escape_text(line))
                html.write("</h")
                html.write_uint_ascii(nr)
                html.write(">")
                break
            }

            if lt == LT.code {
                indent(state, html)
                let code_class = state.code_class
                if isset(code_class) {
                    let class_name = escape_text(code_class)
                    html.write("<pre><code class=\"%{class_name}\">")
                } else {
                    html.write("<pre><code>")
                }
                state.scopes.append(lt)
                break
            }

            if lt == LT.text {
                state.text_lines.append(escape_markers(escape_text(line)))
                break
            }

            if lt == LT.hr {
                indent(state, html)
                html.write("<hr/>")
                break
            }

            panic("Unhandled markdown type (bug): " + lt)
        }
    }

    dump_text(state, html)
    close_scopes(state, html, 0)
}

fn line_format_all(line: String, allowed: Array[String]) String {
    // A code span and a link target are literal: the markers inside them are not
    // formatting. Both are parked in a list and swapped for a placeholder that no
    // emphasis pass can match, then put back.
    let spans = Array[String].new()
    let targets = Array[String].new()
    line = protect_line(line, spans, targets)

    line = line_format(line, "***", "***", "<em><strong>", "</strong></em>")
    line = line_format(line, "___", "___", "<em><strong>", "</strong></em>", true)
    line = line_format(line, "__*", "*__", "<em><strong>", "</strong></em>", true)
    line = line_format(line, "**_", "_**", "<em><strong>", "</strong></em>", true)
    line = line_format(line, "**", "**", "<strong>", "</strong>")
    line = line_format(line, "__", "__", "<strong>", "</strong>", true)
    line = line_format(line, "*", "*", "<em>", "</em>")
    line = line_format(line, "~~", "~~", "<del>", "</del>")

    // Links. The pairs come from one pass over the line; the line is rebuilt as links
    // are emitted, so a position in it is looked up where it stood in the built-from
    // line, `shift` characters away
    let bracket_pairs = pair_matches(line, '[', ']')
    let paren_pairs = pair_matches(line, '(', ')')
    let shift: int = 0
    let search: uint = 0
    while true {
        let is_image = false
        let p1 = line.index_of_byte('[', search) ! break
        if p1 > 0 && line.get(p1 - 1) == '!' : is_image = true
        // Brackets that are not a link are skipped instead of ending the search: a
        // line may hold its own brackets before the first real link
        let p2_orig = bracket_pairs.get((p1.to(int) - shift).to(uint)) !? uint.$max
        if p2_orig == uint.$max {
            search = p1 + 1
            continue
        }
        let p2 = (p2_orig.to(int) + shift).to(uint)
        if line.get(p2 + 1) != '(' {
            search = p1 + 1
            continue
        }
        let p3_orig = paren_pairs.get(p2_orig + 1) !? uint.$max
        if p3_orig == uint.$max {
            search = p1 + 1
            continue
        }
        let p3 = (p3_orig.to(int) + shift).to(uint)
        //
        let s1 = line.range(0, p1 - is_image.to(u8))
        let label = line.range(p1 + 1, p2 - p1 - 1)
        let url = target_value(line.range(p2 + 2, p3 - p2 - 2), targets)
        let s2 = line.range(p3 + 1, line.length - p3 - 1)
        // Both the label and the target already went through the escaper with the
        // line they were cut out of, so they are attribute-safe as they stand.
        let safe_target = url_is_allowed(url, allowed)
        let emitted: String = ""
        if is_image {
            // An image with a target the reader will never fetch is dropped rather
            // than emitted as a broken icon; `alt` is the attribute that names it,
            // `label` never existed in HTML.
            if safe_target : emitted = "<img src=\"%url\" alt=\"%label\"/>"
        } else {
            label = line_format_all(label, allowed)
            // A link whose target cannot be followed loses the anchor and keeps its
            // text, which is what the reader can still act on. A label holding a
            // stray tag — one of its emphasis markers paired with a marker outside
            // the brackets — cannot be wrapped either, or the two spans would cross.
            if safe_target && tags_balanced(label) : emitted = "<a href=\"%url\">%label</a>"
            else : emitted = label
        }
        line = "%s1%emitted%s2"
        // What stood between s1 and s2 is what the rendering replaced
        shift = shift + emitted.length.to(int) - (p3 + 1 - (p1 - is_image.to(uint))).to(int)
        search = s1.length + emitted.length
    }

    // A target that never became a link is source text, so it goes back as it was
    line = restore_placeholders(line, targets, PLACEHOLDER_TARGET)
    return restore_placeholders(line, spans, PLACEHOLDER_CODE)
}

// A parked code span and a parked link target are marked with a different byte, so a
// leftover target can still be put back when it is not part of a link.
value PLACEHOLDER_CODE (0x01)
value PLACEHOLDER_TARGET (0x02)

// The marker bytes are escaped before the inline passes see the text and put back
// after them, so a literal 0x01 or 0x02 in the input cannot pass for a placeholder.
fn escape_markers(text: String) String {
    let out = ByteBuffer.new(text.bytes)
    each text as ch {
        out.write_byte(ch)
        if ch == PLACEHOLDER_CODE || ch == PLACEHOLDER_TARGET : out.write_byte(0)
    }
    return out.into_string()
}

fn unescape_markers(text: String) String {
    let out = ByteBuffer.new(text.bytes)
    let bytes = text.bytes
    let i: uint = 0
    while i < bytes {
        let ch = text.get(i++)
        out.write_byte(ch)
        if (ch == PLACEHOLDER_CODE || ch == PLACEHOLDER_TARGET) && i < bytes && text.get(i) == 0 : i++
    }
    return out.into_string()
}

// A placeholder such as "\x010\x01" stands for `values.get(0)`.
fn placeholder(kind: u8, index: uint) String {
    let byte = kind.to_ascii_string()
    return byte + index.to(String) + byte
}

// Returns the index held in a placeholder, or -1 when the text is not one.
fn placeholder_index(text: String, kind: u8) int {
    let len = text.length
    if len < 3 || text.get(0) != kind || text.get(len - 1) != kind : return -1
    let value: int = 0
    let i: uint = 1
    while i < len - 1 {
        let ch = text.get(i++)
        if !ch.is_number() : return -1
        value = value * 10 + (ch - '0').to(int)
    }
    return value
}

// Renders every code span and swaps every link and image target for a placeholder, in
// one scan, so neither rewrites the other: markers inside a code span are not
// formatting, and a URL holds no inline formatting of its own.
fn protect_line(line: String, spans: Array[String], targets: Array[String]) String {
    let result = line
    // Same tables and the same rebuilt line as in `line_format_all`
    let bracket_pairs = pair_matches(line, '[', ']')
    let paren_pairs = pair_matches(line, '(', ')')
    let shift: int = 0
    let i: uint = 0
    while i < result.length {
        let ch = result.get(i)
        if ch == '`' {
            let marker = result.get(i + 1) == '`' ? "``" : "`"
            let close = result.index_of(marker, i + marker.length) !? uint.$max
            if close == uint.$max {
                // An unclosed backtick stays literal
                i += marker.length
                continue
            }
            spans.append("<code>" + result.range(i + marker.length, close - i - marker.length) + "</code>")
            let text = placeholder(PLACEHOLDER_CODE, spans.length - 1)
            shift = shift + text.length.to(int) - (close + marker.length - i).to(int)
            result = result.range(0, i) + text + result.range(close + marker.length, result.length - close - marker.length)
            i += text.length
            continue
        }
        if ch == '[' {
            let p2 = bracket_pairs.get((i.to(int) - shift).to(uint)) !? uint.$max
            if p2 != uint.$max {
                let p2c = (p2.to(int) + shift).to(uint)
                if result.get(p2c + 1) == '(' {
                    let p3 = paren_pairs.get(p2 + 1) !? uint.$max
                    if p3 != uint.$max {
                        let p3c = (p3.to(int) + shift).to(uint)
                        let text = placeholder(PLACEHOLDER_TARGET, targets.length)
                        targets.append(result.range(p2c + 2, p3c - p2c - 2))
                        shift = shift + text.length.to(int) - (p3c - p2c - 2).to(int)
                        result = result.range(0, p2c + 2) + text + result.range(p3c, result.length - p3c)
                        i = p2c + 2 + text.length
                        continue
                    }
                }
            }
        }
        i++
    }
    return result
}

// Returns the target a placeholder stands for, or the text itself when it holds no
// placeholder (a target may be only part of a longer URL).
fn target_value(text: String, targets: Array[String]) String {
    let index = placeholder_index(text, PLACEHOLDER_TARGET)
    if index < 0 : return text
    return targets.get(index.to(uint)) !? text
}

fn restore_placeholders(line: String, values: Array[String], kind: u8) String {
    let result = line
    let i: uint = 0
    while i < values.length {
        result = result.replace(placeholder(kind, i), values.get(i) ! break)
        i++
    }
    return result
}

// The end of the pair an opener starts: the closer that brings the nesting back to the
// level just inside it. Scanning forward from every candidate repeats that on a line
// with many brackets; a closer ends the innermost opener still open, so one stack pass
// over the line records the closer of every opener at once.
fn pair_matches(line: String, open: u8, close: u8) HashMap[uint, uint] {
    let matches = HashMap[uint, uint].new()
    let stack = Array[uint].new()
    let i: uint = 0
    while i < line.length {
        let ch = line.get(i)
        if ch == open {
            stack.append(i)
        } else if ch == close {
            // A closer with nothing open is literal text, not the end of a pair
            let start = stack.pop_last() !? uint.$max
            if start != uint.$max : matches.set(start, i)
        }
        i++
    }
    return matches
}

// Whether every tag in `text` is opened and closed inside it, and no closing tag
// is left over. Only the tags this formatter writes can appear — raw HTML from the
// input is escaped — so a stray one means the inline passes put it there.
fn tags_balanced(text: String) bool {
    let stack = Array[String].new(8)
    let bytes = text.bytes
    let offset: uint = 0
    while offset < bytes {
        if text.get(offset++) != '<' : continue
        let closing = offset < bytes && text.get(offset) == '/'
        if closing : offset++
        let start = offset
        while offset < bytes {
            let ch = text.get(offset)
            if !ch.is_alpha_numeric() : break
            offset++
        }
        if offset == start : return false
        let name = text.range(start, offset - start)
        while offset < bytes && text.get(offset) != '>' : offset++
        if offset >= bytes : return false
        let self_closing = text.get(offset - 1) == '/'
        offset++
        if self_closing : continue
        if closing {
            if stack.length == 0 || (stack.get(stack.length - 1) !? "") != name : return false
            stack.pop_last() _
            continue
        }
        // Void elements carry no end tag
        if name.equals_ignore_ascii_case("br") || name.equals_ignore_ascii_case("hr") || name.equals_ignore_ascii_case("img") : continue
        stack.append(name)
    }
    return stack.length == 0
}

fn line_format(line: String, find1: String, find2: String, before: String, after: String, no_ascii: bool (false)) String {
    let fl1 = find1.length
    let fl2 = find2.length
    let from: uint = 0
    while true {
        let p1 = line.index_of(find1, from) ! break
        if p1 > 0 && no_ascii && line.get(p1 - 1).is_alpha_numeric() : break
        // Searching from p1 + 1 let the closing marker match inside the opening one on
        // a run of markers, which made the length below wrap and the loop grow forever
        let p2 = line.index_of(find2, p1 + fl1) ! break
        if p2 + fl2 < line.length && no_ascii && line.get(p2 + fl2).is_alpha_numeric() : break
        // A run longer than the closing marker leaves its other markers behind, and a
        // span that leaves one of them unpaired is closed by the inner pass instead:
        // close on the run's last marker, or the two spans would cross
        let marker = find2.get(0)
        if fl2 > 1 && find1 == find2 && marker == find2.get(fl2 - 1) {
            let run_end = p2 + fl2
            while run_end < line.length && line.get(run_end) == marker : run_end++
            if run_end > p2 + fl2 {
                let unpaired: uint = 0
                let scan = p1 + fl1
                while scan < p2 {
                    if line.get(scan) == marker : unpaired++
                    scan++
                }
                if unpaired % 2 == 1 : p2++
            }
        }
        let s1 = line.range(0, p1)
        let s2 = line.range(p1 + fl1, p2 - p1 - fl1)
        // A span that holds a stray tag — one opened inside it and closed after, or
        // the other way around — cannot be wrapped without crossing that tag's span
        if !tags_balanced(s2) {
            from = p1 + fl1
            continue
        }
        let s3 = line.range(p2 + fl2, line.length - p2 - fl2)
        line = "%s1%before%s2%after%s3"
        from = 0
    }
    return line
}

fn is_numbered_li(line: String) bool {
    let i: uint = 0
    while true {
        let ch = line.get(i++)
        if ch.is_number() : continue
        if ch == '.' && line.get(i) == ' ' && i > 1 : return true
        return false
    }
}

fn parse_scope(html: ByteBuffer, line: String, state: State) String {
    let current = state.scopes.get(state.scopes.length - 1) !? LT.empty

    if current == LT.code : return line

    // Check leading whitespace
    let linespaces: uint = 0
    let whitespace_chars: uint = 0
    let i = 0
    while true {
        let ch = line.get(i++)
        if ch == ' ' { linespaces++; whitespace_chars++ }
        else if ch == '\t' { linespaces += 3; whitespace_chars++ }
        else : break
    }

    // Spaces until in list item
    let scope_same_count = 0
    let cut = 0
    each state.li_starts as pos {
        if linespaces >= pos {
            cut = pos
            while true {
                let scope = state.scopes.get(scope_same_count++) ! break
                if scope == LT.li : break
            }
        }
    }
    // `cut` is a column count from the item starts, but a tab is one byte and three
    // columns: cutting that many bytes dropped the tab and the marker after it
    if cut > 0 {
        let columns: uint = 0
        let bytes: uint = 0
        while columns < cut && bytes < line.length {
            let ch = line.get(bytes)
            if ch == ' ' : columns++
            else if ch == '\t' : columns += 3
            else : break
            bytes++
        }
        line = line.range(bytes, line.length)
        state.offset = bytes
    }

    // Progress scopes
    i = 0
    while i < line.length {
        let ch = line.get(i++)
        if ch == ' ' || ch == '\t' : continue
        if ch == '>' && (state.scopes.get(scope_same_count) !? LT.empty) == LT.blockquote {
            scope_same_count++
            continue
        }
        i--
        break
    }
    line = line.range(i, line.length)
    state.offset += i

    // Get type of line remainder
    let type = line_type(line)
    if type >= LT.ul1 && type <= LT.ol {
        current = state.scopes.get(scope_same_count) !? LT.empty
        if type == current : scope_same_count++
    }

    // Close un-used scopes
    close_scopes(state, html, scope_same_count)

    return line
}

fn close_scopes(state: State, html: ByteBuffer, keep: uint) {
    let amount = state.scopes.length - keep
    if amount > 0 : dump_text(state, html)
    //
    while amount-- > 0 {
        let scope = state.scopes.pop_last() ! panic("Missing scope (bug)")

        if state.use_para {
            indent(state, html)
        } else {
            state.use_para = true
        }

        if scope == LT.blockquote : html.write("</blockquote>")
        else if scope == LT.code : html.write("</code></pre>")
        else if scope == LT.li {
            state.li_starts.pop_last() _
            html.write("</li>")
        }
        else if scope >= LT.ul1 && scope <= LT.ul3 : html.write("</ul>")
        else if scope == LT.ol : html.write("</ol>")
        else : panic("Unknown scope (bug): " + scope)
    }
}

fn trim_whitespace(line: String) String {
    let len = line.length
    let from = 0
    let until = len
    while from < len {
        let ch = line.get(from)
        if !ch.is_whitespace() : break
        from++
    }
    while until > from {
        let ch = line.get(until - 1)
        if !ch.is_whitespace() : break
        until--
    }
    return line.range(from, until - from)
}

fn skip_part_and_spaces(state: State, line: String, start: uint) String {
    let i = start
    let len = line.length
    while i < len {
        let ch = line.get(i)
        if ch != ' ' && ch != '\t' : break
        i++
    }
    state.offset += i
    return line.range(i, line.length)
}

fn dump_text(state: State, html: ByteBuffer) {
    if state.text_lines.length == 0 : return
    if state.use_para {
        let pclass = state.paragraph_class
        indent(state, html)
        if isset(pclass) {
            let class_name = escape_text(pclass)
            html.write("<p class=\"%{class_name}\">")
        } else {
            html.write("<p>")
        }
    }
    each state.text_lines as text, index {
        if index > 0 : html.write("<br>")
        html.write(unescape_markers(line_format_all(text, state.allowed_schemes)))
    }
    if state.use_para {
        html.write("</p>")
    }
    state.text_lines.clear()
}

fn indent(state: State, html: ByteBuffer) {
    html.write("\n")
    each state.li_starts as li {
        html.write("  ")
    }
}

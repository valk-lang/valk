
use json

+ global default_translations : Map[String] (.{
    "string_invalid" => "Invalid value"
    "string_min" => "Must be atleast $1 characters long"
    "string_max" => "Cannot be longer than $1 characters"
    "string_email" => "Invalid email address"
    "string_equal" => "Must be equal to '$1'"
    "string_lower" => "Cannot contain uppercase characters"
    "string_upper" => "Cannot contain lowercase characters"
    "string_username" => "Invalid username"
    "bool_invalid" => "Invalid value"
    "int_invalid" => "Invalid value"
    "int_min" => "Minimum value is $1"
    "int_max" => "Maximum value is $1"
    "float_invalid" => "Invalid value"
    "float_min" => "Minimum value is $1"
    "float_max" => "Maximum value is $1"
    "array_invalid" => "Invalid value"
    "array_min" => "Missing items (min: $1)"
    "array_max" => "Too many items (max: $1)"
    "object_invalid" => "Invalid value"
    "object_min" => "Missing values"
    "object_max" => "Too many values"
    "object_missing_field" => "Field should not be empty"
})

+ class Field {
    type: json:Kind
    s_null: bool (false)
    s_optional: bool (false)
    s_min: ?int
    s_max: ?int
    s_fmin: ?float
    s_fmax: ?float
    s_lower: bool (false)
    s_upper: bool (false)
    custom_validators: ?Array[fn(json:Value)(bool)]
    custom_errors: ?Array[String]
    array_field: ?Field
    object_fields: ?Map[Field]
    s_equals_string: ?String
    default_value: json:Value (null)

    + fn get_form_rules() json:Value {
        let res = json:object()
        if this.type == json:Kind.object {
            let fields = this.object_fields
            if !isset(fields) : return res
            each fields as subf, name {
                res.set(name, subf.get_form_rules())
            }
            return res
        }
        let min = this.s_min
        let max = this.s_max
        if isset(min) : res.set("min", min)
        if isset(max) : res.set("max", max)
        if this.type == json:Kind.string {
            if this.s_lower : res.set("lower", true)
            if this.s_upper : res.set("upper", true)
        }
        return res
    }

    + static fn string() SELF {
        return Field {
            type: json:Kind.string
        }
    }
    + static fn bool() SELF {
        return Field {
            type: json:Kind.bool
        }
    }
    + static fn int() SELF {
        return Field {
            type: json:Kind.int
        }
    }
    + static fn float() SELF {
        return Field {
            type: json:Kind.float
        }
    }
    + static fn array(of: ?Field) SELF {
        return Field {
            type: json:Kind.array
            array_field: of
        }
    }
    + static fn object(fields: ?Map[Field]) SELF {
        return Field {
            type: json:Kind.object
            object_fields: fields
        }
    }

    + fn nullable(value: bool (true)) SELF {
        this.s_null = value
        return this
    }
    + fn optional(value: bool (true)) SELF {
        this.s_optional = value
        return this
    }
    + fn default(val: $T) SELF {
        let v = json:from(val)
        this.default_value = v
        return this
    }
    + fn min(val: int) SELF {
        this.s_min = val
        return this
    }
    + fn max(val: int) SELF {
        this.s_max = val
        return this
    }
    + fn fmin(val: int) SELF {
        this.s_fmin = val
        return this
    }
    + fn fmax(val: int) SELF {
        this.s_fmax = val
        return this
    }
    + fn lower(val: bool (true)) SELF {
        this.s_lower = val
        return this
    }
    + fn upper(val: bool (true)) SELF {
        this.s_upper = val
        return this
    }
    + fn email() SELF {
        this.custom(fn(v: json:Value) bool {
            if !v.is_string() : return false
            return email(v.string_or(""))
        }, "string_email")
        return this
    }
    + fn username(numbers: bool, underscore: bool) SELF {
        this.custom(fn(v: json:Value) bool {
            if !v.is_string() : return false
            each v.string_or("") as ch {
                if ch.is_alpha() : continue
                if ch.is_number() && numbers : continue
                if ch == '_' && underscore : continue
                return false
            }
            return true
        }, "string_username")
        return this
    }
    + fn is_syntax(mask: String, mask_is_exclude: bool (false)) SELF {
        this.custom(fn(v: json:Value) bool {
            if !v.is_string() : return false
            return v.string_or("").is_syntax(mask, mask_is_exclude)
        }, "string_syntax")
        return this
    }
    + fn equals_string(str: ?String) SELF {
        this.s_equals_string = str
        return this
    }

    + fn custom(func: fn(json:Value)(bool), error: String) SELF {
        let cv = this.custom_validators ?? <{ let a = Array[fn(json:Value)(bool)]{}; this.custom_validators = a; return a }
        let ce = this.get_custom_errors()
        cv.append(func)
        ce.append(error)
        return this
    }

    fn get_custom_errors() Array[String] {
        return this.custom_errors ?? <{ let a = Array[String]{}; this.custom_errors = a; return a }
    }

    + fn validate(data: json:Value, errors: ?Map[String] (null), field_name: ?String (null)) bool {
        let field = field_name ?? "field"
        // Null check
        if this.s_null && data.is_null() : return true
        // Custom validators
        let cv = this.custom_validators
        if isset(cv) {
            let ce = this.get_custom_errors()
            each cv as func, i {
                if !func(data) {
                    if isset(errors) : errors.set(field, ce.get(i) !? "custom_error")
                    return false
                }
            }
        }
        //
        let type = this.type
        if type == json:Kind.string {
            return this.validate_string(data, errors, field)
        } else if type == json:Kind.bool {
            return this.validate_bool(data, errors, field)
        } else if type == json:Kind.int {
            return this.validate_int(data, errors, field)
        } else if type == json:Kind.float {
            return this.validate_float(data, errors, field)
        } else if type == json:Kind.array {
            return this.validate_array(data, errors, field)
        } else if type == json:Kind.object {
            return this.validate_object(data, errors, field)
        }

        if isset(errors) : errors.set(field_name ?? "field", "unknown_type")
        return false
    }

    + fn validate_and_translate(data: json:Value, errors: Map[String], translations: Map[String] (default_translations)) bool {
        let valid = this.validate(data, errors)
        Field.translate_errors(errors, translations)
        return valid
    }

    /////////////////////
    // Casting
    /////////////////////

    + fn try_cast(data: json:Value) json:Value {
        let to = this.type
        let from = data.kind()
        if to == json:Kind.string {
            if from == json:Kind.bool : return json:from(data.bool_or(false) ? "true" : "false")
            if from == json:Kind.int || from == json:Kind.float : return json:from(json:stringify(data))
            if from == json:Kind.null : return json:from("")
            if from == json:Kind.string {
                let text = data.string_or("")
                if this.s_lower && !text.is_lower() : data = json:from(text.lower())
                if this.s_upper && !text.is_upper() : data = json:from(text.upper())
            }

        } else if to == json:Kind.bool {
            if from == json:Kind.string {
                let text = data.string_or("")
                if text == "true" : return json:from(true)
                if text == "false" : return json:from(false)
            }
            if from == json:Kind.int {
                let number = data.int_or(0)
                if number == 1 : return json:from(true)
                if number == 0 : return json:from(false)
            }
            if from == json:Kind.null : return json:from(false)

        } else if to == json:Kind.int {
            if from == json:Kind.string : return json:from(data.string_or("").to_int() ! return data)
            if from == json:Kind.bool : return json:from(data.bool_or(false) ? 1 : 0)
            if from == json:Kind.float : return json:from(data.float_or(0.0).to(int))
            if from == json:Kind.null : return json:from(0)

        } else if to == json:Kind.float {
            if from == json:Kind.string : return json:from(data.string_or("").to_float() ! return data)
            if from == json:Kind.bool : return json:from(data.bool_or(false) ? 1.0 : 0.0)
            if from == json:Kind.int : return json:from(data.int_or(0).to(float))
            if from == json:Kind.null : return json:from(0.0)

        } else if to == json:Kind.array {
            let subf = this.array_field
            if isset(subf) {
                match data {
                    null => {}
                    json:ArrayValue as array => {
                        let new_items = Array[json:Value]{}
                        each array.values as item : new_items.append(subf.try_cast(item))
                        return json:array(new_items)
                    }
                    default => {}
                }
            }
        } else if to == json:Kind.object {
            let subfs = this.object_fields
            if isset(subfs) {
                match data {
                    null => {}
                    json:ObjectValue as object => {
                        let res = json:object()
                        each subfs as subf, name {
                            let v = object.get(name) ! {
                                let defv = subf.default_value
                                if isset(defv) : res.set(name, subf.try_cast(defv))
                                else if !subf.s_optional : res.set(name, json:default_value(subf.type))
                                continue
                            }
                            res.set(name, subf.try_cast(v))
                        }
                        return res
                    }
                    default => {}
                }
            }
        }
        return data
    }

    /////////////////////
    // Validate
    /////////////////////

    fn validate_string(data: json:Value, errors: ?Map[String], field_name: String) bool {
        if !data.is_string() {
            if isset(errors) : errors.set(field_name, "string_invalid")
            return false
        }
        let min = this.s_min
        let max = this.s_max
        let eqstr = this.s_equals_string
        let strv = data.string_or("")
        let len = strv.length
        if isset(min) && len < min {
            if isset(errors) : errors.set(field_name, "string_min:" + min)
            return false
        }
        if isset(max) && len > max {
            if isset(errors) : errors.set(field_name, "string_max:" + max)
            return false
        }
        if isset(eqstr) && strv != eqstr {
            if isset(errors) : errors.set(field_name, "string_equal:" + eqstr)
            return false
        }
        if this.s_lower && !strv.is_syntax("A", true) {
            if isset(errors) : errors.set(field_name, "string_lower")
            return false
        }
        if this.s_upper && !strv.is_syntax("a", true) {
            if isset(errors) : errors.set(field_name, "string_upper")
            return false
        }
        return true
    }

    fn validate_bool(data: json:Value, errors: ?Map[String], field_name: String) bool {
        if !data.is_bool() {
            if isset(errors) : errors.set(field_name, "bool_invalid")
            return false
        }
        return true
    }

    fn validate_int(data: json:Value, errors: ?Map[String], field_name: String) bool {
        if !data.is_int() {
            if isset(errors) : errors.set(field_name, "int_invalid")
            return false
        }
        let min = this.s_min
        let max = this.s_max
        let val = data.int_or(0)
        if isset(min) && val < min {
            if isset(errors) : errors.set(field_name, "int_min:" + min)
            return false
        }
        if isset(max) && val > max {
            if isset(errors) : errors.set(field_name, "int_max:" + max)
            return false
        }
        return true
    }

    fn validate_float(data: json:Value, errors: ?Map[String], field_name: String) bool {
        if !data.is_float() {
            if isset(errors) : errors.set(field_name, "float_invalid")
            return false
        }
        let min = this.s_min
        let max = this.s_max
        let fmin = this.s_fmin
        let fmax = this.s_fmax
        let val = data.float_or(0.0)
        if isset(min) && val < min {
            if isset(errors) : errors.set(field_name, "float_min:" + min)
            return false
        }
        if isset(fmin) && val < fmin {
            if isset(errors) : errors.set(field_name, "float_min:" + fmin)
            return false
        }
        if isset(max) && val > max {
            if isset(errors) : errors.set(field_name, "float_max:" + max)
            return false
        }
        if isset(fmax) && val > fmax {
            if isset(errors) : errors.set(field_name, "float_max:" + fmax)
            return false
        }
        return true
    }

    fn validate_array(data: json:Value, errors: ?Map[String], field_name: String) bool {
        if !data.is_array() {
            if isset(errors) : errors.set(field_name, "array_invalid")
            return false
        }
        let min = this.s_min
        let max = this.s_max
        let items = data.array_or_empty().values
        let len = items.length
        if isset(min) && len < min {
            if isset(errors) : errors.set(field_name, "array_min:" + min)
            return false
        }
        if isset(max) && len > max {
            if isset(errors) : errors.set(field_name, "array_max:" + max)
            return false
        }
        let subf = this.array_field
        if isset(subf) {
            let is_valid = true
            each items as item, i {
                if !subf.validate(item, errors, "%field_name.%i") : is_valid = false
            }
            if !is_valid : return false
        }
        return true
    }

    fn validate_object(data: json:Value, errors: ?Map[String], field_name: String) bool {
        if !data.is_object() {
            if isset(errors) : errors.set(field_name, "object_invalid")
            return false
        }
        let min = this.s_min
        let max = this.s_max
        let odata = data.object_or_empty()
        let len = odata.length()
        if isset(min) && len < min {
            if isset(errors) : errors.set(field_name, "object_min:" + min)
            return false
        }
        if isset(max) && len > max {
            if isset(errors) : errors.set(field_name, "object_max:" + max)
            return false
        }
        let fields = this.object_fields
        if isset(fields) {
            let is_valid = true
            each fields as subf, fname {
                let fdata = odata.get(fname) ! {
                    if isset(errors) : errors.set("%field_name.%fname", "object_missing_field")
                    is_valid = false
                    continue
                }
                if !subf.validate(fdata, errors, "%field_name.%fname") : is_valid = false
            }
            if !is_valid : return false
        }
        return true
    }

    /////////////////////
    // Translate
    /////////////////////

    + static fn translate_errors(errors: Map[String], translations: Map[String] (default_translations)) {
        each errors as err, k {
            let parts = err.split(":")
            let name = parts.pop_first() ! continue
            let new = translations.get(name) ! continue
            each parts as val, i {
                new = new.replace("$%{i + 1}", val)
            }
            errors.set(k, new)
        }
    }
}

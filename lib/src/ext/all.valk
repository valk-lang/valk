
// Calls callback(sp, ctx) with the callee-saved registers pushed above sp
extern fn valk_gc_scan_stack(callback: ptr, ctx: ptr) void $nonblocking;
// Installs the collector callback(sp, kind), where kind is 0 (local) or 1 (shared)
extern fn valk_gc_set_entry(entry: ptr) void $nonblocking;
// Collects with the caller's registers pushed; bound to gc.collect()
extern fn valk_gc_collect() void $nonblocking;
extern fn valk_gc_collect_shared() void $nonblocking;
// Grove-MT's native brackets (linux-x64): `ctl` is the thread's control block, or null
extern fn valk_gc_native_enter(ctl: ?ptr) void $nonblocking;
extern fn valk_gc_native_leave(ctl: ?ptr) void $nonblocking;
// Installs the routine valk_gc_native_leave calls while the thread is held by a round
extern fn valk_gc_set_leave_slow(handler: ptr) void $nonblocking;
// A compare-and-swap of a word: returns the word's old value
extern fn valk_gc_cas(address: ptr, expected: uint, desired: uint) uint $nonblocking;
link ":valk-stack-swap.o"
#if OS != "win"
extern fn valk_stack_swap(from: ptr, to: ptr) void $nonblocking;
#else
extern fn valk_gc_stack_base() ptr;
#end

#if OS == "linux"

link dynamic "pthread"
link dynamic "c"
// Float remainders lower to fmod
link dynamic "m"
link "uring"
// glibc publishes no dynamic form of this one, so it is the exception.
link "libc_nonshared.a"
#if ARCH == "x64"
link dynamic "ld-linux-x86-64.so.2"
#else
link dynamic "ld-linux-aarch64.so.1"
#end

#elif OS == "macos"

link dynamic "System"

#elif OS == "win"

link dynamic "kernel32"
link dynamic "wsock32"
link dynamic "ws2_32"
link dynamic "ntdll"
link dynamic "ucrt"
link dynamic "bcrypt"
link "libvcruntime"
link "libcmt" // c-runtime startup

#end


// Calls callback(sp, ctx) with the callee-saved registers pushed above sp
extern fn valk_gc_scan_stack(callback: ptr, ctx: ptr);
// Installs the collector entry that valk_gc_collect() calls with the stack pointer
extern fn valk_gc_set_entry(entry: ptr);
// Collects with the caller's registers pushed; bound to gc.collect()
extern fn valk_gc_collect();
link ":valk-stack-swap.o"
#if OS != "win"
extern fn valk_stack_swap(from: ptr, to: ptr);
#else
extern fn valk_gc_stack_base() ptr;
#end

#if OS == "linux"

link dynamic "pthread"
link dynamic "c"
link "uring"
// glibc publishes no dynamic form of this one, so it is the exception.
link "libc_nonshared.a"
link dynamic "ld-linux-x86-64.so.2"

#elif OS == "macos"

link dynamic "System"

#elif OS == "win"

link dynamic "kernel32"
link dynamic "wsock32"
link dynamic "ws2_32"
link dynamic "ntdll"
link dynamic "ucrt"
link dynamic "bcrypt"
link "libvcruntime"
link "libcmt" // c-runtime startup

#end

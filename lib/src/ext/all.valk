
extern fn valk_stack_swap(from: ptr, to: ptr);

// Link
link ":valk-stack-swap.o"

// Only libraries the OS itself provides are pinned to `dynamic`: those are
// always present, so there is nothing for --static to decide. Everything else
// stays on `auto` so the build's static dependency mode keeps control over it.
#if OS == "linux"

link dynamic "pthread"
link dynamic "c"
link "uring"
// glibc publishes no dynamic form of this one, so it is the exception.
link "libc_nonshared.a"
// Not redundant with --dynamic-linker: the bundled libpthread.so imports
// _dl_make_stack_executable@GLIBC_PRIVATE, which only the loader defines.
// A generated stub would drop that import and this line with it.
link dynamic "ld-linux-x86-64.so.2"

#elif OS == "macos"

link dynamic "System"

#elif OS == "win"

link dynamic "kernel32"
link dynamic "wsock32"
link dynamic "ws2_32"
link dynamic "ntdll"
// The UCRT is an OS component on Windows 10+, so it is imported rather than
// linked in. vcruntime is not: it ships with the VC++ redistributable, so the
// static libvcruntime/libcmt stay, and the output needs no redistributable.
link dynamic "ucrt"
link "libvcruntime"
link "libcmt" // c-runtime startup

#end

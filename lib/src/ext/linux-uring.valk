
#if OS == "linux"
/// Mirrors the kernel `struct io_uring_sqe` (64 bytes): one submission queue entry,
/// filled in by `io`.
+ struct io_uring_sqe {
    /// Operation (`IORING_OP`).
    + opcode: u8
    /// `IOSQE_*` flags.
    + flags: u8
    /// I/O priority; some operations reuse it for their own flags.
    + ioprio: u16
    /// Target file descriptor, or a registered file index with `IOSQE_FIXED_FILE`.
    + fd: i32
    /// File offset; aka `addr2`.
    + off: u64
    /// Buffer address or pointer argument; aka `splice_off_in`.
    + addr: u64
    /// Buffer size in bytes, or number of iovecs.
    + len: u32
    /// Per-operation flags (`rw_flags`, `msg_flags`, `accept_flags`, ...).
    + rw_flags: u32
    /// Opaque value copied to the completion's `user_data`.
    + user_data: u64
    /// Registered buffer index; aka `buf_group` with buffer selection.
    + buf_index: u16
    /// Registered credentials ID, 0 for the current ones.
    + personality: u16
    /// Direct descriptor slot; aka `splice_fd_in`.
    + file_index: u32
    /// `addr3` and trailing padding.
    + pad2: [u64 x 2]
    // pad: [u8 x 8]
}

/// Mirrors the kernel `struct io_uring_cqe`: one completion queue entry.
+ struct io_uring_cqe {
    /// The `user_data` of the submission this completes.
    + user_data: u64
    /// Result: the operation's return value, or a negative errno.
    + res: i32
    /// `IORING_CQE_F_*` flags.
    + flags: u32
}

/// Mirrors liburing `struct io_uring_sq`: the submission ring's mapped pointers
/// and local state.
+ struct io_uring_sq {
    /// Head index, advanced by the kernel as it consumes entries.
    + khead: *u32
    /// Tail index, advanced by the application to submit.
    + ktail: *u32
    /// Mask that turns an index into a ring slot.
    + kring_mask: *u32
    /// Number of ring entries.
    + kring_entries: *u32
    /// `IORING_SQ_*` status flags (e.g. `IORING_SQ_NEED_WAKEUP`).
    + kflags: *u32
    /// Number of invalid entries the kernel dropped.
    + kdropped: *u32
    /// Index array mapping ring slots to entries in `sqes`.
    + array: *u32
    /// The submission queue entries.
    + sqes: *io_uring_sqe
    /// Local head: first entry not yet submitted to the kernel.
    + sqe_head: u32
    /// Local tail: next entry `io_uring_get_sqe` hands out.
    + sqe_tail: u32
    /// Size of the mmap'd ring in bytes.
    + ring_sz: uint
    /// Start of the mmap'd ring.
    + ring_ptr: ptr
    /// Cached ring mask/entry count and padding, used by liburing.
    + pad: [u32 x 4]
}

/// Mirrors liburing `struct io_uring_cq`: the completion ring's mapped pointers.
+ struct io_uring_cq {
    /// Head index, advanced by the application as it consumes completions.
    + khead: *u32
    /// Tail index, advanced by the kernel as it posts completions.
    + ktail: *u32
    /// Mask that turns an index into a ring slot.
    + kring_mask: *u32
    /// Number of ring entries.
    + kring_entries: *u32
    /// `IORING_CQ_*` flags.
    + kflags: *u32
    /// Number of completions dropped because the ring was full.
    + koverflow: *u32
    /// The completion queue entries.
    + cqes: *io_uring_cqe
    /// Size of the mmap'd ring in bytes.
    + ring_sz: uint
    /// Start of the mmap'd ring.
    + ring_ptr: ptr
    /// Cached ring mask/entry count and padding, used by liburing.
    + pad: [u32 x 4]
}

/// Mirrors liburing `struct io_uring`: one ring, set up by `io_uring_queue_init`; used
/// by `io` and `coro` on Linux.
+ struct io_uring {
    /// Submission queue.
    + sq: io_uring_sq (@undefined)
    /// Completion queue.
    + cq: io_uring_cq (@undefined)
    /// Setup flags (`IORING_SETUP_*`).
    + flags: u32 (@undefined)
    /// File descriptor of the ring.
    + ring_fd: i32 (@undefined)
    /// `IORING_FEAT_*` bits reported by the kernel.
    + features: u32 (@undefined)
    /// liburing-internal fields (`enter_ring_fd`, `int_flags`) and padding.
    + pad: [u32 x 3] (@undefined)
}

enum IOSQE {
    FIXED_FILE_BIT
    IO_DRAIN_BIT
    IO_LINK_BIT
    IO_HARDLINK_BIT
    ASYNC_BIT
    BUFFER_SELECT_BIT
}

enum IORING_OP {
    NOP
    READV
    WRITEV
    FSYNC
    READ_FIXED
    WRITE_FIXED
    POLL_ADD
    POLL_REMOVE
    SYNC_FILE_RANGE
    SENDMSG
    RECVMSG
    TIMEOUT
    TIMEOUT_REMOVE
    ACCEPT
    ASYNC_CANCEL
    LINK_TIMEOUT
    CONNECT
    FALLOCATE
    OPENAT
    CLOSE
    FILES_UPDATE
    STATX
    READ
    WRITE
    FADVISE
    MADVISE
    SEND
    RECV
    OPENAT2
    EPOLL_CTL
    SPLICE
    PROVIDE_BUFFERS
    REMOVE_BUFFERS
    TEE
    SHUTDOWN
    RENAMEAT
    UNLINKAT
    MKDIRAT
    SYMLINKAT
    LINKAT
    MSG_RING
    FSETXATTR
    SETXATTR
    FGETXATTR
    GETXATTR
    SOCKET
    URING_CMD
    SEND_ZC
    SENDMSG_ZC
    READ_MULTISHOT
    WAITID
    FUTEX_WAIT
    FUTEX_WAKE
    FUTEX_WAITV
    FIXED_FD_INSTALL
    FTRUNCATE
    BIND
    LISTEN
    RECV_ZC
    EPOLL_WAIT
    READV_FIXED
    WRITEV_FIXED
    PIPE
    NOP128
    URING_CMD128
    LAST
}

enum IORING_SQE_FLAGS {
    FIXED_FILE_BIT
    IO_DRAIN_BIT
    IO_LINK_BIT
    IO_HARDLINK_BIT
    ASYNC_BIT
    BUFFER_SELECT_BIT
    CQE_SKIP_SUCCESS_BIT
}

// Init
extern fn io_uring_queue_init(entries: u32, ring: *io_uring, flags: u32) i32;
extern fn io_uring_queue_exit(ring: *io_uring);
// Register file descriptors
extern fn io_uring_register_files(ring: *io_uring, files: *i32, nr_files: u32) i32;
// Submit
extern fn io_uring_submit_and_wait(ring: *io_uring, wait_nr: u32) i32;
extern fn io_uring_submit(ring: *io_uring) i32;
// Submission queue events (sqe)
extern fn io_uring_get_sqe(ring: *io_uring) ?*io_uring_sqe;
extern fn io_uring_sqe_set_flags(ring: *io_uring_sqe, flags: u32);
// Completion queue events (cqe)
extern fn __io_uring_get_cqe(ring: *io_uring, cqe_ptr: *?*io_uring_cqe, submit: u32, wait_nr: u32, sigmask: ?ptr) i32;
#end

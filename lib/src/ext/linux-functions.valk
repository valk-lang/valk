#if OS == "linux"
extern shared stderr: ?FILE;
extern shared stdin: ?FILE;
extern shared stdout: ?FILE;

/// The C `pid_t` process id type.
alias pid_t for i32

/// An opaque C `FILE *` stream handle.
alias FILE for ptr

/// An opaque C `DIR *` directory stream handle, from `opendir`.
alias DIR for ptr

/// The `addrinfo` layout `net` passes to `getaddrinfo`; on this OS it is `libc_gen_addrinfo`.
alias libc_addrinfo_fix for libc_gen_addrinfo

extern fn malloc(size: uint) ptr;
extern fn free(adr: ptr) void;
extern fn mmap(address: ?ptr, length: uint, protection: i32, flags: i32, fd: i32, offset: int) ptr;
extern fn mprotect(address: ptr, length: uint, protection: i32) i32;
extern fn munmap(address: ptr, length: uint) i32;

extern fn exit(code: i32) void $exit;
extern fn _exit(code: i32) void $exit;
extern fn signal(signum: i32, handler: ptr) ptr;
extern fn raise(sig: i32) i32;
extern fn __errno_location() *i32;

/// Mirrors glibc `struct sigaction` on linux-x64; passed to `sigaction` by `coro`
/// (stack overflow handler) and `signal`.
+ struct sigaction_t {
    /// Handler (`sa_handler`, or `sa_sigaction` with `SA_SIGINFO`); 0 is `SIG_DFL`, 1 is `SIG_IGN`.
    + handler: ptr
    /// Signals blocked while the handler runs (`sa_mask`, a 1024-bit `sigset_t`).
    + mask: [u64 x 16] ({ 0... })
    /// `SA_*` flags, e.g. `SA_SIGINFO`, `SA_ONSTACK`.
    + flags: i32 (0)
    /// `sa_restorer`; filled in by libc, leave null.
    + restorer: ?ptr (null)
}
/// Mirrors glibc `stack_t` on Linux: the alternate signal stack passed to `sigaltstack`
/// by `coro`.
+ struct stack_t {
    /// Lowest address of the stack memory (`ss_sp`).
    + sp: ptr
    /// `SS_*` flags (`ss_flags`); 0 enables the stack.
    + flags: i32 (0)
    /// Size of the stack in bytes (`ss_size`).
    + size: uint
}
value SA_ONSTACK (0x08000000)
value SA_SIGINFO (4)
value SA_NODEFER (0x40000000)
value SIGBUS (7)
value SIGSEGV (11)
extern fn sigaction(sig: i32, action: *sigaction_t, old: ?ptr) i32;
extern fn sigaltstack(stack: *stack_t, old: ?ptr) i32;

/// Returns the calling thread's C `errno` value.
+ fn get_errno() i32 {
    return @ptrv(__errno_location(), i32)
}

/// Sets the calling thread's C `errno` to `value`.
+ fn set_errno(value: i32) {
    @ptrv(__errno_location(), i32) = value
}
extern fn getenv(key: cstring) ?cstring;
extern fn setenv(key: cstring, value: cstring, overwrite: i32) i32;
extern fn unsetenv(key: cstring) i32;
extern fn sysconf(name: i32) int;
extern fn fork() pid_t;
extern fn waitpid(pid: pid_t, status_ptr: *i32, options: i32) pid_t;
extern fn kill(pid: pid_t, sig: i32) i32;
extern fn getpid() pid_t;
extern fn execv(path: cstring, args: *?cstring) i32;
extern fn execvp(path: cstring, args: *?cstring) i32;
extern fn execve(path: cstring, argv: *?cstring, envp: ptr) i32;

extern fn sync() void;
extern fn fsync(fd: i32) i32;
extern fn fdatasync(fd: i32) i32;
extern fn read(fd: i32, buf: ptr, size: uint) int;
extern fn pread(fd: i32, buf: ptr, size: uint, offset: i64) int;
extern fn pwrite(fd: i32, buf: ptr, size: uint, offset: i64) int;
extern fn write(fd: i32, data: ptr, length: uint) int;
extern fn getrandom(buffer: ptr, length: uint, flags: u32) int;
extern fn open(path: ptr, flags: i32, ...) i32;
extern fn close(fd: i32) i32;
extern fn lseek(fd: i32, offset: int, flags: u32) int;

extern fn getcwd(buf: cstring, size: uint) ?cstring;
extern fn chdir(path: cstring) i32;

extern fn recv(fd: i32, buf: ptr, len: uint, flags: i32) int;
extern fn send(fd: i32, buf: ptr, len: uint, flags: i32) int;

extern fn pipe(fds: *[i32 x 2]) i32;
extern fn dup(old_fd: i32) i32;
extern fn dup2(old_fd: i32, new_fd: i32) i32;
extern fn fcntl(fd: i32, action: i32, ...) i32;

extern fn socket(domain: i32, type: i32, protocol: i32) i32;
extern fn connect(sockfd: i32, addr: *libc_sockaddr, addrlen: u32) i32;
extern fn accept(sockfd: i32, addr: ?*libc_sockaddr, addrlen: ?*u32) i32;
extern fn accept4(sockfd: i32, addr: ?*libc_sockaddr, addrlen: ?*u32, flags: i32) i32;
extern fn shutdown(sockfd: i32, how: i32) i32;
extern fn bind(sockfd: i32, addr: *libc_sockaddr, addrlen: u32) i32;
extern fn listen(sockfd: i32, backlog: i32) i32;
extern fn sendto(sockfd: i32, buf: ptr, len: uint, flags: i32, addr: *libc_sockaddr, addrlen: u32) int;
extern fn recvfrom(sockfd: i32, buf: ptr, len: uint, flags: i32, addr: ?*libc_sockaddr, addrlen: ?*u32) int;
extern fn getsockname(sockfd: i32, addr: *libc_sockaddr, addrlen: *u32) i32;

extern fn getsockopt(sockfd: i32, level: i32, optname: i32, optval: ptr, optlen: *u32) i32;
extern fn setsockopt(sockfd: i32, level: i32, optname: i32, optval: ?ptr, optlen: u32) i32;
extern fn getaddrinfo(host: cstring, port: cstring, hints: *libc_addrinfo_fix, res: *?*libc_addrinfo_fix) i32;
extern fn freeaddrinfo(info: *libc_addrinfo) void;

extern fn poll(fds: *libc_pollfd, nfds: uint, timeout: i32) i32;

extern fn epoll_create(size: i32) i32;
// A C `struct epoll_event` is 12 packed bytes (u32 events, then the 8-byte data union at
// offset 4). Valk rounds struct sizes up to 8 bytes, so it has no mirror: pass raw memory.
extern fn epoll_wait(epfd: i32, events: ptr, maxevents: i32, timeout: i32) i32;
extern fn epoll_ctl(epfd: i32, op: i32, fd: i32, event: ptr) i32;

extern fn nanosleep(req: *libc_timespec, rem: *libc_timespec) i32;

// Files
extern fn stat(path: cstring, stat_buf: *libc_stat) i32;
extern fn fstat(fd: i32, stat_buf: *libc_stat) i32;
extern fn lstat(path: cstring, stat_buf: *libc_stat) i32;
extern fn access(path: cstring, mode: i32) i32;

extern fn opendir(name: cstring) ?DIR;
extern fn readdir(dirp: DIR) ?*libc_dirent;
extern fn closedir(dirp: DIR) i32;
extern fn mkdir(pathname: cstring, mode: u32) i32;
extern fn rmdir(pathname: cstring) i32;
extern fn realpath(dir: ptr, buf: ptr) ?cstring;
extern fn chmod(pathname: cstring, mode: u32) i32;
extern fn fchmod(fd: i32, mode: u32) i32;
extern fn truncate(pathname: cstring, length: int) i32;
extern fn ftruncate(fd: i32, length: int) i32;

extern fn rename(oldpath: cstring, newpath: cstring) i32;
extern fn link(oldpath: cstring, newpath: cstring) i32;
extern fn unlink(pathname: cstring) i32;
extern fn symlink(target: cstring, linkpath: cstring) i32;
extern fn readlink(pathname: cstring, buf: ptr, bufsiz: uint) int;

// Process
extern fn popen(cmd: cstring, type: cstring) ?FILE;
extern fn pclose(stream: FILE) i32;
extern fn fgets(buffer: cstring, size: i32, stream: FILE) ?cstring;
extern fn fread(buffer: ptr, size: uint, count: uint, stream: FILE) uint;

// Time
value CLOCK_REALTIME (0)
value CLOCK_MONOTONIC (1)
extern fn gettimeofday(tv: *libc_timeval, tz: ?*libc_timezone) i32;
extern fn settimeofday(tv: *libc_timeval, tz: ?*libc_timezone) i32;
extern fn clock_gettime(clock_id: i32, value: *libc_timespec) i32;

extern fn eventfd(initval: u32, flags: i32) i32;
#end

extern fn acos(value: float) float $nonblocking;
extern fn asin(value: float) float $nonblocking;
extern fn atan(value: float) float $nonblocking;
extern fn atan2(y: float, x: float) float $nonblocking;
extern fn cbrt(value: float) float $nonblocking;
extern fn ceil(value: float) float $nonblocking;
extern fn cos(value: float) float $nonblocking;
extern fn exp(value: float) float $nonblocking;
extern fn exp2(value: float) float $nonblocking;
extern fn fabs(value: float) float $nonblocking;
extern fn floor(value: float) float $nonblocking;
extern fn fmod(value: float, divisor: float) float $nonblocking;
extern fn hypot(x: float, y: float) float $nonblocking;
extern fn log(value: float) float $nonblocking;
extern fn log2(value: float) float $nonblocking;
extern fn log10(value: float) float $nonblocking;
extern fn pow(base: float, exponent: float) float $nonblocking;
extern fn round(value: float) float $nonblocking;
extern fn sin(value: float) float $nonblocking;
extern fn sqrt(value: float) float $nonblocking;
extern fn tan(value: float) float $nonblocking;

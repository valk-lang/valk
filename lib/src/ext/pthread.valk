
#if OS == "linux" || OS == "macos"
+ struct pthread_t {
    + data: uint (0)
}
+ struct pthread_mutex_t {
    + data: [uint x 10] ({ 0... })
}
+ struct pthread_cond_t {
    + data: [uint x 12] ({ 0... })
}
#if OS == "linux"
+ struct pthread_condattr_t {
    + data: i32 (0)
}
#end

extern fn pthread_create(thread: *pthread_t, attr: ?ptr, entry: ptr, data: ?ptr) i32;
extern fn pthread_detach(thread: uint) i32;
extern fn pthread_join(thread: uint, exit_value: ?ptr) i32;

extern fn pthread_mutex_init(mutex: *pthread_mutex_t, attr: ?ptr) i32;
extern fn pthread_mutex_destroy(mutex: *pthread_mutex_t) i32;
extern fn pthread_mutex_lock(mutex: *pthread_mutex_t) i32;
extern fn pthread_mutex_unlock(mutex: *pthread_mutex_t) i32;

extern fn pthread_cond_init(cond: *pthread_cond_t, attr: ?ptr) i32;
extern fn pthread_cond_signal(cond: *pthread_cond_t) i32;
extern fn pthread_cond_wait(cond: *pthread_cond_t, mutex: *pthread_mutex_t) i32;
extern fn pthread_cond_timedwait(cond: *pthread_cond_t, mutex: *pthread_mutex_t, abstime: *libc_timespec) i32;
extern fn pthread_cond_destroy(cond: *pthread_cond_t) i32;
#if OS == "linux"
extern fn pthread_condattr_init(attr: *pthread_condattr_t) i32;
extern fn pthread_condattr_setclock(attr: *pthread_condattr_t, clock_id: i32) i32;
extern fn pthread_condattr_destroy(attr: *pthread_condattr_t) i32;
#else
extern fn pthread_cond_timedwait_relative_np(cond: *pthread_cond_t, mutex: *pthread_mutex_t, interval: *libc_timespec) i32;
#end
#end

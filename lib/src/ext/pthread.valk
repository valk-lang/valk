
#if OS == "linux" || OS == "macos"
/// Holds a `pthread_t` thread handle, filled by `pthread_create`; used by `thread` and
/// `core`.
+ struct pthread_t {
    /// The handle (an integer on Linux, a pointer on macOS).
    + data: uint (0)
}
/// Opaque storage for a `pthread_mutex_t`; initialize with `pthread_mutex_init`.
///
/// 80 bytes, more than the C type needs (40 on linux-x64, 64 on macOS).
+ struct pthread_mutex_t {
    /// Opaque mutex bytes, zero by default.
    + data: [uint x 10] ({ 0... })
}
/// Opaque storage for a `pthread_cond_t`; initialize with `pthread_cond_init`.
///
/// 96 bytes, more than the C type needs (48 on Linux and macOS).
+ struct pthread_cond_t {
    /// Opaque condition variable bytes, zero by default.
    + data: [uint x 12] ({ 0... })
}
#if OS == "linux"
/// Mirrors glibc `pthread_condattr_t` on Linux; `thread` uses it to make timed
/// waits use `CLOCK_MONOTONIC`.
+ struct pthread_condattr_t {
    /// Opaque attribute bits.
    + data: i32 (0)
}
#end

extern fn pthread_create(thread: *pthread_t, attr: ?ptr, entry: ptr, data: ?ptr) i32;
extern fn pthread_self() uint;
#if OS == "linux"
/// Opaque storage for glibc `pthread_attr_t` (64 bytes, C needs 56); `gc` fills it
/// with `pthread_getattr_np` to find a thread's stack.
+ struct pthread_attr_t {
    /// Opaque attribute bytes, zero by default.
    + data: [uint x 8] ({ 0... })
}
extern fn pthread_getattr_np(thread: uint, attr: *pthread_attr_t) i32;
extern fn pthread_attr_getstack(attr: *pthread_attr_t, addr: *ptr, size: *uint) i32;
extern fn pthread_attr_destroy(attr: *pthread_attr_t) i32;
#else
extern fn pthread_get_stackaddr_np(thread: uint) ptr;
extern fn pthread_get_stacksize_np(thread: uint) uint;
#end
extern fn pthread_detach(thread: uint) i32;
extern fn pthread_join(thread: uint, exit_value: ?ptr) i32;

extern fn pthread_mutex_init(mutex: *pthread_mutex_t, attr: ?ptr) i32;
extern fn pthread_mutex_destroy(mutex: *pthread_mutex_t) i32;
extern fn pthread_mutex_lock(mutex: *pthread_mutex_t) i32;
extern fn pthread_mutex_unlock(mutex: *pthread_mutex_t) i32;

extern fn pthread_cond_init(cond: *pthread_cond_t, attr: ?ptr) i32;
extern fn pthread_cond_signal(cond: *pthread_cond_t) i32;
extern fn pthread_cond_wait(cond: *pthread_cond_t, mutex: *pthread_mutex_t) i32;
extern fn pthread_cond_timedwait(cond: *pthread_cond_t, mutex: *pthread_mutex_t, abstime: *libc_timespec) i32;
extern fn pthread_cond_destroy(cond: *pthread_cond_t) i32;
#if OS == "linux"
extern fn pthread_condattr_init(attr: *pthread_condattr_t) i32;
extern fn pthread_condattr_setclock(attr: *pthread_condattr_t, clock_id: i32) i32;
extern fn pthread_condattr_destroy(attr: *pthread_condattr_t) i32;
#else
extern fn pthread_cond_timedwait_relative_np(cond: *pthread_cond_t, mutex: *pthread_mutex_t, interval: *libc_timespec) i32;
#end
#end


#if OS == "win" && ARCH == "x64"
/// Mirrors Win32 `STARTUPINFOA`, the ANSI startup information for `CreateProcessA`.
+ struct STARTUPINFOA {
    /// Size of the struct in bytes; must be set.
    + cb: u32
    /// Reserved; null.
    + lpReserved: cstring
    /// Desktop and window station name, or null.
    + lpDesktop: cstring
    /// Console window title for a new console, or null.
    + lpTitle: cstring
    /// Window x position in pixels (with `STARTF_USEPOSITION`).
    + dwX: u32
    /// Window y position in pixels (with `STARTF_USEPOSITION`).
    + dwY: u32
    /// Window width in pixels (with `STARTF_USESIZE`).
    + dwXSize: u32
    /// Window height in pixels (with `STARTF_USESIZE`).
    + dwYSize: u32
    /// Console buffer width in character cells (with `STARTF_USECOUNTCHARS`).
    + dwXCountChars: u32
    /// Console buffer height in character cells (with `STARTF_USECOUNTCHARS`).
    + dwYCountChars: u32
    /// Console text and background colors (with `STARTF_USEFILLATTRIBUTE`).
    + dwFillAttribute: u32
    /// `STARTF_*` flags selecting which fields are used.
    + dwFlags: u32
    /// `SW_*` show command (with `STARTF_USESHOWWINDOW`).
    + wShowWindow: u16
    /// Reserved; 0.
    + cbReserved2: u16
    /// Reserved; null.
    + lpReserved2: *u8
    /// Standard input handle (with `STARTF_USESTDHANDLES`).
    + hStdInput: HANDLE
    /// Standard output handle (with `STARTF_USESTDHANDLES`).
    + hStdOutput: HANDLE
    /// Standard error handle (with `STARTF_USESTDHANDLES`).
    + hStdError: HANDLE
}
/// Mirrors Win32 `STARTUPINFOW`, the UTF-16 startup information for
/// `CreateProcessW`; used by `core`.
+ struct STARTUPINFOW {
    /// Size of the struct in bytes; must be set.
    + cb: u32
    /// Reserved; null.
    + lpReserved: ?*u16
    /// Desktop and window station name, or null.
    + lpDesktop: ?*u16
    /// Console window title for a new console, or null.
    + lpTitle: ?*u16
    /// Window x position in pixels (with `STARTF_USEPOSITION`).
    + dwX: u32
    /// Window y position in pixels (with `STARTF_USEPOSITION`).
    + dwY: u32
    /// Window width in pixels (with `STARTF_USESIZE`).
    + dwXSize: u32
    /// Window height in pixels (with `STARTF_USESIZE`).
    + dwYSize: u32
    /// Console buffer width in character cells (with `STARTF_USECOUNTCHARS`).
    + dwXCountChars: u32
    /// Console buffer height in character cells (with `STARTF_USECOUNTCHARS`).
    + dwYCountChars: u32
    /// Console text and background colors (with `STARTF_USEFILLATTRIBUTE`).
    + dwFillAttribute: u32
    /// `STARTF_*` flags selecting which fields are used.
    + dwFlags: u32
    /// `SW_*` show command (with `STARTF_USESHOWWINDOW`).
    + wShowWindow: u16
    /// Reserved; 0.
    + cbReserved2: u16
    /// Reserved; null.
    + lpReserved2: ?*u8
    /// Standard input handle (with `STARTF_USESTDHANDLES`).
    + hStdInput: HANDLE
    /// Standard output handle (with `STARTF_USESTDHANDLES`).
    + hStdOutput: HANDLE
    /// Standard error handle (with `STARTF_USESTDHANDLES`).
    + hStdError: HANDLE
}
/// Mirrors Win32 `STARTUPINFOEXW`: `STARTUPINFOW` plus an attribute list, for
/// `CreateProcessW` with `EXTENDED_STARTUPINFO_PRESENT`; used by `core`.
+ struct STARTUPINFOEXW {
    /// Basic startup information; its `cb` holds the size of the extended struct.
    + StartupInfo: STARTUPINFOW
    /// Attribute list from `InitializeProcThreadAttributeList`, or null.
    + lpAttributeList: ?ptr
}
/// Mirrors Win32 `SECURITY_ATTRIBUTES`; `core` uses it to open inheritable handles for
/// child processes.
+ struct SECURITY_ATTRIBUTES {
    /// Size of the struct in bytes.
    + nLength: u32
    /// Security descriptor, or null for the default.
    + lpSecurityDescriptor: ?ptr
    /// Nonzero when child processes inherit the new handle.
    + bInheritHandle: BOOL
}
/// Mirrors Win32 `PROCESS_INFORMATION`, filled by `CreateProcessW`; used by `core`.
+ struct PROCESS_INFORMATION {
    /// Handle to the new process.
    + hProcess: HANDLE
    /// Handle to its primary thread.
    + hThread: HANDLE
    /// Process ID.
    + dwProcessId: u32
    /// Primary thread ID.
    + dwThreadId: u32
}

/// Mirrors `struct timezone` on win-x64.
+ struct libc_timezone {
    /// Minutes west of Greenwich.
    + tz_minuteswest: i32
    /// Type of DST correction; nonzero if DST is ever in effect.
    + tz_dsttime: i32
}

/// Mirrors Winsock `ADDRINFOA` with untyped pointers; used by `getaddrinfo` in `net`.
+ struct libc_addrinfo_fix {
    /// `AI_*` flags.
    + ai_flags: i32
    /// Address family (`AF_*`).
    + ai_family: i32
    /// Socket type (`SOCK_*`).
    + ai_socktype: i32
    /// Protocol (`IPPROTO_*`), 0 for any.
    + ai_protocol: i32
    /// Length of `ai_addr` in bytes (a `size_t` on Windows).
    + ai_addrlen: uint
    /// Canonical host name (only with `AI_CANONNAME`), otherwise null.
    + ai_canonname: ?ptr
    /// The socket address.
    + ai_addr: ptr
    /// Next result in the list, null on the last one.
    + ai_next: ?ptr
}

/// Mirrors the UCRT `struct stat` (`_stat64i32`) on win-x64. Nothing in the
/// standard library uses it.
+ struct libc_stat_fix {
    /// Drive number of the disk holding the file.
    + st_dev: u32
    /// Not used on Windows.
    + st_ino: u16
    /// File type and permission bits (`_S_IF*` and mode bits).
    + st_mode: u16

    /// Number of hard links (always 1 outside NTFS).
    + st_nlink: i16
    /// Not used on Windows (0).
    + st_uid: i16
    /// Not used on Windows (0).
    + st_gid: i16
    /// Same as `st_dev`.
    + st_rdev: u32
    /// Size in bytes (32-bit).
    + st_size: i32

    /// Time of last access, seconds since the Unix epoch.
    + st_atime: i64
    /// Time of last modification, seconds since the Unix epoch.
    + st_mtime: i64
    /// Creation time, seconds since the Unix epoch.
    + st_ctime: i64
}

/// Mirrors Winsock `struct in_addr` as one 32-bit word.
+ struct in_addr {
    /// IPv4 address in network byte order.
    + addr: u32
}

/// Mirrors Winsock `struct sockaddr_in`, an IPv4 socket address.
+ struct sockaddr_in {
    /// Address family, `AF_INET` (`sin_family` in C).
    + sa_family: u16
    /// Port in network byte order.
    + sin_port: u16
    /// IPv4 address in network byte order.
    + sin_addr: u32
    /// Zero padding.
    + sin_zero: [u8 x 8]
}

/// Mirrors Win32 `GUID`; `net` uses it to look up `ConnectEx`/`AcceptEx` via `WSAIoctl`.
+ struct GUID {
    /// First 32 bits.
    + Data1: u32
    /// Next 16 bits.
    + Data2: u16
    /// Next 16 bits.
    + Data3: u16
    /// Last 8 bytes.
    + Data4: [u8 x 8]
}

value _SS_MAXSIZE (128)            // Maximum size
value _SS_ALIGNSIZE (size_of(i64)) // Desired alignment
value _SS_PAD1SIZE (_SS_ALIGNSIZE - size_of(u16))
value _SS_PAD2SIZE (_SS_MAXSIZE - (size_of(u16) + _SS_PAD1SIZE + _SS_ALIGNSIZE))

/// Mirrors Winsock `SOCKADDR_STORAGE`: 128 bytes, large and aligned enough for
/// any socket address.
+ struct sockaddr_storage {
    /// Address family (`AF_*`).
    + ss_family: u16
    /// Padding up to `__ss_align`.
    + __ss_pad1: [u8 x _SS_PAD1SIZE]
    /// Forces 8-byte alignment.
    + __ss_align: i64
    /// Padding up to 128 bytes.
    + __ss_pad2: [u8 x _SS_PAD2SIZE]
}

/// The C `struct timeval` of this target: seconds plus microseconds, both 32-bit.
type libc_timeval (libc_gen_timeval)

/// The C `struct timespec` of this target: seconds plus nanoseconds.
type libc_timespec (libc_gen_timespec)

/// The C generic `struct sockaddr` of this target.
type libc_sockaddr (libc_gen_sockaddr)

/// The C `struct pollfd` of this target, one descriptor watched by `poll`.
type libc_pollfd (libc_gen_pollfd)

/// The C `struct stat` of this target, filled by `stat` and `fstat`.
type libc_stat (libc_gen_stat)

/// The C `struct addrinfo` of this target, one entry of a `getaddrinfo` result list.
type libc_addrinfo (libc_gen_addrinfo)

/// The Win32 `WIN32_FIND_DATAA` struct, filled by `FindFirstFileA` and `FindNextFileA`.
type libc_WIN32_FIND_DATAA (libc_gen__WIN32_FIND_DATAA)

/// The Win32 `WIN32_FIND_DATAW` struct, filled by `FindFirstFileW` and `FindNextFileW`.
type libc_WIN32_FIND_DATAW (libc_gen__WIN32_FIND_DATAW)

/// The Win32 `WIN32_FILE_ATTRIBUTE_DATA` struct, filled by `GetFileAttributesExW`.
type libc_WIN32_FILE_ATTRIBUTE_DATA (libc_gen__WIN32_FILE_ATTRIBUTE_DATA)

/// The Win32 `FILETIME` struct: 100-nanosecond intervals since 1601-01-01 UTC.
type libc_FILETIME (libc_gen__FILETIME)

/// Mirrors the UCRT `struct stat` (`_stat64i32`) on win-x64; aliased as `libc_stat`.
+ struct libc_gen_stat {
    /// Drive number of the disk holding the file.
    + st_dev: u32
    /// Not used on Windows.
    + st_ino: u16
    /// File type and permission bits (`_S_IF*` and mode bits).
    + st_mode: u16
    /// Number of hard links (always 1 outside NTFS).
    + st_nlink: i16
    /// Not used on Windows (0).
    + st_uid: i16
    /// Not used on Windows (0).
    + st_gid: i16
    /// Same as `st_dev`.
    + st_rdev: u32
    /// Size in bytes (32-bit).
    + st_size: i32
    /// Time of last access, seconds since the Unix epoch.
    + st_atime: int
    /// Time of last modification, seconds since the Unix epoch.
    + st_mtime: int
    /// Creation time, seconds since the Unix epoch.
    + st_ctime: int
}

/// Mirrors Win32 `FILETIME`: 100-nanosecond intervals since 1601-01-01 UTC, split
/// into two halves; aliased as `libc_FILETIME`.
+ struct libc_gen__FILETIME {
    /// Low 32 bits.
    + dwLowDateTime: u32
    /// High 32 bits.
    + dwHighDateTime: u32
}

/// Mirrors Win32 `WIN32_FIND_DATAA` for `FindFirstFileA`; aliased as
/// `libc_WIN32_FIND_DATAA`.
+ struct libc_gen__WIN32_FIND_DATAA {
    /// `FILE_ATTRIBUTE_*` bits.
    + dwFileAttributes: u32
    /// Creation time.
    + ftCreationTime: libc_gen__FILETIME
    /// Time of last access.
    + ftLastAccessTime: libc_gen__FILETIME
    /// Time of last write.
    + ftLastWriteTime: libc_gen__FILETIME
    /// High 32 bits of the file size in bytes.
    + nFileSizeHigh: u32
    /// Low 32 bits of the file size in bytes.
    + nFileSizeLow: u32
    /// Reparse tag when `FILE_ATTRIBUTE_REPARSE_POINT` is set.
    + dwReserved0: u32
    /// Reserved.
    + dwReserved1: u32
    /// Null-terminated file name.
    + cFileName: [i8 x 260]
    /// Null-terminated 8.3 short name, or empty.
    + cAlternateFileName: [i8 x 14]
}

/// Mirrors Win32 `WIN32_FIND_DATAW` (UTF-16 names) for `FindFirstFileW`; aliased
/// as `libc_WIN32_FIND_DATAW`, used by `fs`.
+ struct libc_gen__WIN32_FIND_DATAW {
    /// `FILE_ATTRIBUTE_*` bits.
    + dwFileAttributes: u32
    /// Creation time.
    + ftCreationTime: libc_gen__FILETIME
    /// Time of last access.
    + ftLastAccessTime: libc_gen__FILETIME
    /// Time of last write.
    + ftLastWriteTime: libc_gen__FILETIME
    /// High 32 bits of the file size in bytes.
    + nFileSizeHigh: u32
    /// Low 32 bits of the file size in bytes.
    + nFileSizeLow: u32
    /// Reparse tag when `FILE_ATTRIBUTE_REPARSE_POINT` is set.
    + dwReserved0: u32
    /// Reserved.
    + dwReserved1: u32
    /// Null-terminated file name.
    + cFileName: [u16 x 260]
    /// Null-terminated 8.3 short name, or empty.
    + cAlternateFileName: [u16 x 14]
}

/// Mirrors Win32 `WIN32_FILE_ATTRIBUTE_DATA`, filled by
/// `GetFileAttributesExW`; aliased as `libc_WIN32_FILE_ATTRIBUTE_DATA`.
+ struct libc_gen__WIN32_FILE_ATTRIBUTE_DATA {
    /// `FILE_ATTRIBUTE_*` bits.
    + dwFileAttributes: u32
    /// Creation time.
    + ftCreationTime: libc_gen__FILETIME
    /// Time of last access.
    + ftLastAccessTime: libc_gen__FILETIME
    /// Time of last write.
    + ftLastWriteTime: libc_gen__FILETIME
    /// High 32 bits of the file size in bytes.
    + nFileSizeHigh: u32
    /// Low 32 bits of the file size in bytes.
    + nFileSizeLow: u32
}

/// Aliased as `libc_sockaddr` on win-x64; laid out as `sockaddr_in`, which has the
/// 16-byte size of `struct sockaddr`.
+ struct libc_gen_sockaddr {
    /// Address family (`AF_*`).
    + sa_family: u16
    /// Port in network byte order (for `AF_INET`).
    + sin_port: u16
    /// IPv4 address in network byte order (for `AF_INET`).
    + sin_addr: u32
    /// Zero padding.
    + sin_zero: [u8 x 8]
}

/// Mirrors Winsock `ADDRINFOA`; aliased as `libc_addrinfo`.
+ struct libc_gen_addrinfo {
    /// `AI_*` flags.
    + ai_flags: i32
    /// Address family (`AF_*`).
    + ai_family: i32
    /// Socket type (`SOCK_*`).
    + ai_socktype: i32
    /// Protocol (`IPPROTO_*`), 0 for any.
    + ai_protocol: i32
    /// Length of `ai_addr` in bytes (a `size_t` on Windows).
    + ai_addrlen: uint
    /// Canonical host name (only with `AI_CANONNAME`), otherwise null.
    + ai_canonname: ?cstring
    /// The socket address.
    + ai_addr: *libc_gen_sockaddr
    /// Next result in the list, null on the last one.
    + ai_next: ?*libc_gen_addrinfo
}

/// Mirrors the Winsock `struct timeval` (32-bit fields); aliased as `libc_timeval`.
+ struct libc_gen_timeval {
    /// Whole seconds.
    + tv_sec: i32
    /// Microseconds, 0 to 999,999.
    + tv_usec: i32
}

/// Mirrors Winsock `WSAPOLLFD`; aliased as `libc_pollfd`.
+ struct libc_gen_pollfd {
    /// Socket to watch; negative entries are ignored.
    + fd: uint
    /// Requested events (`POLLIN`, `POLLOUT`, ...).
    + events: i16
    /// Events that occurred, filled in by `WSAPoll`.
    + revents: i16
}

/// Mirrors the UCRT `struct timespec` (64-bit seconds, 32-bit nanoseconds); aliased as
/// `libc_timespec`.
+ struct libc_gen_timespec {
    /// Whole seconds.
    + tv_sec: int
    /// Nanoseconds, 0 to 999,999,999.
    + tv_nsec: i32
}

/// Mirrors Win32 `CRITICAL_SECTION` (40 bytes); used by the thread suspend gate in
/// `thread`. Treat as opaque and set up with `InitializeCriticalSection`.
+ struct CRITICAL_SECTION {
    /// Debug information, managed by the system.
    + DebugInfo: *CRITICAL_SECTION_DEBUG
    /// Lock state, managed by the system.
    + LockCount: i32
    /// Number of times the owning thread has entered.
    + RecursionCount: i32
    /// ID of the owning thread.
    + OwningThread: HANDLE
    /// Event used to wait for the lock, managed by the system.
    + LockSemaphore: HANDLE
    /// Spins before waiting on multiprocessor systems.
    + SpinCount: uint
}

/// Mirrors Win32 `RTL_CRITICAL_SECTION_DEBUG` (48 bytes), managed by the system.
+ struct CRITICAL_SECTION_DEBUG {
    /// Kind of debug record.
    + Type: u16
    /// Index of the creation back trace.
    + CreatorBackTraceIndex: u16
    /// The critical section this record belongs to.
    + CriticalSection: *CRITICAL_SECTION
    /// Link in the process's list of critical sections.
    + ProcessLocksList: LIST_ENTRY
    /// Number of entries.
    + EntryCount: u32
    /// Number of times a thread had to wait.
    + ContentionCount: u32
    /// Debug flags.
    + Flags: u32
    /// High bits of `CreatorBackTraceIndex`.
    + CreatorBackTraceIndexHigh: u16
    /// Reserved.
    + Identifier: u16
}

/// Mirrors Win32 `LIST_ENTRY`, a node in a doubly linked list.
+ struct LIST_ENTRY {
    /// Next entry.
    + Flink: *LIST_ENTRY
    /// Previous entry.
    + Blink: *LIST_ENTRY
}

/// Mirrors Win32 `CONDITION_VARIABLE` (one opaque pointer); set up with
/// `InitializeConditionVariable`; used by the thread suspend gate in `thread`.
+ struct CONDITION_VARIABLE {
    /// Opaque state.
    + ref: ptr
}
#end


#if OS == "win"
/// Mirrors Win32 `OVERLAPPED`: the state of one overlapped I/O request; used by `io`,
/// `fs` and `net` with I/O completion ports.
+ struct OVERLAPPED {
    /// Status code of the request, set by the system.
    + Internal: uint
    /// Number of bytes transferred, set by the system.
    + InternalHigh: uint
    /// Low 32 bits of the file offset to start at.
    + Offset: u32
    /// High 32 bits of the file offset to start at.
    + OffsetHigh: u32
    /// Event signaled on completion, or null.
    + hEvent: HANDLE
}

extern fn CreateIoCompletionPort(FileHandle: HANDLE, ExistingCompletionPort: HANDLE, CompletionKey: uint, NumberOfConcurrentThreads: u32) HANDLE;
extern fn GetQueuedCompletionStatus(CompletionPort: ptr, lpNumberOfBytesTransferred: ptr, lpCompletionKey: ptr, lpOverlapped: ptr, dwMilliseconds: u32) BOOL;
extern fn PostQueuedCompletionStatus(CompletionPort: HANDLE, dwNumberOfBytesTransferred: u32, dwCompletionKey: uint, lpOverlapped: ?ptr) BOOL;
extern fn CancelIoEx(hFile: HANDLE, lpOverlapped: ?ptr) BOOL;
extern fn RegisterWaitForSingleObject(wait: *HANDLE, event: HANDLE, callback: ptr, context: ptr, timeout_ms: u32, flags: u32) BOOL;
extern fn UnregisterWaitEx(wait: HANDLE, completion: HANDLE) BOOL;
extern fn SetFileCompletionNotificationModes(FileHandle: HANDLE, Flags: u8) BOOL;
extern fn GetOverlappedResult(s: SOCKET, lpOverlapped: ptr, lpcbTransfer: *u32, fWait: BOOL) BOOL;
extern fn WSAGetOverlappedResult(s: SOCKET, lpOverlapped: ptr, lpcbTransfer: *u32, fWait: BOOL, flags: *u32) BOOL;
#end

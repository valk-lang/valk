
#if OS == "macos"
/// Mirrors `struct kevent` for `kqueue`/`kevent` on macOS; used by `io` and `coro`.
+ struct kEvent {
    /// Identifier for the event, usually a file descriptor.
    + ident: uint
    /// Event filter (`EVFILT_*`).
    + filter: i16
    /// Action and status flags (`EV_ADD`, `EV_ONESHOT`, `EV_EOF`, ...).
    + flags: u16
    /// Filter-specific flags (`NOTE_*`).
    + fflags: u32
    /// Filter-specific data, e.g. bytes available to read.
    + data: i64
    /// Opaque user value returned with the event.
    + udata: ptr
}

/// Mirrors `struct aiocb` on macOS (80 bytes), for `aio_read`/`aio_return`.
///
/// The only user in the standard library is the `OS == "bsd"` read path in `io`, which no
/// build target selects.
+ struct aiocb {
    /// File descriptor to read from (`aio_fildes`).
    + fd: i32
    /// File offset in bytes (`aio_offset`).
    + offset: i64
    /// Buffer address (`aio_buf`).
    + buf: ptr
    /// Number of bytes to transfer (`aio_nbytes`).
    + len: i64
    /// Request priority offset (`aio_reqprio`).
    + prio: i32
    /// How completion is reported (`aio_sigevent`).
    + sig: sigevent
    /// `LIO_*` operation for `lio_listio` (`aio_lio_opcode`).
    + op: i32
}

/// Mirrors `struct sigevent` on macOS (32 bytes), the completion notification of `aiocb`.
+ struct sigevent {
    /// Notification kind (`SIGEV_NONE`, `SIGEV_SIGNAL` or `SIGEV_THREAD`).
    + notify: i32
    /// Signal number to deliver.
    + signo: i32
    /// Value passed to the notification (`sigev_value`, an int or a pointer).
    + value: ?ptr
    /// Callback for `SIGEV_THREAD`.
    + func: ?ptr
    /// Thread attributes for `SIGEV_THREAD`, or null.
    + attr: ?ptr
}

extern fn kqueue() i32;
extern fn kevent(kq: i32, changelist: ?*kEvent, nchanges: i32, eventlist: ?*kEvent, nevents: i32, timeout: ?*libc_gen_timespec) i32;

extern fn aio_read(cb: *aiocb) i32;
extern fn aio_return(cb: *aiocb) int;
#end

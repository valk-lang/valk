
#if OS == "macos" && ARCH == "x64"
/// The C `struct timespec` of this target: seconds plus nanoseconds.
type libc_timespec (libc_gen_timespec)

/// The C `struct timeval` of this target: seconds plus microseconds.
type libc_timeval (libc_gen_timeval)

/// The C generic `struct sockaddr` of this target.
type libc_sockaddr (libc_gen_sockaddr)

/// The C `struct pollfd` of this target, one descriptor watched by `poll`.
type libc_pollfd (libc_gen_pollfd)

/// The C `jmp_buf` of this target, treated as an opaque buffer.
type libc_jmp_buf ([i32 x 37])

/// The C `struct stat` of this target, filled by `stat` and `fstat`.
type libc_stat (libc_gen_stat)

/// The C `struct dirent` of this target, one entry returned by `readdir`.
type libc_dirent (libc_gen_dirent)

/// The C `struct timezone` of this target, as passed to `gettimeofday`.
type libc_timezone (libc_gen_timezone)

/// The C `struct addrinfo` of this target, one entry of a `getaddrinfo` result list.
type libc_addrinfo (libc_gen_addrinfo)

/// Mirrors `struct timespec` on macos-x64; aliased as `libc_timespec`.
+ struct libc_gen_timespec {
    /// Whole seconds.
    + tv_sec: int
    /// Nanoseconds, 0 to 999,999,999.
    + tv_nsec: int
}

/// Mirrors the legacy macOS `struct stat` (32-bit inode, no birth time) that the plain
/// `stat` symbols use on macos-x64; aliased as `libc_stat`, filled by `stat`/`fstat`/`lstat`
/// in `fs`.
+ struct libc_gen_stat {
    /// ID of the device containing the file.
    + st_dev: i32
    /// Inode number.
    + st_ino: u32
    /// File type and permission bits (`S_IF*` and mode bits).
    + st_mode: u16
    /// Number of hard links.
    + st_nlink: u16
    /// Owner user ID.
    + st_uid: u32
    /// Owner group ID.
    + st_gid: u32
    /// Device ID, for character and block special files.
    + st_rdev: i32
    /// Time of last access.
    + st_atimespec: libc_gen_timespec
    /// Time of last modification.
    + st_mtimespec: libc_gen_timespec
    /// Time of last status change.
    + st_ctimespec: libc_gen_timespec
    /// Size in bytes (for a symlink: length of the target path).
    + st_size: int
    /// Number of 512-byte blocks allocated.
    + st_blocks: int
    /// Preferred block size for file system I/O, in bytes.
    + st_blksize: i32
    /// User-defined file flags (`chflags`).
    + st_flags: u32
    /// File generation number.
    + st_gen: u32
    /// Reserved.
    + st_lspare: i32
    /// Reserved.
    + st_qspare: [int x 2]
}

/// Mirrors the legacy macOS `struct dirent` (32-bit inode, 255-byte names) that the plain
/// `readdir` symbol returns on macos-x64; aliased as `libc_dirent`.
+ struct libc_gen_dirent {
    /// Inode number.
    + d_ino: u32
    /// Length of this record in bytes.
    + d_reclen: u16
    /// File type (`DT_*`), or `DT_UNKNOWN`.
    + d_type: u8
    /// Length of `d_name` in bytes, without the terminator.
    + d_namlen: u8
    /// Null-terminated file name.
    + d_name: [i8 x 256]
}

/// Mirrors `struct timeval` on macos-x64 (32-bit microseconds); aliased as `libc_timeval`.
+ struct libc_gen_timeval {
    /// Whole seconds.
    + tv_sec: int
    /// Microseconds, 0 to 999,999.
    + tv_usec: i32
}

/// Mirrors `struct pollfd` on macos-x64; aliased as `libc_pollfd`, passed to `poll`.
+ struct libc_gen_pollfd {
    /// File descriptor to watch; negative entries are ignored.
    + fd: i32
    /// Requested events (`POLLIN`, `POLLOUT`, ...).
    + events: i16
    /// Events that occurred, filled in by `poll`.
    + revents: i16
}

/// Mirrors the BSD `struct sockaddr` on macos-x64; aliased as `libc_sockaddr`.
+ struct libc_gen_sockaddr {
    /// Total length of the address in bytes.
    + sa_len: u8
    /// Address family (`AF_*`).
    + sa_family: u8
    /// Family-specific address bytes.
    + sa_data: [i8 x 14]
}

/// Mirrors `struct addrinfo` on macos-x64; aliased as `libc_addrinfo` and
/// `libc_addrinfo_fix`, used by `getaddrinfo` in `net`.
+ struct libc_gen_addrinfo {
    /// `AI_*` flags.
    + ai_flags: i32
    /// Address family (`AF_*`).
    + ai_family: i32
    /// Socket type (`SOCK_*`).
    + ai_socktype: i32
    /// Protocol (`IPPROTO_*`), 0 for any.
    + ai_protocol: i32
    /// Length of `ai_addr` in bytes.
    + ai_addrlen: u32
    /// Canonical host name (only with `AI_CANONNAME`), otherwise null.
    + ai_canonname: cstring
    /// The socket address.
    + ai_addr: *libc_gen_sockaddr
    /// Next result in the list, null on the last one.
    + ai_next: *libc_gen_addrinfo
}

/// Mirrors `struct timezone` for `gettimeofday` (obsolete; normally all zero).
+ struct libc_gen_timezone {
    /// Minutes west of Greenwich.
    + tz_minuteswest: i32
    /// Type of DST correction; nonzero if DST is ever in effect.
    + tz_dsttime: i32
}
#end

use mem

/// A stack of plain values in one manually allocated block, for recycling items.
///
/// `get` returns the most recently added item. `T` cannot contain GC references: `add`
/// fails to compile for such a type.
+ class Pool[T] {
    - data: ptr
    - size: uint
    /// The number of items currently stored.
    ~ count: uint (0)

    /// Creates an empty pool with room for `start_size` items (at least 2).
    ///
    /// Panics when the size in bytes overflows. Marked `$default`: it also provides
    /// `Pool[T].$default_value`.
    + static fn new(start_size: uint (2)) SELF $default {
        if start_size < 2 {
            start_size = 2
        }
        let allocation_size = start_size.checked_multiply(size_of(T)) ! panic("Pool capacity is too large")
        return SELF {
            size: start_size
            data: mem.alloc(allocation_size)
        }
    }

    /// Stores `item`, doubling the storage when it is full.
    ///
    /// Panics when the capacity overflows.
    + fn add(item: T) {
        #if T.$has_gc_refs
        #error "Pool[T] cannot store a type with GC references"
        #end
        let count = this.count
        let size = this.size
        if count == size {
            let new_size = size.checked_add(size) ! panic("Pool capacity is too large")
            this.increase_size(new_size)
        }

        @ptrv(this.data, T, count) = item
        this.count = count + 1
    }

    /// Removes and returns the most recently added item.
    ///
    /// Throws `empty` when the pool is empty.
    + fn get() T !LookupError {
        let count = this.count
        if count == 0 : throw .empty
        let new_count = count - 1
        let item = @ptrv(this.data, T, new_count)
        this.count = new_count
        return item
    }

    fn increase_size(new_size: uint) ptr {
        @unsafe
        let item_size = size_of(T)
        let old_bytes = this.size.checked_multiply(item_size) ! panic("Pool capacity is too large")
        let new_bytes = new_size.checked_multiply(item_size) ! panic("Pool capacity is too large")
        this.data = mem.resize(this.data, old_bytes, new_bytes)
        this.size = new_size
        return this.data
    }

    fn gc_free() {
        @unsafe
        mem.free(this.data)
    }
}

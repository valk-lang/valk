use core

+ class HashMap[K, T] $global {
    _keys: Array[K] (.{})
    - values_: Array[T] (.{})
    // 0 is empty, -1 is a deleted slot, and positive values are entry indexes + 1.
    - buckets: Array[int] (.{})
    - entry_buckets: Array[uint] (.{})
    - bucket_count: uint (16)
    - tombstones: uint

    + static fn new() SELF $default {
        return SELF{}
    }

    + fn lock() {
        core:race_lock()
    }
    + fn unlock() {
        core:race_unlock()
    }

    + get length : uint {
        return this._keys.length
    }
    + fn keys() Array[K] {
        return this._keys.copy()
    }
    + fn sort_keys() SELF {
        let keys = this._keys.copy()
        keys.sort()

        let values = Array[T].new(keys.length)
        each keys as key {
            values.append(this.get(key) ! continue)
        }

        this._keys = keys
        this.values_ = values
        this.rebuild_buckets(this.bucket_count)
        return this
    }
    + fn values() Array[T] {
        return this.values_.copy()
    }

    static fn key_hash(key: K) uint {
        let hash : uint = 0
        #if K.$has_hash
        hash = $hash(key)
        #else
        hash = key.@cast(uint)
        #end

        hash ^= hash >> 33
        hash *= 0xff51afd7ed558ccd
        hash ^= hash >> 33
        hash *= 0xc4ceb9fe1a85ec53
        hash ^= hash >> 33
        return hash
    }

    fn bucket_value(index: uint) int {
        return this.buckets.get(index) !? 0
    }

    fn find_bucket(key: K) (uint, bool) {
        if this.buckets.length == 0 : return (0, false)

        let index = SELF.key_hash(key) & (this.bucket_count - 1)
        let first_tombstone = this.bucket_count
        let checked: uint = 0
        while checked++ < this.bucket_count {
            let bucket = this.bucket_value(index)
            if bucket == 0 {
                return (first_tombstone < this.bucket_count ? first_tombstone : index, false)
            }
            if bucket < 0 {
                if first_tombstone == this.bucket_count : first_tombstone = index
            } else {
                let entry_index = (bucket - 1).to(uint)
                let stored_key = this._keys.get(entry_index) ! panic("HashMap bucket index is out of bounds")
                if stored_key == key : return (index, true)
            }
            index++
            if index == this.bucket_count : index = 0
        }
        return (first_tombstone, false)
    }

    fn entry_index(key: K) uint !LookupError {
        let bucket_index, found = this.find_bucket(key)
        if !found : throw .missing
        let bucket = this.bucket_value(bucket_index)
        if bucket <= 0 : throw .missing
        return (bucket - 1).to(uint)
    }

    fn rebuild_buckets(new_bucket_count: uint) {
        this.bucket_count = new_bucket_count
        this.tombstones = 0
        this.buckets = Array[int].new(new_bucket_count)
        this.buckets.set_expand(new_bucket_count - 1, 0, 0)
        this.entry_buckets = Array[uint].new(this.length)
        each this._keys as key, index {
            let bucket_index, found = this.find_bucket(key)
            if found : panic("HashMap contains a duplicate key")
            this.buckets.set(bucket_index, (index + 1).to(int)) _
            this.entry_buckets.append(bucket_index)
        }
    }

    fn prepare_insert() bool {
        if this.buckets.length == 0 {
            this.rebuild_buckets(this.bucket_count)
            return true
        }

        if (this.length + this.tombstones + 1) * 4 <= this.bucket_count * 3 : return false
        if (this.length + 1) * 4 > this.bucket_count * 3 {
            this.rebuild_buckets(this.bucket_count * 2)
        } else {
            this.rebuild_buckets(this.bucket_count)
        }
        return true
    }

    // `$set_key`: class-init map form `HashMap`/`Map`{ k => v, ... }
    + fn set(key: K, value: T) SELF $offset_assign $set_key {
        let bucket_index, found = this.find_bucket(key)
        if found {
            let index = (this.bucket_value(bucket_index) - 1).to(uint)
            this.values_.set(index, value) _
            return this
        }

        if this.prepare_insert() {
            let rebuilt_bucket_index, rebuilt_found = this.find_bucket(key)
            if rebuilt_found : panic("HashMap rebuild introduced a duplicate key")
            bucket_index = rebuilt_bucket_index
        }

        let entry_index = this._keys.length
        this._keys.append(key)
        this.values_.append(value)
        this.entry_buckets.append(bucket_index)
        if this.bucket_value(bucket_index) < 0 : this.tombstones--
        this.buckets.set(bucket_index, (entry_index + 1).to(int)) _
        return this
    }

    + fn set_unique(key: K, value: T) SELF {
        let bucket_index, found = this.find_bucket(key)
        if found : return this

        if this.prepare_insert() {
            let rebuilt_bucket_index, rebuilt_found = this.find_bucket(key)
            if rebuilt_found : panic("HashMap rebuild introduced a duplicate key")
            bucket_index = rebuilt_bucket_index
        }

        let entry_index = this._keys.length
        this._keys.append(key)
        this.values_.append(value)
        this.entry_buckets.append(bucket_index)
        if this.bucket_value(bucket_index) < 0 : this.tombstones--
        this.buckets.set(bucket_index, (entry_index + 1).to(int)) _
        return this
    }

    + fn get(key: K) T !LookupError $offset {
        let index = this.entry_index(key) !>
        return this.values_.get(index) !>
    }

    + fn has(key: K) bool {
        let bucket_index, found = this.find_bucket(key)
        return found
    }
    + fn has_value(value: T) bool {
        return this.values_.contains(value)
    }

    #if TEST
    + fn bucket_count_for_test() uint {
        return this.bucket_count
    }
    + fn allocated_buckets_for_test() uint {
        let count: uint = 0
        each this.buckets as bucket {
            if bucket > 0 : count++
        }
        return count
    }
    #end

    + fn remove(key: K) SELF {
        let bucket_index, found = this.find_bucket(key)
        if !found : return this

        let bucket = this.bucket_value(bucket_index)
        if bucket <= 0 : return this
        let index = (bucket - 1).to(uint)
        let last_index = this.length - 1

        this.buckets.set(bucket_index, -1) _
        this.tombstones++

        if index != last_index {
            let moved_bucket = this.entry_buckets.get(last_index) ! panic("HashMap reverse bucket index is out of bounds")
            this.buckets.set(moved_bucket, (index + 1).to(int)) _
        }

        this._keys.swap_remove(index)
        this.values_.swap_remove(index)
        this.entry_buckets.swap_remove(index)
        return this
    }

    + fn clear() SELF {
        this.buckets.clear(true)
        this.entry_buckets.clear()
        this._keys.clear()
        this.values_.clear()
        this.bucket_count = 16
        this.tombstones = 0
        return this
    }

    + fn merge(map: SELF) SELF $add {
        each map as v, k : this.set(k, v)
        return this
    }

    + fn copy() SELF {
        let copy = SELF.new()
        each this as value, key : copy.set(key, value)
        return copy
    }

    + fn clone() SELF $clone {
        let copy = SELF.new()
        each this as value, key {
            copy.set($clone(key), $clone(value))
        }
        return copy
    }

    fn _next(index: uint) (T, K) !IterError {
        let key = this._keys.get(index) ! throw .end
        let value = this.values_.get(index) ! throw .end
        return (value, key)
    }
}

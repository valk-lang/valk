// Up to this many entries a map finds keys by a linear scan and keeps no bucket table
value HASHMAP_SMALL_LIMIT (8)

/// A hash table from keys of type `K` to values of type `T`.
///
/// Keys hash with their `$hash` method, otherwise integers by value and pointers by
/// address; keys are compared with `==`, so equal keys must hash the same. Entries keep
/// insertion order for `each`, `keys` and `values`, except that removing an entry moves
/// the last entry into its place.
/// Build one with `HashMap[K, T]{ k => v }` and iterate with `each map as value, key`.
+ class HashMap[K, T] $global {
    _keys: Array[K] (.{})
    - values_: Array[T] (.{})
    // Only once the map holds more than HASHMAP_SMALL_LIMIT entries; a smaller map finds
    // keys by a linear scan. 0 is empty; positive values are dense entry indexes + 1.
    - buckets: ?Array[int] (null)
    - entry_buckets: ?Array[uint] (null)
    - bucket_count: uint (16)

    /// Creates an empty map with room for `capacity` entries, without rehashing.
    ///
    /// Panics when `capacity` is too large. Marked `$default`: it also provides the type's
    /// default value.
    + static fn new(capacity: uint(0)) SELF $default {
        let map = SELF {}
        if capacity == 0 : return map

        let bucket_count: uint = 16
        while capacity > bucket_count - bucket_count / 4 {
            bucket_count *= 2
            if bucket_count == 0 : panic("HashMap capacity is too large")
        }
        map.bucket_count = bucket_count
        map._keys.increase_size(capacity)
        map.values_.increase_size(capacity)
        if capacity > HASHMAP_SMALL_LIMIT : map.rebuild_buckets(bucket_count)
        return map
    }

    /// The number of entries.
    + get length: uint {
        return this._keys.length
    }
    /// Returns a new array of the keys, in entry order.
    + fn keys() Array[K] {
        return this._keys.copy()
    }
    #if K.$can_order
    /// Reorders the entries so iteration, `keys` and `values` follow ascending key order.
    + fn sort_keys() {
        let keys = this._keys.copy()
        keys.sort()

        let values = Array[T].new(keys.length)
        each keys into key {
            values.append(this.get(key) ! continue)
        }

        this._keys = keys
        this.values_ = values
        if isset(this.buckets) : this.rebuild_buckets(this.bucket_count)
    }
    #end
    /// Returns a new array of the values, in entry order.
    + fn values() Array[T] {
        return this.values_.copy()
    }

    static fn key_hash(key: K) uint {
        #if K.$is_raw_pointer
        @unsafe
        #end
        let hash: uint = 0
        #if K.$has_hash
        hash = $hash(key)
        #elif K.$is_integer
        hash = key.to(uint)
        #elif K.$is_pointer
        hash = key.@cast(uint)
        #else
        #error "HashMap key type must define $hash"
        #end

        #if K.$is_integer
        hash ^= hash >> 30
        hash *= 0xbf58476d1ce4e5b9
        hash ^= hash >> 27
        #else
        hash ^= hash >> 33
        hash *= 0xff51afd7ed558ccd
        hash ^= hash >> 33
        hash *= 0xc4ceb9fe1a85ec53
        hash ^= hash >> 33
        #end
        return hash
    }

    // The dense index of `key`, and whether it is in the map
    fn find_entry(key: K) (uint, bool) {
        #if K.$is_raw_pointer
        @unsafe
        #end
        if isset(this.buckets) {
            let bucket_index, found = this.find_bucket(key)
            if !found : return (0, false)
            return ((this.bucket_value(bucket_index) - 1).to(uint), true)
        }
        let keys = this._keys.items()
        let length = this._keys.length
        let i: uint = 0
        while i < length {
            if @property_get(@ptrv(keys, K, i)) == key : return (i, true)
            i++
        }
        return (0, false)
    }

    fn bucket_value(index: uint) int {
        let buckets = this.buckets ?! panic("HashMap has no buckets")
        return @ptrv(buckets.items(), int, index)
    }

    fn find_bucket(key: K) (uint, bool) {
        @unsafe
        let buckets = this.buckets ?! return (0, false)
        return this.probe(buckets.items(), buckets.length, key)
    }

    // The bucket of `key` among `bucket_count` slots, or the empty one where it would go
    fn probe(slots: ptr, bucket_count: uint, key: K) (uint, bool) {
        #if K.$is_raw_pointer
        @unsafe
        #end
        if bucket_count == 0 : return (0, false)

        let index = SELF.key_hash(key) & (bucket_count - 1)
        let checked: uint = 0
        while checked++ < bucket_count {
            let bucket = @ptrv(slots, int, index)
            if bucket == 0 : return (index, false)
            if bucket < 0 : panic("HashMap contains a deleted bucket")
            let entry_index = (bucket - 1).to(uint)
            let stored_key = @property_get(@ptrv(this._keys.items(), K, entry_index))
            if stored_key == key : return (index, true)
            index++
            if index == bucket_count : index = 0
        }
        return (bucket_count, false)
    }

    fn rebuild_buckets(new_bucket_count: uint) {
        @unsafe
        let buckets = Array[int].new(new_bucket_count)
        buckets.set_expand(new_bucket_count - 1, 0, 0)
        let entry_buckets = Array[uint].new(this.length)
        each this._keys into key, index {
            let bucket_index, found = this.probe(buckets.items(), new_bucket_count, key)
            if found : panic("HashMap contains a duplicate key")
            buckets.set(bucket_index, (index + 1).to(int)) _
            entry_buckets.append(bucket_index)
        }
        this.bucket_count = new_bucket_count
        this.buckets = buckets
        this.entry_buckets = entry_buckets
    }

    // Adds an entry for a key the map does not hold yet
    fn insert_new(key: K, value: T) {
        let entry_index = this._keys.length
        if entry_index == 0 {
            // Most maps stay small: one allocation holds their first entries
            this._keys.increase_size(4)
            this.values_.increase_size(4)
        }
        this._keys.append(key)
        this.values_.append(value)

        let buckets = this.buckets
        if !isset(buckets) {
            if entry_index >= HASHMAP_SMALL_LIMIT : this.rebuild_buckets(this.bucket_count)
            return
        }
        if (entry_index + 1) * 4 > this.bucket_count * 3 {
            this.rebuild_buckets(this.bucket_count * 2)
            return
        }
        let bucket_index, found = this.find_bucket(key)
        if found : panic("HashMap contains a duplicate key")
        buckets.set(bucket_index, (entry_index + 1).to(int)) _
        let entry_buckets = this.entry_buckets ?! panic("HashMap has no entry buckets")
        entry_buckets.append(bucket_index)
    }

    // Remove one bucket while preserving every linear-probe search chain.
    // Returns the dense entry index and the final empty bucket.
    fn delete_bucket(bucket_index: uint) (uint, uint) !LookupError {
        #if K.$is_raw_pointer || T.$is_raw_pointer
        @unsafe
        #end
        let buckets = this.buckets ?! throw .missing
        let entry_buckets = this.entry_buckets ?! throw .missing
        let removed = this.bucket_value(bucket_index)
        if removed <= 0 : throw .missing
        let removed_index = (removed - 1).to(uint)
        let mask = buckets.length - 1
        let hole = bucket_index
        let scan = (hole + 1) & mask

        while true {
            let candidate = this.bucket_value(scan)
            if candidate == 0 : break
            if candidate < 0 : panic("HashMap contains a deleted bucket")
            let entry_index = (candidate - 1).to(uint)
            let key = @property_get(@ptrv(this._keys.items(), K, entry_index))
            let home = SELF.key_hash(key) & mask
            let scan_distance = (scan - home) & mask
            let hole_distance = (hole - home) & mask
            if scan_distance > hole_distance {
                @ptrv(buckets.items(), int, hole) = candidate
                @ptrv(entry_buckets.items(), uint, entry_index) = hole
                hole = scan
            }
            scan = (scan + 1) & mask
        }
        @ptrv(buckets.items(), int, hole) = 0
        return (removed_index, hole)
    }

    fn remove_bucket_entry(bucket_index: uint) uint !LookupError {
        #if K.$is_raw_pointer || T.$is_raw_pointer
        @unsafe
        #end
        let buckets = this.buckets ?! throw .missing
        let entry_buckets = this.entry_buckets ?! throw .missing
        let index, hole = this.delete_bucket(bucket_index) !>
        let last_index = this.length - 1
        if index != last_index {
            let moved_bucket = @ptrv(entry_buckets.items(), uint, last_index)
            @ptrv(buckets.items(), int, moved_bucket) = (index + 1).to(int)
        }
        this._keys.swap_remove(index)
        this.values_.swap_remove(index)
        entry_buckets.swap_remove(index)
        return hole
    }

    /// Stores `value` under `key`, replacing the value of an existing entry in place.
    ///
    /// Backs `map[key] = value` (`$offset_assign`) and the literal `HashMap[K, T]{ k => v }`
    /// (`$set_key`). An existing entry keeps its position and its original key object.
    + fn set(key: K, value: T) $offset_assign $set_key {
        #if K.$is_raw_pointer || T.$is_raw_pointer
        @unsafe
        #end
        let index, found = this.find_entry(key)
        if found {
            @property_update(this.values_.data, @ptrv(this.values_.items(), T, index), value)
            return
        }
        this.insert_new(key, value)
    }

    /// Adds a new entry for `key`.
    ///
    /// Throws `exists`, leaving the map unchanged, when `key` is already present.
    + fn set_unique(key: K, value: T) !LookupError {
        let index, found = this.find_entry(key)
        if found : throw .exists
        this.insert_new(key, value)
    }

    /// Returns the value stored under `key`; backs `map[key]`.
    ///
    /// Throws `missing` when `key` is absent.
    + fn get(key: K) T !LookupError $offset {
        #if K.$is_raw_pointer
        @unsafe
        #end
        let index, found = this.find_entry(key)
        if !found : throw .missing
        return @property_get(@ptrv(this.values_.items(), T, index))
    }

    /// Looks up `key`; when it is absent, removes `remove_key` and stores `replacement` under
    /// `key` instead, without probing for `key` twice.
    ///
    /// Returns the value and true when `key` was present, or `replacement` and false when it
    /// was inserted. The entry count stays the same, which suits fixed-size caches. Throws
    /// `missing`, leaving the map unchanged, when both `key` and `remove_key` are absent.
    + fn get_or_replace(key: K, remove_key: K, replacement: T) (T, bool) !LookupError {
        #if K.$is_raw_pointer || T.$is_raw_pointer
        @unsafe
        #end
        let buckets = this.buckets
        if !isset(buckets) {
            let index, found = this.find_entry(key)
            if found : return (@property_get(@ptrv(this.values_.items(), T, index)), true)
            let remove_index, remove_found = this.find_entry(remove_key)
            if !remove_found : throw .missing
            this._keys.swap_remove(remove_index)
            this.values_.swap_remove(remove_index)
            this.insert_new(key, replacement)
            return (replacement, false)
        }

        let bucket_index, found = this.find_bucket(key)
        if found {
            let bucket = this.bucket_value(bucket_index)
            if bucket <= 0 : throw .missing
            let index = (bucket - 1).to(uint)
            return (@property_get(@ptrv(this.values_.items(), T, index)), true)
        }

        let remove_bucket_index, remove_found = this.find_bucket(remove_key)
        if !remove_found : throw .missing
        let new_hole = this.remove_bucket_entry(remove_bucket_index) !>
        let mask = buckets.length - 1
        let home = SELF.key_hash(key) & mask
        if ((new_hole - home) & mask) < ((bucket_index - home) & mask) {
            bucket_index = new_hole
        }

        let entry_index = this._keys.length
        this._keys.append(key)
        this.values_.append(replacement)
        let entry_buckets = this.entry_buckets ?! throw .missing
        entry_buckets.append(bucket_index)
        buckets.set(bucket_index, (entry_index + 1).to(int)) _
        return (replacement, false)
    }

    /// Returns whether an entry for `key` exists.
    + fn has(key: K) bool {
        let index, found = this.find_entry(key)
        return found
    }
    /// Returns whether any entry holds a value equal to `value` (a linear scan using `==`).
    + fn has_value(value: T) bool {
        return this.values_.contains(value)
    }

    #if TEST
    /// Returns the size of the bucket table. Only compiled in test builds.
    + fn bucket_count_for_test() uint {
        return this.bucket_count
    }
    /// Returns the number of occupied buckets. Only compiled in test builds.
    + fn allocated_buckets_for_test() uint {
        let buckets = this.buckets ?! return 0
        let count: uint = 0
        each buckets as bucket {
            if bucket > 0 : count++
        }
        return count
    }
    #end

    /// Removes the entry for `key`; does nothing when it is absent.
    ///
    /// The last entry moves into the removed entry's position, so iteration order changes.
    + fn remove(key: K) {
        if isset(this.buckets) {
            let bucket_index, found = this.find_bucket(key)
            if !found : return
            this.remove_bucket_entry(bucket_index) ! panic("HashMap bucket index is out of bounds")
            return
        }
        let index, found = this.find_entry(key)
        if !found : return
        this._keys.swap_remove(index)
        this.values_.swap_remove(index)
    }

    /// Removes every entry.
    ///
    /// The bucket table's memory is released, but its size is kept: refilling the map to its
    /// earlier size, or to the capacity passed to `new`, does not rehash.
    + fn clear() {
        this.buckets = null
        this.entry_buckets = null
        this._keys.clear()
        this.values_.clear()
    }

    /// Copies every entry of `map` into this map, replacing values of keys both maps have.
    + fn merge_in_place(map: SELF) {
        each map as v, k : this.set(k, v)
    }

    /// Returns a new map with the entries of this map and of `map`; `map` wins on shared keys.
    ///
    /// Marked `$add`: backs `a + b`. Neither operand changes.
    + fn merge(map: SELF) SELF $add {
        let result = this.copy()
        result.merge_in_place(map)
        return result
    }

    /// Returns a shallow copy: a new map holding the same keys and values.
    + fn copy() SELF {
        let copy = SELF.new(this.length)
        each this as value, key : copy.set(key, value)
        return copy
    }

    /// Returns a deep copy: every key and value is cloned with `$clone`.
    ///
    /// Marked `$clone`: backs `$clone(map)`.
    + fn clone() SELF $clone {
        let copy = SELF.new(this.length)
        each this as value, key {
            copy.set($clone(key), $clone(value))
        }
        return copy
    }

    fn _next(index: uint) (T, K) !IterError {
        let key = this._keys.get(index) ! throw .end
        let value = this.values_.get(index) ! throw .end
        return (value, key)
    }
}

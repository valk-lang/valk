
use core

class HashMapEntry[K, T] {
    key: K
    value: T
    next: ?HashMapEntry[K, T]
}

+ class HashMap[K, T] $global {
    _keys: Array[K] (.{})
    - buckets: Array[?HashMapEntry[K, T]] (.{})
    - bucket_count: uint (16)

    + static fn new() SELF $default {
        return SELF{}
    }

    + fn lock() {
        core:race_lock()
    }
    + fn unlock() {
        core:race_unlock()
    }

    + get length : uint {
        return this._keys.length
    }
    + fn keys() Array[K] {
        return this._keys.copy()
    }
    + fn sort_keys() SELF {
        this._keys.sort()
        return this
    }
    + fn values() Array[T] {
        let values = Array[T].new(this.length)
        each this._keys as key {
            values.append(this.get(key) ! continue)
        }
        return values
    }

    static fn key_hash(key: K) uint {
        let hash : uint = 0
        #if K.$has_method(map_hash)
        hash = key.map_hash()
        #else
        hash = key.@cast(uint)
        #end

        // Mix aligned pointers and patterned integer keys before selecting a
        // bucket. String keys arrive here with their full-byte FNV-1a hash.
        hash ^= hash >> 33
        hash *= 0xff51afd7ed558ccd
        hash ^= hash >> 33
        hash *= 0xc4ceb9fe1a85ec53
        hash ^= hash >> 33
        return hash
    }

    fn bucket_index(key: K) uint {
        return SELF.key_hash(key) % this.bucket_count
    }

    fn find_entry(key: K) ?HashMapEntry[K, T] {
        let entry = this.buckets.get(this.bucket_index(key)) !? null
        while isset(entry) {
            if entry.key == key : return entry
            entry = entry.next
        }
        return null
    }

    fn insert_entry(key: K, value: T) {
        let index = this.bucket_index(key)
        let head = this.buckets.get(index) !? null
        this.buckets.set_expand(index, HashMapEntry[K, T] {
            key: key
            value: value
            next: head
        }, null)
    }

    fn resize(new_bucket_count: uint) {
        let old_buckets = this.buckets
        this.buckets = Array[?HashMapEntry[K, T]].new(new_bucket_count)
        this.bucket_count = new_bucket_count

        each old_buckets as old_head {
            let entry = old_head
            while isset(entry) {
                let next = entry.next
                let index = this.bucket_index(entry.key)
                entry.next = this.buckets.get(index) !? null
                this.buckets.set_expand(index, entry, null)
                entry = next
            }
        }
    }

    fn prepare_insert() {
        let bucket_count = this.bucket_count
        if (this.length + 1) * 4 > bucket_count * 3 {
            this.resize(bucket_count * 2)
        }
    }

    // `$set_key`: class-init map form `HashMap`/`Map`{ k => v, ... }
    + fn set(key: K, value: T) SELF $offset_assign $set_key {
        let entry = this.find_entry(key)
        if isset(entry) {
            entry.value = value
            return this
        }

        this.prepare_insert()
        this._keys.append(key)
        this.insert_entry(key, value)
        return this
    }

    + fn set_unique(key: K, value: T) SELF {
        if isset(this.find_entry(key)) : return this

        this.prepare_insert()
        this._keys.append(key)
        this.insert_entry(key, value)
        return this
    }

    + fn get(key: K) T !LookupError $offset {
        let entry = this.find_entry(key)
        if !isset(entry) : throw .missing
        return entry.value
    }

    + fn has(key: K) bool {
        return isset(this.find_entry(key))
    }
    + fn has_value(value: T) bool {
        each this.buckets as head {
            let entry = head
            while isset(entry) {
                if entry.value == value : return true
                entry = entry.next
            }
        }
        return false
    }

    #if TEST
    + fn bucket_count_for_test() uint {
        return this.bucket_count
    }
    + fn allocated_buckets_for_test() uint {
        let count : uint = 0
        each this.buckets as head {
            if isset(head) : count++
        }
        return count
    }
    #end

    + fn remove(key: K) SELF {
        let index = this.bucket_index(key)
        let entry = this.buckets.get(index) !? null
        let previous : ?HashMapEntry[K, T] = null

        while isset(entry) {
            if entry.key == key {
                if isset(previous) : previous.next = entry.next
                else : this.buckets.set(index, entry.next) _
                this._keys.remove_value(key)
                return this
            }
            previous = entry
            entry = entry.next
        }
        return this
    }

    + fn clear() SELF {
        this.buckets.clear(true)
        this._keys.clear()
        this.bucket_count = 16
        return this
    }

    + fn merge(map: SELF) SELF $add {
        each map as v, k : this.set(k, v)
        return this
    }

    + fn copy() SELF {
        let copy = SELF.new()
        each this as value, key : copy.set(key, value)
        return copy
    }

    + fn clone() SELF {
        let copy = SELF.new()
        each this as value, key {
            copy.set(clone_value_unchecked(key), clone_value_unchecked(value))
        }
        return copy
    }

    fn _next(index: uint) (T, K) !IterError {
        let k = this._keys.get(index) ! throw .end
        return ((this.get(k) ! throw .end), k)
    }
}

// Up to this many entries a map finds keys by a linear scan and keeps no bucket table
value HASHMAP_SMALL_LIMIT (8)

// The bucket table is split in groups of 8 buckets. Each bucket has a control byte:
// 7 bits of its key's hash, or EMPTY, or DELETED (a removed entry that searches pass).
// A search compares a whole group of control bytes at once.
value HASHMAP_EMPTY (0xFF)
value HASHMAP_DELETED (0x80)
value HASHMAP_GROUP_LSB (0x0101010101010101)
value HASHMAP_GROUP_MSB (0x8080808080808080)
// No entry or bucket; one value instead of a (uint, bool) keeps the lookup short
value HASHMAP_NONE (uint.$max)

// A high bit for every byte of `group` equal to the byte in `pattern`; the rare false
// positive only costs a key comparison
fn hashmap_match_byte(group: u64, pattern: u64) u64 $inline {
    let x = group ^ pattern
    return (x - HASHMAP_GROUP_LSB) & ~x & HASHMAP_GROUP_MSB
}

// The 7 hash bits a bucket's control byte holds
fn hashmap_h2(hash: uint) u8 $inline {
    return (hash >> (size_of(uint) * 8 - 7)).to(u8)
}

// A high bit for every EMPTY byte of `group`
fn hashmap_match_empty(group: u64) u64 $inline {
    return group & (group << 1) & HASHMAP_GROUP_MSB
}

// The entries a table of `bucket_count` buckets holds before it grows (3/4)
fn hashmap_capacity(bucket_count: uint) uint $inline {
    return bucket_count - bucket_count / 4
}

// One entry of a HashMap: keys and values share one array, so a small map is two
// allocations (the map and the entry storage)
struct HashMapEntry[K, T] {
    key: K
    value: T
}

/// A hash table from keys of type `K` to values of type `T`.
///
/// Keys hash with their `hash` method, otherwise integers by value and pointers by
/// address; keys are compared with `==`, so equal keys must hash the same. Entries keep
/// insertion order for `each`, `keys` and `values`, except that removing an entry moves
/// the last entry into its place. Removing entries inside `each` is safe: the loop still
/// visits every entry that was not removed, once, and skips the removed ones.
/// Build one with `HashMap[K, T]{ k => v }` and iterate with `each map as value, key`.
+ class HashMap[K, T] $global {
    entries: Array[HashMapEntry[K, T]] (.{})
    // Only once the map holds more than HASHMAP_SMALL_LIMIT entries; a smaller map finds
    // keys by a linear scan. One u64 of control bytes per group, then per bucket the u32
    // index of its entry in `entries`, from u32 position bucket_count / 4.
    - table: ?Array[u64] (null)
    - bucket_count: uint (16)
    // EMPTY buckets that may still be filled before the table is rebuilt
    - growth_left: uint (0)
    // DELETED buckets; too many make searches long, so the table is rebuilt
    - deleted: uint (0)
    // `each` loops running over the map. While one runs, a removed entry stays in the dense
    // arrays as a hole instead of being replaced by the last one, so no loop skips an entry;
    // the last loop to end closes the holes
    - loops: uint (0)
    - holes: uint (0)
    // Which dense positions are holes; positions past its end are not
    - hole_marks: ?Array[bool] (null)

    /// Creates an empty map with room for `capacity` entries, without rehashing.
    ///
    /// Panics when `capacity` is too large. Marked `$default`: it also provides the type's
    /// default value.
    + static fn new(capacity: uint(0)) SELF $default {
        let map = SELF {}
        if capacity == 0 : return map

        let bucket_count: uint = 16
        while capacity > hashmap_capacity(bucket_count) {
            bucket_count *= 2
            if bucket_count == 0 : panic("HashMap capacity is too large")
        }
        map.bucket_count = bucket_count
        map.entries.increase_size(capacity)
        if capacity > HASHMAP_SMALL_LIMIT : map.rebuild_buckets(bucket_count)
        return map
    }

    /// The number of entries.
    + get length: uint {
        return this.entries.length - this.holes
    }
    /// Returns a new array of the keys, in entry order.
    + fn keys() Array[K] {
        let keys = Array[K].new(this.length)
        each this.entries into entry, index {
            if !this.is_hole(index) : keys.append(entry.key)
        }
        return keys
    }
    #if K.$can_order
    /// Reorders the entries so iteration, `keys` and `values` follow ascending key order.
    + fn sort_keys() {
        if this.holes > 0 : this.close_holes()
        this.entries.apply_order(this.keys().sort_order())
        if isset(this.table) : this.rebuild_buckets(this.bucket_count)
    }
    #end
    /// Returns a new array of the values, in entry order.
    + fn values() Array[T] {
        let values = Array[T].new(this.length)
        each this.entries into entry, index {
            if !this.is_hole(index) : values.append(entry.value)
        }
        return values
    }

    // Raw reads of one field of the entry at `index`, without copying the entry
    static fn value_offset() uint $inline {
        @unsafe
        let probe: HashMapEntry[K, T] = @undefined
        return @ref(probe.value).@cast(uint) - @ref(probe).@cast(uint)
    }
    static fn key_at(items: ptr, index: uint) K $inline {
        @unsafe
        return @property_get(@ptrv(items.@offset(index * size_of(HashMapEntry[K, T])), K))
    }
    static fn value_at(items: ptr, index: uint) T $inline {
        @unsafe
        return @property_get(@ptrv(items.@offset(index * size_of(HashMapEntry[K, T]) + SELF.value_offset()), T))
    }
    fn value_at_index(index: uint) T $inline {
        @unsafe
        return SELF.value_at(this.entries.items(), index)
    }
    // Replaces the value of the entry at `index` in place
    fn update_value(index: uint, value: T) $inline {
        @unsafe
        let slot = this.entries.items().@offset(index * size_of(HashMapEntry[K, T]) + SELF.value_offset())
        @property_update(this.entries.data, @ptrv(slot, T), value)
    }

    fn key_hash(key: K) uint {
        #if K.$is_raw_pointer
        @unsafe
        #end
        let hash: uint = 0
        #if K.$has_hash
        hash = $hash(key)
        #elif K.$is_integer
        hash = key.to(uint)
        #elif K.$is_pointer
        // The key's identity
        @unsafe
        hash = key.@cast(uint)
        #else
        #error "HashMap key type must have a 'hash' method"
        #end

        #if K.$is_integer
        hash ^= hash >> 30
        hash *= 0xbf58476d1ce4e5b9
        hash ^= hash >> 27
        #else
        hash ^= hash >> 33
        hash *= 0xff51afd7ed558ccd
        hash ^= hash >> 33
        hash *= 0xc4ceb9fe1a85ec53
        hash ^= hash >> 33
        #end
        return hash
    }

    // The dense index of `key`, or HASHMAP_NONE
    fn find_entry(key: K) uint {
        @unsafe
        let table = this.table
        if isset(table) {
            let slot = this.find_slot(key, this.key_hash(key))
            if slot == HASHMAP_NONE : return HASHMAP_NONE
            return @ptrv(table.items(), u32, this.bucket_count / 4 + slot).to(uint)
        }
        let items = this.entries.items()
        let length = this.entries.length
        let base = this.entries.data.@cast(ptr)
        let i: uint = 0
        while i < length {
            if SELF.key_at(items, i) == key && !this.is_hole(i) : return i
            // A `$eq` that changed the map ends the search
            if this.entries.changed(length, base) : return HASHMAP_NONE
            i++
        }
        return HASHMAP_NONE
    }

    // The bucket holding `key`, or HASHMAP_NONE
    fn find_slot(key: K, hash: uint) uint {
        @unsafe
        let table = this.table ?! return HASHMAP_NONE
        let groups = table.items()
        let items = this.entries.items()
        let length = this.entries.length
        let base = this.entries.data.@cast(ptr)
        let entries_at = this.bucket_count / 4
        let group_mask = this.bucket_count / 8 - 1
        let pattern = hashmap_h2(hash).to(u64) * HASHMAP_GROUP_LSB
        let index = hash & group_mask
        let stride: uint = 0
        while true {
            let group = @ptrv(groups, u64, index)
            let matches = hashmap_match_byte(group, pattern)
            while matches != 0 {
                let slot = index * 8 + matches.trailing_zeros() / 8
                let entry = @ptrv(groups, u32, entries_at + slot)
                if SELF.key_at(items, entry) == key : return slot
                // A `$eq` that changed the map ends the search
                if this.entries.changed(length, base) || this.table.@cast(?ptr) != table.@cast(ptr) : return HASHMAP_NONE
                matches &= matches - 1
            }
            if hashmap_match_empty(group) != 0 : return HASHMAP_NONE
            stride++
            index = (index + stride) & group_mask
        }
        return HASHMAP_NONE
    }

    // The first EMPTY or DELETED bucket on the search path of `hash`
    static fn find_free_slot(groups: ptr, group_mask: uint, hash: uint) uint {
        @unsafe
        let index = hash & group_mask
        let stride: uint = 0
        while true {
            let free = @ptrv(groups, u64, index) & HASHMAP_GROUP_MSB
            if free != 0 : return index * 8 + free.trailing_zeros() / 8
            stride++
            index = (index + stride) & group_mask
        }
        return 0
    }

    fn rebuild_buckets(new_bucket_count: uint) {
        @unsafe
        if this.entries.length > u32.$max.to(uint) : panic("HashMap capacity is too large")
        let group_count = new_bucket_count / 8
        // Control groups all EMPTY; the entry indexes are written as buckets fill
        let table = Array[u64].fill(group_count + new_bucket_count / 2, 0xFFFFFFFFFFFFFFFF)
        let groups = table.items()
        let entries_at = new_bucket_count / 4
        let count = this.entries.length
        let index: uint = 0
        while index < count {
            if this.is_hole(index) {
                index++
                continue
            }
            let hash = this.key_hash(SELF.key_at(this.entries.items(), index))
            let slot = SELF.find_free_slot(groups, group_count - 1, hash)
            @ptrv(groups, u8, slot) = hashmap_h2(hash)
            @ptrv(groups, u32, entries_at + slot) = index.to(u32)
            index++
        }
        this.bucket_count = new_bucket_count
        this.growth_left = hashmap_capacity(new_bucket_count) - this.length
        this.deleted = 0
        this.table = table
    }

    // Adds an entry for a key the map does not hold yet
    fn insert_new(key: K, value: T) {
        if isset(this.table) {
            this.append_entry(key, value, this.key_hash(key))
            return
        }
        let entry_index = this.entries.length
        // Most maps stay small: one allocation holds their first entries
        if entry_index == 0 : this.entries.increase_size(4)
        this.entries.append(HashMapEntry[K, T] { key: key, value: value })
        if entry_index >= HASHMAP_SMALL_LIMIT : this.rebuild_buckets(this.bucket_count)
    }

    // Adds an entry for a key the bucket table does not hold
    fn append_entry(key: K, value: T, hash: uint) {
        @unsafe
        let table = this.table ?! panic("HashMap has no buckets")
        let entry_index = this.entries.length
        this.entries.append(HashMapEntry[K, T] { key: key, value: value })
        let slot = SELF.find_free_slot(table.items(), this.bucket_count / 8 - 1, hash)
        this.place_entry(entry_index, hash, slot)
    }

    // Puts the entry at `entry_index` in the free bucket `slot` on its search path
    fn place_entry(entry_index: uint, hash: uint, slot: uint) {
        @unsafe
        let table = this.table ?! panic("HashMap has no buckets")
        if entry_index > u32.$max.to(uint) : panic("HashMap capacity is too large")
        let groups = table.items()
        if @ptrv(groups, u8, slot) == HASHMAP_EMPTY {
            if this.growth_left == 0 {
                // Rebuilt at the same size when DELETED buckets used up the room
                let entries = this.length
                let size = entries <= hashmap_capacity(this.bucket_count) / 2 ? this.bucket_count : this.bucket_count * 2
                if size == 0 : panic("HashMap capacity is too large")
                this.rebuild_buckets(size)
                return
            }
            this.growth_left--
        } else {
            this.deleted--
        }
        @ptrv(groups, u8, slot) = hashmap_h2(hash)
        @ptrv(groups, u32, this.bucket_count / 4 + slot) = entry_index.to(u32)
    }

    // The bucket of the entry at `entry_index`
    fn slot_of_entry(entry_index: uint) uint {
        @unsafe
        let table = this.table ?! panic("HashMap has no buckets")
        let groups = table.items()
        let entries_at = this.bucket_count / 4
        let group_mask = this.bucket_count / 8 - 1
        let hash = this.key_hash(SELF.key_at(this.entries.items(), entry_index))
        let pattern = hashmap_h2(hash).to(u64) * HASHMAP_GROUP_LSB
        let index = hash & group_mask
        let stride: uint = 0
        while true {
            let group = @ptrv(groups, u64, index)
            let matches = hashmap_match_byte(group, pattern)
            while matches != 0 {
                let slot = index * 8 + matches.trailing_zeros() / 8
                if @ptrv(groups, u32, entries_at + slot).to(uint) == entry_index : return slot
                matches &= matches - 1
            }
            if hashmap_match_empty(group) != 0 : break
            stride++
            index = (index + stride) & group_mask
        }
        panic("HashMap entry has no bucket")
    }

    // Removes the entry in `slot`; the last entry takes its place in the dense arrays, or,
    // while a loop runs, the entry's position becomes a hole
    fn remove_slot(slot: uint) {
        @unsafe
        let table = this.table ?! panic("HashMap has no buckets")
        let groups = table.items()
        let entries_at = this.bucket_count / 4
        let index = @ptrv(groups, u32, entries_at + slot).to(uint)
        // EMPTY when the group has an EMPTY bucket already, since no search continues past
        // such a group; otherwise DELETED, so searches still pass it
        if hashmap_match_empty(@ptrv(groups, u64, slot / 8)) != 0 {
            @ptrv(groups, u8, slot) = HASHMAP_EMPTY
            this.growth_left++
        } else {
            @ptrv(groups, u8, slot) = HASHMAP_DELETED
            this.deleted++
        }
        if this.loops > 0 {
            this.mark_hole(index)
            if this.deleted > this.bucket_count / 8 : this.rebuild_buckets(this.bucket_count)
            return
        }
        let last_index = this.entries.length - 1
        if index != last_index {
            let moved_slot = this.slot_of_entry(last_index)
            @ptrv(groups, u32, entries_at + moved_slot) = index.to(u32)
        }
        this.entries.swap_remove(index)
        if this.deleted > this.bucket_count / 8 : this.rebuild_buckets(this.bucket_count)
    }

    /// Stores `value` under `key`, replacing the value of an existing entry in place.
    ///
    /// Backs `map[key] = value` (`$offset_assign`) and the literal `HashMap[K, T]{ k => v }`
    /// (`$set_key`). An existing entry keeps its position and its original key object.
    + fn set(key: K, value: T) $offset_assign $set_key {
        #if K.$is_raw_pointer || T.$is_raw_pointer
        @unsafe
        #end
        if isset(this.table) {
            let hash = this.key_hash(key)
            let slot = this.find_slot(key, hash)
            // Read after the hooks ran, which may have changed the map
            let table = this.table
            if slot != HASHMAP_NONE && isset(table) {
                let index = @ptrv(table.items(), u32, this.bucket_count / 4 + slot).to(uint)
                this.update_value(index, value)
                return
            }
            this.append_entry(key, value, hash)
            return
        }
        let index = this.find_entry(key)
        if index != HASHMAP_NONE {
            this.update_value(index, value)
            return
        }
        this.insert_new(key, value)
    }

    /// Adds a new entry for `key`.
    ///
    /// Throws `exists`, leaving the map unchanged, when `key` is already present.
    + fn set_unique(key: K, value: T) !LookupError {
        if isset(this.table) {
            let hash = this.key_hash(key)
            if this.find_slot(key, hash) != HASHMAP_NONE : throw .exists
            this.append_entry(key, value, hash)
            return
        }
        if this.find_entry(key) != HASHMAP_NONE : throw .exists
        this.insert_new(key, value)
    }

    /// Returns the value stored under `key`; backs `map[key]`.
    ///
    /// Throws `missing` when `key` is absent.
    + fn get(key: K) T !LookupError $offset {
        #if K.$is_raw_pointer
        @unsafe
        #end
        let index = this.find_entry(key)
        if index == HASHMAP_NONE : throw .missing
        return this.value_at_index(index)
    }

    /// Stores what `change` makes of the current value (`null` when there is none), and returns
    /// it.
    + fn update(key: K, change: fn(?T)(T)) T {
        let value = change(this.get(key) !? null)
        this.set(key, value)
        return value
    }

    #if T.$is_integer || T.$is_float
    /// Adds `amount` to the value of `key`, which starts at 0, and returns the new value.
    ///
    /// Probes for `key` once: `counts.add(word, 1)` counts occurrences.
    + fn add(key: K, amount: T) T {
        #if K.$is_raw_pointer
        @unsafe
        #end
        if isset(this.table) {
            let hash = this.key_hash(key)
            let slot = this.find_slot(key, hash)
            // Read after the hooks ran, which may have changed the map
            let table = this.table
            if slot != HASHMAP_NONE && isset(table) {
                let index = @ptrv(table.items(), u32, this.bucket_count / 4 + slot).to(uint)
                let value = this.value_at_index(index) + amount
                this.update_value(index, value)
                return value
            }
            this.append_entry(key, amount, hash)
            return amount
        }
        let index = this.find_entry(key)
        if index != HASHMAP_NONE {
            let value = this.value_at_index(index) + amount
            this.update_value(index, value)
            return value
        }
        this.insert_new(key, amount)
        return amount
    }
    #end

    /// Looks up `key`; when it is absent, removes `remove_key` and stores `replacement` under
    /// `key` instead, without probing for `key` twice.
    ///
    /// Returns the value and true when `key` was present, or `replacement` and false when it
    /// was inserted. The entry count stays the same, which suits fixed-size caches. Throws
    /// `missing`, leaving the map unchanged, when both `key` and `remove_key` are absent.
    + fn get_or_replace(key: K, remove_key: K, replacement: T) (T, bool) !LookupError {
        #if K.$is_raw_pointer || T.$is_raw_pointer
        @unsafe
        #end
        let table = this.table
        if !isset(table) {
            let index = this.find_entry(key)
            if index != HASHMAP_NONE : return (this.value_at_index(index), true)
            let remove_index = this.find_entry(remove_key)
            if remove_index == HASHMAP_NONE : throw .missing
            this.remove_small(remove_index)
            this.insert_new(key, replacement)
            // Read back from the map: on locked data the stored value is part of it now
            return (this.value_at_index(this.entries.length - 1), false)
        }

        let hash = this.key_hash(key)
        let slot = this.find_slot(key, hash)
        let current = this.table
        if slot != HASHMAP_NONE && isset(current) {
            let index = @ptrv(current.items(), u32, this.bucket_count / 4 + slot).to(uint)
            return (this.value_at_index(index), true)
        }

        let remove_slot = this.find_slot(remove_key, this.key_hash(remove_key))
        if remove_slot == HASHMAP_NONE : throw .missing
        this.remove_slot(remove_slot)
        this.append_entry(key, replacement, hash)
        return (this.value_at_index(this.entries.length - 1), false)
    }

    /// Returns whether an entry for `key` exists.
    + fn has(key: K) bool {
        return this.find_entry(key) != HASHMAP_NONE
    }
    /// Returns whether any entry holds a value equal to `value` (a linear scan using `==`).
    + fn has_value(value: T) bool {
        each this.entries into entry, index {
            if entry.value == value && !this.is_hole(index) : return true
        }
        return false
    }

    #if TEST
    /// Returns the size of the bucket table. Only compiled in test builds.
    + fn bucket_count_for_test() uint {
        return this.bucket_count
    }
    /// Returns the number of occupied buckets. Only compiled in test builds.
    + fn allocated_buckets_for_test() uint {
        let table = this.table ?! return 0
        let count: uint = 0
        let group_count = this.bucket_count / 8
        each table as group, index {
            if index < group_count : count += (~group & HASHMAP_GROUP_MSB).count_ones()
        }
        return count
    }
    #end

    /// Removes the entry for `key`; does nothing when it is absent.
    ///
    /// The last entry moves into the removed entry's position, so iteration order changes.
    /// Inside an `each` over this map nothing moves until the loop ends, so the loop still
    /// visits every other entry once.
    + fn remove(key: K) {
        if isset(this.table) {
            let slot = this.find_slot(key, this.key_hash(key))
            if slot != HASHMAP_NONE : this.remove_slot(slot)
            return
        }
        let index = this.find_entry(key)
        if index == HASHMAP_NONE : return
        this.remove_small(index)
    }

    // Removes the entry at `index` of a map without a bucket table
    fn remove_small(index: uint) {
        if this.loops > 0 {
            this.mark_hole(index)
            return
        }
        this.entries.swap_remove(index)
    }

    // Removes the entry for `key` and moves every later entry up one place, so the order
    // stays; O(n) without hashing. For `json` objects, which keep insertion order
    fn remove_keep_order(key: K) {
        @unsafe
        // A hole keeps the order as well
        if this.loops > 0 {
            this.remove(key)
            return
        }
        let table = this.table
        if !isset(table) {
            let index = this.find_entry(key)
            if index == HASHMAP_NONE : return
            this.entries.remove(index)
            return
        }
        let slot = this.find_slot(key, this.key_hash(key))
        let current = this.table
        if slot == HASHMAP_NONE || !isset(current) : return
        let groups = current.items()
        let entries_at = this.bucket_count / 4
        let index = @ptrv(groups, u32, entries_at + slot)
        // Cleared as in remove_slot
        if hashmap_match_empty(@ptrv(groups, u64, slot / 8)) != 0 {
            @ptrv(groups, u8, slot) = HASHMAP_EMPTY
            this.growth_left++
        } else {
            @ptrv(groups, u8, slot) = HASHMAP_DELETED
            this.deleted++
        }
        // A full bucket's control byte has its high bit clear
        let bucket: uint = 0
        while bucket < this.bucket_count {
            if (@ptrv(groups, u8, bucket) & 0x80) == 0 {
                let at = @ptrv(groups, u32, entries_at + bucket)
                if at > index : @ptrv(groups, u32, entries_at + bucket) = at - 1
            }
            bucket++
        }
        this.entries.remove(index.to(uint))
        if this.deleted > this.bucket_count / 8 : this.rebuild_buckets(this.bucket_count)
    }

    /// Removes the entries for which `func` returns true; the rest keep their order.
    ///
    /// `func` gets the value and the key, like `each map as value, key`, and must not change
    /// the map. Inside an `each` over this map the loop still visits every kept entry once.
    + fn remove_where(func: fn(T, K)(bool)) {
        this.filter_entries(func, true)
    }

    /// Keeps only the entries for which `func` returns true; the opposite of `remove_where`.
    + fn retain(func: fn(T, K)(bool)) {
        this.filter_entries(func, false)
    }

    fn filter_entries(func: fn(T, K)(bool), remove: bool) {
        let count = this.entries.length
        if this.loops > 0 {
            // A loop runs over the map: removed entries become holes
            let i: uint = 0
            while i < count {
                if !this.is_hole(i) {
                    let entry = this.entries.get(i) ! break
                    if func(entry.value, entry.key) == remove : this.mark_hole(i)
                }
                i++
            }
            return
        }
        // Kept entries move forward in place: no new arrays, and on locked data nothing leaves it
        let kept: uint = 0
        let i: uint = 0
        while i < count {
            let entry = this.entries.get(i) ! break
            if func(entry.value, entry.key) != remove {
                if kept != i : this.entries.set(kept, entry) _
                kept++
            }
            i++
        }
        if kept == count : return
        while this.entries.length > kept : this.entries.pop_last() _
        if isset(this.table) : this.rebuild_buckets(this.bucket_count)
    }

    /// Removes every entry.
    ///
    /// The bucket table's memory is released, but its size is kept: refilling the map to its
    /// earlier size, or to the capacity passed to `new`, does not rehash.
    + fn clear() {
        this.table = null
        this.entries.clear()
        this.holes = 0
        this.hole_marks = null
    }

    /// Copies every entry of `map` into this map, replacing values of keys both maps have.
    + fn merge_in_place(map: SELF) {
        each map as v, k : this.set(k, v)
    }

    /// Returns a new map with the entries of this map and of `map`; `map` wins on shared keys.
    ///
    /// Marked `$add`: backs `a + b`. Neither operand changes.
    + fn merge(map: SELF) SELF $add {
        let result = this.copy()
        result.merge_in_place(map)
        return result
    }

    /// Returns a shallow copy: a new map holding the same keys and values.
    + fn copy() SELF {
        let copy = SELF.new(this.length)
        each this as value, key : copy.set(key, value)
        return copy
    }

    /// Returns a deep copy: every key and value is cloned.
    + fn clone() SELF {
        let copy = SELF.new(this.length)
        each this as value, key {
            copy.set(clone key, clone value)
        }
        return copy
    }

    fn _next(index: uint) (T, K) !IterError {
        let entry = this.entries.get(index) ! throw .end
        return (entry.value, entry.key)
    }

    fn _each_begin() {
        this.loops++
    }

    fn _each_end() {
        if this.loops > 0 : this.loops--
        if this.loops == 0 && this.holes > 0 : this.close_holes()
    }

    // The first position at or after `index` that is not a hole
    fn _each_skip(index: uint) uint $inline {
        if this.holes == 0 : return index
        return this.skip_holes(index)
    }

    fn skip_holes(index: uint) uint $noinline {
        while this.is_hole(index) : index++
        return index
    }

    fn is_hole(index: uint) bool {
        if this.holes == 0 : return false
        let marks = this.hole_marks ?! return false
        return marks.get(index) !? false
    }

    fn mark_hole(index: uint) {
        // Read back from the map, a kept local would alias the stored array
        if !isset(this.hole_marks) : this.hole_marks = Array[bool].new(this.entries.length)
        let marks = this.hole_marks ?! return
        while marks.length <= index : marks.append(false)
        marks.set(index, true) _
        this.holes++
    }

    // Moves the entries left of the holes together, keeping their order. In place: the
    // entries never leave the map, so this also works on locked data
    fn close_holes() $noinline {
        let count = this.entries.length
        let kept: uint = 0
        let i: uint = 0
        while i < count {
            if !this.is_hole(i) {
                if kept != i : this.entries.swap(kept, i)
                kept++
            }
            i++
        }
        this.entries.truncate(kept)
        this.holes = 0
        this.hole_marks = null
        if isset(this.table) : this.rebuild_buckets(this.bucket_count)
    }
}

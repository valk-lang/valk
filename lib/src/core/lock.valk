// Mutable shared data. The value can only be reached inside a `lock` block,
// which holds the mutex for the length of the block:
//
//     let state: shared Lock[Stats] = .new(Stats {}) !>
//     lock state as s {
//         s.count++
//     }
+ class Lock[T] $global {
    - mutex: Mutex
    - value: T

    + static fn new(value: T) SELF !InitError {
        return SELF { mutex: Mutex.new() !>, value: value }
    }

    fn acquire() @threadsafe {
        this.mutex.lock()
    }

    fn release() @threadsafe {
        this.mutex.unlock()
    }
}

use ext
use gc

#if OS != "win"
use mem
#end

/// A mutex backed by an OS mutex (pthread, or a Win32 mutex object on Windows).
///
/// Waiting blocks the whole thread, including its other coroutines; coroutine code should
/// use `Mutex` instead. On Windows the owning thread may lock it again (it is reentrant);
/// elsewhere locking it twice from one thread deadlocks.
+ class SyncMutex {
    #if OS == "win"
    - mutex: ext.HANDLE
    #else
    - mutex: ptr
    #end

    /// Creates an unlocked mutex; panics when the OS cannot create one.
    ///
    /// Marked `$default`: it also provides `SyncMutex.$default_value`.
    + static fn new() SELF $default {
        @unsafe
        #if OS == "win"
        let mut = ext.CreateMutexA(null, 0, null)
        if mut == 0 : panic("Failed to create mutex")
        #else
        let mut = mem.calloc(64)
        if ext.pthread_mutex_init(mut, null) != 0 : panic("Failed to initialize mutex")
        #end
        return SELF { mutex: mut }
    }

    /// Takes the mutex, blocking the thread until it is free.
    ///
    /// The GC lock is released while waiting, so other threads can collect. Panics when the
    /// wait fails.
    + fn lock() void {
        gc.unlock()
        #if OS == "win"
        let wait_result = ext.WaitForSingleObject(this.mutex, ext.INFINITE)
        #else
        let wait_result = ext.pthread_mutex_lock(this.mutex)
        #end
        gc.lock()
        #if OS == "win"
        if wait_result != 0 : panic("Failed to lock mutex (wait result " + wait_result + ", error " + ext.GetLastError() + ")")
        #else
        if wait_result != 0 : panic("Failed to lock mutex (error " + wait_result + ")")
        #end
    }

    /// Releases the mutex; panics when the OS rejects the unlock.
    + fn unlock() void {
        #if OS == "win"
        if ext.ReleaseMutex(this.mutex) == 0 : panic("Failed to unlock mutex (error " + ext.GetLastError() + ")")
        #else
        let error = ext.pthread_mutex_unlock(this.mutex)
        if error != 0 : panic("Failed to unlock mutex (error " + error + ")")
        #end
    }

    fn gc_free() void {
        #if OS == "win"
        if ext.CloseHandle(this.mutex) == 0 {
            cleanup_warning("Failed to close mutex", __FILE__, __LINE__)
        }
        #else
        @unsafe
        if ext.pthread_mutex_destroy(this.mutex) != 0 {
            cleanup_warning("Failed to destroy mutex", __FILE__, __LINE__)
        } else {
            mem.free(this.mutex)
        }
        #end
    }
}

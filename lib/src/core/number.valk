
use ext
use mem
use io
use time

// to_base_to_ptr writes at most 64 digits plus a sign: i64.min in base 2 is 65 bytes, and
// u64.max in base 2 is 64 digits with no sign. Both buffers are that wide so the writer can
// never run past what the globals hold.
global num2str_buf1: [u8 x 65] (@undefined)
global num2str_buf2: [u8 x 65] (@undefined)
global randcount: uint

+ trait Number {
    + fn to_string() String $auto {
        return this.to_base(10)
    }
    + fn to_hex() String {
        return this.to_base(16)
    }

    + fn round_up(modulo: SELF) SELF {
        return this + ((modulo - (this % modulo)) % modulo)
    }
    + fn round_down(modulo: SELF) SELF {
        return this - (this % modulo)
    }

    + fn to_base(base: SELF) String {
        if this == 0 : return "0"
        let buf = num2str_buf1
        let len = this.to_base_to_ptr(base, &buf)
        return String.copy_from_ptr(&buf, len)
    }

    + fn to_base_to_ptr(base: SELF, result: ptr, lowercase: bool (false)) uint {
        // A base outside 2..=16 is not a wider or narrower request, it is a bug: base 1
        // never shrinks `val` so the digit loop below runs forever writing one scratch byte
        // per pass, and base 0 divides by zero. Both fall back to 10 for every type — this
        // guard used to sit inside #if SELF.$is_signed, which left the unsigned loop
        // unclamped. `to_base` clamps the same way so a base beyond 16 cannot make
        // character_length and this writer disagree about how many digits a value needs.
        if base > 16 : base = 16
        if base < 2 : base = 10
        let base_ = base

        let chars = lowercase ? "0123456789abcdef".data : "0123456789ABCDEF".data

        let rev = num2str_buf2

        let val = this
        let negative = false
        #if SELF.$is_signed
        if val < 0 {
            negative = true
        } else {
            val = 0 - val
        }

        let i: uint = 0
        while val < 0 {
            let digit = 0 - (val % base_)
            @ptrv(rev, u8, i) = @ptrv(chars, u8, digit)
            i++
            val = val / base_
        }
        #else
        let i: uint = 0
        while val > 0 {
            @ptrv(rev, u8, i) = @ptrv(chars, u8, val % base_)
            i++
            val = val / base_
        }
        #end
        // Set len
        if i == 0 {
            @ptrv(result, u8, 0) = '0'
            // @ptrv(result, u8, 1) = 0
            return 1
        }
        let len = i
        #if SELF.$is_signed
        if negative {
            len++
            @ptrv(result, u8, 0) = '-'
        }
        #end
        // Reverse
        let amount = i
        let offset: uint = negative ? 1 : 0
        while i-- > 0 {
            @ptrv(result, u8, i + offset) = @ptrv(rev, u8, amount - i - 1)
        }
        // @ptrv(result, u8, len) = 0

        return len
    }

    + fn character_length(base: SELF) uint {
        if this == 0 : return 1
        // Clamped exactly like to_base_to_ptr, because callers use this to size what that
        // one writes: an unclamped base 1 looped forever and base 0 divided by zero.
        if base > 16 : base = 16
        if base < 2 : base = 10
        let val = this
        let i: uint = 0
        #if SELF.$is_signed
        let negative = val < 0
        if val > 0 : val = 0 - val
        while val < 0 {
            i++
            val = val / base
        }
        if negative : i++
        #else
        while val > 0 {
            i++
            val = val / base
        }
        #end
        return i
    }

    + fn print(base: SELF) {
        let buf = num2str_buf1
        let len = this.to_base_to_ptr(base, &buf)
        io.write_bytes_sync(1, &buf, len) !? 0
    }

    + fn equals_string(str: String) bool $eq {
        #if SELF.$is_signed
        let v = str.to_int() ! return false
        #else
        let v = str.to_uint() ! return false
        #end
        return this == v
    }

    + static fn write_little_endian(v: SELF, to: *[u8 x size_of(SELF)]) {
        let i = 0
        while i < size_of(SELF) {
            to[i++] = (v & 0xFF).to(u8)
            #if size_of(SELF) > 1
            v = v >> 8
            #end
        }
    }
    + static fn write_big_endian(v: SELF, to: *[u8 x size_of(SELF)]) {
        let i = size_of(SELF)
        while i-- > 0 {
            to[i] = (v & 0xFF).to(u8)
            #if size_of(SELF) > 1
            v = v >> 8
            #end
        }
    }

    + static fn read_little_endian(from: *[u8 x size_of(SELF)]) SELF {
        let v: SELF = 0
        let sh: SELF = 0
        let i = 0
        while i < size_of(SELF) {
            v = v | (from[i++].to(SELF) << sh)
            sh += 8
        }
        return v
    }
    + static fn read_big_endian(from: *[u8 x size_of(SELF)]) SELF {
        let v: SELF = 0
        let sh: SELF = 0
        let i = size_of(SELF)
        while i-- > 0 {
            v = v | (from[i].to(SELF) << sh)
            sh += 8
        }
        return v
    }

    + static fn random() SELF {
        randcount++
        ext.srand(time.unix_us().to(u32) + randcount.to(u32))
        let low = ext.rand().to(u32).to(u64)
        randcount++
        ext.srand(time.unix_us().to(u32) + randcount.to(u32))
        let high = ext.rand().to(u32).to(u64)
        return (low | (high << 32)).to(SELF)
    }

    + static fn secure_random() SELF !ExternError {
        let value: u64 = 0
        if !fill_secure_random(&value, size_of(u64)) : throw .extern
        return value.to(SELF)
    }
}

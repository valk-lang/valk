@unsafe

use ext
use mem
use io

// to_base_to_ptr writes at most 64 digits plus a sign: i64.min in base 2 is 65 bytes, and
// u64.max in base 2 is 64 digits with no sign. Both buffers are that wide so the writer can
// never run past what the globals hold.
global num2str_buf1: [u8 x 65] (@undefined)
global num2str_buf2: [u8 x 65] (@undefined)

/// Methods shared by every integer type.
+ trait Number {
    /// Returns the absolute value. Unsigned values are returned unchanged.
    ///
    /// Panics for the minimum value of a signed type (e.g. `i8.$min`), whose absolute value
    /// does not fit.
    + fn abs() SELF {
        #if SELF.$is_signed
        if this < 0 {
            let result = 0 - this
            if result < 0 : panic("The absolute value is outside the integer range")
            return result
        }
        #end
        return this
    }

    /// Returns the smaller of `this` and `other`.
    + fn min(other: SELF) SELF {
        return this < other ? this : other
    }

    /// Returns the larger of `this` and `other`.
    + fn max(other: SELF) SELF {
        return this > other ? this : other
    }

    /// Returns the value limited to the range `minimum` to `maximum`, both inclusive.
    ///
    /// Panics when `minimum` is greater than `maximum`.
    + fn clamp(minimum: SELF, maximum: SELF) SELF {
        if minimum > maximum : panic("The minimum cannot exceed the maximum")
        if this < minimum : return minimum
        if this > maximum : return maximum
        return this
    }

    /// Returns the value in decimal, with a leading `-` when negative.
    ///
    /// Tagged `$auto`, so an integer converts to `String` implicitly wherever one is expected.
    + fn to_string() String $auto {
        return this.to_base(10)
    }
    /// Returns the value in uppercase hexadecimal without a `0x` prefix, e.g. `FF` or `-FF`.
    + fn to_hex() String {
        return this.to_base(16)
    }

    /// Rounds up, toward positive infinity, to a multiple of `modulo`; multiples are returned
    /// unchanged.
    ///
    /// `(5).round_up(4)` is 8 and `(-5).round_up(4)` is -4. The sign of `modulo` does not
    /// matter. Panics when `modulo` is 0 or the rounded value does not fit in the type, e.g.
    /// `u8.$max.round_up(4)`.
    + fn round_up(modulo: SELF) SELF {
        if modulo == 0 : panic("Cannot round to a multiple of 0")
        let rem = this % modulo
        if rem == 0 : return this
        #if SELF.$is_signed
        if rem < 0 : return this - rem
        if modulo < 0 {
            let result = this - (modulo + rem)
            if result < this : panic("The rounded value is outside the integer range")
            return result
        }
        #end
        let result = this + (modulo - rem)
        if result < this : panic("The rounded value is outside the integer range")
        return result
    }
    /// Rounds down, toward negative infinity, to a multiple of `modulo`; multiples are returned
    /// unchanged.
    ///
    /// `(5).round_down(4)` is 4 and `(-5).round_down(4)` is -8. The sign of `modulo` does not
    /// matter. Panics when `modulo` is 0 or the rounded value does not fit in the type, e.g.
    /// `i8.$min.round_down(3)`.
    + fn round_down(modulo: SELF) SELF {
        if modulo == 0 : panic("Cannot round to a multiple of 0")
        let rem = this % modulo
        if rem == 0 : return this
        #if SELF.$is_signed
        if rem < 0 {
            let result = this - (modulo > 0 ? rem + modulo : rem - modulo)
            if result > this : panic("The rounded value is outside the integer range")
            return result
        }
        #end
        let result = this - rem
        if result > this : panic("The rounded value is outside the integer range")
        return result
    }

    /// Returns the value as text in `base` (2 to 16), with a leading `-` when negative.
    ///
    /// Digits above 9 are uppercase. A `base` above 16 is treated as 16 and one below 2 as 10.
    + fn to_base(base: SELF) String {
        @unsafe
        if this == 0 : return "0"
        let buf = num2str_buf1
        let len = this.to_base_to_ptr(base, &buf)
        return String.copy_from_ptr(&buf, len)
    }

    /// Writes the value as text in `base` to `out` and returns the bytes written.
    ///
    /// The text is built on the stack, so nothing is allocated. Digits above 9 are lowercase
    /// when `lowercase` is true, uppercase otherwise; `base` is clamped as in `to_base`.
    /// Throws when `out` fails.
    + fn to_base_into(base: SELF, out: io.Writer, lowercase: bool (false)) uint !io.IoError {
        let buf: [u8 x 65] = { 0... }
        let len = this.to_base_to_ptr(base, &buf, lowercase)
        let text: local &[u8] = &buf
        return out.write(text.view(0, len)) !>
    }

    /// Writes the value as text in `base` to `result` and returns the byte count.
    ///
    /// Digits above 9 are lowercase when `lowercase` is true, uppercase otherwise. A `base`
    /// above 16 is treated as 16 and one below 2 as 10. Writes at most 65 bytes (a sign plus 64
    /// binary digits) and no terminating zero.
    + fn to_base_to_ptr(base: SELF, result: ptr, lowercase: bool (false)) uint {
        // A base outside 2..=16 is not a wider or narrower request, it is a bug: base 1
        // never shrinks `val` so the digit loop below runs forever writing one scratch byte
        // per pass, and base 0 divides by zero. Both fall back to 10 for every type — this
        // guard used to sit inside #if SELF.$is_signed, which left the unsigned loop
        // unclamped. `to_base` clamps the same way so a base beyond 16 cannot make
        // character_length and this writer disagree about how many digits a value needs.
        if base > 16 : base = 16
        if base < 2 : base = 10
        let base_ = base

        let chars = lowercase ? "0123456789abcdef".data : "0123456789ABCDEF".data

        let rev = num2str_buf2

        let val = this
        let negative = false
        #if SELF.$is_signed
        if val < 0 {
            negative = true
        } else {
            val = 0 - val
        }

        let i: uint = 0
        while val < 0 {
            let digit = 0 - (val % base_)
            @ptrv(rev, u8, i) = @ptrv(chars, u8, digit)
            i++
            val = val / base_
        }
        #else
        let i: uint = 0
        while val > 0 {
            @ptrv(rev, u8, i) = @ptrv(chars, u8, val % base_)
            i++
            val = val / base_
        }
        #end
        // Set len
        if i == 0 {
            @ptrv(result, u8, 0) = '0'
            // @ptrv(result, u8, 1) = 0
            return 1
        }
        let len = i
        #if SELF.$is_signed
        if negative {
            len++
            @ptrv(result, u8, 0) = '-'
        }
        #end
        // Reverse
        let amount = i
        let offset: uint = negative ? 1 : 0
        while i-- > 0 {
            @ptrv(result, u8, i + offset) = @ptrv(rev, u8, amount - i - 1)
        }
        // @ptrv(result, u8, len) = 0

        return len
    }

    /// Returns how many bytes `to_base_to_ptr` writes for this value in `base`, sign included.
    ///
    /// `base` is clamped the same way as in `to_base_to_ptr`.
    + fn character_length(base: SELF) uint {
        if this == 0 : return 1
        // Clamped exactly like to_base_to_ptr, because callers use this to size what that
        // one writes: an unclamped base 1 looped forever and base 0 divided by zero.
        if base > 16 : base = 16
        if base < 2 : base = 10
        let val = this
        let i: uint = 0
        #if SELF.$is_signed
        let negative = val < 0
        if val > 0 : val = 0 - val
        while val < 0 {
            i++
            val = val / base
        }
        if negative : i++
        #else
        while val > 0 {
            i++
            val = val / base
        }
        #end
        return i
    }

    /// Writes the value as text in `base` to stdout, without a newline.
    ///
    /// The write is unbuffered and write errors are ignored. Digits above 9 are uppercase. A
    /// `base` above 16 is treated as 16 and one below 2 as 10.
    + fn print(base: SELF) {
        @unsafe
        let buf = num2str_buf1
        let len = this.to_base_to_ptr(base, &buf)
        io.write_bytes_sync(1, &buf, len) !? 0
    }

    /// Returns true when `str` parses as an integer equal to this value.
    ///
    /// Parses with `String.to_int` (`String.to_uint` for unsigned types); text that does not
    /// parse compares unequal. Tagged `$eq`, so `5 == "5"` is true.
    + fn equals_string(str: String) bool $eq {
        #if SELF.$is_signed
        let v = str.to_int() ! return false
        #else
        let v = str.to_uint() ! return false
        #end
        return this == v
    }

    /// Writes `v` to `to` as `size_of(SELF)` bytes, least significant first.
    ///
    /// ```valk
    /// let buf: [u8 x 4] = @undefined
    /// u32.write_little_endian(0x01020304, &buf)
    /// ```
    + static fn write_little_endian(v: SELF, to: *[u8 x size_of(SELF)]) {
        let i = 0
        while i < size_of(SELF) {
            to[i++] = (v & 0xFF).to(u8)
            #if size_of(SELF) > 1
            v = v >> 8
            #end
        }
    }
    /// Writes `v` to `to` as `size_of(SELF)` bytes, most significant first.
    + static fn write_big_endian(v: SELF, to: *[u8 x size_of(SELF)]) {
        let i = size_of(SELF)
        while i-- > 0 {
            to[i] = (v & 0xFF).to(u8)
            #if size_of(SELF) > 1
            v = v >> 8
            #end
        }
    }

    /// Reads a value from `size_of(SELF)` bytes at `from`, least significant first.
    + static fn read_little_endian(from: *[u8 x size_of(SELF)]) SELF {
        let v: SELF = 0
        let sh: SELF = 0
        let i = 0
        while i < size_of(SELF) {
            v = v | (from[i++].to(SELF) << sh)
            sh += 8
        }
        return v
    }
    /// Reads a value from `size_of(SELF)` bytes at `from`, most significant first.
    + static fn read_big_endian(from: *[u8 x size_of(SELF)]) SELF {
        let v: SELF = 0
        let sh: SELF = 0
        let i = size_of(SELF)
        while i-- > 0 {
            v = v | (from[i].to(SELF) << sh)
            sh += 8
        }
        return v
    }

    /// Returns a random value from the operating system's secure entropy source.
    ///
    /// Every value of the type is equally likely. Panics when the operating system cannot
    /// provide random bytes.
    + static fn random() SELF {
        let value: u64 = 0
        fill_secure_random(&value, size_of(u64))
        return value.to(SELF)
    }
}

use mem

trait PointerRead {
    // Byte
    + fn read_byte() u8 {
        @unsafe
        let data: *[u8] = this
        return data[0]
    }
    // Little endian
    + fn read_u16_le() u16  {
        return read_little_endian(this, 2).to(u16)
    }
    + fn read_u32_le() u32  {
        return read_little_endian(this, 4).to(u32)
    }
    + fn read_u64_le() u64  {
        return read_little_endian(this, 8)
    }
    + fn read_uint_le() uint  {
        return read_little_endian(this, size_of(uint))
    }
    // Big endian
    + fn read_u16_be() u16  {
        return read_big_endian(this, 2).to(u16)
    }
    + fn read_u32_be() u32  {
        return read_big_endian(this, 4).to(u32)
    }
    + fn read_u64_be() u64  {
        return read_big_endian(this, 8)
    }
    + fn read_uint_be() uint  {
        return read_big_endian(this, size_of(uint))
    }
    // Read LE/BE
    + fn read_little_endian(bytes: uint) uint  {
        return read_little_endian(this, bytes)
    }
    + fn read_big_endian(bytes: uint) uint  {
        return read_big_endian(this, bytes)
    }
    // String
    + fn read_string(len: uint) String  {
        @unsafe
        return String.copy_from_ptr(this, len)
    }
    + fn read_cstring(memory_size: uint) String  {
        let data = this
        let i = data.index_of_byte(0, memory_size) ! return ""
        return this.read_string(i)
    }
    + fn read_cstring_inf() String  {
        let data = this
        let i = data.index_of_byte_inf(0)
        return this.read_string(i)
    }
    + fn equals_string(str: String) bool  {
        @unsafe
        return mem.equal(this, str.data, str.length)
    }
    + fn equals(data: ptr, len: uint) bool  {
        @unsafe
        return mem.equal(this, data, len)
    }

    /////////////////////////////////////
    // Read ascii integers - Decimal
    /////////////////////////////////////
    + fn read_int(len: uint) int !SyntaxError {
        @unsafe
        let data: *[u8] = this
        if len == 0 : throw .syntax
        let offset: uint = 0
        let negative = false
        if data[0] == '-' {
            negative = true
            offset = 1
        } else if data[0] == '+' {
            offset = 1
        }
        if offset == len : throw .syntax
        let v = (data + offset).read_uint(len - offset)
        let uint_max: uint = 0
        uint_max--
        let int_max = uint_max >> 1
        if negative {
            let min_magnitude = int_max + 1
            if v > min_magnitude : throw .syntax
            if v == min_magnitude : return (0 - int_max.to(int)) - 1
            return 0 - v.to(int)
        }
        if v > int_max : throw .syntax
        return v.to(int)
    }
    + fn read_uint(len: uint) uint !SyntaxError {
        @unsafe
        let data: *[u8] = this
        if len == 0 : throw .syntax
        let i: uint = 0
        if data[0] == '+' {
            i++
            if i == len : throw .syntax
        }
        let result: uint = 0
        let max: uint = 0
        max--
        while i < len {
            let ch = data[i++]
            if ch < '0' || ch > '9' : throw .syntax
            let digit = (ch - '0').to(uint)
            if result > (max - digit) / 10 : throw .syntax
            result = result * 10 + digit
        }
        return result
    }
    + fn read_int_dynamic(max_bytes: uint) (int, uint)  {
        let len = this.determine_int_length(max_bytes)
        return (this.read_int(len) ! return (0, 0), len)
    }
    + fn read_uint_dynamic(max_bytes: uint) (uint, uint)  {
        let len = this.determine_uint_length(max_bytes)
        return (this.read_uint(len) ! return (0, 0), len)
    }
    + fn determine_int_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        if data[0] == '-' || data[0] == '+' : len++
        while len < max_bytes && data[len].is_number() : len++
        return len
    }
    + fn determine_uint_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        if data[0] == '+' : len++
        while len < max_bytes && data[len].is_number() : len++
        return len
    }

    /////////////////////////////////////
    // Read ascii integers - Octal
    /////////////////////////////////////
    + fn read_octal_int(len: uint) int !SyntaxError {
        @unsafe
        let data: *[u8] = this
        if len == 0 : return 0
        let offset: uint = 0
        let negative = false
        if data[0] == '-' {
            negative = true
            offset = 1
        }
        if offset == len : return 0
        let v = (data + offset).read_octal_uint(len - offset)
        return v.to(int) * (negative ? -1 : 1)
    }
    + fn read_octal_uint(len: uint) uint !SyntaxError {
        @unsafe
        let data: *[u8] = this
        let i = len
        let result: uint = 0
        let mult: uint = 1

        while i > 0 {
            let ch = data[--i]
            if ch >= '0' && ch <= '7' {
                result += (ch.to(uint) - '0') * mult
            } else if ch == 'c' && i == 1 && data[0] == '0' {
                break
            } else {
                throw .syntax
            }
            mult *= 8
        }
        return result
    }
    + fn read_octal_int_dynamic(max_bytes: uint) (int, uint)  {
        let len = this.determine_octal_int_length(max_bytes)
        return (this.read_octal_int(len) ! return (0, 0), len)
    }
    + fn read_octal_uint_dynamic(max_bytes: uint) (uint, uint)  {
        let len = this.determine_octal_uint_length(max_bytes)
        return (this.read_octal_uint(len) ! return (0, 0), len)
    }
    + fn determine_octal_int_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        if data[0] == '-' : len++
        if len + 2 <= max_bytes && (data + len).equals_string("0c") : len += 2
        while len < max_bytes && data[len].is_octal() : len++
        return len
    }
    + fn determine_octal_uint_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        if 2 <= max_bytes && (data + len).equals_string("0c") : len += 2
        while len < max_bytes && data[len].is_octal() : len++
        return len
    }

    /////////////////////////////////////
    // Read ascii integers - Hex
    /////////////////////////////////////
    + fn read_hex_int(len: uint) int !SyntaxError {
        @unsafe
        let data: *[u8] = this
        if len == 0 : return 0
        let offset: uint = 0
        let negative = false
        if data[0] == '-' {
            negative = true
            offset = 1
        }
        if offset == len : return 0
        let v = (data + offset).read_hex_uint(len - offset)
        return v.to(int) * (negative ? -1 : 1)
    }
    + fn read_hex_uint(len: uint) uint !SyntaxError {
        @unsafe
        let data: *[u8] = this
        let i: uint = 0
        if len >= 2 && data[0] == '0' && data[1] == 'x' {
            i = 2
        }
        let result: uint = 0
        while i < len {
            let ch = data[i]
            let digit: uint = 0
            if ch >= '0' && ch <= '9' {
                digit = ch.to(uint) - '0'
            } else if ch >= 'A' && ch <= 'F' {
                digit = ch.to(uint) - 'A' + 10
            } else if ch >= 'a' && ch <= 'f' {
                digit = ch.to(uint) - 'a' + 10
            } else {
                throw .syntax
            }
            let prev = result
            result = result * 16 + digit
            // Integer arithmetic wraps, so a quotient that does not round-trip
            // means the accumulator overflowed. Leading zeros still pass.
            if result / 16 != prev : throw .syntax
            i++
        }
        return result
    }
    + fn read_hex_int_dynamic(max_bytes: uint) (int, uint)  {
        let len = this.determine_hex_int_length(max_bytes)
        return (this.read_hex_int(len) ! return (0, 0), len)
    }
    + fn read_hex_uint_dynamic(max_bytes: uint) (uint, uint)  {
        let len = this.determine_hex_uint_length(max_bytes)
        return (this.read_hex_uint(len) ! return (0, 0), len)
    }
    + fn determine_hex_int_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        if data[0] == '-' : len++
        if len + 2 <= max_bytes && (data + len).equals_string("0x") : len += 2
        while len < max_bytes && data[len].is_hex() : len++
        return len
    }
    + fn determine_hex_uint_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        if 2 <= max_bytes && (data + len).equals_string("0x") : len += 2
        while len < max_bytes && data[len].is_hex() : len++
        return len
    }

    /////////////////////////////////////
    // Read ascii floats
    /////////////////////////////////////
    + fn read_float(len: uint) float !SyntaxError {
        @unsafe
        // 768 decimal bytes cover the precision needed to distinguish binary64 values
        // down through the subnormal range. Reject a larger input rather than silently
        // falling back to an accumulating-float approximation.
        if len > 768 : throw .syntax
        let sign: f64 = 1
        let i: uint = 0
        let mantissa_end = len
        let has_dot = false
        let decimals: int = 0
        let exponent: int = 0
        let exponent_negative = false
        let has_exponent = false
        let exact_mantissa: u64 = 0
        let exact = true
        let data: *[u8] = this

        if i == len : throw .syntax
        if data[0] == '-' {
            sign = -1
            i++
            if i == len : throw .syntax
        }

        while i < len {
            let ch = data[i++]
            if ch.is_number() {
                let digit = (ch - '0').to(u64)
                if exact && exact_mantissa <= (18446744073709551615.to(u64) - digit) / 10 {
                    exact_mantissa = exact_mantissa * 10 + digit
                } else {
                    exact = false
                }
                if has_dot : decimals++
            } else if ch == '.' {
                if has_dot : throw .syntax
                has_dot = true
            } else if ch == 'e' || ch == 'E' {
                has_exponent = true
                mantissa_end = i - 1
                break
            } else {
                throw .syntax
            }
        }

        if has_exponent {
            if i == len : throw .syntax
            let ch = data[i]
            if ch == '+' || ch == '-' {
                exponent_negative = ch == '-'
                i++
                if i == len : throw .syntax
            }
            while i < len {
                ch = data[i++]
                if !ch.is_number() : throw .syntax
                exponent = exponent * 10 + (ch - '0').to(int)
                if exponent > 400 : throw .syntax
            }
        }

        let scale = (exponent_negative ? 0 - exponent : exponent) - decimals
        if exact : return parse_float_exact(exact_mantissa, scale) * sign
        return parse_float_exact_bytes(data, mantissa_end, scale) * sign
    }

    + fn determine_float_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        let dot = false
        if data[0] == '-' : len++
        while len < max_bytes {
            let ch = data[len]
            if ch == '.' {
                if dot : break
                dot = true
                len++
                continue
            }
            if ch.is_number() {
                len++
                continue
            }
            if ch == 'e' || ch == 'E' {
                len++
                if len < max_bytes {
                    let sign = data[len]
                    if sign == '+' || sign == '-' : len++
                }
                while len < max_bytes && data[len].is_number() : len++
            }
            break
        }
        return len
    }
    + fn read_float_dynamic(max_bytes: uint) (float, uint)  {
        let len = this.determine_float_length(max_bytes)
        return (this.read_float(len) ! return (0, 0), len)
    }
}

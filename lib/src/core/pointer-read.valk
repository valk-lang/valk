use mem

trait PointerRead {
    // Byte
    /// Returns the byte at this address.
    + fn read_byte() u8 {
        @unsafe
        let data: *[u8] = this
        return data[0]
    }
    // Little endian
    /// Reads a little-endian `u16` from this address.
    + fn read_u16_le() u16  {
        return read_little_endian(this, 2).to(u16)
    }
    /// Reads a little-endian `u32` from this address.
    + fn read_u32_le() u32  {
        return read_little_endian(this, 4).to(u32)
    }
    /// Reads a little-endian `u64` from this address.
    + fn read_u64_le() u64  {
        return read_little_endian(this, 8)
    }
    /// Reads a little-endian `uint` (`size_of(uint)` bytes) from this address.
    + fn read_uint_le() uint  {
        return read_little_endian(this, size_of(uint))
    }
    // Big endian
    /// Reads a big-endian `u16` from this address.
    + fn read_u16_be() u16  {
        return read_big_endian(this, 2).to(u16)
    }
    /// Reads a big-endian `u32` from this address.
    + fn read_u32_be() u32  {
        return read_big_endian(this, 4).to(u32)
    }
    /// Reads a big-endian `u64` from this address.
    + fn read_u64_be() u64  {
        return read_big_endian(this, 8)
    }
    /// Reads a big-endian `uint` (`size_of(uint)` bytes) from this address.
    + fn read_uint_be() uint  {
        return read_big_endian(this, size_of(uint))
    }
    // Read LE/BE
    /// Reads a `bytes`-long little-endian unsigned integer from this address.
    ///
    /// `bytes` must not exceed `size_of(uint)`.
    + fn read_little_endian(bytes: uint) uint  {
        return read_little_endian(this, bytes)
    }
    /// Reads a `bytes`-long big-endian unsigned integer from this address.
    ///
    /// `bytes` must not exceed `size_of(uint)`.
    + fn read_big_endian(bytes: uint) uint  {
        return read_big_endian(this, bytes)
    }
    // String
    /// Returns a new `String` holding a copy of the first `len` bytes.
    + fn read_string(len: uint) String  {
        @unsafe
        return String.copy_from_ptr(this, len)
    }
    /// Returns a copy of the zero-terminated string at this address, without the zero byte.
    ///
    /// Only the first `memory_size` bytes are searched for the terminator; when none is found,
    /// the result is an empty string.
    + fn read_cstring(memory_size: uint) String  {
        let data = this
        let i = data.index_of_byte(0, memory_size) ! return ""
        return this.read_string(i)
    }
    /// Returns a copy of the zero-terminated string at this address, without the zero byte.
    ///
    /// Scans without a length limit, so the memory must contain a zero byte.
    + fn read_cstring_inf() String  {
        let data = this
        let i = data.index_of_byte_inf(0)
        return this.read_string(i)
    }
    /// Returns true when the bytes at this address start with the bytes of `str`.
    + fn equals_string(str: String) bool  {
        @unsafe
        return mem.equal_bytes(this, str.data, str.length)
    }
    /// Returns true when the first `len` bytes here equal the first `len` bytes at `data`.
    + fn equals(data: ptr, len: uint) bool  {
        @unsafe
        return mem.equal_bytes(this, data, len)
    }

    /////////////////////////////////////
    // Read ascii integers - Decimal
    /////////////////////////////////////
    /// Parses the first `len` bytes as a decimal `int` with an optional `-` or `+` sign.
    ///
    /// Throws `syntax` when `len` is 0, when there are no digits, on any non-digit byte, and
    /// when the value does not fit in an `int`. A `+` directly after the sign is also accepted:
    /// `-+5` reads as -5.
    + fn read_int(len: uint) int !SyntaxError {
        @unsafe
        let data: *[u8] = this
        if len == 0 : throw .syntax
        let offset: uint = 0
        let negative = false
        if data[0] == '-' {
            negative = true
            offset = 1
        } else if data[0] == '+' {
            offset = 1
        }
        if offset == len : throw .syntax
        let v = (data + offset).read_uint(len - offset)
        let uint_max: uint = 0
        uint_max--
        let int_max = uint_max >> 1
        if negative {
            let min_magnitude = int_max + 1
            if v > min_magnitude : throw .syntax
            if v == min_magnitude : return (0 - int_max.to(int)) - 1
            return 0 - v.to(int)
        }
        if v > int_max : throw .syntax
        return v.to(int)
    }
    /// Parses the first `len` bytes as a decimal `uint` with an optional `+` sign.
    ///
    /// Throws `syntax` when `len` is 0, when there are no digits, on any non-digit byte
    /// (including `-`), and when the value does not fit in a `uint`.
    + fn read_uint(len: uint) uint !SyntaxError {
        @unsafe
        let data: *[u8] = this
        if len == 0 : throw .syntax
        let i: uint = 0
        if data[0] == '+' {
            i++
            if i == len : throw .syntax
        }
        let result: uint = 0
        let max: uint = 0
        max--
        while i < len {
            let ch = data[i++]
            if ch < '0' || ch > '9' : throw .syntax
            let digit = (ch - '0').to(uint)
            if result > (max - digit) / 10 : throw .syntax
            result = result * 10 + digit
        }
        return result
    }
    /// Parses a decimal `int` like `read_int`, stopping at the first byte not part of it.
    ///
    /// Returns the value and the number of bytes it used, or `(0, 0)` when the text does not
    /// parse (including overflow). Reads at most `max_bytes` bytes.
    + fn read_int_dynamic(max_bytes: uint) (int, uint)  {
        let len = this.determine_int_length(max_bytes)
        return (this.read_int(len) ! return (0, 0), len)
    }
    /// Parses a decimal `uint` like `read_uint`, stopping at the first byte not part of it.
    ///
    /// Returns the value and the number of bytes it used, or `(0, 0)` when the text does not
    /// parse (including overflow). Reads at most `max_bytes` bytes.
    + fn read_uint_dynamic(max_bytes: uint) (uint, uint)  {
        let len = this.determine_uint_length(max_bytes)
        return (this.read_uint(len) ! return (0, 0), len)
    }
    /// Returns the length of an optional sign and decimal digits, up to `max_bytes`.
    + fn determine_int_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        if data[0] == '-' || data[0] == '+' : len++
        while len < max_bytes && data[len].is_number() : len++
        return len
    }
    /// Returns the length of an optional `+` and decimal digits, up to `max_bytes`.
    + fn determine_uint_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        if data[0] == '+' : len++
        while len < max_bytes && data[len].is_number() : len++
        return len
    }

    /////////////////////////////////////
    // Read ascii integers - Octal
    /////////////////////////////////////
    /// Parses the first `len` bytes as an octal `int` with an optional `-` and `0c` prefix.
    ///
    /// Returns 0 when `len` is 0 or only a `-` is present. Throws `syntax` on any other
    /// non-octal byte. Overflow is not detected; the result wraps.
    + fn read_octal_int(len: uint) int !SyntaxError {
        @unsafe
        let data: *[u8] = this
        if len == 0 : return 0
        let offset: uint = 0
        let negative = false
        if data[0] == '-' {
            negative = true
            offset = 1
        }
        if offset == len : return 0
        let v = (data + offset).read_octal_uint(len - offset)
        return v.to(int) * (negative ? -1 : 1)
    }
    /// Parses the first `len` bytes as an octal `uint` with an optional `0c` prefix.
    ///
    /// Returns 0 when `len` is 0. Throws `syntax` on a non-octal byte. Overflow is not
    /// detected; the result wraps.
    + fn read_octal_uint(len: uint) uint !SyntaxError {
        @unsafe
        let data: *[u8] = this
        let i = len
        let result: uint = 0
        let mult: uint = 1

        while i > 0 {
            let ch = data[--i]
            if ch >= '0' && ch <= '7' {
                result += (ch.to(uint) - '0') * mult
            } else if ch == 'c' && i == 1 && data[0] == '0' {
                break
            } else {
                throw .syntax
            }
            mult *= 8
        }
        return result
    }
    /// Parses an octal `int` like `read_octal_int`, stopping at the first byte not part of it.
    ///
    /// Returns the value and the number of bytes it used, or `(0, 0)` when the text does not
    /// parse. Reads at most `max_bytes` bytes.
    + fn read_octal_int_dynamic(max_bytes: uint) (int, uint)  {
        let len = this.determine_octal_int_length(max_bytes)
        return (this.read_octal_int(len) ! return (0, 0), len)
    }
    /// Parses an octal `uint` like `read_octal_uint`, stopping at the first byte not part of
    /// it.
    ///
    /// Returns the value and the number of bytes it used, or `(0, 0)` when the text does not
    /// parse. Reads at most `max_bytes` bytes.
    + fn read_octal_uint_dynamic(max_bytes: uint) (uint, uint)  {
        let len = this.determine_octal_uint_length(max_bytes)
        return (this.read_octal_uint(len) ! return (0, 0), len)
    }
    /// Returns the length of an optional `-`, `0c` prefix and octal digits, up to `max_bytes`.
    + fn determine_octal_int_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        if data[0] == '-' : len++
        if len + 2 <= max_bytes && (data + len).equals_string("0c") : len += 2
        while len < max_bytes && data[len].is_octal() : len++
        return len
    }
    /// Returns the length of an optional `0c` prefix and octal digits, up to `max_bytes`.
    + fn determine_octal_uint_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        if 2 <= max_bytes && (data + len).equals_string("0c") : len += 2
        while len < max_bytes && data[len].is_octal() : len++
        return len
    }

    /////////////////////////////////////
    // Read ascii integers - Hex
    /////////////////////////////////////
    /// Parses the first `len` bytes as a hexadecimal `int` with an optional `-` and `0x`
    /// prefix.
    ///
    /// Digits may be upper- or lowercase; the prefix must be a lowercase `0x`. Returns 0 when
    /// `len` is 0 or only a `-` is present. Throws `syntax` on a non-hex byte and when the
    /// magnitude does not fit in a `uint`. A magnitude above `int.$max` wraps, so
    /// `FFFFFFFFFFFFFFFF` reads as -1 on 64-bit targets.
    + fn read_hex_int(len: uint) int !SyntaxError {
        @unsafe
        let data: *[u8] = this
        if len == 0 : return 0
        let offset: uint = 0
        let negative = false
        if data[0] == '-' {
            negative = true
            offset = 1
        }
        if offset == len : return 0
        let v = (data + offset).read_hex_uint(len - offset)
        return v.to(int) * (negative ? -1 : 1)
    }
    /// Parses the first `len` bytes as a hexadecimal `uint` with an optional `0x` prefix.
    ///
    /// Digits may be upper- or lowercase; the prefix must be a lowercase `0x`. Returns 0 when
    /// `len` is 0 or only the prefix is present. Throws `syntax` on a non-hex byte and when the
    /// value does not fit in a `uint`.
    + fn read_hex_uint(len: uint) uint !SyntaxError {
        @unsafe
        let data: *[u8] = this
        let i: uint = 0
        if len >= 2 && data[0] == '0' && data[1] == 'x' {
            i = 2
        }
        let result: uint = 0
        while i < len {
            let ch = data[i]
            let digit: uint = 0
            if ch >= '0' && ch <= '9' {
                digit = ch.to(uint) - '0'
            } else if ch >= 'A' && ch <= 'F' {
                digit = ch.to(uint) - 'A' + 10
            } else if ch >= 'a' && ch <= 'f' {
                digit = ch.to(uint) - 'a' + 10
            } else {
                throw .syntax
            }
            let prev = result
            result = result * 16 + digit
            // Integer arithmetic wraps, so a quotient that does not round-trip
            // means the accumulator overflowed. Leading zeros still pass.
            if result / 16 != prev : throw .syntax
            i++
        }
        return result
    }
    /// Parses a hex `int` like `read_hex_int`, stopping at the first byte not part of it.
    ///
    /// Returns the value and the number of bytes it used, or `(0, 0)` when the text does not
    /// parse (including overflow). Reads at most `max_bytes` bytes.
    + fn read_hex_int_dynamic(max_bytes: uint) (int, uint)  {
        let len = this.determine_hex_int_length(max_bytes)
        return (this.read_hex_int(len) ! return (0, 0), len)
    }
    /// Parses a hex `uint` like `read_hex_uint`, stopping at the first byte not part of it.
    ///
    /// Returns the value and the number of bytes it used, or `(0, 0)` when the text does not
    /// parse (including overflow). Reads at most `max_bytes` bytes.
    + fn read_hex_uint_dynamic(max_bytes: uint) (uint, uint)  {
        let len = this.determine_hex_uint_length(max_bytes)
        return (this.read_hex_uint(len) ! return (0, 0), len)
    }
    /// Returns the length of an optional `-`, `0x` prefix and hex digits, up to `max_bytes`.
    + fn determine_hex_int_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        if data[0] == '-' : len++
        if len + 2 <= max_bytes && (data + len).equals_string("0x") : len += 2
        while len < max_bytes && data[len].is_hex() : len++
        return len
    }
    /// Returns the length of an optional `0x` prefix and hex digits, up to `max_bytes`.
    + fn determine_hex_uint_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        if 2 <= max_bytes && (data + len).equals_string("0x") : len += 2
        while len < max_bytes && data[len].is_hex() : len++
        return len
    }

    /////////////////////////////////////
    // Read ascii floats
    /////////////////////////////////////
    /// Parses the first `len` bytes as a decimal floating-point number, e.g. `-12.5e-3`.
    ///
    /// Accepts an optional `-` (not `+`), digits with at most one `.`, and an optional `e`/`E`
    /// exponent with its own sign. The result is the nearest `float` to the decimal value.
    /// Throws `syntax` on any other byte, on an empty or sign-only input, on an exponent
    /// without digits, on an exponent above 400, and when `len` exceeds 768. Inputs without
    /// mantissa digits, like `.` or `e5`, parse as 0.
    + fn read_float(len: uint) float !SyntaxError {
        @unsafe
        // 768 decimal bytes cover the precision needed to distinguish binary64 values
        // down through the subnormal range. Reject a larger input rather than silently
        // falling back to an accumulating-float approximation.
        if len > 768 : throw .syntax
        let sign: f64 = 1
        let i: uint = 0
        let mantissa_end = len
        let has_dot = false
        let decimals: int = 0
        let exponent: int = 0
        let exponent_negative = false
        let has_exponent = false
        let exact_mantissa: u64 = 0
        let exact = true
        let data: *[u8] = this

        if i == len : throw .syntax
        if data[0] == '-' {
            sign = -1
            i++
            if i == len : throw .syntax
        }

        while i < len {
            let ch = data[i++]
            if ch.is_number() {
                let digit = (ch - '0').to(u64)
                if exact && exact_mantissa <= (18446744073709551615.to(u64) - digit) / 10 {
                    exact_mantissa = exact_mantissa * 10 + digit
                } else {
                    exact = false
                }
                if has_dot : decimals++
            } else if ch == '.' {
                if has_dot : throw .syntax
                has_dot = true
            } else if ch == 'e' || ch == 'E' {
                has_exponent = true
                mantissa_end = i - 1
                break
            } else {
                throw .syntax
            }
        }

        if has_exponent {
            if i == len : throw .syntax
            let ch = data[i]
            if ch == '+' || ch == '-' {
                exponent_negative = ch == '-'
                i++
                if i == len : throw .syntax
            }
            while i < len {
                ch = data[i++]
                if !ch.is_number() : throw .syntax
                exponent = exponent * 10 + (ch - '0').to(int)
                if exponent > 400 : throw .syntax
            }
        }

        let scale = (exponent_negative ? 0 - exponent : exponent) - decimals
        if exact : return parse_float_exact(exact_mantissa, scale) * sign
        return parse_float_exact_bytes(data, mantissa_end, scale) * sign
    }

    /// Returns the length of the float text at this address, up to `max_bytes`.
    ///
    /// Covers an optional `-`, digits with at most one `.`, and an `e`/`E` exponent with an
    /// optional sign. The span is not validated; `read_float` does that.
    + fn determine_float_length(max_bytes: uint) uint {
        @unsafe
        let data: *[u8] = this
        if max_bytes == 0 : return 0
        let len = 0
        let dot = false
        if data[0] == '-' : len++
        while len < max_bytes {
            let ch = data[len]
            if ch == '.' {
                if dot : break
                dot = true
                len++
                continue
            }
            if ch.is_number() {
                len++
                continue
            }
            if ch == 'e' || ch == 'E' {
                len++
                if len < max_bytes {
                    let sign = data[len]
                    if sign == '+' || sign == '-' : len++
                }
                while len < max_bytes && data[len].is_number() : len++
            }
            break
        }
        return len
    }
    /// Parses a float like `read_float`, stopping at the first byte not part of it.
    ///
    /// Returns the value and the number of bytes it used, or `(0, 0)` when the text does not
    /// parse. Reads at most `max_bytes` bytes.
    + fn read_float_dynamic(max_bytes: uint) (float, uint)  {
        let len = this.determine_float_length(max_bytes)
        return (this.read_float(len) ! return (0, 0), len)
    }
}

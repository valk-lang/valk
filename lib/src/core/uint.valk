
/// An unsigned integer as wide as a pointer: 64 bits on 64-bit targets, 32 on 32-bit ones.
+ integer uint unsigned * $global {
    use Number

    /// Returns `this + other`, throwing `range` instead of wrapping on overflow.
    + fn checked_add(other: SELF) SELF !LookupError {
        let result = this + other
        if result < this : throw .range
        return result
    }

    /// Returns `this * other`, throwing `range` instead of wrapping on overflow.
    + fn checked_multiply(other: SELF) SELF !LookupError {
        if this == 0 || other == 0 : return 0
        let result = this * other
        if result / this != other : throw .range
        return result
    }
}


use core
use mem
use gc

+ array Array[T] of T $global {
    + static fn new(start_size: uint (0)) SELF $default {
        let d = gc.alloc(start_size * size_of(T))

        let res = SELF {
            cap: start_size
            data: d
        }
        return res
    }

    + fn lock() {
        core.race_lock()
    }
    + fn unlock() {
        core.race_unlock()
    }

    ////////////////
    // Append
    ////////////////

    // `$append`: class-init list form `Array[T]{ a, b, c }`
    + fn append(item: T, unique: bool (false)) SELF $append {
        if unique : this.index_of(item) -> i : return this
        let length = this.length
        this.fit_index(length)
        // Keep the buffer owned through `this`; a local copy needs its own GC root.
        @property_init(this, @ptrv(this.data, T, length), item)
        this.length = length + 1
        return this
    }

    + fn append_many(items: SELF) SELF {
        each items as item : this.append(item)
        return this
    }

    ////////////////
    // Prepend
    ////////////////

    + fn prepend(item: T, unique: bool (false)) SELF {
        if unique : this.index_of(item) -> i : return this

        let size = this.cap
        let length = this.length
        this.fit_index(length)
        let data = this.data

        let to_pos = length
        while to_pos > 0 {
            @ptrv(data, T, to_pos) = @ptrv(data, T, to_pos - 1)
            to_pos--
        }

        @property_init(this, @ptrv(data, T, 0), item)

        this.length = length + 1

        return this
    }

    + fn prepend_many(items: SELF) SELF {
        let ilen = items.length
        if ilen == 0 : return this
        // Adjust size
        let length = this.length
        let new_len = length + ilen
        this.fit_index(new_len - 1)
        let data = this.data
        let items_data = items.data

        let insert_bytes = ilen * size_of(T)
        mem.move(data, data.@offset(insert_bytes), length * size_of(T))

        let i: uint = 0
        while i < ilen {
            @property_init(this, @ptrv(data, T, i), @property_get(@ptrv(items_data, T, i)))
            i++
        }

        this.length += ilen
        return this
    }

    ////////////////
    // 
    ////////////////

    + fn merge_in_place(items: SELF) SELF {
        let length = items.length
        let i: uint = 0
        while i < length {
            this.append(items.get(i) ! panic("Array length changed while merging"))
            i++
        }
        return this
    }

    + fn merge(items: SELF) SELF $add {
        return this.copy().merge_in_place(items)
    }

    + fn intersect(with: SELF) SELF {
        let len = this.length
        if with.length < len : len = with.length
        let result = SELF.new(len)
        each this as item {
            if with.contains(item) : result.append(item, true)
        }
        return result
    }

    + fn range(start: uint, end: uint, inclusive: bool (true)) SELF {
        if start > end : return SELF.new()
        let amount = end - start
        if inclusive {
            let inclusive_amount = amount + 1
            if inclusive_amount > amount : amount = inclusive_amount
        }
        return this.part(start, amount)
    }

    + fn part(start: uint, amount: uint) SELF $range {
        if start >= this.length : return SELF.new()
        let remain = this.length - start
        if amount > remain : amount = remain
        let new = SELF.new(amount)
        let from = this.data.@cast(ptr) + start * size_of(T)
        mem.copy(from, new.data, amount * size_of(T))
        new.length = amount
        #if T.$has_gc_refs
        while amount-- > 0 {
            let item = @property_get(@ptrv(new.data, T, amount))
            @property_init(new, @ptrv(new.data, T, amount), item)
        }
        #end
        return new
    }

    + fn slice(start: uint, amount: uint) Slice[T] {
        if start >= this.length : return .new(0)
        let remain = this.length - start
        if amount > remain : amount = remain
        let s = Slice[T].new(amount)
        let adata = this.data
        let sdata = s.data
        while amount-- > 0 {
            let item = @property_get(@ptrv(adata, T, start + amount))
            @property_init(s, @ptrv(sdata, T, amount), item)
        }
        return s
    }

    + fn fit_index(index: uint) {
        let size = this.cap
        if index >= size {
            if size == 0 : size = 2
            while index >= size {
                let next_size = size * 2
                if next_size <= size : panic("Array capacity is too large")
                size = next_size
            }
            this.increase_size(size)
        }
    }

    // Returns nothing on purpose: handing back the interior data pointer makes
    // every caller's array look like it escaped, which stops it ever being
    // shared. Read 'this.data' after the call instead.
    + fn increase_size(new_size: uint) {
        let size = this.cap
        if size >= new_size : return

        let data = this.data
        let item_size = size_of(T)
        let allocation_size = new_size * item_size
        if item_size > 0 && allocation_size / item_size != new_size : panic("Array capacity is too large")
        let new_data = gc.alloc(allocation_size)
        // Nothing to carry over when there was no buffer yet.
        if size > 0 : mem.copy(data, new_data, size * size_of(T))

        this.data = new_data
        this.cap = new_size
    }

    + fn get(index: uint) T !LookupError {
        if index >= this.length : throw .missing
        return @property_get(@ptrv(this.data, T, index))
    }

    + fn set(index: uint, value: T) !LookupError {
        if index > this.length : throw .range
        if index == this.length {
            this.append(value)
            return
        }
        @property_update(this, @ptrv(this.data, T, index), value)
    }

    + fn set_all(value: T) {
        let i = this.length
        let data = this.data
        while i-- > 0 {
            @property_update(this, @ptrv(data, T, i), value)
        }
    }

    + fn set_expand(index: uint, value: T, filler_value: T) {
        this.fit_index(index)
        let len = this.length
        if index >= len : this.length = index + 1
        let data = this.data

        // fill
        let i = len
        while i < index {
            @property_init(this, @ptrv(data, T, i++), filler_value)
        }

        // Set index
        if index < len {
            @property_update(this, @ptrv(data, T, index), value)
        } else {
            @property_init(this, @ptrv(data, T, index), value)
        }
    }

    + fn contains(value: T) bool {
        this.index_of(value) ! return false
        return true
    }

    + fn remove(index: uint) SELF {
        let len = this.length
        if index >= len {
            return this
        }
        let data: ptr = this.data
        let after_count = len - (index + 1)

        @property_clear(this, @ptrv(data, T, index))

        if after_count > 0 {
            mem.move(data + (index + 1) * size_of(T), data + index * size_of(T), after_count * size_of(T))
        }

        this.length--
        return this
    }

    + fn swap_remove(index: uint) SELF {
        let len = this.length
        if index >= len : return this

        let data: ptr = this.data
        let last_index = len - 1
        @property_clear(this, @ptrv(data, T, index))
        if index != last_index {
            mem.copy(data + last_index * size_of(T), data + index * size_of(T), size_of(T))
        }
        this.length--
        return this
    }

    + fn remove_value(value: T) SELF {
        let index = this.index_of(value) ! return this
        this.remove(index)
        return this
    }

    + fn pop_last() T !LookupError {
        if this.length == 0 : throw .missing

        let index = --this.length
        let data = this.data

        let item = @property_get(@ptrv(data, T, index))
        @property_clear(this, @ptrv(data, T, index))

        return item
    }
    + fn pop_first() T !LookupError {
        if this.length == 0 : throw .missing

        let data: ptr = this.data

        let item = @property_get(@ptrv(data, T, 0))
        @property_clear(this, @ptrv(data, T, 0))

        this.length--
        mem.move(data + size_of(T), data, this.length * size_of(T))

        return item
    }

    + fn swap(index_a: uint, index_b: uint) {
        let len = this.length
        if index_a >= len {
            return
        }
        if index_b >= len {
            return
        }
        let data = this.data
        let a = @ptrv(data, T, index_a)
        let b = @ptrv(data, T, index_b)
        @ptrv(data, T, index_a) = b
        @ptrv(data, T, index_b) = a
    }

    + fn index_of(item: T) uint !LookupError {
        let index: uint = 0
        let adr = this.data
        let len = this.length
        while index < len {
            let x = @property_get(@ptrv(adr, T, index))
            if x == item : return index
            index++
        }
        throw .missing
    }

    + fn clear(reduce_size: bool (false)) SELF {
        #if T.$has_gc_refs
        let data = this.data
        let i = this.length
        while i-- > 0 : @property_clear(this, @ptrv(data, T, i))
        #end

        this.length = 0
        if reduce_size {
            this.data = gc.alloc(2 * size_of(T))
            this.cap = 2
        }
        return this
    }

    #if !T.$is_inline
    - static fn sort_after(a: T, b: T, func: ?fn(T, T)(bool)) bool {
        if isset(func) : return func(a, b)
        return isset(a) && isset(b) && a > b
    }

    - fn sort_sift_down(start: uint, count: uint, func: ?fn(T, T)(bool)) {
        let root = start
        while root * 2 + 1 < count {
            let child = root * 2 + 1
            let swap_index = root

            let swap_value = this.get(swap_index) ! return
            let child_value = this.get(child) ! return
            if SELF.sort_after(child_value, swap_value, func) : swap_index = child

            if child + 1 < count {
                let current = this.get(swap_index) ! return
                let right = this.get(child + 1) ! return
                if SELF.sort_after(right, current, func) : swap_index = child + 1
            }

            if swap_index == root : return
            this.swap(root, swap_index)
            root = swap_index
        }
    }

    + fn sort(func: ?fn(T, T)(bool) (null)) SELF {
        let count = this.length
        if count < 2 : return this

        let start = count / 2
        while start > 0 {
            start--
            this.sort_sift_down(start, count, func)
        }

        let end = count
        while end > 1 {
            end--
            this.swap(0, end)
            this.sort_sift_down(0, end, func)
        }
        return this
    }
    #end

    + fn reverse() SELF {
        let len_ = this.length
        if len_ < 2 : return this
        let last = len_ - 1
        let first: uint = 0
        while len_ > 1 {
            this.swap(first, last)
            first++
            last--
            len_ -= 2
        }
        return this
    }

    + fn equal(array: SELF) bool $eq {
        if this.length != array.length : return false
        each this as v, i {
            let v2 = array.get(i) ! return false
            if v != v2 : return false
        }
        return true
    }

    + fn equal_ignore_order(array: SELF) bool {
        if this.length != array.length : return false
        let copy = array.copy()
        each this as v, i {
            let i2 = copy.index_of(v) ! return false
            copy.remove(i2)
        }
        return true
    }

    ////////////////
    // Filtering
    ////////////////

    #if T.$is_nullable
    - static fn filter_null(i: T) bool {
        return !isset(i)
    }
    #end

    + fn filter_self(func: ?fn(T)(bool) (null)) SELF {
        if this.length == 0 : return this
        if !isset(func) {
            #if T.$has_method(default_array_filter)
            func = T.default_array_filter
            #elif T.$is_nullable
            func = SELF.filter_null
            #else
            return this
            #end
        }

        let result: ?SELF = null
        let removals: uint = 0
        each this as v, i {
            if func(v) {
                if !isset(result) : result = this.copy()
                result.remove(i - removals++)
            }
        }
        if !isset(result) : return this
        return result
    }

    + fn filter(func: ?fn(T)(bool) (null)) SELF {
        let result = SELF.new(this.length)
        if isset(func) {
            each this as value {
                if func(value) : result.append(value)
            }
            return result
        }

        #if T.$has_method(default_array_filter)
        each this as value {
            if !T.default_array_filter(value) : result.append(value)
        }
        #elif T.$is_nullable
        each this as value {
            if isset(value) : result.append(value)
        }
        #else
        return this.copy()
        #end
        return result
    }

    + fn unique() SELF {
        let insert_i: uint = 0
        let data = this.data
        each this as find, i {
            let found = false
            each this as item, o {
                if o == insert_i : break
                if find == item {
                    found = true
                    break
                }
            }
            if found : @property_clear(this, @ptrv(data, T, i))
            else {
                if insert_i != i : @ptrv(data, T, insert_i) = @ptrv(data, T, i)
                insert_i++
            }
        }
        this.length = insert_i
        return this
    }

    ////////////////
    // Exceptions
    ////////////////

    #if T.$can_convert_to(String)
    + fn join(divider: String) String {
        let buffer = ByteBuffer.new()
        let count: uint = 0
        each this as part, i {
            #if T.$is_nullable
            if !isset(part) : continue
            #end
            if count++ > 0 : buffer.write_string(divider)
            buffer.write_string(part)
        }
        return buffer
    }
    #end

    ////////////////
    // Internals
    ////////////////

    + fn copy() SELF {
        let arr = SELF.new(this.length)
        each this as item {
            arr.append(item)
        }
        return arr
    }

    + fn iter() Slice[T] {
        return this.slice(0, this.length)
    }

    + fn clone() SELF $clone {
        let new = SELF.new(this.cap)
        each this as item {
            new.append($clone(item))
        }
        return new.@cast(SELF)
    }
}

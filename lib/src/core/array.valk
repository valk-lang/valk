use mem
use gc
use random

// Elements live in `&[T]` storage: a block that traces every slot it
// holds. `data` is that block, `size` its slot count, and the elements start
// at the block's storage header offset. The element pointer is written out as
// an expression on `data` rather than a helper call so the escape analysis
// can see which array's storage a value came from. A view over the block stays valid
// after the array reallocates, and a slot that leaves the array is cleared so
// the block keeps nothing dead.
/// A growable array of `T` stored in one contiguous block.
///
/// Build one with `Array[T]{ a, b }` (see `append`) or `Array[T]{ value x count }` (see
/// `fill`), and iterate with `each arr as value, index`.
+ array Array[T] of T $global {
    /// Creates an empty array with room for `start_size` elements before it has to grow.
    ///
    /// Marked `$default`: it also provides the type's default value.
    + static fn new(start_size: uint (0)) SELF $default {
        let res = SELF {}
        if start_size > 0 : res.allocate_storage(start_size)
        return res
    }

    /// Creates an array holding `count` copies of `value`; backs `Array[T]{ value x count }`.
    ///
    /// For a reference type every slot holds the same object, not a copy.
    + static fn fill(count: uint, value: T) SELF {
        @unsafe
        let res = SELF.new(count)
        if count == 0 : return res
        // One pass over the storage `new` sized for exactly `count` elements
        let i: uint = 0
        #if T.$has_gc_refs
        while i < count {
            @property_init(res.data, @ptrv(res.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]), T, i), value)
            i++
        }
        #else
        let data = res.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])
        while i < count {
            @ptrv(data, T, i) = value
            i++
        }
        #end
        res.length = count
        return res
    }

    - fn allocate_storage(new_size: uint) {
        @unsafe
        let block = [T]{ null x new_size }
        // The block is freshly allocated; it passes through a raw pointer so
        // the uniqueness analysis keeps treating the array as a fresh graph.
        this.data = block.owner.@cast(ptr).@cast(?gc.GcPtr)
        this.size = new_size
    }


    // Clear a slot whose element is no longer part of the array.
    - fn clear_slot(index: uint) {
        @unsafe
        @property_clear(this.data, @ptrv(this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]), T, index))
        mem.clear_bytes(this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]).@cast(ptr) + index * size_of(T), size_of(T))
    }

    /// Returns a raw pointer to the first element.
    ///
    /// It stays valid only until the array grows or replaces its storage, and reads through
    /// it skip the bounds and presence checks of `[]`.
    + fn items() *[T] $inline {
        return this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])
    }

    /// Returns a writable view of up to `amount` elements starting at `start`, without copying.
    ///
    /// Backs `&arr[start .. amount]`. A `start` past the end gives an empty view. The view
    /// shares the array's storage block and keeps it alive on its own: it sees in-place
    /// writes through the array, including the shifting and zeroed slots left by removals.
    /// Once the array grows (or `clear(true)` replaces its storage) the view keeps covering
    /// the old block, and the two no longer see each other's writes. Marked `$auto`: an array
    /// converts to a view where a `&[T]`, `local &[T]` or `mut &[T]` is expected.
    + fn view(start: uint (0), amount: uint (uint.$max)) mut &[T] $view $auto {
        @unsafe
        if start >= this.length : return [T]{ owner: this.data, data: this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]), length: 0 }
        let remain = this.length - start
        let count = amount > remain ? remain : amount
        return [T]{ owner: this.data, data: @ref(@ptrv(this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]), T, start)), length: count }
    }

    ////////////////
    // Append
    ////////////////

    /// Appends `item` to the end, growing the storage when it is full.
    ///
    /// With `unique`, nothing is added when an equal item is already present (a linear scan).
    /// Marked `$append`: backs the list literal `Array[T]{ a, b, c }`.
    + fn append(item: T, unique: bool (false)) $append {
        @unsafe
        if unique : this.index_of(item) -> i : return
        let length = this.length
        this.fit_index(length)
        // Keep the buffer owned through `this`; a local copy needs its own GC root.
        @property_init(this.data, @ptrv(this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]), T, length), item)
        this.length = length + 1
    }

    /// Appends every element of `items` in order; with `unique`, each one is skipped when an
    /// equal item is already present (tracked in a set for integers and `$hash` types).
    + fn append_many(items: SELF, unique: bool (false)) {
        #if T.$is_raw_pointer
        @unsafe
        #end
        let length = items.length
        #if !T.$is_nullable && (T.$has_hash || T.$is_integer)
        if unique && length >= 8 && this.length + length >= ARRAY_UNIQUE_SET_MIN {
            let seen = HashSet[T].new(this.length + length)
            each this into item : seen.add(item)
            let i: uint = 0
            while i < length {
                let item = items.get(i) ! panic("Array length changed while appending")
                if !seen.has(item) {
                    seen.add(item)
                    this.append(item)
                }
                i++
            }
            return
        }
        #end
        let i: uint = 0
        while i < length {
            this.append(items.get(i) ! panic("Array length changed while appending"), unique)
            i++
        }
    }

    ////////////////
    // Prepend
    ////////////////

    /// Inserts `item` at the front, shifting every element one slot up.
    ///
    /// With `unique`, nothing is added when an equal item is already present. Costs O(n);
    /// prefer `append` when order allows.
    + fn prepend(item: T, unique: bool (false)) {
        @unsafe
        if unique : this.index_of(item) -> i : return

        let size = this.size
        let length = this.length
        this.fit_index(length)
        let data = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])

        mem.move_bytes(data, data.@offset(size_of(T)), length * size_of(T))
        #if T.$has_gc_refs
        gc.moved_elements(this.data.@cast(ptr), 1, length)
        #end

        @property_init(this.data, @ptrv(data, T, 0), item)

        this.length = length + 1
    }

    /// Inserts the elements of `items` at the front, keeping their order.
    ///
    /// With `unique`, each one is skipped when an equal item is already present.
    + fn prepend_many(items: SELF, unique: bool (false)) {
        #if T.$is_raw_pointer
        @unsafe
        #end
        if unique {
            let i = items.length
            while i > 0 {
                i--
                this.prepend(items.get(i) ! panic("Array length changed while prepending"), true)
            }
            return
        }
        @unsafe
        let ilen = items.length
        if ilen == 0 : return
        let length = this.length
        let new_len = length.checked_add(ilen) ! panic("Array capacity is too large")
        this.fit_index(new_len - 1)
        let data = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])
        let items_data = items.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])

        let insert_bytes = ilen * size_of(T)
        mem.move_bytes(data, data.@offset(insert_bytes), length * size_of(T))
        #if T.$has_gc_refs
        gc.moved_elements(this.data.@cast(ptr), ilen, length)
        #end

        let i: uint = 0
        while i < ilen {
            @property_init(this.data, @ptrv(data, T, i), @property_get(@ptrv(items_data, T, i)))
            i++
        }

        this.length += ilen
    }

    /// Inserts `value` at `index`, shifting the elements from there one slot up.
    ///
    /// An `index` equal to `length` appends. Throws `range` when `index` is greater than
    /// `length`. Costs O(n) for the elements that move.
    + fn insert(index: uint, value: T) !LookupError {
        @unsafe
        let length = this.length
        if index > length : throw .range
        if index == length {
            this.append(value)
            return
        }
        this.fit_index(length)
        let data = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])
        mem.move_bytes(data.@offset(index * size_of(T)), data.@offset((index + 1) * size_of(T)), (length - index) * size_of(T))
        #if T.$has_gc_refs
        gc.moved_elements(this.data.@cast(ptr), index + 1, length - index)
        #end
        @property_init(this.data, @ptrv(data, T, index), value)
        this.length = length + 1
    }

    /// Returns a new array with the elements of this array followed by those of `items`.
    ///
    /// Marked `$add`: backs `a + b`. Neither operand changes.
    + fn merge(items: SELF) SELF $add {
        let result = this.copy()
        result.append_many(items)
        return result
    }

    /// Returns a new array of the elements that also occur in `with`, in this array's order
    /// and without duplicates.
    + fn intersect(with: SELF) SELF {
        #if T.$is_raw_pointer
        @unsafe
        #end
        let len = this.length
        if with.length < len : len = with.length
        let result = SELF.new(len)
        #if !T.$is_nullable && (T.$has_hash || T.$is_integer)
        if this.length >= 8 && with.length >= 8 && this.length + with.length >= ARRAY_UNIQUE_SET_MIN {
            let lookup = HashSet[T].new(with.length)
            each with into item : lookup.add(item)
            each this into item {
                if lookup.has(item) : result.append(item)
            }
            result.remove_duplicates()
            return result
        }
        #end
        each this into item {
            if with.contains(item) : result.append(item, true)
        }
        return result
    }


    /// Returns a new array with a copy of up to `amount` elements starting at `start`.
    ///
    /// Backs `arr[start .. amount]`. A `start` past the end gives an empty array. The copy is
    /// shallow: reference elements are shared.
    + fn range(start: uint, amount: uint) SELF $range {
        @unsafe
        if start >= this.length : return SELF.new()
        let remain = this.length - start
        if amount > remain : amount = remain
        let new = SELF.new(amount)
        let from = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]).@cast(ptr) + start * size_of(T)
        mem.copy_bytes(from, new.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]), amount * size_of(T))
        new.length = amount
        #if T.$has_gc_refs
        while amount-- > 0 {
            let item = @property_get(@ptrv(new.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]), T, amount))
            @property_init(new, @ptrv(new.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]), T, amount), item)
        }
        #end
        return new
    }

    /// Grows the storage, doubling its size, until `index` is a valid slot; the length does
    /// not change.
    ///
    /// Panics when the needed size overflows.
    + fn fit_index(index: uint) {
        let size = this.size
        if index >= size {
            if size == 0 : size = 2
            while index >= size {
                let next_size = size * 2
                if next_size <= size : panic("Array capacity is too large")
                size = next_size
            }
            this.increase_size(size)
        }
    }

    // Returns nothing on purpose: handing back the interior data pointer makes
    // every caller's array look like it escaped, which stops it ever being
    // shared. Read 'this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])' after the call instead.
    /// Grows the storage to hold at least `new_size` elements; does nothing when it already
    /// does. The length does not change.
    ///
    /// Panics when the size in bytes overflows.
    + fn increase_size(new_size: uint) {
        @unsafe
        let size = this.size
        if size >= new_size : return

        let old_block = this.data
        let data = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])
        let length = this.length
        new_size.checked_multiply(size_of(T)) ! panic("Array capacity is too large")
        this.allocate_storage(new_size)
        if length > 0 {
            mem.copy_bytes(data, this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]), length * size_of(T))
            // The old block stays alive for any view that still covers it, so
            // it keeps a hold on the elements while their ownership moves to
            // the new block, which saves the collector from disowning and
            // re-marking everything they reference
            #if T.$has_gc_refs
            if isset(old_block) : gc.transfer_refs(old_block.@cast(ptr), this.data.@cast(ptr))
            #end
        }
    }

    /// Returns the element at `index`.
    ///
    /// Throws `missing` when `index` is not below `length`.
    + fn get(index: uint) T !LookupError {
        if index >= this.length : throw .missing
        return @property_get(@ptrv(this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]), T, index))
    }

    /// Returns the first element without removing it.
    ///
    /// Throws `empty` when the array is empty.
    + fn first() T !LookupError {
        return this.get(0) ! throw .empty
    }

    /// Returns the last element without removing it.
    ///
    /// Throws `empty` when the array is empty.
    + fn last() T !LookupError {
        if this.length == 0 : throw .empty
        return this.get(this.length - 1) ! throw .empty
    }

    /// Replaces the element at `index` with `value`; an `index` equal to `length` appends.
    ///
    /// Throws `range` when `index` is greater than `length`.
    + fn set(index: uint, value: T) !LookupError {
        #if T.$is_raw_pointer
        @unsafe
        #end
        if index > this.length : throw .range
        if index == this.length {
            this.append(value)
            return
        }
        @property_update(this.data, @ptrv(this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]), T, index), value)
    }

    /// Replaces every element with `value`; the length does not change.
    + fn set_all(value: T) {
        let i = this.length
        let data = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])
        while i-- > 0 {
            @property_update(this.data, @ptrv(data, T, i), value)
        }
    }

    /// Sets the element at `index`, first growing the array to that length with
    /// `filler_value` when `index` is past the end.
    + fn set_expand(index: uint, value: T, filler_value: T) {
        @unsafe
        this.fit_index(index)
        let len = this.length
        if index >= len : this.length = index + 1
        let data = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])

        // fill
        let i = len
        while i < index {
            @property_init(this.data, @ptrv(data, T, i++), filler_value)
        }

        // Set index
        if index < len {
            @property_update(this.data, @ptrv(data, T, index), value)
        } else {
            @property_init(this.data, @ptrv(data, T, index), value)
        }
    }

    /// Returns whether an element equal to `value` is present (a linear scan using `==`).
    + fn contains(value: T) bool {
        #if T.$is_raw_pointer
        @unsafe
        #end
        this.index_of(value) ! return false
        return true
    }

    /// Removes the element at `index` and shifts the following elements down.
    ///
    /// Does nothing when `index` is out of range. Costs O(n); `swap_remove` is O(1) when
    /// order does not matter.
    + fn remove(index: uint) {
        @unsafe
        let len = this.length
        if index >= len {
            return
        }
        let data: ptr = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])
        let after_count = len - (index + 1)

        @property_clear(this.data, @ptrv(data, T, index))

        if after_count > 0 {
            mem.move_bytes(data + (index + 1) * size_of(T), data + index * size_of(T), after_count * size_of(T))
            #if T.$has_gc_refs
            gc.moved_elements(this.data.@cast(ptr), index, after_count)
            #end
        }

        this.length--
        mem.clear_bytes(data + this.length * size_of(T), size_of(T))
    }

    /// Removes the element at `index` by moving the last element into its slot.
    ///
    /// Does not preserve order. Does nothing when `index` is out of range.
    + fn swap_remove(index: uint) {
        @unsafe
        let len = this.length
        if index >= len : return

        let data: ptr = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])
        let last_index = len - 1
        @property_clear(this.data, @ptrv(data, T, index))
        if index != last_index {
            mem.copy_bytes(data + last_index * size_of(T), data + index * size_of(T), size_of(T))
            #if T.$has_gc_refs
            gc.moved_elements(this.data.@cast(ptr), index, 1)
            #end
        }
        this.length--
        mem.clear_bytes(data + last_index * size_of(T), size_of(T))
    }

    /// Removes the first element equal to `value`, shifting the rest down; does nothing when
    /// it is absent.
    + fn remove_value(value: T) {
        #if T.$is_raw_pointer
        @unsafe
        #end
        let index = this.index_of(value) ! return
        this.remove(index)
    }

    /// Removes and returns the last element.
    ///
    /// Throws `missing` when the array is empty.
    + fn pop_last() T !LookupError {
        @unsafe
        if this.length == 0 : throw .missing

        let index = --this.length
        let item = @property_get(@ptrv(this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T]), T, index))
        this.clear_slot(index)
        return item
    }
    /// Removes and returns the first element, shifting the rest down (O(n)).
    ///
    /// Throws `missing` when the array is empty.
    + fn pop_first() T !LookupError {
        @unsafe
        if this.length == 0 : throw .missing

        let data: ptr = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])

        let item = @property_get(@ptrv(data, T, 0))
        @property_clear(this.data, @ptrv(data, T, 0))

        this.length--
        mem.move_bytes(data + size_of(T), data, this.length * size_of(T))
        #if T.$has_gc_refs
        gc.moved_elements(this.data.@cast(ptr), 0, this.length)
        #end
        mem.clear_bytes(data + this.length * size_of(T), size_of(T))

        return item
    }

    /// Exchanges the elements at `index_a` and `index_b`; does nothing when either is out of
    /// range.
    + fn swap(index_a: uint, index_b: uint) {
        let len = this.length
        if index_a >= len {
            return
        }
        if index_b >= len {
            return
        }
        let data = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])
        let a = @ptrv(data, T, index_a)
        let b = @ptrv(data, T, index_b)
        @ptrv(data, T, index_a) = b
        @ptrv(data, T, index_b) = a
        #if T.$has_gc_refs
        @unsafe
        gc.moved_elements(this.data.@cast(ptr), index_a, 1)
        gc.moved_elements(this.data.@cast(ptr), index_b, 1)
        #end
    }

    /// Returns the index of the first element equal to `item` (compared with `==`).
    ///
    /// Throws `missing` when no element matches.
    + fn index_of(item: T) uint !LookupError {
        let index: uint = 0
        let adr = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])
        let len = this.length
        while index < len {
            let x = @property_get(@ptrv(adr, T, index))
            if x == item : return index
            index++
        }
        throw .missing
    }

    /// Removes every element.
    ///
    /// The storage is kept for reuse unless `reduce_size` is set, which replaces it with a
    /// two-slot block.
    + fn clear(reduce_size: bool (false)) {
        @unsafe
        let data = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])
        let i = this.length
        #if T.$has_gc_refs
        while i-- > 0 : @property_clear(this.data, @ptrv(data, T, i))
        #end
        if this.length > 0 : mem.clear_bytes(data, this.length * size_of(T))

        this.length = 0
        if reduce_size : this.allocate_storage(2)
    }

    #if T.$can_order
    - static fn sort_after(a: T, b: T) bool {
        #if T.$is_raw_pointer
        @unsafe
        #end
        if !isset(a) : return false
        if !isset(b) : return true
        return a > b
    }

    /// Sorts the elements in place, ascending by default.
    ///
    /// `func(a, b)` returns true when `a` belongs after `b`. The sort is stable: elements that
    /// compare equal keep their order. With the default order, null elements come first.
    + fn sort(func: ?fn(T, T)(bool) (null)) {
        this.sort_with(func ?? SELF.sort_after)
    }
    /// Returns a sorted copy, ascending by default; `func` works as in `sort`.
    + fn sorted(func: ?fn(T, T)(bool) (null)) SELF {
        let result = this.copy()
        result.sort(func)
        return result
    }

    /// Searches this sorted array for `value` in O(log n).
    ///
    /// Returns whether it was found, and its position: the first of several equal elements,
    /// or where `value` would go to keep the order, so `insert(position, value)` keeps the
    /// array sorted. `func` works as in `sort`, for an array sorted another way.
    + fn binary_search(value: T, func: ?fn(T, T)(bool) (null)) (bool, uint) {
        #if T.$is_raw_pointer
        @unsafe
        #end
        return this.search_sorted(value, func ?? SELF.sort_after)
    }
    #else
    /// Sorts the elements in place with `func`, which returns true when `a` belongs after `b`.
    ///
    /// The element type has no natural order, so `func` is required. The sort is stable:
    /// elements that compare equal keep their order.
    + fn sort(func: fn(T, T)(bool)) {
        this.sort_with(func)
    }
    /// Returns a copy sorted with `func`; see `sort`.
    + fn sorted(func: fn(T, T)(bool)) SELF {
        let result = this.copy()
        result.sort(func)
        return result
    }

    /// Searches this array, sorted with `func`, for `value` in O(log n).
    ///
    /// Returns whether it was found, and its position: the first of several equal elements,
    /// or where `value` would go to keep the order, so `insert(position, value)` keeps the
    /// array sorted.
    + fn binary_search(value: T, func: fn(T, T)(bool)) (bool, uint) {
        #if T.$is_raw_pointer
        @unsafe
        #end
        return this.search_sorted(value, func)
    }
    #end

    // The first position whose element does not belong before `value`, and whether it equals it
    - fn search_sorted(value: T, after: fn(T, T)(bool)) (bool, uint) {
        #if T.$is_raw_pointer
        @unsafe
        #end
        let lo: uint = 0
        let hi = this.length
        while lo < hi {
            let mid = lo + (hi - lo) / 2
            let item = this.get(mid) ! return (false, lo)
            if after(value, item) : lo = mid + 1
            else : hi = mid
        }
        let at = this.get(lo) ! return (false, lo)
        return (!after(at, value), lo)
    }

    /// Sorts the elements in place by the value `key` gives for each, ascending.
    ///
    /// `key` runs once per element. The sort is stable, and a null key comes first. Use `sort`
    /// with a function for another order.
    + fn sort_by[K](key: fn(T)(K)) {
        #if !K.$can_order
        #error "sort_by needs a key with an order, such as a number or a String; for another key, use sort with a function"
        #end
        let count = this.length
        if count < 2 : return
        let keys = Array[K].new(count)
        each this into item : keys.append(key(item))
        this.apply_order(array_stable_order(keys, Array[K].sort_after))
    }
    /// Returns a copy sorted by `key`; see `sort_by`.
    + fn sorted_by[K](key: fn(T)(K)) SELF {
        let result = this.copy()
        result.sort_by(key)
        return result
    }

    - fn sort_with(func: fn(T, T)(bool)) {
        if this.length < 2 : return
        #if T.$has_gc_refs
        // Elements with references move only by swaps inside their own storage
        this.apply_order(array_stable_order(this, func))
        #else
        array_sort_plain(this, func)
        #end
    }

    // Puts the element at position `order[k]` at position `k`, following each cycle of the
    // permutation. Elements only move inside the array's own storage, like `swap`, and the GC
    // hears about the whole range once.
    - fn apply_order(order: Array[uint]) {
        @unsafe
        let count = order.length
        if count != this.length : return
        let items = this.items()
        let from_pos = order.items()
        let start: uint = 0
        while start < count {
            if @ptrv(from_pos, uint, start) == start {
                start++
                continue
            }
            let first = @ptrv(items, T, start)
            let k = start
            while true {
                let from = @ptrv(from_pos, uint, k)
                // Placed: the cycle never visits it again
                @ptrv(from_pos, uint, k) = k
                if from == start {
                    @ptrv(items, T, k) = first
                    break
                }
                @ptrv(items, T, k) = @ptrv(items, T, from)
                k = from
            }
            start++
        }
        #if T.$has_gc_refs
        gc.moved_elements(this.data.@cast(ptr), 0, count)
        #end
        // The order stays alive while it is read through a raw pointer
        order.clear()
    }

    /// Reverses the order of the elements in place.
    + fn reverse() {
        let len_ = this.length
        if len_ < 2 : return
        let last = len_ - 1
        let first: uint = 0
        while len_ > 1 {
            this.swap(first, last)
            first++
            last--
            len_ -= 2
        }
    }

    /// Returns a copy with the elements in reverse order.
    + fn reversed() SELF {
        let result = this.copy()
        result.reverse()
        return result
    }

    /// Returns whether both arrays have the same length and equal elements at each index.
    ///
    /// Marked `$eq`: backs `==`. Elements are compared with `==`, so their own `$eq` applies.
    + fn equals(array: SELF) bool $eq {
        if this.length != array.length : return false
        each this into v, i {
            let v2 = array.get(i) ! return false
            if v != v2 : return false
        }
        return true
    }

    /// Returns whether both arrays hold the same elements the same number of times, in any
    /// order.
    ///
    /// Costs O(n²).
    + fn equals_ignore_order(array: SELF) bool {
        #if T.$is_raw_pointer
        @unsafe
        #end
        if this.length != array.length : return false
        let copy = array.copy()
        each this into v, i {
            let i2 = copy.index_of(v) ! return false
            copy.remove(i2)
        }
        return true
    }

    ////////////////
    // Filtering
    ////////////////

    #if T.$is_nullable
    - static fn filter_null(i: T) bool {
        return !isset(i)
    }
    #end

    // Predicate used by `remove_where` / `extract`: true means take the item out.
    // With no `func`, empty strings and nulls are taken out.
    - fn remove_predicate(func: ?fn(T)(bool)) ?fn(T)(bool) {
        if isset(func) : return func
        #if T.$has_method(default_array_filter)
        return T.default_array_filter
        #elif T.$is_nullable
        return SELF.filter_null
        #else
        return null
        #end
    }

    /// Returns a new array of the elements for which `func` returns true; this array is
    /// unchanged.
    ///
    /// Without `func`, empty strings and nulls are dropped; for other element types the
    /// result is a plain copy.
    + fn filter(func: ?fn(T)(bool) (null)) SELF {
        #if T.$is_raw_pointer
        @unsafe
        #end
        let result = SELF.new(this.length)
        if isset(func) {
            each this into value {
                if func(value) : result.append(value)
            }
            return result
        }

        #if T.$has_method(default_array_filter)
        each this into value {
            if !T.default_array_filter(value) : result.append(value)
        }
        #elif T.$is_nullable
        each this into value {
            if isset(value) : result.append(value)
        }
        #else
        return this.copy()
        #end
        return result
    }

    /// Removes the elements for which `func` returns true, keeping the order of the rest.
    ///
    /// `func` may append to the array; only elements present when the call started are
    /// tested. Without `func`, empty strings and nulls are removed; for other element types
    /// nothing happens.
    + fn remove_where(func: ?fn(T)(bool) (null)) {
        #if T.$is_raw_pointer
        @unsafe
        #end
        let pred = this.remove_predicate(func)
        if !isset(pred) : return
        let seen: uint = 0
        let original = this.length
        let i: uint = 0
        while seen < original && i < this.length {
            let v = this.get(i) ! break
            seen++
            if pred(v) : this.remove(i)
            else : i++
        }
    }

    /// Removes the elements for which `func` returns true and returns them in their original
    /// order.
    ///
    /// Follows the same rules as `remove_where`, including the default without `func`.
    + fn extract(func: ?fn(T)(bool) (null)) SELF {
        #if T.$is_raw_pointer
        @unsafe
        #end
        let taken = SELF.new()
        let pred = this.remove_predicate(func)
        if !isset(pred) : return taken
        let seen: uint = 0
        let original = this.length
        let i: uint = 0
        while seen < original && i < this.length {
            let v = this.get(i) ! break
            seen++
            if pred(v) {
                taken.append(v)
                this.remove(i)
            } else {
                i++
            }
        }
        return taken
    }

    /// Returns whether `func` returns true for at least one element; false when empty.
    + fn any(func: fn(T)(bool)) bool {
        #if T.$is_raw_pointer
        @unsafe
        #end
        each this into value {
            if func(value) : return true
        }
        return false
    }

    /// Returns whether `func` returns true for every element; true when empty.
    + fn all(func: fn(T)(bool)) bool {
        #if T.$is_raw_pointer
        @unsafe
        #end
        each this into value {
            if !func(value) : return false
        }
        return true
    }

    /// Returns the first element for which `func` returns true.
    ///
    /// Throws `missing` when none matches.
    + fn find(func: fn(T)(bool)) T !LookupError {
        #if T.$is_raw_pointer
        @unsafe
        #end
        each this into value {
            if func(value) : return value
        }
        throw .missing
    }

    /// Returns a new array holding `func` applied to each element, in order.
    ///
    /// ```valk
    /// let strs = values.map(fn(v) { return v.to(String) }) // Array[String]
    /// ```
    + fn map[R](func: fn(T)(R)) Array[R] {
        #if T.$is_raw_pointer || R.$is_raw_pointer
        @unsafe
        #end
        let result = Array[R].new(this.length)
        each this into value : result.append(func(value))
        return result
    }

    /// Folds the elements left to right into one value, starting from `init`.
    + fn reduce[R](init: R, func: fn(R, T)(R)) R {
        #if T.$is_raw_pointer || R.$is_raw_pointer
        @unsafe
        #end
        let total = init
        each this into value : total = func(total, value)
        return total
    }

    #if !T.$is_enum && !T.$is_nullable
    #if T.$is_integer || T.$is_float
    /// Returns the sum of the elements, or 0 when the array is empty.
    ///
    /// Available on arrays of non-nullable integers and floats.
    + fn sum() T {
        let total = 0.to(T)
        each this into value : total += value
        return total
    }

    /// Returns the smallest element.
    ///
    /// Throws `empty` when the array is empty. Available on arrays of non-nullable integers
    /// and floats.
    + fn min() T !LookupError {
        let result = this.get(0) ! throw .empty
        each this into value {
            if value < result : result = value
        }
        return result
    }

    /// Returns the largest element.
    ///
    /// Throws `empty` when the array is empty. Available on arrays of non-nullable integers
    /// and floats.
    + fn max() T !LookupError {
        let result = this.get(0) ! throw .empty
        each this into value {
            if value > result : result = value
        }
        return result
    }
    #end
    #end

    /// Returns the element with the smallest key; on a tie, the first of them.
    ///
    /// `key` runs once per element, and a null key is the smallest. Throws `empty` when the
    /// array is empty.
    + fn min_by[K](key: fn(T)(K)) T !LookupError {
        #if !K.$can_order
        #error "min_by needs a key with an order, such as a number or a String"
        #end
        #if T.$is_raw_pointer
        @unsafe
        #end
        let best = this.get(0) ! throw .empty
        let best_key = key(best)
        let i: uint = 1
        while i < this.length {
            let item = this.get(i) ! break
            let k = key(item)
            if Array[K].sort_after(best_key, k) {
                best = item
                best_key = k
            }
            i++
        }
        return best
    }

    /// Returns the element with the largest key; on a tie, the first of them.
    ///
    /// `key` runs once per element, and a null key is the smallest. Throws `empty` when the
    /// array is empty.
    + fn max_by[K](key: fn(T)(K)) T !LookupError {
        #if !K.$can_order
        #error "max_by needs a key with an order, such as a number or a String"
        #end
        #if T.$is_raw_pointer
        @unsafe
        #end
        let best = this.get(0) ! throw .empty
        let best_key = key(best)
        let i: uint = 1
        while i < this.length {
            let item = this.get(i) ! break
            let k = key(item)
            if Array[K].sort_after(k, best_key) {
                best = item
                best_key = k
            }
            i++
        }
        return best
    }

    /// Puts the elements in random order in place, every order equally likely (Fisher-Yates).
    ///
    /// Uses this thread's `random` generator, or `rng` for an order that repeats with its seed.
    + fn shuffle(rng: ?random.Rng (null)) {
        let i = this.length
        while i > 1 {
            let j = isset(rng) ? rng.below(i) : random.below(i)
            i--
            this.swap(i, j)
        }
    }

    /// Returns a copy with the elements in random order; see `shuffle`.
    + fn shuffled(rng: ?random.Rng (null)) SELF {
        let result = this.copy()
        result.shuffle(rng)
        return result
    }

    /// Removes every element equal to an earlier one, keeping first occurrences in order.
    ///
    /// Compares with `==` (so `$eq` applies). From 128 items, integers and types with `$hash`
    /// (such as `String`) are tracked in a set, which costs O(n); otherwise it costs O(n²).
    + fn remove_duplicates() {
        @unsafe
        let insert_i: uint = 0
        let data = this.data.@cast(ptr).@offset(SELF.$slice_data_offset.to(uint)).@cast(*[T])
        let len = this.length
        // A set pays for its hashing from about 128 items; below that the scan is faster
        #if !T.$is_nullable && (T.$has_hash || T.$is_integer)
        let seen: ?HashSet[T] = len >= ARRAY_UNIQUE_SET_MIN ? HashSet[T].new(len) : null
        #end
        let i: uint = 0
        while i < len {
            let find = @property_get(@ptrv(data, T, i))
            let found = false
            #if !T.$is_nullable && (T.$has_hash || T.$is_integer)
            if isset(seen) {
                found = seen.has(find)
                if !found : seen.add(find)
            } else {
                found = this.prefix_has(data, insert_i, find)
            }
            #else
            found = this.prefix_has(data, insert_i, find)
            #end
            if found : @property_clear(this.data, @ptrv(data, T, i))
            else {
                if insert_i != i {
                    @ptrv(data, T, insert_i) = @ptrv(data, T, i)
                    #if T.$has_gc_refs
                    gc.moved_elements(this.data.@cast(ptr), insert_i, 1)
                    #end
                }
                insert_i++
            }
            i++
        }
        let stale = len - insert_i
        if stale > 0 : mem.clear_bytes(data.@cast(ptr) + insert_i * size_of(T), stale * size_of(T))
        this.length = insert_i
    }

    // Whether one of the first `count` elements equals `find`. `remove_duplicates` scans only
    // its kept prefix: slots between it and the current item may already be cleared.
    fn prefix_has(data: *[T], count: uint, find: T) bool {
        @unsafe
        let o: uint = 0
        while o < count {
            if @property_get(@ptrv(data, T, o)) == find : return true
            o++
        }
        return false
    }

    /// Returns a copy without duplicates; see `remove_duplicates`.
    + fn unique() SELF {
        let result = this.copy()
        result.remove_duplicates()
        return result
    }

    ////////////////
    // Exceptions
    ////////////////

    #if T.$can_convert_to(String)
    /// Converts each element to a `String` and joins them with `divider` between each pair.
    ///
    /// Null elements are skipped and get no divider.
    + fn join(divider: String) String {
        let buffer = ByteBuffer.new()
        let count: uint = 0
        each this into part, i {
            #if T.$is_nullable
            if !isset(part) : continue
            #end
            if count++ > 0 : buffer.write(divider)
            buffer.write(part.to(String))
        }
        return buffer.into_string()
    }
    #end

    ////////////////
    // Internals
    ////////////////

    /// Returns a shallow copy: a new array holding the same elements.
    + fn copy() SELF {
        #if T.$is_raw_pointer
        @unsafe
        #end
        let arr = SELF.new(this.length)
        each this into item {
            arr.append(item)
        }
        return arr
    }

    /// Returns a deep copy: a new array holding a `$clone` of every element.
    ///
    /// Marked `$clone`: backs `$clone(arr)`.
    + fn clone() SELF $clone {
        let new = SELF.new(this.size)
        each this into item {
            new.append($clone(item))
        }
        return new.@cast(SELF)
    }
}

// The positions of `values` in a stable order: `after(a, b)` is true when `a` belongs after
// `b`. A bottom-up merge sort over positions: runs of ORDER_RUN by insertion, then merges
// that alternate between two position arrays. The values themselves never move.
fn array_stable_order[V](values: Array[V], after: fn(V, V)(bool)) Array[uint] {
    @unsafe
    let count = values.length
    let order = Array[uint].new(count)
    let spare = Array[uint].new(count)
    let n: uint = 0
    while n < count {
        order.append(n)
        spare.append(n)
        n++
    }
    let items = values.items()
    let src = order.items()
    let dst = spare.items()

    let start: uint = 0
    while start < count {
        let end = start + ORDER_RUN < count ? start + ORDER_RUN : count
        let k = start + 1
        while k < end {
            let pos = @ptrv(src, uint, k)
            let value = @property_get(@ptrv(items, V, pos))
            let m = k
            while m > start {
                let prev = @ptrv(src, uint, m - 1)
                if !after(@property_get(@ptrv(items, V, prev)), value) : break
                @ptrv(src, uint, m) = prev
                m--
            }
            @ptrv(src, uint, m) = pos
            k++
        }
        start = end
    }

    let result_is_order = true
    let width = ORDER_RUN
    while width < count {
        let lo: uint = 0
        while lo < count {
            let mid = lo + width < count ? lo + width : count
            let hi = mid + width < count ? mid + width : count
            let l = lo
            let r = mid
            let o = lo
            // Two runs already in order are copied as they are
            if r < hi && !after(@property_get(@ptrv(items, V, @ptrv(src, uint, r - 1))), @property_get(@ptrv(items, V, @ptrv(src, uint, r)))) {
                r = hi
                l = mid
                while o < hi {
                    @ptrv(dst, uint, o) = @ptrv(src, uint, o)
                    o++
                }
            }
            while l < mid && r < hi {
                let lp = @ptrv(src, uint, l)
                let rp = @ptrv(src, uint, r)
                // An equal right value stays behind the left one: that keeps the sort stable
                if after(@property_get(@ptrv(items, V, lp)), @property_get(@ptrv(items, V, rp))) {
                    @ptrv(dst, uint, o) = rp
                    r++
                } else {
                    @ptrv(dst, uint, o) = lp
                    l++
                }
                o++
            }
            while l < mid {
                @ptrv(dst, uint, o) = @ptrv(src, uint, l)
                l++
                o++
            }
            while r < hi {
                @ptrv(dst, uint, o) = @ptrv(src, uint, r)
                r++
                o++
            }
            lo = hi
        }
        let swap = src
        src = dst
        dst = swap
        result_is_order = !result_is_order
        width *= 2
    }
    // The values stay alive while they are read through raw pointers
    return result_is_order || values.length == 0 ? order : spare
}

// Sorts `values` in place with the merge sort of `array_stable_order`, moving the values
// themselves: only for element types without references, which copy as plain memory
fn array_sort_plain[V](values: Array[V], after: fn(V, V)(bool)) {
    @unsafe
    let count = values.length
    let own = values.items()
    let src = own

    let start: uint = 0
    while start < count {
        let end = start + ORDER_RUN < count ? start + ORDER_RUN : count
        let k = start + 1
        while k < end {
            let value = @ptrv(src, V, k)
            let m = k
            while m > start {
                let prev = @ptrv(src, V, m - 1)
                if !after(prev, value) : break
                @ptrv(src, V, m) = prev
                m--
            }
            @ptrv(src, V, m) = value
            k++
        }
        start = end
    }
    // One run needs no merging, and no spare storage
    if count <= ORDER_RUN : return

    let spare = values.copy()
    let dst = spare.items()
    let width = ORDER_RUN
    while width < count {
        let lo: uint = 0
        while lo < count {
            let mid = lo + width < count ? lo + width : count
            let hi = mid + width < count ? mid + width : count
            let l = lo
            let r = mid
            let o = lo
            if r < hi && !after(@ptrv(src, V, r - 1), @ptrv(src, V, r)) {
                r = hi
                l = mid
                while o < hi {
                    @ptrv(dst, V, o) = @ptrv(src, V, o)
                    o++
                }
            }
            while l < mid && r < hi {
                let lv = @ptrv(src, V, l)
                let rv = @ptrv(src, V, r)
                if after(lv, rv) {
                    @ptrv(dst, V, o) = rv
                    r++
                } else {
                    @ptrv(dst, V, o) = lv
                    l++
                }
                o++
            }
            while l < mid {
                @ptrv(dst, V, o) = @ptrv(src, V, l)
                l++
                o++
            }
            while r < hi {
                @ptrv(dst, V, o) = @ptrv(src, V, r)
                r++
                o++
            }
            lo = hi
        }
        let swap = src
        src = dst
        dst = swap
        width *= 2
    }
    if src != own {
        let i: uint = 0
        while i < count {
            @ptrv(own, V, i) = @ptrv(src, V, i)
            i++
        }
    }
    // The spare storage stays alive while it is written through a raw pointer
    spare.clear()
}

// Insertion-sorted run length of `array_stable_order`
value ORDER_RUN (16)

// From this many items `unique` and friends track values in a set instead of scanning
value ARRAY_UNIQUE_SET_MIN (128)

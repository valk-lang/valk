
use coro
use ansi

// The tests that started and have not finished, and the results of this run: a panic
// names the test it happened in and still prints the summary
global tests_running: ?Array[TestEntry] (null)
global tests_results: ?TestResults (null)

class TestEntry {
    name: String
    file: String
    line: uint
    assert_count: uint (0)
    assert_passed: uint (0)
    failure_count: uint (0)
    failures: Array[String] (.new())
    passed: bool (false)
    // The coroutine running the test
    runner: ?coro.Coro (null)

    static fn init(name: String, file: String, line: uint) TestEntry {
        let entry = TestEntry {
            name: name
            file: file
            line: line
            runner: coro.current_coro
        }
        let running = tests_running ?? <{
            let list = Array[TestEntry]{}
            tests_running = list
            return list
        }
        running.append(entry)
        return entry
    }

    static fn assert_panic(check: bool, code: String, file: String, line: uint) bool {
        if !check {
            let message = "assert(" + code + ") @ " + file + ":" + line
            panic("Assert failed: " + message)
        }
        return check
    }

    fn assert_test(check: bool, code: String, file: String, line: uint) bool {
        this.assert_count++
        if check {
            this.assert_passed++
        } else {
            this.add_failure(code, file, line, null, null)
        }
        return check
    }

    // A failed comparison, with both sides as text
    fn assert_compare_failed(code: String, file: String, line: uint, left: String, right: String) bool {
        this.assert_count++
        this.add_failure(code, file, line, left, right)
        return false
    }

    fn add_failure(code: String, file: String, line: uint, left: ?String, right: ?String) {
        this.failure_count++
        let nr = this.failure_count
        this.failures.append("#" + nr + " [code] assert(" + code + ")")
        if isset(left) && isset(right) {
            this.failures.append("#" + nr + " [left] " + test_value_text(left))
            this.failures.append("#" + nr + " [right] " + test_value_text(right))
        }
        this.failures.append("#" + nr + " [file] " + file + ":" + line)
    }
}

// A value shown in a failure line: long text is cut, so one line stays readable
fn test_value_text(text: String) String {
    if text.bytes <= 300 : return text
    return text.utf8.range(0, 300) + "... (" + text.bytes + " bytes)"
}

// How a String operand of a failed assert is shown
fn test_quote(text: String) String {
    return "\"" + text + "\""
}

// Called by `panic` in a test build, after the panic message
fn test_panicked() {
    test_stopped("panicked", "the panic")
}

// Called by `exit` in a test build: an exit from inside a test is reported like a panic.
// Returns whether a test was still running.
fn test_exited() bool {
    let running = tests_running ?? Array[TestEntry]{}
    if running.length == 0 : return false
    test_stopped("called exit", "the exit")
    return true
}

// The test running on this coroutine fails with its recorded failures, then the summary
fn test_stopped(what: String, cause: String) {
    let current = coro.current_coro
    let found: ?TestEntry = null
    let running = tests_running ?? Array[TestEntry]{}
    each running as entry {
        if isset(current) && entry.runner == current {
            found = entry
            break
        }
    }
    let results = tests_results
    if isset(found) {
        found.passed = false
        print(TestResults.format_row(found.name, false, ansi.supported() && ansi.utf8_supported()))
        each found.failures as msg : println(msg)
        println("The test " + what + " @ " + found.file + ":" + found.line)
        if isset(results) : results.entries.append(found)
    } else if running.length > 0 {
        let names = Array[String]{}
        each running as entry : names.append("'" + entry.name + "'")
        println("Tests running when it " + what + ": " + names.join(", "))
    }
    if isset(results) {
        results.print()
        println("The run stopped at " + cause + "; other tests that had not finished are not counted")
    }
}

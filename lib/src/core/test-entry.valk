
use coro
use ansi

// The tests that started and have not finished, and the results of this run: a panic
// names the test it happened in and still prints the summary
global tests_running: ?Array[TestEntry] (null)
global tests_results: ?TestResults (null)

class TestEntry {
    name: String
    file: String
    line: uint
    assert_count: uint (0)
    assert_passed: uint (0)
    failures: Array[String] (.new())
    passed: bool (false)
    // The coroutine running the test
    runner: ?coro.Coro (null)

    static fn init(name: String, file: String, line: uint) TestEntry {
        let entry = TestEntry {
            name: name
            file: file
            line: line
            runner: coro.current_coro
        }
        let running = tests_running ?? <{
            let list = Array[TestEntry]{}
            tests_running = list
            return list
        }
        running.append(entry)
        return entry
    }

    static fn assert_panic(check: bool, code: String, file: String, line: uint) bool {
        if !check {
            let message = "assert(" + code + ") @ " + file + ":" + line
            panic("Assert failed: " + message)
        }
        return check
    }

    fn assert_test(check: bool, code: String, file: String, line: uint) bool {
        this.assert_count++
        if check {
            this.assert_passed++
        } else {
            let nr = (this.failures.length / 2) + 1
            let msg1 = "#" + nr + " [code] assert(" + code + ")"
            this.failures.append(msg1)
            let msg2 = "#" + nr + " [file] " + file + ":" + line
            this.failures.append(msg2)
        }
        return check
    }
}

// Called by `panic` in a test build, after the panic message
fn test_panicked() {
    let current = coro.current_coro
    let found: ?TestEntry = null
    let running = tests_running ?? Array[TestEntry]{}
    each running as entry {
        if isset(current) && entry.runner == current {
            found = entry
            break
        }
    }
    if isset(found) {
        print(TestResults.format_row(found.name, false, ansi.supported() && ansi.utf8_supported()))
        println("The test panicked @ " + found.file + ":" + found.line)
    } else if running.length > 0 {
        let names = Array[String]{}
        each running as entry : names.append("'" + entry.name + "'")
        println("Tests running when it panicked: " + names.join(", "))
    }
    let results = tests_results
    if isset(results) {
        results.print()
        println("The run stopped at the panic; tests that had not finished are not counted")
    }
}

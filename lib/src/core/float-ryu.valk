struct RyuPow {
    low: u64
    high: u64
}

struct RyuProduct {
    low: u64
    high: u64
}

struct RyuDecimal {
    mantissa: u64
    exponent: int
}

fn ryu_log10_pow2(exponent: int) uint {
    return (exponent.to(uint) * 78913) >> 18
}

fn ryu_log10_pow5(exponent: int) uint {
    return (exponent.to(uint) * 732923) >> 20
}

fn ryu_pow5_bits(exponent: int) int {
    return ((exponent.to(uint) * 1217359) >> 19).to(int) + 1
}

fn ryu_mul_128(left: u64, right: u64) RyuProduct {
    let left_low = left.to(u32)
    let left_high = (left >> 32).to(u32)
    let right_low = right.to(u32)
    let right_high = (right >> 32).to(u32)

    let p00 = left_low.to(u64) * right_low
    let p01 = left_low.to(u64) * right_high
    let p10 = left_high.to(u64) * right_low
    let p11 = left_high.to(u64) * right_high
    let middle1 = p10 + (p00 >> 32)
    let middle2 = p01 + middle1.to(u32).to(u64)
    return .{
        low: middle2.to(u32).to(u64) << 32 | p00.to(u32).to(u64)
        high: p11 + (middle1 >> 32) + (middle2 >> 32)
    }
}

fn ryu_shift_right_128(low: u64, high: u64, distance: uint) u64 {
    return (high << (64 - distance)) | (low >> distance)
}

fn ryu_mul_shift(value: u64, multiplier: RyuPow, shift: int) u64 {
    let upper = ryu_mul_128(value, multiplier.high)
    let lower = ryu_mul_128(value, multiplier.low)
    let middle = lower.high + upper.low
    let high = upper.high + (middle < lower.high ? 1 : 0)
    return ryu_shift_right_128(middle, high, (shift - 64).to(uint))
}

fn ryu_multiple_of_power5(value: u64, power: uint) bool {
    let count: uint = 0
    while value % 5 == 0 {
        value /= 5
        count++
    }
    return count >= power
}

fn ryu_multiple_of_power2(value: u64, power: uint) bool {
    return (value & ((1.to(u64) << power) - 1)) == 0
}

fn ryu_decimal(mantissa_bits: u64, exponent_bits: uint) RyuDecimal {
    let binary_exponent: int = 0
    let binary_mantissa: u64 = 0
    if exponent_bits == 0 {
        binary_exponent = 1 - 1023 - 52 - 2
        binary_mantissa = mantissa_bits
    } else {
        binary_exponent = exponent_bits.to(int) - 1023 - 52 - 2
        binary_mantissa = (1.to(u64) << 52) | mantissa_bits
    }

    let even = (binary_mantissa & 1) == 0
    let bounds = even
    let middle = 4 * binary_mantissa
    let lower_shift: uint = mantissa_bits != 0 || exponent_bits <= 1 ? 1 : 0
    let value: u64 = 0
    let upper: u64 = 0
    let lower: u64 = 0
    let decimal_exponent: int = 0
    let lower_zeros = false
    let value_zeros = false

    if binary_exponent >= 0 {
        let power = ryu_log10_pow2(binary_exponent) - (binary_exponent > 3 ? 1 : 0)
        decimal_exponent = power.to(int)
        let k = 125 + ryu_pow5_bits(power.to(int)) - 1
        let shift = 0 - binary_exponent + power.to(int) + k
        let multiplier = ryu_pow5_inv[power]
        upper = ryu_mul_shift(4 * binary_mantissa + 2, multiplier, shift)
        lower = ryu_mul_shift(4 * binary_mantissa - 1 - lower_shift, multiplier, shift)
        value = ryu_mul_shift(4 * binary_mantissa, multiplier, shift)

        if power <= 21 {
            if middle % 5 == 0 {
                value_zeros = ryu_multiple_of_power5(middle, power)
            } else if bounds {
                lower_zeros = ryu_multiple_of_power5(middle - 1 - lower_shift, power)
            } else if ryu_multiple_of_power5(middle + 2, power) {
                upper--
            }
        }
    } else {
        let negative_exponent = 0 - binary_exponent
        let power = ryu_log10_pow5(negative_exponent) - (negative_exponent > 1 ? 1 : 0)
        decimal_exponent = power.to(int) + binary_exponent
        let table_index = negative_exponent - power.to(int)
        let k = ryu_pow5_bits(table_index) - 125
        let shift = power.to(int) - k
        let multiplier = ryu_pow5[table_index.to(uint)]
        upper = ryu_mul_shift(4 * binary_mantissa + 2, multiplier, shift)
        lower = ryu_mul_shift(4 * binary_mantissa - 1 - lower_shift, multiplier, shift)
        value = ryu_mul_shift(4 * binary_mantissa, multiplier, shift)

        if power <= 1 {
            value_zeros = true
            if bounds : lower_zeros = lower_shift == 1
            else : upper--
        } else if power < 63 {
            value_zeros = ryu_multiple_of_power2(middle, power)
        }
    }

    let removed: int = 0
    let last_digit: u8 = 0
    let output: u64 = 0
    if lower_zeros || value_zeros {
        while true {
            let upper_div = upper / 10
            let lower_div = lower / 10
            if upper_div <= lower_div : break
            lower_zeros = lower_zeros && lower % 10 == 0
            value_zeros = value_zeros && last_digit == 0
            last_digit = (value % 10).to(u8)
            value /= 10
            upper = upper_div
            lower = lower_div
            removed++
        }
        if lower_zeros {
            while lower % 10 == 0 {
                value_zeros = value_zeros && last_digit == 0
                last_digit = (value % 10).to(u8)
                value /= 10
                upper /= 10
                lower /= 10
                removed++
            }
        }
        if value_zeros && last_digit == 5 && value % 2 == 0 : last_digit = 4
        output = value + (value == lower && (!bounds || !lower_zeros) || last_digit >= 5 ? 1 : 0)
    } else {
        let round_up = false
        let upper_div = upper / 100
        let lower_div = lower / 100
        if upper_div > lower_div {
            round_up = value % 100 >= 50
            value /= 100
            upper = upper_div
            lower = lower_div
            removed += 2
        }
        while true {
            upper_div = upper / 10
            lower_div = lower / 10
            if upper_div <= lower_div : break
            round_up = value % 10 >= 5
            value /= 10
            upper = upper_div
            lower = lower_div
            removed++
        }
        output = value + (value == lower || round_up ? 1 : 0)
    }
    return .{ mantissa: output, exponent: decimal_exponent + removed }
}

fn float_format_ryu_supported(exponent_bits: uint) bool {
    let binary_exponent = exponent_bits == 0
        ? 1 - 1023 - 52 - 2
        : exponent_bits.to(int) - 1023 - 52 - 2
    if binary_exponent >= 0 {
        return ryu_log10_pow2(binary_exponent) - (binary_exponent > 3 ? 1 : 0) < ryu_pow5_inv.length
    }
    let negative_exponent = 0 - binary_exponent
    let power = ryu_log10_pow5(negative_exponent) - (negative_exponent > 1 ? 1 : 0)
    return (negative_exponent - power.to(int)).to(uint) < ryu_pow5.length
}

fn format_float_ryu(value: f64, buf: ptr) uint {
    let bits = @ptrv(&value, u64)
    let negative = (bits >> 63) != 0
    let mantissa = bits & ((1.to(u64) << 52) - 1)
    let exponent = ((bits >> 52) & 0x7ff).to(uint)
    if !float_format_ryu_supported(exponent) : return 0
    let decimal = ryu_decimal(mantissa, exponent)

    let reversed: [u8 x 24] = @undefined
    let count: uint = 0
    let digits = decimal.mantissa
    while digits > 0 {
        reversed[count++] = (digits % 10).to(u8)
        digits /= 10
    }
    let ordered: [u8 x 32] = @undefined
    let i: uint = 0
    while i < count : ordered[i] = reversed[count - i++ - 1]
    return float_format_write_digits(buf, negative, &ordered, count, decimal.exponent + count.to(int) - 1)
}

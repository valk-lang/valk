/// A binary heap: `pop` returns the item that sorts first.
///
/// By default the smallest item (by `<`) comes first; a `before(a, b)` function that returns
/// true when `a` must come out before `b` chooses another order. Items that compare equal
/// come out in no particular order, and `each` visits the items in heap order, not sorted.
/// A heap can be stored in `Lock` data when its `before` function captures nothing.
+ class Heap[T] $global {
    - items: Array[T] (.{})
    #if T.$can_order
    // Null: the default order, `<`, compared without a call
    - before: ?atomic fn(T, T)(bool) (null)
    #else
    - before: atomic fn(T, T)(bool)
    #end

    #if T.$can_order
    /// Creates an empty heap ordered by `before`, or smallest first when `before` is `null`.
    ///
    /// Marked `$default`: it also provides `Heap[T].$default_value`.
    + static fn new(before: ?atomic fn(T, T)(bool) (null)) SELF $default {
        return SELF { before: before }
    }
    #else
    /// Creates an empty heap ordered by `before`.
    ///
    /// This form is used when `T` has no `<`; the `before` function is then required.
    + static fn new(before: atomic fn(T, T)(bool)) SELF {
        return SELF { before: before }
    }
    #end

    // Whether `a` comes out before `b`; the default order without a call
    - fn earlier(a: T, b: T) bool $inline {
        let before = this.before
        #if T.$can_order
        if !isset(before) {
            #if T.$is_raw_pointer
            @unsafe
            #end
            return isset(a) && isset(b) && a < b
        }
        #end
        return before(a, b)
    }

    /// The number of items.
    + get length: uint {
        return this.items.length
    }

    /// Returns true when the heap holds no items.
    + fn is_empty() bool {
        return this.items.length == 0
    }

    /// Adds `item` in O(log n); backs the `Heap[T]{ a, b }` list literal (`$append`).
    + fn push(item: T) $append {
        this.items.append(item)
        this.sift_up(this.items.length - 1)
    }

    /// Returns the first item without removing it.
    ///
    /// Throws `empty` when the heap is empty.
    + fn peek() T !LookupError {
        if this.items.length == 0 : throw .empty
        return this.items.get(0) !>
    }

    /// Removes and returns the first item, in O(log n).
    ///
    /// Throws `empty` when the heap is empty.
    + fn pop() T !LookupError {
        let items = this.items
        if items.length == 0 : throw .empty
        let first = items.get(0) !>
        let last = items.pop_last() !>
        if items.length > 0 {
            items.set(0, last) !>
            // The moved item is usually large: sink the hole to the bottom with one comparison
            // per level, then float the item up, instead of two comparisons per level
            this.sift_down_to_bottom(0)
        }
        return first
    }

    /// Pushes `item` and pops the first item in one step.
    ///
    /// When `item` comes before the current first item, returns `item` itself and leaves the
    /// heap unchanged. Throws `empty` when the heap is empty, without pushing `item`.
    + fn replace(item: T) T !LookupError {
        if this.items.length == 0 : throw .empty
        let first = this.items.get(0) !>
        if this.earlier(item, first) : return item
        this.items.set(0, item) !>
        this.sift_down(0)
        return first
    }

    /// Removes every item.
    + fn clear() {
        this.items.clear()
    }

    /// Returns the items as a new array in heap order, which is not sorted.
    + fn to_array() Array[T] {
        return this.items.copy()
    }

    /// Removes every item and returns them sorted, first item first.
    + fn drain() Array[T] {
        let result = Array[T].new(this.items.length)
        while true {
            result.append(this.pop() ! break)
        }
        return result
    }

    /// Returns a shallow copy with the same items and the same order function.
    + fn copy() SELF {
        return SELF { items: this.items.copy(), before: this.before }
    }
    /// Returns a deep copy: every item is cloned, the order function is shared.
    + fn clone() SELF {
        return SELF { items: this.items.clone(), before: clone this.before }
    }

    - fn sift_up(index: uint) {
        let items = this.items
        #if T.$has_gc_refs
        while index > 0 {
            let parent = (index - 1) / 2
            let child_value = items.get(index) ! return
            let parent_value = items.get(parent) ! return
            if !this.earlier(child_value, parent_value) : return
            items.swap(index, parent)
            index = parent
        }
        #else
        // Plain values: carry the item up through a hole instead of swapping
        @unsafe
        let data = items.items()
        let item = @ptrv(data, T, index)
        while index > 0 {
            let parent = (index - 1) / 2
            let parent_value = @ptrv(data, T, parent)
            if !this.earlier(item, parent_value) : break
            @ptrv(data, T, index) = parent_value
            index = parent
        }
        @ptrv(data, T, index) = item
        #end
    }

    - fn sift_down(index: uint) {
        let items = this.items
        let count = items.length
        #if T.$has_gc_refs
        while index * 2 + 1 < count {
            let child = index * 2 + 1
            let best = index
            let best_value = items.get(best) ! return
            let child_value = items.get(child) ! return
            if this.earlier(child_value, best_value) {
                best = child
                best_value = child_value
            }
            if child + 1 < count {
                let right = items.get(child + 1) ! return
                if this.earlier(right, best_value) : best = child + 1
            }
            if best == index : return
            items.swap(index, best)
            index = best
        }
        #else
        if index >= count : return
        @unsafe
        let data = items.items()
        let item = @ptrv(data, T, index)
        while index * 2 + 1 < count {
            let child = index * 2 + 1
            let child_value = @ptrv(data, T, child)
            if child + 1 < count {
                let right = @ptrv(data, T, child + 1)
                if this.earlier(right, child_value) {
                    child++
                    child_value = right
                }
            }
            if !this.earlier(child_value, item) : break
            @ptrv(data, T, index) = child_value
            index = child
        }
        @ptrv(data, T, index) = item
        #end
    }

    // Moves the item at `index` to the bottom along the path of the earlier children, then
    // sifts it up from there (Floyd); fewer comparisons than sift_down when the item is large
    - fn sift_down_to_bottom(index: uint) {
        let items = this.items
        let count = items.length
        #if T.$has_gc_refs
        let end = count
        while index * 2 + 1 < end {
            let child = index * 2 + 1
            if child + 1 < end {
                let left = items.get(child) ! return
                let right = items.get(child + 1) ! return
                if this.earlier(right, left) : child++
            }
            items.swap(index, child)
            index = child
        }
        this.sift_up(index)
        #else
        if index >= count : return
        @unsafe
        let data = items.items()
        let item = @ptrv(data, T, index)
        while index * 2 + 1 < count {
            let child = index * 2 + 1
            if child + 1 < count && this.earlier(@ptrv(data, T, child + 1), @ptrv(data, T, child)) : child++
            @ptrv(data, T, index) = @ptrv(data, T, child)
            index = child
        }
        @ptrv(data, T, index) = item
        this.sift_up(index)
        #end
    }

    fn _next(index: uint) (T, uint) !IterError {
        let item = this.items.get(index) ! throw .end
        return (item, index)
    }
}

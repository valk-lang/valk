// A binary heap: `pop` returns the item that sorts first. By default the
// smallest item comes first; a `before(a, b)` function that returns true
// when `a` must come out before `b` chooses another order
+ class Heap[T] $global {
    - items: Array[T] (.{})
    #if T.$can_order
    - before: fn(T, T)(bool) (SELF.less)
    #else
    - before: fn(T, T)(bool)
    #end

    #if T.$can_order
    - static fn less(a: T, b: T) bool {
        #if T.$is_raw_pointer
        @unsafe
        #end
        return isset(a) && isset(b) && a < b
    }

    + static fn new(before: ?fn(T, T)(bool) (null)) SELF $default {
        return SELF { before: before ?? SELF.less }
    }
    #else
    + static fn new(before: fn(T, T)(bool)) SELF {
        return SELF { before: before }
    }
    #end

    + get length: uint {
        return this.items.length
    }

    + fn is_empty() bool {
        return this.items.length == 0
    }

    + fn push(item: T) $append {
        this.items.append(item)
        this.sift_up(this.items.length - 1)
    }

    // The first item, without removing it
    + fn peek() T !LookupError {
        return this.items.get(0) !>
    }

    // Removes and returns the first item
    + fn pop() T !LookupError {
        let items = this.items
        let count = items.length
        if count == 0 : throw .empty
        if count == 1 : return items.pop_last() !>
        items.swap(0, count - 1)
        let first = items.pop_last() !>
        this.sift_down(0)
        return first
    }

    // Pushes `item` and pops the first item in one step
    + fn replace(item: T) T !LookupError {
        if this.items.length == 0 : throw .empty
        let first = this.items.get(0) !>
        if this.before(item, first) : return item
        this.items.set(0, item) !>
        this.sift_down(0)
        return first
    }

    + fn clear() {
        this.items.clear()
    }

    // The items in heap order, not sorted
    + fn to_array() Array[T] {
        return this.items.copy()
    }

    // Removes every item; the result is sorted
    + fn drain() Array[T] {
        let result = Array[T].new(this.items.length)
        while true {
            result.append(this.pop() ! break)
        }
        return result
    }

    + fn copy() SELF {
        return SELF { items: this.items.copy(), before: this.before }
    }

    - fn sift_up(index: uint) {
        let items = this.items
        while index > 0 {
            let parent = (index - 1) / 2
            let child_value = items.get(index) ! return
            let parent_value = items.get(parent) ! return
            if !this.before(child_value, parent_value) : return
            items.swap(index, parent)
            index = parent
        }
    }

    - fn sift_down(index: uint) {
        let items = this.items
        let count = items.length
        while index * 2 + 1 < count {
            let child = index * 2 + 1
            let best = index
            let best_value = items.get(best) ! return
            let child_value = items.get(child) ! return
            if this.before(child_value, best_value) {
                best = child
                best_value = child_value
            }
            if child + 1 < count {
                let right = items.get(child + 1) ! return
                if this.before(right, best_value) : best = child + 1
            }
            if best == index : return
            items.swap(index, best)
            index = best
        }
    }

    fn _next(index: uint) (T, uint) !IterError {
        let item = this.items.get(index) ! throw .end
        return (item, index)
    }
}

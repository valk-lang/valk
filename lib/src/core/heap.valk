use mem
use gc

/// A binary heap: `pop` returns the item that sorts first.
///
/// By default the smallest item (by `<`) comes first; a `before(a, b)` function that returns
/// true when `a` must come out before `b` chooses another order. Items that compare equal
/// come out in no particular order, and `each` visits the items in heap order, not sorted.
/// A heap can be stored in `Lock` data when its `before` function captures nothing.
+ class Heap[T] $global {
    - storage: mut &[T] (SELF.empty_storage())
    - capacity: uint (0)
    - count: uint (0)
    #if T.$can_order
    // Null: the default order, `<`, compared without a call
    - before: ?atomic fn(T, T)(bool) (null)
    #else
    - before: atomic fn(T, T)(bool)
    #end

    - static fn empty_storage() mut &[T] $inline {
        @unsafe
        return [T]{ owner: null, data: 0.@cast(*[T]), length: 0 }
    }

    #if T.$can_order
    /// Creates an empty heap ordered by `before`, or smallest first when `before` is `null`.
    ///
    /// Marked `$default`: it also provides `Heap[T].$default_value`.
    + static fn new(before: ?atomic fn(T, T)(bool) (null)) SELF $default $inline {
        return SELF { before: before }
    }
    #else
    /// Creates an empty heap ordered by `before`.
    ///
    /// This form is used when `T` has no `<`; the `before` function is then required.
    + static fn new(before: atomic fn(T, T)(bool)) SELF $inline {
        return SELF { before: before }
    }
    #end

    // Whether `a` comes out before `b`; the default order without a call
    - fn earlier(a: T, b: T) bool $inline {
        let before = this.before
        #if T.$can_order
        if !isset(before) {
            #if T.$is_raw_pointer
            @unsafe
            #end
            return isset(a) && isset(b) && a < b
        }
        #end
        return before(a, b)
    }

    /// The number of items.
    + get length: uint {
        return this.count
    }

    /// Returns true when the heap holds no items.
    + fn is_empty() bool {
        return this.count == 0
    }

    /// Adds `item` in O(log n); backs the `Heap[T]{ a, b }` list literal (`$append`).
    + fn push(item: T) $append $inline {
        let count = this.count
        if count == this.capacity : this.grow(count + 1)
        this.count = count + 1
        #if T.$has_gc_refs
        @property_init(this.storage.owner, @ptrv(this.storage.data, T, count), item)
        this.sift_up_managed(count)
        #else
        this.sift_up_plain(count, item)
        #end
    }

    /// Returns the first item without removing it.
    ///
    /// Throws `empty` when the heap is empty.
    + fn peek() T !LookupError {
        if this.count == 0 : throw .empty
        return @property_get(@ptrv(this.storage.data, T, 0))
    }

    /// Removes and returns the first item, in O(log n).
    ///
    /// Throws `empty` when the heap is empty.
    + fn pop() T !LookupError $inline {
        let count = this.count
        if count == 0 : throw .empty
        let data = this.storage.data
        let first = @property_get(@ptrv(data, T, 0))
        let last_idx = count - 1
        let last = @property_get(@ptrv(data, T, last_idx))
        #if T.$has_gc_refs
        @unsafe
        @property_clear(this.storage.owner, @ptrv(data, T, last_idx))
        mem.clear_bytes(data.@cast(ptr) + last_idx * size_of(T), size_of(T))
        #end
        this.count = last_idx
        if last_idx > 0 {
            #if T.$has_gc_refs
            this.sift_down_to_bottom_managed(last)
            #else
            this.sift_down_to_bottom_plain(last, last_idx)
            #end
        }
        return first
    }

    /// Pushes `item` and pops the first item in one step.
    ///
    /// When `item` comes before the current first item, returns `item` itself and leaves the
    /// heap unchanged. Throws `empty` when the heap is empty, without pushing `item`.
    + fn replace(item: T) T !LookupError {
        if this.count == 0 : throw .empty
        let first = @property_get(@ptrv(this.storage.data, T, 0))
        if this.earlier(item, first) : return item
        this.storage[0] = item
        #if T.$has_gc_refs
        this.sift_down(0)
        #else
        this.sift_down_plain(0, item, this.count)
        #end
        return first
    }

    /// Removes every item.
    + fn clear() {
        #if T.$has_gc_refs
        @unsafe
        let i: uint = 0
        let count = this.count
        let data = this.storage.data
        let owner = this.storage.owner
        while i < count {
            @property_clear(owner, @ptrv(data, T, i))
            i++
        }
        if count > 0 : mem.clear_bytes(data.@cast(ptr), count * size_of(T))
        #end
        this.count = 0
    }

    /// Returns the items as a new array in heap order, which is not sorted.
    + fn to_array() Array[T] {
        let count = this.count
        let result = Array[T].new(count)
        let i: uint = 0
        let data = this.storage.data
        while i < count {
            result.append(@property_get(@ptrv(data, T, i)))
            i++
        }
        return result
    }

    /// Removes every item and returns them sorted, first item first.
    + fn drain() Array[T] {
        let result = Array[T].new(this.count)
        while true {
            result.append(this.pop() ! break)
        }
        return result
    }

    /// Returns a shallow copy with the same items and the same order function.
    + fn copy() SELF {
        let count = this.count
        let out = SELF { before: this.before }
        if count > 0 {
            out.grow(count)
            let src = this.storage.data
            let dst = out.storage.data
            #if !T.$has_gc_refs
            @unsafe
            mem.copy_bytes(src.@cast(ptr), dst.@cast(ptr), count * size_of(T))
            #else
            let i: uint = 0
            while i < count {
                @property_init(out.storage.owner, @ptrv(dst, T, i), @property_get(@ptrv(src, T, i)))
                i++
            }
            #end
            out.count = count
        }
        return out
    }

    /// Returns a deep copy: every item is cloned, the order function is shared.
    + fn clone() SELF {
        let count = this.count
        let out = SELF { before: clone this.before }
        if count > 0 {
            out.grow(count)
            let src = this.storage.data
            let dst = out.storage.data
            let i: uint = 0
            while i < count {
                let item = @property_get(@ptrv(src, T, i))
                #if T.$has_gc_refs
                @property_init(out.storage.owner, @ptrv(dst, T, i), clone item)
                #else
                @ptrv(dst, T, i) = clone item
                #end
                i++
            }
            out.count = count
        }
        return out
    }

    - fn grow(minimum: uint) $noinline $region {
        @unsafe
        let capacity = this.capacity
        let size: uint = capacity == 0 ? 8 : capacity
        while size < minimum {
            let next = size * 2
            if next <= size : panic("Heap capacity is too large")
            size = next
        }
        size = gc.fit_count(Array[T].$slice_data_offset.to(uint), size_of(T), size)
        if size <= capacity : return
        let count = this.count
        #if !T.$has_gc_refs
        let fresh = [T]{ @undefined x size }
        if count > 0 {
            mem.copy_bytes(this.storage.data.@cast(ptr), fresh.data.@cast(ptr), count * size_of(T))
        }
        this.storage = fresh
        this.capacity = size
        #else
        let fresh = [T]{ null x size }
        if count > 0 {
            let old_owner = this.storage.owner
            let new_owner = fresh.owner
            mem.copy_bytes(this.storage.data.@cast(ptr), fresh.data.@cast(ptr), count * size_of(T))
            if isset(old_owner) && isset(new_owner) : gc.transfer_refs(old_owner.@cast(ptr), new_owner.@cast(ptr))
        }
        this.storage = fresh
        this.capacity = size
        #end
    }

    - fn swap_slots(index_a: uint, index_b: uint) $inline {
        let data = this.storage.data
        let a = @ptrv(data, T, index_a)
        let b = @ptrv(data, T, index_b)
        @ptrv(data, T, index_a) = b
        @ptrv(data, T, index_b) = a
        #if T.$has_gc_refs
        @unsafe
        let owner = this.storage.owner
        if isset(owner) {
            gc.moved_elements(owner.@cast(ptr), index_a, 1)
            gc.moved_elements(owner.@cast(ptr), index_b, 1)
        }
        #end
    }

    #if !T.$has_gc_refs
    - fn sift_up_plain(index: uint, item: T) $inline {
        let data = this.storage.data
        let before = this.before
        #if T.$can_order
        if !isset(before) {
            #if T.$is_raw_pointer
            @unsafe
            #end
            while index > 0 {
                let parent = (index - 1) / 2
                let parent_value = @ptrv(data, T, parent)
                if !(isset(item) && isset(parent_value) && item < parent_value) : break
                @ptrv(data, T, index) = parent_value
                index = parent
            }
            @ptrv(data, T, index) = item
            return
        }
        #end
        while index > 0 {
            let parent = (index - 1) / 2
            let parent_value = @ptrv(data, T, parent)
            if !before(item, parent_value) : break
            @ptrv(data, T, index) = parent_value
            index = parent
        }
        @ptrv(data, T, index) = item
    }

    - fn sift_down_plain(index: uint, item: T, count: uint) {
        let data = this.storage.data
        let before = this.before
        #if T.$can_order
        if !isset(before) {
            #if T.$is_raw_pointer
            @unsafe
            #end
            while index * 2 + 1 < count {
                let child = index * 2 + 1
                let child_value = @ptrv(data, T, child)
                if child + 1 < count {
                    let right = @ptrv(data, T, child + 1)
                    if isset(right) && isset(child_value) && right < child_value {
                        child++
                        child_value = right
                    }
                }
                if !(isset(child_value) && isset(item) && child_value < item) : break
                @ptrv(data, T, index) = child_value
                index = child
            }
            @ptrv(data, T, index) = item
            return
        }
        #end
        while index * 2 + 1 < count {
            let child = index * 2 + 1
            let child_value = @ptrv(data, T, child)
            if child + 1 < count {
                let right = @ptrv(data, T, child + 1)
                if before(right, child_value) {
                    child++
                    child_value = right
                }
            }
            if !before(child_value, item) : break
            @ptrv(data, T, index) = child_value
            index = child
        }
        @ptrv(data, T, index) = item
    }

    // Fills the hole at the root with `item`: the hole sinks to the bottom, then `item` floats up
    - fn sift_down_to_bottom_plain(item: T, count: uint) $inline {
        let data = this.storage.data
        let before = this.before
        let index: uint = 0
        #if T.$can_order
        if !isset(before) {
            #if T.$is_raw_pointer
            @unsafe
            #end
            while index * 2 + 1 < count {
                let child = index * 2 + 1
                if child + 1 < count {
                    let right = @ptrv(data, T, child + 1)
                    let left = @ptrv(data, T, child)
                    if isset(right) && isset(left) && right < left : child++
                }
                @ptrv(data, T, index) = @ptrv(data, T, child)
                index = child
            }
            while index > 0 {
                let parent = (index - 1) / 2
                let parent_value = @ptrv(data, T, parent)
                if !(isset(item) && isset(parent_value) && item < parent_value) : break
                @ptrv(data, T, index) = parent_value
                index = parent
            }
            @ptrv(data, T, index) = item
            return
        }
        #end
        while index * 2 + 1 < count {
            let child = index * 2 + 1
            if child + 1 < count && before(@ptrv(data, T, child + 1), @ptrv(data, T, child)) : child++
            @ptrv(data, T, index) = @ptrv(data, T, child)
            index = child
        }
        while index > 0 {
            let parent = (index - 1) / 2
            let parent_value = @ptrv(data, T, parent)
            if !before(item, parent_value) : break
            @ptrv(data, T, index) = parent_value
            index = parent
        }
        @ptrv(data, T, index) = item
    }
    #else
    - fn sift_up_managed(index: uint) {
        let data = this.storage.data
        while index > 0 {
            let parent = (index - 1) / 2
            let child_value = @property_get(@ptrv(data, T, index))
            let parent_value = @property_get(@ptrv(data, T, parent))
            if !this.earlier(child_value, parent_value) : return
            this.swap_slots(index, parent)
            index = parent
        }
    }

    - fn sift_down(index: uint) {
        let count = this.count
        let data = this.storage.data
        while index * 2 + 1 < count {
            let child = index * 2 + 1
            let best = index
            let best_value = @property_get(@ptrv(data, T, best))
            let child_value = @property_get(@ptrv(data, T, child))
            if this.earlier(child_value, best_value) {
                best = child
                best_value = child_value
            }
            if child + 1 < count {
                let right = @property_get(@ptrv(data, T, child + 1))
                if this.earlier(right, best_value) : best = child + 1
            }
            if best == index : return
            this.swap_slots(index, best)
            index = best
        }
    }

    - fn sift_down_to_bottom_managed(item: T) {
        let count = this.count
        let data = this.storage.data
        @property_update(this.storage.owner, @ptrv(data, T, 0), item)
        let index: uint = 0
        while index * 2 + 1 < count {
            let child = index * 2 + 1
            if child + 1 < count {
                let left = @property_get(@ptrv(data, T, child))
                let right = @property_get(@ptrv(data, T, child + 1))
                if this.earlier(right, left) : child++
            }
            this.swap_slots(index, child)
            index = child
        }
        this.sift_up_managed(index)
    }
    #end

    fn _next(index: uint) (T, uint) !IterError {
        if index >= this.count : throw .end
        return (@property_get(@ptrv(this.storage.data, T, index)), index)
    }
}

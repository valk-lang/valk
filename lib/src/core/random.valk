@unsafe

use ext

-~+ fn fill_secure_random(buffer: ptr, length: uint) bool {
    let offset: uint = 0
    while offset < length {
        let remaining = length - offset
        #if OS == "linux"
        let result = ext.getrandom(buffer.@offset(offset), remaining, 0)
        if result < 0 {
            if ext.get_errno() == ext.EINTR : continue
            return false
        }
        if result == 0 : return false
        offset += result.to(uint)
        #elif OS == "macos"
        let chunk = remaining > 256 ? 256 : remaining
        if ext.getentropy(buffer.@offset(offset), chunk) != 0 : return false
        offset += chunk
        #elif OS == "win"
        let chunk = remaining > 0xffffffff ? 0xffffffff.to(uint) : remaining
        if ext.BCryptGenRandom(null, buffer.@offset(offset), chunk.to(u32), 2) != 0 : return false
        offset += chunk
        #end
    }
    return true
}

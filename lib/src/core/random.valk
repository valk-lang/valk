use ext

// Fills `buffer` from the OS entropy source; an unavailable source is fatal
-~+ fn fill_secure_random(buffer: ptr, length: uint) {
    @unsafe
    let offset: uint = 0
    while offset < length {
        let remaining = length - offset
        #if OS == "linux"
        let result = ext.getrandom(buffer.@offset(offset), remaining, 0)
        if result < 0 {
            if ext.get_errno() == ext.EINTR : continue
            panic("The operating system could not provide secure random bytes")
        }
        if result == 0 : panic("The operating system could not provide secure random bytes")
        offset += result.to(uint)
        #elif OS == "macos"
        let chunk = remaining > 256 ? 256 : remaining
        if ext.getentropy(buffer.@offset(offset), chunk) != 0 : panic("The operating system could not provide secure random bytes")
        offset += chunk
        #elif OS == "win"
        let chunk = remaining > 0xffffffff ? 0xffffffff.to(uint) : remaining
        if ext.BCryptGenRandom(null, buffer.@offset(offset), chunk.to(u32), 2) != 0 : panic("The operating system could not provide secure random bytes")
        offset += chunk
        #end
    }
}

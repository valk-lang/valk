// A set of unique values, hashed like HashMap keys. Iteration order is the
// insertion order until a removal, which moves the last value into the freed
// slot
+ class HashSet[T] $global {
    - map: HashMap[T, bool] (.{})

    + static fn new(capacity: uint (0)) SELF $default {
        return SELF { map: HashMap[T, bool].new(capacity) }
    }

    + get length: uint {
        return this.map.length
    }

    // Adds `value`; the set is returned so that adds can be chained
    + fn add(value: T) SELF $append {
        this.map.set(value, true)
        return this
    }

    // Adds `value` and tells whether it was new
    + fn insert(value: T) bool {
        if this.map.has(value) : return false
        this.map.set(value, true)
        return true
    }

    + fn has(value: T) bool {
        return this.map.has(value)
    }

    // Removes `value` and tells whether it was present
    + fn remove(value: T) bool {
        if !this.map.has(value) : return false
        this.map.remove(value)
        return true
    }

    + fn clear() SELF {
        this.map.clear()
        return this
    }

    // The values as an array, in iteration order
    + fn items() Array[T] {
        return this.map.keys()
    }

    + fn add_all(values: Array[T]) SELF {
        each values as value : this.map.set(value, true)
        return this
    }

    // Values in this set or in `other`
    + fn union(other: SELF) SELF $add {
        let result = this.copy()
        each other as value : result.map.set(value, true)
        return result
    }

    // Values in both sets
    + fn intersection(other: SELF) SELF {
        let result = SELF.new()
        each this as value {
            if other.has(value) : result.map.set(value, true)
        }
        return result
    }

    // Values in this set that are not in `other`
    + fn difference(other: SELF) SELF $sub {
        let result = SELF.new()
        each this as value {
            if !other.has(value) : result.map.set(value, true)
        }
        return result
    }

    + fn is_subset_of(other: SELF) bool {
        if this.length > other.length : return false
        each this as value {
            if !other.has(value) : return false
        }
        return true
    }

    + fn is_disjoint(other: SELF) bool {
        each this as value {
            if other.has(value) : return false
        }
        return true
    }

    + fn equals(other: SELF) bool $eq {
        return this.length == other.length && this.is_subset_of(other)
    }

    + fn copy() SELF {
        return SELF { map: this.map.copy() }
    }

    // Deep copy: every value is cloned as well
    + fn clone() SELF $clone {
        return SELF { map: this.map.clone() }
    }

    fn _next(index: uint) (T, uint) !IterError {
        let value = this.map._keys.get(index) ! throw .end
        return (value, index)
    }
}

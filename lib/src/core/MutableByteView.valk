+ struct MutableByteView $global {
    source: ByteBuffer
    offset: uint
    length: uint

    + static fn new(source: ByteBuffer, offset: uint, length: uint) SELF $inline {
        let source_length = source.length
        if offset > source_length {
            offset = 0
            length = 0
        } else if length > source_length - offset {
            length = source_length - offset
        }
        return SELF {
            source: source
            offset: offset
            length: length
        }
    }

    + get data: ptr $inline {
        if this.offset > this.source.length : return this.source.data
        return this.source.data.@offset(this.offset)
    }

    + get bytes: uint $inline {
        return this.available_length()
    }

    + fn get(index: uint) u8 $offset $inline {
        if index >= this.available_length() : return 0
        return @ptrv(this.source.data, u8, this.offset + index)
    }

    + fn set(index: uint, value: u8) $offset_assign $inline {
        if index >= this.available_length() : return
        @ptrv(this.source.data, u8, this.offset + index) = value
    }

    + fn view(offset: uint, length: uint) SELF $range $inline {
        let available = this.available_length()
        if offset > available {
            offset = 0
            length = 0
        } else if length > available - offset {
            length = available - offset
        }
        return SELF {
            source: this.source
            offset: this.offset + offset
            length: length
        }
    }

    + fn read_view() ByteView[ByteBuffer] $inline {
        return ByteView[ByteBuffer].new(this.source, this.offset, this.available_length())
    }

    fn available_length() uint $inline {
        let source_length = this.source.length
        let offset = this.offset
        if offset > source_length : return 0
        let available = source_length - offset
        return this.length > available ? available : this.length
    }
}

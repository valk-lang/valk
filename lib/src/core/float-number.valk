+ trait FloatNumber {
    + fn abs() SELF {
        if this == 0 : return 0
        return this < 0 ? 0 - this : this
    }

    + fn min(other: SELF) SELF {
        if this.is_nan() : return other
        if other.is_nan() : return this
        return this < other ? this : other
    }

    + fn max(other: SELF) SELF {
        if this.is_nan() : return other
        if other.is_nan() : return this
        return this > other ? this : other
    }

    + fn clamp(minimum: SELF, maximum: SELF) SELF {
        if minimum.is_nan() || maximum.is_nan() || minimum > maximum {
            panic("The minimum cannot exceed the maximum or be NaN")
        }
        if this < minimum : return minimum
        if this > maximum : return maximum
        return this
    }

    + fn is_nan() bool {
        return this != this
    }

    + fn is_finite() bool {
        return !this.is_nan() && (this - this) == 0
    }

    + fn is_infinite() bool {
        return !this.is_nan() && (this - this) != 0
    }

    + fn to_shortest_string() String $auto {
        @unsafe
        let buf: [u8 x 64] = @undefined
        let len = this.to_shortest_string_in_ptr(@ref(buf))
        return String.copy_from_ptr(&buf, len)
    }

    + fn to_string(decimals: uint (2), trim_zeros: bool (false)) String {
        @unsafe
        let buf: [u8 x 64] = @undefined
        let len = this.to_string_in_ptr(&buf, decimals, trim_zeros)
        return String.copy_from_ptr(&buf, len)
    }

    + fn to_string_in_ptr(buf: ptr, decimals: uint (2), trim_zeros: bool (false)) uint {
        @unsafe
        let intv_offset: uint = 0

        let value = this
        let finite_check = value - value
        if finite_check != finite_check : return format_float_shortest(value, buf)

        if value < 0 {
            value = value * -1
            @ptrv(buf, u8, 0) = '-'
            intv_offset++
        }

        //
        let intv = value.to(int)
        let dot_offset = intv_offset + intv.character_length(10)

        let fv: SELF = value - intv.to(SELF)
        let i: uint = 0
        let expo: uint = 1
        while i++ < decimals : expo *= 10
        fv *= expo.to(SELF)
        let fi = fv.to(uint)

        fv -= fi.to(SELF)
        if fv > 0.5 {
            if (++fi) % expo == 0 {
                fi = 0
                intv++
                dot_offset = intv_offset + intv.character_length(10)
            }
        }

        let len = intv.to_base_to_ptr(10, buf + intv_offset)
        if decimals > 0 && (fi > 0 || !trim_zeros) {
            @ptrv(buf, u8, dot_offset) = '.'
            let offset = dot_offset + 1
            // Leading zeros
            let fillc = decimals - fi.character_length(10)
            i = 0
            while i++ < fillc : @ptrv(buf, u8, offset++) = '0'
            // Write decimal number
            let flen = fi.to_base_to_ptr(10, buf + offset)
            offset += flen
            // Trailing zeros
            if trim_zeros {
                while @ptrv(buf, u8, offset - 1) == '0' : offset--
            } else {
                flen += fillc
                while flen++ < decimals : @ptrv(buf, u8, offset++) = '0'
            }
            len = offset
        } else {
            len = len + intv_offset
        }

        return len
    }

    + fn to_shortest_string_in_ptr(buf: ptr) uint {
        @unsafe
        return format_float_shortest(this, buf)
    }

    fn equals_string(str: String) bool $eq {
        let v = str.to_float() ! return false
        return this == v
    }
}

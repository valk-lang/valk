/// Methods shared by every floating-point type.
+ trait FloatNumber {
    /// Returns the absolute value. `-0.0` becomes `0.0` and NaN stays NaN.
    + fn abs() SELF {
        if this == 0 : return 0
        return this < 0 ? 0 - this : this
    }

    /// Returns the smaller of `this` and `other`; when one of them is NaN, returns the other.
    + fn min(other: SELF) SELF {
        if this.is_nan() : return other
        if other.is_nan() : return this
        return this < other ? this : other
    }

    /// Returns the larger of `this` and `other`; when one of them is NaN, returns the other.
    + fn max(other: SELF) SELF {
        if this.is_nan() : return other
        if other.is_nan() : return this
        return this > other ? this : other
    }

    /// Returns the value limited to the range `minimum` to `maximum`, both inclusive.
    ///
    /// Panics when `minimum` is greater than `maximum` or either bound is NaN. A NaN value is
    /// returned unchanged.
    + fn clamp(minimum: SELF, maximum: SELF) SELF {
        if minimum.is_nan() || maximum.is_nan() || minimum > maximum {
            panic("The minimum cannot exceed the maximum or be NaN")
        }
        if this < minimum : return minimum
        if this > maximum : return maximum
        return this
    }

    /// Returns true when the value is NaN.
    + fn is_nan() bool {
        return this != this
    }

    /// Returns true when the value is neither infinite nor NaN.
    + fn is_finite() bool {
        return !this.is_nan() && (this - this) == 0
    }

    /// Returns true when the value is positive or negative infinity.
    + fn is_infinite() bool {
        return !this.is_nan() && (this - this) != 0
    }

    /// Returns the shortest decimal text that parses back to the same value.
    ///
    /// Values with a decimal exponent from -6 to 20 are written plainly (`100`, `0.1`,
    /// `0.000001`); others use an exponent (`1e21`, `1.5e-7`). Special values are `nan`, `inf`,
    /// `-inf` and `-0`. Tagged `$auto`, so a float converts to `String` implicitly wherever one
    /// is expected.
    + fn to_shortest_string() String $auto {
        @unsafe
        let buf: [u8 x 64] = @undefined
        let len = this.to_shortest_string_in_ptr(@ref(buf))
        return String.copy_from_ptr(&buf, len)
    }

    /// Returns the value with exactly `decimals` digits after the dot, e.g. `1.50`.
    ///
    /// At most 19 decimals are written; larger values are clamped to 19. With `trim_zeros`,
    /// trailing zeros are dropped, and the dot too when nothing remains after it. Halfway cases
    /// round toward zero: `(2.5).to_string(0)` is `2`. NaN, infinities and values of magnitude
    /// 2^63 or more fall back to `to_shortest_string` formatting. Negative zero keeps its sign.
    + fn to_string(decimals: uint (2), trim_zeros: bool (false)) String {
        @unsafe
        let buf: [u8 x 64] = @undefined
        let len = this.to_string_in_ptr(&buf, decimals, trim_zeros)
        return String.copy_from_ptr(&buf, len)
    }

    /// Writes the value like `to_string` to `buf` and returns the byte count.
    ///
    /// `buf` needs room for 64 bytes. No terminating zero is written.
    + fn to_string_in_ptr(buf: ptr, decimals: uint (2), trim_zeros: bool (false)) uint {
        @unsafe
        if decimals > 19 : decimals = 19
        let intv_offset: uint = 0

        let value = this
        let finite_check = value - value
        if finite_check != finite_check : return format_float_shortest(value, buf)
        // Beyond the integer range the fixed layout has no digits to write
        if value >= 9223372036854775808.0 || value <= -9223372036854775808.0 : return format_float_shortest(value, buf)

        // Negative zero keeps its sign, like every other formatter
        if value < 0 || (value == 0 && 1.0 / value < 0) {
            value = value * -1
            @ptrv(buf, u8, 0) = '-'
            intv_offset++
        }

        //
        let intv = value.to(int)
        let dot_offset = intv_offset + intv.character_length(10)

        let fv: SELF = value - intv.to(SELF)
        let i: uint = 0
        let expo: uint = 1
        while i++ < decimals : expo *= 10
        fv *= expo.to(SELF)
        let fi = fv.to(uint)

        fv -= fi.to(SELF)
        if fv > 0.5 {
            if (++fi) % expo == 0 {
                fi = 0
                intv++
                dot_offset = intv_offset + intv.character_length(10)
            }
        }

        let len = intv.to_base_to_ptr(10, buf + intv_offset)
        if decimals > 0 && (fi > 0 || !trim_zeros) {
            @ptrv(buf, u8, dot_offset) = '.'
            let offset = dot_offset + 1
            // Leading zeros
            let fillc = decimals - fi.character_length(10)
            i = 0
            while i++ < fillc : @ptrv(buf, u8, offset++) = '0'
            // Write decimal number
            let flen = fi.to_base_to_ptr(10, buf + offset)
            offset += flen
            // Trailing zeros
            if trim_zeros {
                while @ptrv(buf, u8, offset - 1) == '0' : offset--
            } else {
                flen += fillc
                while flen++ < decimals : @ptrv(buf, u8, offset++) = '0'
            }
            len = offset
        } else {
            len = len + intv_offset
        }

        return len
    }

    /// Writes the value like `to_shortest_string` to `buf` and returns the byte count.
    ///
    /// `buf` needs room for 32 bytes. No terminating zero is written. With `force_exponent`
    /// the exponent form is always used.
    + fn to_shortest_string_in_ptr(buf: ptr, force_exponent: bool (false)) uint {
        @unsafe
        return format_float_shortest(this, buf, force_exponent)
    }

    /// Returns true when `str` parses as a float equal to this value.
    ///
    /// Parses with `String.to_float`; text that does not parse compares unequal, and NaN never
    /// compares equal. Tagged `$eq`, so `1.5 == "1.5"` is true.
    + fn equals_string(str: String) bool $eq {
        let v = str.to_float() ! return false
        return this == v
    }
}

struct ZmijPow {
    high: u64
    low: u64
}

struct ZmijProduct {
    high: u64
    low: u64
}

struct ZmijDecimal {
    mantissa: u64
    exponent: int
}

struct ZmijCandidate {
    significand: u64
    exponent: int
    last_digit: u8
    has_last_digit: bool
}

fn zmij_mul_128(left: u64, right: u64) ZmijProduct {
    let a = left >> 32
    let b = left.to(u32).to(u64)
    let c = right >> 32
    let d = right.to(u32).to(u64)
    let ac = a * c
    let bc = b * c
    let ad = a * d
    let bd = b * d
    let cross = (bd >> 32) + ad.to(u32).to(u64) + bc.to(u32).to(u64)
    return .{
        high: ac + (ad >> 32) + (bc >> 32) + (cross >> 32)
        low: (cross << 32) + bd.to(u32).to(u64)
    }
}

fn zmij_mul_high(left: u64, right: u64) u64 {
    return zmij_mul_128(left, right).high
}

fn zmij_mul_192_high(value_high: u64, value_low: u64, multiplier: u64) ZmijProduct {
    let product = zmij_mul_128(value_high, multiplier)
    let low = product.low + zmij_mul_high(value_low, multiplier)
    return .{
        high: product.high + (low < product.low ? 1 : 0)
        low: low
    }
}

fn zmij_mul_add_high(left: u64, right: u64, carry: u64) u64 {
    let product = zmij_mul_128(left, right)
    return product.high + (product.low + carry < product.low ? 1 : 0)
}

fn zmij_decimal_exponent(binary_exponent: int, regular: bool) int {
    return (binary_exponent * 315653 - (!regular ? 131072 : 0)) >> 20
}

fn zmij_exponent_shift(binary_exponent: int, decimal_exponent: int) uint {
    let power_exponent = (0 - decimal_exponent * 217707) >> 16
    return (binary_exponent + power_exponent + 1).to(uint)
}

fn zmij_power(decimal_exponent: int) ZmijPow {
    return zmij_pow10[(decimal_exponent + 293).to(uint)]
}

fn zmij_candidate(mantissa: u64, raw_exponent: int, regular: bool) ZmijCandidate {
    let binary_exponent = raw_exponent - 1075
    let decimal_exponent = zmij_decimal_exponent(binary_exponent, regular)
    let extra_shift: uint = 6
    let shift = zmij_exponent_shift(binary_exponent, decimal_exponent + 1) + extra_shift
    let power = zmij_power(0 - decimal_exponent - 1)
    let product = zmij_mul_192_high(power.high, power.low, mantissa << shift)
    let integral = product.high >> extra_shift
    let fractional = (product.high << (64 - extra_shift)) | (product.low >> extra_shift)

    let half_ulp = power.high >> (extra_shift + 1 - shift)
    let round_up = false
    let round_down = false
    if regular {
        half_ulp += 1 - (mantissa & 1)
        round_up = fractional + half_ulp < fractional
        round_down = half_ulp > fractional
    } else {
        round_up = half_ulp > 0xffffffffffffffff - fractional
        round_down = (half_ulp >> 1) > fractional
    }
    integral += round_up ? 1 : 0

    let digit = zmij_mul_add_high(fractional, 10, 0x8000000000000005).to(u8)
    if !regular {
        let lower = zmij_mul_add_high(fractional - (half_ulp >> 1), 10, 0xffffffffffffffff).to(u8)
        if digit < lower : digit = lower
    } else if fractional == (1.to(u64) << 62) {
        digit = 2
    }
    return .{
        significand: integral
        exponent: decimal_exponent
        last_digit: digit
        has_last_digit: !round_up && !round_down
    }
}

fn zmij_decimal(mantissa: u64, raw_exponent: int) ZmijDecimal {
    let candidate = zmij_candidate(
        raw_exponent == 0 ? mantissa : mantissa | (1.to(u64) << 52),
        raw_exponent == 0 ? 1 : raw_exponent,
        raw_exponent == 0 || mantissa != 0
    )

    if raw_exponent == 0 {
        let combined = candidate.significand * 10
            + (candidate.has_last_digit ? candidate.last_digit.to(u64) : 0)
        while combined < 1000000000000000 {
            combined *= 10
            candidate.exponent--
        }
        let quotient = combined / 10
        candidate.last_digit = (combined - quotient * 10).to(u8)
        candidate.significand = quotient
        candidate.has_last_digit = candidate.last_digit != 0
    }

    let extra_digit = candidate.significand >= 1000000000000000
    let display_exponent = candidate.exponent + 15 + (extra_digit ? 1 : 0)
    let output = candidate.significand
    if candidate.has_last_digit : output = output * 10 + candidate.last_digit
    while output > 0 && output % 10 == 0 : output /= 10
    return .{ mantissa: output, exponent: display_exponent }
}

fn format_float_zmij(value: f64, buf: ptr) uint {
    let bits = @ptrv(&value, u64)
    let negative = (bits >> 63) != 0
    let mantissa = bits & ((1.to(u64) << 52) - 1)
    let exponent = ((bits >> 52) & 0x7ff).to(int)
    let decimal = zmij_decimal(mantissa, exponent)

    let reversed: [u8 x 24] = @undefined
    let count: uint = 0
    let digits = decimal.mantissa
    while digits > 0 {
        reversed[count++] = (digits % 10).to(u8)
        digits /= 10
    }
    let ordered: [u8 x 32] = @undefined
    let i: uint = 0
    while i < count : ordered[i] = reversed[count - i++ - 1]
    return float_format_write_digits(buf, negative, &ordered, count, decimal.exponent)
}

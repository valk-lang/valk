
use ansi

class TestResults {
    entries: Array[TestEntry] (.{})
    asserts_total: uint (0)
    asserts_passed: uint (0)
    // Tests in the binary, and `--filter <text>` from the command line
    test_total: uint (0)
    filter: ?String (null)
    filter_read: bool (false)

    // Whether the test named `name` runs: its name contains the `--filter` text, ignoring case
    fn select(name: String) bool {
        this.test_total++
        if !this.filter_read {
            this.filter_read = true
            let args = cli_args
            each args as arg, i {
                if arg == "--filter" : this.filter = args.get(i + 1) !? ""
            }
        }
        let filter = this.filter ?! return true
        return name.lower().contains(filter.lower())
    }

    // Stops the run when the filter matches no test
    fn check_selection(started: uint) {
        let filter = this.filter ?! return
        if started > 0 : return
        println("No test name contains '" + filter + "' (--filter matches case-insensitively)")
        exit(1)
    }

    fn submit_entry(entry: TestEntry) {
        let passed = entry.assert_count == entry.assert_passed
        entry.passed = passed
        this.entries.append(entry)
        let running = tests_running
        if isset(running) {
            let index = running.index_of(entry) !? running.length
            if index < running.length : running.swap_remove(index)
        }

        print(SELF.format_row(entry.name, passed, ansi.supported() && ansi.utf8_supported()))

        each entry.failures as msg {
            println(msg)
        }
    }

    static fn format_row(name: String, passed: bool, use_ansi: bool) String {
        let row = "> " + name + " "
        let width = row.utf8.length
        if width > 64 {
            row = row.utf8.range(0, 64)
            width = 64
        }
        while width < 64 {
            let even = width % 2 == 0
            row += even ? " " : "."
            width++
        }
        row += " "
        if use_ansi {
            row += passed ? "✅" : "❌"
        } else {
            row += passed ? "OK" : "FAIL"
        }
        row += "\n"
        return row
    }

    fn finalize() {
        this.asserts_total = 0
        this.asserts_passed = 0
        each this.entries as entry {
            this.asserts_total += entry.assert_count
            this.asserts_passed += entry.assert_passed
        }
    }

    fn passed() bool {
        each this.entries as entry {
            if !entry.passed : return false
        }
        return true
    }

    fn print() {
        this.finalize()
        let failed = Array[TestEntry]{}
        each this.entries as entry {
            if !entry.passed : failed.append(entry)
        }

        println("--------- TEST RESULTS ---------")
        let tests = "Tests: " + this.entries.length
        let filter = this.filter
        if isset(filter) : tests += " of " + this.test_total + " (--filter '" + filter + "')"
        if failed.length > 0 : tests += ", " + failed.length + " failed"
        println(tests)
        println("Asserts: " + this.asserts_total)
        println("Passed: " + this.asserts_passed)
        println("Failed: " + (this.asserts_total - this.asserts_passed))
        if failed.length > 0 {
            println("Failed tests:")
            each failed as entry : println("  " + entry.name + " @ " + entry.file + ":" + entry.line)
        }
        println("--------------------------------")
    }
}

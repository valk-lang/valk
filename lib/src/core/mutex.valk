@unsafe

use coro

// Bits of Mutex.state
value MUTEX_HELD (1)
// Waiters are queued; `unlock` then wakes the first of them
value MUTEX_QUEUED (2)

/// A mutual-exclusion lock whose waiters yield to other coroutines instead of blocking the thread.
///
/// Outside a coroutine, waiting blocks the thread. The mutex is not reentrant and has no
/// owner: any coroutine or thread may `unlock` it. It works across threads. Locking and
/// unlocking without contention are single atomic operations; `unlock` wakes the longest
/// waiting waiter, which takes the mutex unless another locker was quicker.
+ class Mutex {
    - state: uint (0)
    - guard: uint (0)
    // Waiting coro.Park entries, first to last
    - first: ?ptr (null)
    - last: ?ptr (null)

    /// Creates an unlocked mutex.
    ///
    /// Never fails since the mutex holds no operating system resource; the error type is kept
    /// for existing callers.
    + static fn new() SELF !InitError {
        return SELF {}
    }

    /// Returns this same mutex, so clones of an object that holds it share it (`$clone`).
    + fn clone() SELF $clone {
        return this
    }

    /// Waits until the mutex is unlocked, without keeping it locked.
    + fn await_unlock() @threadsafe {
        this.lock()
        this.unlock()
    }

    /// Takes the mutex, waiting while it is locked.
    ///
    /// Inside a coroutine the wait yields to other coroutines on the thread; outside one it
    /// blocks the thread. Locking it again from the same coroutine before `unlock` deadlocks.
    + fn lock() @threadsafe {
        if (atomic(this.state | MUTEX_HELD) & MUTEX_HELD) == 0 : return
        this.lock_slow()
    }

    fn lock_slow() @threadsafe {
        // Held briefly by another thread most of the time: try a little before parking
        let spins: uint = 0
        while spins < 100 {
            spins++
            if (atomic_load(this.state) & MUTEX_HELD) != 0 : continue
            if (atomic(this.state | MUTEX_HELD) & MUTEX_HELD) == 0 : return
        }
        let woken = false
        while true {
            let p = coro.park_new()
            coro.spin_acquire(@ref(this.guard))
            // Marked queued first, so an `unlock` from here on takes the slow path and finds us
            let before = atomic(this.state | (MUTEX_HELD | MUTEX_QUEUED))
            if (before & MUTEX_HELD) == 0 {
                if !isset(this.first) : atomic(this.state & MUTEX_HELD)
                coro.spin_release(@ref(this.guard))
                coro.park_discard(p)
                return
            }
            // A waiter that was woken and lost the race keeps its place in front
            if woken : this.push_front(p)
            else : this.push_back(p)
            coro.spin_release(@ref(this.guard))
            coro.park_wait(p, 0)
            coro.park_release(p)
            woken = true
            if (atomic(this.state | MUTEX_HELD) & MUTEX_HELD) == 0 : return
        }
    }

    fn push_back(p: *coro.Park) @threadsafe {
        p.next = null
        let last = this.last
        if isset(last) {
            let previous = last.@cast(*coro.Park)
            previous.next = p.@cast(ptr)
        } else {
            this.first = p.@cast(ptr)
        }
        this.last = p.@cast(ptr)
    }

    fn push_front(p: *coro.Park) @threadsafe {
        p.next = this.first
        this.first = p.@cast(ptr)
        if !isset(this.last) : this.last = p.@cast(ptr)
    }

    /// Releases the mutex and wakes the longest waiting waiter.
    ///
    /// Does nothing when the mutex is not locked.
    + fn unlock() @threadsafe {
        let before = atomic(this.state & MUTEX_QUEUED)
        if (before & MUTEX_HELD) == 0 : return
        if (before & MUTEX_QUEUED) == 0 : return
        this.wake_next()
    }

    fn wake_next() @threadsafe {
        while true {
            coro.spin_acquire(@ref(this.guard))
            let next = this.first
            if !isset(next) {
                atomic(this.state & MUTEX_HELD)
                coro.spin_release(@ref(this.guard))
                return
            }
            let p = next.@cast(*coro.Park)
            this.first = p.next
            if !isset(this.first) {
                this.last = null
                atomic(this.state & MUTEX_HELD)
            }
            coro.spin_release(@ref(this.guard))
            // A waiter whose thread ended cannot take it; wake the next one
            if coro.wake_park(p) : return
        }
    }

    fn gc_free() {
        // Only waiters of threads that ended can be left
        let p = this.first
        while isset(p) {
            let park = p.@cast(*coro.Park)
            p = park.next
            coro.park_release(park)
        }
    }
}

/// A pointer to zero-terminated bytes with no stored length, as used by C APIs.
///
/// `$global` makes the name available in every namespace without a prefix.
+ unbound cstring of u8 $global {
    /// Returns the byte at `index`, or 0 at or past the zero terminator; backs `s[i]`.
    ///
    /// Each call scans from the start for the terminator, so it never reads out of bounds, and
    /// reading index `i` costs O(i).
    + fn get(index: uint) u8 $offset {
        let i: uint = 0
        while i < index {
            if @ptrv(this, u8, i) == 0 : return 0
            i++
        }
        return @ptrv(this, u8, index)
    }
    /// Returns the index of the first `find` byte before the zero terminator.
    ///
    /// Throws `LookupError` when it does not occur; searching for 0 returns the length. Every
    /// byte is read through `get`, which rescans from the start, so the cost is quadratic in
    /// the length.
    + fn index_of(find: u8) uint !LookupError {
        @unsafe
        let i: uint = 0
        while true {
            let ch = this[i++]
            if ch == find : return i - 1
            if ch == 0 : break
        }
        throw .missing
    }

    /// Returns the number of bytes before the zero terminator.
    ///
    /// Every byte is read through `get`, which rescans from the start, so the cost is quadratic
    /// in the length.
    + fn length() uint {
        @unsafe
        let i: uint = 0
        while this[i] != 0 {
            i++
        }
        return i
    }

    /// Returns a new `String` holding a copy of the bytes before the zero terminator.
    ///
    /// `$auto` lets a `cstring` convert to `String` implicitly where one is expected. The copy
    /// goes through `length`, so it has the same quadratic cost.
    + fn to_string() String $auto {
        @unsafe
        return String.copy_from_ptr(this, this.length())
    }
}

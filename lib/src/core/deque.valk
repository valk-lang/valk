// Items live in two arrays, the front one reversed; a pop from an empty side
// moves half of the other side over
/// A double-ended queue: pushes and pops at both ends in amortized constant time.
///
/// Items are indexed from the front, and `each` visits them from front to back.
+ class Deque[T] $global {
    - front: Array[T] (.{})
    - back: Array[T] (.{})

    /// Creates an empty deque with room for `capacity` items pushed at the back.
    ///
    /// Marked `$default`: it also provides `Deque[T].$default_value`.
    + static fn new(capacity: uint (0)) SELF $default {
        return SELF { back: Array[T].new(capacity) }
    }

    /// The number of items.
    + get length: uint {
        return this.front.length + this.back.length
    }

    /// Returns true when the deque holds no items.
    + fn is_empty() bool {
        return this.front.length == 0 && this.back.length == 0
    }

    /// Adds `item` at the back.
    ///
    /// Backs the `Deque[T]{ a, b }` list literal (`$append`), which pushes each item at the back.
    + fn push_back(item: T) $append {
        this.back.append(item)
    }

    /// Adds `item` at the front.
    + fn push_front(item: T) {
        this.front.append(item)
    }

    /// Removes and returns the item at the front.
    ///
    /// Throws `missing` when the deque is empty.
    + fn pop_front() T !LookupError {
        if this.front.length == 0 : this.rebalance_to_front()
        return this.front.pop_last() !>
    }

    /// Removes and returns the item at the back.
    ///
    /// Throws `missing` when the deque is empty.
    + fn pop_back() T !LookupError {
        if this.back.length == 0 : this.rebalance_to_back()
        return this.back.pop_last() !>
    }

    /// Returns the item at the front without removing it.
    ///
    /// Throws `missing` when the deque is empty.
    + fn peek_front() T !LookupError {
        if this.front.length > 0 : return this.front.get(this.front.length - 1) !>
        return this.back.get(0) !>
    }

    /// Returns the item at the back without removing it.
    ///
    /// Throws `missing` when the deque is empty.
    + fn peek_back() T !LookupError {
        if this.back.length > 0 : return this.back.get(this.back.length - 1) !>
        return this.front.get(0) !>
    }

    /// Returns the item `index` places from the front; backs `deque[index]` (`$offset`).
    ///
    /// Throws `missing` when `index` is out of range.
    + fn get(index: uint) T !LookupError $offset {
        let front_length = this.front.length
        if index < front_length : return this.front.get(front_length - 1 - index) !>
        return this.back.get(index - front_length) !>
    }

    /// Replaces the item `index` places from the front; backs `deque[index] = value`
    /// (`$offset_assign`).
    ///
    /// Throws `missing` when `index` is out of range; unlike `Array.set`, it never appends.
    + fn set(index: uint, value: T) !LookupError $offset_assign {
        let front_length = this.front.length
        if index < front_length {
            this.front.set(front_length - 1 - index, value) !>
            return
        }
        if index - front_length >= this.back.length : throw .missing
        this.back.set(index - front_length, value) !>
    }

    /// Returns true when an item equals `value` (compared with `==`), in linear time.
    + fn contains(value: T) bool {
        return this.front.contains(value) || this.back.contains(value)
    }

    /// Removes every item.
    + fn clear() {
        this.front.clear()
        this.back.clear()
    }

    /// Returns a new array with the items from front to back.
    + fn to_array() Array[T] {
        let result = Array[T].new(this.length)
        let i = this.front.length
        while i > 0 {
            i--
            result.append(this.front.get(i) ! break)
        }
        each this.back into item : result.append(item)
        return result
    }

    /// Returns a shallow copy: a new deque holding the same items.
    + fn copy() SELF {
        return SELF { front: this.front.copy(), back: this.back.copy() }
    }

    /// Returns a deep copy in which every item is cloned as well (`$clone`).
    + fn clone() SELF $clone {
        return SELF { front: this.front.clone(), back: this.back.clone() }
    }

    // Moves the first half of `back` into `front` (reversed)
    - fn rebalance_to_front() {
        let count = this.back.length
        if count == 0 : return
        let move = (count + 1) / 2
        let rest = Array[T].new(count - move)
        let i = move
        while i > 0 {
            i--
            this.front.append(this.back.get(i) ! break)
        }
        i = move
        while i < count {
            rest.append(this.back.get(i) ! break)
            i++
        }
        this.back = rest
    }

    // Moves the deque's last items out of `front` into `back`, where they keep
    // their order; `front` keeps the first items, still reversed
    - fn rebalance_to_back() {
        let count = this.front.length
        if count == 0 : return
        let move = (count + 1) / 2
        let rest = Array[T].new(count - move)
        let i = move
        while i < count {
            rest.append(this.front.get(i) ! break)
            i++
        }
        i = move
        while i > 0 {
            i--
            this.back.append(this.front.get(i) ! break)
        }
        this.front = rest
    }

    fn _next(index: uint) (T, uint) !IterError {
        let item = this.get(index) ! throw .end
        return (item, index)
    }
}

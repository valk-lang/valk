use mem
use gc

// Items live in a ring over the storage of `items`, whose length is the capacity: `head` is
// the slot of the first item and the capacity a power of two, so item `i` sits in slot
// `(head + i) & (capacity - 1)`. Unused slots are zero
/// A double-ended queue: pushes and pops at both ends in constant time.
///
/// Items are indexed from the front, and `each` visits them from front to back.
+ class Deque[T] $global {
    - items: Array[T] (.{})
    - capacity: uint (0)
    - head: uint (0)
    - count: uint (0)

    /// Creates an empty deque with room for `capacity` items.
    ///
    /// Marked `$default`: it also provides `Deque[T].$default_value`.
    + static fn new(capacity: uint (0)) SELF $default {
        let deque = SELF {}
        if capacity > 0 : deque.grow(capacity)
        return deque
    }

    /// The number of items.
    + get length: uint {
        return this.count
    }

    /// Returns true when the deque holds no items.
    + fn is_empty() bool {
        return this.count == 0
    }

    /// Adds `item` at the back.
    ///
    /// Backs the `Deque[T]{ a, b }` list literal (`$append`), which pushes each item at the back.
    + fn push_back(item: T) $append $inline {
        @unsafe
        if this.count == this.capacity : this.grow(this.count + 1)
        let at = (this.head + this.count) & (this.capacity - 1)
        @property_init(this.items.data, @ptrv(this.items.items(), T, at), item)
        this.count++
    }

    /// Adds `item` at the front.
    + fn push_front(item: T) $inline {
        @unsafe
        if this.count == this.capacity : this.grow(this.count + 1)
        let at = (this.head + this.capacity - 1) & (this.capacity - 1)
        @property_init(this.items.data, @ptrv(this.items.items(), T, at), item)
        this.head = at
        this.count++
    }

    /// Removes and returns the item at the front.
    ///
    /// Throws `missing` when the deque is empty.
    + fn pop_front() T !LookupError $inline {
        @unsafe
        if this.count == 0 : throw .missing
        let at = this.head
        let item = @property_get(@ptrv(this.items.items(), T, at))
        this.release(at)
        this.head = (at + 1) & (this.capacity - 1)
        this.count--
        return item
    }

    /// Removes and returns the item at the back.
    ///
    /// Throws `missing` when the deque is empty.
    + fn pop_back() T !LookupError $inline {
        @unsafe
        if this.count == 0 : throw .missing
        let at = (this.head + this.count - 1) & (this.capacity - 1)
        let item = @property_get(@ptrv(this.items.items(), T, at))
        this.release(at)
        this.count--
        return item
    }

    /// Returns the item at the front without removing it.
    ///
    /// Throws `missing` when the deque is empty.
    + fn peek_front() T !LookupError {
        return this.get(0) !>
    }

    /// Returns the item at the back without removing it.
    ///
    /// Throws `missing` when the deque is empty.
    + fn peek_back() T !LookupError {
        if this.count == 0 : throw .missing
        return this.get(this.count - 1) !>
    }

    /// Returns the item `index` places from the front; backs `deque[index]` (`$offset`).
    ///
    /// Throws `missing` when `index` is out of range.
    + fn get(index: uint) T !LookupError $offset {
        @unsafe
        if index >= this.count : throw .missing
        return @property_get(@ptrv(this.items.items(), T, (this.head + index) & (this.capacity - 1)))
    }

    /// Replaces the item `index` places from the front; backs `deque[index] = value`
    /// (`$offset_assign`).
    ///
    /// Throws `missing` when `index` is out of range; unlike `Array.set`, it never appends.
    + fn set(index: uint, value: T) !LookupError $offset_assign {
        @unsafe
        if index >= this.count : throw .missing
        let slot = this.items.items().@offset(((this.head + index) & (this.capacity - 1)) * size_of(T))
        @property_update(this.items.data, @ptrv(slot, T), value)
    }

    /// Returns true when an item equals `value` (compared with `==`), in linear time.
    + fn contains(value: T) bool {
        let i: uint = 0
        while i < this.count {
            if (this.get(i) ! break) == value : return true
            i++
        }
        return false
    }

    /// Removes every item; the storage is kept.
    + fn clear() {
        @unsafe
        #if T.$has_gc_refs
        let i: uint = 0
        while i < this.count {
            this.release((this.head + i) & (this.capacity - 1))
            i++
        }
        #end
        this.head = 0
        this.count = 0
    }

    /// Returns a new array with the items from front to back.
    + fn to_array() Array[T] {
        let result = Array[T].new(this.count)
        let i: uint = 0
        while i < this.count {
            result.append(this.get(i) ! break)
            i++
        }
        return result
    }

    /// Returns a shallow copy: a new deque holding the same items.
    + fn copy() SELF {
        let copy = SELF.new(this.count)
        let i: uint = 0
        while i < this.count {
            copy.push_back(this.get(i) ! break)
            i++
        }
        return copy
    }

    /// Returns a deep copy in which every item is cloned as well.
    + fn clone() SELF {
        let copy = SELF.new(this.count)
        let i: uint = 0
        while i < this.count {
            let item = this.get(i) ! break
            copy.push_back(clone item)
            i++
        }
        return copy
    }

    // Storage for at least `minimum` items, the current ones in order. The array's length
    // equals the capacity, so it is copied whole when it grows or when the deque is published
    - fn grow(minimum: uint) {
        @unsafe
        let capacity = this.capacity
        let size: uint = capacity == 0 ? 8 : capacity
        while size < minimum {
            let next = size * 2
            if next <= size : panic("Deque capacity is too large")
            size = next
        }
        if size == capacity : return
        this.items.increase_size(size)
        this.items.fill_to_capacity()
        let end = this.head + this.count
        if end > capacity {
            // The items that wrapped past the old end move to the slots after it, so the
            // ring reads in order again
            let wrapped = end - capacity
            #if GROVE && T.$has_gc_refs
            // Into the growth's zero tail: nothing is overwritten, the moved slots become zero
            let block = this.items.data
            if isset(block) : gc.gc_move(block.@cast(ptr), capacity, 0, wrapped)
            #else
            let data = this.items.items().@cast(ptr)
            mem.copy_bytes(data, data + capacity * size_of(T), wrapped * size_of(T))
            #if T.$has_gc_refs
            let block = this.items.data
            if isset(block) : gc.moved_elements(block.@cast(ptr), capacity, wrapped)
            #end
            mem.clear_bytes(data, wrapped * size_of(T))
            #end
        }
        this.capacity = size
    }

    // Clears the slot of an item that left the deque, so the block keeps nothing dead
    - fn release(at: uint) $inline {
        @unsafe
        #if T.$has_gc_refs
        @property_clear(this.items.data, @ptrv(this.items.items(), T, at))
        mem.clear_bytes(this.items.items().@cast(ptr) + at * size_of(T), size_of(T))
        #end
    }

    fn _next(index: uint) (T, uint) !IterError {
        let item = this.get(index) ! throw .end
        return (item, index)
    }
}

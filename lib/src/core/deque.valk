// A double-ended queue: pushes and pops at both ends in amortized constant
// time, and indexed access from the front. Items live in two arrays, the
// front one reversed; a pop from an empty side moves half of the other side
// over
+ class Deque[T] $global {
    - front: Array[T] (.{})
    - back: Array[T] (.{})

    + static fn new(capacity: uint (0)) SELF $default {
        return SELF { back: Array[T].new(capacity) }
    }

    + get length: uint {
        return this.front.length + this.back.length
    }

    + fn is_empty() bool {
        return this.front.length == 0 && this.back.length == 0
    }

    + fn push_back(item: T) $append {
        this.back.append(item)
    }

    + fn push_front(item: T) {
        this.front.append(item)
    }

    + fn pop_front() T !LookupError {
        if this.front.length == 0 : this.rebalance_to_front()
        return this.front.pop_last() !>
    }

    + fn pop_back() T !LookupError {
        if this.back.length == 0 : this.rebalance_to_back()
        return this.back.pop_last() !>
    }

    + fn peek_front() T !LookupError {
        if this.front.length > 0 : return this.front.get(this.front.length - 1) !>
        return this.back.get(0) !>
    }

    + fn peek_back() T !LookupError {
        if this.back.length > 0 : return this.back.get(this.back.length - 1) !>
        return this.front.get(0) !>
    }

    // The item `index` places from the front
    + fn get(index: uint) T !LookupError $offset {
        let front_length = this.front.length
        if index < front_length : return this.front.get(front_length - 1 - index) !>
        return this.back.get(index - front_length) !>
    }

    // Replaces the item `index` places from the front; like an array, an
    // `deque[index] = value`; throws `missing` when the index is out of range
    + fn set(index: uint, value: T) !LookupError $offset_assign {
        let front_length = this.front.length
        if index < front_length {
            this.front.set(front_length - 1 - index, value) !>
            return
        }
        if index - front_length >= this.back.length : throw .missing
        this.back.set(index - front_length, value) !>
    }

    + fn contains(value: T) bool {
        return this.front.contains(value) || this.back.contains(value)
    }

    + fn clear() {
        this.front.clear()
        this.back.clear()
    }

    // The items from front to back
    + fn to_array() Array[T] {
        let result = Array[T].new(this.length)
        let i = this.front.length
        while i > 0 {
            i--
            result.append(this.front.get(i) ! break)
        }
        each this.back into item : result.append(item)
        return result
    }

    + fn copy() SELF {
        return SELF { front: this.front.copy(), back: this.back.copy() }
    }

    // Deep copy: every item is cloned as well
    + fn clone() SELF $clone {
        return SELF { front: this.front.clone(), back: this.back.clone() }
    }

    // Moves the first half of `back` into `front` (reversed)
    - fn rebalance_to_front() {
        let count = this.back.length
        if count == 0 : return
        let move = (count + 1) / 2
        let rest = Array[T].new(count - move)
        let i = move
        while i > 0 {
            i--
            this.front.append(this.back.get(i) ! break)
        }
        i = move
        while i < count {
            rest.append(this.back.get(i) ! break)
            i++
        }
        this.back = rest
    }

    // Moves the last half of `front` (the deque's first items) into `back`
    - fn rebalance_to_back() {
        let count = this.front.length
        if count == 0 : return
        let move = (count + 1) / 2
        let keep = count - move
        let rest = Array[T].new(keep)
        let i: uint = 0
        while i < keep {
            rest.append(this.front.get(i) ! break)
            i++
        }
        i = count
        while i > keep {
            i--
            this.back.append(this.front.get(i) ! break)
        }
        this.front = rest
    }

    fn _next(index: uint) (T, uint) !IterError {
        let item = this.get(index) ! throw .end
        return (item, index)
    }
}

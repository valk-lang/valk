use ext
use mem

struct MutexStruct[T] {
    #if OS == "win"
    - mutex: ext.HANDLE
    #else
    - mutex: ptr
    #end

    #if T.$is_void

    static fn new() *SELF {
        @unsafe
        #if OS == "win"
        let mut = ext.CreateMutexA(null, 0, null)
        if mut == 0 : panic("Failed to create mutex")
        #else
        let mut = mem.calloc(64)
        if ext.pthread_mutex_init(mut, null) != 0 : panic("Failed to initialize mutex")
        #end
        let value = mem.new[SELF](.{ mutex: mut })
        return value
    }

    fn lock() void {
        #if OS == "win"
        let wait_result = ext.WaitForSingleObject(this.mutex, ext.INFINITE)
        if wait_result != 0 : panic("Failed to lock native mutex (wait result " + wait_result + ", error " + ext.GetLastError() + ")")
        #else
        let error = ext.pthread_mutex_lock(this.mutex)
        if error != 0 : panic("Failed to lock native mutex (error " + error + ")")
        #end
    }

    fn unlock() void {
        #if OS == "win"
        if ext.ReleaseMutex(this.mutex) == 0 : panic("Failed to unlock native mutex (error " + ext.GetLastError() + ")")
        #else
        let error = ext.pthread_mutex_unlock(this.mutex)
        if error != 0 : panic("Failed to unlock native mutex (error " + error + ")")
        #end
    }

    #else
    - value: T

    static fn new(value: T) *SELF {
        @unsafe
        #if OS == "win"
        let mut = ext.CreateMutexA(null, 0, null)
        if mut == 0 : panic("Failed to create mutex")
        #else
        // Room for the native mutex; 64 covers every target's pthread_mutex_t
        let mut = mem.calloc(64)
        if ext.pthread_mutex_init(mut, null) != 0 : panic("Failed to initialize mutex")
        #end
        let result = mem.new[SELF](.{ mutex: mut, value: value })
        return result
    }

    fn lock() T {
        @unsafe
        #if OS == "win"
        if ext.WaitForSingleObject(this.mutex, ext.INFINITE) != 0 : panic("Failed to lock mutex")
        #else
        if ext.pthread_mutex_lock(this.mutex) != 0 : panic("Failed to lock mutex")
        #end
        // Hands the value out and leaves the default behind, so the mutex holds
        // nothing while it is unlocked; `unlock` stores the value back
        let result = this.value
        this.value = T.$default_value
        return result
    }

    fn unlock(value: T) void {
        @unsafe
        this.value = value
        #if OS == "win"
        if ext.ReleaseMutex(this.mutex) == 0 : panic("Failed to unlock mutex")
        #else
        if ext.pthread_mutex_unlock(this.mutex) != 0 : panic("Failed to unlock mutex")
        #end
    }

    #end

    fn free() void {
        @unsafe
        #if OS == "win"
        if ext.CloseHandle(this.mutex) == 0 {
            cleanup_warning("Failed to close mutex", __FILE__, __LINE__)
        }
        #else
        @unsafe
        if ext.pthread_mutex_destroy(this.mutex) != 0 {
            cleanup_warning("Failed to destroy mutex", __FILE__, __LINE__)
        } else {
            mem.free(this.mutex)
        }
        #end
        mem.free(this)
    }
}

#if TEST
/// Test hook: locks and unlocks a value-carrying `MutexStruct` and returns the value
/// after one locked round trip.
+ fn mutex_struct_value_for_test(value: int) int {
    let mutex = MutexStruct[int].new(value)
    let held = mutex.lock()
    mutex.unlock(held + 1)
    let again = mutex.lock()
    mutex.unlock(again)
    mutex.free()
    return again
}
#end

use ext
use mem

struct MutexStruct[T] {
    #if OS == "win"
    - srw: uint (0)
    #else
    // Room for the native mutex; 64 covers every target's pthread_mutex_t
    - mutex: [u64 x 8] ({ 0 ... })
    #end

    #if T.$is_void

    static fn new() *SELF {
        #if OS == "win"
        let value = mem.new[SELF](.{ srw: 0 })
        return value
        #else
        @unsafe
        let value = mem.new[SELF]()
        if ext.pthread_mutex_init(@ref(value.mutex).@cast(ptr), null) != 0 : panic("Failed to initialize mutex")
        return value
        #end
    }

    fn lock() void {
        #if OS == "win"
        ext.AcquireSRWLockExclusive(@ref(this.srw))
        #else
        @unsafe
        let error = ext.pthread_mutex_lock(@ref(this.mutex).@cast(ptr))
        if error != 0 : panic("Failed to lock native mutex (error " + error + ")")
        #end
    }

    // Takes the lock only when it is free
    fn try_lock() bool {
        #if OS == "win"
        return ext.TryAcquireSRWLockExclusive(@ref(this.srw)) != 0
        #else
        @unsafe
        return ext.pthread_mutex_trylock(@ref(this.mutex).@cast(ptr)) == 0
        #end
    }

    fn unlock() void {
        #if OS == "win"
        ext.ReleaseSRWLockExclusive(@ref(this.srw))
        #else
        @unsafe
        let error = ext.pthread_mutex_unlock(@ref(this.mutex).@cast(ptr))
        if error != 0 : panic("Failed to unlock native mutex (error " + error + ")")
        #end
    }

    #else
    - value: T

    static fn new(value: T) *SELF {
        #if OS == "win"
        let result = mem.new[SELF](.{ srw: 0, value: value })
        return result
        #else
        @unsafe
        let result = mem.new[SELF](.{ value: value })
        if ext.pthread_mutex_init(@ref(result.mutex).@cast(ptr), null) != 0 : panic("Failed to initialize mutex")
        return result
        #end
    }

    fn lock() T {
        #if OS == "win"
        ext.AcquireSRWLockExclusive(@ref(this.srw))
        #else
        @unsafe
        if ext.pthread_mutex_lock(@ref(this.mutex).@cast(ptr)) != 0 : panic("Failed to lock mutex")
        #end
        // Hands the value out and leaves the default behind, so the mutex holds
        // nothing while it is unlocked; `unlock` stores the value back
        let result = this.value
        this.value = T.$default_value
        return result
    }

    fn unlock(value: T) void {
        this.value = value
        #if OS == "win"
        ext.ReleaseSRWLockExclusive(@ref(this.srw))
        #else
        @unsafe
        if ext.pthread_mutex_unlock(@ref(this.mutex).@cast(ptr)) != 0 : panic("Failed to unlock mutex")
        #end
    }

    #end

    fn free() void {
        @unsafe
        #if OS != "win"
        if ext.pthread_mutex_destroy(@ref(this.mutex).@cast(ptr)) != 0 {
            cleanup_warning("Failed to destroy mutex", __FILE__, __LINE__)
        }
        #end
        mem.free(this)
    }
}

#if TEST
/// Test hook: locks and unlocks a value-carrying `MutexStruct` and returns the value
/// after one locked round trip.
+ fn mutex_struct_value_for_test(value: int) int {
    let mutex = MutexStruct[int].new(value)
    let held = mutex.lock()
    mutex.unlock(held + 1)
    let again = mutex.lock()
    mutex.unlock(again)
    mutex.free()
    return again
}
#end

// Format specifiers for string interpolation (`%{expr:spec}`) and runtime formatting.
//
// Packed `flags` layout (shared with the compiler):
//   bits  0..1: align (0=default, 1=left '<', 2=right '>', 3=center '^')
//   bits  2..3: sign  (0=default, 1=plus '+', 2=space ' ', 3=minus '-')
//   bit      4: alt   ('#' prefix: 0x / 0X / 0b / 0o)
//   bit      5: zero  ('0' sign/prefix-aware zero padding)
//   bits 8..15: kind  (0, 'd', 'x', 'X', 'b', 'o', 'f', 'e', 'E', 's')
//   bit     16: has_prec ('.precision' present)

value FMT_ALIGN_MASK (0x03.to(u32))
value FMT_ALIGN_LEFT (1.to(u32))
value FMT_ALIGN_RIGHT (2.to(u32))
value FMT_ALIGN_CENTER (3.to(u32))
value FMT_SIGN_SHIFT (2.to(u32))
value FMT_SIGN_MASK (0x03.to(u32))
value FMT_SIGN_PLUS (1.to(u32))
value FMT_SIGN_SPACE (2.to(u32))
value FMT_FLAG_ALT (0x10.to(u32))
value FMT_FLAG_ZERO (0x20.to(u32))
value FMT_FLAG_HAS_PREC (0x10000.to(u32))

struct ParsedFmtSpec {
    flags: u32 (0)
    width: uint (0)
    precision: uint (0)
    fill: u8 (' ')
}

fn fmt_align_code(ch: u8) u32 {
    if ch == '<' : return FMT_ALIGN_LEFT
    if ch == '>' : return FMT_ALIGN_RIGHT
    if ch == '^' : return FMT_ALIGN_CENTER
    return 0
}

fn fmt_parse_spec(spec: String) ParsedFmtSpec !SyntaxError {
    let len = spec.bytes
    let pos: uint = 0
    let fill: u8 = ' '
    let align: u32 = 0
    let sign: u32 = 0
    let alt: u32 = 0
    let zero: u32 = 0
    let width: uint = 0
    let has_prec: u32 = 0
    let prec: uint = 0
    let kind: u32 = 0

    // Optional [fill]align
    if pos + 1 < len && fmt_align_code(spec[pos + 1]) != 0 {
        let f = spec[pos]
        if f >= 128 : throw .syntax
        fill = f
        align = fmt_align_code(spec[pos + 1])
        pos += 2
    } else if pos < len && fmt_align_code(spec[pos]) != 0 {
        align = fmt_align_code(spec[pos])
        pos++
    }

    // Optional sign ('+', '-', ' ')
    if pos < len {
        let ch = spec[pos]
        if ch == '+' {
            sign = FMT_SIGN_PLUS
            pos++
        } else if ch == ' ' {
            sign = FMT_SIGN_SPACE
            pos++
        } else if ch == '-' {
            sign = 3
            pos++
        }
    }

    // Optional '#'
    if pos < len && spec[pos] == '#' {
        alt = FMT_FLAG_ALT
        pos++
    }

    // Optional '0' zero-pad flag
    if pos < len && spec[pos] == '0' {
        zero = FMT_FLAG_ZERO
        pos++
    }

    // Optional width
    while pos < len && spec[pos] >= '0' && spec[pos] <= '9' {
        width = width * 10 + (spec[pos] - '0').to(uint)
        if width > 1000000 : throw .syntax
        pos++
    }

    // Optional .precision
    if pos < len && spec[pos] == '.' {
        pos++
        if pos >= len || spec[pos] < '0' || spec[pos] > '9' : throw .syntax
        has_prec = FMT_FLAG_HAS_PREC
        while pos < len && spec[pos] >= '0' && spec[pos] <= '9' {
            prec = prec * 10 + (spec[pos] - '0').to(uint)
            if prec > 1000000 : throw .syntax
            pos++
        }
    }

    // Optional type code
    if pos < len {
        let ch = spec[pos]
        if ch == 'd' || ch == 'x' || ch == 'X' || ch == 'b' || ch == 'o' || ch == 'f' || ch == 'e' || ch == 'E' || ch == 's' {
            kind = ch.to(u32)
            pos++
        }
    }

    if pos != len : throw .syntax

    let flags = align | (sign << FMT_SIGN_SHIFT) | alt | zero | (kind << 8) | has_prec
    return ParsedFmtSpec { flags: flags, width: width, precision: prec, fill: fill }
}

fn fmt_write_repeat(out: ByteBuffer, ch: u8, count: uint) {
    let i: uint = 0
    while i < count {
        out.write_byte(ch)
        i++
    }
}

fn fmt_apply_padding(prefix: String, body: String, flags: u32, width: uint, fill: u8, default_align: u32, allow_zero_pad: bool) String {
    let content_len = prefix.bytes + body.bytes
    if content_len >= width {
        if prefix.bytes == 0 : return body
        let out = ByteBuffer.new(content_len)
        out.write(prefix)
        out.write(body)
        return out.into_string()
    }
    let pad = width - content_len
    let align = flags & FMT_ALIGN_MASK
    let zero_pad = (flags & FMT_FLAG_ZERO) != 0
    let out = ByteBuffer.new(width)
    if allow_zero_pad && zero_pad && align == 0 {
        out.write(prefix)
        fmt_write_repeat(out, '0', pad)
        out.write(body)
        return out.into_string()
    }
    let eff = align == 0 ? default_align : align
    if eff == FMT_ALIGN_LEFT {
        out.write(prefix)
        out.write(body)
        fmt_write_repeat(out, fill, pad)
    } else if eff == FMT_ALIGN_CENTER {
        let left_pad = pad >> 1
        let right_pad = pad - left_pad
        fmt_write_repeat(out, fill, left_pad)
        out.write(prefix)
        out.write(body)
        fmt_write_repeat(out, fill, right_pad)
    } else {
        fmt_write_repeat(out, fill, pad)
        out.write(prefix)
        out.write(body)
    }
    return out.into_string()
}

fn fmt_uint_digits(mag: uint, base: uint, upper: bool) String {
    let buf: [u8 x 64] = { 0... }
    let pos: uint = 64
    let v = mag
    if v == 0 {
        return "0"
    }
    let alpha_base: uint = upper ? ('A').to(uint) - 10 : ('a').to(uint) - 10
    while v > 0 {
        let d = v % base
        pos--
        buf[pos] = (d < 10 ? ('0').to(uint) + d : alpha_base + d).to(u8)
        v = v / base
    }
    let out = ByteBuffer.new(64 - pos)
    let i = pos
    while i < 64 {
        out.write_byte(buf[i])
        i++
    }
    return out.into_string()
}

fn fmt_int_common(negative: bool, mag: uint, flags: u32, width: uint, fill: u8) String {
    let kind = ((flags >> 8) & 0xff).to(u8)
    let alt = (flags & FMT_FLAG_ALT) != 0
    let sign_mode = (flags >> FMT_SIGN_SHIFT) & FMT_SIGN_MASK

    let base: uint = 10
    let upper = false
    let base_prefix = ""
    if kind == 'x' {
        base = 16
        if alt : base_prefix = "0x"
    } else if kind == 'X' {
        base = 16
        upper = true
        if alt : base_prefix = "0X"
    } else if kind == 'b' {
        base = 2
        if alt : base_prefix = "0b"
    } else if kind == 'o' {
        base = 8
        if alt : base_prefix = "0o"
    }

    let sign_str = ""
    if negative : sign_str = "-"
    else if sign_mode == FMT_SIGN_PLUS : sign_str = "+"
    else if sign_mode == FMT_SIGN_SPACE : sign_str = " "

    let prefix = sign_str.bytes > 0 && base_prefix.bytes > 0 ? sign_str + base_prefix : (sign_str.bytes > 0 ? sign_str : base_prefix)
    let digits = fmt_uint_digits(mag, base, upper)
    return fmt_apply_padding(prefix, digits, flags, width, fill, FMT_ALIGN_RIGHT, true)
}

// Compiler-called fast paths for `%{expr:spec}`
fn fmt_int(value: int, flags: u32, width: uint, fill: u8) String {
    let neg = value < 0
    let mag: uint = neg ? (0 - value.to(uint)) : value.to(uint)
    return fmt_int_common(neg, mag, flags, width, fill)
}

fn fmt_uint(value: uint, flags: u32, width: uint, fill: u8) String {
    return fmt_int_common(false, value, flags, width, fill)
}

fn fmt_float(value: f64, flags: u32, width: uint, precision: uint, fill: u8) String {
    let kind = ((flags >> 8) & 0xff).to(u8)
    let has_prec = (flags & FMT_FLAG_HAS_PREC) != 0
    let sign_mode = (flags >> FMT_SIGN_SHIFT) & FMT_SIGN_MASK

    let raw = ""
    if kind == 'f' {
        raw = value.to_string(has_prec ? precision : 6)
    } else if kind == 'e' {
        raw = value.to_scientific_string(has_prec ? precision : 6)
    } else if kind == 'E' {
        raw = value.to_scientific_string(has_prec ? precision : 6).upper()
    } else if has_prec {
        raw = value.to_string(precision)
    } else {
        raw = value.to_shortest_string()
    }

    let prefix = ""
    let body = raw
    if raw.bytes > 0 && raw[0] == '-' {
        prefix = "-"
        body = raw.range(1, raw.bytes - 1)
    } else if !value.is_nan() {
        if sign_mode == FMT_SIGN_PLUS : prefix = "+"
        else if sign_mode == FMT_SIGN_SPACE : prefix = " "
    }

    return fmt_apply_padding(prefix, body, flags, width, fill, FMT_ALIGN_RIGHT, value.is_finite())
}

fn fmt_string(value: String, flags: u32, width: uint, precision: uint, fill: u8) String {
    let has_prec = (flags & FMT_FLAG_HAS_PREC) != 0

    // Count UTF-8 characters and optionally truncate to `precision` characters
    let chars: uint = 0
    let cut_bytes = value.bytes
    let i: uint = 0
    let len = value.bytes
    while i < len {
        if has_prec && chars == precision {
            cut_bytes = i
            break
        }
        let b = value[i]
        let step: uint = 1
        if b >= 0xf0 : step = 4
        else if b >= 0xe0 : step = 3
        else if b >= 0xc0 : step = 2
        i = i + step > len ? len : i + step
        chars++
    }
    let text = cut_bytes < len ? value.range(0, cut_bytes) : value

    if chars >= width : return text
    let pad = width - chars
    let align = flags & FMT_ALIGN_MASK
    let eff = align == 0 ? FMT_ALIGN_LEFT : align
    let out = ByteBuffer.new(text.bytes + pad)
    if eff == FMT_ALIGN_RIGHT {
        fmt_write_repeat(out, fill, pad)
        out.write(text)
    } else if eff == FMT_ALIGN_CENTER {
        let left_pad = pad >> 1
        let right_pad = pad - left_pad
        fmt_write_repeat(out, fill, left_pad)
        out.write(text)
        fmt_write_repeat(out, fill, right_pad)
    } else {
        out.write(text)
        fmt_write_repeat(out, fill, pad)
    }
    return out.into_string()
}

/// Formats signed integer `value` using format specifier `spec` (e.g. `"05"`, `"#06x"`, `"+>8"`).
///
/// Throws `invalid` when `spec` is not a valid integer format specifier.
+ fn format_int(value: int, spec: String) String !SyntaxError {
    let p = fmt_parse_spec(spec) !>
    let kind = ((p.flags >> 8) & 0xff).to(u8)
    let has_prec = (p.flags & FMT_FLAG_HAS_PREC) != 0
    let alt = (p.flags & FMT_FLAG_ALT) != 0
    if has_prec : throw .syntax
    if kind != 0 && kind != 'd' && kind != 'x' && kind != 'X' && kind != 'b' && kind != 'o' : throw .syntax
    if alt && kind != 'x' && kind != 'X' && kind != 'b' && kind != 'o' : throw .syntax
    return fmt_int(value, p.flags, p.width, p.fill)
}

/// Formats unsigned integer `value` using format specifier `spec` (e.g. `"05"`, `"#08x"`, `"b"`).
///
/// Throws `invalid` when `spec` is not a valid integer format specifier.
+ fn format_uint(value: uint, spec: String) String !SyntaxError {
    let p = fmt_parse_spec(spec) !>
    let kind = ((p.flags >> 8) & 0xff).to(u8)
    let has_prec = (p.flags & FMT_FLAG_HAS_PREC) != 0
    let alt = (p.flags & FMT_FLAG_ALT) != 0
    if has_prec : throw .syntax
    if kind != 0 && kind != 'd' && kind != 'x' && kind != 'X' && kind != 'b' && kind != 'o' : throw .syntax
    if alt && kind != 'x' && kind != 'X' && kind != 'b' && kind != 'o' : throw .syntax
    return fmt_uint(value, p.flags, p.width, p.fill)
}

/// Formats floating-point `value` using format specifier `spec` (e.g. `".2f"`, `"08.2f"`, `".3e"`).
///
/// Throws `invalid` when `spec` is not a valid float format specifier.
+ fn format_float(value: f64, spec: String) String !SyntaxError {
    let p = fmt_parse_spec(spec) !>
    let kind = ((p.flags >> 8) & 0xff).to(u8)
    let alt = (p.flags & FMT_FLAG_ALT) != 0
    if alt : throw .syntax
    if kind != 0 && kind != 'f' && kind != 'e' && kind != 'E' : throw .syntax
    return fmt_float(value, p.flags, p.width, p.precision, p.fill)
}

/// Formats string `value` using format specifier `spec` (e.g. `">10"`, `"*^12"`, `".5"`).
///
/// Throws `invalid` when `spec` is not a valid string format specifier.
+ fn format_string(value: String, spec: String) String !SyntaxError {
    let p = fmt_parse_spec(spec) !>
    let kind = ((p.flags >> 8) & 0xff).to(u8)
    let sign = (p.flags >> FMT_SIGN_SHIFT) & FMT_SIGN_MASK
    let alt = (p.flags & FMT_FLAG_ALT) != 0
    let zero = (p.flags & FMT_FLAG_ZERO) != 0
    if sign != 0 || alt || zero : throw .syntax
    if kind != 0 && kind != 's' : throw .syntax
    return fmt_string(value, p.flags, p.width, p.precision, p.fill)
}

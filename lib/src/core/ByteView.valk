use mem

+ struct ByteView[T] $global {
    source: T
    offset: uint
    length: uint

    + static fn new(source: T, offset: uint, length: uint) SELF $inline {
        let source_length = source_byte_length[T](source)
        if offset > source_length {
            offset = 0
            length = 0
        } else if length > source_length - offset {
            length = source_length - offset
        }
        return SELF {
            source: source
            offset: offset
            length: length
        }
    }

    + get data: ptr $inline {
        @unsafe
        let source_length = source_byte_length[T](this.source)
        if this.offset > source_length : return this.source.data
        return this.source.data.@offset(this.offset)
    }

    + get bytes: uint $inline {
        return this.available_length()
    }

    + fn clear() $inline {
        this.length = 0
        this.offset = 0
    }

    + fn get(index: uint) u8 $offset $inline {
        @unsafe
        let length = this.available_length()
        if index >= length : return 0
        return @ptrv(this.source.data, u8, this.offset + index)
    }

    + fn has_ascii_control(allow_tab: bool (false)) bool $inline {
        @unsafe
        let length = this.available_length()
        let data = this.source.data.@offset(this.offset)
        let i: uint = 0
        let high: u64 = 0x8080808080808080
        let ones: u64 = 0x0101010101010101
        while length - i >= 8 {
            let word = @ptrv(data.@offset(i), u64)
            let low = (word - 0x2020202020202020) & ~word & high
            let del = word ^ 0x7f7f7f7f7f7f7f7f
            let has_del = (del - ones) & ~del & high
            if low != 0 || has_del != 0 {
                let end = i + 8
                while i < end {
                    let ch = @ptrv(data, u8, i++)
                    if (ch < 32 && (!allow_tab || ch != '\t')) || ch == 127 : return true
                }
            } else {
                i += 8
            }
        }
        while i < length {
            let ch = @ptrv(data, u8, i++)
            if (ch < 32 && (!allow_tab || ch != '\t')) || ch == 127 : return true
        }
        return false
    }

    + fn view(offset: uint, length: uint) SELF $range $inline {
        let available = this.available_length()
        if offset > available {
            offset = 0
            length = 0
        } else if length > available - offset {
            length = available - offset
        }
        return SELF {
            source: this.source
            offset: this.offset + offset
            length: length
        }
    }

    + fn to_string() String {
        @unsafe
        let length = this.available_length()
        if length == 0 : return ""
        return String.copy_from_ptr(this.source.data.@offset(this.offset), length)
    }

    + fn to_ascii_lower_string() String {
        @unsafe
        let result = this.to_string()
        mem.ascii_bytes_to_lower(result.data, result.bytes)
        return result
    }

    + fn to_uint() uint !SyntaxError $inline {
        return mem.to_uint[T](this.view(0, this.available_length())) ! throw .syntax
    }

    + fn to_int() int !SyntaxError $inline {
        return this.parse_int() ! throw .syntax
    }

    + fn to_float() float !SyntaxError $inline {
        return this.parse_float() ! throw .syntax
    }

    fn parse_uint(allow_plus: bool (false)) uint !SyntaxError $inline {
        return mem.to_uint[T](this.view(0, this.available_length()), allow_plus) ! throw .syntax
    }

    fn parse_int() int !SyntaxError $inline {
        let length = this.available_length()
        if length == 0 : throw .syntax
        let offset: uint = 0
        let negative = false
        if this[0] == '-' {
            negative = true
            offset = 1
        } else if this[0] == '+' {
            offset = 1
        }
        if offset == length : throw .syntax
        let value = this.view(offset, length - offset).parse_uint() ! throw .syntax
        let uint_max: uint = 0
        uint_max--
        let int_max = uint_max >> 1
        if negative {
            let min_magnitude = int_max + 1
            if value > min_magnitude : throw .syntax
            if value == min_magnitude : return (0 - int_max.to(int)) - 1
            return 0 - value.to(int)
        }
        if value > int_max : throw .syntax
        return value.to(int)
    }

    fn parse_octal_uint() uint !SyntaxError $inline {
        let length = this.available_length()
        let i = length
        let result: uint = 0
        let mult: uint = 1
        while i > 0 {
            let ch = this[--i]
            if ch >= '0' && ch <= '7' {
                result += (ch.to(uint) - '0') * mult
            } else if ch == 'c' && i == 1 && this[0] == '0' {
                break
            } else {
                throw .syntax
            }
            mult *= 8
        }
        return result
    }

    fn parse_octal_int() int !SyntaxError $inline {
        let length = this.available_length()
        if length == 0 : return 0
        let offset: uint = 0
        let negative = false
        if this[0] == '-' {
            negative = true
            offset = 1
        }
        if offset == length : return 0
        let value = this.view(offset, length - offset).parse_octal_uint() ! throw .syntax
        return value.to(int) * (negative ? -1 : 1)
    }

    fn parse_hex_uint() uint !SyntaxError $inline {
        let length = this.available_length()
        let i: uint = 0
        if length >= 2 && this[0] == '0' && this[1] == 'x' : i = 2
        let result: uint = 0
        while i < length {
            let ch = this[i++]
            let digit: uint = 0
            if ch >= '0' && ch <= '9' {
                digit = ch.to(uint) - '0'
            } else if ch >= 'A' && ch <= 'F' {
                digit = ch.to(uint) - 'A' + 10
            } else if ch >= 'a' && ch <= 'f' {
                digit = ch.to(uint) - 'a' + 10
            } else {
                throw .syntax
            }
            let previous = result
            result = result * 16 + digit
            if result / 16 != previous : throw .syntax
        }
        return result
    }

    fn parse_hex_int() int !SyntaxError $inline {
        let length = this.available_length()
        if length == 0 : return 0
        let offset: uint = 0
        let negative = false
        if this[0] == '-' {
            negative = true
            offset = 1
        }
        if offset == length : return 0
        let value = this.view(offset, length - offset).parse_hex_uint() ! throw .syntax
        return value.to(int) * (negative ? -1 : 1)
    }

    fn parse_float() float !SyntaxError {
        let length = this.available_length()
        if length > 768 : throw .syntax
        let sign: f64 = 1
        let i: uint = 0
        let mantissa_end = length
        let has_dot = false
        let decimals: int = 0
        let exponent: int = 0
        let exponent_negative = false
        let has_exponent = false
        let exact_mantissa: u64 = 0
        let exact = true

        if i == length : throw .syntax
        if this[0] == '-' {
            sign = -1
            i++
            if i == length : throw .syntax
        }
        while i < length {
            let ch = this[i++]
            if ch.is_number() {
                let digit = (ch - '0').to(u64)
                if exact && exact_mantissa <= (18446744073709551615.to(u64) - digit) / 10 {
                    exact_mantissa = exact_mantissa * 10 + digit
                } else {
                    exact = false
                }
                if has_dot : decimals++
            } else if ch == '.' {
                if has_dot : throw .syntax
                has_dot = true
            } else if ch == 'e' || ch == 'E' {
                has_exponent = true
                mantissa_end = i - 1
                break
            } else {
                throw .syntax
            }
        }
        if has_exponent {
            if i == length : throw .syntax
            let ch = this[i]
            if ch == '+' || ch == '-' {
                exponent_negative = ch == '-'
                i++
                if i == length : throw .syntax
            }
            while i < length {
                ch = this[i++]
                if !ch.is_number() : throw .syntax
                exponent = exponent * 10 + (ch - '0').to(int)
                if exponent > 400 : throw .syntax
            }
        }
        let scale = (exponent_negative ? 0 - exponent : exponent) - decimals
        if exact : return parse_float_exact(exact_mantissa, scale) * sign
        return parse_float_exact_view[T](this.view(0, mantissa_end), scale) * sign
    }

    fn decimal_length(signed: bool) uint $inline {
        let length = this.available_length()
        if length == 0 : return 0
        let i: uint = 0
        if (signed && this[0] == '-') || this[0] == '+' : i++
        while i < length && this[i].is_number() : i++
        return i
    }

    fn octal_length(signed: bool) uint $inline {
        let length = this.available_length()
        if length == 0 : return 0
        let i: uint = 0
        if signed && this[0] == '-' : i++
        if i + 2 <= length && this.equals_at(i, 2, "0c") : i += 2
        while i < length && this[i].is_octal() : i++
        return i
    }

    fn hex_length(signed: bool) uint $inline {
        let length = this.available_length()
        if length == 0 : return 0
        let i: uint = 0
        if signed && this[0] == '-' : i++
        if i + 2 <= length && this.equals_at(i, 2, "0x") : i += 2
        while i < length && this[i].is_hex() : i++
        return i
    }

    fn float_length() uint $inline {
        let length = this.available_length()
        if length == 0 : return 0
        let i: uint = 0
        let dot = false
        if this[0] == '-' : i++
        while i < length {
            let ch = this[i]
            if ch == '.' {
                if dot : break
                dot = true
                i++
                continue
            }
            if ch.is_number() {
                i++
                continue
            }
            if ch == 'e' || ch == 'E' {
                i++
                if i < length && (this[i] == '+' || this[i] == '-') : i++
                while i < length && this[i].is_number() : i++
            }
            break
        }
        return i
    }

    + fn equals(cmp: String) bool $inline {
        return this.equals_at(0, this.available_length(), cmp)
    }

    + fn equal_ignore_ascii_case(cmp: String) bool $inline {
        return this.equal_at_ignore_ascii_case(0, this.available_length(), cmp)
    }

    + fn equals_at(offset: uint, length: uint, cmp: String) bool $inline {
        if length != cmp.bytes : return false
        return mem.equal[T, String](this.view(offset, length), cmp.view(0, length))
    }

    + fn equal_at_ignore_ascii_case(offset: uint, length: uint, cmp: String) bool $inline {
        if length != cmp.bytes : return false
        return mem.ascii_equal_ignore_case[T, String](this.view(offset, length), cmp.view(0, length))
    }

    + fn starts_with(cmp: String) bool $inline {
        let length = this.available_length()
        if cmp.bytes > length : return false
        return mem.equal[T, String](this.view(0, cmp.bytes), cmp.view(0, cmp.bytes))
    }

    + fn index_of_byte(byte: u8, start_index: uint (0)) uint !LookupError $inline {
        let length = this.available_length()
        if start_index >= length : throw .missing
        let found = mem.find_char[T](this.view(start_index, length - start_index), byte) ! throw .missing
        return start_index + found
    }

    fn available_length() uint $inline {
        let source_length = source_byte_length[T](this.source)
        let offset = this.offset
        if offset > source_length : return 0
        let available = source_length - offset
        return this.length > available ? available : this.length
    }
}

fn source_byte_length[T](source: T) uint $inline {
    #if T.$has_method(byte_view_length)
    return source.byte_view_length()
    #elif T.$is_type_of(String)
    return source.bytes
    #elif T.$is_type_of(ByteBuffer)
    return source.length
    #else
    #error "ByteView source type must be String, ByteBuffer, or implement byte_view_length"
    #end
}

use mem

+ struct ByteView[T] $global {
    source: T
    offset: uint
    length: uint

    + static fn new(source: T, offset: uint, length: uint) SELF $inline {
        let source_length = source_byte_length[T](source)
        if offset > source_length {
            offset = 0
            length = 0
        } else if length > source_length - offset {
            length = source_length - offset
        }
        return SELF {
            source: source
            offset: offset
            length: length
        }
    }

    + get data: ptr $inline {
        @unsafe
        let source_length = source_byte_length[T](this.source)
        if this.offset > source_length : return this.source.data
        return this.source.data.@offset(this.offset)
    }

    + get bytes: uint $inline {
        return this.available_length()
    }

    + fn clear() $inline {
        this.length = 0
        this.offset = 0
    }

    + fn get(index: uint) u8 $offset $inline {
        @unsafe
        let length = this.available_length()
        if index >= length : return 0
        return @ptrv(this.source.data, u8, this.offset + index)
    }

    + fn has_ascii_control(allow_tab: bool (false)) bool $inline {
        @unsafe
        let length = this.available_length()
        let data = this.source.data.@offset(this.offset)
        let i: uint = 0
        let high: u64 = 0x8080808080808080
        let ones: u64 = 0x0101010101010101
        while length - i >= 8 {
            let word = @ptrv(data.@offset(i), u64)
            let low = (word - 0x2020202020202020) & ~word & high
            let del = word ^ 0x7f7f7f7f7f7f7f7f
            let has_del = (del - ones) & ~del & high
            if low != 0 || has_del != 0 {
                let end = i + 8
                while i < end {
                    let ch = @ptrv(data, u8, i++)
                    if (ch < 32 && (!allow_tab || ch != '\t')) || ch == 127 : return true
                }
            } else {
                i += 8
            }
        }
        while i < length {
            let ch = @ptrv(data, u8, i++)
            if (ch < 32 && (!allow_tab || ch != '\t')) || ch == 127 : return true
        }
        return false
    }

    + fn view(offset: uint, length: uint) SELF $range $inline {
        let available = this.available_length()
        if offset > available {
            offset = 0
            length = 0
        } else if length > available - offset {
            length = available - offset
        }
        return SELF {
            source: this.source
            offset: this.offset + offset
            length: length
        }
    }

    + fn to_string() String {
        @unsafe
        let length = this.available_length()
        if length == 0 : return ""
        return String.copy_from_ptr(this.source.data.@offset(this.offset), length)
    }

    + fn to_ascii_lower_string() String {
        @unsafe
        let result = this.to_string()
        mem.ascii_bytes_to_lower(result.data, result.bytes)
        return result
    }

    + fn to_uint() uint !SyntaxError $inline {
        return mem.to_uint[T](this.view(0, this.available_length())) ! throw .syntax
    }

    + fn to_int() int !SyntaxError $inline {
        return this.data.read_int(this.bytes) ! throw .syntax
    }

    + fn to_float() float !SyntaxError $inline {
        return this.data.read_float(this.bytes) ! throw .syntax
    }

    + fn equals(cmp: String) bool $inline {
        return this.equals_at(0, this.available_length(), cmp)
    }

    + fn equal_ignore_ascii_case(cmp: String) bool $inline {
        return this.equal_at_ignore_ascii_case(0, this.available_length(), cmp)
    }

    + fn equals_at(offset: uint, length: uint, cmp: String) bool $inline {
        if length != cmp.bytes : return false
        return mem.equal[T, String](this.view(offset, length), cmp.view(0, length))
    }

    + fn equal_at_ignore_ascii_case(offset: uint, length: uint, cmp: String) bool $inline {
        if length != cmp.bytes : return false
        return mem.ascii_equal_ignore_case[T, String](this.view(offset, length), cmp.view(0, length))
    }

    + fn starts_with(cmp: String) bool $inline {
        let length = this.available_length()
        if cmp.bytes > length : return false
        return mem.equal[T, String](this.view(0, cmp.bytes), cmp.view(0, cmp.bytes))
    }

    + fn index_of_byte(byte: u8, start_index: uint (0)) uint !LookupError $inline {
        let length = this.available_length()
        if start_index >= length : throw .missing
        let found = mem.find_char[T](this.view(start_index, length - start_index), byte) ! throw .missing
        return start_index + found
    }

    fn available_length() uint $inline {
        let source_length = source_byte_length[T](this.source)
        let offset = this.offset
        if offset > source_length : return 0
        let available = source_length - offset
        return this.length > available ? available : this.length
    }
}

fn source_byte_length[T](source: T) uint $inline {
    #if T.$has_method(byte_view_length)
    return source.byte_view_length()
    #elif T.$is_type_of(String)
    return source.bytes
    #elif T.$is_type_of(ByteBuffer)
    return source.length
    #else
    #error "ByteView source type must be String, ByteBuffer, or implement byte_view_length"
    #end
}

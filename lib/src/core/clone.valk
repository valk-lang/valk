
@ignore_access

fn clone_value[T](value: T) T {
    #if T.$is_nullable
    if value == null : return null
    #end
    #if !T.$is_structural
    return value
    #else
        #if T.$has_method(clone)
        return value.clone()
        #else
        // Structure types
        let result = T {
            // #if T.$has_vtable
            // _VTABLE: @vtable(T)
            // #end
            #loop object value as PROP
            // #if !property_name_is(PROP, _VTABLE)
            PROP: clone_value[PROP](PROP.value)
            // #end
            #end
        }
        return result
        #end
    #end
}

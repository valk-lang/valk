@ignore_access

// Deep copy of a value.
//
// Cases, decided at compile time for the concrete type:
//
//   - a type that defines `clone()` is asked to copy itself (Array, String,
//     ByteBuffer, and function values with captures).
//   - a class or struct without one is copied property by property, each of
//     those cloned in turn.
//   - a structural type that embeds raw pointers is returned as-is (a field-wise
//     copy would alias that memory).
//   - anything else is a plain value and is returned as it stands.
// Library entry point; `$clone` is the language token. Prefer `$clone(v)` in
// new code — this remains for call sites that want a normal function.
+ fn clone_value(value: $T) T {
    return $clone(value)
}

// Implementation of `$clone` / `clone_value`. Kept as a separate function so
// the token can lower to a call without recursing into itself.
fn clone_value_impl(value: $T) T {
    #if T.$is_nullable
    // `isset` narrows the generic payload so `.clone()` is allowed on `?T`.
    if !isset(value) : return null
    #if T.$has_method(clone)
    return value.clone()
    #elif T.$is_structural
    #if T.$has_raw_pointer_props
    return value
    #else
    return {
        #loop object value as PROP
        PROP: $clone(PROP)
        #end
    }
    #end
    #else
    return value
    #end
    #else
    #if T.$has_method(clone)
    return value.clone()
    #elif T.$is_structural
    // Types that embed raw pointers cannot be deep-copied field-wise without
    // aliasing; keep a shallow copy so containers like Array[Coro] still work.
    #if T.$has_raw_pointer_props
    return value
    #else
    return {
        #loop object value as PROP
        PROP: $clone(PROP)
        #end
    }
    #end
    #else
    return value
    #end
    #end
}

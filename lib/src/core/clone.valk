use gc

/// Returns a deep copy of `value`, the same copy `clone value` makes.
///
/// Classes with a `clone` method are copied through it; `atomic` values are returned as
/// they are. Values that alias raw memory (raw pointers, borrows) without a `clone` method
/// are a compile error.
+ fn clone_value(value: $T) T {
    return clone value
}

// The objects the clone in progress on this thread copied, by address: a graph with cycles or
// with parts reached twice is copied with the same shape
global clone_copies: ?HashMap[uint, uint] (null)
global clone_depth: uint (0)
// Copies whose fields are still to be cloned; a loop fills them, so deep graphs don't recurse
global clone_work: Array[CloneWork] (.{})

struct CloneWork {
    source: gc.GcPtr
    copy: gc.GcPtr
    fill: fnptr(ptr, ptr)()
}

fn clone_begin() uint $inline {
    clone_depth++
    return clone_work.length
}

// Fills the copies made since `mark`, then forgets the copies when the outer clone is done
fn clone_end(mark: uint) {
    @unsafe
    while clone_work.length > mark {
        let work = clone_work.pop_last() !!
        work.fill(work.source.@cast(ptr), work.copy.@cast(ptr))
    }
    clone_depth--
    if clone_depth > 0 : return
    let copies = clone_copies ?! return
    copies.clear()
}

fn clone_defer(source: ptr, copy: ptr, fill: fnptr(ptr, ptr)()) {
    @unsafe
    clone_work.append(CloneWork { source: source.@cast(gc.GcPtr), copy: copy.@cast(gc.GcPtr), fill: fill })
}

fn clone_find(source: ptr) ?ptr {
    @unsafe
    let copies = clone_copies ?! return null
    let copy = copies.get(source.@cast(uint)) ! return null
    return copy.@cast(ptr)
}

fn clone_note(source: ptr, copy: ptr) {
    @unsafe
    let copies = clone_copies ?? <{
        let created = HashMap[uint, uint]{}
        clone_copies = created
        return created
    }
    copies.set(source.@cast(uint), copy.@cast(uint))
}

@ignore_access

// Deep copy of a value.
//
// Three cases, decided at compile time for the concrete type:
//
//   - a type that defines `clone()` is asked to copy itself. Anything owning a
//     buffer belongs here — Array and String both do — because only the type
//     knows how to duplicate what it points at.
//   - a class or struct without one is copied property by property, each of
//     those cloned in turn.
//   - anything else is a plain value and is returned as it stands.
//
// Copying a property that is a raw pointer copies the address, not what it
// addresses, so the copy and the original would quietly share that memory.
// Rather than do that, a type holding a raw pointer and no `clone()` of its own
// is refused, and writing that method resolves it.
+ fn clone_value[T](value: T) T {
    #if T.$is_nullable
    if value == null : return null
    #end

    #if T.$has_method(clone)
    return value.clone()
    #elif T.$is_structural
    clone_reject_raw_pointers[T]()
    return T {
        #loop object value as PROP
        PROP: clone_value[PROP](PROP)
        #end
    }
    #else
    return value
    #end
}

// Refuse a property-wise copy that would alias. Separate from the copy itself
// so the check reads over the properties once, before any of them is touched.
fn clone_reject_raw_pointers[T]() {
    #loop properties T as PROP
    #if PROP.$type.$is_raw_pointer
    #error "Cannot clone this type: it has a raw pointer property, which a copy would share instead of duplicate. Give the type its own 'clone()' method."
    #end
    #end
}

// Deep copy of a value.
//
// Cases, decided at compile time for the concrete type:
//
//   - a type that defines `clone()` is asked to copy itself (Array, String,
//     ByteBuffer, and function values with captures).
//   - a class or struct without one is copied property by property, each of
//     those cloned in turn.
//   - a structural type that embeds raw pointers is returned as-is (a field-wise
//     copy would alias that memory).
//   - anything else is a plain value and is returned as it stands.
// Library entry point; `$clone` is the language token. Prefer `$clone(v)` in
// new code — this remains for call sites that want a normal function.
+ fn clone_value(value: $T) T {
    return $clone(value)
}

fn clone_value_unchecked(value: $T) T {
    return $clone(value)
}

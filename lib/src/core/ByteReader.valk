use mem
use io

// A parsing cursor over a byte slice (`String` and `ByteBuffer` convert to Slice[u8]).
// Also an `io.Reader`, so in-memory bytes can be streamed like a file
+ class ByteReader $global is io.Reader, io.Seeker {
    + source: Slice[u8]
    + pos: uint (0)

    + static fn new(source: Slice[u8]) SELF {
        return SELF {
            source: source
        }
    }

    + fn read(buf: Slice[u8]) uint !io.IoError {
        @unsafe
        let remaining = this.remaining()
        let count = remaining.length
        if count > buf.length : count = buf.length
        mem.copy_bytes(remaining.data, buf.data, count)
        this.pos += count
        return count
    }

    + fn seek(offset: int, from: io.SeekFrom (io.SeekFrom.start)) uint !io.IoError {
        let length = this.source.length
        let base: uint = 0
        if from == io.SeekFrom.current : base = this.pos
        else if from == io.SeekFrom.end : base = length

        let position: uint = 0
        if offset < 0 {
            let distance = (-(offset + 1)).to(uint) + 1
            if distance > base : throw .range
            position = base - distance
        } else {
            position = base.checked_add(offset.to(uint)) ! throw .range
        }
        if position > length : throw .range
        this.pos = position
        return position
    }

    + fn reset() {
        this.pos = 0
    }
    + fn set_pos(index: uint) {
        this.pos = index > this.source.length ? this.source.length : index
    }
    + fn get_pos() uint {
        return this.pos
    }
    + fn skip(amount: uint) {
        let len = this.source.length
        if this.pos >= len || amount > len - this.pos : this.pos = len
        else : this.pos += amount
    }
    + fn rewind(amount: uint) {
        if amount > this.pos : this.pos = 0
        else : this.pos -= amount
    }
    // The bytes that have not been read yet
    + fn remaining() Slice[u8] {
        let pos = this.pos
        let len = this.source.length
        if pos >= len : return this.source.view(0, 0)
        return this.source.view(pos, len - pos)
    }

    //
    + fn read_byte() u8 {
        if this.pos >= this.source.length : return 0
        return this.source.byte(this.pos++)
    }
    + fn read_u16_le() u16 {
        return this.read_little_endian(size_of(u16)).to(u16)
    }
    + fn read_u32_le() u32 {
        return this.read_little_endian(size_of(u32)).to(u32)
    }
    + fn read_u64_le() u64 {
        return this.read_little_endian(size_of(u64))
    }
    + fn read_uint_le() uint {
        return this.read_little_endian(size_of(uint))
    }
    + fn read_u16_be() u16 {
        return this.read_big_endian(size_of(u16)).to(u16)
    }
    + fn read_u32_be() u32 {
        return this.read_big_endian(size_of(u32)).to(u32)
    }
    + fn read_u64_be() u64 {
        return this.read_big_endian(size_of(u64))
    }
    + fn read_uint_be() uint {
        return this.read_big_endian(size_of(uint))
    }
    + fn read_little_endian(bytes: uint) uint {
        let pos = this.pos
        if pos > this.source.length || bytes > this.source.length - pos : return 0
        this.pos = pos + bytes
        return read_little_endian(this.source.data.@offset(pos), bytes)
    }
    + fn read_big_endian(bytes: uint) uint {
        let pos = this.pos
        if pos > this.source.length || bytes > this.source.length - pos : return 0
        this.pos = pos + bytes
        return read_big_endian(this.source.data.@offset(pos), bytes)
    }
    // String
    + fn read_string(len: uint) String {
        let remaining = this.remaining()
        if len > remaining.length : return this.read_remaining_string()
        this.pos += len
        return remaining.view(0, len).to_string()
    }
    + fn read_remaining_string() String {
        let remaining = this.remaining()
        this.pos += remaining.length
        return remaining.to_string()
    }
    + fn read_cstring() String {
        let i = this.source.index_of_byte(0, this.pos) ! return ""
        let str = this.source.view(this.pos, i - this.pos).to_string()
        this.pos = i + 1
        return str
    }

    /////////////////////////////////////
    // Read ascii integers
    /////////////////////////////////////
    + fn read_int() int {
        let view = this.remaining()
        let bytes = view.decimal_length(true)
        let v = view.view(0, bytes).parse_int() ! return 0
        this.pos += bytes
        return v
    }
    + fn read_uint() uint {
        let view = this.remaining()
        let bytes = view.decimal_length(false)
        let v = view.view(0, bytes).parse_uint(true) ! return 0
        this.pos += bytes
        return v
    }
    + fn read_octal_int() int {
        let view = this.remaining()
        let bytes = view.octal_length(true)
        let v = view.view(0, bytes).parse_octal_int() ! return 0
        this.pos += bytes
        return v
    }
    + fn read_octal_uint() uint {
        let view = this.remaining()
        let bytes = view.octal_length(false)
        let v = view.view(0, bytes).parse_octal_uint() ! return 0
        this.pos += bytes
        return v
    }
    + fn read_hex_int() int {
        let view = this.remaining()
        let bytes = view.hex_length(true)
        let v = view.view(0, bytes).parse_hex_int() ! return 0
        this.pos += bytes
        return v
    }
    + fn read_hex_uint() uint {
        let view = this.remaining()
        let bytes = view.hex_length(false)
        let v = view.view(0, bytes).parse_hex_uint() ! return 0
        this.pos += bytes
        return v
    }
    + fn read_float() float {
        let view = this.remaining()
        let bytes = view.float_length()
        let v = view.view(0, bytes).parse_float() ! return 0
        this.pos += bytes
        return v
    }
}

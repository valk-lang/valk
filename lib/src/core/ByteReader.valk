use mem
use io

/// A read cursor over bytes, for parsing binary or text data.
///
/// `String` and `ByteBuffer` convert to `&[u8]`, so either can be the source. It implements
/// `io.Reader` and `io.Seeker`, so in-memory bytes can be streamed like a file. The reader
/// keeps a view, not a copy: bytes appended to a `ByteBuffer` source afterwards are not seen.
///
/// Reading past the end never throws: the `read_*` methods return 0 or a short or empty
/// string and leave the position where it was.
+ class ByteReader $global is io.Reader, io.Seeker {
    /// The bytes being read.
    + source: &[u8]
    /// Byte offset of the next read. May be set directly; a position past the end reads as the
    /// end.
    + pos: uint (0)

    /// Creates a reader at position 0 over `source`.
    + static fn new(source: &[u8]) SELF {
        return SELF {
            source: source
        }
    }

    /// Copies up to `buf.length` unread bytes into `buf` and advances past them.
    ///
    /// Returns the number of bytes copied, 0 at the end. Never throws.
    + fn read(buf: mut &[u8]) uint !io.IoError {
        @unsafe
        let remaining = this.remaining()
        let count = remaining.length
        if count > buf.length : count = buf.length
        mem.copy_bytes(remaining.data, buf.data, count)
        this.pos += count
        return count
    }

    /// Moves the position to `offset` bytes relative to `from` and returns the new position.
    ///
    /// Throws `range`, leaving the position unchanged, when the result would lie before the
    /// start or past the end of the source.
    + fn seek(offset: int, from: io.SeekFrom (io.SeekFrom.start)) uint !io.IoError {
        let length = this.source.length
        let base: uint = 0
        if from == io.SeekFrom.current : base = this.pos
        else if from == io.SeekFrom.end : base = length

        let position: uint = 0
        if offset < 0 {
            let distance = (-(offset + 1)).to(uint) + 1
            if distance > base : throw .range
            position = base - distance
        } else {
            position = base.checked_add(offset.to(uint)) ! throw .range
        }
        if position > length : throw .range
        this.pos = position
        return position
    }

    /// Moves the position back to the start.
    + fn reset() {
        this.pos = 0
    }
    /// Sets the position to `index`, clamped to the source length.
    + fn set_pos(index: uint) {
        this.pos = index > this.source.length ? this.source.length : index
    }
    /// Returns the current position in bytes.
    + fn get_pos() uint {
        return this.pos
    }
    /// Advances the position by `amount` bytes, stopping at the end.
    + fn skip(amount: uint) {
        let len = this.source.length
        if this.pos >= len || amount > len - this.pos : this.pos = len
        else : this.pos += amount
    }
    /// Moves the position back by `amount` bytes, stopping at the start.
    + fn rewind(amount: uint) {
        if amount > this.pos : this.pos = 0
        else : this.pos -= amount
    }
    /// Returns a view of the bytes that have not been read yet, without advancing.
    + fn remaining() &[u8] {
        let pos = this.pos
        let len = this.source.length
        if pos >= len : return this.source.view(0, 0)
        return this.source.view(pos, len - pos)
    }

    //
    /// Reads one byte, or returns 0 without advancing at the end.
    ///
    /// A 0 result is ambiguous when the data can contain zero bytes; check `remaining()` first.
    + fn read_byte() u8 {
        if this.pos >= this.source.length : return 0
        return this.source.byte(this.pos++)
    }
    /// Reads a little-endian `u16`; returns 0 without advancing when fewer than 2 bytes remain.
    + fn read_u16_le() u16 {
        return this.read_little_endian(size_of(u16)).to(u16)
    }
    /// Reads a little-endian `u32`; returns 0 without advancing when fewer than 4 bytes remain.
    + fn read_u32_le() u32 {
        return this.read_little_endian(size_of(u32)).to(u32)
    }
    /// Reads a little-endian `u64`; returns 0 without advancing when fewer than 8 bytes remain.
    + fn read_u64_le() u64 {
        return this.read_little_endian(size_of(u64))
    }
    /// Reads a little-endian `uint` of `size_of(uint)` bytes.
    ///
    /// Returns 0 without advancing when fewer bytes remain.
    + fn read_uint_le() uint {
        return this.read_little_endian(size_of(uint))
    }
    /// Reads a big-endian `u16`; returns 0 without advancing when fewer than 2 bytes remain.
    + fn read_u16_be() u16 {
        return this.read_big_endian(size_of(u16)).to(u16)
    }
    /// Reads a big-endian `u32`; returns 0 without advancing when fewer than 4 bytes remain.
    + fn read_u32_be() u32 {
        return this.read_big_endian(size_of(u32)).to(u32)
    }
    /// Reads a big-endian `u64`; returns 0 without advancing when fewer than 8 bytes remain.
    + fn read_u64_be() u64 {
        return this.read_big_endian(size_of(u64))
    }
    /// Reads a big-endian `uint` of `size_of(uint)` bytes.
    ///
    /// Returns 0 without advancing when fewer bytes remain.
    + fn read_uint_be() uint {
        return this.read_big_endian(size_of(uint))
    }
    /// Reads `bytes` bytes as an unsigned little-endian integer (meant for 1 to 8 bytes).
    ///
    /// Returns 0 without advancing when fewer than `bytes` bytes remain.
    + fn read_little_endian(bytes: uint) uint {
        let pos = this.pos
        if pos > this.source.length || bytes > this.source.length - pos : return 0
        this.pos = pos + bytes
        return read_little_endian(this.source.data.@offset(pos), bytes)
    }
    /// Reads `bytes` bytes as an unsigned big-endian integer (meant for 1 to 8 bytes).
    ///
    /// Returns 0 without advancing when fewer than `bytes` bytes remain.
    + fn read_big_endian(bytes: uint) uint {
        let pos = this.pos
        if pos > this.source.length || bytes > this.source.length - pos : return 0
        this.pos = pos + bytes
        return read_big_endian(this.source.data.@offset(pos), bytes)
    }
    // String
    /// Reads `len` bytes into a new `String`, or all remaining bytes when fewer are left.
    ///
    /// The bytes are copied as they are; no UTF-8 check is made.
    + fn read_string(len: uint) String {
        let remaining = this.remaining()
        if len > remaining.length : return this.read_remaining_string()
        this.pos += len
        return remaining.view(0, len).to_string()
    }
    /// Reads all remaining bytes into a new `String`.
    + fn read_remaining_string() String {
        let remaining = this.remaining()
        this.pos += remaining.length
        return remaining.to_string()
    }
    /// Reads the bytes up to the next zero byte into a `String` and advances past the zero.
    ///
    /// Returns "" without advancing when no zero byte remains.
    + fn read_cstring() String {
        let i = this.source.index_of_byte(0, this.pos) ! return ""
        let str = this.source.view(this.pos, i - this.pos).to_string()
        this.pos = i + 1
        return str
    }

    /////////////////////////////////////
    // Read ascii integers
    /////////////////////////////////////
    /// Parses a decimal integer with an optional `-` or `+` sign and advances past it.
    ///
    /// Parsing starts at the position (whitespace is not skipped) and stops at the first
    /// non-digit. Returns 0 without advancing when there is no number or it does not fit in
    /// `int`.
    + fn read_int() int {
        let view = this.remaining()
        let bytes = view.decimal_length(true)
        let v = view.view(0, bytes).parse_int() ! return 0
        this.pos += bytes
        return v
    }
    /// Parses an unsigned decimal integer with an optional `+` sign and advances past it.
    ///
    /// Parsing starts at the position (whitespace is not skipped) and stops at the first
    /// non-digit. Returns 0 without advancing when there is no number or it does not fit in
    /// `uint`.
    + fn read_uint() uint {
        let view = this.remaining()
        let bytes = view.decimal_length(false)
        let v = view.view(0, bytes).parse_uint(true) ! return 0
        this.pos += bytes
        return v
    }
    /// Parses an octal integer with an optional `-` sign and `0c` prefix and advances past it.
    ///
    /// Stops at the first non-octal digit. Returns 0 without advancing when there is no number
    /// or it does not fit in `int`; a bare `0c` prefix reads as 0 and is consumed.
    + fn read_octal_int() int {
        let view = this.remaining()
        let bytes = view.octal_length(true)
        let v = view.view(0, bytes).parse_octal_int() ! return 0
        this.pos += bytes
        return v
    }
    /// Parses an unsigned octal integer with an optional `0c` prefix and advances past it.
    ///
    /// Stops at the first non-octal digit. Returns 0 without advancing when there is no number
    /// or it does not fit in `uint`; a bare `0c` prefix reads as 0 and is consumed.
    + fn read_octal_uint() uint {
        let view = this.remaining()
        let bytes = view.octal_length(false)
        let v = view.view(0, bytes).parse_octal_uint() ! return 0
        this.pos += bytes
        return v
    }
    /// Parses a hexadecimal integer with an optional `-` sign and `0x` prefix, advancing past it.
    ///
    /// Digits may be upper or lower case; the prefix must be a lowercase `0x`. Returns 0 without
    /// advancing when there is no number or it does not fit in `int`; a bare `0x` prefix reads
    /// as 0 and is consumed.
    + fn read_hex_int() int {
        let view = this.remaining()
        let bytes = view.hex_length(true)
        let v = view.view(0, bytes).parse_hex_int() ! return 0
        this.pos += bytes
        return v
    }
    /// Parses an unsigned hexadecimal integer with an optional `0x` prefix, advancing past it.
    ///
    /// Digits may be upper or lower case; the prefix must be a lowercase `0x`. Returns 0 without
    /// advancing when there is no number or it does not fit in `uint`; a bare `0x` prefix reads
    /// as 0 and is consumed.
    + fn read_hex_uint() uint {
        let view = this.remaining()
        let bytes = view.hex_length(false)
        let v = view.view(0, bytes).parse_hex_uint() ! return 0
        this.pos += bytes
        return v
    }
    /// Parses a decimal float and advances past it.
    ///
    /// Accepts an optional `-` (not `+`), digits with at most one `.`, and an optional exponent
    /// (`e` or `E`, optional sign). Returns 0 without advancing when the text is not a valid
    /// number or is out of range. An `e` not followed by digits makes the whole read fail, so
    /// `2em` returns 0 rather than 2.
    + fn read_float() float {
        let view = this.remaining()
        let bytes = view.float_length()
        let v = view.view(0, bytes).parse_float() ! return 0
        this.pos += bytes
        return v
    }
}

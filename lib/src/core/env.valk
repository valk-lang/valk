use ext

/// Returns the value of the environment variable `var`.
///
/// Throws `missing` when it is not set.
+ fn getenv(var: String) String !LookupError {
    let res = ext.getenv(var.data_cstring)
    if isset(res) {
        return res.to_string()
    }
    throw .missing
}

/// Sets or replaces the environment variable `var` for this process and the children it
/// starts.
///
/// Throws `failed` when `var` is empty or contains `=`, or when the OS rejects it. On Windows
/// an empty `value` removes the variable.
+ fn setenv(var: String, value: String) !SystemError {
    if var.length == 0 || var.contains("=") : throw .failed
    #if OS == "win"
    let res = ext._putenv_s(var.data_cstring, value.data_cstring)
    #else
    let res = ext.setenv(var.data_cstring, value.data_cstring, 1)
    #end
    if res != 0 : throw .failed
}

/// Removes the environment variable `var`; removing a variable that is not set succeeds.
///
/// Throws `failed` when `var` is empty or contains `=`, or when the OS rejects it.
+ fn unsetenv(var: String) !SystemError {
    if var.length == 0 || var.contains("=") : throw .failed
    #if OS == "win"
    // The CRT removes a variable whose value is set to ""
    let res = ext._putenv_s(var.data_cstring, "".data_cstring)
    #else
    let res = ext.unsetenv(var.data_cstring)
    #end
    if res != 0 : throw .failed
}

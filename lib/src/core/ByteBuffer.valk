use mem
use io

/// A growable byte buffer for building binary or text data in memory.
///
/// Bytes `0 .. length` are the written contents and `size` is the capacity. When the capacity
/// runs out it doubles and the contents move to new storage. The buffer converts to
/// `mut &[u8]` and `String` where those are expected (see `view` and `to_string`), and
/// implements `io.Writer`.
+ class ByteBuffer $global is io.Writer {
    /// The `String` whose bytes back the buffer; replaced when the capacity changes.
    ~ storage: String
    /// Pointer to the first byte of `storage`.
    ~ data: ptr
    /// Capacity in bytes.
    ~ size: uint
    /// Number of bytes written.
    ~ length: uint (0)
    - consumed: bool (false)

    /// Creates an empty buffer with room for `start_size` bytes (at least 32).
    ///
    /// Marked `$default`, so it also provides `ByteBuffer.$default_value`.
    + static fn new(start_size: uint (128)) ByteBuffer $default {
        if start_size < 32 : start_size = 32
        let storage = String.alloc(start_size)
        return ByteBuffer {
            storage: storage
            data: storage.data
            size: start_size
        }
    }

    /// Returns an independent copy with the same contents and capacity.
    ///
    /// A consumed buffer (see `into_string`) clones to a new, empty, writable buffer.
    + fn clone() SELF $clone {
        @unsafe
        if this.consumed : return SELF.new()
        let size = this.size
        let length = this.length
        let storage = String.alloc(size)
        if length > 0 : mem.copy_bytes(this.data, storage.data, length)

        return SELF {
            storage: storage
            data: storage.data
            size: size
            length: length
        }
    }

    /// Returns a `ByteReader` over the current contents.
    ///
    /// The reader keeps a view of the bytes as they are now: bytes appended later are not seen.
    + fn reader() ByteReader {
        return ByteReader.new(this)
    }

    /// Sets the length to 0; the capacity is kept.
    + fn clear() {
        this.length = 0
    }
    /// Removes the first `index` bytes and moves the rest to the front.
    ///
    /// Clears the whole buffer when `index` is at or past the length.
    + fn clear_until(index: uint) {
        let len = this.length
        if index >= len {
            this.clear()
            return
        }
        this.clear_range(0, index)
    }
    /// Removes `len` bytes starting at `index` and moves the later bytes down.
    ///
    /// `len` is clamped to the end of the contents. Does nothing when `index` is at or past the
    /// length.
    + fn clear_range(index: uint, len: uint) {
        if len == 0 || index >= this.length : return
        // Limits
        let total = this.length
        let max = total - index
        if len > max : len = max
        let rem = max - len
        // Copy bytes if needed
        if rem > 0 {
            mem.move(this.view(index + len, rem), this.view(index, rem))
        }
        this.length = index + rem
    }
    /// Grows the length by `amount` bytes without writing them.
    ///
    /// The skipped bytes keep whatever the storage held, such as earlier contents. Use it after
    /// filling the region returned by `view_spare`. Panics when the buffer is consumed.
    + fn skip(amount: uint) {
        this.reserve(amount)
        this.length += amount
    }
    /// Sets the length to `length`, growing the capacity when needed.
    ///
    /// Bytes added by growing the length are not cleared.
    + fn resize(length: uint) {
        if length > this.length : this.reserve(length - this.length)
        this.length = length
    }
    /// Shortens the contents to `length` bytes; does nothing when they are not longer.
    + fn truncate(length: uint) {
        if length < this.length : this.length = length
    }

    // Read
    /// Returns the byte at `index`, or 0 when `index` is at or past the length.
    ///
    /// Backs the `buffer[index]` read (`$offset`).
    + fn get(index: uint) u8 $offset {
        if index >= this.length : return 0
        return @ptrv(this.data, u8, index)
    }
    /// Replaces the byte at `index`; backs `buffer[index] = v` (`$offset_assign`).
    ///
    /// Panics when `index` is at or past the length: it never grows the buffer.
    + fn set(index: uint, v: u8) $offset_assign $inline {
        if index >= this.length : panic("Index out of bounds")
        @ptrv(this.data, u8, index) = v
    }

    // Compare
    /// Returns whether the contents equal the bytes of `str`; backs `buffer == str` (`$eq`).
    + fn equals_string(str: String) bool $eq {
        @unsafe
        let len = this.length
        if str.bytes != len : return false
        return mem.equal_bytes(this.data, str.data, len)
    }
    /// Returns whether the contents at byte `offset` begin with `str`.
    ///
    /// Returns false when `offset` is past the length.
    + fn starts_with(str: String, offset: uint (0)) bool {
        @unsafe
        let len = str.bytes
        if offset > this.length || len > this.length - offset : return false
        return mem.equal_bytes(this.data.@offset(offset), str.data, len)
    }

    // Find
    /// Returns the index of the first `byte` at or after `start_index`.
    ///
    /// Throws `missing` when there is none or `start_index` is at or past the length.
    + fn index_of(byte: u8, start_index: uint (0)) uint !LookupError {
        @unsafe
        let len = this.length
        if start_index >= len : throw .missing
        let res = mem.find_char_bytes(this.data.@offset(start_index), byte, len - start_index) ! throw .missing
        return res + start_index
    }

    /// Returns the index of the first byte at or after `start_index` that differs from `byte`.
    ///
    /// Throws `missing` when every remaining byte equals `byte`, or `start_index` is at or past
    /// the length.
    + fn index_where_byte_is_not(byte: u8, start_index: uint (0)) uint !LookupError {
        let index = start_index
        let len = this.length
        let data: ptr = this.data
        while index < len {
            let ch = @ptrv(data, u8, index)
            if ch != byte : return index
            index++
        }
        throw .missing
    }

    /////////////////////////
    // String functions
    /////////////////////////

    /// Returns a copy of the contents as a new `String`.
    ///
    /// Marked `$auto`: a buffer converts to `String` implicitly where one is expected.
    + fn to_string() String $auto {
        @unsafe
        if this.length == 0 : return ""
        let str = String.alloc(this.length)
        mem.copy_bytes(this.data, str.data, this.length)
        return str
    }

    /// Hands the storage over as a `String` without copying, and leaves the buffer consumed.
    ///
    /// A consumed buffer is empty for good: every call that needs room (`write*`, `reserve`,
    /// `skip`, `fill`, `resize` to a larger length, ...) panics, and `clear` does not undo it.
    /// Calling `into_string` again returns "". Use `clone` or a new buffer to keep writing.
    /// Views taken before the call still point at the bytes now owned by the returned string.
    + fn into_string() String {
        if this.consumed : return ""
        if this.length == 0 {
            this.storage = ""
            this.size = 0
            this.consumed = true
            return ""
        }
        // Hands the storage over as a string of the written length. This
        // writes the zero terminator, so the string stays terminated
        let result = String.adopt_storage(this.storage, this.length)
        this.storage = ""
        this.length = 0
        this.size = 0
        this.consumed = true
        return result
    }

    /// Returns a copy of `length` bytes starting at `start_index`, clamped to the contents.
    ///
    /// Returns "" when `start_index` is at or past the length.
    + fn range(start_index: uint, length: uint) String {
        @unsafe
        let len = this.length
        if length == 0 || start_index >= len : return ""
        let remain = len - start_index
        let real_len = length > remain ? remain : length
        return String.copy_from_ptr(this.data.@offset(start_index), real_len)
    }

    /// Returns a writable view of `length` bytes starting at `offset`, clamped to the contents.
    ///
    /// An `offset` past the length gives an empty view. Marked `$auto`, so the buffer converts
    /// to a view of its whole contents where a `&[u8]` is expected, and `$view`, which backs
    /// `&buffer[a .. b]`.
    ///
    /// The view has a fixed length and shares the current storage. Once the buffer moves to new
    /// storage (growth, `shrink_capacity`) the view still reads the old bytes and no longer sees
    /// writes; `clear_range` and similar calls shift the bytes under it.
    + fn view(offset: uint (0), length: uint (uint.$max)) mut &[u8] $view $auto $inline {
        @unsafe
        if offset > this.length {
            offset = 0
            length = 0
        } else if length > this.length - offset {
            length = this.length - offset
        }
        // The buffer owns its bytes, so its views are writable
        return [u8]{ owner: this.storage.owner, data: @ref(@ptrv(this.data, u8, offset)), length: length }
    }

    /// Returns a writable view of up to `amount` bytes of unused capacity after the contents.
    ///
    /// For readers that fill the buffer directly: `reserve` the room, write into this view, then
    /// `skip` the number of bytes written. `amount` is clamped to the free capacity, so without
    /// a prior `reserve` the view can be shorter than asked. `view` never covers this region.
    + fn view_spare(amount: uint) mut &[u8] $inline {
        @unsafe
        let free = this.size - this.length
        if amount > free : amount = free
        return [u8]{ owner: this.storage.owner, data: @ref(@ptrv(this.data, u8, this.length)), length: amount }
    }

    /// Removes the bytes for which `filter` returns true from both ends.
    + fn trim(filter: fnptr(u8)(bool)) {
        this.ltrim(filter)
        this.rtrim(filter)
    }
    /// Removes trailing bytes for which `filter` returns true.
    + fn rtrim(filter: fnptr(u8)(bool)) {
        let len = this.length
        let data = this.data
        while len-- > 0 {
            let ch = @ptrv(data, u8, len)
            if filter(ch) : continue
            break
        }
        this.length = len + 1
    }
    /// Removes leading bytes for which `filter` returns true and moves the rest to the front.
    + fn ltrim(filter: fnptr(u8)(bool)) {
        let len = this.length
        let data = this.data
        let i: uint = 0
        while i < len {
            let ch = @ptrv(data, u8, i++)
            if filter(ch) : continue
            i--
            break
        }
        if i > 0 : this.clear_until(i)
        return
    }
    // 
    /// Ensures room for `length` more bytes after the contents, growing the capacity if needed.
    ///
    /// Panics when the buffer is consumed (see `into_string`) or the size would overflow.
    + fn reserve(length: uint) $inline {
        if this.consumed : panic("Cannot write to a consumed ByteBuffer")
        let end = this.length.checked_add(length) ! panic("ByteBuffer capacity is too large")
        if end > this.size : this.ensure_capacity(end)
    }
    /// Grows the capacity to at least `minimum_capacity` bytes.
    ///
    /// The capacity doubles (starting from at least 32) until it is large enough, and the
    /// contents move to new storage; views taken before keep the old bytes. Panics when the
    /// size would overflow.
    + fn ensure_capacity(minimum_capacity: uint) {
        @unsafe
        let size: uint = this.size
        let new_size: uint = size
        if new_size < 32 : new_size = 32
        while new_size < minimum_capacity {
            new_size = new_size.checked_add(new_size) ! panic("ByteBuffer capacity is too large")
        }
        if (new_size != size) {
            let storage = String.alloc(new_size)
            mem.copy_bytes(this.data, storage.data, this.length)
            this.storage = storage
            this.data = storage.data
            this.size = new_size
        }
    }

    /// Reduces the capacity to `size` bytes, but never below the length or 32.
    ///
    /// Does nothing when `size` is not below the current capacity. Otherwise the contents move
    /// to new storage.
    + fn shrink_capacity(size: uint) {
        @unsafe
        if size < 32 : size = 32
        if size >= this.size : return
        let len = this.length
        if len > size : size = len
        let storage = String.alloc(size)
        mem.copy_bytes(this.data, storage.data, len)
        this.storage = storage
        this.data = storage.data
        this.size = size
    }

    ////////////////////////
    // Write
    ////////////////////////

    /// Appends `v` as text in `base`, using uppercase digits above 9.
    ///
    /// A `base` above 16 is treated as 16 and one below 2 as 10.
    + fn write_uint_ascii(v: uint, base: u8 (10)) {
        @unsafe
        this.reserve(65)
        this.length += v.to_base_to_ptr(base, this.data.@offset(this.length))
    }
    /// Appends `v` as text in `base`, with a leading `-` when negative.
    ///
    /// Uppercase digits above 9; a `base` above 16 is treated as 16 and one below 2 as 10.
    + fn write_int_ascii(v: int, base: u8 (10)) {
        @unsafe
        this.reserve(65)
        this.length += v.to_base_to_ptr(base, this.data.@offset(this.length))
    }
    /// Appends `v` in fixed notation with `decimals` digits after the point.
    ///
    /// `decimals` is clamped to 19. With `trim_zeros`, trailing zeros are dropped, and the point
    /// too when the fraction is zero. NaN, infinities and values beyond the 64-bit integer range
    /// are written as by `write_f64_ascii_shortest`.
    + fn write_f64_ascii(v: f64, decimals: uint, trim_zeros: bool (false)) {
        @unsafe
        this.reserve(64)
        this.length += v.to_string_in_ptr(this.data.@offset(this.length), decimals, trim_zeros)
    }
    /// Appends `v` with the fewest digits that parse back to the same value.
    ///
    /// Plain decimals for decimal exponents -6 to 20 (`0.001`, `125`), otherwise exponent form
    /// (`1.5e300`). NaN and infinities are written by name.
    + fn write_f64_ascii_shortest(v: f64) {
        @unsafe
        this.reserve(64)
        this.length += v.to_shortest_string_in_ptr(this.data.@offset(this.length))
    }
    /// Appends one byte.
    + fn write_byte(v: u8) {
        this.reserve(1)
        @ptrv(this.data, u8, this.length++) = v
    }
    /// Appends `v` as 2 bytes, most significant first.
    + fn write_u16_be(v: u16) {
        this.write_big_endian(v, 2)
    }
    /// Appends `v` as 2 bytes, least significant first.
    + fn write_u16_le(v: u16) {
        this.write_little_endian(v, 2)
    }
    /// Appends `v` as 4 bytes, most significant first.
    + fn write_u32_be(v: u32) {
        this.write_big_endian(v, 4)
    }
    /// Appends `v` as 4 bytes, least significant first.
    + fn write_u32_le(v: u32) {
        this.write_little_endian(v, 4)
    }
    /// Appends `v` as 8 bytes, most significant first.
    + fn write_u64_be(v: u64) {
        this.write_big_endian(v, 8)
    }
    /// Appends `v` as 8 bytes, least significant first.
    + fn write_u64_le(v: u64) {
        this.write_little_endian(v, 8)
    }
    /// Appends the IEEE 754 bits of `v` as 8 bytes, most significant first.
    + fn write_f64_be(v: f64) {
        this.write_big_endian(f64_to_bits(v), size_of(f64))
    }
    /// Appends the IEEE 754 bits of `v` as 8 bytes, least significant first.
    + fn write_f64_le(v: f64) {
        this.write_little_endian(f64_to_bits(v), size_of(f64))
    }

    /// Appends `amount` copies of the byte `with`.
    + fn fill(with: u8, amount: uint) {
        if amount == 0 : return
        @unsafe
        this.reserve(amount)
        this.data.@offset(this.length).fill_bytes(with, amount)
        this.length += amount
    }
    /// Zeroes the `amount` bytes after the contents, reserving room first.
    ///
    /// The length does not change; follow with `skip(amount)` to include the zeroed bytes.
    + fn clear_next_bytes(amount: uint) {
        @unsafe
        this.reserve(amount)
        mem.clear_bytes(this.data.@offset(this.length), amount)
    }

    /// Appends the low `bytes` bytes of `value`, least significant first.
    + fn write_little_endian(value: uint, bytes: uint) {
        this.reserve(bytes)
        write_little_endian(this.data.@offset(this.length), value, bytes)
        this.length += bytes
    }
    /// Appends the low `bytes` bytes of `value`, most significant first.
    + fn write_big_endian(value: uint, bytes: uint) {
        this.reserve(bytes)
        write_big_endian(this.data.@offset(this.length), value, bytes)
        this.length += bytes
    }
    /// Appends the bytes of `data` and returns how many were written (`data.length`).
    ///
    /// Implements `io.Writer`; it never throws.
    + fn write(data: &[u8]) uint {
        @unsafe
        let len = data.length
        this.reserve(len)
        mem.copy_bytes(data.data, this.data.@offset(this.length), len)
        this.length += len
        return len
    }
    /// Appends the bytes of the C string `str`, plus its zero terminator when `include_zero_byte`.
    + fn write_cstring(str: cstring, include_zero_byte: bool) {
        @unsafe
        let len = str.length()
        if include_zero_byte : len = len.checked_add(1) ! panic("ByteBuffer capacity is too large")
        this.reserve(len)
        mem.copy_bytes(str, this.data.@offset(this.length), len)
        this.length += len
    }
    fn write_bytes(data: ptr, length: uint) {
        @unsafe
        if length == 0 : return
        this.reserve(length)
        mem.copy_bytes(data, this.data.@offset(this.length), length)
        this.length += length
    }
}

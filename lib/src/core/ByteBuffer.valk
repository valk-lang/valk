
use mem

+ class ByteBuffer $global {
    ~ storage: String
    ~ data: ptr
    ~ size: uint
    ~ length: uint (0)
    - consumed: bool (false)

    + static fn new(start_size: uint (128)) ByteBuffer $default {
        if start_size < 32 : start_size = 32
        let storage = String.make_empty(start_size)
        return ByteBuffer {
            storage: storage
            data: storage.data
            size: start_size
        }
    }

    + fn clone() SELF $clone {
        if this.consumed : return SELF.new()
        let size = this.size
        let length = this.length
        let storage = String.make_empty(size)
        if length > 0 : mem.copy(this.data, storage.data, length)

        return SELF {
            storage: storage
            data: storage.data
            size: size
            length: length
        }
    }

    // #doc: Creates a ByteReader for this buffer
    + fn reader() ByteReader {
        return ByteReader.new(this)
    }

    + fn clear() {
        this.length = 0
    }
    + fn clear_until(index: uint) {
        let len = this.length
        if index >= len {
            this.clear()
            return
        }
        this.clear_part(0, index)
    }
    + fn clear_part(index: uint, len: uint) {
        if len == 0 || index >= this.length : return
        let data = this.data.@offset(index)
        // Limits
        let total = this.length
        let max = total - index
        if len > max : len = max
        let rem = max - len
        // Copy bytes if needed
        if rem > 0 : mem.move(data.@offset(len), data, rem)
        this.length = index + rem
    }
    + fn skip(amount: uint) {
        let start = this.length
        this.reserve_space(amount)
        mem.clear(this.data.@offset(start), amount)
        this.length += amount
    }
    // Commit bytes that a low-level writer already placed at data + length.
    + fn advance(amount: uint) {
        this.reserve_space(amount)
        this.length += amount
    }
    + fn resize(length: uint) {
        let current = this.length
        if length > current {
            this.reserve_space(length - current)
            mem.clear(this.data.@offset(current), length - current)
        }
        this.length = length
    }
    + fn truncate(length: uint) {
        if length < this.length : this.length = length
    }

    // Read
    + fn get(index: uint) u8 $offset {
        if index >= this.length : return 0
        return @ptrv(this.data, u8, index)
    }
    + fn set(index: uint, v: u8) $offset_assign $inline {
        if index >= this.length : return
        @ptrv(this.data, u8, index) = v
    }

    // Compare
    + fn equals_string(str: String) bool $eq {
        let str_len = str.bytes
        let len = this.length
        if str_len != len {
            return false
        }
        return mem.equal(this.data, str.data, len)
    }
    + fn starts_with(str: String, offset: uint) bool {
        let len = str.bytes
        if offset > this.length || len > this.length - offset : return false
        return mem.equal(this.data.@offset(offset), str.data, len)
    }

    // Find
    + fn index_of(byte: u8, start_index: uint (0)) uint !LookupError {
        let len = this.length
        if start_index >= len : throw .missing
        let data: ptr = this.data
        let res = mem.find_char(data + start_index, byte, len - start_index) ! throw .missing
        return res + start_index
    }

    + fn index_where_byte_is_not(byte: u8, start_index: uint (0)) uint !LookupError {
        let index = start_index
        let len = this.length
        let data: ptr = this.data
        while index < len {
            let ch = @ptrv(data, u8, index)
            if ch != byte : return index
            index++
        }
        throw .missing
    }

    /////////////////////////
    // String functions
    /////////////////////////

    + fn to_string() String $auto {
        if this.length == 0 : return ""
        let str = String.make_empty(this.length)
        mem.copy(this.data, str.data, this.length)
        return str
    }

    + fn into_string() String {
        if this.consumed : return ""
        if this.length == 0 {
            this.storage = ""
            this.size = 0
            this.consumed = true
            return ""
        }
        @ptrv(this.data, u8, this.length) = 0
        let result = this.storage.take_length(this.length)
        this.storage = ""
        this.length = 0
        this.size = 0
        this.consumed = true
        return result
    }

    + fn part(start_index: uint, length: uint) String {
        let len = this.length
        if length == 0 || start_index >= len : return ""
        let remain = len - start_index
        let real_len = length > remain ? remain : length
        return String.make_from_ptr(this.data.@offset(start_index), real_len)
    }

    + fn view(offset: uint, length: uint) ByteView[ByteBuffer] $inline {
        return ByteView[ByteBuffer].new(this, offset, length)
    }

    + fn ref(offset: uint, length: uint) ByteView[ByteBuffer] $inline {
        return this.view(offset, length)
    }

    + fn trim(filter: fnptr(u8)(bool)) {
        this.ltrim(filter)
        this.rtrim(filter)
    }
    + fn rtrim(filter: fnptr(u8)(bool)) {
        let len = this.length
        let data = this.data
        while len-- > 0 {
            let ch = @ptrv(data, u8, len)
            if filter(ch) : continue
            break
        }
        this.length = len + 1
    }
    + fn ltrim(filter: fnptr(u8)(bool)) {
        let len = this.length
        let data = this.data
        let i: uint = 0
        while i < len {
            let ch = @ptrv(data, u8, i++)
            if filter(ch) : continue
            i--
            break
        }
        if i > 0 : this.clear_until(i)
        return
    }
    // 
    + fn reserve_space(length: uint) {
        if this.consumed : panic("Cannot write to a consumed ByteBuffer")
        let end = this.length.checked_add(length) ! panic("ByteBuffer capacity is too large")
        if end > this.size : this.minimum_size(end)
    }
    + fn minimum_size(minimum_size: uint) {
        let size: uint = this.size
        let new_size: uint = size
        if new_size < 32 : new_size = 32
        while new_size < minimum_size {
            new_size = new_size.checked_add(new_size) ! panic("ByteBuffer capacity is too large")
        }
        if (new_size != size) {
            let storage = String.make_empty(new_size)
            mem.copy(this.data, storage.data, this.length)
            this.storage = storage
            this.data = storage.data
            this.size = new_size
        }
    }

    + fn reduce_size(size: uint) {
        if size < 32 : size = 32
        if size >= this.size : return
        let len = this.length
        if len > size : size = len
        let storage = String.make_empty(size)
        mem.copy(this.data, storage.data, len)
        this.storage = storage
        this.data = storage.data
        this.size = size
    }

    ////////////////////////
    // Write
    ////////////////////////

    + fn write_uint_ascii(v: uint, base: u8 (10)) {
        this.reserve_space(65)
        this.length += v.to_base_to_ptr(base, this.data.@offset(this.length))
    }
    + fn write_int_ascii(v: int, base: u8 (10)) {
        this.reserve_space(65)
        this.length += v.to_base_to_ptr(base, this.data.@offset(this.length))
    }
    + fn write_f64_ascii(v: f64, decimals: uint (2), trim_zeros: bool (false)) {
        this.reserve_space(64)
        this.length += v.to_string_in_ptr(this.data.@offset(this.length), decimals, trim_zeros)
    }
    + fn write_f64(v: f64) {
        this.reserve_space(64)
        this.length += v.to_shortest_string_in_ptr(this.data.@offset(this.length))
    }
    + fn write_byte(v: u8) {
        this.reserve_space(1)
        @ptrv(this.data, u8, this.length++) = v
    }
    + fn write_u16_be(v: u16) {
        this.write_big_endian(v, 2)
    }
    + fn write_u16_le(v: u16) {
        this.write_little_endian(v, 2)
    }
    + fn write_u32_be(v: u32) {
        this.write_big_endian(v, 4)
    }
    + fn write_u32_le(v: u32) {
        this.write_little_endian(v, 4)
    }
    + fn write_u64_string(v: u64) {
        let bytes = size_of(u64)
        this.reserve_space(bytes)
        mem.copy(&v, this.data.@offset(this.length), bytes)
        this.length += bytes
    }
    + fn write_u64_be(v: u64) {
        this.write_big_endian(v, 8)
    }
    + fn write_u64_le(v: u64) {
        this.write_little_endian(v, 8)
    }
    + fn write_f64_be(v: f64) {
        this.write_big_endian(f64_to_bits(v), size_of(f64))
    }
    + fn write_f64_le(v: f64) {
        this.write_little_endian(f64_to_bits(v), size_of(f64))
    }

    + fn fill(with: u8, amount: uint) {
        if amount == 0 : return
        this.reserve_space(amount)
        while amount-- > 0 : this.write_byte(with)
    }
    + fn clear_next_bytes(amount: uint) {
        this.reserve_space(amount)
        mem.clear(this.data.@offset(this.length), amount)
    }

    + fn write_little_endian(value: uint, bytes: uint) {
        this.reserve_space(bytes)
        write_little_endian(this.data.@offset(this.length), value, bytes)
        this.length += bytes
    }
    + fn write_big_endian(value: uint, bytes: uint) {
        this.reserve_space(bytes)
        write_big_endian(this.data.@offset(this.length), value, bytes)
        this.length += bytes
    }
    // String
    + fn write_string(str: String) {
        let len = str.length
        this.reserve_space(len)
        mem.copy(str.data, this.data.@offset(this.length), len)
        this.length += len
    }
    + fn write_cstring(str: cstring, include_zero_byte: bool) {
        let len = str.length()
        if include_zero_byte : len = len.checked_add(1) ! panic("ByteBuffer capacity is too large")
        this.reserve_space(len)
        mem.copy(str, this.data.@offset(this.length), len)
        this.length += len
    }
    + fn write_buffer(buf: ByteBuffer, offset: uint (0)) {
        this.write_buffer_part(buf, buf.length, offset)
    }
    + fn write_buffer_part(buf: ByteBuffer, len: uint, offset: uint (0)) {
        if len == 0 || offset > buf.length : return
        let remain = buf.length - offset
        if len > remain : len = remain
        this.reserve_space(len)
        mem.copy(buf.data.@offset(offset), this.data.@offset(this.length), len)
        this.length += len
    }
    + fn write_from_ptr(data: ptr, length: uint) {
        if length == 0 : return
        this.reserve_space(length)
        mem.copy(data, this.data.@offset(this.length), length)
        this.length += length
    }
}

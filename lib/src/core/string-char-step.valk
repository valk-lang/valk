
struct CharStep {
    source: String
    pos: uint

    fn set(str: String) {
        this.source = str
        this.pos = 0
    }
    fn skip_bytes(len: uint) {
        let left = this.source.bytes - this.pos
        this.pos += len < left ? len : left
    }

    fn next() u8 !IterError {
        let pos = this.pos
        let bytes = this.source.bytes
        if pos >= bytes : throw .end
        let byte = this.source[pos]
        let bytec: u8 = 1
        if ((byte & 128) > 0) {
            byte = byte << 1
            while (byte & 128) > 0 {
                bytec++
                byte = byte << 1
            }
            if bytec > 4 : bytec = 1
            if pos + bytec > bytes : bytec -= (pos + bytec - bytes).to(u8)
        }
        this.pos = pos + bytec
        return bytec
    }
}

/// An iterator over the UTF-8 characters of a string, returned by `str.utf8.chars()`.
///
/// `each str.utf8.chars() as ch` yields each character as its own `String`. Characters are
/// delimited by their lead byte only; a stray continuation byte or an invalid lead byte is
/// yielded as a one-byte string, and sequences are not validated.
+ struct StringChars {
    source: String
    pos: uint

    fn _next(index: uint) String !IterError {
        @unsafe
        // `skip` seeds the loop index, so an iteration that starts past the
        // beginning has to move this iterator to that character first
        if index > 0 && this.pos == 0 {
            let leading = CharStep { source: this.source, pos: 0 }
            let skipped: uint = 0
            while skipped < index {
                leading.next() !>
                skipped++
            }
            this.pos = leading.pos
        }
        let step = CharStep { source: this.source, pos: this.pos }
        let count = step.next() !>
        let start = this.pos
        this.pos = step.pos
        return String.copy_from_ptr(this.source.data.@offset(start), count.to(uint))
    }
}

#if TEST
/// Test hook: returns the byte position after skipping `bytes` bytes, clamped to the end.
+ fn char_step_skip_for_test(str: String, bytes: uint) uint {
    let step = CharStep { source: str, pos: 0 }
    step.skip_bytes(bytes)
    return step.pos
}

/// Test hook: returns the byte length of the character at byte `offset`, or 0 at the end.
///
/// The length comes from the lead byte and is cut short when the string ends early.
+ fn char_step_next_for_test(str: String, offset: uint (0)) u8 {
    let step = CharStep { source: str, pos: 0 }
    step.skip_bytes(offset)
    return step.next() !? 0
}
#end

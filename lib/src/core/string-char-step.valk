
struct CharStep {
    source: String
    pos: uint

    fn set(str: String) {
        this.source = str
        this.pos = 0
    }
    fn skip_bytes(len: uint) {
        let left = this.source.bytes - this.pos
        this.pos += len < left ? len : left
    }

    fn next() u8 !IterError {
        let pos = this.pos
        let bytes = this.source.bytes
        if pos >= bytes : throw .end
        let byte = this.source[pos]
        let bytec: u8 = 1
        if ((byte & 128) > 0) {
            byte = byte << 1
            while (byte & 128) > 0 {
                bytec++
                byte = byte << 1
            }
            if bytec > 4 : bytec = 1
            if pos + bytec > bytes : bytec -= (pos + bytec - bytes).to(u8)
        }
        this.pos = pos + bytec
        return bytec
    }
}

// `each str.utf8.chars() as ch`: one String per Unicode character
+ struct StringChars {
    source: String
    pos: uint

    fn _next(index: uint) String !IterError {
        @unsafe
        let step = CharStep { source: this.source, pos: this.pos }
        let count = step.next() !>
        let start = this.pos
        this.pos = step.pos
        return String.copy_from_ptr(this.source.data.@offset(start), count.to(uint))
    }
}

#if TEST
+ fn char_step_skip_for_test(str: String, bytes: uint) uint {
    let step = CharStep { source: str, pos: 0 }
    step.skip_bytes(bytes)
    return step.pos
}

+ fn char_step_next_for_test(str: String, offset: uint (0)) u8 {
    let step = CharStep { source: str, pos: 0 }
    step.skip_bytes(offset)
    return step.next() !? 0
}
#end

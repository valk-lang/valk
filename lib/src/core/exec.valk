
use ext

#if OS == "win"
use fs
#end

// execute command and return exit-code
+ fn exec(cmd: String, print_output: bool (false)) (i32, String) {

    #if OS == "win"
    let cwd = fs:cwd() ! return (1, "Exec failed to read the working directory")
    let revert_cwd = false
    if cwd.starts_with("\\\\") {
        revert_cwd = true
        fs:chdir("C:/") ! return (1, "Exec failed to change the working directory")
    }
    #end

    cmd += " 2>&1"
    let buf = ByteBuffer.new(1024)
    let cstr_buf : [u8 x 1024] = @undefined
    let cstr: cstring = &cstr_buf

    let pipe = ext:popen(cmd.data_cstring, "r".data_cstring)
    if !isset(pipe) {
        #if OS == "win"
        if revert_cwd : fs:chdir(cwd) ! return (1, "Exec failed to restore the working directory")
        #end
        return (1, "Exec failed to open process")
    }

    // TODO: non-blocking/poll?
    while ext:fgets(cstr, 1024, pipe) != null {
        buf.write_cstring(cstr, false)
        if print_output : print(cstr)
    }

    let exit_code : i32 = 0
    let status = ext:pclose(pipe)

    #if OS == "win"
    if revert_cwd : fs:chdir(cwd) ! return (1, "Exec failed to restore the working directory")
    #end

    if status == -1 : return (1, "Exec failed to close process")
    exit_code = WEXITSTATUS(status)
    return (exit_code, buf.to_string())
}

fn WEXITSTATUS(status: i32) i32 {
    #if OS == "win"
    return status
    #else
    return (status & 0xff00) >> 8
    #end
}

@unsafe

use ext

#if OS == "win"
use fs
#end

// execute command and return exit-code
+ value EXEC_FAILED (-1)

+ fn exec(cmd: String, print_output: bool (false), capture_stderr: bool (true)) (i32, String) {
    #if OS == "win"
    let cwd = fs.cwd() ! return (EXEC_FAILED, "Exec failed to read the working directory")
    let revert_cwd = false
    if cwd.starts_with("\\\\") {
        revert_cwd = true
        fs.chdir("C:/") ! return (EXEC_FAILED, "Exec failed to change the working directory")
    }
    #end

    let command = cmd + (capture_stderr ? " 2>&1" : "")
    let buf = ByteBuffer.new(1024)
    let read_buf: [u8 x 4096] = @undefined

    #if OS == "win"
    let mode = "rb"
    #else
    let mode = "r"
    #end
    let pipe = ext.popen(command.data_cstring, mode.data_cstring)
    if !isset(pipe) {
        #if OS == "win"
        if revert_cwd : fs.chdir(cwd) ! return (EXEC_FAILED, "Exec failed to restore the working directory")
        #end
        return (EXEC_FAILED, "Exec failed to open process")
    }

    while true {
        let read = ext.fread(@ref(read_buf), 1, 4096, pipe)
        if read == 0 : break
        buf.write_bytes(@ref(read_buf), read)
        if print_output : exec_write_stdout(@ref(read_buf), read)
    }

    let status = ext.pclose(pipe)

    #if OS == "win"
    if revert_cwd : fs.chdir(cwd) ! return (EXEC_FAILED, "Exec failed to restore the working directory")
    #end

    if status == -1 : return (EXEC_FAILED, "Exec failed to close process")
    return (exec_status(status), buf.to_string())
}

fn exec_status(status: i32) i32 {
    #if OS == "win"
    return status
    #else
    return process_status(status)
    #end
}

fn exec_write_stdout(data: ptr, length: uint) {
    while length > 0 {
        #if OS == "win"
        let written = ext.write(1, data, length.to(u32))
        #else
        let written = ext.write(1, data, length)
        #end
        if written <= 0 {
            #if OS != "win"
            if written < 0 && ext.get_errno() == ext.EINTR : continue
            #end
            return
        }
        data += written.to(uint)
        length -= written.to(uint)
    }
}

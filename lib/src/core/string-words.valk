
/// An iterator over the words of a string, returned by `str.words()`.
///
/// Words are the runs of bytes between ASCII whitespace (`u8.is_whitespace`); each is a view
/// into the string, nothing is copied.
+ struct StringWords {
    source: String
    pos: uint

    fn _next(index: uint) String !IterError {
        // `skip` seeds the loop index, so an iteration that starts past the
        // beginning has to move this iterator to that word first
        if index > 0 && this.pos == 0 {
            let skipped: uint = 0
            while skipped < index {
                this.next_word() !>
                skipped++
            }
        }
        return this.next_word() !>
    }

    fn next_word() String !IterError {
        let source = this.source
        let len = source.bytes
        let i = this.pos
        while i < len && source[i].is_whitespace() : i++
        if i >= len {
            this.pos = len
            throw .end
        }
        let start = i
        while i < len && !source[i].is_whitespace() : i++
        this.pos = i
        return source.range(start, i - start)
    }
}


use ext
use gc
use mem

+ class Process {
    #if OS == "win"
    - pid: ext:HANDLE
    #else
    - pid: i32
    #end
    - exited: bool (false)
    - stopped: bool (false)

    + static fn run(exe: String, args: ?Array[String], print_output: bool (false)) SELF !ExternError {

        #if OS == "win"
        let cmd = exe + (isset(args) ? " " + args.join(" ") : "")
        // if !print_output : cmd += " 2>&1"
        let si : ext:STARTUPINFOA = @undefined
        let pi : ext:PROCESS_INFORMATION = @undefined
        if ext:CreateProcessA(null, cmd.data, null, null, print_output ? 1 : 0, 0, null, null, @ref(si), @ref(pi)) == 0 {
            throw .extern
        }

        if ext:CloseHandle(pi.hThread) == 0 : panic("Failed to close process thread handle")
        let pid = pi.hProcess // Process handle

        #else
        let argv = Array[?cstring]{}
        argv.append(exe.data_cstring)
        if isset(args) {
            each args as arg {
                argv.append(arg.data_cstring)
            }
        }
        argv.append(null)

        let pid = ext:fork()
        if pid == 0 {
            if !print_output {
                if ext:close(ext:STDOUT_FILENO) != 0 : exit(1)
                if ext:close(ext:STDERR_FILENO) != 0 : exit(1)
            }
            if ext:execvp(exe.data_cstring, argv.data.@cast(*?cstring)) < 0 : exit(1)
            exit(0)
        }
        if pid < 0 : throw .extern
        #end

        return SELF {
            pid: pid
        }
    }

    + fn did_exit() bool {
        if this.exited : return true

        #if OS == "win"
        let res = ext:WaitForSingleObject(this.pid, 0) // 0 = no wait
        if res == ext:WAIT_TIMEOUT : return false
        if res == ext:INVALID_HANDLE_VALUE : panic("Failed to query process state")
        #else
        let status : i32 = 0
        let ret = 0
        while true {
            ret = ext:waitpid(this.pid, @ref(status), ext:WNOHANG)
            if ret >= 0 || ext:errno != ext:EINTR : break
        }
        if ret == 0 : return false
        if ret < 0 : panic("Failed to query process state")
        #end

        this.exited = true
        return true
    }

    + fn stop() {
        if this.stopped : return
        if this.did_exit() {
            this.stopped = true
            return
        }
        #if OS == "win"
        if ext:TerminateProcess(this.pid, 0) == 0 : panic("Failed to terminate process")
        #else
        while ext:kill(this.pid, ext:SIGKILL) != 0 {
            if ext:errno != ext:EINTR : panic("Failed to terminate process")
        }
        #end
        this.stopped = true
    }

    fn gc_free() {
        #if OS == "win"
        if ext:CloseHandle(this.pid) == 0 : panic("Failed to close process handle")
        #end
    }
}

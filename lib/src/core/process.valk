
use ext
use gc
use mem

+ class Process {
    #if OS == "win"
    - pid: ext.HANDLE
    #else
    - pid: i32
    #end
    - exited: bool (false)
    - stopped: bool (false)
    - status: ?i32 (null)

    + static fn run(exe: String, args: ?Array[String], print_output: bool (false)) SELF !ExternError {
        #if OS == "win"
        let cmd = exe + (isset(args) ? " " + args.join(" ") : "")
        // if !print_output : cmd += " 2>&1"
        let si: ext.STARTUPINFOA = @undefined
        let pi: ext.PROCESS_INFORMATION = @undefined
        if ext.CreateProcessA(null, cmd.data, null, null, print_output ? 1 : 0, 0, null, null, @ref(si), @ref(pi)) == 0 {
            throw .extern
        }

        if ext.CloseHandle(pi.hThread) == 0 {
            cleanup_warning("Failed to close process thread handle", __FILE__, __LINE__)
        }
        let pid = pi.hProcess // Process handle

        #else
        let argv_strings = Array[String]{ exe }
        if isset(args) {
            each args as arg : argv_strings.append(arg)
        }
        let argv = Array[?cstring]{}
        each argv_strings as arg : argv.append(arg.data_cstring)
        argv.append(null)

        let pid = ext.fork()
        if pid == 0 {
            if !print_output {
                if ext.close(ext.STDOUT_FILENO) != 0 : ext._exit(1)
                if ext.close(ext.STDERR_FILENO) != 0 : ext._exit(1)
            }
            ext.execvp(exe.data_cstring, argv.data.@cast(*?cstring))
            ext._exit(127)
        }
        if pid < 0 : throw .extern
        // Keep every String backing argv live until fork has returned in the parent.
        if argv_strings.length == 0 : throw .extern
        #end

        return SELF {
            pid: pid
        }
    }

    + fn did_exit() bool !ExternError {
        if this.exited : return true

        #if OS == "win"
        let res = ext.WaitForSingleObject(this.pid, 0) // 0 = no wait
        if res == ext.WAIT_TIMEOUT : return false
        if res == ext.INVALID_HANDLE_VALUE : throw .extern
        let status: u32 = 0
        if ext.GetExitCodeProcess(this.pid, @ref(status)) == 0 : throw .extern
        this.status = status.to(i32)
        #else
        let status: i32 = 0
        let ret = 0
        while true {
            ret = ext.waitpid(this.pid, @ref(status), ext.WNOHANG)
            if ret >= 0 || ext.get_errno() != ext.EINTR : break
        }
        if ret == 0 : return false
        if ret < 0 : throw .extern
        this.status = process_status(status)
        #end

        this.exited = true
        return true
    }

    + fn exit_code() i32 !ExternError {
        if !this.exited {
            #if OS == "win"
            let res = ext.WaitForSingleObject(this.pid, ext.INFINITE)
            if res == ext.INVALID_HANDLE_VALUE : throw .extern
            let status: u32 = 0
            if ext.GetExitCodeProcess(this.pid, @ref(status)) == 0 : throw .extern
            this.status = status.to(i32)
            #else
            let status: i32 = 0
            let ret: i32 = 0
            while true {
                ret = ext.waitpid(this.pid, @ref(status), 0)
                if ret >= 0 || ext.get_errno() != ext.EINTR : break
            }
            if ret < 0 : throw .extern
            this.status = process_status(status)
            #end
            this.exited = true
        }
        return this.status ?? 0
    }

    + fn stop() !ExternError {
        if this.stopped : return
        if this.did_exit() !> {
            this.stopped = true
            return
        }
        #if OS == "win"
        if ext.TerminateProcess(this.pid, 137) == 0 : throw .extern
        #else
        while ext.kill(this.pid, ext.SIGKILL) != 0 {
            if ext.get_errno() != ext.EINTR : throw .extern
        }
        #end
        this.stopped = true
        this.exit_code() !? 0
    }

    fn gc_free() {
        #if OS == "win"
        if ext.CloseHandle(this.pid) == 0 {
            cleanup_warning("Failed to close process handle", __FILE__, __LINE__)
        }
        #end
    }
}

#if OS != "win"
fn process_status(status: i32) i32 {
    let signal = status & 0x7f
    if signal == 0 : return (status >> 8) & 0xff
    return 128 + signal
}
#end

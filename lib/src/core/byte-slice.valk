use mem

extend &[T] {
    #if T.$is_type_of(u8)

    fn byte(index: uint) u8 $inline {
        return this.get(index) ! panic("Byte slice index is out of bounds")
    }

    /// Returns whether any byte is an ASCII control character (below 32, or 127 DEL).
    ///
    /// With `allow_tab`, the tab byte `\t` does not count as a control character.
    + fn has_ascii_control(allow_tab: bool (false)) bool $inline {
        let length = this.length
        let data = this.data
        let i: uint = 0
        let high: u64 = 0x8080808080808080
        let ones: u64 = 0x0101010101010101
        while length - i >= 8 {
            let word = @ptrv(data.@offset(i), u64)
            let low = (word - 0x2020202020202020) & ~word & high
            let del = word ^ 0x7f7f7f7f7f7f7f7f
            let has_del = (del - ones) & ~del & high
            if low != 0 || has_del != 0 {
                let end = i + 8
                while i < end {
                    let ch = @ptrv(data, u8, i++)
                    if (ch < 32 && (!allow_tab || ch != '\t')) || ch == 127 : return true
                }
            } else {
                i += 8
            }
        }
        while i < length {
            let ch = @ptrv(data, u8, i++)
            if (ch < 32 && (!allow_tab || ch != '\t')) || ch == 127 : return true
        }
        return false
    }

    /// Returns a `ByteReader` that reads these bytes from the start without copying them.
    + fn reader() ByteReader {
        return ByteReader.new(this)
    }

    /// Returns a new `String` holding a copy of the bytes.
    + fn to_string() String {
        @unsafe
        let length = this.length
        if length == 0 : return ""
        return String.copy_from_ptr(this.data, length)
    }

    /// Returns a new `String` holding a copy of the bytes with `A`-`Z` lowered to `a`-`z`.
    ///
    /// Bytes outside ASCII are copied unchanged.
    + fn to_ascii_lower_string() String {
        @unsafe
        let result = this.to_string()
        mem.ascii_bytes_to_lower(result.data, result.bytes)
        return result
    }

    /// Parses the bytes as a decimal unsigned integer, with an optional leading `+`.
    ///
    /// Throws `SyntaxError` for an empty slice, any byte other than the digits `0`-`9` after
    /// the sign, or a value that does not fit.
    + fn to_uint() uint !SyntaxError $inline {
        return this.parse_uint() ! throw .syntax
    }

    /// Parses the bytes as a decimal signed integer with an optional `-` or `+` sign.
    ///
    /// Throws `SyntaxError` for an empty slice, any byte that is not a digit after the sign, or
    /// a value outside the `int` range.
    + fn to_int() int !SyntaxError $inline {
        return this.parse_int() ! throw .syntax
    }

    /// Parses the bytes as a decimal floating-point number, with the rules of `String.to_float`.
    ///
    /// Accepts an optional `-` or `+` sign, digits with at most one `.` (at least one digit is
    /// required), and an optional `e`/`E` exponent with its own sign. Throws `SyntaxError` for
    /// other bytes, input without mantissa digits such as `"."` or `"e5"`, more than 768 bytes,
    /// an exponent above 400, or a value that overflows to infinity.
    + fn to_float() float !SyntaxError $inline {
        return this.parse_float() ! throw .syntax
    }

    // The parsers below share the pointer readers, so String, &[u8], ptr and ByteReader
    // accept exactly the same text.
    fn parse_uint() uint !SyntaxError $inline {
        @unsafe
        let data: ptr = this.data
        return data.read_uint(this.length) ! throw .syntax
    }

    fn parse_int() int !SyntaxError $inline {
        @unsafe
        let data: ptr = this.data
        return data.read_int(this.length) ! throw .syntax
    }

    fn parse_octal_uint() uint !SyntaxError $inline {
        @unsafe
        let data: ptr = this.data
        return data.read_octal_uint(this.length) ! throw .syntax
    }

    fn parse_octal_int() int !SyntaxError $inline {
        @unsafe
        let data: ptr = this.data
        return data.read_octal_int(this.length) ! throw .syntax
    }

    fn parse_hex_uint() uint !SyntaxError $inline {
        @unsafe
        let data: ptr = this.data
        return data.read_hex_uint(this.length) ! throw .syntax
    }

    fn parse_hex_int() int !SyntaxError $inline {
        @unsafe
        let data: ptr = this.data
        return data.read_hex_int(this.length) ! throw .syntax
    }

    fn parse_float() float !SyntaxError $inline {
        @unsafe
        let data: ptr = this.data
        return data.read_float(this.length) ! throw .syntax
    }

    /// Returns whether the bytes are exactly the bytes of `cmp`.
    + fn equals(cmp: String) bool $inline {
        return this.equals_at(0, this.length, cmp)
    }

    /// Returns whether the bytes equal `cmp` when ASCII letters are compared case-insensitively.
    ///
    /// Bytes outside ASCII must match exactly.
    + fn equals_ignore_ascii_case(cmp: String) bool $inline {
        return this.equals_at_ignore_ascii_case(0, this.length, cmp)
    }

    /// Returns whether the `length` bytes at `offset` are exactly the bytes of `cmp`.
    ///
    /// Returns false when `length` differs from the byte length of `cmp` or the range runs past
    /// the end of the slice.
    + fn equals_at(offset: uint, length: uint, cmp: String) bool $inline {
        if length != cmp.bytes : return false
        // The check cannot be left to the clamped view: an offset past the end also
        // yields an empty view, which would pass for an empty `cmp`
        if offset > this.length || length > this.length - offset : return false
        @unsafe
        return mem.equals_bytes(this.data.@offset(offset), cmp.data, length)
    }

    /// Returns whether the `length` bytes at `offset` equal `cmp`, ignoring ASCII case.
    ///
    /// Returns false when `length` differs from the byte length of `cmp` or the range runs past
    /// the end of the slice. Bytes outside ASCII must match exactly.
    + fn equals_at_ignore_ascii_case(offset: uint, length: uint, cmp: String) bool $inline {
        if length != cmp.bytes : return false
        if offset > this.length || length > this.length - offset : return false
        @unsafe
        return mem.ascii_bytes_equal_ignore_case(this.data.@offset(offset), cmp.data, length)
    }

    /// Returns whether the slice begins with the bytes of `cmp`; an empty `cmp` always matches.
    + fn starts_with(cmp: String) bool $inline {
        let length = this.length
        if cmp.bytes > length : return false
        @unsafe
        return mem.equals_bytes(this.data, cmp.data, cmp.bytes)
    }

    /// Returns the index of the first `byte` at or after `start_index`.
    ///
    /// The index counts from the start of the slice. Throws `LookupError` when the byte does not
    /// occur or `start_index` is at or past the end.
    + fn index_of_byte(byte: u8, start_index: uint (0)) uint !LookupError $inline {
        let length = this.length
        if start_index >= length : throw .missing
        let view = this.view(start_index, length - start_index)
        @unsafe
        let found = mem.find_char_bytes(view.data, byte, view.length) ! throw .missing
        return start_index + found
    }
    #end
}

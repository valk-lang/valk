fn unicode_hex_value(byte: u8) u32 {
    if byte <= '9' : return (byte - '0').to(u32)
    return (byte - 'a' + 10).to(u32)
}

fn unicode_table_get(table: String, index: uint) u32 {
    let offset = index * 6
    let value: u32 = 0
    let count: uint = 0
    while count < 6 {
        value = (value << 4) | unicode_hex_value(table[offset + count])
        count++
    }
    return value
}

fn unicode_table_length(table: String) uint {
    return table.bytes / 6
}

fn unicode_in_ranges(code: u32, ranges: String) bool {
    let low: uint = 0
    let high = unicode_table_length(ranges) / 2
    while low < high {
        let middle = low + (high - low) / 2
        let offset = middle * 2
        let first = unicode_table_get(ranges, offset)
        let last = unicode_table_get(ranges, offset + 1)
        if code < first {
            high = middle
        } else if code > last {
            low = middle + 1
        } else {
            return true
        }
    }
    return false
}

struct UnicodeChar {
    code: u32
    count: uint
    valid: bool
}

fn unicode_read(str: String, offset: uint) UnicodeChar {
    let bytes = str.bytes
    let first = str[offset]
    if first < 0x80 : return UnicodeChar { code: first.to(u32), count: 1, valid: true }

    let count: uint = 0
    let code: u32 = 0
    let minimum: u32 = 0
    if (first & 0xe0) == 0xc0 {
        count = 2
        code = (first & 0x1f).to(u32)
        minimum = 0x80
    } else if (first & 0xf0) == 0xe0 {
        count = 3
        code = (first & 0x0f).to(u32)
        minimum = 0x800
    } else if (first & 0xf8) == 0xf0 {
        count = 4
        code = (first & 0x07).to(u32)
        minimum = 0x10000
    } else {
        return UnicodeChar { code: first.to(u32), count: 1, valid: false }
    }
    if count > bytes - offset : return UnicodeChar { code: first.to(u32), count: 1, valid: false }

    let index: uint = 1
    while index < count {
        let next = str[offset + index]
        if (next & 0xc0) != 0x80 : return UnicodeChar { code: first.to(u32), count: 1, valid: false }
        code = (code << 6) | (next & 0x3f).to(u32)
        index++
    }
    if code < minimum || code > 0x10ffff || (code >= 0xd800 && code <= 0xdfff) {
        return UnicodeChar { code: first.to(u32), count: 1, valid: false }
    }
    return UnicodeChar { code: code, count: count, valid: true }
}

fn unicode_write(buf: ByteBuffer, code: u32) {
    if code < 0x80 {
        buf.write_byte(code.to(u8))
    } else if code < 0x800 {
        buf.write_byte((0xc0 | (code >> 6)).to(u8))
        buf.write_byte((0x80 | (code & 0x3f)).to(u8))
    } else if code < 0x10000 {
        buf.write_byte((0xe0 | (code >> 12)).to(u8))
        buf.write_byte((0x80 | ((code >> 6) & 0x3f)).to(u8))
        buf.write_byte((0x80 | (code & 0x3f)).to(u8))
    } else {
        buf.write_byte((0xf0 | (code >> 18)).to(u8))
        buf.write_byte((0x80 | ((code >> 12) & 0x3f)).to(u8))
        buf.write_byte((0x80 | ((code >> 6) & 0x3f)).to(u8))
        buf.write_byte((0x80 | (code & 0x3f)).to(u8))
    }
}

fn unicode_write_map(code: u32, ranges: String, singles: String, expansions: String, expansion_values: String, buf: ByteBuffer) bool {
    let offset: uint = 0
    let ranges_length = unicode_table_length(ranges)
    while offset < ranges_length {
        let first = unicode_table_get(ranges, offset)
        let last = unicode_table_get(ranges, offset + 1)
        let step = unicode_table_get(ranges, offset + 2)
        if code >= first && code <= last && (code - first) % step == 0 {
            unicode_write(buf, unicode_table_get(ranges, offset + 3) + code - first)
            return true
        }
        offset += 4
    }

    let low: uint = 0
    let high = unicode_table_length(singles) / 2
    while low < high {
        let middle = low + (high - low) / 2
        let at = middle * 2
        let source = unicode_table_get(singles, at)
        if code < source {
            high = middle
        } else if code > source {
            low = middle + 1
        } else {
            unicode_write(buf, unicode_table_get(singles, at + 1))
            return true
        }
    }

    low = 0
    high = unicode_table_length(expansions) / 3
    while low < high {
        let middle = low + (high - low) / 2
        let at = middle * 3
        let source = unicode_table_get(expansions, at)
        if code < source {
            high = middle
        } else if code > source {
            low = middle + 1
        } else {
            let value_offset = unicode_table_get(expansions, at + 1).to(uint)
            let count = unicode_table_get(expansions, at + 2).to(uint)
            let index: uint = 0
            while index < count {
                unicode_write(buf, unicode_table_get(expansion_values, value_offset + index))
                index++
            }
            return true
        }
    }
    return false
}

fn unicode_has_map(code: u32, ranges: String, singles: String, expansions: String) bool {
    let offset: uint = 0
    let ranges_length = unicode_table_length(ranges)
    while offset < ranges_length {
        let first = unicode_table_get(ranges, offset)
        let last = unicode_table_get(ranges, offset + 1)
        let step = unicode_table_get(ranges, offset + 2)
        if code >= first && code <= last && (code - first) % step == 0 : return true
        offset += 4
    }

    let low: uint = 0
    let high = unicode_table_length(singles) / 2
    while low < high {
        let middle = low + (high - low) / 2
        let source = unicode_table_get(singles, middle * 2)
        if code < source : high = middle
        else if code > source : low = middle + 1
        else : return true
    }

    low = 0
    high = unicode_table_length(expansions) / 3
    while low < high {
        let middle = low + (high - low) / 2
        let source = unicode_table_get(expansions, middle * 3)
        if code < source : high = middle
        else if code > source : low = middle + 1
        else : return true
    }
    return false
}

fn unicode_has_lower_mapping(code: u32) bool {
    if code < 0x80 : return code >= 'A' && code <= 'Z'
    return unicode_has_map(code, unicode_lower_ranges, unicode_lower_singles, unicode_lower_expansions)
}

fn unicode_has_upper_mapping(code: u32) bool {
    if code < 0x80 : return code >= 'a' && code <= 'z'
    return unicode_has_map(code, unicode_upper_ranges, unicode_upper_singles, unicode_upper_expansions)
}

fn unicode_has_cased_after(str: String, offset: uint) bool {
    let bytes = str.bytes
    while offset < bytes {
        let char = unicode_read(str, offset)
        if !char.valid : return false
        if unicode_in_ranges(char.code, unicode_cased_ranges) : return true
        if !unicode_in_ranges(char.code, unicode_case_ignorable_ranges) : return false
        offset += char.count
    }
    return false
}

fn unicode_lower_string(str: String) String {
    let buf = ByteBuffer.new(str.bytes)
    let bytes = str.bytes
    let offset: uint = 0
    let had_cased = false
    while offset < bytes {
        let char = unicode_read(str, offset)
        if !char.valid {
            buf.write_byte(char.code.to(u8))
            had_cased = false
            offset++
            continue
        }

        if char.code == 0x3a3 && had_cased && !unicode_has_cased_after(str, offset + char.count) {
            unicode_write(buf, 0x3c2)
        } else if !unicode_write_map(char.code, unicode_lower_ranges, unicode_lower_singles, unicode_lower_expansions, unicode_lower_expansion_values, buf) {
            unicode_write(buf, char.code)
        }

        if unicode_in_ranges(char.code, unicode_cased_ranges) {
            had_cased = true
        } else if !unicode_in_ranges(char.code, unicode_case_ignorable_ranges) {
            had_cased = false
        }
        offset += char.count
    }
    return buf.into_string()
}

fn unicode_upper_string(str: String) String {
    let buf = ByteBuffer.new(str.bytes)
    let bytes = str.bytes
    let offset: uint = 0
    while offset < bytes {
        let char = unicode_read(str, offset)
        if !char.valid {
            buf.write_byte(char.code.to(u8))
            offset++
            continue
        }
        if !unicode_write_map(char.code, unicode_upper_ranges, unicode_upper_singles, unicode_upper_expansions, unicode_upper_expansion_values, buf) {
            unicode_write(buf, char.code)
        }
        offset += char.count
    }
    return buf.into_string()
}

fn unicode_string_is_lower(str: String) bool {
    let offset: uint = 0
    while offset < str.bytes {
        let char = unicode_read(str, offset)
        if char.valid && unicode_has_lower_mapping(char.code) : return false
        offset += char.count
    }
    return true
}

fn unicode_string_is_upper(str: String) bool {
    let offset: uint = 0
    while offset < str.bytes {
        let char = unicode_read(str, offset)
        if char.valid && unicode_has_upper_mapping(char.code) : return false
        offset += char.count
    }
    return true
}

fn unicode_string_has_only(str: String, extras: String, ranges: String) bool {
    let offset: uint = 0
    while offset < str.bytes {
        let start = offset
        let char = unicode_read(str, offset)
        if !char.valid || !unicode_in_ranges(char.code, ranges) {
            let index: uint = 0
            while index < char.count {
                if !extras.contains_byte(str[start + index]) : return false
                index++
            }
        }
        offset += char.count
    }
    return true
}

use io
use mem

+ pointer ptr $global {
    use PointerRead
    use PointerWrite

    + fn to_hex() String $auto {
        let address: uint = this
        return address.to_hex()
    }

    + fn index_of_byte(byte: u8, memory_size: uint) uint !LookupError {
        @unsafe
        let data: *[u8] = this
        let index: uint = 0
        let len = memory_size
        while index < len {
            let ch = data[index]
            if ch == byte : return index
            index++
        }
        throw .missing
    }
    + fn index_of_byte_inf(byte: u8) uint {
        @unsafe
        let data: *[u8] = this
        let index: uint = 0
        while true {
            if data[index] == byte : return index
            index++
        }
        return 0
    }

    + fn print_bytes(length: uint, end_with_newline: bool (true)) {
        @unsafe
        let data: *[u8] = this
        let index: uint = 0
        while length-- > 0 {
            print("0x")
            data[index++].print(16)
            if length > 0 : print(",")
        }
        if end_with_newline : print("\n")
    }

    + fn create_string(length: uint) String {
        @unsafe
        if length == 0 : return ""
        let str = String.alloc(length)
        mem.copy_bytes(this, str.data, length)
        return str
    }
}

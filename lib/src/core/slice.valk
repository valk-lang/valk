use mem
use gc

// Every `&[T]` is `{ owner, data, length }`: a view over storage that `owner`
// keeps alive. `[T x n]{ v }` and `[T]{ a, b }` allocate fresh storage; these
// are the methods every such view offers.
extend &[T] {
    // `[T x n]{ v }`
    static fn fill(length: uint, value: T) SELF {
        @unsafe
        let result = SELF { length: length }
        let data = result.data
        let i: uint = 0
        while i < length {
            @property_init(result.owner, @ptrv(data, T, i), value)
            i++
        }
        return result
    }

    // `[T]{ a, b }` writes each element once into zeroed storage
    - fn write_init(index: uint, value: T) $inline {
        @unsafe
        @property_init(this.owner, @ptrv(this.data, T, index), value)
    }

    + fn get(index: uint) T !LookupError {
        if index >= this.length : throw .missing
        return this[index]
    }

    + fn set(index: uint, value: T) !LookupError {
        if index >= this.length : throw .range
        @property_update(this.owner, @ptrv(this.data, T, index), value)
    }

    + fn set_all(value: T) {
        let i = this.length
        let data = this.data
        while i-- > 0 {
            @property_update(this.owner, @ptrv(data, T, i), value)
        }
    }

    // A copy of `length` elements from `offset`, clamped to the slice
    + fn part(offset: uint, length: uint) SELF $range {
        @unsafe
        if offset >= this.length : return SELF { length: 0 }
        let remain = this.length - offset
        if length > remain : length = remain
        let result = SELF { length: length }
        let from = this.data
        let to = result.data
        let i: uint = 0
        while i < length {
            @property_init(result.owner, @ptrv(to, T, i), @property_get(@ptrv(from, T, offset + i)))
            i++
        }
        return result
    }

    + fn view(offset: uint, length: uint) SELF $view $inline {
        @unsafe
        if offset > this.length {
            offset = 0
            length = 0
        } else if length > this.length - offset {
            length = this.length - offset
        }
        return SELF {
            owner: this.owner
            data: @ref(@ptrv(this.data, T, offset))
            length: length
        }
    }
}

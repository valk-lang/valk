
use gc
use mem

slice Slice[T] $global {

    static fn new(length: uint (0)) SELF {
        let size = length * size_of(T)
        let data = gc:alloc(size)
        mem:clear(data, size)
        let s = SELF {
            length: length
            data: data
        }
        return s
    }

    // `$append`: class-init list form `Slice[T]{ a, b }` → new() + append each (grows)
    + fn append(item: T) SELF $append {
        let i = this.length
        let nlen = i + 1
        let nsize = nlen * size_of(T)
        let ndata = gc:alloc(nsize)
        if i > 0 {
            mem:copy(this.data, ndata, i * size_of(T))
        }
        @property_init(this, @ptrv(ndata, T, i), item)
        this.data = ndata
        this.length = nlen
        return this
    }

    + fn get(index: uint) T !LookupError $offset {
        if index >= this.length : throw .missing
        return @property_get(@ptrv(this.data, T, index))
    }

    + fn set(index: uint, value: T) !LookupError $offset_assign {
        if index >= this.length : throw .range
        @property_update(this, @ptrv(this.data, T, index), value)
    }
    + fn set_all(value: T) {
        let i = this.length
        let data = this.data
        while i-- > 0 {
            @property_update(this, @ptrv(data, T, i), value)
        }
    }

    #if T.$is_gc
    fn _props(list: gc:Lifo, func: fnptr(ptr, gc:Lifo)()) {
        let data : uint = this.data.@cast(uint)
        let end : uint = data + (this.length * size_of(T))
        while data < end {
            func(data.@cast(ptr), list)
            data += size_of(T)
        }
    }
    #end
}

use mem
use gc

+ slice Slice[T] of T $global {
    static fn from_storage(storage: gc.GcPtr, offset: uint, length: uint) SELF $inline {
        return SELF {
            _storage: storage
            offset: offset
            length: length
        }
    }

    static fn init(length: uint (0)) SELF $default {
        @unsafe
        let allocation_size = length.checked_multiply(size_of(T)) ! panic("Slice length is too large")
        let s = SELF {
            length: length
        }
        mem.clear_bytes(s.data, allocation_size)
        return s
    }

    + static fn new(length: uint, value: T) SELF {
        let result = SELF.init(length)
        let data = result.data
        let i: uint = 0
        while i < length {
            @property_init(result._storage, @ptrv(data, T, i), value)
            i++
        }
        return result
    }

    // `$append`: class-init list form `Slice[T]{ a, b }` (grows)
    + fn append(item: T) SELF $append {
        @unsafe
        let i = this.length
        let nlen = i.checked_add(1) ! panic("Slice length is too large")
        let result = SELF.init(nlen)
        if i > 0 {
            #if T.$has_gc_refs
            let from = this.data
            let to = result.data
            let copy_index: uint = 0
            while copy_index < i {
                let value = @property_get(@ptrv(from, T, copy_index))
                @property_init(result._storage, @ptrv(to, T, copy_index), value)
                copy_index++
            }
            #else
            let copy_size = i.checked_multiply(size_of(T)) ! panic("Slice length is too large")
            mem.copy_bytes(this.data, result.data, copy_size)
            #end
        }
        @property_init(result._storage, @ptrv(result.data, T, i), item)
        return result
    }

    + fn get(index: uint) T !LookupError {
        if index >= this.length : throw .missing
        return @property_get(@ptrv(this.data, T, index))
    }

    + fn set(index: uint, value: T) !LookupError {
        if index >= this.length : throw .range
        @property_update(this._storage, @ptrv(this.data, T, index), value)
    }

    + fn set_all(value: T) {
        let i = this.length
        let data = this.data
        while i-- > 0 {
            @property_update(this._storage, @ptrv(data, T, i), value)
        }
    }

    + fn view(offset: uint, length: uint) SELF $range $inline {
        if offset > this.length {
            offset = 0
            length = 0
        } else if length > this.length - offset {
            length = this.length - offset
        }
        return SELF {
            _storage: this._storage
            offset: this.offset + offset
            length: length
        }
    }
}

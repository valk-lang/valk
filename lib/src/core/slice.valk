use mem

+ slice Slice[T] of T $global {
    static fn new(length: uint (0)) SELF $default {
        @unsafe
        let allocation_size = length.checked_multiply(size_of(T)) ! panic("Slice length is too large")
        let s = SELF {
            length: length
        }
        mem.clear(s.data, allocation_size)
        return s
    }

    // `$append`: class-init list form `Slice[T]{ a, b }` (grows)
    + fn append(item: T) SELF $append {
        @unsafe
        let i = this.length
        let nlen = i.checked_add(1) ! panic("Slice length is too large")
        let result = SELF.new(nlen)
        if i > 0 {
            let copy_size = i.checked_multiply(size_of(T)) ! panic("Slice length is too large")
            mem.copy(this.data, result.data, copy_size)
        }
        @property_init(result, @ptrv(result.data, T, i), item)
        return result
    }

    + fn get(index: uint) T !LookupError {
        if index >= this.length : throw .missing
        return @property_get(@ptrv(this.data, T, index))
    }

    + fn set(index: uint, value: T) !LookupError {
        if index >= this.length : throw .range
        @property_update(this, @ptrv(this.data, T, index), value)
    }

    + fn set_all(value: T) {
        let i = this.length
        let data = this.data
        while i-- > 0 {
            @property_update(this, @ptrv(data, T, i), value)
        }
    }
}

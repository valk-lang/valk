
use mem

+ slice Slice[T] of T $global {

    static fn new(length: uint (0)) SELF $default {
        let s = SELF {
            length: length
        }
        mem:clear(s.data, length * size_of(T))
        return s
    }

    // `$append`: class-init list form `Slice[T]{ a, b }` (grows)
    + fn append(item: T) SELF $append {
        let i = this.length
        let nlen = i + 1
        let result = SELF.new(nlen)
        if i > 0 {
            mem:copy(this.data, result.data, i * size_of(T))
        }
        @property_init(result, @ptrv(result.data, T, i), item)
        return result
    }

    + fn get(index: uint) T !LookupError $offset {
        if index >= this.length : throw .missing
        return @property_get(@ptrv(this.data, T, index))
    }

    + fn set(index: uint, value: T) !LookupError $offset_assign {
        if index >= this.length : throw .range
        @property_update(this, @ptrv(this.data, T, index), value)
    }
    + fn set_all(value: T) {
        let i = this.length
        let data = this.data
        while i-- > 0 {
            @property_update(this, @ptrv(data, T, i), value)
        }
    }

}

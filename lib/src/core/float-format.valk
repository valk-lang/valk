struct FloatFormatInt {
    limbs: [u32 x 128]
    length: uint
}

fn f64_from_bits(bits: u64) f64 $inline {
    return @ptrv(&bits, f64)
}

fn f64_to_bits(value: f64) u64 $inline {
    return @ptrv(&value, u64)
}

fn f32_to_bits(value: f32) u32 $inline {
    return @ptrv(&value, u32)
}

fn parse_float_exact(mantissa: u64, decimal_exponent: int) f64 {
    if mantissa == 0 : return 0

    let lemire, lemire_value = parse_float_lemire(mantissa, decimal_exponent)
    if lemire : return lemire_value

    let fast, fast_value = parse_float_exact_u64(mantissa, decimal_exponent)
    if fast : return fast_value

    return parse_float_exact_big(float_format_int(mantissa), decimal_exponent)
}

fn parse_float_exact_bytes(data: *[u8], length: uint, decimal_exponent: int) f64 {
    @unsafe
    let mantissa = float_format_int(0)
    let i: uint = 0
    while i < length {
        let ch = data[i++]
        if ch < '0' || ch > '9' : continue
        float_format_multiply(&mantissa, 10)
        float_format_add(&mantissa, (ch - '0').to(u32))
    }
    return parse_float_exact_big(mantissa, decimal_exponent)
}

fn parse_float_exact_view[T](view: &[T], decimal_exponent: int) f64 {
    let mantissa = float_format_int(0)
    let i: uint = 0
    while i < view.length {
        let ch = view.get(i++) ! panic("Byte slice index is out of bounds")
        if ch < '0' || ch > '9' : continue
        float_format_multiply(&mantissa, 10)
        float_format_add(&mantissa, (ch - '0').to(u32))
    }
    return parse_float_exact_big(mantissa, decimal_exponent)
}

fn parse_float_exact_big(mantissa: FloatFormatInt, decimal_exponent: int) f64 {
    if mantissa.length == 0 : return 0
    let numerator = mantissa
    let denominator = float_format_int(1)
    let exponent = decimal_exponent
    while exponent > 0 {
        float_format_multiply(&numerator, 10)
        exponent--
    }
    while exponent < 0 {
        float_format_multiply(&denominator, 10)
        exponent++
    }

    let binary_exponent: int = 0
    if float_format_compare(&numerator, &denominator) >= 0 {
        let scaled_denominator = denominator
        let next_denominator = scaled_denominator
        float_format_multiply(&next_denominator, 2)
        while float_format_compare(&numerator, &next_denominator) >= 0 {
            scaled_denominator = next_denominator
            next_denominator = scaled_denominator
            float_format_multiply(&next_denominator, 2)
            binary_exponent++
        }
        denominator = scaled_denominator
    } else {
        while float_format_compare(&numerator, &denominator) < 0 {
            float_format_multiply(&numerator, 2)
            binary_exponent--
        }
    }

    if binary_exponent > 1023 : return f64_from_bits(0x7ff0000000000000)
    if binary_exponent < -1075 : return 0

    let bit_count: int = binary_exponent >= -1022 ? 53 : binary_exponent + 1075
    if bit_count == 0 {
        return float_format_compare(&numerator, &denominator) > 0
            ? f64_from_bits(1)
            : 0
    }

    let significand: u64 = 0
    let i: int = 0
    while i < bit_count {
        significand = significand << 1
        if float_format_compare(&numerator, &denominator) >= 0 {
            float_format_subtract(&numerator, &denominator)
            significand++
        }
        i++
        if i < bit_count : float_format_multiply(&numerator, 2)
    }

    let twice_remainder = numerator
    float_format_multiply(&twice_remainder, 2)
    let rounding = float_format_compare(&twice_remainder, &denominator)
    if rounding > 0 || (rounding == 0 && (significand & 1) != 0) : significand++

    if binary_exponent < -1022 {
        return f64_from_bits(significand)
    }
    if significand == (1.to(u64) << 53) {
        significand = significand >> 1
        binary_exponent++
        if binary_exponent > 1023 : return f64_from_bits(0x7ff0000000000000)
    }
    let fraction = significand - (1.to(u64) << 52)
    return f64_from_bits((binary_exponent + 1023).to(u64) << 52 | fraction)
}

// Eisel-Lemire (Daniel Lemire, fast_float): mantissa × 10^exponent from one or two
// products with a 128-bit power of five, correctly rounded for any exact mantissa
// (Mushtak and Lemire). Subnormal results and exponents outside the table return false
fn parse_float_lemire(mantissa: u64, exponent: int) (bool, f64) {
    if exponent < -342 || exponent > 308 : return (false, 0)
    let zeros = mantissa.leading_zeros()
    let w = mantissa << zeros
    let index = ((exponent + 342) * 2).to(uint)
    let high, low = w.mul_wide(float_lemire_powers[index])
    // The low 9 bits of the 55 kept are all ones: the second word may carry into them
    if (high & 0x1FF) == 0x1FF {
        let carry_high, carry_low = w.mul_wide(float_lemire_powers[index + 1])
        low += carry_high
        if carry_high > low : high++
    }
    let upper = (high >> 63).to(uint)
    let shift = upper + 9
    let significand = high >> shift
    let power2 = ((217706 * exponent) >> 16) + 63 + upper.to(int) - zeros.to(int) + 1023
    if power2 <= 0 : return (false, 0)
    // Exactly halfway: round to even instead of up
    if low <= 1 && exponent >= -4 && exponent <= 23 && (significand & 3) == 1 && (significand << shift) == high {
        significand &= ~1.to(u64)
    }
    significand += significand & 1
    significand = significand >> 1
    if significand >= (2.to(u64) << 52) {
        significand = 1.to(u64) << 52
        power2++
    }
    if power2 >= 0x7FF : return (true, f64_from_bits(0x7ff0000000000000))
    return (true, f64_from_bits(power2.to(u64) << 52 | (significand & ((1.to(u64) << 52) - 1))))
}

fn parse_float_exact_u64(mantissa: u64, decimal_exponent: int) (bool, f64) {
    let numerator = mantissa
    let denominator: u64 = 1
    let exponent = decimal_exponent
    while exponent > 0 {
        if numerator > 18446744073709551615.to(u64) / 10 : return (false, 0)
        numerator *= 10
        exponent--
    }
    while exponent < 0 {
        if denominator > 9223372036854775807.to(u64) / 10 : return (false, 0)
        denominator *= 10
        exponent++
    }

    // Scale by a power of two so numerator / denominator lands in [1, 2)
    let binary_exponent: int = 0
    let numerator_bits = u64_bit_length(numerator)
    let denominator_bits = u64_bit_length(denominator)
    if numerator >= denominator {
        let shift = numerator_bits - denominator_bits
        if (denominator << shift) > numerator : shift--
        denominator = denominator << shift
        binary_exponent = shift.to(int)
    } else {
        let shift = denominator_bits - numerator_bits
        let scaled = numerator << shift
        if scaled < denominator {
            if scaled > 9223372036854775807.to(u64) : return (false, 0)
            scaled = scaled << 1
            shift++
        }
        numerator = scaled
        binary_exponent = 0 - shift.to(int)
    }

    if denominator > 9223372036854775807.to(u64) : return (false, 0)

    if binary_exponent < -1022 || binary_exponent > 1023 : return (false, 0)
    // The 53 significand bits, as many per division as fit above the remainder, which
    // stays below the denominator
    let significand = numerator / denominator
    let remainder = numerator % denominator
    let room = 64 - u64_bit_length(denominator)
    let needed: uint = 52
    while needed > 0 {
        let step = room < needed ? room : needed
        let wide = remainder << step
        significand = (significand << step) | (wide / denominator)
        remainder = wide % denominator
        needed -= step
    }

    let rounding = remainder * 2
    if rounding > denominator || (rounding == denominator && (significand & 1) != 0) : significand++
    if significand == (1.to(u64) << 53) {
        significand = significand >> 1
        binary_exponent++
        if binary_exponent > 1023 : return (true, f64_from_bits(0x7ff0000000000000))
    }
    let fraction = significand - (1.to(u64) << 52)
    return (true, f64_from_bits((binary_exponent + 1023).to(u64) << 52 | fraction))
}

// The number of bits `value` needs; 0 for 0
fn u64_bit_length(value: u64) uint $inline {
    return 64 - value.leading_zeros()
}

fn float_format_int(value: u64) FloatFormatInt {
    let result = FloatFormatInt { limbs: { 0... }, length: 0 }
    if value == 0 : return result
    result.limbs[0] = value.to(u32)
    result.length = 1
    let high = value >> 32
    if high > 0 {
        result.limbs[1] = high.to(u32)
        result.length = 2
    }
    return result
}

fn float_format_compare(left: local &FloatFormatInt, right: local &FloatFormatInt) int {
    if left.length < right.length : return -1
    if left.length > right.length : return 1
    let i = left.length
    while i-- > 0 {
        if left.limbs[i] < right.limbs[i] : return -1
        if left.limbs[i] > right.limbs[i] : return 1
    }
    return 0
}

fn float_format_multiply(value: local mut &FloatFormatInt, multiplier: u32) {
    if value.length == 0 || multiplier == 1 : return
    if multiplier == 0 {
        value.length = 0
        return
    }
    let carry: u64 = 0
    let i: uint = 0
    while i < value.length {
        let product = value.limbs[i].to(u64) * multiplier + carry
        value.limbs[i] = product.to(u32)
        carry = product >> 32
        i++
    }
    if carry > 0 {
        value.limbs[value.length++] = carry.to(u32)
    }
}

fn float_format_add(value: local mut &FloatFormatInt, add: u32) {
    if add == 0 : return
    if value.length == 0 {
        value.limbs[0] = add
        value.length = 1
        return
    }
    let carry = add.to(u64)
    let i: uint = 0
    while carry > 0 {
        let sum = value.limbs[i].to(u64) + carry
        value.limbs[i] = sum.to(u32)
        carry = sum >> 32
        i++
    }
    if i > value.length : value.length = i
}

fn float_format_shift_left(value: local mut &FloatFormatInt, bits: uint) {
    while bits-- > 0 : float_format_multiply(value, 2)
}

fn float_format_subtract(value: local mut &FloatFormatInt, other: local mut &FloatFormatInt) {
    let borrow: u64 = 0
    let i: uint = 0
    while i < value.length {
        let left = value.limbs[i].to(u64)
        let right = (i < other.length ? other.limbs[i].to(u64) : 0) + borrow
        if left < right {
            value.limbs[i] = ((1.to(u64) << 32) + left - right).to(u32)
            borrow = 1
        } else {
            value.limbs[i] = (left - right).to(u32)
            borrow = 0
        }
        i++
    }
    while value.length > 0 && value.limbs[value.length - 1] == 0 : value.length--
}

/// Shifts `value` right by one bit and returns the bit that fell off.
fn float_format_halve(value: local mut &FloatFormatInt) u32 {
    let bit: u32 = value.length == 0 ? 0 : value.limbs[0] & 1
    let carry: u32 = 0
    let i = value.length
    while i-- > 0 {
        let limb = value.limbs[i]
        value.limbs[i] = (limb >> 1) | (carry << 31)
        carry = limb & 1
    }
    while value.length > 0 && value.limbs[value.length - 1] == 0 : value.length--
    return bit
}

/// Divides `value` by `divisor` in place and returns the remainder.
fn float_format_divide_small(value: local mut &FloatFormatInt, divisor: u32) u32 {
    let remainder: u64 = 0
    let i = value.length
    while i-- > 0 {
        let current = (remainder << 32) | value.limbs[i].to(u64)
        value.limbs[i] = (current / divisor).to(u32)
        remainder = current % divisor
    }
    while value.length > 0 && value.limbs[value.length - 1] == 0 : value.length--
    return remainder.to(u32)
}

/// Returns the number of significant bits in `value`, zero for zero.
fn float_format_bit_length(value: local &FloatFormatInt) uint {
    if value.length == 0 : return 0
    let top = value.limbs[value.length - 1]
    let bits: uint = 0
    while top > 0 {
        top = top >> 1
        bits++
    }
    return (value.length - 1) * 32 + bits
}

/// Writes `value` with `decimals` digits after the dot, rounding on the exact binary value:
/// past a half rounds up, exactly a half rounds to the even digit (as C, Python, Go and Rust
/// do). Every digit written is exact,
/// also past the 17 the binary value names on its own; `decimals` must be at most 19.
fn format_float_fixed(value: $T, buf: ptr, decimals: uint, trim_zeros: bool) uint {
    @unsafe
    let bits: u64 = 0
    let fraction_bits: uint = 0
    let exponent_bits: uint = 0
    let exponent_bias: int = 0
    if size_of(T) == 4 {
        bits = f32_to_bits(value.to(f32)).to(u64)
        fraction_bits = 23
        exponent_bits = 8
        exponent_bias = 127
    } else {
        bits = f64_to_bits(value.to(f64))
        fraction_bits = 52
        exponent_bits = 11
        exponent_bias = 1023
    }

    let sign_shift = fraction_bits + exponent_bits
    let negative = ((bits >> sign_shift) & 1) != 0
    let fraction_mask = (1.to(u64) << fraction_bits) - 1
    let exponent_mask = (1.to(u64) << exponent_bits) - 1
    let fraction = bits & fraction_mask
    let encoded_exponent = (bits >> fraction_bits) & exponent_mask

    let mantissa = fraction
    let exponent: int = 0
    if encoded_exponent == 0 {
        exponent = 1 - exponent_bias - fraction_bits.to(int)
    } else {
        mantissa |= 1.to(u64) << fraction_bits
        exponent = encoded_exponent.to(int) - exponent_bias - fraction_bits.to(int)
    }

    // The exact value is mantissa * 2^exponent; scaling it by 10^decimals keeps a whole
    // number times a power of two, so the rounding below needs no floating point
    let scaled = float_format_int(mantissa)
    let i: uint = 0
    while i < decimals {
        float_format_multiply(&scaled, 10)
        i++
    }

    if exponent >= 0 {
        float_format_shift_left(&scaled, exponent.to(uint))
    } else {
        let shifts = (0 - exponent).to(uint)
        // Further than a whole digit down: the value is below half of the last digit
        if shifts > float_format_bit_length(&scaled) {
            scaled.length = 0
        } else {
            // Shift out the bits below the half, remembering whether any was set
            let below_half: u32 = 0
            let shift: uint = 1
            while shift < shifts {
                below_half |= float_format_halve(&scaled)
                shift++
            }
            let half_bit = scaled.length == 0 ? 0 : scaled.limbs[0] & 1
            float_format_halve(&scaled)
            // An exact half goes to the even last digit; the parity of the kept number is
            // the parity of its last digit
            let odd = scaled.length > 0 && (scaled.limbs[0] & 1) == 1
            if half_bit == 1 && (below_half != 0 || odd) : float_format_add(&scaled, 1)
        }
    }

    // The digits of scaled, least significant first
    let digits: [u8 x 48] = { 0... }
    let count: uint = 0
    while true {
        digits[count++] = float_format_divide_small(&scaled, 10).to(u8)
        if scaled.length == 0 : break
    }

    let kept = decimals
    if trim_zeros {
        // digits holds the least significant digit first, so the zeros to drop are at the low end
        while kept > 0 && digits[decimals - kept] == 0 : kept--
    }

    let offset: uint = 0
    if negative : @ptrv(buf, u8, offset++) = '-'
    let integer_digits = count > decimals ? count - decimals : 0
    if integer_digits == 0 {
        @ptrv(buf, u8, offset++) = '0'
    } else {
        let j = count
        while j > decimals {
            @ptrv(buf, u8, offset++) = digits[--j] + '0'
        }
    }
    if kept > 0 {
        @ptrv(buf, u8, offset++) = '.'
        let j = decimals
        while j > decimals - kept {
            @ptrv(buf, u8, offset++) = (j - 1 < count ? digits[j - 1] : 0) + '0'
            j--
        }
    }
    return offset
}

/// Writes `value` in exponent form with `decimals` digits after the dot in the mantissa,
/// e.g. `1.234567e6`, rounding on the exact binary value like `format_float_fixed`: past a
/// half rounds up, exactly a half rounds to the even digit. `decimals` must be at most 19.
fn format_float_scientific(value: $T, buf: ptr, decimals: uint, trim_zeros: bool) uint {
    @unsafe
    let bits: u64 = 0
    let fraction_bits: uint = 0
    let exponent_bits: uint = 0
    let exponent_bias: int = 0
    if size_of(T) == 4 {
        bits = f32_to_bits(value.to(f32)).to(u64)
        fraction_bits = 23
        exponent_bits = 8
        exponent_bias = 127
    } else {
        bits = f64_to_bits(value.to(f64))
        fraction_bits = 52
        exponent_bits = 11
        exponent_bias = 1023
    }

    let sign_shift = fraction_bits + exponent_bits
    let negative = ((bits >> sign_shift) & 1) != 0
    let fraction_mask = (1.to(u64) << fraction_bits) - 1
    let exponent_mask = (1.to(u64) << exponent_bits) - 1
    let fraction = bits & fraction_mask
    let encoded_exponent = (bits >> fraction_bits) & exponent_mask

    if encoded_exponent == exponent_mask {
        return float_format_write_special(buf, negative, fraction != 0)
    }

    let mantissa = fraction
    let exponent: int = 0
    if encoded_exponent == 0 {
        exponent = 1 - exponent_bias - fraction_bits.to(int)
    } else {
        mantissa |= 1.to(u64) << fraction_bits
        exponent = encoded_exponent.to(int) - exponent_bias - fraction_bits.to(int)
    }

    // The exact value is `whole / 10^scale`: a negative binary exponent becomes a power
    // of five, so every decimal digit of the value is available without floating point
    let whole = float_format_int(mantissa)
    let scale: uint = 0
    if exponent >= 0 {
        float_format_shift_left(&whole, exponent.to(uint))
    } else {
        scale = (0 - exponent).to(uint)
        let i: uint = 0
        while i < scale {
            float_format_multiply(&whole, 5)
            i++
        }
    }

    // All digits of `whole`, least significant first; a subnormal double has up to 767
    let digits: [u8 x 800] = @undefined
    let count: uint = 0
    while true {
        digits[count++] = float_format_divide_small(&whole, 10).to(u8)
        if whole.length == 0 : break
    }

    // The mantissa keeps the `decimals + 1` most significant digits; the leading one
    // sits at decimal exponent `count - 1 - scale`
    let kept: [u8 x 20] = { 0... }
    let keep = decimals + 1
    let decimal_exponent: int = 0
    let is_zero = count == 1 && digits[0] == 0
    if !is_zero {
        decimal_exponent = count.to(int) - 1 - scale.to(int)
        let i: uint = 0
        while i < keep {
            kept[i] = i < count ? digits[count - 1 - i] : 0
            i++
        }
        if count > keep {
            let first_dropped = digits[count - 1 - keep]
            let rest_nonzero = false
            let j: uint = 0
            while j < count - 1 - keep {
                if digits[j] != 0 : rest_nonzero = true
                j++
            }
            let odd = kept[keep - 1] % 2 == 1
            if first_dropped > 5 || (first_dropped == 5 && (rest_nonzero || odd)) {
                // Round up, carrying through the kept digits
                let k = keep
                while k-- > 0 {
                    if kept[k] < 9 {
                        kept[k]++
                        break
                    }
                    kept[k] = 0
                    if k == 0 {
                        // 9.99 became 10.00: the leading digit moves up one place
                        kept[0] = 1
                        decimal_exponent++
                    }
                }
            }
        }
    }

    let shown = decimals
    if trim_zeros {
        while shown > 0 && kept[shown] == 0 : shown--
    }

    let offset: uint = 0
    if negative : @ptrv(buf, u8, offset++) = '-'
    @ptrv(buf, u8, offset++) = kept[0] + '0'
    if shown > 0 {
        @ptrv(buf, u8, offset++) = '.'
        let i: uint = 1
        while i <= shown {
            @ptrv(buf, u8, offset++) = kept[i] + '0'
            i++
        }
    }
    @ptrv(buf, u8, offset++) = 'e'
    return offset + decimal_exponent.to_base_to_ptr(10, buf + offset)
}

fn float_format_write_special(buf: ptr, negative: bool, nan: bool) uint {
    let offset: uint = 0
    // A NaN has no sign worth showing: x86 makes 0.0 / 0.0 with the sign bit set
    if negative && !nan {
        @ptrv(buf, u8, offset++) = '-'
    }
    if nan {
        @ptrv(buf, u8, offset++) = 'n'
        @ptrv(buf, u8, offset++) = 'a'
        @ptrv(buf, u8, offset++) = 'n'
    } else {
        @ptrv(buf, u8, offset++) = 'i'
        @ptrv(buf, u8, offset++) = 'n'
        @ptrv(buf, u8, offset++) = 'f'
    }
    return offset
}

fn float_format_write_digits(buf: ptr, negative: bool, digits: local mut &[u8 x 32], count: uint, exponent: int, force_exponent: bool (false)) uint {
    @unsafe
    let offset: uint = 0
    if negative : @ptrv(buf, u8, offset++) = '-'

    // Plain decimal for everyday magnitudes, like JavaScript's Number#toString
    let fixed = !force_exponent && exponent >= -6 && exponent < 21
    if fixed {
        if exponent < 0 {
            @ptrv(buf, u8, offset++) = '0'
            @ptrv(buf, u8, offset++) = '.'
            let zeros = 0 - exponent - 1
            while zeros-- > 0 : @ptrv(buf, u8, offset++) = '0'
            let i: uint = 0
            while i < count : @ptrv(buf, u8, offset++) = digits[i++] + '0'
            return offset
        }

        let integer_digits = exponent.to(uint) + 1
        let i: uint = 0
        while i < integer_digits {
            @ptrv(buf, u8, offset++) = i < count ? digits[i] + '0' : '0'
            i++
        }
        if i < count {
            @ptrv(buf, u8, offset++) = '.'
            while i < count : @ptrv(buf, u8, offset++) = digits[i++] + '0'
        }
        return offset
    }

    @ptrv(buf, u8, offset++) = digits[0] + '0'
    if count > 1 {
        @ptrv(buf, u8, offset++) = '.'
        let i: uint = 1
        while i < count : @ptrv(buf, u8, offset++) = digits[i++] + '0'
    }
    @ptrv(buf, u8, offset++) = 'e'
    return offset + exponent.to_base_to_ptr(10, buf + offset)
}

// Copies a few bytes with word moves that overlap instead of running past `count`; a
// memcpy call costs more than the copy at these lengths
fn float_format_copy(from: ptr, to: ptr, count: uint) $inline {
    @unsafe
    if count >= 8 {
        let i: uint = 0
        while i + 8 < count {
            write_little_endian(to + i, read_little_endian(from + i, 8), 8)
            i += 8
        }
        write_little_endian(to + count - 8, read_little_endian(from + count - 8, 8), 8)
        return
    }
    if count >= 4 {
        let head = read_little_endian(from, 4)
        let tail = read_little_endian(from + count - 4, 4)
        write_little_endian(to, head, 4)
        write_little_endian(to + count - 4, tail, 4)
        return
    }
    if count > 0 : @ptrv(to, u8, 0) = @ptrv(from, u8, 0)
    if count > 1 : @ptrv(to, u8, 1) = @ptrv(from, u8, 1)
    if count > 2 : @ptrv(to, u8, 2) = @ptrv(from, u8, 2)
}

// Same as float_format_write_digits, for `count` ASCII digits at `digits`
fn float_format_write_ascii(buf: ptr, negative: bool, digits: ptr, count: uint, exponent: int, force_exponent: bool) uint {
    @unsafe
    let offset: uint = 0
    if negative : @ptrv(buf, u8, offset++) = '-'

    // Plain decimal for everyday magnitudes, like JavaScript's Number#toString
    if !force_exponent && exponent >= -6 && exponent < 21 {
        if exponent < 0 {
            @ptrv(buf, u8, offset++) = '0'
            @ptrv(buf, u8, offset++) = '.'
            let zeros = 0 - exponent - 1
            while zeros-- > 0 : @ptrv(buf, u8, offset++) = '0'
            float_format_copy(digits, buf + offset, count)
            return offset + count
        }
        let integer_digits = exponent.to(uint) + 1
        if integer_digits >= count {
            float_format_copy(digits, buf + offset, count)
            offset += count
            let zeros = integer_digits - count
            while zeros-- > 0 : @ptrv(buf, u8, offset++) = '0'
            return offset
        }
        float_format_copy(digits, buf + offset, integer_digits)
        offset += integer_digits
        @ptrv(buf, u8, offset++) = '.'
        float_format_copy(digits + integer_digits, buf + offset, count - integer_digits)
        return offset + count - integer_digits
    }

    @ptrv(buf, u8, offset++) = @ptrv(digits, u8, 0)
    if count > 1 {
        @ptrv(buf, u8, offset++) = '.'
        float_format_copy(digits + 1, buf + offset, count - 1)
        offset += count - 1
    }
    @ptrv(buf, u8, offset++) = 'e'
    return offset + exponent.to_base_to_ptr(10, buf + offset)
}

fn format_float_shortest(value: $T, buf: ptr, force_exponent: bool (false)) uint {
    @unsafe
    let bits: u64 = 0
    let fraction_bits: uint = 0
    let exponent_bits: uint = 0
    let exponent_bias: int = 0
    if size_of(T) == 4 {
        bits = f32_to_bits(value.to(f32)).to(u64)
        fraction_bits = 23
        exponent_bits = 8
        exponent_bias = 127
    } else {
        bits = f64_to_bits(value.to(f64))
        fraction_bits = 52
        exponent_bits = 11
        exponent_bias = 1023
    }

    let sign_shift = fraction_bits + exponent_bits
    let negative = ((bits >> sign_shift) & 1) != 0
    let fraction_mask = (1.to(u64) << fraction_bits) - 1
    let exponent_mask = (1.to(u64) << exponent_bits) - 1
    let fraction = bits & fraction_mask
    let encoded_exponent = (bits >> fraction_bits) & exponent_mask

    if encoded_exponent == exponent_mask {
        return float_format_write_special(buf, negative, fraction != 0)
    }
    if encoded_exponent == 0 && fraction == 0 {
        if negative {
            @ptrv(buf, u8, 0) = '-'
            @ptrv(buf, u8, 1) = '0'
            return 2
        }
        @ptrv(buf, u8, 0) = '0'
        return 1
    }

    if size_of(T) == 8 : return format_float_cached(value, buf, force_exponent)

    let mantissa = fraction
    let exponent: int = 0
    let unequal_margins = false
    if encoded_exponent == 0 {
        exponent = 1 - exponent_bias - fraction_bits.to(int)
    } else {
        mantissa |= 1.to(u64) << fraction_bits
        exponent = encoded_exponent.to(int) - exponent_bias - fraction_bits.to(int)
        unequal_margins = fraction == 0 && encoded_exponent > 1
    }

    let numerator = float_format_int(mantissa)
    let denominator = float_format_int(1)
    let margin_high = float_format_int(2)
    let margin_low = float_format_int(unequal_margins ? 1 : 2)
    float_format_multiply(&numerator, 4)
    float_format_multiply(&denominator, 4)
    if exponent >= 0 {
        float_format_shift_left(&numerator, exponent.to(uint))
        float_format_shift_left(&margin_high, exponent.to(uint))
        float_format_shift_left(&margin_low, exponent.to(uint))
    } else {
        float_format_shift_left(&denominator, (0 - exponent).to(uint))
    }

    let decimal_exponent: int = 0
    let ten_denominator = denominator
    float_format_multiply(&ten_denominator, 10)
    while float_format_compare(&numerator, &ten_denominator) >= 0 {
        denominator = ten_denominator
        ten_denominator = denominator
        float_format_multiply(&ten_denominator, 10)
        decimal_exponent++
    }
    while float_format_compare(&numerator, &denominator) < 0 {
        float_format_multiply(&numerator, 10)
        float_format_multiply(&margin_high, 10)
        float_format_multiply(&margin_low, 10)
        decimal_exponent--
    }

    let digits: [u8 x 32] = { 0... }
    let count: uint = 0
    let boundaries_inclusive = (mantissa & 1) == 0
    while true {
        let digit: u8 = 0
        while float_format_compare(&numerator, &denominator) >= 0 {
            float_format_subtract(&numerator, &denominator)
            digit++
        }

        let low_compare = float_format_compare(&numerator, &margin_low)
        let low = boundaries_inclusive ? low_compare <= 0 : low_compare < 0
        let upper_distance = denominator
        float_format_subtract(&upper_distance, &numerator)
        let high_compare = float_format_compare(&upper_distance, &margin_high)
        let high = boundaries_inclusive ? high_compare <= 0 : high_compare < 0

        if low || high {
            let round_up = high && !low
            if low && high {
                let twice = numerator
                float_format_multiply(&twice, 2)
                let middle = float_format_compare(&twice, &denominator)
                round_up = middle > 0 || (middle == 0 && (digit & 1) != 0)
            }

            if round_up {
                if digit < 9 {
                    digits[count++] = digit + 1
                } else {
                    while count > 0 && digits[count - 1] == 9 : count--
                    if count == 0 {
                        digits[0] = 1
                        count = 1
                        decimal_exponent++
                    } else {
                        digits[count - 1]++
                    }
                }
            } else {
                digits[count++] = digit
            }
            break
        }

        digits[count++] = digit
        float_format_multiply(&numerator, 10)
        float_format_multiply(&margin_high, 10)
        float_format_multiply(&margin_low, 10)
    }

    return float_format_write_digits(buf, negative, &digits, count, decimal_exponent, force_exponent)
}

struct FloatFormatInt {
    limbs: [u32 x 48]
    length: uint
}

fn float_from_bits(bits: u64) f64 {
    return @ptrv(&bits, f64)
}

fn parse_float_exact(mantissa: u64, decimal_exponent: int) f64 {
    if mantissa == 0 : return 0

    let numerator = float_format_int(mantissa)
    let denominator = float_format_int(1)
    let exponent = decimal_exponent
    while exponent > 0 {
        float_format_multiply(&numerator, 10)
        exponent--
    }
    while exponent < 0 {
        float_format_multiply(&denominator, 10)
        exponent++
    }

    let binary_exponent: int = 0
    if float_format_compare(&numerator, &denominator) >= 0 {
        let scaled_denominator = denominator
        let next_denominator = scaled_denominator
        float_format_multiply(&next_denominator, 2)
        while float_format_compare(&numerator, &next_denominator) >= 0 {
            scaled_denominator = next_denominator
            next_denominator = scaled_denominator
            float_format_multiply(&next_denominator, 2)
            binary_exponent++
        }
        denominator = scaled_denominator
    } else {
        while float_format_compare(&numerator, &denominator) < 0 {
            float_format_multiply(&numerator, 2)
            binary_exponent--
        }
    }

    if binary_exponent > 1023 : return float_from_bits(0x7ff0000000000000)
    if binary_exponent < -1075 : return 0

    let bit_count: int = binary_exponent >= -1022 ? 53 : binary_exponent + 1075
    if bit_count == 0 {
        return float_format_compare(&numerator, &denominator) > 0
            ? float_from_bits(1)
            : 0
    }

    let significand: u64 = 0
    let i: int = 0
    while i < bit_count {
        significand = significand << 1
        if float_format_compare(&numerator, &denominator) >= 0 {
            float_format_subtract(&numerator, &denominator)
            significand++
        }
        i++
        if i < bit_count : float_format_multiply(&numerator, 2)
    }

    let twice_remainder = numerator
    float_format_multiply(&twice_remainder, 2)
    let rounding = float_format_compare(&twice_remainder, &denominator)
    if rounding > 0 || (rounding == 0 && (significand & 1) != 0) : significand++

    if binary_exponent < -1022 {
        return float_from_bits(significand)
    }
    if significand == (1.to(u64) << 53) {
        significand = significand >> 1
        binary_exponent++
        if binary_exponent > 1023 : return float_from_bits(0x7ff0000000000000)
    }
    let fraction = significand - (1.to(u64) << 52)
    return float_from_bits((binary_exponent + 1023).to(u64) << 52 | fraction)
}

fn float_format_int(value: u64) FloatFormatInt {
    let result = FloatFormatInt { limbs: {0...}, length: 0 }
    if value == 0 : return result
    result.limbs[0] = value.to(u32)
    result.length = 1
    let high = value >> 32
    if high > 0 {
        result.limbs[1] = high.to(u32)
        result.length = 2
    }
    return result
}

fn float_format_compare(left: &FloatFormatInt, right: &FloatFormatInt) int {
    if left.length < right.length : return -1
    if left.length > right.length : return 1
    let i = left.length
    while i-- > 0 {
        if left.limbs[i] < right.limbs[i] : return -1
        if left.limbs[i] > right.limbs[i] : return 1
    }
    return 0
}

fn float_format_multiply(value: &FloatFormatInt, multiplier: u32) {
    if value.length == 0 || multiplier == 1 : return
    if multiplier == 0 {
        value.length = 0
        return
    }
    let carry: u64 = 0
    let i: uint = 0
    while i < value.length {
        let product = value.limbs[i].to(u64) * multiplier + carry
        value.limbs[i] = product.to(u32)
        carry = product >> 32
        i++
    }
    if carry > 0 {
        value.limbs[value.length++] = carry.to(u32)
    }
}

fn float_format_shift_left(value: &FloatFormatInt, bits: uint) {
    while bits-- > 0 : float_format_multiply(value, 2)
}

fn float_format_subtract(value: &FloatFormatInt, other: &FloatFormatInt) {
    let borrow: u64 = 0
    let i: uint = 0
    while i < value.length {
        let left = value.limbs[i].to(u64)
        let right = (i < other.length ? other.limbs[i].to(u64) : 0) + borrow
        if left < right {
            value.limbs[i] = ((1.to(u64) << 32) + left - right).to(u32)
            borrow = 1
        } else {
            value.limbs[i] = (left - right).to(u32)
            borrow = 0
        }
        i++
    }
    while value.length > 0 && value.limbs[value.length - 1] == 0 : value.length--
}

fn float_format_write_special(buf: ptr, negative: bool, nan: bool) uint {
    let offset: uint = 0
    if negative {
        @ptrv(buf, u8, offset++) = '-'
    }
    if nan {
        @ptrv(buf, u8, offset++) = 'n'
        @ptrv(buf, u8, offset++) = 'a'
        @ptrv(buf, u8, offset++) = 'n'
    } else {
        @ptrv(buf, u8, offset++) = 'i'
        @ptrv(buf, u8, offset++) = 'n'
        @ptrv(buf, u8, offset++) = 'f'
    }
    return offset
}

fn float_format_write_digits(buf: ptr, negative: bool, digits: &[u8 x 32], count: uint, exponent: int) uint {
    let offset: uint = 0
    if negative : @ptrv(buf, u8, offset++) = '-'

    let fixed = exponent >= -4 && exponent < count.to(int)
    if fixed {
        if exponent < 0 {
            @ptrv(buf, u8, offset++) = '0'
            @ptrv(buf, u8, offset++) = '.'
            let zeros = 0 - exponent - 1
            while zeros-- > 0 : @ptrv(buf, u8, offset++) = '0'
            let i: uint = 0
            while i < count : @ptrv(buf, u8, offset++) = digits[i++] + '0'
            return offset
        }

        let integer_digits = exponent.to(uint) + 1
        let i: uint = 0
        while i < integer_digits {
            @ptrv(buf, u8, offset++) = i < count ? digits[i] + '0' : '0'
            i++
        }
        if i < count {
            @ptrv(buf, u8, offset++) = '.'
            while i < count : @ptrv(buf, u8, offset++) = digits[i++] + '0'
        }
        return offset
    }

    @ptrv(buf, u8, offset++) = digits[0] + '0'
    if count > 1 {
        @ptrv(buf, u8, offset++) = '.'
        let i: uint = 1
        while i < count : @ptrv(buf, u8, offset++) = digits[i++] + '0'
    }
    @ptrv(buf, u8, offset++) = 'e'
    return offset + exponent.to_base_to_ptr(10, buf + offset)
}

fn format_float_shortest(value: $T, buf: ptr) uint {
    let bits: u64 = 0
    let fraction_bits: uint = 0
    let exponent_bits: uint = 0
    let exponent_bias: int = 0
    if size_of(T) == 4 {
        bits = @ptrv(&value, u32).to(u64)
        fraction_bits = 23
        exponent_bits = 8
        exponent_bias = 127
    } else {
        bits = @ptrv(&value, u64)
        fraction_bits = 52
        exponent_bits = 11
        exponent_bias = 1023
    }

    let sign_shift = fraction_bits + exponent_bits
    let negative = ((bits >> sign_shift) & 1) != 0
    let fraction_mask = (1.to(u64) << fraction_bits) - 1
    let exponent_mask = (1.to(u64) << exponent_bits) - 1
    let fraction = bits & fraction_mask
    let encoded_exponent = (bits >> fraction_bits) & exponent_mask

    if encoded_exponent == exponent_mask {
        return float_format_write_special(buf, negative, fraction != 0)
    }
    if encoded_exponent == 0 && fraction == 0 {
        if negative {
            @ptrv(buf, u8, 0) = '-'
            @ptrv(buf, u8, 1) = '0'
            return 2
        }
        @ptrv(buf, u8, 0) = '0'
        return 1
    }

    if size_of(T) == 8 {
        let ryu = format_float_ryu(value, buf)
        if ryu > 0 : return ryu
    }

    let mantissa = fraction
    let exponent: int = 0
    let unequal_margins = false
    if encoded_exponent == 0 {
        exponent = 1 - exponent_bias - fraction_bits.to(int)
    } else {
        mantissa |= 1.to(u64) << fraction_bits
        exponent = encoded_exponent.to(int) - exponent_bias - fraction_bits.to(int)
        unequal_margins = fraction == 0 && encoded_exponent > 1
    }

    let numerator = float_format_int(mantissa)
    let denominator = float_format_int(1)
    let margin_high = float_format_int(2)
    let margin_low = float_format_int(unequal_margins ? 1 : 2)
    float_format_multiply(&numerator, 4)
    float_format_multiply(&denominator, 4)
    if exponent >= 0 {
        float_format_shift_left(&numerator, exponent.to(uint))
        float_format_shift_left(&margin_high, exponent.to(uint))
        float_format_shift_left(&margin_low, exponent.to(uint))
    } else {
        float_format_shift_left(&denominator, (0 - exponent).to(uint))
    }

    let decimal_exponent: int = 0
    let ten_denominator = denominator
    float_format_multiply(&ten_denominator, 10)
    while float_format_compare(&numerator, &ten_denominator) >= 0 {
        denominator = ten_denominator
        ten_denominator = denominator
        float_format_multiply(&ten_denominator, 10)
        decimal_exponent++
    }
    while float_format_compare(&numerator, &denominator) < 0 {
        float_format_multiply(&numerator, 10)
        float_format_multiply(&margin_high, 10)
        float_format_multiply(&margin_low, 10)
        decimal_exponent--
    }

    let digits: [u8 x 32] = {0...}
    let count: uint = 0
    let boundaries_inclusive = (mantissa & 1) == 0
    while true {
        let digit: u8 = 0
        while float_format_compare(&numerator, &denominator) >= 0 {
            float_format_subtract(&numerator, &denominator)
            digit++
        }

        let low_compare = float_format_compare(&numerator, &margin_low)
        let low = boundaries_inclusive ? low_compare <= 0 : low_compare < 0
        let upper_distance = denominator
        float_format_subtract(&upper_distance, &numerator)
        let high_compare = float_format_compare(&upper_distance, &margin_high)
        let high = boundaries_inclusive ? high_compare <= 0 : high_compare < 0

        if low || high {
            let round_up = high && !low
            if low && high {
                let twice = numerator
                float_format_multiply(&twice, 2)
                let middle = float_format_compare(&twice, &denominator)
                round_up = middle > 0 || (middle == 0 && (digit & 1) != 0)
            }

            if round_up {
                if digit < 9 {
                    digits[count++] = digit + 1
                } else {
                    while count > 0 && digits[count - 1] == 9 : count--
                    if count == 0 {
                        digits[0] = 1
                        count = 1
                        decimal_exponent++
                    } else {
                        digits[count - 1]++
                    }
                }
            } else {
                digits[count++] = digit
            }
            break
        }

        digits[count++] = digit
        float_format_multiply(&numerator, 10)
        float_format_multiply(&margin_high, 10)
        float_format_multiply(&margin_low, 10)
    }

    return float_format_write_digits(buf, negative, &digits, count, decimal_exponent)
}

/// A `HashMap` with `String` keys, compatible with `HashMap[String, T]` in both directions.
///
/// Build one with `Map[T]{ "k" => v }`; every `HashMap` method applies.
+ mode Map[T] for HashMap[String, T] $global {
    /// Creates an empty map with room for `capacity` entries before it has to grow.
    ///
    /// Marked `$default`: it also provides the type's default value.
    + static fn new(capacity: uint (0)) SELF $default {
        return HashMap[String, T].new(capacity).@cast(SELF)
    }

    /// Returns a deep copy as a `Map`: every key and value is cloned.
    + fn clone() SELF {
        return this.@cast(HashMap[String, T]).clone().@cast(SELF)
    }

    // Map-style class init `Map[T]{ "k" => v, ... }` uses HashMap.$set_key via mode fallthrough.
}

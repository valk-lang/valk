
+ mode Map[T] for HashMap[String, T] $global {

    + static fn new() SELF $default {
        return SELF{}
    }

    + fn clone() SELF {
        return this.@cast(HashMap[String, T]).clone().@cast(SELF)
    }

    // Map-style class init `Map[T]{ "k" => v, ... }` uses HashMap.$set_key via mode fallthrough.
}

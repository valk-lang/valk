
+ mode Map[T] for HashMap[String, T] $global {

    + static fn new() SELF {
        return SELF{}
    }

    + macro scope("{", suggest(String) V:v1 "=>"  suggest(T) V:v2, "," as items) <{
    	let m = SELF.new()
    	#loop macro_values items as item
    	m.set(item.v1, item.v2)
    	#end
    	return m
    }
}

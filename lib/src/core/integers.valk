/// Reads a `bytes`-long little-endian unsigned integer from `from`.
///
/// `bytes` must not exceed `size_of(uint)`; no bounds are checked.
+ fn read_little_endian(from: *[u8], bytes: uint) uint {
    @unsafe
    let v: uint = 0
    let sh: uint = 0
    let i = 0
    while i < bytes {
        v = v | (from[i++].to(uint) << sh)
        sh += 8
    }
    return v
}
/// Reads a `bytes`-long big-endian unsigned integer from `from`.
///
/// `bytes` must not exceed `size_of(uint)`; no bounds are checked.
+ fn read_big_endian(from: *[u8], bytes: uint) uint {
    @unsafe
    let v: uint = 0
    let sh: uint = 0
    while bytes-- > 0 {
        v = v | (from[bytes].to(uint) << sh)
        sh += 8
    }
    return v
}

/// Writes the low `bytes` bytes of `value` to `to`, least significant byte first.
///
/// Higher bytes of `value` are dropped. No bounds are checked.
+ fn write_little_endian(value: uint, to: *[u8], bytes: uint) {
    @unsafe
    let i = 0
    while i < bytes {
        to[i++] = (value & 0xFF).to(u8)
        value = value >> 8
    }
}
/// Writes the low `bytes` bytes of `value` to `to`, most significant byte first.
///
/// Higher bytes of `value` are dropped. No bounds are checked.
+ fn write_big_endian(value: uint, to: *[u8], bytes: uint) {
    @unsafe
    while bytes-- > 0 {
        to[bytes] = (value & 0xFF).to(u8)
        value = value >> 8
    }
}

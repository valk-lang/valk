
/// A boolean value, `true` or `false`, stored in one byte.
+ boolean bool $global {
    /// Returns `"true"` or `"false"`.
    ///
    /// Tagged `$auto`, so a `bool` converts to `String` implicitly wherever one is expected.
    + fn to_string() String $auto {
        return this ? "true" : "false"
    }
}

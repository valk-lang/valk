use valk:gc

// Runtime header for tagged unions. This is intentionally an implementation
// detail: source values retain their `A | B` type and can only inspect the
// active alternative through language-level narrowing.
//
// `gc_payload` is reserved for managed references and out-of-line inline
// payloads. `other_payload` is reserved for scalar/raw-pointer bit patterns;
// keeping those slots disjoint prevents arbitrary scalar bytes from being
// mistaken for a GC object pointer.
class TaggedUnion $noNewProperties {
    ~ tag: uint
    // Managed alternatives stay in a dedicated pointer slot so the collector
    // can trace it without interpreting the active tag. All scalar and raw
    // pointer alternatives share the fixed-width bit payload.
    ~ gc_payload: ?gc:GcPtr (null)
    ~ other_payload: u64
}

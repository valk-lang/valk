use valk:gc

// Runtime storage for structural tagged unions. This is intentionally an
// implementation detail: source values retain their `A | B` type and can only
// inspect the active alternative through language-level narrowing.
class TaggedUnion $noNewProperties {
    ~ tag: uint
    ~ int_value: int
    ~ float_value: float
    ~ gc_value: ?gc:GcPtr (null)
}

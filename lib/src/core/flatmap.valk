
/// A map that keeps its keys and values in two arrays and finds keys by linear search.
///
/// Lookups, inserts and removals cost O(n), so it suits small maps. Keys are compared with
/// `==` and need no hash. Entries stay in insertion order, also after removals. Build one
/// with `FlatMap[K, T]{ k => v }` and iterate with `each map as value, key`. Removing entries
/// inside `each` is safe: the loop still visits every entry that was not removed, once.
+ class FlatMap[K, T] $global {
    - _keys: Array[K] (.{})
    - _values: Array[T] (.{})
    // While an `each` runs, removed entries stay as holes, closed when the last loop ends;
    // see HashMap
    - loops: uint (0)
    - holes: uint (0)
    - hole_marks: ?Array[bool] (null)

    /// Creates an empty map.
    ///
    /// Marked `$default`: it also provides the type's default value.
    + static fn new() SELF $default {
        return SELF {}
    }

    /// The number of entries.
    + get length: uint {
        return this._keys.length - this.holes
    }
    /// Returns a new array of the keys, in entry order.
    + fn keys() Array[K] {
        if this.holes == 0 : return this._keys.copy()
        let keys = Array[K].new(this.length)
        each this._keys into key, index {
            if !this.is_hole(index) : keys.append(key)
        }
        return keys
    }
    #if K.$can_order
    /// Reorders the entries so iteration, `keys` and `values` follow ascending key order.
    + fn sort_keys() {
        let keys = this.keys()
        keys.sort()

        let values = Array[T].new(keys.length)
        each keys into key {
            values.append(this.get(key) ! panic("FlatMap key disappeared while sorting"))
        }

        this._keys = keys
        this._values = values
        this.holes = 0
        this.hole_marks = null
    }
    #end
    /// Returns a new array of the values, in entry order.
    + fn values() Array[T] {
        if this.holes == 0 : return this._values.copy()
        let values = Array[T].new(this.length)
        each this._values into value, index {
            if !this.is_hole(index) : values.append(value)
        }
        return values
    }

    /// Stores `value` under `key`, replacing the value of an existing entry in place.
    ///
    /// Backs `map[key] = value` (`$offset_assign`) and the literal `FlatMap[K, T]{ k => v }`
    /// (`$set_key`). A new key is added at the end.
    + fn set(key: K, value: T) $offset_assign $set_key {
        let index = this.find(key)
        if index == uint.$max {
            this._keys.append(key)
            this._values.append(value)
            return
        }
        this._values.set(index, value) _
    }

    /// Copies every entry of `map` into this map, replacing values of keys both maps have.
    + fn set_many(map: SELF) {
        each map as v, k {
            this.set(k, v)
        }
    }

    /// Adds a new entry for `key` at the end.
    ///
    /// Throws `exists`, leaving the map unchanged, when `key` is already present.
    + fn set_unique(key: K, value: T) !LookupError {
        if this.find(key) != uint.$max : throw .exists
        this._keys.append(key)
        this._values.append(value)
    }

    /// Returns the value stored under `key`; backs `map[key]`.
    ///
    /// Throws `missing` when `key` is absent.
    + fn get(key: K) T !LookupError $offset {
        let index = this.find(key)
        if index == uint.$max : throw .missing
        return this._values.get(index) ! { throw .missing }
    }

    /// Returns whether an entry for `key` exists.
    + fn has(key: K) bool {
        return this.find(key) != uint.$max
    }
    /// Returns whether any entry holds a value equal to `value`.
    + fn has_value(value: T) bool {
        if this.holes == 0 : return this._values.contains(value)
        each this._values into item, index {
            if item == value && !this.is_hole(index) : return true
        }
        return false
    }

    /// Removes the entry for `key`, keeping the order of the rest; does nothing when absent.
    + fn remove(key: K) {
        let index = this.find(key)
        if index == uint.$max : return
        if this.loops > 0 {
            let marks = this.hole_marks ?? <{
                let created = Array[bool].new(this._keys.length)
                this.hole_marks = created
                return created
            }
            while marks.length <= index : marks.append(false)
            marks.set(index, true) _
            this.holes++
            return
        }
        this._keys.remove(index)
        this._values.remove(index)
    }

    /// Removes every entry.
    + fn clear() {
        this._keys.clear()
        this._values.clear()
        this.holes = 0
        this.hole_marks = null
    }

    /// Copies every entry of `map` into this map; the same as `set_many`.
    + fn merge_in_place(map: SELF) {
        this.set_many(map)
    }

    /// Returns a new map with the entries of this map and of `map`; `map` wins on shared keys.
    ///
    /// Marked `$add`: backs `a + b`. Neither operand changes.
    + fn merge(map: SELF) SELF $add {
        let result = this.copy()
        result.merge_in_place(map)
        return result
    }

    /// Returns a shallow copy: a new map holding the same keys and values.
    + fn copy() SELF {
        return SELF {
            _keys: this.keys()
            _values: this.values()
        }
    }

    /// Returns a deep copy: every key and value is cloned with `$clone`.
    ///
    /// Marked `$clone`: backs `$clone(map)`.
    + fn clone() SELF $clone {
        let copy = SELF.new()
        each this as value, key {
            copy.set($clone(key), $clone(value))
        }
        return copy
    }

    fn _next(index: uint) (T, K) !IterError {
        let k = this._keys.get(index) ! throw .end
        let v = this._values.get(index) ! throw .end
        return (v, k)
    }

    fn _each_begin() {
        this.loops++
    }

    fn _each_end() {
        if this.loops > 0 : this.loops--
        if this.loops > 0 || this.holes == 0 : return
        this._keys = this.keys()
        this._values = this.values()
        this.holes = 0
        this.hole_marks = null
    }

    // The first position at or after `index` that is not a hole
    fn _each_skip(index: uint) uint {
        while this.is_hole(index) : index++
        return index
    }

    // The position of `key`, or uint.$max
    fn find(key: K) uint {
        each this._keys into stored, index {
            if stored == key && !this.is_hole(index) : return index
        }
        return uint.$max
    }

    fn is_hole(index: uint) bool {
        if this.holes == 0 : return false
        let marks = this.hole_marks ?! return false
        return marks.get(index) !? false
    }
}


+ class FlatMap[K, T] $global {
    - _keys: Array[K] (.{})
    - _values: Array[T] (.{})

    + static fn new() SELF $default {
        return SELF {}
    }

    + get length: uint {
        return this._keys.length
    }
    + fn keys() Array[K] {
        return this._keys.copy()
    }
    #if Array[K].$has_method(sort)
    + fn sort_keys() SELF {
        let keys = this._keys.copy()
        keys.sort()

        let values = Array[T].new(keys.length)
        each keys as key {
            values.append(this.get(key) ! panic("FlatMap key disappeared while sorting"))
        }

        this._keys = keys
        this._values = values
        return this
    }
    #end
    + fn values() Array[T] {
        return this._values.copy()
    }

    // `$set_key`: class-init map form `FlatMap{ k => v, ... }`
    + fn set(key: K, value: T) SELF $offset_assign $set_key {
        let index = this._keys.index_of(key) ! {
            // Set new key / value
            this._keys.append(key)
            this._values.append(value)
            return this
        }
        // Update existing key / value
        this._values.set(index, value) _
        return this
    }

    + fn set_many(map: SELF) SELF {
        each map as v, k {
            this.set(k, v)
        }
        return this
    }

    + fn set_unique(key: K, value: T) SELF !LookupError {
        if this._keys.contains(key) : throw .exists
        this._keys.append(key)
        this._values.append(value)
        return this
    }

    + fn get(key: K) T !LookupError $offset {
        let index = this._keys.index_of(key) ! { throw .missing }
        return this._values.get(index) ! { throw .missing }
    }

    + fn has(key: K) bool {
        return this._keys.contains(key)
    }
    + fn has_value(value: T) bool {
        return this._values.contains(value)
    }

    + fn remove(key: K) SELF {
        let index = this._keys.index_of(key) ! return this
        this._keys.remove(index)
        this._values.remove(index)
        return this
    }

    + fn clear() SELF {
        this._keys.clear()
        this._values.clear()
        return this
    }

    + fn merge_in_place(map: SELF) SELF {
        return this.set_many(map)
    }

    + fn merge(map: SELF) SELF $add {
        return this.copy().merge_in_place(map)
    }

    + fn copy() SELF {
        return SELF {
            _keys: this._keys.copy()
            _values: this._values.copy()
        }
    }

    + fn clone() SELF $clone {
        let copy = SELF.new()
        each this as value, key {
            copy.set($clone(key), $clone(value))
        }
        return copy
    }

    fn _next(index: uint) (T, K) !IterError {
        let k = this._keys.get(index) ! throw .end
        let v = this._values.get(index) ! throw .end
        return (v, k)
    }
}

@unsafe

use ext

// The frame records of the running thread's calls, newest first. Only code built with
// `--debug` keeps them: a function links its record on entry and unlinks it when it returns,
// and stores the line of each call it makes.
global debug_frames: ?ptr (null)

struct DebugFrame {
    prev: ?ptr
    info: ptr
    line: u32
}

// Written by the compiler, one per function; each field is a zero-terminated string
struct DebugFuncInfo {
    name: ptr
    file: ptr
    pkg: ptr
}

// A deep recursion shows its newest and oldest frames, with a count of the ones in between
value STACK_TRACE_HEAD (40)
value STACK_TRACE_TAIL (10)

// Writes the calls from `frame` down to the thread's first function to `fd`, one per line.
// Allocates nothing, so a crash handler can use it.
fn write_stack_trace(fd: i32, frame: ?ptr) {
    let total: uint = 0
    let at = frame
    while isset(at) {
        total++
        at = @ptrv(at, DebugFrame).prev
    }
    if total == 0 : return
    write_fd_text(fd, "Stack trace:\n")
    let i: uint = 0
    at = frame
    while isset(at) {
        let record = @ptrv(at, DebugFrame)
        if i < STACK_TRACE_HEAD || i + STACK_TRACE_TAIL >= total {
            write_stack_frame(fd, record)
        } else if i == STACK_TRACE_HEAD {
            write_fd_text(fd, "  ... ")
            write_fd_uint(fd, total - STACK_TRACE_HEAD - STACK_TRACE_TAIL)
            write_fd_text(fd, " more\n")
        }
        i++
        at = record.prev
    }
}

// `  at name (file:line)`, with ` in package x` for code from another package
fn write_stack_frame(fd: i32, record: DebugFrame) {
    let info = @ptrv(record.info, DebugFuncInfo)
    write_fd_text(fd, "  at ")
    write_fd_cstring(fd, info.name)
    write_fd_text(fd, " (")
    write_fd_cstring(fd, info.file)
    write_fd_text(fd, ":")
    write_fd_uint(fd, record.line)
    if @ptrv(info.pkg, u8) != 0 {
        write_fd_text(fd, " in package ")
        write_fd_cstring(fd, info.pkg)
    }
    write_fd_text(fd, ")\n")
}

fn write_fd_text(fd: i32, text: String) {
    write_fd(fd, text.data, text.bytes)
}

fn write_fd_cstring(fd: i32, text: ptr) {
    let length: uint = 0
    while @ptrv(text, u8, length) != 0 : length++
    write_fd(fd, text, length)
}

fn write_fd_uint(fd: i32, value: uint) {
    let digits: [u8 x 20] = @undefined
    let index: uint = 20
    if value == 0 {
        index--
        digits[index] = '0'
    }
    while value > 0 {
        index--
        digits[index] = '0' + (value % 10).to(u8)
        value /= 10
    }
    write_fd(fd, @ref(digits[index]), 20 - index)
}

// Writes all `length` bytes, retrying after a signal; other errors drop the rest
fn write_fd(fd: i32, data: ptr, length: uint) {
    while length > 0 {
        #if OS == "win"
        let written = ext.write(fd, data, length.to(u32))
        #else
        let written = ext.write(fd, data, length)
        #end
        if written <= 0 {
            #if OS != "win"
            if written < 0 && ext.get_errno() == ext.EINTR : continue
            #end
            return
        }
        data += written.to(uint)
        length -= written.to(uint)
    }
}

/// A CPU feature that `cpu_has` checks at run time, for code with a `$target_` variant.
+ enum CpuFeature {
    /// x86-64 SSSE3: byte shuffles (`$lookup` on 16 lanes).
    ssse3
    /// x86-64 SSE4.1.
    sse41
    /// x86-64 AVX2 with the operating system saving the wide registers: 32-lane vectors.
    avx2
    /// x86-64 carry-less multiply (PCLMULQDQ): `$clmul`.
    pclmul
}

value CPU_SSSE3 (1)
value CPU_SSE41 (2)
value CPU_AVX2 (4)
value CPU_PCLMUL (8)

// Detected once per thread
global cpu_features_known: bool
global cpu_features: uint

/// Returns whether the CPU this program runs on has `feature`.
///
/// Features belong to one architecture: on other architectures the answer is false. Use it to
/// choose a function marked with the matching `$target_` flag:
///
/// ```valk
/// if core.cpu_has(.avx2) : sum_avx2(data) else : sum(data)
/// ```
+ fn cpu_has(feature: CpuFeature) bool {
    if !cpu_features_known : cpu_detect()
    let bit: uint = match feature : uint {
        CpuFeature.ssse3 => CPU_SSSE3
        CpuFeature.sse41 => CPU_SSE41
        CpuFeature.avx2 => CPU_AVX2
        CpuFeature.pclmul => CPU_PCLMUL
    }
    return (cpu_features & bit) != 0
}

fn cpu_detect() {
    let features: uint = 0
    #if ARCH == "x64"
    let max_leaf, vendor_b, vendor_c, vendor_d = $cpuid(0, 0)
    if max_leaf >= 1 {
        let a1, b1, c1, d1 = $cpuid(1, 0)
        if (c1 >> 1) & 1 == 1 : features = features | CPU_PCLMUL
        if (c1 >> 9) & 1 == 1 : features = features | CPU_SSSE3
        if (c1 >> 19) & 1 == 1 : features = features | CPU_SSE41
        // AVX2 needs the instruction set and the operating system saving the YMM state
        let osxsave = (c1 >> 27) & 1 == 1
        let avx = (c1 >> 28) & 1 == 1
        if max_leaf >= 7 && osxsave && avx {
            let a7, b7, c7, d7 = $cpuid(7, 0)
            if (b7 >> 5) & 1 == 1 && ($xgetbv(0) & 6) == 6 : features = features | CPU_AVX2
        }
    }
    #end
    cpu_features = features
    cpu_features_known = true
}

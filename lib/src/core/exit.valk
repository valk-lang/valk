@unsafe

use ext

global buffer: ByteBuffer (.new(128))

global cli_args: Array[String] (@undefined)

/// Ends the process with exit code `code`.
///
/// C exit handlers run, unlike with `panic`; `defer` blocks, other coroutines and other
/// threads do not get to finish.
+ fn exit(code: i32) @willexit $global {
    ext.exit(code)
}

// Ends the process without running C exit handlers: other threads may still
// be inside library code whose global destructors those handlers would tear
// down under them
/// Prints `msg` to stdout and ends the process with exit code 1.
///
/// The compiler fills `location` with the panic's source position, relative to the root of
/// the package it was compiled in, and the output reads `msg at path:line`. C exit handlers
/// do not run. Marked `$exit`: the compiler knows a call never returns.
+ fn panic(msg: String, location: String ("")) $exit $global {
    print(msg)
    if location.length > 0 {
        print(" at ")
        print(location)
    }
    print("\n")
    ext._exit(1)
}

fn cleanup_warning_write(data: ptr, length: uint) {
    while length > 0 {
        #if OS == "win"
        let written = ext.write(2, data, length.to(u32))
        #else
        let written = ext.write(2, data, length)
        #end
        if written <= 0 {
            #if OS != "win"
            if written < 0 && ext.get_errno() == ext.EINTR : continue
            #end
            return
        }
        data += written.to(uint)
        length -= written.to(uint)
    }
}

/// Writes `Warning: msg @ file:line` to stderr without allocating.
///
/// Meant for failures in `gc_free` and other cleanup code that cannot throw.
+ fn cleanup_warning(msg: String, file: String, line: uint) {
    let prefix = "Warning: "
    let at = " @ "
    let colon = ":"
    let newline = "\n"
    cleanup_warning_write(prefix.data, prefix.bytes)
    cleanup_warning_write(msg.data, msg.bytes)
    cleanup_warning_write(at.data, at.bytes)
    cleanup_warning_write(file.data, file.bytes)
    cleanup_warning_write(colon.data, colon.bytes)

    let digits: [u8 x 20] = @undefined
    let index: uint = 20
    if line == 0 {
        index--
        digits[index] = '0'
    } else {
        while line > 0 {
            index--
            digits[index] = '0' + (line % 10).to(u8)
            line /= 10
        }
    }
    cleanup_warning_write(@ref(digits[index]), 20 - index)
    cleanup_warning_write(newline.data, newline.bytes)
}

/// Sends signal `code` to the current process.
///
/// Marked `@willexit`: the compiler treats the call as the end of the function, so only raise
/// signals that end the process, not ones that are ignored or handled.
+ fn raise(code: i32) @willexit $global {
    ext.raise(code)
}

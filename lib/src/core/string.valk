use mem
use gc

+ slice String of u8 $global {
    + get bytes: uint {
        return this.length
    }
    + get data_cstring: cstring {
        return this.data
    }

    /////////////////////
    // Start / Ends
    /////////////////////

    + fn starts_with(part: SELF) bool {
        if part.bytes > this.bytes : return false
        return mem.equal(this.view(0, part.bytes), part.view(0, part.bytes))
    }
    + fn ends_with(part: SELF) bool {
        if part.bytes > this.bytes : return false
        return mem.equal(this.view(this.bytes - part.bytes, part.bytes), part.view(0, part.bytes))
    }

    + fn equal_ignore_ascii_case(other: SELF) bool {
        return mem.ascii_equal_ignore_case(this.view(0, this.bytes), other.view(0, other.bytes))
    }

    + fn is_empty() bool { return this.bytes == 0 }

    /////////////////////
    // Convert
    /////////////////////

    + fn to_string() SELF {
        return this
    }

    + fn to_uint() uint !SyntaxError {
        return this.view(0, this.bytes).parse_uint(true) ! throw .syntax
    }
    + fn to_int() int !SyntaxError {
        return this.view(0, this.bytes).parse_int() ! throw .syntax
    }

    + fn hex_to_uint() uint !SyntaxError {
        return this.view(0, this.bytes).parse_hex_uint() ! throw .syntax
    }
    + fn hex_to_int() int !SyntaxError {
        return this.view(0, this.bytes).parse_hex_int() ! throw .syntax
    }

    + fn octal_to_uint() uint !SyntaxError {
        return this.view(0, this.bytes).parse_octal_uint() ! throw .syntax
    }
    + fn octal_to_int() int !SyntaxError {
        return this.view(0, this.bytes).parse_octal_int() ! throw .syntax
    }

    + fn to_float() f64 !SyntaxError {
        return this.view(0, this.bytes).parse_float() ! throw .syntax
    }

    + fn lower() SELF {
        if this.is_lower() : return this
        return unicode_lower_string(this)
    }

    + fn upper() SELF {
        if this.is_upper() : return this
        return unicode_upper_string(this)
    }

    + fn is_lower() bool {
        return unicode_string_is_lower(this)
    }

    + fn is_upper() bool {
        return unicode_string_is_upper(this)
    }

    /////////////////////
    // Syntax
    /////////////////////

    + fn is_syntax(mask: String, mask_is_exclude: bool (false)) bool {
        let lower = false
        let upper = false
        let numbers = false
        each mask as m {
            if m == 'a' : lower = true
            else if m == 'A' : upper = true
            else if m == '0' : numbers = true
        }
        each this as ch {
            if (lower && ch.is_lower()) || (upper && ch.is_upper()) || (numbers && ch.is_number()) || mask.contains_byte(ch) {
                if mask_is_exclude : return false
                continue
            }
            if !mask_is_exclude : return false
        }
        return true
    }

    + fn is_alpha(allow_extra_bytes: SELF ("")) bool {
        return unicode_string_has_only(this, allow_extra_bytes, unicode_alpha_ranges)
    }
    + fn is_alpha_numeric(allow_extra_bytes: SELF ("")) bool {
        return unicode_string_has_only(this, allow_extra_bytes, unicode_alnum_ranges)
    }

    + fn is_integer() bool {
        let i: uint = 0
        let len = this.bytes
        if len == 0 : return false
        while i < len {
            let ch = this[i++]
            if !ch.is_number() : return false
        }
        return true
    }

    + fn is_number() bool {
        let i: uint = 0
        let len = this.bytes
        if len == 0 : return false
        let dot_count = 0
        while i < len {
            let ch = this[i++]
            if ch == '.' {
                if dot_count++ > 0 : return false
                continue
            }
            if !ch.is_number() : return false
        }
        return true
    }

    /////////////////////
    // Internals
    /////////////////////

    fn add(add: SELF) SELF $add {
        @unsafe
        let this_len = this.bytes
        let add_len = add.bytes
        let len = this_len.checked_add(add_len) ! panic("String length is too large")
        if len == 0 : return "".to(SELF)
        let s = SELF.alloc(len)
        let data = s.data
        mem.copy_bytes(this.data, data, this_len)
        let copy_len = add_len.checked_add(1) ! panic("String length is too large")
        mem.copy_bytes(add.data, data.@offset(this_len), copy_len) // Includes the zero byte.
        return s
    }

    fn equal(cmp: SELF) bool $eq {
        return mem.equal(this.view(0, this.bytes), cmp.view(0, cmp.bytes))
    }

    fn lt(cmp: SELF) bool $lt {
        let len1 = this.bytes
        let len2 = cmp.bytes
        let len = len1 <= len2 ? len1 : len2
        let i: uint = 0
        while i < len {
            let ch1 = this[i]
            let ch2 = cmp[i++]
            if ch1 != ch2 : return ch1 < ch2
        }
        return len1 < len2
    }
    fn gt(cmp: SELF) bool $gt {
        let len1 = this.bytes
        let len2 = cmp.bytes
        let len = len1 <= len2 ? len1 : len2
        let i: uint = 0
        while i < len {
            let ch1 = this[i]
            let ch2 = cmp[i++]
            if ch1 != ch2 : return ch1 > ch2
        }
        return len1 > len2
    }
    fn lte(cmp: SELF) bool $lte {
        return this == cmp || this < cmp
    }
    fn gte(cmp: SELF) bool $gte {
        return this == cmp || this > cmp
    }

    static fn default_array_filter(i: ?String) bool {
        if !isset(i) : return true
        return i.bytes == 0
    }

    + fn hash() uint $hash {
        let len = this.bytes
        let data = this.data
        if len < 8 {
            let hash: uint = 0xcbf29ce484222325
            let i: uint = 0
            while i < len {
                hash ^= @ptrv(data, u8, i++)
                hash *= 0x100000001b3
            }
            return hash
        }

        let hash: uint = len * 0x9e3779b185ebca87
        hash ^= @ptrv(data, uint) * 0xc2b2ae3d27d4eb4f
        hash = ((hash << 31) | (hash >> 33)) * 0x9e3779b185ebca87
        hash ^= @ptrv(data.@offset(len - 8), uint) * 0x165667b19e3779f9
        // Longer strings deliberately sample rather than scan every byte.
        if len > 16 {
            hash = ((hash << 31) | (hash >> 33)) * 0x9e3779b185ebca87
            hash ^= @ptrv(data.@offset(len / 2 - 4), uint) * 0x85ebca77c2b2ae63
        }

        hash ^= hash >> 29
        hash *= 0x165667b19e3779f9
        hash ^= hash >> 32
        return hash
    }

    /////////////////////
    // Create
    /////////////////////

    + fn clone() SELF $clone {
        @unsafe
        return SELF.copy_from_ptr(this.data, this.bytes)
    }

    + static fn alloc(length: uint) SELF {
        if length == 0 : return "".to(SELF)
        let storage_length = length.checked_add(1) ! panic("String length is too large")
        let result = SELF { length: storage_length }
        result.length = length
        return result
    }

    + static fn copy_from_ptr(data: ptr, length: uint) SELF {
        @unsafe
        if length == 0 : return "".to(SELF)
        let s = SELF.alloc(length)
        let str_data = s.data
        mem.copy_bytes(data, str_data, length)
        return s
    }

    ~ fn take_length(length: uint) SELF {
        if length > this.length : length = this.length
        this.length = length
        return this
    }

    + static fn random(len: uint, characters: String ("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")) String {
        let alphabet = characters.length
        if alphabet == 0 : return ""
        let buf = reuse_buf
        buf.clear()
        let rand = u64.random()
        let half = 0
        while len-- > 0 {
            let draw = half == 0 ? (rand & 2147483647) : (rand >> 32)
            if half == 1 : rand = u64.random()
            half = 1 - half
            buf.write_byte(characters[draw % alphabet])
        }
        return buf
    }

    + static fn secure_random(len: uint, characters: String ("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")) String !ExternError {
        @unsafe
        let alphabet = characters.length
        if alphabet == 0 : return ""
        let buf = reuse_buf
        buf.clear()
        let draws: [uint x 64] = @undefined
        let draw_index: uint = 64
        let threshold = (0.to(uint) - alphabet) % alphabet
        while len > 0 {
            if draw_index == 64 {
                if !fill_secure_random(&draws, size_of(uint) * 64) : throw .extern
                draw_index = 0
            }
            let draw = draws[draw_index++]
            if draw < threshold : continue
            buf.write_byte(characters[draw % alphabet])
            len--
        }
        return buf
    }

    /////////////////////
    // Index of
    /////////////////////

    + fn index_of(part: String, start_index: uint (0)) uint !LookupError {
        let part_bytes = part.bytes
        if part_bytes > this.bytes : throw .missing
        let index = start_index
        let len = this.bytes - part_bytes + 1
        while index < len {
            if mem.equal(this.view(index, part_bytes), part.view(0, part_bytes)) : return index
            index++
        }
        throw .missing
    }

    + fn index_of_byte(byte: u8, start_index: uint (0)) uint !LookupError {
        let index = start_index
        let len = this.bytes
        while index < len {
            let ch = this[index]
            if ch == byte : return index
            index++
        }
        throw .missing
    }

    + fn contains(part: String, start_index: uint (0)) bool {
        this.index_of(part, start_index) ! return false
        return true
    }
    + fn contains_byte(byte: u8, start_index: uint (0)) bool {
        this.index_of_byte(byte, start_index) ! return false
        return true
    }

    /////////////////////
    // Partials
    /////////////////////

    + fn get(index: uint) u8 $offset $inline {
        @unsafe
        if index >= this.bytes : return 0
        return this.data[index]
    }

    + fn range(start: uint, end: uint, inclusive: bool (true)) SELF {
        if start > end : return ""
        let amount = end - start
        if inclusive {
            let inclusive_amount = amount + 1
            if inclusive_amount > amount : amount = inclusive_amount
        }
        return this.part(start, amount)
    }

    + fn part(start_index: uint, length: uint) String $range {
        @unsafe
        let this_bytes = this.bytes
        if start_index > this_bytes : return ""
        let remain = this_bytes - start_index
        if length > remain : length = remain
        if length == 0 : return ""
        let from = this.data.@offset(start_index)
        let res = String.alloc(length)
        mem.copy_bytes(from, res.data, length)
        return res
    }

    + fn view(start_index: uint, length: uint) Slice[u8] $inline {
        if start_index > this.bytes {
            start_index = 0
            length = 0
        } else if length > this.bytes - start_index {
            length = this.bytes - start_index
        }
        return Slice[u8].from_storage(this._storage, this.offset + start_index, length)
    }

    + fn to_slice() Slice[u8] $auto $inline {
        return this.view(0, this.bytes)
    }

    + fn split(on: String) Array[String] {
        let result = Array[String].new()
        let start: uint = 0
        let on_len = on.bytes
        if on_len == 0 {
            let this_len = this.length
            let i: uint = 0
            while i < this_len {
                result.append(this.part(i++, 1))
            }
        } else {
            while true {
                let index = this.index_of(on, start) ! break
                let part = this.part(start, index - start)
                result.append(part)
                start = index + on_len
            }
            let part = this.part(start, this.bytes - start)
            result.append(part)
        }
        return result
    }

    fn split_on_first_occurance_of_byte(byte: u8) (String, String) !LookupError {
        let pos = this.index_of_byte(byte) ! throw .missing
        let p2 = this.part(pos + 1, this.bytes - pos - 1)
        let p1 = this.part(0, pos)
        return (p1, p2)
    }

    /////////////////////
    // Trim
    /////////////////////

    + fn trim(part: SELF, limit: uint (0)) SELF {
        let res = this.ltrim(part, limit)
        return res.rtrim(part, limit)
    }

    + fn rtrim(part: SELF, limit: uint (0)) SELF {
        @unsafe
        let part_bytes = part.bytes
        if part_bytes == 0 : return this
        let part_data = part.data

        let data = this.data
        let len = this.bytes
        let data_end = data + len
        let offset: uint = 0
        let count: uint = 0
        while offset <= len && part_bytes <= len - offset
            && mem.equal_bytes(data_end - offset - part_bytes, part_data, part_bytes) {
            offset += part_bytes
            count++
            if count == limit : break
        }
        if offset == 0 : return this

        return SELF.copy_from_ptr(data, len - offset)
    }

    + fn ltrim(part: SELF, limit: uint (0)) SELF {
        @unsafe
        let part_bytes = part.bytes
        if part_bytes == 0 : return this
        let part_data = part.data

        let data = this.data
        let len = this.bytes
        let offset: uint = 0
        let count: uint = 0
        while offset <= len && part_bytes <= len - offset
            && mem.equal_bytes(data + offset, part_data, part_bytes) {
            offset += part_bytes
            count++
            if count == limit : break
        }
        if offset == 0 : return this

        return SELF.copy_from_ptr(data + offset, len - offset)
    }

    /////////////////////
    // Modify
    /////////////////////

    + fn replace(part: String, with: String) String {
        @unsafe
        let len = this.bytes
        if len == 0 : return ""

        let part_bytes = part.bytes
        if part_bytes == 0 : return this
        let part_data = part.data

        let buf = reuse_buf
        buf.clear()
        let data = this.data
        let offset: uint = 0
        while offset < len {
            if part_bytes <= len - offset && mem.equal_bytes(data + offset, part_data, part_bytes) {
                buf.write(with)
                offset += part_bytes
                continue
            }
            buf.write_byte(data[offset++])
        }

        return buf
    }

    + fn pad_left(char: u8, length: uint) String {
        @unsafe
        if this.length >= length : return this
        let chars = length - this.length
        let str = SELF.alloc(length)
        let data = str.data
        mem.copy_bytes(this.data, data + chars, this.length)
        while chars-- > 0 {
            @ptrv(data, u8, chars) = char
        }
        return str
    }

    + fn pad_right(char: u8, length: uint) String {
        @unsafe
        let len = this.length
        if len >= length : return this
        let chars = length - len
        let str = SELF.alloc(length)
        let data = str.data
        mem.copy_bytes(this.data, data, len)
        while chars-- > 0 {
            @ptrv(data, u8, len + chars) = char
        }
        return str
    }

    /////////////////////
    // Misc
    /////////////////////

    + fn escape() String {
        let bytes = this.bytes
        if bytes == 0 : return ""
        let buf = reuse_buf
        buf.clear()
        //
        let i: uint = 0
        while i < bytes {
            let ch = this[i++]
            if (ch == '\n') : buf.write("\\n")
            else if (ch == '\r') : buf.write("\\r")
            else if (ch == '\t') : buf.write("\\t")
            else if (ch == '\f') : buf.write("\\f")
            else if (ch == '\b') : buf.write("\\b")
            else if (ch == '\v') : buf.write("\\v")
            else if (ch == '\a') : buf.write("\\a")
            else if (ch == '\e') : buf.write("\\e")
            else if (ch == '\\') : buf.write("\\\\")
            else if (ch == '"') : buf.write("\\\"")
            else : buf.write_byte(ch)
        }
        return buf.to_string()
    }

    // Convert escaped characters
    + fn unescape() String {
        let bytes = this.bytes
        if bytes == 0 : return ""
        let buf = reuse_buf
        buf.clear()
        //
        let i: uint = 0
        while i < bytes {
            let ch = this[i++]
            if (ch == '\\') {
                let ch = this[i++]
                ch = ch.unescape()
                buf.write_byte(ch)
                continue
            }
            buf.write_byte(ch)
        }
        return buf.to_string()
    }

    fn _next(index: uint) u8 !IterError {
        @unsafe
        if index >= this.bytes : throw .end
        return this.data[index]
    }

    /////////////////////
    // UTF8
    /////////////////////

    group utf8 {
        + get length: uint {
            let step = CharStep { source: this, pos: 0 }
            let count: uint = 0
            while true {
                step.next() ! return count
                count++
            }
        }

        /////////////////////
        // Index of
        /////////////////////

        + fn index_of(part: String, start_index: uint (0)) uint !LookupError {
            @unsafe
            if part.bytes > this.bytes : throw .missing
            let step = CharStep { source: this, pos: 0 }
            let count: uint = 0
            let offset: uint = 0
            let adr = this.data
            let part_adr = part.data
            let part_bytes = part.bytes
            let last_offset = this.bytes - part_bytes
            while count < start_index {
                offset += step.next() ! throw .missing
                if offset > last_offset : throw .missing
                count++
            }
            while true {
                if mem.equal_bytes(adr.@offset(offset), part_adr, part_bytes) : return count
                offset += step.next() ! throw .missing
                if offset > last_offset : throw .missing
                count++
            }
        }

        + fn contains(part: String) bool {
            this.index_of(part) ! return false
            return true
        }

        /////////////////////
        // Partials
        /////////////////////

        + fn get(index: uint) String {
            return this.part(index, 1)
        }

        + fn range(start: uint, end: uint, inclusive: bool (true)) SELF {
            if start > end : return ""
            let amount = end - start
            if inclusive {
                let inclusive_amount = amount + 1
                if inclusive_amount > amount : amount = inclusive_amount
            }
            return this.utf8.part(start, amount)
        }

        + fn part(start_index: uint, length: uint) String {
            @unsafe
            if length == 0 : return ""
            let this_bytes = this.bytes
            if start_index > this_bytes : return ""

            let step = CharStep { source: this, pos: 0 }

            let count: uint = 0
            let offset: uint = 0
            let data = this.data
            while count < start_index {
                offset += step.next() ! return ""
                count++
            }
            let start = offset
            count = 0
            while count++ < length {
                offset += step.next() ! break
                if offset >= this_bytes : break
            }
            if offset > this_bytes : offset = this_bytes
            return String.copy_from_ptr(data.@offset(start), offset - start)
        }

        + fn split(on: String) Array[String] {
            @unsafe
            let result = Array[String].new()
            let on_bytes = on.bytes
            let this_bytes = this.bytes
            if on_bytes > this_bytes || on_bytes == 0 {
                result.append(this)
                return result
            }

            let step = CharStep { source: this, pos: 0 }

            let offset: uint = 0
            let start: uint = 0

            let data = this.data
            let on_data = on.data
            let last_offset = this_bytes - on_bytes
            while offset <= last_offset {
                if mem.equal_bytes(data.@offset(offset), on_data, on_bytes) {
                    result.append(String.copy_from_ptr(data.@offset(start), offset - start))
                    offset += on_bytes
                    start = offset
                    step.skip_bytes(on_bytes)
                    continue
                }
                offset += step.next() ! break
            }
            if offset > this_bytes : offset = this_bytes
            result.append(String.copy_from_ptr(data.@offset(start), offset - start))
            return result
        }
    }

    /////////////////////
    // ANSI
    /////////////////////

    group ansi {
        fn esc() String {
            return 27.to(u8).to_ascii_string()
        }
        fn reset() String {
            return 27.to(u8).to_ascii_string() + "[0m"
        }

        + fn black(bold: bool (false)) String {
            return this.ansi.esc() + "[" + (bold ? 1 : 0) + ";30m" + this + this.ansi.reset()
        }
        + fn red(bold: bool (false)) String {
            return this.ansi.esc() + "[" + (bold ? 1 : 0) + ";31m" + this + this.ansi.reset()
        }
        + fn green(bold: bool (false)) String {
            return this.ansi.esc() + "[" + (bold ? 1 : 0) + ";32m" + this + this.ansi.reset()
        }
        + fn yellow(bold: bool (false)) String {
            return this.ansi.esc() + "[" + (bold ? 1 : 0) + ";33m" + this + this.ansi.reset()
        }
        + fn blue(bold: bool (false)) String {
            return this.ansi.esc() + "[" + (bold ? 1 : 0) + ";34m" + this + this.ansi.reset()
        }
        + fn purple(bold: bool (false)) String {
            return this.ansi.esc() + "[" + (bold ? 1 : 0) + ";35m" + this + this.ansi.reset()
        }
        + fn cyan(bold: bool (false)) String {
            return this.ansi.esc() + "[" + (bold ? 1 : 0) + ";36m" + this + this.ansi.reset()
        }
        + fn white(bold: bool (false)) String {
            return this.ansi.esc() + "[" + (bold ? 1 : 0) + ";37m" + this + this.ansi.reset()
        }
    }
}

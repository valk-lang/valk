use mem
use ext

// D-15, the differential oracle (GC_ORACLE builds). A deterministic program allocates the same
// objects in the same order with either collector, so an object's allocation serial number
// names it in both builds. At each `oracle_checkpoint` the program collects and writes the
// serials of the objects still allocated; misc/gc-oracle.sh compares the two builds' files.
// Counting starts at the first checkpoint: the runtimes allocate differently before `main`.
// Only malloc memory is used here: the oracle must not allocate what it counts

#if GC_ORACLE

global oracle_allocs: uint (0)
global oracle_checkpoints: uint (0)
global oracle_fd: i32 (-1)
// Address -> serial, open addressing; an address that is handed out again gets the new serial
global oracle_keys: ptr (null.@cast(ptr))
global oracle_vals: ptr (null.@cast(ptr))
global oracle_cap: uint (0)
global oracle_len: uint (0)
// The serials of a checkpoint's live objects
global oracle_live: ptr (null.@cast(ptr))
global oracle_live_len: uint (0)
global oracle_live_cap: uint (0)

fn oracle_slot(key: uint) uint $inline {
    @unsafe
    let mask = oracle_cap - 1
    let i = ((key >> 3) * 0x9E3779B97F4A7C15) & mask
    while true {
        let k = @ptrv(oracle_keys, uint, i)
        if k == key || k == 0 : return i
        i = (i + 1) & mask
    }
    return 0
}

fn oracle_grow() {
    @unsafe
    let old_keys = oracle_keys
    let old_vals = oracle_vals
    let old_cap = oracle_cap
    oracle_cap = old_cap == 0 ? 65536 : old_cap * 2
    oracle_keys = mem.calloc(oracle_cap * size_of(uint))
    oracle_vals = mem.calloc(oracle_cap * size_of(uint))
    let i: uint = 0
    while i < old_cap {
        let k = @ptrv(old_keys, uint, i)
        if k != 0 {
            let s = oracle_slot(k)
            @ptrv(oracle_keys, uint, s) = k
            @ptrv(oracle_vals, uint, s) = @ptrv(old_vals, uint, i)
        }
        i++
    }
    if old_cap != 0 {
        mem.free(old_keys)
        mem.free(old_vals)
    }
}

// Every object the allocator hands out
fn oracle_new(item: ptr) {
    @unsafe
    if oracle_cap == 0 : return
    if (oracle_len + 1) * 2 > oracle_cap : oracle_grow()
    let key = item.@cast(uint)
    let s = oracle_slot(key)
    if @ptrv(oracle_keys, uint, s) == 0 {
        @ptrv(oracle_keys, uint, s) = key
        oracle_len++
    }
    @ptrv(oracle_vals, uint, s) = ++oracle_allocs
}

// Called with each object still allocated after the checkpoint's collections
fn oracle_note_live(item: ptr) {
    @unsafe
    if oracle_cap == 0 : return
    let s = oracle_slot(item.@cast(uint))
    if @ptrv(oracle_keys, uint, s) == 0 : return
    if oracle_live_len == oracle_live_cap {
        let cap = oracle_live_cap == 0 ? 4096 : oracle_live_cap * 2
        let buffer = mem.alloc(cap * size_of(uint))
        if oracle_live_len > 0 : mem.copy_bytes(oracle_live, buffer, oracle_live_len * size_of(uint))
        if oracle_live_cap != 0 : mem.free(oracle_live)
        oracle_live = buffer
        oracle_live_cap = cap
    }
    @ptrv(oracle_live, uint, oracle_live_len++) = @ptrv(oracle_vals, uint, s)
}

fn oracle_write(text: ptr, length: uint) {
    @unsafe
    if oracle_fd < 0 || length == 0 : return
    ext.write(oracle_fd, text, length)
}

// `n` in decimal, then `end`
fn oracle_write_uint(n: uint, end: u8) {
    @unsafe
    let digits: [u8 x 24] = @undefined
    let at: uint = 23
    digits[at] = end
    while true {
        at--
        digits[at] = (n % 10).to(u8) + 48
        n = n / 10
        if n == 0 : break
    }
    oracle_write(@ref(digits).@cast(ptr) + at, 24 - at)
}

#end

/// In a `--def GC_ORACLE=1` build: collects, then writes the number of allocations so far and
/// the allocation serial numbers of the objects that are still allocated to the file named by
/// the environment variable `VALK_GC_ORACLE`. Does nothing in other builds.
+ fn oracle_checkpoint() {
    #if GC_ORACLE
    @unsafe
    if oracle_fd < 0 {
        let path = ext.getenv("VALK_GC_ORACLE".data_cstring) ?! return
        oracle_fd = ext.open(path.@cast(ptr), ext.O_WRONLY | ext.O_CREAT | ext.O_TRUNC, 0c644)
        if oracle_fd < 0 : return
        oracle_grow()
    }
    clear_stack()
    collect()
    collect()
    oracle_live_len = 0
    oracle_each_live()
    let checkpoint = ++oracle_checkpoints
    oracle_write("checkpoint ".data_cstring.@cast(ptr), 11)
    oracle_write_uint(checkpoint, ' ')
    oracle_write_uint(oracle_allocs, ' ')
    oracle_write_uint(oracle_live_len, '\n')
    let i: uint = 0
    while i < oracle_live_len {
        oracle_write_uint(@ptrv(oracle_live, uint, i++), '\n')
    }
    #end
}

use mem
use core
use ext

// At the young budget B or the log's soft cap (see Gc.set_log_caps): a collection works
// through the log in one stop, so the cap bounds the pause and the log's memory
value trigger_reached (gc.mem_new >= gc.mem_trigger || log_full)
value log_full (log_entries >= gc.e_soft)
// Removal records, card entries and range entries
value log_entries (gc.props_removed.index + gc.card_log.index / size_of(ptr))
// The scheduler's idle point: three quarters of the young budget
value trigger_almost_reached (gc.mem_new >= gc.mem_trigger / 4 * 3)

// R-13: a collection is pending while `poll_inv` is not 0. It holds POLL_SP complemented: the
// stack pointer where the budget or the soft cap ran out (the trigger_sp). The zero every
// thread starts with means nothing is pending. The compiler's loop polls collect at a stack
// pointer at or above it (a shallow point); P10 clears it
global poll_inv: uint (0)
value pending (poll_inv != 0)

/// Bytes of the GC blocks and large objects in use, including free slots.
~+ shared mem_usage_shared: uint
/// Highest value `mem_usage_shared` has reached since the program started, in bytes.
~+ shared mem_usage_peak: uint
/// Whether each collection runs a leak check over the reachable objects.
///
/// Set at startup: `true` in `GC_DEBUG` builds (such as `make test`), `false` otherwise.
+ shared verify: bool (@undefined)
/// Duration of this thread's last local collection, in microseconds.
+ global pause_last_us: uint (0)
/// Longest local collection on this thread since the last reset, in microseconds.
+ global pause_max_us: uint (0)
/// Duration of the last round over the shared memory, in microseconds (at a coarse clock's
/// resolution); 0 in a program that cannot start threads.
+ shared shared_pause_last_us: uint (0)
/// Longest round over the shared memory since the last reset, in microseconds.
+ shared shared_pause_max_us: uint (0)

// A direct call into the runtime's assembly entry: no frame of ours sits
// between the caller and the stack scan, so only the caller's own live
// words can keep objects alive
/// Runs a garbage collection of the calling thread's memory now.
///
/// Does nothing while the GC is not enabled yet. Roots are globals and the words still live
/// on the caller's stack and registers.
+ value collect (ext.valk_gc_collect)
/// Runs a round over the shared memory: stops every other thread at a safepoint or holds it
/// in native code, marks the shared heap from every thread's roots, frees what is unreachable
/// and releases the threads. Does nothing in a program that cannot start threads, which has no
/// shared memory.
///
/// Returns once a round that started after the call has ended. Like `collect`, a direct call
/// into the runtime's assembly entry, so only the caller's own live words are its roots.
+ value collect_shared (ext.valk_gc_collect_shared)

/// Resets `shared_pause_last_us` and `shared_pause_max_us` to zero.
+ fn reset_shared_pause_durations() {
    shared_pause_last_us = 0
    shared_pause_max_us = 0
}

/// Resets `pause_last_us` and `pause_max_us` of the calling thread to zero.
+ fn reset_pause_durations() {
    pause_last_us = 0
    pause_max_us = 0
}

/// Returns the bytes of the GC blocks and large objects in use, including free slots.
+ fn mem_usage() uint {
    return mem_usage_shared
}

/// Returns the largest count of `item`-byte elements, at least `count`, whose storage of
/// `prefix` bytes plus the elements still fits the GC size class that `count` of them need.
///
/// Growing storage uses it to fill its class: sizes above 128 bytes are rounded up to the next
/// of four classes per doubling, and above 8 KiB to whole pages.
+ fn fit_count(prefix: uint, item: uint, count: uint) uint {
    if item == 0 : return count
    let bytes = prefix + count * item
    let class_size = slot_size(bytes)
    if class_size <= prefix : return count
    let fitted = (class_size - prefix) / item
    return fitted > count ? fitted : count
}

/// Does nothing: the thread's state changes at each call into native code.
+ fn lock() $inline {
}
#if GROVE_MT
/// Marks a point where the thread is about to block: it may collect its own memory first, so
/// it stops naming shared data it dropped (at most once per millisecond).
+ fn unlock() {
    preblock(true)
}
#else
/// Does nothing in a program that cannot start threads.
+ fn unlock() $inline {
}
#end

/// Collects the thread's memory when allocation since the last collection reached the trigger.
///
/// Does nothing while a collection is running or the GC is not idle.
+ fn collect_if_threshold_reached() {
    if trigger_reached : collect_now()
}
/// Collects like `collect_if_threshold_reached`, but at three quarters of the trigger.
///
/// Useful at idle points such as an event loop iteration, so the collection happens before
/// an allocation forces it.
+ fn collect_if_threshold_almost_reached() {
    #if GROVE_MT
    // K12: the idle point runs the service duties when no service thread does
    duties()
    #end
    if trigger_almost_reached : collect_now()
}

#if GROVE_MT
// RT5: when the last collection ran and when a skipped one is due (CLOCK_MONOTONIC_COARSE, us)
global preblock_last_us: uint
global preblock_due_us: uint

fn coarse_us() uint {
    let value: ext.libc_timespec = @undefined
    ext.clock_gettime(6, @ref(value))
    return value.tv_sec.to(uint) * 1_000_000 + value.tv_nsec.to(uint) / 1000
}

// RT5, pre-block collections: before the thread blocks (a gc.unlock() bracket: an event wait,
// a park, a native mutex) and at the enter-native of a call outside the library, it collects
// its heap when that may drop counted or covered words into S: X_t, its young windows or its
// log are not empty, and it allocated or logged since its last collection, or its stack is
// shallower than then, or that collection ran on another coroutine's stack. At most once per
// millisecond and once per 20 pauses of the last collection, unless a round asked for it (K10);
// a skipped collection is due then, and the event wait waits no longer (preblock_wait_ms)
fn preblock(at_block: bool) {
    let c = ctl ?! return
    // K12: a pre-block point runs the service duties when no service thread does
    if at_block : duties()
    let g = gc
    if g.state != GcState.idle {
        preblock_due_us = 0
        return
    }
    if c.want_local == 0 {
        let now = coarse_us()
        // Once per millisecond, and at most about 5 % of the thread's time
        let gap = pause_last_us * 20
        if gap < 1000 : gap = 1000
        if now - preblock_last_us < gap {
            if at_block && preblock_due_us == 0 && preblock_due(g) : preblock_due_us = preblock_last_us + gap
            return
        }
        if !preblock_due(g) {
            preblock_due_us = 0
            return
        }
        preblock_last_us = now
    }
    preblock_due_us = 0
    collect_now()
}

fn preblock_due(g: *Gc) bool {
    let active = log_entries > 0 || g.mem_new > 0 || runs_open()
    if active : return true
    if g.xt_len == 0 : return false
    return stack_pointer() > g.last_sp || @ptrv(g.current_coro, ?ptr) != g.last_coro
}

// Whether a pool's current run holds objects allocated since the last collection
fn runs_open() bool {
    let list = alc_list
    let adr = list.data
    let end = adr + list.index
    while adr < end {
        let pool = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        if pool.cursor != pool.run : return true
    }
    return false
}

// The enter-native of a bracketed call made outside the library (C7, RT5)
fn preblock_native() {
    preblock(false)
}

/// Milliseconds until a pre-block collection that was skipped is due; `uint.$max` when none is.
///
/// The event loop waits no longer than this, so the collection runs on its timeout.
+ fn preblock_wait_ms() uint {
    // K12: and no longer than until a service duty of this thread is due
    let duty = duty_wait_ms()
    let due = preblock_due_us
    if due == 0 : return duty
    let now = coarse_us()
    if now >= due : return 0
    let ms = (due - now + 999) / 1000
    return ms < duty ? ms : duty
}
#end

// R-49: a coroutine switch collects while a collection is pending
fn collect_if_pending() {
    if pending : collect_now()
}

fn collect_now() {
    if gc.state != GcState.idle : return
    gc.collect()
}

// No other thread scans this stack while it blocks
fn clear_stack() $inline {
}

/// Does nothing: rounds over the shared memory start by themselves.
+ fn collect_shared_if_threshold_reached() {
}

/// Does nothing: the store barrier records the references of a block that moves. Kept for
/// compatibility.
+ fn transfer_refs(from: ptr, to: ptr) {
}

// The stack pointer, near enough: the address of a local of the calling frame
fn stack_pointer() uint $inline {
    let probe: uint = 0
    return @ref(probe).@cast(ptr)
}

// R-13, at a refill or a large allocation that brings `allocated` to `bytes` more: pending at
// B, at once at H or the log's hard cap. A polling refill (an allocation site inside a loop)
// also collects when pending at a stack pointer at or above the trigger_sp
fn alloc_trigger(bytes: uint, polling: bool) {
    #if GROVE_MT
    // A refill and a large allocation join a requested round (RT8)
    if gc_dead != 0 : ext._exit(127)
    join_if_requested()
    #end
    let allocated = gc.mem_new + bytes
    if allocated >= gc.mem_limit || log_entries >= gc.e_hard {
        collect_now()
        return
    }
    if !pending && (allocated < gc.mem_trigger || gc.state != GcState.idle) : return
    // One probe: two would be two slots of this frame
    let sp = stack_pointer()
    if !pending {
        poll_inv = ~sp
        #if GROVE_MT
        poll_sync()
        #end
    }
    if polling && sp >= ~poll_inv : collect_now()
}

// B6 at the soft cap: pending; at the hard cap: at once
fn log_trigger() {
    if log_entries >= gc.e_hard {
        collect_now()
        return
    }
    if pending || gc.state != GcState.idle : return
    poll_inv = ~stack_pointer()
    #if GROVE_MT
    poll_sync()
    #end
}

/// Allocates `size` bytes of GC memory whose contents are not scanned for references.
///
/// A `size` of 0 still returns a valid, distinct allocation (of the smallest size).
+ fn alloc(size: uint) GcPtr {
    if size == 0 : size = 1
    let pool = get_untyped_pool(size)
    if pool.large : return pool.get_large(size).@cast(GcPtr)
    return pool.get().@cast(GcPtr)
}

/// Allocates `size` bytes of GC memory whose references are traced through `layout`.
///
/// `layout` is a compiler-generated reference layout; `null` means nothing is traced.
/// A `size` of 0 still returns a valid, distinct allocation (of the smallest size).
+ fn alloc_typed(size: uint, layout: ?ptr) GcPtr {
    @unsafe
    if size == 0 : size = 1
    let pool = get_typed_pool(size, layout)
    if pool.large : return pool.get_large(size).@cast(GcPtr)
    return pool.get().@cast(GcPtr)
}

/// Allocates `size` zeroed bytes of GC memory whose references are traced through `layout`.
///
/// The compiler uses it for slice storage. Memory that comes zeroed from the OS, never
/// allocated from since, is not cleared again.
+ fn alloc_typed_zeroed(size: uint, layout: ?ptr) GcPtr {
    @unsafe
    return alloc_zeroed(size, layout, false)
}

// The compiler's slice allocation inside a loop
fn alloc_typed_zeroed_polling(size: uint, layout: ?ptr) GcPtr {
    @unsafe
    return alloc_zeroed(size, layout, true)
}

// C-21, C-19: the compiler's sequence allocation of `size` bytes (the length word included).
// `slot` is a TLS word of the compiler's that caches the layout's record of pools, one per size
// class, so the fast path is a table load and a bump; a layout of null uses the untyped pools.
// The storage is zeroed after its length word unless `zero` is false (the caller writes every
// element before the next safepoint, C-18) or the run is pre-zeroed. The caller writes the length
fn alloc_seq(size: uint, layout: ?ptr, slot: ?ptr, zero: bool, polling: bool) ptr $inline {
    @unsafe
    #if GC_STRESS
    stress_collect()
    #end
    let record: ?ptr = @ref(pools).@cast(ptr)
    if isset(layout) {
        let s = slot ?! return alloc_seq_slow(size, layout, slot, zero, polling)
        record = @ptrv(s, ?ptr)
    }
    if size <= LARGE_SLOT && isset(record) {
        let pool = @ptrv(record, ?*Pool, get_pool_index_for_size(size))
        if isset(pool) {
            let item = pool.cursor
            let next = item + pool.isize
            if next <= pool.limit {
                pool.cursor = next
                #if GC_DEBUG
                alloc_check(item, pool.isize)
                #end
                if zero && !pool.zeroed : mem.clear_bytes(item + size_of(uint), size - size_of(uint))
                #if GC_DEBUG
                if zero && pool.zeroed : zero_check(item, size)
                #end
                #if GC_ORACLE
                oracle_new(item)
                #end
                return item
            }
        }
    }
    return alloc_seq_slow(size, layout, slot, zero, polling)
}

// The first allocation of a layout or size class, a refill, or a large object
fn alloc_seq_slow(size: uint, layout: ?ptr, slot: ?ptr, zero: bool, polling: bool) ptr $noinline {
    @unsafe
    let lay = layout
    let s = slot
    if isset(lay) && isset(s) : @ptrv(s, ptr) = kind_record(lay)
    let pool = get_typed_pool(size, layout)
    let item = pool.large ? pool.get_large(size, polling) : (polling ? pool.get_polling() : pool.get())
    if !zero : return item
    if pool.zeroed {
        #if GC_DEBUG
        zero_check(item, size)
        #end
        return item
    }
    mem.clear_bytes(item + size_of(uint), size - size_of(uint))
    return item
}

fn alloc_zeroed(size: uint, layout: ?ptr, polling: bool) GcPtr {
    @unsafe
    if size == 0 : size = 1
    let pool = get_typed_pool(size, layout)
    let item = pool.large ? pool.get_large(size, polling) : (polling ? pool.get_polling() : pool.get())
    if pool.zeroed {
        #if GC_DEBUG
        zero_check(item, size)
        #end
        return item.@cast(GcPtr)
    }
    mem.clear_bytes(item, size)
    return item.@cast(GcPtr)
}

/// Clones a closure environment; used by the compiler when a closure value is copied.
///
/// An environment allocated for captures is cloned through its pool's hook. A bare receiver
/// object is shared, not copied, and `null` returns `null`.
+ fn clone_closure_env(env: ?ptr) ?ptr {
    @unsafe
    if !isset(env) : return null
    if !in_heap(env) : return env
    let clone = desc_of(env).env_clone
    if !isset(clone) : return env
    return clone(env)
}

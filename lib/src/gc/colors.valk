
use mem

global colors : *[Color] (@undefined)
global colors_free : *LifoFor[u32] (@undefined)
global color_next : u32
global color_max : u32

value COLOR_BUILTIN_COUNT (2)

struct Color {
    owner: u32 (0)
    valid: bool (true)
}

fn colors_init() {
    colors_free = .new()
    color_next = COLOR_BUILTIN_COUNT
    color_max = 32
    colors = mem:calloc(size_of(Color) * color_max)
    let c1 = &colors[0]
    let c2 = &colors[1]
    c1.valid = false
    c2.valid = true
}

fn get_color() u32 {
    let i = colors_free.pop() ! {
        let c = color_next++
        if color_next >= color_max {
            let size = color_max * size_of(Color)
            let new_size = size * 2
            colors = mem:resize(colors, size, new_size)
            mem:clear(colors.@cast(ptr) + size, new_size - size)
            color_max *= 2
        }
        return c
    }
    return i
}

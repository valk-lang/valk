
use mem

global colors : *[Color] (@undefined)

value COLOR_BUILTIN_COUNT (2)
value color_shared (1)

struct Color {
    parent: ?ptr (null)
    root: ?ptr (null) // Item the color started at; entry point for the disconnect sweep
    parent_color: u32 (0)
    uses: u8 (0)
    valid: bool (true)   // Decoupled root or cracked
    cracked: bool (true) // Some ref of same color got removed
    backtrace_checked: bool (false)

    // Losing validity means the region this color covers is no longer reachable
    // through its parent. Queue the item the color started at, so the disconnect
    // pass has an entry point into the region even when the referring object was
    // already freed in an earlier collect.
    fn invalidate() {
        this.valid = false
        let root = this.root
        if isset(root) : gc.disconnect_list.add(root)
    }

    fn backtrace() bool {
        let color = this
        while color.valid {
            if color.backtrace_checked || color.parent_color == 1 {
                color = this
                while !color.backtrace_checked {
                    color.backtrace_checked = true
                    if color.parent_color == 1 : break
                    color = get_color_object(color.parent_color)
                }
                return true
            }
            color = get_color_object(color.parent_color)
        }

        color = this
        while color.valid {
            color.invalidate()
            color = get_color_object(color.parent_color)
        }
        return false
    }

    // A color whose parent was invalidated this collect can still come back:
    // marking may have recaptured an ancestor. Walk up to the first color that
    // survived; everything on the way belongs to it again.
    fn revive(index: u32) bool {
        if !this.has_living_ancestor() : return false
        let i = index
        while true {
            let color = get_color_object(i)
            if color.valid : return true
            color.valid = true
            gc.colors_valid.add(i)
            i = color.parent_color
        }
        return true
    }

    fn has_living_ancestor() bool {
        let color = this
        let steps = gc.color_next
        while steps-- > 0 {
            let p = color.parent_color
            if p == 0 : return false
            color = get_color_object(p)
            if color.valid : return true
        }
        return false
    }

    fn remove_parent() {
        this.parent = null
        this.parent_color = 0
        this.invalidate()
    }
}

// The item is leaving its color, so the color loses its entry point. Anything
// left in that region is reached through the item's new color instead.
fn detach_root(data: *GcData, item: GcItem) {
    data.remove_is_root()
    let color = data.get_color()
    if color.root == item : color.root = null
}

// Remember an item that points outside its own color. The chain is the only
// record of those edges, so every collect re-walks it: a color that lost its
// root is recaptured through the item that still points into it.
//
// `gc.chain_now` is for items that must be walked before this same collect
// frees anything, `gc.chain` for the ones the next collect picks up.
fn queue_chain(item: GcItem, list: *Lifo) {
    let data = item.data()
    if data.is_in_updates() : return
    data.set_in_updates()
    list.add(item)
}

fn colors_init() {
    gc.color_next = COLOR_BUILTIN_COUNT
    gc.color_max = 32
    colors = mem:calloc(size_of(Color) * gc.color_max)
    let c1 = &colors[0]
    let c2 = &colors[1]
    c1.valid = false
    c2.valid = true
}

fn get_color_object(i: u32) *Color {
    return (&colors[i]).@cast(*Color)
}

fn get_color() u32 {
    let i = gc.colors_pool.pop() !? <{
        let c = gc.color_next++
        if c >= gc.color_max {
            let size = gc.color_max * size_of(Color)
            let new_size = size * 2
            colors = mem:resize(colors, size, new_size)
            mem:clear(colors.@cast(ptr) + size, new_size - size)
            gc.color_max *= 2
        }
        return c
    }
    let col = &colors[i]
    col.parent = null
    col.root = null
    col.parent_color = 0
    col.valid = true
    col.cracked = false
    col.backtrace_checked = false
    col.uses = 1
    gc.colors_new.add(i)
    return i
}


use mem

global colors : *[Color] (@undefined)

value COLOR_BUILTIN_COUNT (2)
value color_shared (1)

struct Color {
    parent: ?ptr (null)
    parent_color: u32 (0)
    uses: u8 (0)
    valid: bool (true)   // Decoupled root or cracked
    cracked: bool (true) // Some ref of same color got removed
    backtrace_checked: bool (false)
    //
    child_index: u32 (0)
    update_index: u32 (0)

    fn backtrace() bool {
        let color = this
        while color.valid {
            if color.backtrace_checked || color.parent_color == 1 {
                color = this
                while !color.backtrace_checked {
                    color.backtrace_checked = true
                    if color.parent_color == 1 : break
                    color = get_color_object(color.parent_color)
                }
                return true
            }
            color = get_color_object(color.parent_color)
        }

        color = this
        while color.valid {
            color.valid = false
            color = get_color_object(color.parent_color)
        }
        return false
    }

    fn remove_parent() {
        this.parent = null
        this.parent_color = 0
        this.valid = false
    }

    fn add_child(item: GcItem) {
        let data = item.data()
        if data.is_in_updates() : return
        data.set_in_updates()
        //
        let list = gc.reclaim_chain
        let ci = this.child_index
        let new_index = list.index.to(u32)
        this.child_index = new_index
        if ci == 0 {
            list.add({ item: item })
        } else{
            let prev = list.get_index_ref(ci)
            list.add({ item: item, prev: prev })
        }
    }

    fn add_update(item: GcItem) {
        let data = item.data()
        if data.is_in_updates() : return
        data.set_in_updates()
        //
        let list = gc.update_chain
        let ci = this.update_index
        let new_index = list.index.to(u32)
        this.update_index = new_index
        if ci == 0 {
            list.add({ item: item })
        } else{
            let prev = list.get_index_ref(ci)
            list.add({ item: item, prev: prev })
        }
    }

    fn recapture() {
        let ci = this.child_index
        if ci == 0 : return
        this.child_index = 0
        //
        let chain : ?*ItemChain = gc.reclaim_chain_current.get_index_ref(ci)
        while isset(chain) {
            let item = chain.item
            chain = chain.prev
            loop_items(item, mark_item)
        }
    }
    fn handle_updates() {
        let ci = this.update_index
        if ci == 0 : return
        this.update_index = 0
        //
        let chain : ?*ItemChain = gc.update_chain_current.get_index_ref(ci)
        while isset(chain) {
            let item = chain.item
            chain = chain.prev
            loop_items(item, mark_item)
        }
    }
}

fn colors_init() {
    gc.color_next = COLOR_BUILTIN_COUNT
    gc.color_max = 32
    colors = mem:calloc(size_of(Color) * gc.color_max)
    let c1 = &colors[0]
    let c2 = &colors[1]
    c1.valid = false
    c2.valid = true
}

fn get_color_object(i: u32) *Color {
    return (&colors[i]).@cast(*Color)
}

fn get_color() u32 {
    let i = gc.colors_pool.pop() !? <{
        let c = gc.color_next++
        if c >= gc.color_max {
            let size = gc.color_max * size_of(Color)
            let new_size = size * 2
            colors = mem:resize(colors, size, new_size)
            mem:clear(colors.@cast(ptr) + size, new_size - size)
            gc.color_max *= 2
        }
        return c
    }
    let col = &colors[i]
    col.parent = null
    col.parent_color = 0
    col.valid = true
    col.cracked = false
    col.backtrace_checked = false
    col.uses = 1
    col.child_index = 0
    col.update_index = 0
    gc.colors_new.add(i)
    return i
}

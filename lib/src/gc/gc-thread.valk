@unsafe

use core
use io

fn thread_init(is_main: bool (false)) {
    //
    core.rlock_count = 0

    pools_init()
    @INIT_ALLOCATORS
    gc = Gc.init()
    //
    if is_main {
        mem_shared_trigger = mem_minimum_trigger

        #if GC_DEBUG
        verify = true
        #else
        verify = false
        #end

        //
        core.rlock = .new()
        shared_lock = .new()
        gc_list = .new()
    }
    // Add to gc list
    gc.lock()
    shared_lock.lock()
    gc_list.append(gc)
    shared_lock.unlock()
}

fn thread_stop() {
    // This thread runs no more user code, so its stack holds no roots any
    // more. Mark the gc as shut down before we release our lock, so a shared
    // collection that grabs us in the window below already treats our stack as
    // empty and can release everything we still reference in one pass.
    gc.did_shutdown = true

    // Hold the shared lock for the whole teardown, so a shared collection
    // either sees us in 'gc_list' with all of our shared items, or sees us
    // gone with those items already in the dump. Lock order is the same one
    // collect_shared() uses: release our own lock, take the shared lock, then
    // take our own lock again.
    gc.unlock()
    shared_lock.lock()
    gc.lock()

    // Remove from gc list
    gc_list.remove_value(gc)

    // Final collection + hand over our shared items. Keep both locks until the
    // thread has notified its waiters: once the gc is removed from gc_list,
    // shared_lock is what prevents its Thread object from being finalized.
    gc.shutdown()
}

fn thread_free() {
    shared_lock.unlock()
    gc.free()
    pools_free()
}

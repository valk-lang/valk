#if !GROVE

use core
use io
use ext
use mem
use coro

fn thread_init(is_main: bool (false)) {
    @unsafe
    if is_main {
        blocks_init()
        ext.valk_gc_set_entry(Gc.collect_native.@cast(ptr))
    }
    pools_init()
    @INIT_ALLOCATORS
    gc = Gc.init()
    thread_gc = gc
    #if OS == "linux"
    // One read of the stack bounds: glibc parses /proc/self/maps for the main thread
    let stack_low, stack_top = thread_stack_bounds()
    gc.stack_top = stack_top
    coro.stack_guard_init(is_main, stack_low)
    #elif OS == "macos"
    gc.stack_top = thread_stack_top()
    let top: uint = gc.stack_top
    coro.stack_guard_init(is_main, top - ext.pthread_get_stacksize_np(ext.pthread_self()))
    #else
    gc.stack_top = thread_stack_top()
    coro.stack_guard_init(is_main, 0)
    #end
    //
    if is_main {
        mem_shared_trigger = mem_shared_minimum_trigger

        #if GC_DEBUG
        verify = true
        #else
        verify = false
        #end

        //
        shared_lock = .new()
        gc_list = .new()
        pmark_queue = Lifo.new()
        pmark_units = Bump.new(1024)
    }
    // Add to gc list
    gc.lock()
    shared_lock.lock()
    gc_list.append(gc)
    shared_lock.unlock()
}

#if OS == "linux"
fn thread_stack_bounds() (uint, ptr) {
    let attr = ext.pthread_attr_t{}
    if ext.pthread_getattr_np(ext.pthread_self(), @ref(attr)) != 0 : panic("Failed to read the thread stack bounds")
    let address: ptr = null.@cast(ptr)
    let size: uint = 0
    if ext.pthread_attr_getstack(@ref(attr), @ref(address), @ref(size)) != 0 : panic("Failed to read the thread stack bounds")
    ext.pthread_attr_destroy(@ref(attr))
    return (address, address + size)
}
#else
fn thread_stack_top() ptr {
    #if OS == "macos"
    return ext.pthread_get_stackaddr_np(ext.pthread_self())
    #else
    return ext.valk_gc_stack_base()
    #end
}
#end

fn thread_stop() {
    // Hold the shared lock for the whole teardown, so a shared collection
    // either sees us in 'gc_list' with all of our shared items, or sees us
    // gone with those items already in the dump. Lock order is the same one
    // collect_shared() uses: release our own lock, take the shared lock, then
    // take our own lock again. Our stack still counts as roots in that window:
    // the Thread object is used after this returns, and nobody else may hold it.
    gc.unlock()
    shared_lock.lock()
    gc.lock()

    // Remove from gc list
    gc_list.remove_value(gc)

    // Final collection + hand over our shared items. Keep both locks until the
    // thread has notified its waiters: once the gc is removed from gc_list,
    // shared_lock is what prevents its Thread object from being finalized.
    gc.shutdown()
}

fn thread_free() {
    shared_lock.unlock()
    let marking = pmark_local_list
    if isset(marking) {
        marking.free()
        pmark_local_list = null
    }
    gc.free()
    pools_free()
    #if OS != "win"
    coro.stack_cache_release()
    #end
}

#end

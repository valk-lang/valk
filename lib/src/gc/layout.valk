@unsafe

// GC layouts. The compiler emits one constant per allocation type listing
// the byte offsets of every managed pointer (allocator_layout_words):
//   [kind, data offset, stride, N, G, N offsets, G groups]
//   group: [C, C x (tag offset, tag), M, M offsets]
// Kind 0 is one object. Kind 1 is a sequence: the first word of the
// allocation is the element count, elements start at `data offset` and are
// `stride` bytes each. A group's offsets hold managed pointers only while
// every tag byte matches: the active member of a union.

value layout_kind (0)
value layout_data_offset (1)
value layout_stride (2)
value layout_plain_count (3)
value layout_group_count (4)
value layout_header (5)

// Calls `cb` with the address of every managed pointer slot of `item` that is
// not null. Inlined so that a known callback is called directly
fn each_ref(item: ptr, layout: ptr, list: *Lifo, cb: fnptr(ptr, *Lifo)()) $inline {
    @unsafe
    if @ptrv(layout, uint, layout_kind) == 0 {
        each_field_ref(item, layout, list, cb)
        return
    }
    let length = @ptrv(item, uint)
    let stride = @ptrv(layout, uint, layout_stride)
    let base: ptr = item + @ptrv(layout, uint, layout_data_offset)
    let end: ptr = base + length * stride
    let plain = @ptrv(layout, uint, layout_plain_count)
    let groups = @ptrv(layout, uint, layout_group_count)
    if plain == 1 && groups == 0 && stride == size_of(ptr) && @ptrv(layout, uint, layout_header) == 0 {
        // A sequence of bare pointers
        while base < end {
            let v = @ptrv(base, ?ptr)
            if isset(v) : cb(base, list)
            base += size_of(ptr)
        }
        return
    }
    while base < end {
        each_field_ref(base, layout, list, cb)
        base += stride
    }
}

fn each_field_ref(base: ptr, layout: ptr, list: *Lifo, cb: fnptr(ptr, *Lifo)()) $inline {
    @unsafe
    let plain = @ptrv(layout, uint, layout_plain_count)
    let groups = @ptrv(layout, uint, layout_group_count)
    let word: ptr = layout + layout_header * size_of(ptr)
    let end: ptr = word + plain * size_of(ptr)
    while word < end {
        let slot: ptr = base + @ptrv(word, uint)
        let v = @ptrv(slot, ?ptr)
        if isset(v) : cb(slot, list)
        word += size_of(ptr)
    }
    while groups > 0 {
        groups--
        let conditions = @ptrv(word, uint)
        word += size_of(ptr)
        let active = true
        while conditions > 0 {
            conditions--
            let tag_offset = @ptrv(word, uint)
            let tag = @ptrv(word, uint, 1)
            word += size_of(ptr) * 2
            if @ptrv(base + tag_offset, u8).to(uint) != tag : active = false
        }
        let count = @ptrv(word, uint)
        word += size_of(ptr)
        let group_end: ptr = word + count * size_of(ptr)
        if active {
            while word < group_end {
                let slot: ptr = base + @ptrv(word, uint)
                let v = @ptrv(slot, ?ptr)
                if isset(v) : cb(slot, list)
                word += size_of(ptr)
            }
        }
        word = group_end
    }
}

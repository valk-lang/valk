
// value flag_own_state (3)
// value flag_owned (1)
// value flag_no_owner (2)

// value flag_shared (4)
// value flag_on_stack (8)
// value flag_still_co_owned (16)
// value flag_in_updates (32)
// value flag_shmark (64)
// value flag_leak (128)

// value prop_owned (1)
// value prop_co_owned (2)
// value prop_mask (3)

value flag_root (1)
value flag_in_updates (2)
value flag_on_stack (4)
value flag_leak (128)

fn gcdata(v1: ptr) *GcData {
    return v1.$offset(-8)
}

// value shmarkmask ((0xFF - flag_shmark))
value leakmask ((0xFF - flag_leak))
// value allmarkmask (((0xFF - 64) - 128))

struct GcData {
    color: u32
    flags: u8
    unused: u8
    offset: u16

    fn item() *GcItem { return this.$offset(8) }
    fn block() *BlockMini { return this.$offset(this.offset.to(int) * -1) }
    fn get_color() *Color { return (&colors[this.color]).@cast(*Color) }

    fn is_shared() bool { return this.color == color_shared }
    fn is_valid() bool { return (&colors[this.color]).valid }
    // Flags
    fn is_root() bool { return (this.flags & flag_root) == flag_root }
    fn is_in_updates() bool { return (this.flags & flag_in_updates) == flag_in_updates }
    fn is_on_stack() bool { return (this.flags & flag_on_stack) == flag_on_stack }
    //
    fn set_is_root() { this.flags = this.flags | flag_root }
    fn set_in_updates() { this.flags = this.flags | flag_in_updates }
    fn set_on_stack() { this.flags = this.flags | flag_on_stack }
    //
    fn remove_is_root() { this.flags = this.flags & (255 - flag_root) }
    fn remove_in_updates() { this.flags = this.flags & (255 - flag_in_updates) }
    fn remove_on_stack() { this.flags = this.flags & (255 - flag_on_stack) }
    //
    fn has_leak_mark() bool { return (this.flags & flag_leak) == flag_leak }
    fn set_leak_mark() { this.flags = this.flags | flag_leak }
    fn remove_leak_mark() { this.flags = this.flags & leakmask }
}

pointer GcItem {
    fn data() *GcData { return this.$offset(-8) }
    fn add_props() {
        let data = this.data()
        if data.offset == 0 : return
        let props = data.block().props
        if isset(props) : props(this, gc.mark_list)
    }
}


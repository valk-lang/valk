
fn mark_used(item: ?GcItem) $hot {

    let ml = gc.mark_list
    if isset(item) {
        let data = gcdata(item)
        let is_new = data.is_new()

        #if GC_DEBUG
        if data.is_still_co_owned() : panic("double ownership")
        #end

        data.set_owned()
        if data.offset > 0 && is_new {
            let block = data.block()
            block.slots_used++
            gc.mem_marked += block.isize
        }
        ml.add(item)
    }

    while ml.index > 0 {
        let item = ml.pop_unchecked()
        let data = gcdata(item)
        if data.offset == 0 : continue

        let block = data.block()
        let pf = block.props
        if isset(pf) : pf(item, ml, mark_used_props)
    }
}

fn mark_used_props(ref: ptr, list: Lifo) $hot {
    let sub = @ptrv(ref, ?ptr)
    if !isset(sub) : return
    if sub & prop_mask == 0 {
        let sub_data = gcdata(sub)
        if sub_data.is_not_owned_not_shared() {
            @ptrv(ref, ptr) = sub | prop_owned
            let is_new = sub_data.is_new()
            sub_data.set_owned()
            if is_new && sub_data.offset > 0 {
                let sub_block = sub_data.block()
                sub_block.slots_used++
                gc.mem_marked += sub_block.isize
            }
            list.add(sub)
        } else {
            @ptrv(ref, ptr) = sub | prop_co_owned
            sub_data.co_own()
        }
    }
}

fn free_blank(item: ptr) $hot {
    let data = gcdata(item)
    if data.is_not_new() : return

    // Call gc_free
    let block = data.block()
    let onfree = block.onfree
    if isset(onfree) : onfree(item)

    #if GC_DEBUG
    if data.co_count != 0 : panic("co_count not 0 before free")
    if data.flags != 0 {
        print("Flags: ")
        data.flags.print(10)
        print("\n")
        panic("GC error: Flags not 0 before free")
    }
    #end
}

fn preserve_stack_owner(item: GcItem) {
    gcdata(item).set_owned()
    gc.prev_stack_items.add_ptr(item)
}

fn should_dis_own(item: GcItem) bool $inline {
    let data = gcdata(item)

    #if GC_DEBUG
    if data.is_shared() : panic("removing ownership from shared item")
    if data.is_new() : panic("double ownership removal")
    if data.is_still_co_owned() : panic("unexpected ownership removal")
    #end

    if data.offset == 0 : return false
    if data.is_on_stack() {
        preserve_stack_owner(item)
        return false
    }

    return true
}

fn queue_dis_owned(item: GcItem, list: Lifo) $inline {
    if should_dis_own(item) : list.add(item)
}

fn dis_own_rec(item: ptr) (uint, uint) {

    let ml = gc.mark_list
    let disowned: uint = 0
    let unmarked_bytes: uint = 0
    if !should_dis_own(item) : return (0, 0)

    while true {
        let data = gcdata(item)

        disowned++
        data.set_new()
        if data.co_count > 0 : gc.re_own_list.add_ptr(item)

        let block = data.block()
        block.slots_used--
        unmarked_bytes += block.isize

        // Props
        let pf = block.props
        if isset(pf) : pf(item, ml, dis_own_props)

        let onfree = block.onfree
        if isset(onfree) : gc.blanks.add_ptr(item)

        if ml.index == 0 : break
        item = ml.pop_unchecked()
    }
    return (disowned, unmarked_bytes)
}

fn dis_own_props(ref: ptr, list: Lifo) {
    let sub = @ptrv(ref, ?ptr)
    if !isset(sub) : return
    if sub & prop_owned == prop_owned {
        let sub_item = sub - prop_owned
        // A slot holding a bare tag means the pointer bits are gone while the
        // tag survived. Nothing can write that: both taggers OR a tag onto an
        // already non-null pointer. Without this the next line computes
        // gcdata(null) and the fault lands on address -8, naming the victim
        // rather than the slot. Compare against null, not isset(): sub_item is
        // plain `ptr`, so isset() folds to compile-time true and vanishes.
        #if GC_DEBUG
        if sub_item == null : panic("GC error: property slot holds a bare 'owned' tag")
        #end
        @ptrv(ref, ptr) = sub_item
        let sub_data = gcdata(sub_item)
        sub_data.set_no_owner()
        if sub_data.is_shared() : return
        queue_dis_owned(sub_item, list)
    } else if sub & prop_co_owned == prop_co_owned {
        let sub_item = sub - prop_co_owned
        #if GC_DEBUG
        if sub_item == null : panic("GC error: property slot holds a bare 'co-owned' tag")
        #end
        @ptrv(ref, ptr) = sub_item
        let sub_data = gcdata(sub_item)
        atomic(sub_data.co_count - 1)
        if sub_data.is_still_co_owned() {
            sub_data.remove_still_co_owned()
            // Lets pretend we were the owner
            queue_dis_owned(sub_item, list)
        }
    }
}

fn share_null_check(item: ?ptr) {
    if isset(item) {
        share(item)
    }
}

fn share(item: GcItem) {
    let ds = gc.dont_stop
    gc.dont_stop = true

    let ml = gc.mark_list
    let start = ml.index
    ml.add(item)

    while ml.index > start {
        let item = ml.pop_unchecked().@cast(GcItem)
        let data = gcdata(item)

        if data.is_shared() : continue
        data.set_shared()
        // data.set_mark()

        let is_new = data.is_new()
        if is_new : data.set_no_owner()
        else if data.is_still_co_owned() {
            data.remove_still_co_owned()
            data.set_no_owner()
        }

        if data.offset == 0 : continue
        gc.shared_items.add_ptr(item)

        let block = data.block()
        let size = block.isize
        if is_new {
            block.slots_used++
        } else {
            gc.mem_marked -= size
        }
        atomic(mem_shared + size)

        // Props
        let pf = block.props
        if isset(pf) {
            pf(item, ml, fn(ref: ptr, list: Lifo) {
                let sub = @ptrv(ref, ?ptr)
                if !isset(sub) : return
                let sub_item : GcItem = sub & -4.to(uint)
                let sub_data = gcdata(sub_item)
                if sub & prop_owned == prop_owned {
                    // Remove ownership
                    @ptrv(ref, ?GcItem) = sub_item
                    sub_data.set_no_owner()
                } else if sub & prop_co_owned == prop_co_owned {
                    // Remove co ownership
                    @ptrv(ref, ?GcItem) = sub_item
                    atomic(sub_data.co_count - 1)
                }

                if sub_data.is_shared() : return
                list.add(sub_item)
            })
        }
    }

    gc.dont_stop = ds
}

fn update_mark(item: GcItem) {

    let data = gcdata(item)
    if data.is_marked() : return
    data.set_mark()

    let ml = gc.mark_list
    ml.add(item)

    while ml.index > 0 {
        let item = ml.pop_unchecked().@cast(GcItem)
        let data = gcdata(item)

        if data.offset == 0 : continue

        // Props
        let block = data.block()
        let pf = block.props
        if isset(pf) {
            pf(item, ml, fn(ref: ptr, list: Lifo) {
                let sub = @ptrv(ref, ?ptr)
                if !isset(sub) : return
                let sub_item : GcItem = sub & -4.to(uint)
                let sub_data = gcdata(sub_item)
                if sub_data.is_marked() : return 
                sub_data.set_mark()
                list.add(sub_item)
            })
        }
    }
}

fn mark_leak_rec(item: GcItem, on: bool) {

    let ml = gc.mark_list
    ml.add(item)

    while ml.index > 0 {
        let item = ml.pop_unchecked().@cast(GcItem)
        let data = gcdata(item)
        if data.is_shared() : continue
        if on {
            if data.has_leak_mark() : continue 
            data.set_leak_mark()
        } else {
            if !data.has_leak_mark() : continue 
            data.remove_leak_mark()
        }

        if data.offset == 0 : continue

        // Props
        let block = data.block()
        let pf = block.props
        if isset(pf) {
            pf(item, ml, fn(ref: ptr, list: Lifo) {
                let sub = @ptrv(ref, ?ptr)
                if !isset(sub) : return
                let sub_item : ptr = sub & -4.to(uint)
                list.add(sub_item)
            })
        }
    }
}

fn share_null_check(item: ?ptr) {
    if isset(item) : share(item)
}

fn share(item: GcItem) {
    let dont_stop = gc.dont_stop
    gc.dont_stop = true

    let list = gc.mark_list
    let start = list.index
    list.add(item)

    while list.index > start {
        let item = list.pop_unchecked().@cast(?GcItem)
        if item == null : continue
        let shared_item = item.@cast(GcItem)
        let data = shared_item.data()
        let old_color = data.color
        if old_color == color_shared : continue

        if old_color > color_shared {
            let color = data.get_color()
            color.cracked = true
            if data.is_root() : color.remove_parent()
        }

        data.color = color_shared
        data.remove_is_root()
        data.remove_in_updates()
        if data.offset == 0 : continue

        gc.shared_items.add_ptr(shared_item)
        let block = data.block()
        if old_color == 0 : block.slots_used++
        else : gc.mem_marked -= block.isize
        atomic(mem_shared + block.isize)

        let props = block.props
        if isset(props) : props(shared_item, list)
    }

    gc.dont_stop = dont_stop
}



fn loop_items(parent: GcItem, func: fn(ptr, ptr)(bool)) {
    let ml = gc.mark_list
    ml.add(parent)
    while ml.index > 0 {
        let parent = ml.pop_unchecked().@cast(?GcItem)
        if !isset(parent) : continue
        let start = ml.index
        parent.add_props()
        let end = ml.index
        let data = ml.data
        while start < end {
            let item = @ptrv(data, ?GcItem, start)
            if isset(item) {
                let recursive = func(parent, item)
                if !recursive : @ptrv(data, ?GcItem, start) = null
            }
            start++
        }
    }
}

fn mark_item(parent: GcItem, item: GcItem) bool $hot {
    //
    let pdata = parent.data()
    let pcol = pdata.color
    //
    let data = gcdata(item)
    let item_col = data.color
    let item_color = data.get_color()
    //
    if item_color.valid {
        if item_col == pcol : return false
        if item_col == color_shared : return false
        //
        let pcolor = pdata.get_color()
        if data.is_root() : pcolor.add_child(parent)
        else : pcolor.add_update(parent)
        return false
    }
    // Check if reclaim-able root
    if data.is_root() && !item_color.cracked {
        item_color.valid = true
        item_color.parent = parent
        item_color.parent_color = pcol
        gc.colors_valid.add(item_col)
        return false
    }

    // Check if should use a new color
    let pcolor = &colors[pcol]
    if pcolor.uses > 128 {
        // Use new color
        let new_col = get_color()
        let new_color = &colors[new_col]
        new_color.parent = parent
        new_color.parent_color = pcol
        //
        data.set_is_root()
        data.color = new_col
    } else {
        // Use parent color
        data.color = pcol
        pcolor.uses++
    }

    // Update usage info
    if item_col == 0 && data.offset > 0 {
        let block = data.block()
        block.slots_used++
        gc.mem_marked += block.isize
    }
    return true
}


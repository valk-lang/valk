fn disconnect(item: ptr) (uint, uint) {

    let ml = gc.mark_list
    let disowned: uint = 0
    let unmarked_bytes: uint = 0

    ml.add(item)

    while true {
        let item = (ml.pop() ! break).@cast(?GcItem)
        if !isset(item) : continue
        let data = item.data()
        if data.color == 0 : continue
        if data.get_color().valid : continue

        disowned++
        data.color = 0
        data.remove_is_root()

        if data.offset != 0 {
            let block = data.block()
            block.slots_used--
            unmarked_bytes += block.isize
            // Props
            let pf = block.props
            if isset(pf) : pf(item, ml)
            //
            let onfree = block.onfree
            if isset(onfree) : onfree(item)
        }
    }
    return (disowned, unmarked_bytes)
}


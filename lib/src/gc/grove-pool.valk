#if GROVE

use ext
use mem

// Size classes of runtime-sized storage: 8-byte steps up to 128 bytes, then four per doubling
// (1.25, 1.5, 1.75, 2 x) up to 8 KiB. Objects above 8 KiB are large: a page run each
value POOL_CLASSES (256)
// The record index of a kind's large objects
value LARGE_INDEX ((POOL_CLASSES - 1))
global pools: [?*Pool x 256]
global alc_list: *Bump (@undefined)
// Typed kinds: an open-addressing map from a layout to its record of one pool per size class
@shared kinds: ptr
@shared kinds_cap: uint
@shared kinds_len: uint

fn null_ptr() ptr {
    return null.@cast(ptr)
}

fn pools_init() {
    @unsafe
    alc_list = Bump.new(64)
    kinds_cap = 0
    kinds_len = 0
    // Pools are made on first use (get_pool)
    mem.clear_bytes(@ref(pools), size_of(ptr) * POOL_CLASSES)
}

fn pools_free() {
    let adr = alc_list.data
    let end = adr + alc_list.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        alc.free()
    }
    alc_list.free()
}

fn get_pool_index_for_size(size: uint) uint $inline {
    let until: uint = 16 * size_of(ptr)
    if size <= until {
        let index = (size - 1) / size_of(ptr)
        return index
    }
    // The power of two below `size`, then which quarter above it `size` reaches
    let s = size - 1
    let bits = 63 - s.leading_zeros()
    let base = 1.to(uint) << bits
    let quarter = (s - base) / (base / 4) + 1
    // index 16 is the first class above 128 bytes (2^7): 160
    return 16 + (bits - 7) * 4 + quarter - 1
}

fn get_pool_for_size(size: uint) *Pool $inline {
    let index, isize = get_pool_slot(size)
    return get_pool(index, isize)
}

// The class of an object of `size` bytes (at most LARGE_SLOT): its index and slot size
fn get_pool_slot(size: uint) (uint, uint) $inline {
    let index = get_pool_index_for_size(size)
    if index < 16 : return (index, (index + 1) * size_of(ptr))
    let step = index - 16
    let base = 1.to(uint) << (7 + step / 4)
    return (index, base + (step % 4 + 1) * (base / 4))
}

// The bytes an object of `size` bytes takes: its class, or whole pages for a large object
fn slot_size(size: uint) uint {
    if size > LARGE_SLOT : return (size + PAGE_SIZE - 1) & (~(PAGE_SIZE - 1)).to(uint)
    let index, isize = get_pool_slot(size)
    return isize
}

// Not inlined: inlined into a function that allocates an array, it made LLVM keep that
// array's fields out of registers in the function's loops (a flat 2D loop ran 6x slower)
fn get_typed_pool(size: uint, layout: ?ptr) *Pool $noinline {
    @unsafe
    let lay = layout ?! return get_untyped_pool(size)
    let record = kind_record(lay)
    let index: uint = LARGE_INDEX
    let isize: uint = LARGE_SLOT + 8
    if size <= LARGE_SLOT {
        let i, s = get_pool_slot(size)
        index = i
        isize = s
    }
    let pool = @ptrv(record, ?*Pool, index)
    if isset(pool) : return pool
    pool = Pool.init_sequence(isize, layout)
    @ptrv(record, *Pool, index) = pool
    return pool
}

fn get_untyped_pool(size: uint) *Pool {
    if size > LARGE_SLOT : return get_pool(LARGE_INDEX, LARGE_SLOT + 8)
    return get_pool_for_size(size)
}

// The record of a layout's pools
fn kind_record(layout: ptr) ptr {
    @unsafe
    let key: uint = layout
    if kinds_cap != 0 {
        let mask = kinds_cap - 1
        let i = cnt_map_home(key) & mask
        while true {
            let k = @ptrv(kinds, uint, i * 2)
            if k == key : return @ptrv(kinds, ptr, i * 2 + 1)
            if k == 0 : break
            i = (i + 1) & mask
        }
    }
    if (kinds_len + 1) * 2 > kinds_cap {
        let old = kinds
        let old_cap = kinds_cap
        kinds_cap = old_cap == 0 ? 64 : old_cap * 2
        kinds = mem.calloc(kinds_cap * 2 * size_of(uint))
        let i: uint = 0
        while i < old_cap {
            let k = @ptrv(old, uint, i * 2)
            if k != 0 : kind_insert(k, @ptrv(old, ptr, i * 2 + 1))
            i++
        }
        if old_cap != 0 : mem.free(old)
    }
    let record = mem.calloc(POOL_CLASSES * size_of(ptr))
    kind_insert(key, record)
    kinds_len++
    return record
}

fn kind_insert(key: uint, record: ptr) {
    @unsafe
    let mask = kinds_cap - 1
    let i = cnt_map_home(key) & mask
    while @ptrv(kinds, uint, i * 2) != 0 : i = (i + 1) & mask
    @ptrv(kinds, uint, i * 2) = key
    @ptrv(kinds, ptr, i * 2 + 1) = record
}

fn get_pool(i: uint, size: uint) *Pool {
    @unsafe
    let pool = @ptrv(pools, ?*Pool, i)
    if isset(pool) : return pool
    pool = Pool.init_sequence(size, null)
    @ptrv(pools, *Pool, i) = pool
    return pool
}

// P0: each pool's run closes at its cursor (the window's end) and its bytes are counted
fn close_runs(list: *Bump) {
    let adr = list.data
    let end = adr + list.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        let block = alc.block ?! continue
        alc.count_run()
        block.aw_hi = alc.cursor
    }
}

// P10, after the card clears read the windows of this epoch: a new epoch, in which each current
// block's window opens at its cursor. Objects a finalizer allocates from here on are young in
// the new epoch
fn open_windows(list: *Bump) {
    epoch++
    let adr = list.data
    let end = adr + list.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        let block = alc.block ?! continue
        block.epoch = epoch
        block.aw_lo = alc.cursor
        block.aw_hi = alc.cursor
    }
}

// End of a collection: only the blocks allocated into or freed from since the previous one.
// Current blocks, and blocks entered in the new epoch, stay touched; the others are filed
// by their live count (R-19)
fn settle_blocks(list: *Bump, pools: *Bump) {
    @unsafe
    #if GC_DEBUG
    heap_check(list)
    #end
    let adr = list.data
    let end = adr + list.index
    list.reset()
    while adr < end {
        let block = @ptrv(adr, *Desc)
        adr += size_of(ptr)
        settle_block(block, list)
    }

    adr = pools.data
    end = adr + pools.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        if alc.prune : alc.prune_blocks()
    }
    heap_note_usage()
    #if GC_DEBUG
    pools_check(pools)
    #end
}

fn settle_block(block: *Desc, list: *Bump) {
    @unsafe
    let state = block.state - bs_touched
    let pool: *Pool = block.pool

    #if GC_DEBUG
    let isize = block.isize
    let base = block.first
    let last = base + block.slots_total * isize
    let current = pool.block == block
    let hi: uint = current ? pool.cursor : block.aw_hi
    let live: uint = 0
    while base < last {
        let data = gcdata(base)
        if data.is_new() {
            // A free or young slot has an all-zero shadow and no overflow entry
            if data.bits != 0 || cnt_byte1(base) != 0 : panic("GC error: a free slot's shadow is not zero")
            if cnt_map_has(base) : panic("GC error: a free slot has an overflow map entry")
            // Free slots hold the poison, except those of a pre-zeroed run (D-4)
            let zero = current && pool.zeroed && base >= pool.cursor
            if !zero && !in_window(block, base, hi) && (block.kind & desc_large) == 0 : poison_slot(base, isize)
        } else {
            live++
        }
        base += isize
    }
    if live != block.slots_used : panic("GC error: a block's live count differs from its slots")
    #end

    // A current block, or one a finalizer entered in the new epoch, is filed later
    if pool.block == block || block.epoch == epoch {
        block.state = state | bs_touched
        list.add_ptr(block)
        return
    }
    let used = block.slots_used
    if used == 0 {
        block.state = state | bs_free
        pool.prune = true
        return
    }
    if (block.kind & desc_large) == 0 && (state & bs_queued) == 0 && (block.slots_total - used) * 4 >= block.slots_total {
        state = state | bs_queued
        pool.partial.add_ptr(block)
    }
    block.state = state
}

// The sweep of the debug traces (D-11): every old object was reached and every reached one is
// old; the marks are cleared. Returns the number of ROOT_OWNED objects
fn leak_check_pools(list: *Bump) uint {
    let roots: uint = 0
    let adr = list.data
    let end = adr + list.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        roots += alc.leak_check()
    }
    return roots
}

// The static descriptor of a compiler-generated kind (C-21): the compiler writes one constant per
// kind next to the kind's TLS pool, a named symbol, and sets the pool up from it at thread start
struct Kind {
    isize: uint
    layout: ?ptr
    onfree: ?fnptr(ptr)()
    env_clone: ?EnvCloneFn
}

struct Pool {
    // The run being allocated from: [cursor, limit)
    cursor: ptr (null_ptr())
    limit: ptr (null_ptr())
    isize: uint (0)
    // The current block
    block: ?*Desc
    // The bytes from here to the cursor are not counted in `mem_new` yet
    run: ptr (null_ptr())
    // Every block and large object of the pool
    first: ?*Desc
    // Blocks with at least a quarter of their slots free, filled by the collections
    partial: *Bump (Bump.new())
    // Pages of the next block: 1, doubling up to 8
    pages: uint (1)
    layout: ?ptr
    onfree: ?fnptr(ptr)()
    env_clone: ?EnvCloneFn
    // Blocks marked bs_free wait in the block list
    prune: bool (false)
    // Each item is a large object with its own page run
    large: bool (false)
    // Runtime-sized storage (see desc_seq)
    sequence: bool (false)
    // The slots the cursor has not reached are zero: the current run lies in pre-zeroed pages,
    // or the last large object did
    zeroed: bool (false)

    /// Creates a pool for items of `size` bytes and registers it with the thread's allocators.
    ///
    /// `layout` describes where the items hold references (`null`: none), `onfree` runs when an
    /// item is freed and `env_clone` clones closure environments allocated from the pool. A slot
    /// is the item's size rounded up to 8 bytes; there is no header. The compiler calls this for
    /// the allocators of generated types.
    + static fn init(size: uint, layout: ?ptr, onfree: ?fnptr(ptr)(), env_clone: ?EnvCloneFn (null)) *Pool {
        @unsafe
        let isize = (size + 7) & (~7).to(uint)
        if isize == 0 : isize = 8
        let p = mem.new[Pool](.{
            isize: isize
            first: null
            block: null
            layout: layout
            onfree: onfree
            env_clone: env_clone
            large: isize > LARGE_SLOT
        })
        alc_list.add_ptr(p)

        return p
    }

    /// Sets up the pool of a compiler-generated kind in place, from the kind's static descriptor.
    ///
    /// The pool is the kind's thread-local symbol, so the inlined fast path reaches its cursor
    /// and limit without a load. The compiler calls this at thread start.
    + static fn setup(pool: *Pool, kind: *Kind) {
        @unsafe
        let isize = kind.isize
        pool.isize = isize
        pool.layout = kind.layout
        pool.onfree = kind.onfree
        pool.env_clone = kind.env_clone
        pool.partial = Bump.new()
        pool.pages = 1
        pool.large = isize > LARGE_SLOT
        alc_list.add_ptr(pool)
    }

    static fn init_sequence(size: uint, layout: ?ptr) *Pool {
        @unsafe
        let pool = Pool.init(size, layout, null)
        pool.sequence = true
        return pool
    }

    fn free() {
        @unsafe
        this.partial.free()
        mem.free(this)
    }

    fn get_vtable() ptr $hot {
        @unsafe
        let item = this.get()
        gc.blanks.add_ptr(item)
        return item
    }

    fn get_vtable_polling() ptr $hot {
        @unsafe
        let item = this.get_polling()
        gc.blanks.add_ptr(item)
        return item
    }

    // C-21, the compiler's allocation site of a class kind: `size` is the kind's slot size (a
    // constant), `polling` whether the site lies in a loop (C-27). No safepoint on the fast path
    fn get_sized(size: uint, polling: bool) ptr $inline {
        #if GC_STRESS
        stress_collect()
        #end
        let item = this.cursor
        let next = item + size
        if next > this.limit : return this.refill(polling)
        this.cursor = next
        #if GC_DEBUG
        @unsafe
        if size != this.isize : panic("GC error: an allocation site's size differs from its pool's")
        alloc_check(item, size)
        #end
        return item
    }

    // get_sized for a kind with a finalizer: the object joins the epoch's finalizer list
    fn get_vtable_sized(size: uint, polling: bool) ptr $inline {
        @unsafe
        let item = this.get_sized(size, polling)
        gc.blanks.add_ptr_inline(item)
        return item
    }

    // A bump of the cursor; the refill when the run is exhausted. No state is read
    fn get() ptr $inline {
        #if GC_STRESS
        stress_collect()
        #end
        let item = this.cursor
        let next = item + this.isize
        if next > this.limit : return this.refill()
        this.cursor = next
        #if GC_DEBUG
        @unsafe
        alloc_check(item, this.isize)
        #end
        return item
    }

    // `get` for an allocation site inside a source loop (C-27): its refill also collects at a
    // shallow point, so a loop without calls, which has no poll, still collects
    fn get_polling() ptr $inline {
        #if GC_STRESS
        stress_collect()
        #end
        let item = this.cursor
        let next = item + this.isize
        if next > this.limit : return this.refill(true)
        this.cursor = next
        #if GC_DEBUG
        @unsafe
        alloc_check(item, this.isize)
        #end
        return item
    }

    fn refill(polling: bool (false)) ptr $hot {
        @unsafe
        if this.large : return this.get_large(this.isize, polling)
        let isize = this.isize
        while true {
            this.next_run()
            // A collection may run here, and its finalizers may allocate from this pool
            alloc_trigger(0, polling)
            let item = this.cursor
            if item + isize <= this.limit {
                this.cursor = item + isize
                #if GC_DEBUG
                alloc_check(item, isize)
                #end
                return item
            }
        }
        panic("Failed to allocate memory")
    }

    // R-08: the run's bytes count as allocated
    fn count_run() $inline {
        @unsafe
        gc.mem_new += this.cursor - this.run
        this.run = this.cursor
    }

    // Closes the exhausted run (R-08), then takes the next run of free slots in the current
    // block (R-09) or enters the next block
    fn next_run() {
        @unsafe
        let block = this.block
        if isset(block) {
            this.count_run()
            block.aw_hi = this.cursor
            this.zeroed = false
            if this.find_run(block, this.cursor) : return
        }
        this.enter_block(this.next_block())
    }

    // The maximal run of free slots at or above `from`, if any, becomes the pool's run
    fn find_run(block: *Desc, from: ptr) bool {
        @unsafe
        let isize = this.isize
        let end = block.first + block.slots_total * isize
        let slot = from
        while slot < end && gcdata(slot).is_not_new() : slot += isize
        if slot >= end : return false
        let hi = slot + isize
        while hi < end && gcdata(hi).is_new() : hi += isize
        this.cursor = slot
        this.limit = hi
        this.run = slot
        if isset(this.layout) : premark(block, slot, hi, end)
        return true
    }

    // R-12: a block the allocator starts on; its window opens at its first run
    fn enter_block(block: *Desc) {
        @unsafe
        this.block = block
        if !this.find_run(block, block.first) : panic("GC error: an entered block has no free slot")
        this.zeroed = block.fresh
        block.fresh = false
        block.epoch = epoch
        block.aw_lo = this.cursor
        block.aw_hi = this.cursor
        touch_block(block)
    }

    // R-11: a PARTIAL block, else a new one
    fn next_block() *Desc {
        @unsafe
        let partial = this.partial
        while partial.index > 0 {
            partial.index -= size_of(ptr)
            let b = @ptrv(partial.data + partial.index, *Desc)
            let state = b.state - (b.state & bs_queued)
            b.state = state
            if (state & bs_free) == 0 : return b
        }
        return this.new_block()
    }

    // A block of 1-8 pages, at least one slot
    fn new_block() *Desc {
        @unsafe
        let isize = this.isize
        let pages = this.pages
        let min = (isize + PAGE_SIZE - 1) / PAGE_SIZE
        if pages < min : pages = min
        if this.pages < BLOCK_PAGES_MAX : this.pages = this.pages * 2
        let first, zeroed = heap_carve(pages)
        let block = this.new_desc(first, pages, isize)
        block.slots_total = pages * PAGE_SIZE / isize
        block.recip = ((1.to(uint) << 32) + isize - 1) / isize
        block.fresh = zeroed
        heap_map(block)
        block.next = this.first
        this.first = block
        #if GC_DEBUG
        // D-4: pre-zeroed pages are checked, the others hold the poison in every slot
        if zeroed {
            zero_check(first, pages * PAGE_SIZE)
        } else {
            let item = first
            let i: uint = 0
            while i < block.slots_total {
                poison_fill(item, isize)
                item += isize
                i++
            }
        }
        #end
        heap_note_usage()
        return block
    }

    fn new_desc(first: ptr, pages: uint, isize: uint) *Desc {
        @unsafe
        let desc = desc_new()
        desc.first = first
        desc.pages = pages
        desc.isize = isize
        desc.layout = this.layout
        desc.onfree = this.onfree
        desc.env_clone = this.env_clone
        desc.pool = this.@cast(ptr)
        desc.kind = this.sequence ? desc_seq : 0
        return desc
    }

    // R-16: one object of `size` bytes with a page run of its own. Pacing comes first: a
    // collection here runs before the object exists. The cards it overlaps are pre-marked
    fn get_large(size: uint, polling: bool (false)) ptr {
        @unsafe
        #if GC_STRESS
        stress_collect()
        #end
        let isize = (size + 7) & (~7).to(uint)
        alloc_trigger(isize, polling)
        gc.mem_new += isize
        let pages = (isize + PAGE_SIZE - 1) / PAGE_SIZE
        let first, zeroed = heap_carve(pages)
        let desc = this.new_desc(first, pages, isize)
        desc.slots_total = 1
        desc.kind = desc.kind | desc_large
        // Young until the next collection
        desc.epoch = epoch
        desc.aw_lo = first
        desc.aw_hi = first + isize
        heap_map(desc)
        desc.next = this.first
        this.first = desc
        touch_block(desc)
        if isset(this.layout) : cards_set(first, first + isize)
        #if GC_DEBUG
        if zeroed {
            zero_check(first, isize)
        } else {
            poison_fill(first, isize)
            poison_verify(first, isize, 2)
        }
        #end
        this.zeroed = zeroed
        heap_note_usage()
        return first
    }

    // Gives the pages of the blocks a collection marked bs_free back to the heap: empty
    // blocks and dead large objects
    fn prune_blocks() {
        @unsafe
        this.prune = false
        let partial = this.partial
        let base = partial.data
        let count = partial.index / size_of(ptr)
        let kept: uint = 0
        let i: uint = 0
        while i < count {
            let b = @ptrv(base, *Desc, i)
            i++
            if (b.state & bs_free) != 0 : continue
            @ptrv(base, *Desc, kept) = b
            kept++
        }
        partial.index = kept * size_of(ptr)

        let prev: ?*Desc = null
        let block = this.first
        while isset(block) {
            let next = block.next
            if (block.state & bs_free) != 0 {
                if isset(prev) : prev.next = next
                else : this.first = next
                heap_release(block)
            } else {
                prev = block
            }
            block = next
        }
    }

    fn leak_check() uint {
        @unsafe
        let roots: uint = 0
        let block = this.first
        while isset(block) {
            let isize = block.isize
            let base = block.first
            let end = base + block.slots_total * isize
            while base < end {
                let data = gcdata(base)
                if data.is_new() {
                    if data.bits != 0 || cnt_byte1(base) != 0 {
                        print_item_info(base)
                        panic("GC error: a STATE-0 object was reached or has shadow bits (premature free?)")
                    }
                } else if !data.has_leak_mark() {
                    print_item_info(data.item())
                    panic("Memory leak")
                } else {
                    data.remove_leak_mark()
                    if data.state() == st_root_owned : roots++
                }
                base += isize
            }
            block = block.next
        }
        return roots
    }
}

// R-10: the cards that overlap the run [lo, hi) and hold no slot outside it become dirty. Slack
// after the block's last slot (at `slots_end`) holds no slot; a card wholly in it stays clean
fn premark(block: *Desc, lo: uint, hi: uint, slots_end: uint) {
    let c = (lo + CARD_SIZE - 1) & (~(CARD_SIZE - 1)).to(uint)
    let top = hi & (~(CARD_SIZE - 1)).to(uint)
    if hi == slots_end : top = (hi + CARD_SIZE - 1) & (~(CARD_SIZE - 1)).to(uint)
    if top > c : cards_set(c, top)
}

// Sets the cards that overlap [lo, hi)
fn cards_set(lo: uint, hi: uint) {
    @unsafe
    let card: uint = card_of(lo)
    let end: uint = card_of(hi + CARD_SIZE - 1)
    while card < end && (card & 7) != 0 {
        @ptrv(card.@cast(ptr), u8) = 1
        card++
    }
    while card + 8 <= end {
        @ptrv(card.@cast(ptr), u64) = 0x0101010101010101
        card += 8
    }
    while card < end {
        @ptrv(card.@cast(ptr), u8) = 1
        card++
    }
}

// K-17: the cards that overlap the window of each touched descriptor of a kind with references
// that was allocated into in this epoch become clean
fn clear_window_cards(touched: *Bump) {
    @unsafe
    let adr = touched.data
    let end = adr + touched.index
    while adr < end {
        let desc = @ptrv(adr, *Desc)
        adr += size_of(ptr)
        if desc.epoch != epoch || !isset(desc.layout) : continue
        let lo: uint = desc.aw_lo
        let hi: uint = desc.aw_hi
        if hi <= lo : continue
        let first = card_of(lo)
        mem.clear_bytes(first, card_of(hi + CARD_SIZE - 1) - first)
    }
}

#if GC_STRESS
// D-14, the scaled stress schedule: a collection every 512 allocations while the heap is below
// 1 MiB, at intervals that double with the heap's size above, so the O(heap) checks of these
// collections cost O(allocation) in all. Each exposes a value the program still uses that no
// root names: it is freed (and poisoned) at once, not on a rare unlucky collection
value GC_STRESS_EVERY (512)

fn stress_collect() $noinline {
    let g = gc
    g.stress_count++
    let every: uint = GC_STRESS_EVERY
    let mib = heap_used >> 20
    while mib > 0 {
        every = every * 2
        mib = mib >> 1
    }
    if g.stress_count < every : return
    g.stress_count = 0
    if g.state != GcState.idle : return
    g.stress_check = true
    collect()
    g.stress_check = false
}
#end

#if GC_DEBUG
// Free slots are filled with a pattern that is checked when the slot is handed out or settled
// again: a write into freed memory fails right there instead of corrupting a later object. Its
// low bits are an owner tag and it lies outside the heap, so a barrier, a removal record or a
// mark that reads it fails at once (D-4)
value POISON_U64 (0xCBCBCBCBCBCBCBC9)
value POISON_MAX (262144)

fn poison_len(isize: uint) uint {
    let len = isize
    if len > POISON_MAX : len = POISON_MAX
    return len
}

// A slot handed out: its poison is intact and its shadow is zero
fn alloc_check(item: ptr, isize: uint) {
    @unsafe
    poison_verify(item, isize, 1)
    if gcdata(item).bits != 0 || cnt_byte1(item) != 0 : panic("GC error: shadow not 0 on alloc")
}

// Memory from pre-zeroed pages must be zero (D-4); the check stops after POISON_MAX bytes
fn zero_check(item: ptr, size: uint) {
    @unsafe
    let len = poison_len(size) & (~7).to(uint)
    let i: uint = 0
    while i < len {
        if @ptrv(item + i, u64) != 0 : panic("GC error: memory of a pre-zeroed run is not zero")
        i += 8
    }
}

fn poison_slot(item: ptr, isize: uint) {
    @unsafe
    poison_verify(item, isize, 3)
    poison_fill(item, isize)
}

fn poison_fill(item: ptr, isize: uint) {
    @unsafe
    let len = poison_len(isize)
    let i: uint = 0
    while i + 8 <= len {
        @ptrv(item + i, u64) = POISON_U64
        i += 8
    }
}

fn poison_verify(item: ptr, isize: uint, where: uint) {
    @unsafe
    let len = poison_len(isize)
    let p = item
    if @ptrv(p, u64) != POISON_U64 : return
    // Handed out: the first word no longer says the slot is poisoned
    if where != 3 : @ptrv(p, u64) = 0
    let i: uint = 8
    let bad: uint = 0
    let first: uint = 0
    while i + 8 <= len {
        if @ptrv(p + i, u64) != POISON_U64 {
            if bad == 0 : first = i
            bad++
        }
        i += 8
    }
    if bad == 0 : return
    print("\nPOISON: freed slot written. where=")
    where.print(10)
    print(" item=0x")
    let adr: uint = p
    adr.print(16)
    print(" size=")
    isize.print(10)
    print(" first_bad_offset=")
    first.print(10)
    print(" bad_words=")
    bad.print(10)
    print(" layout=0x")
    let lay: uint = desc_of(p).layout.@cast(uint)
    lay.print(16)
    print("\n")
    let start: uint = first > 64 ? first - 64 : 0
    let end: uint = first + 192
    if end > len : end = len
    let j = start
    while j + 8 <= end {
        print("  +")
        j.print(10)
        print(": ")
        let w = @ptrv(p + j, u64)
        w.print(16)
        print("  ")
        let k: uint = 0
        while k < 8 {
            let c = @ptrv(p + j + k, u8)
            if c >= 32 && c < 127 : print(c.to_ascii_string())
            else : print(".")
            k++
        }
        print("\n")
        j += 8
    }
    panic("POISON: write into freed GC memory")
}

// D-3 and I6 after the settle: a current block is not filed and its run lies inside it; a
// PARTIAL block has room; no block but a current one or one of the new epoch has no live slot
fn pools_check(pools: *Bump) {
    @unsafe
    let adr = pools.data
    let end = adr + pools.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        let current = alc.block
        if isset(current) {
            let slots_end = current.first + current.slots_total * current.isize
            if (current.state & (bs_queued | bs_free)) != 0 : panic("GC error: a current block is filed")
            if current.epoch != epoch || current.aw_lo > alc.cursor : panic("GC error: a current block's window is not open")
            if alc.cursor < current.first || alc.cursor > alc.limit || alc.limit > slots_end : panic("GC error: a run lies outside its block")
        }
        let partial = alc.partial
        let i: uint = 0
        while i < partial.index / size_of(ptr) {
            let b = @ptrv(partial.data, *Desc, i)
            i++
            if (b.state & bs_queued) == 0 || (b.state & bs_free) != 0 : panic("GC error: a PARTIAL block is not queued")
            if b.slots_used >= b.slots_total : panic("GC error: a PARTIAL block is full")
        }
        let block = alc.first
        while isset(block) {
            if block.slots_used == 0 && block.epoch != epoch : panic("GC error: an empty block was not freed")
            block = block.next
        }
    }
}
#end

#end

#if GROVE

use ext
use mem

// Size classes: 8-byte steps up to 128 bytes, then four per doubling (1, 1.25, 1.5, 1.75 x)
value POOL_CLASSES (256)
global pools: [?*Pool x 256]
global alc_list: *Bump (@undefined)
global typed_pools: *Bump (@undefined)
// Recently used typed pools, keyed by layout and size class
global typed_pool_cache: [?*Pool x 128]

fn null_ptr() ptr {
    return null.@cast(ptr)
}

fn pools_init() {
    @unsafe
    alc_list = Bump.new(64)
    typed_pools = Bump.new((POOL_CLASSES + 1) * size_of(ptr))
    // Pools are made on first use (get_pool)
    mem.clear_bytes(@ref(pools), size_of(ptr) * POOL_CLASSES)
}

fn pools_free() {
    let adr = alc_list.data
    let end = adr + alc_list.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        alc.free()
    }
    alc_list.free()
    typed_pools.free()
}

fn get_pool_index_for_size(size: uint) uint $inline {
    let until: uint = 16 * size_of(ptr)
    if size <= until {
        let index = (size - 1) / size_of(ptr)
        return index
    }
    // The power of two below `size`, then which quarter above it `size` reaches
    let s = size - 1
    let bits = 63 - s.leading_zeros()
    let base = 1.to(uint) << bits
    let quarter = (s - base) / (base / 4) + 1
    // index 16 is the first class above 128 bytes (2^7): 160
    return 16 + (bits - 7) * 4 + quarter - 1
}

fn get_pool_for_size(size: uint) *Pool $inline {
    let index, isize = get_pool_slot(size)
    return get_pool(index, isize)
}

fn get_pool_slot(size: uint) (uint, uint) $inline {
    let index = get_pool_index_for_size(size)
    if index >= POOL_CLASSES : panic("GC allocation is too large")
    if index < 16 : return (index, (index + 1) * size_of(ptr))
    let step = index - 16
    let base = 1.to(uint) << (7 + step / 4)
    return (index, base + (step % 4 + 1) * (base / 4))
}

// Not inlined: inlined into a function that allocates an array, it made LLVM keep that
// array's fields out of registers in the function's loops (a flat 2D loop ran 6x slower)
fn get_typed_pool(size: uint, layout: ?ptr) *Pool $noinline {
    @unsafe
    let index, isize = get_pool_slot(size)
    let key = ((layout.@cast(uint) >> 4) + index * 31) & 127
    let cache: *[?*Pool] = &typed_pool_cache
    let cached = cache[key]
    if isset(cached) && cached.layout == layout && cached.isize == isize + 8 : return cached
    let pool = find_typed_pool(index, isize, layout)
    cache[key] = pool
    return pool
}

fn find_typed_pool(index: uint, isize: uint, layout: ?ptr) *Pool {
    @unsafe
    let record_size = (POOL_CLASSES + 1) * size_of(ptr)
    let record = typed_pools.data
    let end = record + typed_pools.index
    while record < end {
        if @ptrv(record, ?ptr) == layout {
            let slot = record + (index + 1) * size_of(ptr)
            let pool = @ptrv(slot, ?*Pool)
            if isset(pool) : return pool
            pool = Pool.init_sequence(isize, layout)
            @ptrv(slot, *Pool) = pool
            return pool
        }
        record += record_size
    }
    record = typed_pools.get(record_size)
    mem.clear_bytes(record, record_size)
    @ptrv(record, ?ptr) = layout
    let pool = Pool.init_sequence(isize, layout)
    @ptrv(record + (index + 1) * size_of(ptr), *Pool) = pool
    return pool
}

fn get_pool(i: uint, size: uint) *Pool {
    @unsafe
    let pool = @ptrv(pools, ?*Pool, i)
    if isset(pool) : return pool
    pool = Pool.init_sequence(size, null)
    @ptrv(pools, *Pool, i) = pool
    return pool
}

// Before a scan: the current block's window ends at the pool cursor
fn mark_alloc_limits(list: *Bump) {
    let adr = list.data
    let end = adr + list.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        let block = alc.block
        if isset(block) : block.alloc_limit = alc.item
    }
}

// Only the current block of each pool needs closing: a block we moved past
// keeps its window, but every slot in it was allocated and marked this cycle,
// so it is accepted as not-new regardless; a pool reset rewrites all windows
fn close_current_alloc_windows(list: *Bump) {
    let adr = list.data
    let end = adr + list.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        let block = alc.block
        if isset(block) : block.alloc_start = block.alloc_limit
    }
}

// End of a collection: only the blocks allocated into or freed from since the
// previous one. Their windows close, and one with room goes into its pool's
// reuse queue, unless it is empty and the pool keeps enough empty blocks
fn settle_blocks(list: *Bump, pools: *Bump) {
    @unsafe
    #if GC_DEBUG
    heap_check(list)
    #end
    // Between collections a reuse queue only shrinks: what is left in it was
    // not needed for a whole cycle, and the empty blocks among it are freed
    let adr = pools.data
    let end = adr + pools.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        alc.drop_unneeded()
    }

    adr = list.data
    end = adr + list.index
    list.reset()
    while adr < end {
        let block = @ptrv(adr, *Desc)
        adr += size_of(ptr)
        settle_block(block)
    }

    adr = pools.data
    end = adr + pools.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        if alc.prune : alc.prune_blocks()
        alc.entered = 0
        // The current block is allocated into from here on
        let current = alc.block
        if isset(current) : touch_block(current)
    }
    heap_note_usage()
}

fn settle_block(block: *Desc) {
    @unsafe
    let state = block.state - bs_touched
    block.alloc_start = block.alloc_limit

    #if GC_DEBUG
    let isize = block.isize
    let base = block.first
    let last = base + block.slots_total * isize
    let live: uint = 0
    while base < last {
        let data: *GcData = base
        if data.is_new() {
            if data.co_count != 0 : panic("GC error: item with state 'new' has a co_count > 0")
            if data.flags != 0 : panic("GC error: item with state 'new' contains 'flag' bits")
            poison_slot(base, isize)
        } else {
            live++
        }
        base += isize
    }
    if live != block.slots_used : panic("GC error: a block's live count differs from its slots")
    #end

    // Marked for freeing already: stays that way until a prune frees it
    if (state & bs_free) != 0 {
        block.state = state
        return
    }
    let pool: *Pool = block.pool
    let used = block.slots_used
    // A large object is freed at the settle that finds it dead
    if (block.kind & desc_large) != 0 {
        if used == 0 {
            state = state | bs_free
            pool.prune = true
        }
        block.state = state
        return
    }
    let total = block.slots_total
    // The current block is settled once the allocator left it
    if (state & bs_queued) != 0 || pool.block == block || used * 100 / total > 95 {
        block.state = state
        return
    }
    if used == 0 && pool.empty_queued >= pool.entered + 4 {
        block.state = state | bs_free
        pool.prune = true
        return
    }
    state = state | bs_queued
    if used == 0 {
        state = state | bs_empty
        pool.empty_queued++
    }
    block.state = state
    pool.reuse.add_ptr(block)
}

fn leak_check_pools(list: *Bump) {
    let adr = list.data
    let end = adr + list.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        alc.leak_check()
    }
}

struct Pool {
    // Pages of the next block: 1, doubling up to 8
    pages: uint (1)
    first: ?*Desc
    block: ?*Desc
    item: ptr (null_ptr())
    last: ptr (null_ptr())
    layout: ?ptr
    onfree: ?fnptr(ptr)()
    env_clone: ?EnvCloneFn
    isize: uint (0)
    // Reuse queue: blocks with room, filled by the collections, taken before a new block
    reuse: *Bump (Bump.new())
    // Empty blocks among them
    empty_queued: uint (0)
    // Blocks the allocator started on since the last collection: that many
    // empty blocks are kept for the next cycle, the others are freed
    entered: uint (0)
    // Blocks marked bs_free wait in the block list
    prune: bool (false)
    // Each item is a large object with its own page run
    large: bool (false)
    // Runtime-sized storage (see desc_seq)
    sequence: bool (false)
    // The slots the cursor has not reached are zero: the current block came from pre-zeroed
    // pages, or the last large object did
    zeroed: bool (false)

    /// Creates a pool for items of `size` bytes and registers it with the thread's allocators.
    ///
    /// `layout` describes where the items hold references (`null`: none), `onfree` runs when an
    /// item is freed and `env_clone` clones closure environments allocated from the pool. Each
    /// slot has 8 bytes of GC header in front of the item. The compiler calls this for the
    /// allocators of generated types.
    + static fn init(size: uint, layout: ?ptr, onfree: ?fnptr(ptr)(), env_clone: ?EnvCloneFn (null)) *Pool {
        @unsafe
        let p = mem.new[Pool](.{
            isize: size + 8
            first: null
            block: null
            layout: layout
            onfree: onfree
            env_clone: env_clone
            large: size + 8 > LARGE_SLOT
        })
        alc_list.add_ptr(p)

        return p
    }

    static fn init_sequence(size: uint, layout: ?ptr) *Pool {
        @unsafe
        let pool = Pool.init(size, layout, null)
        pool.sequence = true
        return pool
    }

    fn free() {
        @unsafe
        this.reuse.free()
        mem.free(this)
    }

    // A block of 1-8 pages, at least one slot
    fn new_block() *Desc {
        @unsafe
        let isize = this.isize
        let pages = this.pages
        let min = (isize + PAGE_SIZE - 1) / PAGE_SIZE
        if pages < min : pages = min
        if this.pages < BLOCK_PAGES_MAX : this.pages = this.pages * 2
        let first, zeroed = heap_carve(pages)
        let block = this.new_desc(first, pages, isize)
        block.slots_total = pages * PAGE_SIZE / isize
        block.recip = ((1.to(uint) << 32) + isize - 1) / isize
        block.fresh = zeroed
        heap_map(block)
        block.next = this.first
        this.first = block

        let i: uint = 0
        let item = first
        while i < block.slots_total {
            if !zeroed : @ptrv(item, u64) = 0
            #if GC_DEBUG
            poison_fill(item, isize)
            #end
            item += isize
            i++
        }
        heap_note_usage()
        return block
    }

    fn new_desc(first: ptr, pages: uint, isize: uint) *Desc {
        @unsafe
        let desc = desc_new()
        desc.first = first
        desc.pages = pages
        desc.isize = isize
        desc.layout = this.layout
        desc.onfree = this.onfree
        desc.env_clone = this.env_clone
        desc.alloc_start = first
        desc.alloc_limit = first
        desc.pool = this.@cast(ptr)
        desc.kind = this.sequence ? desc_seq : 0
        return desc
    }

    // One item with a page run of its own. Pacing comes first: a collection here runs
    // before the object exists
    fn get_large() ptr {
        @unsafe
        let isize = this.isize
        collect_for(isize)
        gc.mem_new += isize
        let pages = (isize + PAGE_SIZE - 1) / PAGE_SIZE
        let first, zeroed = heap_carve(pages)
        let desc = this.new_desc(first, pages, isize)
        desc.slots_total = 1
        desc.kind = desc.kind | desc_large
        // Young until the next collection
        desc.alloc_limit = first + isize
        heap_map(desc)
        desc.next = this.first
        this.first = desc
        touch_block(desc)
        if !zeroed : @ptrv(first, u64) = 0
        #if GC_DEBUG
        poison_fill(first, isize)
        poison_verify(first, isize, 2)
        #end
        this.zeroed = zeroed
        heap_note_usage()
        return first + 8
    }

    fn get_vtable() ptr $hot {
        @unsafe
        let item = this.get()
        gc.blanks.add_ptr(item)
        return item
    }

    fn get() ptr $inline {
        #if GC_STRESS
        stress_collect()
        #end
        let item = this.item
        if item != this.last {
            @unsafe
            let data: *GcData = item
            if data.is_new() {
                let isize = this.isize
                #if GC_DEBUG
                @unsafe
                poison_verify(item, isize, 1)
                #end
                this.item = item + isize
                gc.mem_new += isize
                return item + 8
            }
        }
        return this.get_slow()
    }

    fn get_slow() ptr $hot {
        @unsafe
        if this.large : return this.get_large()
        let isize = this.isize
        if this.block == null {
            this.enter_block(this.new_block())
        }

        let item = this.item
        let last = this.last
        while true {
            if item == last {
                this.set_next_block(this.block ?! panic("Pool has no active block"))
                item = this.item
                last = this.last
                continue
            }

            let data: *GcData = item
            if data.is_not_new() {
                item += isize
                continue
            }

            this.item = item + isize

            #if GC_DEBUG
            poison_verify(item, isize, 2)
            if data.co_count != 0 : panic("co_count not 0 at alloc")
            if data.flags != 0 {
                print("Flags: ")
                data.flags.print(10)
                print("\n")
                panic("GC error: Flags not 0 on alloc")
            }
            #end

            // Increase mem usage
            gc.mem_new += isize

            return item + 8
        }

        panic("Failed to allocate memory")
    }

    fn set_next_block(block: *Desc) {
        @unsafe
        // Every slot of the block we leave was handed out this cycle
        block.alloc_limit = this.last
        // A block a collection found room in, or a new one. One allocated
        // into this cycle waits for the next collection to settle it: its
        // window must not cover the slots it frees
        let reuse = this.reuse
        let next: ?*Desc = null
        while reuse.index > 0 {
            reuse.index -= size_of(ptr)
            let b = @ptrv(reuse.data + reuse.index, *Desc)
            let state = b.state
            if (state & bs_empty) != 0 : this.empty_queued--
            state = state & (bs_touched | bs_free)
            b.state = state
            if (state & (bs_touched | bs_free)) != 0 : continue
            if b.slots_used * 100 / b.slots_total > 95 : continue
            next = b
            break
        }
        if !isset(next) : next = this.new_block()
        this.enter_block(next ?! panic("Pool has no next block"))

        // GC check
        collect_if_threshold_reached()
    }

    // A block the allocator starts on: nothing in it was allocated this cycle,
    // so its window opens at its first slot
    fn enter_block(block: *Desc) {
        @unsafe
        block.alloc_start = block.first
        block.alloc_limit = block.first
        touch_block(block)
        this.entered++
        this.zeroed = block.fresh
        block.fresh = false
        this.set_block(block)
    }

    fn set_block(block: ?*Desc) {
        this.block = block
        if isset(block) {
            this.item = block.first
            this.last = block.first + block.slots_total * this.isize
        } else {
            // The cursor must not point into a block that was just released
            this.item = null.@cast(ptr)
            this.last = null.@cast(ptr)
        }
    }

    // Marks the empty blocks in the reuse queue for freeing
    fn drop_unneeded() {
        @unsafe
        let reuse = this.reuse
        let base = reuse.data
        let count = reuse.index / size_of(ptr)
        let kept: uint = 0
        let i: uint = 0
        while i < count {
            let b = @ptrv(base, *Desc, i)
            i++
            let state = b.state
            // One freed from in this collection is settled later
            if b.slots_used == 0 && (state & bs_touched) == 0 {
                if (state & bs_empty) != 0 : this.empty_queued--
                b.state = state - (state & (bs_queued | bs_empty)) + bs_free
                this.prune = true
                continue
            }
            @ptrv(base, *Desc, kept) = b
            kept++
        }
        reuse.index = kept * size_of(ptr)
    }

    // Gives the pages of the blocks a collection marked bs_free back to the heap: empty
    // blocks not needed in the last cycle or with enough empty ones queued already, and
    // dead large objects
    fn prune_blocks() {
        @unsafe
        this.prune = false
        let prev: ?*Desc = null
        let block = this.first
        while isset(block) {
            let next = block.next
            if (block.state & bs_free) != 0 {
                if isset(prev) : prev.next = next
                else : this.first = next
                heap_release(block)
            } else {
                prev = block
            }
            block = next
        }
    }

    fn leak_check() {
        @unsafe
        let isize = this.isize
        let block = this.first
        while isset(block) {
            let base = block.first
            let end = base + block.slots_total * isize
            while base < end {
                let data: *GcData = base
                if data.is_new() {
                    if data.co_count != 0 : panic("GC error: item with state 'new' has a co_count > 0 (leak-check)")
                    if data.flags != 0 {
                        print("Flags: ")
                        data.flags.print(10)
                        print("\n")
                        panic("GC error: item with state 'new' contains 'flag' bits")
                    }
                } else if !data.has_leak_mark() {
                    print_item_info(data.item())
                    panic("Memory leak")
                }
                base += isize
            }
            block = block.next
        }
    }
}

#if GC_STRESS
// Collects every this many allocations, where an allocation may collect anyway: a value the
// program still uses that no root names is freed (and poisoned) at once, not on a rare
// unlucky collection
value GC_STRESS_EVERY (512)

fn stress_collect() $noinline {
    let g = gc
    g.stress_count++
    if g.stress_count < GC_STRESS_EVERY : return
    g.stress_count = 0
    if g.state != GcState.idle : return
    collect()
}
#end

#if GC_DEBUG
// Free slots are filled with a pattern that is checked when the slot is handed out or settled
// again: a write into freed memory fails right there instead of corrupting a later object, and
// a read of freed memory gets an address that crashes at once
value POISON_U64 (0xCBCBCBCBCBCBCBCB)
value POISON_MAX (262144)

fn poison_len(isize: uint) uint {
    let len = isize - 8
    if len > POISON_MAX : len = POISON_MAX
    return len
}

fn poison_slot(item: ptr, isize: uint) {
    @unsafe
    let len = poison_len(isize)
    if len < 8 : return
    poison_verify(item, isize, 3)
    poison_fill(item, isize)
}

fn poison_fill(item: ptr, isize: uint) {
    @unsafe
    let len = poison_len(isize)
    let p = item + 8
    let i: uint = 0
    while i + 8 <= len {
        @ptrv(p + i, u64) = POISON_U64
        i += 8
    }
}

fn poison_verify(item: ptr, isize: uint, where: uint) {
    @unsafe
    let len = poison_len(isize)
    if len < 8 : return
    let p = item + 8
    if @ptrv(p, u64) != POISON_U64 : return
    // Handed out: the first word no longer says the slot is poisoned
    if where != 3 : @ptrv(p, u64) = 0
    let i: uint = 8
    let bad: uint = 0
    let first: uint = 0
    while i + 8 <= len {
        if @ptrv(p + i, u64) != POISON_U64 {
            if bad == 0 : first = i
            bad++
        }
        i += 8
    }
    if bad == 0 : return
    print("\nPOISON: freed slot written. where=")
    where.print(10)
    print(" item=0x")
    let adr: uint = p
    adr.print(16)
    print(" size=")
    (isize - 8).print(10)
    print(" first_bad_offset=")
    first.print(10)
    print(" bad_words=")
    bad.print(10)
    print(" layout=0x")
    let lay: uint = desc_of(p).layout.@cast(uint)
    lay.print(16)
    print("\n")
    let start: uint = first > 64 ? first - 64 : 0
    let end: uint = first + 192
    if end > len : end = len
    let j = start
    while j + 8 <= end {
        print("  +")
        j.print(10)
        print(": ")
        let w = @ptrv(p + j, u64)
        w.print(16)
        print("  ")
        let k: uint = 0
        while k < 8 {
            let c = @ptrv(p + j + k, u8)
            if c >= 32 && c < 127 : print(c.to_ascii_string())
            else : print(".")
            k++
        }
        print("\n")
        j += 8
    }
    panic("POISON: write into freed GC memory")
}
#end

#end

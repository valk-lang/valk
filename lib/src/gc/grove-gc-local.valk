@unsafe

#if GROVE

use coro
use core
use mem
use time
use ext

// Pacing (THEORY 5.5.6, R-50): from the live bytes L and the survival ratio s of the last
// cycle, the young budget B = clamp(min(L / 2, 1 MiB / s), 512 KiB, 8 MiB) and the hard limit
// H = 1.5 B when s >= 0.5, else clamp(1.25 L, 2 B + 32 KiB, 64 MiB). No clock is read
value budget_min (512 * 1024)
value budget_max (8 * 1024 * 1024)
value limit_max (64 * 1024 * 1024)
// The soft cap of the log in entries: one per KiB of the live heap, within these
value log_cap_min (16 * 1024)
value log_cap_max (256 * 1024)

// Core
/// The collector of the running thread.
~+ global gc: *Gc (@undefined)

enum GcState {
    disabled
    idle
    collecting
}

// The next `more` entries hold further conditions of this root
struct ConditionalGlobalRoot {
    ref: ptr
    tag_ref: ptr
    tag: uint
    more: uint
}

struct Gc {
    // Lists
    globals: *Bump (Bump.new())
    conditional_globals: *Bump (Bump.new())
    // S: the root objects of the running collection, in scan order
    stack_items: *Bump (Bump.new())
    // The root list of the ROOT_OWNED objects (ROOT_prev); ROOT_now is built by a collection
    roots_prev: *Bump (Bump.new())
    roots_now: *Bump (Bump.new())
    // Card entries (a card's first address) and range entries (storage | 1), in log order
    card_log: *Bump (Bump.new())
    // The finalizer list: finalizable objects allocated in this epoch, and the walked ones
    blanks: *Bump (Bump.new())
    cut_list: *Bump (Bump.new())
    // RL: walked objects whose count was not 0
    re_own_list: *Bump (Bump.new())
    // Debug: storage that a growth left with plain words until the next collection cuts it
    growth_sources: *Bump (Bump.new())
    r4_storage: uint (0)        // The storage of the running moved_elements() and its logged cards
    r4_cards: uint (0)
    // The log's caps: removal records plus card log entries
    e_soft: uint (log_cap_min)
    e_hard: uint (log_cap_min * 2)
    stress_count: uint (0)      // Allocations since the last forced collection (GC_STRESS)
    stress_check: bool (false)  // The running collection is a scheduled stress collection
    // The mark and walk stack; the debug traces use their own
    mark_list: *Lifo (Lifo.new())
    trace_list: *Lifo (Lifo.new())
    // The removal buffer
    props_removed: *Lifo (Lifo.new())
    // Blocks allocated into or freed from since the last collection
    touched_blocks: *Bump (Bump.new())

    // Native stacks
    stack_top: ptr (null_ptr())              // Highest address of the thread stack
    live_sp: ptr (null_ptr())                // Stack pointer of the running collection

    // Refs
    #if OS == "win"
    main_sp: ptr (@ref(coro.main_saved_sp))
    #else
    main_sp: ptr (@ref(coro.main_state))
    #end
    current_coro: ptr (@ref(coro.current_coro))

    coros_ptr: *Array[?coro.Coro] (@ref(coro.g_coros))
    alc_list_ptr: **Bump (@ref(alc_list))
    // `collecting` is the in_collection flag
    state: GcState (GcState.disabled)
    // Objects the last collection walked
    dis_own_count: uint (0)
    // Marking and the walk use the prefetch window (see mark)
    mark_window_on: bool (false)
    collect_count: uint (0)
    // Bytes claimed in this epoch's windows, the growths' claims included: the survivors of
    // the young cycle, for the survival ratio
    young_marked: uint (0)
    /// H: bytes of allocation since the last collection beyond which a collection cannot wait.
    ~+ mem_limit: uint (budget_min * 2 + 32 * 1024)
    /// L: bytes of the objects the last collection found live, plus those claimed since.
    ~+ mem_marked: uint (0)
    /// B: a collection is due once `mem_new` reaches this many bytes.
    ///
    /// Set at each collection from the live bytes and from the share of the young bytes that
    /// survived: between 512 KiB and 8 MiB.
    ~+ mem_trigger: uint (budget_min)
    /// Bytes allocated since the last collection, counted per closed run and per large object.
    ~+ mem_new: uint (0)
    /// Bytes of pool blocks this thread's allocators hold, including free slots.
    ~+ mem_usage_thread: uint (0)
    /// Allocates a new collector with empty lists; it stays disabled until the thread enables it.
    + static fn init() *Gc {
        let value = mem.new[Gc]()
        return value
    }

    // Runs the collection below a helper that pushes the caller's registers,
    // so the native stack scan sees every live register
    fn collect() {
        if !this.collect_allowed() : return
        ext.valk_gc_scan_stack(Gc.collect_entry.@cast(ptr), this.@cast(ptr))
    }

    static fn collect_entry(sp: ptr, gcp: ptr) {
        let g: *Gc = gcp
        g.live_sp = sp
        g.collect_run()
    }

    // Both assembly entries pass the caller's saved registers and the kind: 0 local, 1 shared.
    // There is no shared memory to collect
    static fn collect_native(sp: ptr, kind: uint) {
        if kind != 0 : return
        let g = gc
        if !g.collect_allowed() : return
        g.live_sp = sp
        g.collect_run()
    }

    // R-27: a running collection is not entered again; collect() returns at once
    fn collect_allowed() bool {
        return this.state == GcState.idle
    }

    // One collection (THEORY 5.5.2): P0 to P10, P7 deleted (K-01)
    fn collect_run() {
        // P0: in_collection; the runs close at their cursors, so `allocated` and the windows
        // are exact
        this.state = GcState.collecting
        #if GROVE_MT
        nj_set(true)
        #if GC_DEBUG
        s_check_ranges()
        #end
        #end
        let pause_start = time.mono_us()
        close_runs(this.alc_list_ptr[0])
        let allocated = this.mem_new

        #if GC_DEBUG
        // D-5 before P2's cuts
        removal_check(this.props_removed)
        #end
        #if GC_DEBUG && GC_STRESS
        let checks = this.stress_check
        if checks {
            recount_check()
            card_check()
        }
        this.stress_check = false
        #end

        this.collect_stack_items()      // P1
        this.loop_roots_prev()          // P2
        this.loop_props_removed()       // P3
        this.claim_stack_items()        // P4
        this.loop_cuts()                // P5
        #if GC_DEBUG
        // Both forms of the loops get exercised
        this.mark_window_on = this.collect_count % 2 == 0
        #end
        this.loop_cards()               // P6
        this.loop_re_own()              // P8
        #if GC_DEBUG && GC_STRESS
        if checks : word_check()
        #end

        // P10's card clears run before the finalizers: what they store is logged for the
        // next collection. The new epoch opens the current blocks' windows at their cursors
        // before P9 too, so objects a finalizer allocates are young in it
        this.clear_cards()
        open_windows(this.alc_list_ptr[0])
        // Finalizers are ordinary code: they may make native calls (C7)
        #if GROVE_MT
        nj_set(false)
        #end
        this.check_blanks()             // P9
        #if GROVE_MT
        nj_set(true)
        #end

        // P10
        settle_blocks(this.touched_blocks, this.alc_list_ptr[0])
        #if GC_DEBUG
        settled_cards_check()
        #end
        let roots = this.roots_prev
        this.roots_prev = this.roots_now
        this.roots_now = roots
        if verify : this.leak_check()
        this.clear_stack_items()

        this.pace(allocated)
        // Free chunks beyond twice the young budget go back to the OS
        let retain = this.mem_trigger * 2
        heap_return_idle(retain > RETAIN_MIN ? retain : RETAIN_MIN)
        this.shrink_buffers()
        this.collect_count++

        pause_last_us = time.mono_us() - pause_start
        if pause_last_us > pause_max_us : pause_max_us = pause_last_us

        // Nothing is pending
        poll_inv = 0
        #if GROVE_MT
        nj_set(false)
        #end
        this.state = GcState.idle
    }

    // R-22: the collector's buffers shrink after a peak
    fn shrink_buffers() {
        this.stack_items.shrink_idle()
        this.roots_prev.shrink_idle()
        this.roots_now.shrink_idle()
        this.card_log.shrink_idle()
        this.blanks.shrink_idle()
        this.cut_list.shrink_idle()
        this.re_own_list.shrink_idle()
        this.growth_sources.shrink_idle()
        this.touched_blocks.shrink_idle()
        this.mark_list.shrink_idle()
        this.trace_list.shrink_idle()
        this.props_removed.shrink_idle()
    }

    // R-50: B, H and the log's caps of the next cycle; `allocated` bytes were allocated in
    // the one that ends
    fn pace(allocated: uint) {
        let b, h = pacing(this.mem_marked, this.young_marked, allocated)
        this.mem_trigger = b
        this.mem_limit = h
        this.mem_new = 0
        this.young_marked = 0
        this.set_log_caps()
    }

    // D-11 and I7 after P10: a full trace from the root objects S over every reference word
    // reaches exactly the old objects (an old object not reached is a leak, a reached STATE-0
    // object a premature free); the support traversal from the root list, along OWN words and
    // along CO words into CO_ROOTs, reaches exactly them too (I12); the root list holds the
    // ROOT_OWNED objects
    fn leak_check() {
        this.loop_stack_items(fn(item: ptr) { trace_from(item, false) })
        let roots = leak_check_pools(this.alc_list_ptr[0])
        let list = this.roots_prev
        if roots != list.index / size_of(ptr) : panic("GC error: the root list does not hold the ROOT_OWNED objects")
        let adr = list.data
        let end = adr + list.index
        while adr < end {
            let item = @ptrv(adr, ptr)
            adr += size_of(ptr)
            if gcdata(item).state() != st_root_owned : panic("GC error: an object on the root list is not ROOT_OWNED")
            trace_from(item, true)
        }
        leak_check_pools(this.alc_list_ptr[0])
    }

    // P2 (K-04): an object on the root list that is no root object any more is cut
    fn loop_roots_prev() {
        let list = this.roots_prev
        let adr = list.data
        let end = adr + list.index
        while adr < end {
            let item = @ptrv(adr, ptr)
            adr += size_of(ptr)
            let data = gcdata(item)
            #if GC_DEBUG
            if data.state() != st_root_owned : panic("GC error: an object on the root list is not ROOT_OWNED")
            #end
            if !data.is_on_stack() : this.cut(item, data)
        }
        list.reset()
    }

    // cut(u) (K-06): an object that is not STATE 0 is dropped and listed for P5
    fn cut(item: ptr, data: *GcData) $inline {
        if data.is_new() : return
        drop(item, data)
        this.cut_list.add_ptr(item)
    }

    // P3 (K-05): an OWN record cuts its target; a CO record lowers its target's count and cuts
    // it when it is a CO_ROOT
    fn loop_props_removed() {
        let list = this.props_removed
        this.growth_sources.reset()
        while list.index > 0 {
            let v: uint = list.pop_unchecked()
            let tag = v & prop_mask
            let item: ptr = (v - tag).@cast(ptr)
            let data = gcdata(item)
            if tag == prop_owned {
                this.cut(item, data)
                continue
            }
            data.co_unown()
            if data.state() == st_co_root : this.cut(item, data)
        }
    }

    // P4 (K-07): a STATE-0 root object (young, or cut in P2 or P3) is claimed ROOT_OWNED and
    // marked; a ROOT_OWNED one stays on the root list. An on-stack OWNED object needs nothing,
    // an on-stack CO_ROOT stays a CO_ROOT
    fn claim_stack_items() {
        let list = this.stack_items
        let adr = list.data
        let end = adr + list.index
        let roots = this.roots_now
        while adr < end {
            let item = @ptrv(adr, ptr)
            adr += size_of(ptr)
            let st = gcdata(item).state()
            if st == 0 {
                claim(item, st_root_owned)
                roots.add_ptr(item)
                mark(item)
            } else if st == st_root_owned {
                roots.add_ptr(item)
            }
        }
    }

    // P5 (K-08): each cut object that is still STATE 0 is dead and walked; the walk frees in
    // place. The walk's size switches the prefetch window on or off
    fn loop_cuts() {
        let list = this.cut_list
        let walked: uint = 0
        let adr = list.data
        let end = adr + list.index
        while adr < end {
            let item = @ptrv(adr, ptr)
            adr += size_of(ptr)
            if gcdata(item).is_new() : walked += walk(item)
        }
        list.reset()
        this.dis_own_count = walked
        this.mark_window_on = walked >= window_objects && this.mem_marked >= window_heap
    }

    // P8 (K-15): a walked object whose count is still above 0 is reachable through holders
    // that were not walked: it is claimed as a CO_ROOT and marked
    fn loop_re_own() {
        let list = this.re_own_list
        let adr = list.data
        let end = adr + list.index
        while adr < end {
            let item = @ptrv(adr, ptr)
            adr += size_of(ptr)
            let data = gcdata(item)
            if data.is_new() && data.has_co() {
                #if GC_DEBUG
                if data.is_on_stack() : panic("GC error: a walked object is a root object")
                #end
                claim(item, st_co_root)
                mark(item)
            }
        }
        list.reset()
    }

    // P6. The cards that stores into old objects made dirty: every reference word in them
    // that the collection has not counted yet is marked. Cards of objects first, then
    // sequence cards and range entries, in log order: Valk's claim order at card granularity
    fn loop_cards() {
        let log = this.card_log
        let count = log.index / size_of(ptr)
        if count == 0 : return
        let ml = this.mark_list
        #if GC_DEBUG
        let expect = cards_expected(log)
        cards_scanned = 0
        #end
        let i: uint = 0
        while i < count {
            let entry = @ptrv(log.data, uint, i)
            i++
            if entry & 1 == 0 && (desc_of(entry.@cast(ptr)).kind & desc_seq) == 0 : scan_card(entry, ml)
        }
        i = 0
        while i < count {
            let entry = @ptrv(log.data, uint, i)
            i++
            if entry & 1 == 0 {
                if (desc_of(entry.@cast(ptr)).kind & desc_seq) != 0 : scan_card(entry, ml)
                continue
            }
            // A storage logged as a range is scanned once, however often it was logged
            let storage = entry - 1
            if ranges_add(storage) : scan_range(storage, ml)
        }
        #if GC_DEBUG
        if cards_scanned != expect : panic("GC error: P6 did not scan every logged card")
        #end
        mark(null)
    }

    // P10's card part: the cards of the card entries, of each range and of this epoch's windows
    // (K-17) become clean, and the log is empty
    fn clear_cards() {
        clear_window_cards(this.touched_blocks)
        let log = this.card_log
        let adr = log.data
        let end = adr + log.index
        log.reset()
        while adr < end {
            let entry = @ptrv(adr, uint)
            adr += size_of(ptr)
            if entry & 1 == 0 : @ptrv(card_of(entry), u8) = 0
        }
        ranges_clear()
    }

    // The log's caps follow the live heap
    fn set_log_caps() {
        let cap = this.mem_marked / 1024
        if cap < log_cap_min : cap = log_cap_min
        if cap > log_cap_max : cap = log_cap_max
        #if GC_STRESS
        // Small caps in one collection out of 8: the operations that end in a cap test collect
        cap = small_log_cap(this.collect_count, cap)
        #end
        this.e_soft = cap
        this.e_hard = cap * 2
    }

    // P9 (K-16): the finalizer of each distinct dead object on the list runs once. ON_STACK,
    // which no dead object carries, marks the objects done and is cleared again
    fn check_blanks() {
        let list = this.blanks
        let adr = list.data
        let end = adr + list.index
        while adr < end {
            let item = @ptrv(adr, ptr)
            adr += size_of(ptr)
            let data = gcdata(item)
            if data.is_not_new() || data.is_on_stack() : continue
            free_blank(item)
            data.set_on_stack()
        }
        adr = list.data
        while adr < end {
            let data = gcdata(@ptrv(adr, ptr))
            adr += size_of(ptr)
            if data.is_new() : data.remove_on_stack()
        }
        list.reset()
    }

    //////////////////////////
    // Loop stack
    //////////////////////////

    fn loop_stack_items(func: fnptr(ptr)()) {
        let list = this.stack_items
        let adr = list.data
        let end = adr + list.index

        while adr < end {
            let item = @ptrv(adr, GcItem)
            adr = adr.$offset(size_of(ptr))
            func(item)
        }
    }

    fn clear_stack_items() {
        let list = this.stack_items
        let adr = list.data
        let end = adr + list.index
        list.reset()

        while adr < end {
            let item = @ptrv(adr, GcItem)
            adr = adr.$offset(size_of(ptr))
            gcdata(item).remove_on_stack()
        }
    }
    // P1 (K-03): a root object is marked ON_STACK once and listed in S, in scan order; its
    // presence is not counted
    fn collect_stack_item(item: ptr) {
        #if GC_DEBUG
        if item & 7 > 0 {
            let address: uint = item
            panic("GC error: misaligned root: " + address.to_base(16))
        }
        #end
        // A global may name a static string, which has no state
        if !in_heap(item) : return
        let data = gcdata(item)
        if data.is_on_stack() : return
        data.set_on_stack()
        this.stack_items.add_ptr(item)
    }
    fn collect_stack_items() {
        // Globals
        let g_adr = this.globals.data
        let g_end_adr: ptr = g_adr + this.globals.index
        while g_adr < g_end_adr {
            let ref = @ptrv(g_adr, ptr)
            let item = @ptrv(ref, ?ptr)
            if isset(item) : this.collect_stack_item(item)
            g_adr = g_adr.$offset(size_of(ptr))
        }

        let c_adr = this.conditional_globals.data
        let c_end_adr: ptr = c_adr + this.conditional_globals.index
        while c_adr < c_end_adr {
            let root = @ptrv(c_adr, ConditionalGlobalRoot)
            let root_end = c_adr + (root.more + 1) * size_of(ConditionalGlobalRoot)
            let active = true
            while c_adr < root_end {
                let cond = @ptrv(c_adr, ConditionalGlobalRoot)
                if @ptrv(cond.tag_ref, u8).to(uint) != cond.tag : active = false
                c_adr = c_adr.$offset(size_of(ConditionalGlobalRoot))
            }
            if active {
                let item = @ptrv(root.ref, ?ptr)
                if isset(item) : this.collect_stack_item(item)
            }
        }

        // Native stacks
        this.scan_stacks(this.live_sp)
    }

    // Every native stack of the thread: the running one from sp, the main
    // stack while a coroutine runs, and each suspended coroutine
    fn scan_stacks(sp: ptr) {
        if heap_top == 0 : return
        let current = @ptrv(this.current_coro, ?coro.Coro)
        if isset(current) {
            this.scan_words(sp, current.stack_top)
            let main_sp = @ptrv(this.main_sp, ?ptr)
            if isset(main_sp) : this.scan_words(main_sp, this.stack_top)
        } else {
            this.scan_words(sp, this.stack_top)
        }
        // Parked stacks are cold (pathology 3): the next parked stack and the coroutine after
        // it are prefetched while one is scanned
        let coros = this.coros_ptr[0]
        let count = coros.length
        let i: uint = 0
        while i < count {
            let ahead = coros.get(i + 2) !? null
            if isset(ahead) : $prefetch(ahead.@cast(ptr))
            let next = coros.get(i + 1) !? null
            if isset(next) && is_parked(next) : prefetch_stack(next.saved_sp(), next.stack_top)
            let item = coros.get(i) !? null
            i++
            if isset(item) && is_parked(item) {
                this.scan_words(item.saved_sp(), item.stack_top)
                let keep = @ref(item.io_keep).@cast(ptr)
                this.scan_words(keep, keep + 2 * size_of(ptr))
            }
        }
    }

    fn scan_words(low: ptr, high: ptr) {
        let top = heap_top
        let adr: ptr = low & (~7).to(uint)
        while adr < high {
            let word = @ptrv(adr, uint)
            adr += size_of(ptr)
            // The heap's end itself may be one past a sequence's end
            if word - HEAP_BASE > top : continue
            this.resolve(word)
        }
    }

    // The slot a native stack word may point into: page table, descriptor, then the slot by
    // the reciprocal. Accepts any allocated slot; a stale word pointing at a free slot or
    // free pages is rejected so garbage is never resurrected
    fn resolve(word: uint) {
        let at = word - HEAP_BASE
        // One past the end of a sequence whose block ends at this page boundary: the page
        // itself may hold another block, free pages or no chunk
        if at & (PAGE_SIZE - 1) == 0 && at > 0 {
            let prev = @ptrv(page_table, ?*Desc, (at >> PAGE_SHIFT) - 1)
            if isset(prev) && (prev.kind & desc_seq) != 0 {
                let end: uint = prev.first + prev.slots_total * prev.isize
                if end == word : this.accept(prev, word - prev.isize)
            }
        }
        if at >= heap_top : return
        let desc = @ptrv(page_table, ?*Desc, at >> PAGE_SHIFT) ?! return
        let first: uint = desc.first
        let off = word - first
        let isize = desc.isize
        let total = desc.slots_total
        let index: uint = 0
        if total == 1 {
            index = off < isize ? 0 : 1
        } else {
            index = (off * desc.recip) >> 32
            #if GC_DEBUG
            if index != off / isize : panic("GC error: the slot reciprocal is not exact")
            #end
        }
        let slot = first + index * isize
        // One past the end of a sequence that fills its slot is the next slot's start
        if word == slot && index > 0 && index <= total && (desc.kind & desc_seq) != 0 {
            this.accept(desc, slot - isize)
        }
        if index >= total : return
        // A tagged word (p|1, p|2) names its object too: compiled code may keep a loaded
        // reference word untagged only in its uses, so the register holds the tagged value
        // across a call that collects. A stale copy only retains
        this.accept(desc, slot)
    }

    // A slot whose object is not new, or a young one: in its block's window of this epoch (R-45)
    fn accept(desc: *Desc, slot: uint) {
        let item: ptr = slot.@cast(ptr)
        if gcdata(item).is_not_new() || in_window(desc, slot, desc.aw_hi) : this.collect_stack_item(item)
    }

    fn add_conditional_global(ref: ptr, tag_ref: ptr, tag: uint, more: uint) {
        let address = this.conditional_globals.get(size_of(ConditionalGlobalRoot))
        @ptrv(address, ConditionalGlobalRoot) = ConditionalGlobalRoot {
            ref: ref
            tag_ref: tag_ref
            tag: tag
            more: more
        }
    }
}

// A coroutine whose stack holds roots: started, switched out and not finished
fn is_parked(item: coro.Coro) bool $inline {
    return item.started && !item.active && !item.done
}

// The first 4 KiB of a parked stack, from its saved sp
fn prefetch_stack(sp: ptr, top: ptr) $inline {
    let at: uint = sp
    let end: uint = top
    if end > at + 4096 : end = at + 4096
    while at < end {
        $prefetch(at.@cast(ptr))
        at += 64
    }
}

// B and H of the cycle after one that ended with `live` bytes live and in which `young` of
// the `allocated` bytes survived (THEORY 5.5.6)
fn pacing(live: uint, young: uint, allocated: uint) (uint, uint) {
    let b = live / 2
    if young > 0 {
        // 1 MiB / s
        let by_survival = allocated < (1.to(uint) << 43) ? (allocated << 20) / young : (allocated / young) << 20
        if by_survival < b : b = by_survival
    }
    if b < budget_min : b = budget_min
    if b > budget_max : b = budget_max
    // s >= 0.5: waiting cannot reduce the survivors
    if allocated > 0 && young * 2 >= allocated : return (b, b / 2 * 3)
    let h = live / 4 * 5
    if h < b * 2 + 32 * 1024 : h = b * 2 + 32 * 1024
    if h > limit_max : h = limit_max
    return (b, h)
}

#end

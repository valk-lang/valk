
use mem

struct LifoFor[T] {
    data: ptr
    size: uint
    index: uint (0)

    static fn new() *SELF {
        let size : uint = 100
        let value: *SELF = .{
            size: size
            data: mem:alloc(size * size_of(T))
        }
        return value
    }

    + fn add(item: T) {
        let index = this.index
        let new_index = index + 1
        this.index = new_index

        @ptrv(this.data, T, index) = item

        let size = this.size
        if new_index == size {
            let new_size = size * 2
            this.data = mem:resize(this.data, size * size_of(T), new_size * size_of(T))
            this.size = new_size
        }
    }
    fn pop() T !LookupError {
        let index = this.index
        if index == 0 : throw .empty
        let new_index = index - 1
        this.index = new_index
        return @ptrv(this.data, T, new_index)
    }

    fn pop_unchecked() T $inline {
        let new_index = this.index - 1
        this.index = new_index
        return @ptrv(this.data, T, new_index)
    }

    fn clear() {
        this.index = 0
    }

    fn copy_from(from: *SELF) {
        let fi = from.index
        if fi == 0 {
            this.clear()
            return
        }
        if fi > this.size {
            this.data = mem:alloc(fi * size_of(T))
            this.size = fi
        }
        mem:copy(from.data, this.data, fi * size_of(T))
        this.index = fi
    }

    fn get_index_ref(i: uint) *T {
        return this.data.$offset(i * size_of(T))
    }

    fn free() {
        mem:free(this.data)
        mem:free(this)
    }
}

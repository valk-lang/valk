#if GROVE

fn property_update_slow(on_object: ptr, property_ref: ptr, new_value: ?ptr, old: ptr) {
    @unsafe
    if old & prop_mask > 0 : gc.props_removed.add(old)
    if gcdata(on_object).is_owned() && !gcheader(on_object).is_in_updates() : log_update(on_object, property_ref)
    @ptrv(property_ref, ?ptr) = new_value
    // Stores that allocate nothing never reach the allocator's check. Only
    // after the store: its slot is logged, and the collection must see it
    if log_full : collect_if_threshold_reached()
}

fn property_update(on_object: ptr, property_ref: ptr, new_value: ?ptr) $inline {
    @unsafe
    // The holder's state is in its shadow byte; the update log flag in its header
    let data = gcdata(on_object)
    if data.is_not_new() {
        let old = @ptrv(property_ref, ptr)
        if old & prop_mask > 0 || (data.is_owned() && !gcheader(on_object).is_in_updates()) {
            property_update_slow(on_object, property_ref, new_value, old)
            return
        }
    }
    @ptrv(property_ref, ?ptr) = new_value
}

fn property_set_slow(on_object: ptr, property_ref: ptr, value: ptr) {
    @unsafe
    log_update(on_object, property_ref)
    @ptrv(property_ref, ?ptr) = value
    if log_full : collect_if_threshold_reached()
}

fn property_set(on_object: ptr, property_ref: ptr, value: ?ptr) $inline {
    @unsafe
    if isset(value) {
        if gcdata(on_object).is_owned() && !gcheader(on_object).is_in_updates() {
            property_set_slow(on_object, property_ref, value)
            return
        }
    }
    @ptrv(property_ref, ?ptr) = value
}

fn property_get(property_ref: ptr) ptr {
    return @ptrv(property_ref, ptr) & (~prop_mask).to(uint)
}

fn property_remove_slow(value: ptr) {
    @unsafe
    gc.props_removed.add(value)
}

fn property_remove(on_object: ptr, property_ref: ptr) $inline {
    @unsafe
    let value = @ptrv(property_ref, ptr)
    if value & prop_mask > 0 : property_remove_slow(value)
}

// An owned object received a reference. The storage of a sequence logs the
// slot, so a collection looks at what changed instead of every slot of an
// array, until a quarter of its slots is logged: one walk is cheaper then.
// Any other object is walked whole, once per collection
fn log_update(on_object: ptr, property_ref: ptr) {
    @unsafe
    let data = gcheader(on_object)
    let g = gc
    if g.updated_slots.index < slot_log_limit && in_heap(on_object) {
        let layout = desc_of(on_object).layout
        let logs = data.slot_logs.to(uint)
        if isset(layout) && @ptrv(layout, uint, layout_kind) == 1 && logs < 255 && logs * 4 < @ptrv(on_object, uint) {
            data.slot_logs = (logs + 1).to(u8)
            let adr = g.updated_slots.get(size_of(ptr) * 2)
            @ptrv(adr, ptr, 0) = on_object
            @ptrv(adr, ptr, 1) = property_ref
            return
        }
    }
    data.set_in_updates()
    g.updated_list.add_ptr(on_object)
}
// Bytes of slot log; past it sequences are walked whole again
value slot_log_limit (16 * 1024 * 1024)

// Raw writes moved elements `first` to `first + count` of the sequence `item`
// into place (see Array): a store logs the slot it writes, so a reference a
// raw move takes elsewhere before the next collection is logged again
fn moved_elements(item: ptr, first: uint, count: uint) {
    @unsafe
    if count == 0 : return
    // Storage that is new or walked whole logs nothing
    if !in_heap(item) || !gcdata(item).is_owned() || gcheader(item).is_in_updates() : return
    let layout = desc_of(item).layout ?! return
    let stride = @ptrv(layout, uint, layout_stride)
    let adr: ptr = item + @ptrv(layout, uint, layout_data_offset) + first * stride
    let end = adr + count * stride
    moved_item = item
    while adr < end {
        each_field_ref(adr, layout, gc.mark_list, fn(ref: ptr, list: *Lifo) {
            @unsafe
            // A tagged reference was processed already and keeps its tag
            if @ptrv(ref, uint) & prop_mask != 0 : return
            if gcheader(moved_item).is_in_updates() : return
            log_update(moved_item, ref)
        })
        adr += stride
    }
    // A thread-local global sits in the thread's stack block, which is scanned
    moved_item = null_ptr()
}
global moved_item: ptr (null_ptr())

#end

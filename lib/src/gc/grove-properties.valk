#if GROVE

// The barrier. A store into a young holder is plain. A store into an old holder records
// a counted old word (B2) and makes the card of a stored reference dirty: a clean card is
// set and logged once per collection (B5), then the log's cap is tested (B6). Card bytes
// and the card log are read by the next collection (Gc.loop_cards)

fn property_update_slow(on_object: ptr, property_ref: ptr, new_value: ?ptr, old: ptr) {
    @unsafe
    gc.props_removed.add(old)
    @ptrv(property_ref, ?ptr) = new_value
    // The card before the cap test: a collection there must see the stored value
    if isset(new_value) && @ptrv(card_of(property_ref), u8) == 0 : card_log_add(property_ref)
    log_cap_test()
}

fn property_update(on_object: ptr, property_ref: ptr, new_value: ?ptr) $inline {
    @unsafe
    if gcdata(on_object).is_not_new() {
        let old = @ptrv(property_ref, ptr)
        if old & prop_mask > 0 {
            property_update_slow(on_object, property_ref, new_value, old)
            return
        }
        @ptrv(property_ref, ?ptr) = new_value
        if isset(new_value) && @ptrv(card_of(property_ref), u8) == 0 : card_slow(property_ref)
        return
    }
    @ptrv(property_ref, ?ptr) = new_value
}

// A card test without a cap test: the log may pass its cap by these stores until the next
// operation that tests it
fn property_set(on_object: ptr, property_ref: ptr, value: ?ptr) $inline {
    @unsafe
    @ptrv(property_ref, ?ptr) = value
    if isset(value) && gcdata(on_object).is_not_new() && @ptrv(card_of(property_ref), u8) == 0 {
        card_log_add(property_ref)
    }
}

fn property_get(property_ref: ptr) ptr {
    return @ptrv(property_ref, ptr) & (~prop_mask).to(uint)
}

fn property_remove_slow(value: ptr) {
    @unsafe
    gc.props_removed.add(value)
}

fn property_remove(on_object: ptr, property_ref: ptr) $inline {
    @unsafe
    let value = @ptrv(property_ref, ptr)
    if value & prop_mask > 0 : property_remove_slow(value)
}

fn card_slow(property_ref: ptr) {
    @unsafe
    card_log_add(property_ref)
    log_cap_test()
}

// B5: the card becomes dirty and its first address goes into the card log
fn card_log_add(property_ref: ptr) {
    @unsafe
    let card = card_of(property_ref)
    #if GC_DEBUG
    if @ptrv(card, u8) != 0 : panic("GC error: a dirty card is logged again")
    #end
    @ptrv(card, u8) = 1
    gc.card_log.add_ptr(property_ref & (~(CARD_SIZE - 1)).to(uint))
}

// B6, after an operation's last write. Without polls a collection that becomes due at the
// soft cap runs at once, like one at the hard cap
fn log_cap_test() $inline {
    if log_full : log_collect()
}

fn log_collect() {
    if gc.state != GcState.idle : return
    gc.collect()
}

// Cards one moved_elements call logs before it logs its storage as a range instead
value range_switch (64)

// R4. Raw writes moved elements `first` to `first + count` of the sequence `item`
// into place (see Array): the card of each moved reference that a collection has not
// counted yet must be dirty and covered by the log. After 64 logged cards the storage is
// logged as a range, which covers each of its dirty cards, and cards are only set.
// No cap test: the caller's operation tests it
fn moved_elements(item: ptr, first: uint, count: uint) {
    @unsafe
    if count == 0 : return
    // New storage is walked whole when a collection finds it
    if !in_heap(item) || gcdata(item).is_new() : return
    let layout = desc_of(item).layout ?! return
    let stride = @ptrv(layout, uint, layout_stride)
    let adr: ptr = item + @ptrv(layout, uint, layout_data_offset) + first * stride
    let end = adr + count * stride
    let g = gc
    g.r4_storage = item.@cast(uint)
    g.r4_cards = 0
    while adr < end {
        each_field_ref(adr, layout, g.mark_list, fn(ref: ptr, list: *Lifo) {
            @unsafe
            // A tagged reference was counted already and keeps its tag
            if @ptrv(ref, uint) & prop_mask != 0 : return
            let card = card_of(ref)
            if @ptrv(card, u8) != 0 : return
            let r = gc
            if r.r4_cards == range_switch {
                @ptrv(card, u8) = 1
                return
            }
            card_log_add(ref)
            r.r4_cards++
            if r.r4_cards == range_switch : r.card_log.add_ptr((r.r4_storage | 1).@cast(ptr))
        })
        adr += stride
    }
}

#end

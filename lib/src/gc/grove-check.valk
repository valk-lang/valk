@unsafe

#if GROVE
#if GC_DEBUG

use mem

// D-6, the recount, before a scheduled stress collection. From the reference words of the
// old objects, the pending removals and the root list: an OWNED object has exactly one OWN
// word or pending OWN record and is not on the root list, a ROOT_OWNED object is on the root
// list once and has none, a CO_ROOT has neither; every count equals the CO words naming the
// object plus its pending CO records, and the overflow map holds only capped counts

// (object, owner sources | co sources << 32) pairs; the root list counts rc_root per entry
value rc_root (65536)
#if GROVE_MT
global rc_map: ptr
#else
@shared rc_map: ptr
#end
#if GROVE_MT
global rc_cap: uint
#else
@shared rc_cap: uint
#end
#if GROVE_MT
global rc_len: uint
#else
@shared rc_len: uint
#end

fn rc_find(key: uint) uint {
    let mask = rc_cap - 1
    let i = cnt_map_home(key) & mask
    while true {
        let k = @ptrv(rc_map, uint, i * 2)
        if k == key || k == 0 : return i
        i = (i + 1) & mask
    }
    return 0
}

fn rc_add(item: ptr, owners: uint, co_words: uint) {
    if (rc_len + 1) * 2 > rc_cap {
        let old = rc_map
        let old_cap = rc_cap
        rc_cap = old_cap == 0 ? 1024 : old_cap * 2
        rc_map = mem.calloc(rc_cap * 2 * size_of(uint))
        let i: uint = 0
        while i < old_cap {
            let k = @ptrv(old, uint, i * 2)
            if k != 0 {
                let at = rc_find(k)
                @ptrv(rc_map, uint, at * 2) = k
                @ptrv(rc_map, uint, at * 2 + 1) = @ptrv(old, uint, i * 2 + 1)
            }
            i++
        }
        if old_cap != 0 : mem.free(old)
    }
    let key: uint = item
    let i = rc_find(key)
    if @ptrv(rc_map, uint, i * 2) == 0 {
        @ptrv(rc_map, uint, i * 2) = key
        rc_len++
    }
    @ptrv(rc_map, uint, i * 2 + 1) = @ptrv(rc_map, uint, i * 2 + 1) + owners + (co_words << 32)
}

fn rc_get(item: ptr) uint {
    if rc_len == 0 : return 0
    let key: uint = item
    let i = rc_find(key)
    if @ptrv(rc_map, uint, i * 2) != key : return 0
    return @ptrv(rc_map, uint, i * 2 + 1)
}

// A tagged word or record: its target is an old object in the heap
fn rc_count(v: uint) {
    let tag = v & prop_mask
    if tag == 0 : return
    let target: ptr = (v - tag).@cast(ptr)
    if tag == prop_mask : panic("GC error (recount): a reference word holds both tags")
    if !in_heap(target) : panic("GC error (recount): a tagged word names an object outside the heap")
    if gcdata(target).is_new() : panic("GC error (recount): a tagged word names a new object")
    if tag == prop_owned : rc_add(target, 1, 0)
    else : rc_add(target, 0, 1)
}

fn rc_scan(item: ptr) {
    let layout = desc_of(item).layout ?! return
    each_ref(item, layout, gc.mark_list, fn(ref: ptr, list: *Lifo) {
        @unsafe
        rc_count(@ptrv(ref, uint))
    })
}

// Calls `cb` with every object of every block of the thread's pools
fn rc_each_object(cb: fnptr(ptr)()) {
    let adr = alc_list.data
    let end = adr + alc_list.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        let block = alc.first
        while isset(block) {
            let isize = block.isize
            let base = block.first
            let last = base + block.slots_total * isize
            while base < last {
                cb(base)
                base += isize
            }
            block = block.next
        }
    }
}

fn recount_check() {
    let g = gc
    rc_len = 0
    if rc_cap != 0 : mem.clear_bytes(rc_map, rc_cap * 2 * size_of(uint))

    rc_each_object(fn(item: ptr) {
        if gcdata(item).is_not_new() : rc_scan(item)
    })
    let removed = g.props_removed
    let i: uint = 0
    while i < removed.index {
        rc_count(@ptrv(removed.data, uint, i))
        i++
    }
    let adr = g.roots_prev.data
    let end = adr + g.roots_prev.index
    while adr < end {
        rc_add(@ptrv(adr, ptr), rc_root, 0)
        adr += size_of(ptr)
    }

    rc_each_object(fn(item: ptr) {
        let data = gcdata(item)
        let counts = rc_get(item)
        let owners = counts & 0xFFFFFFFF
        let co_words = counts >> 32
        let state = data.state()
        if state == 0 {
            if counts != 0 : panic("GC error (recount): a new object is named by a tagged word")
            if data.bits != 0 || cnt_byte1(item) != 0 || cnt_map_has(item) : panic("GC error (recount): a new object has a count or flags")
            return
        }
        if state == st_owned && owners != 1 : rc_fail(item, "an OWNED object does not have exactly one owner word", owners)
        if state == st_root_owned && owners != rc_root : rc_fail(item, "a ROOT_OWNED object is not on the root list once, or has an owner word", owners)
        if state == st_co_root && owners != 0 : rc_fail(item, "a CO_ROOT also has an owner", owners)
        if data.is_on_stack() : panic("GC error (recount): an on-stack mark outside a collection")
        if data.co_count() != co_words : rc_fail(item, "a co-edge count differs from the co words", co_words)
    })

    // The map holds exactly the capped counts
    let n: uint = 0
    let k: uint = 0
    while k < cnt_map_cap {
        let key = @ptrv(cnt_map, uint, k * 2)
        k++
        if key == 0 : continue
        n++
        let item: ptr = key.@cast(ptr)
        if !in_heap(item) || gcdata(item).is_new() : panic("GC error (recount): an overflow entry outlives its object")
        let wide = cnt_wide(item)
        if gcdata(item).inline_count(wide) != cnt_marker(wide) : panic("GC error (recount): an overflow entry for an inline count")
        if @ptrv(cnt_map, uint, k * 2 - 1) < cnt_marker(wide) : panic("GC error (recount): an overflow entry below the cap")
    }
    if n != cnt_map_len : panic("GC error (recount): the overflow map's length is wrong")
}

// The cards the log covers, in the recount's map: each card entry's card, and each dirty card
// of the range of a storage that a range entry names
fn covered_build() {
    rc_len = 0
    if rc_cap != 0 : mem.clear_bytes(rc_map, rc_cap * 2 * size_of(uint))
    let log = gc.card_log
    let count = log.index / size_of(ptr)
    let i: uint = 0
    while i < count {
        let entry = @ptrv(log.data, uint, i)
        i++
        if entry & 1 == 0 {
            if @ptrv(card_of(entry), u8) == 0 : panic("GC error (cards): a card entry's card is clean")
            rc_add(entry.@cast(ptr), 1, 0)
            continue
        }
        let c, end = range_of(entry - 1)
        while c < end {
            if @ptrv(card_of(c), u8) != 0 : rc_add(c.@cast(ptr), 1, 0)
            c += CARD_SIZE
        }
    }
}

fn covered(c: uint) bool {
    return (rc_get(c.@cast(ptr)) & 0xFFFFFFFF) != 0
}

// D-1 and D-2, the W-C and card checks, before a scheduled stress collection: every uncounted
// reference word of an old object lies in a covered card or in a growth source (D-17); a young
// object holds no counted word (W1); no word holds both tags, and every word into the heap
// names an allocated object's start (WD). A dirty card that is not covered holds only free and
// young slots
#if GROVE_MT
global wc_source: bool
#else
@shared wc_source: bool
#end

fn card_check() {
    covered_build()
    let adr = gc.growth_sources.data
    let end = adr + gc.growth_sources.index
    while adr < end {
        rc_add(@ptrv(adr, ptr), 0, 1)
        adr += size_of(ptr)
    }
    rc_each_object(fn(item: ptr) {
        let desc = desc_of(item)
        let layout = desc.layout ?! return
        if gcdata(item).is_not_new() {
            wc_source = (rc_get(item) >> 32) != 0
            each_ref(item, layout, gc.mark_list, fn(ref: ptr, list: *Lifo) {
                @unsafe
                let v = @ptrv(ref, uint)
                word_target_check(ref, v)
                if v & prop_mask != 0 || !in_heap(v.@cast(ptr)) || wc_source : return
                let c: uint = ref & (~(CARD_SIZE - 1)).to(uint)
                if @ptrv(card_of(c), u8) == 0 || !covered(c) {
                    print_word_address(ref)
                    panic("GC error (cards): an uncounted reference lies in a card the log does not cover")
                }
            })
            return
        }
        // A free slot holds no object
        let slot: uint = item
        if !in_window(desc, slot, desc.aw_hi) : return
        each_ref(item, layout, gc.mark_list, fn(ref: ptr, list: *Lifo) {
            @unsafe
            let v = @ptrv(ref, uint)
            word_target_check(ref, v)
            if v & prop_mask != 0 {
                print_word_address(ref)
                panic("GC error (W1): a young object holds a counted reference")
            }
        })
    })
    dirty_cards_check()
}

// D-5, at P3: every removal record names an old object's start with one tag, and no object
// is recorded twice with the owner tag
fn removal_check(list: *Lifo) {
    let i: uint = 0
    while i < list.index {
        let v = @ptrv(list.data, uint, i)
        i++
        let tag = v & prop_mask
        let target = v - tag
        if tag == 0 || tag == prop_mask : panic("GC error (P3): a removal record without one tag")
        if !in_heap(target.@cast(ptr)) || !allocated_start(target) || gcdata(target.@cast(ptr)).is_new() {
            print_word_address(target.@cast(ptr))
            panic("GC error (P3): a removal record does not name an old object")
        }
        if tag == prop_owned {
            if gcdata(target.@cast(ptr)).has_leak_mark() : panic("GC error (P3): an object is recorded twice with the owner tag")
            gcdata(target.@cast(ptr)).set_leak_mark()
        }
    }
    i = 0
    while i < list.index {
        let v = @ptrv(list.data, uint, i)
        i++
        if v & prop_mask == prop_owned : gcdata((v - prop_owned).@cast(ptr)).remove_leak_mark()
    }
}

// D-8, in B2: the old word is counted, its holder is old, and no collection runs (a
// finalizer's stores into its own object find plain words)
fn slow_path_check(ref: ptr, old: uint) {
    if gc.state == GcState.collecting : panic("GC error: a removal slow path inside a collection")
    if old & prop_mask == prop_mask : panic("GC error: a reference word holds both tags")
    if !in_heap(ref) : panic("GC error: a counted word outside the heap")
    let a: uint = ref
    let desc = @ptrv(page_table, ?*Desc, (a - HEAP_BASE) >> PAGE_SHIFT) ?! panic("GC error: a counted word in free pages")
    let first: uint = desc.first
    let slot = first + (a - first) / desc.isize * desc.isize
    if gcdata(slot.@cast(ptr)).is_new() {
        print_word_address(ref)
        panic("GC error: a young object holds a counted word (B2)")
    }
}

// WD: a reference word holds at most one tag, and a word into the heap names an allocated
// object's start
fn word_target_check(ref: ptr, v: uint) {
    let tag = v & prop_mask
    let target = v - tag
    if tag == prop_mask {
        print_word_address(ref)
        panic("GC error (W-C): a reference word holds both tags")
    }
    if !in_heap(target.@cast(ptr)) {
        if tag == 0 : return
        print_word_address(ref)
        panic("GC error (W-C): a tagged word names an address outside the heap (poison?)")
    }
    if !allocated_start(target) {
        print_word_address(ref)
        panic("GC error (W-C): a reference word does not name an allocated object")
    }
}

fn allocated_start(t: uint) bool {
    let desc = @ptrv(page_table, ?*Desc, (t - HEAP_BASE) >> PAGE_SHIFT) ?! return false
    let first: uint = desc.first
    let off = t - first
    if off % desc.isize != 0 || off / desc.isize >= desc.slots_total : return false
    return gcdata(t.@cast(ptr)).is_not_new() || in_window(desc, t, desc.aw_hi)
}

// Every dirty card is covered, or its slots are free or young
fn dirty_cards_check() {
    let c: uint = HEAP_BASE
    let end = HEAP_BASE + heap_top
    while c < end {
        #if GROVE_MT
        // The thread's own granules only
        if !resolve_owned(c - HEAP_BASE) {
            c = (c | (GRANULE_SIZE - 1)) + 1
            continue
        }
        #end
        let card = card_of(c)
        if (card.@cast(uint) & 7) == 0 && @ptrv(card, u64) == 0 {
            c += 8 * CARD_SIZE
            continue
        }
        if @ptrv(card, u8) != 0 && !covered(c) {
            let desc = card_desc(c) ?! panic("GC error (cards): a dirty card in free pages")
            let first: uint = desc.first
            let slot = first
            while slot < c + CARD_SIZE && slot < first + desc.slots_total * desc.isize {
                if slot + desc.isize > c && gcdata(slot.@cast(ptr)).is_not_new() {
                    panic("GC error (cards): a dirty card the log does not cover holds an old object")
                }
                slot += desc.isize
            }
        }
        c += CARD_SIZE
    }
}

// D-12, after P8 of a scheduled stress collection: every reference word of an old object
// is counted
fn word_check() {
    rc_each_object(fn(item: ptr) {
        if gcdata(item).is_new() : return
        let layout = desc_of(item).layout ?! return
        each_ref(item, layout, gc.mark_list, fn(ref: ptr, list: *Lifo) {
            @unsafe
            let v = @ptrv(ref, uint)
            if v & prop_mask == 0 && in_heap(v.@cast(ptr)) {
                print_word_address(ref)
                panic("GC error (cards): an old object holds an uncounted reference after P8")
            }
        })
    })
}

// D-3 and D-12 after P10, at every collection: a dirty card is covered by the log of the next
// collection (stores of finalizers), or it is pre-marked: it holds at least one slot, and every
// slot it holds is free in the current run, or young in the new epoch (allocated by a finalizer)
fn settled_cards_check() {
    covered_build()
    let c: uint = HEAP_BASE
    let end = HEAP_BASE + heap_top
    while c < end {
        #if GROVE_MT
        // The thread's own granules only
        if !resolve_owned(c - HEAP_BASE) {
            c = (c | (GRANULE_SIZE - 1)) + 1
            continue
        }
        #end
        let card = card_of(c)
        if (card.@cast(uint) & 7) == 0 && @ptrv(card, u64) == 0 {
            c += 8 * CARD_SIZE
            continue
        }
        if @ptrv(card, u8) != 0 && !covered(c) : premarked_check(c)
        c += CARD_SIZE
    }
}

fn premarked_check(c: uint) {
    let desc = card_desc(c) ?! panic("GC error (cards): a dirty card in free pages after the settle")
    let pool: *Pool = desc.pool
    let first: uint = desc.first
    let isize = desc.isize
    let slots_end = first + desc.slots_total * isize
    if c >= slots_end : panic("GC error (cards): a dirty card holds no slot")
    let current = pool.block == desc
    let cursor: uint = pool.cursor
    let limit: uint = pool.limit
    let hi = current ? cursor : desc.aw_hi
    let slot = first
    if c > first && desc.slots_total > 1 : slot = first + (((c - first) * desc.recip) >> 32) * isize
    while slot < c + CARD_SIZE && slot < slots_end {
        let in_run = current && slot >= cursor && slot < limit
        if gcdata(slot.@cast(ptr)).is_not_new() || !(in_run || in_window(desc, slot, hi)) {
            print_word_address(c.@cast(ptr))
            panic("GC error (cards): a dirty card after the settle holds a slot outside the current run")
        }
        slot += isize
    }
}

fn print_word_address(ref: ptr) {
    #if GROVE_MT
    nj_off()
    #end
    let a: uint = ref
    print("reference word at 0x")
    a.print(16)
    print("\n")
}

fn rc_fail(item: ptr, what: String, found: uint) $exit {
    print_item_info(item)
    print("counted: ")
    found.print(10)
    print(", inline count: ")
    gcdata(item).co_count().print(10)
    print("\n")
    panic("GC error (recount): " + what)
}

#end
#end

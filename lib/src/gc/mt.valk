@unsafe

#if GROVE_MT

use ext
use mem
use coro
use io

// Grove-MT's thread states (v6 RT6). A thread runs Valk code (RUN), runs native code (NAT),
// is held in native code by a round (HELD), or is stopped at a safepoint (SAFE)
value TS_RUN (0)
value TS_NAT (1)
value TS_HELD (2)
value TS_SAFE (3)

// A thread's control block. The native brackets (misc/asm/coro/*.s) know its first words: the
// state (0), the NAT save area (the stack pointer at 8 and the callee-saved registers at
// 16..96, saved at the last enter-native: rbx, rbp, r12-r15 on x64, also rdi and rsi on
// Windows, x19-x29 on arm64) and the count of NAT exits (104)
struct ThreadCtl {
    state: uint
    sp: uint
    r0: uint
    r1: uint
    r2: uint
    r3: uint
    r4: uint
    r5: uint
    r6: uint
    r7: uint
    r8: uint
    r9: uint
    r10: uint
    nat_exits: uint
    // D4: set while local GC code runs; a native call or a join with it set stops the program
    in_gc: uint
    // The thread's number, as OWNER names its granules
    tid: uint
    // The thread's POLL_SP word (poll_word), which an initiator sets to stop it at its next poll
    poll_ref: *uint
    is_main: bool
    // What a round reads of the thread while it is stopped: its collector, its epoch and its S
    // buffers (which the round retires)
    heap: ?*Gc
    epoch_ref: *uint
    s_cursor_ref: *uint
    s_limit_ref: *uint
    s_buf_size_ref: *uint
    s_ov_cursor_ref: *uint
    s_ov_limit_ref: *uint
    // RT8: the round whose join stopped the thread (SAFE), and the roots it gathered: exact words
    // and conservative ones
    safe_epoch: uint
    roots_exact: *Bump
    roots_cons: *Bump
    // K10: local collections, and their number at the last round's release
    collects: uint
    collects_seen: uint
    want_local: uint
    // K11: whether the round chose the thread as a marker (1 SAFE, 2 rung from its event wait),
    // its mark stack and K6 queue, whether its roots are gathered, its count of NAT exits when a
    // marker last gathered them while held, and the doorbell of the event wait it is in (or -1)
    marker: uint
    mark_list: ?*Lifo
    fin_queue: *Bump
    roots_done: uint
    nat_seen: uint
    idle_efd: i32
    // K12: the GC service thread, which is no program thread
    is_service: bool
    // C7: a thread that Valk did not start, registered at its first callback; between
    // callbacks (foreign_idle) it has no Valk frames, and rounds read no stack of it
    foreign: bool
    foreign_idle: bool
}

/// The control block of the running thread; null on a thread the GC does not know.
~+ global ctl: ?*ThreadCtl (@undefined)

// What the compiled polls compare the stack pointer with (R-13's POLL_SP, complemented): the
// local trigger (poll_inv), or ~0 while a round waits for this thread (RT7). No default value:
// a round may set it before the thread's globals get theirs
global poll_word: uint

// RT7: the round handshake. A round's initiator holds round_lock and reg_lock; registration
// takes reg_lock
@shared round_lock: uint
@shared reg_lock: uint
@shared round_req: uint
// One more at the end of each round; joined threads wait for it to change (a futex word)
@shared round_epoch: uint
// The registered threads' control blocks, under reg_lock
@shared registry: ptr
@shared registry_len: uint
@shared registry_cap: uint
// Thread numbers: the next new one, and those of ended threads (under reg_lock)
@shared tid_next: uint
@shared tid_free: ptr
@shared tid_free_len: uint
@shared tid_free_cap: uint
// D12: a child process forked from a multi-threaded program may not run the GC
@shared gc_dead: uint
/// Rounds that ran since the program started.
~+ shared rounds_done: uint (0)

fn spin_take(lock: *uint) $inline {
    while atomic(lock[0] | 1) != 0 {
        // GC code: an unbracketed yield; the holder is RUN or NAT and leaves in finite time
        while atomic_load(lock[0]) != 0 : os_yield()
    }
}

fn spin_drop(lock: *uint) $inline {
    atomic(lock[0] & 0)
}

fn cas(address: *uint, expected: uint, desired: uint) bool $inline {
    return ext.valk_gc_cas(address.@cast(ptr), expected, desired) == expected
}

// Waits on a 32-bit futex word while it holds `expected`, 10 ms at most
fn futex_wait(address: *uint, expected: uint) {
    os_wait(address, expected, 10)
}

// A thread number: an ended thread's, or a new one. Under reg_lock
fn tid_take() uint {
    if tid_free_len > 0 {
        tid_free_len--
        return @ptrv(tid_free, uint, tid_free_len)
    }
    tid_next++
    return tid_next
}

fn tid_give(tid: uint) {
    spin_take(@ref(reg_lock))
    if tid_free_len == tid_free_cap {
        let cap = tid_free_cap == 0 ? 16 : tid_free_cap * 2
        let bigger = mem.alloc(cap * size_of(uint))
        if tid_free_len > 0 {
            mem.copy_bytes(tid_free, bigger, tid_free_len * size_of(uint))
            mem.free(tid_free)
        }
        tid_free = bigger
        tid_free_cap = cap
    }
    @ptrv(tid_free, uint, tid_free_len) = tid
    tid_free_len++
    spin_drop(@ref(reg_lock))
}

fn ctl_new(tid: uint, is_main: bool, is_service: bool) *ThreadCtl {
    return mem.new[ThreadCtl](.{
        state: TS_RUN, sp: 0, r0: 0, r1: 0, r2: 0, r3: 0, r4: 0, r5: 0, r6: 0, r7: 0, r8: 0, r9: 0, r10: 0
        nat_exits: 0, in_gc: 0
        tid: tid, poll_ref: @ref(poll_word), is_main: is_main
        heap: gc, epoch_ref: @ref(epoch)
        s_cursor_ref: @ref(s_cursor), s_limit_ref: @ref(s_limit), s_buf_size_ref: @ref(s_buf_size)
        s_ov_cursor_ref: @ref(s_ov_cursor), s_ov_limit_ref: @ref(s_ov_limit)
        safe_epoch: 0, roots_exact: Bump.new(256), roots_cons: Bump.new(1024)
        collects: 0, collects_seen: 0, want_local: 0
        marker: 0, mark_list: null, fin_queue: Bump.new(64), roots_done: 0, nat_seen: (~0).to(uint), idle_efd: -1
        is_service: is_service, foreign: false, foreign_idle: false
    })
}

fn ctl_free(c: *ThreadCtl) {
    c.roots_exact.free()
    c.roots_cons.free()
    c.fin_queue.free()
    let list = c.mark_list
    if isset(list) : list.free()
    mem.free(c)
}

// The number of registered threads: n of LC3
fn thread_heaps() uint $inline {
    let n = atomic_load(registry_len)
    return n > 0 ? n : 1
}

// RT9: a new thread registers its control block under reg_lock while it is in NAT, so a round
// never sees it half registered, then leaves NAT (waiting while a round holds it). K12: the
// registration that makes two program threads starts the GC service thread
fn thread_register(c: *ThreadCtl) {
    ext.valk_gc_native_enter(c.@cast(ptr))
    spin_take(@ref(reg_lock))
    let start: uint = 0
    if !c.is_service {
        program_threads++
        if program_threads == 2 && service_live == 0 {
            service_next++
            atomic_store(service_live, service_next)
            start = service_next
        }
    }
    if registry_len == registry_cap {
        let cap = registry_cap == 0 ? 16 : registry_cap * 2
        let bigger = mem.alloc(cap * size_of(ptr))
        if registry_len > 0 {
            mem.copy_bytes(registry, bigger, registry_len * size_of(ptr))
            mem.free(registry)
        }
        registry = bigger
        registry_cap = cap
    }
    @ptrv(registry, *ThreadCtl, registry_len) = c
    atomic(registry_len + 1)
    spin_drop(@ref(reg_lock))
    if start != 0 : service_start(start)
    ext.valk_gc_native_leave(c.@cast(ptr))
}

// RT9 step 10: the thread leaves the registry in NAT; it runs no Valk code on GC memory after
fn thread_unregister(c: *ThreadCtl) {
    ext.valk_gc_native_enter(c.@cast(ptr))
    spin_take(@ref(reg_lock))
    let i: uint = 0
    while i < registry_len {
        if @ptrv(registry, *ThreadCtl, i) == c {
            let last = registry_len - 1
            @ptrv(registry, *ThreadCtl, i) = @ptrv(registry, *ThreadCtl, last)
            atomic(registry_len - 1)
            break
        }
        i++
    }
    // K12: the unregistration that leaves one program thread sets the service thread exiting
    let stop = false
    if !c.is_service {
        program_threads--
        if program_threads == 1 && service_live != 0 {
            atomic_store(service_live, 0)
            stop = true
        }
    }
    spin_drop(@ref(reg_lock))
    if stop : service_wake()
}

// RT7: the thread's poll word follows its local trigger, or stops it while a round is requested.
// The exchange, then the re-read of round_req: with the initiator's own order (round_req, then
// the poll word) one of the two leaves the word at ~0 while a round waits
fn poll_sync() $inline {
    atomic(poll_word & 0)
    atomic(poll_word | poll_inv)
    if atomic_load(round_req) != 0 || local_wanted() || fin_due : atomic(poll_word | (~0).to(uint))
}

// K10: a round asked this thread for a local collection
fn local_wanted() bool $inline {
    let c = ctl ?! return false
    return c.want_local != 0
}

// The routine valk_gc_native_leave jumps to when its compare-and-swap fails: a round holds the
// thread (HELD). It waits for the release (K9: HELD -> NAT) and leaves NAT then
fn native_leave_slow(c: *ThreadCtl) {
    while true {
        let epoch = atomic_load(round_epoch)
        let state = atomic_load(c.state)
        if state == TS_HELD {
            // K11: rung from its event wait, the thread marks while it is held
            held_marker(c)
            futex_wait(@ref(round_epoch), epoch)
            continue
        }
        // Brackets do not nest: a bracketed call inside code that interrupted a native call
        // (a signal handler that is no $entrance) left the thread running
        if state == TS_RUN {
            #if GC_DEBUG
            panic("GC error: a native call returned to a running thread (a bracket in a signal handler?)")
            #end
            return
        }
        if cas(@ref(c.state), TS_NAT, TS_RUN) : return
    }
}

// RT6, D12: the child of a fork starts with one thread, whose control block says it is in the
// fork call. Locks taken by threads that do not exist in the child are free again. The child
// may not run the GC: Valk's process code only calls into C before exec
fn fork_child() $entrance {
    let c = ctl
    if isset(c) : c.state = TS_NAT
    round_req = 0
    round_lock = 0
    reg_lock = 0
    s_lock = 0
    pool_lock = 0
    mark_lock = 0
    fin_lock = 0
    service_live = 0
    program_threads = 1
    gc_dead = 1
    poll_word = poll_inv
}

// C7: a Valk function that native code calls enters through a stop point: a thread inside a
// native call leaves NAT, waiting while a round holds it. A thread without a control block is
// a foreign thread: it registers at its first callback. `top` is the callback's frame address,
// above which a foreign thread has no Valk frames. A callback whose call tree the compiler found
// GC-free (`gc_free`) runs unregistered. Returns whether the thread was in NAT
fn callback_enter(top: ptr, gc_free: bool) bool {
    if gc_free : return false
    let c = ctl ?! return foreign_register(top + 16)
    if c.state == TS_RUN {
        if c.foreign : foreign_depth++
        return false
    }
    ext.valk_gc_native_leave(c.@cast(ptr))
    if c.foreign {
        if foreign_depth == 0 {
            c.foreign_idle = false
            let g = c.heap ?! return true
            g.stack_top = top + 16
            active_set()
            // RT5: a collection skipped at the last callback's return runs first
            if foreign_due {
                foreign_due = false
                collect_now()
            }
        }
        foreign_depth++
    }
    return true
}

// The callback returns to native code
fn callback_leave(was_native: bool) {
    let c = ctl
    if isset(c) && c.foreign {
        foreign_depth--
        if foreign_depth == 0 : foreign_return(c)
    }
    if !was_native : return
    ext.valk_gc_native_enter(ctl.@cast(?ptr))
}

// Nested callbacks of a foreign thread; a collection due at its next callback (RT5)
global foreign_depth: uint
global foreign_due: bool
global foreign_collect_us: uint
// The key whose destructor ends a foreign thread's registration when it exits (C7)
@shared foreign_key: u32
@shared foreign_key_made: uint
// Registered foreign threads
@shared foreign_live: uint

// C7: the first callback on a thread Valk did not start registers it: a heap, a control block,
// the program's globals and a key whose destructor runs RT9's end when the thread exits
fn foreign_register(top: ptr) bool {
    if gc_dead != 0 : ext._exit(127)
    if globals_init_fn == 0 : panic("GC error: a callback from a foreign thread before the program started")
    thread_init(false, top, false)
    let c = ctl ?! return false
    c.foreign = true
    let init = globals_init_fn.@cast(fnptr(bool)())
    init(false)
    gc.state = GcState.idle
    if atomic_load(foreign_key_made) != 2 {
        if atomic(foreign_key_made | 1) == 0 {
            #if OS == "win"
            foreign_key = ext.FlsAlloc(foreign_exit.@cast(ptr))
            #else
            ext.pthread_key_create(@ref(foreign_key), foreign_exit.@cast(ptr))
            #end
            atomic_store(foreign_key_made, 2)
        }
        while atomic_load(foreign_key_made) != 2 : os_yield()
    }
    #if OS == "win"
    ext.FlsSetValue(foreign_key, c.@cast(ptr))
    #else
    ext.pthread_setspecific(foreign_key, c.@cast(ptr))
    #end
    atomic(foreign_live + 1)
    foreign_depth = 1
    active_set()
    return true
}

// RT5: the outermost callback of a foreign thread returns to native code. It collects when it
// allocated or logged since its last collection, which ran at least 1 ms ago; otherwise its
// next callback collects first. Then it has no Valk frames until that callback
fn foreign_return(c: *ThreadCtl) {
    let g = c.heap ?! return
    if g.state == GcState.idle && preblock_due(g) {
        let now = os_coarse_us()
        if now - foreign_collect_us >= 1000 {
            foreign_collect_us = now
            collect_now()
        } else {
            foreign_due = true
        }
    }
    c.foreign_idle = true
}

// C7, RT9: a registered foreign thread exits; its key's destructor ends the registration
fn foreign_exit(arg: ?ptr) $entrance {
    let c = ctl ?! return
    if !c.foreign : return
    atomic(foreign_live - 1)
    #if OS == "linux"
    io.uring_drain()
    #end
    coro.parks_leave()
    coro.home_close()
    #if OS == "win"
    io.iocp_close()
    #elif OS == "macos"
    io.kqueue_close()
    #end
    thread_stop()
}

// K11: the thread waits in the runtime's event wait, whose doorbell is `efd` (-1: it left it)
fn idle_wait(efd: i32) {
    let c = ctl ?! return
    c.idle_efd = efd
}

// D4's NJ half: local GC code makes no bracketed call
fn native_check() {
    let c = ctl ?! return
    if c.in_gc == 0 : return
    c.in_gc = 0
    panic("GC error: a native call inside local GC code (NJ, D4)")
}

// Local GC code begins or ends (D4); finalizers are ordinary code
fn nj_set(on: bool) $inline {
    let c = ctl ?! return
    c.in_gc = on ? 1 : 0
}

// A diagnostic print or a panic inside GC code is no NJ violation
fn nj_off() {
    nj_set(false)
}

#if TEST
/// Test helper: the running thread's state word (0 RUN, 1 NAT, 2 HELD, 3 SAFE).
+ fn thread_state_for_test() uint {
    let c = ctl ?! return 99
    return c.state
}

/// Test helper: how often the running thread left native code.
+ fn native_exits_for_test() uint {
    let c = ctl ?! return 0
    return c.nat_exits
}

/// Test helper: the number of registered threads.
+ fn registered_threads_for_test() uint {
    return atomic_load(registry_len)
}

/// Test helper: the number of registered foreign threads (C7).
+ fn foreign_threads_for_test() uint {
    return atomic_load(foreign_live)
}

/// Test helper: the number of registered program threads (the GC service thread is none).
+ fn program_threads_for_test() uint {
    return atomic_load(program_threads)
}

/// Test helper: the running thread's number.
+ fn thread_number_for_test() uint {
    let c = ctl ?! return 0
    return c.tid
}

/// Test helper: the number of the thread that owns the granule of `item`, 0 for none.
+ fn owner_of_for_test(item: ptr) uint {
    let a: uint = item
    if a - HEAP_BASE >= heap_top : return 0
    return owner_of((a - HEAP_BASE) >> GRANULE_SHIFT)
}

/// Test helper: makes the running thread's next poll stop, as a pending collection does.
+ fn poll_now_for_test() {
    poll_inv = (~0).to(uint)
    poll_sync()
}
#end

#end

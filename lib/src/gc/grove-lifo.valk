use mem

struct Lifo {
    data: ptr
    size: uint
    index: uint (0)
    guard: uint (0)     // R-22 as for Bump, in entries
    quiet: uint (0)

    static fn new() *Lifo {
        let size: uint = 100
        let value = mem.new[Lifo](.{
            size: size
            data: mem.alloc(size * size_of(ptr))
        })
        return value
    }

    /// Pushes `item` on top of the stack, doubling the buffer when it becomes full.
    + fn add(item: ptr) {
        @unsafe
        let index = this.index
        let new_index = index + 1
        this.index = new_index

        @ptrv(this.data, ptr, index) = item

        let size = this.size
        if new_index == size {
            let new_size = size * 2
            this.data = mem.resize(this.data, size * size_of(ptr), new_size * size_of(ptr))
            this.size = new_size
        }
    }
    /// Makes room for `count` more items, so `add_unchecked` can push them.
    fn reserve(count: uint) $inline {
        @unsafe
        if this.index + count >= this.size : this.grow(this.index + count)
    }

    fn grow(needed: uint) $noinline {
        @unsafe
        let size = this.size
        let new_size = size * 2
        while new_size <= needed : new_size *= 2
        this.data = mem.resize(this.data, size * size_of(ptr), new_size * size_of(ptr))
        this.size = new_size
    }

    fn add_unchecked(item: ptr) $inline {
        @unsafe
        let index = this.index
        this.index = index + 1
        @ptrv(this.data, ptr, index) = item
    }

    fn pop() ptr !LookupError {
        let index = this.index
        if index == 0 : throw .empty
        let new_index = index - 1
        this.index = new_index
        return @ptrv(this.data, ptr, new_index)
    }

    fn pop_unchecked() ptr $inline {
        let new_index = this.index - 1
        this.index = new_index
        return @ptrv(this.data, ptr, new_index)
    }

    fn clear() {
        this.index = 0
    }

    fn free() {
        @unsafe
        mem.free(this.data)
        mem.free(this)
    }

    // R-22, once per collection (see Bump.shrink_idle)
    fn shrink_idle() {
        @unsafe
        let q = this.size / 4
        let below = this.guard == q && this.index < q && @ptrv(this.data, uint, q) == guard_word
        this.quiet = below ? this.quiet + 1 : 0
        this.guard = 0
        if this.size * size_of(ptr) < shrink_min : return
        if this.quiet >= 2 {
            this.data = mem.resize(this.data, this.index * size_of(ptr), q * size_of(ptr))
            this.size = q
            this.quiet = 0
            if q * size_of(ptr) < shrink_min : return
            q = q / 4
        }
        if this.index < q {
            @ptrv(this.data, uint, q) = guard_word
            this.guard = q
        }
    }
}

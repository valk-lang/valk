@unsafe

#if GROVE

use mem

// P6's card scans. A card holds the 128 bytes of one page: the page table names the block or
// large object of all its slots

fn card_desc(c: uint) ?*Desc $inline {
    return @ptrv(page_table, ?*Desc, (c - HEAP_BASE) >> PAGE_SHIFT)
}

// Marks the uncounted reference words inside the card of every old slot that overlaps it
fn scan_card(c: uint, ml: *Lifo) {
    #if GC_DEBUG
    cards_scanned++
    if @ptrv(card_of(c), u8) == 0 : panic("GC error: a logged card is clean")
    #end
    let desc = card_desc(c) ?! return
    let layout = desc.layout ?! return
    let first: uint = desc.first
    let isize = desc.isize
    let slots_end = first + desc.slots_total * isize
    let hi = c + CARD_SIZE
    let slot = first
    if c > first && desc.slots_total > 1 : slot = first + (((c - first) * desc.recip) >> 32) * isize
    while slot < hi && slot < slots_end {
        if gcdata(slot.@cast(ptr)).is_owned() {
            each_ref_in(slot.@cast(ptr), layout, c.@cast(ptr), hi.@cast(ptr), ml, update_props)
        }
        slot += isize
    }
}

// The cards that overlap a storage
fn range_of(storage: uint) (uint, uint) {
    let desc = desc_of(storage.@cast(ptr))
    return (storage & (~(CARD_SIZE - 1)).to(uint), storage + desc.isize)
}

// A range entry: every dirty card of the storage's range, whatever the storage's state. A
// card at its ends may hold an old neighbour, whose words are scanned too
fn scan_range(storage: uint, ml: *Lifo) {
    let c, end = range_of(storage)
    while c < end {
        let card = card_of(c)
        // Eight clean cards at a time
        if (card.@cast(uint) & 7) == 0 && c + 8 * CARD_SIZE <= end && @ptrv(card, u64) == 0 {
            c += 8 * CARD_SIZE
            continue
        }
        if @ptrv(card, u8) != 0 : scan_card(c, ml)
        c += CARD_SIZE
    }
}

//////////////////////////
// The scanned storages
//////////////////////////

// The storages of the range entries P6 scanned, so each is scanned and cleared once. Open
// addressing over keys in malloc'd memory, emptied at the end of each collection
@shared ranges: ptr
@shared ranges_cap: uint
@shared ranges_len: uint

fn ranges_find(key: uint) uint {
    let mask = ranges_cap - 1
    let i = cnt_map_home(key) & mask
    while true {
        let k = @ptrv(ranges, uint, i)
        if k == key || k == 0 : return i
        i = (i + 1) & mask
    }
    return 0
}

// Adds a storage; false when it is in the set already
fn ranges_add(storage: uint) bool {
    if (ranges_len + 1) * 2 > ranges_cap {
        let old = ranges
        let old_cap = ranges_cap
        ranges_cap = old_cap == 0 ? 64 : old_cap * 2
        ranges = mem.calloc(ranges_cap * size_of(uint))
        let i: uint = 0
        while i < old_cap {
            let k = @ptrv(old, uint, i)
            if k != 0 : @ptrv(ranges, uint, ranges_find(k)) = k
            i++
        }
        if old_cap != 0 : mem.free(old)
    }
    let i = ranges_find(storage)
    if @ptrv(ranges, uint, i) == storage : return false
    @ptrv(ranges, uint, i) = storage
    ranges_len++
    return true
}

// Cleans the range of every storage in the set and empties it
fn ranges_clear() {
    if ranges_len == 0 : return
    let i: uint = 0
    while i < ranges_cap {
        let storage = @ptrv(ranges, uint, i)
        i++
        if storage == 0 : continue
        let c, end = range_of(storage)
        let first = card_of(c)
        mem.clear_bytes(first, card_of(end - 1) + 1 - first)
    }
    ranges_len = 0
    if ranges_cap > 4096 {
        mem.free(ranges)
        ranges_cap = 0
        return
    }
    mem.clear_bytes(ranges, ranges_cap * size_of(uint))
}

#if GC_STRESS
// In one collection out of 8 the log's cap is 1 to 64 entries
fn small_log_cap(count: uint, cap: uint) uint {
    if count % 8 != 7 : return cap
    return 1 + ((count * 0x9E3779B97F4A7C15) >> 58)
}
#end

#if GC_DEBUG
// D-19, P6's completeness: P6 scans every card entry and every dirty card of each storage
// that a range entry names, once per storage
global cards_scanned: uint (0)

fn cards_expected(log: *Bump) uint {
    let count = log.index / size_of(ptr)
    let n: uint = 0
    let i: uint = 0
    while i < count {
        let entry = @ptrv(log.data, uint, i)
        i++
        if entry & 1 == 0 {
            n++
            continue
        }
        // The first entry of a storage counts its dirty cards
        let seen = false
        let j: uint = 0
        while j < i - 1 {
            if @ptrv(log.data, uint, j) == entry : seen = true
            j++
        }
        if seen : continue
        let c, end = range_of(entry - 1)
        while c < end {
            if @ptrv(card_of(c), u8) != 0 : n++
            c += CARD_SIZE
        }
    }
    return n
}
#end

#end

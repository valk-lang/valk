@unsafe

use mem

@shared shared_dump: *Bump (Bump.new())
@shared shared_dump_roots: *Bump (Bump.new())

fn dump_shared(shared_list: *Bump) {
    let bytes = shared_list.index
    if bytes == 0 : return
    let dump = shared_dump
    let adr = dump.get(bytes)
    mem.copy_bytes(shared_list.data, adr, bytes)
}

fn dump_shared_roots(roots: *Bump) {
    let bytes = roots.index
    if bytes == 0 : return
    let dump = shared_dump_roots
    let adr = dump.get(bytes)
    mem.copy_bytes(roots.data, adr, bytes)
}

fn check_shared_dump() {
    let list = shared_dump
    let data = list.data
    let adr = data
    let end = adr.$offset(list.index)
    list.reset()
    let freed = false

    while adr < end {
        let item = @ptrv(adr, ptr)
        let data: *GcData = item.$offset(-8)
        adr = adr.$offset(size_of(ptr))

        if data.is_marked() {
            list.add_ptr(item)
            continue
        }

        free_shared_item(item)
        freed = true
    }
    if freed : atomic(shared_free_epoch + 1)
}

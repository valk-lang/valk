@unsafe
@ignore_access

use core
use time

// Core
@shared shared_lock: *core.MutexStruct[void] (@undefined)
@shared gc_list: Array[*Gc] (@undefined)
// Marks
@shared mark_count: uint (0)
// Shared - Counters
shared mem_shared: uint
shared mem_shared_trigger: uint
global in_collect_shared: bool (false)

// mem_shared plus what this thread published since its last batch
fn mem_shared_now() uint {
    return mem_shared + gc.shared_pending
}
// 1 while a shared collection holds shared_lock: a running thread lets go of
// its gc at its next allocator block switch (see shared_safepoint)
shared shared_stop: uint (0)

fn collect_shared_native(sp: ptr) {
    if gc.state != GcState.idle : return
    if in_collect_shared : return
    in_collect_shared = true

    let mc = mark_count
    // Another thread may run the collection while we wait: it scans our stack from the
    // registers the assembly entry pushed at `sp`, just below the caller, and not from here,
    // where the collector's own frames would show it stale words
    Gc.release_lock(sp, gc.@cast(ptr))
    shared_lock.lock()

    if mc != mark_count {
        shared_lock.unlock()
        gc.lock()
        in_collect_shared = false
        return
    }

    let pause_start = time.mono_us()
    let mygc = gc
    mygc.live_sp = sp
    let gcs = gc_list
    atomic_store(shared_stop, 1)

    each gcs as gcx {
        gcx.lock()
        if gcx.dont_stop : panic("GC stopped while calling share")
        gcx.flush_shared_pending()
    }

    // Sweeps of the last round that their threads did not get to, then what those sweeps
    // left in other threads' blocks
    each gcs as gcx {
        gc = gcx
        if gcx.sweep_pending : gcx.sweep_shared()
    }
    let foreign_freed = false
    each gcs as gcx {
        gc = gcx
        let list = gcx.foreign_dead
        let adr = list.data
        let end = adr + list.index
        if adr < end : foreign_freed = true
        while adr < end {
            free_shared_item(@ptrv(adr, GcItem))
            adr = adr.$offset(size_of(ptr))
        }
        list.reset()
    }
    if foreign_freed : atomic(shared_free_epoch + 1)

    // Switch the mark after all gcs are locked
    mark_count++
    shmark_now = shmark_now == flag_shmark ? flag_leak : flag_shmark

    each gcs as gcx {
        gc = gcx
        if gcx.collect_allowed(CollectKind.shared) : gcx.collect_run(CollectKind.shared)
    }

    // Mark, together with the threads waiting at their safepoint (see shared_safepoint)
    let live = pmark_run(gcs)
    each gcs as gcx {
        gc = gcx
        gcx.clear_stack_items()
    }
    gc = mygc

    // Each thread frees its own unmarked items once it runs again (sweep_shared)
    each gcs as gcx {
        gcx.sweep_end = gcx.shared_items.index
        gcx.sweep_pending = gcx.sweep_end > 0
    }
    // Items of threads that ended are swept here
    check_shared_dump()
    free_empty_unused_blocks()
    // What waits for a sweep is no longer counted
    atomic_store(mem_shared, live)

    update_shared_trigger()

    each gcs as gcx {
        gcx.unlock()
    }
    atomic_store(shared_stop, 0)

    shared_pause_last_us = time.mono_us() - pause_start
    if shared_pause_last_us > shared_pause_max_us : shared_pause_max_us = shared_pause_last_us

    // A thread blocked in a call cannot sweep for itself, and its gc is free meanwhile
    each gcs as gcx {
        if gcx == mygc || gcx.at_safepoint || !gcx.sweep_pending || !gcx.mutex.try_lock() : continue
        gc = gcx
        if gcx.sweep_pending : gcx.sweep_shared()
        gc = mygc
        gcx.mutex.unlock()
    }

    shared_lock.unlock()
    gc.lock()
    if mygc.sweep_pending : mygc.sweep_shared()
    in_collect_shared = false
}

// A running thread only lets go of its gc when it blocks, and a shared
// collection needs every gc: the allocator stops here while one waits. The
// thread's stack and registers are saved as for any blocking call, it helps
// mark, and it goes on once the collection lets the gcs go. Its own sweep
// runs at its next collection
fn shared_safepoint() {
    let g = gc
    if g.state != GcState.idle || in_collect_shared : return
    g.at_safepoint = true
    g.unlock()
    while shared_stop == 1 {
        if pmark_active == 1 : pmark_help()
        else : pmark_yield()
    }
    g.lock()
    g.at_safepoint = false
}

/// Resets `shared_pause_last_us` and `shared_pause_max_us` to zero under the shared lock.
+ fn reset_shared_pause_durations() {
    gc.unlock()
    shared_lock.lock()
    shared_pause_last_us = 0
    shared_pause_max_us = 0
    shared_lock.unlock()
    gc.lock()
}

// Bumped when a shared collection frees an item: its block belongs to some
// thread, which settles all of its blocks at its next collection
shared shared_free_epoch: uint (0)

// At least this much new shared memory between shared collections: each one stops every thread
value mem_shared_minimum_trigger (4 * 1024 * 1024)

// The next collection when the shared memory has doubled since this one, plus the minimum
fn update_shared_trigger() {
    let high = mem_shared * 2 + mem_shared_minimum_trigger
    let low = mem_shared_trigger / 100 * 80
    if low > high : high = low
    mem_shared_trigger = high
}

fn free_shared_item(item: GcItem) {
    // Load data before clear
    let data = gcdata(item)

    // Clear data
    data.set_new()
    data.co_count = 0
    data.flags = 0

    #if GC_DEBUG
    if data.flags != 0 : panic("GC did not remove marks")
    #end

    // mem_shared counts the marked items only (see collect_shared_native)
    if data.offset > 0 {
        let block = data.block()
        block.slots_used--

        let onfree = block.onfree
        if isset(onfree) : onfree(item)
    }
}

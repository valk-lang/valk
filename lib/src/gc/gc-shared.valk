@unsafe
@ignore_access

use core
use time

// Core
@shared shared_lock: *core.MutexStruct[void] (@undefined)
@shared gc_list: Array[*Gc] (@undefined)
// Marks
@shared mark_count: uint (0)
// Shared - Counters
shared mem_shared: uint
shared mem_shared_trigger: uint
global in_collect_shared: bool (false)
// 1 while a shared collection holds shared_lock: a running thread lets go of
// its gc at its next allocator block switch (see shared_safepoint)
shared shared_stop: uint (0)

fn collect_shared_native(sp: ptr) {
    if gc.state != GcState.idle : return
    if in_collect_shared : return
    in_collect_shared = true

    let mc = mark_count
    // Another thread may run the collection while we wait: it scans our stack from the
    // registers the assembly entry pushed at `sp`, just below the caller, and not from here,
    // where the collector's own frames would show it stale words
    Gc.release_lock(sp, gc.@cast(ptr))
    shared_lock.lock()

    if mc != mark_count {
        shared_lock.unlock()
        gc.lock()
        in_collect_shared = false
        return
    }

    let pause_start = time.mono_us()
    let mygc = gc
    mygc.live_sp = sp
    let gcs = gc_list
    atomic_store(shared_stop, 1)

    each gcs as gcx {
        gcx.lock()
        if gcx.dont_stop : panic("GC stopped while calling share")
    }

    // Switch the mark after all gcs are locked
    mark_count++
    // let msb = mem_shared / 1024

    each gcs as gcx {
        gc = gcx
        if gcx.collect_allowed(CollectKind.shared) : gcx.collect_run(CollectKind.shared)
    }

    // Update marks
    each gcs as gcx {
        gc = gcx
        gcx.update_marks()
    }

    // We remove all items that have the wrong mark or co_count == 0 & !owned
    each gcs as gcx {
        gc = gcx
        gcx.clear_shared()
    }
    // Check if we can clear items from the dump
    check_shared_dump()
    free_empty_unused_blocks()

    //
    gc = mygc

    update_shared_trigger()
    // println("mark: %mark | msb: %msb | msa: %msa | freed: %{msb-msa} | tb: %tb | ta: %{mem_shared_trigger / 1024}")

    each gcs as gcx {
        gcx.unlock()
    }
    atomic_store(shared_stop, 0)

    shared_pause_last_us = time.mono_us() - pause_start
    if shared_pause_last_us > shared_pause_max_us : shared_pause_max_us = shared_pause_last_us

    shared_lock.unlock()
    gc.lock()
    in_collect_shared = false
}

// A running thread only lets go of its gc when it blocks, and a shared
// collection needs every gc: the allocator stops here while one waits. The
// thread's stack and registers are saved as for any blocking call, and it
// waits on shared_lock, which the collection holds until it is done
fn shared_safepoint() {
    let g = gc
    if g.state != GcState.idle || in_collect_shared : return
    g.unlock()
    shared_lock.lock()
    shared_lock.unlock()
    g.lock()
}

/// Resets `shared_pause_last_us` and `shared_pause_max_us` to zero under the shared lock.
+ fn reset_shared_pause_durations() {
    gc.unlock()
    shared_lock.lock()
    shared_pause_last_us = 0
    shared_pause_max_us = 0
    shared_lock.unlock()
    gc.lock()
}

// Bumped when a shared collection frees an item: its block belongs to some
// thread, which settles all of its blocks at its next collection
shared shared_free_epoch: uint (0)

fn update_shared_trigger() {
    let high = mem_shared / 100 * 130 + mem_minimum_trigger
    let low = mem_shared_trigger / 100 * 80
    if low > high : high = low
    mem_shared_trigger = high
}

fn free_shared_item(item: GcItem) {
    // Load data before clear
    let data = gcdata(item)

    // Clear data
    data.set_new()
    data.co_count = 0
    data.flags = 0
    data.remove_marks()

    #if GC_DEBUG
    if data.is_marked() || data.has_leak_mark() : panic("GC did not remove marks")
    #end

    if data.offset > 0 {
        let block = data.block()
        block.slots_used--
        shared_free_epoch++
        atomic(mem_shared - block.isize)

        let onfree = block.onfree
        if isset(onfree) : onfree(item)
    }
}

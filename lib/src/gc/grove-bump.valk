#if GROVE

use mem

// R-22: a collector buffer above 1 MiB that stayed below a quarter of its size for 2
// collections shrinks to that quarter. A guard word at the quarter shows whether a cycle
// filled the buffer past it; no entry is ~0
value shrink_min (1024 * 1024)
value guard_word ((~0).to(uint))

struct Bump {
    data: ptr
    size: uint
    index: uint (0)
    guard: uint (0)     // The armed guard's offset, 0: none
    quiet: uint (0)     // Collections in a row below a quarter

    static fn new(size: uint (1000)) *Bump {
        if size == 0 : size = 32
        let value = mem.new[Bump](.{
            size: size
            data: mem.alloc(size)
        })
        return value
    }

    fn get(isize: uint) ptr {
        @unsafe
        let i = this.index
        let size = this.size
        let new_index = i + isize

        if new_index > size {
            let new_size = size * 2
            while new_index > new_size : new_size *= 2
            this.data = mem.resize(this.data, size, new_size)
            this.size = new_size
        }

        this.index = new_index
        return this.data + i
    }

    fn minimum_size(size: uint) {
        @unsafe
        if size > this.size {
            this.data = mem.resize(this.data, this.size, size)
            this.size = size
        }
    }

    fn reset() {
        this.index = 0
    }

    fn free() {
        @unsafe
        mem.free(this.data)
        mem.free(this)
    }

    fn add_ptr(item: ptr) {
        let adr = this.get(size_of(ptr))
        @ptrv(adr, ptr) = item
    }

    // add_ptr with the common case inlined: room left
    fn add_ptr_inline(item: ptr) $inline {
        @unsafe
        let i = this.index
        if i + size_of(ptr) > this.size {
            this.add_ptr(item)
            return
        }
        @ptrv(this.data + i, ptr) = item
        this.index = i + size_of(ptr)
    }

    // R-22, once per collection
    fn shrink_idle() {
        @unsafe
        let q = (this.size / 4) & (~7).to(uint)
        let below = this.guard == q && this.index < q && @ptrv(this.data + q, uint) == guard_word
        this.quiet = below ? this.quiet + 1 : 0
        this.guard = 0
        if this.size < shrink_min : return
        if this.quiet >= 2 {
            this.data = mem.resize(this.data, this.index, q)
            this.size = q
            this.quiet = 0
            if q < shrink_min : return
            q = (q / 4) & (~7).to(uint)
        }
        if this.index < q {
            @ptrv(this.data + q, uint) = guard_word
            this.guard = q
        }
    }

    fn loop_items[T](func: fn(T)(), reset: bool) {
        @unsafe
        let data = this.data
        let adr = data
        let end = adr + this.index
        if reset : this.reset()

        while adr < end {
            let item = @ptrv(adr, T)
            func(item)
            adr = adr.$offset(size_of(T))
        }
    }
}

#if TEST
/// Test helper: grows a zero-sized `Bump` and returns its initial size, grown size, index
/// and whether the second allocation directly follows the first.
+ fn bump_zero_growth_for_test() (uint, uint, uint, bool) {
    let bump = Bump.new(0)
    let initial_size = bump.size
    bump.get(1)
    let second = bump.get(32)
    let grown_size = bump.size
    let index = bump.index
    let second_at_expected = second == bump.data + 1
    bump.free()
    return (initial_size, grown_size, index, second_at_expected)
}
#end

#end

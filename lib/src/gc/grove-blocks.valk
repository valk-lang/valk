@unsafe

#if GROVE

use ext
use mem

// Grove's heap. One reservation at a fixed address holds the heap, its shadow (a >> 3) and
// its card table ((a >> 7) + 0x800). 2 MiB chunks are made writable in address order.
// Blocks (1-8 pages) and large objects are page runs; the page table names the descriptor
// of every page in use, so a word resolves to its slot without a search
value HEAP_BASE (0x200000000000)
value HEAP_MAX (64 * 1024 * 1024 * 1024)
value PAGE_SIZE (4096)
value PAGE_SHIFT (12)
value CHUNK_SIZE (2 * 1024 * 1024)
value CHUNK_PAGES (512)
value CHUNK_SHIFT (21)
value BLOCK_PAGES_MAX (8)
// An object above this size is a large object with a page run of its own
value LARGE_SLOT (8192)
// A large object from this size on that reuses pages takes them zeroed from the OS
value LARGE_RETURN (1024 * 1024)
// The first chunks keep 4 KiB pages, so a small program stays small
value SMALL_CHUNKS (4)
// The shadow is committed in steps of this size
value SHADOW_STEP (2 * 1024 * 1024)
// Free chunks kept for reuse before idle ones go back to the OS
value RETAIN_MIN (4 * 1024 * 1024)

// Card c is the 128 bytes [128c, 128c + 128) of heap; its byte CT(a) lies at (a >> 7) + 0x800
value CARD_SHIFT (7)
value CARD_SIZE (128)
value CARD_OFFSET (0x800)

value MAP_FLAGS (0x2 | 0x20 | 0x4000) // private, anonymous, no reserve
value MAP_FIXED_NOREPLACE (0x100000)
value MADV_DONTNEED (4)
value MADV_HUGEPAGE (14)
value MADV_NOHUGEPAGE (15)
value RLIMIT_AS (9)

// Chunk states: collections the chunk was wholly free for (0-3), and flags
value chunk_idle_mask (3)
value chunk_free_now (64)
value chunk_returned (128)

// Descriptor kinds
value desc_large (1)
// Runtime-sized storage: a word at a slot start also names the slot before it
value desc_seq (2)

// Block states
// Listed in the touched blocks: allocated into or freed from since
// the last collection, which settles only those blocks
value bs_touched (1)
// On its pool's PARTIAL list
value bs_queued (2)
// To be freed by the pool's next prune
value bs_free (8)

/// A pool callback that clones a closure environment allocated from that pool.
type EnvCloneFn (fnptr(ptr)(ptr))

// A block or a large object
struct Desc {
    first: ptr          // first slot, page-aligned
    isize: uint         // slot size (a large object: its size)
    recip: uint         // ceil(2^32 / isize): slot index = offset * recip >> 32
    slots_total: uint
    slots_used: uint    // slots whose state is not new (live)
    layout: ?ptr
    onfree: ?fnptr(ptr)()
    env_clone: ?EnvCloneFn
    // A compiler kind's generated routines (C-01); null: the layout table is read
    routines: ?*Kind
    // The window (I6): in epoch `epoch`, the slots allocated since the last collection lie in
    // [aw_lo, aw_hi); a current block's aw_hi is written when its run closes and at P0
    aw_lo: ptr
    aw_hi: ptr
    epoch: uint
    state: uint
    pool: ptr
    next: ?*Desc        // the pool's blocks
    pages: uint
    kind: uint
    fresh: bool         // pre-zeroed pages, never allocated from
}

// A run of free pages, counted from HEAP_BASE
struct FreeRun {
    start: uint
    pages: uint
    zeroed: bool
}

// Set in heap_init only: the program assigns global initial values after the gc started
@shared heap_size: uint         // R: bytes reserved
@shared heap_top: uint          // bytes of the chunks taken
@shared shadow_top: uint        // bytes of the shadow committed
@shared page_table: ptr         // ?*Desc per page
@shared chunk_states: ptr       // u8 per chunk
@shared thp_madvise: u8         // 0 unknown, 1 madvise huge pages, 2 leave them to the kernel
#if GROVE_MT
// Each thread heap has its own free pages, descriptors and usage (RT1)
global heap_used: uint
global free_runs: *Bump (@undefined)
global descs_free: ?*Desc
global descs_slab: ptr
global descs_slab_left: uint
// The descriptor slabs, freed at the thread's end
global descs_slabs: ?*Bump
#else
@shared heap_used: uint         // bytes of the blocks and large objects
@shared free_runs: *Bump (@undefined) // FreeRun records, ordered by address
@shared descs_free: ?*Desc
@shared descs_slab: ptr
@shared descs_slab_left: uint
#end

#if GROVE_MT
// Grove-MT (RT1): the reservation is owned in 64 KiB granules. The pool, under pool_lock, takes
// chunks at the frontier and hands out runs of granules; OWNER names the thread of each granule,
// and only the pool writes it. A thread heap's free page runs cover its own granules only
value GRANULE_SHIFT (16)
value GRANULE_SIZE (65536)
value GRANULE_PAGES (16)
value CHUNK_GRANULES (32)
// RT10: free granules the pool keeps with their pages; the rest go back to the OS
value POOL_RETAIN (64)

@shared pool_lock: uint
// FreeRun records in granules
@shared pool_runs: *Bump (@undefined)
// Granules in the pool whose pages were not given back to the OS
@shared pool_kept: uint
// u32 per granule: the number of the thread that owns it, 0 while the pool holds it
@shared owner_table: ptr
// u8 per granule: the owner's collections that found it wholly free, in a row
@shared granule_idle: ptr
// Bytes of the blocks and large objects of every thread heap
@shared heap_used_all: uint
// The running thread's number: what OWNER holds for its granules
global heap_tid: uint
#end

fn heap_init() {
    let size: uint = HEAP_MAX
    let limit: [uint x 2] = @undefined
    if ext.getrlimit(RLIMIT_AS, @ref(limit)) == 0 && limit[0] != (~0).to(uint) {
        // Half of the address space limit, the rest stays for the program
        let half = (limit[0] / 2) & (~(CHUNK_SIZE - 1)).to(uint)
        if half < size : size = half
    }
    if size < SMALL_CHUNKS * CHUNK_SIZE : heap_fail()
    heap_reserve(HEAP_BASE, size)
    heap_reserve(HEAP_BASE >> 3, size >> 3)
    heap_reserve(HEAP_BASE >> 7, (size >> 7) + 0x1000)
    let table = ext.mmap(null, size >> 9, 0, MAP_FLAGS, -1, 0)
    let address: uint = table
    if address == (~0).to(uint) : heap_fail()
    page_table = table
    chunk_states = ext.calloc(size >> CHUNK_SHIFT, 1)
    #if GROVE_MT
    owner_table = ext.calloc(size >> GRANULE_SHIFT, 4)
    granule_idle = ext.calloc(size >> GRANULE_SHIFT, 1)
    pool_runs = Bump.new(64 * size_of(FreeRun))
    #else
    free_runs = Bump.new(64 * size_of(FreeRun))
    epoch = 1
    #end
    heap_size = size
    // The shadow of the first 16 MiB of heap keeps 4 KiB pages
    ext.madvise((HEAP_BASE >> 3).@cast(ptr), CHUNK_SIZE, MADV_NOHUGEPAGE)
}

fn heap_reserve(at: uint, size: uint) {
    let p = ext.mmap(at.@cast(ptr), size, 0, MAP_FLAGS | MAP_FIXED_NOREPLACE, -1, 0)
    let got: uint = p
    if got == at : return
    // A kernel without MAP_FIXED_NOREPLACE takes the address as a hint
    if got != (~0).to(uint) : ext.munmap(p, size)
    heap_fail()
}

fn heap_fail() $exit {
    panic("Grove cannot reserve its heap at 0x200000000000: the address space limit (RLIMIT_AS) is too small or the range is in use")
}

fn heap_commit(at: uint, size: uint) {
    if ext.mprotect(at.@cast(ptr), size, 0x1 | 0x2) != 0 : panic("Grove cannot commit heap memory")
}

// Whether a word points below the chunks taken: only those pages have page table entries
fn in_heap(item: ptr) bool $inline {
    let a: uint = item
    return a - HEAP_BASE < heap_top
}

// The card byte of a heap address
fn card_of(a: uint) ptr $inline {
    return ((a >> CARD_SHIFT) + CARD_OFFSET).@cast(ptr)
}

// The descriptor of an object in the heap
fn desc_of(item: ptr) *Desc $inline {
    let a: uint = item
    return @ptrv(page_table, *Desc, (a - HEAP_BASE) >> PAGE_SHIFT)
}

fn heap_take_chunks(count: uint) {
    let size = count * CHUNK_SIZE
    if heap_top + size > heap_size : panic("Grove's heap is full")
    let at = HEAP_BASE + heap_top
    heap_commit(at, size)
    heap_commit_shadow(heap_top + size)
    heap_commit(page_table + (heap_top >> 9), size >> 9)
    // The card bytes, page-rounded: a page at either end may be shared with a neighbour chunk
    let cards: uint = card_of(at)
    let cards_end: uint = card_of(at + size)
    let cards_page = cards & (~(PAGE_SIZE - 1)).to(uint)
    heap_commit(cards_page, ((cards_end + PAGE_SIZE - 1) & (~(PAGE_SIZE - 1)).to(uint)) - cards_page)
    let chunk = heap_top >> CHUNK_SHIFT
    let end = chunk + count
    while chunk < end {
        let adr = (HEAP_BASE + chunk * CHUNK_SIZE).@cast(ptr)
        if chunk < SMALL_CHUNKS : ext.madvise(adr, CHUNK_SIZE, MADV_NOHUGEPAGE)
        else if thp_wants_madvise() : ext.madvise(adr, CHUNK_SIZE, MADV_HUGEPAGE)
        chunk++
    }
    let first_page = heap_top >> PAGE_SHIFT
    heap_top += size
    #if GROVE_MT
    free_insert(pool_runs, first_page / GRANULE_PAGES, count * CHUNK_GRANULES, true)
    #else
    free_insert(free_runs, first_page, count * CHUNK_PAGES, true)
    #end
}

#if GROVE_MT
// A thread heap: its own free pages and epochs; the main heap's are set up the same way
fn heap_thread_init(tid: uint) {
    heap_tid = tid
    free_runs = Bump.new(64 * size_of(FreeRun))
    descs_slabs = Bump.new(16 * size_of(ptr))
    epoch = 1
}

fn pool_lock_take() $inline {
    while atomic(pool_lock | 1) != 0 {
        while atomic_load(pool_lock) != 0 : ext.sched_yield()
    }
}

fn pool_lock_drop() $inline {
    atomic(pool_lock & 0)
}

fn owner_of(granule: uint) uint $inline {
    return @ptrv(owner_table, u32, granule).to(uint)
}

// RT1: `count` contiguous granules from the pool, owned by this thread from here on; their
// pages join the thread's free runs, pre-zeroed only if the pool had them zeroed
fn heap_take_granules(count: uint) {
    pool_lock_take()
    let g, zeroed = free_take(pool_runs, count)
    if g == (~0).to(uint) {
        heap_take_chunks((count + CHUNK_GRANULES - 1) / CHUNK_GRANULES)
        let again, again_zeroed = free_take(pool_runs, count)
        if again == (~0).to(uint) : panic("Grove: no free granules after taking chunks (bug)")
        g = again
        zeroed = again_zeroed
    }
    let i: uint = 0
    while i < count {
        #if GC_DEBUG
        if owner_of(g + i) != 0 : panic("GC error: the pool handed out a granule that has an owner")
        #end
        @ptrv(owner_table, u32, g + i) = heap_tid.to(u32)
        @ptrv(granule_idle, u8, g + i) = 0
        i++
    }
    if !zeroed : pool_kept = pool_kept > count ? pool_kept - count : 0
    pool_lock_drop()
    free_insert(free_runs, g * GRANULE_PAGES, count * GRANULE_PAGES, zeroed)
}

// RT10: a granule the thread no longer uses goes back to the pool. Its pages are free: their
// shadow is zero and their cards are clean. The pool keeps POOL_RETAIN granules with their
// pages; the others go back to the OS and are zero when taken again
fn heap_give_granule(g: uint, to_os: bool) {
    let at = HEAP_BASE + g * GRANULE_SIZE
    // Page-table entries of free pages are null already, but a thread's end leaves them set
    mem.clear_bytes(page_table + g * GRANULE_PAGES * size_of(ptr), GRANULE_PAGES * size_of(ptr))
    let zeroed = to_os || atomic_load(pool_kept) >= POOL_RETAIN
    if zeroed {
        ext.madvise(at.@cast(ptr), GRANULE_SIZE, MADV_DONTNEED)
        ext.madvise((at >> 3).@cast(ptr), GRANULE_SIZE >> 3, MADV_DONTNEED)
    }
    pool_lock_take()
    #if GC_DEBUG
    if owner_of(g) != heap_tid : panic("GC error: a thread gave back a granule it does not own")
    #end
    @ptrv(owner_table, u32, g) = 0
    if !zeroed : pool_kept++
    free_insert(pool_runs, g, 1, zeroed)
    pool_lock_drop()
}

// After a collection: each granule that lay wholly in free pages for 2 collections in a row
// leaves the thread's free runs for the pool
fn heap_return_granules() {
    let count = free_count(free_runs)
    let back = Bump.new(16 * size_of(uint))
    let i: uint = 0
    while i < count {
        let run = free_run(free_runs, i)
        i++
        let g = (run.start + GRANULE_PAGES - 1) / GRANULE_PAGES
        let last = (run.start + run.pages) / GRANULE_PAGES
        while g < last {
            let idle = @ptrv(granule_idle, u8, g).to(uint)
            if idle < 3 : idle++
            @ptrv(granule_idle, u8, g) = idle.to(u8)
            if idle >= 2 : back.add_ptr(g.@cast(ptr))
            g++
        }
    }
    let adr = back.data
    let end = adr + back.index
    while adr < end {
        let g = @ptrv(adr, uint)
        adr += size_of(ptr)
        free_cut(free_runs, g * GRANULE_PAGES, GRANULE_PAGES)
        #if GC_DEBUG
        // OWNER audit: a granule changes owner only while it holds no object
        let page: uint = 0
        while page < GRANULE_PAGES {
            if isset(@ptrv(page_table, ?ptr, g * GRANULE_PAGES + page)) : panic("GC error: a granule that holds a block went back to the pool")
            page++
        }
        #end
        heap_give_granule(g, false)
    }
    back.free()
}

// Takes the pages [start, start + pages) out of the free run that holds them
fn free_cut(runs: *Bump, start: uint, pages: uint) {
    let count = free_count(runs)
    let i: uint = 0
    while i < count && free_run(runs, i).start + free_run(runs, i).pages <= start : i++
    if i >= count || free_run(runs, i).start > start : panic("GC error: a returned granule is not in a free run")
    let run = free_run(runs, i)
    let run_start = run.start
    let run_end = run.start + run.pages
    let zeroed = run.zeroed
    if start + pages > run_end : panic("GC error: a returned granule is not in one free run")
    free_remove(runs, i, 1)
    if run_start < start {
        free_insert_at(runs, i, run_start, start - run_start, zeroed)
        i++
    }
    if start + pages < run_end : free_insert_at(runs, i, start + pages, run_end - start - pages, zeroed)
}

// RT9 step 11: every granule of the ended thread's heap goes back to the pool, its pages, shadow
// and cards cleared, so the next owner finds pre-zeroed memory and no stale entry
fn heap_thread_end() {
    let top = heap_top >> GRANULE_SHIFT
    let g: uint = 0
    while g < top {
        if owner_of(g) == heap_tid {
            let at = HEAP_BASE + g * GRANULE_SIZE
            mem.clear_bytes(card_of(at), GRANULE_SIZE >> CARD_SHIFT)
            heap_give_granule(g, true)
        }
        g++
    }
    free_runs.free()
    let slabs = descs_slabs
    if isset(slabs) {
        let adr = slabs.data
        let end = adr + slabs.index
        while adr < end {
            mem.free(@ptrv(adr, ptr))
            adr += size_of(ptr)
        }
        slabs.free()
        descs_slabs = null
    }
    atomic(heap_used_all - heap_used)
    heap_used = 0
}
#end

// The shadow is committed in 2 MiB steps (16 MiB of heap), so beyond the first step, whose
// pages stay small, it can have huge pages
fn heap_commit_shadow(heap_end: uint) {
    let need = heap_end >> 3
    if need <= shadow_top : return
    let top = (need + SHADOW_STEP - 1) & (~(SHADOW_STEP - 1)).to(uint)
    if top > heap_size >> 3 : top = heap_size >> 3
    let at = (HEAP_BASE >> 3) + shadow_top
    heap_commit(at, top - shadow_top)
    if shadow_top > 0 && thp_wants_madvise() : ext.madvise(at.@cast(ptr), top - shadow_top, MADV_HUGEPAGE)
    shadow_top = top
}

// Under `enabled = always` huge pages come without asking. Under `madvise` they are asked
// for only when `defrag` does not stall on them (defer or never)
fn thp_wants_madvise() bool {
    if thp_madvise == 0 {
        thp_madvise = 2
        if thp_setting_has("/sys/kernel/mm/transparent_hugepage/enabled", "[madvise]") {
            let defrag = "/sys/kernel/mm/transparent_hugepage/defrag"
            if thp_setting_has(defrag, "[defer]") || thp_setting_has(defrag, "[never]") : thp_madvise = 1
        }
    }
    return thp_madvise == 1
}

fn thp_setting_has(path: String, word: String) bool {
    let fd = ext.open(path.data_cstring, 0)
    if fd < 0 : return false
    let buf: [u8 x 128] = @undefined
    let len = ext.read(fd, @ref(buf), 128)
    ext.close(fd)
    if len <= 0 : return false
    let n: uint = len.to(uint)
    let i: uint = 0
    while i + word.bytes <= n {
        if mem.equals_bytes(@ref(buf) + i, word.data, word.bytes) : return true
        i++
    }
    return false
}

// Takes `pages` free pages, the lowest that fit, and whether they are zero
fn heap_carve(pages: uint) (ptr, bool) {
    let start, zeroed = free_take(free_runs, pages)
    if start == (~0).to(uint) {
        #if GROVE_MT
        heap_take_granules((pages + GRANULE_PAGES - 1) / GRANULE_PAGES)
        #else
        heap_take_chunks((pages + CHUNK_PAGES - 1) / CHUNK_PAGES)
        #end
        let again, again_zeroed = free_take(free_runs, pages)
        if again == (~0).to(uint) : panic("Grove: no free pages after taking chunks (bug)")
        start = again
        zeroed = again_zeroed
    }
    #if GROVE_MT
    // The granules are in use again
    let g = start / GRANULE_PAGES
    let g_last = (start + pages - 1) / GRANULE_PAGES
    while g <= g_last {
        @ptrv(granule_idle, u8, g) = 0
        g++
    }
    atomic(heap_used_all + pages * PAGE_SIZE)
    #else
    // The chunks are in use again
    let chunk = start >> (CHUNK_SHIFT - PAGE_SHIFT)
    let last = (start + pages - 1) >> (CHUNK_SHIFT - PAGE_SHIFT)
    while chunk <= last {
        @ptrv(chunk_states, u8, chunk) = 0
        chunk++
    }
    #end
    heap_used += pages * PAGE_SIZE
    return ((HEAP_BASE + start * PAGE_SIZE).@cast(ptr), zeroed)
}

// Makes every page of the descriptor's run name it
fn heap_map(desc: *Desc) {
    let a: uint = desc.first
    let page = (a - HEAP_BASE) >> PAGE_SHIFT
    let end = page + desc.pages
    while page < end {
        @ptrv(page_table, *Desc, page) = desc
        page++
    }
}

// Gives a descriptor's pages back to the free runs and releases the descriptor
fn heap_release(desc: *Desc) {
    let a: uint = desc.first
    let start = (a - HEAP_BASE) >> PAGE_SHIFT
    let pages = desc.pages
    let page = start
    while page < start + pages {
        @ptrv(page_table, ?*Desc, page) = null
        page++
    }
    heap_used -= pages * PAGE_SIZE
    #if GROVE_MT
    atomic(heap_used_all - pages * PAGE_SIZE)
    #end
    #if GC_DEBUG
    // Free pages have a zero shadow
    let sh: ptr = (a >> 3).@cast(ptr)
    let i: uint = 0
    while i < (pages * PAGE_SIZE) >> 3 {
        if @ptrv(sh, u64, i / 8) != 0 : panic("GC error: freed pages have a non-zero shadow")
        i += 8
    }
    // and clean cards
    let ct: ptr = card_of(a)
    i = 0
    while i < (pages * PAGE_SIZE) >> CARD_SHIFT {
        if @ptrv(ct, u64, i / 8) != 0 : panic("GC error: freed pages have dirty cards")
        i += 8
    }
    #end
    free_insert(free_runs, start, pages, false)
    desc.next = descs_free
    descs_free = desc
}

fn heap_note_usage() {
    #if GROVE_MT
    let used = heap_used_all
    #else
    let used = heap_used
    #end
    mem_usage_shared = used
    if used > mem_usage_peak : mem_usage_peak = used
    gc.mem_usage_thread = used
}

fn desc_new() *Desc {
    let desc = descs_free
    if isset(desc) {
        descs_free = desc.next
        mem.clear_bytes(desc, size_of(Desc))
        return desc
    }
    if descs_slab_left == 0 {
        descs_slab = mem.calloc(64 * size_of(Desc))
        descs_slab_left = 64
        #if GROVE_MT
        let slabs = descs_slabs
        if isset(slabs) : slabs.add_ptr(descs_slab)
        #end
    }
    let slot: *Desc = descs_slab
    descs_slab += size_of(Desc)
    descs_slab_left--
    return slot
}

//////////////////////////
// Free page runs
//////////////////////////

// A list of free runs (FreeRun records, ordered by start): a heap's free pages, or Grove-MT's
// pool of free granules, in units of granules
fn free_count(runs: *Bump) uint $inline {
    return runs.index / size_of(FreeRun)
}

fn free_run(runs: *Bump, i: uint) *FreeRun $inline {
    return runs.data + i * size_of(FreeRun)
}

fn free_insert_at(runs: *Bump, i: uint, start: uint, pages: uint, zeroed: bool) {
    let count = free_count(runs)
    runs.get(size_of(FreeRun))
    if i < count : mem.move_bytes(free_run(runs, i), free_run(runs, i + 1), (count - i) * size_of(FreeRun))
    @ptrv(free_run(runs, i), FreeRun) = FreeRun { start: start, pages: pages, zeroed: zeroed }
}

fn free_remove(runs: *Bump, i: uint, n: uint) {
    let count = free_count(runs)
    if i + n < count : mem.move_bytes(free_run(runs, i + n), free_run(runs, i), (count - i - n) * size_of(FreeRun))
    runs.index -= n * size_of(FreeRun)
}

// Adds a run, merged with touching free neighbours whose zero flag is the same
fn free_insert(runs: *Bump, start: uint, pages: uint, zeroed: bool) {
    let count = free_count(runs)
    let lo: uint = 0
    let hi = count
    while lo < hi {
        let mid = (lo + hi) / 2
        if free_run(runs, mid).start < start : lo = mid + 1
        else : hi = mid
    }
    let i = lo
    #if GC_DEBUG
    if i > 0 && free_run(runs, i - 1).start + free_run(runs, i - 1).pages > start : panic("GC error: freed pages overlap a free run")
    if i < count && start + pages > free_run(runs, i).start : panic("GC error: freed pages overlap a free run")
    #end
    free_insert_at(runs, i, start, pages, zeroed)
    free_coalesce(runs, i)
}

// Merges run i with touching neighbours whose zero flag is the same
fn free_coalesce(runs: *Bump, i: uint) {
    let run = free_run(runs, i)
    if i + 1 < free_count(runs) {
        let next = free_run(runs, i + 1)
        if run.start + run.pages == next.start && run.zeroed == next.zeroed {
            run.pages += next.pages
            free_remove(runs, i + 1, 1)
        }
    }
    if i > 0 {
        let prev = free_run(runs, i - 1)
        if prev.start + prev.pages == run.start && prev.zeroed == run.zeroed {
            prev.pages += run.pages
            free_remove(runs, i, 1)
        }
    }
}

// First fit by address. Runs that touch (split by a returned chunk) are taken together.
// Returns the first page, or ~0 when nothing fits
fn free_take(runs: *Bump, pages: uint) (uint, bool) {
    let count = free_count(runs)
    let i: uint = 0
    while i < count {
        let span = free_run(runs, i).pages
        let j = i
        while span < pages && j + 1 < count && free_run(runs, j).start + free_run(runs, j).pages == free_run(runs, j + 1).start {
            j++
            span += free_run(runs, j).pages
        }
        if span < pages {
            i = j + 1
            continue
        }
        let start = free_run(runs, i).start
        let zeroed = true
        let left = pages
        let k = i
        while left > 0 {
            let run = free_run(runs, k)
            zeroed = zeroed && run.zeroed
            if run.pages <= left {
                left -= run.pages
                k++
            } else {
                run.start += left
                run.pages -= left
                left = 0
            }
        }
        if k > i : free_remove(runs, i, k - i)
        return (start, zeroed)
    }
    return ((~0).to(uint), false)
}

//////////////////////////
// Chunks back to the OS
//////////////////////////

// After a collection: a chunk that lay wholly in free pages for 2 collections goes back to
// the OS, with its shadow, once more than `retain` bytes of free chunks are kept
fn heap_return_idle(retain: uint) {
    let chunks = heap_top >> CHUNK_SHIFT
    let count = free_count(free_runs)
    let i: uint = 0
    while i < count {
        // Touching runs (their zero flags differ) are one span of free pages
        let start = free_run(free_runs, i).start
        let end = start + free_run(free_runs, i).pages
        i++
        while i < count && free_run(free_runs, i).start == end {
            end += free_run(free_runs, i).pages
            i++
        }
        let chunk = (start + CHUNK_PAGES - 1) / CHUNK_PAGES
        let last = end / CHUNK_PAGES
        while chunk < last {
            @ptrv(chunk_states, u8, chunk) = @ptrv(chunk_states, u8, chunk) | chunk_free_now
            chunk++
        }
    }
    let kept: uint = 0
    let chunk: uint = 0
    while chunk < chunks {
        let state = @ptrv(chunk_states, u8, chunk).to(uint)
        if (state & chunk_free_now) == 0 {
            @ptrv(chunk_states, u8, chunk) = 0
            chunk++
            continue
        }
        state = state - chunk_free_now
        if (state & chunk_returned) == 0 {
            let idle = state & chunk_idle_mask
            if idle < chunk_idle_mask : idle++
            state = idle
            kept += CHUNK_SIZE
            if kept > retain && idle >= 2 {
                heap_return_chunk(chunk)
                kept -= CHUNK_SIZE
                state = chunk_returned
            }
        }
        @ptrv(chunk_states, u8, chunk) = state.to(u8)
        chunk++
    }
}

fn heap_return_chunk(chunk: uint) {
    let at = HEAP_BASE + chunk * CHUNK_SIZE
    ext.madvise(at.@cast(ptr), CHUNK_SIZE, MADV_DONTNEED)
    heap_return_shadow(chunk)
    heap_return_cards(chunk)
    // The chunk becomes one pre-zeroed run; the runs it cuts keep their flags outside it
    let start = chunk * CHUNK_PAGES
    let end = start + CHUNK_PAGES
    let count = free_count(free_runs)
    let i: uint = 0
    while i < count && free_run(free_runs, i).start + free_run(free_runs, i).pages <= start : i++
    let k = i
    while k < count && free_run(free_runs, k).start + free_run(free_runs, k).pages < end : k++
    if k >= count || free_run(free_runs, i).start > start : panic("GC error: a returned chunk is not in a free run")
    let head_start = free_run(free_runs, i).start
    let head_zeroed = free_run(free_runs, i).zeroed
    let tail_end = free_run(free_runs, k).start + free_run(free_runs, k).pages
    let tail_zeroed = free_run(free_runs, k).zeroed
    free_remove(free_runs, i, k - i + 1)
    if head_start < start {
        free_insert_at(free_runs, i, head_start, start - head_start, head_zeroed)
        i++
    }
    free_insert_at(free_runs, i, start, CHUNK_PAGES, true)
    if end < tail_end : free_insert_at(free_runs, i + 1, end, tail_end - end, tail_zeroed)
    free_coalesce(free_runs, i)
}

// The shadow of a free chunk is zero. The first shadow step has small pages and goes back
// with each chunk; a later one, which may be a huge page, only once all its chunks went back
fn heap_return_shadow(chunk: uint) {
    let per_step = SHADOW_STEP / (CHUNK_SIZE >> 3)
    let first = chunk - chunk % per_step
    if first == 0 {
        ext.madvise(((HEAP_BASE + chunk * CHUNK_SIZE) >> 3).@cast(ptr), CHUNK_SIZE >> 3, MADV_DONTNEED)
        return
    }
    let chunks = heap_top >> CHUNK_SHIFT
    let c = first
    while c < first + per_step && c < chunks {
        if c != chunk && (@ptrv(chunk_states, u8, c) & chunk_returned) == 0 : return
        c++
    }
    let shadow = (HEAP_BASE + first * CHUNK_SIZE) >> 3
    let end = shadow_top + (HEAP_BASE >> 3)
    let size = SHADOW_STEP
    if shadow + size > end : size = end - shadow
    ext.madvise(shadow.@cast(ptr), size, MADV_DONTNEED)
}

// A chunk's card bytes start 0x800 into a page, so its first and last card pages are shared
// with its neighbours. Its private pages go back with it; a shared one only while the
// neighbour is returned too (or was never taken), else with the neighbour's return
fn heap_return_cards(chunk: uint) {
    let lo: uint = card_of(HEAP_BASE + chunk * CHUNK_SIZE)
    let hi = lo + (CHUNK_SIZE >> CARD_SHIFT)
    #if GC_DEBUG
    let i = lo
    while i < hi {
        if @ptrv(i.@cast(ptr), u64) != 0 : panic("GC error: a returned chunk has dirty cards")
        i += 8
    }
    #end
    let start = lo & (~(PAGE_SIZE - 1)).to(uint)
    let end = (hi + PAGE_SIZE - 1) & (~(PAGE_SIZE - 1)).to(uint)
    if start != lo && chunk > 0 && !chunk_gone(chunk - 1) : start += PAGE_SIZE
    if end != hi && !chunk_gone(chunk + 1) : end -= PAGE_SIZE
    if end > start : ext.madvise(start.@cast(ptr), end - start, MADV_DONTNEED)
}

// A chunk that is returned or not taken yet: its card bytes are zero and unused
fn chunk_gone(chunk: uint) bool {
    if chunk >= heap_top >> CHUNK_SHIFT : return true
    return (@ptrv(chunk_states, u8, chunk) & chunk_returned) != 0
}

// The current epoch: one per collection, starting at 1 (a new descriptor has epoch 0)
#if GROVE_MT
global epoch: uint
#else
@shared epoch: uint
#end

// Whether a slot is young: allocated in this epoch, inside its block's window. `hi` is the
// window's end (a current block's cursor)
fn in_window(desc: *Desc, slot: uint, hi: uint) bool $inline {
    let lo: uint = desc.aw_lo
    return desc.epoch == epoch && slot >= lo && slot < hi
}

// Touched blocks are listed once per collection
fn touch_block(block: *Desc) $inline {
    let state = block.state
    if (state & bs_touched) != 0 : return
    block.state = state | bs_touched
    gc.touched_blocks.add_ptr(block)
}

#if GC_DEBUG
// Each touched descriptor is named by the page table for each of its pages; free runs are
// in order, apart, and coalesced unless their zero flags differ
fn heap_check(touched: *Bump) {
    let adr = touched.data
    let end = adr + touched.index
    while adr < end {
        let desc = @ptrv(adr, *Desc)
        adr += size_of(ptr)
        desc_check(desc)
    }
    let count = free_count(free_runs)
    let i: uint = 0
    while i < count {
        let run = free_run(free_runs, i)
        if run.pages == 0 : panic("GC error: an empty free page run")
        if @ptrv(page_table, ?ptr, run.start) != null || @ptrv(page_table, ?ptr, run.start + run.pages - 1) != null {
            panic("GC error: a free page run is named by the page table")
        }
        if i + 1 < count {
            let next = free_run(free_runs, i + 1)
            if run.start + run.pages > next.start : panic("GC error: free page runs overlap")
            if run.start + run.pages == next.start && run.zeroed == next.zeroed : panic("GC error: free page runs are not coalesced")
        }
        i++
    }
}
#end

fn desc_check(desc: *Desc) {
    let a: uint = desc.first
    let page = (a - HEAP_BASE) >> PAGE_SHIFT
    let end = page + desc.pages
    if desc.slots_total * desc.isize > desc.pages * PAGE_SIZE : panic("GC error: a block's slots exceed its pages")
    while page < end {
        if @ptrv(page_table, ptr, page) != desc.@cast(ptr) : panic("GC error: the page table does not name a block's descriptor")
        page++
    }
}

#if TEST
/// Test helper: bytes of the chunks whose pages are all free and that are not returned.
+ fn free_chunks_kept_for_test() uint {
    #if GROVE_MT
    // The thread's granules that lie wholly in its free pages
    let bytes: uint = 0
    let count = free_count(free_runs)
    let i: uint = 0
    while i < count {
        let run = free_run(free_runs, i)
        i++
        let g = (run.start + GRANULE_PAGES - 1) / GRANULE_PAGES
        let last = (run.start + run.pages) / GRANULE_PAGES
        if last > g : bytes += (last - g) * GRANULE_SIZE
    }
    return bytes
    #end
    let kept: uint = 0
    let chunks = heap_top >> CHUNK_SHIFT
    let chunk: uint = 0
    while chunk < chunks {
        let page = chunk * CHUNK_PAGES
        let end = page + CHUNK_PAGES
        while page < end && !isset(@ptrv(page_table, ?ptr, page)) : page++
        if page == end && (@ptrv(chunk_states, u8, chunk) & chunk_returned) == 0 : kept += CHUNK_SIZE
        chunk++
    }
    return kept
}

/// Test helper: whether the page table names the descriptor of every block of the thread's pools.
+ fn block_registry_ok_for_test() bool {
    let adr = alc_list.data
    let end = adr + alc_list.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        let block = alc.first
        while isset(block) {
            desc_check(block)
            if !in_heap(block.first) : return false
            block = block.next
        }
    }
    return true
}
#end

#end

@unsafe
@ignore_access

use ext

// Marking of shared memory during a shared collection. The collecting thread and every thread
// waiting at its safepoint mark together: each claims an item with one atomic or of the mark
// bit, works on its own stack, and hands half of it to the queue while others wait for work

// Set in thread_init of the main thread
@shared pmark_queue: *Lifo (@undefined)
@shared pmark_spin: uint (0)
// 1 while marking runs; threads join only then
shared pmark_active: uint (0)
// Threads marking, and those of them waiting for work
shared pmark_workers: uint (0)
shared pmark_idle: uint (0)
// Bytes of the items marked
shared pmark_live: uint (0)
// This thread's stack while it marks
global pmark_local_list: ?*Lifo (null)
global pmark_local_live: uint (0)

// Root lists cut into units the marking threads claim: (first entry, entry count, kind)
@shared pmark_units: *Bump (@undefined)
shared pmark_unit_next: uint (0)
@shared pmark_unit_count: uint (0)
value pmark_unit_size (2048)
value pmark_unit_stack (0)
value pmark_unit_list (1)

value pmark_share_min (64)
value pmark_take_max (256)

// Lets other threads run while this one waits for the shared collection
fn pmark_yield() {
    #if OS == "win"
    ext.SwitchToThread()
    #else
    ext.sched_yield()
    #end
}

fn pmark_lock() {
    while true {
        if atomic_load(pmark_spin) == 0 && (atomic(pmark_spin | 1) & 1) == 0 : return
        $pause()
    }
}

fn pmark_unlock() {
    atomic_store(pmark_spin, 0)
}

fn pmark_local() *Lifo {
    let list = pmark_local_list
    if isset(list) : return list
    let created = Lifo.new()
    pmark_local_list = created
    return created
}

// Sets this round's mark on `item`; false when another thread already did
fn pmark_claim(item: ptr) bool $inline {
    let data = gcdata(item)
    let now = shmark_now
    if (data.flags & now) != 0 : return false
    let old = atomic(data.flags | now)
    if (old & now) != 0 : return false
    // The mark of the last round, which the next sweep must not see
    let last = flag_shmark + flag_leak - now
    if (old & last) != 0 : atomic(data.flags & (255 - last))
    return true
}

fn pmark_claim_single(item: ptr) bool $inline {
    let data = gcdata(item)
    let now = shmark_now
    let flags = data.flags
    if (flags & now) != 0 : return false
    let last = flag_shmark + flag_leak - now
    data.flags = (flags & (255 - last)) | now
    return true
}

// Run by the collecting thread with every gc locked: marks from the roots of `gcs`
fn pmark_run(gcs: Array[*Gc], stop_gen: uint) uint {
    // Helpers of the last round may still be leaving
    let wait_spins: uint = 0
    while pmark_workers > 0 {
        if wait_spins < 64 {
            $pause()
            wait_spins++
        } else {
            pmark_yield()
        }
    }
    let has_helpers = false
    each gcs as gcx {
        if gcx.safepoint_gen == stop_gen {
            has_helpers = true
            break
        }
    }
    if !has_helpers : return pmark_run_single(gcs)

    let units = pmark_units
    units.reset()
    each gcs as gcx {
        pmark_add_units(gcx.stack_items, pmark_unit_stack)
        pmark_add_units(gcx.shared_roots, pmark_unit_list)
    }
    pmark_add_units(shared_dump_roots, pmark_unit_list)
    pmark_unit_count = units.index / (size_of(ptr) * 3)
    atomic_store(pmark_unit_next, 0)
    atomic_store(pmark_live, 0)
    atomic_store(pmark_idle, 0)
    atomic_store(pmark_workers, 1)
    atomic_store(pmark_active, 1)

    pmark_drain(pmark_local())
    let live = pmark_live
    return live
}

fn pmark_drain_ref_single(ref: ptr, list: *Lifo) $hot $inline {
    @unsafe
    let sub = @ptrv(ref, ?ptr)
    if !isset(sub) : return
    let sub_item: ptr = sub & (~prop_mask).to(uint)
    #if GC_DEBUG
    if !gcdata(sub_item).is_shared() : panic("GC error: shared data refers to an object that is not shared")
    #end
    if pmark_claim_single(sub_item) {
        let sub_data = gcdata(sub_item)
        if sub_data.offset == 0 : return
        let sub_block = sub_data.block()
        if !isset(sub_block.layout) {
            pmark_local_live += sub_block.isize
            return
        }
        list.add_unchecked(sub_item)
    }
}

fn pmark_push_roots_single(list: *Bump, from_stack: bool, local: *Lifo) {
    let adr = list.data
    let end = adr + list.index
    while adr < end {
        let item = @ptrv(adr, ptr)
        adr = adr + size_of(ptr)
        let data = gcdata(item)
        if from_stack {
            if !data.is_shared() : continue
        } else if !data.is_shared() || data.is_marked() || (!data.is_owned() && data.co_count == 0) {
            continue
        }
        if pmark_claim_single(item) {
            if data.offset == 0 : continue
            let block = data.block()
            if !isset(block.layout) {
                pmark_local_live += block.isize
                continue
            }
            local.add(item)
        }
    }
}

// Single-threaded shared mark when no helper thread is waiting at a safepoint: zero atomics
fn pmark_run_single(gcs: Array[*Gc]) uint $hot {
    let local = pmark_local()
    pmark_local_live = 0
    each gcs as gcx {
        pmark_push_roots_single(gcx.stack_items, true, local)
        pmark_push_roots_single(gcx.shared_roots, false, local)
    }
    pmark_push_roots_single(shared_dump_roots, false, local)

    let live: uint = 0
    let prefetch_on = mem_shared >= 16 * 1024 * 1024
    while local.index > 0 {
        if prefetch_on && local.index >= 4 {
            $prefetch((@ptrv(local.data, ptr, local.index - 4) - 8).@cast(ptr))
        }
        let item: GcItem = local.pop_unchecked()
        let data = gcdata(item)
        let block = data.block()
        live += block.isize
        let layout = block.layout
        if isset(layout) {
            local.reserve(block.isize / size_of(ptr))
            each_ref(item, layout, local, pmark_drain_ref_single)
        }
    }
    let total = live + pmark_local_live
    pmark_local_live = 0
    return total
}

// Drops entries no longer held by local objects and deduplicates; runs under STW after stack clear
fn compact_shared_roots(list: *Bump) {
    let base = list.data
    let end = base + list.index
    let write = base
    let adr = base
    while adr < end {
        let item = @ptrv(adr, ptr)
        adr = adr + size_of(ptr)
        let data = gcdata(item)
        if !data.is_shared() || (!data.is_owned() && data.co_count == 0) : continue
        if data.is_in_updates() : continue
        data.set_in_updates()
        @ptrv(write, ptr) = item
        write = write + size_of(ptr)
    }
    adr = base
    while adr < write {
        gcdata(@ptrv(adr, ptr)).remove_in_updates()
        adr = adr + size_of(ptr)
    }
    list.index = write - base
}

fn sort_ptrs_rec(base: ptr, lo: uint, hi: uint) {
    while hi - lo > 16 {
        let pivot = @ptrv(base, ptr, (lo + hi) / 2)
        let i = lo
        let j = hi - 1
        while true {
            while @ptrv(base, ptr, i) < pivot : i++
            while @ptrv(base, ptr, j) > pivot : j--
            if i >= j : break
            let tmp = @ptrv(base, ptr, i)
            @ptrv(base, ptr, i) = @ptrv(base, ptr, j)
            @ptrv(base, ptr, j) = tmp
            i++
            j--
        }
        let split = j + 1
        if split - lo < hi - split {
            sort_ptrs_rec(base, lo, split)
            lo = split
        } else {
            sort_ptrs_rec(base, split, hi)
            hi = split
        }
    }
    let i = lo + 1
    while i < hi {
        let cur = @ptrv(base, ptr, i)
        let j = i
        while j > lo && @ptrv(base, ptr, j - 1) > cur {
            @ptrv(base, ptr, j) = @ptrv(base, ptr, j - 1)
            j--
        }
        @ptrv(base, ptr, j) = cur
        i++
    }
}

// Thread-local compaction of `shared_roots` outside STW: drops released entries using
// atomic reads and deduplicates by sorting without writing any shared header flags
fn compact_shared_roots_local(list: *Bump) {
    let base = list.data
    let end = base + list.index
    let write = base
    let adr = base
    while adr < end {
        let item = @ptrv(adr, ptr)
        adr = adr + size_of(ptr)
        let data = gcdata(item)
        let flags = atomic_load(data.flags)
        if (flags & flag_shared) == 0 : continue
        if (flags & flag_owned) == 0 && atomic_load(data.co_count) == 0 : continue
        @ptrv(write, ptr) = item
        write = write + size_of(ptr)
    }
    let count = (write - base) / size_of(ptr)
    if count <= 1 {
        list.index = count * size_of(ptr)
        return
    }
    sort_ptrs_rec(base, 0, count)
    let kept: uint = 1
    let prev = @ptrv(base, ptr, 0)
    let i: uint = 1
    while i < count {
        let cur = @ptrv(base, ptr, i)
        if cur != prev {
            @ptrv(base, ptr, kept) = cur
            prev = cur
            kept++
        }
        i++
    }
    list.index = kept * size_of(ptr)
}

#if GC_DEBUG
fn verify_shared_roots(gcs: Array[*Gc]) {
    each gcs as gcx : verify_shared_list(gcx.shared_items)
    verify_shared_list(shared_dump)
}

fn verify_shared_list(list: *Bump) {
    let adr = list.data
    let end = adr + list.index
    while adr < end {
        let item = @ptrv(adr, ptr)
        adr = adr + size_of(ptr)
        let data = gcdata(item)
        if !data.is_marked() && (data.is_owned() || data.co_count > 0) {
            panic("GC error: shared item held by local object was missed by shared_roots")
        }
    }
}
#end

fn pmark_add_units(list: *Bump, kind: uint) {
    let count = list.index / size_of(ptr)
    let first: uint = 0
    while first < count {
        let n = count - first
        if n > pmark_unit_size : n = pmark_unit_size
        let unit = pmark_units.get(size_of(ptr) * 3)
        @ptrv(unit, ptr, 0) = list.data + first * size_of(ptr)
        @ptrv(unit, uint, 1) = n
        @ptrv(unit, uint, 2) = kind
        first += n
    }
}

// Claims the roots of one unit onto `local`; false when no unit is left. Roots only read and
// claim: the stack items are released after marking, by the collecting thread
fn pmark_scan_unit(local: *Lifo) bool {
    if pmark_unit_next >= pmark_unit_count : return false
    let index = atomic(pmark_unit_next + 1)
    if index >= pmark_unit_count : return false
    let unit = pmark_units.data + index * size_of(ptr) * 3
    let adr = @ptrv(unit, ptr, 0)
    let end = adr + @ptrv(unit, uint, 1) * size_of(ptr)
    let from_stack = @ptrv(unit, uint, 2) == pmark_unit_stack
    while adr < end {
        let item = @ptrv(adr, ptr)
        adr = adr + size_of(ptr)
        let data = gcdata(item)
        if from_stack {
            if !data.is_shared() : continue
        } else if !data.is_shared() || data.is_marked() || (!data.is_owned() && data.co_count == 0) {
            continue
        }
        if pmark_claim(item) {
            if data.offset == 0 : continue
            let block = data.block()
            if !isset(block.layout) {
                pmark_local_live += block.isize
                continue
            }
            local.add(item)
        }
    }
    return true
}

// Run by a thread waiting at the safepoint of a shared collection
fn pmark_help() {
    pmark_lock()
    if pmark_active == 0 {
        pmark_unlock()
        return
    }
    atomic(pmark_workers + 1)
    pmark_unlock()
    pmark_drain(pmark_local())
}

fn pmark_drain_ref(ref: ptr, list: *Lifo) $hot $inline {
    @unsafe
    let sub = @ptrv(ref, ?ptr)
    if !isset(sub) : return
    let sub_item: ptr = sub & (~prop_mask).to(uint)
    #if GC_DEBUG
    // What the compiler proved about publication: shared data reaches only shared data
    if !gcdata(sub_item).is_shared() : panic("GC error: shared data refers to an object that is not shared")
    #end
        if pmark_claim(sub_item) {
            let sub_data = gcdata(sub_item)
            if sub_data.offset == 0 : return
            let sub_block = sub_data.block()
            if !isset(sub_block.layout) {
                pmark_local_live += sub_block.isize
                return
            }
            list.add_unchecked(sub_item)
        }
}

fn pmark_drain(local: *Lifo) $hot {
    let live: uint = 0
    pmark_local_live = 0
    let prefetch_on = mem_shared >= 16 * 1024 * 1024
    while true {
        while local.index > 0 {
            if prefetch_on && local.index >= 4 {
                $prefetch((@ptrv(local.data, ptr, local.index - 4) - 8).@cast(ptr))
            }
            let item: GcItem = local.pop_unchecked()
            let data = gcdata(item)
            if data.offset == 0 : continue
            let block = data.block()
            live += block.isize
            let layout = block.layout
            if isset(layout) {
                local.reserve(block.isize / size_of(ptr))
                each_ref(item, layout, local, pmark_drain_ref)
            }
            // Threads wait for work: hand over half
            if local.index >= pmark_share_min && pmark_idle > 0 && pmark_queue.index == 0 {
                pmark_lock()
                let n = local.index / 2
                let queue = pmark_queue
                while n-- > 0 : queue.add(local.pop_unchecked())
                pmark_unlock()
            }
        }

        if pmark_scan_unit(local) : continue
        if pmark_take(local) : continue

        // Nothing here and nothing queued: done once every thread waits
        let total = live + pmark_local_live
        if total > 0 {
            atomic(pmark_live + total)
            live = 0
            pmark_local_live = 0
        }
        atomic(pmark_idle + 1)
        let spins: uint = 0
        while true {
            if pmark_active == 0 {
                atomic(pmark_workers - 1)
                return
            }
            if pmark_queue.index > 0 || pmark_unit_next < pmark_unit_count {
                atomic(pmark_idle - 1)
                break
            }
            if pmark_idle == pmark_workers {
                pmark_lock()
                if pmark_active == 1 && pmark_idle == pmark_workers && pmark_queue.index == 0 && pmark_unit_next >= pmark_unit_count {
                    atomic_store(pmark_active, 0)
                }
                pmark_unlock()
            }
            if spins < 64 {
                $pause()
                spins++
            } else {
                pmark_yield()
            }
        }
    }
}

fn pmark_take(local: *Lifo) bool {
    if pmark_queue.index == 0 : return false
    pmark_lock()
    let queue = pmark_queue
    let n = queue.index
    if n > pmark_take_max : n = pmark_take_max
    let took = n > 0
    while n-- > 0 : local.add(queue.pop_unchecked())
    pmark_unlock()
    return took
}

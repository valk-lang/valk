@unsafe

use mem
use core

@shared unused_blocks: ?*Bump (null)
shared pool_lock: core.SyncMutex (core.SyncMutex.new())

value b_next (0)
value b_slots_total (1)
// The gc of the thread whose allocator owns the block; null once that thread is gone
value b_owner (2)
value b_isize (3)
value b_slots_used (4)
value b_layout (5)
value b_onfree (6)
value b_env_clone (7)
// Slots allocated since the last collection: [alloc_start, alloc_limit)
value b_alloc_start (8)
value b_alloc_limit (9)
// Bits below, and the pool the block belongs to
value b_state (10)
value b_pool (11)

// Listed in the thread's touched blocks: allocated into or freed from since
// the last collection, which settles only those blocks
value bs_touched (1)
// In its pool's reuse queue
value bs_queued (2)
// Counted in its pool's empty queued blocks
value bs_empty (4)
// To be freed by the pool's next prune
value bs_free (8)

/// A pool callback that clones a closure environment allocated from that pool.
type EnvCloneFn (fnptr(ptr)(ptr))

struct Block {
    next: ?ptr
    slots_total: uint
    owner: ?ptr
    // Mini
    isize: uint
    slots_used: uint
    layout: ?ptr
    onfree: ?fnptr(ptr)()
    env_clone: ?EnvCloneFn
    alloc_start: ptr
    alloc_limit: ptr
    state: uint
    pool: ptr
}

struct BlockMini {
    isize: uint
    slots_used: uint
    layout: ?ptr
    onfree: ?fnptr(ptr)()
    env_clone: ?EnvCloneFn
    alloc_start: ptr
    alloc_limit: ptr
    state: uint
    pool: ptr
}

// Lists the block in the thread's touched blocks, once per collection
fn touch_block(block: ptr) $inline {
    @unsafe
    let state = @ptrv(block, uint, b_state)
    if (state & bs_touched) != 0 : return
    @ptrv(block, uint, b_state) = state | bs_touched
    gc.touched_blocks.add_ptr(block)
}

fn loop_all_blocks(func: fnptr(*Block)()) {
    let adr = alc_list.data
    let end = adr + alc_list.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        let block: ?*Block = alc.first
        while isset(block) {
            let next: ?*Block = block.next
            func(block)
            block = next
        }
    }
}

fn add_unused_block(block: *Block) {
    block.next = null
    let list = unused_blocks
    if !isset(list) {
        list = Bump.new(32)
        unused_blocks = list
    }
    list.add_ptr(block)
}

fn free_empty_unused_blocks() {
    pool_lock.lock()
    let list = unused_blocks
    if isset(list) && list.index > 0 {
        let start = list.data
        let end = list.data.$offset(list.index)
        list.reset()
        while start < end {
            let block = @ptrv(start, *Block)
            if block.slots_used == 0 {
                let alloc_size = block.slots_total * block.isize + POOL_DATA_OFFSET
                atomic(mem_usage_shared - alloc_size)
                unregister_block(block)
                mem.free(block)
            } else {
                list.add_ptr(block)
            }
            start = start.$offset(size_of(ptr))
        }
    }
    pool_lock.unlock()
}

//////////////////////////
// Block registry
//////////////////////////

// Pool block address ranges, so a word found on a native stack can be resolved to
// the slot it points into. Each thread keeps its own `local_ranges` for lock-free
// local stack scans; `shared_block_ranges` holds every block of every thread under
// `block_lock` for shared collections. Registering appends and unregistering leaves
// a hole (start == end); the array is sorted and compacted before a lookup
struct BlockRange {
    start: ptr
    end: ptr
    // Owning thread's gc; null once the thread is gone
    gc: ?*Gc
    inv_isize: uint
}

struct BlockRegistry {
    ranges: *Bump
    // Appended since the last sort; a hole keeps the order, so lookups stay binary
    unsorted: bool (false)
    holes: bool (false)
    // The ranges before this index are in order; the appended ones follow
    sorted: uint (0)

    static fn new(initial_cap: uint (64)) *BlockRegistry {
        return mem.new[BlockRegistry](.{
            ranges: Bump.new(initial_cap * size_of(BlockRange))
        })
    }

    fn free() {
        this.ranges.free()
        mem.free(this)
    }

    fn count() uint $inline {
        return this.ranges.index / size_of(BlockRange)
    }

    fn add(block: ptr, alloc_size: uint, owner: ?*Gc, inv_isize: uint) {
        if !this.unsorted {
            this.sorted = this.count()
            this.unsorted = true
        }
        let adr = this.ranges.get(size_of(BlockRange))
        @ptrv(adr, BlockRange) = BlockRange {
            start: block
            end: block + alloc_size
            gc: owner
            inv_isize: inv_isize
        }
    }

    fn remove(block: ptr) {
        // Holes keep the lookup binary; appended blocks need a sort
        if this.unsorted : this.sort()
        let range = this.find(block)
        if isset(range) {
            range.end = range.start
            this.holes = true
        }
    }

    fn release_owner(block: ptr) {
        if this.unsorted : this.sort()
        let range = this.find(block)
        if isset(range) : range.gc = null
    }

    // Drops the holes, sorts the appended ranges on their own and merges them
    // into the sorted ones from the back
    fn sort() {
        @unsafe
        if !this.unsorted && !this.holes : return
        let size = size_of(BlockRange)
        let base = this.ranges.data
        let count = this.count()
        let sorted = this.unsorted ? this.sorted : count
        let kept: uint = 0
        let kept_sorted: uint = 0
        let i: uint = 0
        while i < count {
            let range: *BlockRange = base + i * size
            if range.start != range.end {
                if kept != i : @ptrv(base, BlockRange, kept) = @ptrv(range, BlockRange)
                kept++
                if i < sorted : kept_sorted = kept
            }
            i++
        }
        this.ranges.index = kept * size
        this.holes = false
        if this.unsorted {
            this.unsorted = false
            let tail = kept - kept_sorted
            sort_block_ranges_rec(base + kept_sorted * size, 0, tail)
            if kept_sorted > 0 && tail > 0 {
                let temp = mem.alloc(tail * size)
                mem.copy_bytes(base + kept_sorted * size, temp, tail * size)
                let a = kept_sorted
                let b = tail
                let w = kept
                while b > 0 {
                    w--
                    if a > 0 && @ptrv(base, BlockRange, a - 1).start > @ptrv(temp, BlockRange, b - 1).start {
                        a--
                        @ptrv(base, BlockRange, w) = @ptrv(base, BlockRange, a)
                    } else {
                        b--
                        @ptrv(base, BlockRange, w) = @ptrv(temp, BlockRange, b)
                    }
                }
                mem.free(temp)
            }
        }
        this.sorted = kept
    }

    // A binary search over the sorted ranges, and a linear one over the ones appended since
    fn find(adr: ptr) ?*BlockRange {
        let base = this.ranges.data
        let count = this.count()
        let sorted = this.unsorted ? this.sorted : count
        let lo: uint = 0
        let hi = sorted
        while lo < hi {
            let mid = (lo + hi) / 2
            let range: *BlockRange = base + mid * size_of(BlockRange)
            if adr < range.start : hi = mid
            else if adr >= range.end : lo = mid + 1
            else : return range
        }
        let i = sorted
        while i < count {
            let range: *BlockRange = base + i * size_of(BlockRange)
            if adr >= range.start && adr < range.end : return range
            i++
        }
        return null
    }
}

// Set in blocks_init only: the program assigns global initial values after the main thread's
// gc started, and blocks are registered by then
@shared shared_block_ranges: *BlockRegistry (@undefined)
@shared block_lock: *core.MutexStruct[void] (@undefined)

fn blocks_init() {
    shared_block_ranges = BlockRegistry.new(256)
    block_lock = core.MutexStruct[void].new()
}

fn register_block(block: ptr, alloc_size: uint, slots_total: uint, isize: uint) {
    let inv_isize: uint = slots_total <= 1 ? 0 : ((1.to(uint) << 48) + isize - 1) / isize
    gc.local_ranges.add(block, alloc_size, gc, inv_isize)
    block_lock.lock()
    shared_block_ranges.add(block, alloc_size, gc, inv_isize)
    block_lock.unlock()
}

fn unregister_block(block: ptr) {
    let owner = @ptrv(block, ?*Gc, b_owner)
    if isset(owner) && !owner.did_shutdown {
        owner.local_ranges.remove(block)
    }
    block_lock.lock()
    shared_block_ranges.remove(block)
    block_lock.unlock()
}

fn release_block_owner(block: ptr) {
    block_lock.lock()
    shared_block_ranges.release_owner(block)
    block_lock.unlock()
}

fn sort_block_ranges_rec(base: ptr, lo: uint, hi: uint) {
    while hi - lo > 16 {
        let pivot = @ptrv(base, BlockRange, (lo + hi) / 2).start
        let i = lo
        let j = hi - 1
        while i <= j {
            while @ptrv(base, BlockRange, i).start < pivot : i++
            while @ptrv(base, BlockRange, j).start > pivot : j--
            if i <= j {
                let tmp = @ptrv(base, BlockRange, i)
                @ptrv(base, BlockRange, i) = @ptrv(base, BlockRange, j)
                @ptrv(base, BlockRange, j) = tmp
                i++
                j--
            }
        }
        // Recurse into the smaller half, loop over the larger
        if j + 1 - lo < hi - i {
            sort_block_ranges_rec(base, lo, j + 1)
            lo = i
        } else {
            sort_block_ranges_rec(base, i, hi)
            hi = j + 1
        }
    }
    // Insertion sort for the small ranges
    let i = lo + 1
    while i < hi {
        let v = @ptrv(base, BlockRange, i)
        let j = i
        while j > lo && @ptrv(base, BlockRange, j - 1).start > v.start {
            @ptrv(base, BlockRange, j) = @ptrv(base, BlockRange, j - 1)
            j--
        }
        @ptrv(base, BlockRange, j) = v
        i++
    }
}

#if TEST
/// Test helper: whether the block registry is in order after a sort and finds every block of
/// the calling thread's pools.
+ fn block_registry_ok_for_test() bool {
    let local_reg = gc.local_ranges
    local_reg.sort()
    block_lock.lock()
    shared_block_ranges.sort()
    let ok = true
    let base = shared_block_ranges.ranges.data
    let count = shared_block_ranges.count()
    let i: uint = 1
    while i < count {
        if @ptrv(base, BlockRange, i - 1).start >= @ptrv(base, BlockRange, i).start : ok = false
        i++
    }
    let lbase = local_reg.ranges.data
    let lcount = local_reg.count()
    i = 1
    while i < lcount {
        if @ptrv(lbase, BlockRange, i - 1).start >= @ptrv(lbase, BlockRange, i).start : ok = false
        i++
    }
    let adr = alc_list.data
    let end = adr + alc_list.index
    while adr < end {
        let alc = @ptrv(adr, *Pool)
        adr += size_of(ptr)
        let block = alc.first
        while isset(block) {
            if !isset(shared_block_ranges.find(block)) : ok = false
            if !isset(local_reg.find(block)) : ok = false
            block = @ptrv(block, ?ptr, b_next)
        }
    }
    block_lock.unlock()
    return ok
}
#end

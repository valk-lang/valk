@unsafe

// GC layouts. The compiler emits one constant per allocation type listing
// the byte offsets of every managed pointer (allocator_layout_words):
//   [kind, data offset, stride, N, G, N offsets, G groups]
//   group: [C, C x (tag offset, tag), M, M offsets]
// Kind 0 is one object. Kind 1 is a sequence: the first word of the
// allocation is the element count, elements start at `data offset` and are
// `stride` bytes each. A group's offsets hold managed pointers only while
// every tag byte matches: the active member of a union.

value layout_kind (0)
value layout_data_offset (1)
value layout_stride (2)
value layout_plain_count (3)
value layout_group_count (4)
value layout_header (5)
// Grove-MT: bit 2 of an offset marks a fat value's owner word, whose data word follows
value layout_fat (4)

// The byte offset of a layout word
fn layout_offset(word: uint) uint $inline {
    #if GROVE_MT
    return word & (~7).to(uint)
    #else
    return word
    #end
}

// Calls `cb` with the address of every managed pointer slot of `item` that is
// not null. Inlined so that a known callback is called directly
fn each_ref(item: ptr, layout: ptr, list: *Lifo, cb: fnptr(ptr, *Lifo)()) $inline {
    @unsafe
    if @ptrv(layout, uint, layout_kind) == 0 {
        each_field_ref(item, layout, list, cb)
        return
    }
    let length = @ptrv(item, uint)
    let stride = @ptrv(layout, uint, layout_stride)
    let base: ptr = item + @ptrv(layout, uint, layout_data_offset)
    let end: ptr = base + length * stride
    let plain = @ptrv(layout, uint, layout_plain_count)
    let groups = @ptrv(layout, uint, layout_group_count)
    if plain == 1 && groups == 0 && stride == size_of(ptr) && @ptrv(layout, uint, layout_header) == 0 {
        // A sequence of bare pointers
        while base < end {
            let v = @ptrv(base, ?ptr)
            if isset(v) : cb(base, list)
            base += size_of(ptr)
        }
        return
    }
    while base < end {
        each_field_ref(base, layout, list, cb)
        base += stride
    }
}

// Work items (K-21): the collector visits a sequence in chunks of at most this many bytes of
// elements, so its mark and walk stacks stay O(256 words x depth)
value work_bytes (256 * 8)

// Calls `cb` like each_ref for one work item: every word of an object, or the elements of a
// sequence from element `from` on, at most work_bytes of them. When elements remain, the rest
// is pushed first as two words, the next element and `item | 1`. Reserves room for the pushes
fn each_ref_work(item: ptr, layout: ptr, isize: uint, from: uint, list: *Lifo, cb: fnptr(ptr, *Lifo)()) $inline {
    @unsafe
    if @ptrv(layout, uint, layout_kind) == 0 {
        list.reserve(layout_words(layout))
        each_field_ref(item, layout, list, cb)
        return
    }
    let length = @ptrv(item, uint)
    let stride = @ptrv(layout, uint, layout_stride)
    let per = stride == 0 ? length : work_bytes / stride
    if per == 0 : per = 1
    let to = from + per
    if to < length {
        list.reserve(per * stride / size_of(ptr) + 2)
        list.add_unchecked(to.@cast(ptr))
        list.add_unchecked(item + 1)
    } else {
        to = length
        list.reserve((to - from) * stride / size_of(ptr))
    }
    let base: ptr = item + @ptrv(layout, uint, layout_data_offset) + from * stride
    let end: ptr = item + @ptrv(layout, uint, layout_data_offset) + to * stride
    let plain = @ptrv(layout, uint, layout_plain_count)
    let groups = @ptrv(layout, uint, layout_group_count)
    if plain == 1 && groups == 0 && stride == size_of(ptr) && @ptrv(layout, uint, layout_header) == 0 {
        // A sequence of bare pointers
        while base < end {
            let v = @ptrv(base, ?ptr)
            if isset(v) : cb(base, list)
            base += size_of(ptr)
        }
        return
    }
    while base < end {
        each_field_ref(base, layout, list, cb)
        base += stride
    }
}

// The reference words a layout lists for one object or element, at most
fn layout_words(layout: ptr) uint {
    @unsafe
    let n = @ptrv(layout, uint, layout_plain_count)
    let groups = @ptrv(layout, uint, layout_group_count)
    let word: ptr = layout + (layout_header + n) * size_of(ptr)
    while groups > 0 {
        groups--
        word += (1 + @ptrv(word, uint) * 2) * size_of(ptr)
        let count = @ptrv(word, uint)
        n += count
        word += (1 + count) * size_of(ptr)
    }
    return n
}

fn each_field_ref(base: ptr, layout: ptr, list: *Lifo, cb: fnptr(ptr, *Lifo)()) $inline {
    @unsafe
    let plain = @ptrv(layout, uint, layout_plain_count)
    let groups = @ptrv(layout, uint, layout_group_count)
    let word: ptr = layout + layout_header * size_of(ptr)
    let end: ptr = word + plain * size_of(ptr)
    while word < end {
        let slot: ptr = base + layout_offset(@ptrv(word, uint))
        let v = @ptrv(slot, ?ptr)
        if isset(v) : cb(slot, list)
        word += size_of(ptr)
    }
    while groups > 0 {
        groups--
        let conditions = @ptrv(word, uint)
        word += size_of(ptr)
        let active = true
        while conditions > 0 {
            conditions--
            let tag_offset = @ptrv(word, uint)
            let tag = @ptrv(word, uint, 1)
            word += size_of(ptr) * 2
            if @ptrv(base + tag_offset, u8).to(uint) != tag : active = false
        }
        let count = @ptrv(word, uint)
        word += size_of(ptr)
        let group_end: ptr = word + count * size_of(ptr)
        if active {
            while word < group_end {
                let slot: ptr = base + layout_offset(@ptrv(word, uint))
                let v = @ptrv(slot, ?ptr)
                if isset(v) : cb(slot, list)
                word += size_of(ptr)
            }
        }
        word = group_end
    }
}

// Calls `cb` like each_ref, for the slots that lie in [lo, hi) only. A sequence starts at
// the element that holds `lo`; tags are read wherever they lie
fn each_ref_in(item: ptr, layout: ptr, lo: ptr, hi: ptr, list: *Lifo, cb: fnptr(ptr, *Lifo)()) $inline {
    @unsafe
    if @ptrv(layout, uint, layout_kind) == 0 {
        each_field_ref_in(item, layout, lo, hi, list, cb)
        return
    }
    let stride = @ptrv(layout, uint, layout_stride)
    let base: ptr = item + @ptrv(layout, uint, layout_data_offset)
    let end: ptr = base + @ptrv(item, uint) * stride
    if end > hi : end = hi
    if lo > base : base += (lo - base) / stride * stride
    while base < end {
        each_field_ref_in(base, layout, lo, hi, list, cb)
        base += stride
    }
}

fn each_field_ref_in(base: ptr, layout: ptr, lo: ptr, hi: ptr, list: *Lifo, cb: fnptr(ptr, *Lifo)()) $inline {
    @unsafe
    let plain = @ptrv(layout, uint, layout_plain_count)
    let groups = @ptrv(layout, uint, layout_group_count)
    let word: ptr = layout + layout_header * size_of(ptr)
    let end: ptr = word + plain * size_of(ptr)
    while word < end {
        let slot: ptr = base + layout_offset(@ptrv(word, uint))
        if slot >= lo && slot < hi {
            let v = @ptrv(slot, ?ptr)
            if isset(v) : cb(slot, list)
        }
        word += size_of(ptr)
    }
    while groups > 0 {
        groups--
        let conditions = @ptrv(word, uint)
        word += size_of(ptr)
        let active = true
        while conditions > 0 {
            conditions--
            let tag_offset = @ptrv(word, uint)
            let tag = @ptrv(word, uint, 1)
            word += size_of(ptr) * 2
            if @ptrv(base + tag_offset, u8).to(uint) != tag : active = false
        }
        let count = @ptrv(word, uint)
        word += size_of(ptr)
        let group_end: ptr = word + count * size_of(ptr)
        if active {
            while word < group_end {
                let slot: ptr = base + layout_offset(@ptrv(word, uint))
                if slot >= lo && slot < hi {
                    let v = @ptrv(slot, ?ptr)
                    if isset(v) : cb(slot, list)
                }
                word += size_of(ptr)
            }
        }
        word = group_end
    }
}


fn property_update(on_object: ptr, property_ref: ptr, new_value: ?ptr) {
    let data: *GcData = on_object.$offset(-8)
    let on_col = data.color
    if on_col > 0 {
        if on_col == color_shared : share_null_check(new_value)
        else {
            let old = @ptrv(property_ref, ?GcItem)
            if isset(old) {
                let odata = old.data()
                let color = odata.get_color()
                if odata.is_root() && color.parent == on_object {
                    color.remove_parent()
                    gc.disconnect_list.add(old)
                } else if odata.color == data.color {
                    color.remove_parent()
                    color.cracked = true
                    gc.disconnect_list.add(old)
                }
            }
            //
            let flags = data.flags
            let on_color = data.get_color()
            if (on_color.valid && (flags & (flag_in_updates)) == 0) {
                queue_chain(on_object, gc.chain)
            }
        }
    }
    @ptrv(property_ref, ?ptr) = new_value
}

fn property_set(on_object: ptr, property_ref: ptr, value: ?ptr) {
    if isset(value) {
        let data: *GcData = on_object.$offset(-8)
        let flags = data.flags
        let on_color = data.get_color()

        if data.color == color_shared {
            share(value)
        } else if (on_color.valid && (flags & (flag_in_updates)) == 0) {
            queue_chain(on_object, gc.chain)
        }
    }
    @ptrv(property_ref, ?ptr) = value
}

// fn property_get(property_ref: ptr) ptr {
//     return @ptrv(property_ref, ptr) & -4.to(uint)
// }

fn property_remove(on_object: ptr, property_ref: ptr) {
    let data: *GcData = on_object.$offset(-8)
    let on_col = data.color
    if on_col > 0 {
        let old = @ptrv(property_ref, ?GcItem)
        if isset(old) {
            let odata = old.data()
            let color = odata.get_color()
            if odata.is_root() && color.parent == on_object {
                color.remove_parent()
                gc.disconnect_list.add(old)
            } else if odata.color == data.color {
                color.remove_parent()
                color.cracked = true
                gc.disconnect_list.add(old)
            }
        }
    }
}

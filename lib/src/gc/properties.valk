@unsafe

fn property_update_slow(on_object: ptr, property_ref: ptr, new_value: ?ptr, flags: u8, old: ptr) {
    if (flags & flag_shared) == flag_shared {
        share_null_check(new_value)
    } else {
        if old & prop_mask > 0 : gc.props_removed.add(old)
        if (flags & (flag_owned | flag_in_updates)) == flag_owned {
            let data: *GcData = on_object.$offset(-8)
            data.set_in_updates()
            gc.updated_list.add_ptr(on_object)
        }
    }
    @ptrv(property_ref, ?ptr) = new_value
}

fn property_update(on_object: ptr, property_ref: ptr, new_value: ?ptr) $inline {
    let flags = gcdata(on_object).flags
    if (flags & flag_own_state) != 0 {
        let old = @ptrv(property_ref, ptr)
        if (flags & flag_shared) == flag_shared || old & prop_mask > 0
            || (flags & (flag_owned | flag_in_updates)) == flag_owned {
                property_update_slow(on_object, property_ref, new_value, flags, old)
                return
            }
    }
    @ptrv(property_ref, ?ptr) = new_value
}

fn property_set_slow(on_object: ptr, property_ref: ptr, value: ptr, flags: u8) {
    if (flags & flag_shared) == flag_shared {
        share(value)
    } else {
        let data: *GcData = on_object.$offset(-8)
        data.set_in_updates()
        gc.updated_list.add_ptr(on_object)
    }
    @ptrv(property_ref, ?ptr) = value
}

fn property_set(on_object: ptr, property_ref: ptr, value: ?ptr) $inline {
    if isset(value) {
        let flags = gcdata(on_object).flags
        if (flags & flag_shared) == flag_shared
            || (flags & (flag_owned | flag_in_updates)) == flag_owned {
                property_set_slow(on_object, property_ref, value, flags)
                return
            }
    }
    @ptrv(property_ref, ?ptr) = value
}

fn property_get(property_ref: ptr) ptr {
    return @ptrv(property_ref, ptr) & (~prop_mask).to(uint)
}

fn property_remove_slow(value: ptr) {
    gc.props_removed.add(value)
}

fn property_remove(on_object: ptr, property_ref: ptr) $inline {
    let value = @ptrv(property_ref, ptr)
    if value & prop_mask > 0 : property_remove_slow(value)
}

use mem

// The barrier reads no holder. B1: a store over a counted old word takes the removal slow
// path B2; any other store is plain, then the card of a stored reference is tested: a clean
// card is set and logged once per collection (B5), then the log's cap is tested (B6). Card
// bytes and the card log are read by the next collection (Gc.loop_cards)

// B2
fn store_slow(property_ref: ptr, new_value: ?ptr, old: ptr) {
    @unsafe
    // The same value: the counted word keeps its tag
    if old & (~prop_mask).to(uint) == new_value : return
    #if GC_DEBUG
    slow_path_check(property_ref, old)
    #end
    gc.props_removed.add(old)
    @ptrv(property_ref, ?ptr) = new_value
    // The card before the cap test: a collection there must see the stored value
    if isset(new_value) && @ptrv(card_of(property_ref), u8) == 0 : card_log_add(property_ref)
    log_cap_test()
    #if GROVE_MT
    // The end of a barrier slow path joins a requested round (RT8)
    join_if_requested()
    #end
}

fn property_update(on_object: ptr, property_ref: ptr, new_value: ?ptr) $inline {
    @unsafe
    #if GROVE_MT
    // C5: a store into S runs no barrier
    if !in_heap(property_ref) {
        s_store(property_ref, new_value)
        return
    }
    #end
    let old = @ptrv(property_ref, ptr)
    if old & prop_mask > 0 {
        store_slow(property_ref, new_value, old)
        return
    }
    @ptrv(property_ref, ?ptr) = new_value
    if isset(new_value) && @ptrv(card_of(property_ref), u8) == 0 : card_slow(property_ref)
}

// The set walk of a union or aggregate store (B4): the word holds the new value already,
// stripped by the caller. A card test without a cap test: the store's caller tests the cap
// once after its last word (cap_test)
fn property_set(on_object: ptr, property_ref: ptr, value: ?ptr) $inline {
    @unsafe
    #if GROVE_MT
    if !in_heap(property_ref) {
        s_store(property_ref, value)
        return
    }
    #end
    @ptrv(property_ref, ?ptr) = value
    if isset(value) && @ptrv(card_of(property_ref), u8) == 0 : card_log_add(property_ref)
}

// property_set for a fat value's owner word: its data word moves with the owner's copy
fn property_set_fat(on_object: ptr, property_ref: ptr, value: ?ptr) $inline {
    @unsafe
    #if GROVE_MT
    if !in_heap(property_ref) {
        @ptrv(property_ref, ?ptr) = value
        publish_fat(property_ref)
        return
    }
    #end
    property_set(on_object, property_ref, value)
}

fn property_get(property_ref: ptr) ptr {
    return @ptrv(property_ref, ptr) & (~prop_mask).to(uint)
}

fn property_remove_slow(value: ptr) {
    @unsafe
    gc.props_removed.add(value)
}

// The remove walk of a union or aggregate store (B4): records a counted word, writes nothing
fn property_remove(on_object: ptr, property_ref: ptr) $inline {
    @unsafe
    let value = @ptrv(property_ref, ptr)
    if value & prop_mask > 0 : property_remove_slow(value)
}

// R1 for one reference word: records it when it is counted and writes 0. The caller tests
// the cap once after the slot's last word (cap_test)
fn property_release(on_object: ptr, property_ref: ptr) $inline {
    @unsafe
    let value = @ptrv(property_ref, ptr)
    if value & prop_mask > 0 : property_remove_slow(value)
    @ptrv(property_ref, uint) = 0
}

fn card_slow(property_ref: ptr) {
    @unsafe
    card_log_add(property_ref)
    log_cap_test()
    #if GROVE_MT
    join_if_requested()
    #end
}

// B5: the card becomes dirty and its first address goes into the card log
fn card_log_add(property_ref: ptr) {
    @unsafe
    let card = card_of(property_ref)
    #if GC_DEBUG
    if !in_heap(property_ref) : panic("GC error: a card test outside the heap")
    if @ptrv(card, u8) != 0 : panic("GC error: a dirty card is logged again")
    #end
    @ptrv(card, u8) = 1
    gc.card_log.add_ptr(property_ref & (~(CARD_SIZE - 1)).to(uint))
}

// B6, after an operation's last write: pending at the soft cap, at once at the hard cap
fn log_cap_test() $inline {
    if log_full : log_trigger()
}

// B6 for the compiler's stores and the library's move sites
fn cap_test() $inline {
    log_cap_test()
}

// Cards one moved_elements call logs before it logs its storage as a range instead
value range_switch (64)

// R4. Raw writes moved elements `first` to `first + count` of the sequence `item`
// into place (see Array): the card of each moved reference that a collection has not
// counted yet must be dirty and covered by the log. After 64 logged cards the storage is
// logged as a range, which covers each of its dirty cards, and cards are only set.
// No cap test: the caller's operation tests it
fn moved_elements(item: ptr, first: uint, count: uint) $inline $gc_primitive {
    @unsafe
    if count == 0 : return
    #if GROVE_MT
    // S2: S storage has no cards
    if !in_heap(item) : return
    #end
    let layout = desc_of(item).layout ?! return
    let stride = @ptrv(layout, uint, layout_stride)
    let adr: ptr = item + @ptrv(layout, uint, layout_data_offset) + first * stride
    let end = adr + count * stride
    // Fast path: every card of the moved elements is dirty already. The loop makes no call,
    // so it never polls
    let card = card_of(adr)
    let last = card_of(end - 1)
    while card <= last && @ptrv(card, u8) != 0 : card += 1
    if card <= last : moved_elements_log(layout, adr, end, item)
}

fn moved_elements_log(layout: ptr, adr: ptr, end: ptr, item: ptr) $noinline $gc_primitive {
    @unsafe
    let stride = @ptrv(layout, uint, layout_stride)
    let g = gc
    g.r4_storage = item.@cast(uint)
    g.r4_cards = 0
    while adr < end {
        each_field_ref(adr, layout, g.mark_list, fn(ref: ptr, list: *Lifo) {
            @unsafe
            // A tagged reference was counted already and keeps its tag
            if @ptrv(ref, uint) & prop_mask != 0 : return
            let card = card_of(ref)
            if @ptrv(card, u8) != 0 : return
            let r = gc
            if r.r4_cards == range_switch {
                @ptrv(card, u8) = 1
                return
            }
            card_log_add(ref)
            r.r4_cards++
            if r.r4_cards == range_switch : r.card_log.add_ptr((r.r4_storage | 1).@cast(ptr))
        })
        adr += stride
    }
}

// R3. Moves `count` elements of the sequence `item` from index `src` to index `dst`. First
// the counted words of the destination elements that are no source elements are recorded
// (a right shift past the length may overwrite a word a view stored there); then the move,
// R4 over the destinations, zero bytes over the vacated elements (R2) and one cap test.
// Nothing in between can collect
fn gc_move(item: ptr, dst: uint, src: uint, count: uint) $gc_primitive {
    @unsafe
    if count == 0 || dst == src : return
    #if GROVE_MT
    // S2: in S a move is a memmove, and the vacated elements become zero
    if !in_heap(item) {
        s_move(item, dst, src, count)
        return
    }
    #end
    let layout = desc_of(item).layout ?! panic("gc_move: the storage has no reference layout")
    let stride = @ptrv(layout, uint, layout_stride)
    let base: ptr = item + @ptrv(layout, uint, layout_data_offset)
    let g = gc
    // Destinations that are no sources
    let lo = dst
    let hi = dst + count
    if dst > src && dst < src + count : lo = src + count
    if dst < src && hi > src : hi = src
    let adr = base + lo * stride
    while lo < hi {
        each_field_ref(adr, layout, g.mark_list, fn(ref: ptr, list: *Lifo) {
            @unsafe
            let v = @ptrv(ref, uint)
            if v & prop_mask != 0 : gc.props_removed.add(v.@cast(ptr))
        })
        adr += stride
        lo++
    }
    mem.move_bytes(base + src * stride, base + dst * stride, count * stride)
    moved_elements(item, dst, count)
    // Sources that are no destinations
    let v_lo = src
    let v_hi = src + count
    if dst > src && dst < v_hi : v_hi = dst
    if dst < src && dst + count > src : v_lo = dst + count
    mem.clear_bytes(base + v_lo * stride, (v_hi - v_lo) * stride)
    log_cap_test()
}

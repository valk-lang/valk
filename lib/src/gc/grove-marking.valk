#if GROVE

use mem

// Marking and dis-owning walk the graph through the mark list. Two forms: the direct one
// touches an object's shadow byte when its slot is reached and pushes the object; the window
// form pushes the slot address, prefetches the object and its shadow byte when the entry
// leaves the list and processes it mark_window entries later, so the cache misses of several
// objects overlap. The window costs instructions, so it is only used when the last
// dis-own ran at cache-miss speed (Gc.mark_window_on)
value mark_window (8)
// Nanoseconds per dis-owned object above which the window is used
value mark_window_ns (16)

fn mark_used(item: ?GcItem) $hot {
    @unsafe
    if gc.mark_window_on : mark_used_window(item)
    else : mark_used_direct(item)
}

fn mark_used_direct(item: ?GcItem) $hot {
    @unsafe
    let ml = gc.mark_list
    if isset(item) {
        let data = gcdata(item)
        let is_new = data.is_new()

        #if GC_DEBUG
        if data.is_still_co_owned() : panic("double ownership")
        #end

        data.own()
        if is_new {
            let block = desc_of(item)
            block.slots_used++
            gc.mem_marked += block.isize
        }
        ml.add(item)
    }

    // Only objects in the heap are marked
    while ml.index > 0 {
        let item = ml.pop_unchecked()
        let block = desc_of(item)
        let layout = block.layout
        if isset(layout) {
            // Room for every word of the object, so the pushes need no capacity check
            ml.reserve(block.isize / size_of(ptr))
            each_ref(item, layout, ml, mark_used_props_direct)
        }
    }
}

fn mark_used_props_direct(ref: ptr, list: *Lifo) $hot $inline {
    @unsafe
    let sub = @ptrv(ref, ?ptr)
    if !isset(sub) : return
    // Objects outside the heap (static strings) have no state and are never tagged
    if sub & prop_mask == 0 && in_heap(sub) {
        let sub_data = gcdata(sub)
        if sub_data.is_not_owned() {
            @ptrv(ref, ptr) = sub | prop_owned
            let is_new = sub_data.is_new()
            sub_data.own()
            if is_new {
                let sub_block = desc_of(sub)
                sub_block.slots_used++
                gc.mem_marked += sub_block.isize
            }
            list.add_unchecked(sub)
        } else {
            @ptrv(ref, ptr) = sub | prop_co_owned
            sub_data.co_own()
        }
    }
}

fn mark_used_window(item: ?GcItem) $hot {
    @unsafe
    let g = gc
    let ml = g.mark_list
    let marked_bytes: uint = 0
    if isset(item) {
        let data = gcdata(item)
        #if GC_DEBUG
        if data.is_still_co_owned() : panic("double ownership")
        #end
        let is_new = data.is_new()
        data.own()
        let block = desc_of(item)
        if is_new {
            block.slots_used++
            marked_bytes += block.isize
        }
        let layout = block.layout
        if isset(layout) {
            ml.reserve(block.isize / size_of(ptr))
            each_ref(item, layout, ml, mark_push_ref)
        }
    }

    // Slots leave the list through a window of mark_window entries: an entry's shadow byte and
    // object are prefetched when it enters and touched when it leaves. One in, one out, so the
    // branches stay predictable
    let window: [ptr x mark_window] = @undefined
    let head: uint = 0
    let count: uint = 0
    let fill: uint = g.mark_window_on ? mark_window - 1 : 0
    while true {
        let ref: ptr = null_ptr()
        if ml.index > 0 {
            let entered = ml.pop_unchecked()
            let target = @ptrv(entered, uint) & (~prop_mask).to(uint)
            $prefetch((target >> 3).@cast(ptr))
            $prefetch(target.@cast(ptr))
            window[(head + count) & (mark_window - 1)] = entered
            if count < fill {
                count++
                continue
            }
        } else {
            if count == 0 : break
            count--
        }
        ref = window[head]
        head = (head + 1) & (mark_window - 1)

        let sub = @ptrv(ref, ?ptr)
        // A slot logged twice was processed already
        if !isset(sub) || sub & prop_mask != 0 || !in_heap(sub) : continue
        let sub_data = gcdata(sub)
        if sub_data.is_not_owned() {
            @ptrv(ref, ptr) = sub | prop_owned
            let is_new = sub_data.is_new()
            sub_data.own()
            let block = desc_of(sub)
            if is_new {
                block.slots_used++
                marked_bytes += block.isize
            }
            let layout = block.layout
            if isset(layout) {
                ml.reserve(block.isize / size_of(ptr))
                each_ref(sub, layout, ml, mark_push_ref)
            }
        } else {
            @ptrv(ref, ptr) = sub | prop_co_owned
            sub_data.co_own()
        }
    }
    g.mem_marked += marked_bytes
}

// Queues a slot that holds an untagged reference; mark_used_window decides between owning and
// co-owning when it reaches the slot
fn mark_push_ref(ref: ptr, list: *Lifo) $hot $inline {
    @unsafe
    let sub = @ptrv(ref, ?ptr)
    if !isset(sub) || sub & prop_mask != 0 || !in_heap(sub) : return
    list.add_unchecked(ref)
}

// An updated object hands ownership to the fields it received since the
// last collection; drained by mark_used(null)
fn update_props(ref: ptr, list: *Lifo) $hot $inline {
    @unsafe
    // No reserve precedes these pushes
    list.reserve(1)
    if gc.mark_window_on : mark_push_ref(ref, list)
    else : mark_used_props_direct(ref, list)
}

fn free_blank(item: ptr) $hot {
    @unsafe
    let data = gcdata(item)
    if data.is_not_new() : return

    // Call gc_free
    let onfree = desc_of(item).onfree
    if isset(onfree) : onfree(item)

    #if GC_DEBUG
    if data.has_co() : panic("co_count not 0 before free")
    if data.bits != 0 {
        print("Shadow: ")
        data.bits.print(10)
        print("\n")
        panic("GC error: shadow not 0 before free")
    }
    #end
}

fn preserve_stack_owner(item: GcItem) {
    @unsafe
    gcdata(item).set_owned()
    gc.prev_stack_items.add_ptr(item)
}

fn should_dis_own(item: GcItem) bool $inline {
    @unsafe
    if !in_heap(item) : return false
    let data = gcdata(item)

    #if GC_DEBUG
    if data.is_new() : panic("double ownership removal")
    if data.is_still_co_owned() : panic("unexpected ownership removal")
    #end

    if data.is_on_stack() {
        preserve_stack_owner(item)
        return false
    }

    return true
}

fn queue_dis_owned(item: GcItem, list: *Lifo) $inline {
    @unsafe
    if should_dis_own(item) : list.add_unchecked(item)
}

fn dis_own_rec(item: ptr) (uint, uint) {
    @unsafe
    if !should_dis_own(item) : return (0, 0)
    return dis_own_loop(item)
}

fn dis_own_loop(item: ptr) (uint, uint) {
    @unsafe
    if gc.mark_window_on : return dis_own_loop_window(item)
    return dis_own_loop_direct(item)
}

fn dis_own_loop_direct(item: ptr) (uint, uint) {
    @unsafe
    let ml = gc.mark_list
    let disowned: uint = 0
    let unmarked_bytes: uint = 0

    while true {
        let data = gcdata(item)
        let block = desc_of(item)

        disowned++
        data.set_new()
        if data.has_co_in(block.isize) : gc.re_own_list.add_ptr(item)

        block.slots_used--
        unmarked_bytes += block.isize
        touch_block(block)

        let onfree = block.onfree
        if isset(onfree) : gc.blanks.add_ptr(item)

        let layout = block.layout
        if isset(layout) {
            ml.reserve(block.isize / size_of(ptr))
            each_ref(item, layout, ml, dis_own_props_direct)
        }

        if ml.index == 0 : break
        item = ml.pop_unchecked()
    }
    return (disowned, unmarked_bytes)
}

fn dis_own_loop_window(item: ptr) (uint, uint) {
    @unsafe
    let g = gc
    let ml = g.mark_list
    let disowned: uint = 1
    let unmarked_bytes = dis_own_item(item, ml)

    // Slots leave the list through a window of mark_window entries: an entry's shadow byte and
    // object are prefetched when it enters and touched when it leaves. One in, one out, so the
    // branches stay predictable
    let window: [ptr x mark_window] = @undefined
    let head: uint = 0
    let count: uint = 0
    let fill: uint = g.mark_window_on ? mark_window - 1 : 0
    while true {
        let ref: ptr = null_ptr()
        if ml.index > 0 {
            let entered = ml.pop_unchecked()
            let target = @ptrv(entered, uint) & (~prop_mask).to(uint)
            $prefetch((target >> 3).@cast(ptr))
            $prefetch(target.@cast(ptr))
            window[(head + count) & (mark_window - 1)] = entered
            if count < fill {
                count++
                continue
            }
        } else {
            if count == 0 : break
            count--
        }
        ref = window[head]
        head = (head + 1) & (mark_window - 1)

        let dead = dis_own_ref(ref) ?! continue
        disowned++
        unmarked_bytes += dis_own_item(dead, ml)
    }
    return (disowned, unmarked_bytes)
}

// Frees the slot of a dead item and queues the tagged slots it holds; returns its bytes
fn dis_own_item(item: ptr, ml: *Lifo) uint $hot $inline {
    @unsafe
    let data = gcdata(item)
    let block = desc_of(item)
    data.set_new()
    if data.has_co_in(block.isize) : gc.re_own_list.add_ptr(item)

    block.slots_used--
    touch_block(block)

    let onfree = block.onfree
    if isset(onfree) : gc.blanks.add_ptr(item)

    let layout = block.layout
    if isset(layout) {
        ml.reserve(block.isize / size_of(ptr))
        each_ref(item, layout, ml, dis_own_push_ref)
    }
    return block.isize
}

// Releases the ownership a dead item's slot held; returns the item that dies with it
fn dis_own_ref(ref: ptr) ?ptr $hot $inline {
    @unsafe
    let sub = @ptrv(ref, ptr)
    if sub & prop_owned == prop_owned {
        let sub_item = sub - prop_owned
        #if GC_DEBUG
        if sub_item == null : panic("GC error: 'owned' property slot is not a tagged pointer; its memory was reused")
        #end
        @ptrv(ref, ptr) = sub_item
        gcdata(sub_item).set_no_owner()
        if !should_dis_own(sub_item) : return null
        return sub_item
    }
    if sub & prop_co_owned == prop_co_owned {
        let sub_item = sub - prop_co_owned
        #if GC_DEBUG
        if sub_item == null : panic("GC error: 'co-owned' property slot is not a tagged pointer; its memory was reused")
        #end
        @ptrv(ref, ptr) = sub_item
        let sub_data = gcdata(sub_item)
        sub_data.co_unown()
        if sub_data.is_still_co_owned() {
            sub_data.remove_still_co_owned()
            // Lets pretend we were the owner
            if should_dis_own(sub_item) : return sub_item
        }
    }
    return null
}

// The growth of a sequence's storage (THEORY 5.5.9): `data_ref` is the container's storage
// word, whose storage holds `count` elements; the new storage has room for `size`. It is
// allocated first, the last point that can collect before the storage word is read. When
// the container owns its storage, the new storage is claimed at once: the counted words move
// to it with their tags, the old storage keeps plain words and is recorded as removed, and
// every card of the new storage is dirty and covered by one range entry. Otherwise the
// elements are copied stripped and the storage word is stored through the barrier
fn gc_grow(data_ref: ptr, count: uint, size: uint) {
    @unsafe
    let first: ptr = (@ptrv(data_ref, uint) & (~prop_mask).to(uint)).@cast(ptr)
    let layout = desc_of(first).layout ?! panic("gc_grow: the storage has no reference layout")
    let stride = @ptrv(layout, uint, layout_stride)
    let offset = @ptrv(layout, uint, layout_data_offset)
    let bytes = offset + size * stride
    let pool = get_typed_pool(bytes, layout)
    let to = pool.large ? pool.get_large(bytes) : pool.get()
    let zeroed = pool.zeroed
    let w = @ptrv(data_ref, uint)
    let from: ptr = (w & (~prop_mask).to(uint)).@cast(ptr)
    let g = gc
    @ptrv(to, uint) = size
    let src = from + offset
    let dst = to + offset
    if w & prop_mask == prop_owned {
        mem.copy_bytes(src, dst, count * stride)
        let adr = src
        let end = src + count * stride
        while adr < end {
            each_field_ref(adr, layout, g.mark_list, fn(ref: ptr, list: *Lifo) {
                @unsafe
                @ptrv(ref, uint) = @ptrv(ref, uint) & (~prop_mask).to(uint)
            })
            adr += stride
        }
        if !zeroed : mem.clear_bytes(dst + count * stride, (size - count) * stride)
        let desc = desc_of(to)
        gcdata(to).own()
        desc.slots_used++
        g.mem_marked += desc.isize
        @ptrv(data_ref, uint) = to | prop_owned
        g.props_removed.add(from | prop_owned)
        #if GC_DEBUG
        g.growth_sources.add_ptr(from)
        #end
        cards_set(to, to + desc.isize)
        g.card_log.add_ptr(to + 1)
    } else {
        copy_strip(src, dst, count, to)
        if !zeroed : mem.clear_bytes(dst + count * stride, (size - count) * stride)
        property_update(data_ref, data_ref, to)
    }
    log_cap_test()
}

/// Copies `count` elements from `from` to `to` with the ownership tags of their references
/// removed, so the copy owns nothing until a collection walks it.
///
/// Both point at elements of sequences laid out like `storage`, the GC allocation that
/// holds `to`. Used to fill fresh storage from elements another storage owns.
+ fn copy_strip(from: ptr, to: ptr, count: uint, storage: ptr) {
    @unsafe
    if count == 0 : return
    #if GC_DEBUG
    // R5 writes only into new storage
    if gcdata(storage).is_not_new() : panic("GC error: copy_strip into an old storage")
    #end
    let layout = desc_of(storage).layout ?! panic("copy_strip: the storage has no reference layout")
    let stride = @ptrv(layout, uint, layout_stride)
    mem.copy_bytes(from, to, count * stride)
    let adr = to
    let end = to + count * stride
    while adr < end {
        each_field_ref(adr, layout, gc.mark_list, fn(ref: ptr, list: *Lifo) {
            @unsafe
            @ptrv(ref, uint) = @ptrv(ref, uint) & (~prop_mask).to(uint)
        })
        adr += stride
    }
}

fn dis_own_props_direct(ref: ptr, list: *Lifo) $hot $inline {
    @unsafe
    let sub = @ptrv(ref, ?ptr)
    if !isset(sub) : return
    if sub & prop_owned == prop_owned {
        let sub_item = sub - prop_owned
        #if GC_DEBUG
        if sub_item == null : panic("GC error: 'owned' property slot is not a tagged pointer; its memory was reused")
        #end
        @ptrv(ref, ptr) = sub_item
        gcdata(sub_item).set_no_owner()
        queue_dis_owned(sub_item, list)
    } else if sub & prop_co_owned == prop_co_owned {
        let sub_item = sub - prop_co_owned
        #if GC_DEBUG
        if sub_item == null : panic("GC error: 'co-owned' property slot is not a tagged pointer; its memory was reused")
        #end
        @ptrv(ref, ptr) = sub_item
        let sub_data = gcdata(sub_item)
        sub_data.co_unown()
        if sub_data.is_still_co_owned() {
            sub_data.remove_still_co_owned()
            // Lets pretend we were the owner
            queue_dis_owned(sub_item, list)
        }
    }
}

// Queues a slot of a dead item that carries an ownership tag
fn dis_own_push_ref(ref: ptr, list: *Lifo) $hot $inline {
    @unsafe
    if @ptrv(ref, uint) & prop_mask != 0 : list.add_unchecked(ref)
}

// Single-threaded: nothing is ever shared, and shared globals are ordinary roots
fn share_null_check(item: ?ptr) $inline {
}

fn share(item: GcItem) $inline {
}

fn mark_leak_rec(item: GcItem, on: bool) {
    @unsafe
    let ml = gc.mark_list
    ml.add(item)

    while ml.index > 0 {
        let item: GcItem = ml.pop_unchecked()
        // Objects outside the heap (static strings) hold no references
        if !in_heap(item) : continue
        let data = gcdata(item)
        if on {
            if data.has_leak_mark() : continue
            data.set_leak_mark()
        } else {
            if !data.has_leak_mark() : continue
            data.remove_leak_mark()
        }

        let layout = desc_of(item).layout
        if isset(layout) {
            each_ref(item, layout, ml, fn(ref: ptr, list: *Lifo) {
                @unsafe
                let sub = @ptrv(ref, ?ptr)
                if !isset(sub) : return
                let sub_item: ptr = sub & (~prop_mask).to(uint)
                list.add(sub_item)
            })
        }
    }
}

#end

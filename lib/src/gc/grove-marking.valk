@unsafe

use mem

// The collector's graph loops (THEORY 5.4.5): marking claims what it reaches, the walk frees
// in place what lost its owner. Both run over the mark list in work items of at most 256
// words (K-21). Two forms: the direct one processes an object when it leaves the list; the
// window form pushes slot addresses and prefetches each target and its shadow byte
// mark_window entries before it is processed, so the cache misses of several objects overlap.
// The window costs instructions, so it is used only after a walk of many objects in a large
// heap: an object count, not a time (Gc.mark_window_on)
value mark_window (8)
value window_objects (4096)
value window_heap (16 * 1024 * 1024)

// claim(u, st) without the push (K-13): STATE := st, the block's live count and L grow, and a
// young object (in its block's window of this epoch) adds its bytes to young_marked
fn claim(item: ptr, st: uint) *Desc $inline {
    @unsafe
    gcdata(item).set_state(st)
    let desc = desc_of(item)
    let size = desc.isize
    desc.slots_used++
    let g = gc
    g.mem_marked += size
    if in_window(desc, item, desc.aw_hi) : g.young_marked += size
    return desc
}

// drop(u) (K-06): STATE 0, the block's live count and L shrink
fn drop(item: ptr, data: *GcData) $inline {
    @unsafe
    data.set_state(0)
    let desc = desc_of(item)
    desc.slots_used--
    #if GC_DEBUG
    if desc.isize > gc.mem_marked : panic("GC marked-memory accounting underflow")
    #end
    gc.mem_marked -= desc.isize
}

//////////////////////////
// Marking
//////////////////////////

// The drain (K-14): marks the object `item` that the caller claimed, if any, then every
// object the mark list holds
fn mark(item: ?ptr) $hot {
    if gc.mark_window_on : mark_window_loop(item)
    else : mark_direct(item)
}

fn mark_direct(item: ?ptr) $hot {
    @unsafe
    let ml = gc.mark_list
    if isset(item) : ml.add(item)
    while ml.index > 0 {
        let e = ml.pop_unchecked()
        let from: uint = 0
        if e & 1 != 0 {
            e = e - 1
            from = ml.pop_unchecked()
        }
        let desc = desc_of(e)
        let r = desc.routines
        if isset(r) {
            ml.reserve(r.words)
            r.mark(e, ml)
            continue
        }
        let layout = desc.layout ?! continue
        each_ref_work(e, layout, desc.isize, from, ml, mark_ref)
    }
}

// The mark rule (K-12) for one non-null reference word of a claimed object: a counted word is
// skipped; an untagged word claims a STATE-0 target as OWNED and tags the word OWN, else it
// counts the target and tags the word CO
fn mark_ref(ref: ptr, list: *Lifo) $hot $inline {
    @unsafe
    let w = @ptrv(ref, uint)
    if w & prop_mask != 0 {
        #if GC_DEBUG
        mark_word_check(ref, w)
        #end
        return
    }
    let sub: ptr = w.@cast(ptr)
    // Objects outside the heap (static strings) have no state and are never tagged
    if !in_heap(sub) {
        #if GROVE_MT
        if in_shared(sub) : mark_shared(ref, w)
        #end
        return
    }
    let data = gcdata(sub)
    if data.is_new() {
        claim(sub, st_owned)
        @ptrv(ref, uint) = w | prop_owned
        list.add_unchecked(sub)
        return
    }
    data.co_own()
    @ptrv(ref, uint) = w | prop_co_owned
}

fn mark_window_loop(item: ?ptr) $hot {
    @unsafe
    let ml = gc.mark_list
    if isset(item) : mark_expand(item, 0, ml)

    // Slots leave the list through a window of mark_window entries: an entry's shadow byte and
    // object are prefetched when it enters and processed when it leaves. One in, one out, so
    // the branches stay predictable
    let window: [ptr x mark_window] = @undefined
    let head: uint = 0
    let count: uint = 0
    while true {
        if ml.index > 0 {
            let entered = ml.pop_unchecked()
            if entered & 1 != 0 {
                // The rest of a work item
                let from: uint = ml.pop_unchecked()
                mark_expand(entered - 1, from, ml)
                continue
            }
            let target = @ptrv(entered, uint) & (~prop_mask).to(uint)
            $prefetch((target >> 3).@cast(ptr))
            $prefetch(target.@cast(ptr))
            window[(head + count) & (mark_window - 1)] = entered
            if count < mark_window - 1 {
                count++
                continue
            }
        } else {
            if count == 0 : break
            count--
        }
        let ref = window[head]
        head = (head + 1) & (mark_window - 1)

        let w = @ptrv(ref, uint)
        // A slot pushed twice was processed already
        if w & prop_mask != 0 : continue
        let sub: ptr = w.@cast(ptr)
        let data = gcdata(sub)
        if data.is_new() {
            claim(sub, st_owned)
            @ptrv(ref, uint) = w | prop_owned
            mark_expand(sub, 0, ml)
        } else {
            data.co_own()
            @ptrv(ref, uint) = w | prop_co_owned
        }
    }
}

// Pushes the slots of a claimed object's work item that hold an untagged reference into the
// heap; mark_window_loop applies the mark rule when it reaches them
fn mark_expand(item: ptr, from: uint, ml: *Lifo) $inline {
    @unsafe
    let desc = desc_of(item)
    let r = desc.routines
    if isset(r) {
        ml.reserve(r.words)
        r.expand(item, ml)
        return
    }
    let layout = desc.layout ?! return
    each_ref_work(item, layout, desc.isize, from, ml, mark_push_ref)
}

fn mark_push_ref(ref: ptr, list: *Lifo) $hot $inline {
    @unsafe
    let w = @ptrv(ref, uint)
    if w & prop_mask != 0 {
        #if GC_DEBUG
        mark_word_check(ref, w)
        #end
        return
    }
    if !in_heap(w.@cast(ptr)) {
        #if GROVE_MT
        if in_shared(w.@cast(ptr)) : mark_shared(ref, w)
        #end
        return
    }
    list.add_unchecked(ref)
}

#if GROVE_MT
// LC1: a word into S is a co-edge whose count goes to X_t; it is never claimed or walked
fn mark_shared(ref: ptr, w: uint) $noinline {
    @unsafe
    @ptrv(ref, uint) = w | prop_co_owned
    xt_inc(gc, w)
}
#end

// P6: the mark rule for one word of a logged card; drained by mark(null)
fn update_props(ref: ptr, list: *Lifo) $hot $inline {
    @unsafe
    // No reserve precedes these pushes
    list.reserve(1)
    if gc.mark_window_on : mark_push_ref(ref, list)
    else : mark_ref(ref, list)
}

#if GC_DEBUG
// Debug mark_T rejects a word with both tags and the poison of a free slot
fn mark_word_check(ref: ptr, w: uint) {
    if w & prop_mask == prop_mask || w == POISON_U64 {
        print_word_address(ref)
        panic("GC error: marking found a word with both tags or the poison")
    }
}
#end

//////////////////////////
// The walk
//////////////////////////

// P5's walk (K-08) from `item`, which has STATE 0 and was cut: it and every object the walk
// drops are dead (K-09), and their words are walked. Returns the number of objects walked
fn walk(item: ptr) uint {
    @unsafe
    if gc.mark_window_on : return walk_window(item)
    return walk_direct(item)
}

fn walk_direct(item: ptr) uint $hot {
    @unsafe
    let ml = gc.mark_list
    let walked: uint = 0
    let from: uint = 0
    while true {
        let desc = desc_of(item)
        if from == 0 {
            walked++
            dead(item, desc)
        }
        let r = desc.routines
        if isset(r) {
            ml.reserve(r.words)
            r.walk(item, ml)
        } else {
            let layout = desc.layout
            if isset(layout) : each_ref_work(item, layout, desc.isize, from, ml, walk_ref)
        }
        if ml.index == 0 : break
        item = ml.pop_unchecked()
        from = 0
        if item & 1 != 0 {
            item = item - 1
            from = ml.pop_unchecked()
        }
    }
    return walked
}

fn walk_window(item: ptr) uint $hot {
    @unsafe
    let ml = gc.mark_list
    let walked: uint = 1
    walk_expand(item, 0, ml)

    // The window of mark_window_loop
    let window: [ptr x mark_window] = @undefined
    let head: uint = 0
    let count: uint = 0
    while true {
        if ml.index > 0 {
            let entered = ml.pop_unchecked()
            if entered & 1 != 0 {
                let from: uint = ml.pop_unchecked()
                walk_expand(entered - 1, from, ml)
                continue
            }
            let target = @ptrv(entered, uint) & (~prop_mask).to(uint)
            $prefetch((target >> 3).@cast(ptr))
            $prefetch(target.@cast(ptr))
            window[(head + count) & (mark_window - 1)] = entered
            if count < mark_window - 1 {
                count++
                continue
            }
        } else {
            if count == 0 : break
            count--
        }
        let ref = window[head]
        head = (head + 1) & (mark_window - 1)

        let sub = walk_word(ref) ?! continue
        walked++
        walk_expand(sub, 0, ml)
    }
    return walked
}

// A dropped object (from 0), or the rest of a work item: its counted words are pushed
fn walk_expand(item: ptr, from: uint, ml: *Lifo) $inline {
    @unsafe
    let desc = desc_of(item)
    if from == 0 : dead(item, desc)
    let r = desc.routines
    if isset(r) {
        ml.reserve(r.words)
        r.walk_expand(item, ml)
        return
    }
    let layout = desc.layout ?! return
    each_ref_work(item, layout, desc.isize, from, ml, walk_push_ref)
}

fn walk_push_ref(ref: ptr, list: *Lifo) $hot $inline {
    @unsafe
    if @ptrv(ref, uint) & prop_mask != 0 : list.add_unchecked(ref)
}

// dead(c) (K-09): a remaining count puts it on RL for P8, a finalizable object joins the
// finalizer list, and its block is touched. The free is in place: STATE is 0 already, the
// count stays for P8, no card byte is written
fn dead(item: ptr, desc: *Desc) $inline {
    @unsafe
    let g = gc
    if gcdata(item).has_co_in(desc.isize) : g.re_own_list.add_ptr(item)
    if isset(desc.onfree) : g.blanks.add_ptr(item)
    touch_block(desc)
}

fn walk_ref(ref: ptr, list: *Lifo) $hot $inline {
    @unsafe
    let sub = walk_word(ref) ?! return
    list.add_unchecked(sub)
}

// The walk rule (K-08) for one reference word of a walked object: a counted word is
// stripped. Its OWN target, or a CO target that is a CO_ROOT (after the count falls by one),
// is dropped and returned to be walked, unless it is a root object of this collection, which
// becomes ROOT_OWNED and joins the root list instead
fn walk_word(ref: ptr) ?ptr $hot $inline {
    @unsafe
    let w = @ptrv(ref, uint)
    let tag = w & prop_mask
    if tag == 0 : return null
    let sub: ptr = (w - tag).@cast(ptr)
    #if GROVE_MT
    // LC1: a counted word into S is stripped; X_t falls at P10, after the finalizers
    if !in_heap(sub) {
        @ptrv(ref, uint) = sub
        gc.xt_pending.add_ptr(sub)
        return null
    }
    #end
    let data = gcdata(sub)
    #if GC_DEBUG
    if tag == prop_mask || sub == null : panic("GC error: the walk found a word with both tags or a tagged null")
    if tag == prop_owned && data.state() != st_owned {
        print_word_address(ref)
        panic("GC error: the walk found an OWN word whose target is not OWNED")
    }
    #end
    @ptrv(ref, uint) = sub
    if tag == prop_co_owned {
        data.co_unown()
        if data.state() != st_co_root : return null
    }
    if data.is_on_stack() {
        data.set_state(st_root_owned)
        gc.roots_now.add_ptr(sub)
        return null
    }
    drop(sub, data)
    return sub
}

// P9: runs the finalizer of a dead object
fn free_blank(item: ptr) $hot {
    @unsafe
    let data = gcdata(item)
    let onfree = desc_of(item).onfree
    if isset(onfree) : onfree(item)

    #if GC_DEBUG
    if data.has_co() : panic("co_count not 0 before free")
    if data.bits != 0 {
        #if GROVE_MT
        nj_off()
        #end
        print("Shadow: ")
        data.bits.print(10)
        print("\n")
        panic("GC error: shadow not 0 before free")
    }
    #end
}

// The growth of a sequence's storage (THEORY 5.5.9): `data_ref` is the container's storage
// word, whose storage holds `count` elements; the new storage has room for `size`. It is
// allocated first, the last point that can collect before the storage word is read. When
// the container owns its storage, the new storage is claimed at once: the counted words move
// to it with their tags, the old storage keeps plain words and is recorded as removed, and
// every card of the new storage is dirty and covered by one range entry. Otherwise the
// elements are copied stripped and the storage word is stored through the barrier
fn gc_grow(data_ref: ptr, count: uint, size: uint) $gc_primitive {
    @unsafe
    #if GROVE_MT
    // S2: the growth of an S container's storage is made in S, by a plain copy
    if !in_heap(data_ref) {
        s_grow(data_ref, count, size)
        return
    }
    #end
    let first: ptr = (@ptrv(data_ref, uint) & (~prop_mask).to(uint)).@cast(ptr)
    let layout = desc_of(first).layout ?! panic("gc_grow: the storage has no reference layout")
    let stride = @ptrv(layout, uint, layout_stride)
    let offset = @ptrv(layout, uint, layout_data_offset)
    let bytes = offset + size * stride
    let pool = get_typed_pool(bytes, layout)
    let to = pool.large ? pool.get_large(bytes) : pool.get()
    let zeroed = pool.zeroed
    let w = @ptrv(data_ref, uint)
    let from: ptr = (w & (~prop_mask).to(uint)).@cast(ptr)
    let g = gc
    @ptrv(to, uint) = size
    let src = from + offset
    let dst = to + offset
    if w & prop_mask == prop_owned {
        mem.copy_bytes(src, dst, count * stride)
        let adr = src
        let end = src + count * stride
        while adr < end {
            each_field_ref(adr, layout, g.mark_list, fn(ref: ptr, list: *Lifo) {
                @unsafe
                @ptrv(ref, uint) = @ptrv(ref, uint) & (~prop_mask).to(uint)
            })
            adr += stride
        }
        if !zeroed : mem.clear_bytes(dst + count * stride, (size - count) * stride)
        // Claimed at once: OWNED, live, and young bytes for the survival ratio
        let desc = desc_of(to)
        gcdata(to).set_state(st_owned)
        desc.slots_used++
        g.mem_marked += desc.isize
        g.young_marked += desc.isize
        @ptrv(data_ref, uint) = to | prop_owned
        g.props_removed.add(from | prop_owned)
        #if GC_DEBUG
        g.growth_sources.add_ptr(from)
        #end
        cards_set(to, to + desc.isize)
        g.card_log.add_ptr(to + 1)
    } else {
        copy_strip(src, dst, count, to)
        if !zeroed : mem.clear_bytes(dst + count * stride, (size - count) * stride)
        property_update(data_ref, data_ref, to)
    }
    log_cap_test()
}

/// Copies `count` elements from `from` to `to` with the ownership tags of their references
/// removed, so the copy owns nothing until a collection walks it.
///
/// Both point at elements of sequences laid out like `storage`, the GC allocation that
/// holds `to`. Used to fill fresh storage from elements another storage owns.
+ fn copy_strip(from: ptr, to: ptr, count: uint, storage: ptr) $gc_primitive {
    @unsafe
    if count == 0 : return
    #if GROVE_MT
    // S2: into S storage the elements are published
    if !in_heap(storage) {
        s_copy_in(from, to, count, storage)
        return
    }
    #end
    #if GC_DEBUG
    // R5 writes only into new storage
    if gcdata(storage).is_not_new() : panic("GC error: copy_strip into an old storage")
    #end
    let layout = desc_of(storage).layout ?! panic("copy_strip: the storage has no reference layout")
    let stride = @ptrv(layout, uint, layout_stride)
    mem.copy_bytes(from, to, count * stride)
    let adr = to
    let end = to + count * stride
    while adr < end {
        each_field_ref(adr, layout, gc.mark_list, fn(ref: ptr, list: *Lifo) {
            @unsafe
            @ptrv(ref, uint) = @ptrv(ref, uint) & (~prop_mask).to(uint)
        })
        adr += stride
    }
}

#if GROVE_MT
// C-33 amended: a value about to become shared was published, so it is null or outside the
// thread heap
fn share_null_check(item: ?ptr) $inline {
    @unsafe
    if in_heap(item.@cast(ptr)) : panic("GC error: a thread-heap object became shared without being published")
}
#else
// Single-threaded: nothing is ever shared, and shared globals are ordinary roots
fn share_null_check(item: ?ptr) $inline {
}
#end

fn share(item: GcItem) $inline {
}

// The traces of the debug checks (D-11): with `support` false along every reference word,
// else along OWN words and along CO words into CO_ROOTs only. Reached objects get the leak mark
fn trace_from(item: GcItem, support: bool) {
    @unsafe
    let ml = gc.trace_list
    ml.add(item)

    while ml.index > 0 {
        let item: GcItem = ml.pop_unchecked()
        // Objects outside the heap (static strings) hold no references
        if !in_heap(item) : continue
        let data = gcdata(item)
        if data.has_leak_mark() : continue
        data.set_leak_mark()

        let layout = desc_of(item).layout ?! continue
        if support {
            each_ref(item, layout, ml, fn(ref: ptr, list: *Lifo) {
                @unsafe
                let w = @ptrv(ref, uint)
                let tag = w & prop_mask
                let sub: ptr = (w - tag).@cast(ptr)
                if tag == prop_owned || (tag == prop_co_owned && in_heap(sub) && gcdata(sub).state() == st_co_root) : list.add(sub)
            })
            continue
        }
        each_ref(item, layout, ml, fn(ref: ptr, list: *Lifo) {
            @unsafe
            list.add((@ptrv(ref, uint) & (~prop_mask).to(uint)).@cast(ptr))
        })
    }
}

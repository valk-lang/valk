use mem

/// Buffers reads from an `io.Reader` so small reads avoid repeated underlying calls.
///
/// Implements `io.Reader` and also supports byte peeking, delimited reads, and line reads
/// over the same stream without losing unread bytes.
+ class BufReader is Reader {
    - reader: Reader
    - buf: mut &[u8]
    - start: uint (0)
    - end: uint (0)

    /// Creates a buffered reader over `reader` with an internal buffer of `capacity` bytes
    /// (at least 1).
    + static fn new(reader: Reader, capacity: uint (8192)) SELF {
        return SELF {
            reader: reader
            buf: [u8]{ 0 x capacity == 0 ? 1 : capacity }
        }
    }

    /// Number of unread bytes currently held in the buffer.
    + get buffered: uint {
        return this.end - this.start
    }

    /// Size of the internal buffer in bytes.
    + get capacity: uint {
        return this.buf.length
    }

    /// Returns the underlying reader.
    + fn inner() Reader {
        return this.reader
    }

    /// Switches to `reader` and discards any unread buffered bytes, reusing the buffer.
    + fn reset(reader: Reader) {
        this.reader = reader
        this.start = 0
        this.end = 0
    }

    /// Returns a view of the currently buffered bytes, filling from the underlying reader
    /// once if the buffer is empty.
    ///
    /// Returns an empty view at the end of input (a `.closed` error counts as end of input).
    /// The returned view is overwritten by subsequent reads once the buffer is refilled.
    + fn fill() &[u8] !IoError {
        if this.start < this.end {
            return this.buf.view(this.start, this.end - this.start)
        }
        this.start = 0
        this.end = 0
        let count = this.reader.read(this.buf) ! {
            if E == .closed : return this.buf.view(0, 0)
            throw E
        }
        if count > this.buf.length : count = this.buf.length
        this.end = count
        return this.buf.view(0, count)
    }

    /// Marks up to `count` buffered bytes as read.
    + fn consume(count: uint) {
        let avail = this.end - this.start
        if count >= avail {
            this.start = 0
            this.end = 0
        } else {
            this.start += count
        }
    }

    /// Returns the next byte without consuming it, or `null` at the end of input.
    + fn peek() ?u8 !IoError {
        let view = this.fill() !>
        if view.length == 0 : return null
        return view[0]
    }

    /// Reads and consumes one byte, or returns `null` at the end of input.
    + fn read_byte() ?u8 !IoError {
        let view = this.fill() !>
        if view.length == 0 : return null
        let b = view[0]
        this.consume(1)
        return b
    }

    /// Skips up to `count` bytes and returns the number of bytes actually skipped.
    + fn discard(count: uint) uint !IoError {
        let skipped: uint = 0
        while skipped < count {
            let view = this.fill() !>
            if view.length == 0 : break
            let take = count - skipped
            if take > view.length : take = view.length
            this.consume(take)
            skipped += take
        }
        return skipped
    }

    /// Reads up to `buf.length` bytes into `buf` and returns the count; 0 at the end of input.
    ///
    /// Large reads when the buffer is empty go straight to the underlying reader without an
    /// extra copy.
    + fn read(buf: local mut &[u8]) uint !IoError {
        if buf.length == 0 : return 0
        let avail = this.end - this.start
        if avail > 0 {
            let take = buf.length < avail ? buf.length : avail
            mem.copy(this.buf.view(this.start, take), buf.view(0, take))
            this.consume(take)
            return take
        }
        if buf.length >= this.buf.length {
            let count = this.reader.read(buf) !>
            return count > buf.length ? buf.length : count
        }
        let count = this.reader.read(this.buf) !>
        if count == 0 : return 0
        if count > this.buf.length : count = this.buf.length
        let take = buf.length < count ? buf.length : count
        mem.copy(this.buf.view(0, take), buf.view(0, take))
        if take < count {
            this.start = take
            this.end = count
        }
        return take
    }

    /// Returns the next line without its `\n` or `\r\n`, or `null` at the end of input.
    + fn read_line() ?String !IoError {
        let out = ByteBuffer.new()
        let count = this.read_until_to('\n', out, true) !>
        if !isset(count) : return null
        return out.into_string()
    }

    /// Writes the next line to `out` without its `\n` or `\r\n` and returns the bytes
    /// written, or `null` at the end of input.
    + fn read_line_into(out: Writer) ?uint !IoError {
        return this.read_until_to('\n', out, true) !>
    }

    /// Returns the bytes up to, not including, the next `delimiter`, or `null` at the end.
    + fn read_until(delimiter: u8) ?String !IoError {
        let out = ByteBuffer.new()
        let count = this.read_until_to(delimiter, out, false) !>
        if !isset(count) : return null
        return out.into_string()
    }

    /// Writes the bytes up to, not including, the next `delimiter` to `out` and returns the
    /// bytes written, or `null` at the end of input.
    + fn read_until_into(delimiter: u8, out: Writer) ?uint !IoError {
        return this.read_until_to(delimiter, out, false) !>
    }

    fn read_until_to(delimiter: u8, out: Writer, strip_cr: bool) ?uint !IoError {
        let written: uint = 0
        let pending_cr = false
        while true {
            let i = this.start
            while i < this.end {
                if this.buf[i] == delimiter {
                    let segment = this.buf.view(this.start, i - this.start)
                    if pending_cr && segment.length > 0 {
                        write_all(out, "\r") !>
                        written += 1
                        pending_cr = false
                    }
                    if strip_cr && segment.length > 0 && segment[segment.length - 1] == '\r' {
                        segment = segment.view(0, segment.length - 1)
                    }
                    if segment.length > 0 {
                        write_all(out, segment) !>
                        written += segment.length
                    }
                    this.consume(i - this.start + 1)
                    return written
                }
                i++
            }
            let segment = this.buf.view(this.start, this.end - this.start)
            if segment.length > 0 {
                if pending_cr {
                    write_all(out, "\r") !>
                    written += 1
                    pending_cr = false
                }
                if strip_cr && segment[segment.length - 1] == '\r' {
                    pending_cr = true
                    segment = segment.view(0, segment.length - 1)
                }
                if segment.length > 0 {
                    write_all(out, segment) !>
                    written += segment.length
                }
            }
            this.start = 0
            this.end = 0
            let count = this.reader.read(this.buf) ! {
                if E == .closed : break
                throw E
            }
            if count == 0 : break
            if count > this.buf.length : count = this.buf.length
            this.end = count
        }
        if pending_cr {
            write_all(out, "\r") !>
            return written + 1
        }
        if written == 0 : return null
        return written
    }
}

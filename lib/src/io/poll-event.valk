
use ext

value POLL_TIMEOUT (1 << 14)

integer PollEvent signed 2 {
    /// Returns whether the wait ended because its timeout expired.
    + fn is_timeout() bool {
        return (this & POLL_TIMEOUT) != 0
    }
    /// Returns whether the descriptor hung up or reported an error.
    + fn is_closed() bool {
        return (this & (ext.POLLHUP | ext.POLLERR)) > 0
    }
    /// Returns whether the descriptor has data to read.
    + fn is_readable() bool {
        return (this & ext.POLLIN) > 0
    }
    /// Returns whether the descriptor can accept writes.
    + fn is_writable() bool {
        return (this & ext.POLLOUT) > 0
    }
}

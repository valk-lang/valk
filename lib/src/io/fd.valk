use ext
use core

#if OS == "win"
/// A file or socket descriptor: a Win32 `HANDLE` or Winsock `SOCKET` value.
alias Fd for uint $global
#else
/// A file or socket descriptor: a POSIX file descriptor.
alias Fd for i32 $global
#end

/// Wakes pending socket I/O on `fd` and makes later I/O on it fail, without releasing it.
///
/// Safe to call from another thread. The descriptor must still be closed with `close`.
+ fn interrupt_fd(fd: Fd) {
    let res = ext.shutdown(fd, 2)
    #if OS == "macos"
    // An unconnected datagram socket cannot be shut down here, and unlike Linux the
    // kernel does not wake its waiters either; an empty datagram to its own address does
    if res != 0 && ext.get_errno() == ext.ENOTCONN : wake_datagram_socket(fd)
    #end
    #if OS == "win"
    // Winsock's shutdown() does not complete a pending overlapped receive;
    // cancelling the descriptor's I/O does (see cancel_overlap)
    @unsafe
    ext.CancelIoEx(fd, null)
    #end
}

#if OS == "macos"
// Sends an empty datagram from `fd` to the address it is bound to, so a
// pending receive returns; a socket bound to the unspecified address is
// reached through the loopback address of its family
fn wake_datagram_socket(fd: Fd) {
    @unsafe
    let type: i32 = 0
    let type_len: u32 = 4
    if ext.getsockopt(fd, ext.SOL_SOCKET, ext.SO_TYPE, @ref(type), @ref(type_len)) != 0 : return
    if type != ext.SOCK_DGRAM : return
    let buffer = [u8 x 128]{ 0... }
    let address = @ref(buffer).@cast(ptr)
    let length: u32 = 128
    if ext.getsockname(fd, address.@cast(*ext.libc_sockaddr), @ref(length)) != 0 : return
    // BSD sockaddr: len (1), family (1), port (2), then the address
    let family = @ptrv(address, u8, 1)
    if family == ext.AF_INET.to(u8) {
        if @ptrv(address, u32, 1) == 0 {
            // 0.0.0.0 -> 127.0.0.1
            @ptrv(address, u8, 4) = 127
            @ptrv(address, u8, 7) = 1
        }
    } else if family == ext.AF_INET6.to(u8) {
        let zero = true
        let i: uint = 0
        while i < 16 {
            if @ptrv(address, u8, 8 + i) != 0 : zero = false
            i++
        }
        // :: -> ::1
        if zero : @ptrv(address, u8, 23) = 1
    } else {
        return
    }
    let nothing: u8 = 0
    ext.sendto(fd, @ref(nothing), 0, 0, address.@cast(*ext.libc_sockaddr), length)
}
#end

/// Turns non-blocking mode of `fd` on or off.
///
/// On Windows it only works for sockets. Throws `.os` on failure.
+ fn set_nonblocking(fd: Fd, value: bool) !IoError {
    while true {
        #if OS == "win"
        @unsafe
        let nonblock: uint = value ? 1 : 0
        let err = ext.ioctlsocket(fd, ext.FIONBIO, @ref(nonblock))
        if err == 0 : return
        if ext.WSAGetLastError() == ext.WSAEINTR : continue
        #else
        let flags = ext.fcntl(fd, ext.F_GETFL, 0)
        if flags == -1 {
            if ext.get_errno() == ext.EINTR : continue
            throw .os
        }
        let max: i32 = -1
        let v: i32 = value ? (flags | ext.O_NONBLOCK) : flags & (max - ext.O_NONBLOCK)
        let err = ext.fcntl(fd, ext.F_SETFL, v)
        if err == 0 : return
        if ext.get_errno() == ext.EINTR : continue
        #end
        throw .os
    }
}

/// Closes `fd`; it must not be used afterwards.
///
/// Throws `.os` when the OS reports a failure.
+ fn close(fd: Fd) !IoError {
    #if OS == "win"
    let ok = ext.CloseHandle(fd)
    if ok == 0 : throw .os
    #else
    let err = ext.close(fd)
    if err == -1 : throw .os
    #end
}

fn close_cleanup(fd: Fd, file: String, line: uint) {
    close(fd) ! core.cleanup_warning("Failed to close descriptor", file, line)
}

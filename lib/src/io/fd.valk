
use ext

#if OS == "win"
alias FD for uint $global
#else
alias FD for i32 $global
#end

+ fn set_non_block(fd: FD, value: bool) {
    while true {
        #if OS == "win"
        let nonblock : uint = value ? 1 : 0
        let err = ext:ioctlsocket(fd, ext:FIONBIO, @ref(nonblock))
        if err == 0 : return
        if ext:WSAGetLastError() == ext:WSAEINTR : continue
        #else
        let flags = ext:fcntl(fd, ext:F_GETFL, 0)
        if flags == -1 {
            if ext:errno == ext:EINTR : continue
            panic("Failed to read descriptor flags")
        }
        let max : i32 = -1
        let v : i32 = value ? (flags | ext:O_NONBLOCK) : flags & (max - ext:O_NONBLOCK)
        let err = ext:fcntl(fd, ext:F_SETFL, v)
        if err == 0 : return
        if ext:errno == ext:EINTR : continue
        #end
        panic("Failed to change descriptor blocking mode")
    }
}

+ fn close(fd: FD) {
    #if OS == "win"
    let ok = ext:CloseHandle(fd)
    if ok == 0 : panic("Failed to close handle")
    #else
    let err = ext:close(fd)
    if err == -1 : panic("Failed to close descriptor")
    #end
}

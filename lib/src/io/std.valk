use core

// The standard input stream as an `io.Reader`
+ fn stdin() StdStream {
    return StdStream { fd: 0, can_read: true, can_write: false }
}
// The standard output stream as an `io.Writer`
+ fn stdout() StdStream {
    return StdStream { fd: 1, can_read: false, can_write: true }
}
// The standard error stream as an `io.Writer`
+ fn stderr() StdStream {
    return StdStream { fd: 2, can_read: false, can_write: true }
}

// One of the process' standard streams. Reads and writes are blocking and
// never close the descriptor.
+ class StdStream is Reader, Writer {
    ~ fd: Fd
    ~ can_read: bool
    ~ can_write: bool

    + fn read(buf: Slice[u8]) uint !IoError {
        @unsafe
        if !this.can_read : throw .read
        return read_bytes_sync(this.fd, buf.data, buf.length, 0) ! throw .read
    }

    + fn write(data: Slice[u8]) uint !IoError {
        @unsafe
        if !this.can_write : throw .write
        let from = data.data
        let len = data.length
        let total: uint = 0
        while len - total > 0 {
            let written = write_bytes_sync(this.fd, from + total, len - total) ! throw .write
            if written == 0 : throw .write
            total += written
        }
        return total
    }
}

use core

/// Writes all `amount` bytes at `adr` to `fd`.
///
/// `write_bytes_sync` may transfer less than it was asked for, so a short count is not
/// a complete write; keep going with the rest. Errors are ignored, so a failed call stops
/// the loop.
fn write_all_sync(fd: Fd, adr: ptr, amount: uint) {
    @unsafe
    let offset: uint = 0
    while offset < amount {
        let sent = write_bytes_sync(fd, adr + offset, amount - offset) ! return
        if sent == 0 : return
        offset += sent
    }
}

/// Writes `msg` and a newline to standard output.
///
/// Available in every namespace without the `io.` prefix. The write blocks the thread, and
/// errors are ignored.
+ fn println(msg: String) $global {
    @unsafe
    let buf = core.buffer
    buf.clear()
    buf.write(msg)
    buf.write_byte('\n')
    write_all_sync(1, buf.data, buf.length)
}

/// Writes `msg` to standard output, without a newline.
///
/// Available in every namespace without the `io.` prefix. The write blocks the thread, and
/// errors are ignored.
+ fn print(msg: String) $global {
    @unsafe
    write_all_sync(1, msg.data, msg.length)
}

fn print_bytes(adr: ptr, len: uint) {
    @unsafe
    write_all_sync(1, adr, len)
}

#if OS == "linux"
use ext
use coro
use mem

global uring_instance: ?URing
global uring_unsubmitted: uint
// IORING_FEAT_* of this thread's ring, as the kernel reported them
global uring_features: u32

class URing {
    inst: *ext.io_uring
    fn gc_free() {
        @unsafe
        ext.io_uring_queue_exit(this.inst)
        mem.free(this.inst)
    }
}

value IORING_CQE_F_MORE (2)
// Linux 6.3+; implies sends that wait for all their data (MSG_WAITALL, 5.19+)
value IORING_FEAT_REG_REG_RING (8192)

// The ring of this thread. Ring memory counts against the locked-memory
// limit of the whole user, so a busy machine may only have room for a small
// ring, or for none at all.
// struct io_uring_params: u32 sq_entries, cq_entries, flags, ...
value IORING_SETUP_CQSIZE (8)
// Only this thread submits, and the kernel completes its work when the thread waits instead of
// interrupting it (Linux 6.1+). The flag tells a peek that deferred completions are pending
value IORING_SETUP_TASKRUN_FLAG (512)
value IORING_SETUP_SINGLE_ISSUER (4096)
value IORING_SETUP_DEFER_TASKRUN (8192)

fn uring() *ext.io_uring !IoError {
    @unsafe
    let ring = uring_instance
    if isset(ring) : return ring.inst
    let inst = mem.new[ext.io_uring]()
    // Rings count against the user's locked-memory limit, which every program of the user
    // shares. Submissions go out in batches of at most 128, so 256 entries are enough; the
    // completion queue stays large for many connections that finish at once
    let params: [u32 x 30] = @undefined
    mem.clear_bytes(@ref(params).@cast(ptr), 120)
    params[1] = 2048
    params[2] = IORING_SETUP_CQSIZE | IORING_SETUP_SINGLE_ISSUER | IORING_SETUP_DEFER_TASKRUN | IORING_SETUP_TASKRUN_FLAG
    let err = ext.io_uring_queue_init_params(256, inst, @ref(params).@cast(ptr))
    if err < 0 {
        mem.clear_bytes(@ref(params).@cast(ptr), 120)
        params[1] = 2048
        params[2] = IORING_SETUP_CQSIZE
        err = ext.io_uring_queue_init_params(256, inst, @ref(params).@cast(ptr))
    }
    if err >= 0 : uring_features = params[5]
    if err < 0 : err = ext.io_uring_queue_init(64, inst, 0)
    if err < 0 {
        mem.free(inst)
        throw .os
    }
    uring_instance = URing { inst: inst }
    return inst
}

// Direct descriptors: sockets that live in the ring's own file table instead of the process's,
// so they do not count against RLIMIT_NOFILE. The kernel caps one table at that limit
value IOSQE_FIXED_FILE (1)
value IORING_FILE_INDEX_ALLOC (0xFFFF_FFFF)
value IORING_POLL_ADD_MULTI (1)
value DIRECT_TABLE_MAX ((1 << 18) - 64)

global uring_files_size: uint
global uring_files_tried: bool

// The size of this thread's table of direct descriptors, registered on first use; 0 when the
// kernel has none (before 5.19)
fn uring_files() uint {
    @unsafe
    if uring_files_tried : return uring_files_size
    uring_files_tried = true
    let ring = uring() ! return 0
    let limits: [u64 x 2] = { 0 ... }
    if ext.getrlimit(ext.RLIMIT_NOFILE, @ref(limits).@cast(ptr)) != 0 : return 0
    let size = limits[0].to(uint)
    if size > DIRECT_TABLE_MAX : size = DIRECT_TABLE_MAX
    if size < 64 : return 0
    if !register_files_sparse(ring, size) : return 0
    uring_files_size = size
    return size
}

// System calls of their own: the liburing that static builds link predates these
value SYS_IO_URING_ENTER (426)
value SYS_IO_URING_REGISTER (427)
value IORING_ENTER_GETEVENTS (1)
value IORING_REGISTER_FILES2 (13)
value IORING_RSRC_REGISTER_SPARSE (1)
value IORING_SQ_TASKRUN (4)

fn uring_register(ring: *ext.io_uring, opcode: uint, arg: ptr, nr: uint) bool {
    @unsafe
    return ext.syscall(SYS_IO_URING_REGISTER, ring.ring_fd.to(int), opcode.to(int), arg, nr.to(int)) >= 0
}

// An empty table of `size` direct descriptors (Linux 5.19+)
fn register_files_sparse(ring: *ext.io_uring, size: uint) bool {
    @unsafe
    // struct io_uring_rsrc_register { u32 nr, flags; u64 resv2, data, tags }
    let reg: [u64 x 4] = { 0 ... }
    reg[0] = size.to(u64) | (IORING_RSRC_REGISTER_SPARSE.to(u64) << 32)
    return uring_register(ring, IORING_REGISTER_FILES2, @ref(reg).@cast(ptr), 32)
}

// Completions that belong to no coroutine carry this index where a coroutine's would be, and
// a payload of 30 bits above it (see `coro.side_event`). Payload 0 is dropped
value SIDE_INDEX (0xFFFF_FFFF)
// The payload of the main ring's read of the extra rings' eventfd (channel 0, data 1)
value EXTRA_DOORBELL (1 << 6)

fn side_user_data(payload: uint) u64 {
    return ((payload << 34) | (SIDE_INDEX << 2)).to(u64)
}

fn is_side_event(user_data: u64) bool {
    return (user_data >> 2) & 0xFFFF_FFFF == SIDE_INDEX.to(u64)
}

// More rings of this thread for direct descriptors, each with a table of its own: one table
// holds at most RLIMIT_NOFILE. Ring 0 is the main ring (`uring`), ring i the extra ring i - 1.
// They signal one eventfd, which the main ring reads, and the scheduler reaps them with it
value DIRECT_RINGS_MAX (16)
value EFD_CLOEXEC (0x80000)

class ExtraRing {
    inst: *ext.io_uring
    unsubmitted: uint (0)
    fn gc_free() {
        @unsafe
        ext.io_uring_queue_exit(this.inst)
        mem.free(this.inst)
    }
}

global extra_rings: Array[ExtraRing] (.{})
global extra_efd: i32 (-1)
global extra_efd_count: ?ptr (null)

// The number of rings with a table of direct descriptors, the main ring included; 0 without
fn direct_ring_count() uint {
    if uring_files() == 0 : return 0
    return extra_rings.length + 1
}

// Adds a ring with a table of direct descriptors and returns its index; 0 when none can be made
fn add_direct_ring() uint {
    @unsafe
    let size = uring_files()
    if size == 0 || extra_rings.length + 1 >= DIRECT_RINGS_MAX : return 0
    let main = uring() ! return 0
    if extra_efd < 0 {
        let efd = ext.eventfd(0, EFD_CLOEXEC)
        if efd < 0 : return 0
        extra_efd = efd
        extra_efd_count = mem.alloc(8)
        arm_extra_doorbell()
    }
    let inst = mem.new[ext.io_uring]()
    let params: [u32 x 30] = @undefined
    mem.clear_bytes(@ref(params).@cast(ptr), 120)
    params[1] = 4096
    params[2] = IORING_SETUP_CQSIZE
    if ext.io_uring_queue_init_params(256, inst, @ref(params).@cast(ptr)) < 0 {
        mem.free(inst)
        return 0
    }
    let ring = ExtraRing { inst: inst }
    if !register_files_sparse(inst, size) : return 0
    if ext.io_uring_register_eventfd(inst, extra_efd) < 0 : return 0
    extra_rings.append(ring)
    return extra_rings.length
}

// Queues the main ring's read of the extra rings' eventfd
fn arm_extra_doorbell() {
    @unsafe
    let count = extra_efd_count ?! return
    let sqe = detached_sqe(0, EXTRA_DOORBELL) ! return
    io_uring_prep_read(sqe, extra_efd, count, 8, 0)
}

// Submits what was queued on the extra rings
fn submit_extra_rings() {
    each extra_rings as extra {
        if extra.unsubmitted == 0 : continue
        let submitted = ext.io_uring_submit(extra.inst)
        if submitted < 0 : continue
        extra.unsubmitted = uring_remaining(extra.unsubmitted, submitted.to(uint))
    }
}

// A submission entry on ring `index` for `coro`, like `sqe`
fn sqe_on(coro: ?coro.Coro, index: uint) *ext.io_uring_sqe !IoError {
    if index == 0 : return sqe(coro) !>
    let extra = extra_rings.get(index - 1) ! throw .os
    if extra.unsubmitted + 2 > 128 || sq_space_left(extra.inst) < 2 : submit_extra(extra)
    let entry = take_sqe_raw(coro, extra.inst) !>
    extra.unsubmitted++
    return entry
}

fn linked_sqe_on(coro: ?coro.Coro, index: uint) *ext.io_uring_sqe !IoError {
    if index == 0 : return linked_sqe(coro) !>
    let extra = extra_rings.get(index - 1) ! throw .os
    let entry = take_sqe_raw(coro, extra.inst) !>
    extra.unsubmitted++
    return entry
}

fn submit_extra(extra: ExtraRing) {
    let submitted = ext.io_uring_submit(extra.inst)
    if submitted < 0 : panic("Failed to submit io_uring requests")
    extra.unsubmitted = uring_remaining(extra.unsubmitted, submitted.to(uint))
}

// A submission on ring `index` that no coroutine waits for; its completion is a side event
// with `payload`. Allocates nothing: collectors use it
fn detached_sqe(index: uint, payload: uint) *ext.io_uring_sqe !IoError {
    @unsafe
    let sqe: ?*ext.io_uring_sqe = null
    if index == 0 {
        let main = uring_instance ?! throw .os
        let ring = main.inst
        if uring_unsubmitted + 2 > 128 || sq_space_left(ring) < 2 : uring_submit(ring)
        sqe = ext.io_uring_get_sqe(ring)
        if isset(sqe) : uring_unsubmitted++
    } else {
        let extra = extra_rings.get(index - 1) ! throw .os
        if extra.unsubmitted + 2 > 128 || sq_space_left(extra.inst) < 2 : submit_extra(extra)
        sqe = ext.io_uring_get_sqe(extra.inst)
        if isset(sqe) : extra.unsubmitted++
    }
    let entry = sqe ?! throw .os
    io_uring_prep_rw(ext.IORING_OP.NOP, entry, -1, null, 0, 0)
    entry.user_data = side_user_data(payload)
    return entry
}

// Closes the direct descriptor `slot` of ring `index`, without waiting; the socket ends once no
// operation holds it. No shutdown: io_uring runs that on a worker thread, where it would find
// the slot by number after a new connection took it
fn close_direct(index: uint, slot: i32) {
    @unsafe
    let close = detached_sqe(index, 0) ! return
    io_uring_prep_rw(ext.IORING_OP.CLOSE, close, 0, null, 0, 0)
    close.file_index = (slot + 1).to(u32)
}

// Arms a multishot poll on the direct descriptor `slot` of ring `index`; each time it becomes
// readable (or ends) a side event with `payload` arrives
fn poll_direct(index: uint, slot: i32, mask: u32, payload: uint) bool {
    @unsafe
    let sqe = detached_sqe(index, payload) ! return false
    io_uring_prep_poll_add(sqe, slot, mask)
    sqe.len = IORING_POLL_ADD_MULTI
    sqe.flags = IOSQE_FIXED_FILE.to(u8)
    return true
}

// Removes the poll armed on ring `index` with `payload`, without waiting
fn poll_remove_side(index: uint, payload: uint) {
    @unsafe
    let sqe = detached_sqe(index, 0) ! return
    io_uring_prep_rw(ext.IORING_OP.POLL_REMOVE, sqe, -1, null, 0, 0)
    sqe.addr = side_user_data(payload)
}

// Whether a send can be linked to a read: the send must go out whole, or the read
// would start after a part of it and the peer would wait for the rest
fn uring_links_full_sends() bool {
    uring() ! return false
    return (uring_features & IORING_FEAT_REG_REG_RING) != 0
}

fn uring_submit(ring: *ext.io_uring) uint {
    let submitc = ext.io_uring_submit(ring)
    return uring_record_submitted(submitc)
}

fn uring_record_submitted(submitc: i32) uint {
    if submitc < 0 : panic("Failed to submit io_uring requests")
    uring_unsubmitted = uring_remaining(uring_unsubmitted, submitc.to(uint))
    return submitc
}

fn uring_remaining(unsubmitted: uint, submitted: uint) uint {
    if submitted > unsubmitted : return 0
    return unsubmitted - submitted
}

// Free submission slots that have not been handed out yet
fn sq_space_left(ring: *ext.io_uring) uint {
    let entries = ring.sq.kring_entries[0].to(uint)
    let used = (ring.sq.sqe_tail - ring.sq.sqe_head).to(uint)
    if used >= entries : return 0
    return entries - used
}

// Hands out one submission entry and, if the batch is large or the queue is
// nearly full, flushes the entries handed out before it. The flush happens
// before the new entry is taken: the kernel copies an entry at submit time, so
// submitting one the caller has not prepared yet would run whatever operation
// last occupied that slot, under this coroutine's id. Room is kept for a
// second entry so that a linked timeout (see `link_timeout`) is never split
// from its operation by a flush in between.
fn sqe(coro: ?coro.Coro, ring: ?*ext.io_uring (null)) *ext.io_uring_sqe !IoError {
    if !isset(ring) : ring = uring() !>
    if uring_unsubmitted + 2 > 128 || sq_space_left(ring) < 2 : uring_submit(ring)
    return take_sqe(coro, ring) !>
}

// The entry linked to one taken by `sqe` just before; never submits, so the
// pair stays in one batch
fn linked_sqe(coro: ?coro.Coro, ring: ?*ext.io_uring (null)) *ext.io_uring_sqe !IoError {
    if !isset(ring) : ring = uring() !>
    return take_sqe(coro, ring) !>
}

fn take_sqe(coro: ?coro.Coro, ring: *ext.io_uring) *ext.io_uring_sqe !IoError {
    let sqe = take_sqe_raw(coro, ring) !>
    uring_unsubmitted++
    return sqe
}

// Like `take_sqe`, without counting it for the main ring
fn take_sqe_raw(coro: ?coro.Coro, ring: *ext.io_uring) *ext.io_uring_sqe !IoError {
    if !isset(coro) : coro = coro.current_coro
    let sqe = ext.io_uring_get_sqe(ring)
    if !isset(sqe) : throw .os
    let target = coro ?! panic("Cannot schedule an io_uring operation without a coroutine")
    target.arm_kernel_event()
    sqe.user_data = target.event_id().to(u64)
    return sqe
}

fn io_uring_prep_rw(op: i32, sqe: *ext.io_uring_sqe, fd: i32, addr: ?ptr, len: u32, offset: u64) {
    sqe.opcode = op.to(u8)
    sqe.flags = 0
    sqe.ioprio = 0
    sqe.fd = fd
    sqe.off = offset
    sqe.addr = addr.@cast(u64)
    sqe.len = len
    sqe.rw_flags = 0
    // sqe.user_data = 0
    sqe.buf_index = 0
    sqe.personality = 0
    sqe.file_index = 0
    sqe.pad2 = { 0 ... }
}

struct kernel_timespec {
    tv_sec: i64
    tv_nsec: i64
}
fn io_uring_prep_msg_ring(sqe: *ext.io_uring_sqe, fd: Fd, coro: coro.Coro) {
    @unsafe
    // The target ring's completion carries this payload back as `user_data`, and the
    // receiving loop decodes it with `take_kernel_event`, so it has to be the coroutine's
    // event id; the object address would never resolve to a coroutine
    io_uring_prep_rw(ext.IORING_OP.MSG_RING, sqe, fd, null, 0, coro.event_id().to(u64))
    sqe.flags = 1 << ext.IORING_SQE_FLAGS.CQE_SKIP_SUCCESS_BIT
}
fn io_uring_prep_accept(sqe: *ext.io_uring_sqe, fd: i32, addr: ?ptr, addrlen: uint, flags: i32) {
    @unsafe
    io_uring_prep_rw(ext.IORING_OP.ACCEPT, sqe, fd, addr, 0, addrlen)
    sqe.rw_flags = flags
}
fn io_uring_prep_connect(sqe: *ext.io_uring_sqe, fd: i32, addr: *ext.libc_sockaddr, addrlen: uint) {
    @unsafe
    io_uring_prep_rw(ext.IORING_OP.CONNECT, sqe, fd, addr, 0, addrlen)
}

fn io_uring_prep_read(sqe: *ext.io_uring_sqe, fd: i32, buf: ptr, nbytes: u32, offset: u64) {
    @unsafe
    io_uring_prep_rw(ext.IORING_OP.READ, sqe, fd, buf, nbytes, offset)
}
fn io_uring_prep_recv(sqe: *ext.io_uring_sqe, fd: i32, buf: ptr, nbytes: u32, flags: i32) {
    @unsafe
    io_uring_prep_rw(ext.IORING_OP.RECV, sqe, fd, buf, nbytes, 0)
    sqe.rw_flags = flags
}

fn io_uring_prep_write(sqe: *ext.io_uring_sqe, fd: i32, buf: ptr, nbytes: u32, offset: u64) {
    @unsafe
    io_uring_prep_rw(ext.IORING_OP.WRITE, sqe, fd, buf, nbytes, offset)
}
fn io_uring_prep_send(sqe: *ext.io_uring_sqe, fd: i32, buf: ptr, nbytes: u32, flags: i32) {
    @unsafe
    io_uring_prep_rw(ext.IORING_OP.SEND, sqe, fd, buf, nbytes, 0)
    sqe.rw_flags = flags
}

fn io_uring_prep_poll_add(sqe: *ext.io_uring_sqe, fd: i32, poll_mask: u32) {
    @unsafe
    io_uring_prep_rw(ext.IORING_OP.POLL_ADD, sqe, fd, null, 0, 0)
    sqe.rw_flags = io_uring_prep_poll_mask(poll_mask)
}
fn io_uring_prep_timeout(sqe: *ext.io_uring_sqe, ts: &kernel_timespec, count: u32, flags: u32) {
    @unsafe
    io_uring_prep_rw(ext.IORING_OP.TIMEOUT, sqe, -1, ts, 1, count)
    sqe.rw_flags = flags
}
fn io_uring_prep_link_timeout(sqe: *ext.io_uring_sqe, ts: &kernel_timespec, flags: u32) {
    @unsafe
    io_uring_prep_rw(ext.IORING_OP.LINK_TIMEOUT, sqe, -1, ts, 1, 0)
    sqe.rw_flags = flags
}

fn link_timeout(coro: coro.Coro, operation: *ext.io_uring_sqe, timeout_ms: uint, ring: uint (0)) !IoError {
    if timeout_ms == 0 : return

    operation.flags = operation.flags | (1 << ext.IORING_SQE_FLAGS.IO_LINK_BIT)
    operation.user_data = operation.user_data | 2
    let timeout = linked_sqe_on(coro, ring) !>
    // Split into whole seconds and a nanosecond remainder: one nanosecond count
    // wraps the signed field once the timeout passes about 292 years, and a
    // negative timespec fires at once
    let seconds = timeout_ms / 1000
    let nanos = (timeout_ms % 1000) * 1_000_000
    coro.timeout_ts = {
        tv_sec: seconds.to(i64)
        tv_nsec: nanos.to(i64)
    }
    io_uring_prep_link_timeout(timeout, &coro.timeout_ts, 0)
    timeout.user_data = timeout.user_data | 1
}

fn io_uring_prep_poll_mask(poll_mask: u32) u32 {
    return poll_mask
}

fn io_uring_wait_cqe_nr(ring: *ext.io_uring, cqe_ptr: *?*ext.io_uring_cqe, wait_nr: u32) i32 {
    @unsafe
    return ext.__io_uring_get_cqe(ring, cqe_ptr, 0, wait_nr, null)
}
fn io_uring_wait_cqe(ring: *ext.io_uring, cqe_ptr: *?*ext.io_uring_cqe) i32 {
    while true {
        let err = io_uring_wait_cqe_nr(ring, cqe_ptr, 1)
        if err == 0 - ext.EINTR : continue
        if err < 0 : panic("Failed to wait for an io_uring completion")
        return err
    }
}
fn io_uring_cqe_seen(ring: *ext.io_uring, cqe: *ext.io_uring_cqe) {
    io_uring_cq_advance(ring, 1);
}
// check if an io_uring completion event is available
fn io_uring_peek_cqe(ring: *ext.io_uring, cqe_ptr: *?*ext.io_uring_cqe) i32 {
    @unsafe
    // A deferred completion is only posted once this thread enters the kernel
    if io_uring_cq_ready(ring) == 0 && (atomic_load(ring.sq.kflags[0]) & IORING_SQ_TASKRUN.to(u32)) != 0 {
        ext.syscall(SYS_IO_URING_ENTER, ring.ring_fd.to(int), 0, 0, IORING_ENTER_GETEVENTS, 0, 0)
    }
    while true {
        let err = io_uring_wait_cqe_nr(ring, cqe_ptr, 0)
        if err == 0 - ext.EINTR : continue
        if err < 0 && err != 0 - ext.EAGAIN : panic("Failed to inspect io_uring completions")
        return err
    }
}

fn io_uring_cq_advance(ring: *ext.io_uring, nr: u32) {
    let cq = ring.cq.khead
    // cq[0] = cq[0] + nr
    atomic_store(cq[0], cq[0] + nr)
}

fn io_uring_cq_ready(ring: *ext.io_uring) u32 {
    return atomic_load(ring.cq.ktail[0]) - ring.cq.khead[0]
}
#end

+ interface Reader {
    + fn read(buffer: ByteBuffer, max_bytes: uint) uint !IoError;
}

+ interface Writer {
    + fn write_buffer(buffer: ByteBuffer) uint !IoError;
}

+ interface Seeker {
    + fn seek(offset: int, from: SeekFrom) uint !IoError;
}

+ class ByteBufferReader is Reader {
    + source: ByteBuffer
    + offset: uint (0)

    + fn read(buffer: ByteBuffer, max_bytes: uint) uint !IoError {
        if this.offset >= this.source.length : return 0
        let count = this.source.length - this.offset
        if count > max_bytes : count = max_bytes
        buffer.write_buffer_part(this.source, count, this.offset)
        this.offset += count
        return count
    }
}

+ class StringReader is Reader {
    + source: String
    + offset: uint (0)

    + fn read(buffer: ByteBuffer, max_bytes: uint) uint !IoError {
        @unsafe
        if this.offset >= this.source.bytes : return 0
        let count = this.source.bytes - this.offset
        if count > max_bytes : count = max_bytes
        buffer.write_bytes(this.source.data.@offset(this.offset), count)
        this.offset += count
        return count
    }
}

+ class ByteBufferWriter is Writer {
    + buffer: ByteBuffer

    + fn write_buffer(source: ByteBuffer) uint !IoError {
        let count = source.length
        this.buffer.write_buffer(source)
        return count
    }
}

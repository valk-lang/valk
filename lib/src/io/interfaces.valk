use core
use mem

+ interface Reader {
    // Fills `buf` and returns the number of bytes read; 0 means end of input
    + fn read(buf: Slice[u8]) uint !IoError;
}

+ interface Writer {
    + fn write(data: Slice[u8]) uint !IoError;
}

+ interface Seeker {
    + fn seek(offset: int, from: SeekFrom) uint !IoError;
}

// Reads from an in-memory byte slice (`String` and `ByteBuffer` convert to Slice[u8])
+ class SliceReader is Reader, Seeker {
    + source: Slice[u8]
    + offset: uint (0)

    + fn read(buf: Slice[u8]) uint !IoError {
        @unsafe
        let source = this.source
        if this.offset >= source.length : return 0
        let count = source.length - this.offset
        if count > buf.length : count = buf.length
        mem.copy_bytes(source.data.@offset(this.offset), buf.data, count)
        this.offset += count
        return count
    }

    + fn seek(offset: int, from: SeekFrom (SeekFrom.start)) uint !IoError {
        let length = this.source.length
        let base: uint = 0
        if from == SeekFrom.current : base = this.offset
        else if from == SeekFrom.end : base = length

        let position: uint = 0
        if offset < 0 {
            let distance = (-(offset + 1)).to(uint) + 1
            if distance > base : throw .read
            position = base - distance
        } else {
            position = base.checked_add(offset.to(uint)) ! throw .read
        }
        if position > length : throw .read
        this.offset = position
        return position
    }
}

// Appends everything written to a ByteBuffer
+ class BufferWriter is Writer {
    + buffer: ByteBuffer

    + static fn new(buffer: ?ByteBuffer (null)) SELF {
        return SELF { buffer: buffer ?? ByteBuffer.new() }
    }

    + fn write(data: Slice[u8]) uint !IoError {
        this.buffer.write(data)
        return data.length
    }
}

// Copies `reader` into `writer` until the reader is exhausted; returns the bytes copied
+ fn copy(reader: Reader, writer: Writer, chunk_size: uint (65536)) uint !IoError {
    let buf = Slice[u8].new(chunk_size == 0 ? 1 : chunk_size, 0)
    let total: uint = 0
    while true {
        let count = reader.read(buf) !>
        if count == 0 : break
        let view = buf.view(0, count)
        while view.length > 0 {
            let written = writer.write(view) !>
            if written == 0 || written > view.length : throw .write
            view = view.view(written, view.length - written)
        }
        total += count
    }
    return total
}

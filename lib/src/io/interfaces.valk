
/// A source of bytes that is read one buffer at a time.
+ interface Reader {
    /// Reads up to `buf.length` bytes into `buf` and returns the count; 0 means the end of input.
    + fn read(buf: local mut &[u8]) uint !IoError;
}

/// A destination for bytes.
+ interface Writer {
    /// Writes bytes from `data` and returns the count, which may be less than `data.length`.
    + fn write(data: local &[u8]) uint !IoError;
}

/// A stream with a movable position.
+ interface Seeker {
    /// Moves the position to `offset` bytes from `from` and returns the new position.
    + fn seek(offset: int, from: SeekFrom) uint !IoError;
}

/// A resource that is released with `close`.
+ interface Closer {
    /// Releases the resource.
    + fn close() !IoError;
}

/// Writes all of `data` to `writer`, retrying short writes until every byte is written.
///
/// Throws `.write` when `writer` accepts 0 bytes or reports more bytes than offered.
+ fn write_all(writer: Writer, data: local &[u8]) !IoError {
    let view = data
    while view.length > 0 {
        let written = writer.write(view) !>
        if written == 0 || written > view.length : throw .write
        view = view.view(written, view.length - written)
    }
}

/// Fills all of `buf` from `reader`, retrying short reads until every byte is read.
///
/// Throws `.closed` if the input ends before `buf` is full, and `.read` if `reader` reports
/// more bytes than requested.
+ fn read_exact(reader: Reader, buf: local mut &[u8]) !IoError {
    let view = buf
    while view.length > 0 {
        let count = reader.read(view) !>
        if count == 0 : throw .closed
        if count > view.length : throw .read
        view = view.view(count, view.length - count)
    }
}

/// Reads `reader` until it is exhausted and returns everything read.
///
/// Reads `chunk_size` bytes at a time. A `.closed` error from the reader counts as the end of
/// input.
+ fn read_all(reader: Reader, chunk_size: uint (65536)) ByteBuffer !IoError {
    let out = ByteBuffer.new()
    copy(reader, out, chunk_size) !>
    return out
}

/// Copies `reader` into `writer` until the reader is exhausted and returns the bytes copied.
///
/// Short writes are continued until each chunk is written; a write of 0 bytes throws `.write`.
/// A `.closed` error from the reader counts as the end of input. Reads `chunk_size` bytes at a
/// time.
+ fn copy(reader: Reader, writer: Writer, chunk_size: uint (65536)) uint !IoError {
    let buf = [u8]{ 0 x chunk_size == 0 ? 1 : chunk_size }
    let total: uint = 0
    while true {
        let count = reader.read(buf) ! {
            if error_is(E.code, closed) : break
            throw E
        }
        if count == 0 : break
        if count > buf.length : count = buf.length
        write_all(writer, buf.view(0, count)) !>
        total += count
    }
    return total
}

/// Copies up to `limit` bytes from `reader` into `writer` and returns the bytes copied.
///
/// Stops early and returns fewer than `limit` bytes when `reader` reaches the end of input
/// (or throws `.closed`). Short writes are continued; a write of 0 bytes throws `.write`.
+ fn copy_n(reader: Reader, writer: Writer, limit: uint, chunk_size: uint (65536)) uint !IoError {
    if limit == 0 : return 0
    let cap = chunk_size == 0 ? 1 : chunk_size
    if cap > limit : cap = limit
    let buf = [u8]{ 0 x cap }
    let total: uint = 0
    while total < limit {
        let want = limit - total
        if want > buf.length : want = buf.length
        let count = reader.read(buf.view(0, want)) ! {
            if error_is(E.code, closed) : break
            throw E
        }
        if count == 0 : break
        if count > want : count = want
        write_all(writer, buf.view(0, count)) !>
        total += count
    }
    return total
}

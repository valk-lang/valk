#if OS == "linux"
use ext
use mem

value EPOLL_CTL_ADD (1)
value EPOLL_CTL_DEL (2)
value EPOLL_CTL_MOD (3)
value EPOLLIN (1)
value EPOLLOUT (4)
value EPOLLERR (8)
value EPOLLHUP (16)
value EPOLLRDHUP (8192)
value EPOLLONESHOT (1 << 30)
value EPOLLET (1 << 31)
value EPOLL_CLOEXEC (0x80000)
// A C `struct epoll_event`: u32 events, then 8 bytes of user data. Packed on x86-64 only;
// elsewhere the data is aligned to 8 bytes
#if ARCH == "x64"
value EPOLL_EVENT_SIZE (12)
value EPOLL_DATA_OFFSET (4)
#else
value EPOLL_EVENT_SIZE (16)
value EPOLL_DATA_OFFSET (8)
#end

// One `epoll_ctl` on the set `ep`; `data` comes back with the events of `fd`. Returns 0, or
// the error number
fn epoll_change(ep: i32, op: i32, fd: Fd, events: u32, data: uint) i32 {
    @unsafe
    let event: [u8 x EPOLL_EVENT_SIZE] = { 0 ... }
    let mask = events
    let value = data
    mem.copy_bytes(@ref(mask), @ref(event[0]), 4)
    mem.copy_bytes(@ref(value), @ref(event[EPOLL_DATA_OFFSET]), size_of(uint))
    if ext.epoll_ctl(ep, op, fd, @ref(event[0])) == 0 : return 0
    return ext.get_errno()
}

#if !URING
fn use_epoll_backend() bool $inline {
    return true
}
#else
// Whether this thread waits with epoll instead of io_uring: set on first check (`uring` sets
// 1 on success and 2 when the kernel refuses or cannot allocate a ring)
global backend_state: u8 (0)
shared uring_blocked: bool (false)
#if TEST
shared force_epoll_for_test: bool (false)
#end

fn use_epoll_backend() bool $inline {
    let state = backend_state
    if state != 0 : return state == 2
    return init_linux_backend()
}

fn init_linux_backend() bool {
    uring() ! return true
    return false
}
#end

#if TEST
/// Test hook: forces newly initialized threads to fall back from io_uring to epoll.
+ fn set_force_epoll_for_test(force: bool) {
    #if URING
    force_epoll_for_test = force
    if !force : uring_blocked = false
    #end
}

/// Test hook: returns whether this thread uses the epoll backend.
+ fn is_epoll_backend_for_test() bool {
    return use_epoll_backend()
}
#end

// The epoll set of this thread, which its event loop waits in (see coro/coro-epoll.valk)
global epoll_fd: i32 (-1)
// The event data of the thread's wake descriptor (see coro/park.valk); a waited descriptor
// carries its own number
value EPOLL_HOME (1 << 32)
// epoll_pwait2, Linux 5.11: a wait with a limit in nanoseconds
value SYS_EPOLL_PWAIT2 (441)
shared epoll_wait_ms_only: bool (false)

fn epoll() i32 {
    let fd = epoll_fd
    if fd >= 0 : return fd
    fd = ext.epoll_create1(EPOLL_CLOEXEC)
    if fd < 0 : panic("Failed to create the coroutine epoll set")
    epoll_fd = fd
    return fd
}

fn epoll_close() {
    let fd = epoll_fd
    if fd < 0 : return
    close_cleanup(fd, __FILE__, __LINE__)
    epoll_fd = -1
}

// Arms `fd` in this thread's set for one event out of `events`: after it the descriptor stays
// in the set, disabled, until it is armed again or closes. `add` puts it in the set, otherwise
// it is in there already. Returns 0, or the error number: ENOENT when it is not in the set,
// EEXIST when it is
fn epoll_arm(fd: Fd, events: u32, add: bool) i32 {
    return epoll_change(epoll(), add ? EPOLL_CTL_ADD : EPOLL_CTL_MOD, fd, events | EPOLLONESHOT, fd.to(uint))
}

// Waits for events of this thread's set for at most `ns` nanoseconds (uint.$max: no limit)
// and returns how many it put in `events`, or -1
fn epoll_wait_ns(events: ptr, max: i32, ns: uint) i32 {
    @unsafe
    let ep = epoll()
    if ns == 0 : return ext.epoll_wait(ep, events, max, 0)
    if ns == uint.$max : return ext.epoll_wait(ep, events, max, -1)
    if !epoll_wait_ms_only {
        let limit = ext.libc_timespec { tv_sec: (ns / 1_000_000_000).to(int), tv_nsec: (ns % 1_000_000_000).to(int) }
        let count = ext.syscall(SYS_EPOLL_PWAIT2, ep.to(int), events, max.to(int), @ref(limit).@cast(ptr), 0, 0)
        if count >= 0 : return count.to(i32)
        let error = ext.get_errno()
        // An older kernel, or a sandbox that does not know the call
        if error != ext.ENOSYS && error != ext.EPERM : return -1
        epoll_wait_ms_only = true
    }
    // Whole milliseconds, rounded up: a timer never fires early
    let ms = ns / 1_000_000
    if ns % 1_000_000 > 0 : ms++
    if ms > 2_000_000_000 : ms = 2_000_000_000
    return ext.epoll_wait(ep, events, max, ms.to(i32))
}
#end

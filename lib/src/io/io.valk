use ext
use coro
use core
use mem

+ enum Mode {
    text
    binary
}

+ fn set_mode(fd: Fd, mode: Mode) !IoError {
    #if OS == "win"
    let result = 0
    if mode == Mode.text {
        result = ext._setmode(fd.to(i32), ext.O_TEXT)
    } else if mode == Mode.binary {
        result = ext._setmode(fd.to(i32), ext.O_BINARY)
    }
    if result == -1 : throw .os
    #end
}

// Read
+ fn read(fd: Fd, buf: ByteBuffer, amount: uint, offset: uint) uint !IoError {
    @unsafe
    buf.reserve(amount)
    let res = read_bytes(fd, buf.data.@offset(buf.length), amount, offset) !>
    buf.advance(res)
    return res
}
+ fn read_bytes_sync(fd: Fd, buf: ptr, amount: uint, offset: uint) uint !IoError $unsafe {
    while true {
        let rcvd = ext.read(fd.to(i32), buf, amount.to(u32))
        if rcvd >= 0 : return rcvd
        #if OS != "win"
        if ext.get_errno() == ext.EINTR : continue
        #end
        throw .read
    }
}
+ fn read_bytes(fd: Fd, buf: ptr, amount: uint, offset: uint) uint !IoError $unsafe {
    @unsafe
    let coro = coro.current_coro
    if !isset(coro) : return read_bytes_sync(fd, buf, amount, offset) !>

    #if OS == "linux"
    let sqe = sqe(coro) ! throw .os
    io_uring_prep_read(sqe, fd, buf, amount.to(u32), offset)

    #elif OS == "win"
    let ov = overlap()
    ov.buflen = amount
    ov.buf = buf
    ov.base.sys.Offset = (offset & 0xFFFFFFFF).to(u32)
    ov.base.sys.OffsetHigh = (offset >> 32).to(u32)

    let ok = ext.ReadFile(fd, buf, amount.to(u32), null, ov.@cast(ptr))
    if ok == 0 {
        let error = ext.GetLastError()
        if error == ext.ERROR_HANDLE_EOF : return 0
        if error != ext.ERROR_IO_PENDING : throw .read
    }
    coro.yield()

    ok = ext.GetOverlappedResult(fd, ov.@cast(ptr), @ref(ov.transferred), 1)
    if ok == 0 {
        if ext.GetLastError() == ext.ERROR_HANDLE_EOF : return 0
        throw .read
    }
    if ov.base.sys.Internal != 0 : throw .read

    let rcvd = ov.transferred
    return rcvd

    #elif OS == "macos"
    while true {
        let res = ext.read(fd, buf, amount.to(u32))
        if res < 0 {
            let error = ext.get_errno()
            if error == ext.EINTR : continue
            if error == ext.EAGAIN {
                let ev = await_fd(fd, true, false)
                if !ev.is_readable() : throw .read
                continue
            }
            throw .read
        }
        return res.to(uint)
    }
    return 0

    #elif OS == "bsd"
    let cb = aio()
    cb.fd = fd
    cb.offset = offset.to(i64)
    cb.buf = buf
    cb.len = amount.to(i64)

    let kq = kqueue()
    cb.sig.kq = kq
    cb.sig.kevent_flags = EV_ADD | EV_ENABLE | EV_ONESHOT
    cb.sig.notify = SIGEV_KEVENT

    if ext.aio_read(cb) != 0 {
        aio_free(cb)
        throw .read
    }

    #else
    #error "IO read: Unsupported OS"
    #end

    #if OS == "linux" || OS == "bsd"
    coro.yield()
    #if OS == "bsd"
    let rcvd = ext.aio_return(cb)
    aio_free(cb)
    #else
    let rcvd = coro.completion_res
    #end
    if rcvd < 0 : throw .read
    return rcvd.to(uint)
    #end
}

// Write
+ fn write[T](fd: Fd, data: ByteView[T]) uint !IoError $inline {
    @unsafe
    return write_bytes(fd, data.data, data.bytes) !>
}
+ fn write_string(fd: Fd, str: String) uint !IoError $inline {
    return write[String](fd, str.view(0, str.bytes)) !>
}
+ fn write_buffer(fd: Fd, buf: ByteBuffer, amount: uint) uint !IoError $inline {
    return write[ByteBuffer](fd, buf.view(0, amount)) !>
}
+ fn write_bytes_sync(fd: Fd, buf: ptr, amount: uint) uint !IoError $unsafe {
    while true {
        let sent = ext.write(fd.to(i32), buf, amount.to(u32))
        if sent >= 0 : return sent
        #if OS != "win"
        if ext.get_errno() == ext.EINTR : continue
        #end
        throw .write
    }
}
+ fn write_bytes(fd: Fd, buf: ptr, amount: uint) uint !IoError $unsafe {
    @unsafe
    let coro = coro.current_coro

    #if OS == "linux"
    if !isset(coro) {
        let sent = ext.write(fd, buf, amount.to(u32))
        if sent < 0 : throw .write
        return sent
    }
    //
    let sqe = sqe(coro) ! throw .os
    io_uring_prep_write(sqe, fd, buf, amount.to(u32), -1)
    coro.yield()
    let sent = coro.completion_res
    if sent < 0 : throw .write
    return sent.to(uint)

    #elif OS == "win"

    let ov = overlap()
    ov.buflen = amount
    ov.buf = buf
    ov.base.sys.Offset = 0xFFFFFFFF
    ov.base.sys.OffsetHigh = 0xFFFFFFFF

    let ok = ext.WriteFile(fd, buf, amount.to(u32), null, ov.@cast(ptr))
    if ok == 0 && ext.GetLastError() != ext.ERROR_IO_PENDING {
        throw .write
    }
    coro.yield()

    ok = ext.GetOverlappedResult(fd, ov.@cast(ptr), @ref(ov.transferred), 1)
    if ok == 0 || ov.base.sys.Internal != 0 {
        throw .write
    }

    let sent = ov.transferred
    return sent

    #elif OS == "macos"
    while true {
        let sent = ext.write(fd, buf, amount.to(u32))
        if sent >= 0 : return sent.to(uint)
        if ext.get_errno() != ext.EINTR : throw .write
    }

    #else
    #error "IO write: Unsupported OS"
    #end
}

#if OS == "macos"
fn cancel_kqueue_wait_events(kq: i32, current: coro.Coro) {
    @unsafe
    let remove: ext.kEvent = @undefined
    if current.io_wait_read_armed {
        current.io_wait_read_armed = false
        EV_SET(&remove, current.io_wait_fd, EVFILT_READ, EV_DELETE, 0, 0, current.@cast(ptr))
        kqueue_change(kq, &remove)
        current.disarm_kernel_event()
    }
    if current.io_wait_write_armed {
        current.io_wait_write_armed = false
        EV_SET(&remove, current.io_wait_fd, EVFILT_WRITE, EV_DELETE, 0, 0, current.@cast(ptr))
        kqueue_change(kq, &remove)
        current.disarm_kernel_event()
    }
    if current.io_wait_timer_armed {
        current.io_wait_timer_armed = false
        EV_SET(&remove, current.io_timer_ident, EVFILT_TIMER, EV_DELETE, 0, 0, current.@cast(ptr))
        kqueue_change(kq, &remove)
        current.disarm_kernel_event()
    }
}
#end

+ fn await_fd(fd: Fd, read: bool, write: bool, timeout_ms: uint (0)) PollEvent {
    @unsafe
    if !read && !write : return 0

    let coro = coro.current_coro
    if !isset(coro) {
        panic("Polling outside coroutine")
    }

    #if OS == "linux"
    let sqe = sqe(coro) ! return ext.POLLERR
    let events: u32 = ext.POLLERR | ext.POLLHUP | ext.POLLRDHUP
    if read : events = events | ext.POLLIN
    if write : events = events | ext.POLLOUT
    io_uring_prep_poll_add(sqe, fd, events)
    link_timeout(coro, sqe, timeout_ms) ! return ext.POLLERR

    #elif OS == "macos"
    let kq = kqueue()
    let ev: ext.kEvent = @undefined
    coro.io_wait_active = true
    coro.io_wait_timed_out = false
    coro.io_wait_fd = fd
    coro.io_wait_read_armed = false
    coro.io_wait_write_armed = false
    coro.io_wait_timer_armed = false
    coro.poll_event = 0

    if read {
        coro.arm_kernel_event()
        EV_SET(&ev, fd, EVFILT_READ, EV_ADD | EV_ENABLE | EV_ONESHOT, 0, 0, coro.event_id().@cast(ptr));
        if !kqueue_change(kq, &ev) {
            coro.disarm_kernel_event()
            coro.io_wait_active = false
            return ext.POLLERR
        }
        coro.io_wait_read_armed = true
    }
    if write {
        coro.arm_kernel_event()
        EV_SET(&ev, fd, EVFILT_WRITE, EV_ADD | EV_ENABLE | EV_ONESHOT, 0, 0, coro.event_id().@cast(ptr));
        if !kqueue_change(kq, &ev) {
            coro.disarm_kernel_event()
            coro.io_wait_active = false
            cancel_kqueue_wait_events(kq, coro)
            return ext.POLLERR
        }
        coro.io_wait_write_armed = true
    }

    if timeout_ms > 0 {
        coro.io_timer_ident = coro.timer_id++
        coro.arm_kernel_event()
        EV_SET(&ev, coro.io_timer_ident, EVFILT_TIMER, EV_ADD | EV_ENABLE | EV_ONESHOT, 0, timeout_ms.to(i64), (coro.event_id() | 1).@cast(ptr))
        if !kqueue_change(kq, &ev) {
            coro.disarm_kernel_event()
            coro.io_wait_active = false
            cancel_kqueue_wait_events(kq, coro)
            return ext.POLLERR
        }
        coro.io_wait_timer_armed = true
    }

    #elif OS == "win"
    if read && write {
        let read_ov = overlap()
        let write_ov = overlap()
        read_ov.base.event = ext.POLLIN
        write_ov.base.event = ext.POLLOUT

        let read_ok = ext.ReadFile(fd, null, 0, null, read_ov.@cast(ptr))
        if read_ok == 0 && ext.GetLastError() != ext.ERROR_IO_PENDING : return ext.POLLERR
        let write_ok = ext.WriteFile(fd, null, 0, null, write_ov.@cast(ptr))
        if write_ok == 0 && ext.GetLastError() != ext.ERROR_IO_PENDING {
            cancel_overlap(fd, read_ov.@cast(ptr), coro)
            return ext.POLLERR
        }
        return await_overlaps(fd, read_ov.@cast(ptr), write_ov.@cast(ptr), coro)
    }

    let ov = overlap()
    let ok: ext.BOOL = 0
    if read {
        ov.base.event = ext.POLLIN
        ok = ext.ReadFile(fd, null, 0, null, ov.@cast(ptr))
    } else {
        ov.base.event = ext.POLLOUT
        ok = ext.WriteFile(fd, null, 0, null, ov.@cast(ptr))
    }
    if ok == 0 && ext.GetLastError() != ext.ERROR_IO_PENDING : return ext.POLLERR

    #else
    #error "IO poll: Unsupported OS"
    #end

    #if OS == "win"
    if await_overlap(fd, ov.@cast(ptr), coro, timeout_ms) : return POLL_TIMEOUT
    #else
    coro.yield()
    #end

    #if OS == "macos"
    coro.io_wait_active = false
    cancel_kqueue_wait_events(kq, coro)
    if coro.io_wait_timed_out : return POLL_TIMEOUT
    #end
    return coro.poll_event
}

#if TEST && OS == "linux"
+ fn await_fd_timeout_for_test(timeout_ms: uint) bool {
    @unsafe
    let pipe: [i32 x 2] = { -1... }
    if ext.pipe(@ref(pipe)) != 0 : return false
    let event = await_fd(pipe[0], true, false, timeout_ms)
    close_cleanup(pipe[0], __FILE__, __LINE__)
    close_cleanup(pipe[1], __FILE__, __LINE__)
    return event.is_timeout()
}
#end

#if TEST && OS == "macos"
+ fn prepare_no_timeout_timer_collision_for_test() {
    let current = coro.current_coro
    if !isset(current) : panic("Testing a kqueue wait outside a coroutine")
    // The next sleep timer will receive this identifier. A no-timeout wait
    // must not attempt to delete it merely because the stale value matches.
    current.io_timer_ident = coro.timer_id
}
#end

+ fn await_socket_fd(fd: Fd, read: bool, write: bool, timeout_ms: uint (0)) PollEvent {
    @unsafe
    #if OS != "win"
    return await_fd(fd, read, write, timeout_ms)
    #else

    if !read && !write : return 0

    let coro = coro.current_coro
    if !isset(coro) {
        panic("Polling outside coroutine")
    }

    if read && write {
        let read_ov = overlap()
        let write_ov = overlap()
        read_ov.buf = null
        read_ov.base.socket_read = true
        read_ov.base.fd = fd
        write_ov.buf = null
        read_ov.base.event = ext.POLLIN
        write_ov.base.event = ext.POLLOUT

        let read_res = ext.WSARecv(fd, @ref(read_ov.buflen), 1, null, @ref(read_ov.flags), read_ov.@cast(ptr), null)
        if read_res == ext.SOCKET_ERROR && socket_io_failed() : return ext.POLLERR
        let write_res = ext.WSASend(fd, @ref(write_ov.buflen), 1, null, 0, write_ov.@cast(ptr), null)
        if write_res == ext.SOCKET_ERROR && socket_io_failed() {
            cancel_overlap(fd, read_ov.@cast(ptr), coro)
            return ext.POLLERR
        }
        return await_overlaps(fd, read_ov.@cast(ptr), write_ov.@cast(ptr), coro)
    }

    if read {
        let ov = overlap()
        ov.buf = null
        ov.base.socket_read = true
        ov.base.fd = fd
        ov.base.event = ext.POLLIN
        let res = ext.WSARecv(fd, @ref(ov.buflen), 1, null, @ref(ov.flags), ov.@cast(ptr), null)
        if res == ext.SOCKET_ERROR && socket_io_failed() : return ext.POLLERR
        if await_overlap(fd, ov.@cast(ptr), coro, timeout_ms) : return POLL_TIMEOUT
        return coro.poll_event
    } else {
        let ov = overlap()
        ov.buf = null
        ov.base.event = ext.POLLOUT
        let res = ext.WSASend(fd, @ref(ov.buflen), 1, null, 0, ov.@cast(ptr), null)
        if res == ext.SOCKET_ERROR && socket_io_failed() : return ext.POLLERR
        if await_overlap(fd, ov.@cast(ptr), coro, timeout_ms) : return POLL_TIMEOUT
        return coro.poll_event
    }
    #end
}

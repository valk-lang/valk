use core

// Reads a `Reader` line by line, buffering its input. Any reader works:
// `io.LineReader.new(io.stdin())`, a `fs.FileStream` or a `ByteReader`
+ class LineReader {
    - reader: Reader
    - chunk: &mut [u8]
    - start: uint (0)
    - end: uint (0)

    + static fn new(reader: Reader, chunk_size: uint (65536)) SELF {
        return SELF { reader: reader, chunk: [u8]{ 0 x chunk_size == 0 ? 1 : chunk_size } }
    }

    // The next line without its `\n` or `\r\n`; null once the input is exhausted
    + fn read_line() ?String !IoError {
        let line = this.read_until('\n') !>
        if !isset(line) : return null
        let len = line.bytes
        if len > 0 && line[len - 1] == '\r' : return line.range(0, len - 1)
        return line
    }

    // Bytes up to and excluding the next `delimiter`; the input's final
    // bytes are returned as-is when no delimiter follows them
    + fn read_until(delimiter: u8) ?String !IoError {
        let out = ByteBuffer.new()
        while true {
            let i = this.start
            while i < this.end {
                if this.chunk[i] == delimiter {
                    out.write(this.chunk.view(this.start, i - this.start))
                    this.start = i + 1
                    return out
                }
                i++
            }
            out.write(this.chunk.view(this.start, this.end - this.start))
            this.start = 0
            this.end = 0
            let count = this.reader.read(this.chunk) ! {
                if error_is(E.code, closed) : break
                throw E
            }
            if count == 0 : break
            this.end = count
        }
        if out.length == 0 : return null
        return out
    }

    // Every remaining line
    + fn lines() Array[String] !IoError {
        let result = Array[String]{}
        while true {
            let line = this.read_line() !>
            if !isset(line) : break
            result.append(line)
        }
        return result
    }
}

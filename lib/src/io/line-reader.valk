use core

/// Reads a `Reader` line by line, buffering its input.
///
/// Any reader works: `io.LineReader.new(io.stdin())`, a `fs.FileStream` or a `ByteReader`.
+ class LineReader {
    - reader: Reader
    - chunk: mut &[u8]
    - start: uint (0)
    - end: uint (0)
    // Whether the last read_until stopped at its delimiter rather than at the end
    - terminated: bool (false)

    /// Creates a line reader over `reader` that reads `chunk_size` bytes at a time.
    + static fn new(reader: Reader, chunk_size: uint (65536)) SELF {
        return SELF { reader: reader, chunk: [u8]{ 0 x chunk_size == 0 ? 1 : chunk_size } }
    }

    /// Returns the next line without its `\n` or `\r\n`, or `null` once the input is exhausted.
    ///
    /// A final line without a newline is returned as well; a newline at the very end does not
    /// produce an extra empty line. The `\r` of a `\r\n` is only dropped when the `\n` was
    /// there: without it the line keeps its last byte, as `read_until` promises.
    + fn read_line() ?String !IoError {
        let line = this.read_until('\n') !>
        if !isset(line) : return null
        let len = line.bytes
        if this.terminated && len > 0 && line[len - 1] == '\r' : return line.range(0, len - 1)
        return line
    }

    /// Returns the bytes up to, not including, the next `delimiter`, or `null` at the end.
    ///
    /// The input's final bytes are returned as-is when no delimiter follows them. A `.closed`
    /// error from the reader counts as the end of input.
    + fn read_until(delimiter: u8) ?String !IoError {
        let out = ByteBuffer.new()
        this.terminated = false
        while true {
            let i = this.start
            while i < this.end {
                if this.chunk[i] == delimiter {
                    out.write(this.chunk.view(this.start, i - this.start))
                    this.start = i + 1
                    this.terminated = true
                    return out.into_string()
                }
                i++
            }
            out.write(this.chunk.view(this.start, this.end - this.start))
            this.start = 0
            this.end = 0
            let count = this.reader.read(this.chunk) ! {
                if error_is(E.code, closed) : break
                throw E
            }
            if count == 0 : break
            // The reader's contract caps the count at the buffer, but the buffer is
            // this class's memory: clamp rather than trust it
            if count > this.chunk.length : count = this.chunk.length
            this.end = count
        }
        if out.length == 0 : return null
        return out.into_string()
    }

    /// Returns every remaining line, split as `read_line` does.
    + fn lines() Array[String] !IoError {
        let result = Array[String]{}
        while true {
            let line = this.read_line() !>
            if !isset(line) : break
            result.append(line)
        }
        return result
    }
}

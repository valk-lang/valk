use core

/// Reads a `Reader` line by line, buffering its input.
///
/// Any reader works: `io.LineReader.new(io.stdin())`, a `fs.FileStream` or a `ByteReader`.
+ class LineReader {
    - reader: Reader
    - chunk: mut &[u8]
    - start: uint (0)
    - end: uint (0)
    // Whether the last read_until stopped at its delimiter rather than at the end
    - terminated: bool (false)

    /// Creates a line reader over `reader` that reads `chunk_size` bytes at a time.
    + static fn new(reader: Reader, chunk_size: uint (65536)) SELF {
        return SELF { reader: reader, chunk: [u8]{ 0 x chunk_size == 0 ? 1 : chunk_size } }
    }

    /// Returns the next line without its `\n` or `\r\n`, or `null` once the input is exhausted.
    ///
    /// A final line without a newline is returned as well; a newline at the very end does not
    /// produce an extra empty line. The `\r` of a `\r\n` is only dropped when the `\n` was
    /// there: without it the line keeps its last byte, as `read_until` promises.
    + fn read_line() ?String !IoError {
        let out = ByteBuffer.new()
        let count = this.read_until_to('\n', out, true) !>
        if !isset(count) : return null
        return out.into_string()
    }

    /// Writes the next line to `out` as `read_line` returns it and returns the bytes written,
    /// or `null` once the input is exhausted.
    ///
    /// An empty line writes nothing and returns 0. Throws when the reader or `out` fails;
    /// bytes written to `out` before a failure stay written.
    + fn read_line_into(out: Writer) ?uint !IoError {
        return this.read_until_to('\n', out, true) !>
    }

    /// Returns the bytes up to, not including, the next `delimiter`, or `null` at the end.
    ///
    /// The input's final bytes are returned as-is when no delimiter follows them. A `.closed`
    /// error from the reader counts as the end of input.
    + fn read_until(delimiter: u8) ?String !IoError {
        let out = ByteBuffer.new()
        let count = this.read_until_to(delimiter, out, false) !>
        if !isset(count) : return null
        return out.into_string()
    }

    /// Writes the bytes up to, not including, the next `delimiter` to `out` and returns the
    /// bytes written, or `null` at the end of the input.
    ///
    /// The bytes reach `out` as the reader delivers them, so a long line never sits in memory
    /// as a whole. Throws when the reader or `out` fails.
    + fn read_until_into(delimiter: u8, out: Writer) ?uint !IoError {
        return this.read_until_to(delimiter, out, false) !>
    }

    // The one loop behind the four readers. `strip_cr` drops a `\r` right before the
    // delimiter; a `\r` at the end of a chunk is held back until the next byte shows
    // whether the delimiter follows it.
    fn read_until_to(delimiter: u8, out: Writer, strip_cr: bool) ?uint !IoError {
        let written: uint = 0
        let pending_cr = false
        this.terminated = false
        while true {
            let i = this.start
            while i < this.end {
                if this.chunk[i] == delimiter {
                    let segment = this.chunk.view(this.start, i - this.start)
                    if pending_cr && segment.length > 0 {
                        // The held `\r` was not the line's last byte after all
                        written += out.write("\r") !>
                        pending_cr = false
                    }
                    if strip_cr && segment.length > 0 && segment[segment.length - 1] == '\r' {
                        segment = segment.view(0, segment.length - 1)
                    }
                    if segment.length > 0 : written += out.write(segment) !>
                    this.start = i + 1
                    this.terminated = true
                    return written
                }
                i++
            }
            let segment = this.chunk.view(this.start, this.end - this.start)
            if segment.length > 0 {
                if pending_cr {
                    written += out.write("\r") !>
                    pending_cr = false
                }
                if strip_cr && segment[segment.length - 1] == '\r' {
                    pending_cr = true
                    segment = segment.view(0, segment.length - 1)
                }
                if segment.length > 0 : written += out.write(segment) !>
            }
            this.start = 0
            this.end = 0
            let count = this.reader.read(this.chunk) ! {
                if error_is(E.code, closed) : break
                throw E
            }
            if count == 0 : break
            // The reader's contract caps the count at the buffer, but the buffer is
            // this class's memory: clamp rather than trust it
            if count > this.chunk.length : count = this.chunk.length
            this.end = count
        }
        // No delimiter followed: a held `\r` is a real last byte
        if pending_cr : written += out.write("\r") !>
        if written == 0 && !pending_cr {
            // Nothing at all was read: the end of the input
            return null
        }
        return written
    }

    /// Returns every remaining line, split as `read_line` does.
    + fn lines() Array[String] !IoError {
        let result = Array[String]{}
        while true {
            let line = this.read_line() !>
            if !isset(line) : break
            result.append(line)
        }
        return result
    }
}

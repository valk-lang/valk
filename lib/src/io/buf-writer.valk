use mem

/// Buffers writes to an `io.Writer` so small writes are combined into larger chunks.
///
/// Call `flush` when finished writing to ensure all buffered bytes reach the underlying
/// writer.
+ class BufWriter is Writer {
    - writer: Writer
    - buf: mut &[u8]
    - length: uint (0)

    /// Creates a buffered writer over `writer` with an internal buffer of `capacity` bytes
    /// (at least 1).
    + static fn new(writer: Writer, capacity: uint (8192)) SELF {
        return SELF {
            writer: writer
            buf: [u8]{ 0 x capacity == 0 ? 1 : capacity }
        }
    }

    /// Number of bytes currently waiting in the buffer.
    + get buffered: uint {
        return this.length
    }

    /// Remaining free space in the buffer before the next flush.
    + get available: uint {
        return this.buf.length - this.length
    }

    /// Size of the internal buffer in bytes.
    + get capacity: uint {
        return this.buf.length
    }

    /// Returns the underlying writer.
    + fn inner() Writer {
        return this.writer
    }

    /// Switches to `writer` and discards any unflushed buffered bytes, reusing the buffer.
    + fn reset(writer: Writer) {
        this.writer = writer
        this.length = 0
    }

    /// Writes all buffered bytes to the underlying writer.
    ///
    /// If a write fails partway through, the remaining unwritten bytes stay at the front of
    /// the buffer so a later `flush` can retry them without duplicating already-sent bytes.
    + fn flush() !IoError {
        let written: uint = 0
        while written < this.length {
            let chunk = this.buf.view(written, this.length - written)
            let count = this.writer.write(chunk) ! {
                if written > 0 {
                    let rem = this.length - written
                    mem.move(this.buf.view(written, rem), this.buf.view(0, rem))
                    this.length = rem
                }
                throw E
            }
            if count == 0 || count > chunk.length {
                if written > 0 {
                    let rem = this.length - written
                    mem.move(this.buf.view(written, rem), this.buf.view(0, rem))
                    this.length = rem
                }
                throw .write
            }
            written += count
        }
        this.length = 0
    }

    /// Writes `data` into the buffer, flushing to the underlying writer when full.
    ///
    /// Returns `data.length`. Large writes bypass the buffer once pending data is flushed.
    + fn write(data: local &[u8]) uint !IoError {
        let total = data.length
        if total == 0 : return 0
        let view = data
        if view.length > this.available {
            if this.length > 0 {
                let fill = this.available
                if fill > 0 {
                    mem.copy(view.view(0, fill), this.buf.view(this.length, fill))
                    this.length += fill
                    view = view.view(fill, view.length - fill)
                }
                this.flush() !>
            }
            if view.length >= this.buf.length {
                write_all(this.writer, view) !>
                return total
            }
        }
        if view.length > 0 {
            mem.copy(view, this.buf.view(this.length, view.length))
            this.length += view.length
        }
        return total
    }

    /// Buffers a single byte, flushing first if the buffer is full.
    + fn write_byte(byte: u8) !IoError {
        if this.length == this.buf.length : this.flush() !>
        this.buf[this.length++] = byte
    }
}


use ext
use coro

#if OS == "win"
global cport_instance: ext:HANDLE
struct OverlapBase {
    sys: <ext:OVERLAPPED>
    coro: ?ptr
    event: PollEvent
    completed: bool
    cancel_requested: bool
    socket_read: bool
    fd: FD
}
class OverlapData {
    base: <OverlapBase>
}
// AcceptEx
class OverlapAcceptEx {
    base: <OverlapBase>
    socket: ext:SOCKET
    addressBuffer: [u8 x 128]
    bytesReceived: u32
}
// ConnectEx
class OverlapConnectEx {
    base: <OverlapBase>
    sent: u32
}
// Recv
class OverlapRecv {
    base: <OverlapBase>
    buflen: uint
    buf: ptr (@undefined)
    rcvd: u32
    flags: u32
}
// Send
class OverlapSend {
    base: <OverlapBase>
    buflen: uint
    buf: ptr (@undefined)
    sent: u32
}

fn iocp() ext:HANDLE {
    let p = cport_instance
    if p != 0 : return p
    let res = ext:CreateIoCompletionPort(ext:INVALID_HANDLE_VALUE, null, 0, 0)
    if res == 0 : panic("Failed to create IO Completion Port")
    cport_instance = res
    // ext:SetFileCompletionNotificationModes(res, ext:FILE_SKIP_COMPLETION_PORT_ON_SUCCESS)
    // ext:SetFileCompletionNotificationModes(res, ext:FILE_SKIP_SET_EVENT_ON_HANDLE)
    return res
}

fn iocp_close() {
    let p = cport_instance
    if p == 0 : return
    ext:CloseHandle(p)
    cport_instance = 0
}

fn overlap[T]() T {
    let current = coro:current_coro
    if !isset(current) : panic("Creating IOCP state outside a coroutine")
    let ov = T {}
    ov.base.coro = current
    current.iocp_ready = false
    current.poll_event = 0
    return ov
}

fn socket_io_failed() bool {
    return ext:WSAGetLastError() != ext:WSA_IO_PENDING
}

fn completion_event(ov: OverlapData, result: bool) PollEvent {
    if !result : return ext:POLLERR
    if !ov.base.socket_read : return ov.base.event
    let available: uint = 0
    if ext:ioctlsocket(ov.base.fd, ext:FIONREAD, @ref(available)) != 0 : return ext:POLLERR
    return available == 0 ? ext:POLLHUP : ov.base.event
}

fn associate(fd: FD) bool {
    return ext:CreateIoCompletionPort(fd, iocp(), 0, 0) != 0
}

fn cancel_overlap(fd: FD, ov: ptr, current: coro:Coro) {
    let data = ov.@cast(OverlapData)
    if data.base.completed : return
    data.base.cancel_requested = true
    ext:CancelIoEx(fd, data)
    while !data.base.completed {
        current.iocp_ready = false
        current.yield()
    }
}

fn await_overlaps(fd: FD, first: ptr, second: ptr, current: coro:Coro) PollEvent {
    current.yield()
    cancel_overlap(fd, first, current)
    cancel_overlap(fd, second, current)
    return current.poll_event
}

#end

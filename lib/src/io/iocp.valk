use ext
use coro
use mem

#if OS == "win"
global cport_instance: ext:HANDLE
struct OverlapBase {
    sys: ext:OVERLAPPED
    // Raw pointer to the coroutine that owns this overlap. The coroutine is
    // rooted by 'coro:g_coros' and owns the overlap itself, so it always
    // outlives it. Keeping it raw makes 'Overlap' free of managed fields.
    coro: ptr (null.@cast(ptr))
    event: PollEvent
    completed: bool
    cancel_requested: bool
    socket_read: bool
    // Set while the kernel still owns this overlap, cleared by the coroutine
    // loop when the completion packet is dequeued. Reusing an overlap is only
    // safe once that happened.
    in_use: bool
    fd: FD
}

// A single overlap type for every operation: a coroutine keeps two of these
// and hands them out again, so an IO call does not allocate. That only works
// when one slot fits every use, hence the shared field set.
// 'buflen' + 'buf' double as the WSABUF given to WSARecv/WSASend, so they must
// stay adjacent and in this order.
class Overlap {
    base: OverlapBase
    // WSABUF
    buflen: uint
    buf: ?ptr
    // Recv / Send / ConnectEx result
    transferred: u32
    flags: u32
    // AcceptEx
    addressBuffer: [u8 x 128]
}

fn iocp() ext:HANDLE {
    let p = cport_instance
    if p != 0 : return p
    let res = ext:CreateIoCompletionPort(ext:INVALID_HANDLE_VALUE, 0, 0, 0)
    if res == 0 : panic("Failed to create IO Completion Port")
    cport_instance = res
    return res
}

fn iocp_close() {
    let p = cport_instance
    if p == 0 : return
    ext:CloseHandle(p)
    cport_instance = 0
}

fn overlap() Overlap {
    let current = coro:current_coro
    if !isset(current) : panic("Creating IOCP state outside a coroutine")
    let ov = current.take_overlap()

    mem:clear(&ov.base.sys, size_of(ext:OVERLAPPED))
    ov.base.coro = current.@cast(ptr)
    ov.base.event = 0
    ov.base.completed = false
    ov.base.cancel_requested = false
    ov.base.socket_read = false
    ov.base.in_use = true
    ov.base.fd = 0
    ov.buflen = 0
    ov.buf = null
    ov.transferred = 0
    ov.flags = 0

    current.iocp_ready = false
    current.poll_event = 0
    return ov
}

// Wake a coroutine that is parked on 'port', which may belong to another
// thread. The coroutine travels as the completion key instead of inside an
// OVERLAPPED, so waking never allocates.
fn wake_coro(port: ext:HANDLE, target: ptr) bool {
    return ext:PostQueuedCompletionStatus(port, 0, target.@cast(uint), null)
}

fn socket_io_failed() bool {
    return ext:WSAGetLastError() != ext:WSA_IO_PENDING
}

fn completion_event(ov: Overlap, result: bool) PollEvent {
    if !result : return ext:POLLERR
    if !ov.base.socket_read : return ov.base.event
    let available: uint = 0
    if ext:ioctlsocket(ov.base.fd, ext:FIONREAD, @ref(available)) != 0 : return ext:POLLERR
    return available == 0 ? ext:POLLHUP : ov.base.event
}

fn associate(fd: FD) bool {
    return ext:CreateIoCompletionPort(fd, iocp(), 0, 0) != 0
}

fn cancel_overlap(fd: FD, ov: ptr, current: coro:Coro) {
    let data = ov.@cast(Overlap)
    if data.base.completed : return
    data.base.cancel_requested = true
    ext:CancelIoEx(fd, data.@cast(ptr))
    while !data.base.completed {
        current.iocp_ready = false
        current.yield()
    }
}

fn await_overlaps(fd: FD, first: ptr, second: ptr, current: coro:Coro) PollEvent {
    current.yield()
    cancel_overlap(fd, first, current)
    cancel_overlap(fd, second, current)
    return current.poll_event
}

#end

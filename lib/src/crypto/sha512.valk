use mem

// SHA-512 and SHA-384 (FIPS 180-4)

fn ROTR64(x: u64, n: u64) u64 $inline { return (x >> n) | (x << (64 - n)) }
fn CH64(x: u64, y: u64, z: u64) u64 $inline { return (x & y) ^ (~x & z) }
fn MAJ64(x: u64, y: u64, z: u64) u64 $inline { return (x & y) ^ (x & z) ^ (y & z) }
fn EP0_64(x: u64) u64 $inline { return ROTR64(x, 28) ^ ROTR64(x, 34) ^ ROTR64(x, 39) }
fn EP1_64(x: u64) u64 $inline { return ROTR64(x, 14) ^ ROTR64(x, 18) ^ ROTR64(x, 41) }
fn SIG0_64(x: u64) u64 $inline { return ROTR64(x, 1) ^ ROTR64(x, 8) ^ (x >> 7) }
fn SIG1_64(x: u64) u64 $inline { return ROTR64(x, 19) ^ ROTR64(x, 61) ^ (x >> 6) }

// One round; the caller rotates the roles of a..h instead of moving the values
fn sha512_round(a: u64, b: u64, c: u64, d: local mut &u64, e: u64, f: u64, g: u64, h: local mut &u64, kw: u64) $inline {
    let t1 = h[0] + EP1_64(e) + CH64(e, f, g) + kw
    d[0] += t1
    h[0] = t1 + EP0_64(a) + MAJ64(a, b, c)
}

// Hashes the 128-byte block at `data` into `state`
fn sha512_compress(state: local mut &[u64 x 8], data: *[u8]) {
    let w: [u64 x 16] = @undefined
    let i: uint = 0
    while i < 16 {
        w[i] = load_be64(data, i * 8)
        i++
    }

    let a = state[0]
    let b = state[1]
    let c = state[2]
    let d = state[3]
    let e = state[4]
    let f = state[5]
    let g = state[6]
    let h = state[7]

    // 16 rounds at a time; the message schedule is kept as a 16-word window
    let r: uint = 0
    while r < 80 {
        if r > 0 {
            i = 0
            while i < 16 {
                w[i] += SIG1_64(w[(i + 14) & 15]) + w[(i + 9) & 15] + SIG0_64(w[(i + 1) & 15])
                i++
            }
        }
        sha512_round(a, b, c, &d, e, f, g, &h, k512[r] + w[0])
        sha512_round(h, a, b, &c, d, e, f, &g, k512[r + 1] + w[1])
        sha512_round(g, h, a, &b, c, d, e, &f, k512[r + 2] + w[2])
        sha512_round(f, g, h, &a, b, c, d, &e, k512[r + 3] + w[3])
        sha512_round(e, f, g, &h, a, b, c, &d, k512[r + 4] + w[4])
        sha512_round(d, e, f, &g, h, a, b, &c, k512[r + 5] + w[5])
        sha512_round(c, d, e, &f, g, h, a, &b, k512[r + 6] + w[6])
        sha512_round(b, c, d, &e, f, g, h, &a, k512[r + 7] + w[7])
        sha512_round(a, b, c, &d, e, f, g, &h, k512[r + 8] + w[8])
        sha512_round(h, a, b, &c, d, e, f, &g, k512[r + 9] + w[9])
        sha512_round(g, h, a, &b, c, d, e, &f, k512[r + 10] + w[10])
        sha512_round(f, g, h, &a, b, c, d, &e, k512[r + 11] + w[11])
        sha512_round(e, f, g, &h, a, b, c, &d, k512[r + 12] + w[12])
        sha512_round(d, e, f, &g, h, a, b, &c, k512[r + 13] + w[13])
        sha512_round(c, d, e, &f, g, h, a, &b, k512[r + 14] + w[14])
        sha512_round(b, c, d, &e, f, g, h, &a, k512[r + 15] + w[15])
        r += 16
    }

    state[0] += a
    state[1] += b
    state[2] += c
    state[3] += d
    state[4] += e
    state[5] += f
    state[6] += g
    state[7] += h
}

global k512: [u64 x 80] ({
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc, 0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2, 0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65, 0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4, 0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df, 0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30, 0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8, 0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec, 0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178, 0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c, 0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
})

/// A streaming SHA-512 or SHA-384 `Hasher`.
///
/// A literal `Sha512 {}` computes SHA-512; `Sha512.sha384()` returns one that computes SHA-384.
+ class Sha512 is Hasher, KeyedHasher {
    data: [u8 x 128] ({ 0... })
    datalen: uint (0)
    total: u64 (0)
    bits: uint (512)
    state: [u64 x 8] ({ 0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1, 0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179 })

    /// Returns a hasher that computes SHA-384.
    + static fn sha384() SELF {
        let h = SELF { bits: 384 }
        h.reset()
        return h
    }

    /// Returns the hasher to its initial state for its variant, discarding all input fed so far.
    + fn reset() {
        if this.bits == 384 {
            this.state = { 0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939, 0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4 }
        } else {
            this.state = { 0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1, 0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179 }
        }
        this.datalen = 0
        this.total = 0
    }

    /// Returns the digest size in bytes: 64 for SHA-512, 48 for SHA-384.
    + fn digest_size() uint { return this.bits / 8 }
    /// Returns 128, the SHA-512 block size in bytes.
    + fn block_size() uint { return 128 }

    /// Feeds more input into the hash.
    + fn update(data: local &[u8]) {
        @unsafe
        let length = data.length
        let i: uint = 0
        if this.datalen > 0 {
            i = 128 - this.datalen
            if i > length : i = length
            mem.copy_bytes(data.data, @ref(this.data).@offset(this.datalen), i)
            this.datalen += i
            if this.datalen < 128 {
                this.total += length.to(u64)
                return
            }
            sha512_compress(&this.state, @ref(this.data))
            this.datalen = 0
        }
        // Whole blocks are hashed where they are
        while length - i >= 128 {
            sha512_compress(&this.state, data.data.@offset(i))
            i += 128
        }
        this.datalen = length - i
        mem.copy_bytes(data.data.@offset(i), @ref(this.data), this.datalen)
        this.total += length.to(u64)
    }

    /// Writes the digest into `out` and returns its size in bytes.
    ///
    /// `out` must hold at least `digest_size()` bytes. Call `reset` before hashing new input.
    + fn finish(out: local mut &[u8]) uint {
        @unsafe
        let size = this.digest_size()
        if out.length < size : panic("Sha512.finish: the output buffer is shorter than the digest")
        let i = this.datalen
        this.data[i++] = 0x80
        if i > 112 {
            mem.clear_bytes(@ref(this.data).@offset(i), 128 - i)
            sha512_compress(&this.state, @ref(this.data))
            i = 0
        }
        // The 128-bit length: the high word is zero for any input we can hold
        mem.clear_bytes(@ref(this.data).@offset(i), 120 - i)
        store_be64(@ref(this.data), 120, this.total * 8)
        sha512_compress(&this.state, @ref(this.data))

        i = 0
        while i < size / 8 {
            store_be64(out.data, i * 8, this.state[i])
            i++
        }
        return size
    }

    // For Hmac: the state after a whole number of blocks
    fn save(to: local mut &[u64 x 8]) {
        let i: uint = 0
        while i < 8 {
            to[i] = this.state[i]
            i++
        }
    }

    fn restore(from: local &[u64 x 8], total: u64) {
        let i: uint = 0
        while i < 8 {
            this.state[i] = from[i]
            i++
        }
        this.datalen = 0
        this.total = total
    }
}

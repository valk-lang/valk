// HMAC (RFC 2104) over any `HashAlgorithm`

// A hasher whose state after the padded key block can be saved and restored, so a
// MAC does not hash that block again on every reset (PBKDF2 resets thousands of times)
interface KeyedHasher {
    fn update(data: local &[u8]);
    fn finish(out: local mut &[u8]) uint;
    // Copies the state after a whole number of blocks into `to`
    fn save(to: local mut &[u64 x 8]);
    // Continues from a state saved after `total` bytes
    fn restore(from: local &[u64 x 8], total: u64);
}

fn keyed_hasher(algorithm: HashAlgorithm) KeyedHasher {
    if algorithm == HashAlgorithm.md5 : return Md5 {}
    if algorithm == HashAlgorithm.sha1 : return Sha1 {}
    if algorithm == HashAlgorithm.sha256 : return Sha256 {}
    if algorithm == HashAlgorithm.sha384 : return Sha512.sha384()
    return Sha512 {}
}

/// A streaming HMAC (RFC 2104) over any `HashAlgorithm`, usable wherever a `Hasher` is.
+ class Hmac is Hasher {
    - inner: KeyedHasher
    - outer: KeyedHasher
    - inner_start: [u64 x 8]
    - outer_start: [u64 x 8]
    - size: uint
    - block: uint

    /// Returns an HMAC ready for input, keyed with `key`.
    ///
    /// A key longer than the hash's block size is hashed first, as the RFC specifies.
    + static fn new(algorithm: HashAlgorithm, key: local &[u8]) SELF {
        let inner = keyed_hasher(algorithm)
        let outer = keyed_hasher(algorithm)
        let block: uint = algorithm == HashAlgorithm.sha384 || algorithm == HashAlgorithm.sha512 ? 128 : 64
        let pad: [u8 x 128] = { 0... }
        // A key longer than a block is hashed first
        if key.length > block {
            hash_in(algorithm, key, &pad)
        } else {
            let i: uint = 0
            while i < key.length {
                pad[i] = key[i]
                i++
            }
        }
        let i: uint = 0
        while i < block {
            pad[i] = pad[i] ^ 0x36
            i++
        }
        inner.update(&pad[0 .. block])
        i = 0
        while i < block {
            pad[i] = pad[i] ^ (0x36 ^ 0x5c)
            i++
        }
        outer.update(&pad[0 .. block])
        let mac = SELF {
            inner: inner
            outer: outer
            inner_start: @undefined
            outer_start: @undefined
            size: digest_size(algorithm)
            block: block
        }
        inner.save(&mac.inner_start)
        outer.save(&mac.outer_start)
        return mac
    }

    /// Returns the raw MAC of `data` under `key` as binary bytes (not text).
    + static fn sign(algorithm: HashAlgorithm, key: local &[u8], data: local &[u8]) String {
        let mac = SELF.new(algorithm, key)
        mac.update(data)
        let out: [u8 x 64] = @undefined
        let size = mac.finish(&out)
        return bytes_to_string(&out[0 .. size])
    }

    /// Returns the MAC of `data` under `key` as lowercase hex.
    + static fn sign_hex(algorithm: HashAlgorithm, key: local &[u8], data: local &[u8]) String {
        let mac = SELF.new(algorithm, key)
        mac.update(data)
        let out: [u8 x 64] = @undefined
        let size = mac.finish(&out)
        return hex_encode(&out[0 .. size])
    }

    /// Returns whether `mac` is the raw MAC of `data` under `key`, compared in constant time.
    ///
    /// `mac` must be raw bytes; decode a hex MAC with `hex_decode` first.
    + static fn verify(algorithm: HashAlgorithm, key: local &[u8], data: local &[u8], mac: local &[u8]) bool {
        let h = SELF.new(algorithm, key)
        h.update(data)
        let out: [u8 x 64] = @undefined
        let size = h.finish(&out)
        return constant_time_equals(&out[0 .. size], mac)
    }

    /// Feeds more input into the MAC.
    + fn update(data: local &[u8]) {
        this.inner.update(data)
    }

    /// Writes the MAC into `out` and returns its size in bytes.
    ///
    /// `out` must hold at least `digest_size()` bytes. Call `reset` before computing another MAC
    /// with the same key.
    + fn finish(out: local mut &[u8]) uint {
        let digest: [u8 x 64] = @undefined
        let size = this.inner.finish(&digest)
        this.outer.restore(this.outer_start, this.block.to(u64))
        this.outer.update(&digest[0 .. size])
        return this.outer.finish(out)
    }

    /// Discards all input and starts a new MAC with the same key.
    + fn reset() {
        this.inner.restore(this.inner_start, this.block.to(u64))
    }

    /// Returns the MAC size in bytes, the digest size of the underlying hash.
    + fn digest_size() uint { return this.size }
    /// Returns the block size in bytes of the underlying hash.
    + fn block_size() uint { return this.block }
}

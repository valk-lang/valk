// HMAC (RFC 2104) over any `HashAlgorithm`

+ class Hmac is Hasher {
    - inner: Hasher
    - outer: Hasher
    - inner_key: String
    - outer_key: String
    - size: uint
    - block: uint

    + static fn new(algorithm: HashAlgorithm, key: &[u8]) SELF {
        let inner = hasher(algorithm)
        let outer = hasher(algorithm)
        let block = inner.block_size()
        let size = inner.digest_size()
        // A key longer than a block is hashed first
        let short_key: String = key.length > block ? hash(algorithm, key) : bytes_to_string(key)
        let ipad = ByteBuffer.new(block)
        let opad = ByteBuffer.new(block)
        let i: uint = 0
        while i < block {
            let k: u8 = i < short_key.length ? short_key[i] : 0
            ipad.write_byte(k ^ 0x36)
            opad.write_byte(k ^ 0x5c)
            i++
        }
        let mac = SELF {
            inner: inner
            outer: outer
            inner_key: ipad.to_string()
            outer_key: opad.to_string()
            size: size
            block: block
        }
        mac.reset()
        return mac
    }

    // The MAC of `data` as raw bytes
    + static fn sign(algorithm: HashAlgorithm, key: &[u8], data: &[u8]) String {
        let mac = SELF.new(algorithm, key)
        mac.update(data)
        let out = [u8]{ 0 x mac.size }
        mac.finish(out)
        return bytes_to_string(out)
    }

    + static fn sign_hex(algorithm: HashAlgorithm, key: &[u8], data: &[u8]) String {
        return hex_encode(SELF.sign(algorithm, key, data))
    }

    // Checks a raw MAC in constant time
    + static fn verify(algorithm: HashAlgorithm, key: &[u8], data: &[u8], mac: &[u8]) bool {
        return constant_time_equals(SELF.sign(algorithm, key, data), mac)
    }

    + fn update(data: &[u8]) {
        this.inner.update(data)
    }

    + fn finish(out: mut &[u8]) uint {
        let digest = [u8]{ 0 x this.size }
        this.inner.finish(digest)
        this.outer.reset()
        this.outer.update(this.outer_key)
        this.outer.update(digest)
        return this.outer.finish(out)
    }

    + fn reset() {
        this.inner.reset()
        this.inner.update(this.inner_key)
    }

    + fn digest_size() uint { return this.size }
    + fn block_size() uint { return this.block }
}

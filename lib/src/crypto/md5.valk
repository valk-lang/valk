use mem

fn md5_rotl(value: u32, amount: u32) u32 $inline {
    return (value << amount) | (value >> (32 - amount))
}

// The four round functions of RFC 1321
fn md5_ff(a: u32, b: u32, c: u32, d: u32, x: u32, s: u32, t: u32) u32 $inline { return b + md5_rotl(a + ((b & c) | (~b & d)) + x + t, s) }
fn md5_gg(a: u32, b: u32, c: u32, d: u32, x: u32, s: u32, t: u32) u32 $inline { return b + md5_rotl(a + ((b & d) | (c & ~d)) + x + t, s) }
fn md5_hh(a: u32, b: u32, c: u32, d: u32, x: u32, s: u32, t: u32) u32 $inline { return b + md5_rotl(a + (b ^ c ^ d) + x + t, s) }
fn md5_ii(a: u32, b: u32, c: u32, d: u32, x: u32, s: u32, t: u32) u32 $inline { return b + md5_rotl(a + (c ^ (b | ~d)) + x + t, s) }

// Hashes the 64-byte block at `data` into `state`
fn md5_compress(state: local mut &[u32 x 4], data: *[u8]) {
    let x: [u32 x 16] = @undefined
    let i: uint = 0
    while i < 16 {
        x[i] = load_le32(data, i * 4)
        i++
    }

    let a = state[0]
    let b = state[1]
    let c = state[2]
    let d = state[3]

    a = md5_ff(a, b, c, d, x[0], 7, 0xd76aa478)
    d = md5_ff(d, a, b, c, x[1], 12, 0xe8c7b756)
    c = md5_ff(c, d, a, b, x[2], 17, 0x242070db)
    b = md5_ff(b, c, d, a, x[3], 22, 0xc1bdceee)
    a = md5_ff(a, b, c, d, x[4], 7, 0xf57c0faf)
    d = md5_ff(d, a, b, c, x[5], 12, 0x4787c62a)
    c = md5_ff(c, d, a, b, x[6], 17, 0xa8304613)
    b = md5_ff(b, c, d, a, x[7], 22, 0xfd469501)
    a = md5_ff(a, b, c, d, x[8], 7, 0x698098d8)
    d = md5_ff(d, a, b, c, x[9], 12, 0x8b44f7af)
    c = md5_ff(c, d, a, b, x[10], 17, 0xffff5bb1)
    b = md5_ff(b, c, d, a, x[11], 22, 0x895cd7be)
    a = md5_ff(a, b, c, d, x[12], 7, 0x6b901122)
    d = md5_ff(d, a, b, c, x[13], 12, 0xfd987193)
    c = md5_ff(c, d, a, b, x[14], 17, 0xa679438e)
    b = md5_ff(b, c, d, a, x[15], 22, 0x49b40821)

    a = md5_gg(a, b, c, d, x[1], 5, 0xf61e2562)
    d = md5_gg(d, a, b, c, x[6], 9, 0xc040b340)
    c = md5_gg(c, d, a, b, x[11], 14, 0x265e5a51)
    b = md5_gg(b, c, d, a, x[0], 20, 0xe9b6c7aa)
    a = md5_gg(a, b, c, d, x[5], 5, 0xd62f105d)
    d = md5_gg(d, a, b, c, x[10], 9, 0x02441453)
    c = md5_gg(c, d, a, b, x[15], 14, 0xd8a1e681)
    b = md5_gg(b, c, d, a, x[4], 20, 0xe7d3fbc8)
    a = md5_gg(a, b, c, d, x[9], 5, 0x21e1cde6)
    d = md5_gg(d, a, b, c, x[14], 9, 0xc33707d6)
    c = md5_gg(c, d, a, b, x[3], 14, 0xf4d50d87)
    b = md5_gg(b, c, d, a, x[8], 20, 0x455a14ed)
    a = md5_gg(a, b, c, d, x[13], 5, 0xa9e3e905)
    d = md5_gg(d, a, b, c, x[2], 9, 0xfcefa3f8)
    c = md5_gg(c, d, a, b, x[7], 14, 0x676f02d9)
    b = md5_gg(b, c, d, a, x[12], 20, 0x8d2a4c8a)

    a = md5_hh(a, b, c, d, x[5], 4, 0xfffa3942)
    d = md5_hh(d, a, b, c, x[8], 11, 0x8771f681)
    c = md5_hh(c, d, a, b, x[11], 16, 0x6d9d6122)
    b = md5_hh(b, c, d, a, x[14], 23, 0xfde5380c)
    a = md5_hh(a, b, c, d, x[1], 4, 0xa4beea44)
    d = md5_hh(d, a, b, c, x[4], 11, 0x4bdecfa9)
    c = md5_hh(c, d, a, b, x[7], 16, 0xf6bb4b60)
    b = md5_hh(b, c, d, a, x[10], 23, 0xbebfbc70)
    a = md5_hh(a, b, c, d, x[13], 4, 0x289b7ec6)
    d = md5_hh(d, a, b, c, x[0], 11, 0xeaa127fa)
    c = md5_hh(c, d, a, b, x[3], 16, 0xd4ef3085)
    b = md5_hh(b, c, d, a, x[6], 23, 0x04881d05)
    a = md5_hh(a, b, c, d, x[9], 4, 0xd9d4d039)
    d = md5_hh(d, a, b, c, x[12], 11, 0xe6db99e5)
    c = md5_hh(c, d, a, b, x[15], 16, 0x1fa27cf8)
    b = md5_hh(b, c, d, a, x[2], 23, 0xc4ac5665)

    a = md5_ii(a, b, c, d, x[0], 6, 0xf4292244)
    d = md5_ii(d, a, b, c, x[7], 10, 0x432aff97)
    c = md5_ii(c, d, a, b, x[14], 15, 0xab9423a7)
    b = md5_ii(b, c, d, a, x[5], 21, 0xfc93a039)
    a = md5_ii(a, b, c, d, x[12], 6, 0x655b59c3)
    d = md5_ii(d, a, b, c, x[3], 10, 0x8f0ccc92)
    c = md5_ii(c, d, a, b, x[10], 15, 0xffeff47d)
    b = md5_ii(b, c, d, a, x[1], 21, 0x85845dd1)
    a = md5_ii(a, b, c, d, x[8], 6, 0x6fa87e4f)
    d = md5_ii(d, a, b, c, x[15], 10, 0xfe2ce6e0)
    c = md5_ii(c, d, a, b, x[6], 15, 0xa3014314)
    b = md5_ii(b, c, d, a, x[13], 21, 0x4e0811a1)
    a = md5_ii(a, b, c, d, x[4], 6, 0xf7537e82)
    d = md5_ii(d, a, b, c, x[11], 10, 0xbd3af235)
    c = md5_ii(c, d, a, b, x[2], 15, 0x2ad7d2bb)
    b = md5_ii(b, c, d, a, x[9], 21, 0xeb86d391)

    state[0] += a
    state[1] += b
    state[2] += c
    state[3] += d
}

/// A streaming MD5 `Hasher`; a literal `Md5 {}` is ready for input.
///
/// MD5 is broken for collision resistance; use it only for checksums and compatibility.
+ class Md5 is Hasher, KeyedHasher {
    data: [u8 x 64] ({ 0... })
    datalen: uint (0)
    total: u64 (0)
    state: [u32 x 4] ({ 0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476 })

    /// Returns the hasher to its initial state, discarding all input fed so far.
    + fn reset() {
        this.state = { 0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476 }
        this.datalen = 0
        this.total = 0
    }

    /// Returns 16, the MD5 digest size in bytes.
    + fn digest_size() uint { return 16 }
    /// Returns 64, the MD5 block size in bytes.
    + fn block_size() uint { return 64 }

    /// Feeds more input into the hash.
    + fn update(data: local &[u8]) {
        @unsafe
        let length = data.length
        let i: uint = 0
        if this.datalen > 0 {
            i = 64 - this.datalen
            if i > length : i = length
            mem.copy_bytes(data.data, @ref(this.data).@offset(this.datalen), i)
            this.datalen += i
            if this.datalen < 64 {
                this.total += length.to(u64)
                return
            }
            md5_compress(&this.state, @ref(this.data))
            this.datalen = 0
        }
        // Whole blocks are hashed where they are
        while length - i >= 64 {
            md5_compress(&this.state, data.data.@offset(i))
            i += 64
        }
        this.datalen = length - i
        mem.copy_bytes(data.data.@offset(i), @ref(this.data), this.datalen)
        this.total += length.to(u64)
    }

    /// Writes the 16-byte digest into `out` and returns 16.
    ///
    /// `out` must hold at least 16 bytes. Call `reset` before hashing new input.
    + fn finish(out: local mut &[u8]) uint {
        @unsafe
        if out.length < 16 : panic("Md5.finish: the output buffer is shorter than 16 bytes")
        let i = this.datalen
        this.data[i++] = 0x80
        if i > 56 {
            mem.clear_bytes(@ref(this.data).@offset(i), 64 - i)
            md5_compress(&this.state, @ref(this.data))
            i = 0
        }
        mem.clear_bytes(@ref(this.data).@offset(i), 56 - i)
        store_le64(@ref(this.data), 56, this.total * 8)
        md5_compress(&this.state, @ref(this.data))
        i = 0
        while i < 4 {
            store_le32(out.data, i * 4, this.state[i])
            i++
        }
        return 16
    }

    // For Hmac: the state after a whole number of blocks
    fn save(to: local mut &[u64 x 8]) {
        let i: uint = 0
        while i < 4 {
            to[i] = this.state[i].to(u64)
            i++
        }
    }

    fn restore(from: local &[u64 x 8], total: u64) {
        let i: uint = 0
        while i < 4 {
            this.state[i] = from[i].to(u32)
            i++
        }
        this.datalen = 0
        this.total = total
    }
}

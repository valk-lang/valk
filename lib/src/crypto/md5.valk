global md5_shifts : [u32 x 64] ({
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
})

global md5_constants : [u32 x 64] ({
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
    0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
    0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
    0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
    0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
    0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
    0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
    0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
    0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
})

fn md5_rotate_left(value: u32, amount: u32) u32 {
    return (value << amount) | (value >> (32 - amount))
}

fn md5_byte(input: String, index: uint, padded_length: uint) u8 {
    if index < input.bytes : return input.data[index]
    if index == input.bytes : return 0x80
    if index >= padded_length - 8 {
        let shift = (index - (padded_length - 8)) * 8
        return ((input.bytes.to(u64) * 8) >> shift).to(u8)
    }
    return 0
}

+ fn md5_encode(input: String) String {
    let state : [u32 x 4] = {0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476}
    let padded_length = (input.bytes + 9).round_up(64)
    let offset : uint = 0

    while offset < padded_length {
        let words : [u32 x 16] = {0...}
        let word_index : uint = 0
        while word_index < 16 {
            let byte_index = offset + word_index * 4
            words[word_index] = md5_byte(input, byte_index, padded_length).to(u32)
                | (md5_byte(input, byte_index + 1, padded_length).to(u32) << 8)
                | (md5_byte(input, byte_index + 2, padded_length).to(u32) << 16)
                | (md5_byte(input, byte_index + 3, padded_length).to(u32) << 24)
            word_index++
        }

        let a = state[0]
        let b = state[1]
        let c = state[2]
        let d = state[3]
        let round : uint = 0
        while round < 64 {
            let mixed : u32 = 0
            let word : uint = 0
            if round < 16 {
                mixed = (b & c) | ((b ^ -1) & d)
                word = round
            } else if round < 32 {
                mixed = (d & b) | ((d ^ -1) & c)
                word = (5 * round + 1) % 16
            } else if round < 48 {
                mixed = b ^ c ^ d
                word = (3 * round + 5) % 16
            } else {
                mixed = c ^ (b | (d ^ -1))
                word = (7 * round) % 16
            }

            let previous_d = d
            d = c
            c = b
            b += md5_rotate_left(a + mixed + md5_constants[round] + words[word], md5_shifts[round])
            a = previous_d
            round++
        }

        state[0] += a
        state[1] += b
        state[2] += c
        state[3] += d
        offset += 64
    }

    let output : [u8 x 32] = {0...}
    let digits = "0123456789abcdef"
    let i : uint = 0
    while i < 16 {
        let byte = (state[i / 4] >> ((i % 4) * 8)).to(u8)
        output[i * 2] = digits.data[(byte >> 4).to(uint)]
        output[i * 2 + 1] = digits.data[(byte & 15).to(uint)]
        i++
    }
    return String.make_from_ptr(&output, 32)
}

use mem

global md5_shifts: [u32 x 64] ({
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
})

global md5_constants: [u32 x 64] ({
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
    0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
    0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
    0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
    0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
    0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
    0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
    0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
    0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
})

fn md5_rotate_left(value: u32, amount: u32) u32 {
    return (value << amount) | (value >> (32 - amount))
}

fn md5_compress(state: local mut &[u32 x 4], data: *[u8]) {
    let words: [u32 x 16] = { 0... }
    let word_index: uint = 0
    while word_index < 16 {
        words[word_index] = data.@offset(word_index * 4).read_u32_le()
        word_index++
    }

    let a = state[0]
    let b = state[1]
    let c = state[2]
    let d = state[3]
    let round: uint = 0
    while round < 64 {
        let mixed: u32 = 0
        let word: uint = 0
        if round < 16 {
            mixed = (b & c) | (~b & d)
            word = round
        } else if round < 32 {
            mixed = (d & b) | (~d & c)
            word = (5 * round + 1) % 16
        } else if round < 48 {
            mixed = b ^ c ^ d
            word = (3 * round + 5) % 16
        } else {
            mixed = c ^ (b | ~d)
            word = (7 * round) % 16
        }

        let previous_d = d
        d = c
        c = b
        b += md5_rotate_left(a + mixed + md5_constants[round] + words[word], md5_shifts[round])
        a = previous_d
        round++
    }

    state[0] += a
    state[1] += b
    state[2] += c
    state[3] += d
}

// Streaming MD5
+ class Md5 is Hasher {
    data: [u8 x 64] ({ 0... })
    datalen: uint (0)
    total: u64 (0)
    state: [u32 x 4] ({ 0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476 })

    + fn reset() {
        this.data = { 0... }
        this.state = { 0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476 }
        this.datalen = 0
        this.total = 0
    }

    + fn digest_size() uint { return 16 }
    + fn block_size() uint { return 64 }

    fn compress_block() {
        @unsafe
        let state = this.state
        md5_compress(&state, @ref(this.data))
        this.state = state
    }

    + fn update(data: &[u8]) {
        let i: uint = 0
        let length = data.length
        while i < length {
            this.data[this.datalen] = data[i]
            this.datalen++
            if this.datalen == 64 {
                this.compress_block()
                this.datalen = 0
            }
            i++
        }
        this.total += length.to(u64)
    }

    + fn finish(out: mut &[u8]) uint {
        @unsafe
        let i = this.datalen
        this.data[i++] = 0x80
        if i > 56 {
            while i < 64 : this.data[i++] = 0
            this.compress_block()
            i = 0
        }
        while i < 56 : this.data[i++] = 0
        let bitlen = this.total * 8
        let b: uint = 0
        while b < 8 {
            this.data[56 + b] = (bitlen >> (b * 8).to(u64)).to(u8)
            b++
        }
        this.compress_block()
        i = 0
        while i < 16 {
            out[i] = (this.state[i / 4] >> ((i % 4) * 8).to(u32)).to(u8)
            i++
        }
        return 16
    }
}

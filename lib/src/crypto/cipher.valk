/// An authenticated encryption algorithm (AEAD) for `encrypt` and `decrypt`.
///
/// Each takes a 12-byte nonce and adds a 16-byte tag that `decrypt` checks, so tampering is
/// detected. AES-256-GCM and ChaCha20-Poly1305 take a 32-byte key, AES-128-GCM a 16-byte
/// one.
+ enum Cipher {
    aes_128_gcm
    aes_256_gcm
    chacha20_poly1305
}

/// The nonce size in bytes of every `Cipher`.
+ value CIPHER_NONCE_SIZE (12)
/// The size in bytes of the authentication tag every `Cipher` appends.
+ value CIPHER_TAG_SIZE (16)

// Bytes per EVP update: its lengths are 32-bit
value CIPHER_CHUNK (1 << 30)

/// Returns the key size in bytes that `cipher` takes: 16 for AES-128-GCM, 32 for the others.
+ fn cipher_key_size(cipher: Cipher) uint {
    if cipher == Cipher.aes_128_gcm : return 16
    return 32
}

/// Encrypts `plaintext` with `key` and the 12-byte `nonce`, and returns the ciphertext with
/// the 16-byte tag appended.
///
/// `aad` is additional data that is authenticated but not encrypted, such as a header; the
/// same bytes must be given to `decrypt`. A nonce must never be used twice with the same key:
/// use a counter, or `seal`, which picks a random one. Throws `invalid_input` when the key or
/// nonce has the wrong size.
+ fn encrypt(cipher: Cipher, key: local &[u8], nonce: local &[u8], plaintext: local &[u8], aad: local &[u8] ("")) String !CipherError {
    @unsafe
    check_cipher_input(cipher, key, nonce) !>
    let ctx = EVP_CIPHER_CTX_new() ?! throw .failed
    let result = String.alloc(plaintext.length + CIPHER_TAG_SIZE)
    let final_length: i32 = 0
    let ok = EVP_EncryptInit_ex(ctx, cipher_method(cipher), null, null, null) == 1
        && EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_AEAD_SET_IVLEN, CIPHER_NONCE_SIZE, null) == 1
        && EVP_EncryptInit_ex(ctx, null, null, key.data, nonce.data) == 1
        && cipher_update(ctx, true, null, aad)
        && cipher_update(ctx, true, result.data, plaintext)
        && EVP_EncryptFinal_ex(ctx, result.data + plaintext.length, @ref(final_length)) == 1
        && EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_AEAD_GET_TAG, CIPHER_TAG_SIZE, result.data + plaintext.length) == 1
    EVP_CIPHER_CTX_free(ctx)
    if !ok {
        ERR_clear_error()
        throw .failed
    }
    return result
}

/// Decrypts `ciphertext`, as returned by `encrypt`, with the same `key`, `nonce` and `aad`.
///
/// Throws `auth` when the tag does not match: the ciphertext, the tag or `aad` was altered,
/// or the key or nonce differs. Nothing is returned in that case. Throws `invalid_input` when
/// the key or nonce has the wrong size.
+ fn decrypt(cipher: Cipher, key: local &[u8], nonce: local &[u8], ciphertext: local &[u8], aad: local &[u8] ("")) String !CipherError {
    @unsafe
    check_cipher_input(cipher, key, nonce) !>
    if ciphertext.length < CIPHER_TAG_SIZE : throw .auth
    let length = ciphertext.length - CIPHER_TAG_SIZE
    let ctx = EVP_CIPHER_CTX_new() ?! throw .failed
    let result = String.alloc(length)
    let ok = EVP_DecryptInit_ex(ctx, cipher_method(cipher), null, null, null) == 1
        && EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_AEAD_SET_IVLEN, CIPHER_NONCE_SIZE, null) == 1
        && EVP_DecryptInit_ex(ctx, null, null, key.data, nonce.data) == 1
        && cipher_update(ctx, false, null, aad)
        && cipher_update(ctx, false, result.data, ciphertext.view(0, length))
        && EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_AEAD_SET_TAG, CIPHER_TAG_SIZE, ciphertext.data + length) == 1
    if !ok {
        EVP_CIPHER_CTX_free(ctx)
        ERR_clear_error()
        throw .failed
    }
    let final_length: i32 = 0
    let authentic = EVP_DecryptFinal_ex(ctx, result.data + length, @ref(final_length)) == 1
    EVP_CIPHER_CTX_free(ctx)
    if !authentic {
        ERR_clear_error()
        throw .auth
    }
    return result
}

/// Encrypts `plaintext` with AES-256-GCM under the 32-byte `key` and a random nonce, and
/// returns the nonce, ciphertext and tag together, ready for `unseal`.
///
/// Suited to encrypted cookies, tokens and stored secrets. With random nonces one key should
/// seal no more than a few billion messages. Throws `invalid_input` when the key is not 32
/// bytes.
+ fn seal(key: local &[u8], plaintext: local &[u8], aad: local &[u8] ("")) String !CipherError {
    let nonce = random_bytes(CIPHER_NONCE_SIZE)
    let encrypted = encrypt(Cipher.aes_256_gcm, key, nonce, plaintext, aad) !>
    return nonce + encrypted
}

/// Decrypts what `seal` returned, with the same `key` and `aad`.
///
/// Throws `auth` when the data was altered or sealed with another key, and `invalid_input`
/// when the key is not 32 bytes.
+ fn unseal(key: local &[u8], sealed: local &[u8], aad: local &[u8] ("")) String !CipherError {
    if sealed.length < CIPHER_NONCE_SIZE + CIPHER_TAG_SIZE : throw .auth
    let body = sealed.view(CIPHER_NONCE_SIZE, sealed.length - CIPHER_NONCE_SIZE)
    return decrypt(Cipher.aes_256_gcm, key, sealed.view(0, CIPHER_NONCE_SIZE), body, aad) !>
}

fn check_cipher_input(cipher: Cipher, key: local &[u8], nonce: local &[u8]) !CipherError {
    if key.length != cipher_key_size(cipher) || nonce.length != CIPHER_NONCE_SIZE : throw .invalid_input
}

fn cipher_method(cipher: Cipher) EVP_CIPHER {
    if cipher == Cipher.aes_128_gcm : return EVP_aes_128_gcm()
    if cipher == Cipher.aes_256_gcm : return EVP_aes_256_gcm()
    return EVP_chacha20_poly1305()
}

// Feeds `input` through the cipher; a null `out` feeds additional data
fn cipher_update(ctx: EVP_CIPHER_CTX, encrypting: bool, out: ?ptr, input: local &[u8]) bool {
    @unsafe
    let done: uint = 0
    while done < input.length {
        let chunk = input.length - done
        if chunk > CIPHER_CHUNK : chunk = CIPHER_CHUNK
        let written: i32 = 0
        let target: ?ptr = null
        if isset(out) : target = out + done
        let status = encrypting
            ? EVP_EncryptUpdate(ctx, target, @ref(written), input.data + done, chunk.to(i32))
            : EVP_DecryptUpdate(ctx, target, @ref(written), input.data + done, chunk.to(i32))
        if status != 1 : return false
        done += chunk
    }
    return true
}

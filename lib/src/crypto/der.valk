// Just enough DER to build public keys from their parts and to convert ECDSA signatures

fn bytes_of(values: Array[u8]) String {
    let out = ByteBuffer.new(values.length)
    each values as value : out.write_byte(value)
    return out.to_string()
}

fn oid_rsa_encryption() String {
    return bytes_of(.{ 0x06, 0x09, 0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x01 })
}

fn oid_ec_public_key() String {
    return bytes_of(.{ 0x06, 0x07, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x02, 0x01 })
}

fn der_null() String {
    return bytes_of(.{ 0x05, 0x00 })
}

fn curve_oid(curve: Curve) String {
    if curve == Curve.p384 : return bytes_of(.{ 0x06, 0x05, 0x2B, 0x81, 0x04, 0x00, 0x22 })
    if curve == Curve.p521 : return bytes_of(.{ 0x06, 0x05, 0x2B, 0x81, 0x04, 0x00, 0x23 })
    return bytes_of(.{ 0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x03, 0x01, 0x07 })
}

fn der_element(tag: u8, content: String) String {
    let out = ByteBuffer.new(content.bytes + 6)
    out.write_byte(tag)
    let length = content.bytes
    if length < 0x80 {
        out.write_byte(length.to(u8))
    } else {
        let count: uint = 0
        let rest = length
        while rest > 0 {
            count++
            rest = rest >> 8
        }
        out.write_byte((0x80 | count).to(u8))
        while count-- > 0 : out.write_byte((length >> (count * 8)).to(u8))
    }
    out.write(content)
    return out.to_string()
}

fn der_sequence(content: String) String {
    return der_element(0x30, content)
}

fn der_bit_string(content: String) String {
    let out = ByteBuffer.new(content.bytes + 1)
    // No unused bits
    out.write_byte(0)
    out.write(content)
    return der_element(0x03, out.to_string())
}

// The unsigned big-endian number `value` as an INTEGER
fn der_integer(value: String) String {
    let start: uint = 0
    while start + 1 < value.bytes && value.get(start) == 0 : start++
    let out = ByteBuffer.new(value.bytes + 1)
    if value.bytes == 0 || (value.get(start) & 0x80) != 0 : out.write_byte(0)
    if value.bytes > 0 : out.write(value.view(start, value.bytes - start))
    return der_element(0x02, out.to_string())
}

class DerReader {
    data: String
    pos: uint (0)

    fn done() bool {
        return this.pos >= this.data.bytes
    }

    // The content of the next element, which must be tagged `tag`
    fn element(tag: u8) String !KeyError {
        if this.pos + 2 > this.data.bytes || this.data.get(this.pos) != tag : throw .invalid_input
        this.pos++
        let first = this.data.get(this.pos++).to(uint)
        let length = first
        if first >= 0x80 {
            let count = first & 0x7F
            if count == 0 || count > 4 : throw .invalid_input
            length = 0
            while count-- > 0 {
                if this.done() : throw .invalid_input
                length = (length << 8) | this.data.get(this.pos++).to(uint)
            }
        }
        if length > this.data.bytes - this.pos : throw .invalid_input
        let content = this.data.range(this.pos, length)
        this.pos += length
        return content
    }
}

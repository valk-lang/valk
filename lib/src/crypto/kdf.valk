// Key derivation: PBKDF2 (RFC 8018) for passwords and HKDF (RFC 5869) for
// deriving keys from keying material that already has entropy

// Derives `length` bytes from `password`; `iterations` must be at least 1.
// Use bcrypt for storing passwords; PBKDF2 is for interoperability and for
// turning a password into a key
+ fn pbkdf2(algorithm: HashAlgorithm, password: &[u8], salt: &[u8], iterations: uint, length: uint) String !CryptoError {
    if iterations == 0 || length == 0 : throw .invalid_input
    let mac = Hmac.new(algorithm, password)
    let size = mac.digest_size()
    let out = ByteBuffer.new(length)
    let u = [u8]{ 0 x size }
    let t = [u8]{ 0 x size }
    let counter = [u8]{ 0 x 4 }
    let block: uint = 1
    while out.length < length {
        counter[0] = (block >> 24).to(u8)
        counter[1] = (block >> 16).to(u8)
        counter[2] = (block >> 8).to(u8)
        counter[3] = block.to(u8)
        mac.reset()
        mac.update(salt)
        mac.update(counter)
        mac.finish(u)
        let i: uint = 0
        while i < size {
            t[i] = u[i]
            i++
        }
        let iteration: uint = 1
        while iteration < iterations {
            mac.reset()
            mac.update(u)
            mac.finish(u)
            i = 0
            while i < size {
                t[i] = t[i] ^ u[i]
                i++
            }
            iteration++
        }
        let take = length - out.length
        if take > size : take = size
        out.write(t.view(0, take))
        block++
    }
    return out.to_string()
}

// HKDF-Extract: a pseudorandom key from `ikm`; an empty salt is allowed
+ fn hkdf_extract(algorithm: HashAlgorithm, salt: &[u8], ikm: &[u8]) String {
    return Hmac.sign(algorithm, salt, ikm)
}

// HKDF-Expand: `length` bytes from `prk`; at most 255 digests long
+ fn hkdf_expand(algorithm: HashAlgorithm, prk: &[u8], info: &[u8], length: uint) String !CryptoError {
    let size = digest_size(algorithm)
    if length == 0 || length > 255 * size : throw .invalid_input
    let mac = Hmac.new(algorithm, prk)
    let out = ByteBuffer.new(length)
    let t = [u8]{ 0 x size }
    let previous: uint = 0
    let counter = [u8]{ 0 x 1 }
    let block: uint = 1
    while out.length < length {
        counter[0] = block.to(u8)
        mac.reset()
        if previous > 0 : mac.update(t)
        mac.update(info)
        mac.update(counter)
        mac.finish(t)
        previous = size
        let take = length - out.length
        if take > size : take = size
        out.write(t.view(0, take))
        block++
    }
    return out.to_string()
}

// Extract then expand
+ fn hkdf(algorithm: HashAlgorithm, ikm: &[u8], salt: &[u8], info: &[u8], length: uint) String !CryptoError {
    return hkdf_expand(algorithm, hkdf_extract(algorithm, salt, ikm), info, length) !>
}

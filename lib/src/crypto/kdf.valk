use io
use mem

// Key derivation: PBKDF2 (RFC 8018) for passwords and HKDF (RFC 5869) for
// deriving keys from keying material that already has entropy

/// Derives `length` bytes from `password` and `salt` with PBKDF2-HMAC (RFC 8018).
///
/// Throws `invalid_input` when `iterations` or `length` is zero. For storing passwords
/// prefer `bcrypt_hash`; PBKDF2 is for interoperability and for turning a password into a key.
+ fn pbkdf2(password: local &[u8], algorithm: HashAlgorithm, salt: local &[u8], iterations: uint, length: uint) String !CryptoError {
    @unsafe
    if iterations == 0 || length == 0 : throw .invalid_input
    let res = String.alloc(length)
    pbkdf2_in(password, algorithm, salt, iterations, [u8]{ owner: res.owner, data: res.data, length: length }, length) !>
    return res
}

/// Derives `length` bytes with PBKDF2-HMAC into `out` and returns `length`.
///
/// `out` must hold at least `length` bytes; a shorter buffer panics. Throws `invalid_input`
/// when `iterations` or `length` is zero.
+ fn pbkdf2_in(password: local &[u8], algorithm: HashAlgorithm, salt: local &[u8], iterations: uint, out: local mut &[u8], length: uint) uint !CryptoError {
    if iterations == 0 || length == 0 : throw .invalid_input
    crypto_room(out, length, "pbkdf2_in")
    let mac = Hmac.new(algorithm, password)
    let size = mac.digest_size()
    let u: [u8 x 64] = { 0... }
    let t: [u8 x 64] = { 0... }
    let counter: [u8 x 4] = { 0... }
    let written: uint = 0
    let block: uint = 1
    while written < length {
        counter[0] = (block >> 24).to(u8)
        counter[1] = (block >> 16).to(u8)
        counter[2] = (block >> 8).to(u8)
        counter[3] = block.to(u8)
        mac.reset()
        mac.update(salt)
        mac.update(&counter)
        mac.finish(&u)
        let i: uint = 0
        while i < size {
            t[i] = u[i]
            i++
        }
        let iteration: uint = 1
        while iteration < iterations {
            mac.reset()
            mac.update(&u[0 .. size])
            mac.finish(&u)
            i = 0
            while i < size {
                t[i] = t[i] ^ u[i]
                i++
            }
            iteration++
        }
        let take = length - written
        if take > size : take = size
        mem.copy(&t[0 .. take], out.view(written, take))
        written += take
        block++
    }
    return length
}

/// Derives `length` bytes with PBKDF2-HMAC to `out` and returns `length`.
///
/// Throws `invalid_input` when `iterations` or `length` is zero, and `write` when `out` fails.
+ fn pbkdf2_into(password: local &[u8], algorithm: HashAlgorithm, salt: local &[u8], iterations: uint, out: io.Writer, length: uint) uint !CryptoError {
    if iterations == 0 || length == 0 : throw .invalid_input
    let mac = Hmac.new(algorithm, password)
    let size = mac.digest_size()
    let u: [u8 x 64] = { 0... }
    let t: [u8 x 64] = { 0... }
    let counter: [u8 x 4] = { 0... }
    let written: uint = 0
    let block: uint = 1
    while written < length {
        counter[0] = (block >> 24).to(u8)
        counter[1] = (block >> 16).to(u8)
        counter[2] = (block >> 8).to(u8)
        counter[3] = block.to(u8)
        mac.reset()
        mac.update(salt)
        mac.update(&counter)
        mac.finish(&u)
        let i: uint = 0
        while i < size {
            t[i] = u[i]
            i++
        }
        let iteration: uint = 1
        while iteration < iterations {
            mac.reset()
            mac.update(&u[0 .. size])
            mac.finish(&u)
            i = 0
            while i < size {
                t[i] = t[i] ^ u[i]
                i++
            }
            iteration++
        }
        let take = length - written
        if take > size : take = size
        io.write_all(out, &t[0 .. take]) ! throw .write
        written += take
        block++
    }
    return length
}

/// Returns the HKDF-Extract (RFC 5869) pseudorandom key of `ikm` under `salt`.
///
/// An empty `salt` is allowed. The result is raw bytes, one digest long.
+ fn hkdf_extract(ikm: local &[u8], algorithm: HashAlgorithm, salt: local &[u8]) String {
    return Hmac.sign(ikm, algorithm, salt)
}

/// Writes the HKDF-Extract pseudorandom key of `ikm` under `salt` into `out` and returns its size.
///
/// `out` must hold at least `digest_size(algorithm)` bytes; a shorter buffer panics.
+ fn hkdf_extract_in(ikm: local &[u8], algorithm: HashAlgorithm, salt: local &[u8], out: local mut &[u8]) uint {
    return Hmac.sign_in(ikm, algorithm, salt, out)
}

/// Writes the HKDF-Extract pseudorandom key of `ikm` under `salt` to `out` and returns its size.
+ fn hkdf_extract_into(ikm: local &[u8], algorithm: HashAlgorithm, salt: local &[u8], out: io.Writer) uint !io.IoError {
    return Hmac.sign_into(ikm, algorithm, salt, out) !>
}

/// Returns `length` bytes of HKDF-Expand (RFC 5869) output from the pseudorandom key `prk`.
///
/// Throws `invalid_input` when `length` is zero or more than 255 digests long.
+ fn hkdf_expand(prk: local &[u8], algorithm: HashAlgorithm, info: local &[u8], length: uint) String !CryptoError {
    @unsafe
    let size = digest_size(algorithm)
    if length == 0 || length > 255 * size : throw .invalid_input
    let res = String.alloc(length)
    hkdf_expand_in(prk, algorithm, info, [u8]{ owner: res.owner, data: res.data, length: length }, length) !>
    return res
}

/// Writes `length` bytes of HKDF-Expand output into `out` and returns `length`.
///
/// `out` must hold at least `length` bytes; a shorter buffer panics. Throws `invalid_input`
/// when `length` is zero or more than 255 digests long.
+ fn hkdf_expand_in(prk: local &[u8], algorithm: HashAlgorithm, info: local &[u8], out: local mut &[u8], length: uint) uint !CryptoError {
    let size = digest_size(algorithm)
    if length == 0 || length > 255 * size : throw .invalid_input
    crypto_room(out, length, "hkdf_expand_in")
    let mac = Hmac.new(algorithm, prk)
    let t: [u8 x 64] = { 0... }
    let previous: uint = 0
    let counter: [u8 x 1] = { 0 }
    let written: uint = 0
    let block: uint = 1
    while written < length {
        counter[0] = block.to(u8)
        mac.reset()
        if previous > 0 : mac.update(&t[0 .. size])
        mac.update(info)
        mac.update(&counter)
        mac.finish(&t)
        previous = size
        let take = length - written
        if take > size : take = size
        mem.copy(&t[0 .. take], out.view(written, take))
        written += take
        block++
    }
    return length
}

/// Writes `length` bytes of HKDF-Expand output to `out` and returns `length`.
///
/// Throws `invalid_input` when `length` is zero or more than 255 digests long, and `write`
/// when `out` fails.
+ fn hkdf_expand_into(prk: local &[u8], algorithm: HashAlgorithm, info: local &[u8], out: io.Writer, length: uint) uint !CryptoError {
    let size = digest_size(algorithm)
    if length == 0 || length > 255 * size : throw .invalid_input
    let mac = Hmac.new(algorithm, prk)
    let t: [u8 x 64] = { 0... }
    let previous: uint = 0
    let counter: [u8 x 1] = { 0 }
    let written: uint = 0
    let block: uint = 1
    while written < length {
        counter[0] = block.to(u8)
        mac.reset()
        if previous > 0 : mac.update(&t[0 .. size])
        mac.update(info)
        mac.update(&counter)
        mac.finish(&t)
        previous = size
        let take = length - written
        if take > size : take = size
        io.write_all(out, &t[0 .. take]) ! throw .write
        written += take
        block++
    }
    return length
}

/// Derives `length` bytes from `ikm` with HKDF (RFC 5869): extract with `salt`, expand with `info`.
///
/// Throws `invalid_input` when `length` is zero or more than 255 digests long.
+ fn hkdf(ikm: local &[u8], algorithm: HashAlgorithm, salt: local &[u8], info: local &[u8], length: uint) String !CryptoError {
    let prk: [u8 x 64] = @undefined
    let prk_len = hkdf_extract_in(ikm, algorithm, salt, &prk)
    return hkdf_expand(&prk[0 .. prk_len], algorithm, info, length) !>
}

/// Derives `length` bytes from `ikm` with HKDF into `out` and returns `length`.
///
/// `out` must hold at least `length` bytes; a shorter buffer panics. Throws `invalid_input`
/// when `length` is zero or more than 255 digests long.
+ fn hkdf_in(ikm: local &[u8], algorithm: HashAlgorithm, salt: local &[u8], info: local &[u8], out: local mut &[u8], length: uint) uint !CryptoError {
    let prk: [u8 x 64] = @undefined
    let prk_len = hkdf_extract_in(ikm, algorithm, salt, &prk)
    return hkdf_expand_in(&prk[0 .. prk_len], algorithm, info, out, length) !>
}

/// Derives `length` bytes from `ikm` with HKDF to `out` and returns `length`.
///
/// Throws `invalid_input` when `length` is zero or more than 255 digests long, and `write`
/// when `out` fails.
+ fn hkdf_into(ikm: local &[u8], algorithm: HashAlgorithm, salt: local &[u8], info: local &[u8], out: io.Writer, length: uint) uint !CryptoError {
    let prk: [u8 x 64] = @undefined
    let prk_len = hkdf_extract_in(ikm, algorithm, salt, &prk)
    return hkdf_expand_into(&prk[0 .. prk_len], algorithm, info, out, length) !>
}

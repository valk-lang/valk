use mem

// Own copies of the helpers: dev builds inline only within a file
fn sha1_rotl(x: u32, n: u32) u32 $inline { return (x << n) | (x >> (32 - n)) }
fn sha1_ch(x: u32, y: u32, z: u32) u32 $inline { return (x & y) ^ (~x & z) }
fn sha1_parity(x: u32, y: u32, z: u32) u32 $inline { return x ^ y ^ z }
fn sha1_maj(x: u32, y: u32, z: u32) u32 $inline { return (x & y) ^ (x & z) ^ (y & z) }

// One round; the caller rotates the roles of a..e instead of moving the values
fn sha1_round(a: u32, b: local mut &u32, e: local mut &u32, f: u32, kw: u32) $inline {
    e[0] += sha1_rotl(a, 5) + f + kw
    b[0] = sha1_rotl(b[0], 30)
}

// Hashes the 64-byte block at `data` into `state`
fn sha1_compress(state: local mut &[u32 x 5], data: *[u8]) {
    let m: [u32 x 80] = @undefined
    let i: uint = 0
    while i < 16 {
        m[i] = load_be32(data, i * 4)
        i++
    }
    while i < 80 {
        m[i] = sha1_rotl(m[i - 3] ^ m[i - 8] ^ m[i - 14] ^ m[i - 16], 1)
        i++
    }

    let a = state[0]
    let b = state[1]
    let c = state[2]
    let d = state[3]
    let e = state[4]

    i = 0
    while i < 20 {
        sha1_round(a, &b, &e, sha1_ch(b, c, d), 0x5a827999 + m[i])
        sha1_round(e, &a, &d, sha1_ch(a, b, c), 0x5a827999 + m[i + 1])
        sha1_round(d, &e, &c, sha1_ch(e, a, b), 0x5a827999 + m[i + 2])
        sha1_round(c, &d, &b, sha1_ch(d, e, a), 0x5a827999 + m[i + 3])
        sha1_round(b, &c, &a, sha1_ch(c, d, e), 0x5a827999 + m[i + 4])
        i += 5
    }
    while i < 40 {
        sha1_round(a, &b, &e, sha1_parity(b, c, d), 0x6ed9eba1 + m[i])
        sha1_round(e, &a, &d, sha1_parity(a, b, c), 0x6ed9eba1 + m[i + 1])
        sha1_round(d, &e, &c, sha1_parity(e, a, b), 0x6ed9eba1 + m[i + 2])
        sha1_round(c, &d, &b, sha1_parity(d, e, a), 0x6ed9eba1 + m[i + 3])
        sha1_round(b, &c, &a, sha1_parity(c, d, e), 0x6ed9eba1 + m[i + 4])
        i += 5
    }
    while i < 60 {
        sha1_round(a, &b, &e, sha1_maj(b, c, d), 0x8f1bbcdc + m[i])
        sha1_round(e, &a, &d, sha1_maj(a, b, c), 0x8f1bbcdc + m[i + 1])
        sha1_round(d, &e, &c, sha1_maj(e, a, b), 0x8f1bbcdc + m[i + 2])
        sha1_round(c, &d, &b, sha1_maj(d, e, a), 0x8f1bbcdc + m[i + 3])
        sha1_round(b, &c, &a, sha1_maj(c, d, e), 0x8f1bbcdc + m[i + 4])
        i += 5
    }
    while i < 80 {
        sha1_round(a, &b, &e, sha1_parity(b, c, d), 0xca62c1d6 + m[i])
        sha1_round(e, &a, &d, sha1_parity(a, b, c), 0xca62c1d6 + m[i + 1])
        sha1_round(d, &e, &c, sha1_parity(e, a, b), 0xca62c1d6 + m[i + 2])
        sha1_round(c, &d, &b, sha1_parity(d, e, a), 0xca62c1d6 + m[i + 3])
        sha1_round(b, &c, &a, sha1_parity(c, d, e), 0xca62c1d6 + m[i + 4])
        i += 5
    }

    state[0] += a
    state[1] += b
    state[2] += c
    state[3] += d
    state[4] += e
}

/// A streaming SHA-1 `Hasher`; a literal `Sha1 {}` is ready for input.
///
/// SHA-1 is broken for collision resistance; use it only for checksums and compatibility.
+ class Sha1 is Hasher, KeyedHasher {
    data: [u8 x 64] ({ 0... })
    datalen: uint (0)
    total: u64 (0)
    state: [u32 x 5] ({ 0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xc3d2e1f0 })

    /// Returns the hasher to its initial state, discarding all input fed so far.
    + fn reset() {
        this.state = { 0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xc3d2e1f0 }
        this.datalen = 0
        this.total = 0
    }

    /// Feeds more input into the hash.
    + fn update(data: local &[u8]) {
        @unsafe
        let length = data.length
        let i: uint = 0
        if this.datalen > 0 {
            i = 64 - this.datalen
            if i > length : i = length
            mem.copy_bytes(data.data, @ref(this.data).@offset(this.datalen), i)
            this.datalen += i
            if this.datalen < 64 {
                this.total += length.to(u64)
                return
            }
            sha1_compress(&this.state, @ref(this.data))
            this.datalen = 0
        }
        // Whole blocks are hashed where they are
        while length - i >= 64 {
            sha1_compress(&this.state, data.data.@offset(i))
            i += 64
        }
        this.datalen = length - i
        mem.copy_bytes(data.data.@offset(i), @ref(this.data), this.datalen)
        this.total += length.to(u64)
    }

    /// Writes the 20-byte digest into `out` and returns 20.
    ///
    /// `out` must hold at least 20 bytes. Call `reset` before hashing new input.
    + fn finish(out: local mut &[u8]) uint {
        @unsafe
        if out.length < 20 : panic("Sha1.finish: the output buffer is shorter than 20 bytes")
        let i = this.datalen
        this.data[i++] = 0x80
        if i > 56 {
            mem.clear_bytes(@ref(this.data).@offset(i), 64 - i)
            sha1_compress(&this.state, @ref(this.data))
            i = 0
        }
        mem.clear_bytes(@ref(this.data).@offset(i), 56 - i)
        store_be64(@ref(this.data), 56, this.total * 8)
        sha1_compress(&this.state, @ref(this.data))
        i = 0
        while i < 5 {
            store_be32(out.data, i * 4, this.state[i])
            i++
        }
        return 20
    }

    /// Returns 20, the SHA-1 digest size in bytes.
    + fn digest_size() uint { return 20 }
    /// Returns 64, the SHA-1 block size in bytes.
    + fn block_size() uint { return 64 }

    // For Hmac: the state after a whole number of blocks
    fn save(to: local mut &[u64 x 8]) {
        let i: uint = 0
        while i < 5 {
            to[i] = this.state[i].to(u64)
            i++
        }
    }

    fn restore(from: local &[u64 x 8], total: u64) {
        let i: uint = 0
        while i < 5 {
            this.state[i] = from[i].to(u32)
            i++
        }
        this.datalen = 0
        this.total = total
    }
}

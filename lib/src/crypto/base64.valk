use io
use coro

global charset: String ("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")

// Input bytes per streamed block. A multiple of 3 so that every block encodes
// to whole base64 quads, and of 4 so that every block decodes on a boundary
value BASE64_CHUNK (504)

// Streaming borrows the current coroutine's scratch buffer; see 'digest.valk'
// for why a plain global would be unsafe across a suspending write

/// Returns `data` encoded as standard base64 (`+` and `/`), `=` padded, without line breaks.
+ fn base64_encode(data: local &[u8]) String {
    @unsafe
    let out = ByteBuffer.new(base64_encoded_size(data.length))
    out.skip(internal_base64_encode(data.data, out.data, data.length))
    return out.into_string()
}
/// Decodes standard base64 (`+` and `/`) into the raw bytes it represents.
///
/// The `=` padding is optional, and line breaks (`\n`, `\r`), as in PEM and MIME bodies,
/// are skipped. Throws `invalid_input` on any other character (including spaces and the
/// URL-safe `-` and `_`), on an impossible length, or when the unused bits of the last
/// character are not zero.
+ fn base64_decode(data: local &[u8]) String !CryptoError {
    @unsafe
    let joined = without_line_breaks(data)
    if isset(joined) : return base64_decode(joined) !>
    let out = ByteBuffer.new(base64_decoded_size(data.length))
    out.skip(internal_base64_decode(data.data, out.data, data.length) !>)
    return out.into_string()
}

/// Writes `data` encoded as standard padded base64 into `out` and returns the bytes written.
///
/// `out` must hold at least `base64_encoded_size(data.length)` bytes; a shorter buffer panics.
+ fn base64_encode_in(data: local &[u8], out: local mut &[u8]) uint {
    @unsafe
    crypto_room(out, base64_encoded_size(data.length), "base64_encode_in")
    return internal_base64_encode(data.data, out.data, data.length)
}

/// Decodes standard base64 into `out` and returns the bytes written.
///
/// `out` must hold at least `base64_decoded_size(data.length)` bytes; a shorter buffer
/// panics. Accepts the same input as `base64_decode` and throws `invalid_input` the same way.
+ fn base64_decode_in(data: local &[u8], out: local mut &[u8]) uint !CryptoError {
    @unsafe
    let joined = without_line_breaks(data)
    if isset(joined) : return base64_decode_in(joined, out) !>
    crypto_room(out, base64_decoded_size(data.length), "base64_decode_in")
    return internal_base64_decode(data.data, out.data, data.length) !>
}

/// Returns the number of base64 characters that encode `length` bytes, padding included.
+ fn base64_encoded_size(length: uint) uint {
    return (length + 2) / 3 * 4
}

/// Returns the most bytes that `length` base64 characters can decode to.
+ fn base64_decoded_size(length: uint) uint {
    return (length + 3) / 4 * 3
}

/// Writes `data` encoded as standard padded base64 to `out` and returns the bytes written.
///
/// The input is encoded in blocks of 504 bytes, so memory use does not grow with `data`.
+ fn base64_encode_into(data: local &[u8], out: io.Writer) uint !io.IoError {
    @unsafe
    let block = coro.temp_buffer()
    let written: uint = 0
    let offset: uint = 0
    while offset < data.length {
        let take = data.length - offset
        if take > BASE64_CHUNK : take = BASE64_CHUNK
        block.clear()
        block.reserve(take / 3 * 4 + 4)
        let part = data.view(offset, take)
        block.skip(internal_base64_encode(part.data, block.data, take))
        written += out.write(block) !>
        offset += take
    }
    return written
}

/// Decodes standard base64 into `out` and returns the bytes written.
///
/// Accepts the same input as `base64_decode`, decoded in blocks of 504 characters. Throws
/// `invalid_input` on malformed input and `write` when `out` fails; blocks decoded before
/// the error have already been written.
+ fn base64_decode_into(data: local &[u8], out: io.Writer) uint !CryptoError {
    @unsafe
    let joined = without_line_breaks(data)
    if isset(joined) : return base64_decode_into(joined, out) !>
    let block = coro.temp_buffer()
    let written: uint = 0
    let offset: uint = 0
    while offset < data.length {
        let take = data.length - offset
        if take > BASE64_CHUNK : take = BASE64_CHUNK
        // Padding may only appear in the final block, so a full block that is
        // not the last one must stay on a quad boundary
        block.clear()
        block.reserve(take + 4)
        let part = data.view(offset, take)
        block.skip(internal_base64_decode(part.data, block.data, take, offset + take >= data.length) !>)
        written += out.write(block) ! throw .write
        offset += take
    }
    return written
}

// `data` without its line breaks, or null when it has none
fn without_line_breaks(data: local &[u8]) ?ByteBuffer {
    let i: uint = 0
    while i < data.length {
        let ch = data[i++]
        if ch != '\n' && ch != '\r' : continue
        let joined = ByteBuffer.new(data.length)
        each data as byte {
            if byte != '\n' && byte != '\r' : joined.write_byte(byte)
        }
        return joined
    }
    return null
}

fn internal_base64_encode(in: *[u8], out: *[u8], len: uint) uint {
    @unsafe
    let full_len = len / 3 * 3
    let i: uint = 0
    let o: uint = 0
    // 12 input bytes per 16-byte block: the 6-bit indexes come out of shifts on the
    // 16-bit lanes of the regrouped bytes, the characters out of range compares
    if len >= 16 {
        let input = [u8]{ owner: null, data: in, length: len }
        let output = [u8]{ owner: null, data: out, length: base64_encoded_size(len) }
        let even_lanes = $bitcast[i16x8]($splat[u32x4](0x0000FFFF))
        while i + 16 <= len {
            let block = $load[u8x16](input, i)
            // Every 3-byte group as the 16-bit lanes [b1 b0] [b2 b1]
            let grouped = $bitcast[u16x8]($shuffle(block, block, 1, 0, 2, 1, 4, 3, 5, 4, 7, 6, 8, 7, 10, 9, 11, 10))
            let evens = ((grouped >> 10) & $splat[u16x8](0x003F)) | ((grouped << 4) & $splat[u16x8](0x3F00))
            let odds = ((grouped >> 6) & $splat[u16x8](0x003F)) | ((grouped << 8) & $splat[u16x8](0x3F00))
            let indexes = $bitcast[i8x16]($select(even_lanes, evens, odds))
            // 0..25 'A'.., 26..51 'a'.., 52..61 '0'.., 62 '+', 63 '/'
            let ascii = indexes + $splat[i8x16](65)
            ascii = ascii + ($gt(indexes, $splat[i8x16](25)) & $splat[i8x16](6))
            ascii = ascii - ($gt(indexes, $splat[i8x16](51)) & $splat[i8x16](75))
            ascii = ascii - ($gt(indexes, $splat[i8x16](61)) & $splat[i8x16](15))
            ascii = ascii + ($gt(indexes, $splat[i8x16](62)) & $splat[i8x16](3))
            $store(output, o, $bitcast[u8x16](ascii))
            i += 12
            o += 16
        }
    }
    while i < full_len {
        let n = (in[i].to(uint) << 16) | (in[i + 1].to(uint) << 8) | in[i + 2].to(uint)
        let hi = encode_table[n >> 12]
        let lo = encode_table[n & 0xFFF]
        out[o] = hi.to(u8)
        out[o + 1] = (hi >> 8).to(u8)
        out[o + 2] = lo.to(u8)
        out[o + 3] = (lo >> 8).to(u8)
        i += 3
        o += 4
    }
    let left_over = len - full_len
    if left_over == 1 {
        let hi = encode_table[in[i].to(uint) << 4]
        out[o] = hi.to(u8)
        out[o + 1] = (hi >> 8).to(u8)
        out[o + 2] = '='
        out[o + 3] = '='
        o += 4
    } else if left_over == 2 {
        let n = (in[i].to(uint) << 16) | (in[i + 1].to(uint) << 8)
        let hi = encode_table[n >> 12]
        let lo = encode_table[n & 0xFFF]
        out[o] = hi.to(u8)
        out[o + 1] = (hi >> 8).to(u8)
        out[o + 2] = lo.to(u8)
        out[o + 3] = '='
        o += 4
    }
    return o
}

fn internal_base64_decode(in: *[u8], out: *[u8], len: uint, final_block: bool (true)) uint !CryptoError {
    @unsafe
    if len == 0 : return 0

    // Padding only closes the stream, so a block that is followed by more input
    // has none and its `=` fails as an invalid character
    let padding: uint = 0
    if final_block && in[len - 1] == '=' {
        padding++
        if len > 1 && in[len - 2] == '=' : padding++
    }

    if padding > 0 && len % 4 != 0 : throw .invalid_input
    let data_len = len - padding
    let left_over = data_len % 4
    if left_over == 1 : throw .invalid_input
    if padding == 1 && left_over != 3 : throw .invalid_input
    if padding == 2 && left_over != 2 : throw .invalid_input

    let full_len = data_len - left_over
    let i: uint = 0
    let o: uint = 0
    // 16 characters per block while every one is in the alphabet: range compares give
    // the 6-bit values, shifts on the 32-bit lanes pack them, a shuffle drops the fourth byte
    // of every group. The block writes 16 bytes for its 12, so it stays inside the output
    if full_len >= 16 {
        let input = [u8]{ owner: null, data: in, length: len }
        let output = [u8]{ owner: null, data: out, length: base64_decoded_size(len) }
        while i + 16 <= full_len && o + 16 <= output.length {
            let chars = $bitcast[i8x16]($load[u8x16](input, i))
            let upper = $gte(chars, $splat[i8x16]('A')) & $lte(chars, $splat[i8x16]('Z'))
            let lower = $gte(chars, $splat[i8x16]('a')) & $lte(chars, $splat[i8x16]('z'))
            let digit = $gte(chars, $splat[i8x16]('0')) & $lte(chars, $splat[i8x16]('9'))
            let plus = $eq(chars, $splat[i8x16]('+'))
            let slash = $eq(chars, $splat[i8x16]('/'))
            if $mask_bits(upper | lower | digit | plus | slash) != 0xFFFF : break
            let values = chars + (upper & $splat[i8x16](-65)) + (lower & $splat[i8x16](-71)) + (digit & $splat[i8x16](4))
            values = values + (plus & $splat[i8x16](19)) + (slash & $splat[i8x16](16))
            let g = $bitcast[u32x4](values)
            let packed = ((g << 2) & $splat[u32x4](0x000000FC)) | ((g >> 12) & $splat[u32x4](0x0000000F))
            packed = packed | ((g << 4) & $splat[u32x4](0x0000F000)) | ((g >> 10) & $splat[u32x4](0x00003F00))
            packed = packed | ((g << 6) & $splat[u32x4](0x00C00000)) | ((g >> 8) & $splat[u32x4](0x00FF0000))
            let bytes = $bitcast[u8x16](packed)
            $store(output, o, $shuffle(bytes, bytes, 0, 1, 2, 4, 5, 6, 8, 9, 10, 12, 13, 14, 14, 14, 14, 14))
            i += 16
            o += 12
        }
    }
    while i < full_len {
        let n = decode_table0[in[i].to(uint)] | decode_table1[in[i + 1].to(uint)] | decode_table2[in[i + 2].to(uint)] | decode_table3[in[i + 3].to(uint)]
        if n > 0xFFFFFF : throw .invalid_input
        out[o] = (n >> 16).to(u8)
        out[o + 1] = (n >> 8).to(u8)
        out[o + 2] = n.to(u8)
        i += 4
        o += 3
    }

    // The unused low bits of the last character must be zero
    if left_over == 2 {
        let n = decode_table0[in[i].to(uint)] | decode_table1[in[i + 1].to(uint)]
        if n > 0xFFFFFF || (n & 0xFFFF) != 0 : throw .invalid_input
        out[o] = (n >> 16).to(u8)
        o++
    } else if left_over == 3 {
        let n = decode_table0[in[i].to(uint)] | decode_table1[in[i + 1].to(uint)] | decode_table2[in[i + 2].to(uint)]
        if n > 0xFFFFFF || (n & 0xFF) != 0 : throw .invalid_input
        out[o] = (n >> 16).to(u8)
        out[o + 1] = (n >> 8).to(u8)
        o += 2
    }

    return o
}

/// Returns `data` encoded as URL-safe base64 (`-` and `_`) without `=` padding, the form JWT,
/// JWK and WebAuthn use.
+ fn base64url_encode(data: local &[u8]) String {
    let text = base64_encode(data)
    let out = ByteBuffer.new(text.bytes)
    let i: uint = 0
    while i < text.bytes {
        let ch = text.get(i++)
        if ch == '=' : break
        if ch == '+' : ch = '-'
        else if ch == '/' : ch = '_'
        out.write_byte(ch)
    }
    return out.to_string()
}

/// Decodes URL-safe base64 (`-` and `_`), with or without `=` padding.
///
/// Throws `invalid_input` on the standard alphabet's `+` and `/`, and on anything
/// `base64_decode` rejects.
+ fn base64url_decode(text: local &[u8]) String !CryptoError {
    let out = ByteBuffer.new(text.length)
    let i: uint = 0
    while i < text.length {
        let ch = text[i++]
        if ch == '+' || ch == '/' : throw .invalid_input
        if ch == '-' : ch = '+'
        else if ch == '_' : ch = '/'
        out.write_byte(ch)
    }
    return base64_decode(out) !>
}

use io

global charset: String ("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")

value NEWLINE_INVL (76)

// Input bytes per streamed block. A multiple of 3 so that every block encodes
// to whole base64 quads, and of 4 so that every block decodes on a boundary
value BASE64_CHUNK (504)

// The block is allocated per call, not per iteration, and never shared: a
// reused global would be overwritten by another coroutine while 'out.write'
// is suspended

+ fn base64_encode(data: &[u8]) String {
    @unsafe
    let out = ByteBuffer.new(data.length / 3 * 4 + 4)
    out.reserve(data.length / 3 * 4 + 4)
    out.skip(internal_base64_encode(data.data, out.data, data.length, 0))
    return out.to_string()
}
+ fn base64_decode(data: &[u8]) String !CryptoError {
    @unsafe
    let out = ByteBuffer.new(data.length + 4)
    out.reserve(data.length + 4)
    out.skip(internal_base64_decode(data.data, out.data, data.length) !>)
    return out.to_string()
}

// Base64 of `data`, written to `out` a block at a time, so the encoding needs
// memory for one block rather than for the whole result
+ fn base64_write_encode(data: &[u8], out: io.Writer) uint !io.IoError {
    @unsafe
    let block = ByteBuffer.new(BASE64_CHUNK / 3 * 4 + 4)
    let written: uint = 0
    let offset: uint = 0
    while offset < data.length {
        let take = data.length - offset
        if take > BASE64_CHUNK : take = BASE64_CHUNK
        block.clear()
        block.reserve(take / 3 * 4 + 4)
        let part = data.view(offset, take)
        block.skip(internal_base64_encode(part.data, block.data, take, 0))
        written += out.write(block) !>
        offset += take
    }
    return written
}

// Decodes base64 into `out` a block at a time. Throws `invalid_input` on
// malformed input and `write` on an output failure
+ fn base64_write_decode(data: &[u8], out: io.Writer) uint !CryptoError {
    @unsafe
    let block = ByteBuffer.new(BASE64_CHUNK + 4)
    let written: uint = 0
    let offset: uint = 0
    while offset < data.length {
        let take = data.length - offset
        if take > BASE64_CHUNK : take = BASE64_CHUNK
        // Padding may only appear in the final block, so a full block that is
        // not the last one must stay on a quad boundary
        block.clear()
        block.reserve(take + 4)
        let part = data.view(offset, take)
        block.skip(internal_base64_decode(part.data, block.data, take) !>)
        written += out.write(block) ! throw .write
        offset += take
    }
    return written
}

fn revchar(ch: u8) u8 !CryptoError {
    if (ch >= 'A' && ch <= 'Z') : ch -= 'A'
    else if (ch >= 'a' && ch <= 'z') : ch = ch - 'a' + 26
    else if (ch >= '0' && ch <= '9') : ch = ch - '0' + 52
    else if (ch == '+') : ch = 62
    else if (ch == '/') : ch = 63
    else : throw .invalid_input
    return ch
}

fn internal_base64_encode(in: *[u8], out: *[u8], len: uint, newline_flag: i32) uint {
    @unsafe
    let idx: uint = 0
    let idx2: uint = 0
    let blks: uint = 0
    let blk_ceiling: uint = 0
    let left_over: uint = 0
    let newline_count: uint = 0

    blks = len / 3
    left_over = len % 3

    if out == null {
        idx2 = blks * 4
        if left_over > 0 : idx2 += 4
        if newline_flag > 0 : idx2 += len / 57 // (NEWLINE_INVL / 4) * 3 = 57. One newline per 57 input bytes.
    } else {
        blk_ceiling = blks * 3
        idx = 0
        idx2 = 0
        while idx < blk_ceiling {
            out[idx2] = charset[in[idx] >> 2];
            out[idx2 + 1] = charset[((in[idx] & 0x03) << 4) | (in[idx + 1] >> 4)];
            out[idx2 + 2] = charset[((in[idx + 1] & 0x0f) << 2) | (in[idx + 2] >> 6)];
            out[idx2 + 3] = charset[in[idx + 2] & 0x3F];
            if (((idx2 - newline_count + 4) % NEWLINE_INVL == 0) && newline_flag > 0) {
                out[idx2 + 4] = '\n';
                idx2++;
                newline_count++;
            }
            idx += 3
            idx2 += 4
        }

        if (left_over == 1) {
            out[idx2] = charset[in[idx] >> 2];
            out[idx2 + 1] = charset[(in[idx] & 0x03) << 4];
            out[idx2 + 2] = '=';
            out[idx2 + 3] = '=';
            idx2 += 4;
        }
        else if (left_over == 2) {
            out[idx2] = charset[in[idx] >> 2];
            out[idx2 + 1] = charset[((in[idx] & 0x03) << 4) | (in[idx + 1] >> 4)];
            out[idx2 + 2] = charset[(in[idx + 1] & 0x0F) << 2];
            out[idx2 + 3] = '=';
            idx2 += 4;
        }
    }

    return idx2
}

fn internal_base64_decode(in: *[u8], out: *[u8], len: uint) uint !CryptoError {
    @unsafe
    if len == 0 : return 0

    let padding: uint = 0
    if in[len - 1] == '=' {
        padding++
        if len > 1 && in[len - 2] == '=' : padding++
    }

    if padding > 0 && len % 4 != 0 : throw .invalid_input
    let data_len = len - padding
    let left_over = data_len % 4
    if left_over == 1 : throw .invalid_input
    if padding == 1 && left_over != 3 : throw .invalid_input
    if padding == 2 && left_over != 2 : throw .invalid_input

    let i: uint = 0
    while i < data_len {
        revchar(in[i]) !>
        i++
    }

    if left_over == 2 && (revchar(in[data_len - 1]) !> & 0x0F) != 0 : throw .invalid_input
    if left_over == 3 && (revchar(in[data_len - 1]) !> & 0x03) != 0 : throw .invalid_input

    let full_len = data_len - left_over
    let input_index: uint = 0
    let output_index: uint = 0
    while input_index < full_len {
        let a = revchar(in[input_index]) !>
        let b = revchar(in[input_index + 1]) !>
        let c = revchar(in[input_index + 2]) !>
        let d = revchar(in[input_index + 3]) !>
        if out != null {
            out[output_index] = (a << 2) | ((b & 0x30) >> 4)
            out[output_index + 1] = (b << 4) | (c >> 2)
            out[output_index + 2] = (c << 6) | d
        }
        input_index += 4
        output_index += 3
    }

    if left_over == 2 {
        let a = revchar(in[input_index]) !>
        let b = revchar(in[input_index + 1]) !>
        if out != null : out[output_index] = (a << 2) | ((b & 0x30) >> 4)
        output_index++
    } else if left_over == 3 {
        let a = revchar(in[input_index]) !>
        let b = revchar(in[input_index + 1]) !>
        let c = revchar(in[input_index + 2]) !>
        if out != null {
            out[output_index] = (a << 2) | ((b & 0x30) >> 4)
            out[output_index + 1] = (b << 4) | (c >> 2)
        }
        output_index += 2
    }

    return output_index
}

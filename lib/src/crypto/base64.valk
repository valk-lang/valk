
global charset : String ("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")

value NEWLINE_INVL (76)

+ fn base64_encode(str: String) String {
    let bb = ByteBuffer.new(str.length / 3 * 4 + 4)
    base64_encode_ptr(str.data, str.bytes, bb)
    return bb
}
+ fn base64_decode(str: String) String !CryptoError {
    let bb = ByteBuffer.new(str.length + 4)
    base64_decode_ptr(str.data, str.bytes, bb) !>
    return bb
}
+ fn base64_encode_ptr(data: ptr, len: uint, out: ByteBuffer) {
    out.clear()
    out.reserve_space(len / 3 * 4 + 4)
    out.skip(internal_base64_encode(data, out.data, len, 0))
}
+ fn base64_decode_ptr(data: ptr, len: uint, out: ByteBuffer) !CryptoError {
    out.clear()
    out.reserve_space(len + 4)
    out.skip(internal_base64_decode(data, out.data, len) !>)
}

fn revchar(ch: u8) u8 !CryptoError {
    if (ch >= 'A' && ch <= 'Z') : ch -= 'A'
    else if (ch >= 'a' && ch <='z') : ch = ch - 'a' + 26
    else if (ch >= '0' && ch <='9') : ch = ch - '0' + 52
    else if (ch == '+') : ch = 62
    else if (ch == '/') : ch = 63
    else : throw .invalid_input
    return ch
}

fn internal_base64_encode(in: *[u8], out: *[u8], len: uint, newline_flag: i32) uint {
    let idx : uint = 0
    let idx2 : uint = 0
    let blks : uint = 0
    let blk_ceiling : uint = 0
    let left_over : uint = 0
    let newline_count : uint = 0

    blks = len / 3
    left_over = len % 3

    if out == null {
        idx2 = blks * 4
        if left_over > 0 : idx2 += 4
        if newline_flag > 0 : idx2 += len / 57   // (NEWLINE_INVL / 4) * 3 = 57. One newline per 57 input bytes.
    } else {
        blk_ceiling = blks * 3
        idx = 0
        idx2 = 0
        while idx < blk_ceiling {
            out[idx2]     = charset[in[idx] >> 2];
            out[idx2 + 1] = charset[((in[idx] & 0x03) << 4) | (in[idx + 1] >> 4)];
            out[idx2 + 2] = charset[((in[idx + 1] & 0x0f) << 2) | (in[idx + 2] >> 6)];
            out[idx2 + 3] = charset[in[idx + 2] & 0x3F];
            if (((idx2 - newline_count + 4) % NEWLINE_INVL == 0) && newline_flag > 0) {
                out[idx2 + 4] = '\n';
                idx2++;
                newline_count++;
            }
            idx += 3
            idx2 += 4
        }

        if (left_over == 1) {
            out[idx2]     = charset[in[idx] >> 2];
            out[idx2 + 1] = charset[(in[idx] & 0x03) << 4];
            out[idx2 + 2] = '=';
            out[idx2 + 3] = '=';
            idx2 += 4;
        }
        else if (left_over == 2) {
            out[idx2]     = charset[in[idx] >> 2];
            out[idx2 + 1] = charset[((in[idx] & 0x03) << 4) | (in[idx + 1] >> 4)];
            out[idx2 + 2] = charset[(in[idx + 1] & 0x0F) << 2];
            out[idx2 + 3] = '=';
            idx2 += 4;
        }
    }

    return idx2
}

fn internal_base64_decode(in: *[u8], out: *[u8], len: uint) uint !CryptoError {
    if len == 0 : return 0

    let padding : uint = 0
    if in[len - 1] == '=' {
        padding++
        if len > 1 && in[len - 2] == '=' : padding++
    }

    if padding > 0 && len % 4 != 0 : throw .invalid_input
    let data_len = len - padding
    let left_over = data_len % 4
    if left_over == 1 : throw .invalid_input
    if padding == 1 && left_over != 3 : throw .invalid_input
    if padding == 2 && left_over != 2 : throw .invalid_input

    let i : uint = 0
    while i < data_len {
        revchar(in[i]) !>
        i++
    }

    if left_over == 2 && (revchar(in[data_len - 1]) !> & 0x0F) != 0 : throw .invalid_input
    if left_over == 3 && (revchar(in[data_len - 1]) !> & 0x03) != 0 : throw .invalid_input

    let full_len = data_len - left_over
    let input_index : uint = 0
    let output_index : uint = 0
    while input_index < full_len {
        let a = revchar(in[input_index]) !>
        let b = revchar(in[input_index + 1]) !>
        let c = revchar(in[input_index + 2]) !>
        let d = revchar(in[input_index + 3]) !>
        if out != null {
            out[output_index] = (a << 2) | ((b & 0x30) >> 4)
            out[output_index + 1] = (b << 4) | (c >> 2)
            out[output_index + 2] = (c << 6) | d
        }
        input_index += 4
        output_index += 3
    }

    if left_over == 2 {
        let a = revchar(in[input_index]) !>
        let b = revchar(in[input_index + 1]) !>
        if out != null : out[output_index] = (a << 2) | ((b & 0x30) >> 4)
        output_index++
    } else if left_over == 3 {
        let a = revchar(in[input_index]) !>
        let b = revchar(in[input_index + 1]) !>
        let c = revchar(in[input_index + 2]) !>
        if out != null {
            out[output_index] = (a << 2) | ((b & 0x30) >> 4)
            out[output_index + 1] = (b << 4) | (c >> 2)
        }
        output_index += 2
    }

    return output_index
}

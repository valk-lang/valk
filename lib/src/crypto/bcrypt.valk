use io

/// Length in bytes of a bcrypt hash string (`$2a$...`, 60 bytes).
+ value BCRYPT_HASH_SIZE (60)
value BCRYPT_MIN_COST (4)
value BCRYPT_MAX_COST (31)
value BCRYPT_SALT_LEN (16)
value BCRYPT_SALT_STRING_LEN (22)

/// Hashes `password` with bcrypt and a fresh random salt, for storing credentials.
///
/// Returns the 60-character `$2a$` hash string, which embeds the cost and salt; check a
/// password against it with `bcrypt_verify`. Each step up in `cost` doubles the work.
/// Only the first 72 bytes of `password` affect the hash. Throws `invalid_input` when
/// `cost` is outside 4..31.
+ fn bcrypt_hash(password: local &[u8], cost: uint (12)) String !CryptoError {
    let out: [u8 x BCRYPT_HASH_SIZE] = @undefined
    bcrypt_hash_in(password, &out, cost) !>
    return bytes_to_string(&out)
}

/// Hashes `password` with bcrypt and a fresh random salt into `out` and returns the bytes written (60).
///
/// `out` must hold at least `BCRYPT_HASH_SIZE` (60) bytes; a shorter buffer panics.
/// Throws `invalid_input` when `cost` is outside 4..31.
+ fn bcrypt_hash_in(password: local &[u8], out: local mut &[u8], cost: uint (12)) uint !CryptoError {
    crypto_room(out, BCRYPT_HASH_SIZE, "bcrypt_hash_in")
    let salt: [u8 x BCRYPT_SALT_LEN] = @undefined
    random_bytes_in(&salt)
    return bcrypt_in(password, &salt, cost, out) !>
}

/// Hashes `password` with bcrypt and a fresh random salt to `out` and returns the bytes written (60).
///
/// Throws `invalid_input` when `cost` is outside 4..31, and `write` when `out` fails.
+ fn bcrypt_hash_into(password: local &[u8], out: io.Writer, cost: uint (12)) uint !CryptoError {
    let buf: [u8 x BCRYPT_HASH_SIZE] = @undefined
    bcrypt_hash_in(password, &buf, cost) !>
    io.write_all(out, &buf) ! throw .write
    return BCRYPT_HASH_SIZE
}

/// Returns whether `password` matches the bcrypt `hash` string.
///
/// Accepts `$2a$`, `$2b$` and `$2y$` hashes. A malformed hash, or one with a cost outside
/// 4..31, returns false. The comparison runs in constant time.
+ fn bcrypt_verify(password: local &[u8], hash: local &[u8]) bool {
    // Check the length of the hash string
    if hash.length != BCRYPT_HASH_SIZE : return false

    // This implementation writes the $2a$ prefix; $2b$ (OpenBSD) and $2y$
    // (crypt_blowfish) mark revisions of key-schedule bugs this code does not have,
    // so a hash carrying any of the three describes the same algorithm. Without this
    // a hash copied from another tool could never be verified.
    if !hash.starts_with("$2a$") && !hash.starts_with("$2b$") && !hash.starts_with("$2y$") : return false

    // Parse cost parameter
    let cost_end = hash.index_of_byte('$', 4) ! return false
    let cost = hash.view(4, cost_end - 4).to_uint() ! return false

    // Check the value of the cost parameter
    if cost < BCRYPT_MIN_COST || cost > BCRYPT_MAX_COST : return false

    // Parse salt parameter
    let salt_buf: [u8 x 24] = @undefined
    let salt_len = radix64_decode_in(hash.view(cost_end + 1, BCRYPT_SALT_STRING_LEN), &salt_buf) ! return false

    // Hash the password using bcrypt algorithm
    let computed: [u8 x BCRYPT_HASH_SIZE] = @undefined
    bcrypt_in(password, &salt_buf[0 .. salt_len], cost, &computed) ! return false

    // The revision prefix is skipped: it is whitelisted above and bcrypt() always
    // writes $2a$, so comparing it would reject a $2b$/$2y$ hash outright.
    let i: uint = 4
    let mask: u8 = 0
    while i < BCRYPT_HASH_SIZE {
        mask |= computed[i] ^ hash[i]
        i++
    }

    return mask == 0
}

/// Computes the 60-character `$2a$` bcrypt hash of `password` with the given `salt` and `cost`.
///
/// `salt` must be exactly 16 raw bytes and `cost` within 4..31, otherwise throws
/// `invalid_input`. Most callers want `bcrypt_hash`, which generates the salt.
+ fn bcrypt(password: local &[u8], salt: local &[u8], cost: uint) String !CryptoError {
    let out: [u8 x BCRYPT_HASH_SIZE] = @undefined
    bcrypt_in(password, salt, cost, &out) !>
    return bytes_to_string(&out)
}

/// Computes the bcrypt hash of `password` with `salt` and `cost` into `out` and returns the bytes written (60).
///
/// `out` must hold at least `BCRYPT_HASH_SIZE` (60) bytes; a shorter buffer panics.
/// `salt` must be exactly 16 raw bytes and `cost` within 4..31, otherwise throws `invalid_input`.
+ fn bcrypt_in(password: local &[u8], salt: local &[u8], cost: uint, out: local mut &[u8]) uint !CryptoError {
    crypto_room(out, BCRYPT_HASH_SIZE, "bcrypt_in")
    // A cost outside the range bcrypt_verify() accepts yields a credential that can
    // never be verified, and `1 << 32` wraps to zero expensive rounds.
    if cost < BCRYPT_MIN_COST || cost > BCRYPT_MAX_COST : throw .invalid_input
    // The salt is copied into the hash string verbatim, so only the canonical 16 bytes
    // produce the 60 characters the format promises.
    if salt.length != BCRYPT_SALT_LEN : throw .invalid_input

    let context = BlowfishContext {}
    let pw_buf: [u8 x 72] = { 0... }
    let pw_len = password.length > 72 ? 72 : password.length
    let i: uint = 0
    while i < pw_len {
        pw_buf[i] = password[i]
        i++
    }
    let key_len = pw_len < 72 ? pw_len + 1 : 72

    // Must not be discarded: an aborted key expansion leaves the P and S boxes at the
    // constants blowfish_init_state() wrote, so everything below encrypts the fixed
    // plaintext with a key that contains no trace of the password.
    eks_blowfish_setup(context, cost, salt, &pw_buf[0 .. key_len]) !>

    let ctext: [u8 x 24] = {
        'O', 'r', 'p', 'h', 'e', 'a', 'n', 'B'
        'e', 'h', 'o', 'l', 'd', 'e', 'r', 'S'
        'c', 'r', 'y', 'D', 'o', 'u', 'b', 't'
    }

    // Repeatedly encrypt the text "OrpheanBeholderScryDoubt" 64 times
    i = 0
    while i < 64 {
        blowfish_encrypt_block(context, &ctext[0 .. 8])
        blowfish_encrypt_block(context, &ctext[8 .. 8])
        blowfish_encrypt_block(context, &ctext[16 .. 8])
        i++
    }

    // Format `$2a$CC$` + 22-char salt + 31-char ciphertext directly into `out`
    out[0] = '$'
    out[1] = '2'
    out[2] = 'a'
    out[3] = '$'
    out[4] = ('0' + (cost / 10).to(u8))
    out[5] = ('0' + (cost % 10).to(u8))
    out[6] = '$'
    radix64_encode_in(salt, out.view(7, BCRYPT_SALT_STRING_LEN))
    radix64_encode_in(&ctext[0 .. 23], out.view(29, 31))
    return BCRYPT_HASH_SIZE
}

/// Computes the bcrypt hash of `password` with `salt` and `cost` to `out` and returns the bytes written (60).
///
/// Throws `invalid_input` for an invalid `salt` or `cost`, and `write` when `out` fails.
+ fn bcrypt_into(password: local &[u8], salt: local &[u8], cost: uint, out: io.Writer) uint !CryptoError {
    let buf: [u8 x BCRYPT_HASH_SIZE] = @undefined
    bcrypt_in(password, salt, cost, &buf) !>
    io.write_all(out, &buf) ! throw .write
    return BCRYPT_HASH_SIZE
}

// Expensive key setup
fn eks_blowfish_setup(context: BlowfishContext, cost: uint, salt: local &[u8], password: local &[u8]) !CryptoError {
    blowfish_init_state(context)
    blowfish_expand_key(context, salt, password) !>

    let n: u32 = 1.to(u32) << cost.to(u32)
    let i: u32 = 0
    while i < n {
        blowfish_expand_key(context, "", password) !>
        blowfish_expand_key(context, "", salt) !>
        i++
    }
}

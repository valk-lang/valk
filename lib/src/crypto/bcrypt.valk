value BCRYPT_HASH_STRING_LEN (60)
value BCRYPT_MIN_COST (3)
value BCRYPT_MAX_COST (31)
value BCRYPT_SALT_LEN (16)
value BCRYPT_SALT_STRING_LEN (22)

+ fn bcrypt_hash(password: String, cost: uint (12)) String !CryptoError {
    // Generate a 16-byte random salt
    let salt = random_bytes(BCRYPT_SALT_LEN) !>
    // Generate hash
    let hash = ByteBuffer.new(BCRYPT_HASH_STRING_LEN)
    bcrypt(cost, salt, password, hash) !>
    return hash
}

+ fn bcrypt_verify(password: String, hash: String) bool {
    let cost: uint = 0

    // Check the length of the hash string
    if hash.length != BCRYPT_HASH_STRING_LEN : return false

    // This implementation writes the $2a$ prefix; $2b$ (OpenBSD) and $2y$
    // (crypt_blowfish) mark revisions of key-schedule bugs this code does not have,
    // so a hash carrying any of the three describes the same algorithm. Without this
    // a hash copied from another tool could never be verified.
    if !hash.starts_with("$2a$") && !hash.starts_with("$2b$") && !hash.starts_with("$2y$") : return false

    // Parse cost parameter
    let cost_end = hash.index_of_byte('$', 4) ! return false
    cost = hash.part(4, cost_end - 4).to_uint() ! return false

    // Check the value of the cost parameter
    if cost < BCRYPT_MIN_COST || cost > BCRYPT_MAX_COST : return false

    // Parse salt parameter
    let hash_buf = ByteBuffer.new(BCRYPT_SALT_STRING_LEN)
    hash_buf.write(hash.part(cost_end + 1, BCRYPT_SALT_STRING_LEN))
    let salt_buf = ByteBuffer.new(32)
    radix64_decode(hash_buf, salt_buf) ! return false
    let salt: String = salt_buf

    // Hash the password using bcrypt algorithm
    hash_buf.clear()
    hash_buf.reserve(BCRYPT_HASH_STRING_LEN)
    bcrypt(cost, salt, password, hash_buf) ! return false

    // The calculated string is bitwise compared to the hash string. The password is correct if and only if the strings match
    // The revision prefix is skipped: it is whitelisted above and bcrypt() always
    // writes $2a$, so comparing it would reject a $2b$/$2y$ hash outright.
    let i: uint = 4
    let mask: u8 = 0
    while i < BCRYPT_HASH_STRING_LEN {
        mask |= hash_buf[i] ^ hash[i]
        i++
    }

    return mask == 0
}

+ fn bcrypt(cost: uint, salt: String, password: String, output: ByteBuffer) !CryptoError {
    // A cost outside the range bcrypt_verify() accepts yields a credential that can
    // never be verified, and `1 << 32` wraps to zero expensive rounds.
    if cost < BCRYPT_MIN_COST || cost > BCRYPT_MAX_COST : throw .invalid_input
    // The salt is copied into the hash string verbatim, so only the canonical 16 bytes
    // produce the 60 characters the format promises.
    if salt.length != BCRYPT_SALT_LEN : throw .invalid_input

    let context = BlowfishContext {}
    let buf1 = ByteBuffer.new(BCRYPT_SALT_LEN)
    let buf2 = ByteBuffer.new(24)
    buf1.write(salt)
    buf2.write(password)
    buf2.write_byte(0)

    // Must not be discarded: an aborted key expansion leaves the P and S boxes at the
    // constants blowfish_init_state() wrote, so everything below encrypts the fixed
    // plaintext with a key that contains no trace of the password.
    eks_blowfish_setup(context, cost, buf1, buf2) !>

    buf2.clear()
    buf2.write("OrpheanBeholderScryDoubt")

    // Repeatedly encrypt the text "OrpheanBeholderScryDoubt" 64 times
    let i: uint = 0
    let data: *[u8 x 24] = buf2.data
    while i < 64 {
        // Perform encryption using Blowfish in ECB mode
        blowfish_encrypt_block(context, data, data)
        blowfish_encrypt_block(context, data + 8, data + 8)
        blowfish_encrypt_block(context, data + 16, data + 16)
        i++
    }

    // bcrypt uses the $2a$ prefix in the hash string
    let hash_start = "$2a$%{ cost.to_base(10).pad_left('0', 2) }$"

    // Concatenate the salt and the ciphertext
    let buf3 = ByteBuffer.new(24)
    output.clear()
    output.write(hash_start)
    radix64_encode(buf1, buf3)
    buf2.truncate(buf2.length - 1) // Remove last character
    output.write(buf3)
    buf3.clear()
    radix64_encode(buf2, buf3)
    output.write(buf3)
}

// Expensive key setup
fn eks_blowfish_setup(context: BlowfishContext, cost: uint, salt: ByteBuffer, password: ByteBuffer) !CryptoError {
    // Initialize Blowfish state
    blowfish_init_state(context)
    // Perform the first key expansion
    blowfish_expand_key(context, salt, password) !>

    // The cost parameter specifies a key expansion iteration count as a power of two
    let n: u32 = 1.to(u32) << cost.to(u32)
    // Iterate as many times as desired
    let i: u32 = 0
    while i < n {
        // Perform key expansion with password
        blowfish_expand_key(context, null, password) !>
        // Perform key expansion with salt
        blowfish_expand_key(context, null, salt) !>
        i++
    }
}

use mem

fn ROTRIGHT(a: u32, b: u32) u32 $inline { return (a >> b) | (a << (32 - b)) }

fn CH(x: u32, y: u32, z: u32) u32 $inline { return (x & y) ^ (~x & z) }
fn MAJ(x: u32, y: u32, z: u32) u32 $inline { return (x & y) ^ (x & z) ^ (y & z) }
fn EP0(x: u32) u32 $inline { return ROTRIGHT(x, 2) ^ ROTRIGHT(x, 13) ^ ROTRIGHT(x, 22) }
fn EP1(x: u32) u32 $inline { return ROTRIGHT(x, 6) ^ ROTRIGHT(x, 11) ^ ROTRIGHT(x, 25) }
fn SIG0(x: u32) u32 $inline { return ROTRIGHT(x, 7) ^ ROTRIGHT(x, 18) ^ (x >> 3) }
fn SIG1(x: u32) u32 $inline { return ROTRIGHT(x, 17) ^ ROTRIGHT(x, 19) ^ (x >> 10) }

// One round; the caller rotates the roles of a..h instead of moving the values
fn sha256_round(a: u32, b: u32, c: u32, d: local mut &u32, e: u32, f: u32, g: u32, h: local mut &u32, kw: u32) $inline {
    let t1 = h[0] + EP1(e) + CH(e, f, g) + kw
    d[0] += t1
    h[0] = t1 + EP0(a) + MAJ(a, b, c)
}

// Hashes the 64-byte block at `data` into `state`
fn sha256_compress(state: local mut &[u32 x 8], data: *[u8]) {
    let w: [u32 x 16] = @undefined
    let i: uint = 0
    while i < 16 {
        w[i] = load_be32(data, i * 4)
        i++
    }

    let a = state[0]
    let b = state[1]
    let c = state[2]
    let d = state[3]
    let e = state[4]
    let f = state[5]
    let g = state[6]
    let h = state[7]

    // 16 rounds at a time; the message schedule is kept as a 16-word window
    let r: uint = 0
    while r < 64 {
        if r > 0 {
            i = 0
            while i < 16 {
                w[i] += SIG1(w[(i + 14) & 15]) + w[(i + 9) & 15] + SIG0(w[(i + 1) & 15])
                i++
            }
        }
        sha256_round(a, b, c, &d, e, f, g, &h, k[r] + w[0])
        sha256_round(h, a, b, &c, d, e, f, &g, k[r + 1] + w[1])
        sha256_round(g, h, a, &b, c, d, e, &f, k[r + 2] + w[2])
        sha256_round(f, g, h, &a, b, c, d, &e, k[r + 3] + w[3])
        sha256_round(e, f, g, &h, a, b, c, &d, k[r + 4] + w[4])
        sha256_round(d, e, f, &g, h, a, b, &c, k[r + 5] + w[5])
        sha256_round(c, d, e, &f, g, h, a, &b, k[r + 6] + w[6])
        sha256_round(b, c, d, &e, f, g, h, &a, k[r + 7] + w[7])
        sha256_round(a, b, c, &d, e, f, g, &h, k[r + 8] + w[8])
        sha256_round(h, a, b, &c, d, e, f, &g, k[r + 9] + w[9])
        sha256_round(g, h, a, &b, c, d, e, &f, k[r + 10] + w[10])
        sha256_round(f, g, h, &a, b, c, d, &e, k[r + 11] + w[11])
        sha256_round(e, f, g, &h, a, b, c, &d, k[r + 12] + w[12])
        sha256_round(d, e, f, &g, h, a, b, &c, k[r + 13] + w[13])
        sha256_round(c, d, e, &f, g, h, a, &b, k[r + 14] + w[14])
        sha256_round(b, c, d, &e, f, g, h, &a, k[r + 15] + w[15])
        r += 16
    }

    state[0] += a
    state[1] += b
    state[2] += c
    state[3] += d
    state[4] += e
    state[5] += f
    state[6] += g
    state[7] += h
}

global k: [u32 x 64] ({
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
})

/// A streaming SHA-256 `Hasher`; a literal `Sha256 {}` is ready for input.
+ class Sha256 is Hasher, KeyedHasher {
    data: [u8 x 64] ({ 0... })
    datalen: uint (0)
    total: u64 (0)
    state: [u32 x 8] ({ 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 })

    /// Returns the hasher to its initial state, discarding all input fed so far.
    + fn reset() {
        this.state = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 }
        this.datalen = 0
        this.total = 0
    }

    /// Feeds more input into the hash.
    + fn update(data: local &[u8]) {
        @unsafe
        let length = data.length
        let i: uint = 0
        if this.datalen > 0 {
            i = 64 - this.datalen
            if i > length : i = length
            mem.copy_bytes(data.data, @ref(this.data).@offset(this.datalen), i)
            this.datalen += i
            if this.datalen < 64 {
                this.total += length.to(u64)
                return
            }
            sha256_compress(&this.state, @ref(this.data))
            this.datalen = 0
        }
        // Whole blocks are hashed where they are
        while length - i >= 64 {
            sha256_compress(&this.state, data.data.@offset(i))
            i += 64
        }
        this.datalen = length - i
        mem.copy_bytes(data.data.@offset(i), @ref(this.data), this.datalen)
        this.total += length.to(u64)
    }

    /// Writes the 32-byte digest into `out` and returns 32.
    ///
    /// `out` must hold at least 32 bytes. Call `reset` before hashing new input.
    + fn finish(out: local mut &[u8]) uint {
        @unsafe
        if out.length < 32 : panic("Sha256.finish: the output buffer is shorter than 32 bytes")
        let i = this.datalen
        this.data[i++] = 0x80
        if i > 56 {
            mem.clear_bytes(@ref(this.data).@offset(i), 64 - i)
            sha256_compress(&this.state, @ref(this.data))
            i = 0
        }
        mem.clear_bytes(@ref(this.data).@offset(i), 56 - i)
        store_be64(@ref(this.data), 56, this.total * 8)
        sha256_compress(&this.state, @ref(this.data))
        i = 0
        while i < 8 {
            store_be32(out.data, i * 4, this.state[i])
            i++
        }
        return 32
    }

    /// Returns 32, the SHA-256 digest size in bytes.
    + fn digest_size() uint { return 32 }
    /// Returns 64, the SHA-256 block size in bytes.
    + fn block_size() uint { return 64 }

    // For Hmac: the state after a whole number of blocks
    fn save(to: local mut &[u64 x 8]) {
        let i: uint = 0
        while i < 8 {
            to[i] = this.state[i].to(u64)
            i++
        }
    }

    fn restore(from: local &[u64 x 8], total: u64) {
        let i: uint = 0
        while i < 8 {
            this.state[i] = from[i].to(u32)
            i++
        }
        this.datalen = 0
        this.total = total
    }
}

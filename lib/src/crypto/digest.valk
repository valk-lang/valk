// A common face for the hash functions, so that HMAC and the key derivation
// functions work with any of them

use io
use coro

// Bytes buffered before each write when streaming into an 'io.Writer', so the
// work needs memory for the chunk rather than for the whole result
value ENCODE_CHUNK (512)

// Streaming borrows the current coroutine's scratch buffer, so the work needs
// memory for one chunk rather than for the whole result, and no allocation at
// all after a coroutine's first call. A plain global would be wrong here:
// 'out.write' can suspend, and a second coroutine on the same thread would
// then overwrite the bytes the kernel is still reading.
//
// The digest below stays a per-call slice on purpose: 'hash_write_hex' holds a
// digest while hex encoding it, and only one scratch buffer exists per coroutine

/// The hash functions available through `hasher`, `hash` and `Hmac`.
+ enum HashAlgorithm {
    /// MD5, a 16-byte digest. Broken for collision resistance; use only for compatibility.
    md5
    /// SHA-1, a 20-byte digest. Broken for collision resistance; use only for compatibility.
    sha1
    /// SHA-256, a 32-byte digest.
    sha256
    /// SHA-384, a 48-byte digest.
    sha384
    /// SHA-512, a 64-byte digest.
    sha512
}

/// A streaming hash function: feed input with `update`, then read the digest with `finish`.
///
/// Implemented by `Md5`, `Sha1`, `Sha256`, `Sha512` (also SHA-384) and `Hmac`.
+ interface Hasher {
    /// Feeds more input into the hash.
    + fn update(data: &[u8]);
    /// Writes the digest into `out` and returns its size in bytes.
    ///
    /// `out` must hold at least `digest_size()` bytes. The hasher must be `reset` before it is
    /// used again.
    + fn finish(out: mut &[u8]) uint;
    /// Returns the hasher to its initial state, discarding all input fed so far.
    + fn reset();
    /// Returns the digest size in bytes.
    + fn digest_size() uint;
    /// Returns the size in bytes of the blocks the hash function processes (64 or 128).
    + fn block_size() uint;
}

/// Returns a fresh `Hasher` for `algorithm`.
+ fn hasher(algorithm: HashAlgorithm) Hasher {
    if algorithm == HashAlgorithm.md5 : return Md5 {}
    if algorithm == HashAlgorithm.sha1 : return Sha1 {}
    if algorithm == HashAlgorithm.sha256 : return Sha256 {}
    if algorithm == HashAlgorithm.sha384 : return Sha512.sha384()
    return Sha512 {}
}

/// Returns the digest size in bytes of `algorithm`.
+ fn digest_size(algorithm: HashAlgorithm) uint {
    if algorithm == HashAlgorithm.md5 : return 16
    if algorithm == HashAlgorithm.sha1 : return 20
    if algorithm == HashAlgorithm.sha256 : return 32
    if algorithm == HashAlgorithm.sha384 : return 48
    return 64
}

/// Returns the raw digest of `data` as binary bytes (not text).
+ fn hash(algorithm: HashAlgorithm, data: &[u8]) String {
    let h = hasher(algorithm)
    h.update(data)
    let out = [u8]{ 0 x h.digest_size() }
    h.finish(out)
    return bytes_to_string(out)
}

/// Returns the digest of `data` as lowercase hex.
+ fn hash_hex(algorithm: HashAlgorithm, data: &[u8]) String {
    return hex_encode(hash(algorithm, data))
}

/// Writes the raw digest of `data` to `out` and returns the bytes written.
+ fn hash_write(algorithm: HashAlgorithm, data: &[u8], out: io.Writer) uint !io.IoError {
    let buf = digest_of(algorithm, data)
    return out.write(buf) !>
}

/// Writes the digest of `data` as lowercase hex to `out` and returns the bytes written.
+ fn hash_write_hex(algorithm: HashAlgorithm, data: &[u8], out: io.Writer) uint !io.IoError {
    let buf = digest_of(algorithm, data)
    return hex_write_encode(buf, out) !>
}

// The raw digest of `data`, at most 64 bytes
- fn digest_of(algorithm: HashAlgorithm, data: &[u8]) &[u8] {
    let h = hasher(algorithm)
    h.update(data)
    let buf = [u8]{ 0 x h.digest_size() }
    let size = h.finish(buf)
    return buf.view(0, size)
}

/// Returns the MD5 digest of `data` as lowercase hex.
+ fn md5_hex(data: &[u8]) String { return hash_hex(HashAlgorithm.md5, data) }
/// Returns the SHA-1 digest of `data` as lowercase hex.
+ fn sha1_hex(data: &[u8]) String { return hash_hex(HashAlgorithm.sha1, data) }
/// Returns the SHA-256 digest of `data` as lowercase hex.
+ fn sha256_hex(data: &[u8]) String { return hash_hex(HashAlgorithm.sha256, data) }
/// Returns the SHA-384 digest of `data` as lowercase hex.
+ fn sha384_hex(data: &[u8]) String { return hash_hex(HashAlgorithm.sha384, data) }
/// Returns the SHA-512 digest of `data` as lowercase hex.
+ fn sha512_hex(data: &[u8]) String { return hash_hex(HashAlgorithm.sha512, data) }

/// Writes the MD5 digest of `data` as lowercase hex to `out`; returns the bytes written.
+ fn md5_write_hex(data: &[u8], out: io.Writer) uint !io.IoError { return hash_write_hex(HashAlgorithm.md5, data, out) !> }
/// Writes the SHA-1 digest of `data` as lowercase hex to `out`; returns the bytes written.
+ fn sha1_write_hex(data: &[u8], out: io.Writer) uint !io.IoError { return hash_write_hex(HashAlgorithm.sha1, data, out) !> }
/// Writes the SHA-256 digest of `data` as lowercase hex to `out`; returns the bytes written.
+ fn sha256_write_hex(data: &[u8], out: io.Writer) uint !io.IoError { return hash_write_hex(HashAlgorithm.sha256, data, out) !> }
/// Writes the SHA-384 digest of `data` as lowercase hex to `out`; returns the bytes written.
+ fn sha384_write_hex(data: &[u8], out: io.Writer) uint !io.IoError { return hash_write_hex(HashAlgorithm.sha384, data, out) !> }
/// Writes the SHA-512 digest of `data` as lowercase hex to `out`; returns the bytes written.
+ fn sha512_write_hex(data: &[u8], out: io.Writer) uint !io.IoError { return hash_write_hex(HashAlgorithm.sha512, data, out) !> }

/// Returns `data` encoded as lowercase hex, two characters per byte.
+ fn hex_encode(data: &[u8]) String {
    let digits = "0123456789abcdef"
    let out = ByteBuffer.new(data.length * 2)
    let i: uint = 0
    while i < data.length {
        let byte = data[i]
        out.write_byte(digits[(byte >> 4).to(uint)])
        out.write_byte(digits[(byte & 15).to(uint)])
        i++
    }
    return out.to_string()
}

/// Writes `data` as lowercase hex to `out` and returns the bytes written.
///
/// Output is buffered in 512-byte chunks, so memory use does not grow with `data`.
+ fn hex_write_encode(data: &[u8], out: io.Writer) uint !io.IoError {
    let digits = "0123456789abcdef"
    let chunk = coro.temp_buffer()
    chunk.reserve(ENCODE_CHUNK)
    let written: uint = 0
    let i: uint = 0
    while i < data.length {
        let byte = data[i]
        chunk.write_byte(digits[(byte >> 4).to(uint)])
        chunk.write_byte(digits[(byte & 15).to(uint)])
        if chunk.length == ENCODE_CHUNK {
            written += out.write(chunk) !>
            chunk.clear()
        }
        i++
    }
    if chunk.length > 0 : written += out.write(chunk) !>
    return written
}

/// Decodes hex text (either case) into the raw bytes it represents.
///
/// Throws `invalid_input` on an odd length or a non-hex character.
+ fn hex_decode(text: &[u8]) String !CryptoError {
    if text.length % 2 != 0 : throw .invalid_input
    let out = ByteBuffer.new(text.length / 2)
    let i: uint = 0
    while i < text.length {
        let high = hex_value(text[i]) !>
        let low = hex_value(text[i + 1]) !>
        out.write_byte((high << 4) | low)
        i += 2
    }
    return out.to_string()
}

/// Decodes hex text (either case) into `out` and returns the bytes written.
///
/// Output is buffered in 512-byte chunks. Throws `invalid_input` on an odd length or a
/// non-hex character, and `write` when `out` fails; chunks decoded before the error have
/// already been written.
+ fn hex_write_decode(text: &[u8], out: io.Writer) uint !CryptoError {
    if text.length % 2 != 0 : throw .invalid_input
    let chunk = coro.temp_buffer()
    chunk.reserve(ENCODE_CHUNK)
    let written: uint = 0
    let i: uint = 0
    while i < text.length {
        let high = hex_value(text[i]) !>
        let low = hex_value(text[i + 1]) !>
        chunk.write_byte((high << 4) | low)
        if chunk.length == ENCODE_CHUNK {
            written += out.write(chunk) ! throw .write
            chunk.clear()
        }
        i += 2
    }
    if chunk.length > 0 : written += out.write(chunk) ! throw .write
    return written
}

fn hex_value(c: u8) u8 !CryptoError {
    if c >= '0' && c <= '9' : return c - '0'
    if c >= 'a' && c <= 'f' : return c - 'a' + 10
    if c >= 'A' && c <= 'F' : return c - 'A' + 10
    throw .invalid_input
}

/// Returns whether `a` and `b` hold the same bytes, in time that depends only on their length.
///
/// Use it to compare MACs and tokens without leaking where they differ. Different lengths
/// return false immediately.
+ fn constant_time_equals(a: &[u8], b: &[u8]) bool {
    if a.length != b.length : return false
    let diff: u8 = 0
    let i: uint = 0
    while i < a.length {
        diff = diff | (a[i] ^ b[i])
        i++
    }
    return diff == 0
}

fn bytes_to_string(data: &[u8]) String {
    let out = ByteBuffer.new(data.length)
    out.write(data)
    return out.to_string()
}


fn derive_pkey_secret(priv: EVP_PKEY, peer: EVP_PKEY) String !KeyError {
    @unsafe
    let ctx = EVP_PKEY_CTX_new(priv, null) ?! {
        ERR_clear_error()
        throw .failed
    }
    let length: uint = 0
    let ok = EVP_PKEY_derive_init(ctx) == 1
        && EVP_PKEY_derive_set_peer(ctx, peer) == 1
        && EVP_PKEY_derive(ctx, null, @ref(length)) == 1
    if !ok || length == 0 {
        EVP_PKEY_CTX_free(ctx)
        ERR_clear_error()
        throw .failed
    }
    let secret = String.alloc(length)
    ok = EVP_PKEY_derive(ctx, secret.data, @ref(length)) == 1
    EVP_PKEY_CTX_free(ctx)
    if !ok {
        ERR_clear_error()
        throw .failed
    }
    if length < secret.bytes : return secret.range(0, length)
    return secret
}

/// An X25519 (RFC 7748) key pair for Diffie-Hellman key agreement.
///
/// Generate a fresh key with `X25519Key.generate()`, exchange the 32-byte `public_key()`
/// with the peer, and call `derive(peer_public_key)` to compute the 32-byte shared secret.
/// Pass the derived secret through a KDF such as `hkdf` before using it as a symmetric key.
+ class X25519Key {
    - handle: EVP_PKEY

    /// Generates a new random X25519 key pair.
    + static fn generate() SELF !KeyError {
        let key = generate_key(EVP_PKEY_X25519, 0, 0) !>
        return SELF { handle: key }
    }

    /// Loads an X25519 key pair from a 32-byte raw private scalar.
    ///
    /// Throws `invalid_input` if `private_bytes` is not 32 bytes long.
    + static fn from_raw(private_bytes: local &[u8]) SELF !KeyError {
        @unsafe
        if private_bytes.length != 32 : throw .invalid_input
        let key = EVP_PKEY_new_raw_private_key(EVP_PKEY_X25519, null, private_bytes.data, 32) ?! {
            ERR_clear_error()
            throw .key
        }
        return SELF { handle: key }
    }

    /// Returns the 32-byte raw public key.
    + fn public_key() String !KeyError {
        @unsafe
        let out = String.alloc(32)
        let length: uint = 32
        if EVP_PKEY_get_raw_public_key(this.handle, out.data, @ref(length)) != 1 || length != 32 {
            ERR_clear_error()
            throw .failed
        }
        return out
    }

    /// Returns the 32-byte raw private key.
    + fn private_key() String !KeyError {
        @unsafe
        let out = String.alloc(32)
        let length: uint = 32
        if EVP_PKEY_get_raw_private_key(this.handle, out.data, @ref(length)) != 1 || length != 32 {
            ERR_clear_error()
            throw .failed
        }
        return out
    }

    /// Computes the 32-byte X25519 shared secret with `peer_public_key` (32 bytes).
    ///
    /// Throws `invalid_input` if `peer_public_key` is not 32 bytes, or `failed` for
    /// low-order / all-zero peer keys.
    + fn derive(peer_public_key: local &[u8]) String !KeyError {
        @unsafe
        if peer_public_key.length != 32 : throw .invalid_input
        let peer = EVP_PKEY_new_raw_public_key(EVP_PKEY_X25519, null, peer_public_key.data, 32) ?! {
            ERR_clear_error()
            throw .key
        }
        let secret = derive_pkey_secret(this.handle, peer) ! {
            EVP_PKEY_free(peer)
            throw E
        }
        EVP_PKEY_free(peer)
        return secret
    }

    fn clone() SELF {
        @unsafe
        EVP_PKEY_up_ref(this.handle)
        return SELF { handle: this.handle }
    }

    fn gc_free() {
        @unsafe
        EVP_PKEY_free(this.handle)
    }
}

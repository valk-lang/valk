use mem

global KECCAK_RC: [u64 x 24] ({
    0x0000000000000001, 0x0000000000008082, 0x800000000000808a, 0x8000000080008000
    0x000000000000808b, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009
    0x000000000000008a, 0x0000000000000088, 0x0000000080008009, 0x000000008000000a
    0x000000008000808b, 0x800000000000008b, 0x8000000000008089, 0x8000000000008003
    0x8000000000008002, 0x8000000000000080, 0x000000000000800a, 0x800000008000000a
    0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008
})

global KECCAK_ROTC: [u8 x 24] ({
    1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 2, 14
    27, 41, 56, 8, 25, 43, 62, 18, 39, 61, 20, 44
})

global KECCAK_PILN: [u8 x 24] ({
    10, 7, 11, 17, 18, 3, 5, 16, 8, 21, 24, 4
    15, 23, 19, 13, 12, 2, 20, 14, 22, 9, 6, 1
})

fn keccak_rotl64(x: u64, n: u64) u64 $inline {
    return (x << n) | (x >> (64 - n))
}

fn keccak_f1600(st: local mut &[u64 x 25]) {
    let bc: [u64 x 5] = @undefined
    let round: uint = 0
    while round < 24 {
        // Theta
        let i: uint = 0
        while i < 5 {
            bc[i] = st[i] ^ st[i + 5] ^ st[i + 10] ^ st[i + 15] ^ st[i + 20]
            i++
        }
        i = 0
        while i < 5 {
            let t = bc[(i + 4) % 5] ^ keccak_rotl64(bc[(i + 1) % 5], 1)
            let j: uint = 0
            while j < 25 {
                st[j + i] = st[j + i] ^ t
                j += 5
            }
            i++
        }

        // Rho + Pi
        let t = st[1]
        i = 0
        while i < 24 {
            let j = KECCAK_PILN[i].to(uint)
            let next = st[j]
            st[j] = keccak_rotl64(t, KECCAK_ROTC[i].to(u64))
            t = next
            i++
        }

        // Chi
        let j: uint = 0
        while j < 25 {
            i = 0
            while i < 5 {
                bc[i] = st[j + i]
                i++
            }
            i = 0
            while i < 5 {
                st[j + i] = bc[i] ^ ((~bc[(i + 1) % 5]) & bc[(i + 2) % 5])
                i++
            }
            j += 5
        }

        // Iota
        st[0] = st[0] ^ KECCAK_RC[round]
        round++
    }
}

/// A streaming SHA-3 (FIPS 202) hash supporting SHA3-256 and SHA3-512.
///
/// Implements `Hasher`. Create one with `Sha3.sha3_256()` or `Sha3.sha3_512()`.
+ class Sha3 is Hasher {
    - state: [u64 x 25] ({ 0... })
    - buf: [u8 x 136] ({ 0... })
    - pos: uint (0)
    - rate: uint
    - out_len: uint

    /// Creates a streaming SHA3-256 hasher (32-byte digest, 136-byte block rate).
    + static fn sha3_256() SELF {
        return SELF { rate: 136, out_len: 32 }
    }

    /// Creates a streaming SHA3-512 hasher (64-byte digest, 72-byte block rate).
    + static fn sha3_512() SELF {
        return SELF { rate: 72, out_len: 64 }
    }

    /// Returns the digest size in bytes (32 or 64).
    + fn digest_size() uint {
        return this.out_len
    }

    /// Returns the sponge block rate in bytes (136 for SHA3-256, 72 for SHA3-512).
    + fn block_size() uint {
        return this.rate
    }

    /// Discards all input fed so far and resets the sponge state.
    + fn reset() {
        let i: uint = 0
        while i < 25 {
            this.state[i] = 0
            i++
        }
        this.pos = 0
    }

    fn absorb(block: local &[u8]) {
        let lanes = this.rate / 8
        let i: uint = 0
        while i < lanes {
            let off = i * 8
            let w: u64 = block[off].to(u64)
                | (block[off + 1].to(u64) << 8)
                | (block[off + 2].to(u64) << 16)
                | (block[off + 3].to(u64) << 24)
                | (block[off + 4].to(u64) << 32)
                | (block[off + 5].to(u64) << 40)
                | (block[off + 6].to(u64) << 48)
                | (block[off + 7].to(u64) << 56)
            this.state[i] = this.state[i] ^ w
            i++
        }
        keccak_f1600(&this.state)
    }

    /// Feeds more input bytes into the hash.
    + fn update(data: local &[u8]) {
        let offset: uint = 0
        let rate = this.rate
        let buf: local mut &[u8] = &this.buf
        if this.pos > 0 {
            let need = rate - this.pos
            let take = data.length < need ? data.length : need
            mem.copy(data.view(0, take), buf.view(this.pos, take))
            this.pos += take
            offset += take
            if this.pos == rate {
                this.absorb(buf.view(0, rate))
                this.pos = 0
            }
        }
        while data.length - offset >= rate {
            this.absorb(data.view(offset, rate))
            offset += rate
        }
        let rem = data.length - offset
        if rem > 0 {
            mem.copy(data.view(offset, rem), buf.view(0, rem))
            this.pos = rem
        }
    }

    /// Writes the digest into `out` and returns its size in bytes.
    ///
    /// `out` must hold at least `digest_size()` bytes; a shorter buffer panics.
    + fn finish(out: local mut &[u8]) uint {
        crypto_room(out, this.out_len, "Sha3.finish")
        let rate = this.rate
        let i = this.pos
        while i < rate {
            this.buf[i] = 0
            i++
        }
        this.buf[this.pos] = 0x06
        this.buf[rate - 1] = this.buf[rate - 1] ^ 0x80
        let buf: local &[u8] = &this.buf
        this.absorb(buf.view(0, rate))
        this.pos = 0

        let words = this.out_len / 8
        let w_idx: uint = 0
        while w_idx < words {
            let w = this.state[w_idx]
            let off = w_idx * 8
            out[off] = (w & 0xff).to(u8)
            out[off + 1] = ((w >> 8) & 0xff).to(u8)
            out[off + 2] = ((w >> 16) & 0xff).to(u8)
            out[off + 3] = ((w >> 24) & 0xff).to(u8)
            out[off + 4] = ((w >> 32) & 0xff).to(u8)
            out[off + 5] = ((w >> 40) & 0xff).to(u8)
            out[off + 6] = ((w >> 48) & 0xff).to(u8)
            out[off + 7] = ((w >> 56) & 0xff).to(u8)
            w_idx++
        }
        return this.out_len
    }
}

/// Returns the raw 32-byte SHA3-256 digest of `data`.
+ fn sha3_256(data: local &[u8]) String {
    let h = Sha3.sha3_256()
    h.update(data)
    let out: [u8 x 32] = @undefined
    h.finish(&out)
    return bytes_to_string(&out)
}

/// Returns the SHA3-256 digest of `data` as 64 lowercase hex characters.
+ fn sha3_256_hex(data: local &[u8]) String {
    let h = Sha3.sha3_256()
    h.update(data)
    let out: [u8 x 32] = @undefined
    h.finish(&out)
    return hex_encode(&out)
}

/// Returns the raw 64-byte SHA3-512 digest of `data`.
+ fn sha3_512(data: local &[u8]) String {
    let h = Sha3.sha3_512()
    h.update(data)
    let out: [u8 x 64] = @undefined
    h.finish(&out)
    return bytes_to_string(&out)
}

/// Returns the SHA3-512 digest of `data` as 128 lowercase hex characters.
+ fn sha3_512_hex(data: local &[u8]) String {
    let h = Sha3.sha3_512()
    h.update(data)
    let out: [u8 x 64] = @undefined
    h.finish(&out)
    return hex_encode(&out)
}

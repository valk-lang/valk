// libcrypto for ciphers, keys and signatures. Depending on the target and the build this is
// OpenSSL 1.1.1 or 3, so only functions both export are bound here

#if OS == "win"
link "libcrypto"
link "advapi32"
link "user32"
link "bcrypt"
link "crypt32"
link "ws2_32"
#else
link "crypto"
#end
#if OS == "linux"
link dynamic "dl"
link ":libc_nonshared.a"
#end

// C `long` is 32 bits on Windows
#if OS == "win"
type c_long (i32)
#else
type c_long (int)
#end

pointer EVP_CIPHER_CTX {}
pointer EVP_CIPHER {}
pointer EVP_PKEY {}
pointer EVP_PKEY_CTX {}
pointer EVP_MD_CTX {}
pointer EVP_MD {}
pointer BIO {}
pointer X509 {}

value EVP_CTRL_AEAD_SET_IVLEN (0x9)
value EVP_CTRL_AEAD_GET_TAG (0x10)
value EVP_CTRL_AEAD_SET_TAG (0x11)

value EVP_PKEY_RSA (6)
value EVP_PKEY_EC (408)
value EVP_PKEY_ED25519 (1087)
value NID_X9_62_PRIME256V1 (415)
value NID_SECP384R1 (715)
value NID_SECP521R1 (716)

// The EVP_PKEY_CTX_set_* helpers are macros in 1.1.1; these are the controls they send
value EVP_PKEY_CTRL_RSA_PADDING (0x1001)
value EVP_PKEY_CTRL_RSA_PSS_SALTLEN (0x1002)
value EVP_PKEY_CTRL_RSA_KEYGEN_BITS (0x1003)
value EVP_PKEY_CTRL_EC_PARAMGEN_CURVE_NID (0x1001)
value RSA_PKCS1_PSS_PADDING (6)
value RSA_PSS_SALTLEN_DIGEST (-1)
value BIO_CTRL_INFO (3)

extern fn EVP_CIPHER_CTX_new() ?EVP_CIPHER_CTX;
extern fn EVP_CIPHER_CTX_free(ctx: EVP_CIPHER_CTX) void;
extern fn EVP_CIPHER_CTX_ctrl(ctx: EVP_CIPHER_CTX, command: i32, arg: i32, data: ?ptr) i32;
extern fn EVP_EncryptInit_ex(ctx: EVP_CIPHER_CTX, cipher: ?EVP_CIPHER, engine: ?ptr, key: ?ptr, iv: ?ptr) i32;
extern fn EVP_EncryptUpdate(ctx: EVP_CIPHER_CTX, out: ?ptr, out_length: *i32, input: ptr, input_length: i32) i32;
extern fn EVP_EncryptFinal_ex(ctx: EVP_CIPHER_CTX, out: ptr, out_length: *i32) i32;
extern fn EVP_DecryptInit_ex(ctx: EVP_CIPHER_CTX, cipher: ?EVP_CIPHER, engine: ?ptr, key: ?ptr, iv: ?ptr) i32;
extern fn EVP_DecryptUpdate(ctx: EVP_CIPHER_CTX, out: ?ptr, out_length: *i32, input: ptr, input_length: i32) i32;
extern fn EVP_DecryptFinal_ex(ctx: EVP_CIPHER_CTX, out: ptr, out_length: *i32) i32;
extern fn EVP_aes_128_gcm() EVP_CIPHER;
extern fn EVP_aes_256_gcm() EVP_CIPHER;
extern fn EVP_chacha20_poly1305() EVP_CIPHER;

extern fn EVP_PKEY_free(key: EVP_PKEY) void;
extern fn EVP_PKEY_up_ref(key: EVP_PKEY) i32;
extern fn EVP_PKEY_new_raw_private_key(key_type: i32, engine: ?ptr, key: ptr, length: uint) ?EVP_PKEY;
extern fn EVP_PKEY_new_raw_public_key(key_type: i32, engine: ?ptr, key: ptr, length: uint) ?EVP_PKEY;
extern fn EVP_PKEY_get_raw_public_key(key: EVP_PKEY, out: ?ptr, length: *uint) i32;
extern fn EVP_PKEY_CTX_new_id(id: i32, engine: ?ptr) ?EVP_PKEY_CTX;
extern fn EVP_PKEY_CTX_free(ctx: EVP_PKEY_CTX) void;
extern fn EVP_PKEY_CTX_ctrl(ctx: EVP_PKEY_CTX, key_type: i32, operation: i32, command: i32, p1: i32, p2: ?ptr) i32;
extern fn EVP_PKEY_keygen_init(ctx: EVP_PKEY_CTX) i32;
extern fn EVP_PKEY_keygen(ctx: EVP_PKEY_CTX, out: *?EVP_PKEY) i32;

extern fn EVP_MD_CTX_new() ?EVP_MD_CTX;
extern fn EVP_MD_CTX_free(ctx: EVP_MD_CTX) void;
extern fn EVP_DigestSignInit(ctx: EVP_MD_CTX, pctx: *?EVP_PKEY_CTX, md: ?EVP_MD, engine: ?ptr, key: EVP_PKEY) i32;
extern fn EVP_DigestSign(ctx: EVP_MD_CTX, signature: ?ptr, signature_length: *uint, data: ptr, length: uint) i32;
extern fn EVP_DigestVerifyInit(ctx: EVP_MD_CTX, pctx: *?EVP_PKEY_CTX, md: ?EVP_MD, engine: ?ptr, key: EVP_PKEY) i32;
extern fn EVP_DigestVerify(ctx: EVP_MD_CTX, signature: ptr, signature_length: uint, data: ptr, length: uint) i32;
extern fn EVP_sha256() EVP_MD;
extern fn EVP_sha384() EVP_MD;
extern fn EVP_sha512() EVP_MD;

extern fn BIO_new_mem_buf(data: ptr, length: i32) ?BIO;
extern fn BIO_new(method: ptr) ?BIO;
extern fn BIO_s_mem() ptr;
extern fn BIO_free(bio: BIO) i32;
extern fn BIO_ctrl(bio: BIO, command: i32, larg: c_long, parg: ?ptr) c_long;
extern fn PEM_read_bio_PrivateKey(bio: BIO, out: ?ptr, callback: ?ptr, password: ?ptr) ?EVP_PKEY;
extern fn PEM_read_bio_PUBKEY(bio: BIO, out: ?ptr, callback: ?ptr, data: ?ptr) ?EVP_PKEY;
extern fn PEM_read_bio_X509(bio: BIO, out: ?ptr, callback: ?ptr, data: ?ptr) ?X509;
extern fn PEM_write_bio_PKCS8PrivateKey(bio: BIO, key: EVP_PKEY, cipher: ?ptr, password: ?ptr, password_length: i32, callback: ?ptr, data: ?ptr) i32;
extern fn PEM_write_bio_PUBKEY(bio: BIO, key: EVP_PKEY) i32;
extern fn X509_get_pubkey(cert: X509) ?EVP_PKEY;
extern fn X509_free(cert: X509) void;
extern fn d2i_X509(out: ?ptr, input: *ptr, length: c_long) ?X509;
extern fn X509_STORE_add_cert(store: ptr, cert: X509) i32;
extern fn d2i_PUBKEY(out: ?ptr, input: *ptr, length: c_long) ?EVP_PKEY;
extern fn d2i_AutoPrivateKey(out: ?ptr, input: *ptr, length: c_long) ?EVP_PKEY;
extern fn i2d_PUBKEY(key: EVP_PKEY, out: ?*ptr) i32;
extern fn ERR_clear_error() void;


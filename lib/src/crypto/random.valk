use core
use io
use coro

// Bytes drawn per write when streaming, so the caller needs memory for one
// chunk rather than for every byte requested
value RANDOM_CHUNK (512)

// Streaming borrows the current coroutine's scratch buffer; see 'digest.valk'
// for why a plain global would be unsafe across a suspending write

/// Returns a string of `length` cryptographically secure random bytes.
///
/// The bytes are raw binary, not valid UTF-8 text; encode them (e.g. with `hex_encode` or
/// `base64_encode`) before printing.
+ fn random_bytes(length: uint) String {
    @unsafe
    let result = String.alloc(length)
    if length > 0 : core.fill_secure_random(result.data, length)
    return result
}

/// Writes `length` cryptographically secure random bytes to `out`; returns the bytes written.
///
/// The bytes are generated and written in chunks of 512, so memory use does not grow with
/// `length`. Errors from `out` are passed on.
+ fn random_bytes_into(length: uint, out: io.Writer) uint !io.IoError {
    @unsafe
    let chunk = coro.temp_buffer()
    let written: uint = 0
    let remaining = length
    while remaining > 0 {
        let take = remaining
        if take > RANDOM_CHUNK : take = RANDOM_CHUNK
        chunk.clear()
        chunk.reserve(take)
        core.fill_secure_random(chunk.data, take)
        chunk.skip(take)
        written += out.write(chunk) !>
        remaining -= take
    }
    return written
}

use core

+ fn random_bytes(length: uint) String !CryptoError {
    let result = String.make_empty(length)
    if length > 0 && !core.fill_secure_random(result.data, length) : throw .rng_failure
    return result
}

+ fn random_uint() uint !CryptoError {
    return uint.secure_random() ! throw .rng_failure
}

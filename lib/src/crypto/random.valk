use core
use io

// Bytes drawn per write when streaming, so the caller needs memory for one
// chunk rather than for every byte requested
value RANDOM_CHUNK (512)

// The chunk is allocated per call, not per iteration, and never shared: a
// reused global would be overwritten by another coroutine while 'out.write'
// is suspended

+ fn random_bytes(length: uint) String {
    @unsafe
    let result = String.alloc(length)
    if length > 0 : core.fill_secure_random(result.data, length)
    return result
}

// `length` random bytes written to `out`, without holding them all in memory
+ fn random_write_bytes(length: uint, out: io.Writer) uint !io.IoError {
    @unsafe
    let chunk = ByteBuffer.new(RANDOM_CHUNK)
    let written: uint = 0
    let remaining = length
    while remaining > 0 {
        let take = remaining
        if take > RANDOM_CHUNK : take = RANDOM_CHUNK
        chunk.clear()
        chunk.reserve(take)
        core.fill_secure_random(chunk.data, take)
        chunk.skip(take)
        written += out.write(chunk) !>
        remaining -= take
    }
    return written
}

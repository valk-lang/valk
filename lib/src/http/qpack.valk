
// QPACK static table and field section codec (RFC 9204, zero dynamic table capacity).
// Reuses `HpackField`, `hpack_slice_int`, `hpack_write_integer`, and `hpack_huffman_slice`.

value QPACK_STATIC_COUNT (99)

global qpack_static_names: [String x 99] ({
    ":authority", ":path", "age", "content-disposition", "content-length", "cookie", "date", "etag",
    "if-modified-since", "if-none-match", "last-modified", "link", "location", "referer", "set-cookie", ":method",
    ":method", ":method", ":method", ":method", ":method", ":method", ":scheme", ":scheme",
    ":status", ":status", ":status", ":status", ":status", "accept", "accept", "accept-encoding",
    "accept-ranges", "access-control-allow-headers", "access-control-allow-headers", "access-control-allow-origin", "cache-control", "cache-control", "cache-control", "cache-control",
    "cache-control", "cache-control", "content-encoding", "content-encoding", "content-type", "content-type", "content-type", "content-type",
    "content-type", "content-type", "content-type", "content-type", "content-type", "content-type", "content-type", "range",
    "strict-transport-security", "strict-transport-security", "strict-transport-security", "vary", "vary", "x-content-type-options", "x-xss-protection", ":status",
    ":status", ":status", ":status", ":status", ":status", ":status", ":status", ":status",
    "accept-language", "access-control-allow-credentials", "access-control-allow-credentials", "access-control-allow-headers", "access-control-allow-methods", "access-control-allow-methods", "access-control-allow-methods", "access-control-expose-headers",
    "access-control-request-headers", "access-control-request-method", "access-control-request-method", "alt-svc", "authorization", "content-security-policy", "early-data", "expect-ct",
    "forwarded", "if-range", "origin", "purpose", "server", "timing-allow-origin", "upgrade-insecure-requests", "user-agent",
    "x-forwarded-for", "x-frame-options", "x-frame-options"
})

global qpack_static_values: [String x 99] ({
    "", "/", "0", "", "0", "", "", "",
    "", "", "", "", "", "", "", "CONNECT",
    "DELETE", "GET", "HEAD", "OPTIONS", "POST", "PUT", "http", "https",
    "103", "200", "304", "404", "503", "*/*", "application/dns-message", "gzip, deflate, br",
    "bytes", "cache-control", "content-type", "*", "max-age=0", "max-age=2592000", "max-age=604800", "no-cache",
    "no-store", "public, max-age=31536000", "br", "gzip", "application/dns-message", "application/javascript", "application/json", "application/x-www-form-urlencoded",
    "image/gif", "image/jpeg", "image/png", "text/css", "text/html; charset=utf-8", "text/plain", "text/plain;charset=utf-8", "bytes=0-",
    "max-age=31536000", "max-age=31536000; includesubdomains", "max-age=31536000; includesubdomains; preload", "accept-encoding", "origin", "nosniff", "1; mode=block", "100",
    "204", "206", "302", "400", "403", "421", "425", "500",
    "", "FALSE", "TRUE", "*", "get", "get, post, options", "options", "content-length",
    "content-type", "get", "post", "clear", "", "script-src 'none'; object-src 'none'; base-uri 'none'", "1", "",
    "", "", "", "prefetch", "", "*", "1", "",
    "", "deny", "sameorigin"
})

fn qpack_decode_string(bytes: local &[u8], pos: uint, prefix: uint, huffman: bool, limit: uint) (String, uint) !H2Error {
    let slen, next = hpack_slice_int(bytes, pos, prefix) !>
    if slen > bytes.length - next : throw .compression
    let slice = bytes.view(next, slen)
    if huffman {
        let decoded = hpack_huffman_slice(slice, limit) !>
        return (decoded, next + slen)
    }
    if slen > limit : throw .limit
    return (slice.to_string(), next + slen)
}

fn qpack_decode(bytes: local &[u8], max_header_size: uint) Array[HpackField] !H2Error {
    let limit = max_header_size == 0 ? uint.$max : max_header_size
    if bytes.length < 2 : throw .compression
    let ric, pos1 = hpack_slice_int(bytes, 0, 8) !>
    if ric != 0 : throw .compression
    let _, pos = hpack_slice_int(bytes, pos1, 7) !>

    let out = Array[HpackField].new(8)
    let total: uint = 0
    let len = bytes.length
    while pos < len {
        let b = bytes[pos]
        if (b & 0x80) != 0 {
            // Indexed Field Line: 1 T xxxxxx
            if (b & 0x40) == 0 : throw .compression
            let idx, next = hpack_slice_int(bytes, pos, 6) !>
            if idx >= QPACK_STATIC_COUNT : throw .compression
            let name = qpack_static_names[idx]
            let val = qpack_static_values[idx]
            let sz = name.bytes + val.bytes + 32
            if sz > limit || total > limit - sz : throw .limit
            total += sz
            out.append(HpackField { name: name, value: val })
            pos = next
        } else if (b & 0xc0) == 0x40 {
            // Literal Field Line with Name Reference: 0 1 N T xxxx
            if (b & 0x10) == 0 : throw .compression
            let idx, next1 = hpack_slice_int(bytes, pos, 4) !>
            if idx >= QPACK_STATIC_COUNT : throw .compression
            let name = qpack_static_names[idx]
            if next1 >= len : throw .compression
            let vhuff = (bytes[next1] & 0x80) != 0
            let val, next2 = qpack_decode_string(bytes, next1, 7, vhuff, limit) !>
            let sz = name.bytes + val.bytes + 32
            if sz > limit || total > limit - sz : throw .limit
            total += sz
            out.append(HpackField { name: name, value: val })
            pos = next2
        } else if (b & 0xe0) == 0x20 {
            // Literal Field Line with Literal Name: 0 0 1 N H xxx
            let nhuff = (b & 0x08) != 0
            let name, next1 = qpack_decode_string(bytes, pos, 3, nhuff, limit) !>
            if next1 >= len : throw .compression
            let vhuff = (bytes[next1] & 0x80) != 0
            let val, next2 = qpack_decode_string(bytes, next1, 7, vhuff, limit) !>
            let sz = name.bytes + val.bytes + 32
            if sz > limit || total > limit - sz : throw .limit
            total += sz
            out.append(HpackField { name: name, value: val })
            pos = next2
        } else {
            // Post-base dynamic table entries require RIC > 0
            throw .compression
        }
    }
    return out
}

// Returns `(exact_index, name_index)` in static table (`-1` when absent).
fn qpack_static_lookup(name: String, val: String) (int, int) {
    let nlen = name.bytes
    if nlen == 0 : return (-1, -1)
    let c0 = name[0]
    if c0 == ':' {
        if name == ":status" {
            if val == "200" : return (25, 25)
            if val == "404" : return (27, 25)
            if val == "304" : return (26, 25)
            if val == "204" : return (64, 25)
            if val == "206" : return (65, 25)
            if val == "302" : return (66, 25)
            if val == "400" : return (67, 25)
            if val == "403" : return (68, 25)
            if val == "500" : return (71, 25)
            if val == "503" : return (28, 25)
            if val == "100" : return (63, 25)
            if val == "103" : return (24, 25)
            return (-1, 25)
        }
        if name == ":method" {
            if val == "GET" : return (17, 17)
            if val == "POST" : return (20, 17)
            if val == "HEAD" : return (18, 17)
            if val == "PUT" : return (21, 17)
            if val == "DELETE" : return (16, 17)
            if val == "OPTIONS" : return (19, 17)
            if val == "CONNECT" : return (15, 17)
            return (-1, 17)
        }
        if name == ":path" : return val == "/" ? (1, 1) : (-1, 1)
        if name == ":scheme" {
            if val == "https" : return (23, 23)
            if val == "http" : return (22, 22)
            return (-1, 23)
        }
        if name == ":authority" : return (-1, 0)
        return (-1, -1)
    }
    if name == "content-type" {
        if val == "text/plain" : return (53, 44)
        if val == "text/plain;charset=utf-8" : return (54, 44)
        if val == "text/html; charset=utf-8" : return (52, 44)
        if val == "application/json" : return (46, 44)
        if val == "application/javascript" : return (45, 44)
        if val == "text/css" : return (51, 44)
        if val == "image/png" : return (50, 44)
        if val == "image/jpeg" : return (49, 44)
        if val == "image/gif" : return (48, 44)
        return (-1, 44)
    }
    if name == "content-length" : return val == "0" ? (4, 4) : (-1, 4)
    if name == "content-encoding" {
        if val == "br" : return (42, 42)
        if val == "gzip" : return (43, 42)
        return (-1, 42)
    }
    if name == "accept-encoding" : return val == "gzip, deflate, br" ? (31, 31) : (-1, 31)
    if name == "etag" : return (-1, 7)
    if name == "last-modified" : return (-1, 10)
    if name == "cache-control" {
        if val == "no-cache" : return (39, 36)
        if val == "no-store" : return (40, 36)
        if val == "max-age=0" : return (36, 36)
        return (-1, 36)
    }
    if name == "vary" {
        if val == "accept-encoding" : return (59, 59)
        if val == "origin" : return (60, 59)
        return (-1, 59)
    }
    if name == "accept-ranges" : return val == "bytes" ? (32, 32) : (-1, 32)
    if name == "location" : return (-1, 12)
    if name == "set-cookie" : return (-1, 14)
    if name == "cookie" : return (-1, 5)
    if name == "user-agent" : return (-1, 95)
    if name == "authorization" : return (-1, 84)
    if name == "date" : return (-1, 6)
    if name == "server" : return (-1, 92)
    if name == "range" : return val == "bytes=0-" ? (55, 55) : (-1, 55)
    if name == "if-none-match" : return (-1, 9)
    if name == "if-modified-since" : return (-1, 8)
    if name == "accept" : return val == "*/*" ? (29, 29) : (-1, 29)
    if name == "origin" : return (-1, 90)
    if name == "referer" : return (-1, 13)
    return (-1, -1)
}

fn qpack_encode_field(out: ByteBuffer, name: String, val: String, never_index: bool (false)) {
    let exact, name_idx = qpack_static_lookup(name, val)
    if exact >= 0 {
        // Indexed Field Line (static): 1 1 xxxxxx
        hpack_write_integer(out, exact.to(uint), 6, 0xc0)
        return
    }
    let nbit: u8 = never_index ? 0x20 : 0x00
    if name_idx >= 0 {
        // Literal Field Line with Static Name Reference: 0 1 N 1 xxxx
        hpack_write_integer(out, name_idx.to(uint), 4, 0x50 | nbit)
    } else {
        // Literal Field Line with Literal Name: 0 0 1 N 0 xxx
        let lnbit: u8 = never_index ? 0x10 : 0x00
        hpack_write_integer(out, name.bytes, 3, 0x20 | lnbit)
        out.write(name)
    }
    // Literal value (non-Huffman): 0 xxxxxxx
    hpack_write_integer(out, val.bytes, 7, 0x00)
    out.write(val)
}

fn qpack_encode(fields: Array[HpackField], out: ByteBuffer) {
    // Prefix: Required Insert Count = 0, Delta Base = 0
    out.write_byte(0)
    out.write_byte(0)
    each fields as f {
        qpack_encode_field(out, f.name, f.value, f.never_index)
    }
}

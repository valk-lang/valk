
use net
use url
use time
use core
use io

fn request_method_is_safe(method: String) bool {
    return response_header_name_is_safe(method)
}

fn request_target_part_is_safe(value: String) bool {
    each value as ch {
        if ch <= 32 || ch == 127 || ch == '#' : return false
    }
    return true
}

fn request_host_is_safe(host: String) bool {
    if host.bytes == 0 : return false
    each host as ch {
        if ch <= 32 || ch == 127 || ch == '/' || ch == '?' || ch == '#' || ch == '@' : return false
    }
    return true
}

fn request_header_is_reserved(name: String) bool {
    return name.equals_ignore_ascii_case("host")
        || name.equals_ignore_ascii_case("content-length")
        || name.equals_ignore_ascii_case("transfer-encoding")
}

/// A single HTTP/1.1 request on its own connection, sent and received step by step.
///
/// `progress` does the work; the progress fields can be read in between, for example
/// to show a progress bar. Redirects are not followed.
///
/// ```valk
/// let req = http.create_request("GET", "http://example.com/") !!
/// while (req.progress() !!) {
///     println("received: %{req.bytes_received}")
/// }
/// let res = req.response() !!
/// ```
+ class ClientRequest {
    /// The buffer that collects the raw response bytes.
    ~ recv_buffer: ByteBuffer
    - recv_data: mut &[u8]
    - ctx: Context
    /// The connection the request is sent on; closed once the request has finished.
    ~ con: net.TcpConnection
    - payload: ByteBuffer
    - deadline_ms: uint (0)
    - read_timeout_ms: uint (5000)
    - write_timeout_ms: uint (5000)
    - max_response_header_size: uint (DEFAULT_MAX_RESPONSE_HEADER_SIZE)
    - max_response_body_size: uint (DEFAULT_MAX_RESPONSE_BODY_SIZE)
    // Progress
    - stage: uint (0)
    // Raw bytes of the skipped `1xx` responses
    - recv_skipped: uint (0)
    /// The size of the complete request (head and body) in bytes.
    ~ bytes_to_send: uint (0)
    /// The number of request bytes written so far.
    ~ bytes_sent: uint (0)
    /// The size of the complete raw response (head and body) in bytes, like
    /// `bytes_received` counts it.
    ///
    /// Known once the head of the final response has arrived and the body length follows
    /// from it (a `Content-Length`, or a response without a body); 0 before that and for
    /// chunked or connection-close delimited bodies. Skipped `1xx` responses are included.
    ~ bytes_to_recv: uint (0)
    /// The number of raw response bytes read so far, head included.
    ~ bytes_received: uint (0)
    /// The share of the request written so far, from 0 to 100.
    ~ sent_percent: uint (0)
    /// The share of the response received so far, from 0 to 100.
    ///
    /// Compares `bytes_received` with `bytes_to_recv`, so it stays 0 while the size is
    /// unknown; it is set to 100 once the response is complete.
    ~ recv_percent: uint (0)
    /// Whether the request has been written completely, or the request ended in an error.
    ~ request_sent: bool (false)
    /// Whether the request has finished, with a response or with an error.
    ~ response_received: bool (false)
    // Final
    - resp: ?ClientResponse

    //////////////////////////////
    // Request initialization
    //////////////////////////////

    /// Validates the request, connects to the server and builds the request bytes.
    ///
    /// Nothing is sent yet. `deadline_ms` is an absolute `time.mono_ms()` value for the
    /// whole request; 0 uses `options.timeout_ms` from now. Fails with `invalid_url` for
    /// anything but an `http`/`https` URL with a host, credentials in the URL or a port
    /// outside 1-65535, with `invalid_request` for an invalid method, path or header,
    /// with `ssl` when TLS setup, the handshake or the certificate fingerprint check
    /// fails, and with `timeout` or a connection error when connecting fails.
    + static fn new(method: String, url: String, options: ?Options (null), deadline_ms: uint (0)) ClientRequest !HttpError {
        let connect_timeout_ms: uint = 5000
        let read_timeout_ms: uint = 5000
        let write_timeout_ms: uint = 5000
        let max_response_header_size = DEFAULT_MAX_RESPONSE_HEADER_SIZE
        let max_response_body_size = DEFAULT_MAX_RESPONSE_BODY_SIZE
        if isset(options) {
            connect_timeout_ms = options.connect_timeout_ms
            read_timeout_ms = options.read_timeout_ms
            write_timeout_ms = options.write_timeout_ms
            max_response_header_size = options.max_response_header_size
            max_response_body_size = options.max_response_body_size
            if deadline_ms == 0 && options.timeout_ms > 0 {
                deadline_ms = time.deadline_ms(options.timeout_ms)
            }
        }

        // Validate URL
        let u = url.parse(url)
        if u.scheme != "http" && u.scheme != "https" : throw .invalid_url
        if !request_host_is_safe(u.host) : throw .invalid_url
        let is_https = u.scheme == "https"

        // Credentials in the URL are not sent, so they are refused instead of dropped
        if u.user.bytes > 0 || u.password.bytes > 0 : throw .invalid_url
        let host = u.host
        let port: u16 = is_https ? 443 : 80
        let parsed_port = u.port
        if isset(parsed_port) {
            if parsed_port == 0 || parsed_port > 65535 : throw .invalid_url
            port = parsed_port.to(u16)
        }

        if host.bytes == 0 : throw .invalid_url

        // Build and validate the complete request before opening a socket. This
        // keeps rejected input local and makes every Options construction path,
        // including a directly supplied headers map, pass through one boundary.
        let payload = SELF.create_payload(method, u, options) !>

        // Connect
        let connect_deadline_ms = SELF.operation_deadline(deadline_ms, connect_timeout_ms)
        let con = net.tcp_client(host, port, SELF.remaining_timeout(connect_deadline_ms, 0) !>) !>
        SELF.remaining_timeout(connect_deadline_ms, 0) !>
        con.set_timeouts(read_timeout_ms, write_timeout_ms)

        if is_https {
            let ssl = net.Ssl.new()
            SELF.configure_ssl(ssl, options) ! {
                con.close() ! core.cleanup_warning("Failed to close HTTP connection", __FILE__, __LINE__)
                throw .ssl
            }
            con.ssl_connect(ssl, SELF.remaining_timeout(connect_deadline_ms, 0) !>) ! {
                con.close() ! core.cleanup_warning("Failed to close HTTP connection", __FILE__, __LINE__)
                if error_is(E.code, timeout) : throw .timeout
                throw .ssl
            }
            if isset(options) {
                let expected = options.certificate_sha256
                if isset(expected) {
                    expected = expected.replace(":", "")
                    let actual = ssl.peer_certificate_sha256() ! {
                        con.close() ! core.cleanup_warning("Failed to close HTTP connection", __FILE__, __LINE__)
                        throw .ssl
                    }
                    if expected.bytes != 64 || !actual.equals_ignore_ascii_case(expected) {
                        con.close() ! core.cleanup_warning("Failed to close HTTP connection", __FILE__, __LINE__)
                        throw .ssl
                    }
                }
            }
        }

        // Request
        let recv_buffer = ByteBuffer.new(2048)
        let ctx = Context.new(recv_buffer)
        ctx.response_to_head = method.equals_ignore_ascii_case("HEAD")
        ctx.response_to_connect = method.equals_ignore_ascii_case("CONNECT")

        if isset(options) : ctx.output = options.output

        return SELF {
            recv_buffer: recv_buffer
            recv_data: [u8]{ 0 x 1024 * 32 }
            ctx: ctx
            con: con
            payload: payload
            deadline_ms: deadline_ms
            read_timeout_ms: read_timeout_ms
            write_timeout_ms: write_timeout_ms
            max_response_header_size: max_response_header_size
            max_response_body_size: max_response_body_size
            bytes_to_send: payload.length
        }
    }

    static fn configure_ssl(ssl: net.Ssl, options: ?Options) !HttpError {
        let min_version = net.TlsVersion.tls_1_2
        let max_version: ?net.TlsVersion = null
        let alpn = Array[String]{ "http/1.1" }

        if isset(options) {
            min_version = options.min_tls_version
            max_version = options.max_tls_version
            ssl.set_verify(options.verify_tls_cert)
            let cert = options.ca_cert_path
            if isset(cert) : ssl.set_ca_cert(cert) !>
            let cipher_list = options.tls_cipher_list
            if isset(cipher_list) : ssl.set_cipher_list(cipher_list) !>
            let cipher_suites = options.tls_cipher_suites
            if isset(cipher_suites) : ssl.set_cipher_suites(cipher_suites) !>
            let protocols = options.alpn_protocols
            if isset(protocols) : alpn = protocols
        }

        ssl.set_min_version(min_version) !>
        if isset(max_version) : ssl.set_max_version(max_version) !>
        ssl.set_alpn(alpn) !>
    }

    static fn remaining_timeout(deadline_ms: uint, operation_timeout_ms: uint) uint !HttpError {
        if deadline_ms == 0 : return operation_timeout_ms
        let now = time.mono_ms()
        if now >= deadline_ms : throw .timeout
        let remaining = deadline_ms - now
        if operation_timeout_ms == 0 || remaining < operation_timeout_ms : return remaining
        return operation_timeout_ms
    }

    static fn operation_deadline(request_deadline_ms: uint, operation_timeout_ms: uint) uint {
        if operation_timeout_ms == 0 : return request_deadline_ms
        let deadline = time.deadline_ms(operation_timeout_ms)
        if request_deadline_ms == 0 || deadline < request_deadline_ms : return deadline
        return request_deadline_ms
    }

    - static fn create_payload(method: String, url: url.Url, options: ?Options) ByteBuffer !HttpError {
        let body = ""
        let headers: ?Headers = null
        let has_custom_agent = false

        if !request_method_is_safe(method) : throw .invalid_request
        if url.path.bytes > 0 && !url.path.starts_with("/") : throw .invalid_request
        if !request_target_part_is_safe(url.path) || !request_target_part_is_safe(url.query) : throw .invalid_request

        if isset(options) {
            body = options.body
            headers = options.headers
            if isset(headers) {
                each headers as value, name {
                    if !response_header_name_is_safe(name) || !response_header_value_is_safe(value)
                        || request_header_is_reserved(name) : throw .invalid_request
                    if name.equals_ignore_ascii_case("user-agent") : has_custom_agent = true
                }
            }
            let qdata = options.query_data
            if isset(qdata) {
                let qstr = ""
                each qdata as v, k, i {
                    if i > 0 : qstr += "&"
                    qstr += "%{url.encode(k)}=%{url.encode(v)}"
                }
                // `url.query` has no leading `?`; the target writer adds it
                if qstr.bytes > 0 : url.query += url.query.bytes > 0 ? "&" + qstr : qstr
            }
        }

        let len = body.bytes
        let buf = ByteBuffer.new(len + 256)

        buf.write(method)
        buf.write(" ")
        buf.write(url.path.bytes > 0 ? url.path : "/")
        if !url.query.is_empty() {
            buf.write("?")
            buf.write(url.query)
        }
        buf.write(" HTTP/1.1\r\n")

        buf.write("Host: ")
        buf.write(url.host_with_port())
        buf.write("\r\n")

        buf.write("Content-Length: ")
        buf.write_uint_ascii(body.bytes)
        buf.write("\r\n")

        if !has_custom_agent {
            buf.write("User-Agent: Valk http client\r\n")
        }

        if isset(headers) {
            each headers as v, k {
                buf.write(k)
                buf.write(": ")
                buf.write(v)
                buf.write("\r\n")
            }
        }

        buf.write("\r\n")
        buf.write(body)

        return buf
    }

    //////////////////////////////
    // Run / Progress
    //////////////////////////////

    - fn stop() {
        this.con.close() ! core.cleanup_warning("Failed to close HTTP connection", __FILE__, __LINE__)
        this.ctx.reset()
        this.request_sent = true
        this.response_received = true
    }

    /// Writes or reads the next chunk; returns `true` while there is more to do.
    ///
    /// Blocks on the socket for up to the read or write timeout. Returns `false` once
    /// the final response is complete; `1xx` interim responses are skipped. Errors close
    /// the connection and end the request: `timeout`, `write`, `read` (also for a
    /// connection closed early), `response_too_large` and `invalid_response`.
    + fn progress() bool !HttpError {
        if this.response_received : return false

        let con = this.con

        if this.stage == 0 {
            // Send request
            con.write_timeout_ms = SELF.remaining_timeout(this.deadline_ms, this.write_timeout_ms) !>
            let sent_count = con.write(this.payload.view(this.bytes_sent, this.payload.length)) ! {
                this.stop()
                if error_is(E.code, timeout) : throw .timeout
                throw .write
            }
            this.bytes_sent += sent_count
            this.sent_percent = this.bytes_sent * 100 / this.bytes_to_send
            if this.bytes_sent < this.bytes_to_send : return true
            // Done
            this.stage = 1
            this.sent_percent = 100
        }

        //
        this.request_sent = true

        // Receive response
        let context = this.ctx
        let recv_buf = this.recv_buffer
        if !context.done {
            con.read_timeout_ms = SELF.remaining_timeout(this.deadline_ms, this.read_timeout_ms) !>
            let recv_data = this.recv_data
            let bytes = SELF.read_chunk(con, recv_data) ! {
                this.stop()
                if error_is(E.code, timeout) : throw .timeout
                throw .read
            }
            recv_buf.write(recv_data.view(0, bytes))
            this.bytes_received += bytes

            if bytes == 0 {
                if context.close_delimited {
                    context.stage = 3
                    context.done = true
                    this.recv_percent = 100
                } else {
                    this.stop()
                    throw .read
                }
            } else {
                while true {
                    parse_http(recv_buf, context, true,
                        this.max_response_header_size, this.max_response_body_size) ! {
                        if E.code == E.incomplete {
                            this.update_recv_progress()
                            return true
                        }
                        this.stop()
                        if E.code == E.http413 : throw .response_too_large
                        throw .invalid_response
                    }
                    if context.status >= 200 || context.status == 101 : break

                    // Reuse the context and buffer for the final response.
                    let output = context.output
                    let head = context.response_to_head
                    let connect = context.response_to_connect
                    this.recv_skipped += context.parsed_index
                    recv_buf.clear_until(context.parsed_index)
                    context.reset()
                    context.parsed_index = 0
                    context.output = output
                    context.response_to_head = head
                    context.response_to_connect = connect
                }
            }

            this.update_recv_progress()
            this.recv_percent = 100
        }

        // Create response
        let resp = ClientResponse {
            status: context.status
            headers: context.headers()
            body: context.body
        }

        this.stop()
        this.resp = resp

        return false
    }

    // Sets `bytes_to_recv` once the final head is parsed and frames the body by length
    - fn update_recv_progress() {
        let context = this.ctx
        if this.bytes_to_recv == 0 && context.stage >= 2 && !context.chunked && !context.close_delimited {
            // `body_start` counts from the start of the buffer, which holds the final
            // response since the skipped ones were cleared from it
            this.bytes_to_recv = this.recv_skipped + context.body_start + context.content_length
        }
        let total = this.bytes_to_recv
        if total == 0 : return
        let percent = this.bytes_received * 100 / total
        this.recv_percent = percent > 100 ? 100 : percent
    }

    // A closed peer reads as zero bytes; the response state decides if that ends it
    static fn read_chunk(con: net.TcpConnection, buf: local mut &[u8]) uint !io.IoError {
        return con.read(buf) ! {
            if error_is(E.code, closed) : return 0
            throw E
        }
    }

    /// Returns the response once `progress` has returned `false`.
    ///
    /// Throws `in_progress` while the request is still running and `invalid_response`
    /// when it ended in an error.
    + fn response() ClientResponse !HttpError {
        if !this.response_received : throw .in_progress
        return this.resp ?! throw .invalid_response
    }
}

use fs
use io
use compress

// Files up to this size are kept in memory by the worker that served them
value FILE_CACHE_MAX_FILE (1024 * 1024)
// Bytes of file content one worker keeps; the cache starts over when more would not fit
value FILE_CACHE_BUDGET (8 * 1024 * 1024)
// Files one worker keeps track of; the cache starts over when one more is asked for
value FILE_CACHE_MAX_ENTRIES (4096)

// One version of a file, known by its size, times and inode. Each request still stats the
// file, so a change on disk is seen at once.
class CachedFile {
    meta: FileMeta
    changed: uint
    inode: uint
    path: String
    data: ?String (null)
    gzipped: ?String (null)
    gzipped_level: uint (0)
    zstded: ?String (null)
    zstded_level: uint (0)
    zst: CachedSidecar
    br: CachedSidecar
    gz: CachedSidecar
}

// A pre-compressed copy next to a cached file, checked against its own size and time when used
class CachedSidecar {
    path: String
    size: uint (0)
    modified: uint (0)
    changed: uint (0)
    inode: uint (0)
    data: ?String (null)
}

global file_cache: ?HashMap[String, CachedFile] (null)
global file_cache_bytes: uint (0)

// The cache entry for the file at `path` as `info` describes it; null for a file too big to keep
fn cached_file(path: String, info: fs.FileInfo) ?CachedFile {
    if info.size > FILE_CACHE_MAX_FILE : return null
    let cache = file_cache ?? <{
        let made = HashMap[String, CachedFile].new()
        file_cache = made
        return made
    }
    let entry = cache.get(path) !? null
    if isset(entry) {
        if file_cache_same(entry.meta.size, entry.meta.modified, entry.changed, entry.inode, info) : return entry
        file_cache_forget(entry)
    }
    if cache.length >= FILE_CACHE_MAX_ENTRIES {
        cache.clear()
        file_cache_bytes = 0
    }
    let made = CachedFile {
        meta: file_meta(info.size, info.modified_time)
        changed: info.changed_time
        inode: info.inode
        path: path
        zst: CachedSidecar { path: path + ".zst" }
        br: CachedSidecar { path: path + ".br" }
        gz: CachedSidecar { path: path + ".gz" }
    }
    cache.set(path, made)
    return made
}

// A file replaced or rewritten changes its inode or status change time, even when its size
// and modification time are kept
fn file_cache_same(size: uint, modified: uint, changed: uint, inode: uint, info: fs.FileInfo) bool {
    return size == info.size && modified == info.modified_time && changed == info.changed_time && inode == info.inode
}

fn file_cache_has(entry: CachedFile) bool {
    let cache = file_cache ?! return false
    return (cache.get(entry.path) !? null) == entry
}

fn file_cache_forget(entry: CachedFile) {
    let cache = file_cache ?! return
    file_cache_bytes -= file_cache_entry_bytes(entry)
    cache.remove(entry.path)
}

fn file_cache_entry_bytes(entry: CachedFile) uint {
    let total: uint = 0
    let data = entry.data
    if isset(data) : total += data.bytes
    let gzipped = entry.gzipped
    if isset(gzipped) : total += gzipped.bytes
    let zstded = entry.zstded
    if isset(zstded) : total += zstded.bytes
    let zst = entry.zst.data
    if isset(zst) : total += zst.bytes
    let br = entry.br.data
    if isset(br) : total += br.bytes
    let gz = entry.gz.data
    if isset(gz) : total += gz.bytes
    return total
}

// Makes room for `bytes` more; false when the entry was evicted or they do not fit
fn file_cache_reserve(entry: CachedFile, bytes: uint) bool {
    if !file_cache_has(entry) || bytes > FILE_CACHE_BUDGET : return false
    if file_cache_bytes + bytes > FILE_CACHE_BUDGET {
        let cache = file_cache ?! return false
        // Start over, keeping only the entry in use
        cache.clear()
        let kept = file_cache_entry_bytes(entry)
        if kept + bytes > FILE_CACHE_BUDGET {
            entry.data = null
            entry.gzipped = null
            entry.zstded = null
            entry.zst.data = null
            entry.br.data = null
            entry.gz.data = null
            kept = 0
        }
        cache.set(entry.path, entry)
        file_cache_bytes = kept
    }
    file_cache_bytes += bytes
    return true
}

// Reads `path` using a known size hint so cold fills avoid an extra stat syscall
fn file_cache_read(path: String, size_hint: uint) String !io.IoError {
    let fd = fs.open(path) ! throw .open
    let buffer = ByteBuffer.new(size_hint + 1)
    while true {
        buffer.reserve(1)
        let readcount = io.read(fd, buffer.view_spare(1024 * 1024 * 1024), buffer.length) ! {
            io.close(fd) ! {}
            throw .read
        }
        if readcount == 0 : break
        buffer.skip(readcount)
    }
    io.close(fd) !>
    return buffer.into_string()
}

// The whole file; null when it no longer has the size the entry was made for
fn cached_file_data(entry: CachedFile) ?String {
    let data = entry.data
    if isset(data) : return data
    let read = file_cache_read(entry.path, entry.meta.size) ! return null
    if read.bytes != entry.meta.size : return null
    // Another coroutine on this worker may have filled or evicted the entry while io.read yielded
    let existing = entry.data
    if isset(existing) : return existing
    if file_cache_reserve(entry, read.bytes) : entry.data = read
    return read
}

// The file gzip-compressed at `level`
fn cached_file_gzip(entry: CachedFile, data: String, level: uint) String {
    let gzipped = entry.gzipped
    if isset(gzipped) && entry.gzipped_level == level : return gzipped
    if !file_cache_has(entry) : return compress.gzip(data, level)
    if isset(gzipped) {
        file_cache_bytes -= gzipped.bytes
        entry.gzipped = null
    }
    let made = compress.gzip(data, level)
    if file_cache_reserve(entry, made.bytes) {
        entry.gzipped = made
        entry.gzipped_level = level
    }
    return made
}

// The file zstd-compressed at `level`
fn cached_file_zstd(entry: CachedFile, data: String, level: uint) String {
    let zstded = entry.zstded
    if isset(zstded) && entry.zstded_level == level : return zstded
    if !file_cache_has(entry) : return compress.zstd(data, level)
    if isset(zstded) {
        file_cache_bytes -= zstded.bytes
        entry.zstded = null
    }
    let made = compress.zstd(data, level)
    if file_cache_reserve(entry, made.bytes) {
        entry.zstded = made
        entry.zstded_level = level
    }
    return made
}

fn file_cache_clear_sidecar(entry: CachedFile, sidecar: CachedSidecar, data: ?String) {
    if !isset(data) : return
    if file_cache_has(entry) : file_cache_bytes -= data.bytes
    sidecar.data = null
}

// The sidecar's bytes, or null when there is no such regular file or it is too big to keep
fn cached_sidecar_data(entry: CachedFile, sidecar: CachedSidecar) ?String {
    let data = sidecar.data
    let info = fs.stat(sidecar.path) !? null
    if !isset(info) || info.kind != fs.FileKind.file || info.size > FILE_CACHE_MAX_FILE {
        file_cache_clear_sidecar(entry, sidecar, data)
        return null
    }
    if isset(data) && file_cache_same(sidecar.size, sidecar.modified, sidecar.changed, sidecar.inode, info) : return data
    file_cache_clear_sidecar(entry, sidecar, data)
    let read = file_cache_read(sidecar.path, info.size) ! return null
    if read.bytes != info.size : return null
    if isset(sidecar.data) : return read
    if file_cache_reserve(entry, read.bytes) {
        sidecar.size = info.size
        sidecar.modified = info.modified_time
        sidecar.changed = info.changed_time
        sidecar.inode = info.inode
        sidecar.data = read
    }
    return read
}

// Picks a `.zst`, `.br` or `.gz` sidecar the client accepts, as `open_precompressed_sidecar` does,
// and returns its bytes
fn cached_precompressed(entry: CachedFile, content_type: String, compress: bool, accept_encoding: String, plan: FilePlan) ?String {
    if !compress || plan.status != 200 || !response_gzip_type(content_type) : return null
    let checked_zst = false
    let checked_br = false
    let checked_gz = false
    if request_accepts_zstd(accept_encoding) {
        checked_zst = true
        let data = cached_sidecar_data(entry, entry.zst)
        if isset(data) {
            plan.zstd = false
            plan.gzip = false
            plan.encoding = "zstd"
            plan.vary = true
            plan.length = data.bytes
            plan.etag = entry.meta.zstd_etag
            return data
        }
    }
    if request_accepts_br(accept_encoding) {
        checked_br = true
        let data = cached_sidecar_data(entry, entry.br)
        if isset(data) {
            plan.zstd = false
            plan.gzip = false
            plan.encoding = "br"
            plan.vary = true
            plan.length = data.bytes
            plan.etag = entry.meta.br_etag
            return data
        }
    }
    if request_accepts_gzip(accept_encoding) {
        checked_gz = true
        let data = cached_sidecar_data(entry, entry.gz)
        if isset(data) {
            plan.zstd = false
            plan.gzip = false
            plan.encoding = "gzip"
            plan.vary = true
            plan.length = data.bytes
            plan.etag = entry.meta.gzip_etag
            return data
        }
    }
    if !plan.vary && ((!checked_zst && cached_sidecar_exists(entry.zst)) || (!checked_br && cached_sidecar_exists(entry.br)) || (!checked_gz && cached_sidecar_exists(entry.gz))) {
        plan.vary = true
    }
    return null
}

fn cached_sidecar_exists(sidecar: CachedSidecar) bool {
    return fs.is_file(sidecar.path)
}

#if TEST
/// Test hook: clears the current thread's static file cache.
+ fn file_cache_clear_for_test() {
    let cache = file_cache
    if isset(cache) : cache.clear()
    file_cache_bytes = 0
}

/// Test hook: returns whether the current thread's tracked cache bytes match its entries.
+ fn file_cache_bytes_ok_for_test() bool {
    let cache = file_cache ?! return file_cache_bytes == 0
    let total: uint = 0
    each cache as entry, _ : total += file_cache_entry_bytes(entry)
    return total == file_cache_bytes
}
#end


+ fn parse_http(input: ByteBuffer, context: Context, is_response: bool, max_header_size: uint (8192), max_body_size: uint (0)) !HttpParseError {
    if context.done : return

    let pos = context.parsed_index
    if pos >= input.length : throw .incomplete

    let stage = context.stage
    let data = input.data
    let length = input.length

    // Header
    if stage == 0 {
        context.request_start = pos
        let index = input.index_of('\r', pos) ! {
            if max_header_size > 0 && length - context.request_start > max_header_size : throw .http413
            throw .incomplete
        }

        // let version = ""

        if is_response {
            let sp1 = input.index_of(' ', pos) ! throw .invalid
            sp1++
            if sp1 >= index : throw .invalid
            // The reason phrase may be empty or absent entirely (RFC 9112 §9), so
            // the status code runs to the next space or to the end of the line:
            // "200 OK", "404 " and "404" are all readable. A space found past the
            // line end belongs to the next header, not to this status line.
            let code_end = input.index_of(' ', sp1) !? index
            if code_end > index : code_end = index
            if code_end == sp1 : throw .invalid
            context.status = input.view(sp1, code_end - sp1).to_uint() ! throw .invalid
        } else {
            if index + 1 == length : throw .incomplete
            if input[index + 1] != '\n' { throw .invalid }

            let space1 = input.index_of(' ', pos) ! { throw .invalid }
            let space2 = input.index_of(' ', space1 + 1) ! { throw .invalid }

            if space1 >= index || space2 >= index { throw .invalid }

            let method_len = space1 - pos
            if method_len == 0 : throw .invalid
            let method_pos: uint = 0
            while method_pos < method_len {
                if !is_tchar(input[pos + method_pos]) : throw .invalid
                method_pos++
            }

            let version_offset = space2 + 1
            let version = "HTTP/1.1"
            if index - version_offset != version.bytes
                || !input.starts_with(version, version_offset) : throw .invalid

            // Request "GET / HTTP/1.1"
            context.method.offset = pos
            context.method.length = method_len

            // Path
            let path_offset = space1 + 1
            let path_len = space2 - space1 - 1
            let is_options = method_len == 7 && context.method.equals("OPTIONS")
            if !is_request_target(data.@offset(path_offset), path_len, is_options) : throw .invalid

            context.path.offset = path_offset
            context.path.length = path_len
            let path = context.path

            // Query string
            let qmark = path.data.index_of_byte('?', path_len) !? 999999
            if qmark != 999999 {
                let query_len = path_len - qmark
                if query_len > 1 {
                    context.query_string.offset = path_offset + qmark + 1
                    context.query_string.length = query_len - 1
                }
                context.path.length -= query_len
            }
            // version = input.part(space2 + 1, index - space2 - 1)
        }

        pos = index + 2
        context.parsed_index = pos

        stage = 1
        context.stage = stage

        context.header_data.offset = pos
        context.header_data.length = 0
    }

    // Headers
    while stage == 1 {
        let index = input.index_of('\r', pos) ! {
            if max_header_size > 0 && input.length - context.request_start > max_header_size : throw .http413
            throw .incomplete
        }
        if index + 1 == length : throw .incomplete
        if input[index + 1] != '\n' : throw .invalid

        if index == pos {
            // End of headers
            pos = index + 2
            if max_header_size > 0 && pos - context.request_start > max_header_size : throw .http413
            context.header_size = pos - context.request_start
            context.parsed_index = pos

            stage = 2
            context.stage = stage

            if is_response {
                let status = context.status
                let no_body = context.response_to_head
                    || (context.response_to_connect && status >= 200 && status < 300)
                    || (status >= 100 && status < 200)
                    || status == 204 || status == 304
                if no_body {
                    context.content_length = 0
                    context.body_expected = 0
                    context.body_data.length = 0
                } else if !context.chunked && !context.has_content_length {
                    context.close_delimited = true
                } else if max_body_size > 0 && context.content_length > max_body_size {
                    throw .http413
                }
            }

            // Host header = required
            if !is_response && !context.has_host : throw .missing_host_header

            context.header_data.length += 2
            context.body_data.offset = pos
            break
        }

        let key_adr = input.data.@offset(pos)
        let header_len = index - pos

        // Header lines are stored raw and only split into key/value pairs once a
        // handler asks for them, by which point a bad line can no longer become a
        // status code. Reject what that parser cannot handle here instead; the
        // whitespace check also rejects obsolete line folding.
        let colon = key_adr.index_of_byte(':', header_len) ! throw .invalid
        if colon == 0 : throw .invalid
        let name_pos: uint = 0
        while name_pos < colon {
            if !is_tchar(http_byte(key_adr, header_len, name_pos)) : throw .invalid
            name_pos++
        }
        if !is_header_value(key_adr.$offset(colon + 1), header_len - colon - 1) : throw .invalid

        let headers_length = context.header_data.length + header_len + 2
        if max_header_size > 0 && index + 2 - context.request_start > max_header_size : throw .http413
        context.header_data.length = headers_length

        // Check certain headers
        let h1 = "content-length"
        let h2 = "transfer-encoding"
        let h3 = "host"
        let header_offset = pos - context.header_data.offset
        if colon == h1.bytes {
            if context.header_data.equal_at_ignore_ascii_case(header_offset, colon, h1) {
                let value_start = pos + h1.bytes + 1
                while value_start < index && input[value_start].is_html_spacing() : value_start++
                let value_len = index - value_start
                let content_len = input.view(value_start, value_len).to_uint() ! { throw .invalid }
                // Two conflicting lengths let a front-end and this server frame the
                // same connection differently. Identical repeats are harmless.
                if context.has_content_length && content_len != context.content_length : throw .invalid
                // A request that is both transfer-coded and length-delimited is the
                // CL.TE smuggling vector, so reject it rather than pick a winner.
                if !is_response && context.has_transfer_encoding : throw .invalid
                if !is_response && max_body_size > 0 && content_len > max_body_size : throw .http413
                context.has_content_length = true
                // For a response, Transfer-Encoding wins per RFC 9110 §8.4, and that
                // must not depend on which header arrived first.
                if !context.chunked {
                    context.body_data.length = content_len
                    context.content_length = content_len
                    context.body_expected = content_len
                }
            }
        } else if colon == h2.bytes {
            if context.header_data.equal_at_ignore_ascii_case(header_offset, colon, h2) {
                if context.has_transfer_encoding : throw .invalid
                if !is_response && context.has_content_length : throw .invalid
                context.has_transfer_encoding = true
                let value_start = pos + h2.bytes + 1
                while value_start < index && input[value_start].is_html_spacing() : value_start++
                let value_adr = input.data.@offset(value_start)
                let value_len = index - value_start
                let v = "chunked"
                while value_len > 0 && http_byte(value_adr, value_len, value_len - 1).is_space_or_tab() : value_len--
                // Only the key is folded in place, so the value is compared
                // case-insensitively over the exact remainder of the line: "chu"
                // must not read 4 bytes of the next line, and "chunkedXX" must not
                // prefix-match.
                let value_offset = value_start - context.header_data.offset
                if context.header_data.equal_at_ignore_ascii_case(value_offset, value_len, v) {
                    context.chunked = true
                    context.body_data.length = 0
                    // A Content-Length that arrived earlier must not linger: stage 2
                    // accumulates chunk sizes into body_expected, and the length is
                    // readable through the public context.
                    context.content_length = 0
                    context.body_expected = 0
                } else if is_transfer_codings(value_adr, value_len) {
                    // A well formed list naming a coding we cannot decode: something
                    // stacked before chunked, or no chunked at all. Ignoring it would
                    // frame the body differently than the sender framed it, so this
                    // is reported as a missing capability, not as bad syntax.
                    throw .not_implemented
                } else {
                    throw .invalid
                }
            }
        } else if colon == h3.bytes {
            if context.header_data.equal_at_ignore_ascii_case(header_offset, colon, h3) {
                if !is_response && context.has_host : throw .invalid
                let host_start = h3.bytes + 1
                while host_start < header_len && http_byte(key_adr, header_len, host_start).is_space_or_tab() : host_start++
                let host_len = header_len - host_start
                while host_len > 0 && http_byte(key_adr, header_len, host_start + host_len - 1).is_space_or_tab() : host_len--
                if !is_response && !is_host_value(key_adr.$offset(host_start), host_len) : throw .invalid
                context.has_host = true
            }
        }

        pos = index + 2
        context.parsed_index = pos
    }

    // Body
    if stage == 2 {
        let chunked = context.chunked
        let input_left = length - pos

        if chunked {
            let chunks = context.chunks

            while true {
                // The last chunk can be followed by trailer headers, which end at
                // a blank line of their own. They are skipped, not stored.
                if context.chunk_trailers {
                    while true {
                        let t = input.index_of('\r', pos) ! { throw .incomplete }
                        if t + 1 >= input.length : throw .incomplete
                        if input[t + 1] != '\n' : throw .invalid
                        let is_last = t == pos
                        pos = t + 2
                        context.parsed_index = pos
                        let trailer_size = pos - context.trailer_start
                        if max_header_size > 0 && trailer_size > max_header_size - context.header_size : throw .http413
                        if is_last : break
                    }
                    break
                }
                // Read length line
                let chlen = context.body_data.length
                if chlen == 0 {
                    let index = input.index_of('\r', pos) ! {
                        throw .incomplete
                    }
                    if index + 1 >= input.length : throw .incomplete
                    if input[index + 1] != '\n' : throw .invalid
                    let line = input.part(pos, index - pos)
                    // A chunk size is bare hex digits. The '0x' form that
                    // String.hex_to_uint also accepts is not legal on the wire,
                    // and a front-end would not read it as the same number.
                    if line.bytes > 1 && line[0] == '0' && line[1] == 'x' : throw .invalid
                    let part_len = line.hex_to_uint() ! throw .invalid
                    let expected = context.body_expected + part_len
                    let len = part_len + 2
                    if expected < context.body_expected || len < part_len : throw .http413
                    if max_body_size > 0 && expected > max_body_size : throw .http413
                    context.body_expected = expected

                    pos = index + 2
                    context.parsed_index = pos
                    input_left = length - pos

                    if len == 2 {
                        // Last chunk. What follows is not necessarily the blank
                        // line: trailer fields come first when the client sends
                        // them, so hand the remainder to the trailer loop rather
                        // than assuming two bytes.
                        context.chunk_trailers = true
                        context.trailer_start = pos
                        continue
                    }

                    chlen = len
                    context.body_data.length = len
                }
                // Read chunk content
                if input_left < chlen {
                    throw .incomplete
                }

                let part_len = chlen - 2
                context.body_received += part_len

                // Save to file or append to body buffer
                let file = context.save_to_file
                if isset(file) {
                    file.write_buffer_part(input, part_len, pos) !>
                } else {
                    chunks.write_buffer_part(input, part_len, pos)
                }

                // Clear input
                input.clear_part(pos, chlen)

                //
                context.body_data.length = 0
                input_left = input.length - pos
            }
        } else if context.close_delimited {
            let file = context.save_to_file
            if isset(file) {
                let body_bytes = input.length - pos
                let received = context.body_received + body_bytes
                if received < context.body_received : throw .http413
                if max_body_size > 0 && received > max_body_size : throw .http413
                context.body_received = received
                if body_bytes > 0 {
                    file.write_buffer_part(input, body_bytes, pos) !>
                    input.clear_part(pos, body_bytes)
                }
            } else {
                let received = input.length - context.body_data.offset
                if max_body_size > 0 && received > max_body_size : throw .http413
                context.body_data.length = received
                context.body_received = context.body_data.length
            }
            throw .incomplete
        } else {
            // Non chunked
            let content_len = context.content_length

            // Write body to file
            let file = context.save_to_file
            if isset(file) {
                let body_bytes = input.length - pos
                let remaining: uint = 0
                if context.body_received < content_len {
                    remaining = content_len - context.body_received
                }
                if body_bytes > remaining : body_bytes = remaining

                context.body_received += body_bytes

                if body_bytes > 0 {
                    file.write_buffer_part(input, body_bytes, pos) !>
                    input.clear_part(pos, body_bytes)
                }
            }

            if input_left < content_len && context.body_received < content_len {
                throw .incomplete
            }

            pos += content_len
            context.parsed_index = pos
        }

        context.stage = 3
        context.done = true
    }
}

fn is_request_target(adr: ptr, len: uint, is_options: bool) bool {
    if len == 1 && http_byte(adr, len, 0) == '*' : return is_options
    if len == 0 || http_byte(adr, len, 0) != '/' : return false

    let i: uint = 0
    while i < len {
        let ch = http_byte(adr, len, i)
        let lower = ch | 32
        if (lower >= 'a' && lower <= 'z') || (ch >= '0' && ch <= '9')
            || ch == '-' || ch == '.' || ch == '_' || ch == '~'
            || ch == '!' || ch == '$' || ch == '&' || ch == '\'' || ch == '(' || ch == ')'
            || ch == '*' || ch == '+' || ch == ',' || ch == ';' || ch == '=' || ch == ':'
            || ch == '@' || ch == '/' || ch == '?' {
            i++
            continue
        }
        if ch != '%' || len - i < 3 || !http_byte(adr, len, i + 1).is_hex()
            || !http_byte(adr, len, i + 2).is_hex() : return false
        i += 3
    }
    return true
}

// Most header values are printable ASCII and considerably longer than their
// names. Check words at once on that common path, falling back to the
// byte loop only for a word that might contain a control byte. HTAB is the one
// control byte allowed in a field value.
fn is_header_value(adr: ptr, len: uint) bool {
    let i: uint = 0
    let high: u64 = 0x8080808080808080
    let ones: u64 = 0x0101010101010101
    while len - i >= 16 {
        let word1 = http_word(adr, len, i)
        let word2 = http_word(adr, len, i + 8)
        let low1 = (word1 - 0x2020202020202020) & ~word1 & high
        let low2 = (word2 - 0x2020202020202020) & ~word2 & high
        let del1 = word1 ^ 0x7f7f7f7f7f7f7f7f
        let del2 = word2 ^ 0x7f7f7f7f7f7f7f7f
        let has_del1 = (del1 - ones) & ~del1 & high
        let has_del2 = (del2 - ones) & ~del2 & high
        if low1 != 0 || low2 != 0 || has_del1 != 0 || has_del2 != 0 {
            let end = i + 16
            while i < end {
                let ch = http_byte(adr, len, i++)
                if ch != '\t' && (ch < 32 || ch == 127) : return false
            }
        } else {
            i += 16
        }
    }
    while len - i >= 8 {
        let word = http_word(adr, len, i)
        let low = (word - 0x2020202020202020) & ~word & high
        let del = word ^ 0x7f7f7f7f7f7f7f7f
        let has_del = (del - ones) & ~del & high
        if low != 0 || has_del != 0 {
            let end = i + 8
            while i < end {
                let ch = http_byte(adr, len, i++)
                if ch != '\t' && (ch < 32 || ch == 127) : return false
            }
        } else {
            i += 8
        }
    }
    while i < len {
        let ch = http_byte(adr, len, i++)
        if ch != '\t' && (ch < 32 || ch == 127) : return false
    }
    return true
}

fn is_host_port(adr: ptr, len: uint) bool {
    if len == 0 : return false
    let port: uint = 0
    let i: uint = 0
    while i < len {
        let ch = http_byte(adr, len, i++)
        if ch < '0' || ch > '9' : return false
        let digit = (ch - '0').to(uint)
        if port > (65535 - digit) / 10 : return false
        port = port * 10 + digit
    }
    return true
}

fn is_ipv4_literal(adr: ptr, len: uint) bool {
    let parts: uint = 0
    let i: uint = 0
    while i < len {
        let start = i
        let value: uint = 0
        let digits: uint = 0
        while i < len && http_byte(adr, len, i).is_number() {
            if digits == 3 : return false
            value = value * 10 + (http_byte(adr, len, i) - '0').to(uint)
            if value > 255 : return false
            digits++
            i++
        }
        if digits == 0 : return false
        if digits > 1 && http_byte(adr, len, start) == '0' : return false
        parts++
        if i == len : break
        if http_byte(adr, len, i++) != '.' : return false
    }
    return parts == 4
}

fn is_ipv6_literal(adr: ptr, len: uint) bool {
    if len < 2 : return false
    let groups: uint = 0
    let compressed = false
    let i: uint = 0
    if http_byte(adr, len, 0) == ':' {
        if http_byte(adr, len, 1) != ':' : return false
        compressed = true
        i = 2
        if i == len : return true
    }

    while i < len {
        let start = i
        while i < len && http_byte(adr, len, i).is_hex() && i - start < 4 : i++
        if i == start : return false
        if i < len && http_byte(adr, len, i) == '.' {
            if !is_ipv4_literal(adr.$offset(start), len - start) : return false
            groups += 2
            i = len
            break
        }
        groups++
        if groups > 8 : return false
        if i == len : break
        if http_byte(adr, len, i++) != ':' || i == len : return false
        if http_byte(adr, len, i) == ':' {
            if compressed : return false
            compressed = true
            i++
            if i == len : break
        }
    }
    return compressed ? groups < 8 : groups == 8
}

fn is_reg_host(adr: ptr, len: uint) bool {
    if len == 0 : return false
    let label_len: uint = 0
    let numeric = true
    let dotted = false
    let i: uint = 0
    while i < len {
        let ch = http_byte(adr, len, i)
        if ch == ':' : break
        if ch == '.' {
            if label_len == 0 || http_byte(adr, len, i - 1) == '-' : return false
            dotted = true
            label_len = 0
            i++
            continue
        }
        if !ch.is_alpha_numeric() && ch != '-' && ch != '_' : return false
        if label_len == 0 && ch == '-' : return false
        if !ch.is_number() : numeric = false
        label_len++
        if label_len > 63 : return false
        i++
    }
    let host_len = i
    if host_len == 0 || host_len > 253 : return false
    if label_len == 0 {
        if host_len == 1 : return false
    } else if http_byte(adr, len, host_len - 1) == '-' : return false
    if numeric && dotted && !is_ipv4_literal(adr, host_len) : return false
    if host_len == len : return true
    return is_host_port(adr.$offset(host_len + 1), len - host_len - 1)
}

fn is_host_value(adr: ptr, len: uint) bool {
    if len == 0 : return false
    if http_byte(adr, len, 0) == '[' {
        let close: uint = 1
        while close < len && http_byte(adr, len, close) != ']' : close++
        if close >= len || !is_ipv6_literal(adr.$offset(1), close - 1) : return false
        if close + 1 == len : return true
        return http_byte(adr, len, close + 1) == ':' && is_host_port(adr.$offset(close + 2), len - close - 2)
    }

    return is_reg_host(adr, len)
}

// RFC 9112 §8.4.1:
//   TEF             = #transfer-coding
//   transfer-coding = token *( OWS ";" OWS token [ "=" parameter ] )
// Parameters are checked loosely on purpose: the question being answered is
// whether this names codings at all (400 if not) versus whether it names one
// this server can decode (501 if not). A quoted-string parameter is not parsed,
// so one containing a comma or a byte outside this set reads as bad syntax
// instead of being mis-framed.
fn is_transfer_codings(adr: ptr, len: uint) bool {
    let i: uint = 0
    while true {
        while i < len && http_byte(adr, len, i).is_space_or_tab() : i++
        let name = i
        while i < len && is_tchar(http_byte(adr, len, i)) : i++
        if i == name : return false
        while i < len && http_byte(adr, len, i) != ',' {
            let ch = http_byte(adr, len, i)
            if ch == ';' || ch == '=' || ch.is_space_or_tab() || is_tchar(ch) {
                i++
            } else {
                return false
            }
        }
        if i == len : return true
        // The separator promises one more coding after it.
        i++
    }
}

fn is_tchar(ch: u8) bool {
    let lower = ch | 32
    if (lower >= 'a' && lower <= 'z') || (ch >= '0' && ch <= '9') : return true
    return ch == '!' || ch == '#' || ch == '$' || ch == '%' || ch == '&' || ch == '\'' || ch == '*' || ch == '+' || ch == '-' || ch == '.' || ch == '^' || ch == '_' || ch == '`' || ch == '|' || ch == '~'
}

fn http_byte(data: ptr, length: uint, index: uint) u8 $inline {
    if index >= length : return 0
    return @ptrv(data, u8, index)
}

fn http_word(data: ptr, length: uint, index: uint) u64 $inline {
    if index > length || length - index < 8 : return 0
    return @ptrv(data.$offset(index), u64)
}

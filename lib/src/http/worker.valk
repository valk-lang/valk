
use core
use time

fn worker(server: shared ServerWorkerData) {
    let sock = server.socket

    let worker = Worker {
        server: server
    }

    while true {
        let netcon = sock.accept() ! {
            if error_is(E.code, max_connections) {
                println("[x] Too many connections")
                time.sleep_ms(100)
                continue
            }
            #if TEST
            panic("HTTP Server failed to accept a connection")
            #else
            println("[x] Failed to accept")
            continue
            #end
        }
        netcon.set_timeouts(server.idle_timeout_ms, server.write_timeout_ms)

        let connections = ++server.connections
        let too_many_connections = server.max_connections > 0 && connections > server.max_connections
        let body_capacity_full = server.max_server_wide_body_size > 0 && server.active_body_size >= server.max_server_wide_body_size
        if too_many_connections || body_capacity_full {
            server.connections--
            let response = ResponseWriter {}
            response.send_status(503)
            response.send_bytes(netcon) ! {}
            netcon.close() ! core.cleanup_warning("Failed to close rejected HTTP connection", __FILE__, __LINE__)
            continue
        }

        let fd = netcon.fd
        if server.show_info {
            println("[+] New connection: " + fd)
        }

        let http_con = Connection {
            worker: worker,
            netcon: netcon,
            fd: fd,
        }

        worker.connections++

        co http_con.handle()
    }
}

class Worker {
    server: shared ServerWorkerData
    connections: uint (0)
}

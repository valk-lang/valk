
use core
use time
use net
use io
use mem
use ext

// How often an idle acceptor checks whether the server is stopping
value ACCEPT_POLL_MS (20)
// Sleep between drain passes over the open connections
value DRAIN_POLL_MS (10)
// How often read deadlines are checked; a read past its deadline is interrupted
value SWEEP_MS (25)
// How long the watcher of parked connections waits before it checks whether the worker ended
value WATCH_POLL_MS (100)
// Parked connections woken per epoll_wait
value WATCH_BATCH (256)

#if OS == "linux"
value EPOLL_CTL_ADD (1)
value EPOLL_CTL_MOD (3)
value EPOLLIN (1)
value EPOLLERR (8)
value EPOLLHUP (16)
value EPOLLRDHUP (8192)
value EPOLLONESHOT (1 << 30)
// A C `struct epoll_event`: u32 events, then 8 bytes of user data, packed
value EPOLL_EVENT_SIZE (12)
#end

fn worker(server: atomic ServerWorkerData) {
    let worker = Worker {
        server: server
        now: time.mono_ms()
    }
    #if OS == "linux"
    // Connections waiting for their next request park here, without a coroutine
    worker.epoll_fd = ext.epoll_create(1)
    if worker.epoll_fd >= 0 : co worker.watch_parked()
    #end

    let sock = server.socket
    while server.stopping == 0 {
        worker.tick()
        if !worker_may_accept(worker.connections, server.connections, server.worker_count) {
            time.sleep_ms(1)
            continue
        }
        let netcon = sock.accept(ACCEPT_POLL_MS) ! {
            if server.stopping != 0 : break
            if error_is(E.code, timeout) : continue
            if error_is(E.code, max_connections) {
                // Out of file descriptors: close the connection idle the longest, give its
                // coroutine a moment to release the descriptor, then accept again
                if worker.evict_idle() {
                    time.sleep_ms(1)
                    continue
                }
                time.sleep_ms(100)
                continue
            }
            #if TEST
            panic("HTTP Server failed to accept a connection")
            #else
            println("[x] Failed to accept")
            continue
            #end
        }
        worker.handle(netcon)
    }

    if --server.acceptors == 0 {
        sock.close() ! core.cleanup_warning("Failed to close HTTP listener", __FILE__, __LINE__)
    }
    worker.drain()
    worker.ended = true
    if --server.workers == 0 : server.done.unlock()
}

// A worker that holds more than its share of the open connections (plus an eighth) lets the
// others accept, so a few long-lived connections do not end up on one thread
fn worker_may_accept(own: uint, total: uint, workers: uint) bool {
    return (own + 1) * workers <= total + workers + total / 8
}

class Worker {
    server: atomic ServerWorkerData
    connections: uint (0)
    // The worker's clock (`time.mono_ms`), updated by `tick`; reads use it for deadlines
    now: uint
    last_sweep: uint (0)
    // Doubly linked so that `remove_client` is O(1)
    clients: ?Connection
    // The epoll set parked connections wait in, -1 without one; parked connections by descriptor
    epoll_fd: Fd (-1)
    parked: HashMap[Fd, Connection] (.new())
    // Set once the worker drained: the watcher of parked connections ends
    ended: bool (false)

    fn handle(netcon: net.TcpConnection) {
        let server = this.server
        // Reads wait without a timer of their own: `tick` interrupts them at their deadline
        netcon.set_timeouts(0, server.write_timeout_ms)
        if server.stopping != 0 {
            netcon.interrupt()
            netcon.close() ! core.cleanup_warning("Failed to close HTTP connection", __FILE__, __LINE__)
            return
        }

        let connections = ++server.connections
        let too_many_connections = server.max_connections > 0 && connections > server.max_connections
        // At the limit, an idle connection makes room for the new one
        if too_many_connections && this.evict_idle() : too_many_connections = false
        let body_capacity_full = server.max_server_wide_body_size > 0 && server.active_body_size >= server.max_server_wide_body_size
        let rejected = too_many_connections || body_capacity_full
        // A rejected connection gives its slot back right away, so the next
        // accept is judged without it. `finish()` skips the decrement for it.
        if rejected : server.connections--
        let fd = netcon.fd
        if server.show_info {
            println("[+] New connection: " + fd)
        }

        let input = ByteBuffer.new(HEAD_READ_SIZE)
        let http_con = Connection {
            worker: this,
            netcon: netcon,
            fd: fd,
            rejected: rejected,
            input: input,
            context: Context.new(input),
        }
        this.add_client(http_con)

        // The TLS handshake happens inside the coroutine, so a slow client
        // never stalls the acceptor
        co http_con.handle()
    }

    // Updates the clock and, every SWEEP_MS, ends the wait of connections whose deadline passed:
    // a read is interrupted, a parked connection closed
    fn tick() {
        let now = time.mono_ms()
        this.now = now
        if now - this.last_sweep < SWEEP_MS : return
        this.last_sweep = now
        let connection = this.clients
        while isset(connection) {
            let next = connection.next
            let deadline = connection.deadline_ms
            if deadline > 0 && now >= deadline {
                if connection.parked : this.close_parked(connection)
                else : connection.netcon.interrupt()
            }
            connection = next
        }
    }

    // Interrupts the connection that has waited longest for its next request; false
    // when every connection is busy
    fn evict_idle() bool {
        let victim: ?Connection = null
        let connection = this.clients
        while isset(connection) {
            let since = connection.idle_since
            if since > 0 && (!isset(victim) || since < victim.idle_since) : victim = connection
            connection = connection.next
        }
        let found = victim ?! return false
        found.idle_since = 0
        if found.parked : this.close_parked(found)
        else : found.netcon.interrupt()
        return true
    }

    #if OS == "linux"
    // Registers a parked connection for one readiness event; false when epoll refuses it
    fn park(connection: Connection) bool {
        @unsafe
        let event: [u8 x EPOLL_EVENT_SIZE] = { 0 ... }
        let events: u32 = EPOLLIN | EPOLLRDHUP | EPOLLERR | EPOLLHUP | EPOLLONESHOT
        let fd = connection.fd
        mem.copy_bytes(@ref(events), @ref(event[0]), 4)
        mem.copy_bytes(@ref(fd), @ref(event[4]), 4)
        let op: i32 = connection.polled ? EPOLL_CTL_MOD : EPOLL_CTL_ADD
        if ext.epoll_ctl(this.epoll_fd, op, fd, @ref(event[0])) != 0 : return false
        connection.polled = true
        this.parked.set(fd, connection)
        return true
    }

    // Wakes parked connections as their descriptors become readable, on its own coroutine;
    // the parked connections hold none
    fn watch_parked() {
        @unsafe
        let buffer: [u8 x (EPOLL_EVENT_SIZE * WATCH_BATCH)] = @undefined
        let base = @ref(buffer[0]).@cast(ptr)
        while !this.ended {
            let ready = io.await_fd(this.epoll_fd, true, false, WATCH_POLL_MS)
            if ready.is_timeout() : continue
            if !ready.is_readable() : continue
            let count = ext.epoll_wait(this.epoll_fd, base, WATCH_BATCH, 0)
            let now = time.mono_ms()
            let i = 0
            while i < count {
                let fd: Fd = @ptrv(base + i * EPOLL_EVENT_SIZE + 4, i32)
                i++
                let connection = this.parked.get(fd) ! continue
                this.parked.remove(fd)
                // Busy again from here, so the sweep leaves it to its coroutine
                connection.parked = false
                connection.woken = true
                connection.deadline_ms = 0
                if connection.served : connection.last_gap_ms = now - connection.idle_since
                connection.idle_since = 0
                // Data, or the end of the connection: the coroutine reads it either way
                co connection.serve()
            }
        }
        io.close(this.epoll_fd) ! {}
        this.epoll_fd = -1
    }
    #else
    fn park(connection: Connection) bool {
        return false
    }
    #end

    // Ends a parked connection from the worker: nothing else holds its descriptor
    fn close_parked(connection: Connection) {
        this.parked.remove(connection.fd)
        connection.parked = false
        connection.deadline_ms = 0
        connection.idle_since = 0
        connection.finish()
    }

    fn add_client(client: Connection) {
        let head = this.clients
        client.next = head
        if isset(head) : head.prev = client
        this.clients = client
        this.connections++
    }

    fn remove_client(client: Connection) {
        let prev = client.prev
        let next = client.next
        if isset(prev) : prev.next = next
        else if this.clients == client : this.clients = next
        if isset(next) : next.prev = prev
        client.prev = null
        client.next = null
        this.connections--
    }

    // Runs once the server is stopping: idle connections are closed or interrupted right
    // away, in-flight requests may finish until the deadline, after which their
    // sockets are interrupted too. Returns when every connection is gone.
    fn drain() {
        while this.connections > 0 {
            this.tick()
            let now = this.now
            let deadline = this.server.deadline_ms
            let expired = now >= deadline
            let connection = this.clients
            while isset(connection) {
                let next = connection.next
                let h2 = connection.h2
                if isset(h2) : h2.request_shutdown()
                if connection.parked : this.close_parked(connection)
                else if expired || (!isset(h2) && !connection.active) : connection.netcon.interrupt()
                connection = next
            }
            let wait_ms: uint = DRAIN_POLL_MS
            if !expired && deadline - now < wait_ms : wait_ms = deadline - now
            time.sleep_ms(wait_ms)
        }
    }
}

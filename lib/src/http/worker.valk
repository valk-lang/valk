
use core
use time
use net
use io
use mem
use ext
use sync

// How often an idle acceptor checks whether the server is stopping
value ACCEPT_POLL_MS (20)
// Sleep between drain passes over the open connections
value DRAIN_POLL_MS (10)
// How often read deadlines are checked; a read past its deadline is interrupted
value SWEEP_MS (25)
// How often the idle deadlines of parked connections are checked
value PARKED_SWEEP_MS (1000)
// How long the watcher of parked connections waits before it checks whether the worker ended
value WATCH_POLL_MS (100)
// Parked connections woken per epoll_wait
value WATCH_BATCH (256)
// Serving coroutines kept per worker: each drains the ready queue, then waits on its waker for
// the next batch. When all are busy, up to SERVE_EXTRA temporary ones per batch help out
value SERVE_POOL_MAX (256)
value SERVE_EXTRA (8)

#if OS == "linux"
value EPOLL_CTL_ADD (1)
value EPOLL_CTL_MOD (3)
value EPOLLIN (1)
value EPOLLERR (8)
value EPOLLHUP (16)
value EPOLLRDHUP (8192)
value EPOLLONESHOT (1 << 30)
value EPOLL_CLOEXEC (0x80000)
// A C `struct epoll_event`: u32 events, then 8 bytes of user data. Packed on x86-64 only;
// elsewhere the data is aligned to 8 bytes
#if ARCH == "x64"
value EPOLL_EVENT_SIZE (12)
value EPOLL_DATA_OFFSET (4)
#else
value EPOLL_EVENT_SIZE (16)
value EPOLL_DATA_OFFSET (8)
#end
#end

fn worker(server: atomic ServerWorkerData) {
    let worker = Worker {
        server: server
        now: time.mono_ms()
    }
    #if OS == "linux"
    // Connections waiting for their next request park here, without a coroutine
    // Not inherited by child processes
    worker.epoll_fd = ext.epoll_create1(EPOLL_CLOEXEC)
    if worker.epoll_fd >= 0 : co worker.watch_parked()
    #end

    let sock = server.socket
    while server.stopping == 0 {
        worker.tick()
        if !worker_may_accept(worker.connections, server.connections, server.worker_count) {
            time.sleep_ms(1)
            continue
        }
        let netcon = sock.accept(ACCEPT_POLL_MS) ! {
            if server.stopping != 0 : break
            if error_is(E.code, timeout) : continue
            if error_is(E.code, max_connections) {
                // Out of file descriptors: close the connection idle the longest, give its
                // coroutine a moment to release the descriptor, then accept again
                if worker.evict_idle() {
                    time.sleep_ms(1)
                    continue
                }
                time.sleep_ms(100)
                continue
            }
            #if TEST
            panic("HTTP Server failed to accept a connection")
            #else
            println("[x] Failed to accept")
            continue
            #end
        }
        worker.handle(netcon)
    }

    if --server.acceptors == 0 {
        sock.close() ! core.cleanup_warning("Failed to close HTTP listener", __FILE__, __LINE__)
    }
    worker.drain()
    worker.ended = true
    if --server.workers == 0 : server.done.unlock()
}

// A worker that holds more than its share of the open connections (plus an eighth) lets the
// others accept, so a few long-lived connections do not end up on one thread
fn worker_may_accept(own: uint, total: uint, workers: uint) bool {
    return (own + 1) * workers <= total + workers + total / 8
}

class Worker {
    server: atomic ServerWorkerData
    // Output buffer storage of parked connections, for the connections that wake; a
    // connection waiting for its next request holds none. The holders are emptied buffers
    spare_outputs: Array[ByteBuffer] (.{})
    empty_holders: Array[ByteBuffer] (.{})
    connections: uint (0)
    // The worker's clock (`time.mono_ms`), updated by `tick`; reads use it for deadlines
    now: uint
    last_sweep: uint (0)
    last_parked_sweep: uint (0)
    // Connections with a coroutine, and parked ones; each knows its index, so moving and
    // `remove_client` are O(1). The frequent sweep walks only the first list. Arrays, not
    // linked lists: a moved list node would hand the GC the whole chain behind it
    clients: Array[Connection] (.{})
    parked_clients: Array[Connection] (.{})
    // The epoll set parked connections wait in, -1 without one; parked connections by descriptor
    // (descriptors are small dense numbers, and one array slot per connection logs little for the GC)
    epoll_fd: i32 (-1)
    parked: Array[?Connection] (.{})
    // Woken connections waiting for a serving coroutine
    ready: Deque[Connection] (.new())
    // Wakers of the serving coroutines that wait for work, and how many serving coroutines exist
    idle_servers: Array[sync.Waker] (.{})
    servers: uint (0)
    // Set once the worker drained: the watcher of parked connections ends
    ended: bool (false)

    fn handle(netcon: net.TcpConnection) {
        let server = this.server
        // Reads wait without a timer of their own: `tick` interrupts them at their deadline
        netcon.set_timeouts(0, server.write_timeout_ms)
        if server.stopping != 0 {
            netcon.interrupt()
            netcon.close() ! core.cleanup_warning("Failed to close HTTP connection", __FILE__, __LINE__)
            return
        }

        let connections = ++server.connections
        let too_many_connections = server.max_connections > 0 && connections > server.max_connections
        // At the limit, an idle connection makes room for the new one
        if too_many_connections && this.evict_idle() : too_many_connections = false
        let body_capacity_full = server.max_server_wide_body_size > 0 && server.active_body_size >= server.max_server_wide_body_size
        let rejected = too_many_connections || body_capacity_full
        // A rejected connection gives its slot back right away, so the next
        // accept is judged without it. `finish()` skips the decrement for it.
        if rejected : server.connections--
        let fd = netcon.fd
        if server.show_info {
            println("[+] New connection: " + fd)
        }

        // The first read gives it room
        let input = ByteBuffer.new(PARKED_BUFFER_SIZE)
        let http_con = Connection {
            worker: this,
            netcon: netcon,
            fd: fd,
            rejected: rejected,
            input: input,
            context: Context.new(input),
        }
        this.add_client(http_con)

        // The TLS handshake happens inside the coroutine, so a slow client
        // never stalls the acceptor
        co http_con.handle()
    }

    // Updates the clock and, every SWEEP_MS, interrupts reads whose deadline passed; parked
    // connections past their idle deadline are closed every PARKED_SWEEP_MS
    fn tick() {
        let now = time.mono_ms()
        this.now = now
        if now - this.last_sweep < SWEEP_MS : return
        this.last_sweep = now
        each this.clients as connection {
            let deadline = connection.deadline_ms
            if deadline > 0 && now >= deadline : connection.netcon.interrupt()
        }
        if now - this.last_parked_sweep < PARKED_SWEEP_MS : return
        this.last_parked_sweep = now
        // Backwards: closing moves the last connection into the closed one's slot
        let i = this.parked_clients.length
        while i-- > 0 {
            let connection = this.parked_clients.get(i) ! continue
            let deadline = connection.deadline_ms
            if deadline > 0 && now >= deadline : this.close_parked(connection)
        }
    }

    // Closes the connection that has waited longest for its next request; false when every
    // connection is busy. Parked connections first: those on a coroutine are busier
    fn evict_idle() bool {
        let victim = this.longest_idle(this.parked_clients)
        if !isset(victim) : victim = this.longest_idle(this.clients)
        let found = victim ?! return false
        found.idle_since = 0
        if found.parked : this.close_parked(found)
        else : found.netcon.interrupt()
        return true
    }

    fn longest_idle(list: Array[Connection]) ?Connection {
        let victim: ?Connection = null
        each list as connection {
            let since = connection.idle_since
            if since > 0 && (!isset(victim) || since < victim.idle_since) : victim = connection
        }
        return victim
    }

    // Moves the storage of the empty `buffer` into `spares`, leaving it the smallest storage
    fn give_buffer(buffer: ByteBuffer, spares: Array[ByteBuffer]) {
        if buffer.length > 0 || buffer.size <= PARKED_BUFFER_SIZE : return
        let holder = this.empty_holders.pop_last() !? ByteBuffer.new(PARKED_BUFFER_SIZE)
        holder.swap(buffer)
        // Enough for the connections that are busy at once; storage past that is let go
        if spares.length < SPARE_BUFFERS : spares.append(holder)
    }

    // Gives `buffer` storage from `spares`, or new storage of `size` when there is none
    fn take_buffer(buffer: ByteBuffer, spares: Array[ByteBuffer], size: uint) {
        if buffer.size > PARKED_BUFFER_SIZE : return
        let holder = spares.pop_last() ! {
            buffer.ensure_capacity(size)
            return
        }
        buffer.swap(holder)
        this.empty_holders.append(holder)
    }

    #if OS == "linux"
    // Registers a parked connection for one readiness event; false when epoll refuses it
    fn park(connection: Connection) bool {
        @unsafe
        let event: [u8 x EPOLL_EVENT_SIZE] = { 0 ... }
        let events: u32 = EPOLLIN | EPOLLRDHUP | EPOLLERR | EPOLLHUP | EPOLLONESHOT
        let fd = connection.fd
        mem.copy_bytes(@ref(events), @ref(event[0]), 4)
        mem.copy_bytes(@ref(fd), @ref(event[EPOLL_DATA_OFFSET]), 4)
        let op: i32 = connection.polled ? EPOLL_CTL_MOD : EPOLL_CTL_ADD
        if ext.epoll_ctl(this.epoll_fd, op, fd, @ref(event[0])) != 0 : return false
        connection.polled = true
        let index = fd.to(uint)
        while this.parked.length <= index : this.parked.append(null)
        this.parked.set(index, connection) _
        this.unlink(connection)
        this.link(connection, true)
        return true
    }

    // Wakes parked connections as their descriptors become readable, on its own coroutine;
    // the parked connections hold none
    fn watch_parked() {
        @unsafe
        let buffer: [u8 x (EPOLL_EVENT_SIZE * WATCH_BATCH)] = @undefined
        let base = @ref(buffer[0]).@cast(ptr)
        while !this.ended {
            let ready = io.await_fd(this.epoll_fd, true, false, WATCH_POLL_MS)
            if ready.is_timeout() : continue
            if !ready.is_readable() : continue
            let count = ext.epoll_wait(this.epoll_fd, base, WATCH_BATCH, 0)
            let now = time.mono_ms()
            let i = 0
            while i < count {
                let fd: Fd = @ptrv(base + i * EPOLL_EVENT_SIZE + EPOLL_DATA_OFFSET, i32)
                i++
                let connection = (this.parked.get(fd.to(uint)) !? null) ?! continue
                this.parked.set(fd.to(uint), null) _
                // Busy again from here, so the sweep leaves it to its coroutine
                connection.parked = false
                this.unlink(connection)
                this.link(connection, false)
                connection.woken = true
                connection.deadline_ms = 0
                if connection.served : connection.last_gap_ms = now - connection.idle_since
                connection.idle_since = 0
                this.ready.push_back(connection)
            }
            // Serving coroutines that wait get the work; without enough of them more are started,
            // so no coroutine is created per request
            let pending = this.ready.length
            while pending > 0 {
                let waker = this.idle_servers.pop_last() ! break
                waker.wake()
                pending--
            }
            while pending > 0 && this.servers < SERVE_POOL_MAX {
                pending--
                let waker = sync.Waker.new() ! break
                this.servers++
                co this.serve_loop(waker)
            }
            if pending > SERVE_EXTRA : pending = SERVE_EXTRA
            while pending-- > 0 : co this.serve_ready()
        }
        io.close(this.epoll_fd) ! {}
        this.epoll_fd = -1
        // The worker ended: the waiting serving coroutines end too
        while true {
            let waker = this.idle_servers.pop_last() ! break
            waker.wake()
        }
    }

    // A serving coroutine: drains the ready queue, then waits for the watcher's wake
    fn serve_loop(waker: sync.Waker) {
        while true {
            this.serve_ready()
            if this.ended : break
            this.idle_servers.append(waker)
            waker.wait()
        }
        this.servers--
    }

    // Serves woken connections until the queue is empty. Data, or the end of the connection,
    // is readable for each of them: `serve` reads it either way
    fn serve_ready() {
        while true {
            let connection = this.ready.pop_front() ! break
            connection.serve()
        }
    }
    #else
    fn park(connection: Connection) bool {
        return false
    }
    #end

    // Ends a parked connection from the worker: nothing else holds its descriptor
    fn close_parked(connection: Connection) {
        this.parked.set(connection.fd.to(uint), null) _
        connection.parked = false
        connection.deadline_ms = 0
        connection.idle_since = 0
        connection.finish()
    }

    fn add_client(client: Connection) {
        this.link(client, false)
        this.connections++
    }

    fn remove_client(client: Connection) {
        this.unlink(client)
        this.connections--
    }

    fn link(client: Connection, parked: bool) {
        let list = parked ? this.parked_clients : this.clients
        client.list_index = list.length
        list.append(client)
        client.in_parked_list = parked
    }

    fn unlink(client: Connection) {
        let list = client.in_parked_list ? this.parked_clients : this.clients
        let index = client.list_index
        let found = list.get(index) ! return
        if found != client : return
        let last = list.last() ! return
        last.list_index = index
        list.swap_remove(index)
    }

    // Runs once the server is stopping: idle connections are closed or interrupted right
    // away, in-flight requests may finish until the deadline, after which their
    // sockets are interrupted too. Returns when every connection is gone.
    fn drain() {
        while this.connections > 0 {
            this.tick()
            let now = this.now
            let deadline = this.server.deadline_ms
            let expired = now >= deadline
            let i = this.parked_clients.length
            while i-- > 0 {
                let connection = this.parked_clients.get(i) ! continue
                this.close_parked(connection)
            }
            each this.clients as connection {
                let h2 = connection.h2
                if isset(h2) : h2.request_shutdown()
                if expired || (!isset(h2) && !connection.active) : connection.netcon.interrupt()
            }
            let wait_ms: uint = DRAIN_POLL_MS
            if !expired && deadline - now < wait_ms : wait_ms = deadline - now
            time.sleep_ms(wait_ms)
        }
    }
}

class HpackEncoder {
    entries: Array[HpackField] (.new())
    size: uint (0)
    capacity: uint (4096)
    pending_min: uint (4096)
    changed: bool (false)

    fn set_limit(limit: uint) {
        if limit > 4096 : limit = 4096
        if limit == this.capacity : return
        if !this.changed || limit < this.pending_min : this.pending_min = limit
        this.changed = true
        this.capacity = limit
        this.evict(limit)
    }

    fn evict(limit: uint) {
        while this.size > limit {
            let last = this.entries.get(this.entries.length - 1) !!
            this.size -= last.size()
            this.entries.remove(this.entries.length - 1)
        }
    }

    fn encode(fields: Array[HpackField], max_size: uint) String !H2Error {
        // Validate before changing the compression context.
        let size: uint = 0
        each fields as field {
            if size > max_size || field.size() > max_size - size : throw .limit
            size += field.size()
        }
        let out = ByteBuffer.new()
        if this.changed {
            if this.pending_min < this.capacity : hpack_write_integer(out, this.pending_min, 5, 32)
            hpack_write_integer(out, this.capacity, 5, 32)
            this.changed = false
        }
        each fields as field {
            let name_index, exact_index = hpack_static_indexes(field)
            let indexable = !field.never_index && (field.name == "content-type" || field.name == "content-length")
            if indexable {
                each this.entries as entry, index {
                    if entry.name == field.name && entry.value == field.value {
                        exact_index = index + 62
                        break
                    }
                }
            }
            if exact_index != 0 && !field.never_index {
                hpack_write_integer(out, exact_index, 7, 128)
                continue
            }
            let insert = indexable && field.size() <= this.capacity
            hpack_write_integer(out, name_index, insert ? 6 : 4, insert ? 64 : (field.never_index ? 16 : 0))
            if name_index == 0 {
                hpack_write_integer(out, field.name.bytes, 7, 0)
                out.write(field.name)
            }
            hpack_write_integer(out, field.value.bytes, 7, 0)
            out.write(field.value)
            if insert {
                this.evict(this.capacity - field.size())
                this.entries.prepend(HpackField { name: field.name, value: field.value })
                this.size += field.size()
            }
        }
        return out.into_string()
    }
}

use url
use time

class StoredCookie {
    name: String
    value: String
    // Lowercased, without a leading dot
    domain: String
    // Sent to `domain` only, not its subdomains: the cookie had no Domain attribute
    host_only: bool
    path: String
    // Unix seconds after which the cookie is gone; 0 for a session cookie
    expires: int (0)
    secure: bool
    http_only: bool
    // Order of arrival, for the order cookies are sent in
    created: uint
}

/// The cookies a `Client` received, sent back on later requests as a browser does
/// (RFC 6265).
///
/// A cookie with a `Domain` goes to that domain and its subdomains, one without it only to
/// the host that set it. `Path` limits it to the paths below it, `Secure` to HTTPS, and
/// `Max-Age` or `Expires` to a lifetime; a cookie that is set again replaces the earlier one.
+ class CookieJar {
    - entries: Array[StoredCookie] (.{})
    - arrivals: uint (0)

    /// The number of cookies that have not expired.
    + get length: uint {
        this.drop_expired()
        return this.entries.length
    }

    /// Stores the cookies of `response`, which answered a request to `url`.
    + fn store(url: String, response: ClientResponse) {
        each response.headers.get_all("set-cookie") as field {
            let cookie = Cookie.parse(field) ! continue
            this.store_cookie(url, cookie, set_cookie_has_path(field))
        }
    }

    /// Stores `cookie` as if a response from `url` had set it.
    ///
    /// Its `path` is used as it is; an empty `domain` makes a cookie for the host of `url`
    /// only. Its `secure` flag applies too, and `Cookie.new` sets it.
    + fn set(url: String, cookie: Cookie) {
        this.store_cookie(url, cookie, true)
    }

    /// Returns the cookies a request to `url` sends, longest path first.
    + fn cookies_for(url: String) Array[Cookie] {
        this.drop_expired()
        let target = url.parse(url)
        let host = target.host.lower()
        let path = target.path.bytes > 0 ? target.path : "/"
        let https = target.scheme == "https"
        let matching = Array[StoredCookie]{}
        each this.entries as entry {
            if entry.secure && !https : continue
            let domain_ok = entry.host_only ? host == entry.domain : cookie_domain_match(host, entry.domain)
            if !domain_ok : continue
            if !cookie_path_match(path, entry.path) : continue
            matching.append(entry)
        }
        matching.sort(fn(a, b) {
            if a.path.bytes != b.path.bytes : return a.path.bytes < b.path.bytes
            return a.created > b.created
        })
        let result = Array[Cookie]{}
        each matching as entry {
            let cookie = Cookie.new(entry.name, entry.value)
            cookie.path = entry.path
            cookie.domain = entry.host_only ? null : entry.domain
            cookie.secure = entry.secure
            cookie.http_only = entry.http_only
            result.append(cookie)
        }
        return result
    }

    /// Returns the `Cookie` header value for a request to `url`; empty when none matches.
    + fn header_for(url: String) String {
        let parts = Array[String]{}
        each this.cookies_for(url) as cookie : parts.append(cookie.name + "=" + cookie.value)
        return parts.join("; ")
    }

    /// Removes every cookie.
    + fn clear() {
        this.entries.clear()
    }

    - fn store_cookie(url: String, cookie: Cookie, has_path: bool) {
        if cookie.name.bytes == 0 : return
        let source = url.parse(url)
        let host = source.host.lower()
        if host.bytes == 0 : return

        let domain = host
        let host_only = true
        let wanted = cookie.domain
        if isset(wanted) && wanted.bytes > 0 {
            let lower = wanted.lower().ltrim(".")
            // A server may only set cookies for its own domain
            if !cookie_domain_match(host, lower) : return
            domain = lower
            host_only = false
        }
        let path = has_path && cookie.path.starts_with("/") ? cookie.path : cookie_default_path(source.path)

        let now = time.unix_ms().to(int) / 1000
        let expires = 0
        let max_age = cookie.max_age
        let until = cookie.expires
        if isset(max_age) {
            expires = max_age <= 0 ? -1 : now + max_age
        } else if isset(until) {
            expires = until.unix_seconds()
            if expires <= now : expires = -1
        }

        // A cookie set again replaces the earlier one, and one set to expire removes it
        let created = this.arrivals++
        let i: uint = 0
        while i < this.entries.length {
            let entry = this.entries.get(i) ! break
            if entry.name == cookie.name && entry.domain == domain && entry.path == path {
                created = entry.created
                this.entries.remove(i)
                continue
            }
            i++
        }
        if expires < 0 : return
        this.entries.append(StoredCookie {
            name: cookie.name
            value: cookie.value
            domain: domain
            host_only: host_only
            path: path
            expires: expires
            secure: cookie.secure
            http_only: cookie.http_only
            created: created
        })
    }

    - fn drop_expired() {
        let now = time.unix_ms().to(int) / 1000
        this.entries.remove_where(fn(entry) { return entry.expires > 0 && entry.expires <= now })
    }
}

// Whether `host` is `domain` or a subdomain of it; an IP address only matches itself
fn cookie_domain_match(host: String, domain: String) bool {
    if host == domain : return true
    if !host.ends_with("." + domain) : return false
    let last = host.get(host.bytes - 1)
    return !last.is_number() && !host.contains_byte(':')
}

fn cookie_path_match(path: String, cookie_path: String) bool {
    if path == cookie_path : return true
    if !path.starts_with(cookie_path) : return false
    return cookie_path.ends_with("/") || path.get(cookie_path.bytes) == '/'
}

// The directory of the request path, the path of a cookie without a Path attribute
fn cookie_default_path(path: String) String {
    if !path.starts_with("/") : return "/"
    let slash = path.last_index_of("/") !? 0
    if slash == 0 : return "/"
    return path.range(0, slash)
}

fn set_cookie_has_path(field: String) bool {
    each field.split(";") as part {
        let name = (part.split("=", 2).get(0) !? "").trim()
        if name.equals_ignore_ascii_case("path") : return true
    }
    return false
}

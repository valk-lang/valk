+ class Headers {
    - names: Array[String] (.{})
    - values: Array[String] (.{})

    + static fn new() SELF $default {
        return SELF {}
    }

    + get length: uint { return this.names.length }

    // Returns the first value; repeated fields are never joined implicitly.
    + fn get(name: String) String !LookupError $offset {
        each this.names as stored, index {
            if stored.equal_ignore_ascii_case(name) : return this.values.get(index) ! throw .missing
        }
        throw .missing
    }

    + fn get_all(name: String) Array[String] {
        let result = Array[String].new()
        each this.names as stored, index {
            if stored.equal_ignore_ascii_case(name) : result.append(this.values.get(index) ! continue)
        }
        return result
    }

    + fn has(name: String) bool {
        this.get(name) ! return false
        return true
    }

    + fn set(name: String, value: String) $offset_assign $set_key {
        this.remove(name)
        this.append(name, value)
    }

    + fn append(name: String, value: String) {
        this.names.append(name)
        this.values.append(value)
    }

    + fn remove(name: String) {
        let index = this.names.length
        while index-- > 0 {
            let stored = this.names.get(index) ! continue
            if stored.equal_ignore_ascii_case(name) {
                this.names.remove(index)
                this.values.remove(index)
            }
        }
    }

    + fn clear() {
        this.names.clear()
        this.values.clear()
    }

    + fn copy() SELF {
        return SELF { names: this.names.copy(), values: this.values.copy() }
    }

    fn _next(index: uint) (String, String) !IterError {
        let name = this.names.get(index) ! throw .end
        let value = this.values.get(index) ! throw .end
        return (value, name)
    }
}


use fs
use url
use json

trait ContextParser {
    -+ header_map: ?Headers
    -+ params_map: ?Map[String]
    -+ params_grp: ?Map[Array[String]]
    -+ data_map: ?Map[String]
    -+ data_json_cache: json.Value (null)
    // The cached `{}` stands for a body that was not valid JSON
    -+ data_json_invalid: bool (false)
    -+ files_map: ?Map[fs.InMemoryFile]
    -+ cookie_map: ?Map[String]

    fn reset_cache() {
        this.header_map = null
        this.params_map = null
        this.params_grp = null
        this.data_map = null
        this.data_json_cache = null
        this.data_json_invalid = false
        this.files_map = null
        this.cookie_map = null
    }

    /// Returns the request headers, with names lowercased.
    ///
    /// Leading spaces of values are removed; trailing whitespace is kept.
    + fn headers() Headers {
        let headers = this.header_map
        if isset(headers) : return headers
        let new = Headers.new()
        this.parse_stored_headers(new)
        this.header_map = new
        return new
    }

    /// Returns the query string parameters.
    ///
    /// Keys and values are decoded with `url.decode`. A part without `=`, like `?flag`, has
    /// the value `""`, and for a repeated key the last value wins; see `query_grouped`.
    + fn query() Map[String] {
        let params = this.params_map
        if isset(params) : return params
        let new = url.parse_query(this.query_string.to_string())
        this.params_map = new
        return new
    }

    /// Returns every value of each query string parameter, in order.
    ///
    /// Decoded like `query`.
    + fn query_grouped() Map[Array[String]] {
        let params = this.params_grp
        if isset(params) : return params
        let new = url.parse_query_grouped(this.query_string.to_string())
        this.params_grp = new
        return new
    }

    /// Returns the cookies of the request, by name.
    ///
    /// The `Cookie` header is split on `;` only, and a value keeps every `=` after the
    /// first one, so a base64 value arrives whole. Surrounding double quotes are removed.
    /// A browser sends the cookie of the most specific path first, and that is the one
    /// kept when a name is sent more than once.
    + fn cookies() Map[String] {
        let cookies = this.cookie_map
        if isset(cookies) : return cookies
        let new = Map[String].new()
        let header = this.headers().get("cookie") !? ""
        if header.bytes > 0 : parse_cookie_header(header, new)
        this.cookie_map = new
        return new
    }

    /// Returns the value of one cookie; throws `LookupError` when the request has no
    /// cookie of that name.
    + fn cookie(name: String) String !LookupError {
        return this.cookies().get(name) !>
    }

    /// Returns the form fields of the request body.
    ///
    /// Reads `application/x-www-form-urlencoded` bodies (keys and values decoded),
    /// `multipart/form-data` (file parts go to `files()`) and `application/json` objects.
    /// For JSON, string values are kept, `null` becomes an empty string and every other
    /// value is re-encoded as JSON text. The media type is compared case-insensitively
    /// and without its parameters, so `application/json; charset=utf-8` is read as JSON;
    /// the multipart `boundary` parameter may be quoted. Any other body gives an empty
    /// map.
    + fn form() Map[String] {
        let data = this.data_map
        if isset(data) : return data
        let new = Map[String].new()
        let files = Map[fs.InMemoryFile]{}
        let headers = this.headers()
        let type = headers.get("content-type") !? ""
        let media_type = content_media_type(type)

        if media_type == "application/x-www-form-urlencoded" {
            this.data_urlencoded(new)
        } else if media_type == "multipart/form-data" {
            let boundary = content_type_param(type, "boundary")
            if isset(boundary) && boundary.bytes > 0 : this.data_multipart(new, files, boundary)
        } else if media_type == "application/json" {
            this.data_json_body(new)
        }
        this.data_map = new
        this.files_map = files
        return new
    }

    /// Returns the request body as JSON.
    ///
    /// Form bodies are turned into an object of string values, see `data()`. Any other
    /// body is decoded as JSON regardless of its content type; a body that is not valid
    /// JSON gives an empty object. `parse_json` throws for such a body instead.
    + fn json() json.Value {
        let data = this.data_json_cache
        if isset(data) : return data

        let headers = this.headers()
        let type = content_media_type(headers.get("content-type") !? "")

        let res: json.Value = null

        if type == "application/x-www-form-urlencoded" {
            let object = json.new_object()
            let data = this.form()
            each data as v, k {
                object.set(k, json.from(v))
            }
            res = object
        } else if type == "multipart/form-data" {
            let object = json.new_object()
            let data = this.form()
            each data as v, k {
                object.set(k, json.from(v))
            }
            res = object
        } else {
            let body = this.body
            res = json.decode(body) !? <{
                this.data_json_invalid = true
                return json.new_object()
            }
        }
        this.data_json_cache = res
        return res
    }

    /// Returns the request body as JSON, like `json()`, but throws when it is not valid JSON.
    ///
    /// Form bodies are turned into an object of string values as `json()` does and never
    /// fail. Any other body must be valid JSON, so an empty body throws too. Throws the
    /// `json.ParseError` of `json.decode`.
    ///
    /// ```valk
    /// let body = req.parse_json() ! return http.Response.text("Invalid JSON", 400)
    /// ```
    + fn parse_json() json.Value !json.ParseError {
        let cached = this.data_json_cache
        if isset(cached) && !this.data_json_invalid : return cached
        let type = content_media_type(this.headers().get("content-type") !? "")
        if type == "application/x-www-form-urlencoded" || type == "multipart/form-data" : return this.json()
        let res = json.decode(this.body) !>
        this.data_json_cache = res
        this.data_json_invalid = false
        return res
    }

    /// Returns the uploaded files of a `multipart/form-data` body, by field name.
    ///
    /// A file part without its own `Content-Type` header is skipped.
    + fn files() Map[fs.InMemoryFile] {
        let files = this.files_map
        if isset(files) : return files
        this.form()
        return this.files()
    }

    - fn data_urlencoded(result: Map[String]) {
        let parts = this.body.split("&")
        each parts as part {
            let k, v = part.split_on_first_occurance_of_byte('=') ! continue
            result.set(url.decode(k), url.decode(v))
        }
    }
    - fn data_multipart(result: Map[String], files: Map[fs.InMemoryFile], boundary: String) {
        let headers = Headers.new()
        let dispos = Map[String].new()
        let body = this.body
        let parts = body.split("--" + boundary)
        each parts as part, i {
            if i == 0 : continue
            let ch = part.get(0)
            if ch != '\r' : break
            ch = part.get(1)
            if ch != '\n' : break
            // Parse headers
            headers.clear()
            dispos.clear()
            let part_data = part.view(2, part.bytes - 2)
            let header_bytes = parse_headers(part_data, headers) ! continue
            // Content disposition
            let dispo = headers.get("content-disposition") ! continue
            this.parse_content_disposition(dispo, dispos)
            let name = dispos.get("name") ! continue
            let fn: ?String = dispos.get("filename") !? null
            // 
            let body_offset = header_bytes + 2
            if body_offset > part.bytes - 2 : continue
            let body_bytes = part.bytes - body_offset - 2

            if isset(fn) {
                let file_data = part.view(body_offset, body_bytes)
                let file = fs.InMemoryFile.new(file_data)
                let mime_type = headers.get("content-type") ! continue
                file.set_metadata(fn, mime_type)
                files.set(name, file)
            } else {
                let v = part.range(body_offset, body_bytes)
                result.set(name, v)
            }
        }
    }

    - fn parse_content_disposition(value: String, result: Map[String]) {
        // form-data name="avatar" filename="avatar.jpg"
        let buf = ByteBuffer.new(128)
        let in_str = false
        let in_value = false
        let key = ""
        let val = ""
        let last_ch: u8 = 0
        each value as ch {
            if in_str {
                // A quoted-pair stands for the byte after its backslash, which is not
                // the quote it would otherwise look like
                if last_ch == '\\' {
                    buf.write_byte(ch)
                    last_ch = 0
                    continue
                }
                if ch == '\\' {
                    last_ch = ch
                    continue
                }
                if ch == '"' {
                    in_str = false
                    last_ch = 0
                    continue
                }
                buf.write_byte(ch)
                continue
            }
            if ch == '"' {
                in_str = true
                continue
            }
            // An unquoted value may hold '=', which only separates a key when one is
            // still being read: "name=a=b" is the name "a=b", not a stray key "a"
            if ch == '=' && !in_value {
                key = buf
                buf.clear()
                in_value = true
                continue
            }
            if ch == ' ' || ch == ';' {
                if buf.length > 0 {
                    if in_value : val = buf
                    else : key = buf
                    buf.clear()
                }
                if key.length > 0 : result.set(key, val)
                key = ""
                val = ""
                in_value = false
                continue
            }
            buf.write_byte(ch)
        }

        if buf.length > 0 {
            if in_value : val = buf
            else : key = buf
        }
        if key.length > 0 : result.set(key, val)
    }

    - fn data_json_body(result: Map[String]) {
        let data = json.decode(this.body) ! return
        if !data.is_object : return
        let object = data.object
        each object.values as value, key {
            match value {
                null => result.set(key, "")
                String as text => result.set(key, text)
                default => result.set(key, json.encode(value))
            }
        }
    }

}

// The media type of a `Content-Type` value: without parameters, trimmed and lowercased
fn content_media_type(value: String) String {
    let end = value.index_of_byte(';') !? value.bytes
    let start: uint = 0
    while start < end && value[start].is_space_or_tab() : start++
    while end > start && value[end - 1].is_space_or_tab() : end--
    return value.range(start, end - start).lower()
}

// The value of the parameter `name` (case-insensitive) of a `Content-Type` value, with
// a quoted-string unquoted (RFC 9110 §5.6.6); null when the parameter is absent
fn content_type_param(value: String, name: String) ?String {
    let len = value.bytes
    let i = value.index_of_byte(';') !? len
    while i < len {
        // `i` is at a `;`
        i++
        while i < len && value[i].is_space_or_tab() : i++
        let key_start = i
        while i < len && value[i] != '=' && value[i] != ';' : i++
        let key_end = i
        while key_end > key_start && value[key_end - 1].is_space_or_tab() : key_end--
        if i == len || value[i] == ';' : continue
        // Skip the `=`
        i++
        while i < len && value[i].is_space_or_tab() : i++
        let param = ""
        if i < len && value[i] == '"' {
            i++
            let buf = ByteBuffer.new(len - i)
            while i < len && value[i] != '"' {
                if value[i] == '\\' && i + 1 < len : i++
                buf.write_byte(value[i])
                i++
            }
            param = buf.to_string()
            while i < len && value[i] != ';' : i++
        } else {
            let param_start = i
            while i < len && value[i] != ';' : i++
            let param_end = i
            while param_end > param_start && value[param_end - 1].is_space_or_tab() : param_end--
            param = value.range(param_start, param_end - param_start)
        }
        if value.view(key_start, key_end - key_start).equals_ignore_ascii_case(name) : return param
    }
    return null
}

fn parse_headers(data: local &[u8], result: Headers) uint !HttpParseError {
    let pos: uint = 0
    let length = data.length

    while true {
        let index = data.index_of_byte('\r', pos) ! throw .invalid
        if index + 1 >= length : throw .invalid
        if (data.get(index + 1) ! throw .invalid) != '\n' : throw .invalid

        // End of headers
        if index == pos {
            pos += 2
            break
        }

        let split = data.index_of_byte(':', pos) ! throw .invalid
        if split >= index : throw .invalid

        let value_pos = split + 1
        while value_pos < index && (data.get(value_pos) ! throw .invalid) == ' ' : value_pos++

        let key = data.view(pos, split - pos).to_ascii_lower_string()
        let value = data.view(value_pos, index - value_pos).to_string()
        result.append(key, value)

        pos = index + 2
    }

    return pos
}

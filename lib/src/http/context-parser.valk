
use fs
use url
use json

trait ContextParser {
    -+ header_map: ?Map[String]
    -+ params_map: ?Map[String]
    -+ params_grp: ?Map[Array[String]]
    -+ data_map: ?Map[String]
    -+ data_json_cache: json.Value (null)
    -+ files_map: ?Map[fs.InMemoryFile]

    fn reset_cache() {
        this.header_map = null
        this.params_map = null
        this.params_grp = null
        this.data_map = null
        this.data_json_cache = null
        this.files_map = null
    }

    + fn headers() Map[String] {
        let headers = this.header_map
        if isset(headers) : return headers
        let new = Map[String].new()
        this.parse_stored_headers(new)
        this.header_map = new
        return new
    }

    + fn params() Map[String] {
        let params = this.params_map
        if isset(params) : return params
        let new = Map[String].new()
        let data = this.query_string.to_string()
        if data.bytes > 0 {
            let parts = data.split("&")
            each parts as part {
                let k, v = part.split_on_first_occurance_of_byte('=') ! continue
                new.set(k, url.decode(v))
            }
        }
        this.params_map = new
        return new
    }

    + fn params_grouped() Map[Array[String]] {
        let params = this.params_grp
        if isset(params) : return params
        let new = Map[Array[String]].new()
        let data = this.query_string.to_string()
        if data.bytes > 0 {
            let parts = data.split("&")
            each parts as part {
                let k, v = part.split_on_first_occurance_of_byte('=') ! continue
                let arr = new.get(k) ! {
                    let g = Array[String].new()
                    g.append(url.decode(v))
                    new.set(k, g)
                    // new.set(k, Array[String]{ url.decode(v) })
                    continue
                }
                arr.append(url.decode(v))
            }
        }
        this.params_grp = new
        return new
    }

    + fn data() Map[String] {
        let data = this.data_map
        if isset(data) : return data
        let new = Map[String].new()
        let files = Map[fs.InMemoryFile]{}
        let headers = this.headers()
        let type = headers.get("content-type") !? ""

        if type.starts_with("application/x-www-form-urlencoded") {
            this.data_urlencoded(new)
        } else if type.starts_with("multipart/form-data") {
            this.data_multipart(new, files, type.ltrim("multipart/form-data; boundary="))
        } else if type == "application/json" {
            this.data_json_body(new)
        }
        this.data_map = new
        this.files_map = files
        return new
    }

    + fn data_json() json.Value {
        let data = this.data_json_cache
        if isset(data) : return data

        let headers = this.headers()
        let type = headers.get("content-type") !? ""

        let res: json.Value = null

        if type.starts_with("application/x-www-form-urlencoded") {
            let object = json.new_object()
            let data = this.data()
            each data as v, k {
                object.set(k, json.from(v))
            }
            res = object
        } else if type.starts_with("multipart/form-data") {
            let object = json.new_object()
            let data = this.data()
            each data as v, k {
                object.set(k, json.from(v))
            }
            res = object
        } else {
            let body = this.body
            res = json.decode(body) !? json.new_object()
        }
        this.data_json_cache = res
        return res
    }

    + fn files() Map[fs.InMemoryFile] {
        let files = this.files_map
        if isset(files) : return files
        this.data()
        return this.files()
    }

    - fn data_urlencoded(result: Map[String]) {
        let parts = this.body.split("&")
        each parts as part {
            let k, v = part.split_on_first_occurance_of_byte('=') ! continue
            result.set(k, url.decode(v))
        }
    }
    - fn data_multipart(result: Map[String], files: Map[fs.InMemoryFile], boundary: String) {
        let headers = Map[String].new()
        let dispos = Map[String].new()
        let body = this.body
        let parts = body.split("--" + boundary)
        each parts as part, i {
            if i == 0 : continue
            let ch = part.get(0)
            if ch != '\r' : break
            ch = part.get(1)
            if ch != '\n' : break
            // Parse headers
            headers.clear()
            dispos.clear()
            let part_data = part.view(2, part.bytes - 2)
            let header_bytes = parse_headers[String](part_data, headers) ! continue
            // Content disposition
            let dispo = headers.get("content-disposition") ! continue
            this.parse_content_disposition(dispo, dispos)
            let name = dispos.get("name") ! continue
            let fn: ?String = dispos.get("filename") !? null
            // 
            let body_offset = header_bytes + 2
            if body_offset > part.bytes - 2 : continue
            let body_bytes = part.bytes - body_offset - 2

            if isset(fn) {
                let file = fs.InMemoryFile.create_from_ptr(part.data + body_offset, body_bytes)
                let mime_type = headers.get("content-type") ! continue
                file.set_metadata(fn, mime_type)
                files.set(name, file)
            } else {
                let v = part.part(body_offset, body_bytes)
                result.set(name, v)
            }
        }
    }

    - fn parse_content_disposition(value: String, result: Map[String]) {
        // form-data name="avatar" filename="avatar.jpg"
        let buf = ByteBuffer.new(128)
        let in_str = false
        let in_value = false
        let key = ""
        let val = ""
        let last_ch: u8 = 0
        each value as ch {
            if in_str {
                if ch == '"' && last_ch != '\\' {
                    last_ch = 0
                    in_str = false
                    continue
                }
                last_ch = ch
                buf.write_byte(ch)
                continue
            }
            if ch == '"' {
                in_str = true
                continue
            }
            if ch == '=' {
                key = buf
                buf.clear()
                in_value = true
                continue
            }
            if ch == ' ' || ch == ';' {
                if buf.length > 0 {
                    if in_value : val = buf
                    else : key = buf
                    buf.clear()
                }
                if key.length > 0 : result.set(key, val)
                key = ""
                val = ""
                in_value = false
                continue
            }
            buf.write_byte(ch)
        }

        if buf.length > 0 {
            if in_value : val = buf
            else : key = buf
        }
        if key.length > 0 : result.set(key, val)
    }

    - fn data_json_body(result: Map[String]) {
        let data = json.decode(this.body) ! return
        if !data.is_object : return
        let object = data.object
        each object.values as value, key {
            match value {
                null => result.set(key, "")
                String as text => result.set(key, text)
                default => result.set(key, json.encode(value))
            }
        }
    }

}

fn parse_headers[T](data: ByteView[T], result: Map[String]) uint !HttpParseError {
    let pos: uint = 0
    let length = data.bytes

    while true {
        let index = data.index_of_byte('\r', pos) ! throw .invalid
        if index + 1 >= length : throw .invalid
        if data[index + 1] != '\n' : throw .invalid

        // End of headers
        if index == pos {
            pos += 2
            break
        }

        let split = data.index_of_byte(':', pos) ! throw .invalid
        if split >= index : throw .invalid

        let value_pos = split + 1
        while value_pos < index && data[value_pos] == ' ' : value_pos++

        let key = data.view(pos, split - pos).to_ascii_lower_string()
        let value = data.view(value_pos, index - value_pos).to_string()
        result.get(key) -> prev: value = prev + ", " + value
        result.set(key, value)

        pos = index + 2
    }

    return pos
}

use net

/// A request passed to a server handler.
///
/// `headers()`, `query()`, `form()`, `json()` and `files()` parse the request on first
/// use and cache the result.
+ class Request {
    /// The request method as sent, such as `GET`.
    + method: String
    /// The path of the request target without the query string, not percent-decoded (see
    /// `url.decode_path`).
    + path: String
    /// The query string without the leading `?`, not decoded; empty when absent.
    + query_string: String
    /// The client's address.
    + peer_address: net.SocketAddress (.{})
    /// The subject of the certificate the client sent, such as `CN=alice,O=Example`; empty
    /// when it sent none. A server asks for one with `Server.tls_client_ca`.
    + client_subject: String ("")
    /// The SHA-256 fingerprint of that certificate as 64 lowercase hex characters; empty when
    /// the client sent none.
    + client_certificate_sha256: String ("")
    -+ body_data: String
    -+ header_data: String
    -+ h2_fields: ?Array[HpackField] (null)

    use ContextParser

    fn parse_stored_headers(result: Headers) {
        let fields = this.h2_fields
        if isset(fields) {
            each fields as field {
                if field.name == ":authority" : result.set("host", field.value)
                else if field.name == "cookie" && result.has("cookie") : result.set("cookie", (result.get("cookie") !!) + "; " + field.value)
                else if !field.name.starts_with(":") : result.append(field.name, field.value)
            }
            return
        }
        parse_headers(this.header_data.view(0, this.header_data.bytes), result) ! panic("Stored HTTP headers are invalid")
    }

    fn find_stored_header(name: String) ?String {
        let fields = this.h2_fields
        if isset(fields) : return find_h2_header(fields, name)
        return find_header(this.header_data.view(0, this.header_data.bytes), name)
    }

    fn find_stored_query_param(name: String) ?String {
        return find_query_param(this.query_string.view(0, this.query_string.bytes), name)
    }

    /// The request body; empty when there is none.
    + get body: String {
        return this.body_data
    }
}

fn find_h2_header(fields: Array[HpackField], name: String) ?String {
    if name.bytes == 0 || name[0] == ':' : return null
    let name_view = name.view(0, name.bytes)
    if name_view.equals_ignore_ascii_case("host") {
        let host: ?String = null
        each fields as field {
            if field.name == ":authority" : return field.value
            if !isset(host) && field.name == "host" : host = field.value
        }
        return host
    }
    if name_view.equals_ignore_ascii_case("cookie") {
        let first: ?String = null
        let combined: ?ByteBuffer = null
        each fields as field {
            if field.name != "cookie" : continue
            if !isset(first) {
                first = field.value
            } else {
                let buf = combined ?? <{
                    let b = ByteBuffer.new(first.bytes + field.value.bytes + 2)
                    b.write(first)
                    combined = b
                    return b
                }
                buf.write("; ")
                buf.write(field.value)
            }
        }
        if isset(combined) : return combined.into_string()
        return first
    }
    each fields as field {
        if field.name.bytes == name.bytes && !field.name.starts_with(":") && field.name.view(0, field.name.bytes).equals_ignore_ascii_case(name) {
            return field.value
        }
    }
    return null
}

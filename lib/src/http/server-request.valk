
+ class Request {
    + method: String
    + path: String
    + query_string: String
    -+ body_data: String
    -+ header_data: String

    use ContextParser

    fn parse_stored_headers(result: Map[String]) {
        parse_headers[String](this.header_data.view(0, this.header_data.bytes), result) ! panic("Stored HTTP headers are invalid")
    }

    + get body: String {
        return this.body_data
    }
}

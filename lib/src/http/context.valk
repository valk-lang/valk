
use fs
use core

+ class Context {
    ~+ method: ByteView[ByteBuffer]
    ~+ path: ByteView[ByteBuffer]
    ~+ query_string: ByteView[ByteBuffer]
    -+ header_data: ByteView[ByteBuffer]
    -+ body_data: ByteView[ByteBuffer]
    -+ chunks: ByteBuffer (ByteBuffer.new(2048))

    ~+ status: uint (0)
    -+ stage: uint (0)
    ~+ parsed_index: uint (0)
    -+ request_start: uint (0)
    ~+ content_length: uint (0)
    ~+ body_received: uint (0)
    ~+ body_expected: uint (0)
    -+ header_size: uint (0)
    -+ trailer_start: uint (0)
    -+ save_to_file: ?fs.FileStream (null)

    ~+ has_host: bool (false)
    ~+ has_content_length: bool (false)
    ~+ has_transfer_encoding: bool (false)
    ~+ chunked: bool (false)
    ~+ chunk_trailers: bool (false)
    -+ close_delimited: bool (false)
    -+ response_to_head: bool (false)
    -+ response_to_connect: bool (false)
    -+ done: bool (false)

    use ContextParser

    static fn new(buffer: ByteBuffer) Context {
        return Context {
            method: buffer.view(0, 0)
            path: buffer.view(0, 0)
            query_string: buffer.view(0, 0)
            header_data: buffer.view(0, 0)
            body_data: buffer.view(0, 0)
        }
    }

    fn reset() {
        let file = this.save_to_file
        if isset(file) {
            file.close() ! core.cleanup_warning("Failed to close HTTP output file", __FILE__, __LINE__)
        }
        this.save_to_file = null

        this.stage = 0
        this.status = 0
        this.content_length = 0
        this.body_received = 0
        this.body_expected = 0
        this.header_size = 0
        this.trailer_start = 0

        this.method.clear()
        this.path.clear()
        this.query_string.clear()
        this.header_data.clear()
        this.body_data.clear()
        this.chunks.clear()
        this.chunks.reduce_size(2048)

        this.reset_cache()

        this.has_host = false
        this.has_content_length = false
        this.has_transfer_encoding = false
        this.chunked = false
        this.chunk_trailers = false
        this.close_delimited = false
        this.response_to_head = false
        this.response_to_connect = false
        this.done = false
    }

    fn parse_stored_headers(result: Map[String]) {
        parse_headers[ByteBuffer](this.header_data, result) ! panic("Stored HTTP headers are invalid")
    }

    + get body: String {
        if !this.done : return ""
        if this.chunked : return this.chunks.to_string()
        return this.body_data.to_string()
    }
}

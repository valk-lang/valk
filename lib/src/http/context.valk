
use fs
use net
use io
use core

/// The parse state of one HTTP/1.x message; `fast` handlers receive it as the request.
///
/// `method`, `path` and `query_string` are views into the connection's input buffer and
/// are only valid during the handler call; copy them with `to_string()` to keep them.
/// `headers()`, `query()`, `form()`, `json()` and `files()` parse on first use and
/// cache the result.
+ class Context {
    /// The request method as sent, such as `GET`.
    ~+ method: &[u8]
    /// The path of the request target without the query string, not percent-decoded.
    ~+ path: &[u8]
    /// The query string without the leading `?`, not decoded; empty when absent.
    ~+ query_string: &[u8]
    /// The client's address; unset (port 0) for a context that was not accepted by a server.
    ~+ peer_address: net.SocketAddress (.{})
    -+ header_data: &[u8]
    -+ body_data: &[u8]
    // Byte index of `header_data` / `body_data` inside the input buffer.
    -+ header_start: uint (0)
    -+ body_start: uint (0)
    -+ chunks: ByteBuffer (ByteBuffer.new(2048))

    /// The status code of a parsed response; 0 for a request.
    ~+ status: u16 (0)
    -+ stage: uint (0)
    -+ parsed_index: uint (0)
    -+ request_start: uint (0)
    -+ content_length: uint (0)
    -+ body_received: uint (0)
    -+ body_expected: uint (0)
    -+ header_size: uint (0)
    -+ trailer_start: uint (0)
    -+ chunk_bytes: uint (0)
    -+ output: ?io.Writer (null)

    -+ http10: bool (false)
    -+ connection_close: bool (false)
    -+ connection_keep_alive: bool (false)
    -+ has_host: bool (false)
    -+ has_content_length: bool (false)
    -+ has_transfer_encoding: bool (false)
    -+ chunked: bool (false)
    -+ chunk_trailers: bool (false)
    -+ close_delimited: bool (false)
    -+ response_to_head: bool (false)
    -+ response_to_connect: bool (false)
    -+ done: bool (false)

    use ContextParser

    static fn new(buffer: ByteBuffer) Context {
        return Context {
            method: buffer.view(0, 0)
            path: buffer.view(0, 0)
            query_string: buffer.view(0, 0)
            header_data: buffer.view(0, 0)
            body_data: buffer.view(0, 0)
        }
    }

    fn reset() {
        this.output = null

        this.stage = 0
        this.status = 0
        this.content_length = 0
        this.body_received = 0
        this.body_expected = 0
        this.header_size = 0
        this.trailer_start = 0
        this.chunk_bytes = 0

        // The parser assigns the other views before they are read again
        this.query_string = this.query_string.view(0, 0)
        if this.chunks.length > 0 {
            this.chunks.clear()
            this.chunks.shrink_capacity(2048)
        }

        this.reset_cache()

        this.http10 = false
        this.connection_close = false
        this.connection_keep_alive = false
        this.has_host = false
        this.has_content_length = false
        this.has_transfer_encoding = false
        this.chunked = false
        this.chunk_trailers = false
        this.close_delimited = false
        this.response_to_head = false
        this.response_to_connect = false
        this.done = false
    }

    fn parse_stored_headers(result: Headers) {
        parse_headers(this.header_data, result) ! panic("Stored HTTP headers are invalid")
    }

    /// Whether the client expects the connection to stay open after the response.
    ///
    /// HTTP/1.1 keeps it unless `Connection: close` was sent; HTTP/1.0 only when
    /// `Connection: keep-alive` was sent.
    + get keep_alive: bool {
        if this.http10 : return this.connection_keep_alive && !this.connection_close
        return !this.connection_close
    }

    /// The message body, with chunked encoding removed; empty until the message is
    /// complete.
    + get body: String {
        if !this.done : return ""
        if this.chunked : return this.chunks.to_string()
        return this.body_data.to_string()
    }
}

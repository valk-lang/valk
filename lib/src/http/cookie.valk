use time

/// When a browser sends a cookie on a request that another site caused.
+ enum SameSite {
    /// Sent on same-site requests, and on a normal link from another site.
    lax
    /// Only sent on same-site requests, so a link from another site arrives without it.
    strict
    /// Sent on every request, including a form post or a fetch from another site.
    /// Browsers drop such a cookie unless `secure` is set too, which it is by default.
    none
}

/// A cookie to send with a response.
///
/// `secure`, `http_only` and `SameSite.lax` are on by default: the cookie travels over
/// HTTPS only, is out of reach of page scripts, and is not sent along by another site.
/// A cookie that is forgotten about is then the safe one, and a program that wants less
/// says so.
///
/// ```valk
/// let cookie = http.Cookie.new("session", id)
/// cookie.max_age = 3600
/// response.set_cookie(cookie)
/// ```
///
/// Development over plain HTTP is the one place to turn `secure` off. Browsers make an
/// exception for `localhost` and keep the cookie there, but on any other plain-HTTP
/// address, such as a LAN IP or a staging hostname, they drop it without saying so.
+ class Cookie {
    /// The name, which may not be empty or hold a separator.
    + name: String ("")
    /// The value. It is sent as it is, in double quotes when it holds a space or a comma.
    + value: String ("")
    /// The paths the cookie is sent on; `/` is the whole site.
    + path: String ("/")
    /// The hosts the cookie is sent to. Without one it is the host that set it, without
    /// its subdomains; with one, that domain and every subdomain of it.
    + domain: ?String (null)
    /// The moment the cookie is dropped. A moment in the past deletes it.
    + expires: ?time.DateTime (null)
    /// How many seconds the cookie lives. `0` deletes it. Browsers prefer this over
    /// `expires` when both are given.
    + max_age: ?int (null)
    /// Only send the cookie over HTTPS. Off during plain-HTTP development.
    + secure: bool (true)
    /// Keep the cookie away from page scripts (`document.cookie`).
    + http_only: bool (true)
    /// When the cookie is sent on requests another site caused.
    + same_site: SameSite (SameSite.lax)

    /// Creates a cookie with `name` and `value`, and the defaults of the class.
    + static fn new(name: String, value: String) SELF {
        return SELF { name: name, value: value }
    }

    /// Whether the cookie can be sent: a name and a value a header can carry.
    + fn is_valid() bool {
        return cookie_name_is_valid(this.name) && cookie_value_is_valid(this.value)
    }

    /// Returns the `Set-Cookie` field value for this cookie.
    ///
    /// Attributes left null are not written. An invalid name or value gives an empty
    /// string, which the server leaves out of the response.
    + fn to_header() String {
        if !this.is_valid() : return ""
        let buf = ByteBuffer.new(this.name.bytes + this.value.bytes + 64)
        buf.write(this.name)
        buf.write("=")
        // A value with a space or a comma is legal inside double quotes
        let quote = this.value.contains_byte(' ') || this.value.contains_byte(',')
        if quote : buf.write("\"")
        buf.write(this.value)
        if quote : buf.write("\"")

        let path = this.path
        if path.bytes > 0 && attribute_is_valid(path) {
            buf.write("; Path=")
            buf.write(path)
        }
        let domain = this.domain
        if isset(domain) && domain.bytes > 0 && attribute_is_valid(domain) {
            buf.write("; Domain=")
            buf.write(domain)
        }
        let expires = this.expires
        if isset(expires) {
            buf.write("; Expires=")
            buf.write(format_date(expires))
        }
        let max_age = this.max_age
        if isset(max_age) {
            buf.write("; Max-Age=")
            buf.write_int_ascii(max_age)
        }
        if this.secure : buf.write("; Secure")
        if this.http_only : buf.write("; HttpOnly")
        if this.same_site == SameSite.strict : buf.write("; SameSite=Strict")
        else if this.same_site == SameSite.none : buf.write("; SameSite=None")
        else : buf.write("; SameSite=Lax")

        return buf.into_string()
    }

    /// Reads a `Set-Cookie` field value, as a client does.
    ///
    /// Attributes it does not know are skipped, and so is an `Expires` it cannot read;
    /// `Max-Age` then still says how long the cookie lives. Throws `SyntaxError` when
    /// there is no `name=value` in front.
    + static fn parse(header: String) SELF !SyntaxError {
        let parts = header.split(";")
        let first = parts.get(0) ! throw .syntax
        let name, value = first.split_on_first_occurance_of_byte('=') ! throw .syntax
        // The defaults of the class are for a cookie being set; what is read is what the
        // header says, so an attribute that is not there is off
        let cookie = SELF {
            name: name.trim(" ")
            value: unquote(value.trim(" "))
            secure: false
            http_only: false
        }
        each parts as part, i {
            if i == 0 : continue
            let trimmed = part.trim(" ")
            // An attribute without a value, such as Secure, is the name alone
            let name_part, value_part = trimmed.split_on_first_occurance_of_byte('=') !? (trimmed, "")
            let key = name_part.trim(" ")
            let val = value_part.trim(" ")

            if key.equals_ignore_ascii_case("path") : cookie.path = val
            else if key.equals_ignore_ascii_case("domain") : cookie.domain = val.ltrim(".")
            else if key.equals_ignore_ascii_case("secure") : cookie.secure = true
            else if key.equals_ignore_ascii_case("httponly") : cookie.http_only = true
            else if key.equals_ignore_ascii_case("max-age") : cookie.max_age = val.to_int() !? null
            else if key.equals_ignore_ascii_case("expires") : cookie.expires = parse_date(val) !? null
            else if key.equals_ignore_ascii_case("samesite") {
                if val.equals_ignore_ascii_case("strict") : cookie.same_site = SameSite.strict
                else if val.equals_ignore_ascii_case("none") : cookie.same_site = SameSite.none
                else : cookie.same_site = SameSite.lax
            }
        }
        return cookie
    }
}

/// Reads a `Cookie` request header into `result`, the way `Request.cookies` does.
fn parse_cookie_header(header: String, result: Map[String]) {
    let parts = header.split(";")
    each parts as part {
        let trimmed = part.trim(" ")
        if trimmed.bytes == 0 : continue
        // A value may hold '=', so only the first one separates
        let name, value = trimmed.split_on_first_occurance_of_byte('=') ! continue
        let key = name.trim(" ")
        if key.bytes == 0 : continue
        // The first cookie of a name is the most specific one the browser has
        if result.has(key) : continue
        result.set(key, unquote(value.trim(" ")))
    }
}

fn unquote(value: String) String {
    if value.bytes < 2 : return value
    if value.get(0) != '"' || value.get(value.bytes - 1) != '"' : return value
    return value.range(1, value.bytes - 2)
}

fn cookie_name_is_valid(name: String) bool {
    if name.bytes == 0 : return false
    let i: uint = 0
    while i < name.bytes {
        let ch = name.get(i++)
        if ch <= ' ' || ch >= 127 : return false
        if ch == '(' || ch == ')' || ch == '<' || ch == '>' || ch == '@' || ch == ',' : return false
        if ch == ';' || ch == ':' || ch == '\\' || ch == '"' || ch == '/' : return false
        if ch == '[' || ch == ']' || ch == '?' || ch == '=' || ch == '{' || ch == '}' : return false
    }
    return true
}

fn cookie_value_is_valid(value: String) bool {
    let i: uint = 0
    while i < value.bytes {
        let ch = value.get(i++)
        // Quoting takes care of a space or a comma; the rest ends the value or the header
        if ch < ' ' || ch >= 127 : return false
        if ch == '"' || ch == ';' || ch == '\\' : return false
    }
    return true
}

fn attribute_is_valid(value: String) bool {
    let i: uint = 0
    while i < value.bytes {
        let ch = value.get(i++)
        if ch < ' ' || ch >= 127 || ch == ';' : return false
    }
    return true
}

global day_names: [String x 7] ({ "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
global month_names: [String x 12] ({ "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" })

/// Returns `date` as an HTTP date: `Sun, 06 Nov 1994 08:49:37 GMT`.
///
/// The value is read as UTC, which is the only zone HTTP dates are written in.
+ fn format_date(date: time.DateTime) String {
    let buf = ByteBuffer.new(29)
    buf.write(day_names[date.day_of_week() - 1])
    buf.write(", ")
    write_padded(buf, date.day())
    buf.write(" ")
    buf.write(month_names[date.month() - 1])
    buf.write(" ")
    let year = date.year()
    if year < 1000 : buf.write("0")
    if year < 100 : buf.write("0")
    if year < 10 : buf.write("0")
    buf.write_int_ascii(year)
    buf.write(" ")
    write_padded(buf, date.hour())
    buf.write(":")
    write_padded(buf, date.minute())
    buf.write(":")
    write_padded(buf, date.second())
    buf.write(" GMT")
    return buf.into_string()
}

/// Reads an HTTP date such as `Sun, 06 Nov 1994 08:49:37 GMT`.
///
/// Throws `SyntaxError` for anything else, including the two formats RFC 9110 calls
/// obsolete.
+ fn parse_date(text: String) time.DateTime !SyntaxError {
    let value = text.trim(" ")
    if value.bytes < 29 : throw .syntax
    let day = read_number(value, 5, 2) !>
    let month = month_of(value.range(8, 3)) !>
    let year = read_number(value, 12, 4) !>
    let hour = read_number(value, 17, 2) !>
    let minute = read_number(value, 20, 2) !>
    let second = read_number(value, 23, 2) !>
    return time.DateTime.new(year.to(int), month, day, hour, minute, second) ! throw .syntax
}

fn month_of(name: String) uint !SyntaxError {
    let i: uint = 0
    while i < 12 {
        if month_names[i] == name : return i + 1
        i++
    }
    throw .syntax
}

fn read_number(value: String, offset: uint, length: uint) uint !SyntaxError {
    let result: uint = 0
    let i: uint = 0
    while i < length {
        let ch = value.get(offset + i++)
        if ch < '0' || ch > '9' : throw .syntax
        result = result * 10 + (ch - '0').to(uint)
    }
    return result
}

fn write_padded(buf: ByteBuffer, value: uint) {
    if value < 10 : buf.write("0")
    buf.write_uint_ascii(value)
}

use time
use url
use fs
use core
use io

/// Connects and prepares a request without sending it; drive it with `progress`.
///
/// Fails with `invalid_url` for anything but an `http`/`https` URL with a host, a URL
/// with credentials or an out-of-range port, with `invalid_request` for an invalid
/// method, path or header, and with the connection/TLS errors of `ClientRequest.create`.
/// Redirects are not followed.
+ fn create_request(method: String, url: String, options: ?Options (null)) ClientRequest !HttpError {
    if !isset(options) : options = Options {}
    return ClientRequest.new(method, url, options) !>
}

/// Sends a GET request; see `request`.
+ fn get(url: String, options: ?Options (null)) ClientResponse !HttpError {
    return request("GET", url, options) !>
}

/// Sends a HEAD request; see `request`.
+ fn head(url: String, options: ?Options (null)) ClientResponse !HttpError {
    return request("HEAD", url, options) !>
}

/// Sends a DELETE request; see `request`.
+ fn delete(url: String, options: ?Options (null)) ClientResponse !HttpError {
    return request("DELETE", url, options) !>
}

/// Sends a POST request with `body`; see `request`.
///
/// `body` is stored in `options.body`, so a passed `Options` object is modified.
+ fn post(url: String, body: String, options: ?Options (null)) ClientResponse !HttpError {
    return request_with_body("POST", url, body, options) !>
}

/// Sends a PUT request with `body`; see `post`.
+ fn put(url: String, body: String, options: ?Options (null)) ClientResponse !HttpError {
    return request_with_body("PUT", url, body, options) !>
}

/// Sends a PATCH request with `body`; see `post`.
+ fn patch(url: String, body: String, options: ?Options (null)) ClientResponse !HttpError {
    return request_with_body("PATCH", url, body, options) !>
}

fn request_with_body(method: String, url: String, body: String, options: ?Options) ClientResponse !HttpError {
    let opts = options ?? Options {}
    opts.body = body
    return request(method, url, opts) !>
}

/// Sends a request and returns the final response, following redirects.
///
/// Blocks until the response is complete. Any status code is returned as a response;
/// only transport, protocol, limit and timeout problems throw. Each request uses a new
/// connection, which is closed afterwards.
///
/// ```valk
/// let res = http.request("GET", "https://example.com/") ! panic("request failed")
/// println(res.status)
/// ```
+ fn request(method: String, url: String, options: ?Options (null)) ClientResponse !HttpError {
    let deadline_ms: uint = 0
    let timeout_ms = isset(options) ? options.timeout_ms : DEFAULT_REQUEST_TIMEOUT_MS
    if timeout_ms > 0 : deadline_ms = time.deadline_ms(timeout_ms)
    return request_with_deadline(method, url, options, deadline_ms) !>
}

fn is_redirect(status: u16) bool {
    return status == 301 || status == 302 || status == 303 || status == 307 || status == 308
}

// The URL a redirect's `Location` points to, read against the URL that answered with it
fn redirect_url(from: String, location: String) String {
    return url.parse(from).resolve(location).to_string()
}

fn url_origin(value: String) String {
    let parsed = url.parse(value)
    let port = parsed.port
    if isset(port) && ((parsed.scheme == "http" && port == 80) || (parsed.scheme == "https" && port == 443)) {
        parsed.port = null
    }
    return parsed.scheme + "://" + parsed.host_with_port().lower()
}

fn redirected_method(method: String, status: u16) String {
    let upper = method.upper()
    if status == 303 && upper != "HEAD" : return "GET"
    if (status == 301 || status == 302) && upper == "POST" : return "GET"
    return method
}

fn redirect_header_is_sensitive(name: String) bool {
    return name.equals_ignore_ascii_case("authorization")
        || name.equals_ignore_ascii_case("proxy-authorization")
        || name.equals_ignore_ascii_case("cookie")
        || name.equals_ignore_ascii_case("cookie2")
}

fn redirect_header_describes_body(name: String) bool {
    return name.equals_ignore_ascii_case("content-length")
        || name.equals_ignore_ascii_case("content-type")
        || name.equals_ignore_ascii_case("content-encoding")
        || name.equals_ignore_ascii_case("transfer-encoding")
}

fn redirect_options(options: ?Options, cross_origin: bool, drop_body: bool) ?Options {
    if !isset(options) : return null

    let headers: ?Headers = null
    let source_headers = options.headers
    if isset(source_headers) {
        headers = Headers.new()
        each source_headers as value, name {
            if name.equals_ignore_ascii_case("host") : continue
            if cross_origin && redirect_header_is_sensitive(name) : continue
            if drop_body && redirect_header_describes_body(name) : continue
            headers.append(name, value)
        }
    }

    // The query data and the Host override belong to the first URL
    let next = copy_options(options)
    next.body = drop_body ? "" : options.body
    next.headers = headers
    next.query_data = null
    next.host = null
    return next
}

fn options_with_output(options: Options, output: io.Writer) Options {
    let copy = copy_options(options)
    copy.output = output
    return copy
}

// Every setting of `options`, in a new object; `headers` is shared
fn copy_options(options: Options) Options {
    return Options {
        body: options.body
        query_data: options.query_data
        headers: options.headers
        host: options.host
        proxy: options.proxy
        proxy_from_env: options.proxy_from_env
        output: options.output
        follow_redirects: options.follow_redirects
        max_redirects: options.max_redirects
        verify_tls_cert: options.verify_tls_cert
        ca_cert_path: options.ca_cert_path
        client_certificate_file: options.client_certificate_file
        client_key_file: options.client_key_file
        client_key_password: options.client_key_password
        certificate_sha256: options.certificate_sha256
        min_tls_version: options.min_tls_version
        max_tls_version: options.max_tls_version
        tls_cipher_list: options.tls_cipher_list
        tls_cipher_suites: options.tls_cipher_suites
        alpn_protocols: options.alpn_protocols
        timeout_ms: options.timeout_ms
        connect_timeout_ms: options.connect_timeout_ms
        read_timeout_ms: options.read_timeout_ms
        write_timeout_ms: options.write_timeout_ms
        max_response_header_size: options.max_response_header_size
        max_response_body_size: options.max_response_body_size
        decompress: options.decompress
    }
}

fn request_with_deadline(method: String, url: String, options: ?Options, deadline_ms: uint, client: ?Client (null)) ClientResponse !HttpError {
    let current_method = method
    let current_url = url
    let current_options = options
    let redirects: uint = 0

    while true {
        let hop_options = current_options
        if isset(client) : hop_options = options_with_cookies(current_options, client.cookies.header_for(current_url))
        let res = send_once(current_method, current_url, hop_options, deadline_ms, client) !>
        if isset(client) : client.cookies.store(current_url, res)
        if !is_redirect(res.status) : return res

        let follow = !isset(current_options) || current_options.follow_redirects
        if !follow : return res
        let location = res.headers.get("location") !? null
        if !isset(location) : return res

        let max_redirects: uint = isset(current_options) ? current_options.max_redirects : DEFAULT_MAX_REDIRECTS
        if redirects >= max_redirects : throw .too_many_redirects
        redirects++

        let next_url = redirect_url(current_url, location)
        let next_method = redirected_method(current_method, res.status)
        let drop_body = next_method.upper() != current_method.upper()
        current_options = redirect_options(current_options,
            url_origin(current_url) != url_origin(next_url), drop_body)
        current_method = next_method
        current_url = next_url
    }
}

// The options of one request with the cookies of a `Client` added, unless its own headers
// carry a `Cookie` already
fn options_with_cookies(options: ?Options, cookies: String) ?Options {
    if cookies.bytes == 0 : return options
    let headers = isset(options) ? options.headers : null
    if isset(headers) && headers.has("cookie") : return options
    let copy = isset(options) ? copy_options(options) : Options {}
    let own = Headers.new()
    if isset(headers) {
        each headers as value, name : own.append(name, value)
    }
    own.append("Cookie", cookies)
    copy.headers = own
    return copy
}

/// Sends a request and writes the response body to the file at `to_path`.
///
/// Redirects are followed as `request` does. The final response must have a 2xx status:
/// any other status throws `status` (`request` with `Options.output` set to a file gives
/// the code itself). The file is created or truncated first and removed again when the
/// download fails, so it only exists after a successful one. The request uses a copy of `options` whose `output` is the file; the
/// caller's object is not changed. Without `options` the timeout is 30 seconds instead of
/// the usual 10. Failing to close the file throws `write`.
+ fn download(url: String, to_path: String, method: String ("GET"), options: ?Options (null)) !HttpError {
    let file = fs.stream(to_path, fs.OpenOptions { write: fs.WriteMode.truncate, create: true }) !>
    let request_options = isset(options) ? options_with_output(options, file) : Options { timeout_ms: DEFAULT_DOWNLOAD_TIMEOUT_MS, output: file }
    let response = request(method, url, request_options) ! {
        file.close() ! core.cleanup_warning("Failed to close download file", __FILE__, __LINE__)
        fs.delete_file(to_path) _
        throw E
    }
    file.close() ! {
        fs.delete_file(to_path) _
        throw .write
    }
    if response.status < 200 || response.status > 299 {
        fs.delete_file(to_path) _
        throw .status
    }
}

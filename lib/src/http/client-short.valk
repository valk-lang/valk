use time
use url

+ fn create_request(method: String, url: String, options: ?Options (null)) ClientRequest !HttpError {
    if !isset(options) : options = Options {}
    return ClientRequest.create(method, url, options) !>
}

+ fn request(method: String, url: String, options: ?Options (null)) ClientResponse !HttpError {
    let deadline_ms: uint = 0
    let timeout_ms = isset(options) ? options.timeout_ms : DEFAULT_REQUEST_TIMEOUT_MS
    if timeout_ms > 0 : deadline_ms = time.mstime() + timeout_ms
    return request_with_deadline(method, url, options, deadline_ms) !>
}

fn is_redirect(status: uint) bool {
    return status == 301 || status == 302 || status == 303 || status == 307 || status == 308
}

fn normalized_redirect_path(path: String) String {
    let result = Array[String].new()
    each path.split("/") as part {
        if part.length == 0 || part == "." : continue
        if part == ".." {
            if result.length > 0 : result.remove(result.length - 1)
            continue
        }
        result.append(part)
    }
    return "/" + result.join("/")
}

fn redirect_url(from: String, location: String) String {
    let target = url.parse(location)
    if target.scheme.length > 0 : return location

    let base = url.parse(from)
    if location.starts_with("//") : return base.scheme + ":" + location
    let origin = base.scheme + "://" + base.host
    if location.starts_with("/") : return origin + normalized_redirect_path(location)
    if location.starts_with("?") : return origin + base.path + location

    let slash: uint = base.path.bytes
    while slash > 0 {
        slash--
        if base.path.get(slash) == '/' {
            slash++
            break
        }
    }
    return origin + normalized_redirect_path(base.path.part(0, slash) + location)
}

fn url_origin(value: String) String {
    let parsed = url.parse(value)
    let host = parsed.host.lower()
    if parsed.scheme == "http" && host.ends_with(":80") : host = host.part(0, host.bytes - 3)
    else if parsed.scheme == "https" && host.ends_with(":443") : host = host.part(0, host.bytes - 4)
    return parsed.scheme + "://" + host
}

fn redirected_method(method: String, status: uint) String {
    let upper = method.upper()
    if status == 303 && upper != "HEAD" : return "GET"
    if (status == 301 || status == 302) && upper == "POST" : return "GET"
    return method
}

fn redirect_header_is_sensitive(name: String) bool {
    name = name.lower()
    return name == "authorization" || name == "proxy-authorization"
        || name == "cookie" || name == "cookie2"
}

fn redirect_header_describes_body(name: String) bool {
    name = name.lower()
    return name == "content-length" || name == "content-type"
        || name == "content-encoding" || name == "transfer-encoding"
}

fn redirect_options(options: ?Options, cross_origin: bool, drop_body: bool) ?Options {
    if !isset(options) : return null

    let headers: ?Map[String] = null
    let source_headers = options.headers
    if isset(source_headers) {
        headers = Map[String]{}
        each source_headers as value, name {
            let lowered = name.lower()
            if lowered == "host" : continue
            if cross_origin && redirect_header_is_sensitive(lowered) : continue
            if drop_body && redirect_header_describes_body(lowered) : continue
            headers.set(name, value)
        }
    }

    return Options {
        body: drop_body ? "" : options.body
        headers: headers
        output_to_file: options.output_to_file
        follow_redirects: options.follow_redirects
        max_redirects: options.max_redirects
        verify_ssl_cert: options.verify_ssl_cert
        ca_cert: options.ca_cert
        timeout_ms: options.timeout_ms
        connect_timeout_ms: options.connect_timeout_ms
        read_timeout_ms: options.read_timeout_ms
        write_timeout_ms: options.write_timeout_ms
    }
}

fn request_with_deadline(method: String, url: String, options: ?Options, deadline_ms: uint) ClientResponse !HttpError {
    let current_method = method
    let current_url = url
    let current_options = options
    let redirects: uint = 0

    while true {
        let req = ClientRequest.create(current_method, current_url, current_options, deadline_ms) !>
        while (req.progress() !>) {}

        let res = req.response() !>
        if !is_redirect(res.status) : return res

        let follow = !isset(current_options) || current_options.follow_redirects
        if !follow : return res
        let location = res.headers.get("location") !? null
        if !isset(location) : return res

        let max_redirects: uint = isset(current_options) ? current_options.max_redirects : DEFAULT_MAX_REDIRECTS
        if redirects >= max_redirects : throw .too_many_redirects
        redirects++

        let next_url = redirect_url(current_url, location)
        let next_method = redirected_method(current_method, res.status)
        let drop_body = next_method.upper() != current_method.upper()
        current_options = redirect_options(current_options,
            url_origin(current_url) != url_origin(next_url), drop_body)
        current_method = next_method
        current_url = next_url
    }
}

+ fn download(url: String, to_path: String, method: String ("GET"), options: ?Options (null)) !HttpError {
    if !isset(options) : options = Options { timeout_ms: DEFAULT_DOWNLOAD_TIMEOUT_MS }
    options.output_to_file = to_path
    request(method, url, options) !>
}

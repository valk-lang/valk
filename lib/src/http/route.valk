use url


/// A route found by `Router.find`: the handler plus the positions of its `@name` parts.
+ class Route[T] {
    /// The value registered with `Router.add`.
    + handler: T
    -+ args: Array[RouteArg]
    // The position of a `*` part, which takes the rest of the path
    -+ wildcard_at: ?uint (null)

    /// Returns the value of one `@name` part (or `*` for a wildcard part) from `path`, like
    /// `params(path, decode).get(name)` without extracting the other parts.
    ///
    /// Throws `LookupError` when the route has no such part or `path` is shorter than it.
    + fn param(path: String, name: String, decode: bool (true)) String !LookupError {
        if name == "*" {
            let wildcard = this.wildcard_at
            if isset(wildcard) {
                let tail = route_wildcard_value(path, wildcard, decode)
                if isset(tail) : return tail
            }
        }
        let target: uint = 0
        each this.args as arg {
            if arg.name == name : target = arg.i
        }
        if target == 0 : throw .missing
        let raw = route_segment_at(path, target) ?! throw .missing
        return decode ? url.decode_path(raw) : raw
    }

    /// Returns the values of the route's `@name` parts, taken from `path`, and the rest of
    /// the path matched by a `*` part under the name `*`.
    ///
    /// Pass the same path that was given to `Router.find`. Values are percent-decoded, with
    /// a `+` kept as a `+` (like `url.decode_path`); `decode` off gives them as written.
    /// Empty parts are ignored like `Router.find` ignores them, so doubled slashes and a
    /// missing leading `/` do not shift the values; missing parts are left out.
    + fn params(path: String, decode: bool (true)) Map[String] {
        let result = Map[String]{}
        if this.args.length == 0 && !isset(this.wildcard_at) : return result
        let pos: uint = 0
        let arg_idx: uint = 0
        let arg_count = this.args.length
        let wildcard = this.wildcard_at
        let rest_buf: ?ByteBuffer = null
        let i: uint = 0
        let len = path.bytes
        while i < len {
            while i < len && path[i] == '/' : i++
            if i >= len : break
            let end = i + 1
            while end < len && path[end] != '/' : end++
            pos++
            let need_arg = arg_idx < arg_count && this.args[arg_idx].i == pos
            let need_wild = isset(wildcard) && pos >= wildcard
            if need_arg || need_wild {
                let raw = path.range(i, end - i)
                let val = decode ? url.decode_path(raw) : raw
                while arg_idx < arg_count && this.args[arg_idx].i == pos {
                    result.set(this.args[arg_idx].name, val)
                    arg_idx++
                }
                if need_wild {
                    let buf = rest_buf ?? <{
                        let created = ByteBuffer.new(len - i)
                        rest_buf = created
                        return created
                    }
                    if buf.length > 0 : buf.write_byte('/')
                    buf.write(val)
                }
            }
            if arg_idx >= arg_count && !isset(wildcard) : break
            i = end
        }
        if isset(rest_buf) : result.set("*", rest_buf.into_string())
        return result
    }

    /// Returns an independent copy of the route.
    + fn clone() SELF {
        return SELF { handler: clone this.handler, args: this.args.clone(), wildcard_at: this.wildcard_at }
    }
}

fn route_segment_at(path: String, target: uint) ?String {
    let pos: uint = 0
    let i: uint = 0
    let len = path.bytes
    while i < len {
        while i < len && path[i] == '/' : i++
        if i >= len : return null
        let end = i + 1
        while end < len && path[end] != '/' : end++
        pos++
        if pos == target : return path.range(i, end - i)
        i = end
    }
    return null
}

fn route_wildcard_value(path: String, wildcard: uint, decode: bool) ?String {
    let pos: uint = 0
    let i: uint = 0
    let len = path.bytes
    let out: ?ByteBuffer = null
    while i < len {
        while i < len && path[i] == '/' : i++
        if i >= len : break
        let end = i + 1
        while end < len && path[end] != '/' : end++
        pos++
        if pos >= wildcard {
            let raw = path.range(i, end - i)
            let val = decode ? url.decode_path(raw) : raw
            let buf = out ?? <{
                let created = ByteBuffer.new(len - i)
                out = created
                return created
            }
            if buf.length > 0 : buf.write_byte('/')
            buf.write(val)
        }
        i = end
    }
    if isset(out) : return out.into_string()
    return null
}

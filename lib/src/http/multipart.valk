/// A `multipart/form-data` request body with fields and files, for uploads.
///
/// ```valk
/// let form = http.Multipart.new()
/// form.add_field("title", "Holiday")
/// form.add_file("photo", "beach.jpg", fs.read("beach.jpg") !, "image/jpeg")
/// let options = http.Options {}
/// form.apply(options)
/// let res = http.request("POST", "https://example.com/upload", options) !
/// ```
+ class Multipart {
    /// The separator between the parts; random, so it does not occur in them.
    ~ boundary: String
    - parts: ByteBuffer (.new())

    /// Returns an empty form with a random boundary.
    + static fn new() SELF {
        return SELF { boundary: "valk-form-" + String.random(32) }
    }

    /// Adds a text field.
    + fn add_field(name: String, value: String) {
        this.start_part(name, null, null)
        this.parts.write(value)
        this.parts.write("\r\n")
    }

    /// Adds a file with its file name, contents and media type.
    + fn add_file(name: String, filename: String, data: local &[u8], content_type: String ("application/octet-stream")) {
        this.start_part(name, filename, content_type)
        this.parts.write(data)
        this.parts.write("\r\n")
    }

    /// The `Content-Type` header for this form: `multipart/form-data` with its boundary.
    + fn content_type() String {
        return "multipart/form-data; boundary=" + this.boundary
    }

    /// Returns the complete body.
    + fn body() String {
        let out = ByteBuffer.new(this.parts.length + this.boundary.bytes + 8)
        out.write(this.parts)
        out.write("--")
        out.write(this.boundary)
        out.write("--\r\n")
        return out.into_string()
    }

    /// Sets `options.body` to this form and its `Content-Type` header.
    + fn apply(options: Options) {
        options.body = this.body()
        options.set_header("Content-Type", this.content_type())
    }

    - fn start_part(name: String, filename: ?String, content_type: ?String) {
        let out = this.parts
        out.write("--")
        out.write(this.boundary)
        out.write("\r\nContent-Disposition: form-data; name=\"")
        out.write(multipart_quote(name))
        out.write("\"")
        if isset(filename) {
            out.write("; filename=\"")
            out.write(multipart_quote(filename))
            out.write("\"")
        }
        out.write("\r\n")
        if isset(content_type) {
            out.write("Content-Type: ")
            out.write(multipart_quote(content_type))
            out.write("\r\n")
        }
        out.write("\r\n")
    }
}

// A name or file name inside double quotes, escaped the way browsers do
fn multipart_quote(value: String) String {
    if !value.contains_byte('"') && !value.contains_byte('\r') && !value.contains_byte('\n') : return value
    return value.replace("\"", "%22").replace("\r", "%0D").replace("\n", "%0A")
}

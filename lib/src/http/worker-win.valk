#if OS == "win"
use core
use coro
use io
use net
use ext
use time

// Only unassociated descriptors cross threads. Each inbox has one consumer.
class WorkerInbox {
    mutex: shared core.SyncMutex (.new())
    sockets: Array[Fd] (.new())
    closed: bool (false)
    waiter: ?ptr (null)
    port: ext.HANDLE (0)

    fn wake() @shared_unsafe {
        @unsafe
        let waiter = this.waiter
        if !isset(waiter) : return
        this.waiter = null
        if !io.wake_coro(this.port, waiter) : panic("Failed to wake HTTP worker")
    }

    fn push(fd: Fd) bool @shared_unsafe {
        this.mutex.lock()
        if this.closed || this.sockets.length >= 128 {
            this.mutex.unlock()
            return false
        }
        this.sockets.append(fd)
        this.wake()
        this.mutex.unlock()
        return true
    }

    fn pop() ?Fd @shared_unsafe {
        @unsafe
        let current = coro.current_coro
        if !isset(current) : panic("Receiving HTTP connections outside a coroutine")
        while true {
            this.mutex.lock()
            let fd: ?Fd = this.sockets.pop_first() !? null
            if isset(fd) || this.closed {
                this.mutex.unlock()
                return fd
            }
            this.port = io.iocp()
            this.waiter = current.@cast(ptr)
            current.iocp_ready = false
            this.mutex.unlock()
            current.yield()
        }
        return null
    }

    fn close() @shared_unsafe {
        this.mutex.lock()
        this.closed = true
        this.wake()
        this.mutex.unlock()
    }
}

extend Worker {
    fn receive_windows(fd: Fd) {
        if this.server.stopping != 0 || !io.associate(fd) {
            net.Socket.close_fd_cleanup(fd, __FILE__, __LINE__)
            return
        }
        let connection = net.Connection.new(fd) ! return
        this.handle(connection)
    }

    fn accept_windows() {
        let server = this.server
        let count = server.inboxes.length
        let next: uint = count > 1 ? 1 : 0
        while server.stopping == 0 {
            let fd = server.socket.accept_fd(ACCEPT_POLL_MS) ! {
                if server.stopping != 0 : break
                if error_is(E.code, timeout) : continue
                if error_is(E.code, max_connections) {
                    time.sleep_ms(100)
                    continue
                }
                #if TEST
                panic("HTTP Server failed to accept a connection")
                #else
                println("[x] Failed to accept")
                continue
                #end
            }
            if server.stopping != 0 {
                net.Socket.close_fd_cleanup(fd, __FILE__, __LINE__)
                break
            }
            let destination = next
            next = (next + 1) % count
            if destination == 0 {
                this.receive_windows(fd)
            } else {
                let inbox = server.inboxes.get(destination) !!
                if !inbox.push(fd) : net.Socket.close_fd_cleanup(fd, __FILE__, __LINE__)
            }
        }
        server.socket.close() ! core.cleanup_warning("Failed to close HTTP listener", __FILE__, __LINE__)
        each server.inboxes as inbox : inbox.close()
    }
}
#end


use net

value DEFAULT_MAX_REDIRECTS (10)
value DEFAULT_REQUEST_TIMEOUT_MS (10_000)
value DEFAULT_DOWNLOAD_TIMEOUT_MS (30_000)
value DEFAULT_MAX_RESPONSE_HEADER_SIZE (8 * 1024)
value DEFAULT_MAX_RESPONSE_BODY_SIZE (32 * 1024 * 1024)

+ class Options {
    + body: String ("")
    + query_data: ?Map[String]
    + headers: ?Map[String]
    + output_to_file: ?String
    + follow_redirects: bool (true)
    + max_redirects: uint (DEFAULT_MAX_REDIRECTS)
    + verify_ssl_cert: bool (true)
    + ca_cert_path: ?String
    + certificate_sha256: ?String
    + min_tls_version: net.TlsVersion (net.TlsVersion.tls_1_2)
    + max_tls_version: ?net.TlsVersion
    + tls_cipher_list: ?String
    + tls_cipher_suites: ?String
    + alpn_protocols: ?Array[String]
    // A zero total timeout leaves the overall request unlimited. Individual
    // network operations still use their five-second defaults.
    + timeout_ms: uint (DEFAULT_REQUEST_TIMEOUT_MS)
    + connect_timeout_ms: uint (5000)
    + read_timeout_ms: uint (5000)
    + write_timeout_ms: uint (5000)
    // Zero disables the corresponding response limit.
    + max_response_header_size: uint (DEFAULT_MAX_RESPONSE_HEADER_SIZE)
    + max_response_body_size: uint (DEFAULT_MAX_RESPONSE_BODY_SIZE)

    //////////////////////////////
    // Configure headers
    //////////////////////////////

    + fn get_headers() Map[String] {
        let hh = this.headers
        if !isset(hh) {
            hh = Map[String]{}
            this.headers = hh
            return hh
        }
        return hh
    }
    + fn set_header(key: String, value: String) SELF {
        let hh = this.get_headers()
        hh.set(key, value)
        return this
    }
    + fn set_headers(headers: Map[String]) SELF {
        each headers as v, k : this.set_header(k, v)
        return this
    }
    + fn clear_headers() SELF {
        let hh = this.headers
        if isset(hh) : hh.clear()
        return this
    }

}

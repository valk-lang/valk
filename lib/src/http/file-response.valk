use time
use fs

// Files up to this size are gzip-compressed in memory when `Server.compress` is on
value GZIP_MAX_FILE_SIZE (1024 * 1024)

// How a file response answers the request's conditional, range and encoding headers
class FilePlan {
    // 200, 206 (a range), 304 (the client's copy is current) or 416 (a range past the end)
    status: u16 (200)
    // The part of the file to send
    start: uint (0)
    length: uint (0)
    size: uint (0)
    etag: String ("")
    last_modified: String ("")
    // Send the whole file gzip-compressed in memory
    gzip: bool (false)
    // Pre-compressed sidecar encoding ("br" or "gzip"), "" when none
    encoding: String ("")
    // The response varies by Accept-Encoding
    vary: bool (false)
}

// Decides a file response. The header values are empty when the request has none.
fn file_plan(size: uint, modified_ns: uint, content_type: String, compress: bool, if_none_match: String,
    if_modified_since: String, range: String, if_range: String, accept_encoding: String) FilePlan {
    let modified = (modified_ns / 1_000_000_000).to(int)
    let base_etag = "\"" + size + "-" + modified_ns + "\""
    let gzip_etag = "\"" + size + "-" + modified_ns + "-gzip\""
    let br_etag = "\"" + size + "-" + modified_ns + "-br\""
    let plan = FilePlan {
        length: size
        size: size
        etag: base_etag
        last_modified: format_date(time.DateTime.from_unix_seconds(modified) !? time.DateTime.now())
    }
    let compressible_type = compress && response_gzip_type(content_type)
    let compressible = compressible_type && size >= GZIP_MIN_SIZE && size <= GZIP_MAX_FILE_SIZE
    plan.vary = compressible
    let gzip = compressible && request_accepts_gzip(accept_encoding)
    if gzip : plan.etag = gzip_etag

    // If-None-Match decides alone when present, If-Modified-Since otherwise (RFC 9110 13.2.2)
    if if_none_match.bytes > 0 {
        if etag_list_matches(if_none_match, base_etag) || etag_list_matches(if_none_match, gzip_etag) || etag_list_matches(if_none_match, br_etag) {
            plan.status = 304
            plan.length = 0
            return plan
        }
    } else if if_modified_since.bytes > 0 {
        let since = parse_date(if_modified_since) !? null
        if isset(since) && modified <= since.unix_seconds() {
            plan.status = 304
            plan.length = 0
            return plan
        }
    }

    // One range of bytes; a list of ranges gets the whole file, and so does an If-Range
    // that names another version
    if range.starts_with("bytes=") && !range.contains(",") && (if_range.bytes == 0 || if_range == plan.last_modified || if_range == base_etag) {
        let spec = range.range(6, range.bytes - 6).trim()
        let dash = spec.index_of_byte('-') !? null
        if isset(dash) {
            let first = spec.range(0, dash)
            let last = spec.range(dash + 1, spec.bytes - dash - 1)
            let start: ?uint = null
            let end = size == 0 ? 0 : size - 1
            if first.bytes == 0 {
                // The last `n` bytes
                let n = last.to_uint() !? 0
                if n > 0 && size > 0 : start = n >= size ? 0 : size - n
            } else {
                let from = first.to_uint() !? null
                if isset(from) {
                    start = from
                    if last.bytes > 0 {
                        let to = last.to_uint() !? null
                        if !isset(to) || to < from : start = null
                        else if to < end : end = to
                    }
                }
            }
            if isset(start) {
                if start >= size {
                    plan.status = 416
                    plan.length = 0
                    return plan
                }
                plan.status = 206
                plan.start = start
                plan.length = end - start + 1
                plan.etag = base_etag
                return plan
            }
        }
    }
    plan.gzip = gzip
    return plan
}

// Whether an If-None-Match value (`*` or a list of entity tags) names `etag`, compared
// without the weak marks
fn etag_list_matches(value: String, etag: String) bool {
    let wanted = etag.starts_with("W/") ? etag.range(2, etag.bytes - 2) : etag
    each value.split(",") as item {
        let tag = item.trim()
        if tag == "*" : return true
        if tag.starts_with("W/") : tag = tag.range(2, tag.bytes - 2)
        if tag == wanted : return true
    }
    return false
}

// Opens a pre-compressed `.br` or `.gz` sidecar next to `path` when the client accepts it
fn open_precompressed_sidecar(path: String, info: fs.FileInfo, content_type: String, compress: bool, accept_encoding: String, plan: FilePlan) ?fs.FileStream {
    if !compress || plan.status != 200 || !response_gzip_type(content_type) : return null
    if request_accepts_br(accept_encoding) {
        let br_path = path + ".br"
        let br_info = fs.stat(br_path) !? null
        if isset(br_info) && br_info.kind == fs.FileKind.file {
            let stream = fs.stream(br_path) !? null
            if isset(stream) {
                plan.gzip = false
                plan.encoding = "br"
                plan.vary = true
                plan.length = br_info.size
                plan.etag = "\"" + info.size + "-" + info.modified_time + "-br\""
                return stream
            }
        }
    }
    if request_accepts_gzip(accept_encoding) {
        let gz_path = path + ".gz"
        let gz_info = fs.stat(gz_path) !? null
        if isset(gz_info) && gz_info.kind == fs.FileKind.file {
            let stream = fs.stream(gz_path) !? null
            if isset(stream) {
                plan.gzip = false
                plan.encoding = "gzip"
                plan.vary = true
                plan.length = gz_info.size
                plan.etag = "\"" + info.size + "-" + info.modified_time + "-gzip\""
                return stream
            }
        }
    }
    if fs.is_file(path + ".br") || fs.is_file(path + ".gz") : plan.vary = true
    return null
}

#if TEST
/// Test hook, only in `TEST` builds: `file_plan` as text: `status start length etag gzip`.
+ fn file_plan_for_test(size: uint, modified_ns: uint, content_type: String, compress: bool, if_none_match: String,
    if_modified_since: String, range: String, if_range: String, accept_encoding: String) String {
    let plan = file_plan(size, modified_ns, content_type, compress, if_none_match, if_modified_since, range, if_range, accept_encoding)
    return "" + plan.status + " " + plan.start + " " + plan.length + " " + plan.etag + " " + plan.gzip
}
#end

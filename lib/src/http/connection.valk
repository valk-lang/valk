
use net
use fs
use core

value READ_SIZE (32000)

+ class Connection {
    ~+ worker: Worker
    ~+ netcon: net.Connection
    ~+ fd: Fd
    - reserved_body_size: uint (0)
    active: bool (false)
    rejected: bool (false)
    prev: ?Connection
    next: ?Connection
    h2: ?H2Connection

    fn handle() {
        // Settings
        let worker = this.worker
        let server = worker.server

        let handler = server.handler
        let fast_handler = server.fast_handler

        let tls_context = server.tls_context
        if isset(tls_context) {
            this.netcon.ssl_accept(tls_context, server.header_timeout_ms) ! {
                this.finish()
                return
            }
        }

        let ssl = this.netcon.ssl
        if server.http2 && isset(ssl) && ssl.selected_alpn() == "h2" {
            let connection = H2Connection.new(this) ! {
                this.finish()
                return
            }
            this.h2 = connection
            connection.run()
            this.h2 = null
            this.finish()
            return
        }

        let input = ByteBuffer.new(2048)
        let context = Context.new(input)
        let res = ResponseWriter {}

        if this.rejected {
            this.send_error(503, res)
            this.finish()
            return
        }

        while true {
            if server.stopping != 0 && !this.active {
                this.active = true
                res.send_bytes(this.netcon) ! {}
                break
            }
            parse_http(input, context, false, server.max_request_header_size, server.max_request_body_size) ! {
                // Check if we need more data
                if E.code == E.incomplete {
                    if !this.reserve_body(context) {
                        this.send_error(503, res)
                        break
                    }
                    let bytes = this.read_more(input, context) ! break
                    if bytes == 0 : break
                    continue
                } else if E.code == E.http413 {
                    this.send_error(413, res)
                } else if E.code == E.not_implemented {
                    this.send_error(501, res)
                } else {
                    this.send_error(400, res)
                }
                // Stop connection
                break
            }

            if !this.reserve_body(context) {
                this.send_error(503, res)
                break
            }

            // Handle request
            this.active = true
            // Draining: this response is the last one on the connection
            res.close = server.stopping != 0

            // Check static dirs
            let is_file = false
            if isset(server.static_dirs) && context.path.length > 0 {
                let path = context.path.to_string()
                if !path.contains("..") {
                    let static_dir = server.static_dirs
                    while isset(static_dir) {
                        let dir = static_dir.path
                        let fullpath = fs.resolve(fs.add(dir, path))
                        if fs.is_file(fullpath) && fullpath.starts_with(dir) {
                            res.send_file(fullpath)
                            is_file = true
                            break
                        }
                        static_dir = static_dir.next
                    }
                }
            }

            // Response
            if !is_file {
                if isset(fast_handler) {
                    fast_handler(context, res)
                    if !res.responded {
                        this.send_error(400, res)
                    }
                } else {
                    let request = Request {
                        method: context.method.to_string()
                        path: context.path.to_string()
                        header_data: context.header_data.to_string()
                        query_string: context.query_string.to_string()
                        body_data: context.body
                    }
                    let resp = handler(request)
                    res.send_response(resp)
                }
            }

            // Reset
            this.release_body()
            context.reset()

            // Clear input
            let reached_end = context.parsed_index >= input.length
            if reached_end {
                input.clear()
                input.shrink_capacity(READ_SIZE + 1024)
                context.parsed_index = 0
            } else if context.parsed_index > 1024 {
                input.clear_until(context.parsed_index)
                context.parsed_index = 0
                input.shrink_capacity(READ_SIZE + 1024)
            }

            // Flush output
            if res.should_send() || reached_end || server.stopping != 0 {
                res.send_bytes(this.netcon) ! break
                res.reset()
            }
            //
            res.allow_new_response()
            this.active = false
        }

        res.reset()
        context.reset()
        input.clear()

        this.finish()
    }

    fn finish() {
        this.release_body()
        this.close()
        this.worker.remove_client(this)
        // A rejected connection returned its slot when it was accepted
        if !this.rejected : this.worker.server.connections--
    }

    fn read_more(buffer: ByteBuffer, request: Context) uint !net.NetError {
        let settings = this.worker.server
        if request.stage >= 2 {
            this.netcon.read_timeout_ms = settings.body_timeout_ms
        } else if buffer.length == 0 {
            this.netcon.read_timeout_ms = settings.idle_timeout_ms
        } else {
            this.netcon.read_timeout_ms = settings.header_timeout_ms
        }
        // Read straight into the spare capacity instead of through a bounce buffer
        buffer.reserve(READ_SIZE)
        let bytes = this.netcon.read(buffer.storage.view(buffer.length, READ_SIZE)) !>
        if settings.stopping != 0 && !this.active : throw .closed
        if bytes > 0 : this.active = true
        buffer.advance(bytes)
        return bytes
    }

    fn send_error(code: uint, res: ResponseWriter) {
        // Every error response is followed by closing the connection
        res.close = true
        res.send_status(code)
        res.send_bytes(this.netcon) ! {
            return
        }
    }

    fn reserve_body(context: Context) bool {
        let expected = context.body_expected
        if expected <= this.reserved_body_size : return true

        let server = this.worker.server
        let added = expected - this.reserved_body_size
        let limit = server.max_server_wide_body_size
        if limit > 0 && expected > limit : return false
        server.active_body_size += added
        let active = server.active_body_size
        if active < added || (limit > 0 && active > limit) {
            server.active_body_size -= added
            return false
        }
        this.reserved_body_size = expected
        return true
    }

    fn release_body() {
        if this.reserved_body_size == 0 : return
        this.worker.server.active_body_size -= this.reserved_body_size
        this.reserved_body_size = 0
    }

    + fn close() {
        this.netcon.close() ! core.cleanup_warning("Failed to close HTTP connection", __FILE__, __LINE__)
    }
}

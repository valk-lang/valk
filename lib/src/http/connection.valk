
use ext
use net
use fs

value READ_SIZE (32000)

+ class Connection {
    ~+ worker: Worker
    ~+ netcon: net:Connection
    ~+ fd: FD

    fn handle() {
        // Settings
        let worker = this.worker
        let server = worker.server

        let handler = server.handler
        let fast_handler = server.fast_handler

        let input = ByteBuffer.new(2048)
        let context = Context.new(input)
        let res = ResponseWriter {}

        while true {
            parse_http(input, context, false) ! {
                // Check if we need more data
                if E.code == E.incomplete {
                    let bytes = this.read_more(input, context) ! break
                    if bytes > 0 : continue
                } else if E.code == E.http413 {
                    this.send_error(413, res)
                } else {
                    this.send_error(400, res)
                }
                // Stop connection
                break
            }

            // Handle request

            // Check static dirs
            let is_file = false
            if isset(server.static_dirs) && context.path.length > 0 {
                let path : String = context.path
                if !path.contains("..") {
                    let static_dir = server.static_dirs
                    while isset(static_dir) {
                        let dir = static_dir.path
                        let fullpath : String = fs:resolve(fs:add(dir, path))
                        if fs:is_file(fullpath) && fullpath.starts_with(dir) {
                            res.send_file(fullpath)
                            is_file = true
                            break
                        }
                        static_dir = static_dir.next
                    }
                }
            }

            // Response
            if !is_file {
                if isset(fast_handler) {
                    fast_handler(context, res)
                    if !res.responded {
                        this.send_error(400, res)
                    }
                } else {
                    let request = Request {
                        method: context.method
                        path: context.path
                        header_data: context.header_data
                        query_string: context.query_string
                        body_data: context.body
                    }
                    let resp = handler(request)
                    res.send_response(resp)
                }
            }

            // Reset
            context.reset()

            // Clear input
            let reached_end = context.parsed_index >= input.length
            if reached_end {
                input.clear()
                input.reduce_size(READ_SIZE + 1024)
                context.parsed_index = 0
            } else if context.parsed_index > 1024 {
                input.clear_until(context.parsed_index)
                context.parsed_index = 0
                input.reduce_size(READ_SIZE + 1024)
            }

            // Flush output
            if res.should_send() || reached_end {
                res.send_bytes(this.netcon) ! break
                res.reset()
            }
            //
            res.allow_new_response()
        }

        res.reset()
        context.reset()
        input.clear()

        this.close()
        worker.connections--
    }

    fn read_more(buffer: ByteBuffer, request: Context) uint !net:NetError {
        let settings = this.worker.server
        if request.stage >= 2 {
            this.netcon.read_timeout_ms = settings.body_timeout_ms
        } else if buffer.length == 0 {
            this.netcon.read_timeout_ms = settings.idle_timeout_ms
        } else {
            this.netcon.read_timeout_ms = settings.header_timeout_ms
        }
        let bytes = this.netcon.recv(buffer, READ_SIZE) !>
        return bytes
    }

    fn send_error(code: uint, res: ResponseWriter) {
        res.send_status(code)
        res.send_bytes(this.netcon) ! {
            return
        }
    }

    + fn close() {
        this.netcon.close()
    }
}


use net
use fs
use core
use time

// Bodies are read in pieces of this size
value READ_SIZE (32000)
// Request heads are read into a buffer of this size, which is all an idle connection holds
value HEAD_READ_SIZE (2048)
// The buffer storage a parked connection keeps: the smallest a ByteBuffer has
value PARKED_BUFFER_SIZE (32)
// The first read after a pause: most request heads fit, and a read that fills it doubles the next
value WOKEN_READ_SIZE (512)
// Spare buffers a worker keeps per kind for the connections that wake
value SPARE_BUFFERS (4096)
// A connection parks between requests once the client paused at least this long before
// its last request; clients that keep requests coming stay on their coroutine
value PARK_GAP_MS (5)

/// One accepted client connection of a `Server`, served on a coroutine while a request is
/// in flight. On Linux a plain connection waiting for its next request holds no coroutine:
/// it is parked in the worker's epoll set and served again when data arrives.
///
/// The server creates and manages these; handlers never receive one.
class Connection {
    /// The server worker that accepted the connection.
    ~+ worker: Worker
    /// The underlying socket connection.
    ~+ netcon: net.TcpConnection
    /// The socket's file descriptor.
    ~+ fd: Fd
    /// The client's address, read once when the connection is accepted.
    ~+ peer_address: net.SocketAddress (.{})
    // The certificate the client sent over TLS, see `Request.client_subject`
    ~+ client_subject: String ("")
    ~+ client_certificate_sha256: String ("")
    - reserved_body_size: uint (0)
    // The request bytes received so far, the parse state and the response under construction
    input: ByteBuffer
    context: Context
    res: ResponseWriter (ResponseWriter {})
    // When the current request head started arriving (`time.mono_ms`), 0 between requests
    head_started: uint (0)
    // When the read in progress, or the parked wait, must have ended (`Worker.now` time), 0 for none
    deadline_ms: uint (0)
    // The response writer holds an answer that `read_more` sends before it reads
    answer_pending: bool (false)
    // Since when the connection waits for its next request (`time.mono_ms`), 0 while busy
    idle_since: uint (0)
    // How long the client paused before its last request; unknown until the second one
    last_gap_ms: uint (uint.$max)
    // A request was answered on this connection: the wait before the next one is a client pause
    served: bool (false)
    // Waiting for its next request in the worker's epoll set, without a coroutine
    parked: bool (false)
    // Taken out of the epoll set by the worker: `serve` starts with a read
    woken: bool (false)
    // Registered in the worker's epoll set (parked at least once)
    polled: bool (false)
    // Which of the worker's lists holds it
    in_parked_list: bool (false)
    // How much a read of request heads asks for: doubles while reads fill it (pipelining,
    // large heads), back to WOKEN_READ_SIZE when the connection parks
    read_size: uint (HEAD_READ_SIZE)
    active: bool (false)
    rejected: bool (false)
    prev: ?Connection
    next: ?Connection
    h2: ?H2Connection

    fn handle() {
        // Settings
        let worker = this.worker
        let server = worker.server

        let tls_context = server.tls_context
        if isset(tls_context) {
            this.netcon.ssl_accept(tls_context, server.header_timeout_ms) ! {
                this.finish()
                return
            }
            let accepted = this.netcon.ssl
            if isset(accepted) {
                this.client_subject = accepted.peer_certificate_subject() !? ""
                this.client_certificate_sha256 = accepted.peer_certificate_sha256() !? ""
            }
        }

        let ssl = this.netcon.ssl
        if server.http2 && isset(ssl) && ssl.selected_alpn() == "h2" {
            let connection = H2Connection.new(this) ! {
                this.finish()
                return
            }
            this.h2 = connection
            connection.run()
            this.h2 = null
            this.finish()
            return
        }

        let context = this.context
        this.peer_address = this.netcon.peer_address() !? net.SocketAddress {}
        context.peer_address = this.peer_address
        let res = this.res
        res.compress = server.compress
        res.compress_level = server.compress_level
        res.websocket_compression = server.websocket_compression
        res.stop = server.stop

        if this.rejected {
            this.send_error(503, res)
            this.finish()
            return
        }

        this.serve()
    }

    // Serves requests until the connection ends, or until it parks between two requests;
    // the worker calls it again when data arrives for a parked connection
    fn serve() {
        let worker = this.worker
        let server = worker.server
        let handler = server.handler
        let fast_handler = server.fast_handler
        let input = this.input
        let context = this.context
        let res = this.res
        // The output buffer given away while parked
        worker.take_buffer(res.output_buffer(), worker.spare_outputs, OUTPUT_SMALL_SIZE)

        if this.woken {
            // Woken by the worker: the next request, or the end of the connection, is readable
            let bytes = this.read_more(input, context, res) ! {
                this.finish()
                return
            }
            if bytes == 0 {
                this.finish()
                return
            }
        }

        while true {
            if server.stopping != 0 && !this.active {
                this.active = true
                res.send_bytes(this.netcon) ! {}
                break
            }
            parse_http(input, context, false, server.max_request_header_size, server.max_request_body_size) ! {
                // Check if we need more data
                if E.code == E.incomplete {
                    if !this.reserve_body(context) {
                        this.send_error(503, res)
                        break
                    }
                    // Headers are in and the body is still to come: a client that asked
                    // for it gets the go-ahead now instead of waiting out its timeout
                    if context.stage == 2 && context.expect_continue && !context.continue_sent && !context.http10 {
                        context.continue_sent = true
                        this.netcon.write("HTTP/1.1 100 Continue\r\n\r\n") ! break
                    }
                    // Between two requests: wait without a coroutine where the worker can
                    if input.length == 0 && this.can_park() {
                        if this.answer_pending {
                            this.answer_pending = false
                            res.send_bytes(this.netcon) ! break
                            res.reset()
                        }
                        if this.park() : return
                    }
                    let bytes = this.read_more(input, context, res) ! break
                    if bytes == 0 : break
                    continue
                } else if E.code == E.http413 {
                    this.send_error(413, res)
                } else if E.code == E.http431 {
                    this.send_error(431, res)
                } else if E.code == E.not_implemented {
                    this.send_error(501, res)
                } else {
                    this.send_error(400, res)
                }
                // Stop connection
                break
            }

            if !this.reserve_body(context) {
                this.send_error(503, res)
                break
            }

            // Handle request
            this.active = true
            this.head_started = 0
            // Last response on the connection when draining or when the client
            // asked for it (any HTTP/1.0 request that did not ask to keep it)
            let keep_alive = context.keep_alive
            res.close = server.stopping != 0 || !keep_alive
            res.keep_alive = context.http10 && !res.close
            // A HEAD response carries the head of the GET response, never its body
            res.head = context.method.equals("HEAD")
            res.request_context = context

            // Check static dirs
            let is_file = false
            if isset(server.static_dirs) && context.path.length > 0 {
                let found = static_file(server.static_dirs, context.path.to_string())
                if isset(found) {
                    if found.redirect : res.send_response(Response.redirect(static_redirect_location(context.path.to_string(), context.query_string.to_string()), 301))
                    else : res.send_file(found.path)
                    is_file = true
                }
            }

            // Response
            if !is_file {
                if isset(fast_handler) {
                    fast_handler(context, res)
                    if !res.responded {
                        this.send_error(400, res)
                    }
                } else {
                    let request = Request {
                        method: context.method.to_string()
                        path: context.path.to_string()
                        header_data: context.header_data.to_string()
                        query_string: context.query_string.to_string()
                        body_data: context.body
                        peer_address: this.peer_address
                        client_subject: this.client_subject
                        client_certificate_sha256: this.client_certificate_sha256
                    }
                    let resp = handler(request)
                    res.send_response(resp)
                }
            }

            // A WebSocket upgrade hands the socket to its handler until it returns
            let ws_handler = res.websocket_handler
            if isset(ws_handler) {
                res.websocket_handler = null
                res.send_bytes(this.netcon) ! break
                let deflate_bits = res.websocket_deflate_bits
                let protocol = res.websocket_protocol
                res.reset()
                let leftover = context.parsed_index
                let socket = WebSocket.from_server(this.netcon, input.view(leftover, input.length - leftover), deflate_bits, protocol)
                socket.deflate_level = server.websocket_compression_level
                socket.deflate_min_size = server.websocket_compression_min_size
                this.release_body()
                context.reset()
                input.clear()
                // Not "active": a shutdown interrupts the socket, which ends the handler
                this.active = false
                ws_handler(socket)
                socket.abandon()
                break
            }

            // Reset
            this.release_body()
            context.reset()

            // Clear input
            let reached_end = context.parsed_index >= input.length
            if reached_end {
                input.clear()
                input.shrink_capacity(this.read_size)
                context.parsed_index = 0
            } else if context.parsed_index > 1024 {
                input.clear_until(context.parsed_index)
                context.parsed_index = 0
                input.shrink_capacity(this.read_size)
            }

            // Flush output. A small answer to everything the client sent goes out with the
            // read of its next request (`read_more`)
            if res.should_send() || reached_end || res.close {
                if reached_end && !res.close && res.can_send_with_read() {
                    this.answer_pending = true
                } else {
                    res.send_bytes(this.netcon) ! break
                    res.reset()
                }
            }
            if res.close : break
            //
            res.allow_new_response()
            this.active = false
            this.served = true
        }

        res.reset()
        context.reset()
        input.clear()

        this.finish()
    }

    // Whether the wait for the next request can happen without a coroutine: a plain
    // connection on a worker with an epoll set, while the server runs
    fn can_park() bool {
        #if OS == "linux"
        return this.last_gap_ms >= PARK_GAP_MS && !isset(this.netcon.ssl) && this.worker.server.stopping == 0 && this.worker.epoll_fd >= 0
        #else
        return false
        #end
    }

    // Parks the connection in the worker's epoll set; the coroutine then returns. False when
    // the set refused the descriptor, so the caller reads with the coroutine instead
    fn park() bool {
        let worker = this.worker
        let now = time.mono_ms()
        worker.now = now
        this.head_started = 0
        this.idle_since = now
        let timeout = worker.server.idle_timeout_ms
        this.deadline_ms = timeout == 0 ? 0 : now.checked_add(timeout) !? uint.$max
        this.active = false
        this.parked = true
        // The next request gets new input storage of its own: views a handler kept of this one
        // must never show another connection's request, so input storage is not shared
        this.read_size = WOKEN_READ_SIZE
        this.input.shrink_capacity(PARKED_BUFFER_SIZE)
        if worker.park(this) {
            // The output buffer, which no view outside the server reads, goes to the worker for
            // the connections that wake
            worker.give_buffer(this.res.output_buffer(), worker.spare_outputs)
            return true
        }
        this.parked = false
        this.deadline_ms = 0
        this.idle_since = 0
        return false
    }

    fn finish() {
        this.release_body()
        this.close()
        this.worker.remove_client(this)
        // A rejected connection returned its slot when it was accepted
        if !this.rejected : this.worker.server.connections--
    }

    fn read_more(buffer: ByteBuffer, request: Context, res: ResponseWriter) uint !net.NetError {
        let worker = this.worker
        let settings = worker.server
        // Not the worker clock: a pause since its tick would make the deadline early
        let now = time.mono_ms()
        worker.now = now
        let timeout: uint = 0
        // Heads are read into the small buffer; a body in pieces of READ_SIZE, or what is
        // left of it when its length is known. An idle connection then holds the small buffer
        let size: uint = this.read_size
        if request.stage >= 2 {
            this.head_started = 0
            timeout = settings.body_timeout_ms
            size = READ_SIZE
            if request.has_content_length && !request.chunked && request.content_length > request.body_received {
                let left = request.content_length - request.body_received
                if left < size : size = left > HEAD_READ_SIZE ? left : HEAD_READ_SIZE
            }
        } else if buffer.length == 0 {
            this.head_started = 0
            if this.woken {
                // Data is readable already: not a client pause, so no gap is measured from it
                this.woken = false
                timeout = settings.header_timeout_ms
            } else {
                this.idle_since = now
                timeout = settings.idle_timeout_ms
            }
        } else {
            // The whole head must arrive in time, not each read of it, or a client that
            // trickles bytes keeps the connection forever
            let limit = settings.header_timeout_ms
            if this.head_started == 0 : this.head_started = now
            let spent = now - this.head_started
            if limit > 0 && spent >= limit : throw .timeout
            timeout = limit == 0 ? 0 : limit - spent
        }
        this.deadline_ms = timeout == 0 ? 0 : now.checked_add(timeout) !? uint.$max
        // Read straight into the spare capacity instead of through a bounce buffer
        buffer.reserve(size)
        let bytes: uint = 0
        if this.answer_pending {
            this.answer_pending = false
            bytes = this.netcon.write_then_read(res.unsent_output(), buffer.view_spare(size)) ! {
                this.deadline_ms = 0
                this.idle_since = 0
                throw E
            }
            res.reset()
        } else {
            bytes = this.netcon.read(buffer.view_spare(size)) ! {
                this.deadline_ms = 0
                this.idle_since = 0
                throw E
            }
        }
        this.deadline_ms = 0
        if this.idle_since > 0 {
            if bytes > 0 && this.served : this.last_gap_ms = time.mono_ms() - this.idle_since
            this.idle_since = 0
        }
        // A read that filled its room: the client sends more at once, so ask for more next time
        if bytes == size && request.stage < 2 && this.read_size < READ_SIZE {
            this.read_size = this.read_size * 2 > READ_SIZE ? READ_SIZE : this.read_size * 2
        }
        if settings.stopping != 0 && !this.active : throw .closed
        if bytes > 0 : this.active = true
        buffer.skip(bytes)
        return bytes
    }

    fn send_error(code: u16, res: ResponseWriter) {
        // Every error response is followed by closing the connection
        res.close = true
        res.head = false
        res.send_status(code)
        res.send_bytes(this.netcon) ! {
            return
        }
    }

    fn reserve_body(context: Context) bool {
        let expected = context.body_expected
        if expected <= this.reserved_body_size : return true

        let server = this.worker.server
        let added = expected - this.reserved_body_size
        let limit = server.max_server_wide_body_size
        if limit > 0 && expected > limit : return false
        server.active_body_size += added
        let active = server.active_body_size
        if active < added || (limit > 0 && active > limit) {
            server.active_body_size -= added
            return false
        }
        this.reserved_body_size = expected
        return true
    }

    fn release_body() {
        if this.reserved_body_size == 0 : return
        this.worker.server.active_body_size -= this.reserved_body_size
        this.reserved_body_size = 0
    }

    /// Closes the socket; a failure to close only prints a warning.
    + fn close() {
        this.netcon.close() ! core.cleanup_warning("Failed to close HTTP connection", __FILE__, __LINE__)
    }
}

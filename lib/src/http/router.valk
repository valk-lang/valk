
class RouteBlock[T] {
    route: ?Route[T] (null)
    keys: Array[String] (.{})
    children: Array[RouteBlock[T]] (.{})
    param_block: ?RouteBlock[T] (null)
    wildcard_block: ?RouteBlock[T] (null)

    fn get_literal(part: local &[u8]) ?RouteBlock[T] {
        each this.keys as key, i {
            if part.equals(key) : return this.children.get(i) !? null
        }
        return null
    }

    fn ensure_literal(key: String) RouteBlock[T] {
        each this.keys as existing, i {
            if existing == key : return this.children.get(i) !!
        }
        let created = RouteBlock[T]{}
        this.keys.append(key)
        this.children.append(created)
        return created
    }
}

class RouteArg {
    name: String
    i: uint
}

/// A router error.
///
/// - `invalid`: not raised by the standard library.
error RouteError (invalid)

/// Maps a method and a URL path to a handler of type `T`.
///
/// Patterns are split on `/`. A part `@name` matches any single part and is returned
/// by `Route.params`; a part `*` matches one or more remaining parts, returned as `*`.
/// When several patterns match, a literal part is preferred over `@name`, and `@name`
/// over `*`. When no route matches a request's method, `allowed_methods` tells whether
/// the path exists for others, for a 405 answer.
///
/// ```valk
/// let router = http.Router[fn(http.Request)(http.Response)].new()
/// router.add("GET", "/users/@id", show_user)
/// let route = router.find(req.method, req.path) ! return http.Response.empty(404)
/// let id = route.param(req.path, "id") !? ""
/// ```
+ class Router[T] {
    - block: RouteBlock[T]
    - inited: bool (false)

    /// Creates an empty router; also backs `Router[T]{}` and default construction.
    + static fn new() SELF $default {
        return SELF {
            block: RouteBlock[T]{}
        }
    }

    /// Registers `handler` for `method` and the path pattern `url`.
    ///
    /// The method is compared case-sensitively. A leading `/` is optional and empty
    /// parts are ignored. Adding the same pattern again replaces the handler; patterns
    /// that differ only in their `@name` names count as the same. Parts after a `*` are
    /// never reached by `find`.
    + fn add(method: String, url: String, handler: T) {
        if url.is_empty() : url = "/"
        if url[0] != '/' : url = "/" + url

        let url_tmp = url.range(1, url.bytes - 1)
        let parts = url_tmp.split("/")
        parts.prepend(method)

        let block = this.block
        let args = Array[RouteArg].new(2)
        let has_wcard = false
        let wcard_index: uint = 0
        // Position among the non-empty parts, the way `find` and `Route.params` count
        let pos: uint = 0

        each parts as part, i {
            if part.bytes == 0 : continue
            if i > 0 : pos++

            if part.get(0) == '@' {
                let name = part.range(1, part.bytes - 1)
                args.append(RouteArg { i: pos, name: name })
                let next = block.param_block ?? <{
                    let v = RouteBlock[T]{}
                    block.param_block = v
                    return v
                }
                block = next
            } else if part == "*" {
                wcard_index = pos
                has_wcard = true
                let next = block.wildcard_block ?? <{
                    let v = RouteBlock[T]{}
                    block.wildcard_block = v
                    return v
                }
                block = next
            } else {
                block = block.ensure_literal(part)
            }
        }

        block.route = Route[T]{ handler: handler, args: args, wildcard_at: has_wcard ? wcard_index : null }
    }

    /// Returns the route that matches `method` and the path `url`.
    ///
    /// Throws `missing` when no route matches. `url` must not contain the query string.
    + fn find(method: String, url: String) Route[T] !LookupError {
        let r = method.bytes == 0 ? SELF.find_path(this.block, url, 0) : SELF.match_segment(this.block, method.view(0, method.bytes), url, 0)
        if isset(r) : return r
        throw .missing
    }

    /// Returns the methods with a route for the path `url`, sorted.
    ///
    /// For a request whose method `find` did not match: an empty list means 404, anything
    /// else 405 with these methods in its `Allow` header.
    ///
    /// ```valk
    /// let allowed = router.allowed_methods(req.path)
    /// if allowed.length > 0 : return http.Response.empty(405, http.Headers { "Allow" => allowed.join(", ") })
    /// ```
    + fn allowed_methods(url: String) Array[String] {
        let result = Array[String]{}
        each this.block.keys as method {
            this.find(method, url) ! continue
            result.append(method)
        }
        result.sort()
        return result
    }

    - static fn find_path(current: RouteBlock[T], url: String, start: uint) ?Route[T] {
        let block = current
        let pos = start
        let len = url.bytes
        while !isset(block.param_block) && !isset(block.wildcard_block) {
            while pos < len && url[pos] == '/' : pos++
            if pos >= len : return block.route
            let end = pos + 1
            while end < len && url[end] != '/' : end++
            block = block.get_literal(url.view(pos, end - pos)) ?! return null
            pos = end
        }
        while pos < len && url[pos] == '/' : pos++
        if pos >= len : return block.route
        let end = pos + 1
        while end < len && url[end] != '/' : end++
        return SELF.match_segment(block, url.view(pos, end - pos), url, end)
    }

    - static fn match_segment(block: RouteBlock[T], seg: local &[u8], url: String, next_pos: uint) ?Route[T] {
        if !seg.equals("*") {
            let sub = block.get_literal(seg)
            if isset(sub) {
                let route = SELF.find_path(sub, url, next_pos)
                if isset(route) : return route
            }
        }
        let param = block.param_block
        if isset(param) {
            let route = SELF.find_path(param, url, next_pos)
            if isset(route) : return route
        }
        let wildcard = block.wildcard_block ?! return null
        return wildcard.route
    }

    /// Returns an independent copy of the router and its routes.
    + fn clone() SELF {
        return SELF { block: clone this.block, inited: this.inited }
    }
}

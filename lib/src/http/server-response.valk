use json
use io
use sync
use time

/// A response returned by a server handler.
///
/// The server writes `Content-Type` and `Content-Length` itself: a `Content-Type`
/// header replaces `content_type`, and `Content-Length` and `Transfer-Encoding` headers
/// are dropped.
+ class Response {
    /// The HTTP status code, also for `file` and `stream` responses.
    + status: u16 (200)
    /// The response body.
    ///
    /// It is left out for `1xx`, 204 and 304 responses and for a `HEAD` request, whose
    /// `Content-Length` still gives the size of the body.
    + body: String ("")
    /// The `Content-Type` header value; a value with control characters is not sent.
    + content_type: String ("text/plain; charset=utf-8")
    // Allocated on first use: most responses set no header of their own
    -+ header_list: ?Headers
    // Allocated on first use: HTTP/2 and HTTP/3 trailing headers (e.g. gRPC status)
    -+ trailer_list: ?Headers (null)
    // A file, stream or WebSocket response's own fields; most responses have none
    -+ source: ?ResponseSource (null)

    get filepath: ?String {
        let source = this.source ?! return null
        return source.filepath
    }
    get filename: ?String {
        let source = this.source ?! return null
        return source.filename
    }
    get stream_reader: ?io.Reader {
        let source = this.source ?! return null
        return source.stream_reader
    }
    get stream_size: ?uint {
        let source = this.source ?! return null
        return source.stream_size
    }
    get event_reader: ?EventReader {
        let source = this.source ?! return null
        return source.event_reader
    }
    -+ get websocket_handler: ?fn(WebSocket)() {
        let source = this.source ?! return null
        return source.websocket_handler
    }
    -+ get websocket_compression: ?bool {
        let source = this.source ?! return null
        return source.websocket_compression
    }

    /// The extra response headers, created empty on first access.
    ///
    /// Fields with invalid names or values are left out when the response is sent.
    + get headers: Headers {
        let hh = this.header_list
        if isset(hh) : return hh
        let created = Headers.new()
        this.header_list = created
        return created
    }

    /// Trailing headers sent after the response body over HTTP/2 and HTTP/3, created empty on first access.
    + get trailers: Headers {
        let tt = this.trailer_list
        if isset(tt) : return tt
        let created = Headers.new()
        this.trailer_list = created
        return created
    }

    /// Creates a `text/html; charset=utf-8` response.
    + static fn html(body: String, code: u16 (200), headers: ?Headers (null)) Response {
        return Response { body: body, status: code, content_type: "text/html; charset=utf-8", header_list: headers }
    }
    /// Creates an `application/json` response; `body` must already be encoded JSON.
    + static fn json(body: String, code: u16 (200), headers: ?Headers (null)) Response {
        return Response { body: body, status: code, content_type: "application/json", header_list: headers }
    }
    /// Creates a response with `body`, `code` and `content_type`; the general form the
    /// other constructors are shortcuts for.
    + static fn new(body: String, code: u16 (200), content_type: String ("text/plain; charset=utf-8"), headers: ?Headers (null)) Response {
        return Response { body: body, status: code, content_type: content_type, header_list: headers }
    }
    /// Creates a `text/plain; charset=utf-8` response.
    + static fn text(body: String, code: u16 (200), headers: ?Headers (null)) Response {
        return Response { body: body, status: code, content_type: "text/plain; charset=utf-8", header_list: headers }
    }
    /// Creates an `application/json` response from any value, encoded with `json.encode`.
    + static fn json_of(data: $T, code: u16 (200), headers: ?Headers (null)) Response {
        return Response { body: json.encode(data), status: code, content_type: "application/json", header_list: headers }
    }
    /// Creates a redirect to `location` with an empty body.
    ///
    /// Sets `Location` on `headers` when given, so a passed `Headers` object is modified.
    + static fn redirect(location: String, code: u16 (302), headers: ?Headers (null)) Response {
        let h = headers ?? Headers.new()
        h.set("Location", location)
        return Response { status: code, header_list: h }
    }
    /// Creates a response with an empty body; also backs default construction.
    + static fn empty(code: u16 (200), headers: ?Headers (null)) Response $default {
        return Response { status: code, header_list: headers }
    }
    /// Creates a response that sends the file at `path`.
    ///
    /// The content type follows from the file extension. With a `filename` the file is
    /// offered as a download under that name (`Content-Disposition: attachment`). A file
    /// that cannot be opened results in an empty 404 response.
    ///
    /// A 200 answer to `GET` or `HEAD` carries `ETag` and `Last-Modified` and answers
    /// `If-None-Match` / `If-Modified-Since` with 304 and a single `Range` of bytes with
    /// 206 (416 past the end), unless the response sets its own `ETag`, `Last-Modified` or
    /// `Content-Encoding`.
    + static fn file(path: String, filename: ?String (null)) Response {
        return Response { source: ResponseSource { filepath: path, filename: filename } }
    }
    /// Creates a response whose body is streamed from `reader`.
    ///
    /// `size` becomes the `Content-Length` and exactly `size` bytes are read from `reader`;
    /// a reader that ends early fails the response. Without a `size` the body is sent as
    /// it is read, until the reader returns 0: chunked over HTTP/1.1, closing the
    /// connection for an HTTP/1.0 client. With a `filename` the body is offered as a
    /// download under that name. The reader is not closed.
    + static fn stream(reader: io.Reader, content_type: String ("application/octet-stream"), size: ?uint (null), filename: ?String (null)) Response {
        return Response { source: ResponseSource { stream_reader: reader, stream_size: size, filename: filename }, content_type: content_type }
    }
    /// Creates a Server-Sent Events response (`text/event-stream`): each value received
    /// from `channel` is sent as one event, its lines as `data:` lines.
    ///
    /// The stream ends when the channel is closed and empty, and when the server shuts
    /// down. An idle stream sends a comment every 15 seconds, so proxies keep it open
    /// and a client that left is noticed.
    + static fn events(channel: sync.Channel[String], headers: ?Headers (null)) Response {
        let reader = EventReader { channel: channel }
        let res = Response { source: ResponseSource { stream_reader: reader, event_reader: reader }, content_type: "text/event-stream", header_list: headers }
        if !res.headers.has("cache-control") : res.headers.set("Cache-Control", "no-cache")
        return res
    }
    /// Sets the header `name` to `value`, replacing earlier values for that name.
    + fn set_header(name: String, value: String) {
        this.headers.set(name, value)
    }
    /// Adds a header field, keeping earlier fields with the same name.
    + fn add_header(name: String, value: String) {
        this.headers.append(name, value)
    }
    /// Sets the trailing header `name` to `value`, replacing earlier values for that name.
    + fn set_trailer(name: String, value: String) {
        this.trailers.set(name, value)
    }
    /// Adds a trailing header field, keeping earlier fields with the same name.
    + fn add_trailer(name: String, value: String) {
        this.trailers.append(name, value)
    }

    /// Sends `cookie` with this response, next to any cookie already set.
    ///
    /// A cookie whose name or value cannot go in a header is left out, as an invalid
    /// header field is.
    + fn set_cookie(cookie: Cookie) {
        let value = cookie.to_header()
        if value.bytes == 0 : return
        this.headers.append("Set-Cookie", value)
    }

    /// Deletes the cookie `name` at the browser, by sending it expired.
    ///
    /// `path` and `domain` must be the ones it was set with, or the browser keeps the
    /// cookie and this one sits next to it.
    + fn clear_cookie(name: String, path: String ("/"), domain: ?String (null)) {
        let cookie = Cookie.new(name, "")
        cookie.path = path
        cookie.domain = domain
        cookie.max_age = 0
        cookie.expires = time.DateTime.from_unix_seconds(0) !? null
        this.set_cookie(cookie)
    }
}

class ResponseSource {
    filepath: ?String (null)
    filename: ?String (null)
    stream_reader: ?io.Reader (null)
    stream_size: ?uint (null)
    event_reader: ?EventReader (null)
    // Set by `WebSocket.upgrade`: runs on the connection once the 101 response is sent
    websocket_handler: ?fn(WebSocket)() (null)
    websocket_compression: ?bool (null)
}

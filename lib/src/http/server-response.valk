use io

+ class Response {
    + status: u32 (200)
    + body: String ("")
    filepath: ?String
    filename: ?String
    stream_reader: ?io.Reader
    stream_size: uint (0)
    + content_type: String ("text/plain")
    // Allocated on first use: most responses set no header of their own
    -+ header_list: ?Headers

    + get headers: Headers {
        let hh = this.header_list
        if isset(hh) : return hh
        let created = Headers.new()
        this.header_list = created
        return created
    }

    + static fn html(body: String, code: u32 (200), headers: ?Headers (null)) Response {
        return Response { body: body, status: code, content_type: "text/html", header_list: headers }
    }
    + static fn json(body: String, code: u32 (200), headers: ?Headers (null)) Response {
        return Response { body: body, status: code, content_type: "application/json", header_list: headers }
    }
    + static fn text(body: String, code: u32 (200), content_type: String ("text/plain"), headers: ?Headers (null)) Response {
        return Response { body: body, status: code, content_type: content_type, header_list: headers }
    }
    + static fn redirect(location: String, code: u32 (302), headers: ?Headers (null)) Response {
        let h = headers ?? Headers.new()
        h.set("Location", location)
        return Response { status: code, header_list: h }
    }
    + static fn empty(code: u32 (200), headers: ?Headers (null)) Response $default {
        return Response { status: code, header_list: headers }
    }
    + static fn file(path: String, filename: ?String (null)) Response {
        return Response { filepath: path, filename: filename }
    }
    // Streams `size` bytes from `reader` as the body
    + static fn stream(reader: io.Reader, size: uint, content_type: String ("application/octet-stream"), filename: ?String (null)) Response {
        return Response { stream_reader: reader, stream_size: size, content_type: content_type, filename: filename }
    }
    + fn set_header(name: String, value: String) {
        this.headers.set(name, value)
    }
    + fn add_header(name: String, value: String) {
        this.headers.append(name, value)
    }

    fn reset() {
        this.status = 200
        this.body = ""
        this.filepath = null
        this.filename = null
        this.stream_reader = null
        this.stream_size = 0
        this.content_type = "text/plain"
        this.header_list = null
    }
}

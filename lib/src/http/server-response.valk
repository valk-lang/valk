use io

+ class Response {
    + status: u32 (200)
    + body: String ("")
    filepath: ?String
    filename: ?String
    stream_reader: ?io.Reader
    stream_size: uint (0)
    + content_type: String ("text/plain")
    + headers: ?Map[String]
    + extra_headers: ?Array[String]

    + static fn html(body: String, code: u32 (200), headers: ?Map[String] (null)) Response {
        return Response { body: body, status: code, content_type: "text/html", headers: headers }
    }
    + static fn json(body: String, code: u32 (200), headers: ?Map[String] (null)) Response {
        return Response { body: body, status: code, content_type: "application/json", headers: headers }
    }
    + static fn text(body: String, code: u32 (200), content_type: String ("text/plain"), headers: ?Map[String] (null)) Response {
        return Response { body: body, status: code, content_type: content_type, headers: headers }
    }
    + static fn redirect(location: String, code: u32 (302), headers: ?Map[String] (null)) Response {
        let h = headers ?? Map[String].new()
        h.set("Location", location)
        return Response { status: code, headers: h }
    }
    + static fn empty(code: u32 (200), headers: ?Map[String] (null)) Response $default {
        return Response { status: code, headers: headers }
    }
    + static fn file(path: String, filename: ?String (null)) Response {
        return Response { filepath: path, filename: filename }
    }
    // Streams `size` bytes from `reader` as the body
    + static fn stream(reader: io.Reader, size: uint, content_type: String ("application/octet-stream"), filename: ?String (null)) Response {
        return Response { stream_reader: reader, stream_size: size, content_type: content_type, filename: filename }
    }
    + fn set_header(name: String, value: String, extend_existing: bool (false)) {
        let h = this.headers ?? Map[String].new()
        if extend_existing : h.get(name) -> hv : value = "%hv, %value"
        h.set(name, value)
        this.headers = h
    }
    + fn add_header(name: String, value: String) {
        let h = this.extra_headers ?? Array[String].new()
        h.append("%name: %value")
        this.extra_headers = h
    }

    fn reset() {
        this.status = 200
        this.body = ""
        this.filepath = null
        this.filename = null
        this.stream_reader = null
        this.stream_size = 0
        this.content_type = "text/plain"
        let headers = this.headers
        if isset(headers) : headers.clear()
        let extra_headers = this.extra_headers
        if isset(extra_headers) : extra_headers.clear()
    }
}

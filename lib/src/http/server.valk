
use core
use net
use fs
use thread
use time

fn handler_default(req: Request) Response {
    return Response.html("Hello world!")
}
fn fast_handler_default(req: Context, res: ResponseWriter) {
    res.respond("Hello world!", 200, "text/html")
}

class ServerStaticDir {
    path: String
    next: ?shared ServerStaticDir
}

// State shared by the worker threads of one `start()` call
class ServerWorkerData {
    socket: shared net.TcpServer
    tls_context: ?shared net.SslServerContext
    handler: shared fn(Request)(Response)
    fast_handler: ?shared fn(Context, ResponseWriter)()
    static_dirs: ?shared ServerStaticDir
    show_info: bool
    idle_timeout_ms: uint
    header_timeout_ms: uint
    body_timeout_ms: uint
    write_timeout_ms: uint
    max_connections: uint
    max_request_header_size: uint
    max_request_body_size: uint
    max_server_wide_body_size: uint
    http2: bool (false)
    connections: uint (0)
    active_body_size: uint (0)
    // Shutdown: `stopping` is polled by the workers, `deadline_ms` says how
    // long in-flight requests may take. Both are written under `mutex`.
    mutex: shared core.SyncMutex (.new())
    stopping: u8 (0)
    deadline_ms: uint (0)
    // Running workers; the last one to exit unlocks `done`
    workers: uint (0)
    acceptors: uint (0)
    done: shared core.Mutex

    // Repeated requests can shorten, but never extend, the deadline
    fn request_shutdown(timeout_ms: uint) @threadsafe {
        // An overflowing timeout saturates: "wait as long as it takes"
        let deadline = time.mono_ms().checked_add(timeout_ms) !? (~0).to(uint)
        this.mutex.lock()
        if this.stopping == 0 || deadline < this.deadline_ms : this.deadline_ms = deadline
        this.stopping = 1
        this.mutex.unlock()
    }
}

/// Creates a `Server` with default settings for `handler` and runs it; see `Server.start`.
+ fn serve(host: String, port: u16, handler: shared fn(Request)(Response), worker_count: uint (0)) void !HttpError {
    Server.new(host, port, handler).start(worker_count) !>
}

/// Like `serve`, with a fast handler that writes straight to a `ResponseWriter`.
///
/// It skips building a `Request` and `Response` per call, which mostly matters for
/// benchmarks.
+ fn serve_fast(host: String, port: u16, handler: shared fn(Context, ResponseWriter)(), worker_count: uint (0)) void !HttpError {
    let server = Server.new(host, port)
    server.fast(handler)
    server.start(worker_count) !>
}

/// A multi-threaded HTTP/1.1 server, with optional TLS and experimental HTTP/2.
///
/// Configure the public fields, then call `start`. A server can be started once.
///
/// ```valk
/// let s = http.Server.new("127.0.0.1", 9000, handler)
/// s.max_request_body_size = 1024 * 1024
/// s.start() ! { println("Failed to start http server"); return }
/// ```
+ class Server {
    /// The address the server listens on.
    ~ host: String
    /// The port the server listens on.
    ~ port: u16
    - tls_context: ?shared net.SslServerContext
    // Set by `start()`; a Server runs once
    - run: ?shared ServerWorkerData (null)
    // A shutdown requested before `start()` got going, applied when it does
    - early_stop: bool (false)
    - early_stop_timeout_ms: uint (0)
    /// The number of open connections allowed; 0 means no limit. Defaults to 10000.
    ///
    /// Connections beyond it are answered with 503 and closed.
    + max_connections: uint
    handler: shared fn(Request)(Response) (handler_default)
    /// A handler that replaces the regular one, see `fast`.
    + fast_handler: ?shared fn(Context, ResponseWriter)()
    -+ static_dirs: Array[String] (.{})
    /// The largest accepted request head (request line and headers) in bytes; 0 means
    /// no limit. Defaults to 8 KiB.
    ///
    /// Larger requests are answered with 413 and the connection is closed.
    + max_request_header_size: uint (8 * 1024)
    /// The largest accepted request body in bytes; 0 means no limit. Defaults to 32 MiB.
    ///
    /// Larger requests are answered with 413 and the connection is closed.
    + max_request_body_size: uint (32 * 1024 * 1024)
    /// The combined size of the request bodies being received at once, over all
    /// connections, in bytes; 0 means no limit.
    ///
    /// A request that would exceed it is answered with 503, and while the limit is
    /// reached new connections are answered with 503 as well.
    + max_server_wide_body_size: uint (0)
    /// Whether the server prints startup, connection and error messages.
    + show_info: bool (false)
    /// Enables experimental HTTP/2, negotiated through ALPN with HTTP/1.1 as fallback.
    ///
    /// Requires `tls` and the regular handler; `start` fails with `init` otherwise.
    + http2: bool (false)
    /// How long a connection may wait for the next request, in milliseconds.
    + idle_timeout_ms: uint (5000)
    /// How long each read of a request head, and the TLS handshake, may take, in
    /// milliseconds.
    + header_timeout_ms: uint (5000)
    /// How long each read of a request body may take, in milliseconds.
    + body_timeout_ms: uint (5000)
    /// How long each socket write may take, in milliseconds.
    + write_timeout_ms: uint (5000)

    /// Creates a server for `host` and `port`; nothing is opened until `start`.
    ///
    /// The default handler answers every request with "Hello world!".
    + static fn new(host: String, port: u16, handler: shared fn(Request)(Response) (handler_default)) Server {
        return Server {
            host: host,
            port: port,
            max_connections: 10000,
            handler: handler,
        }
    }

    /// Sets the handler that answers each request.
    + fn handle(handler: shared fn(Request)(Response)) {
        this.handler = handler
    }

    /// Sets a fast handler, which is used instead of the regular one.
    ///
    /// It receives the parsed `Context` and writes to a `ResponseWriter`, skipping the
    /// `Request`/`Response` objects. A handler that does not respond makes the server
    /// answer 400 and close the connection. Not supported together with `http2`.
    + fn fast(handler: shared fn(Context, ResponseWriter)()) {
        this.fast_handler = handler
    }

    /// Serves over TLS with the given PEM certificate and private key files.
    ///
    /// `cipher_list` applies to TLS 1.2 and older, `cipher_suites` to TLS 1.3. Throws when
    /// the files or settings cannot be loaded.
    + fn tls(
        certificate_file: String,
        private_key_file: String,
        min_version: net.TlsVersion (net.TlsVersion.tls_1_2),
        cipher_list: ?String (null),
        cipher_suites: ?String (null)
    ) !HttpError {
        this.tls_context = net.SslServerContext.new(
            certificate_file,
            private_key_file,
            min_version,
            cipher_list,
            cipher_suites
        ) !>
    }

    /// Stops accepting connections and gives in-flight requests `timeout_ms` to finish.
    ///
    /// Returns without waiting and is safe to call from a handler. Idle connections are
    /// closed right away. Before `start` the request is remembered and `start` stops
    /// again as soon as it is running. Repeated calls can shorten the deadline, never
    /// extend it.
    + fn request_shutdown(timeout_ms: uint (5000)) {
        let run = this.run
        if isset(run) {
            run.request_shutdown(timeout_ms)
            return
        }
        if !this.early_stop || timeout_ms < this.early_stop_timeout_ms : this.early_stop_timeout_ms = timeout_ms
        this.early_stop = true
    }

    /// Calls `request_shutdown` and waits for the workers to finish.
    ///
    /// Returns `false` when the deadline expired first; handler code can then still be
    /// unwinding, and `start` returns once it did. Before `start` it only records the
    /// request and returns `true`. Do not call this from a handler: it would wait for
    /// itself.
    + fn shutdown(timeout_ms: uint (5000)) bool {
        let run = this.run
        if !isset(run) {
            this.request_shutdown(timeout_ms)
            return true
        }
        run.request_shutdown(timeout_ms)
        while run.workers > 0 {
            let now = time.mono_ms()
            let deadline = run.deadline_ms
            if now >= deadline : return false
            let remaining = deadline - now
            time.sleep_ms(remaining < 10 ? remaining : 10)
        }
        return true
    }

    /// Serves until `request_shutdown`/`shutdown` and every worker has drained.
    ///
    /// Runs `worker_count` workers, one per thread, one of them on the calling thread, so
    /// use `co` to keep working. A count of 0 uses the number of CPU threads; the
    /// count is clamped to 1-128. Throws `init` when the server was started before, when
    /// `http2` is set without `tls` or with a fast handler, or when a worker thread cannot
    /// be started (after the started workers have drained), and a network error when the
    /// port cannot be bound. `SIGPIPE` is ignored process-wide from then on.
    + fn start(worker_count: uint (0)) void !HttpError {
        if isset(this.run) : throw .init
        if this.http2 {
            if !isset(this.tls_context) || isset(this.fast_handler) : throw .init
            let context = this.tls_context
            if isset(context) {
                @unsafe
                net.SSL_CTX_set_alpn_select_cb(context.ctx, h2_alpn_select, null)
            }
        }
        let socket = net.tcp_server(this.host, this.port) !>
        let done: shared core.Mutex = .new() ! {
            socket.close() ! core.cleanup_warning("Failed to close HTTP listener", __FILE__, __LINE__)
            throw .init
        }
        done.lock()

        // SIGPIPE
        core.signal_ignore(13)

        // Clamp into a local: `worker_count` is published as shared below
        let count = worker_count
        if count == 0 {
            count = (core.cpu_thread_count() !? 8).to(uint)
        }
        if count < 1 {
            count = 1
        }
        if count > 128 {
            count = 128
        }

        if this.show_info {
            println("[+] Running http server on port " + this.port)
            println("[+] Worker count: " + count)
        }

        let static_dirs: ?shared ServerStaticDir = null
        each this.static_dirs as path {
            static_dirs = .{
                path: path
                next: static_dirs
            }
        }

        let server: shared ServerWorkerData = .{
            socket: socket
            tls_context: this.tls_context
            handler: this.handler
            fast_handler: this.fast_handler
            static_dirs: static_dirs
            show_info: this.show_info
            idle_timeout_ms: this.idle_timeout_ms
            header_timeout_ms: this.header_timeout_ms
            body_timeout_ms: this.body_timeout_ms
            write_timeout_ms: this.write_timeout_ms
            max_connections: this.max_connections
            max_request_header_size: this.max_request_header_size
            max_request_body_size: this.max_request_body_size
            max_server_wide_body_size: this.max_server_wide_body_size
            http2: this.http2
            workers: count
            acceptors: count.to(uint)
            done: done
        }
        this.run = server
        if this.early_stop : server.request_shutdown(this.early_stop_timeout_ms)

        // Worker 0 is this thread; the others get a thread each
        let failed = false
        let remaining = server.workers - 1
        while remaining > 0 && !failed {
            let run: shared fn()() = fn() { worker(server) }
            thread.Thread[void].start(run) ! { failed = true }
            if !failed : remaining--
        }
        if failed {
            // Workers that never started are not waited for; the rest drain
            server.workers -= remaining
            server.acceptors -= remaining
            server.request_shutdown(0)
        }

        worker(server)
        server.done.await_unlock()
        if failed : throw .init
    }

    /// Serves files from the directory `path` before a request reaches the handler.
    ///
    /// Throws `missing` when `path` is not a directory. A request whose path names a file
    /// inside the directory gets that file whatever the method (over HTTP/2: except
    /// `CONNECT`); paths containing `..` are never served. The directory added last is
    /// searched first.
    + fn add_static_dir(path: String) !LookupError {
        let full = fs.resolve(path)
        if !fs.is_dir(full) : throw .missing
        if this.show_info : println("[+] Add static dir: " + full)
        this.static_dirs.append(full)
    }
}

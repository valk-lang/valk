
use core
use net
use fs
use thread
use time

fn handler_default(req: Request) Response {
    return Response.html("Hello world!")
}
fn fast_handler_default(req: Context, res: ResponseWriter) {
    res.respond(200, "text/html", "Hello world!")
}

class ServerStaticDir {
    path: String
    next: ?shared ServerStaticDir
}

class ServerWorkerData {
    socket: shared net.SocketServer
    tls_context: ?shared net.SslServerContext
    handler: shared fn(Request)(Response)
    fast_handler: ?shared fn(Context, ResponseWriter)()
    static_dirs: ?shared ServerStaticDir
    show_info: bool
    idle_timeout_ms: uint
    header_timeout_ms: uint
    body_timeout_ms: uint
    write_timeout_ms: uint
    max_connections: uint
    max_request_header_size: uint
    max_request_body_size: uint
    max_server_wide_body_size: uint
    connections: uint (0)
    active_body_size: uint (0)
    stopping: u8 (0)
    deadline_ms: uint (0)
    workers: uint (0)
    acceptors: uint (0)
    #if OS == "win"
    inboxes: Array[shared WorkerInbox]
    #end
    done: shared core.Mutex
}

class ServerLifecycle {
    mutex: shared core.SyncMutex (.new())
    active: bool (false)
    stopping: bool (false)
    deadline_ms: uint (0)
    run: ?shared ServerWorkerData (null)

    fn begin() !HttpError @shared_unsafe {
        this.mutex.lock()
        if this.active {
            this.mutex.unlock()
            throw .init
        }
        this.active = true
        this.run = null
        this.mutex.unlock()
    }

    fn publish(run: shared ServerWorkerData) @shared_unsafe {
        this.mutex.lock()
        this.run = run
        if this.stopping {
            run.deadline_ms = this.deadline_ms
            run.stopping = 1
        }
        this.mutex.unlock()
    }

    fn finish() @shared_unsafe {
        this.mutex.lock()
        this.active = false
        this.stopping = false
        this.mutex.unlock()
    }

    fn request_shutdown(timeout_ms: uint) @shared_unsafe {
        let deadline = time.mono_ms().checked_add(timeout_ms) !? (~0).to(uint)
        this.mutex.lock()
        let run = this.run
        if !this.active && isset(run) {
            this.mutex.unlock()
            return
        }
        if !this.stopping || deadline < this.deadline_ms : this.deadline_ms = deadline
        this.stopping = true
        if isset(run) {
            run.deadline_ms = this.deadline_ms
            run.stopping = 1
        }
        this.mutex.unlock()
    }
}

// Shortcut: create a server and start it
+ fn serve(host: String, port: u16, handler: shared fn(Request)(Response), worker_count: i32 (-1)) void !HttpError {
    Server.new(host, port, handler).start(worker_count) !>
}

// Same as `serve`, with a fast handler that writes straight to the response
// writer. It skips building a Request/Response per call, which mostly matters
// for benchmarks.
+ fn serve_fast(host: String, port: u16, handler: shared fn(Context, ResponseWriter)(), worker_count: i32 (-1)) void !HttpError {
    Server.new(host, port).fast(handler).start(worker_count) !>
}

+ class Server {
    - lifecycle: shared ServerLifecycle (.{})
    #if TEST && OS == "win"
    - fail_worker_start_after: int (-1)
    #end
    ~ host: String
    ~ port: u16
    - tls_context: ?shared net.SslServerContext
    + max_connections: uint
    handler: shared fn(Request)(Response) (handler_default)
    + fast_handler: ?shared fn(Context, ResponseWriter)()
    -+ static_dirs: Array[String] (.{})
    + max_request_header_size: uint (8 * 1024)       // 8 KiB
    + max_request_body_size: uint (32 * 1024 * 1024) // 32 MiB
    + max_server_wide_body_size: uint (0)
    + show_info: bool (false)
    + idle_timeout_ms: uint (5000)
    + header_timeout_ms: uint (5000)
    + body_timeout_ms: uint (5000)
    + write_timeout_ms: uint (5000)

    + static fn new(host: String, port: u16, handler: shared fn(Request)(Response) (handler_default)) Server {
        return Server {
            host: host,
            port: port,
            max_connections: 10000,
            handler: handler,
        }
    }

    + fn handle(handler: shared fn(Request)(Response)) SELF {
        this.handler = handler
        return this
    }

    + fn fast(handler: shared fn(Context, ResponseWriter)()) SELF {
        this.fast_handler = handler
        return this
    }

    + fn tls(
        certificate_file: String,
        private_key_file: String,
        min_version: net.TlsVersion (net.TlsVersion.tls_1_2),
        cipher_list: ?String (null),
        cipher_suites: ?String (null)
    ) SELF !HttpError {
        this.tls_context = net.SslServerContext.new(
            certificate_file,
            private_key_file,
            min_version,
            cipher_list,
            cipher_suites
        ) !>
        return this
    }

    // Repeated requests can shorten, but never extend, the shutdown deadline.
    + fn request_shutdown(timeout_ms: uint (5000)) {
        this.lifecycle.request_shutdown(timeout_ms)
    }

    // False means the deadline expired; handler code can still be unwinding.
    + fn shutdown(timeout_ms: uint (5000)) bool {
        let lifecycle = this.lifecycle
        lifecycle.request_shutdown(timeout_ms)
        while lifecycle.active {
            let now = time.mono_ms()
            let deadline = lifecycle.deadline_ms
            if now >= deadline : return false
            let remaining = deadline - now
            time.sleep_ms(remaining < 10 ? remaining : 10)
        }
        return true
    }

    + fn start(worker_count: i32 (-1)) void !HttpError {
        let lifecycle = this.lifecycle
        lifecycle.begin() !>
        defer lifecycle.finish()
        if lifecycle.stopping : return
        let socket = net.Socket.server(net.SocketType.tcp, this.host, this.port) !>
        let done: shared core.Mutex = .new() ! {
            socket.close() ! core.cleanup_warning("Failed to close HTTP listener", __FILE__, __LINE__)
            throw .init
        }
        done.lock()

        // SIGPIPE
        core.signal_ignore(13)

        // Clamp into a local: `worker_count` is published as shared below
        let count = worker_count
        if count < 0 {
            count = (core.cpu_thread_count() !? 8).to(i32)
        }
        if count < 1 {
            count = 1
        }
        if count > 128 {
            count = 128
        }

        if this.show_info {
            println("[+] Running http server on port " + this.port)
            println("[+] Worker count: " + count)
        }

        let static_dirs: ?shared ServerStaticDir = null
        each this.static_dirs as path {
            static_dirs = .{
                path: path
                next: static_dirs
            }
        }

        #if OS == "win"
        let inboxes = Array[shared WorkerInbox].new()
        let inbox_count: uint = 0
        while inbox_count++ < count.to(uint) : inboxes.append(WorkerInbox {})
        #end
        let server: shared ServerWorkerData = .{
            socket: socket
            tls_context: this.tls_context
            handler: this.handler
            fast_handler: this.fast_handler
            static_dirs: static_dirs
            show_info: this.show_info
            idle_timeout_ms: this.idle_timeout_ms
            header_timeout_ms: this.header_timeout_ms
            body_timeout_ms: this.body_timeout_ms
            write_timeout_ms: this.write_timeout_ms
            max_connections: this.max_connections
            max_request_header_size: this.max_request_header_size
            max_request_body_size: this.max_request_body_size
            max_server_wide_body_size: this.max_server_wide_body_size
            workers: count.to(uint)
            acceptors: count.to(uint)
            done: done
            #if OS == "win"
            inboxes: inboxes
            #end
        }
        lifecycle.publish(server)
        #if OS != "win"
        let run: shared fn()() = fn() {
            worker(server)
        }
        #end

        let remaining_workers = server.workers - 1
        while remaining_workers > 0 {
            #if OS == "win"
            let index = remaining_workers
            let run: shared fn()() = fn() { worker(server, index) }
            #end
            this.spawn_worker(run) ! {
                lifecycle.request_shutdown(0)
                server.workers -= remaining_workers
                #if OS == "win"
                each server.inboxes as inbox : inbox.close()
                server.socket.close() ! core.cleanup_warning("Failed to close HTTP listener", __FILE__, __LINE__)
                #else
                server.acceptors -= remaining_workers
                if --server.acceptors == 0 : server.socket.close() ! core.cleanup_warning("Failed to close HTTP listener", __FILE__, __LINE__)
                #end
                if --server.workers == 0 : server.done.unlock()
                server.done.await_unlock()
                throw .init
            }
            remaining_workers--
        }

        worker(server)
        server.done.await_unlock()
    }

    fn spawn_worker(handler: shared fn()()) !HttpError {
        #if TEST && OS == "win"
        if this.fail_worker_start_after == 0 : throw .init
        if this.fail_worker_start_after > 0 : this.fail_worker_start_after--
        #end
        thread.Thread[void].start(handler) ! throw .init
    }

    + fn add_static_dir(path: String) !LookupError {
        let full = fs.resolve(path)
        if !fs.is_dir(full) : throw .missing
        if this.show_info : println("[+] Add static dir: " + full)
        this.static_dirs.append(full)
    }
}

use io
use sync

// An idle event stream sends a comment this often, so proxies keep it open and a gone
// client is noticed
value EVENT_PING_MS (15000)

// Reads a channel of text as Server-Sent Events: each value is one `message` event
class EventReader is io.Reader {
    channel: shared sync.Channel[String]
    // Set by the server: ends the stream when it shuts down
    stop: ?shared sync.CancelToken (null)
    ping_ms: uint (EVENT_PING_MS)
    pending: String ("")
    pending_pos: uint (0)

    + fn read(buf: local mut &[u8]) uint !io.IoError {
        while this.pending_pos == this.pending.bytes {
            let value = this.channel.recv(this.ping_ms, this.stop) ! {
                if !error_is(E.code, timeout) : return 0
                this.pending = ":\n\n"
                this.pending_pos = 0
                break
            }
            this.pending = encode_event(value)
            this.pending_pos = 0
        }
        let count = this.pending.bytes - this.pending_pos
        if count > buf.length : count = buf.length
        let pending = this.pending
        let pos = this.pending_pos
        let i: uint = 0
        while i < count {
            buf[i] = pending[pos + i]
            i++
        }
        this.pending_pos += count
        return count
    }
}

// `data:` lines for each line of `value`, then the blank line that ends the event
fn encode_event(value: String) String {
    let out = ByteBuffer.new(value.bytes + 16)
    let start: uint = 0
    let i: uint = 0
    while i <= value.bytes {
        let end = i == value.bytes
        let ch: u8 = end ? 0 : value[i]
        if end || ch == '\n' || ch == '\r' {
            out.write("data: ")
            out.write(value.view(start, i - start))
            out.write("\n")
            if end : break
            if ch == '\r' && i + 1 < value.bytes && value[i + 1] == '\n' : i++
            start = i + 1
        }
        i++
    }
    out.write("\n")
    return out.into_string()
}

#if TEST
/// Test hook, only in `TEST` builds: the reader behind `Response.events`, pinging every
/// `ping_ms`.
+ fn event_reader_for_test(channel: shared sync.Channel[String], ping_ms: uint) io.Reader {
    return EventReader { channel: channel, ping_ms: ping_ms }
}
#end

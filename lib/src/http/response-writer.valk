
use fs
use io
use core
use compress

// Responses smaller than this are sent uncompressed: gzip would save little or nothing
value GZIP_MIN_SIZE (1024)

// Content types worth compressing
fn response_gzip_type(content_type: String) bool {
    let t = content_type.lower()
    return t.starts_with("text/") || t.starts_with("application/json") || t.starts_with("application/javascript")
        || t.starts_with("application/xml") || t.starts_with("image/svg+xml") || t.contains("+json") || t.contains("+xml")
}

// Whether an `Accept-Encoding` value takes gzip (and does not rule it out with q=0)
fn request_accepts_gzip(value: String) bool {
    each value.split(",") as item {
        let parts = item.split(";")
        let name = (parts.get(0) !? "").trim().lower()
        if name != "gzip" && name != "*" : continue
        let refused = false
        each parts as param, i {
            if i == 0 : continue
            let p = param.trim().lower()
            if p == "q=0" || p == "q=0.0" || p == "q=0.00" || p == "q=0.000" : refused = true
        }
        if !refused : return true
    }
    return false
}

fn response_header_is_framing(name: String) bool {
    return name.equals_ignore_ascii_case("content-type")
        || name.equals_ignore_ascii_case("content-length")
        || name.equals_ignore_ascii_case("transfer-encoding")
}

fn response_header_name_is_safe(name: String) bool {
    if name.bytes == 0 : return false
    each name as ch {
        if ch.is_alpha_numeric() : continue
        if ch == '!' || ch == '#' || ch == '$' || ch == '%' || ch == '&'
            || ch == '\'' || ch == '*' || ch == '+' || ch == '-' || ch == '.'
            || ch == '^' || ch == '_' || ch == '`' || ch == '|' || ch == '~': continue
        return false
    }
    return true
}

fn response_header_value_is_safe(value: String) bool {
    return !value.view().has_ascii_control(true)
}

fn write_response_quoted_header_value(out: ByteBuffer, value: String) {
    each value as ch {
        if ch == '"' || ch == '\\' : out.write_byte('\\')
        out.write_byte(ch)
    }
}

/// Writes the HTTP/1.1 response for one request; passed to `fast` handlers.
///
/// Only the first `respond`, `send_status`, `send_file` or `send_stream` call per request
/// has an effect; later calls are ignored. A fast handler that does not respond makes
/// the server answer 400 and close the connection. Output is buffered and sent by the
/// server after the handler returns.
+ class ResponseWriter {
    - output: ByteBuffer (ByteBuffer.new(1024))
    - file_response: ?fs.FileStream
    - body_reader: ?io.Reader
    /// Whether a response has been written for the current request.
    ~ responded: bool (false)
    // Emits `Connection: close`; set by the server when it closes the
    // connection after this response (draining, error responses)
    -+ close: bool (false)
    // Emits `Connection: keep-alive`: an HTTP/1.0 client only keeps the
    // connection open when the response says so
    -+ keep_alive: bool (false)
    // Answers a `HEAD` request: the head is sent without the body; set by the server
    // for every request
    -+ head: bool (false)
    - output_pos: uint (0)
    // The number of bytes still to copy from `body_reader`
    - body_left: uint (0)
    // Set by a WebSocket upgrade response; the server hands the connection to it
    -+ websocket_handler: ?fn(WebSocket)() (null)
    // `Server.compress`
    -+ compress: bool (false)
    // The request being answered, for the headers that shape the response
    -+ request_context: ?Context (null)

    -+ fn reset() {
        this.request_context = null
        this.output.clear()
        this.output.shrink_capacity(2048)
        this.output_pos = 0
        this.body_reader = null
        this.body_left = 0
        this.websocket_handler = null

        let file = this.file_response
        if isset(file) {
            file.close() ! core.cleanup_warning("Failed to close HTTP response file", __FILE__, __LINE__)
            this.file_response = null
        }
    }

    -+ fn allow_new_response() {
        this.responded = false
    }

    fn send_response(resp: Response) {
        if this.responded : return

        let filepath = resp.filepath
        if isset(filepath) {
            this.send_file(filepath, resp.filename, resp.header_list, resp.status)
            return
        }
        let reader = resp.stream_reader
        if isset(reader) {
            this.send_stream(reader, resp.stream_size, resp.content_type, resp.filename, resp.header_list, resp.status)
            return
        }

        let ws = resp.websocket_handler
        if isset(ws) {
            this.send_upgrade(resp.header_list, ws)
            return
        }
        this.send(resp.body, resp.status, resp.content_type, resp.header_list)
    }

    /// Answers with the WebSocket upgrade and runs `handler` on the connection once the
    /// response is sent; the fast-handler form of `WebSocket.upgrade`.
    ///
    /// A request that is not a valid WebSocket upgrade gets a `400` response and the
    /// handler never runs.
    + fn send_websocket(context: Context, handler: fn(WebSocket)()) {
        if this.responded : return
        let accept = websocket_accept_key(context.method.to_string(), context.headers())
        if !isset(accept) {
            this.send("Expected a WebSocket upgrade request", 400)
            return
        }
        let headers = Headers.new()
        websocket_upgrade_headers(headers, accept)
        this.send_upgrade(headers, handler)
    }

    - fn send_upgrade(headers: ?Headers, handler: fn(WebSocket)()) {
        // The connection stays open for the handler, so no `Connection: close`
        this.close = false
        this.keep_alive = false
        this.send("", 101, "text/plain", headers)
        this.websocket_handler = handler
    }

    /// Responds with `status_code` and an empty `text/plain` body.
    + fn send_status(status_code: u16) {
        this.send("", status_code)
    }

    /// Responds with status `code` and the file at `path`; responds 404 when it cannot
    /// be opened.
    ///
    /// The content type follows from the file extension, unless `headers` has a
    /// `Content-Type`. With a `filename` the file is offered as a download under that
    /// name. The body is left out like `respond` leaves it out.
    ///
    /// A 200 response to a `GET` or `HEAD` request carries `ETag` and `Last-Modified`,
    /// answers 304 when the client's copy is current and 206 for a `Range` of bytes,
    /// unless `headers` sets its own `ETag`, `Last-Modified` or `Content-Encoding`.
    + fn send_file(path: String, filename: ?String (null), headers: ?Headers (null), code: u16 (200)) {
        if this.responded : return

        let stream = fs.stream(path) ! {
            this.send("", 404, "text/plain", headers)
            return
        }
        let info = fs.stat(path) ! {
            stream.close() ! core.cleanup_warning("Failed to close HTTP response file", __FILE__, __LINE__)
            this.send("", 404, "text/plain", headers)
            return
        }

        let content_type = fs.mime_type(fs.extension(path))
        if isset(headers) : content_type = headers.get("content-type") !? content_type
        let plan = this.file_plan_for(code, info, content_type, headers)
        if isset(plan) {
            if plan.status == 304 || plan.status == 416 {
                stream.close() ! core.cleanup_warning("Failed to close HTTP response file", __FILE__, __LINE__)
                this.send_file_status(plan, headers)
                return
            }
            if plan.gzip {
                let data = io.read_all(stream) !? null
                stream.close() ! core.cleanup_warning("Failed to close HTTP response file", __FILE__, __LINE__)
                if !isset(data) || data.length != plan.size {
                    this.send("", 500, "text/plain", headers)
                    return
                }
                this.send_encoded(compress.gzip(data), 200, content_type, headers, plan)
                return
            }
            if plan.start > 0 {
                stream.seek(plan.start.to(int)) ! {
                    stream.close() ! core.cleanup_warning("Failed to close HTTP response file", __FILE__, __LINE__)
                    this.send("", 500, "text/plain", headers)
                    return
                }
            }
        }

        this.file_response = stream
        this.stream_response(stream, isset(plan) ? plan.length : info.size, content_type, filename, headers, isset(plan) ? plan.status : code, plan)
    }

    // The caching and range answer for a file, or null when the response is not a
    // plain 200 to a GET or HEAD request
    - fn file_plan_for(code: u16, info: fs.FileInfo, content_type: String, headers: ?Headers) ?FilePlan {
        if code != 200 : return null
        let context = this.request_context ?! return null
        let get = context.method.equals("GET")
        if !get && !context.method.equals("HEAD") : return null
        if isset(headers) && (headers.has("etag") || headers.has("last-modified") || headers.has("content-encoding")) : return null
        let h = context.headers()
        // Ranges are only defined for GET (RFC 9110 14.2)
        let range = get ? h.get("range") !? "" : ""
        return file_plan(info.size, info.modified_time, content_type, this.compress, h.get("if-none-match") !? "",
            h.get("if-modified-since") !? "", range, h.get("if-range") !? "", h.get("accept-encoding") !? "")
    }

    // Answers 304 or 416 for a file
    - fn send_file_status(plan: FilePlan, headers: ?Headers) {
        this.responded = true
        let out = this.output
        this.write_status_line(plan.status)
        if plan.status == 416 {
            out.write("Content-Type: text/plain\r\nContent-Length: 0\r\nContent-Range: bytes */")
            out.write_uint_ascii(plan.size)
            out.write("\r\n")
        } else {
            this.write_file_plan_headers(plan)
        }
        this.write_connection_header()
        this.write_headers(headers)
        out.write("\r\n")
    }

    - fn write_file_plan_headers(plan: FilePlan) {
        let out = this.output
        out.write("ETag: ")
        out.write(plan.etag)
        out.write("\r\nLast-Modified: ")
        out.write(plan.last_modified)
        out.write("\r\n")
        if plan.status != 304 : out.write("Accept-Ranges: bytes\r\n")
        if plan.vary && !plan.gzip : out.write("Vary: Accept-Encoding\r\n")
        if plan.status == 206 {
            out.write("Content-Range: bytes ")
            out.write_uint_ascii(plan.start)
            out.write("-")
            out.write_uint_ascii(plan.start + plan.length - 1)
            out.write("/")
            out.write_uint_ascii(plan.size)
            out.write("\r\n")
        }
    }

    /// Responds with status `code` and a body streamed from `reader`.
    ///
    /// `size` becomes the `Content-Length` and exactly `size` bytes are copied from the
    /// reader; a reader that ends early fails the response and closes the connection. A
    /// `Content-Type` in `headers` replaces `content_type`. With a `filename` the body is
    /// offered as a download under that name. The body is left out like `respond` leaves
    /// it out, and then the reader is not read.
    + fn send_stream(reader: io.Reader, size: uint, content_type: String ("application/octet-stream"), filename: ?String (null), headers: ?Headers (null), code: u16 (200)) {
        if this.responded : return
        if isset(headers) : content_type = headers.get("content-type") !? content_type
        this.stream_response(reader, size, content_type, filename, headers, code, null)
    }

    - fn stream_response(reader: io.Reader, size: uint, content_type: String, filename: ?String, headers: ?Headers, code: u16, plan: ?FilePlan) {
        this.responded = true

        let out = this.output
        let with_body = ResponseWriter.status_has_body(code) && !this.head
        if with_body && size > 0 {
            this.body_reader = reader
            this.body_left = size
        }

        this.write_status_line(code)
        out.write("Content-Type: ")
        out.write(response_header_value_is_safe(content_type) ? content_type : "application/octet-stream")
        out.write("\r\n")
        this.write_content_length(code, size)
        this.write_connection_header()
        if isset(plan) : this.write_file_plan_headers(plan)

        let has_disposition = isset(headers) && headers.has("content-disposition")
        if !has_disposition && isset(filename) && response_header_value_is_safe(filename) {
            out.write("Content-Disposition: attachment; filename=\"")
            write_response_quoted_header_value(out, filename)
            out.write("\"\r\n")
        }

        this.write_headers(headers)
        out.write("\r\n")
    }

    /// Returns the reason phrase for `code`, such as `Bad Request`.
    ///
    /// Covers the codes RFC 9110 defines plus 428, 429 and 431; any other code returns an
    /// empty string, which the status line allows.
    + static fn code_name(code: u16) String {
        if code == 100 : return "Continue"
        if code == 101 : return "Switching Protocols"
        if code == 200 : return "OK"
        if code == 201 : return "Created"
        if code == 202 : return "Accepted"
        if code == 203 : return "Non-Authoritative Information"
        if code == 204 : return "No Content"
        if code == 205 : return "Reset Content"
        if code == 206 : return "Partial Content"
        if code == 300 : return "Multiple Choices"
        if code == 301 : return "Moved Permanently"
        if code == 302 : return "Found"
        if code == 303 : return "See Other"
        if code == 304 : return "Not Modified"
        if code == 307 : return "Temporary Redirect"
        if code == 308 : return "Permanent Redirect"
        if code == 400 : return "Bad Request"
        if code == 401 : return "Unauthorized"
        if code == 402 : return "Payment Required"
        if code == 403 : return "Forbidden"
        if code == 404 : return "Not Found"
        if code == 405 : return "Method Not Allowed"
        if code == 406 : return "Not Acceptable"
        if code == 407 : return "Proxy Authentication Required"
        if code == 408 : return "Request Timeout"
        if code == 409 : return "Conflict"
        if code == 410 : return "Gone"
        if code == 411 : return "Length Required"
        if code == 412 : return "Precondition Failed"
        if code == 413 : return "Content Too Large"
        if code == 414 : return "URI Too Long"
        if code == 415 : return "Unsupported Media Type"
        if code == 416 : return "Range Not Satisfiable"
        if code == 417 : return "Expectation Failed"
        if code == 421 : return "Misdirected Request"
        if code == 422 : return "Unprocessable Content"
        if code == 426 : return "Upgrade Required"
        if code == 428 : return "Precondition Required"
        if code == 429 : return "Too Many Requests"
        if code == 431 : return "Request Header Fields Too Large"
        if code == 500 : return "Internal Server Error"
        if code == 501 : return "Not Implemented"
        if code == 502 : return "Bad Gateway"
        if code == 503 : return "Service Unavailable"
        if code == 504 : return "Gateway Timeout"
        if code == 505 : return "HTTP Version Not Supported"
        // An unlisted code has no phrase we can state truthfully; RFC 9112 §9 allows an
        // empty reason-phrase, so leave it blank rather than claiming "OK" on an error
        return ""
    }

    /// Responds with status `code`, `content_type` and `body`.
    ///
    /// A `Content-Type` in `headers` replaces `content_type`; `Content-Length` and
    /// `Transfer-Encoding` in `headers` are dropped, as are fields with invalid names or
    /// values. The body is left out for `1xx`, 204 and 304 responses and for a `HEAD`
    /// request; a `HEAD` response keeps the `Content-Length` of `body`, and 1xx and 204
    /// responses have no `Content-Length`.
    + fn send(body: local &[u8], code: u16 (200), content_type: String ("text/plain; charset=utf-8"), headers: ?Headers (null)) {
        if this.responded : return

        if isset(headers) : content_type = headers.get("content-type") !? content_type
        // A compressible response varies by Accept-Encoding, compressed or not
        let compressible = this.compress && ResponseWriter.status_has_body(code) && body.length >= GZIP_MIN_SIZE
            && response_gzip_type(content_type) && !(isset(headers) && headers.has("content-encoding"))
        if compressible && this.client_accepts_gzip() {
            this.send_encoded(compress.gzip(body), code, content_type, headers)
            return
        }
        this.responded = true

        let buf = this.output

        this.write_status_line(code)
        // A 1xx response has no body, so it names no content type either
        if code >= 200 {
            buf.write("Content-Type: ")
            buf.write(response_header_value_is_safe(content_type) ? content_type : "text/plain")
            buf.write("\r\n")
        }
        this.write_content_length(code, body.length)
        this.write_connection_header()
        if compressible : buf.write("Vary: Accept-Encoding\r\n")

        this.write_headers(headers)
        buf.write("\r\n")
        if ResponseWriter.status_has_body(code) && !this.head : buf.write(body)
    }

    // Sends a gzip-compressed body
    - fn send_encoded(body: String, code: u16, content_type: String, headers: ?Headers, plan: ?FilePlan (null)) {
        this.responded = true
        let buf = this.output
        this.write_status_line(code)
        buf.write("Content-Type: ")
        buf.write(response_header_value_is_safe(content_type) ? content_type : "text/plain")
        buf.write("\r\nContent-Encoding: gzip\r\nVary: Accept-Encoding\r\n")
        this.write_content_length(code, body.bytes)
        this.write_connection_header()
        if isset(plan) : this.write_file_plan_headers(plan)
        this.write_headers(headers)
        buf.write("\r\n")
        if !this.head : buf.write(body)
    }

    - fn client_accepts_gzip() bool {
        let context = this.request_context ?! return false
        return request_accepts_gzip(context.headers().get("accept-encoding") !? "")
    }

    // 1xx, 204 and 304 responses never carry a body (RFC 9110 §6.4.1)
    - static fn status_has_body(code: u16) bool {
        return code >= 200 && code != 204 && code != 304
    }

    - fn write_status_line(code: u16) {
        let buf = this.output
        if code == 200 {
            buf.write("HTTP/1.1 200 OK\r\n")
            return
        }
        buf.write("HTTP/1.1 ")
        buf.write_uint_ascii(code)
        buf.write(" ")
        buf.write(ResponseWriter.code_name(code))
        buf.write("\r\n")
    }

    // A HEAD or 304 response states the length the body would have had; 1xx and 204
    // responses must not send the field at all (RFC 9110 §8.6)
    - fn write_content_length(code: u16, size: uint) {
        if code < 200 || code == 204 : return
        let buf = this.output
        buf.write("Content-Length: ")
        buf.write_uint_ascii(size)
        buf.write("\r\n")
    }

    - fn write_connection_header() {
        if this.close : this.output.write("Connection: close\r\n")
        else if this.keep_alive : this.output.write("Connection: keep-alive\r\n")
    }

    // Writes the handler's headers. The writer computes Content-Type and
    // Content-Length itself (a handler's Content-Type is applied there, see
    // `respond` and `send_stream`), so those and Transfer-Encoding are skipped
    // here: emitting them twice would give two conflicting framing headers.
    // The same goes for `Connection` once the writer emits it itself.
    - fn write_headers(headers: ?Headers) {
        let buf = this.output
        if isset(headers) {
            each headers as v, k {
                if response_header_is_framing(k) : continue
                if (this.close || this.keep_alive) && k.equals_ignore_ascii_case("connection") : continue
                if !response_header_name_is_safe(k) || !response_header_value_is_safe(v) : continue
                buf.write(k)
                buf.write(": ")
                buf.write(v)
                buf.write("\r\n")
            }
        }
    }

    - fn count_bytes_to_send() uint {
        return this.output.length - this.output_pos
    }

    -+ fn should_send() bool {
        return this.count_bytes_to_send() > (128 * 1024) || this.body_reader != null
    }

    // Copies exactly `body_left` bytes: the Content-Length promised that many, so a
    // longer reader is cut off and a shorter one fails the response
    - fn copy_body(reader: io.Reader, writer: io.Writer) !HttpError {
        let left = this.body_left
        let chunk: uint = left < 65536 ? left : 65536
        let buf = [u8]{ 0 x chunk }
        while left > 0 {
            let amount = left < chunk ? left : chunk
            let count = reader.read(buf.view(0, amount)) !>
            if count == 0 || count > amount : throw .write
            let view = buf.view(0, count)
            while view.length > 0 {
                let written = writer.write(view) !>
                if written == 0 || written > view.length : throw .write
                view = view.view(written, view.length - written)
            }
            left -= count
            this.body_left = left
        }
    }

    -+ fn send_bytes(writer: io.Writer) !HttpError {
        let out = this.output
        let reader = this.body_reader

        while true {
            // Headers are flushed before the streamed body
            if isset(reader) {
                if this.count_bytes_to_send() == 0 {
                    this.copy_body(reader, writer) !>
                    this.body_reader = null
                    reader = null
                }
            }

            let pos = this.output_pos
            let bytes = out.length - pos
            if bytes == 0 : break

            writer.write(out.view(pos, out.length)) !>
            this.output_pos += bytes
        }
    }
}

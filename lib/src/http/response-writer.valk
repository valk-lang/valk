
use fs
use io
use core

fn response_header_is_framing(name: String) bool {
    return name.equal_ignore_ascii_case("content-type")
        || name.equal_ignore_ascii_case("content-length")
        || name.equal_ignore_ascii_case("transfer-encoding")
}

fn response_header_name_is_safe(name: String) bool {
    if name.bytes == 0 : return false
    each name as ch {
        if ch.is_alpha_numeric() : continue
        if ch == '!' || ch == '#' || ch == '$' || ch == '%' || ch == '&'
            || ch == '\'' || ch == '*' || ch == '+' || ch == '-' || ch == '.'
            || ch == '^' || ch == '_' || ch == '`' || ch == '|' || ch == '~': continue
        return false
    }
    return true
}

fn response_header_value_is_safe(value: String) bool {
    return !value.view().has_ascii_control(true)
}

fn write_response_quoted_header_value(out: ByteBuffer, value: String) {
    each value as ch {
        if ch == '"' || ch == '\\' : out.write_byte('\\')
        out.write_byte(ch)
    }
}

/// Writes the HTTP/1.1 response for one request; passed to `fast` handlers.
///
/// Only the first `respond`, `send_status`, `send_file` or `send_stream` call per request
/// has an effect; later calls are ignored. A fast handler that does not respond makes
/// the server answer 400 and close the connection. Output is buffered and sent by the
/// server after the handler returns.
+ class ResponseWriter {
    - output: ByteBuffer (ByteBuffer.new(1024))
    - file_response: ?fs.FileStream
    - body_reader: ?io.Reader
    /// Whether a response has been written for the current request.
    ~ responded: bool (false)
    // Emits `Connection: close`; set by the server when it closes the
    // connection after this response (draining, error responses)
    -+ close: bool (false)
    // Emits `Connection: keep-alive`: an HTTP/1.0 client only keeps the
    // connection open when the response says so
    -+ keep_alive: bool (false)
    - output_pos: uint (0)

    -+ fn reset() {
        this.output.clear()
        this.output.shrink_capacity(2048)
        this.output_pos = 0
        this.body_reader = null

        let file = this.file_response
        if isset(file) {
            file.close() ! core.cleanup_warning("Failed to close HTTP response file", __FILE__, __LINE__)
            this.file_response = null
        }
    }

    -+ fn allow_new_response() {
        this.responded = false
    }

    fn send_response(resp: Response) {
        if this.responded : return

        let filepath = resp.filepath
        if isset(filepath) {
            this.send_file(filepath, resp.filename, resp.header_list)
            return
        }
        let reader = resp.stream_reader
        if isset(reader) {
            this.send_stream(reader, resp.stream_size, resp.content_type, resp.filename, resp.header_list)
            return
        }

        this.respond(resp.status, resp.content_type, resp.body, resp.header_list)
    }

    /// Responds with `status_code` and an empty `text/plain` body.
    + fn send_status(status_code: uint) {
        this.respond(status_code, "text/plain", "")
    }

    /// Responds with status `code` and the file at `path`; responds 404 when it cannot
    /// be opened.
    ///
    /// The content type follows from the file extension, unless `headers` has a
    /// `Content-Type`. With a `filename` the file is offered as a download under that
    /// name.
    + fn send_file(path: String, filename: ?String (null), headers: ?Headers (null)) {
        if this.responded : return

        let stream = fs.stream(path) ! {
            this.respond(404, "text/plain", "", headers)
            return
        }
        let fsize = fs.size(path) ! {
            stream.close() ! core.cleanup_warning("Failed to close HTTP response file", __FILE__, __LINE__)
            this.respond(404, "text/plain", "", headers)
            return
        }

        this.file_response = stream
        this.send_stream(stream, fsize, fs.mime_type(fs.extension(path)), filename, headers)
    }

    /// Responds with status `code` and a body streamed from `reader`.
    ///
    /// `size` becomes the `Content-Length`; the reader is copied until it ends, so it must
    /// yield exactly `size` bytes. A `Content-Type` in `headers` replaces `content_type`.
    /// With a `filename` the body is offered as a download under that name.
    + fn send_stream(reader: io.Reader, size: uint, content_type: String ("application/octet-stream"), filename: ?String (null), headers: ?Headers (null)) {
        if this.responded : return
        this.responded = true

        let out = this.output
        this.body_reader = reader

        if isset(headers) : content_type = headers.get("content-type") !? content_type

        out.write("HTTP/1.1 200 OK\r\nContent-Type: ")
        out.write(response_header_value_is_safe(content_type) ? content_type : "application/octet-stream")
        out.write("\r\nContent-Length: ")
        out.write_uint_ascii(size)
        out.write("\r\n")
        this.write_connection_header()

        let has_disposition = isset(headers) && headers.has("content-disposition")
        if !has_disposition && isset(filename) && response_header_value_is_safe(filename) {
            out.write("Content-Disposition: attachment; filename=\"")
            write_response_quoted_header_value(out, filename)
            out.write("\"\r\n")
        }

        this.write_headers(headers)
        out.write("\r\n")
    }

    /// Returns the reason phrase for `code`, such as `Bad Request`.
    ///
    /// Only 200, 301, 302, 303, 307, 308, 400, 413, 501 and 503 have a phrase; every
    /// other code, 404 included, returns an empty string.
    + static fn code_name(code: uint) String {
        if code == 200 : return "OK"
        if code == 301 : return "Moved Permanently"
        if code == 302 : return "Found"
        if code == 303 : return "See Other"
        if code == 307 : return "Temporary Redirect"
        if code == 308 : return "Permanent Redirect"
        if code == 400 : return "Bad Request"
        if code == 413 : return "Content Too Large"
        if code == 501 : return "Not Implemented"
        if code == 503 : return "Service Unavailable"
        // An unlisted code has no phrase we can state truthfully. The grammar
        // allows an empty reason-phrase (RFC 9112 §9), which is what callers
        // parse around anyway, so leave it blank rather than claiming "OK" on
        // an error: 404 used to be written as "HTTP/1.1 404 OK".
        return ""
    }

    /// Responds with status `code`, `content_type` and `body`.
    ///
    /// A `Content-Type` in `headers` replaces `content_type`; `Content-Length` and
    /// `Transfer-Encoding` in `headers` are dropped, as are fields with invalid names or
    /// values. The body is left out for `1xx`, 204 and 304 responses and for a `HEAD`
    /// request; a `HEAD` response keeps the `Content-Length` of `body`, and 1xx and 204
    /// responses have no `Content-Length`.
    + fn respond(code: uint, content_type: String, body: String, headers: ?Headers (null)) {
        if this.responded : return
        this.responded = true

        let buf = this.output

        if isset(headers) : content_type = headers.get("content-type") !? content_type

        if code == 200 {
            buf.write("HTTP/1.1 200 OK\r\nContent-Type: ")
        } else {
            buf.write("HTTP/1.1 ")
            buf.write_uint_ascii(code)
            buf.write(" ")
            buf.write(ResponseWriter.code_name(code))
            buf.write("\r\nContent-Type: ")
        }
        buf.write(response_header_value_is_safe(content_type) ? content_type : "text/plain")
        buf.write("\r\nContent-Length: ")
        buf.write_uint_ascii(body.bytes)
        buf.write("\r\n")
        this.write_connection_header()

        this.write_headers(headers)
        buf.write("\r\n")
        buf.write(body)
    }

    - fn write_connection_header() {
        if this.close : this.output.write("Connection: close\r\n")
        else if this.keep_alive : this.output.write("Connection: keep-alive\r\n")
    }

    // Writes the handler's headers. The writer computes Content-Type and
    // Content-Length itself (a handler's Content-Type is applied there, see
    // `respond` and `send_stream`), so those and Transfer-Encoding are skipped
    // here: emitting them twice would give two conflicting framing headers.
    // The same goes for `Connection` once the writer emits it itself.
    - fn write_headers(headers: ?Headers) {
        let buf = this.output
        if isset(headers) {
            each headers as v, k {
                if response_header_is_framing(k) : continue
                if (this.close || this.keep_alive) && k.equal_ignore_ascii_case("connection") : continue
                if !response_header_name_is_safe(k) || !response_header_value_is_safe(v) : continue
                buf.write(k)
                buf.write(": ")
                buf.write(v)
                buf.write("\r\n")
            }
        }
    }

    - fn count_bytes_to_send() uint {
        return this.output.length - this.output_pos
    }

    -+ fn should_send() bool {
        return this.count_bytes_to_send() > (128 * 1024) || this.body_reader != null
    }

    -+ fn send_bytes(writer: io.Writer) !HttpError {
        let out = this.output
        let reader = this.body_reader

        while true {
            // Headers are flushed before the streamed body
            if isset(reader) {
                if this.count_bytes_to_send() == 0 {
                    io.copy(reader, writer) !>
                    this.body_reader = null
                    this.file_response = null
                    reader = null
                }
            }

            let pos = this.output_pos
            let bytes = out.length - pos
            if bytes == 0 : break

            writer.write(out.view(pos, out.length)) !>
            this.output_pos += bytes
        }
    }
}

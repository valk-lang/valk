
use fs
use io
use core

fn response_header_name_is_safe(name: String) bool {
    if name.bytes == 0 : return false
    each name as ch {
        if ch.is_alpha_numeric() : continue
        if ch == '!' || ch == '#' || ch == '$' || ch == '%' || ch == '&'
            || ch == '\'' || ch == '*' || ch == '+' || ch == '-' || ch == '.'
            || ch == '^' || ch == '_' || ch == '`' || ch == '|' || ch == '~': continue
        return false
    }
    return true
}

fn response_header_value_is_safe(value: String) bool {
    each value as ch {
        if ch == '\t' : continue
        if ch < 32 || ch == 127 : return false
    }
    return true
}

fn response_header_line_is_safe(line: String) bool {
    let split = line.index_of(":") ! return false
    return response_header_name_is_safe(line.part(0, split))
        && response_header_value_is_safe(line.part(split + 1, line.bytes - split - 1))
}

fn write_response_quoted_header_value(out: ByteBuffer, value: String) {
    each value as ch {
        if ch == '"' || ch == '\\' : out.write_byte('\\')
        out.write_byte(ch)
    }
}

+ class ResponseWriter {
    - output: ByteBuffer (ByteBuffer.new(1024))
    - file_response: ?fs.FileStream
    - body_reader: ?io.Reader
    ~ responded: bool (false)
    - output_pos: uint (0)

    -+ fn reset() {
        this.output.clear()
        this.output.shrink_capacity(2048)
        this.output_pos = 0
        this.body_reader = null

        let file = this.file_response
        if isset(file) {
            file.close() ! core.cleanup_warning("Failed to close HTTP response file", __FILE__, __LINE__)
            this.file_response = null
        }
    }

    -+ fn allow_new_response() {
        this.responded = false
    }

    fn send_response(resp: Response) {
        if this.responded : return

        let filepath = resp.filepath
        if isset(filepath) {
            this.send_file(filepath, resp.filename)
            return
        }
        let reader = resp.stream_reader
        if isset(reader) {
            this.send_stream(reader, resp.stream_size, resp.content_type, resp.filename)
            return
        }

        this.respond(resp.status, resp.content_type, resp.body, resp.headers, resp.extra_headers)
    }

    + fn send_status(status_code: uint) {
        this.respond(status_code, "text/plain", "")
    }

    + fn send_file(path: String, custom_filename: ?String (null)) {
        if this.responded : return

        let stream = fs.stream(path) ! {
            this.respond(404, "text/plain", "", null)
            return
        }
        this.send_file_stream(stream, custom_filename)
    }

    + fn send_file_stream(stream: fs.FileStream, filename: ?String (null)) {
        if this.responded : return

        let path = stream.path
        let fsize = fs.size(path) ! {
            stream.close() ! core.cleanup_warning("Failed to close HTTP response file", __FILE__, __LINE__)
            this.respond(404, "text/plain", "", null)
            return
        }
        let mime = fs.mime_type(fs.extension(path))

        this.file_response = stream
        this.send_stream(stream, fsize, mime, filename)
    }

    // Streams `size` bytes from `reader` as the response body
    + fn send_stream(reader: io.Reader, size: uint, content_type: String ("application/octet-stream"), filename: ?String (null)) {
        if this.responded : return
        this.responded = true

        let out = this.output
        this.body_reader = reader

        out.write("HTTP/1.1 200 OK\r\nContent-Type: ")
        out.write(response_header_value_is_safe(content_type) ? content_type : "application/octet-stream")
        out.write("\r\nContent-Length: ")
        out.write_uint_ascii(size)
        out.write("\r\n")

        if isset(filename) && response_header_value_is_safe(filename) {
            out.write("Content-Disposition: attachment; filename=\"")
            write_response_quoted_header_value(out, filename)
            out.write("\"\r\n")
        }

        out.write("\r\n")
    }

    + static fn code_name(code: uint) String {
        if code == 200 : return "OK"
        if code == 301 : return "Moved Permanently"
        if code == 302 : return "Found"
        if code == 303 : return "See Other"
        if code == 307 : return "Temporary Redirect"
        if code == 308 : return "Permanent Redirect"
        if code == 400 : return "Bad Request"
        if code == 413 : return "Content Too Large"
        if code == 501 : return "Not Implemented"
        if code == 503 : return "Service Unavailable"
        // An unlisted code has no phrase we can state truthfully. The grammar
        // allows an empty reason-phrase (RFC 9112 §9), which is what callers
        // parse around anyway, so leave it blank rather than claiming "OK" on
        // an error: 404 used to be written as "HTTP/1.1 404 OK".
        return ""
    }

    + fn respond(code: uint, content_type: String, body: String, headers: ?Map[String] (null), extra_headers: ?Array[String] (null)) {
        if this.responded : return
        this.responded = true

        let buf = this.output

        buf.write("HTTP/1.1 ")
        buf.write_uint_ascii(code)
        buf.write(" ")
        buf.write(ResponseWriter.code_name(code))
        buf.write("\r\n")

        buf.write("Content-Type: ")
        buf.write(response_header_value_is_safe(content_type) ? content_type : "text/plain")
        buf.write("\r\n")

        buf.write("Content-Length: ")
        buf.write_uint_ascii(body.bytes)
        buf.write("\r\n")

        if isset(headers) {
            each headers as v, k {
                if !response_header_name_is_safe(k) || !response_header_value_is_safe(v) : continue
                buf.write(k)
                buf.write(": ")
                buf.write(v)
                buf.write("\r\n")
            }
        }

        if isset(extra_headers) {
            each extra_headers as v, k {
                if !response_header_line_is_safe(v) : continue
                buf.write(v)
                buf.write("\r\n")
            }
        }

        buf.write("\r\n")
        buf.write(body)
    }

    - fn count_bytes_to_send() uint {
        return this.output.length - this.output_pos
    }

    -+ fn should_send() bool {
        return this.count_bytes_to_send() > (128 * 1024) || this.body_reader != null
    }

    -+ fn send_bytes(writer: io.Writer) !HttpError {
        let out = this.output
        let reader = this.body_reader

        while true {
            // Headers are flushed before the streamed body
            if isset(reader) {
                if this.count_bytes_to_send() == 0 {
                    io.copy(reader, writer) !>
                    this.body_reader = null
                    this.file_response = null
                    reader = null
                }
            }

            let pos = this.output_pos
            let bytes = out.length - pos
            if bytes == 0 : break

            writer.write(out.view(pos, out.length)) !>
            this.output_pos += bytes
        }
    }
}

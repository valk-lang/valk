
// HTTP/3 framing (RFC 9114) and QUIC variable-length integers (RFC 9000 §16).

value H3_FRAME_DATA (0x00)
value H3_FRAME_HEADERS (0x01)
value H3_FRAME_CANCEL_PUSH (0x03)
value H3_FRAME_SETTINGS (0x04)
value H3_FRAME_PUSH_PROMISE (0x05)
value H3_FRAME_GOAWAY (0x07)
value H3_FRAME_MAX_PUSH_ID (0x0d)

value H3_STREAM_CONTROL (0x00)
value H3_STREAM_PUSH (0x01)
value H3_STREAM_QPACK_ENCODER (0x02)
value H3_STREAM_QPACK_DECODER (0x03)

value H3_SETTING_QPACK_MAX_TABLE_CAPACITY (0x01)
value H3_SETTING_MAX_FIELD_SECTION_SIZE (0x06)
value H3_SETTING_QPACK_BLOCKED_STREAMS (0x07)

value H3_ERR_NO_ERROR (0x0100)
value H3_ERR_GENERAL_PROTOCOL_ERROR (0x0101)
value H3_ERR_INTERNAL_ERROR (0x0102)
value H3_ERR_STREAM_CREATION_ERROR (0x0103)
value H3_ERR_CLOSED_CRITICAL_STREAM (0x0104)
value H3_ERR_FRAME_UNEXPECTED (0x0105)
value H3_ERR_FRAME_ERROR (0x0106)
value H3_ERR_EXCESSIVE_LOAD (0x0107)
value H3_ERR_ID_ERROR (0x0108)
value H3_ERR_SETTINGS_ERROR (0x0109)
value H3_ERR_MISSING_SETTINGS (0x010a)
value H3_ERR_REQUEST_REJECTED (0x010b)
value H3_ERR_REQUEST_CANCELLED (0x010c)
value H3_ERR_REQUEST_INCOMPLETE (0x010d)
value H3_ERR_MESSAGE_ERROR (0x010e)
value H3_ERR_CONNECT_ERROR (0x010f)
value H3_ERR_QPACK_DECOMPRESSION_FAILED (0x0200)

value H3_VARINT_MAX (4_611_686_018_427_387_903)

fn h3_varint_size(v: u64) uint $inline {
    if v < 64 : return 1
    if v < 16_384 : return 2
    if v < 1_073_741_824 : return 4
    return 8
}

fn h3_varint_write(out: ByteBuffer, v: u64) {
    if v < 64 {
        out.write_byte(v.to(u8))
        return
    }
    if v < 16_384 {
        out.reserve(2)
        out.write_byte((0x40 | ((v >> 8) & 0x3f)).to(u8))
        out.write_byte((v & 0xff).to(u8))
        return
    }
    if v < 1_073_741_824 {
        out.reserve(4)
        out.write_byte((0x80 | ((v >> 24) & 0x3f)).to(u8))
        out.write_byte(((v >> 16) & 0xff).to(u8))
        out.write_byte(((v >> 8) & 0xff).to(u8))
        out.write_byte((v & 0xff).to(u8))
        return
    }
    out.reserve(8)
    out.write_byte((0xc0 | ((v >> 56) & 0x3f)).to(u8))
    out.write_byte(((v >> 48) & 0xff).to(u8))
    out.write_byte(((v >> 40) & 0xff).to(u8))
    out.write_byte(((v >> 32) & 0xff).to(u8))
    out.write_byte(((v >> 24) & 0xff).to(u8))
    out.write_byte(((v >> 16) & 0xff).to(u8))
    out.write_byte(((v >> 8) & 0xff).to(u8))
    out.write_byte((v & 0xff).to(u8))
}

// Returns `(ok, value, next_pos)`; `ok == false` when more bytes are needed.
fn h3_varint_try_read(data: local &[u8], pos: uint) (bool, u64, uint) {
    let len = data.length
    if pos >= len : return (false, 0, pos)
    let first = data[pos]
    let tag = first >> 6
    let need: uint = 1 << tag.to(uint)
    if len - pos < need : return (false, 0, pos)
    let v: u64 = (first & 0x3f).to(u64)
    let i: uint = 1
    while i < need {
        v = (v << 8) | data[pos + i].to(u64)
        i++
    }
    return (true, v, pos + need)
}

fn h3_write_frame_header(out: ByteBuffer, frame_type: u64, payload_len: u64) $inline {
    h3_varint_write(out, frame_type)
    h3_varint_write(out, payload_len)
}

fn h3_write_control_settings(out: ByteBuffer, max_field_section_size: uint) {
    h3_varint_write(out, H3_STREAM_CONTROL)
    if max_field_section_size > 0 && max_field_section_size < uint.$max {
        let id = H3_SETTING_MAX_FIELD_SECTION_SIZE.to(u64)
        let val = max_field_section_size.to(u64)
        let plen = h3_varint_size(id) + h3_varint_size(val)
        h3_write_frame_header(out, H3_FRAME_SETTINGS, plen.to(u64))
        h3_varint_write(out, id)
        h3_varint_write(out, val)
    } else {
        h3_write_frame_header(out, H3_FRAME_SETTINGS, 0)
    }
}

fn h3_write_goaway(out: ByteBuffer, stream_id: u64) {
    let plen = h3_varint_size(stream_id)
    h3_write_frame_header(out, H3_FRAME_GOAWAY, plen.to(u64))
    h3_varint_write(out, stream_id)
}

// RFC 9114 §7.2.4.1 forbids these HTTP/2-only setting identifiers in HTTP/3.
fn h3_is_forbidden_setting(id: u64) bool $inline {
    return id == 0x02 || id == 0x03 || id == 0x04 || id == 0x05
}

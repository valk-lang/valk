
use net
use io
use crypto
use url
use time
use core
use sync
use compress

/// Thrown by `WebSocket` methods.
///
/// - `protocol`: the peer sent a frame that breaks RFC 6455 (bad opcode, a fragmented or
///   oversized control frame, a text message that is not UTF-8, a missing or unexpected
///   mask). The connection is closed with code 1002 or 1007.
/// - `too_large`: a message exceeds `max_message_size`; closed with code 1009.
/// - `handshake`: the server did not accept the upgrade, or its answer is not a valid
///   WebSocket handshake.
/// - `invalid_url`: `connect` was given a URL that is not `ws://` or `wss://`.
/// - `invalid_request`: an extra header given to `connect` is unsafe to send or one the
///   client sets itself.
///
/// Also carries every `net.NetError` and `io.IoError` code: `closed` once the connection is
/// closed, from either side, `ssl` for a failed `wss://` handshake, and `timeout`,
/// `cancelled`, `read` and `write` from the socket.
error WebSocketError (protocol, too_large, handshake, invalid_url, invalid_request) extends(net.NetError)

/// The kind of a WebSocket message.
+ enum WebSocketMessageType {
    text
    binary
}

/// One complete message received over a `WebSocket`.
+ class WebSocketMessage {
    /// Whether the message is text or binary.
    + type: WebSocketMessageType
    /// The message payload; valid UTF-8 for a text message.
    + data: String

    /// Whether this is a text message.
    + get is_text: bool {
        return this.type == WebSocketMessageType.text
    }
}

value WS_OP_CONTINUATION (0)
value WS_OP_TEXT (1)
value WS_OP_BINARY (2)
value WS_OP_CLOSE (8)
value WS_OP_PING (9)
value WS_OP_PONG (10)
value WS_GUID ("258EAFA5-E914-47DA-95CA-C5AB0DC85B11")
value WS_READ_SIZE (16384)
value WS_DEFAULT_MAX_MESSAGE_SIZE (16 * 1024 * 1024)
// permessage-deflate defaults: the level, and the size below which messages go uncompressed
value WS_COMPRESS_LEVEL (6)
value WS_COMPRESS_MIN_SIZE (256)
// Room in front of an outgoing payload for the longest frame header
value WS_HEADER_ROOM (14)
// Bytes queued behind a pending write before further writes wait for it
value WS_MAX_QUEUE (4 * 1024 * 1024)
// Frames per vectored write: `send_parts_now` takes 64 parts per call
value WS_MAX_PARTS (64)
value WS_DEFLATE_TAIL ("\x00\x00\xff\xff")

/// A WebSocket connection (RFC 6455), on the server or the client side.
///
/// A server gets one from `WebSocket.upgrade`, a client from `WebSocket.connect`. `read`
/// returns whole messages and answers pings by itself; `write` and `write_binary` send
/// one message each. Reads and writes may run on different coroutines, so one coroutine
/// can wait for messages while another sends. On Linux and macOS a write without TLS does
/// not wait for a slow peer: what the socket cannot take yet is queued and sent in the
/// background (a write waits once 4 MB are queued); when that fails the connection closes
/// and later calls throw `closed`.
/// `close` performs the closing handshake.
///
/// ```valk
/// fn handler(req: http.Request) http.Response {
///     return http.WebSocket.upgrade(req, fn(ws: http.WebSocket) {
///         while true {
///             let msg = ws.read() ! break
///             ws.write(msg.data) ! break
///         }
///     })
/// }
/// ```
+ class WebSocket {
    - con: net.TcpConnection
    - input: ByteBuffer
    - fragments: ByteBuffer (ByteBuffer.new(0))
    - output: ByteBuffer (ByteBuffer.new(0))
    // Decompressed messages; with `inflate_takeover` it keeps the last 32 KiB as history
    - inflated: ByteBuffer (ByteBuffer.new(0))
    // permessage-deflate (RFC 7692): the window bits for messages sent, 0 when not negotiated
    - deflate_bits: uint (0)
    -+ deflate_level: uint (WS_COMPRESS_LEVEL)
    -+ deflate_min_size: uint (WS_COMPRESS_MIN_SIZE)
    - inflate_takeover: bool (false)
    - message_compressed: bool (false)
    - fragment_opcode: uint (0)
    - in_fragment: bool (false)
    - is_client: bool
    // A write owns the socket; others append to `queue`, which it sends next
    - writing: bool (false)
    - queue: ByteBuffer (ByteBuffer.new(0))
    - sending: ByteBuffer (ByteBuffer.new(0))
    - max_queue: uint (WS_MAX_QUEUE)
    - close_sent: bool (false)
    - closed: bool (false)
    /// The largest message accepted, in bytes (after decompression); a larger one closes
    /// the connection with code 1009. Defaults to 16 MB.
    + max_message_size: uint (WS_DEFAULT_MAX_MESSAGE_SIZE)
    /// The close code received from the peer, or the one sent when this side closed
    /// first; 0 while open, 1006 when the connection dropped without a close frame.
    ~ close_code: u16 (0)
    /// The close reason that came with `close_code`.
    ~ close_reason: String ("")
    /// The subprotocol agreed in the handshake (`Sec-WebSocket-Protocol`), or "" for none.
    ~ protocol: String ("")

    /// Whether the connection is closed, from either side.
    + get is_closed: bool {
        return this.closed
    }

    #if TEST
    /// Test hook: writes wait once `bytes` are queued, and the socket buffers little.
    + fn limit_queue_for_test(bytes: uint) {
        this.max_queue = bytes
        this.con.set_send_buffer(4096) ! {}
    }
    #end

    /// The address of the peer.
    + fn peer_address() net.SocketAddress !net.NetError {
        return this.con.peer_address() !>
    }

    /// Sets the socket timeouts in milliseconds; 0 waits forever.
    ///
    /// A server socket starts with no read timeout and a 5 second write timeout; a client
    /// socket starts with the timeouts of the `Options` it was connected with.
    + fn set_timeouts(read_timeout_ms: uint, write_timeout_ms: uint) {
        this.con.set_timeouts(read_timeout_ms, write_timeout_ms)
    }

    /// Makes a blocked `read` or `write` fail with `cancelled` when `token` is cancelled.
    + fn set_cancel(token: shared sync.CancelToken) {
        this.con.set_cancel(token)
    }

    // ---- Handshake -------------------------------------------------------------------

    /// Answers a server request with the WebSocket upgrade, then runs `handler` on the
    /// connection.
    ///
    /// The handler runs on the connection's coroutine after the `101` response is sent;
    /// the connection is closed when it returns. A request that is not a valid WebSocket
    /// upgrade (RFC 6455 §4.2.1) gets a `400` response instead and the handler never
    /// runs. `Server.request_shutdown` interrupts the socket, so a blocked `read` then
    /// fails with `closed`. Not available over HTTP/2.
    ///
    /// When the client offers permessage-deflate (RFC 7692), `compression` accepts or
    /// declines it for this endpoint; null follows `Server.websocket_compression` (off).
    ///
    /// `protocol` is the subprotocol to answer with: it is sent back in
    /// `Sec-WebSocket-Protocol` when the client offered it, and left out otherwise (see
    /// `WebSocket.protocol`). `headers` adds response fields such as `Set-Cookie`; fields
    /// the handshake sets itself are ignored there.
    + static fn upgrade(req: Request, handler: fn(WebSocket)(), compression: ?bool (null), protocol: ?String (null), headers: ?Headers (null)) Response {
        let request_headers = req.headers()
        let accept = websocket_accept_key(req.method, request_headers)
        if !isset(accept) : return Response.new("Expected a WebSocket upgrade request", 400)
        let response = Response.new("", 101)
        websocket_upgrade_headers(response.headers, accept, request_headers, protocol, headers)
        response.websocket_handler = handler
        response.websocket_compression = compression
        return response
    }

    /// Connects to a `ws://` or `wss://` server and completes the opening handshake.
    ///
    /// `options` supplies extra request headers (for example `Origin` or a cookie), the
    /// TLS settings for `wss://` and the timeouts: `connect_timeout_ms` bounds the
    /// connection, `timeout_ms` the whole handshake, and `read_timeout_ms` /
    /// `write_timeout_ms` become the socket timeouts afterwards. Throws `invalid_url`,
    /// `handshake` when the server answers anything but a matching `101` or picks a
    /// `Sec-WebSocket-Protocol` or extension the request did not offer, and the
    /// socket's `timeout`, `closed`, `read` and `write`. Messages are compressed with
    /// permessage-deflate when the server accepts it; `Options.websocket_compression`
    /// turns the offer off.
    + static fn connect(url: String, options: ?Options (null)) SELF !WebSocketError {
        let u = url.parse(url)
        if u.scheme != "ws" && u.scheme != "wss" : throw .invalid_url
        if !request_host_is_safe(u.host) || u.host.bytes == 0 : throw .invalid_url
        if u.user.bytes > 0 || u.password.bytes > 0 : throw .invalid_url
        let is_tls = u.scheme == "wss"
        let port: u16 = is_tls ? 443 : 80
        let parsed_port = u.port
        if isset(parsed_port) {
            if parsed_port == 0 || parsed_port > 65535 : throw .invalid_url
            port = parsed_port.to(u16)
        }

        let connect_timeout_ms: uint = 5000
        let read_timeout_ms: uint = 5000
        let write_timeout_ms: uint = 5000
        let deadline_ms: uint = 0
        if isset(options) {
            connect_timeout_ms = options.connect_timeout_ms
            read_timeout_ms = options.read_timeout_ms
            write_timeout_ms = options.write_timeout_ms
            if options.timeout_ms > 0 : deadline_ms = time.deadline_ms(options.timeout_ms)
        }

        // Build the request before opening a socket, so a bad header costs no connection
        let key = crypto.base64_encode(crypto.random_bytes(16))
        let deflate_offer = websocket_deflate_offer(options)
        let request = websocket_client_request(u, port, is_tls, key, options, deflate_offer) !>

        let connect_deadline_ms = ClientRequest.operation_deadline(deadline_ms, connect_timeout_ms)
        let con = net.tcp_client(u.host, port, websocket_remaining(connect_deadline_ms, 0) !>) !>
        con.set_timeouts(read_timeout_ms, write_timeout_ms)

        if is_tls {
            let ssl = net.Ssl.new()
            ClientRequest.configure_ssl(ssl, options) ! {
                websocket_close_socket(con)
                throw .ssl
            }
            con.ssl_connect(ssl, websocket_remaining(connect_deadline_ms, 0) !>) ! {
                websocket_close_socket(con)
                if error_is(E.code, timeout) : throw .timeout
                throw .ssl
            }
        }

        // Send the handshake
        con.write_timeout_ms = websocket_remaining(deadline_ms, write_timeout_ms) ! { websocket_close_socket(con); throw E }
        con.write(request) ! {
            websocket_close_socket(con)
            throw E
        }

        // Read the answer; bytes after the head already belong to the frame stream
        let input = ByteBuffer.new(2048)
        let context = Context.new(input)
        while true {
            con.read_timeout_ms = websocket_remaining(deadline_ms, read_timeout_ms) ! { websocket_close_socket(con); throw E }
            input.reserve(WS_READ_SIZE)
            let bytes = con.read(input.view_spare(WS_READ_SIZE)) ! {
                websocket_close_socket(con)
                throw E
            }
            input.skip(bytes)
            parse_http(input, context, true, 8192, 0) ! {
                if E.code == E.incomplete : continue
                websocket_close_socket(con)
                throw .handshake
            }
            break
        }
        if context.status != 101 {
            websocket_close_socket(con)
            throw .handshake
        }
        let headers = context.headers()
        let upgrade = headers.get("upgrade") !? ""
        let connection = headers.get("connection") !? ""
        let accept = headers.get("sec-websocket-accept") !? ""
        if !upgrade.equals_ignore_ascii_case("websocket")
            || !websocket_header_has_token(connection, "upgrade")
            || accept != websocket_accept_value(key) {
            websocket_close_socket(con)
            throw .handshake
        }
        // A subprotocol or extension the request did not offer fails the connection
        // (RFC 6455 §4.1)
        let protocol = (headers.get("sec-websocket-protocol") !? "").trim(" ")
        if protocol.bytes > 0 && !websocket_header_has_token(websocket_offered(options, "sec-websocket-protocol"), protocol) {
            websocket_close_socket(con)
            throw .handshake
        }
        let offered_extensions = websocket_offered(options, "sec-websocket-extensions")
        if deflate_offer.bytes > 0 : offered_extensions = deflate_offer
        let deflate: ?WebSocketDeflateParams = null
        each headers.get_all("sec-websocket-extensions") as value {
            each value.split(",") as extension {
                let name = extension.split(";")[0].trim(" ")
                if name.bytes > 0 && !websocket_extension_offered(offered_extensions, name) {
                    websocket_close_socket(con)
                    throw .handshake
                }
                if name.equals_ignore_ascii_case("permessage-deflate") {
                    // Accepted once, with parameters a response may carry (RFC 7692 §7.1)
                    let params = websocket_deflate_params(extension)
                    if isset(deflate) || !isset(params) || (params.client_bits_given && params.client_bits == 0) {
                        websocket_close_socket(con)
                        throw .handshake
                    }
                    deflate = params
                }
            }
        }

        let rest = ByteBuffer.new(WS_READ_SIZE)
        let leftover = context.parsed_index
        if leftover < input.length : rest.write(input.view(leftover, input.length - leftover))
        con.set_timeouts(read_timeout_ms, write_timeout_ms)
        let ws = SELF { con: con, input: rest, is_client: true, protocol: protocol }
        if isset(deflate) {
            ws.deflate_bits = deflate.client_bits > 0 ? deflate.client_bits : 15
            ws.inflate_takeover = !deflate.server_no_takeover
        }
        if isset(options) {
            ws.deflate_level = options.websocket_compression_level
            ws.deflate_min_size = options.websocket_compression_min_size
        }
        return ws
    }

    // Wraps an upgraded server connection; `leftover` holds bytes received after the
    // request head, `deflate_bits` the negotiated permessage-deflate window (0: none)
    static fn from_server(con: net.TcpConnection, leftover: local &[u8], deflate_bits: uint, protocol: String) SELF {
        let input = ByteBuffer.new(WS_READ_SIZE)
        input.write(leftover)
        con.set_timeouts(0, 5000)
        return SELF { con: con, input: input, is_client: false, deflate_bits: deflate_bits, protocol: protocol }
    }

    // ---- Sending ---------------------------------------------------------------------

    /// Sends `text` as one text message; the bytes must be UTF-8.
    + fn write(text: local &[u8]) !WebSocketError {
        this.send_frame(WS_OP_TEXT, text) !>
    }

    /// Sends `data` as one binary message.
    + fn write_binary(data: local &[u8]) !WebSocketError {
        this.send_frame(WS_OP_BINARY, data) !>
    }

    /// Sends a message prepared with `WebSocketFrame`, for sending one message to many
    /// connections.
    ///
    /// A server connection writes the frame's bytes as they are, compressed when the
    /// connection negotiated permessage-deflate; a client connection masks a copy.
    + fn write_frame(frame: shared WebSocketFrame) !WebSocketError {
        let bytes = frame.bytes_for(this.deflate_bits, this.deflate_level, this.deflate_min_size)
        this.wait_for_room() !>
        if !this.is_client {
            this.write_out(.{ bytes }) !>
            return
        }
        let head = websocket_frame_head_size(bytes)
        let out = this.output
        out.clear()
        out.skip(WS_HEADER_ROOM)
        out.write(bytes.view(head, bytes.bytes - head))
        this.finish_frame(bytes.get(0).to(uint), bytes.bytes - head, "") !>
    }

    /// Sends several prepared messages in order, as `write_frame` does one by one.
    ///
    /// A server connection hands them to the socket together, with one system call for up
    /// to 64 frames on Linux and macOS, as when a connection's writer finds several
    /// messages waiting.
    + fn write_frames(frames: local &[shared WebSocketFrame]) !WebSocketError {
        if this.closed : throw .closed
        if this.is_client {
            each frames as frame : this.write_frame(frame) !>
            return
        }
        let parts: [&[u8] x WS_MAX_PARTS] = @undefined
        let count: uint = 0
        each frames as frame, i {
            parts[count] = frame.bytes_for(this.deflate_bits, this.deflate_level, this.deflate_min_size)
            count++
            if count == WS_MAX_PARTS || i + 1 == frames.length {
                this.wait_for_room() !>
                this.write_out(&parts[0 .. count]) !>
                count = 0
            }
        }
    }

    /// Sends a ping; the peer answers with a pong that `read` consumes.
    ///
    /// `data` is at most 125 bytes.
    + fn ping(data: String ("")) !WebSocketError {
        if data.bytes > 125 : throw .protocol
        this.send_frame(WS_OP_PING, data) !>
    }

    /// Performs the closing handshake and closes the socket.
    ///
    /// Sends a close frame with `code` and `reason` (at most 123 bytes), waits up to
    /// `timeout_ms` for the peer's close frame, and closes the socket either way. Does
    /// nothing when the connection is closed already. Throws `protocol` for a longer reason
    /// or a code a close frame may not carry (such as 1005 or 1006), and when sending fails.
    + fn close(code: u16 (1000), reason: String (""), timeout_ms: uint (1000)) !WebSocketError {
        if this.closed : return
        if reason.bytes > 123 || !websocket_close_code_is_valid(code) : throw .protocol
        this.send_close(code, reason) ! {
            this.finish()
            throw E
        }
        // Drain until the peer's close frame; the socket is closed regardless
        this.con.read_timeout_ms = timeout_ms == 0 ? 1 : timeout_ms
        while !this.closed {
            this.read_frame_into(null) ! break
        }
        this.finish()
    }

    - fn send_close(code: u16, reason: String) !WebSocketError {
        if this.close_sent : return
        this.close_sent = true
        if this.close_code == 0 {
            this.close_code = code
            this.close_reason = reason
        }
        let payload = ByteBuffer.new(2 + reason.bytes)
        payload.write_u16_be(code)
        payload.write(reason)
        this.send_frame(WS_OP_CLOSE, payload) !>
    }

    // Waits while a pending write has a full queue. Called before a frame is built: frames
    // are built in `output`, which another coroutine reuses while this one sleeps
    - fn wait_for_room() !WebSocketError {
        while this.writing && this.queue.length >= this.max_queue && !this.closed : time.sleep_ms(1)
        if this.closed : throw .closed
    }

    // Sends `parts` in order as one piece of the stream. A write that the socket cannot
    // take at once goes on in a coroutine of its own, so a slow peer does not hold up the
    // caller (as when sending to many connections); writes made meanwhile queue behind it.
    // An error there closes the connection, and later calls throw `closed`. Does not wait
    // before `parts` are sent or queued; callers wait for room with `wait_for_room` first.
    - fn write_out(parts: local &[local &[u8]]) !WebSocketError {
        if this.closed : throw .closed
        if this.writing {
            each parts as part : this.queue.write(part)
            return
        }
        this.writing = true
        let sent = this.con.write_now(parts) ! {
            this.writing = false
            this.finish()
            throw E
        }
        let rest = false
        each parts as part {
            if sent >= part.length {
                sent -= part.length
                continue
            }
            this.queue.write(part.view(sent, part.length - sent))
            sent = 0
            rest = true
        }
        if rest {
            co this.flush()
            return
        }
        // With TLS and on Windows the write above could wait while others queued
        this.flush() !>
    }

    // Sends the queue; the caller holds `writing`, which this releases
    - fn flush() !WebSocketError {
        while this.queue.length > 0 {
            let out = this.queue
            this.queue = this.sending
            this.sending = out
            this.con.write(out) ! {
                this.writing = false
                this.finish()
                throw E
            }
            out.clear()
            if out.size > 65536 : out.shrink_capacity(4096)
        }
        this.writing = false
    }

    - fn send_frame(opcode: uint, data: local &[u8]) !WebSocketError {
        this.wait_for_room() !>

        // The payload goes after room for the header, which is put in front of it
        let frame = this.output
        frame.clear()
        frame.skip(WS_HEADER_ROOM)
        let first = 0x80 | opcode
        if this.deflate_bits > 0 && this.deflate_level > 0 && opcode < 8 && data.length >= this.deflate_min_size {
            compress.deflate_message(data, frame, this.deflate_level, this.deflate_bits)
            let compressed = frame.length - WS_HEADER_ROOM
            if compressed < data.length {
                this.finish_frame(first | 0x40, compressed, "") !>
                return
            }
            frame.truncate(WS_HEADER_ROOM)
        }
        if this.is_client {
            // Masked in place
            frame.write(data)
            this.finish_frame(first, data.length, "") !>
            return
        }
        this.finish_frame(first, data.length, data) !>
    }

    // Puts the header for `length` bytes of payload in front of `output` and sends it. A
    // non-empty `body` is the payload itself, sent after the header without a copy;
    // otherwise the payload follows the header in `output`.
    - fn finish_frame(first: uint, length: uint, body: local &[u8]) !WebSocketError {
        let frame = this.output
        let header: uint = length < 126 ? 2 : (length < 65536 ? 4 : 10)
        if this.is_client : header += 4
        let start = WS_HEADER_ROOM - header
        let head = frame.view(start, header)
        head[0] = first.to(u8)
        let mask_bit: u8 = this.is_client ? 0x80 : 0
        if length < 126 {
            head[1] = mask_bit | length.to(u8)
        } else if length < 65536 {
            head[1] = mask_bit | 126
            head[2] = (length >> 8).to(u8)
            head[3] = length.to(u8)
        } else {
            head[1] = mask_bit | 127
            let i: uint = 0
            while i < 8 {
                head[2 + i] = (length >> (56 - i * 8)).to(u8)
                i++
            }
        }
        if this.is_client {
            let key = crypto.random_bytes(4)
            let k = header - 4
            head[k] = key[0]
            head[k + 1] = key[1]
            head[k + 2] = key[2]
            head[k + 3] = key[3]
            websocket_mask(frame.view(WS_HEADER_ROOM, length), key[0], key[1], key[2], key[3])
        }

        if body.length > 0 : this.write_out(.{ head, body }) !>
        else : this.write_out(.{ frame.view(start, header + length) }) !>
        if frame.length > 65536 {
            frame.clear()
            frame.shrink_capacity(4096)
        }
    }

    // ---- Receiving -------------------------------------------------------------------

    /// Waits for the next text or binary message.
    ///
    /// Pings are answered and pongs skipped on the way. Throws `closed` after the
    /// closing handshake (see `close_code`) or when the connection dropped, `timeout`
    /// after the read timeout, `cancelled`, `protocol` and `too_large`.
    + fn read() WebSocketMessage !WebSocketError {
        let out = ByteBuffer.new(256)
        let type = this.read_into(out) !>
        return WebSocketMessage { type: type, data: out.to_string() }
    }

    /// Like `read`, but writes the payload to `out` and returns the message type.
    ///
    /// Throws the writer's error as `write`.
    + fn read_into(out: io.Writer) WebSocketMessageType !WebSocketError {
        while true {
            let done = this.read_frame_into(out) !>
            if done : break
        }
        return this.fragment_opcode == WS_OP_TEXT ? WebSocketMessageType.text : WebSocketMessageType.binary
    }

    // Reads one frame. Returns true when a data message is complete; its payload was
    // written to `out` (or kept in `fragments` when `out` is null, as during `close`).
    - fn read_frame_into(out: ?io.Writer) bool !WebSocketError {
        if this.closed : throw .closed
        let input = this.input
        this.fill(2) !>
        let b0 = input.get(0)
        let b1 = input.get(1)
        let fin = (b0 & 0x80) != 0
        let opcode = (b0 & 0x0f).to(uint)
        // RSV1 marks a compressed message, on its first frame only (RFC 7692 §6)
        let rsv1 = (b0 & 0x40) != 0
        if (b0 & 0x30) != 0 || (rsv1 && (this.deflate_bits == 0 || opcode == WS_OP_CONTINUATION || opcode >= 8)) {
            this.fail(1002, "Reserved bits set") !>
        }
        let masked = (b1 & 0x80) != 0
        // A client must mask, a server must not (RFC 6455 §5.1)
        if masked == this.is_client : this.fail(1002, masked ? "Masked server frame" : "Unmasked client frame") !>
        let length = (b1 & 0x7f).to(uint)
        let header: uint = 2
        if length == 126 {
            this.fill(4) !>
            length = (input.get(2).to(uint) << 8) | input.get(3).to(uint)
            header = 4
        } else if length == 127 {
            this.fill(10) !>
            length = 0
            let i: uint = 2
            while i < 10 {
                length = (length << 8) | input.get(i).to(uint)
                i++
            }
            if (length >> 63) != 0 : this.fail(1002, "Invalid length") !>
            header = 10
        }
        if masked : header += 4
        let is_control = opcode >= 8
        if is_control {
            if opcode > WS_OP_PONG : this.fail(1002, "Unknown opcode") !>
            if !fin : this.fail(1002, "Fragmented control frame") !>
            if length > 125 : this.fail(1002, "Control frame too long") !>
        } else {
            if opcode == WS_OP_CONTINUATION {
                if !this.in_fragment : this.fail(1002, "Unexpected continuation") !>
            } else if opcode == WS_OP_TEXT || opcode == WS_OP_BINARY {
                if this.in_fragment : this.fail(1002, "Expected continuation") !>
            } else {
                this.fail(1002, "Unknown opcode") !>
            }
            let max = this.max_message_size
            if max > 0 && (length > max || this.fragments.length + length > max) : this.fail(1009, "Message too large") !>
        }
        this.fill(header + length) !>
        let payload = input.view(header, length)
        if masked {
            let k0 = input.get(header - 4)
            let k1 = input.get(header - 3)
            let k2 = input.get(header - 2)
            let k3 = input.get(header - 1)
            websocket_mask(payload, k0, k1, k2, k3)
        }

        let complete = false
        if opcode == WS_OP_PING {
            this.send_frame(WS_OP_PONG, payload) ! {
                this.finish()
                throw E
            }
        } else if opcode == WS_OP_PONG {
            // Nothing to do
        } else if opcode == WS_OP_CLOSE {
            let code: u16 = 1005
            let reason = ""
            if length == 1 : this.fail(1002, "Invalid close payload") !>
            if length >= 2 {
                code = (payload[0].to(u16) << 8) | payload[1].to(u16)
                if !websocket_close_code_is_valid(code) : this.fail(1002, "Invalid close code") !>
                let text = payload.view(2, length - 2)
                if !websocket_utf8_is_valid(text) : this.fail(1007, "Invalid UTF-8") !>
                reason = text.to_string()
            }
            if this.close_code == 0 {
                this.close_code = code
                this.close_reason = reason
            }
            input.clear_until(header + length)
            this.send_close(code == 1005 ? 1000 : code, "") ! {}
            this.finish()
            throw .closed
        } else {
            if opcode != WS_OP_CONTINUATION {
                this.fragment_opcode = opcode
                this.in_fragment = true
                this.message_compressed = rsv1
            }
            if !fin {
                this.fragments.write(payload)
            } else {
                this.in_fragment = false
                complete = true
                if this.message_compressed {
                    this.fragments.write(payload)
                    // Nobody reads the message during `close`: skip decompressing it
                    if isset(out) {
                        let start = this.inflate() !>
                        let inflated = this.inflated
                        this.deliver(out, inflated.view(start, inflated.length - start)) !>
                        if this.inflate_takeover {
                            if inflated.length > 32768 : inflated.clear_until(inflated.length - 32768)
                        } else {
                            inflated.clear()
                        }
                        if inflated.size > 65536 : inflated.shrink_capacity(32768)
                    }
                } else if this.fragments.length > 0 {
                    this.fragments.write(payload)
                    this.deliver(out, this.fragments) !>
                } else {
                    this.deliver(out, payload) !>
                }
                this.fragments.clear()
                this.fragments.shrink_capacity(0)
            }
        }

        input.clear_until(header + length)
        return complete
    }

    // Decompresses the message in `fragments` onto `inflated` and returns where it starts
    - fn inflate() uint !WebSocketError {
        let inflated = this.inflated
        if !this.inflate_takeover : inflated.clear()
        let start = inflated.length
        this.fragments.write(WS_DEFLATE_TAIL)
        compress.inflate_message(this.fragments, inflated, this.max_message_size) ! {
            if E.code == E.too_large : this.fail(1009, "Message too large") !>
            this.fail(1007, "Invalid compressed data") !>
        }
        return start
    }

    // Checks a complete message and passes it to `out`
    - fn deliver(out: ?io.Writer, data: local &[u8]) !WebSocketError {
        if this.fragment_opcode == WS_OP_TEXT && !websocket_utf8_is_valid(data) : this.fail(1007, "Invalid UTF-8") !>
        if isset(out) : out.write(data) ! throw .write
    }

    // Makes sure `input` holds at least `needed` bytes
    - fn fill(needed: uint) !WebSocketError {
        let input = this.input
        while input.length < needed {
            input.reserve(WS_READ_SIZE)
            let bytes = this.con.read(input.view_spare(WS_READ_SIZE)) ! {
                if error_is(E.code, closed) {
                    if this.close_code == 0 : this.close_code = 1006
                    this.finish()
                }
                throw E
            }
            input.skip(bytes)
        }
    }

    // Closes with `code` after a peer error and reports it
    - fn fail(code: u16, reason: String) !WebSocketError {
        this.send_close(code, reason) ! {}
        this.finish()
        if code == 1009 : throw .too_large
        throw .protocol
    }

    - fn finish() {
        if this.closed : return
        this.closed = true
        // A pending write sends what was queued (such as a close frame) first
        while this.writing : time.sleep_ms(1)
        this.queue.clear()
        this.input.clear()
        this.fragments.clear()
        this.inflated.clear()
        this.con.close() ! core.cleanup_warning("Failed to close WebSocket connection", __FILE__, __LINE__)
    }

    // Closes the socket without a handshake; used by the server once the handler returned
    fn abandon() {
        if this.closed : return
        this.send_close(1000, "") ! {}
        this.finish()
    }
}

// Compressed forms of a `WebSocketFrame`; `keys` holds level * 16 + window bits of each
class WebSocketFrameCache {
    keys: Array[uint] (Array[uint].new())
    frames: Array[String] (Array[String].new())
}

/// A text or binary message prepared once and sent to many WebSockets with
/// `WebSocket.write_frame`.
///
/// The frame bytes are built when it is made, and the compressed form the first time a
/// connection with permessage-deflate sends it, once per window size and level;
/// connections without compression send the plain bytes. A frame cannot change, so it can
/// be published as `shared WebSocketFrame` and sent from coroutines on any thread:
///
/// ```valk
/// let frame: shared http.WebSocketFrame = http.WebSocketFrame.text(json)
/// each sockets as ws : ws.write_frame(frame) ! continue
/// ```
+ class WebSocketFrame {
    // The unmasked frame as a server sends it: header and payload
    - plain: String
    - compressed: shared core.Lock[WebSocketFrameCache]

    /// Prepares a text message; `data` must be UTF-8.
    + static fn text(data: local &[u8]) SELF {
        return SELF.make(WS_OP_TEXT, data)
    }

    /// Prepares a binary message.
    + static fn binary(data: local &[u8]) SELF {
        return SELF.make(WS_OP_BINARY, data)
    }

    - static fn make(opcode: uint, data: local &[u8]) SELF {
        return SELF {
            plain: websocket_server_frame(0x80 | opcode, data)
            compressed: core.Lock[WebSocketFrameCache].new(WebSocketFrameCache {}) !!
        }
    }

    // The frame bytes for a connection compressing with window `bits` (0: no compression),
    // `level` and `min_size`
    fn bytes_for(bits: uint, level: uint, min_size: uint) String {
        let plain = this.plain
        let head = websocket_frame_head_size(plain)
        let length = plain.bytes - head
        if bits < 8 || bits > 15 || level == 0 || length < min_size : return plain
        if level > 9 : level = 9
        let key = level * 16 + bits
        lock this.compressed as cache {
            each cache.keys as known, i {
                if known == key : return cache.frames.get(i) !? plain
            }
            let out = ByteBuffer.new(length / 2 + 16)
            compress.deflate_message(plain.view(head, length), out, level, bits)
            let result = out.length < length ? websocket_server_frame(plain.get(0).to(uint) | 0x40, out) : plain
            cache.keys.append(key)
            cache.frames.append(result)
            return result
        }
        return plain
    }
}

// An unmasked frame with first byte `first` and `payload`
fn websocket_server_frame(first: uint, payload: local &[u8]) String {
    let length = payload.length
    let out = ByteBuffer.new(length + 10)
    out.write_byte(first.to(u8))
    if length < 126 {
        out.write_byte(length.to(u8))
    } else if length < 65536 {
        out.write_byte(126)
        out.write_u16_be(length.to(u16))
    } else {
        out.write_byte(127)
        out.write_u64_be(length.to(u64))
    }
    out.write(payload)
    return out.into_string()
}

// The header size of an unmasked frame
fn websocket_frame_head_size(frame: String) uint {
    let length = frame.get(1) & 0x7f
    if length == 126 : return 4
    if length == 127 : return 10
    return 2
}

// XORs `data` with the 4-byte masking key (RFC 6455 §5.3)
fn websocket_mask(data: local mut &[u8], k0: u8, k1: u8, k2: u8, k3: u8) {
    let length = data.length
    let i: uint = 0
    while i + 4 <= length {
        data[i] = data[i] ^ k0
        data[i + 1] = data[i + 1] ^ k1
        data[i + 2] = data[i + 2] ^ k2
        data[i + 3] = data[i + 3] ^ k3
        i += 4
    }
    if i < length : data[i] = data[i] ^ k0
    if i + 1 < length : data[i + 1] = data[i + 1] ^ k1
    if i + 2 < length : data[i + 2] = data[i + 2] ^ k2
}

fn websocket_close_socket(con: net.TcpConnection) {
    con.close() ! core.cleanup_warning("Failed to close WebSocket connection", __FILE__, __LINE__)
}

fn websocket_remaining(deadline_ms: uint, operation_timeout_ms: uint) uint !WebSocketError {
    return ClientRequest.remaining_timeout(deadline_ms, operation_timeout_ms) ! throw .timeout
}

// The `Sec-WebSocket-Accept` value for a client key
fn websocket_accept_value(key: String) String {
    return crypto.base64_encode(crypto.hash(crypto.HashAlgorithm.sha1, key + WS_GUID))
}

// Validates an upgrade request (RFC 6455 §4.2.1) and returns the accept value, or null
fn websocket_accept_key(method: String, headers: Headers) ?String {
    if !method.equals("GET") : return null
    let upgrade = headers.get("upgrade") !? ""
    if !upgrade.equals_ignore_ascii_case("websocket") : return null
    let connection = headers.get("connection") !? ""
    if !websocket_header_has_token(connection, "upgrade") : return null
    let version = headers.get("sec-websocket-version") !? ""
    if version.trim(" ") != "13" : return null
    let key = (headers.get("sec-websocket-key") !? "").trim(" ")
    if key.bytes != 24 : return null
    let decoded = crypto.base64_decode(key) ! return null
    if decoded.bytes != 16 : return null
    return websocket_accept_value(key)
}

// Fills the upgrade response: `extra` without the fields the handshake sets, the handshake
// fields, and `protocol` when the request offered it
fn websocket_upgrade_headers(headers: Headers, accept: String, request: Headers, protocol: ?String, extra: ?Headers) {
    if isset(extra) {
        each extra as value, name {
            if websocket_header_is_handshake(name) : continue
            headers.append(name, value)
        }
    }
    headers.set("Upgrade", "websocket")
    headers.set("Connection", "Upgrade")
    headers.set("Sec-WebSocket-Accept", accept)
    if isset(protocol) && websocket_protocol_offered(request, protocol) : headers.set("Sec-WebSocket-Protocol", protocol)
}

fn websocket_header_is_handshake(name: String) bool {
    return name.equals_ignore_ascii_case("upgrade")
        || name.equals_ignore_ascii_case("connection")
        || name.equals_ignore_ascii_case("sec-websocket-accept")
        || name.equals_ignore_ascii_case("sec-websocket-protocol")
        || name.equals_ignore_ascii_case("sec-websocket-extensions")
}

// Whether the request's `Sec-WebSocket-Protocol` lists `protocol`; names are case-sensitive
fn websocket_protocol_offered(request: Headers, protocol: String) bool {
    if protocol.bytes == 0 : return false
    each request.get_all("sec-websocket-protocol") as value {
        each value.split(",") as offered {
            if offered.trim(" ") == protocol : return true
        }
    }
    return false
}

// Whether a comma-separated header value contains `token`, ignoring case
fn websocket_header_has_token(value: String, token: String) bool {
    each value.split(",") as part {
        if part.trim(" ").equals_ignore_ascii_case(token) : return true
    }
    return false
}

fn websocket_client_request(u: url.Url, port: u16, is_tls: bool, key: String, options: ?Options, deflate_offer: String) String !WebSocketError {
    let out = ByteBuffer.new(512)
    let path = u.path.bytes == 0 ? "/" : u.path
    if u.query.bytes > 0 : path = path + "?" + u.query
    if !request_target_part_is_safe(path) : throw .invalid_url
    out.write("GET ")
    out.write(path)
    out.write(" HTTP/1.1\r\nHost: ")
    out.write(u.host)
    if port != (is_tls ? 443 : 80) {
        out.write(":")
        out.write_uint_ascii(port)
    }
    out.write("\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: ")
    out.write(key)
    out.write("\r\nSec-WebSocket-Version: 13\r\n")
    if deflate_offer.bytes > 0 {
        out.write("Sec-WebSocket-Extensions: ")
        out.write(deflate_offer)
        out.write("\r\n")
    }
    if isset(options) {
        let headers = options.headers
        if isset(headers) {
            each headers as value, name {
                if request_header_is_reserved(name) || websocket_header_is_reserved(name) : throw .invalid_request
                if !response_header_name_is_safe(name) || !response_header_value_is_safe(value) : throw .invalid_request
                out.write(name)
                out.write(": ")
                out.write(value)
                out.write("\r\n")
            }
        }
    }
    out.write("\r\n")
    return out.to_string()
}

// Whether a close frame may carry `code` (RFC 6455 §7.4 and the IANA registry)
fn websocket_close_code_is_valid(code: u16) bool {
    return (code >= 1000 && code <= 1003) || (code >= 1007 && code <= 1014) || (code >= 3000 && code <= 4999)
}

// The values of request header `name` in `options`, joined by commas
fn websocket_offered(options: ?Options, name: String) String {
    let result = ""
    let headers = options?.headers ?! return result
    each headers as value, key {
        if !key.equals_ignore_ascii_case(name) : continue
        result = result.bytes == 0 ? value : result + "," + value
    }
    return result
}

fn websocket_extension_offered(offered: String, name: String) bool {
    each offered.split(",") as extension {
        if extension.split(";")[0].trim(" ").equals_ignore_ascii_case(name) : return true
    }
    return false
}

fn websocket_header_is_reserved(name: String) bool {
    return name.equals_ignore_ascii_case("upgrade")
        || name.equals_ignore_ascii_case("connection")
        || name.equals_ignore_ascii_case("sec-websocket-key")
        || name.equals_ignore_ascii_case("sec-websocket-version")
}

// Strict UTF-8 (RFC 3629): no overlong forms, surrogates or code points above U+10FFFF
fn websocket_utf8_is_valid(data: local &[u8]) bool {
    let i: uint = 0
    let length = data.length
    while i < length {
        let b = data[i]
        if b < 0x80 {
            i++
            continue
        }
        let need: uint = 0
        let min: uint = 0
        let cp: uint = 0
        if b >= 0xc2 && b <= 0xdf {
            need = 1
            cp = (b & 0x1f).to(uint)
            min = 0x80
        } else if b >= 0xe0 && b <= 0xef {
            need = 2
            cp = (b & 0x0f).to(uint)
            min = 0x800
        } else if b >= 0xf0 && b <= 0xf4 {
            need = 3
            cp = (b & 0x07).to(uint)
            min = 0x10000
        } else {
            return false
        }
        if i + need >= length : return false
        let j: uint = 1
        while j <= need {
            let c = data[i + j]
            if (c & 0xc0) != 0x80 : return false
            cp = (cp << 6) | (c & 0x3f).to(uint)
            j++
        }
        if cp < min || cp > 0x10ffff : return false
        if cp >= 0xd800 && cp <= 0xdfff : return false
        i += need + 1
    }
    return true
}

// ---- permessage-deflate (RFC 7692) ---------------------------------------------------

// The parameters of one permessage-deflate offer or response; window bits are 0 when absent
class WebSocketDeflateParams {
    server_no_takeover: bool (false)
    client_no_takeover: bool (false)
    server_bits: uint (0)
    client_bits: uint (0)
    // `client_max_window_bits` appeared, maybe without a value
    client_bits_given: bool (false)
}

// Parses `extension` ("permessage-deflate; ..."); null for a repeated, unknown or
// malformed parameter
fn websocket_deflate_params(extension: String) ?WebSocketDeflateParams {
    let params = WebSocketDeflateParams {}
    each extension.split(";") as part, i {
        if i == 0 : continue
        let eq = part.index_of("=") !? part.bytes
        let name = part.range(0, eq).trim(" ")
        let has_value = eq < part.bytes
        let value = has_value ? part.range(eq + 1, part.bytes - eq - 1).trim(" ") : ""
        if value.bytes >= 2 && value.starts_with("\"") && value.ends_with("\"") : value = value.range(1, value.bytes - 2)
        if name == "server_no_context_takeover" {
            if has_value || params.server_no_takeover : return null
            params.server_no_takeover = true
        } else if name == "client_no_context_takeover" {
            if has_value || params.client_no_takeover : return null
            params.client_no_takeover = true
        } else if name == "server_max_window_bits" {
            if params.server_bits > 0 : return null
            params.server_bits = websocket_window_bits(value)
            if params.server_bits == 0 : return null
        } else if name == "client_max_window_bits" {
            if params.client_bits_given : return null
            params.client_bits_given = true
            if has_value {
                params.client_bits = websocket_window_bits(value)
                if params.client_bits == 0 : return null
            }
        } else {
            return null
        }
    }
    return params
}

// A window bits value, 8 to 15 without leading zeros; 0 when invalid
fn websocket_window_bits(value: String) uint {
    if value.bytes == 0 || value.bytes > 2 || value.starts_with("0") : return 0
    let bits = value.to_uint() !? 0
    return bits >= 8 && bits <= 15 ? bits : 0
}

// Accepts the first permessage-deflate offer in `request` that can be honoured, adding
// the answer to `response`; returns the window bits for messages sent, 0 when none fits.
// The answer asks for no context takeover both ways, so no connection keeps a compression
// or decompression window
fn websocket_deflate_accept(request: Headers, response: Headers) uint {
    each request.get_all("sec-websocket-extensions") as value {
        each value.split(",") as offer {
            if !offer.split(";")[0].trim(" ").equals_ignore_ascii_case("permessage-deflate") : continue
            let params = websocket_deflate_params(offer) ?! continue
            let answer = "permessage-deflate; server_no_context_takeover; client_no_context_takeover"
            let bits: uint = 15
            if params.server_bits > 0 {
                bits = params.server_bits
                answer += "; server_max_window_bits=" + bits
            }
            response.set("Sec-WebSocket-Extensions", answer)
            return bits
        }
    }
    return 0
}

// The client's permessage-deflate offer, or "" when it makes none
fn websocket_deflate_offer(options: ?Options) String {
    if isset(options) {
        if !options.websocket_compression : return ""
        // A request that offers its own extensions is sent as it is
        if websocket_offered(options, "sec-websocket-extensions").bytes > 0 : return ""
    }
    return "permessage-deflate; client_no_context_takeover; client_max_window_bits"
}


use net
use io
use crypto
use url
use time
use core
use sync

/// Thrown by `WebSocket` methods.
///
/// - `protocol`: the peer sent a frame that breaks RFC 6455 (bad opcode, a fragmented or
///   oversized control frame, a text message that is not UTF-8, a missing or unexpected
///   mask). The connection is closed with code 1002 or 1007.
/// - `too_large`: a message exceeds `max_message_size`; closed with code 1009.
/// - `handshake`: the server did not accept the upgrade, or its answer is not a valid
///   WebSocket handshake.
/// - `invalid_url`: `connect` was given a URL that is not `ws://` or `wss://`.
/// - `invalid_request`: an extra header given to `connect` is unsafe to send or one the
///   client sets itself.
///
/// Also carries every `net.NetError` and `io.IoError` code: `closed` once the connection is
/// closed, from either side, `ssl` for a failed `wss://` handshake, and `timeout`,
/// `cancelled`, `read` and `write` from the socket.
error WebSocketError (protocol, too_large, handshake, invalid_url, invalid_request) extends(net.NetError)

/// The kind of a WebSocket message.
+ enum WebSocketMessageType {
    text
    binary
}

/// One complete message received over a `WebSocket`.
+ class WebSocketMessage {
    /// Whether the message is text or binary.
    + type: WebSocketMessageType
    /// The message payload; valid UTF-8 for a text message.
    + data: String

    /// Whether this is a text message.
    + get is_text: bool {
        return this.type == WebSocketMessageType.text
    }
}

value WS_OP_CONTINUATION (0)
value WS_OP_TEXT (1)
value WS_OP_BINARY (2)
value WS_OP_CLOSE (8)
value WS_OP_PING (9)
value WS_OP_PONG (10)
value WS_GUID ("258EAFA5-E914-47DA-95CA-C5AB0DC85B11")
value WS_READ_SIZE (16384)
value WS_DEFAULT_MAX_MESSAGE_SIZE (16 * 1024 * 1024)

/// A WebSocket connection (RFC 6455), on the server or the client side.
///
/// A server gets one from `WebSocket.upgrade`, a client from `WebSocket.connect`. `read`
/// returns whole messages and answers pings by itself; `write` and `write_binary` send
/// one message each. Reads and writes may run on different coroutines, so one coroutine
/// can wait for messages while another sends. `close` performs the closing handshake.
///
/// ```valk
/// fn handler(req: http.Request) http.Response {
///     return http.WebSocket.upgrade(req, fn(ws: http.WebSocket) {
///         while true {
///             let msg = ws.read() ! break
///             ws.write(msg.data) ! break
///         }
///     })
/// }
/// ```
+ class WebSocket {
    - con: net.TcpConnection
    - input: ByteBuffer
    - fragments: ByteBuffer (ByteBuffer.new(0))
    - fragment_opcode: uint (0)
    - in_fragment: bool (false)
    - is_client: bool
    - writing: bool (false)
    - close_sent: bool (false)
    - closed: bool (false)
    /// The largest message accepted, in bytes; a larger one closes the connection
    /// with code 1009. Defaults to 16 MB.
    + max_message_size: uint (WS_DEFAULT_MAX_MESSAGE_SIZE)
    /// The close code received from the peer, or the one sent when this side closed
    /// first; 0 while open, 1006 when the connection dropped without a close frame.
    ~ close_code: u16 (0)
    /// The close reason that came with `close_code`.
    ~ close_reason: String ("")

    /// Whether the connection is closed, from either side.
    + get is_closed: bool {
        return this.closed
    }

    /// The address of the peer.
    + fn peer_address() net.SocketAddress !net.NetError {
        return this.con.peer_address() !>
    }

    /// Sets the socket timeouts in milliseconds; 0 waits forever.
    ///
    /// A server socket starts with no read timeout and a 5 second write timeout; a client
    /// socket starts with the timeouts of the `Options` it was connected with.
    + fn set_timeouts(read_timeout_ms: uint, write_timeout_ms: uint) {
        this.con.set_timeouts(read_timeout_ms, write_timeout_ms)
    }

    /// Makes a blocked `read` or `write` fail with `cancelled` when `token` is cancelled.
    + fn set_cancel(token: shared sync.CancelToken) {
        this.con.set_cancel(token)
    }

    // ---- Handshake -------------------------------------------------------------------

    /// Answers a server request with the WebSocket upgrade, then runs `handler` on the
    /// connection.
    ///
    /// The handler runs on the connection's coroutine after the `101` response is sent;
    /// the connection is closed when it returns. A request that is not a valid WebSocket
    /// upgrade (RFC 6455 §4.2.1) gets a `400` response instead and the handler never
    /// runs. `Server.request_shutdown` interrupts the socket, so a blocked `read` then
    /// fails with `closed`. Not available over HTTP/2.
    + static fn upgrade(req: Request, handler: fn(WebSocket)()) Response {
        let accept = websocket_accept_key(req.method, req.headers())
        if !isset(accept) : return Response.new("Expected a WebSocket upgrade request", 400)
        let response = Response.new("", 101)
        websocket_upgrade_headers(response.headers, accept)
        response.websocket_handler = handler
        return response
    }

    /// Connects to a `ws://` or `wss://` server and completes the opening handshake.
    ///
    /// `options` supplies extra request headers (for example `Origin` or a cookie), the
    /// TLS settings for `wss://` and the timeouts: `connect_timeout_ms` bounds the
    /// connection, `timeout_ms` the whole handshake, and `read_timeout_ms` /
    /// `write_timeout_ms` become the socket timeouts afterwards. Throws `invalid_url`,
    /// `handshake` when the server answers anything but a matching `101`, and the
    /// socket's `timeout`, `closed`, `read` and `write`.
    + static fn connect(url: String, options: ?Options (null)) SELF !WebSocketError {
        let u = url.parse(url)
        if u.scheme != "ws" && u.scheme != "wss" : throw .invalid_url
        if !request_host_is_safe(u.host) || u.host.bytes == 0 : throw .invalid_url
        if u.user.bytes > 0 || u.password.bytes > 0 : throw .invalid_url
        let is_tls = u.scheme == "wss"
        let port: u16 = is_tls ? 443 : 80
        let parsed_port = u.port
        if isset(parsed_port) {
            if parsed_port == 0 || parsed_port > 65535 : throw .invalid_url
            port = parsed_port.to(u16)
        }

        let connect_timeout_ms: uint = 5000
        let read_timeout_ms: uint = 5000
        let write_timeout_ms: uint = 5000
        let deadline_ms: uint = 0
        if isset(options) {
            connect_timeout_ms = options.connect_timeout_ms
            read_timeout_ms = options.read_timeout_ms
            write_timeout_ms = options.write_timeout_ms
            if options.timeout_ms > 0 : deadline_ms = time.deadline_ms(options.timeout_ms)
        }

        // Build the request before opening a socket, so a bad header costs no connection
        let key = crypto.base64_encode(crypto.random_bytes(16))
        let request = websocket_client_request(u, port, is_tls, key, options) !>

        let connect_deadline_ms = ClientRequest.operation_deadline(deadline_ms, connect_timeout_ms)
        let con = net.tcp_client(u.host, port, websocket_remaining(connect_deadline_ms, 0) !>) !>
        con.set_timeouts(read_timeout_ms, write_timeout_ms)

        if is_tls {
            let ssl = net.Ssl.new()
            ClientRequest.configure_ssl(ssl, options) ! {
                websocket_close_socket(con)
                throw .ssl
            }
            con.ssl_connect(ssl, websocket_remaining(connect_deadline_ms, 0) !>) ! {
                websocket_close_socket(con)
                if error_is(E.code, timeout) : throw .timeout
                throw .ssl
            }
        }

        // Send the handshake
        con.write_timeout_ms = websocket_remaining(deadline_ms, write_timeout_ms) ! { websocket_close_socket(con); throw E }
        con.write(request) ! {
            websocket_close_socket(con)
            throw E
        }

        // Read the answer; bytes after the head already belong to the frame stream
        let input = ByteBuffer.new(2048)
        let context = Context.new(input)
        while true {
            con.read_timeout_ms = websocket_remaining(deadline_ms, read_timeout_ms) ! { websocket_close_socket(con); throw E }
            input.reserve(WS_READ_SIZE)
            let bytes = con.read(input.view_spare(WS_READ_SIZE)) ! {
                websocket_close_socket(con)
                throw E
            }
            input.skip(bytes)
            parse_http(input, context, true, 8192, 0) ! {
                if E.code == E.incomplete : continue
                websocket_close_socket(con)
                throw .handshake
            }
            break
        }
        if context.status != 101 {
            websocket_close_socket(con)
            throw .handshake
        }
        let headers = context.headers()
        let upgrade = headers.get("upgrade") !? ""
        let connection = headers.get("connection") !? ""
        let accept = headers.get("sec-websocket-accept") !? ""
        if !upgrade.equals_ignore_ascii_case("websocket")
            || !websocket_header_has_token(connection, "upgrade")
            || accept != websocket_accept_value(key) {
            websocket_close_socket(con)
            throw .handshake
        }

        let rest = ByteBuffer.new(WS_READ_SIZE)
        let leftover = context.parsed_index
        if leftover < input.length : rest.write(input.view(leftover, input.length - leftover))
        con.set_timeouts(read_timeout_ms, write_timeout_ms)
        return SELF { con: con, input: rest, is_client: true }
    }

    // Wraps an upgraded server connection; `leftover` holds bytes received after the
    // request head
    static fn from_server(con: net.TcpConnection, leftover: local &[u8]) SELF {
        let input = ByteBuffer.new(WS_READ_SIZE)
        input.write(leftover)
        con.set_timeouts(0, 5000)
        return SELF { con: con, input: input, is_client: false }
    }

    // ---- Sending ---------------------------------------------------------------------

    /// Sends `text` as one text message; the bytes must be UTF-8.
    + fn write(text: local &[u8]) !WebSocketError {
        this.send_frame(WS_OP_TEXT, text) !>
    }

    /// Sends `data` as one binary message.
    + fn write_binary(data: local &[u8]) !WebSocketError {
        this.send_frame(WS_OP_BINARY, data) !>
    }

    /// Sends a ping; the peer answers with a pong that `read` consumes.
    ///
    /// `data` is at most 125 bytes.
    + fn ping(data: String ("")) !WebSocketError {
        if data.bytes > 125 : throw .protocol
        this.send_frame(WS_OP_PING, data) !>
    }

    /// Performs the closing handshake and closes the socket.
    ///
    /// Sends a close frame with `code` and `reason` (at most 123 bytes), waits up to
    /// `timeout_ms` for the peer's close frame, and closes the socket either way. Does
    /// nothing when the connection is closed already. Throws when sending fails.
    + fn close(code: u16 (1000), reason: String (""), timeout_ms: uint (1000)) !WebSocketError {
        if this.closed : return
        if reason.bytes > 123 : throw .protocol
        this.send_close(code, reason) ! {
            this.finish()
            throw E
        }
        // Drain until the peer's close frame; the socket is closed regardless
        this.con.read_timeout_ms = timeout_ms == 0 ? 1 : timeout_ms
        while !this.closed {
            this.read_frame_into(null) ! break
        }
        this.finish()
    }

    - fn send_close(code: u16, reason: String) !WebSocketError {
        if this.close_sent : return
        this.close_sent = true
        if this.close_code == 0 {
            this.close_code = code
            this.close_reason = reason
        }
        let payload = ByteBuffer.new(2 + reason.bytes)
        payload.write_u16_be(code)
        payload.write(reason)
        this.send_frame(WS_OP_CLOSE, payload) !>
    }

    - fn send_frame(opcode: uint, data: local &[u8]) !WebSocketError {
        if this.closed : throw .closed
        let length = data.length
        let frame = ByteBuffer.new(length + 14)
        frame.write_byte((0x80 | opcode).to(u8))
        let mask_bit: u8 = this.is_client ? 0x80 : 0
        if length < 126 {
            frame.write_byte(mask_bit | length.to(u8))
        } else if length < 65536 {
            frame.write_byte(mask_bit | 126)
            frame.write_u16_be(length.to(u16))
        } else {
            frame.write_byte(mask_bit | 127)
            frame.write_u64_be(length.to(u64))
        }
        if this.is_client {
            let key = crypto.random_bytes(4)
            frame.write(key)
            let start = frame.length
            frame.write(data)
            let view = frame.view(start, length)
            let i: uint = 0
            while i < length {
                view[i] = view[i] ^ key[i % 4]
                i++
            }
        } else {
            frame.write(data)
        }

        // One frame at a time: a second writer waits for the one in progress
        while this.writing : time.sleep_ms(1)
        if this.closed : throw .closed
        this.writing = true
        this.con.write(frame) ! {
            this.writing = false
            this.finish()
            throw E
        }
        this.writing = false
    }

    // ---- Receiving -------------------------------------------------------------------

    /// Waits for the next text or binary message.
    ///
    /// Pings are answered and pongs skipped on the way. Throws `closed` after the
    /// closing handshake (see `close_code`) or when the connection dropped, `timeout`
    /// after the read timeout, `cancelled`, `protocol` and `too_large`.
    + fn read() WebSocketMessage !WebSocketError {
        let out = ByteBuffer.new(256)
        let type = this.read_into(out) !>
        return WebSocketMessage { type: type, data: out.to_string() }
    }

    /// Like `read`, but writes the payload to `out` and returns the message type.
    ///
    /// Throws the writer's error as `write`.
    + fn read_into(out: io.Writer) WebSocketMessageType !WebSocketError {
        while true {
            let done = this.read_frame_into(out) !>
            if done : break
        }
        return this.fragment_opcode == WS_OP_TEXT ? WebSocketMessageType.text : WebSocketMessageType.binary
    }

    // Reads one frame. Returns true when a data message is complete; its payload was
    // written to `out` (or kept in `fragments` when `out` is null, as during `close`).
    - fn read_frame_into(out: ?io.Writer) bool !WebSocketError {
        if this.closed : throw .closed
        let input = this.input
        this.fill(2) !>
        let b0 = input.get(0)
        let b1 = input.get(1)
        let fin = (b0 & 0x80) != 0
        let opcode = (b0 & 0x0f).to(uint)
        if (b0 & 0x70) != 0 : this.fail(1002, "Reserved bits set") !>
        let masked = (b1 & 0x80) != 0
        // A client must mask, a server must not (RFC 6455 §5.1)
        if masked == this.is_client : this.fail(1002, masked ? "Masked server frame" : "Unmasked client frame") !>
        let length = (b1 & 0x7f).to(uint)
        let header: uint = 2
        if length == 126 {
            this.fill(4) !>
            length = (input.get(2).to(uint) << 8) | input.get(3).to(uint)
            header = 4
        } else if length == 127 {
            this.fill(10) !>
            length = 0
            let i: uint = 2
            while i < 10 {
                length = (length << 8) | input.get(i).to(uint)
                i++
            }
            if (length >> 63) != 0 : this.fail(1002, "Invalid length") !>
            header = 10
        }
        if masked : header += 4
        let is_control = opcode >= 8
        if is_control {
            if !fin : this.fail(1002, "Fragmented control frame") !>
            if length > 125 : this.fail(1002, "Control frame too long") !>
        } else {
            if opcode == WS_OP_CONTINUATION {
                if !this.in_fragment : this.fail(1002, "Unexpected continuation") !>
            } else if opcode == WS_OP_TEXT || opcode == WS_OP_BINARY {
                if this.in_fragment : this.fail(1002, "Expected continuation") !>
            } else {
                this.fail(1002, "Unknown opcode") !>
            }
            let max = this.max_message_size
            if max > 0 && (length > max || this.fragments.length + length > max) : this.fail(1009, "Message too large") !>
        }
        this.fill(header + length) !>
        let payload = input.view(header, length)
        if masked {
            let k0 = input.get(header - 4)
            let k1 = input.get(header - 3)
            let k2 = input.get(header - 2)
            let k3 = input.get(header - 1)
            let i: uint = 0
            while i + 4 <= length {
                payload[i] = payload[i] ^ k0
                payload[i + 1] = payload[i + 1] ^ k1
                payload[i + 2] = payload[i + 2] ^ k2
                payload[i + 3] = payload[i + 3] ^ k3
                i += 4
            }
            while i < length {
                let k = i % 4 == 0 ? k0 : i % 4 == 1 ? k1 : i % 4 == 2 ? k2 : k3
                payload[i] = payload[i] ^ k
                i++
            }
        }

        let complete = false
        if opcode == WS_OP_PING {
            this.send_frame(WS_OP_PONG, payload) ! {
                this.finish()
                throw E
            }
        } else if opcode == WS_OP_PONG {
            // Nothing to do
        } else if opcode == WS_OP_CLOSE {
            let code: u16 = 1005
            let reason = ""
            if length == 1 : this.fail(1002, "Invalid close payload") !>
            if length >= 2 {
                code = (payload[0].to(u16) << 8) | payload[1].to(u16)
                let text = payload.view(2, length - 2)
                if !websocket_utf8_is_valid(text) : this.fail(1007, "Invalid UTF-8") !>
                reason = text.to_string()
            }
            if this.close_code == 0 {
                this.close_code = code
                this.close_reason = reason
            }
            input.clear_until(header + length)
            this.send_close(code == 1005 ? 1000 : code, "") ! {}
            this.finish()
            throw .closed
        } else {
            if opcode != WS_OP_CONTINUATION {
                this.fragment_opcode = opcode
                this.in_fragment = true
            }
            if fin {
                this.in_fragment = false
                complete = true
                if this.fragment_opcode == WS_OP_TEXT {
                    if this.fragments.length == 0 {
                        if !websocket_utf8_is_valid(payload) : this.fail(1007, "Invalid UTF-8") !>
                    } else {
                        this.fragments.write(payload)
                        if !websocket_utf8_is_valid(this.fragments) : this.fail(1007, "Invalid UTF-8") !>
                    }
                }
                if isset(out) {
                    if this.fragments.length > 0 {
                        if this.fragment_opcode != WS_OP_TEXT : this.fragments.write(payload)
                        out.write(this.fragments) ! throw .write
                    } else {
                        out.write(payload) ! throw .write
                    }
                }
                this.fragments.clear()
                this.fragments.shrink_capacity(0)
            } else {
                this.fragments.write(payload)
            }
        }

        input.clear_until(header + length)
        return complete
    }

    // Makes sure `input` holds at least `needed` bytes
    - fn fill(needed: uint) !WebSocketError {
        let input = this.input
        while input.length < needed {
            input.reserve(WS_READ_SIZE)
            let bytes = this.con.read(input.view_spare(WS_READ_SIZE)) ! {
                if error_is(E.code, closed) {
                    if this.close_code == 0 : this.close_code = 1006
                    this.finish()
                }
                throw E
            }
            input.skip(bytes)
        }
    }

    // Closes with `code` after a peer error and reports it
    - fn fail(code: u16, reason: String) !WebSocketError {
        this.send_close(code, reason) ! {}
        this.finish()
        if code == 1009 : throw .too_large
        throw .protocol
    }

    - fn finish() {
        if this.closed : return
        this.closed = true
        this.input.clear()
        this.fragments.clear()
        this.con.close() ! core.cleanup_warning("Failed to close WebSocket connection", __FILE__, __LINE__)
    }

    // Closes the socket without a handshake; used by the server once the handler returned
    fn abandon() {
        if this.closed : return
        this.send_close(1000, "") ! {}
        this.finish()
    }
}

fn websocket_close_socket(con: net.TcpConnection) {
    con.close() ! core.cleanup_warning("Failed to close WebSocket connection", __FILE__, __LINE__)
}

fn websocket_remaining(deadline_ms: uint, operation_timeout_ms: uint) uint !WebSocketError {
    return ClientRequest.remaining_timeout(deadline_ms, operation_timeout_ms) ! throw .timeout
}

// The `Sec-WebSocket-Accept` value for a client key
fn websocket_accept_value(key: String) String {
    return crypto.base64_encode(crypto.hash(crypto.HashAlgorithm.sha1, key + WS_GUID))
}

// Validates an upgrade request (RFC 6455 §4.2.1) and returns the accept value, or null
fn websocket_accept_key(method: String, headers: Headers) ?String {
    if !method.equals("GET") : return null
    let upgrade = headers.get("upgrade") !? ""
    if !upgrade.equals_ignore_ascii_case("websocket") : return null
    let connection = headers.get("connection") !? ""
    if !websocket_header_has_token(connection, "upgrade") : return null
    let version = headers.get("sec-websocket-version") !? ""
    if version.trim(" ") != "13" : return null
    let key = (headers.get("sec-websocket-key") !? "").trim(" ")
    if key.bytes != 24 : return null
    let decoded = crypto.base64_decode(key) ! return null
    if decoded.bytes != 16 : return null
    return websocket_accept_value(key)
}

fn websocket_upgrade_headers(headers: Headers, accept: String) {
    headers.set("Upgrade", "websocket")
    headers.set("Connection", "Upgrade")
    headers.set("Sec-WebSocket-Accept", accept)
}

// Whether a comma-separated header value contains `token`, ignoring case
fn websocket_header_has_token(value: String, token: String) bool {
    each value.split(",") as part {
        if part.trim(" ").equals_ignore_ascii_case(token) : return true
    }
    return false
}

fn websocket_client_request(u: url.Url, port: u16, is_tls: bool, key: String, options: ?Options) String !WebSocketError {
    let out = ByteBuffer.new(512)
    let path = u.path.bytes == 0 ? "/" : u.path
    if u.query.bytes > 0 : path = path + "?" + u.query
    if !request_target_part_is_safe(path) : throw .invalid_url
    out.write("GET ")
    out.write(path)
    out.write(" HTTP/1.1\r\nHost: ")
    out.write(u.host)
    if port != (is_tls ? 443 : 80) {
        out.write(":")
        out.write_uint_ascii(port)
    }
    out.write("\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: ")
    out.write(key)
    out.write("\r\nSec-WebSocket-Version: 13\r\n")
    if isset(options) {
        let headers = options.headers
        if isset(headers) {
            each headers as value, name {
                if request_header_is_reserved(name) || websocket_header_is_reserved(name) : throw .invalid_request
                if !response_header_name_is_safe(name) || !response_header_value_is_safe(value) : throw .invalid_request
                out.write(name)
                out.write(": ")
                out.write(value)
                out.write("\r\n")
            }
        }
    }
    out.write("\r\n")
    return out.to_string()
}

fn websocket_header_is_reserved(name: String) bool {
    return name.equals_ignore_ascii_case("upgrade")
        || name.equals_ignore_ascii_case("connection")
        || name.equals_ignore_ascii_case("sec-websocket-key")
        || name.equals_ignore_ascii_case("sec-websocket-version")
}

// Strict UTF-8 (RFC 3629): no overlong forms, surrogates or code points above U+10FFFF
fn websocket_utf8_is_valid(data: local &[u8]) bool {
    let i: uint = 0
    let length = data.length
    while i < length {
        let b = data[i]
        if b < 0x80 {
            i++
            continue
        }
        let need: uint = 0
        let min: uint = 0
        let cp: uint = 0
        if b >= 0xc2 && b <= 0xdf {
            need = 1
            cp = (b & 0x1f).to(uint)
            min = 0x80
        } else if b >= 0xe0 && b <= 0xef {
            need = 2
            cp = (b & 0x0f).to(uint)
            min = 0x800
        } else if b >= 0xf0 && b <= 0xf4 {
            need = 3
            cp = (b & 0x07).to(uint)
            min = 0x10000
        } else {
            return false
        }
        if i + need >= length : return false
        let j: uint = 1
        while j <= need {
            let c = data[i + j]
            if (c & 0xc0) != 0x80 : return false
            cp = (cp << 6) | (c & 0x3f).to(uint)
            j++
        }
        if cp < min || cp > 0x10ffff : return false
        if cp >= 0xd800 && cp <= 0xdfff : return false
        i += need + 1
    }
    return true
}

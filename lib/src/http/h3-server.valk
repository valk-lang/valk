use net
use coro
use sync
use time
use fs
use io
use compress

value H3_STREAM_SEND_HIGH_WATER (65_536)
value H3_SERVE_POOL_MAX (16)

global h3_resp_headers: Array[HpackField] (.new(8))
global h3_qpack_buf: ByteBuffer (.new(256))

class H3ServerUniStream {
    qst: net.QuicStream
    stream_type: u64 (0)
    type_known: bool (false)
    got_settings: bool (false)
    frame_in_progress: bool (false)
    frame_type: u64 (0)
    frame_len: u64 (0)
    closed: bool (false)
}

class H3ServerStream {
    conn: H3ServerConn
    qst: net.QuicStream
    frame_in_progress: bool (false)
    frame_type: u64 (0)
    frame_remaining: u64 (0)
    headers_buf: ?ByteBuffer (null)
    req_fields: ?Array[HpackField] (null)
    req_method: String ("")
    req_target: String ("")
    req_body: ?ByteBuffer (null)
    req_body_len: uint (0)
    expected_length: ?uint (null)
    got_headers: bool (false)
    got_trailers: bool (false)
    expect_continue: bool (false)
    read_done: bool (false)
    dispatched: bool (false)
    write_waker: ?sync.Waker (null)
    cancelled: bool (false)
    closed: bool (false)

    fn reset(code: u64) {
        if this.closed : return
        this.cancelled = true
        this.qst.reset_send(code)
        let w = this.write_waker
        if isset(w) : w.wake()
    }

    fn release() {
        if this.closed : return
        this.closed = true
        let w = this.write_waker
        if isset(w) : w.wake()
        let qst = this.qst
        let conn = this.conn
        conn.qconn.release_stream(qst)
        // Clear references and recycle stream wrapper
        this.headers_buf = null
        this.req_fields = null
        this.req_method = ""
        this.req_target = ""
        this.req_body = null
        this.write_waker = null
        conn.worker.give_h3_stream(this)
    }
}

class H3ServerConn {
    worker: H3Worker
    qconn: net.QuicConn
    ctrl_out: ?net.QuicStream (null)
    has_peer_control: bool (false)
    has_peer_qpack_enc: bool (false)
    has_peer_qpack_dec: bool (false)
    uni_streams: HashMap[u64, H3ServerUniStream] (.new(4))
    bidi_streams: HashMap[u64, H3ServerStream] (.new(16))
    next_goaway_id: u64 (0)
    active_handlers: uint (0)
    last_activity_ms: uint (0)
    peer_cert_loaded: bool (false)
    client_subject: String ("")
    client_sha256: String ("")
    draining: bool (false)
    goaway_sent: bool (false)
    closed: bool (false)

    static fn create(worker: H3Worker, qconn: net.QuicConn) SELF {
        return SELF {
            worker: worker,
            qconn: qconn,
            last_activity_ms: time.mono_ms()
        }
    }

    fn ensure_ctrl_out() {
        if isset(this.ctrl_out) || !this.qconn.handshake_done || this.closed : return
        let ctrl = this.qconn.open_server_uni_stream()
        h3_write_control_settings(ctrl.send_hdr, this.worker.server.max_request_header_size)
        this.ctrl_out = ctrl
        this.qconn.enqueue_send_stream(ctrl)
    }

    fn send_goaway() {
        if this.goaway_sent || this.closed : return
        this.goaway_sent = true
        this.draining = true
        this.ensure_ctrl_out()
        let ctrl = this.ctrl_out
        if isset(ctrl) {
            let tmp = ByteBuffer.new(16)
            h3_write_goaway(tmp, this.next_goaway_id)
            ctrl.queue_tail(tmp.view(0, tmp.length))
        }
    }

    fn close_with_error(code: u64) {
        if this.closed : return
        this.closed = true
        each this.bidi_streams as st, _ {
            st.cancelled = true
            let w = st.write_waker
            if isset(w) : w.wake()
        }
        this.bidi_streams.clear()
        this.uni_streams.clear()
        this.qconn.close_with_error(code, true)
    }

    // Processes only QUIC streams that received data/FIN/reset in this batch.
    fn pump_ready_rx(now_ms: uint) (bool, bool) {
        let ready = this.qconn.rx_ready_streams
        if ready.length == 0 : return (false, false)
        let progressed = true
        let dispatched = false
        this.last_activity_ms = now_ms

        let i: uint = 0
        while i < ready.length && !this.closed {
            let qst = ready[i]
            i++
            let sid = qst.id
            if (sid & 0x02) != 0 {
                // Client unidirectional stream
                let u = this.uni_streams.get(sid) !? null
                if !isset(u) {
                    let created = H3ServerUniStream { qst: qst }
                    this.uni_streams.set(sid, created)
                    u = created
                }
                if !this.process_uni_data(u) {
                    u.closed = true
                    this.uni_streams.remove(sid)
                    this.qconn.release_stream(qst)
                } else if qst.recv_fin || qst.recv_reset {
                    if u.type_known && (u.stream_type == H3_STREAM_CONTROL || u.stream_type == H3_STREAM_QPACK_ENCODER || u.stream_type == H3_STREAM_QPACK_DECODER) {
                        this.close_with_error(H3_ERR_CLOSED_CRITICAL_STREAM)
                        break
                    }
                    u.closed = true
                    this.uni_streams.remove(sid)
                    this.qconn.release_stream(qst)
                }
            } else {
                // Client bidirectional request stream
                let st: ?H3ServerStream = null
                if qst.has_partial_app {
                    st = this.bidi_streams.get(sid) !? null
                }
                if !isset(st) {
                    if this.draining {
                        qst.reset_send(H3_ERR_REQUEST_REJECTED)
                        this.qconn.release_stream(qst)
                        continue
                    }
                    if sid + 4 > this.next_goaway_id : this.next_goaway_id = sid + 4
                    let created = this.worker.take_h3_stream(this, qst)
                    // Fast path: complete single-packet request skips bidi_streams HashMap entirely!
                    if !qst.recv_fin && !qst.recv_reset {
                        qst.has_partial_app = true
                        this.bidi_streams.set(sid, created)
                    }
                    st = created
                }
                if qst.recv_reset {
                    st.cancelled = true
                    let w = st.write_waker
                    if isset(w) : w.wake()
                    if !st.dispatched {
                        if qst.has_partial_app {
                            qst.has_partial_app = false
                            this.bidi_streams.remove(sid)
                        }
                        st.release()
                    }
                    continue
                }
                if !st.read_done && !st.cancelled {
                    if qst.recv_buf.length > 0 : this.parse_request_frames(st)
                    if !this.closed && !st.cancelled && qst.recv_fin {
                        st.read_done = true
                        if this.finish_request_read(st) : dispatched = true
                    }
                }
                if st.cancelled && !st.dispatched {
                    if qst.has_partial_app {
                        qst.has_partial_app = false
                        this.bidi_streams.remove(sid)
                    }
                    st.release()
                }
            }
        }
        ready.clear()
        return (progressed, dispatched)
    }

    fn process_uni_data(u: H3ServerUniStream) bool {
        let qst = u.qst
        let buf = qst.recv_buf
        let pos: uint = 0
        let view = buf.view(0, buf.length)
        if !u.type_known {
            let ok, stype, next = h3_varint_try_read(view, pos)
            if !ok : return true
            pos = next
            u.type_known = true
            u.stream_type = stype
            if stype == H3_STREAM_CONTROL {
                if this.has_peer_control {
                    this.close_with_error(H3_ERR_STREAM_CREATION_ERROR)
                    return false
                }
                this.has_peer_control = true
            } else if stype == H3_STREAM_QPACK_ENCODER {
                if this.has_peer_qpack_enc {
                    this.close_with_error(H3_ERR_STREAM_CREATION_ERROR)
                    return false
                }
                this.has_peer_qpack_enc = true
                let dropped = buf.length
                buf.clear()
                qst.on_recv_consumed(dropped)
                return true
            } else if stype == H3_STREAM_QPACK_DECODER {
                if this.has_peer_qpack_dec {
                    this.close_with_error(H3_ERR_STREAM_CREATION_ERROR)
                    return false
                }
                this.has_peer_qpack_dec = true
                let dropped = buf.length
                buf.clear()
                qst.on_recv_consumed(dropped)
                return true
            } else if stype == H3_STREAM_PUSH {
                this.close_with_error(H3_ERR_STREAM_CREATION_ERROR)
                return false
            } else {
                let dropped = buf.length
                buf.clear()
                qst.on_recv_consumed(dropped)
                return true
            }
        }
        if u.stream_type != H3_STREAM_CONTROL {
            let dropped = buf.length
            buf.clear()
            qst.on_recv_consumed(dropped)
            return true
        }
        while pos < view.length {
            if !u.frame_in_progress {
                let ok1, ftype, p1 = h3_varint_try_read(view, pos)
                if !ok1 : break
                let ok2, flen, p2 = h3_varint_try_read(view, p1)
                if !ok2 : break
                if !u.got_settings && ftype != H3_FRAME_SETTINGS {
                    this.close_with_error(H3_ERR_MISSING_SETTINGS)
                    return false
                }
                if ftype == H3_FRAME_DATA || ftype == H3_FRAME_HEADERS || ftype == H3_FRAME_PUSH_PROMISE {
                    this.close_with_error(H3_ERR_FRAME_UNEXPECTED)
                    return false
                }
                if flen > 65_536 {
                    this.close_with_error(H3_ERR_EXCESSIVE_LOAD)
                    return false
                }
                u.frame_in_progress = true
                u.frame_type = ftype
                u.frame_len = flen
                pos = p2
            }
            let need = u.frame_len.to(uint)
            if view.length - pos < need : break
            let payload = view.view(pos, need)
            pos += need
            u.frame_in_progress = false
            if u.frame_type == H3_FRAME_SETTINGS {
                if u.got_settings {
                    this.close_with_error(H3_ERR_FRAME_UNEXPECTED)
                    return false
                }
                u.got_settings = true
                if !this.parse_settings(payload) : return false
            } else if u.frame_type == H3_FRAME_GOAWAY {
                this.draining = true
            }
        }
        if pos > 0 {
            if pos == buf.length : buf.clear()
            else : buf.clear_range(0, pos)
            qst.on_recv_consumed(pos)
        }
        return true
    }

    fn parse_settings(payload: local &[u8]) bool {
        let seen = HashMap[u64, bool].new()
        let pos: uint = 0
        while pos < payload.length {
            let ok1, id, p1 = h3_varint_try_read(payload, pos)
            if !ok1 {
                this.close_with_error(H3_ERR_FRAME_ERROR)
                return false
            }
            let ok2, _, p2 = h3_varint_try_read(payload, p1)
            if !ok2 {
                this.close_with_error(H3_ERR_FRAME_ERROR)
                return false
            }
            if h3_is_forbidden_setting(id) || seen.has(id) {
                this.close_with_error(H3_ERR_SETTINGS_ERROR)
                return false
            }
            seen.set(id, true)
            pos = p2
        }
        return true
    }

    fn parse_request_frames(st: H3ServerStream) {
        let qst = st.qst
        let buf = qst.recv_buf
        let server = this.worker.server
        let header_limit = server.max_request_header_size == 0 ? uint.$max : server.max_request_header_size
        let body_limit = server.max_request_body_size == 0 ? uint.$max : server.max_request_body_size
        let pos: uint = 0
        let total = buf.length
        while pos < total && !st.cancelled && !this.closed {
            let avail = total - pos
            let view = buf.view(pos, avail)
            if !st.frame_in_progress {
                let ok1, ftype, p1 = h3_varint_try_read(view, 0)
                if !ok1 : break
                let ok2, flen, p2 = h3_varint_try_read(view, p1)
                if !ok2 : break
                pos += p2
                if ftype == H3_FRAME_SETTINGS || ftype == H3_FRAME_GOAWAY || ftype == H3_FRAME_CANCEL_PUSH || ftype == H3_FRAME_MAX_PUSH_ID || ftype == H3_FRAME_PUSH_PROMISE {
                    this.close_with_error(H3_ERR_FRAME_UNEXPECTED)
                    return
                }
                if ftype == H3_FRAME_HEADERS {
                    if st.got_trailers {
                        st.reset(H3_ERR_FRAME_UNEXPECTED)
                        return
                    }
                    if flen > header_limit {
                        st.reset(H3_ERR_MESSAGE_ERROR)
                        return
                    }
                } else if ftype == H3_FRAME_DATA {
                    if !st.got_headers || st.got_trailers {
                        st.reset(H3_ERR_FRAME_UNEXPECTED)
                        return
                    }
                }
                st.frame_in_progress = true
                st.frame_type = ftype
                st.frame_remaining = flen
                if flen == 0 {
                    st.frame_in_progress = false
                    if ftype == H3_FRAME_HEADERS {
                        this.close_with_error(H3_ERR_QPACK_DECOMPRESSION_FAILED)
                        return
                    }
                }
                continue
            }
            let take = avail.to(u64) < st.frame_remaining ? avail : st.frame_remaining.to(uint)
            let chunk = buf.view(pos, take)
            pos += take
            st.frame_remaining -= take.to(u64)

            if st.frame_type == H3_FRAME_HEADERS {
                let existing_hbuf = st.headers_buf
                if !isset(existing_hbuf) && st.frame_remaining == 0 {
                    st.frame_in_progress = false
                    let fields = qpack_decode(chunk, header_limit) ! {
                        if E == .limit : st.reset(H3_ERR_MESSAGE_ERROR)
                        else : this.close_with_error(H3_ERR_QPACK_DECOMPRESSION_FAILED)
                        return
                    }
                    this.apply_request_headers(st, fields, body_limit)
                } else {
                    let hbuf = existing_hbuf ?? <{
                        let b = ByteBuffer.new(take < 256 ? 256 : take)
                        st.headers_buf = b
                        return b
                    }
                    hbuf.write(chunk)
                    if st.frame_remaining == 0 {
                        st.frame_in_progress = false
                        let fields = qpack_decode(hbuf.view(0, hbuf.length), header_limit) ! {
                            if E == .limit : st.reset(H3_ERR_MESSAGE_ERROR)
                            else : this.close_with_error(H3_ERR_QPACK_DECOMPRESSION_FAILED)
                            return
                        }
                        hbuf.clear()
                        this.apply_request_headers(st, fields, body_limit)
                    }
                }
            } else if st.frame_type == H3_FRAME_DATA {
                if st.req_body_len > body_limit || take > body_limit - st.req_body_len {
                    st.reset(H3_ERR_MESSAGE_ERROR)
                    return
                }
                let expected = st.expected_length
                if isset(expected) && (st.req_body_len > expected || take > expected - st.req_body_len) {
                    st.reset(H3_ERR_MESSAGE_ERROR)
                    return
                }
                let bbuf = st.req_body ?? <{
                    let b = ByteBuffer.new(take < 1024 ? 1024 : take)
                    st.req_body = b
                    return b
                }
                bbuf.write(chunk)
                st.req_body_len += take
                if st.frame_remaining == 0 : st.frame_in_progress = false
            } else {
                if st.frame_remaining == 0 : st.frame_in_progress = false
            }
        }
        if pos > 0 {
            if pos == total : buf.clear()
            else : buf.clear_range(0, pos)
            qst.on_recv_consumed(pos)
        }
    }

    fn apply_request_headers(st: H3ServerStream, fields: Array[HpackField], body_limit: uint) {
        if !st.got_headers {
            st.got_headers = true
            if !h3_validate_request_headers(fields, st) {
                st.reset(H3_ERR_MESSAGE_ERROR)
                return
            }
            let expected = st.expected_length
            if isset(expected) && expected > body_limit {
                st.reset(H3_ERR_MESSAGE_ERROR)
                return
            }
            st.req_fields = fields
            if st.expect_continue {
                let hdr = st.qst.send_hdr
                h3_write_frame_header(hdr, H3_FRAME_HEADERS, 4)
                hdr.write_byte(0x00)
                hdr.write_byte(0x00)
                hdr.write_byte(0xff)
                hdr.write_byte(0x00)
                this.qconn.enqueue_send_stream(st.qst)
            }
        } else {
            st.got_trailers = true
            if !h3_validate_trailers(fields) {
                st.reset(H3_ERR_MESSAGE_ERROR)
                return
            }
        }
    }

    fn finish_request_read(st: H3ServerStream) bool {
        if st.cancelled || st.dispatched : return false
        if st.frame_in_progress || st.qst.recv_buf.length > 0 {
            st.reset(H3_ERR_FRAME_ERROR)
            return false
        }
        if !st.got_headers {
            st.reset(H3_ERR_REQUEST_INCOMPLETE)
            return false
        }
        let expected = st.expected_length
        if isset(expected) && st.req_body_len != expected {
            st.reset(H3_ERR_MESSAGE_ERROR)
            return false
        }
        if !this.peer_cert_loaded {
            this.peer_cert_loaded = true
            if this.worker.endpoint.listener.context.has_client_ca {
                @unsafe
                this.client_subject = net.quic_peer_subject(this.qconn.ssl)
                this.client_sha256 = net.quic_peer_sha256(this.qconn.ssl)
            }
        }
        st.dispatched = true
        this.active_handlers++
        this.worker.total_active_handlers++
        this.worker.ready_streams.push_back(st)
        return true
    }

    fn handle_stream(st: H3ServerStream) {
        defer {
            this.active_handlers--
            this.worker.total_active_handlers--
            if !st.cancelled && !this.closed {
                st.qst.finish_send()
            }
            if st.qst.has_partial_app {
                st.qst.has_partial_app = false
                this.bidi_streams.remove(st.qst.id)
            }
            st.release()
            if !this.worker.in_dispatch : this.worker.wake()
        }
        let fields = st.req_fields ?! return
        let method = st.req_method
        let target = st.req_target
        let path = target
        let query = ""
        target.index_of_byte('?') -> index: {
            path = target.range(0, index)
            query = target.range(index + 1, target.bytes - index - 1)
        }
        let rbody = st.req_body
        let body = isset(rbody) ? rbody.into_string() : ""
        st.req_body = null

        let request = Request {
            method: method,
            path: path,
            query_string: query,
            body_data: body,
            header_data: "",
            h2_fields: fields,
            peer_address: net.SocketAddress {},
            client_subject: this.client_subject,
            client_certificate_sha256: this.client_sha256
        }
        let response: ?Response = null
        let static_info: ?fs.FileInfo = null
        let server = this.worker.server
        if method != "CONNECT" && isset(server.static_dirs) {
            let found = static_file(server.static_dirs, path)
            if isset(found) {
                if found.redirect {
                    response = Response.redirect(static_redirect_location(path, query), 301)
                } else {
                    response = Response.file(found.path)
                    static_info = found.info
                }
            }
        }
        if !isset(response) : response = method == "CONNECT" ? Response.empty(501) : server.handler(request)
        if !isset(response) || st.cancelled || this.closed : return
        this.send_response(st, request, response, static_info) ! {
            st.reset(H3_ERR_INTERNAL_ERROR)
        }
    }

    fn file_plan_for(request: Request, status: u16, meta: FileMeta, content_type: String, extra: ?Headers, accept_encoding: String) ?FilePlan {
        if status != 200 : return null
        let get = request.method == "GET"
        if !get && request.method != "HEAD" : return null
        if isset(extra) && (extra.has("etag") || extra.has("last-modified") || extra.has("content-encoding")) : return null
        let range = get ? request.header("range") !? "" : ""
        return file_plan(meta, content_type, this.worker.server.compress, request.header("if-none-match") !? "",
            request.header("if-modified-since") !? "", range, request.header("if-range") !? "", accept_encoding)
    }

    fn send_response(st: H3ServerStream, request: Request, response: Response, known_info: ?fs.FileInfo) !H2Error {
        let source = response.stream_reader
        let file: ?fs.FileStream = null
        let body = response.body
        let open_body = isset(source) && !isset(response.stream_size)
        let size: uint = isset(source) ? response.stream_size ?? 0 : body.bytes
        let events = response.event_reader
        if isset(events) : events.stop = this.worker.server.stop
        let content_type = response.content_type
        let status = response.status
        let extra = response.header_list
        let plan: ?FilePlan = null
        let path = response.filepath
        let cached: ?CachedFile = null
        let cached_body = false
        if isset(path) {
            let info = known_info
            if !isset(info) : info = fs.stat(path) !? null
            if isset(info) && info.kind != fs.FileKind.directory {
                content_type = fs.mime_type(fs.extension(path))
                if isset(extra) : content_type = extra.get("content-type") !? content_type
                let accept_encoding = request.header("accept-encoding") !? ""
                cached = cached_file(path, info)
                plan = this.file_plan_for(request, status, isset(cached) ? cached.meta : file_meta(info.size, info.modified_time), content_type, extra, accept_encoding)
                let in_memory = cached
                if isset(in_memory) && !(isset(plan) && (plan.status == 304 || plan.status == 416)) {
                    let sidecar: ?String = null
                    if isset(plan) : sidecar = cached_precompressed(in_memory, content_type, this.worker.server.compress, accept_encoding, plan)
                    if isset(sidecar) {
                        body = sidecar
                    } else {
                        let data = cached_file_data(in_memory)
                        if !isset(data) {
                            plan = null
                            status = 500
                            body = ""
                        } else if isset(plan) && plan.zstd {
                            body = cached_file_zstd(in_memory, data, this.worker.server.compress_level)
                        } else if isset(plan) && plan.gzip {
                            body = cached_file_gzip(in_memory, data, this.worker.server.compress_level)
                        } else if isset(plan) {
                            body = data.range(plan.start, plan.length)
                        } else {
                            body = data
                        }
                    }
                    source = null
                    size = body.bytes
                    cached_body = true
                } else if isset(plan) {
                    if plan.status == 304 || plan.status == 416 {
                        size = 0
                    } else {
                        file = open_precompressed_sidecar(path, info, content_type, this.worker.server.compress, accept_encoding, plan)
                        if isset(file) {
                            source = file.to(io.Reader)
                            size = plan.length
                        }
                    }
                }
                if !cached_body && !isset(file) && !(isset(plan) && (plan.status == 304 || plan.status == 416)) {
                    file = fs.stream(path) !? null
                    if isset(file) {
                        source = file.to(io.Reader)
                        size = info.size
                    } else {
                        plan = null
                        status = 404
                        size = 0
                    }
                }
            } else {
                status = 404
                size = 0
            }
        }
        defer h2_close_file(file)
        if isset(plan) {
            status = plan.status
            if !cached_body || plan.status == 304 || plan.status == 416 : size = plan.length
            open_body = false
            if isset(file) && plan.start > 0 : file.seek(plan.start.to(int)) ! throw .protocol
            if (plan.zstd || plan.gzip) && isset(file) && request.method == "HEAD" {
                source = null
                open_body = true
            } else if (plan.zstd || plan.gzip) && isset(file) {
                let data = io.read_all(file.to(io.Reader)) ! throw .protocol
                if data.length != plan.size : throw .protocol
                source = null
                body = plan.zstd ? compress.zstd(data, this.worker.server.compress_level) : compress.gzip(data, this.worker.server.compress_level)
                size = body.bytes
            }
            if status == 304 || status == 416 : source = null
        }
        if status < 200 || status > 599 : status = 500
        let headers = h3_resp_headers
        headers.clear()
        headers.append(.{ name: ":status", value: status == 200 ? "200" : status.to_string() })
        if isset(extra) : content_type = extra.get("content-type") !? content_type
        if !isset(source) && !isset(plan) && !cached_body && this.worker.server.compress && status != 204 && status != 304 && body.bytes >= GZIP_MIN_SIZE
            && response_gzip_type(content_type) && !(isset(extra) && extra.has("content-encoding")) {
            headers.append(.{ name: "vary", value: "Accept-Encoding" })
            let accept_enc = request.header("accept-encoding") !? ""
            if request_accepts_zstd(accept_enc) {
                body = compress.zstd(body, this.worker.server.compress_level)
                size = body.bytes
                headers.append(.{ name: "content-encoding", value: "zstd" })
            } else if request_accepts_gzip(accept_enc) {
                body = compress.gzip(body, this.worker.server.compress_level)
                size = body.bytes
                headers.append(.{ name: "content-encoding", value: "gzip" })
            }
        }
        if isset(plan) {
            if status == 416 {
                content_type = "text/plain"
                headers.append(.{ name: "content-range", value: "bytes */" + plan.size })
            } else {
                h2_file_plan_fields(headers, plan)
            }
        }
        let trailer_headers = response.trailer_list
        let trailers: ?Array[HpackField] = null
        if isset(trailer_headers) {
            let list = Array[HpackField].new(trailer_headers.length)
            each trailer_headers as value, name {
                if response_header_is_framing(name) : continue
                let field = HpackField { name: name.lower(), value: value, never_index: true }
                if h2_regular_field(field) : list.append(field)
            }
            if list.length > 0 : trailers = list
        }
        let has_trailers = isset(trailers)
        if status != 304 || !isset(plan) {
            if response_header_value_is_safe(content_type) : headers.append(.{ name: "content-type", value: content_type })
            if status != 204 && !open_body && !has_trailers : headers.append(.{ name: "content-length", value: h2_uint_str(size) })
        }
        if isset(extra) {
            each extra as value, name {
                if response_header_is_framing(name) : continue
                let field = HpackField { name: name.lower(), value: value, never_index: true }
                if h2_regular_field(field) : headers.append(field)
            }
        }
        let filename = response.filename
        if isset(filename) && response_header_value_is_safe(filename) && (!isset(extra) || !extra.has("content-disposition")) {
            let disposition = ByteBuffer.new()
            disposition.write("attachment; filename=\"")
            write_response_quoted_header_value(disposition, filename)
            disposition.write("\"")
            headers.append(.{ name: "content-disposition", value: disposition.into_string() })
        }

        // Encode HEADERS frame directly into QuicStream.send_hdr
        let qst = st.qst
        let qbuf = h3_qpack_buf
        qbuf.clear()
        qpack_encode(headers, qbuf)
        h3_write_frame_header(qst.send_hdr, H3_FRAME_HEADERS, qbuf.length.to(u64))
        qst.send_hdr.write(qbuf.view(0, qbuf.length))

        let no_body = request.method == "HEAD" || status == 204 || status == 304 || (size == 0 && !open_body)
        if !no_body {
            if open_body && isset(source) {
                let waker = sync.Waker.new() !? null
                st.write_waker = waker
                if !qst.has_partial_app {
                    qst.has_partial_app = true
                    this.bidi_streams.set(qst.id, st)
                }
                let chunk_buf = h2_take_chunk_buf()
                defer h2_give_chunk_buf(chunk_buf)
                let fhdr = ByteBuffer.new(16)
                while !st.cancelled && !this.closed {
                    let read = read_body_piece(source, chunk_buf.view_spare(16_384)) ! throw .protocol
                    if read == 0 : break
                    fhdr.clear()
                    h3_write_frame_header(fhdr, H3_FRAME_DATA, read.to(u64))
                    qst.queue_tail(fhdr.view(0, fhdr.length))
                    qst.queue_tail(chunk_buf.view_spare(16_384).view(0, read))
                    this.worker.wake()
                    while qst.pending_send_bytes() >= H3_STREAM_SEND_HIGH_WATER && !st.cancelled && !this.closed {
                        if isset(waker) : waker.wait(25)
                        else : coro.await_last()
                    }
                }
            } else if isset(source) {
                let waker = sync.Waker.new() !? null
                st.write_waker = waker
                if !qst.has_partial_app {
                    qst.has_partial_app = true
                    this.bidi_streams.set(qst.id, st)
                }
                let offset: uint = 0
                let chunk_buf = h2_take_chunk_buf()
                defer h2_give_chunk_buf(chunk_buf)
                let fhdr = ByteBuffer.new(16)
                while offset < size && !st.cancelled && !this.closed {
                    let amount = size - offset
                    if amount > 16_384 : amount = 16_384
                    let read = source.read(chunk_buf.view_spare(amount)) ! throw .protocol
                    if read == 0 || read > amount : throw .protocol
                    fhdr.clear()
                    h3_write_frame_header(fhdr, H3_FRAME_DATA, read.to(u64))
                    qst.queue_tail(fhdr.view(0, fhdr.length))
                    qst.queue_tail(chunk_buf.view_spare(amount).view(0, read))
                    offset += read
                    if qst.pending_send_bytes() >= H3_STREAM_SEND_HIGH_WATER {
                        this.worker.wake()
                        while qst.pending_send_bytes() >= H3_STREAM_SEND_HIGH_WATER && !st.cancelled && !this.closed {
                            if isset(waker) : waker.wait(25)
                            else : coro.await_last()
                        }
                    }
                }
            } else if size > 0 {
                h3_write_frame_header(qst.send_hdr, H3_FRAME_DATA, size.to(u64))
                if size > 512 {
                    // Zero-copy: QuicStream encrypts directly out of `body` (cached static file / large response)!
                    qst.send_body = body
                } else {
                    qst.send_hdr.write(body.view(0, size))
                }
            }
        }
        if isset(trailers) && !st.cancelled && !this.closed {
            qbuf.clear()
            qpack_encode(trailers, qbuf)
            let tf = ByteBuffer.new(qbuf.length + 16)
            h3_write_frame_header(tf, H3_FRAME_HEADERS, qbuf.length.to(u64))
            tf.write(qbuf.view(0, qbuf.length))
            qst.queue_tail(tf.view(0, tf.length))
        }
    }
}

fn h3_validate_request_headers(fields: Array[HpackField], st: H3ServerStream) bool {
    let saw_regular = false
    let method = ""
    let scheme = ""
    let path = ""
    let authority = ""
    let has_authority = false
    let host: ?String = null
    let content_length: ?uint = null
    each fields as f {
        let name = f.name
        if name.bytes == 0 : return false
        if name[0] == ':' {
            if saw_regular || !response_header_value_is_safe(f.value) : return false
            if name == ":method" {
                if method.bytes > 0 || f.value.bytes == 0 : return false
                method = f.value
            } else if name == ":scheme" {
                if scheme.bytes > 0 || f.value.bytes == 0 : return false
                scheme = f.value
            } else if name == ":path" {
                if path.bytes > 0 || f.value.bytes == 0 : return false
                path = f.value
            } else if name == ":authority" {
                if has_authority : return false
                has_authority = true
                authority = f.value
            } else {
                return false
            }
            continue
        }
        saw_regular = true
        if !h2_regular_field(f) : return false
        if name == "host" {
            if isset(host) : return false
            host = f.value
        }
        if name == "expect" && f.value.equals_ignore_ascii_case("100-continue") : st.expect_continue = true
        if name == "content-length" {
            if f.value.bytes == 0 : return false
            let parsed: uint = 0
            each f.value as byte {
                if byte < '0' || byte > '9' : return false
                if parsed > uint.$max / 10 : return false
                parsed *= 10
                parsed = parsed.checked_add((byte - '0').to(uint)) ! return false
            }
            let prev = content_length
            if isset(prev) && prev != parsed : return false
            content_length = parsed
        }
    }
    if method.bytes == 0 || !response_header_name_is_safe(method) : return false
    if isset(host) && authority.bytes > 0 && host != authority : return false
    if method == "CONNECT" {
        if authority.bytes == 0 || scheme.bytes > 0 || path.bytes > 0 : return false
    } else {
        if scheme != "http" && scheme != "https" : return false
        if (!path.starts_with("/") && !(method == "OPTIONS" && path == "*")) || path.contains("#") : return false
        if authority.bytes == 0 && (!isset(host) || host == "") : return false
    }
    st.req_method = method
    st.req_target = path
    st.expected_length = content_length
    return true
}

fn h3_validate_trailers(fields: Array[HpackField]) bool {
    each fields as f {
        if f.name.bytes == 0 || f.name[0] == ':' : return false
        if !h2_regular_field(f) : return false
    }
    return true
}

class H3Worker {
    server: atomic ServerWorkerData
    endpoint: net.QuicEndpoint
    conns: Array[H3ServerConn] (.new(16))
    ready_streams: Deque[H3ServerStream] (.new())
    h3_stream_pool: Array[H3ServerStream] (.new(128))
    idle_servers: Array[sync.Waker] (.{})
    servers: uint (0)
    runners: uint (0)
    waking: uint (0)
    total_active_handlers: uint (0)
    waker: sync.Waker (.{})
    watcher_waker: sync.Waker (.{})
    watcher_started: bool (false)
    watcher_armed: bool (false)
    watcher_timeout_ms: uint (25)
    in_dispatch: bool (false)
    stopped: bool (false)

    fn wake() {
        this.waker.wake()
    }

    fn take_h3_stream(conn: H3ServerConn, qst: net.QuicStream) H3ServerStream {
        let st = this.h3_stream_pool.pop_last() !? null
        if isset(st) {
            st.conn = conn
            st.qst = qst
            st.frame_in_progress = false
            st.frame_type = 0
            st.frame_remaining = 0
            st.headers_buf = null
            st.req_fields = null
            st.req_method = ""
            st.req_target = ""
            st.req_body = null
            st.req_body_len = 0
            st.expected_length = null
            st.got_headers = false
            st.got_trailers = false
            st.expect_continue = false
            st.read_done = false
            st.dispatched = false
            st.write_waker = null
            st.cancelled = false
            st.closed = false
            return st
        }
        return H3ServerStream { conn: conn, qst: qst }
    }

    fn give_h3_stream(st: H3ServerStream) {
        if this.h3_stream_pool.length < 256 : this.h3_stream_pool.append(st)
    }

    fn dispatch_ready() {
        if this.ready_streams.length == 0 : return
        if this.runners == 0 && this.waking == 0 {
            this.wake_one_server()
        }
    }

    fn wake_one_server() {
        if this.stopped : return
        let idle = this.idle_servers.pop_last() !? null
        if isset(idle) {
            this.waking++
            idle.wake()
            return
        }
        if this.servers < H3_SERVE_POOL_MAX {
            let waker = sync.Waker.new() !? null
            if isset(waker) {
                this.servers++
                this.waking++
                co this.serve_loop(waker)
                return
            }
        }
        this.waking++
        co this.serve_overflow()
    }

    fn serve_loop(waker: sync.Waker) {
        while true {
            this.waking--
            this.serve_ready()
            if this.stopped : break
            this.idle_servers.append(waker)
            waker.wait()
            if this.stopped : break
        }
        this.servers--
    }

    fn serve_overflow() {
        this.waking--
        this.serve_ready()
    }

    fn runner_yielded() {
        this.runners--
        if this.ready_streams.length > 0 && this.runners == 0 && this.waking == 0 {
            this.wake_one_server()
        }
    }

    fn serve_ready() {
        let self_coro = coro.current_coro.@cast(coro.Coro)
        this.runners++
        while true {
            let st = this.ready_streams.pop_front() ! break
            self_coro.on_yield_fn = h3_worker_on_yield
            self_coro.on_yield_arg = this.@cast(ptr)
            st.conn.handle_stream(st)
            if !isset(self_coro.on_yield_fn) {
                this.runners++
                break
            }
            self_coro.on_yield_fn = null
            self_coro.on_yield_arg = null
        }
        this.runners--
        if this.ready_streams.length > 0 && this.runners == 0 && this.waking == 0 {
            this.wake_one_server()
        }
    }

    fn watcher_loop() {
        while !this.stopped {
            if !this.watcher_armed {
                this.watcher_waker.wait(50)
                continue
            }
            let tms = this.watcher_timeout_ms
            net.quic_await_fd(this.endpoint.fd, true, false, tms)
            this.watcher_armed = false
            this.waker.wake()
        }
    }

    fn run() {
        let draining = false
        let ep = this.endpoint
        let last_sweep_ms = time.mono_ms()
        let last_timer_ms = last_sweep_ms
        let zero_wait_spins: uint = 0
        while true {
            if !draining && this.server.stopping != 0 {
                draining = true
                each this.conns as c : c.send_goaway()
            }

            let now_us = time.mono_us().to(u64)
            let now_ms = (now_us / 1000).to(uint)
            let got_rx = ep.recv_batch(now_us, !draining)

            // Attach newly accepted QUIC connections
            if ep.new_conns.length > 0 {
                each ep.new_conns as qconn {
                    let c = H3ServerConn.create(this, qconn)
                    this.conns.append(c)
                }
                ep.new_conns.clear()
            }

            let dispatched_any = false
            let ci: uint = 0
            while ci < this.conns.length {
                let c = this.conns[ci]
                if !c.closed && !c.qconn.closing {
                    if !isset(c.ctrl_out) && c.qconn.handshake_done : c.ensure_ctrl_out()
                    let _, dp = c.pump_ready_rx(now_ms)
                    if dp : dispatched_any = true
                }
                ci++
            }

            // Run newly dispatched synchronous handlers before flushing QUIC packets
            if dispatched_any {
                this.in_dispatch = true
                this.dispatch_ready()
                coro.await_last()
                this.in_dispatch = false
            }

            // Wake any streaming handlers whose send buffer drained below high water
            if this.total_active_handlers > 0 {
                each this.conns as c {
                    if c.active_handlers > 0 {
                        each c.bidi_streams as st, _ {
                            let w = st.write_waker
                            if isset(w) && st.qst.pending_send_bytes() < H3_STREAM_SEND_HIGH_WATER {
                                w.wake()
                            }
                        }
                    }
                }
            }

            // Periodic timer tick under continuous load so loss/PTO/delayed-ACK timers never starve
            if now_ms >= last_timer_ms && now_ms - last_timer_ms >= 5 {
                last_timer_ms = now_ms
                ep.process_timers(now_us, 25)
            }

            // Flush all dirty QUIC connections (GSO bursts + sendmmsg batch)
            let more_dirty = ep.flush_all(time.mono_us().to(u64))

            // Periodic idle / closed connection sweep
            let do_sweep = draining || (now_ms >= last_sweep_ms && now_ms - last_sweep_ms >= 100)
            if do_sweep {
                last_sweep_ms = now_ms
                let idle_ms = this.server.idle_timeout_ms
                ci = 0
                while ci < this.conns.length {
                    let c = this.conns[ci]
                    let q = c.qconn
                    let drop = q.closed || q.is_draining_expired(now_us) || (draining && (c.closed || q.closing))
                    if !drop && !c.closed && !q.closing && c.active_handlers == 0 && c.bidi_streams.length == 0 {
                        if draining {
                            drop = true
                        } else if idle_ms > 0 && now_ms >= c.last_activity_ms && now_ms - c.last_activity_ms >= idle_ms {
                            drop = true
                        }
                    }
                    if drop {
                        c.close_with_error(H3_ERR_NO_ERROR)
                        ep.drop_conn(q)
                        this.conns.swap_remove(ci)
                        let ei: uint = 0
                        while ei < ep.conns.length {
                            if ep.conns[ei] == q {
                                ep.conns.swap_remove(ei)
                                break
                            }
                            ei++
                        }
                    } else {
                        ci++
                    }
                }
            }

            if draining {
                if this.conns.length == 0 : break
                if time.mono_ms() >= this.server.deadline_ms : break
            }

            if got_rx || more_dirty {
                zero_wait_spins = 0
                continue
            }

            let max_wait: uint = draining ? 10 : 25
            let wait_ms = ep.process_timers(time.mono_us().to(u64), max_wait)
            if wait_ms == 0 {
                if zero_wait_spins < 4 {
                    zero_wait_spins++
                    coro.await_last()
                    continue
                }
                wait_ms = 1
            } else {
                zero_wait_spins = 0
            }

            if this.total_active_handlers == 0 && !this.watcher_armed {
                net.quic_await_fd(ep.fd, true, false, wait_ms)
                continue
            }
            if !this.watcher_started {
                this.watcher_started = true
                co this.watcher_loop()
            }
            if !this.watcher_armed {
                this.watcher_timeout_ms = wait_ms
                this.watcher_armed = true
                this.watcher_waker.wake()
            }
            this.waker.wait(wait_ms)
        }

        this.stopped = true
        if this.watcher_started : this.watcher_waker.wake()
        while true {
            let idle = this.idle_servers.pop_last() ! break
            idle.wake()
        }
        each this.conns as c : c.close_with_error(H3_ERR_NO_ERROR)
        this.conns.clear()
        ep.close()
    }
}

fn h3_worker_on_yield(arg: ptr) {
    let worker = arg.@cast(H3Worker)
    worker.runner_yielded()
}

fn h3_worker(server: atomic ServerWorkerData, listener: atomic net.QuicListener) {
    let ep = net.QuicEndpoint.new(listener, server.max_connections)
    let w = H3Worker { server: server, endpoint: ep }
    await co w.run()
    if --server.workers == 0 : server.done.unlock()
}

// Fast pseudo-random numbers: xoshiro256** seeded with splitmix64, one generator per thread

/// A fast pseudo-random number generator (xoshiro256**) with its own state.
///
/// The same seed gives the same numbers on every platform, which makes tests and
/// simulations repeatable. Not for secrets: use `crypto.random_bytes`, `uint.random()` or
/// `String.random` for keys and tokens. A generator is not meant to be shared between
/// threads; the functions of this namespace use one per thread.
+ class Rng {
    - s0: u64
    - s1: u64
    - s2: u64
    - s3: u64

    /// Creates a generator whose numbers follow from `seed` alone.
    + static fn new(seed: u64) SELF {
        let rng = SELF { s0: 0, s1: 0, s2: 0, s3: 0 }
        rng.reseed(seed)
        return rng
    }

    /// Creates a generator seeded from the operating system's entropy source.
    + static fn from_entropy() SELF {
        let rng = SELF { s0: u64.random(), s1: u64.random(), s2: u64.random(), s3: u64.random() }
        // An all-zero state would only give zeros
        if (rng.s0 | rng.s1 | rng.s2 | rng.s3) == 0 : rng.s0 = 1
        return rng
    }

    /// Restarts the sequence as if the generator was created with `seed`.
    + fn reseed(seed: u64) {
        let x = seed
        x += 0x9e3779b97f4a7c15
        this.s0 = splitmix(x)
        x += 0x9e3779b97f4a7c15
        this.s1 = splitmix(x)
        x += 0x9e3779b97f4a7c15
        this.s2 = splitmix(x)
        x += 0x9e3779b97f4a7c15
        this.s3 = splitmix(x)
    }

    /// Returns the next 64 random bits.
    + fn next() u64 {
        let result = rotl(this.s1 * 5, 7) * 9
        let t = this.s1 << 17
        this.s2 ^= this.s0
        this.s3 ^= this.s1
        this.s1 ^= this.s2
        this.s0 ^= this.s3
        this.s2 ^= t
        this.s3 = rotl(this.s3, 45)
        return result
    }

    /// Returns a number from 0 up to but not including `n`, each equally likely; 0 when `n` is 0.
    + fn below(n: uint) uint {
        if n == 0 : return 0
        let bound = n.to(u64)
        // Lemire's method: the high half of a 128-bit product, redrawn in the rare biased case
        let high, low = this.next().mul_wide(bound)
        if low < bound {
            let threshold = (0 - bound) % bound
            while low < threshold {
                let next_high, next_low = this.next().mul_wide(bound)
                high = next_high
                low = next_low
            }
        }
        return high.to(uint)
    }

    /// Returns a number from `min` to `max`, both included, each equally likely.
    ///
    /// The bounds may be given in either order.
    + fn between(min: int, max: int) int {
        let low = min
        let high = max
        if low > high {
            low = max
            high = min
        }
        let span = high.to(u64) - low.to(u64) + 1
        // The whole int range
        if span == 0 : return this.next().to(int)
        return (low.to(u64) + this.below(span.to(uint)).to(u64)).to(int)
    }

    /// Returns a float from 0 up to but not including 1, with 53 random bits.
    + fn fraction() float {
        return (this.next() >> 11).to(float) * (1.0 / 9007199254740992.0)
    }

    /// Returns true with probability `p`: never for 0 or less, always for 1 or more.
    + fn chance(p: float) bool {
        return this.fraction() < p
    }
}

global thread_rng: ?Rng (null)

// This thread's generator, seeded from the OS on first use
fn rng() Rng {
    let existing = thread_rng
    if isset(existing) : return existing
    let created = Rng.from_entropy()
    thread_rng = created
    return created
}

/// Returns the next 64 random bits of this thread's generator.
///
/// Each thread has a generator seeded from the operating system on first use. The numbers
/// are fast to make but predictable to someone who sees enough of them: use
/// `crypto.random_bytes`, `uint.random()` or `String.random` for secrets.
+ fn next() u64 {
    return rng().next()
}

/// Returns a number from 0 up to but not including `n`, each equally likely; 0 when `n` is 0.
+ fn below(n: uint) uint {
    return rng().below(n)
}

/// Returns a number from `min` to `max`, both included, each equally likely.
///
/// The bounds may be given in either order: `random.between(1, 6)` rolls a die.
+ fn between(min: int, max: int) int {
    return rng().between(min, max)
}

/// Returns a float from 0 up to but not including 1.
+ fn fraction() float {
    return rng().fraction()
}

/// Returns true with probability `p`: never for 0 or less, always for 1 or more.
+ fn chance(p: float) bool {
    return rng().chance(p)
}

/// Seeds this thread's generator, so the numbers that follow repeat from run to run.
+ fn seed(value: u64) {
    rng().reseed(value)
}

fn splitmix(x: u64) u64 {
    let z = x
    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) * 0x94d049bb133111eb
    return z ^ (z >> 31)
}

fn rotl(x: u64, k: u64) u64 $inline {
    return (x << k) | (x >> (64 - k))
}

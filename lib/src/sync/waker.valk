@unsafe

use ext
use io
use coro
use core
use gc
use time

/// A wakeup for the coroutine or thread that waits on it; `wake` may be called from any thread.
///
/// `wait` parks the current coroutine (or blocks a native thread) until a wake arrives or
/// the timeout runs out. Wakes are counted loosely: a wake that nobody waited for is kept
/// and ends the next `wait` early, and several wakes may end just one, so callers re-check
/// their condition in a loop. A waker holds no operating system resource.
+ class Waker $atomic {
    - guard: uint (0)
    - signaled: uint (0)
    // The waiting coro.Park, if one waits
    - waiting: ?ptr (null)

    /// Returns a new waker.
    ///
    /// Never fails since the waker holds no operating system resource; the error type is kept
    /// for existing callers.
    + static fn new() SELF !SyncError {
        let waker = SELF {}
        #if GROVE_MT
        waker.fin_declare()
        #end
        return waker
    }

    #if GROVE_MT
    // K6: a waker that holds no park needs no finalizer
    fn fin_declare() @threadsafe {
        gc.fin_needs_word(this.@cast(ptr), @ref(this.waiting).@cast(ptr))
    }
    #end

    /// Wakes the waiter; safe from any thread, and kept for the next `wait` when nobody waits.
    + fn wake() @threadsafe {
        coro.spin_acquire(@ref(this.guard))
        let waiting = this.waiting
        if !isset(waiting) {
            this.signaled = 1
            coro.spin_release(@ref(this.guard))
            return
        }
        this.waiting = null
        coro.spin_release(@ref(this.guard))
        if coro.wake_park(waiting.@cast(*coro.Park)) : return
        // The waiter timed out at the same moment: keep the wake for its next wait
        coro.spin_acquire(@ref(this.guard))
        this.signaled = 1
        coro.spin_release(@ref(this.guard))
    }

    /// Waits for a wake; returns false when `timeout_ms` (0 = forever) ran out first.
    ///
    /// Returns true right away when an earlier wake is still pending, consuming it.
    + fn wait(timeout_ms: uint (0)) bool @threadsafe {
        coro.spin_acquire(@ref(this.guard))
        if this.signaled != 0 {
            this.signaled = 0
            coro.spin_release(@ref(this.guard))
            return true
        }
        let p = coro.park_new(true)
        this.waiting = p.@cast(ptr)
        coro.spin_release(@ref(this.guard))

        let woken = coro.park_wait(p, timeout_ms)
        if !woken {
            // Timed out: take the park back unless a `wake` already took it
            coro.spin_acquire(@ref(this.guard))
            let withdrawn = this.waiting == p.@cast(ptr)
            if withdrawn : this.waiting = null
            coro.spin_release(@ref(this.guard))
            if withdrawn : coro.park_release(p)
        }
        coro.park_release(p)
        return woken
    }

    // Drops a wake that nobody waited for
    fn clear() @threadsafe {
        coro.spin_acquire(@ref(this.guard))
        this.signaled = 0
        coro.spin_release(@ref(this.guard))
    }

    // S4: whether the waiter's thread ended while it waited (it left its park)
    fn is_dead() bool @threadsafe {
        coro.spin_acquire(@ref(this.guard))
        let waiting = this.waiting
        let dead = isset(waiting) && (atomic_load(waiting.@cast(*coro.Park).state) & coro.PARK_LEFT) != 0
        coro.spin_release(@ref(this.guard))
        return dead
    }

    // S4: a waker collected while it holds a park (its waiter's thread ended) lets the park go
    fn gc_free() {
        let waiting = this.waiting
        if isset(waiting) : coro.park_drop(waiting.@cast(*coro.Park))
    }
}

// S4: a queue of wakers drops those whose waiter's thread ended and wakes each, which lets
// its park and its thread's doorbell go. At twice the length the last drop left, and at
// least 16. Returns the length to compare with next time
fn drop_dead_wakers(list: locked Array[Waker], kept: uint) uint {
    let length = list.length
    if length < 16 || length < kept * 2 : return kept
    let i: uint = 0
    while i < list.length {
        let waker = list.get(i) ! break
        if waker.is_dead() {
            list.remove(i)
            waker.wake()
            continue
        }
        i++
    }
    return list.length
}

// S4 for a rendezvous channel's senders: a dead sender's value stays, as one from `try_send`
fn drop_dead_senders(list: locked Deque[?Waker], kept: uint) uint {
    let length = list.length
    if length < 16 || length < kept * 2 : return kept
    let live: uint = 0
    let i: uint = 0
    while i < length {
        let sender = list.get(i) !? null
        if isset(sender) {
            if sender.is_dead() {
                list.set(i, null) _
                sender.wake()
            } else {
                live++
            }
        }
        i++
    }
    return live
}

// Wakers are reused per thread: a wait takes one, a finished wait puts it back
global waker_cache: Array[Waker] (.{})

// `poll` takes i32 milliseconds: a longer remainder would wrap into a negative or
// otherwise wrong timeout, so it is capped
fn poll_timeout_ms(remaining: uint) i32 {
    if remaining > 2147483647 : return 2147483647
    return remaining.to(i32)
}

// A late wake from the waker's previous use must not end the next wait
fn take_waker() Waker !SyncError {
    let cached = waker_cache.pop_last() !? null
    if isset(cached) {
        cached.clear()
        return cached
    }
    return Waker.new() !>
}

fn release_waker(waker: Waker) {
    if waker_cache.length < 64 : waker_cache.append(waker)
}

#if TEST
/// Test hook: leaves a wake on a cached waker, like a late wake after a wait ended.
+ fn leave_stale_wake_for_test() !SyncError {
    let waker = take_waker() !>
    waker.wake()
    release_waker(waker)
}

/// Test hook: the `poll` timeout used for a remaining duration in milliseconds.
+ fn poll_timeout_ms_for_test(remaining: uint) i32 {
    return poll_timeout_ms(remaining)
}
#end

use core
use time

class BarrierState {
    count: uint
    arrived: uint (0)
    generation: uint (0)
    waiters: Array[Waker] (.{})
}

/// Synchronizes a fixed number of coroutines or threads at a rendezvous point.
///
/// Each participant calls `wait()`, which blocks until `parties` participants have arrived.
/// Once all arrive, everyone wakes and the barrier resets for the next round. Exactly one
/// participant per round receives `true` (the leader) and the others receive `false`.
///
/// ```valk
/// let barrier = sync.Barrier.new(4) !!
/// let is_leader = barrier.wait() !!
/// ```
+ class Barrier $atomic {
    - state: core.Lock[BarrierState]

    /// Creates a reusable barrier for `count` participants.
    ///
    /// Throws `init` when `count` is 0 or its lock cannot be created.
    + static fn new(count: uint) SELF !SyncError {
        if count == 0 : throw .init
        return SELF {
            state: core.Lock[BarrierState].new(BarrierState { count: count }) ! throw .init
        }
    }

    /// The number of participants required to trip the barrier.
    + get parties: uint {
        lock this.state as s : return s.count
    }

    /// Waits until all participants have called `wait` for the current round.
    ///
    /// Returns `true` for exactly one participant (the leader) and `false` for the rest.
    /// `timeout_ms` 0 waits forever; throws `timeout` if the deadline expires before the round
    /// completes (undoing this caller's arrival). Inside a coroutine only the coroutine waits.
    + fn wait(timeout_ms: uint (0)) bool !SyncError @threadsafe {
        let my_gen: uint = 0
        let tripped = false
        let to_wake: ?Array[Waker] = null
        lock this.state as s {
            my_gen = s.generation
            s.arrived++
            if s.arrived >= s.count {
                s.generation++
                s.arrived = 0
                to_wake = s.waiters.clone()
                s.waiters.clear()
                tripped = true
            }
        }
        if tripped {
            if isset(to_wake) {
                each to_wake as w : w.wake()
            }
            return true
        }

        let waker = take_waker() !>
        let deadline = time.deadline_ms(timeout_ms)
        while true {
            let done = false
            lock this.state as s {
                if s.generation != my_gen {
                    done = true
                } else {
                    s.waiters.append(waker)
                }
            }
            if done : break

            let remaining: uint = 0
            if deadline > 0 {
                let now = time.mono_ms()
                if now >= deadline {
                    let completed = this.cancel_arrival(my_gen, waker)
                    release_waker(waker)
                    if completed : return false
                    throw .timeout
                }
                remaining = deadline - now
            }

            waker.wait(remaining)
            this.forget(waker)
        }
        release_waker(waker)
        return false
    }

    // Undoes an arrival on timeout if the generation has not tripped yet; returns true if it
    // already tripped in the meantime.
    fn cancel_arrival(gen: uint, waker: Waker) bool @threadsafe {
        lock this.state as s {
            s.waiters.remove_value(waker)
            if s.generation != gen : return true
            if s.arrived > 0 : s.arrived--
            return false
        }
    }

    fn forget(waker: Waker) @threadsafe {
        lock this.state as s : s.waiters.remove_value(waker)
    }
}

use core
use coro
use time
use io

class CancelState {
    cancelled: bool (false)
    waiters: Array[shared Waker] (.{})
    children: Array[shared CancelToken] (.{})
    callbacks: Array[shared fn()()] (.{})
    fds: Array[Fd] (.{})
}

/// A cancellation signal shared between coroutines and threads.
///
/// Cancelling a token cancels every child made with `child`, wakes every `wait`, runs the
/// callbacks registered with `on_cancel`, and interrupts the I/O of connections that
/// watch it (`net.TcpConnection.set_cancel`). Channel operations take a token so a blocked
/// send or receive ends with `cancelled`. A token cannot be reset.
+ class CancelToken {
    - state: shared core.Lock[CancelState]

    /// Returns a token that is not cancelled; throws `init` when its lock cannot be created.
    + static fn new() SELF !SyncError {
        return SELF { state: core.Lock[CancelState].new(CancelState {}) ! throw .init }
    }

    /// Returns true once the token was cancelled.
    + fn is_cancelled() bool @threadsafe {
        lock this.state as s : return s.cancelled
    }

    /// Cancels this token and its children; a second call does nothing.
    ///
    /// Wakes the waiters, then cancels the children, then runs the callbacks, all on the
    /// calling thread.
    + fn cancel() @threadsafe {
        let waiters: ?Array[shared Waker] = null
        let children: ?Array[shared CancelToken] = null
        let callbacks: ?Array[shared fn()()] = null
        lock this.state as s {
            if s.cancelled : return
            s.cancelled = true
            // Under the lock, so a descriptor that `unwatch_fd` has released
            // (and that may since have been reused) is never touched
            each s.fds as fd : io.interrupt_fd(fd)
            s.fds.clear()
            waiters = s.waiters.copy()
            children = s.children.copy()
            callbacks = s.callbacks.copy()
            s.waiters.clear()
            s.children.clear()
            s.callbacks.clear()
        }
        if isset(waiters) {
            each waiters as waker : waker.wake()
        }
        if isset(children) {
            each children as child : child.cancel()
        }
        if isset(callbacks) {
            each callbacks as callback : callback()
        }
    }

    /// Returns a new token that is cancelled when this one is, or right away when it already is.
    ///
    /// Cancelling the child does not cancel this token. Throws `init`.
    + fn child() SELF !SyncError @threadsafe {
        let child = SELF.new() !>
        let cancelled = false
        lock this.state as s {
            if s.cancelled : cancelled = true
            else : s.children.append(child.@cast(shared SELF))
        }
        if cancelled : child.cancel()
        return child
    }

    /// Runs `callback` on the cancelling thread when cancelled; right away when already cancelled.
    + fn on_cancel(callback: shared fn()()) @threadsafe {
        let now = false
        lock this.state as s {
            if s.cancelled : now = true
            else : s.callbacks.append(callback)
        }
        if now : callback()
    }

    /// Waits until the token is cancelled; returns false when `timeout_ms` (0 = forever) ran out.
    ///
    /// Parks the current coroutine, or blocks a native thread outside one.
    + fn wait(timeout_ms: uint (0)) bool @threadsafe {
        if this.is_cancelled() : return true
        let waker = take_waker() ! return this.is_cancelled()
        let deadline = time.deadline_ms(timeout_ms)
        let result = false
        while true {
            let cancelled = false
            lock this.state as s {
                cancelled = s.cancelled
                if !cancelled : s.waiters.append(waker)
            }
            if cancelled {
                result = true
                break
            }
            let remaining: uint = 0
            if deadline > 0 {
                let now = time.mono_ms()
                if now >= deadline {
                    this.forget(waker)
                    break
                }
                remaining = deadline - now
            }
            let woke = waker.wait(remaining)
            this.forget(waker)
            if !woke {
                result = this.is_cancelled()
                break
            }
        }
        release_waker(waker)
        return result
    }

    /// Cancels the token after `ms` milliseconds.
    ///
    /// The timer is a coroutine started on the calling thread, so it only fires while that
    /// thread keeps running its coroutines.
    + fn cancel_after(ms: uint) @threadsafe {
        let token = this.@cast(shared SELF)
        co cancel_later(token, ms)
    }

    // Interrupts socket I/O on `fd` when cancelled (see
    // `net.TcpConnection.set_cancel`); true when already cancelled, in which
    // case the caller interrupts it itself
    fn watch_fd(fd: Fd) bool @threadsafe {
        lock this.state as s {
            if s.cancelled : return true
            s.fds.append(fd)
        }
        return false
    }

    fn unwatch_fd(fd: Fd) @threadsafe {
        lock this.state as s : s.fds.remove_value(fd)
    }

    fn register(waker: shared Waker) bool @threadsafe {
        lock this.state as s {
            if s.cancelled : return true
            s.waiters.append(waker)
        }
        return false
    }

    fn forget(waker: shared Waker) @threadsafe {
        lock this.state as s : s.waiters.remove_value(waker)
    }
}

fn cancel_later(token: shared CancelToken, ms: uint) {
    time.sleep_ms(ms)
    token.cancel()
}

@unsafe

use core
use coro
use time
use io
use mem

class CancelState {
    cancelled: bool (false)
    waiters: Array[Waker] (.{})
    children: Array[CancelToken] (.{})
    callbacks: Array[atomic fn()()] (.{})
    // S8: watch records (*FdWatch) of descriptors that a cancel interrupts
    watches: Array[uint] (.{})
    // The length the last clean-up of `watches` left
    watches_kept: uint (0)
}

// S8: a descriptor that a token interrupts when cancelled, in malloc'd memory. One reference for
// the token's list and one for the object that watches it. `alive` is cleared under the guard
// before the descriptor is closed, so a cancel never touches a descriptor number reused since
struct FdWatch {
    fd: Fd
    alive: uint
    refs: uint
    guard: uint
}

/// A cancellation signal shared between coroutines and threads.
///
/// Cancelling a token cancels every child made with `child`, wakes every `wait`, runs the
/// callbacks registered with `on_cancel`, and interrupts the I/O of connections that
/// watch it (`net.TcpConnection.set_cancel`). Channel operations take a token so a blocked
/// send or receive ends with `cancelled`. A token cannot be reset.
+ class CancelToken $atomic {
    - state: core.Lock[CancelState]

    /// Returns a token that is not cancelled; throws `init` when its lock cannot be created.
    + static fn new() SELF !SyncError {
        return SELF { state: core.Lock[CancelState].new(CancelState {}) ! throw .init }
    }

    /// Returns true once the token was cancelled.
    + fn is_cancelled() bool @threadsafe {
        lock this.state as s : return s.cancelled
    }

    /// Cancels this token and its children; a second call does nothing.
    ///
    /// Wakes the waiters, then cancels the children, then runs the callbacks, all on the
    /// calling thread.
    + fn cancel() @threadsafe {
        let waiters: ?Array[Waker] = null
        let children: ?Array[CancelToken] = null
        let callbacks: ?Array[atomic fn()()] = null
        lock this.state as s {
            if s.cancelled : return
            s.cancelled = true
            // Under each record's guard, so a descriptor that its owner has closed (and whose
            // number may have been reused since) is never touched
            each s.watches as record : watch_cancel(record)
            s.watches.clear()
            waiters = s.waiters.clone()
            children = s.children.clone()
            callbacks = s.callbacks.clone()
            s.waiters.clear()
            s.children.clear()
            s.callbacks.clear()
        }
        if isset(waiters) {
            each waiters as waker : waker.wake()
        }
        if isset(children) {
            each children as child : child.cancel()
        }
        if isset(callbacks) {
            each callbacks as callback : callback()
        }
    }

    /// Returns a new token that is cancelled when this one is, or right away when it already is.
    ///
    /// Cancelling the child does not cancel this token. Throws `init`.
    + fn child() SELF !SyncError @threadsafe {
        let child = SELF.new() !>
        let cancelled = false
        lock this.state as s {
            if s.cancelled : cancelled = true
            else : s.children.append(child)
        }
        if cancelled : child.cancel()
        return child
    }

    /// Runs `callback` on the cancelling thread when cancelled; right away when already cancelled.
    + fn on_cancel(callback: atomic fn()()) @threadsafe {
        let now = false
        lock this.state as s {
            if s.cancelled : now = true
            else : s.callbacks.append(callback)
        }
        if now : callback()
    }

    /// Waits until the token is cancelled; returns false when `timeout_ms` (0 = forever) ran out.
    ///
    /// Parks the current coroutine, or blocks a native thread outside one.
    + fn wait(timeout_ms: uint (0)) bool @threadsafe {
        if this.is_cancelled() : return true
        let waker = take_waker() ! return this.is_cancelled()
        let deadline = time.deadline_ms(timeout_ms)
        let result = false
        while true {
            let cancelled = false
            lock this.state as s {
                cancelled = s.cancelled
                if !cancelled : s.waiters.append(waker)
            }
            if cancelled {
                result = true
                break
            }
            let remaining: uint = 0
            if deadline > 0 {
                let now = time.mono_ms()
                if now >= deadline {
                    this.forget(waker)
                    break
                }
                remaining = deadline - now
            }
            let woke = waker.wait(remaining)
            this.forget(waker)
            if !woke {
                result = this.is_cancelled()
                break
            }
        }
        release_waker(waker)
        return result
    }

    /// Cancels the token after `ms` milliseconds.
    ///
    /// The timer is a coroutine started on the calling thread, so it only fires while that
    /// thread keeps running its coroutines.
    + fn cancel_after(ms: uint) @threadsafe {
        let token = this.@cast(SELF)
        co cancel_later(token, ms)
    }

    // Interrupts socket I/O on `fd` once cancelled (see `net.TcpConnection.set_cancel`). Returns
    // the watch record for `unwatch_fd`, or null when the token is already cancelled; the caller
    // then interrupts the descriptor itself
    fn watch_fd(fd: Fd) ?ptr @threadsafe {
        let record = mem.new[FdWatch](.{ fd: fd, alive: 1, refs: 2, guard: 0 })
        let cancelled = false
        lock this.state as s {
            if s.cancelled {
                cancelled = true
            } else {
                s.watches.append(record.@cast(uint))
                s.watches_kept = drop_dead_watches(s.watches, s.watches_kept, false)
            }
        }
        if cancelled {
            mem.free(record)
            return null
        }
        return record.@cast(ptr)
    }

    // The watcher stops watching, before it closes its descriptor
    fn unwatch_fd(record: ?ptr) @threadsafe {
        let r = record ?! return
        watch_kill(r)
        let found = false
        lock this.state as s {
            let before = s.watches.length
            s.watches.remove_value(r.@cast(uint))
            found = s.watches.length != before
        }
        if found : watch_release(r)
        watch_release(r)
    }

    fn register(waker: Waker) bool @threadsafe {
        lock this.state as s {
            if s.cancelled : return true
            s.waiters.append(waker)
        }
        return false
    }

    fn forget(waker: Waker) @threadsafe {
        lock this.state as s : s.waiters.remove_value(waker)
    }

    #if TEST
    /// Test hook: the watch records the token holds.
    + fn watches_for_test() uint @threadsafe {
        lock this.state as s : return s.watches.length
    }
    #end
}

fn cancel_later(token: CancelToken, ms: uint) {
    time.sleep_ms(ms)
    token.cancel()
}

// A cancel interrupts the descriptor while its watcher still holds it open, then drops the
// list's reference
fn watch_cancel(record: uint) {
    @unsafe
    let r = record.@cast(*FdWatch)
    coro.spin_acquire(@ref(r.guard))
    if r.alive != 0 : io.interrupt_fd(r.fd)
    coro.spin_release(@ref(r.guard))
    watch_release(record.@cast(ptr))
}

// The watcher is done with its descriptor: no cancel touches it from here on
fn watch_kill(record: ptr) {
    @unsafe
    let r = record.@cast(*FdWatch)
    coro.spin_acquire(@ref(r.guard))
    r.alive = 0
    coro.spin_release(@ref(r.guard))
}

fn watch_release(record: ptr) {
    @unsafe
    let r = record.@cast(*FdWatch)
    if atomic(r.refs - 1) == 1 : mem.free(r)
}

// S8: a watcher's finalizer, which may touch no other GC object, ends its watch; the token's
// list lets go of the record at its next clean-up or cancel
fn watch_drop(record: ?ptr) {
    let r = record ?! return
    watch_kill(r)
    watch_release(r)
}

// Drops the records whose watcher ended, at twice the length the last clean-up left (and at
// least 16), or always with `now`. Returns the length to compare with next time
fn drop_dead_watches(list: locked Array[uint], kept: uint, now: bool) uint {
    @unsafe
    let length = list.length
    if !now && (length < 16 || length < kept * 2) : return kept
    let i: uint = 0
    while i < list.length {
        let record = list.get(i) ! break
        if atomic_load(record.@cast(*FdWatch).alive) == 0 {
            list.remove(i)
            watch_release(record.@cast(ptr))
            continue
        }
        i++
    }
    return list.length
}

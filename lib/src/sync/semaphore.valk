use core
use time

class SemaphoreState {
    available: uint
    waiters: Array[shared Waker] (.{})
}

/// Limits how many tasks do something at once: `acquire` takes a permit, waiting while none
/// is free, and `release` gives it back.
///
/// ```valk
/// let slots: shared sync.Semaphore = sync.Semaphore.new(10) !
/// slots.acquire() !
/// defer slots.release()
/// ```
+ class Semaphore {
    - state: shared core.Lock[SemaphoreState]

    /// Returns a semaphore with `permits` free permits; throws `init` when its lock cannot be
    /// created.
    + static fn new(permits: uint) SELF !SyncError {
        return SELF { state: core.Lock[SemaphoreState].new(SemaphoreState { available: permits }) ! throw .init }
    }

    /// The number of free permits.
    + get available: uint {
        lock this.state as s : return s.available
    }

    /// Takes a permit, waiting while none is free.
    ///
    /// `timeout_ms` 0 waits forever. Throws `timeout` and `cancelled` when `cancel` fires. Inside
    /// a coroutine only the coroutine waits.
    + fn acquire(timeout_ms: uint (0), cancel: ?shared CancelToken (null)) !SyncError @threadsafe {
        let waker: ?shared Waker = null
        let deadline = time.deadline_ms(timeout_ms)
        while true {
            let taken = false
            lock this.state as s {
                if s.available > 0 {
                    s.available--
                    taken = true
                } else if isset(waker) {
                    s.waiters.append(waker)
                }
            }
            if taken : break
            if !isset(waker) {
                waker = take_waker() !>
                continue
            }
            let remaining: uint = 0
            if deadline > 0 {
                let now = time.mono_ms()
                if now >= deadline {
                    this.forget(waker)
                    release_waker(waker)
                    throw .timeout
                }
                remaining = deadline - now
            }
            if isset(cancel) && cancel.register(waker) {
                this.forget(waker)
                release_waker(waker)
                throw .cancelled
            }
            waker.wait(remaining)
            this.forget(waker)
            if isset(cancel) {
                cancel.forget(waker)
                if cancel.is_cancelled() {
                    release_waker(waker)
                    throw .cancelled
                }
            }
        }
        if isset(waker) : release_waker(waker)
    }

    /// Takes a permit when one is free, without waiting; returns whether it did.
    + fn try_acquire() bool @threadsafe {
        lock this.state as s {
            if s.available == 0 : return false
            s.available--
        }
        return true
    }

    /// Gives a permit back and wakes one waiting `acquire`.
    + fn release() @threadsafe {
        let next: ?shared Waker = null
        lock this.state as s {
            s.available++
            next = s.waiters.pop_first() !? null
        }
        if isset(next) : next.wake()
    }

    fn forget(waker: shared Waker) @threadsafe {
        lock this.state as s : s.waiters.remove_value(waker)
    }
}

use core
use time

class WaitGroupState {
    count: uint (0)
    waiters: Array[shared Waker] (.{})
}

/// Counts running tasks so another task can wait until all of them are done.
///
/// Call `add` before starting a task and `done` when it finishes; `wait` returns once the
/// count is back to 0. Share it across threads as `shared WaitGroup`. It holds no results:
/// use `await` or a `Channel` for those.
///
/// ```valk
/// let wg: shared sync.WaitGroup = sync.WaitGroup.new() !
/// each urls as u {
///     wg.add(1)
///     co download(u, wg) // calls wg.done() when finished
/// }
/// wg.wait() !
/// ```
+ class WaitGroup {
    - state: shared core.Lock[WaitGroupState]

    /// Returns a group with a count of 0; throws `init` when its lock cannot be created.
    + static fn new() SELF !SyncError {
        return SELF { state: core.Lock[WaitGroupState].new(WaitGroupState {}) ! throw .init }
    }

    /// The number of tasks that were added and are not done yet.
    + get count: uint {
        lock this.state as s : return s.count
    }

    /// Counts `n` more running tasks.
    + fn add(n: uint (1)) @threadsafe {
        lock this.state as s : s.count += n
    }

    /// Marks one task done, and wakes the waiters when it was the last. A `done` without a
    /// task left to count is ignored.
    + fn done() @threadsafe {
        let waiters: ?Array[shared Waker] = null
        lock this.state as s {
            if s.count == 0 : return
            s.count--
            if s.count == 0 {
                waiters = s.waiters.copy()
                s.waiters.clear()
            }
        }
        if isset(waiters) {
            each waiters as waker : waker.wake()
        }
    }

    /// Waits until the count is 0; returns at once when it already is.
    ///
    /// `timeout_ms` 0 waits forever. Throws `timeout`. Inside a coroutine only the coroutine
    /// waits.
    + fn wait(timeout_ms: uint (0)) !SyncError @threadsafe {
        let waker: ?shared Waker = null
        let deadline = time.deadline_ms(timeout_ms)
        while true {
            let finished = false
            lock this.state as s {
                finished = s.count == 0
                if !finished && isset(waker) : s.waiters.append(waker)
            }
            if finished : break
            if !isset(waker) {
                waker = take_waker() !>
                continue
            }
            let remaining: uint = 0
            if deadline > 0 {
                let now = time.mono_ms()
                if now >= deadline {
                    this.forget(waker)
                    release_waker(waker)
                    throw .timeout
                }
                remaining = deadline - now
            }
            waker.wait(remaining)
            this.forget(waker)
        }
        if isset(waker) : release_waker(waker)
    }

    fn forget(waker: shared Waker) @threadsafe {
        lock this.state as s : s.waiters.remove_value(waker)
    }
}

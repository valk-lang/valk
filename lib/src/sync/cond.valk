use core

class CondState {
    waiters: Array[Waker] (.{})
}

/// A condition variable that parks coroutines or threads until signaled.
///
/// Pair it with a `core.Mutex` guarding the shared state. Call `wait(mutex)` in a loop while
/// holding `mutex` until the condition becomes true; `wait` releases `mutex` while waiting
/// and always re-acquires it before returning (including on timeout).
///
/// ```valk
/// mutex.lock()
/// defer mutex.unlock()
/// while !ready {
///     cond.wait(mutex) !!
/// }
/// ```
+ class Cond $atomic {
    - state: core.Lock[CondState]

    /// Creates a new condition variable.
    + static fn new() SELF !SyncError {
        return SELF { state: core.Lock[CondState].new(CondState {}) ! throw .init }
    }

    /// Releases `mutex`, waits for `signal` or `broadcast`, and re-acquires `mutex` before
    /// returning.
    ///
    /// `mutex` must be locked by the caller. `timeout_ms` 0 waits forever; throws `timeout`
    /// if the timeout expires first (with `mutex` re-acquired). Inside a coroutine only the
    /// coroutine waits.
    + fn wait(mutex: atomic core.Mutex, timeout_ms: uint (0)) !SyncError @threadsafe {
        let waker = take_waker() !>
        lock this.state as s : s.waiters.append(waker)
        mutex.unlock()

        let woken = waker.wait(timeout_ms)
        let was_listed = this.forget(waker)
        release_waker(waker)

        // If a signal popped our waker right as we timed out, pass the signal to the next waiter
        if !woken && !was_listed : this.signal()

        mutex.lock()
        if !woken && timeout_ms > 0 : throw .timeout
    }

    /// Wakes one waiter blocked in `wait`, if any.
    + fn signal() @threadsafe {
        let next: ?Waker = null
        lock this.state as s {
            next = s.waiters.pop_first() !? null
        }
        if isset(next) : next.wake()
    }

    /// Wakes all waiters currently blocked in `wait`.
    + fn broadcast() @threadsafe {
        let waiters: ?Array[Waker] = null
        lock this.state as s {
            if s.waiters.length > 0 {
                waiters = s.waiters.clone()
                s.waiters.clear()
            }
        }
        if isset(waiters) {
            each waiters as w : w.wake()
        }
    }

    fn forget(waker: Waker) bool @threadsafe {
        lock this.state as s {
            let before = s.waiters.length
            s.waiters.remove_value(waker)
            return s.waiters.length < before
        }
    }
}

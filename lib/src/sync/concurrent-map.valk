use core

/// A map that threads read and change at the same time.
///
/// The keys are spread over shards that each have their own lock, so threads working on
/// different keys rarely wait for each other, unlike one `Lock[HashMap[K, V]]`. Keys and
/// values cross threads, so they are numbers, bools, strings or `shared` objects. A call
/// works on one key at a time; `snapshot` copies all entries, shard by shard.
///
/// ```rust
/// let hits: shared sync.ConcurrentMap[String, uint] = sync.ConcurrentMap[String, uint].new() !!
/// hits.add("home", 1)
/// let count = hits.get("home") ?? 0
/// ```
+ class ConcurrentMap[K, V] {
    - shards: Array[shared core.Lock[HashMap[K, V]]]
    - mask: uint

    /// Returns an empty map with `shards` shards, rounded up to a power of two (64 by default).
    ///
    /// Throws `init` when a lock cannot be created.
    + static fn new(shards: uint (64)) shared SELF !SyncError {
        #if (K.$has_gc_refs && !K.$nonnull.$is_shared && !K.$nonnull.$is_type_of(String)) || (V.$has_gc_refs && !V.$nonnull.$is_shared && !V.$nonnull.$is_type_of(String))
        #error "A ConcurrentMap is used by several threads, so its keys and values are numbers, bools, strings or 'shared' objects, like 'ConcurrentMap[String, shared User]'"
        #end
        let count: uint = 1
        while count < shards : count *= 2
        let list = Array[shared core.Lock[HashMap[K, V]]].new(count)
        let i: uint = 0
        while i < count {
            list.append(core.Lock[HashMap[K, V]].new(HashMap[K, V].new()) ! throw .init)
            i++
        }
        return SELF { shards: list, mask: count - 1 }
    }

    // The shard of a key, from bits HashMap itself does not use for its buckets
    - fn shard(key: K) shared core.Lock[HashMap[K, V]] @threadsafe {
        let hash: uint = 0
        #if K.$has_hash
        hash = $hash(key)
        #elif K.$is_integer || K.$is_bool
        hash = key.to(uint)
        #else
        #error "ConcurrentMap key type must define $hash"
        #end
        hash ^= hash >> 33
        hash *= 0xff51afd7ed558ccd
        hash ^= hash >> 33
        return this.shards.get((hash >> (size_of(uint) * 4)) & this.mask) !!
    }

    /// Returns the value of `key`, or `null` when the map does not hold it.
    + fn get(key: K) ?V @threadsafe {
        lock this.shard(key) as m : return m.get(key) !? null
    }

    /// Returns whether the map holds `key`.
    + fn has(key: K) bool @threadsafe {
        lock this.shard(key) as m : return m.has(key)
    }

    /// Stores `value` under `key`, replacing what was there.
    + fn set(key: K, value: V) @threadsafe {
        lock this.shard(key) as m : m.set(key, value)
    }

    /// Removes `key`; returns whether the map held it.
    + fn remove(key: K) bool @threadsafe {
        lock this.shard(key) as m {
            if !m.has(key) : return false
            m.remove(key)
            return true
        }
    }

    /// Stores what `change` makes of the current value (`null` when there is none), and returns
    /// it. `change` runs while the key's shard is locked: it must not use this map.
    + fn update(key: K, change: fn(?V)(V)) V @threadsafe {
        lock this.shard(key) as m {
            let value = change(m.get(key) !? null)
            m.set(key, value)
            return value
        }
    }

    #if V.$is_integer
    /// Adds `amount` to the value of `key`, which starts at 0, and returns the new value.
    + fn add(key: K, amount: V) V @threadsafe {
        lock this.shard(key) as m {
            let value = (m.get(key) !? 0) + amount
            m.set(key, value)
            return value
        }
    }
    #end

    /// The number of entries, counted shard by shard.
    + get length: uint {
        let total: uint = 0
        each this.shards as shard {
            lock shard as m : total += m.length
        }
        return total
    }

    /// Removes every entry.
    + fn clear() @threadsafe {
        each this.shards as shard {
            lock shard as m : m.clear()
        }
    }

    /// Returns a copy of the entries, taken shard by shard: changes made while it runs may or
    /// may not be in it.
    + fn snapshot() HashMap[K, V] @threadsafe {
        let result = HashMap[K, V].new()
        each this.shards as shard {
            lock shard as m {
                each m as value, key : result.set(key, value)
            }
        }
        return result
    }
}

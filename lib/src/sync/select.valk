use core
use time

/// Something `select` waits on. A `Channel` converts to one where it is expected, so a list
/// of channels of any element types can be passed: `sync.select(.{ jobs, quit })`.
+ class Selectable {
    // Registers the waker; true when a receive would not wait
    watch: shared fn(shared Waker)(bool)
    forget: shared fn(shared Waker)()
}

/// Waits until one of `channels` has a value to receive or is closed, and returns its index.
///
/// Take the value with `try_recv` on that channel: another receiver may have taken it first,
/// and `try_recv` then throws `empty`, so select again. Channels earlier in the list win
/// when several are ready. `timeout_ms` 0 waits forever. Throws `timeout`, `cancelled` when
/// `cancel` fires, and `empty` for an empty list. Inside a coroutine only the coroutine waits.
///
/// ```valk
/// let ready = sync.select(.{ jobs, quit }, timeout_ms: 1000) !
/// if ready == 0 : handle(jobs.try_recv() ! continue)
/// ```
+ fn select(channels: Array[Selectable], timeout_ms: uint (0), cancel: ?shared CancelToken (null)) uint !SyncError {
    if channels.length == 0 : throw .empty
    let waker = take_waker() !>
    let deadline = time.deadline_ms(timeout_ms)
    while true {
        let registered: uint = 0
        let ready: ?uint = null
        each channels as channel, i {
            if channel.watch(waker) {
                ready = i
                break
            }
            registered = i + 1
        }
        if isset(ready) {
            select_forget(channels, registered, waker)
            release_waker(waker)
            return ready
        }
        let remaining: uint = 0
        if deadline > 0 {
            let now = time.mono_ms()
            if now >= deadline {
                select_forget(channels, registered, waker)
                release_waker(waker)
                throw .timeout
            }
            remaining = deadline - now
        }
        if isset(cancel) && cancel.register(waker) {
            select_forget(channels, registered, waker)
            release_waker(waker)
            throw .cancelled
        }
        waker.wait(remaining)
        select_forget(channels, registered, waker)
        if isset(cancel) {
            cancel.forget(waker)
            if cancel.is_cancelled() {
                release_waker(waker)
                throw .cancelled
            }
        }
    }
    throw .timeout
}

fn select_forget(channels: Array[Selectable], count: uint, waker: shared Waker) {
    each channels as channel, i {
        if i >= count : break
        channel.forget(waker)
    }
}

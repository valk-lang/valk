
fn utf8_continuation(byte: u8) bool {
    return byte >= 0x80 && byte <= 0xBF
}

fn utf8_sequence_bytes(data: *[u8], bytes: uint, index: uint) uint {
    if index >= bytes : return 0
    let remaining = bytes - index
    let first = data[index]
    if first < 0x80 : return 1

    if first >= 0xC2 && first <= 0xDF {
        if remaining < 2 || !utf8_continuation(data[index + 1]) : return 0
        return 2
    }
    if first >= 0xE0 && first <= 0xEF {
        if remaining < 3 : return 0
        let second = data[index + 1]
        if first == 0xE0 && (second < 0xA0 || second > 0xBF) : return 0
        if first == 0xED && (second < 0x80 || second > 0x9F) : return 0
        if first != 0xE0 && first != 0xED && !utf8_continuation(second) : return 0
        if !utf8_continuation(data[index + 2]) : return 0
        return 3
    }
    if first >= 0xF0 && first <= 0xF4 {
        if remaining < 4 : return 0
        let second = data[index + 1]
        if first == 0xF0 && (second < 0x90 || second > 0xBF) : return 0
        if first == 0xF4 && (second < 0x80 || second > 0x8F) : return 0
        if first != 0xF0 && first != 0xF4 && !utf8_continuation(second) : return 0
        if !utf8_continuation(data[index + 2]) || !utf8_continuation(data[index + 3]) : return 0
        return 4
    }
    return 0
}

use core

+ fn parse(json: String) Value !ParseError {
    let data = ByteBuffer.new(json.bytes)
    data.write_string(json)
    return Parser.parse(data) !>
}

class Parser {
    index: uint
    data: ByteBuffer
    str_buf: ByteBuffer

    - static fn parse(data: ByteBuffer) Value !ParseError {
        let parser = Parser {
            data: data
            str_buf: ByteBuffer.new(100)
        }

        let result = parser.parse_value() !>
        parser.skip_whitespace()
        if parser.index != parser.data.length {
            throw .invalid {
                message: "Trailing character at index"
                at_index: parser.index
            }
        }
        return result
    }

    - fn parse_value() Value !ParseError {
        this.skip_whitespace()
        let ch = this.data.get(this.index++)
        if ch == '{' : return this.parse_object() !>
        if ch == '[' : return this.parse_array() !>
        if ch == '"' : return this.read_string() !>
        if (ch >= '0' && ch <= '9') || ch == '-' {
            this.index--
            return this.parse_number() !>
        }
        if ch >= 'a' && ch <= 'z' {
            this.index--
            let word = this.get_word()
            if word == "null" : return null
            if word == "true" : return true
            if word == "false" : return false
        }
        throw .invalid {
            message: "Unknown value character"
            at_index: this.index
            character: ch
        }
    }

    - fn parse_object() Value !ParseError {
        let count = 0
        let values = Map[Value]{}
        while true {
            this.skip_whitespace()
            let ch = this.data.get(this.index++)
            if ch == '}' {
                break
            }
            if count > 0 {
                if ch != ',' : throw .invalid {
                    message: "Missing object comma"
                    at_index: this.index
                }
                this.skip_whitespace()
                ch = this.data.get(this.index++)
            }
            count++
            if ch == '"' {
                let key = this.read_string() !>
                this.expect(':') !>
                values.set(key, this.parse_value() !>)
                continue
            }
            throw .invalid {
                message: "Invalid json object syntax"
                at_index: this.index
            }
        }
        return ObjectValue { values: values }
    }

    - fn parse_array() Value !ParseError {
        let values = Array[Value]{}
        let count = 0
        while true {
            this.skip_whitespace()
            let ch = this.data.get(this.index++)
            if ch == ']' {
                break
            }
            if count > 0 {
                if ch != ',' : throw .invalid {
                    message: "Missing array comma"
                    at_index: this.index
                }
                this.skip_whitespace()
                ch = this.data.get(this.index++)
            }
            count++
            this.index--
            values.append(this.parse_value() !>)
        }
        return ArrayValue { values: values }
    }

    - fn parse_number() Value !ParseError {
        let buf = this.str_buf
        let data = this.data
        buf.clear()
        let ch = data.get(this.index)
        if ch == '-' {
            buf.write_byte(ch)
            this.index++
            ch = data.get(this.index)
        }

        if ch == '0' {
            buf.write_byte(ch)
            this.index++
            ch = data.get(this.index)
            if ch >= '0' && ch <= '9' : throw .invalid {
                message: "A JSON number cannot have a leading zero"
                at_index: this.index
                character: ch
            }
        } else if ch >= '1' && ch <= '9' {
            while true {
                ch = data.get(this.index)
                if ch < '0' || ch > '9' : break
                buf.write_byte(ch)
                this.index++
            }
        } else {
            throw .invalid {
                message: "Expected a digit in JSON number"
                at_index: this.index
                character: ch
            }
        }

        let is_float = false
        let has_exponent = false
        let exponent_negative = false
        let exponent: uint = 0
        if ch == '.' {
            is_float = true
            buf.write_byte('.')
            this.index++
            ch = data.get(this.index)
            if ch < '0' || ch > '9' : throw .invalid {
                message: "Expected a digit after the decimal point"
                at_index: this.index
                character: ch
            }
            while true {
                ch = data.get(this.index)
                if ch < '0' || ch > '9' : break
                buf.write_byte(ch)
                this.index++
            }
        }

        if ch == 'e' || ch == 'E' {
            is_float = true
            has_exponent = true
            this.index++
            ch = data.get(this.index)
            if ch == '+' || ch == '-' {
                exponent_negative = ch == '-'
                this.index++
                ch = data.get(this.index)
            }
            if ch < '0' || ch > '9' : throw .invalid {
                message: "Expected a digit in JSON number exponent"
                at_index: this.index
                character: ch
            }
            while true {
                ch = data.get(this.index)
                if ch < '0' || ch > '9' : break
                exponent = exponent * 10 + (ch - '0').to(uint)
                if exponent > 400 : throw .invalid {
                    message: "JSON number exponent is outside the supported range"
                    at_index: this.index
                    character: ch
                }
                this.index++
            }
        }

        let text = buf.to_string()
        if is_float {
            let value = text.to_float() ! throw .invalid {
                message: "JSON float is outside the supported range"
                at_index: this.index
            }
            if has_exponent {
                while exponent-- > 0 {
                    if exponent_negative : value /= 10.0
                    else : value *= 10.0
                }
            }
            return value
        }
        if !integer_in_range(text) : throw .invalid {
            message: "JSON integer is outside the supported range"
            at_index: this.index
        }
        return text.to_int() ! throw .invalid {
            message: "JSON integer is outside the supported range"
            at_index: this.index
        }
    }

    - fn get_word() String {
        let buf = this.str_buf
        let data = this.data
        buf.clear()
        while true {
            let ch = data.get(this.index)
            if ch >= 'a' && ch <= 'z' {
                this.index++
                buf.write_byte(ch)
                continue
            }
            break
        }
        return buf.to_string()
    }

    - fn expect(ch: u8) !ParseError {
        this.skip_whitespace()
        let c = this.data.get(this.index++)
        if c != ch : throw .invalid {
            message: "Expected a different character"
            at_index: this.index
            character: ch
        }
    }

    - fn skip_whitespace() {
        let data = this.data
        while true {
            let ch = data.get(this.index)
            if ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n' {
                this.index++
                continue
            }
            break
        }
    }

    - fn read_string() String !ParseError {
        let buf = this.str_buf
        let data = this.data
        buf.clear()
        while true {
            let ch = data.get(this.index++)
            if ch < 32 : throw .invalid {
                message: "Unescaped control character in JSON string"
                at_index: this.index
                character: ch
            }
            if ch == '\\' {
                ch = data.get(this.index++)
                if ch == 'u' {
                    // \uXXXX carries a UTF-16 code unit, so it is decoded to
                    // UTF-8 rather than substituted for a single byte like the
                    // short escapes below.
                    write_utf8(buf, this.read_unicode_escape() !>)
                    continue
                }
                if ch == '"' || ch == '\\' || ch == '/' {
                    buf.write_byte(ch)
                    continue
                }
                if ch == 'b' : ch = '\b'
                else if ch == 'f' : ch = '\f'
                else if ch == 'n' : ch = '\n'
                else if ch == 'r' : ch = '\r'
                else if ch == 't' : ch = '\t'
                else : throw .invalid {
                    message: "Invalid JSON string escape"
                    at_index: this.index
                    character: ch
                }
                buf.write_byte(ch)
                continue
            }
            if ch == '"' : break
            if ch == 0 : throw .invalid {
                message: "Unexpected EOF"
                at_index: this.index
            }
            buf.write_byte(ch)
        }
        return buf.to_string()
    }

    // The code point of a `\u` escape, the `\u` itself already consumed.
    //
    // Anything outside the basic multiplane is written as a surrogate pair, so a
    // high surrogate is only meaningful together with the low one that follows
    // it. An unpaired surrogate is not a code point and cannot be encoded, so it
    // becomes U+FFFD rather than failing the whole parse.
    - fn read_unicode_escape() u32 !ParseError {
        let code = this.read_hex4() !>
        if code < 0xD800 || code > 0xDFFF : return code
        if code > 0xDBFF : return 0xFFFD
        if this.data.get(this.index) != '\\' || this.data.get(this.index + 1) != 'u' : return 0xFFFD

        let restore = this.index
        this.index += 2
        let low = this.read_hex4() !>
        if low < 0xDC00 || low > 0xDFFF {
            // Not a low surrogate, so it is a character in its own right and
            // must still be read as one.
            this.index = restore
            return 0xFFFD
        }
        return 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00)
    }

    - fn read_hex4() u32 !ParseError {
        let out: u32 = 0
        let i: uint = 0
        while i < 4 {
            let ch = this.data.get(this.index++)
            let digit: u32 = 0
            if ch >= '0' && ch <= '9' : digit = (ch - '0').to(u32)
            else if ch >= 'a' && ch <= 'f' : digit = (ch - 'a' + 10).to(u32)
            else if ch >= 'A' && ch <= 'F' : digit = (ch - 'A' + 10).to(u32)
            else : throw .invalid {
                message: "Invalid unicode escape"
                at_index: this.index
            }
            out = (out << 4) | digit
            i++
        }
        return out
    }
}

fn integer_in_range(text: String) bool {
    let negative = text.get(0) == '-'
    let digits = negative ? text.part(1, text.length - 1) : text
    if digits.length < 19 : return true
    if digits.length > 19 : return false
    let limit = negative ? "9223372036854775808" : "9223372036854775807"
    let i: uint = 0
    while i < digits.length {
        let digit = digits.get(i)
        let maximum = limit.get(i)
        if digit < maximum : return true
        if digit > maximum : return false
        i++
    }
    return true
}

fn write_utf8(buf: ByteBuffer, code: u32) {
    if code < 0x80 {
        buf.write_byte(code.to(u8))
        return
    }
    if code < 0x800 {
        buf.write_byte((0xC0 | (code >> 6)).to(u8))
        buf.write_byte((0x80 | (code & 0x3F)).to(u8))
        return
    }
    if code < 0x10000 {
        buf.write_byte((0xE0 | (code >> 12)).to(u8))
        buf.write_byte((0x80 | ((code >> 6) & 0x3F)).to(u8))
        buf.write_byte((0x80 | (code & 0x3F)).to(u8))
        return
    }
    buf.write_byte((0xF0 | (code >> 18)).to(u8))
    buf.write_byte((0x80 | ((code >> 12) & 0x3F)).to(u8))
    buf.write_byte((0x80 | ((code >> 6) & 0x3F)).to(u8))
    buf.write_byte((0x80 | (code & 0x3F)).to(u8))
}

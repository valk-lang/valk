@ignore_access

struct ParsedKey {
    start: uint
    bytes: uint
    escaped: bool
    decoded: String
}

struct ParsedNumber {
    start: uint
    bytes: uint
    is_float: bool
}

// Nesting limit a caller gets when it does not ask for one. Valk runs every program on
// a 1 MiB coroutine stack (lib/src/coro/stack.valk), and one level of JSON costs about
// 450 bytes of it: measured, unclosed-array input dies at depth 2400 and nested objects
// at 2200. 128 keeps a 17x margin, is the depth the wider ecosystem defaults to, and
// leaves the rest of the stack to the caller.
value JSON_MAX_DEPTH (128)
// The deepest request that is still honoured. RFC 8259 section 9 names 1000 as the depth
// an interoperable implementation should reach; more than that is not a wider limit but
// a segfault, so a larger request is clamped to this one instead of being obeyed.
value JSON_MAX_DEPTH_CEILING (1000)
value JSON_MAX_BYTES (64 * 1024 * 1024)
value JSON_MAX_ENTRIES (1_000_000)

fn clamp_depth(max_depth: uint) uint {
    if max_depth > JSON_MAX_DEPTH_CEILING : return JSON_MAX_DEPTH_CEILING
    return max_depth
}

+ fn decode(json: String | ByteBuffer, max_depth: uint (JSON_MAX_DEPTH), max_bytes: uint (JSON_MAX_BYTES), max_entries: uint (JSON_MAX_ENTRIES)) Value !ParseError {
    match json {
        String as str => return Parser[String].parse(str, str.bytes, clamp_depth(max_depth), max_bytes, max_entries) !>
        ByteBuffer as buf => return Parser[ByteBuffer].parse(buf, buf.length, clamp_depth(max_depth), max_bytes, max_entries) !>
    }
}

+ fn decode_to[T](json: String | ByteBuffer, max_depth: uint (JSON_MAX_DEPTH), max_bytes: uint (JSON_MAX_BYTES), max_entries: uint (JSON_MAX_ENTRIES)) T !DecodeError {
    match json {
        String as str => return Parser[String].parse_to[T](str, str.bytes, clamp_depth(max_depth), max_bytes, max_entries) !>
        ByteBuffer as buf => return Parser[ByteBuffer].parse_to[T](buf, buf.length, clamp_depth(max_depth), max_bytes, max_entries) !>
    }
}

struct Parser[S] {
    index: uint (0)
    source: S
    data_length: uint
    max_depth: uint (JSON_MAX_DEPTH)
    depth: uint (0)
    max_entries: uint (JSON_MAX_ENTRIES)
    entries: uint (0)
    str_buf: ByteBuffer

    - static fn parse(data: S, data_length: uint, max_depth: uint, max_bytes: uint, max_entries: uint) Value !ParseError {
        if max_bytes > 0 && data_length > max_bytes : throw .too_large {
            message: "JSON input exceeds the maximum byte length"
            at_index: max_bytes
        }
        let parser = Parser[S] {
            source: data
            data_length: data_length
            max_depth: max_depth
            max_entries: max_entries
            str_buf: ByteBuffer.new(100)
        }
        return parser.parse_root() !>
    }

    - fn parse_root() Value !ParseError {
        let result = this.parse_value() !>
        this.skip_whitespace()
        if this.index != this.data_length {
            throw .invalid {
                message: "Trailing character at index"
                at_index: this.index
                character: this.get(this.index)
            }
        }
        return result
    }

    - static fn parse_to[T](data: S, data_length: uint, max_depth: uint, max_bytes: uint, max_entries: uint) T !DecodeError {
        if max_bytes > 0 && data_length > max_bytes : throw .too_large {
            message: "JSON input exceeds the maximum byte length"
            at_index: max_bytes
        }
        let parser = Parser[S] {
            source: data
            data_length: data_length
            max_depth: max_depth
            max_entries: max_entries
            str_buf: ByteBuffer.new(100)
        }
        return parser.parse_typed_root[T]() !>
    }

    - fn parse_typed_root[T]() T !DecodeError {
        let result = this.parse_typed_type[T]() !>
        this.skip_whitespace()
        if this.index != this.data_length : throw .invalid {
            message: "Trailing character at index"
            at_index: this.index
            character: this.get(this.index)
        }
        return result
    }

    - fn get(index: uint) u8 {
        if index >= this.data_length : return 0
        return this.source[index]
    }

    - fn view(offset: uint, length: uint) ByteView[S] {
        return ByteView[S].new(this.source, offset, length)
    }

    // One level of nested container costs about 450 bytes of the 1 MiB coroutine stack
    // that every Valk program runs on, so nesting without a bound turns a few kilobytes
    // of input into a segfault. Both the untyped and the typed containers call this.
    - fn enter_container() !ParseError {
        if this.depth >= this.max_depth : throw .too_deep {
            message: "JSON nested deeper than the maximum depth"
            at_index: this.index
        }
        this.depth++
    }

    - fn leave_container() {
        this.depth--
    }

    - fn add_entry() !ParseError {
        if this.max_entries > 0 && this.entries >= this.max_entries : throw .too_large {
            message: "JSON contains more than the maximum number of entries"
            at_index: this.index
        }
        this.entries++
    }

    - fn parse_typed_type[T]() T !DecodeError {
        return this.parse_typed[T](false) !>
    }

    - fn parse_typed[T](lazy_marker: bool) T !DecodeError {
        #if T.$is_nullable
        let value = this.parse_value() !>
        return value.to_type[T]() ! throw .wrong_type {
            message: "JSON value has the wrong type"
            at_index: this.index
        }
        #elif T.$is_type_of(Value)
        return this.parse_value() !>
        #elif T.$is_integer
        this.skip_whitespace()
        let ch = this.get(this.index)
        if (ch < '0' || ch > '9') && ch != '-' : throw .wrong_type {
            message: "Expected JSON integer"
            at_index: this.index
            character: ch
        }
        let parsed = this.scan_number() !>
        if parsed.is_float : throw .wrong_type {
            message: "Expected JSON integer, got float"
            at_index: this.index
        }
        #if T.$is_signed
        let number_view = this.view(parsed.start, parsed.bytes)
        if !integer_in_range[S](number_view) : throw .wrong_type {
            message: "JSON integer is outside the target type's range"
            at_index: this.index
        }
        let number = number_view.to_int() ! throw .wrong_type {
            message: "JSON integer is outside the target type's range"
            at_index: this.index
        }
        if !integer_fits[T](number) : throw .wrong_type {
            message: "JSON integer is outside the target type's range"
            at_index: this.index
        }
        return number.to(T)
        #else
        let number_view = this.view(parsed.start, parsed.bytes)
        if number_view[0] == '-' : throw .wrong_type {
            message: "JSON integer is outside the target type's range"
            at_index: this.index
        }
        let number = number_view.to_uint() ! throw .wrong_type {
            message: "JSON integer is outside the target type's range"
            at_index: this.index
        }
        if !uint_fits[T](number) : throw .wrong_type {
            message: "JSON integer is outside the target type's range"
            at_index: this.index
        }
        return number.to(T)
        #end
        #elif T.$is_float
        this.skip_whitespace()
        let ch = this.get(this.index)
        if (ch < '0' || ch > '9') && ch != '-' : throw .wrong_type {
            message: "Expected JSON float"
            at_index: this.index
            character: ch
        }
        let parsed = this.scan_number() !>
        if !parsed.is_float : throw .wrong_type {
            message: "Expected JSON float, got int"
            at_index: this.index
        }
        let number = this.view(parsed.start, parsed.bytes).to_float() ! throw .wrong_type {
            message: "JSON float is outside the supported range"
            at_index: this.index
        }
        return number.to(T)
        #elif T.$is_type_of(String)
        this.skip_whitespace()
        if this.get(this.index++) != '"' : throw .wrong_type {
            message: "Expected JSON string"
            at_index: this.index
        }
        return this.read_string() !>
        #elif T.$is_bool
        this.skip_whitespace()
        if this.view(this.index, 4).equals("true") {
            this.index += 4
            return true.to(T)
        }
        if this.view(this.index, 5).equals("false") {
            this.index += 5
            return false.to(T)
        }
        throw .wrong_type {
            message: "Expected JSON bool"
            at_index: this.index
            character: this.get(this.index)
        }
        #elif T.$has_method(from_json_parser_auto)
        return T.from_json_parser_auto[Parser[S]](this.@cast(&Parser[S]), lazy_marker) !>
        #elif T.$has_method(from_json_value) || T.$has_method(from_json_value_auto)
        let value = this.parse_value() !>
        return value.to_type[T]() ! throw .wrong_type {
            message: "JSON value has the wrong type"
            at_index: this.index
        }
        #elif !T.$is_structural
        #error "Cannot decode JSON directly into this type"
        #elif T.$property_count > 64
        let value = this.parse_value() !>
        return value.to_type[T]() ! throw .wrong_type {
            message: "JSON value has the wrong type"
            at_index: this.index
        }
        #else
        return this.parse_typed_object[T]() !>
        #end
    }

    - fn parse_typed_object[T]() T !DecodeError {
        this.expect_typed('{', "Expected JSON object") !>
        // A recursive type (class Chain { + children: Array[Chain] }) recurses through
        // here without ever reaching parse_value, so the typed containers are counted
        // too rather than only the untyped ones.
        this.enter_container() !>
        let result = T.$zero_value
        let seen: u64 = 0
        let count = 0
        while true {
            this.skip_whitespace()
            let ch = this.get(this.index++)
            if ch == '}' : break
            if count > 0 {
                if ch != ',' : throw .invalid {
                    message: "Missing object comma"
                    at_index: this.index
                    character: ch
                }
                this.skip_whitespace()
                ch = this.get(this.index++)
            }
            this.add_entry() !>
            count++
            if ch != '"' : throw .invalid {
                message: "Invalid JSON object syntax"
                at_index: this.index
                character: ch
            }
            let key = this.read_key() !>
            this.expect(':') !>
            let matched = false
            #loop object result as prop
            if this.key_equals(key, prop.name) {
                prop = this.parse_typed_type[prop]() !>
                seen |= 1.to(u64) << prop.$index.to(u64)
                matched = true
            }
            #end
            if !matched : this.parse_value() !>
        }

        #loop object result as prop
        if (seen & (1.to(u64) << prop.$index.to(u64))) == 0 {
            #if prop.$has_default_value
            prop = prop.$default_value
            #else
            throw .missing {
                message: "Missing required JSON field: " + prop.name
                at_index: this.index
            }
            #end
        }
        #end
        this.leave_container()
        return result
    }

    - fn read_key() ParsedKey !ParseError {
        let start = this.index
        while true {
            let ch = this.get(this.index++)
            if this.index > this.data_length : throw .invalid {
                message: "Unexpected EOF"
                at_index: this.data_length
                character: 0
            }
            if ch < 32 : throw .invalid {
                message: "Unescaped control character in JSON string"
                at_index: this.index
                character: ch
            }
            if ch == '"' : return .{
                start: start
                bytes: this.index - start - 1
                escaped: false
                decoded: ""
            }
            if ch == '\\' {
                this.index = start
                let decoded = this.read_string() !>
                return .{
                    start: 0
                    bytes: decoded.bytes
                    escaped: true
                    decoded: decoded
                }
            }
        }
    }

    - fn key_equals(key: ParsedKey, expected: String) bool {
        if key.bytes != expected.bytes : return false
        if key.escaped : return key.decoded == expected
        return this.view(key.start, key.bytes).equals(expected)
    }

    - fn parse_typed_array[T]() Array[T] !DecodeError {
        this.expect_typed('[', "Expected JSON array") !>
        this.enter_container() !>
        let result = Array[T]{}
        let count = 0
        while true {
            this.skip_whitespace()
            let ch = this.get(this.index++)
            if ch == ']' : break
            if count > 0 {
                if ch != ',' : throw .invalid {
                    message: "Missing array comma"
                    at_index: this.index
                    character: ch
                }
                this.skip_whitespace()
            } else {
                this.index--
            }
            this.add_entry() !>
            count++
            result.append(this.parse_typed_type[T]() !>)
        }
        this.leave_container()
        return result
    }

    - fn expect_typed(ch: u8, message: String) !DecodeError {
        this.skip_whitespace()
        let found = this.get(this.index++)
        if found != ch : throw .wrong_type {
            message: message
            at_index: this.index
            character: found
        }
    }

    - fn parse_value() Value !ParseError {
        this.skip_whitespace()
        let ch = this.get(this.index++)
        if ch == '{' : return this.parse_object() !>
        if ch == '[' : return this.parse_array() !>
        if ch == '"' : return this.read_string() !>
        if (ch >= '0' && ch <= '9') || ch == '-' {
            this.index--
            return this.parse_number() !>
        }
        if ch >= 'a' && ch <= 'z' {
            this.index--
            let word = this.get_word()
            if word == "null" : return null
            if word == "true" : return true
            if word == "false" : return false
        }
        throw .invalid {
            message: "Unknown value character"
            at_index: this.index
            character: ch
        }
    }

    - fn parse_object() Value !ParseError {
        this.enter_container() !>
        let count = 0
        let values = Map[Value]{}
        while true {
            this.skip_whitespace()
            let ch = this.get(this.index++)
            if ch == '}' {
                break
            }
            if count > 0 {
                if ch != ',' : throw .invalid {
                    message: "Missing object comma"
                    at_index: this.index
                    character: ch
                }
                this.skip_whitespace()
                ch = this.get(this.index++)
            }
            this.add_entry() !>
            count++
            if ch == '"' {
                let key = this.read_string() !>
                this.expect(':') !>
                values.set(key, this.parse_value() !>)
                continue
            }
            throw .invalid {
                message: "Invalid json object syntax"
                at_index: this.index
                character: ch
            }
        }
        this.leave_container()
        return ObjectValue { values: values }
    }

    - fn parse_array() Value !ParseError {
        this.enter_container() !>
        let values = Array[Value]{}
        let count = 0
        while true {
            this.skip_whitespace()
            let ch = this.get(this.index++)
            if ch == ']' {
                break
            }
            if count > 0 {
                if ch != ',' : throw .invalid {
                    message: "Missing array comma"
                    at_index: this.index
                    character: ch
                }
                this.skip_whitespace()
                ch = this.get(this.index++)
            }
            this.add_entry() !>
            count++
            this.index--
            values.append(this.parse_value() !>)
        }
        this.leave_container()
        return ArrayValue { values: values }
    }

    - fn scan_number() ParsedNumber !ParseError {
        let start = this.index
        let ch = this.get(this.index)
        if ch == '-' {
            this.index++
            ch = this.get(this.index)
        }

        if ch == '0' {
            this.index++
            ch = this.get(this.index)
            if ch >= '0' && ch <= '9' : throw .invalid {
                message: "A JSON number cannot have a leading zero"
                at_index: this.index
                character: ch
            }
        } else if ch >= '1' && ch <= '9' {
            while true {
                ch = this.get(this.index)
                if ch < '0' || ch > '9' : break
                this.index++
            }
        } else {
            throw .invalid {
                message: "Expected a digit in JSON number"
                at_index: this.index
                character: ch
            }
        }

        let is_float = false
        if ch == '.' {
            is_float = true
            this.index++
            ch = this.get(this.index)
            if ch < '0' || ch > '9' : throw .invalid {
                message: "Expected a digit after the decimal point"
                at_index: this.index
                character: ch
            }
            while true {
                ch = this.get(this.index)
                if ch < '0' || ch > '9' : break
                this.index++
            }
        }

        if ch == 'e' || ch == 'E' {
            is_float = true
            this.index++
            ch = this.get(this.index)
            if ch == '+' || ch == '-' {
                this.index++
                ch = this.get(this.index)
            }
            if ch < '0' || ch > '9' : throw .invalid {
                message: "Expected a digit in JSON number exponent"
                at_index: this.index
                character: ch
            }
            let exponent: uint = 0
            while true {
                ch = this.get(this.index)
                if ch < '0' || ch > '9' : break
                exponent = exponent * 10 + (ch - '0').to(uint)
                if exponent > 400 : throw .invalid {
                    message: "JSON number exponent is outside the supported range"
                    at_index: this.index
                    character: ch
                }
                this.index++
            }
        }

        return .{ start: start, bytes: this.index - start, is_float: is_float }
    }

    - fn parse_number() Value !ParseError {
        let parsed = this.scan_number() !>
        let data = this.view(parsed.start, parsed.bytes)
        if parsed.is_float {
            return data.to_float() ! throw .invalid {
                message: "JSON float is outside the supported range"
                at_index: this.index
                character: 0
            }
        }
        if !integer_in_range[S](data) : throw .invalid {
            message: "JSON integer is outside the supported range"
            at_index: this.index
            character: 0
        }
        return data.to_int() ! throw .invalid {
            message: "JSON integer is outside the supported range"
            at_index: this.index
            character: 0
        }
    }

    - fn get_word() String {
        let buf = this.str_buf
        buf.clear()
        while true {
            let ch = this.get(this.index)
            if ch >= 'a' && ch <= 'z' {
                this.index++
                buf.write_byte(ch)
                continue
            }
            break
        }
        return buf.to_string()
    }

    - fn expect(ch: u8) !ParseError {
        this.skip_whitespace()
        let c = this.get(this.index++)
        if c != ch : throw .invalid {
            message: "Expected a different character"
            at_index: this.index
            character: c
        }
    }

    - fn skip_whitespace() {
        while true {
            let ch = this.get(this.index)
            if ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n' {
                this.index++
                continue
            }
            break
        }
    }

    - fn read_string() String !ParseError {
        let buf = this.str_buf
        buf.clear()
        while true {
            let ch = this.get(this.index++)
            if this.index > this.data_length : throw .invalid {
                message: "Unexpected EOF"
                at_index: this.data_length
                character: 0
            }
            if ch < 32 : throw .invalid {
                message: "Unescaped control character in JSON string"
                at_index: this.index
                character: ch
            }
            if ch == '\\' {
                ch = this.get(this.index++)
                if ch == 'u' {
                    write_utf8(buf, this.read_unicode_escape() !>)
                    continue
                }
                if ch == '"' || ch == '\\' || ch == '/' {
                    buf.write_byte(ch)
                    continue
                }
                if ch == 'b' : ch = '\b'
                else if ch == 'f' : ch = '\f'
                else if ch == 'n' : ch = '\n'
                else if ch == 'r' : ch = '\r'
                else if ch == 't' : ch = '\t'
                else : throw .invalid {
                    message: "Invalid JSON string escape"
                    at_index: this.index
                    character: ch
                }
                buf.write_byte(ch)
                continue
            }
            if ch == '"' : break
            if ch >= 0x80 {
                let start = this.index - 1
                let sequence_bytes = utf8_sequence_bytes[S](this.source, this.data_length, start)
                if sequence_bytes == 0 : throw .invalid {
                    message: "Invalid UTF-8 in JSON string"
                    at_index: start
                    character: ch
                }
                buf.write_byte(ch)
                let continuation_bytes = sequence_bytes - 1
                while continuation_bytes-- > 0 : buf.write_byte(this.get(this.index++))
                continue
            }
            buf.write_byte(ch)
        }
        return buf.to_string()
    }

    - fn read_unicode_escape() u32 !ParseError {
        let code = this.read_hex4() !>
        if code < 0xD800 || code > 0xDFFF : return code
        if code > 0xDBFF : return 0xFFFD
        if this.get(this.index) != '\\' || this.get(this.index + 1) != 'u' : return 0xFFFD

        let restore = this.index
        this.index += 2
        let low = this.read_hex4() !>
        if low < 0xDC00 || low > 0xDFFF {
            this.index = restore
            return 0xFFFD
        }
        return 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00)
    }

    - fn read_hex4() u32 !ParseError {
        let out: u32 = 0
        let i: uint = 0
        while i < 4 {
            let ch = this.get(this.index++)
            let digit: u32 = 0
            if ch >= '0' && ch <= '9' : digit = (ch - '0').to(u32)
            else if ch >= 'a' && ch <= 'f' : digit = (ch - 'a' + 10).to(u32)
            else if ch >= 'A' && ch <= 'F' : digit = (ch - 'A' + 10).to(u32)
            else : throw .invalid {
                message: "Invalid unicode escape"
                at_index: this.index
                character: ch
            }
            out = (out << 4) | digit
            i++
        }
        return out
    }
}

extend Array[JSON_ITEM] {
    - static fn from_json_parser_auto[P](parser: &P, lazy_marker: $X) SELF !DecodeError {
        return parser.parse_typed_array[JSON_ITEM]() !>
    }
}

fn integer_in_range[T](data: ByteView[T]) bool {
    let negative = data[0] == '-'
    let offset = negative ? 1 : 0
    let digits = data.bytes - offset
    if digits < 19 : return true
    if digits > 19 : return false
    let limit = negative ? "9223372036854775808" : "9223372036854775807"
    let i: uint = 0
    while i < digits {
        let digit = data[offset + i]
        let maximum = limit.get(i)
        if digit < maximum : return true
        if digit > maximum : return false
        i++
    }
    return true
}

fn integer_fits[T](value: int) bool {
    #if T.$is_signed
    if size_of(T) == 1 : return value >= -128 && value <= 127
    if size_of(T) == 2 : return value >= -32768 && value <= 32767
    if size_of(T) == 4 : return value >= -2147483648 && value <= 2147483647
    return true
    #else
    if value < 0 : return false
    if size_of(T) == 1 : return value <= 255
    if size_of(T) == 2 : return value <= 65535
    if size_of(T) == 4 : return value <= 4294967295
    return true
    #end
}

fn uint_fits[T](value: uint) bool {
    if size_of(T) == 1 : return value <= 255
    if size_of(T) == 2 : return value <= 65535
    if size_of(T) == 4 : return value <= 4294967295
    return true
}

fn write_utf8(buf: ByteBuffer, code: u32) {
    if code < 0x80 {
        buf.write_byte(code.to(u8))
        return
    }
    if code < 0x800 {
        buf.write_byte((0xC0 | (code >> 6)).to(u8))
        buf.write_byte((0x80 | (code & 0x3F)).to(u8))
        return
    }
    if code < 0x10000 {
        buf.write_byte((0xE0 | (code >> 12)).to(u8))
        buf.write_byte((0x80 | ((code >> 6) & 0x3F)).to(u8))
        buf.write_byte((0x80 | (code & 0x3F)).to(u8))
        return
    }
    buf.write_byte((0xF0 | (code >> 18)).to(u8))
    buf.write_byte((0x80 | ((code >> 12) & 0x3F)).to(u8))
    buf.write_byte((0x80 | ((code >> 6) & 0x3F)).to(u8))
    buf.write_byte((0x80 | (code & 0x3F)).to(u8))
}

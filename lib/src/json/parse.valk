
use core 

+ fn decode(json: String) Value !ParseError {
    let data = ByteBuffer.new(json.bytes)
    data.write_string(json)
    return Parser.parse(data) !>
}

class Parser {
    index: core:uint
    data: ByteBuffer
    str_buf: ByteBuffer

    - static fn parse(data: ByteBuffer) Value !ParseError {
        let p = Parser{
            index: 0
            data: data
            str_buf: ByteBuffer.new(100)
        }

        let result = p.parse_value() !>
        p.skip_whitespace()
        if p.index != p.data.length {
            throw .invalid {
                message: "Trailing character at index"
                at_index: p.index
            }
        }
        return result
    }

    - fn parse_value() Value !ParseError {
        this.skip_whitespace()
        let ch = this.data.get(this.index++)
        if ch == '{' {
            return this.parse_object() !>
        }
        if ch == '[' {
            return this.parse_array() !>
        }
        if ch == '"' {
            let str = this.read_string() !>
            return Value {
                type: TYPE.string
                string_value: str
            }
        }
        if (ch >= '0' && ch <= '9') || ch == '-' {
            this.index--
            return this.parse_number() !>
        }
        if ch >= 'a' && ch <= 'z' {
            this.index--
            let word = this.get_word()
            if word == "null" : return Value { type: TYPE.null }
            if word == "true" : return Value { type: TYPE.bool, bool_value: true }
            if word == "false" : return Value { type: TYPE.bool, bool_value: false }
        }
        throw .invalid {
            message: "Unknown value character"
            at_index: this.index
            character: ch
        }
    }

    - fn parse_object() Value !ParseError {
        let count = 0
        let values = Map[Value]{}
        while true {
            this.skip_whitespace()
            let ch = this.data.get(this.index++)
            if ch == '}' {
                break
            }
            if count > 0 {
                if ch != ',' : throw .invalid {
                    message: "Missing object comma"
                    at_index: this.index
                }
                this.skip_whitespace()
                ch = this.data.get(this.index++)
            }
            count++
            if ch == '"' {
                let key = this.read_string() !>
                this.expect(':') !>
                let value = this.parse_value() !>
                values.set(key, value)
                continue
            }
            throw .invalid {
                message: "Invalid json object syntax"
                at_index: this.index
            }
        }
        return Value {
            type: TYPE.object
            object_values: values
        }
    }

    - fn parse_array() Value !ParseError {
        let values = core:Array[Value]{}
        let count = 0
        while true {
            this.skip_whitespace()
            let ch = this.data.get(this.index++)
            if ch == ']' {
                break
            }
            if count > 0 {
                if ch != ',' : throw .invalid {
                    message: "Missing array comma"
                    at_index: this.index
                }
                this.skip_whitespace()
                ch = this.data.get(this.index++)
            }
            count++
            this.index--
            let v = this.parse_value() !>
            values.append(v)
        }
        return Value {
            type: TYPE.array
            array_values: values
        }
    }

    - fn parse_number() Value !ParseError {
        let buf = this.str_buf
        let data = this.data
        buf.clear()
        let ch : u8 = 0
        let negative = false
        if (data.get(this.index)) == '-' {
            negative = true
            this.index++
        }
        while true {
            ch = data.get(this.index++)
            if ch >= '0' && ch <= '9' {
                buf.write_byte(ch)
                continue
            }
            break
        }

        if ch == '.' {
            // Float
            buf.write_byte('.')
            while true {
                ch = data.get(this.index++)
                if ch >= '0' && ch <= '9' {
                    buf.write_byte(ch)
                    continue
                }
                break
            }

            this.index--
            return Value {
                type: TYPE.float
                float_value: (buf.to_string().to_float() !? 0) * (negative ? -1 : 1)
            }
        }

        // Integer
        this.index--
        return Value {
            type: TYPE.int
            int_value: (buf.to_string().to_int() !? 0) * (negative ? -1 : 1)
        }
    }

    - fn get_word() String {
        let buf = this.str_buf
        let data = this.data
        buf.clear()
        while true {
            let ch = data.get(this.index)
            if ch >= 'a' && ch <= 'z' {
                this.index++
                buf.write_byte(ch)
                continue
            }
            break
        }
        return buf.to_string()
    }

    - fn expect(ch: u8) !ParseError {
        this.skip_whitespace()
        let c = this.data.get(this.index++)
        if c != ch : throw .invalid {
            message: "Expected a different character"
            at_index: this.index
            character: ch
        }
    }

    - fn skip_whitespace() {
        let data = this.data
        while true {
            let ch = data.get(this.index)
            if ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n' {
                this.index++
                continue
            }
            break
        }
    }

    - fn read_string() String !ParseError {
        let buf = this.str_buf
        let data = this.data
        buf.clear()
        while true {
            let ch = data.get(this.index++)
            if ch == '\\' {
                ch = data.get(this.index++)
                if ch == 'u' {
                    // \uXXXX carries a UTF-16 code unit, so it is decoded to
                    // UTF-8 rather than substituted for a single byte like the
                    // short escapes below.
                    write_utf8(buf, this.read_unicode_escape() !>)
                    continue
                }
                if ch == 'b' : ch = '\b'
                else if ch == 'f' : ch = '\f'
                else if ch == 'n' : ch = '\n'
                else if ch == 'r' : ch = '\r'
                else if ch == 't' : ch = '\t'
                else if ch == 0 : throw .invalid {
                    message: "Unexpected EOF"
                    at_index: this.index
                }
                buf.write_byte(ch)
                continue
            }
            if ch == '"' : break
            if ch == 0 : throw .invalid {
                message: "Unexpected EOF"
                at_index: this.index
            }
            buf.write_byte(ch)
        }
        return buf.to_string()
    }

    // The code point of a `\u` escape, the `\u` itself already consumed.
    //
    // Anything outside the basic multiplane is written as a surrogate pair, so a
    // high surrogate is only meaningful together with the low one that follows
    // it. An unpaired surrogate is not a code point and cannot be encoded, so it
    // becomes U+FFFD rather than failing the whole parse.
    - fn read_unicode_escape() u32 !ParseError {
        let code = this.read_hex4() !>
        if code < 0xD800 || code > 0xDFFF : return code
        if code > 0xDBFF : return 0xFFFD
        if this.data.get(this.index) != '\\' || this.data.get(this.index + 1) != 'u' : return 0xFFFD

        let restore = this.index
        this.index += 2
        let low = this.read_hex4() !>
        if low < 0xDC00 || low > 0xDFFF {
            // Not a low surrogate, so it is a character in its own right and
            // must still be read as one.
            this.index = restore
            return 0xFFFD
        }
        return 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00)
    }

    - fn read_hex4() u32 !ParseError {
        let out: u32 = 0
        let i: uint = 0
        while i < 4 {
            let ch = this.data.get(this.index++)
            let digit: u32 = 0
            if ch >= '0' && ch <= '9' : digit = (ch - '0').to(u32)
            else if ch >= 'a' && ch <= 'f' : digit = (ch - 'a' + 10).to(u32)
            else if ch >= 'A' && ch <= 'F' : digit = (ch - 'A' + 10).to(u32)
            else : throw .invalid {
                message: "Invalid unicode escape"
                at_index: this.index
            }
            out = (out << 4) | digit
            i++
        }
        return out
    }
}

fn write_utf8(buf: ByteBuffer, code: u32) {
    if code < 0x80 {
        buf.write_byte(code.to(u8))
        return
    }
    if code < 0x800 {
        buf.write_byte((0xC0 | (code >> 6)).to(u8))
        buf.write_byte((0x80 | (code & 0x3F)).to(u8))
        return
    }
    if code < 0x10000 {
        buf.write_byte((0xE0 | (code >> 12)).to(u8))
        buf.write_byte((0x80 | ((code >> 6) & 0x3F)).to(u8))
        buf.write_byte((0x80 | (code & 0x3F)).to(u8))
        return
    }
    buf.write_byte((0xF0 | (code >> 18)).to(u8))
    buf.write_byte((0x80 | ((code >> 12) & 0x3F)).to(u8))
    buf.write_byte((0x80 | ((code >> 6) & 0x3F)).to(u8))
    buf.write_byte((0x80 | (code & 0x3F)).to(u8))
}

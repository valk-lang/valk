extend HashMap[MAP_KEY, MAP_VALUE] {
    #if MAP_KEY.$is_type_of(String)
    + fn to_json_value_with_stack(stack: Array[ptr]) Value {
        let result = Map[Value]{}
        each this as item, key {
            result.set(key, convert_value(item, stack).value)
        }
        return new_object(result)
    }

    + static fn from_json_value_auto[X](value: X) SELF !ValueError {
        let result = SELF.new()
        if !value.is_object() : throw .wrong_type { message: "Expected JSON object, got %{value.kind_name()}" }
        let items = value.object().values
        each items as item, key {
            result.set(key, from_value[MAP_VALUE](item) !>)
        }
        return result
    }
    #end
}

extend FlatMap[FLAT_KEY, FLAT_VALUE] {
    #if FLAT_KEY.$is_type_of(String)
    + fn to_json_value_with_stack(stack: Array[ptr]) Value {
        let result = Map[Value]{}
        each this as item, key {
            result.set(key, convert_value(item, stack).value)
        }
        return new_object(result)
    }

    + static fn from_json_value_auto[X](value: X) SELF !ValueError {
        let result = SELF.new()
        if !value.is_object() : throw .wrong_type { message: "Expected JSON object, got %{value.kind_name()}" }
        let items = value.object().values
        each items as item, key {
            result.set(key, from_value[FLAT_VALUE](item) !>)
        }
        return result
    }
    #end
}

extend Array[ARRAY_ITEM] {
    + fn to_json_value_with_stack(stack: Array[ptr]) Value {
        let result = Array[Value]{}
        each this as item {
            result.append(convert_value(item, stack).value)
        }
        return new_array(result)
    }

    + static fn from_json_value_auto[X](value: X) SELF !ValueError {
        let result = SELF.new()
        if !value.is_array() : throw .wrong_type { message: "Expected JSON array, got %{value.kind_name()}" }
        let items = value.array().values
        each items as item {
            result.append(from_value[ARRAY_ITEM](item) !>)
        }
        return result
    }
}

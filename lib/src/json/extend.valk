extend HashMap[MAP_KEY, MAP_VALUE] {
    // Integer keys are written as the text of the number, as JSON object keys are strings
    #if MAP_KEY.$is_integer && !MAP_KEY.$is_enum
    -+ fn to_json_value_with_stack(stack: Array[uint]) Value {
        let result = Map[Value]{}
        each this as item, key {
            result.set(key.to_string(), convert_value(item, stack))
        }
        return new_object(result)
    }

    /// Builds a map from a JSON object whose member names are integers, converting each
    /// member with `to_type`.
    ///
    /// Throws `.missing` when `value` is not an object, a name is not an integer of the key
    /// type, or a member cannot be converted to the value type.
    + static fn from_json_value_auto[X](value: X) SELF !LookupError {
        let result = SELF.new()
        if !value.is_object : throw .missing
        let items = value.object.values
        each items as item, key {
            let number = key.to(MAP_KEY) ! throw .missing
            result.set(number, item.to_type[MAP_VALUE]() !>)
        }
        return result
    }
    #end
    #if MAP_KEY.$is_type_of(String)
    -+ fn to_json_value_with_stack(stack: Array[uint]) Value {
        let result = Map[Value]{}
        each this as item, key {
            result.set(key, convert_value(item, stack))
        }
        return new_object(result)
    }

    /// Builds a map from a JSON object, converting each member with `to_type`.
    ///
    /// Only available when the key type is `String`. Throws `.missing` when `value` is
    /// not an object or a member cannot be converted to the value type.
    + static fn from_json_value_auto[X](value: X) SELF !LookupError {
        let result = SELF.new()
        if !value.is_object : throw .missing
        let items = value.object.values
        each items as item, key {
            result.set(key, item.to_type[MAP_VALUE]() !>)
        }
        return result
    }
    #end
}

extend FlatMap[FLAT_KEY, FLAT_VALUE] {
    #if FLAT_KEY.$is_type_of(String)
    -+ fn to_json_value_with_stack(stack: Array[uint]) Value {
        @unsafe
        let result = Map[Value]{}
        each this as item, key {
            result.set(key, convert_value(item, stack))
        }
        return new_object(result)
    }

    /// Builds a flat map from a JSON object, converting each member with `to_type`.
    ///
    /// Only available when the key type is `String`. Throws `.missing` when `value` is
    /// not an object or a member cannot be converted to the value type.
    + static fn from_json_value_auto[X](value: X) SELF !LookupError {
        let result = SELF.new()
        if !value.is_object : throw .missing
        let items = value.object.values
        each items as item, key {
            result.set(key, item.to_type[FLAT_VALUE]() !>)
        }
        return result
    }
    #end
}

extend Array[ARRAY_ITEM] {
    -+ fn to_json_value_with_stack(stack: Array[uint]) Value {
        #if ARRAY_ITEM.$is_raw_pointer
        @unsafe
        #end
        let result = Array[Value]{}
        each this as item {
            result.append(convert_value(item, stack))
        }
        return new_array(result)
    }

    /// Builds an array from a JSON array, converting each item with `to_type`.
    ///
    /// Throws `.missing` when `value` is not an array or an item cannot be converted to
    /// the item type.
    + static fn from_json_value_auto[X](value: X) SELF !LookupError {
        let result = SELF.new()
        if !value.is_array : throw .missing
        let items = value.array.values
        each items as item {
            result.append(item.to_type[ARRAY_ITEM]() !>)
        }
        return result
    }
}

extend HashSet[SET_ITEM] {
    -+ fn to_json_value_with_stack(stack: Array[uint]) Value {
        let result = Array[Value]{}
        each this as item {
            result.append(convert_value(item, stack))
        }
        return new_array(result)
    }

    /// Builds a set from a JSON array, converting each item with `to_type`.
    ///
    /// Throws `.missing` when `value` is not an array or an item cannot be converted to the
    /// item type.
    + static fn from_json_value_auto[X](value: X) SELF !LookupError {
        let result = SELF.new()
        if !value.is_array : throw .missing
        each value.array.values as item {
            result.add(item.to_type[SET_ITEM]() !>)
        }
        return result
    }
}

extend Deque[DEQUE_ITEM] {
    -+ fn to_json_value_with_stack(stack: Array[uint]) Value {
        let result = Array[Value]{}
        each this as item {
            result.append(convert_value(item, stack))
        }
        return new_array(result)
    }

    /// Builds a deque from a JSON array, front first, converting each item with `to_type`.
    ///
    /// Throws `.missing` when `value` is not an array or an item cannot be converted to the
    /// item type.
    + static fn from_json_value_auto[X](value: X) SELF !LookupError {
        let result = SELF.new()
        if !value.is_array : throw .missing
        each value.array.values as item {
            result.push_back(item.to_type[DEQUE_ITEM]() !>)
        }
        return result
    }
}

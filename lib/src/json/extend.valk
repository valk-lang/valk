
use core

extend HashMap[K, V] {

    #if K.$is_type_of(String)
    + fn to_json_value() Value $auto {
        let result = Map[Value]{}
        each this as v, k {
            result.set(k, value(v))
        }
        return new_object(result)
    }
    + fn compose_json(str: core:ByteBuffer, pretty: bool, depth: uint) {
        str.write_byte('{')
        depth++
        each this as v, k, i {
            if i > 0 : str.write_byte(',')
            if pretty : indent_newline(str, depth)
            str.write_byte('"')
            str.write_string(k)
            str.write_byte('"')
            str.write_string(pretty ? ": " : ":")
            encode(v, pretty, str, depth)
        }
        depth--
        if pretty : indent_newline(str, depth)
        str.write_byte('}')
    }
    + static fn from_json_value_auto[X](val: X) SELF {
        let result = SELF.new()
        let items = val.map()
        each items as v, k {
            result.set(k, to_type[V](v))
        }
        return result
    }
    #end
}

extend FlatMap[K, V] {

    #if K.$is_type_of(String)
    + fn to_json_value() Value $auto {
        let result = Map[Value]{}
        each this as v, k {
            result.set(k, value(v))
        }
        return new_object(result)
    }
    + fn compose_json(str: core:ByteBuffer, pretty: bool, depth: uint) {
        str.write_byte('{')
        depth++
        each this as v, k, i {
            if i > 0 : str.write_byte(',')
            if pretty : indent_newline(str, depth)
            str.write_byte('"')
            str.write_string(k)
            str.write_byte('"')
            str.write_string(pretty ? ": " : ":")
            encode(v, pretty, str, depth)
        }
        depth--
        if pretty : indent_newline(str, depth)
        str.write_byte('}')
    }
    + static fn from_json_value_auto[X](val: X) SELF {
        let result = SELF.new()
        let items = val.map()
        each items as v, k {
            result.set(k, to_type[V](v))
        }
        return result
    }
    #end
}

extend Array[T] {

    + fn to_json_value() Value $auto {
        let result = core:Array[Value].new()
        each this as v {
            result.append(value(v))
        }
        return new_array(result)
    }
    + fn compose_json(str: core:ByteBuffer, pretty: bool, depth: uint) {
        str.write_byte('[')
        depth++
        each this as v, i {
            if i > 0 : str.write_byte(',')
            if pretty : indent_newline(str, depth)
            encode(v, pretty, str, depth)
        }
        depth--
        if pretty : indent_newline(str, depth)
        str.write_byte(']')
    }
    + static fn from_json_value_auto[X](val: X) SELF {
        let result = SELF.new()
        let items = val.array()
        each items as v {
            result.append(to_type[T](v))
        }
        return result
    }
}

extend String {

    + fn to_json_value() Value $auto {
        return new_string(this)
    }
    + static fn from_json_value(val: Value) String {
        return val.string()
    }
}

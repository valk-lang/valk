+ fn encode(data: $T, pretty: bool (false)) String {
    return encode_into(data, ByteBuffer.new(1024), pretty).into_string()
}

+ fn encode_into(data: $T, output: ByteBuffer, pretty: bool (false)) ByteBuffer {
    write_typed(data, pretty, output, 0, Array[ptr]{})
    return output
}

fn write_typed(data: $T, pretty: bool, output: ByteBuffer, depth: uint, stack: Array[ptr]) {
    if !isset(data) {
        output.write_string("null")
        return
    }

    #if T.$is_type_of(Value) || T.$is_type_of(ArrayValue) || T.$is_type_of(ObjectValue)
    write_value(data, pretty, output, depth, stack)
    #elif T.$is_type_of(String)
    output.write_byte('"')
    write_json_escaped(data, output)
    output.write_byte('"')
    #elif T.$has_method(write_json_auto)
    data.write_json_auto(pretty, output, depth, stack, false)
    #elif T.$has_method(to_json_value_with_stack) || T.$has_method(to_json_value)
    write_value(from(data), pretty, output, depth, stack)
    #elif T.$is_integer
    #if T.$is_signed
    output.write_int_ascii(data.to(int))
    #else
    output.write_uint_ascii(data.to(uint))
    #end
    #elif T.$is_float
    write_json_float(data.to(float), output)
    #elif T.$is_bool
    output.write_string(data ? "true" : "false")
    #elif !T.$nonnull.$is_structural
    output.write_string("null")
    #else
    // encode reports no error, so a container deeper than the parser would ever hand out
    // stops with a marker instead of recursing through the 1 MiB coroutine stack every
    // Valk program runs on. Measured cliffs: the Value path dies around 2450 levels, the
    // typed path around 2500 levels of a recursive class (twice the containers). Scalars
    // are never cut: the deepest legal document keeps every leaf.
    if depth >= JSON_MAX_DEPTH_CEILING {
        output.write_string("\"(too deep)\"")
        return
    }

    #if T.$is_pointer
    if stack.contains(data.@cast(ptr)) {
        write_typed("(recursion)", pretty, output, depth, stack)
        return
    }
    stack.append(data.@cast(ptr))
    #end

    output.write_byte('{')
    depth++
    let index: uint = 0
    #loop object data as prop
    if index++ > 0 : output.write_byte(',')
    if pretty : indent_newline(output, depth)
    output.write_byte('"')
    write_json_escaped(prop.name, output)
    output.write_byte('"')
    output.write_string(pretty ? ": " : ":")
    write_typed(prop, pretty, output, depth, stack)
    #end
    depth--
    if pretty && index > 0 : indent_newline(output, depth)
    output.write_byte('}')

    #if T.$is_pointer
    stack.pop_last() _
    #end
    #end
}

extend Array[JSON_WRITE_ITEM] {
    - fn write_json_auto(pretty: bool, output: ByteBuffer, depth: uint, stack: Array[ptr], lazy_marker: $X) {
        output.write_byte('[')
        depth++
        each this as item, i {
            if i > 0 : output.write_byte(',')
            if pretty : indent_newline(output, depth)
            write_typed(item, pretty, output, depth, stack)
        }
        depth--
        if pretty && this.length > 0 : indent_newline(output, depth)
        output.write_byte(']')
    }
}

// Marks a container as written and returns true, or writes the marker naming why it was
// refused and returns false. The stack is a visited set, never a path: nothing is popped
// and no parent pointer is compared, so anything reached twice in one document prints
// "(recursion)" from the second visit on. A node reachable from itself is a cycle and has
// to stop somewhere; a node with two parents has no cycle but duplicates its whole subtree
// once per parent — a chain whose root also references every level encodes 2^n bytes that
// way — so printing each node once keeps an encode call proportional to the document.
fn enter_value(node: ptr, stack: Array[ptr], output: ByteBuffer, depth: uint) bool {
    if depth >= JSON_MAX_DEPTH_CEILING {
        output.write_string("\"(too deep)\"")
        return false
    }
    if stack.contains(node) {
        output.write_string("\"(recursion)\"")
        return false
    }
    stack.append(node)
    return true
}

fn write_value(data: Value, pretty: bool, output: ByteBuffer, depth: uint, stack: Array[ptr]) {
    match data {
        null => output.write_string("null")
        String as text => {
            output.write_byte('"')
            write_json_escaped(text, output)
            output.write_byte('"')
        }
        int as number => output.write_int_ascii(number)
        float as number => write_json_float(number, output)
        bool as enabled => output.write_string(enabled ? "true" : "false")
        ArrayValue as array => {
            if enter_value(array.@cast(ptr), stack, output, depth) {
                write_array(array.values, pretty, output, depth, stack)
            }
        }
        ObjectValue as object => {
            if enter_value(object.@cast(ptr), stack, output, depth) {
                write_object(object.values, pretty, output, depth, stack)
            }
        }
    }
}

fn write_json_float(number: float, output: ByteBuffer) {
    let bits = @ptrv(&number, u64)
    if (bits & 0x7ff0000000000000) == 0x7ff0000000000000 {
        output.write_string("null")
        return
    }
    output.write_f64(number)
}

fn write_array(values: Array[Value], pretty: bool, output: ByteBuffer, depth: uint, stack: Array[ptr]) {
    output.write_byte('[')
    depth++
    each values as value, i {
        if i > 0 : output.write_byte(',')
        if pretty : indent_newline(output, depth)
        write_value(value, pretty, output, depth, stack)
    }
    depth--
    if pretty && values.length > 0 : indent_newline(output, depth)
    output.write_byte(']')
}

fn write_object(values: Map[Value], pretty: bool, output: ByteBuffer, depth: uint, stack: Array[ptr]) {
    output.write_byte('{')
    depth++
    each values as value, key, i {
        if i > 0 : output.write_byte(',')
        if pretty : indent_newline(output, depth)
        output.write_byte('"')
        write_json_escaped(key, output)
        output.write_byte('"')
        output.write_string(pretty ? ": " : ":")
        write_value(value, pretty, output, depth, stack)
    }
    depth--
    if pretty && values.length > 0 : indent_newline(output, depth)
    output.write_byte('}')
}

fn indent_newline(output: ByteBuffer, depth: uint) {
    output.write_byte('\n')
    let remaining = depth
    while remaining-- > 0 : output.write_string("    ")
}

fn write_json_escaped(value: String, output: ByteBuffer) {
    let bytes = value.bytes
    if bytes == 0 : return

    let i: uint = 0
    let needs_escape = false
    while i < bytes {
        let ch = @ptrv(value.data, u8, i)
        if ch < 32 || ch == '\\' || ch == '"' {
            needs_escape = true
            break
        }
        if ch >= 0x80 {
            let sequence_bytes = utf8_sequence_bytes(value.data, bytes, i)
            if sequence_bytes == 0 {
                needs_escape = true
                break
            }
            i += sequence_bytes
            continue
        }
        i++
    }
    if !needs_escape {
        output.write_string(value)
        return
    }

    let escapes: [u8 x 256] = { 0... }
    escapes['\n'] = 'n'
    escapes['\r'] = 'r'
    escapes['\t'] = 't'
    escapes['\f'] = 'f'
    escapes['\b'] = 'b'
    escapes['\\'] = '\\'
    escapes['"'] = '"'

    let encoded_size: uint = 0
    i = 0
    while i < bytes {
        let ch = @ptrv(value.data, u8, i)
        if escapes[ch] > 0 : encoded_size += 2
        else if ch < 32 : encoded_size += 6
        else if ch >= 0x80 {
            let sequence_bytes = utf8_sequence_bytes(value.data, bytes, i)
            if sequence_bytes == 0 : encoded_size += 6
            else : encoded_size += sequence_bytes
            i += sequence_bytes > 0 ? sequence_bytes : 1
            continue
        } else : encoded_size++
        i++
    }
    output.reserve_space(encoded_size)

    let hex = "0123456789abcdef"
    let offset = output.length
    let data = output.data
    i = 0
    while i < bytes {
        let ch = @ptrv(value.data, u8, i)
        let escaped = escapes[ch]
        if escaped > 0 {
            @ptrv(data, u8, offset++) = '\\'
            @ptrv(data, u8, offset++) = escaped
        } else if ch < 32 {
            @ptrv(data, u8, offset++) = '\\'
            @ptrv(data, u8, offset++) = 'u'
            @ptrv(data, u8, offset++) = '0'
            @ptrv(data, u8, offset++) = '0'
            @ptrv(data, u8, offset++) = @ptrv(hex.data, u8, (ch >> 4).to(uint))
            @ptrv(data, u8, offset++) = @ptrv(hex.data, u8, (ch & 15).to(uint))
        } else if ch >= 0x80 {
            let sequence_bytes = utf8_sequence_bytes(value.data, bytes, i)
            if sequence_bytes == 0 {
                @ptrv(data, u8, offset++) = '\\'
                @ptrv(data, u8, offset++) = 'u'
                @ptrv(data, u8, offset++) = 'f'
                @ptrv(data, u8, offset++) = 'f'
                @ptrv(data, u8, offset++) = 'f'
                @ptrv(data, u8, offset++) = 'd'
            } else {
                let n: uint = 0
                while n < sequence_bytes {
                    @ptrv(data, u8, offset++) = @ptrv(value.data, u8, i + n)
                    n++
                }
            }
            i += sequence_bytes > 0 ? sequence_bytes : 1
            continue
        } else {
            @ptrv(data, u8, offset++) = ch
        }
        i++
    }
    output.advance(encoded_size)
}

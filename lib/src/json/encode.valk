use core

+ fn stringify(data: Value, pretty: core:bool (false)) String {
    return stringify_to(data, ByteBuffer.new(1024), pretty).to_string()
}

+ fn stringify_to(data: Value, output: ByteBuffer, pretty: core:bool (false)) ByteBuffer {
    write_value(data, pretty, output, 0)
    return output
}

fn write_value(data: Value, pretty: core:bool, output: ByteBuffer, depth: uint) {
    match data {
        null => output.write_string("null")
        String as text => {
            output.write_byte('"')
            write_json_escaped(text, output)
            output.write_byte('"')
        }
        core:int as number => output.write_int_ascii(number)
        core:float as number => output.write_f64_ascii(number, 10, true)
        core:bool as enabled => output.write_string(enabled ? "true" : "false")
        ArrayValue as array => write_array(array.values, pretty, output, depth)
        ObjectValue as object => write_object(object.values, pretty, output, depth)
    }
}

fn write_array(values: Array[Value], pretty: core:bool, output: ByteBuffer, depth: uint) {
    output.write_byte('[')
    depth++
    each values as value, i {
        if i > 0 : output.write_byte(',')
        if pretty : indent_newline(output, depth)
        write_value(value, pretty, output, depth)
    }
    depth--
    if pretty && values.length > 0 : indent_newline(output, depth)
    output.write_byte(']')
}

fn write_object(values: Map[Value], pretty: core:bool, output: ByteBuffer, depth: uint) {
    output.write_byte('{')
    depth++
    each values as value, key, i {
        if i > 0 : output.write_byte(',')
        if pretty : indent_newline(output, depth)
        output.write_byte('"')
        write_json_escaped(key, output)
        output.write_byte('"')
        output.write_string(pretty ? ": " : ":")
        write_value(value, pretty, output, depth)
    }
    depth--
    if pretty && values.length > 0 : indent_newline(output, depth)
    output.write_byte('}')
}

fn indent_newline(output: ByteBuffer, depth: uint) {
    output.write_byte('\n')
    let remaining = depth
    while remaining-- > 0 : output.write_string("    ")
}

fn write_json_escaped(value: String, output: ByteBuffer) {
    let bytes = value.bytes
    if bytes == 0 : return

    let escapes = [u8 x 256]{ 0... }
    escapes['\n'] = 'n'
    escapes['\r'] = 'r'
    escapes['\t'] = 't'
    escapes['\f'] = 'f'
    escapes['\b'] = 'b'
    escapes['\\'] = '\\'
    escapes['"'] = '"'

    let encoded_size: uint = 0
    let i: uint = 0
    while i < bytes {
        let ch = @ptrv(value.data, u8, i++)
        if escapes[ch] > 0 : encoded_size += 2
        else if ch < 32 : encoded_size += 6
        else : encoded_size++
    }
    output.reserve_space(encoded_size)

    let hex = "0123456789abcdef"
    let offset = output.length
    let data = output.data
    i = 0
    while i < bytes {
        let ch = @ptrv(value.data, u8, i++)
        let escaped = escapes[ch]
        if escaped > 0 {
            @ptrv(data, u8, offset++) = '\\'
            @ptrv(data, u8, offset++) = escaped
        } else if ch < 32 {
            @ptrv(data, u8, offset++) = '\\'
            @ptrv(data, u8, offset++) = 'u'
            @ptrv(data, u8, offset++) = '0'
            @ptrv(data, u8, offset++) = '0'
            @ptrv(data, u8, offset++) = @ptrv(hex.data, u8, (ch >> 4).to(uint))
            @ptrv(data, u8, offset++) = @ptrv(hex.data, u8, (ch & 15).to(uint))
        } else {
            @ptrv(data, u8, offset++) = ch
        }
    }
    output.skip(encoded_size)
}

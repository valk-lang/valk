use io
use mem
/// Returns `data` encoded as JSON text; `pretty` adds newlines and four-space indentation.
///
/// Accepts a `Value` or any value `json.from` accepts, and never fails. Strings are escaped
/// as needed (invalid UTF-8 bytes become `�`), and NaN and infinities are written as
/// `null`. A container found again inside itself is written as `"(recursion)"` and one
/// nested 1000 levels deep as `"(too deep)"`. A container that appears several times
/// without a cycle, such as one array held by two members, is written in full each time.
+ fn encode(data: $T, pretty: bool (false)) String {
    if encode_stack_busy {
        let output = ByteBuffer.new()
        write_document(data, pretty, output)
        return output.into_string()
    }
    let output = encode_buffer
    output.clear()
    write_document(data, pretty, output)
    let res = output.to_string()
    if output.size > 262_144 : output.shrink_capacity(4096)
    return res
}

// The containers being written, reused by every encode on this thread; an encode that
// starts while another runs (from a `to_json` hook) gets its own
global encode_stack: Array[uint] (.{})
global encode_buffer: ByteBuffer (.new(4096))
global encode_stack_busy: bool (false)

fn write_document(data: $T, pretty: bool, output: ByteBuffer) {
    if encode_stack_busy {
        write_typed(data, pretty, output, 0, Array[uint]{})
        return
    }
    encode_stack_busy = true
    let stack = encode_stack
    write_typed(data, pretty, output, 0, stack)
    stack.clear()
    encode_stack_busy = false
}

/// Writes `data` encoded as JSON to `out` and returns the bytes written; see `encode`.
///
/// A `ByteBuffer` is written directly; any other writer receives the document in one
/// write. Throws when `out` fails.
+ fn encode_into(data: $T, out: io.Writer, pretty: bool (false)) uint !io.IoError {
    match out {
        ByteBuffer as buf => {
            let before = buf.length
            write_document(data, pretty, buf)
            return buf.length - before
        }
        default => {
            let buf = ByteBuffer.new()
            write_document(data, pretty, buf)
            return out.write(buf) !>
        }
    }
}

fn write_typed(data: $T, pretty: bool, output: ByteBuffer, depth: uint, stack: Array[uint]) {
    if !isset(data) {
        output.write("null")
        return
    }

    #if T.$nonnull.$is_type_of(Value) || T.$nonnull.$is_type_of(Array[Value]) || T.$nonnull.$is_type_of(Map[Value])
    write_value(data, pretty, output, depth, stack)
    #elif T.$nonnull.$is_type_of(String)
    output.write_byte('"')
    write_json_escaped(data, output)
    output.write_byte('"')
    #elif T.$has_method(to_json_string)
    output.write_byte('"')
    write_json_escaped(data.to_json_string(), output)
    output.write_byte('"')
    #elif T.$has_method(write_json_auto)
    data.write_json_auto(pretty, output, depth, stack, false)
    #elif T.$has_method(to_json_value_with_stack) || T.$has_method(to_json_value)
    write_value(from(data), pretty, output, depth, stack)
    #elif T.$is_integer
    #if T.$is_signed
    output.write_int_ascii(data.to(int))
    #else
    output.write_uint_ascii(data.to(uint))
    #end
    #elif T.$is_float
    write_json_float(data.to(float), output)
    #elif T.$is_bool
    output.write(data ? "true" : "false")
    #elif !T.$nonnull.$is_structural
    output.write("null")
    #else
    // encode reports no error, so a container deeper than the parser would ever hand out
    // stops with a marker instead of recursing through the 1 MiB coroutine stack every
    // Valk program runs on. Measured cliffs: the Value path dies around 2450 levels, the
    // typed path around 2500 levels of a recursive class (twice the containers). Scalars
    // are never cut: the deepest legal document keeps every leaf.
    if depth >= JSON_MAX_DEPTH_CEILING {
        output.write("\"(too deep)\"")
        return
    }

    #if T.$is_pointer
    let node = json_pointer_identity(data)
    if stack.contains(node) {
        write_typed("(recursion)", pretty, output, depth, stack)
        return
    }
    stack.append(node)
    #end

    output.write_byte('{')
    depth++
    let index: uint = 0
    #loop object data as prop
    write_json_prop_key(output, prop.name, index++ > 0, pretty, depth)
    write_typed(prop, pretty, output, depth, stack)
    #end
    depth--
    if pretty && index > 0 : indent_newline(output, depth)
    output.write_byte('}')

    #if T.$is_pointer
    stack.pop_last() _
    #end
    #end
}

extend Array[JSON_WRITE_ITEM] {
    - fn write_json_auto(pretty: bool, output: ByteBuffer, depth: uint, stack: Array[uint], lazy_marker: $X) {
        output.write_byte('[')
        depth++
        // `into`: a tuple element stays one value
        each this into item, i {
            if i > 0 : output.write_byte(',')
            if pretty : indent_newline(output, depth)
            write_typed(item, pretty, output, depth, stack)
        }
        depth--
        if pretty && this.length > 0 : indent_newline(output, depth)
        output.write_byte(']')
    }
}

// Pushes a container onto the path from the root and returns true, or writes the marker
// naming why it was refused and returns false. The stack holds only the containers being
// written around the current one (write_value pops after writing), so "(recursion)" marks
// a real cycle and a container shared by two parents is written in full under both, the
// same as the typed path.
fn enter_value(node: uint, stack: Array[uint], output: ByteBuffer, depth: uint) bool {
    if depth >= JSON_MAX_DEPTH_CEILING {
        output.write("\"(too deep)\"")
        return false
    }
    if stack.contains(node) {
        output.write("\"(recursion)\"")
        return false
    }
    stack.append(node)
    return true
}

fn write_value(data: Value, pretty: bool, output: ByteBuffer, depth: uint, stack: Array[uint]) {
    match data {
        null => output.write("null")
        String as text => {
            output.write_byte('"')
            write_json_escaped(text, output)
            output.write_byte('"')
        }
        int as number => output.write_int_ascii(number)
        float as number => write_json_float(number, output)
        bool as enabled => output.write(enabled ? "true" : "false")
        Array[Value] as array => {
            if enter_value(json_pointer_identity(array), stack, output, depth) {
                write_array(array, pretty, output, depth, stack)
                stack.pop_last() _
            }
        }
        Map[Value] as object => {
            if enter_value(json_pointer_identity(object), stack, output, depth) {
                write_object(object, pretty, output, depth, stack)
                stack.pop_last() _
            }
        }
    }
}

fn write_json_float(number: float, output: ByteBuffer) {
    let finite = number - number
    if finite != finite {
        output.write("null")
        return
    }
    // Beyond the 64-bit integer range a plain decimal reads back as an out-of-range
    // integer, so the exponent form keeps the value a float the decoder accepts.
    // -2^63 itself is the first such value: its shortest round-trip decimal is
    // -9223372036854776000, which no longer fits in an `int`
    let beyond_int64 = number >= 9223372036854775808.0 || number <= -9223372036854775808.0
    output.write_f64_ascii_shortest(number, beyond_int64)
    // A whole float keeps its `.0`, so it reads back as a float and not as an int
    if !beyond_int64 && number.to(int).to(float) == number : output.write(".0")
}

fn write_array(values: Array[Value], pretty: bool, output: ByteBuffer, depth: uint, stack: Array[uint]) {
    output.write_byte('[')
    depth++
    each values as value, i {
        if i > 0 : output.write_byte(',')
        if pretty : indent_newline(output, depth)
        write_value(value, pretty, output, depth, stack)
    }
    depth--
    if pretty && values.length > 0 : indent_newline(output, depth)
    output.write_byte(']')
}

fn write_object(values: Map[Value], pretty: bool, output: ByteBuffer, depth: uint, stack: Array[uint]) {
    output.write_byte('{')
    depth++
    each values as value, key, i {
        if i > 0 : output.write_byte(',')
        if pretty : indent_newline(output, depth)
        output.write_byte('"')
        write_json_escaped(key, output)
        output.write_byte('"')
        output.write(pretty ? ": " : ":")
        write_value(value, pretty, output, depth, stack)
    }
    depth--
    if pretty && values.length > 0 : indent_newline(output, depth)
    output.write_byte('}')
}

fn indent_newline(output: ByteBuffer, depth: uint) {
    output.write_byte('\n')
    let remaining = depth
    while remaining-- > 0 : output.write("    ")
}

fn write_json_prop_key(output: ByteBuffer, name: String, comma: bool, pretty: bool, depth: uint) $inline {
    if pretty {
        if comma : output.write_byte(',')
        indent_newline(output, depth)
        output.write_byte('"')
        output.write(name)
        output.write("\": ")
        return
    }
    @unsafe
    let n = name.bytes
    let extra: uint = comma ? 4 : 3
    output.reserve(n + extra)
    let p = output.data.@offset(output.length)
    let at: uint = 0
    if comma : @ptrv(p, u8, at++) = ','
    @ptrv(p, u8, at++) = '"'
    mem.copy_bytes(name.data, p.@offset(at), n)
    at += n
    @ptrv(p, u8, at++) = '"'
    @ptrv(p, u8, at) = ':'
    output.skip(n + extra)
}

global json_escapes_ready: bool (false)
global json_escapes: [u8 x 256] ({ 0... })

fn get_json_escapes() *[u8 x 256] {
    if !json_escapes_ready {
        json_escapes['\n'] = 'n'
        json_escapes['\r'] = 'r'
        json_escapes['\t'] = 't'
        json_escapes['\f'] = 'f'
        json_escapes['\b'] = 'b'
        json_escapes['\\'] = '\\'
        json_escapes['"'] = '"'
        json_escapes_ready = true
    }
    return @ref(json_escapes)
}

fn write_json_escaped(value: String, output: ByteBuffer) {
    let bytes = value.bytes
    if bytes == 0 : return

    let p = value.data
    let i: uint = 0
    let c32 = $splat[i8x16](32)
    let quote = $splat[u8x16]('"')
    let slash = $splat[u8x16]('\\')
    while bytes - i >= 16 {
        let block = $load[u8x16](value, i)
        let special = $lt($bitcast[i8x16](block), c32) | $eq(block, quote) | $eq(block, slash)
        let hits = $mask_bits(special)
        if hits != 0 {
            i += hits.trailing_zeros()
            break
        }
        i += 16
    }
    let high: u64 = 0x8080808080808080
    let ones: u64 = 0x0101010101010101
    while bytes - i >= 8 {
        let word = @ptrv(p.@offset(i), u64)
        if (word & high) != 0 : break
        let q = word ^ 0x2222222222222222
        let s = word ^ 0x5c5c5c5c5c5c5c5c
        if (((word - 0x2020202020202020) | (q - ones) | (s - ones)) & high) != 0 : break
        i += 8
    }
    let needs_escape = false
    while i < bytes {
        let ch = @ptrv(p, u8, i)
        if ch < 32 || ch == '\\' || ch == '"' {
            needs_escape = true
            break
        }
        if ch >= 0x80 {
            let sequence_bytes = utf8_sequence_bytes[String](value, bytes, i)
            if sequence_bytes == 0 {
                needs_escape = true
                break
            }
            i += sequence_bytes
            continue
        }
        i++
    }
    if !needs_escape {
        output.write(value)
        return
    }

    let escapes = get_json_escapes()

    let encoded_size: uint = 0
    i = 0
    while i < bytes {
        let ch = value[i]
        if escapes[ch] > 0 : encoded_size += 2
        else if ch < 32 : encoded_size += 6
        else if ch >= 0x80 {
            let sequence_bytes = utf8_sequence_bytes[String](value, bytes, i)
            if sequence_bytes == 0 : encoded_size += 6
            else : encoded_size += sequence_bytes
            i += sequence_bytes > 0 ? sequence_bytes : 1
            continue
        } else : encoded_size++
        i++
    }
    let hex = "0123456789abcdef"
    let offset = output.length
    output.skip(encoded_size)
    i = 0
    while i < bytes {
        let ch = value[i]
        let escaped = escapes[ch]
        if escaped > 0 {
            output[offset++] = '\\'
            output[offset++] = escaped
        } else if ch < 32 {
            output[offset++] = '\\'
            output[offset++] = 'u'
            output[offset++] = '0'
            output[offset++] = '0'
            output[offset++] = hex[(ch >> 4).to(uint)]
            output[offset++] = hex[(ch & 15).to(uint)]
        } else if ch >= 0x80 {
            let sequence_bytes = utf8_sequence_bytes[String](value, bytes, i)
            if sequence_bytes == 0 {
                output[offset++] = '\\'
                output[offset++] = 'u'
                output[offset++] = 'f'
                output[offset++] = 'f'
                output[offset++] = 'f'
                output[offset++] = 'd'
            } else {
                let n: uint = 0
                while n < sequence_bytes {
                    output[offset++] = value[i + n]
                    n++
                }
            }
            i += sequence_bytes > 0 ? sequence_bytes : 1
            continue
        } else {
            output[offset++] = ch
        }
        i++
    }
}

// Maps, sets and deques write their members directly, without building a Value copy first
extend HashMap[JSON_WRITE_KEY, JSON_WRITE_VALUE] {
    #if JSON_WRITE_KEY.$is_type_of(String) || (JSON_WRITE_KEY.$is_integer && !JSON_WRITE_KEY.$is_enum)
    - fn write_json_auto(pretty: bool, output: ByteBuffer, depth: uint, stack: Array[uint], lazy_marker: $X) {
        output.write_byte('{')
        depth++
        let index: uint = 0
        each this as item, key {
            if index++ > 0 : output.write_byte(',')
            if pretty : indent_newline(output, depth)
            output.write_byte('"')
            #if JSON_WRITE_KEY.$is_type_of(String)
            write_json_escaped(key, output)
            #elif JSON_WRITE_KEY.$is_signed
            output.write_int_ascii(key.to(int))
            #else
            output.write_uint_ascii(key.to(uint))
            #end
            output.write_byte('"')
            output.write(pretty ? ": " : ":")
            write_typed(item, pretty, output, depth, stack)
        }
        depth--
        if pretty && this.length > 0 : indent_newline(output, depth)
        output.write_byte('}')
    }
    #end
}

extend FlatMap[JSON_WRITE_FLAT_KEY, JSON_WRITE_FLAT_VALUE] {
    #if JSON_WRITE_FLAT_KEY.$is_type_of(String)
    - fn write_json_auto(pretty: bool, output: ByteBuffer, depth: uint, stack: Array[uint], lazy_marker: $X) {
        output.write_byte('{')
        depth++
        let index: uint = 0
        each this as item, key {
            if index++ > 0 : output.write_byte(',')
            if pretty : indent_newline(output, depth)
            output.write_byte('"')
            write_json_escaped(key, output)
            output.write_byte('"')
            output.write(pretty ? ": " : ":")
            write_typed(item, pretty, output, depth, stack)
        }
        depth--
        if pretty && this.length > 0 : indent_newline(output, depth)
        output.write_byte('}')
    }
    #end
}

extend HashSet[JSON_WRITE_SET_ITEM] {
    - fn write_json_auto(pretty: bool, output: ByteBuffer, depth: uint, stack: Array[uint], lazy_marker: $X) {
        output.write_byte('[')
        depth++
        let index: uint = 0
        each this as item {
            if index++ > 0 : output.write_byte(',')
            if pretty : indent_newline(output, depth)
            write_typed(item, pretty, output, depth, stack)
        }
        depth--
        if pretty && this.length > 0 : indent_newline(output, depth)
        output.write_byte(']')
    }
}

extend Deque[JSON_WRITE_DEQUE_ITEM] {
    - fn write_json_auto(pretty: bool, output: ByteBuffer, depth: uint, stack: Array[uint], lazy_marker: $X) {
        output.write_byte('[')
        depth++
        let index: uint = 0
        each this as item {
            if index++ > 0 : output.write_byte(',')
            if pretty : indent_newline(output, depth)
            write_typed(item, pretty, output, depth, stack)
        }
        depth--
        if pretty && this.length > 0 : indent_newline(output, depth)
        output.write_byte(']')
    }
}


use core

+ fn encode_to_string(data: $T, pretty: core:bool (false)) String {

    #if T.$is_nullable
    if !isset(data) : return "null"
    #end

    #if !T.$has_method(compose_json)
    #if T.$is_bool
    return data ? "true" : "false"
    #end
    #end

    return encode(data, pretty).to_string()
}

+ fn encode(data: $T, pretty: core:bool (false), output: ?core:StringComposer (null), depth: uint (0)) core:StringComposer {

    let str = output ?? core:StringComposer.new(1024)

    #if T.$is_nullable
    if !isset(data) : return str.append_str("null")
    #end

    #if T.$has_method(compose_json)
    data.compose_json(str, pretty, depth)
    return str
    #elif T.$is_type_of(String)
    str.append_str("\"")
    str.append_str_json_escaped(data)
    str.append_str("\"")
    return str
    #elif T.$is_integer
    return str.append_int(data.to(int))
    #elif T.$is_float
    return str.append_f64(data, 10, true)
    #elif T.$is_bool
    return str.append_str(data ? "true" : "false")
    #elif !T.$is_structural
    return str.append_str("null")
    #else

    #if T.$is_structural && T.$is_pointer
    if check_recursion.contains(data) : return str.append_str("(recursion)")
    check_recursion.append(data)
    #end

    str.append_str("{")
    depth++

    let i = 0
    #loop object data as prop
    if i++ > 0 : str.append_str(",")
    if pretty : indent_newline(str, depth)
    str.append_byte('"')
    str.append_str(prop.name)
    str.append_byte('"')
    str.append_str(pretty ? ": " : ":")
    encode(prop.value, pretty, str, depth)
    #end // End loop

    depth--
    if pretty : indent_newline(str, depth)
    str.append_str("}")

    #if T.$is_structural && T.$is_pointer
    check_recursion.pop_last() _
    #end

    return str
    #end
}

fn indent_newline(str: core:StringComposer, depth: uint) {
    str.append_str("\n")
    while depth-- > 0 {
        str.append_str("    ")
    }
}
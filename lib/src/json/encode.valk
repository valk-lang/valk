
use core

+ fn encode_to_string(data: $T, pretty: core:bool (false)) String {

    #if T.$is_nullable
    if !isset(data) : return "null"
    #end

    #if !T.$has_method(compose_json)
    #if T.$is_bool
    return data ? "true" : "false"
    #end
    #end

    return encode(data, pretty).to_string()
}

+ fn encode(data: $T, pretty: core:bool (false), output: ?core:ByteBuffer (null), depth: uint (0)) core:ByteBuffer {

    let str = output ?? core:ByteBuffer.new(1024)

    #if T.$is_nullable
    if !isset(data) {
        str.write_string("null")
        return str
    }
    #end

    #if T.$has_method(compose_json)
    data.compose_json(str, pretty, depth)
    return str
    #elif T.$is_type_of(String)
    str.write_byte('"')
    write_json_escaped(data, str)
    str.write_byte('"')
    return str
    #elif T.$is_integer
    str.write_int_ascii(data.to(int))
    return str
    #elif T.$is_float
    str.write_f64_ascii(data, 10, true)
    return str
    #elif T.$is_bool
    str.write_string(data ? "true" : "false")
    return str
    #elif !T.$is_structural
    str.write_string("null")
    return str
    #else

    #if T.$is_structural && T.$is_pointer
    if check_recursion.contains(data) {
        str.write_string("(recursion)")
        return str
    }
    check_recursion.append(data)
    #end

    str.write_byte('{')
    depth++

    let i = 0
    #loop object data as prop
    if i++ > 0 : str.write_byte(',')
    if pretty : indent_newline(str, depth)
    str.write_byte('"')
    str.write_string(prop.name)
    str.write_byte('"')
    str.write_string(pretty ? ": " : ":")
    encode(prop, pretty, str, depth)
    #end // End loop

    depth--
    if pretty : indent_newline(str, depth)
    str.write_byte('}')

    #if T.$is_structural && T.$is_pointer
    check_recursion.pop_last() _
    #end

    return str
    #end
}

fn indent_newline(str: core:ByteBuffer, depth: uint) {
    str.write_byte('\n')
    while depth-- > 0 {
        str.write_string("    ")
    }
}

// Write a JSON string payload without quotes. This stays in the JSON package:
// ByteBuffer provides storage, while escaping rules belong to the format.
fn write_json_escaped(str: String, output: core:ByteBuffer) {
    let bytes = str.bytes
    if bytes == 0 : return

    let escapes = [u8 x 256]{ 0... }
    escapes['\n'] = 'n'
    escapes['\r'] = 'r'
    escapes['\t'] = 't'
    escapes['\f'] = 'f'
    escapes['\b'] = 'b'
    escapes['\\'] = '\\'
    escapes['"'] = '"'

    // Reserve the exact encoded width: ordinary bytes are copied as-is,
    // short escapes use two bytes, and other controls use `\u00XX`.
    let encoded_size: uint = 0
    let i: uint = 0
    while i < bytes {
        let ch = @ptrv(str.data, u8, i++)
        if escapes[ch] > 0 : encoded_size += 2
        else if ch < 32 : encoded_size += 6
        else : encoded_size++
    }
    output.reserve_space(encoded_size)

    let hex = "0123456789abcdef"
    let offset = output.length
    let data = output.data
    i = 0
    while i < bytes {
        let ch = @ptrv(str.data, u8, i++)
        let escaped = escapes[ch]
        if escaped > 0 {
            @ptrv(data, u8, offset++) = '\\'
            @ptrv(data, u8, offset++) = escaped
        } else if ch < 32 {
            @ptrv(data, u8, offset++) = '\\'
            @ptrv(data, u8, offset++) = 'u'
            @ptrv(data, u8, offset++) = '0'
            @ptrv(data, u8, offset++) = '0'
            @ptrv(data, u8, offset++) = @ptrv(hex.data, u8, (ch >> 4).to(uint))
            @ptrv(data, u8, offset++) = @ptrv(hex.data, u8, (ch & 15).to(uint))
        } else {
            @ptrv(data, u8, offset++) = ch
        }
    }
    output.skip(encoded_size)
}

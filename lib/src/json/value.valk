use core

// The JSON DOM is exposed through Value. ArrayValue and ObjectValue remain the
// storage variants, while these methods make ordinary JSON code independent of
// which variant is currently active:
//
//     user.get("name").as_string()
//     user.get_or_null("name")
//
// JSON construction, parsing, encoding, and typed conversion remain namespace
// functions. Value inspection and access are methods on the union itself.

+ union Value : String | core:int | core:float | core:bool | ArrayValue | ObjectValue | null {
    + fn kind() Kind {
        return match this : Kind {
            null => Kind.null
            String as _ => Kind.string
            core:int as _ => Kind.int
            core:float as _ => Kind.float
            core:bool as _ => Kind.bool
            ArrayValue as _ => Kind.array
            ObjectValue as _ => Kind.object
        }
    }

    + fn kind_name() String {
        return match this : String {
            null => "null"
            String as _ => "string"
            core:int as _ => "int"
            core:float as _ => "float"
            core:bool as _ => "bool"
            ArrayValue as _ => "array"
            ObjectValue as _ => "object"
        }
    }

    + fn is_null() core:bool { return !isset(this) }

    + fn is_string() core:bool {
        return match this : bool {
            null => false
            String as _ => true
            default => false
        }
    }

    + fn is_bool() core:bool {
        return match this : bool {
            null => false
            core:bool as _ => true
            default => false
        }
    }

    + fn is_int() core:bool {
        return match this : bool {
            null => false
            core:int as _ => true
            default => false
        }
    }

    + fn is_float() core:bool {
        return match this : bool {
            null => false
            core:float as _ => true
            default => false
        }
    }

    + fn is_number() core:bool {
        return match this : bool {
            null => false
            core:int as _ => true
            core:float as _ => true
            default => false
        }
    }

    + fn is_array() core:bool {
        return match this : bool {
            null => false
            ArrayValue as _ => true
            default => false
        }
    }

    + fn is_object() core:bool {
        return match this : bool {
            null => false
            ObjectValue as _ => true
            default => false
        }
    }

    + fn as_string() String !ValueError {
        match this {
            null => {}
            String as text => return text
            default => {}
        }
        throw .wrong_type { message: "Expected JSON string, got %{this.kind_name()}" }
    }

    + fn as_int() core:int !ValueError {
        match this {
            null => {}
            core:int as number => return number
            default => {}
        }
        throw .wrong_type { message: "Expected JSON int, got %{this.kind_name()}" }
    }

    + fn as_float() core:float !ValueError {
        match this {
            null => {}
            core:float as number => return number
            default => {}
        }
        throw .wrong_type { message: "Expected JSON float, got %{this.kind_name()}" }
    }

    + fn as_bool() core:bool !ValueError {
        match this {
            null => {}
            core:bool as enabled => return enabled
            default => {}
        }
        throw .wrong_type { message: "Expected JSON bool, got %{this.kind_name()}" }
    }

    + fn as_array() ArrayValue !ValueError {
        match this {
            null => {}
            ArrayValue as array => return array
            default => {}
        }
        throw .wrong_type { message: "Expected JSON array, got %{this.kind_name()}" }
    }

    + fn as_object() ObjectValue !ValueError {
        match this {
            null => {}
            ObjectValue as object => return object
            default => {}
        }
        throw .wrong_type { message: "Expected JSON object, got %{this.kind_name()}" }
    }

    + fn string_or(fallback: String) String {
        return this.as_string() !? fallback
    }

    + fn int_or(fallback: core:int) core:int {
        return this.as_int() !? fallback
    }

    + fn float_or(fallback: core:float) core:float {
        return this.as_float() !? fallback
    }

    + fn bool_or(fallback: core:bool) core:bool {
        return this.as_bool() !? fallback
    }

    + fn array_or_empty() ArrayValue {
        return this.as_array() !? array()
    }

    + fn object_or_empty() ObjectValue {
        return this.as_object() !? object()
    }

    + fn length() uint !ValueError {
        match this {
            null => {}
            String as text => return text.length
            ArrayValue as array => return array.values.length
            ObjectValue as object => return object.values.length
            default => {}
        }
        throw .wrong_type {
            message: "Expected JSON string, array, or object; got %{this.kind_name()}"
        }
    }

    // Object access is intentionally strict. Use get_or_null/get_or when a
    // missing key is expected. Array access has the unambiguous get_index name.
    + fn get(key: String) Value !ValueError {
        match this {
            null => throw .wrong_type { message: "Expected JSON object, got %{this.kind_name()}" }
            ObjectValue as object => return object.get(key) !>
            default => throw .wrong_type { message: "Expected JSON object, got %{this.kind_name()}" }
        }
    }

    + fn get_or(key: String, fallback: Value) Value {
        match this {
            null => return fallback
            ObjectValue as object => return object.get_or(key, fallback)
            default => return fallback
        }
    }

    + fn get_or_null(key: String) Value {
        match this {
            null => return null
            ObjectValue as object => return object.get_or_null(key)
            default => return null
        }
    }

    + fn get_or_else(key: String, fallback: fn()(Value)) Value {
        match this {
            null => return fallback()
            ObjectValue as object => return object.get_or_else(key, fallback)
            default => return fallback()
        }
    }

    + fn has(key: String) core:bool {
        match this {
            null => return false
            ObjectValue as object => return object.has(key)
            default => return false
        }
    }

    + fn set(key: String, value: Value) Value !ValueError {
        match this {
            null => throw .wrong_type { message: "Expected JSON object, got %{this.kind_name()}" }
            ObjectValue as object => return object.set(key, value)
            default => throw .wrong_type { message: "Expected JSON object, got %{this.kind_name()}" }
        }
    }

    + fn remove(key: String) Value !ValueError {
        match this {
            null => throw .wrong_type { message: "Expected JSON object, got %{this.kind_name()}" }
            ObjectValue as object => return object.remove(key)
            default => throw .wrong_type { message: "Expected JSON object, got %{this.kind_name()}" }
        }
    }

    + fn get_index(index: uint) Value !ValueError {
        match this {
            null => throw .wrong_type { message: "Expected JSON array, got %{this.kind_name()}" }
            ArrayValue as array => return array.get(index) !>
            default => throw .wrong_type { message: "Expected JSON array, got %{this.kind_name()}" }
        }
    }

    + fn get_index_or_null(index: uint) Value {
        match this {
            null => return null
            ArrayValue as array => return array.get_or_null(index)
            default => return null
        }
    }

    + fn append(value: Value) Value !ValueError {
        match this {
            null => throw .wrong_type { message: "Expected JSON array, got %{this.kind_name()}" }
            ArrayValue as array => return array.append(value)
            default => throw .wrong_type { message: "Expected JSON array, got %{this.kind_name()}" }
        }
    }

    + fn prepend(value: Value) Value !ValueError {
        match this {
            null => throw .wrong_type { message: "Expected JSON array, got %{this.kind_name()}" }
            ArrayValue as array => return array.prepend(value)
            default => throw .wrong_type { message: "Expected JSON array, got %{this.kind_name()}" }
        }
    }

    + fn remove_index(index: uint) Value !ValueError {
        match this {
            null => throw .wrong_type { message: "Expected JSON array, got %{this.kind_name()}" }
            ArrayValue as array => return array.remove(index)
            default => throw .wrong_type { message: "Expected JSON array, got %{this.kind_name()}" }
        }
    }
}

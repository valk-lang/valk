use core

// The JSON DOM is exposed through Value. ArrayValue and ObjectValue remain the
// storage variants, while these methods make ordinary JSON code independent of
// which variant is currently active:
//
//     user.get("name").string()
//
// JSON construction, parsing, encoding, and typed conversion remain namespace
// functions. Value inspection and access are methods on the union itself.

+ union Value : String | core:int | core:float | core:bool | ArrayValue | ObjectValue | null {
    + fn kind() Kind {
        return match this : Kind {
            null => Kind.null
            String as _ => Kind.string
            core:int as _ => Kind.int
            core:float as _ => Kind.float
            core:bool as _ => Kind.bool
            ArrayValue as _ => Kind.array
            ObjectValue as _ => Kind.object
        }
    }

    + fn kind_name() String {
        return match this : String {
            null => "null"
            String as _ => "string"
            core:int as _ => "int"
            core:float as _ => "float"
            core:bool as _ => "bool"
            ArrayValue as _ => "array"
            ObjectValue as _ => "object"
        }
    }

    + fn is_null() core:bool { return !isset(this) }

    + fn is_string() core:bool {
        return match this : bool {
            null => false
            String as _ => true
            default => false
        }
    }

    + fn is_bool() core:bool {
        return match this : bool {
            null => false
            core:bool as _ => true
            default => false
        }
    }

    + fn is_int() core:bool {
        return match this : bool {
            null => false
            core:int as _ => true
            default => false
        }
    }

    + fn is_float() core:bool {
        return match this : bool {
            null => false
            core:float as _ => true
            default => false
        }
    }

    + fn is_number() core:bool {
        return match this : bool {
            null => false
            core:int as _ => true
            core:float as _ => true
            default => false
        }
    }

    + fn is_array() core:bool {
        return match this : bool {
            null => false
            ArrayValue as _ => true
            default => false
        }
    }

    + fn is_object() core:bool {
        return match this : bool {
            null => false
            ObjectValue as _ => true
            default => false
        }
    }

    + fn string() String {
        match this {
            null => return ""
            String as text => return text
            default => return ""
        }
    }

    + fn int() core:int {
        match this {
            null => return 0
            core:int as number => return number
            default => return 0
        }
    }

    + fn float() core:float {
        match this {
            null => return 0.0
            core:float as number => return number
            default => return 0.0
        }
    }

    + fn bool() core:bool {
        match this {
            null => return false
            core:bool as enabled => return enabled
            default => return false
        }
    }

    + fn array() ArrayValue {
        match this {
            null => return array()
            ArrayValue as array => return array
            default => return array()
        }
    }

    + fn object() ObjectValue {
        match this {
            null => return object()
            ObjectValue as object => return object
            default => return object()
        }
    }

    + fn length() uint {
        match this {
            null => return 0
            String as text => return text.length
            ArrayValue as array => return array.values.length
            ObjectValue as object => return object.values.length
            default => return 0
        }
    }

    // Safe object/array access. Missing keys, invalid container types, and
    // out-of-range indexes all produce JSON null so lookups can be chained.
    + fn get(key: Value) Value $offset {
        match this {
            null => return null
            ObjectValue as object => match key {
                null => return null
                String as name => return object.get_or_null(name)
                default => return null
            }
            ArrayValue as array => match key {
                null => return null
                core:int as index => {
                    if index < 0 : return null
                    return array.get_or_null(index.to(uint))
                }
                default => return null
            }
            default => return null
        }
    }

    + fn has(key: Value) core:bool {
        match this {
            null => return false
            ObjectValue as object => match key {
                null => return false
                String as name => return object.has(name)
                default => return false
            }
            default => return false
        }
    }

    + fn set(key: Value, value: Value) Value !ValueError {
        match this {
            null => throw .wrong_type { message: "Expected JSON object, got %{this.kind_name()}" }
            ObjectValue as object => match key {
                null => throw .wrong_type { message: "Expected a string JSON object key" }
                String as name => return object.set(name, value)
                default => throw .wrong_type { message: "Expected a string JSON object key" }
            }
            default => throw .wrong_type { message: "Expected JSON object, got %{this.kind_name()}" }
        }
    }

    + fn remove(key: Value) Value !ValueError {
        match this {
            null => throw .wrong_type { message: "Expected JSON object or array, got %{this.kind_name()}" }
            ObjectValue as object => match key {
                null => throw .wrong_type { message: "Expected a string JSON object key" }
                String as name => return object.remove(name)
                default => throw .wrong_type { message: "Expected a string JSON object key" }
            }
            ArrayValue as array => match key {
                null => throw .wrong_type { message: "Expected an integer JSON array index" }
                core:int as index => {
                    if index < 0 : return array
                    return array.remove(index.to(uint))
                }
                default => throw .wrong_type { message: "Expected an integer JSON array index" }
            }
            default => throw .wrong_type { message: "Expected JSON object or array, got %{this.kind_name()}" }
        }
    }

    + fn append(value: Value) Value !ValueError {
        match this {
            null => throw .wrong_type { message: "Expected JSON array, got %{this.kind_name()}" }
            ArrayValue as array => return array.append(value)
            default => throw .wrong_type { message: "Expected JSON array, got %{this.kind_name()}" }
        }
    }

    + fn prepend(value: Value) Value !ValueError {
        match this {
            null => throw .wrong_type { message: "Expected JSON array, got %{this.kind_name()}" }
            ArrayValue as array => return array.prepend(value)
            default => throw .wrong_type { message: "Expected JSON array, got %{this.kind_name()}" }
        }
    }

}

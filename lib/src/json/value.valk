
+ union Value: String | int | float | bool | ArrayValue | ObjectValue | null {
    + get kind: Kind {
        return match this : Kind {
            null => Kind.null
            String as _ => Kind.string
            int as _ => Kind.int
            float as _ => Kind.float
            bool as _ => Kind.bool
            ArrayValue as _ => Kind.array
            ObjectValue as _ => Kind.object
        }
    }

    + fn is_kind(kind: Kind) bool {
        return this.kind == kind
    }

    + fn kind_name() String {
        return match this : String {
            null => "null"
            String as _ => "string"
            int as _ => "int"
            float as _ => "float"
            bool as _ => "bool"
            ArrayValue as _ => "array"
            ObjectValue as _ => "object"
        }
    }

    + get is_null: bool { return !isset(this) }

    + get is_string: bool {
        return match this : bool {
            String as _ => true
            default => false
        }
    }

    + get is_bool: bool {
        return match this : bool {
            bool as _ => true
            default => false
        }
    }

    + get is_int: bool {
        return match this : bool {
            int as _ => true
            default => false
        }
    }

    + get is_float: bool {
        return match this : bool {
            float as _ => true
            default => false
        }
    }

    + get is_number: bool {
        return match this : bool {
            int as _ => true
            float as _ => true
            default => false
        }
    }

    + get is_array: bool {
        return match this : bool {
            ArrayValue as _ => true
            default => false
        }
    }

    + get is_object: bool {
        return match this : bool {
            ObjectValue as _ => true
            default => false
        }
    }

    + get string: String {
        return match this : String {
            null => "null"
            String as text => text
            int as number => number.to_string()
            float as number => number.to_shortest_string()
            bool as enabled => enabled ? "true" : "false"
            ArrayValue as _ => encode(this)
            ObjectValue as _ => encode(this)
        }
    }

    + fn string_value() String !LookupError {
        match this {
            String as text => return text
            default => throw .missing
        }
    }

    + get int: int {
        match this {
            int as number => return number
            default => return 0
        }
    }
    + fn int_value() int !LookupError {
        match this {
            int as number => return number
            default => throw .missing
        }
    }

    + get float: float {
        match this {
            float as number => return number
            default => return 0.0
        }
    }
    + fn float_value() float !LookupError {
        match this {
            float as number => return number
            default => throw .missing
        }
    }

    + get bool: bool {
        match this {
            bool as enabled => return enabled
            default => return false
        }
    }
    + fn bool_value() bool !LookupError {
        match this {
            bool as enabled => return enabled
            default => throw .missing
        }
    }

    + get array: ArrayValue {
        match this {
            ArrayValue as array => return array
            default => return new_array()
        }
    }
    + fn array_value() ArrayValue !LookupError {
        match this {
            ArrayValue as array => return array
            default => throw .missing
        }
    }

    + get object: ObjectValue {
        match this {
            ObjectValue as object => return object
            default => return new_object()
        }
    }
    + fn object_value() ObjectValue !LookupError {
        match this {
            ObjectValue as object => return object
            default => throw .missing
        }
    }

    + fn length() uint {
        match this {
            String as text => return text.length
            ArrayValue as array => return array.values.length
            ObjectValue as object => return object.values.length
            default => return 0
        }
    }

    + fn get(key: uint | String) Value $offset {
        match this {
            ObjectValue as object => match key {
                String as name => return object.values.get(name) !? null
                default => return null
            }
            ArrayValue as array => match key {
                uint as index => return array.values.get(index) !? null
                default => return null
            }
            default => return null
        }
    }

    + fn get_required(key: uint | String) Value !LookupError {
        match this {
            ObjectValue as object => match key {
                String as name => return object.get(name) !>
                default => throw .missing
            }
            ArrayValue as array => match key {
                uint as index => return array.get(index) !>
                default => throw .missing
            }
            default => throw .missing
        }
    }

    + fn get_string(key: uint | String) String !LookupError {
        let value = this.get_required(key) !>
        return value.string_value() !>
    }

    + fn get_int(key: uint | String) int !LookupError {
        let value = this.get_required(key) !>
        return value.int_value() !>
    }

    + fn get_float(key: uint | String) float !LookupError {
        let value = this.get_required(key) !>
        return value.float_value() !>
    }

    + fn get_bool(key: uint | String) bool !LookupError {
        let value = this.get_required(key) !>
        return value.bool_value() !>
    }

    + fn get_array(key: uint | String) ArrayValue !LookupError {
        let value = this.get_required(key) !>
        return value.array_value() !>
    }

    + fn get_object(key: uint | String) ObjectValue !LookupError {
        let value = this.get_required(key) !>
        return value.object_value() !>
    }

    + fn has(key: uint | String) bool {
        match this {
            ObjectValue as object => match key {
                String as name => return object.has(name)
                default => return false
            }
            ArrayValue as array => match key {
                uint as index => return index < array.values.length
                default => return false
            }
            default => return false
        }
    }

    + fn has_string(key: uint | String) bool {
        return this.get(key).is_string
    }

    + fn has_int(key: uint | String) bool {
        return this.get(key).is_int
    }

    + fn has_float(key: uint | String) bool {
        return this.get(key).is_float
    }

    + fn has_bool(key: uint | String) bool {
        return this.get(key).is_bool
    }

    + fn has_array(key: uint | String) bool {
        return this.get(key).is_array
    }

    + fn has_object(key: uint | String) bool {
        return this.get(key).is_object
    }

    + fn set(key: uint | String, value: Value) Value {
        match key {
            String as name => match this {
                ObjectValue as object => return object.set(name, value)
                default => {
                    let object = new_object()
                    object.set(name, value)
                    return object
                }
            }
            uint as index => match this {
                ArrayValue as array => {
                    array.values.set_expand(index, value, null)
                    return array
                }
                default => {
                    let array = new_array()
                    array.values.set_expand(index, value, null)
                    return array
                }
            }
        }
    }

    + fn set_string(key: uint | String, value: String) Value {
        return this.set(key, value)
    }

    + fn set_int(key: uint | String, value: int) Value {
        return this.set(key, value)
    }

    + fn set_float(key: uint | String, value: float) Value {
        return this.set(key, value)
    }

    + fn set_bool(key: uint | String, value: bool) Value {
        return this.set(key, value)
    }

    + fn set_null(key: uint | String) Value {
        return this.set(key, null)
    }

    + fn remove(key: uint | String) Value {
        match key {
            String as name => match this {
                ObjectValue as object => return object.remove(name)
                default => return this
            }
            uint as index => match this {
                ArrayValue as array => return array.remove(index)
                default => return this
            }
        }
    }

    + fn append(value: Value) Value {
        match this {
            ArrayValue as array => return array.append(value)
            default => {
                let array = new_array()
                array.append(value)
                return array
            }
        }
    }

    + fn append_string(value: String) Value {
        return this.append(value)
    }

    + fn append_int(value: int) Value {
        return this.append(value)
    }

    + fn append_float(value: float) Value {
        return this.append(value)
    }

    + fn append_bool(value: bool) Value {
        return this.append(value)
    }

    + fn append_null() Value {
        return this.append(null)
    }

    + fn encode(pretty: bool (false)) String {
        return encode_into(this, ByteBuffer.new(1024), pretty).to_string()
    }

    + fn encode_into(output: ByteBuffer, pretty: bool (false)) ByteBuffer {
        return encode_into(this, output, pretty)
    }

    + fn prepend(value: Value) Value {
        match this {
            ArrayValue as array => return array.prepend(value)
            default => {
                let array = new_array()
                array.prepend(value)
                return array
            }
        }
    }

    fn _next(index: uint) (Value, Value) !IterError {
        match this {
            ArrayValue as array => {
                let v = array.values.get(index) ! throw .end
                return (v, index.to(Value))
            }
            ObjectValue as object => {
                let key = object.values._keys.get(index) ! throw .end
                let val = object.values.get(key) ! throw .end
                return (val, key.to(Value))
            }
            default => throw .end
        }
    }
}

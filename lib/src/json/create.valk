// JSON constructors use `new_` so their names do not shadow primitive types.

+ fn new_null() Value {
    return null
}

+ fn new_string(value: String) Value {
    return value
}

+ fn new_int(value: int) Value {
    return value
}

+ fn new_float(value: float) Value {
    return value
}

+ fn new_bool(value: bool) Value {
    return value
}

+ fn new_array(values: ?Array[Value] (null)) ArrayValue {
    return ArrayValue {
        values: values ?? Array[Value]{}
    }
}

+ fn new_object(values: ?Map[Value] (null)) ObjectValue {
    return ObjectValue {
        values: values ?? Map[Value]{}
    }
}

+ fn default_value(kind: Kind) Value {
    return match kind : Value {
        Kind.null => null
        Kind.string => ""
        Kind.bool => false
        Kind.int => 0
        Kind.float => 0.0
        Kind.array => new_array()
        Kind.object => new_object()
        default => null
    }
}

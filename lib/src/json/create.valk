use core

+ fn array(values: ?Array[Value] (null)) ArrayValue {
    return ArrayValue {
        values: values ?? Array[Value]{}
    }
}

+ fn object(values: ?Map[Value] (null)) ObjectValue {
    return ObjectValue {
        values: values ?? Map[Value]{}
    }
}

+ fn default_value(kind: Kind) Value {
    return match kind : Value {
        Kind.null => null
        Kind.string => ""
        Kind.bool => false
        Kind.int => 0
        Kind.float => 0.0
        Kind.array => array()
        Kind.object => object()
        default => null
    }
}

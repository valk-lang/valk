use mem

/// Converts `data` to a JSON value.
///
/// Strings, numbers and bools map to their JSON kinds, `null` to `null`, arrays to
/// arrays, string-keyed maps to objects, and classes and structs to objects with one
/// member per field. Field tags control serialization: `$tag(json: "name")` renames a
/// field, `$tag(json: "-")` skips it, and `$tag(omitempty)` omits zero/empty values.
/// Types with a `to_json_value` method use it. Any other value becomes
/// `null`. An object that is reached again inside itself becomes the string
/// `"(recursion)"`.
///
/// The value model holds signed 64-bit integers, so an unsigned 64-bit value above
/// `int.$max` becomes a float holding the nearest representable number rather than a
/// negative integer. Narrower unsigned types always fit and stay integers.
+ fn from(data: $T) Value {
    return convert_value(data, Array[uint]{})
}

fn json_pointer_identity(value: $T) uint $inline {
    #if T.$is_pointer
    @unsafe
    return mem.identity(value.@cast(ptr))
    #else
    #error "JSON pointer identity requires a pointer type"
    #end
}

fn json_is_empty(data: $T) bool {
    if !isset(data) : return true

    #if T.$nonnull.$is_type_of(Value)
    if data.is_null : return true
    if data.is_string : return data.string.bytes == 0
    if data.is_array : return data.array.length == 0
    if data.is_object : return data.object.length == 0
    if data.is_bool : return !data.bool
    if data.is_int : return data.int == 0
    if data.is_float : return data.float == 0.0
    return false
    #elif T.$nonnull.$is_type_of(String)
    return data.bytes == 0
    #elif T.$has_method(is_json_empty)
    return data.is_json_empty()
    #elif T.$is_bool
    return !data
    #elif T.$is_integer
    #if T.$is_signed
    return data.to(int) == 0
    #else
    return data.to(uint) == 0
    #end
    #elif T.$is_float
    return data == 0.0
    #else
    return false
    #end
}

fn convert_value(data: $T, stack: Array[uint]) Value {
    if !isset(data) : return null

    #if T.$nonnull.$is_type_of(Value)
    return data
    #elif T.$nonnull.$is_type_of(Array[Value]) || T.$nonnull.$is_type_of(Map[Value])
    // Already a JSON container: the same one, not a copy
    return data
    #elif T.$nonnull.$is_type_of(String)
    return data
    #elif T.$has_method(to_json_string)
    return data.to_json_string()
    #elif T.$has_method(to_json_value_with_stack)
    // On shared data the method may hand back shared parts: the tree is copied out
    #if T.$nonnull.$is_shared
    return clone data.to_json_value_with_stack(stack)
    #else
    return data.to_json_value_with_stack(stack)
    #end
    #elif T.$has_method(to_json_value)
    #if T.$nonnull.$is_shared
    return clone data.to_json_value()
    #else
    return data.to_json_value()
    #end
    #elif T.$is_integer
    #if !T.$is_enum && !T.$is_signed
    #if size_of(T) == 8
    // The value model has no unsigned integer, so an 8-byte value above
    // `int.$max` would wrap to a negative `int`; keep it as a float instead
    if data > int.$max.to(T) : return data.to(float)
    #end
    #end
    return data.to(int)
    #elif T.$is_float
    return data.to(float)
    #elif T.$is_bool
    return data
    #elif !T.$nonnull.$is_structural
    return null
    #else
    let values = Map[Value]{}

    #if T.$is_pointer
    let node = json_pointer_identity(data)
    if stack.contains(node) : return "(recursion)"
    stack.append(node)
    #end

    #loop object data as prop
    #if prop.$tag("json") != "-"
    #if prop.$has_tag("omitempty")
    if !json_is_empty(prop) {
        values.set(prop.$tag("json", prop.name), convert_value(prop, stack))
    }
    #else
    values.set(prop.$tag("json", prop.name), convert_value(prop, stack))
    #end
    #end
    #end

    #if T.$is_pointer
    stack.pop_last() _
    #end

    return new_object(values)
    #end
}


use core

global check_recursion : Array[ptr] (.{})

+ fn value(data: $T) Value {

    #if T.$is_nullable
    if !isset(data) : return new_null()
    #end


    #if T.$is_type_of(Value)
    return data
    #elif T.$has_method(to_json_value)
    return data.to_json_value()
    #elif T.$is_integer
    return new_int(data.to(core:int))
    #elif T.$is_float
    return new_float(data)
    #elif T.$is_bool
    return new_bool(data)
    #elif !T.$notnull.$is_structural
    return new_null()
    // #error "Cannot convert value to json"
    #else
        // Structural
        let i = Map[Value]{}

        if check_recursion.contains(data) : return new_string("(recursion)")
        check_recursion.append(data)

        #loop object data as prop
        i.set(prop.name, value(prop.value))
        #end // End loop
        let v = new_object(i)

        check_recursion.pop_last() _

        return v
    #end
}

+ fn from(data: $T) Value {
    return convert_value(data, Array[ptr]{})
}

fn json_pointer_identity(value: $T) ptr $inline {
    @unsafe
    #if T.$is_pointer
    return value.@cast(ptr)
    #else
    #error "JSON pointer identity requires a pointer type"
    #end
}

fn convert_value(data: $T, stack: Array[ptr]) Value {
    if !isset(data) : return null

    #if T.$is_type_of(Value)
    return data
    #elif T.$is_type_of(ArrayValue)
    return data
    #elif T.$is_type_of(ObjectValue)
    return data
    #elif T.$is_type_of(String)
    return data
    #elif T.$has_method(to_json_value_with_stack)
    return data.to_json_value_with_stack(stack)
    #elif T.$has_method(to_json_value)
    return data.to_json_value()
    #elif T.$is_integer
    return data.to(int)
    #elif T.$is_float
    return data.to(float)
    #elif T.$is_bool
    return data
    #elif !T.$nonnull.$is_structural
    return null
    #else
    let values = Map[Value]{}

    #if T.$is_pointer
    let node = json_pointer_identity(data)
    if stack.contains(node) : return "(recursion)"
    stack.append(node)
    #end

    #loop object data as prop
    values.set(prop.name, convert_value(prop, stack))
    #end

    #if T.$is_pointer
    stack.pop_last() _
    #end

    return new_object(values)
    #end
}

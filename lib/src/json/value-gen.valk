class ConvertedValue {
    value: Value
}

+ fn from(data: $T) Value {
    return convert_value(data, Array[ptr]{}).value
}

fn convert_value(data: $T, stack: Array[ptr]) ConvertedValue {
    if !isset(data) : return ConvertedValue { value: null }

    #if T.$is_type_of(Value)
    return ConvertedValue { value: data }
    #elif T.$is_type_of(ArrayValue)
    return ConvertedValue { value: data }
    #elif T.$is_type_of(ObjectValue)
    return ConvertedValue { value: data }
    #elif T.$is_type_of(String)
    return ConvertedValue { value: data }
    #elif T.$has_method(to_json_value_with_stack)
    return ConvertedValue { value: data.to_json_value_with_stack(stack) }
    #elif T.$has_method(to_json_value)
    return ConvertedValue { value: data.to_json_value() }
    #elif T.$is_integer
    return ConvertedValue { value: data.to(int) }
    #elif T.$is_float
    return ConvertedValue { value: data.to(float) }
    #elif T.$is_bool
    return ConvertedValue { value: data }
    #elif !T.$notnull.$is_structural
    // Generic serializers are often instantiated for types that contain an
    // opaque runtime handle (function pointers, raw pointers, coroutine state,
    // and similar values). They have no JSON representation, so encode that
    // leaf as null.
    return ConvertedValue { value: null }
    #else
    let values = Map[Value]{}

    #if T.$is_pointer
    if stack.contains(data) : return ConvertedValue { value: "(recursion)" }
    stack.append(data)
    #end

    #loop object data as prop
    values.set(prop.name, convert_value(prop, stack).value)
    #end

    #if T.$is_pointer
    stack.pop_last() _
    #end

    return ConvertedValue { value: new_object(values) }
    #end
}

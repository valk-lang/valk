use core

+ enum Kind {
    null
    string
    bool
    int
    float
    array
    object
}

+ class ArrayValue $noNewProperties {
    + values: Array[Value] (.{})

    + fn length() uint {
        return this.values.length
    }

    + fn get(index: uint) Value !ValueError {
        return this.values.get(index) ! throw .missing {
            message: "JSON array index %index does not exist"
        }
    }

    + fn get_or_null(index: uint) Value {
        return this.values.get(index) !? null
    }

    + fn append(value: Value) SELF {
        this.values.append(value)
        return this
    }

    + fn prepend(value: Value) SELF {
        this.values.prepend(value)
        return this
    }

    + fn remove(index: uint) SELF {
        this.values.remove(index)
        return this
    }
}

+ class ObjectValue $noNewProperties {
    + values: Map[Value] (.{})

    + fn length() uint {
        return this.values.length
    }

    + fn get(key: String) Value !ValueError {
        return this.values.get(key) ! throw .missing {
            message: "JSON object key '%key' does not exist"
        }
    }

    + fn get_or(key: String, fallback: Value) Value {
        return this.values.get(key) !? fallback
    }

    + fn get_or_null(key: String) Value {
        return this.values.get(key) !? null
    }

    + fn get_or_else(key: String, fallback: fn()(Value)) Value {
        return this.values.get(key) !? fallback()
    }

    + fn has(key: String) core:bool {
        return this.values.has(key)
    }

    + fn set(key: String, value: Value) SELF {
        this.values.set(key, value)
        return this
    }

    + fn remove(key: String) SELF {
        this.values.remove(key)
        return this
    }
}

+ enum Kind {
    null
    string
    bool
    int
    float
    array
    object
}

+ class ArrayValue $noNewProperties {
    + values: Array[Value] (.{})

    + get length: uint {
        return this.values.length
    }

    + fn get(index: uint) Value !LookupError {
        return this.values.get(index) ! throw .missing
    }

    + fn append(value: Value) {
        this.values.append(value)
    }

    + fn prepend(value: Value) {
        this.values.prepend(value)
    }

    + fn remove(index: uint) {
        this.values.remove(index)
    }
}

+ class ObjectValue $noNewProperties {
    + values: Map[Value] (.{})

    + get length: uint {
        return this.values.length
    }

    + fn get(key: String) Value !LookupError {
        return this.values.get(key) ! throw .missing
    }

    + fn has(key: String) bool {
        return this.values.has(key)
    }

    + fn set(key: String, value: Value) {
        this.values.set(key, value)
    }

    + fn remove(key: String) {
        this.values.remove(key)
    }
}

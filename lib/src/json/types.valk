/// The type of a JSON value, as reported by `Value.kind`.
+ enum Kind {
    /// The `null` value.
    null
    /// A string.
    string
    /// `true` or `false`.
    bool
    /// A number without a fraction or exponent.
    int
    /// A number with a fraction or exponent.
    float
    /// An `Array[Value]`.
    array
    /// A `Map[Value]`.
    object
}

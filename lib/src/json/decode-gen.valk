@ignore_access

+ fn from_value[T](data: Value) T !ValueError {
    #if T.$is_nullable
    if data.is_null() : return null
    #end

    #if T.$is_type_of(Value)
    return data
    #elif T.$is_type_of(ArrayValue)
    if !data.is_array() : throw .wrong_type { message: "Expected JSON array, got %{data.kind_name()}" }
    return data.array()
    #elif T.$is_type_of(ObjectValue)
    if !data.is_object() : throw .wrong_type { message: "Expected JSON object, got %{data.kind_name()}" }
    return data.object()
    #elif T.$is_type_of(String)
    if !data.is_string() : throw .wrong_type { message: "Expected JSON string, got %{data.kind_name()}" }
    return data.string()
    #elif T.$is_integer
    if !data.is_int() : throw .wrong_type { message: "Expected JSON int, got %{data.kind_name()}" }
    return data.int().@cast(T)
    #elif T.$is_float
    if !data.is_float() : throw .wrong_type { message: "Expected JSON float, got %{data.kind_name()}" }
    return data.float().@cast(T)
    #elif T.$is_bool
    if !data.is_bool() : throw .wrong_type { message: "Expected JSON bool, got %{data.kind_name()}" }
    return data.bool().@cast(T)
    #elif T.$has_method(from_json_value)
    return T.from_json_value(data) !>
    #elif T.$has_method(from_json_value_auto)
    return T.from_json_value_auto[Value](data) !>
    #elif !T.$is_structural
    #print T
    #error "Cannot convert a JSON value to this type"
    #else
    if !data.is_object() : throw .wrong_type { message: "Expected JSON object, got %{data.kind_name()}" }
    let source = data.object()
    let result = T {
        #loop properties T as prop
        prop: from_value[prop](source.get(prop.name) !>) !>
        #end
    }
    return result
    #end
}

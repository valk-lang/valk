@ignore_access

+ fn from_value[T](data: Value) T !LookupError {
    #if T.$is_nullable
    if data.is_null : return null
    #end

    #if T.$is_type_of(Value)
    return data
    #elif T.$is_type_of(ArrayValue)
    if !data.is_array : throw .missing
    return data.array
    #elif T.$is_type_of(ObjectValue)
    if !data.is_object : throw .missing
    return data.object
    #elif T.$is_type_of(String)
    if !data.is_string : throw .missing
    return data.string
    #elif T.$is_integer
    if !data.is_int : throw .missing
    return data.int.@cast(T)
    #elif T.$is_float
    if !data.is_float : throw .missing
    return data.float.@cast(T)
    #elif T.$is_bool
    if !data.is_bool : throw .missing
    return data.bool.@cast(T)
    #elif T.$has_method(from_json_value)
    return T.from_json_value(data) !>
    #elif T.$has_method(from_json_value_auto)
    return T.from_json_value_auto[Value](data) !>
    #elif !T.$is_structural
    #print T
    #error "Cannot convert a JSON value to this type"
    #else
    if !data.is_object : throw .missing
    let source = data.object
    let result = T {
        #loop properties T as prop
        prop: from_value[prop](source.get(prop.name) !>) !>
        #end
    }
    return result
    #end
}

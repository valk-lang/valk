
@ignore_access

+ fn to_type[T](data: Value) T {

    #if T.$is_nullable
    if data.is_null() : return null
    #end

    #if T.$has_method(from_json_value)
    return T.from_json_value(data)
    #elif T.$has_method(from_json_value_auto)
    return T.from_json_value_auto[Value](data)
    #elif T.$is_integer
    return data.int().@cast(T)
    #elif T.$is_float
    return data.float().@cast(T)
    #elif T.$is_bool
    return data.bool().@cast(T)
    #elif !T.$is_structural
    #print_type(T)
    #error "Cannot convert json to this value type"
    #else
    // Structural
    let result = T {
        #loop properties T as prop
        prop: to_type[prop](data.get_or(prop.name))
        #end // End loop
    }
    return result
    #end
}

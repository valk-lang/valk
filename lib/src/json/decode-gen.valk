@ignore_access

extend Value {
    /// Converts the value to `T`.
    ///
    /// Throws `.missing` when the value does not fit `T`. A nullable `T` accepts `null`.
    /// Integers must be JSON integers within the range of `T`; a float accepts any JSON
    /// number, so an integer such as `3` converts to `3.0` (a value that overflows `f32` is
    /// rejected). Types with a static `from_json_value` method use it; arrays and
    /// string-keyed maps convert item by item. For a class or struct the value must be an
    /// object: fields that are nullable or declare an explicit default may be absent or
    /// `null` and then get their default, every other field is required, and unknown
    /// members are ignored.
    + fn to_type[T]() T !LookupError {
        #if T.$is_nullable
        if this.is_null : return null
        #end

        #if T.$nonnull.$is_type_of(Value)
        return this
        #elif T.$nonnull.$is_type_of(ArrayValue)
        if !this.is_array : throw .missing
        return this.array
        #elif T.$nonnull.$is_type_of(ObjectValue)
        if !this.is_object : throw .missing
        return this.object
        #elif T.$nonnull.$is_type_of(String)
        if !this.is_string : throw .missing
        return this.string
        #elif T.$is_integer
        if !this.is_int : throw .missing
        let number = this.int
        #if T.$is_signed
        if !integer_fits[T](number) : throw .missing
        #else
        if number < 0 || !uint_fits[T](number.to(uint)) : throw .missing
        #end
        return number.to(T)
        #elif T.$is_float
        if !this.is_float : throw .missing
        let number = this.float
        let converted = number.to(T)
        if size_of(T) == 4 && number == number {
            let finite = converted.to(float) - converted.to(float)
            if finite != finite : throw .missing
        }
        return converted
        #elif T.$is_bool
        if !this.is_bool : throw .missing
        return this.bool
        #elif T.$has_method(from_json_value)
        return T.from_json_value(this) !>
        #elif T.$has_method(from_json_value_auto)
        return T.from_json_value_auto[Value](this) !>
        #elif !T.$is_structural
        #print T
        #error "Cannot convert a JSON value to this type"
        #else
        if !this.is_object : throw .missing
        let source = this.object
        // Fields with an explicit default or a nullable type may be missing
        let result = T {
            #loop properties T as prop
            prop: <{
                #if prop.$has_explicit_default_value || prop.$type.$is_nullable
                let field = source.get(prop.name) ! return prop.$default_value
                if field.is_null : return prop.$default_value
                return field.to_type[prop]() !>
                #else
                return (source.get(prop.name) !>).to_type[prop]() !>
                #end
            }
            #end
        }
        return result
        #end
    }
}

@ignore_access

extend Value {
    + fn to_type[T]() T !LookupError {
        #if T.$is_nullable
        if this.is_null : return null
        #end

        #if T.$is_type_of(Value)
        return this
        #elif T.$is_type_of(ArrayValue)
        if !this.is_array : throw .missing
        return this.array
        #elif T.$is_type_of(ObjectValue)
        if !this.is_object : throw .missing
        return this.object
        #elif T.$is_type_of(String)
        if !this.is_string : throw .missing
        return this.string
        #elif T.$is_integer
        if !this.is_int : throw .missing
        let number = this.int
        #if T.$is_signed
        if !integer_fits[T](number) : throw .missing
        #else
        if number < 0 || !uint_fits[T](number.to(uint)) : throw .missing
        #end
        return number.to(T)
        #elif T.$is_float
        if !this.is_float : throw .missing
        let number = this.float
        let converted = number.to(T)
        if size_of(T) == 4 && number == number {
            let finite = converted.to(float) - converted.to(float)
            if finite != finite : throw .missing
        }
        return converted
        #elif T.$is_bool
        if !this.is_bool : throw .missing
        return this.bool
        #elif T.$has_method(from_json_value)
        return T.from_json_value(this) !>
        #elif T.$has_method(from_json_value_auto)
        return T.from_json_value_auto[Value](this) !>
        #elif !T.$is_structural
        #print T
        #error "Cannot convert a JSON value to this type"
        #else
        if !this.is_object : throw .missing
        let source = this.object
        let result = T {
            #loop properties T as prop
            prop: (source.get(prop.name) !>).to_type[prop]() !>
            #end
        }
        return result
        #end
    }
}

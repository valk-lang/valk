@ignore_access

+ fn from_value[T](data: Value) T !ValueError {
    #if T.$is_nullable
    if data.is_null() : return null
    #end

    #if T.$is_type_of(Value)
    return data
    #elif T.$is_type_of(ArrayValue)
    return data.as_array() !>
    #elif T.$is_type_of(ObjectValue)
    return data.as_object() !>
    #elif T.$is_type_of(String)
    return data.as_string() !>
    #elif T.$is_integer
    return (data.as_int() !>).@cast(T)
    #elif T.$is_float
    return (data.as_float() !>).@cast(T)
    #elif T.$is_bool
    return (data.as_bool() !>).@cast(T)
    #elif T.$has_method(from_json_value)
    return T.from_json_value(data) !>
    #elif T.$has_method(from_json_value_auto)
    return T.from_json_value_auto[Value](data) !>
    #elif !T.$is_structural
    #print T
    #error "Cannot convert a JSON value to this type"
    #else
    let source = data.as_object() !>
    let result = T {
        #loop properties T as prop
        prop: from_value[prop](source.get(prop.name) !>) !>
        #end
    }
    return result
    #end
}

use ext

#if OS == "linux"
link dynamic "m"
#end

+ value E (2.718281828459045)
+ value PI (3.141592653589793)
+ value TAU (6.283185307179586)

+ fn abs(value: float) float $inline {
    return ext.fabs(value)
}

+ fn acos(value: float) float $inline {
    return ext.acos(value)
}

+ fn asin(value: float) float $inline {
    return ext.asin(value)
}

+ fn atan(value: float) float $inline {
    return ext.atan(value)
}

+ fn atan2(y: float, x: float) float $inline {
    return ext.atan2(y, x)
}

+ fn cbrt(value: float) float $inline {
    return ext.cbrt(value)
}

+ fn ceil(value: float) float $inline {
    return ext.ceil(value)
}

+ fn cos(value: float) float $inline {
    return ext.cos(value)
}

+ fn exp(value: float) float $inline {
    return ext.exp(value)
}

+ fn exp2(value: float) float $inline {
    return ext.exp2(value)
}

+ fn floor(value: float) float $inline {
    return ext.floor(value)
}

+ fn hypot(x: float, y: float) float $inline {
    return ext.hypot(x, y)
}

+ fn log(value: float) float $inline {
    return ext.log(value)
}

+ fn log2(value: float) float $inline {
    return ext.log2(value)
}

+ fn log10(value: float) float $inline {
    return ext.log10(value)
}

+ fn pow(base: float, exponent: float) float $inline {
    return ext.pow(base, exponent)
}

+ fn mod(value: float, divisor: float) float $inline {
    return ext.fmod(value, divisor)
}

+ fn round(value: float) float $inline {
    return ext.round(value)
}

+ fn sin(value: float) float $inline {
    return ext.sin(value)
}

+ fn sqrt(value: float) float $inline {
    return ext.sqrt(value)
}

+ fn tan(value: float) float $inline {
    return ext.tan(value)
}

+ fn trunc(value: float) float $inline {
    return ext.trunc(value)
}

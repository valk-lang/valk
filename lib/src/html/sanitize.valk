use io

/// Chooses which characters `escape` replaces with HTML entities; all are escaped by default.
+ class EscapeOptions {
    /// Replaces `<` with `&lt;`.
    + escape_lt: bool (true)
    /// Replaces `>` with `&gt;`.
    + escape_gt: bool (true)
    /// Replaces `"` with `&quot;`.
    + escape_double_quote: bool (true)
    /// Replaces `'` with `&#39;`.
    + escape_single_quote: bool (true)
    /// Replaces `&` with `&amp;`.
    + escape_ampersand: bool (true)
}

/// Returns `code` with the HTML special characters `<`, `>`, `"`, `'` and `&` as entities.
///
/// The result is safe as element text and inside quoted attribute values. Pass `options` to
/// leave some of the characters as they are.
+ fn escape(code: String, options: ?EscapeOptions (null)) String {
    let buf = ByteBuffer.new(code.length + 16)
    escape_to(code, buf, options)
    return buf
}

/// Writes `code` escaped as `escape` does to `out` and returns the bytes written.
///
/// A `ByteBuffer` is written directly; any other writer receives the escaped text in one
/// write. Throws when `out` fails.
+ fn escape_into(code: String, out: io.Writer, options: ?EscapeOptions (null)) uint !io.IoError {
    match out {
        ByteBuffer as buf => {
            let before = buf.length
            escape_to(code, buf, options)
            return buf.length - before
        }
        default => {
            let buf = ByteBuffer.new(code.length + 16)
            escape_to(code, buf, options)
            return out.write(buf) !>
        }
    }
}

fn escape_to(code: String, buf: ByteBuffer, options: ?EscapeOptions) {
    let len = code.length

    let escape_lt = true
    let escape_gt = true
    let escape_double_quote = true
    let escape_single_quote = true
    let escape_ampersand = true

    if isset(options) {
        escape_lt = options.escape_lt
        escape_gt = options.escape_gt
        escape_double_quote = options.escape_double_quote
        escape_single_quote = options.escape_single_quote
        escape_ampersand = options.escape_ampersand
    }

    let i = 0
    while i < len {
        let ch = code.get(i++)
        if ch == '<' && escape_lt {
            buf.write("&lt;")
        } else if ch == '>' && escape_gt {
            buf.write("&gt;")
        } else if ch == '"' && escape_double_quote {
            buf.write("&quot;")
        } else if ch == '\'' && escape_single_quote {
            buf.write("&#39;")
        } else if ch == '&' && escape_ampersand {
            buf.write("&amp;")
        } else {
            buf.write_byte(ch)
        }
    }
}

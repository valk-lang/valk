use io

/// Chooses which characters `escape` replaces with HTML entities; all are escaped by default.
+ class EscapeOptions {
    /// Replaces `<` with `&lt;`.
    + escape_lt: bool (true)
    /// Replaces `>` with `&gt;`.
    + escape_gt: bool (true)
    /// Replaces `"` with `&quot;`.
    + escape_double_quote: bool (true)
    /// Replaces `'` with `&#39;`.
    + escape_single_quote: bool (true)
    /// Replaces `&` with `&amp;`.
    + escape_ampersand: bool (true)
}

/// Returns `code` with the HTML special characters `<`, `>`, `"`, `'` and `&` as entities.
///
/// The result is safe as element text and inside quoted attribute values. Pass `options` to
/// leave some of the characters as they are.
+ fn escape(code: local &[u8], options: ?EscapeOptions (null)) String {
    let buf = ByteBuffer.new(code.length + 16)
    escape_to(code, buf, options)
    return buf
}

/// Writes `code` escaped as `escape` does to `out` and returns the bytes written.
///
/// A `ByteBuffer` is written directly; any other writer receives the escaped text in one
/// write. Throws when `out` fails.
+ fn escape_into(code: local &[u8], out: io.Writer, options: ?EscapeOptions (null)) uint !io.IoError {
    match out {
        ByteBuffer as buf => {
            let before = buf.length
            escape_to(code, buf, options)
            return buf.length - before
        }
        default => {
            let buf = ByteBuffer.new(code.length + 16)
            escape_to(code, buf, options)
            return out.write(buf) !>
        }
    }
}

fn escape_to(code: local &[u8], buf: ByteBuffer, options: ?EscapeOptions) {
    let len = code.length
    if len == 0 : return

    let escape_lt = true
    let escape_gt = true
    let escape_double_quote = true
    let escape_single_quote = true
    let escape_ampersand = true

    if isset(options) {
        escape_lt = options.escape_lt
        escape_gt = options.escape_gt
        escape_double_quote = options.escape_double_quote
        escape_single_quote = options.escape_single_quote
        escape_ampersand = options.escape_ampersand
    }

    buf.reserve(len)
    let p = code.data
    let start: uint = 0
    let i: uint = 0
    let all_five = escape_lt && escape_gt && escape_double_quote && escape_single_quote && escape_ampersand
    let lt = $splat[u8x16]('<')
    let gt = $splat[u8x16]('>')
    let dq = $splat[u8x16]('"')
    let sq = $splat[u8x16]('\'')
    let amp = $splat[u8x16]('&')
    while i < len {
        if all_five && len - i >= 16 {
            while len - i >= 16 {
                let block = $load[u8x16](code, i)
                let special = $eq(block, lt) | $eq(block, gt) | $eq(block, dq) | $eq(block, sq) | $eq(block, amp)
                let hits = $mask_bits(special)
                if hits != 0 {
                    i += hits.trailing_zeros()
                    break
                }
                i += 16
            }
            if i >= len : break
        }
        let ch = @ptrv(p, u8, i)
        if ch > '>' {
            i++
            continue
        }
        let rep = ""
        if ch == '<' && escape_lt : rep = "&lt;"
        else if ch == '>' && escape_gt : rep = "&gt;"
        else if ch == '"' && escape_double_quote : rep = "&quot;"
        else if ch == '\'' && escape_single_quote : rep = "&#39;"
        else if ch == '&' && escape_ampersand : rep = "&amp;"
        else {
            i++
            continue
        }
        if i > start : buf.write(code.view(start, i - start))
        buf.write(rep)
        i++
        start = i
    }
    if len > start : buf.write(code.view(start, len - start))
}

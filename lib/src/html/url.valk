use url

fn url_attribute_name(name: String) bool {
    let lower = name.lower()
    return lower == "href"
        || lower == "src"
        || lower == "action"
        || lower == "formaction"
        || lower == "poster"
        || lower == "cite"
        || lower == "background"
        || lower == "xlink:href"
        || lower == "data"
        || lower == "codebase"
        || lower == "longdesc"
        || lower == "usemap"
        || lower == "profile"
        || lower == "manifest"
}

fn raw_text_tag(name: String) bool {
    let lower = name.lower()
    return lower == "script"
        || lower == "style"
        || lower == "textarea"
        || lower == "title"
        || lower == "xmp"
        || lower == "iframe"
        || lower == "noembed"
        || lower == "noframes"
        || lower == "plaintext"
}

fn html_reference_ascii(text: String, offset: uint) (u8, uint) {
    let bytes = text.bytes
    if offset >= bytes || text.get(offset) != '&' : return (0, 0)
    let index = offset + 1
    if index >= bytes : return (0, 0)

    if text.get(index) != '#' {
        if text.part(index, 6) == "colon;" : return (':', 7)
        if text.part(index, 4) == "Tab;" : return ('\t', 5)
        if text.part(index, 8) == "NewLine;" : return ('\n', 9)
        return (0, 0)
    }

    index++
    let base: uint = 10
    if index < bytes && (text.get(index) == 'x' || text.get(index) == 'X') {
        base = 16
        index++
    }
    let digits = 0
    let value: uint = 0
    while index < bytes {
        let ch = text.get(index)
        let digit: uint = 0
        if ch >= '0' && ch <= '9' : digit = (ch - '0').to(uint)
        else if base == 16 && ch >= 'a' && ch <= 'f' : digit = (ch - 'a' + 10).to(uint)
        else if base == 16 && ch >= 'A' && ch <= 'F' : digit = (ch - 'A' + 10).to(uint)
        else : break
        if digit >= base : break
        if value > (255 - digit) / base : return (0, 0)
        value = value * base + digit
        digits++
        index++
    }
    if digits == 0 : return (0, 0)
    if index < bytes && text.get(index) == ';' : index++
    return (value.to(u8), index - offset)
}

fn url_as_browser_sees(target: String) String {
    let buf = ByteBuffer.new(target.bytes)
    let offset: uint = 0
    while offset < target.bytes {
        let decoded, consumed = html_reference_ascii(target, offset)
        if consumed > 0 {
            if decoded != '\t' && decoded != '\n' && decoded != '\r' : buf.write_byte(decoded)
            offset += consumed
            continue
        }
        let ch = target.get(offset++)
        if ch == '\t' || ch == '\n' || ch == '\r' : continue
        buf.write_byte(ch)
    }

    let normalized: String = buf
    let from: uint = 0
    let until = normalized.bytes
    while from < until && normalized.get(from) <= ' ' { from++ }
    while until > from && normalized.get(until - 1) <= ' ' { until-- }
    return normalized.part(from, until - from)
}

+ fn url_is_allowed(target: String, allowed_schemes: Array[String] (.{ "http", "https", "mailto" })) bool {
    let scheme = url.parse(url_as_browser_sees(target)).scheme
    if scheme.is_empty() : return true
    each allowed_schemes as allowed {
        if scheme == allowed.lower() : return true
    }
    return false
}

+ fn sanitize_url_attributes(code: String, allowed_schemes: Array[String] (.{ "http", "https", "mailto" })) String {
    let output = ByteBuffer.new(code.bytes)
    let offset: uint = 0
    let bytes = code.bytes
    let raw_tag: String = ""
    while offset < bytes {
        let ch = code.get(offset)
        if !raw_tag.is_empty() {
            let closing = code.part(offset, raw_tag.bytes + 2)
            if ch != '<' || closing.lower() != "</" + raw_tag {
                output.write_byte(ch)
                offset++
                continue
            }
            raw_tag = ""
        }
        if ch != '<' {
            output.write_byte(ch)
            offset++
            continue
        }

        output.write_byte(ch)
        offset++
        if offset >= bytes : break
        ch = code.get(offset)
        if ch == '!' || ch == '?' || ch == '/' {
            while offset < bytes {
                ch = code.get(offset++)
                output.write_byte(ch)
                if ch == '>' : break
            }
            continue
        }

        let tag_start = offset
        while offset < bytes {
            ch = code.get(offset)
            if ch.is_whitespace() || ch == '>' || ch == '/' : break
            output.write_byte(ch)
            offset++
        }
        let tag_name = code.part(tag_start, offset - tag_start)
        let next_raw_tag = raw_text_tag(tag_name) ? tag_name.lower() : ""

        while offset < bytes {
            ch = code.get(offset)
            if ch == '>' {
                output.write_byte(ch)
                offset++
                raw_tag = next_raw_tag
                break
            }
            if ch.is_whitespace() || ch == '/' {
                output.write_byte(ch)
                offset++
                continue
            }

            let name_start = offset
            while offset < bytes {
                ch = code.get(offset)
                if ch.is_whitespace() || ch == '=' || ch == '>' || ch == '/' : break
                output.write_byte(ch)
                offset++
            }
            let name = code.part(name_start, offset - name_start)
            while offset < bytes && code.get(offset).is_whitespace() {
                output.write_byte(code.get(offset++))
            }
            if offset >= bytes || code.get(offset) != '=' : continue
            output.write_byte('=')
            offset++
            while offset < bytes && code.get(offset).is_whitespace() {
                output.write_byte(code.get(offset++))
            }
            if offset >= bytes : break

            let quote: u8 = 0
            if code.get(offset) == '"' || code.get(offset) == '\'' {
                quote = code.get(offset++)
                output.write_byte(quote)
            }
            let value_start = offset
            while offset < bytes {
                ch = code.get(offset)
                if quote > 0 {
                    if ch == quote : break
                } else if ch.is_whitespace() || ch == '>' {
                    break
                }
                offset++
            }
            let value = code.part(value_start, offset - value_start)
            if !url_attribute_name(name) || url_is_allowed(value, allowed_schemes) {
                output.write_string(value)
            }
            if quote > 0 && offset < bytes && code.get(offset) == quote {
                output.write_byte(quote)
                offset++
            }
        }
    }
    return output
}

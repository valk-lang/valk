use url

fn url_attribute_name(name: String) bool {
    let lower = name.lower()
    return lower == "href"
        || lower == "src"
        || lower == "action"
        || lower == "formaction"
        || lower == "poster"
        || lower == "cite"
        || lower == "background"
        || lower == "xlink:href"
        || lower == "data"
        || lower == "codebase"
        || lower == "longdesc"
        || lower == "usemap"
        || lower == "profile"
        || lower == "manifest"
}

fn html_reference_ascii(text: String, offset: uint) (u8, uint) {
    let bytes = text.bytes
    if offset >= bytes || text.get(offset) != '&' : return (0, 0)
    let index = offset + 1
    if index >= bytes : return (0, 0)

    if text.get(index) != '#' {
        if text.range(index, 6) == "colon;" : return (':', 7)
        if text.range(index, 4) == "Tab;" : return ('\t', 5)
        if text.range(index, 8) == "NewLine;" : return ('\n', 9)
        return (0, 0)
    }

    index++
    let base: uint = 10
    if index < bytes && (text.get(index) == 'x' || text.get(index) == 'X') {
        base = 16
        index++
    }
    let digits = 0
    let value: uint = 0
    while index < bytes {
        let ch = text.get(index)
        let digit: uint = 0
        if ch >= '0' && ch <= '9' : digit = (ch - '0').to(uint)
        else if base == 16 && ch >= 'a' && ch <= 'f' : digit = (ch - 'a' + 10).to(uint)
        else if base == 16 && ch >= 'A' && ch <= 'F' : digit = (ch - 'A' + 10).to(uint)
        else : break
        if digit >= base : break
        if value > (255 - digit) / base : return (0, 0)
        value = value * base + digit
        digits++
        index++
    }
    if digits == 0 : return (0, 0)
    if index < bytes && text.get(index) == ';' : index++
    return (value.to(u8), index - offset)
}

fn url_as_browser_sees(target: String) String {
    let buf = ByteBuffer.new(target.bytes)
    let offset: uint = 0
    while offset < target.bytes {
        let decoded, consumed = html_reference_ascii(target, offset)
        if consumed > 0 {
            if decoded != '\t' && decoded != '\n' && decoded != '\r' : buf.write_byte(decoded)
            offset += consumed
            continue
        }
        let ch = target.get(offset++)
        if ch == '\t' || ch == '\n' || ch == '\r' : continue
        buf.write_byte(ch)
    }

    let normalized: String = buf
    let from: uint = 0
    let until = normalized.bytes
    while from < until && normalized.get(from) <= ' ' { from++ }
    while until > from && normalized.get(until - 1) <= ' ' { until-- }
    return normalized.range(from, until - from)
}

/// Returns whether a URL taken from an HTML attribute uses a scheme in `allowed_schemes`.
///
/// The URL is read as a browser would: character references such as `&#106;` and `&colon;`
/// are decoded, tabs and line breaks are removed and surrounding whitespace is trimmed, so
/// `java&#x09;script:` is caught. Relative URLs have no scheme and are always allowed.
/// Schemes compare case-insensitively.
+ fn url_is_allowed(url: String, allowed_schemes: Array[String] (.{ "http", "https", "mailto" })) bool {
    let scheme = url.parse(url_as_browser_sees(url)).scheme
    if scheme.is_empty() : return true
    each allowed_schemes as allowed {
        if scheme == allowed.lower() : return true
    }
    return false
}

/// Returns `code` with the value of every URL attribute whose scheme is not allowed emptied.
///
/// URL attributes are `href`, `src`, `action`, `formaction`, `poster`, `cite`,
/// `background`, `xlink:href`, `data`, `codebase`, `longdesc`, `usemap`, `profile` and
/// `manifest`; each value is checked with `url_is_allowed`. The attribute itself and its
/// quotes stay, and a rejected value is emptied: a quoted one keeps its empty quotes, and an
/// unquoted one gets `""` so the text that followed it cannot become the value.
/// Every `<` followed by a letter is read as a start tag, also inside comments, attribute
/// values and raw text elements such as `<script>`, so tag-like text there can change too.
/// Nothing else is changed: event handler attributes such as `onclick` and `<script>`
/// elements pass through, so this is not a full HTML sanitizer. Input built to make this
/// check very slow gets every `<` escaped instead.
+ fn sanitize_url_attributes(code: String, allowed_schemes: Array[String] (.{ "http", "https", "mailto" })) String {
    // Emptying a value can change how overlapping tags read, so repeat until nothing changes
    let text = code
    let passes = 0
    while passes++ < 8 {
        let edits = Array[uint]{}
        if !find_rejected_urls(text, allowed_schemes, edits) : break
        if edits.length == 0 : return text
        text = empty_values(text, edits)
    }
    let escaped = ByteBuffer.new(text.bytes + 64)
    each text as ch {
        if ch == '<' : escaped.write("&lt;")
        else : escaped.write_byte(ch)
    }
    return escaped.into_string()
}

// Adds start, length and quoted (0 or 1) of each rejected URL value in every start tag a
// browser could read in `code`. Returns false when the tags overlap too much to check.
fn find_rejected_urls(code: String, allowed_schemes: Array[String], edits: Array[uint]) bool {
    let bytes = code.bytes
    let budget = bytes * 16 + 4096
    let work: uint = 0
    let at: uint = 0
    while at + 1 < bytes {
        if code.get(at) == '<' && code.get(at + 1).is_alpha() {
            work += read_start_tag(code, at, allowed_schemes, edits) - at
            if work > budget : return false
        }
        at++
    }
    return true
}

// Reads the start tag at `at` as the HTML tokenizer does and returns where it ends
fn read_start_tag(code: String, at: uint, allowed_schemes: Array[String], edits: Array[uint]) uint {
    let bytes = code.bytes
    let offset = at + 2
    while offset < bytes {
        let ch = code.get(offset)
        if ch.is_html_whitespace() || ch == '/' || ch == '>' : break
        offset++
    }
    while offset < bytes {
        let ch = code.get(offset)
        if ch == '>' : return offset + 1
        if ch.is_html_whitespace() || ch == '/' {
            offset++
            continue
        }
        // A name may start with '='
        let name_start = offset++
        while offset < bytes {
            ch = code.get(offset)
            if ch.is_html_whitespace() || ch == '/' || ch == '>' || ch == '=' : break
            offset++
        }
        let name = code.range(name_start, offset - name_start)
        while offset < bytes && code.get(offset).is_html_whitespace() : offset++
        if offset >= bytes || code.get(offset) != '=' : continue
        offset++
        while offset < bytes && code.get(offset).is_html_whitespace() : offset++
        if offset >= bytes || code.get(offset) == '>' : continue

        let quote = code.get(offset)
        let quoted = quote == '"' || quote == '\''
        if quoted : offset++
        let value_start = offset
        while offset < bytes {
            ch = code.get(offset)
            if quoted {
                if ch == quote : break
            } else if ch.is_html_whitespace() || ch == '>' {
                break
            }
            offset++
        }
        let value_length = offset - value_start
        if quoted && offset < bytes : offset++
        if url_attribute_name(name) && !url_is_allowed(code.range(value_start, value_length), allowed_schemes) {
            edits.append(value_start)
            edits.append(value_length)
            edits.append(quoted ? 1 : 0)
        }
    }
    return offset
}

// Drops the bytes of each edit; an unquoted value becomes `""` so the text after it cannot
// become the value
fn empty_values(code: String, edits: Array[uint]) String {
    let bytes = code.bytes
    // Bit 1: dropped, bit 2: write `""` before this byte
    let marks = [u8]{ 0 x (bytes + 1) }
    let i: uint = 0
    while i < edits.length {
        let start = edits[i]
        let length = edits[i + 1]
        if edits[i + 2] == 0 : marks[start] = marks[start] | 2
        each start .. length as pos : marks[pos] = marks[pos] | 1
        i += 3
    }
    let output = ByteBuffer.new(bytes + 16)
    each 0 .. bytes + 1 as pos {
        if (marks[pos] & 2) != 0 : output.write("\"\"")
        if pos < bytes && (marks[pos] & 1) == 0 : output.write_byte(code.get(pos))
    }
    return output.into_string()
}


+ class Url {
    + scheme: String // http, https, file, ... — case-insensitive, so it is stored lowercased
    + host: String
    + path: String
    + query: String
    + fragment: String
}

fn scheme_length(str: String) uint {
    // RFC 3986 section 3.1: ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ) ":"
    // Returns the length of the scheme, or 0 when the string does not begin with one.
    let len = str.bytes
    if len == 0 : return 0
    let data = str.data
    if !@ptrv(data, u8, 0).is_alpha() : return 0
    let i: uint = 1
    while i < len {
        let ch = @ptrv(data, u8, i)
        if ch == ':' : return i
        if !ch.is_alpha_numeric() && ch != '+' && ch != '-' && ch != '.' : return 0
        i++
    }
    return 0
}

+ fn parse(str: String) Url {
    let len = str.bytes

    // The fragment is split off before anything else. It is not part of any component,
    // it must never be sent to a server, and leaving it in the string is how it ended
    // up inside .path — and because a '#' also terminates an authority, a URL such as
    // http://evil.com#@good.com/ has to be cut at the '#' first to be read correctly.
    let hash = str.index_of("#") !? len
    let fragment = ""
    if hash < len : fragment = str.part(hash + 1, len - hash - 1)
    let rest = str.part(0, hash)

    let body = rest
    let scheme = ""
    let slen = scheme_length(rest)
    if slen > 0 {
        scheme = rest.part(0, slen).lower()
        body = rest.part(slen + 1, rest.bytes - slen - 1)
    }

    let host = ""
    if body.starts_with("//") {
        // The authority runs up to the first '/' or '?'; '#' cannot occur here anymore.
        // Splitting on '/' alone let '?a=b/c' poison the host, which made every host
        // allow-list built on .host attacker-influenced.
        let blen = body.bytes
        let end: uint = 2
        while end < blen {
            let ch = @ptrv(body.data, u8, end)
            if ch == '/' || ch == '?' : break
            end++
        }
        host = body.part(2, end - 2)
        body = body.part(end, blen - end)
    }

    let body_len = body.bytes
    let q = body.index_of("?") !? body_len
    let path = body.part(0, q)
    let query = ""
    if q < body_len : query = body.part(q + 1, body_len - q - 1)

    return Url {
        scheme: scheme,
        host: host,
        path: path,
        query: query,
        fragment: fragment,
    }
}

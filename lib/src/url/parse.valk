
+ class Url {
    + scheme: String // http, https, file, ... — case-insensitive, so it is stored lowercased
    + user: String ("") // userinfo before the first ':', as written (still percent-encoded)
    + password: String ("") // userinfo after the first ':'
    + host: String // without userinfo and port; an IPv6 literal keeps its brackets
    + port: ?uint (null) // null when absent or empty; the value is not range-checked
    + path: String
    + query: String
    + fragment: String

    // host[:port], the form used in a Host header
    + fn host_with_port() String {
        let port = this.port
        if !isset(port) : return this.host
        return this.host + ":" + port
    }
}

fn scheme_length(str: String) uint {
    // RFC 3986 section 3.1: ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ) ":"
    // Returns the length of the scheme, or 0 when the string does not begin with one.
    let len = str.bytes
    if len == 0 : return 0
    if !str[0].is_alpha() : return 0
    let i: uint = 1
    while i < len {
        let ch = str[i]
        if ch == ':' : return i
        if !ch.is_alpha_numeric() && ch != '+' && ch != '-' && ch != '.' : return 0
        i++
    }
    return 0
}

fn is_digits(str: String) bool {
    each str as ch {
        if !ch.is_number() : return false
    }
    return true
}

// Splits "user:password@host:port" into the matching Url fields.
fn parse_authority(authority: String, result: Url) {
    let hostport = authority
    let at = authority.bytes
    // Userinfo ends at the last '@'; neither part may contain a raw '@'.
    let i = authority.bytes
    while i > 0 {
        if authority[--i] == '@' {
            at = i
            break
        }
    }
    if at < authority.bytes {
        let userinfo = authority.part(0, at)
        hostport = authority.part(at + 1, authority.bytes - at - 1)
        let colon = userinfo.index_of(":") !? userinfo.bytes
        result.user = userinfo.part(0, colon)
        if colon < userinfo.bytes : result.password = userinfo.part(colon + 1, userinfo.bytes - colon - 1)
    }

    // The port follows the last ':' after the host, which for an IPv6 literal is the ':' after ']'.
    let len = hostport.bytes
    let split = len
    if len > 0 && hostport[0] == '[' {
        let close = hostport.index_of("]") !? len
        if close + 1 < len && hostport[close + 1] == ':' : split = close + 1
    } else {
        i = len
        while i > 0 {
            if hostport[--i] == ':' {
                split = i
                break
            }
        }
    }
    result.host = hostport
    if split == len : return
    // A non-numeric port is not a port; the text then stays in the host
    let port = hostport.part(split + 1, len - split - 1)
    if !is_digits(port) : return
    result.host = hostport.part(0, split)
    if port.bytes > 0 : result.port = port.to_uint() !? null
}

+ fn parse(str: String) Url {
    let len = str.bytes

    // The fragment is split off before anything else. It is not part of any component,
    // it must never be sent to a server, and leaving it in the string is how it ended
    // up inside .path — and because a '#' also terminates an authority, a URL such as
    // http://evil.com#@good.com/ has to be cut at the '#' first to be read correctly.
    let hash = str.index_of("#") !? len
    let fragment = ""
    if hash < len : fragment = str.part(hash + 1, len - hash - 1)
    let rest = str.part(0, hash)

    let body = rest
    let scheme = ""
    let slen = scheme_length(rest)
    if slen > 0 {
        scheme = rest.part(0, slen).lower()
        body = rest.part(slen + 1, rest.bytes - slen - 1)
    }

    let result = Url {
        scheme: scheme,
        host: "",
        path: "",
        query: "",
        fragment: fragment,
    }

    if body.starts_with("//") {
        // The authority runs up to the first '/' or '?'; '#' cannot occur here anymore.
        // Splitting on '/' alone let '?a=b/c' poison the host, which made every host
        // allow-list built on .host attacker-influenced.
        let blen = body.bytes
        let end: uint = 2
        while end < blen {
            let ch = body[end]
            if ch == '/' || ch == '?' : break
            end++
        }
        parse_authority(body.part(2, end - 2), result)
        body = body.part(end, blen - end)
    }

    let body_len = body.bytes
    let q = body.index_of("?") !? body_len
    result.path = body.part(0, q)
    if q < body_len : result.query = body.part(q + 1, body_len - q - 1)

    return result
}

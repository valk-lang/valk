
/// The components of a URL, as split by `url.parse`.
///
/// Every component except `scheme` is kept as written, still percent-encoded; use
/// `url.decode` on the parts that need it.
+ class Url {
    /// The scheme (`http`, `https`, `file`, ...), stored lowercased; empty when absent.
    + scheme: String
    /// The userinfo before the first `:`, as written (still percent-encoded).
    + user: String ("")
    /// The userinfo after the first `:`, as written; empty when there is none.
    + password: String ("")
    /// The host without userinfo and port; an IPv6 literal keeps its brackets.
    + host: String
    /// The port, or `null` when absent or empty; the value is not range-checked.
    + port: ?uint (null)
    /// The path, from the end of the authority up to `?`; empty when absent.
    + path: String
    /// The query string without the leading `?`; empty when absent.
    + query: String
    /// The fragment without the leading `#`; empty when absent.
    + fragment: String

    /// Returns `host` or `host:port`, the form used in a `Host` header.
    + fn host_with_port() String {
        let port = this.port
        if !isset(port) : return this.host
        return this.host + ":" + port
    }

    /// Returns the URL as text: `scheme://user:password@host:port/path?query#fragment`.
    ///
    /// Empty parts are left out, and the parts are written as they are, so they must already
    /// be encoded. A `file` URL keeps its `//` without a host. Marked `$auto`: a `Url`
    /// converts to `String` where one is expected.
    + fn to_string() String $auto {
        let out = ByteBuffer.new()
        if this.scheme.bytes > 0 {
            out.write(this.scheme)
            out.write_byte(':')
        }
        if this.has_authority() {
            out.write("//")
            if this.user.bytes > 0 || this.password.bytes > 0 {
                out.write(this.user)
                if this.password.bytes > 0 {
                    out.write_byte(':')
                    out.write(this.password)
                }
                out.write_byte('@')
            }
            out.write(this.host_with_port())
            // A path after an authority starts with a slash
            if this.path.bytes > 0 && this.path.get(0) != '/' : out.write_byte('/')
        }
        out.write(this.path)
        if this.query.bytes > 0 {
            out.write_byte('?')
            out.write(this.query)
        }
        if this.fragment.bytes > 0 {
            out.write_byte('#')
            out.write(this.fragment)
        }
        return out.into_string()
    }

    fn has_authority() bool {
        return this.host.bytes > 0 || this.user.bytes > 0 || isset(this.port) || this.scheme == "file"
    }

    /// Resolves `reference`, a link found in the page at this URL, into an absolute `Url`.
    ///
    /// Follows RFC 3986 section 5, as browsers do: `../img/a.png`, `/root`, `?page=2`,
    /// `#top` and `//other.host/x` are read against this URL, and a reference with its own
    /// scheme stands on its own. `.` and `..` segments are removed from the result.
    ///
    /// ```valk
    /// url.parse("https://example.com/docs/guide/intro.html").resolve("../img/logo.png")
    /// // https://example.com/docs/img/logo.png
    /// ```
    + fn resolve(reference: String) Url {
        let r = parse(reference)
        // Parts that are present but empty change the result, so read them from the text
        let hash = reference.index_of_byte('#') !? reference.bytes
        let body = reference.range(0, hash)
        let slen = scheme_length(body)
        if slen > 0 : body = body.range(slen + 1, body.bytes - slen - 1)
        let has_query = isset(body.index_of_byte('?') !? null)

        let result = Url {
            scheme: this.scheme
            user: this.user
            password: this.password
            host: this.host
            port: this.port
            path: ""
            query: r.query
            fragment: r.fragment
        }
        if slen > 0 || body.starts_with("//") {
            if slen > 0 : result.scheme = r.scheme
            result.user = r.user
            result.password = r.password
            result.host = r.host
            result.port = r.port
            result.path = remove_dot_segments(r.path)
            return result
        }
        if r.path.bytes == 0 {
            result.path = this.path
            if !has_query : result.query = this.query
            return result
        }
        if r.path.starts_with("/") {
            result.path = remove_dot_segments(r.path)
            return result
        }
        // Merge with the directory of this URL's path
        let merged = ""
        if this.has_authority() && this.path.bytes == 0 {
            merged = "/" + r.path
        } else {
            let slash = this.path.last_index_of("/") !? null
            merged = isset(slash) ? this.path.range(0, slash + 1) + r.path : r.path
        }
        result.path = remove_dot_segments(merged)
        return result
    }
}

/// Removes the `.` and `..` segments from a URL path, as RFC 3986 section 5.2.4 describes.
///
/// `"/a/b/../c/./d"` gives `"/a/c/d"`, and a `..` at the top stays there: `"/../a"` gives
/// `"/a"`. A path that ends in `.` or `..` keeps its final `/`.
+ fn remove_dot_segments(path: String) String {
    let pieces = Array[String]{}
    let len = path.bytes
    let i: uint = 0
    while i < len {
        let rest = path.range(i, len - i)
        if rest.starts_with("../") {
            i += 3
        } else if rest.starts_with("./") {
            i += 2
        } else if rest.starts_with("/./") {
            i += 2
        } else if rest == "/." {
            pieces.append("/")
            i = len
        } else if rest.starts_with("/../") {
            i += 3
            if pieces.length > 0 : pieces.remove(pieces.length - 1)
        } else if rest == "/.." {
            if pieces.length > 0 : pieces.remove(pieces.length - 1)
            pieces.append("/")
            i = len
        } else if rest == "." || rest == ".." {
            i = len
        } else {
            // The next segment, with its leading slash
            let end = path.index_of_byte('/', i + 1) !? len
            pieces.append(path.range(i, end - i))
            i = end
        }
    }
    return pieces.join("")
}

fn scheme_length(str: String) uint {
    // RFC 3986 section 3.1: ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ) ":"
    // Returns the length of the scheme, or 0 when the string does not begin with one.
    let len = str.bytes
    if len == 0 : return 0
    if !str[0].is_alpha() : return 0
    let i: uint = 1
    while i < len {
        let ch = str[i]
        if ch == ':' : return i
        if !ch.is_alpha_numeric() && ch != '+' && ch != '-' && ch != '.' : return 0
        i++
    }
    return 0
}

fn is_digits(str: String) bool {
    each str as ch {
        if !ch.is_number() : return false
    }
    return true
}

// Splits "user:password@host:port" into the matching Url fields.
fn parse_authority(authority: String, result: Url) {
    let hostport = authority
    let at = authority.bytes
    // Userinfo ends at the last '@'; neither part may contain a raw '@'.
    let i = authority.bytes
    while i > 0 {
        if authority[--i] == '@' {
            at = i
            break
        }
    }
    if at < authority.bytes {
        let userinfo = authority.range(0, at)
        hostport = authority.range(at + 1, authority.bytes - at - 1)
        let colon = userinfo.index_of(":") !? userinfo.bytes
        result.user = userinfo.range(0, colon)
        if colon < userinfo.bytes : result.password = userinfo.range(colon + 1, userinfo.bytes - colon - 1)
    }

    // The port follows the last ':' after the host, which for an IPv6 literal is the ':' after ']'.
    let len = hostport.bytes
    let split = len
    if len > 0 && hostport[0] == '[' {
        let close = hostport.index_of("]") !? len
        if close + 1 < len && hostport[close + 1] == ':' : split = close + 1
    } else {
        i = len
        while i > 0 {
            if hostport[--i] == ':' {
                split = i
                break
            }
        }
    }
    result.host = hostport
    if split == len : return
    // A non-numeric port is not a port; the text then stays in the host
    let port = hostport.range(split + 1, len - split - 1)
    if !is_digits(port) : return
    result.host = hostport.range(0, split)
    if port.bytes > 0 : result.port = port.to_uint() !? null
}

/// Splits `str` into a `Url`; it never fails.
///
/// Parsing is lenient and does not validate or decode anything. The fragment is cut off
/// at the first `#` before anything else, then the scheme is read if the string starts
/// with one (RFC 3986 syntax followed by `:`). An authority is only parsed when the rest
/// starts with `//`; it ends at the first `/`, `?` or `\` — a backslash is not an authority
/// byte, and a browser treats it as `/`, so `http://evil.com\@allowed.com/` has the host
/// `evil.com` there as well. Userinfo ends at the last `@` in
/// the authority. A port that is not all digits stays part of `host`.
///
/// ```valk
/// let u = url.parse("https://example.com:8080/a/b?x=1#top")
/// // u.host == "example.com", u.port == 8080, u.path == "/a/b", u.query == "x=1"
/// ```
+ fn parse(str: String) Url {
    let len = str.bytes

    // The fragment is split off before anything else. It is not part of any component,
    // it must never be sent to a server, and leaving it in the string is how it ended
    // up inside .path — and because a '#' also terminates an authority, a URL such as
    // http://evil.com#@good.com/ has to be cut at the '#' first to be read correctly.
    let hash = str.index_of("#") !? len
    let fragment = ""
    if hash < len : fragment = str.range(hash + 1, len - hash - 1)
    let rest = str.range(0, hash)

    let body = rest
    let scheme = ""
    let slen = scheme_length(rest)
    if slen > 0 {
        scheme = rest.range(0, slen).lower()
        body = rest.range(slen + 1, rest.bytes - slen - 1)
    }

    let result = Url {
        scheme: scheme,
        host: "",
        path: "",
        query: "",
        fragment: fragment,
    }

    if body.starts_with("//") {
        // The authority runs up to the first '/', '?' or '\'; '#' cannot occur here
        // anymore. Splitting on '/' alone let '?a=b/c' poison the host, which made every
        // host allow-list built on .host attacker-influenced. A backslash is not a valid
        // authority byte (RFC 3986 reg-name), and a browser reads it as '/', so a host
        // such as "evil.com\@allowed.com" must not be split at that '@' either.
        let blen = body.bytes
        let end: uint = 2
        while end < blen {
            let ch = body[end]
            if ch == '/' || ch == '?' || ch == '\\' : break
            end++
        }
        parse_authority(body.range(2, end - 2), result)
        body = body.range(end, blen - end)
    }

    let body_len = body.bytes
    let q = body.index_of("?") !? body_len
    result.path = body.range(0, q)
    if q < body_len : result.query = body.range(q + 1, body_len - q - 1)

    return result
}

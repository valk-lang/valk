
// The characters url.encode() may leave as literal characters, per URL component.
// `unreserved` escapes everything RFC 3986 does not list as unreserved, so it is the
// only choice that cannot change the meaning of a URL and it is the default. The
// others additionally keep punctuation that is legal inside that one component:
// `path` keeps the sub-delims plus `/`, `:` and `@`; `query` leaves out `&`, `=` and
// `;` because they delimit parameters; `fragment` also keeps `?`, which only starts a
// fragment when it appears before one.
//
// `%` and `+` are escaped in every component: `%` introduces an escape sequence, so
// passing it through makes decode(encode(x)) != x, and decode() reads `+` as a space.
+ enum Component {
    unreserved
    path
    query
    fragment
}

fn component_literals(component: Component) String {
    if component == Component.path : return "!$&'()*,:;=@/"
    if component == Component.query : return "!$'()*,/:@"
    if component == Component.fragment : return "!$&'()*,:;=@/?"
    return ""
}

fn is_literal(ch: u8, literals: String) bool {
    if ch >= 'a' && ch <= 'z' : return true
    if ch >= 'A' && ch <= 'Z' : return true
    if ch >= '0' && ch <= '9' : return true
    if ch == '-' || ch == '.' || ch == '_' || ch == '~' : return true
    let at = literals.index_of_byte(ch) !? literals.length
    return at < literals.length
}

+ fn encode(str: String, component: Component (Component.unreserved)) String {
    let bytes = str.bytes
    let literals = component_literals(component)
    let hex = "0123456789ABCDEF"
    let buffer = ByteBuffer.new(bytes)
    let i: uint = 0
    while i < bytes {
        let ch = str[i++]
        if is_literal(ch, literals) {
            buffer.write_byte(ch)
            continue
        }
        buffer.write_byte('%')
        buffer.write_byte(hex[(ch >> 4).to(uint)])
        buffer.write_byte(hex[(ch & 15).to(uint)])
    }
    return buffer.to_string()
}

+ fn decode(str: String) String {
    let bytes = str.bytes
    let buffer = ByteBuffer.new(bytes)
    let i: uint = 0
    let utf8c: u8 = 0
    while i < bytes {
        let ch = str[i++]
        if ch == '+' {
            buffer.write_byte(' ')
            continue
        }
        if ch == '%' {
            if i + 1 < bytes {
                let n1 = str[i]
                let n2 = str[i + 1]
                if (n1.is_hex() && n2.is_hex()) {
                    i += 2
                    let v1 = n1.hex_byte_to_hex_value()
                    let v2 = n2.hex_byte_to_hex_value()
                    let value: u8 = v1 * 16 + v2
                    if utf8c > 0 {
                        utf8c--
                        buffer.write_byte(value)
                        continue
                    }
                    if value <= 127 {
                        buffer.write_byte(value)
                        continue
                    }
                    // Utf8 character
                    buffer.write_byte(value)
                    let uch = value << 1
                    while uch > 127 {
                        utf8c++
                        uch = uch << 1
                    }
                    continue
                }
            }
        }
        buffer.write_byte(ch)
    }
    return buffer.to_string()
}

use io

/// Parses a query string such as `a=1&b=x%20y` (without the leading `?`) into its parameters.
///
/// Keys and values are decoded with `decode`, so `+` is a space. A part without `=`, like
/// `flag`, has the value `""`, empty parts are skipped, and for a repeated key the last value
/// wins; see `parse_query_grouped`.
+ fn parse_query(query: String) Map[String] {
    let result = Map[String]{}
    each query.split("&") as part {
        if part.bytes == 0 : continue
        let key, value = query_pair(part)
        result.set(decode(key), decode(value))
    }
    return result
}

/// Parses a query string like `parse_query`, keeping every value of a repeated key in order.
+ fn parse_query_grouped(query: String) Map[Array[String]] {
    let result = Map[Array[String]]{}
    each query.split("&") as part {
        if part.bytes == 0 : continue
        let key_text, value = query_pair(part)
        let key = decode(key_text)
        let values = result.get(key) !? <{
            let created = Array[String]{}
            result.set(key, created)
            return created
        }
        values.append(decode(value))
    }
    return result
}

/// Builds a query string such as `a=1&b=x%20y` (without a leading `?`) from `params`.
///
/// Keys and values are encoded with `encode`, in the map's order.
+ fn build_query(params: Map[String]) String {
    let out = ByteBuffer.new()
    build_query_into(params, out) ! return ""
    return out.into_string()
}

/// Writes the encoded query string for `params` to `out` and returns the bytes written.
+ fn build_query_into(params: Map[String], out: io.Writer) uint !io.IoError {
    let written: uint = 0
    each params as value, key {
        if written > 0 {
            io.write_all(out, "&") !>
            written += 1
        }
        written += encode_into(key, out) !>
        io.write_all(out, "=") !>
        written += 1
        written += encode_into(value, out) !>
    }
    return written
}

/// Builds a query string like `build_query`, with one `key=value` part per value of a key.
+ fn build_query_grouped(params: Map[Array[String]]) String {
    let out = ByteBuffer.new()
    build_query_grouped_into(params, out) ! return ""
    return out.into_string()
}

/// Writes the grouped query string for `params` to `out` and returns the bytes written.
+ fn build_query_grouped_into(params: Map[Array[String]], out: io.Writer) uint !io.IoError {
    let written: uint = 0
    each params as values, key {
        let encoded_key = encode(key)
        each values as value {
            if written > 0 {
                io.write_all(out, "&") !>
                written += 1
            }
            io.write_all(out, encoded_key) !>
            io.write_all(out, "=") !>
            written += encoded_key.bytes + 1
            written += encode_into(value, out) !>
        }
    }
    return written
}

fn query_pair(part: String) (String, String) {
    let eq = part.index_of_byte('=') ! return (part, "")
    return (part.range(0, eq), part.range(eq + 1, part.bytes - eq - 1))
}

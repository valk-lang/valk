// Process signals: SIGINT, SIGTERM and friends delivered to cancel tokens,
// callbacks and waiting coroutines. The OS handler only writes the signal
// number to a pipe; a dispatcher thread reads it and does the actual work,
// so nothing runs in signal context

use ext
use core
use sync
use thread
use coro
use gc
use time

/// A process signal that can be handled, waited for or raised.
///
/// `hangup`, `quit`, `user1` and `user2` do not exist on Windows: every function here
/// throws `unsupported` for them there.
+ enum Signal {
    /// Ctrl-C (`SIGINT`).
    interrupt
    /// `SIGTERM`, what `kill`, systemd and Docker send.
    terminate
    /// `SIGHUP`; not on Windows.
    hangup
    /// `SIGQUIT`; not on Windows.
    quit
    /// `SIGUSR1`; not on Windows.
    user1
    /// `SIGUSR2`; not on Windows.
    user2
}

/// Returns the OS signal number of `sig`; throws `unsupported` when the platform lacks it.
+ fn number(sig: Signal) i32 !SignalError {
    if sig == Signal.interrupt : return 2
    if sig == Signal.terminate : return 15
    #if OS == "win"
    throw .unsupported
    #else
    if sig == Signal.hangup : return 1
    if sig == Signal.quit : return 3
    #if OS == "macos"
    if sig == Signal.user1 : return 30
    return 31
    #else
    if sig == Signal.user1 : return 10
    return 12
    #end
    #end
}

class Registration {
    signal: Signal
    installed: bool (false)
    tokens: Array[shared sync.CancelToken] (.{})
    callbacks: Array[shared fn()()] (.{})
    waiters: Array[shared sync.Waker] (.{})
    // Counts deliveries, so a woken `wait` can tell an arrival from `ignore` / `restore`
    arrivals: uint (0)
}

class SignalState {
    entries: Array[Registration] (.{})
    started: bool (false)

    static fn new() SELF {
        let s = SELF {}
        s.entries.append(Registration { signal: Signal.interrupt })
        s.entries.append(Registration { signal: Signal.terminate })
        s.entries.append(Registration { signal: Signal.hangup })
        s.entries.append(Registration { signal: Signal.quit })
        s.entries.append(Registration { signal: Signal.user1 })
        s.entries.append(Registration { signal: Signal.user2 })
        return s
    }

    fn entry(sig: Signal) Registration {
        each this.entries as e {
            if e.signal == sig : return e
        }
        panic("Unknown signal")
    }
}

shared state: core.Lock[SignalState] (.new(SignalState.new()) !!)
// The self-pipe; read by the dispatcher, written by the handler
shared pipe_read: i32 (-1)
shared pipe_write: i32 (-1)

/// Cancels `token` when `sig` arrives; several tokens may watch one signal.
///
/// The first registration for a signal installs its handler, and the first registration
/// of any kind starts the dispatcher thread. Throws `unsupported`, or `init` when the
/// handler, pipe or thread cannot be set up.
+ fn cancel_on(sig: Signal, token: shared sync.CancelToken) !SignalError {
    let number = number(sig) !>
    lock state as s {
        ensure_started(s) !>
        let e = s.entry(sig)
        install(e, number) !>
        e.tokens.append(token)
    }
}

/// Cancels `token` on `SIGINT` or `SIGTERM`, and `SIGHUP` where it exists.
///
/// These are the signals a service receives when it is asked to stop. Throws `init` when
/// the handlers cannot be installed.
+ fn cancel_on_shutdown(token: shared sync.CancelToken) !SignalError {
    cancel_on(Signal.interrupt, token) !>
    cancel_on(Signal.terminate, token) !>
    #if OS != "win"
    cancel_on(Signal.hangup, token) !>
    #end
}

/// Runs `callback` on the dispatcher thread each time `sig` arrives.
///
/// Callbacks run after the signal's tokens are cancelled and its waiters woken, in the order
/// they were registered; a slow callback delays later signals. Throws `unsupported` or
/// `init`.
+ fn on(sig: Signal, callback: shared fn()()) !SignalError {
    let number = number(sig) !>
    lock state as s {
        ensure_started(s) !>
        let e = s.entry(sig)
        install(e, number) !>
        e.callbacks.append(callback)
    }
}

/// Waits until `sig` arrives; returns false when `timeout_ms` (0 = forever) ran out first.
///
/// Parks the current coroutine (or blocks a thread outside one). Also returns false right
/// away when `ignore` or `restore` is called for `sig` meanwhile. Throws `unsupported` or
/// `init`.
+ fn wait(sig: Signal, timeout_ms: uint (0)) bool !SignalError {
    let number = number(sig) !>
    let waker = sync.take_waker() ! throw .init
    let seen: uint = 0
    lock state as s {
        ensure_started(s) !>
        let e = s.entry(sig)
        install(e, number) !>
        seen = e.arrivals
        e.waiters.append(waker)
    }
    let deadline = time.deadline_ms(timeout_ms)
    let arrived = false
    while true {
        let remaining: uint = 0
        if deadline > 0 {
            let now = time.mono_ms()
            remaining = now < deadline ? deadline - now : 1
        }
        let woke = waker.wait(remaining)
        let done = !woke
        lock state as s {
            let e = s.entry(sig)
            arrived = e.arrivals != seen
            // Still registered after a wake without an arrival: the wake was
            // spurious, so keep waiting. A dispatch or `ignore` unregisters us.
            if !e.waiters.contains(waker) || arrived : done = true
            if done : e.waiters.remove_value(waker)
        }
        if done : break
    }
    sync.release_waker(waker)
    return arrived
}

/// Makes the process ignore `sig` and drops the tokens, callbacks and waiters registered for it.
///
/// Pending `wait` calls for `sig` are woken and return false.
+ fn ignore(sig: Signal) !SignalError {
    let number = number(sig) !>
    lock state as s {
        clear(s.entry(sig))
        set_disposition(number, 1)
    }
}

/// Restores the default action of `sig` and drops what was registered for it.
///
/// Pending `wait` calls for `sig` are woken and return false.
+ fn restore(sig: Signal) !SignalError {
    let number = number(sig) !>
    lock state as s {
        clear(s.entry(sig))
        set_disposition(number, 0)
    }
}

/// Sends `sig` to this process through C `raise`; throws `unsupported` when the platform lacks it.
+ fn raise(sig: Signal) !SignalError {
    let number = number(sig) !>
    ext.raise(number)
}

fn clear(e: locked Registration) {
    e.installed = false
    e.tokens.clear()
    e.callbacks.clear()
    // Woken without an arrival, so their `wait` returns false
    each e.waiters as waker : waker.wake()
    e.waiters.clear()
}

fn ensure_started(s: locked SignalState) !SignalError {
    @unsafe
    if s.started : return
    let fds: [i32 x 2] = { -1, -1 }
    #if OS == "win"
    if ext._pipe(@ref(fds), 4096, ext.O_BINARY) != 0 : throw .init
    #else
    if ext.pipe(@ref(fds)) != 0 : throw .init
    #end
    pipe_read = fds[0]
    pipe_write = fds[1]
    thread.start(fn() { dispatch_loop() }) ! throw .init
    s.started = true
}

fn install(e: locked Registration, number: i32) !SignalError {
    @unsafe
    if e.installed : return
    #if OS == "win"
    ext.signal(number, handler.@cast(ptr))
    #else
    let action = ext.sigaction_t { handler: handler.@cast(ptr) }
    #if OS == "macos"
    action.flags = ext.SA_RESTART
    #else
    action.flags = 0x10000000 // SA_RESTART
    #end
    if ext.sigaction(number, @ref(action), null) != 0 : throw .init
    #end
    e.installed = true
}

// 0 = default action, 1 = ignore
fn set_disposition(number: i32, disposition: uint) {
    @unsafe
    #if OS == "win"
    ext.signal(number, disposition.@cast(ptr))
    #else
    let action = ext.sigaction_t { handler: disposition.@cast(ptr) }
    ext.sigaction(number, @ref(action), null)
    #end
}

// Runs in signal context: only the write is allowed here
fn handler(number: i32) {
    @unsafe
    let byte: u8 = number.to(u8)
    #if OS == "win"
    ext._write(pipe_write, @ref(byte), 1)
    // The C runtime resets the disposition before calling the handler
    ext.signal(number, handler.@cast(ptr))
    #else
    ext.write(pipe_write, @ref(byte), 1)
    #end
}

fn dispatch_loop() {
    @unsafe
    let buffer: [u8 x 64] = { 0... }
    while true {
        gc.unlock()
        #if OS == "win"
        let count = ext._read(pipe_read, @ref(buffer), 64)
        #else
        let count = ext.read(pipe_read, @ref(buffer), 64)
        #end
        gc.lock()
        if count <= 0 : continue
        let i: uint = 0
        while i < count.to(uint) {
            dispatch(buffer[i].to(i32))
            i++
        }
    }
}

fn dispatch(arrived: i32) {
    let tokens: ?Array[shared sync.CancelToken] = null
    let callbacks: ?Array[shared fn()()] = null
    lock state as s {
        each s.entries as e {
            let n = number(e.signal) ! continue
            if n != arrived : continue
            tokens = e.tokens.copy()
            callbacks = e.callbacks.copy()
            e.arrivals++
            // Woken under the lock: once `wait` has unregistered a waker and
            // put it back in the cache, no late wake can reach it
            each e.waiters as waker : waker.wake()
            e.waiters.clear()
        }
    }
    if isset(tokens) {
        each tokens as token : token.cancel()
    }
    if isset(callbacks) {
        each callbacks as callback : callback()
    }
}


use ext
use gc
use core

+ class ThreadSuspendGate {
    #if OS == "win"
    crit: ext.CRITICAL_SECTION (@undefined)
    var: ext.CONDITION_VARIABLE (@undefined)
    #else
    mutex: ext.pthread_mutex_t ({})
    cond: ext.pthread_cond_t ({})
    #end
    generation: uint (0)

    + static fn new() SELF $default {
        let sig = SELF{}
        #if OS == "win"
        ext.InitializeCriticalSection(@ref(sig.crit))
        ext.InitializeConditionVariable(@ref(sig.var))
        #else
        if ext.pthread_mutex_init(@ref(sig.mutex), null) != 0 : panic("Failed to initialize thread suspend mutex")
        if ext.pthread_cond_init(@ref(sig.cond)) != 0 : panic("Failed to initialize thread suspend condition")
        #end
        return sig
    }

    + fn wait(should_wait: fn()(bool), timeout_ms: uint (0)) bool @shared_unsafe {
        let is_timeout = false
        let generation = this.generation
        #if OS == "win"
        if timeout_ms == 0 : timeout_ms = ext.INFINITE
        while should_wait() {
            gc.unlock()
            ext.EnterCriticalSection(@ref(this.crit))
            if generation == this.generation {
                let ok = ext.SleepConditionVariableCS(@ref(this.var), @ref(this.crit), timeout_ms.to(u32))
                if ok == 0 && ext.GetLastError() == ext.ERROR_TIMEOUT && timeout_ms != ext.INFINITE {
                    is_timeout = true
                } else if ok == 0 {
                    ext.LeaveCriticalSection(@ref(this.crit))
                    gc.lock()
                    panic("Thread suspend wait failed")
                }
            }
            ext.LeaveCriticalSection(@ref(this.crit))
            gc.lock()
            if is_timeout : break
            generation = this.generation
        }
        #else
        let until : ext.libc_timespec = @undefined
        if timeout_ms > 0 {
            let now : ext.libc_timeval = @undefined
            if ext.gettimeofday(@ref(now), null) != 0 : panic("Failed to read system time")
            let ns = now.tv_usec * 1000 + (timeout_ms % 1000) * 1_000_000
            let extra_s = (ns >= 1_000_000_000).to(int)
            until.tv_sec = now.tv_sec + (timeout_ms / 1000) + extra_s
            until.tv_nsec = ns - extra_s * 1_000_000_000
        }
        //
        while should_wait() {
            gc.unlock()
            if ext.pthread_mutex_lock(@ref(this.mutex)) != 0 {
                gc.lock()
                panic("Failed to lock thread suspend mutex")
            }
            let wait_error = 0
            if generation == this.generation {
                if timeout_ms == 0 {
                    wait_error = ext.pthread_cond_wait(@ref(this.cond), @ref(this.mutex))
                } else {
                    wait_error = ext.pthread_cond_timedwait(@ref(this.cond), @ref(this.mutex), @ref(until))
                    if wait_error == ext.ETIMEDOUT {
                        is_timeout = true
                        wait_error = 0
                    }
                }
            }
            let unlock_error = ext.pthread_mutex_unlock(@ref(this.mutex))
            gc.lock()
            if wait_error != 0 : panic("Thread suspend wait failed")
            if unlock_error != 0 : panic("Failed to unlock thread suspend mutex")
            if is_timeout : break
            generation = this.generation
        }
        #end
        return is_timeout
    }

    + fn signal() @shared_unsafe {
        #if OS == "win"
        ext.EnterCriticalSection(@ref(this.crit))
        this.generation++
        ext.WakeConditionVariable(@ref(this.var))
        ext.LeaveCriticalSection(@ref(this.crit))
        #else
        if ext.pthread_mutex_lock(@ref(this.mutex)) != 0 : panic("Failed to lock thread suspend mutex")
        this.generation++
        let signal_error = ext.pthread_cond_signal(@ref(this.cond))
        let unlock_error = ext.pthread_mutex_unlock(@ref(this.mutex))
        if signal_error != 0 : panic("Failed to signal suspended thread")
        if unlock_error != 0 : panic("Failed to unlock thread suspend mutex")
        #end
    }

    fn gc_free() @shared_unsafe {
        #if OS == "win"
        ext.DeleteCriticalSection(@ref(this.crit))
        #else
        if ext.pthread_mutex_destroy(@ref(this.mutex)) != 0 {
            core.cleanup_warning("Failed to destroy thread suspend mutex", __FILE__, __LINE__)
        }
        if ext.pthread_cond_destroy(@ref(this.cond)) != 0 {
            core.cleanup_warning("Failed to destroy thread suspend condition", __FILE__, __LINE__)
        }
        #end
    }
}


use core

class ThreadCompletionQueue {
    mutex: shared core.SyncMutex (.new())
    gate: shared ThreadSuspendGate (.new())
    completed: Array[uint] (.new())

    fn push(index: uint) @shared_unsafe {
        this.mutex.lock()
        this.completed.append(index)
        this.mutex.unlock()
        this.gate.signal()
    }

    fn pop() ?uint @shared_unsafe {
        this.mutex.lock()
        let index: ?uint = this.completed.pop_first() !? null
        this.mutex.unlock()
        return index
    }

    fn is_empty() bool @shared_unsafe {
        this.mutex.lock()
        let empty = this.completed.length == 0
        this.mutex.unlock()
        return empty
    }

    fn await_next() uint @shared_unsafe {
        while true {
            let index = this.pop()
            if isset(index) : return index
            this.gate.wait(fn() bool { return this.is_empty() })
        }
    }
}

+ class ThreadGroup[T] {
    - state: shared ThreadCompletionQueue (.{})
    - workers: Array[Thread[T]] (.new())
    - pending: uint (0)

    + static fn new() SELF $default {
        return SELF {}
    }

    + fn start(handler: shared fn()(T)) uint !InitError {
        let index = this.workers.length
        let state = this.state
        #if T.$is_void
        let worker = Thread[void].start(fn() {
            await co handler()
            state.push(index)
        }) !>
        #else
        let worker = Thread[T].start(fn() T {
            let result = await co handler()
            state.push(index)
            return result
        }) !>
        #end
        this.workers.append(worker)
        this.pending++
        return index
    }

    + fn has_pending() bool {
        return this.pending > 0
    }

    #if T.$is_void
    + fn await_next() uint {
        let index = this.state.await_next()
        let worker = this.workers.get(index) ! { panic("ThreadGroup received an invalid completion index") }
        worker.await()
        this.pending--
        return index
    }
    #else
    + fn await_next() (uint, T) {
        let index = this.state.await_next()
        let worker = this.workers.get(index) ! { panic("ThreadGroup received an invalid completion index") }
        let result = worker.await()
        this.pending--
        return (index, result)
    }
    #end
}


use core

class ThreadCompletions {
    completed: Array[uint] (.{})
}

class ThreadCompletionQueue {
    gate: shared ThreadSuspendGate (.new())
    state: shared Lock[ThreadCompletions] (.new(.{}) !!)

    fn push(index: uint) {
        lock this.state as s : s.completed.append(index)
        this.gate.signal()
    }

    fn pop() ?uint {
        lock this.state as s : return s.completed.pop_first() !? null
    }

    fn is_empty() bool {
        lock this.state as s : return s.completed.length == 0
    }

    fn await_next() uint {
        while true {
            let index = this.pop()
            if isset(index) : return index
            this.gate.wait(fn() bool { return this.is_empty() })
        }
    }
}

/// Runs handlers on threads of their own and collects their results in completion order.
///
/// ```valk
/// let group = thread.ThreadGroup[int].new()
/// group.start(fn() int { return 1 }) !!
/// group.start(fn() int { return 2 }) !!
/// while group.has_pending() {
///     let index, result = group.await_next() !!
///     println(index.to_string() + ": " + result)
/// }
/// ```
+ class ThreadGroup[T] {
    - state: shared ThreadCompletionQueue (.{})
    - workers: Array[Thread[T]] (.new())
    - pending: uint (0)

    /// Returns an empty group. Tagged `$default`, so it also supplies the group's default value.
    + static fn new() SELF $default {
        return SELF {}
    }

    /// Starts a new thread that runs `handler` and returns the index of this start (0, 1, ...).
    ///
    /// Throws `init` when the thread cannot be started.
    + fn start(handler: shared fn()(T)) uint !InitError {
        let index = this.workers.length
        let state = this.state
        #if T.$is_void
        let worker = Thread[void].start(fn() {
            await co handler()
            state.push(index)
        }) !>
        #else
        let worker = Thread[T].start(fn() T {
            let result = await co handler()
            state.push(index)
            return result
        }) !>
        #end
        this.workers.append(worker)
        this.pending++
        return index
    }

    /// Returns true while some started handler was not yet returned by `await_next`.
    + fn has_pending() bool {
        return this.pending > 0
    }

    #if T.$is_void
    /// Blocks until the next handler finishes and returns its start index.
    ///
    /// Handlers are returned in the order they finish. Blocks the whole OS thread, and forever
    /// when nothing is pending: check `has_pending` first.
    + fn await_next() uint {
        let index = this.state.await_next()
        let worker = this.workers.get(index) ! { panic("ThreadGroup received an invalid completion index") }
        worker.await()
        this.pending--
        return index
    }
    #else
    /// Blocks until the next handler finishes and returns its start index and result.
    ///
    /// Handlers are returned in the order they finish. Blocks the whole OS thread, and forever
    /// when nothing is pending: check `has_pending` first.
    + fn await_next() (uint, T) {
        let index = this.state.await_next()
        let worker = this.workers.get(index) ! { panic("ThreadGroup received an invalid completion index") }
        let result = worker.await()
        this.pending--
        return (index, result)
    }
    #end
}

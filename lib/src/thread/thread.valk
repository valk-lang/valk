@unsafe
@ignore_access

use ext
use gc
use core
use coro
use mem
use io

interface ThreadRef {}

global current_thread: ?ThreadRef (null)
shared threads: Lock[Array[atomic ThreadRef]] (.new(.{}) !!)

/// Starts an OS thread that runs `func`; the same as `Thread[void].start`.
///
/// Throws `init` when the thread cannot be created.
+ fn start(func: atomic fn()()) Thread[void] !InitError {
    return Thread[void].start(func) !>
}

/// An OS thread running one handler that returns a `T`.
///
/// The thread has its own GC heap, scheduler and copy of every non-`shared` global, reset
/// to its declared default; only `atomic` data and `shared` globals cross threads. The OS
/// thread is detached; `await` waits for the handler's result.
+ class Thread[T] is ThreadRef {
    #if OS == "win"
    - thread: ext.HANDLE (0)
    #end
    - handler: atomic fn()(T)
    - mutex_done: atomic core.Mutex
    #if !T.$is_void
    - result: ?T (null)
    #end

    /// Starts an OS thread that runs `func` inside a coroutine, and returns its handle.
    ///
    /// `func` must be an `atomic` closure: what it captures is reachable from two threads.
    /// Throws `init` when the thread cannot be created.
    + static fn start(func: atomic fn()(T)) SELF !InitError {
        #if T.$has_borrows
        #error "A thread's result cannot hold a borrow: the storage may belong to the thread that ends; return an owned value"
        #end
        @unsafe
        let handler_data = @property_get(@ptrv(&func, ?gc.GcItem, 1))
        gc.share_null_check(handler_data)

        let t = SELF {
            handler: func
            mutex_done: .new() ! throw .init
        }

        t.mutex_done.lock()
        // Registering publishes the thread object and its handler for the
        // new thread. Every field is shared-safe, so the cast is sound.
        lock threads as list : list.append(t.@cast(atomic SELF))

        let entry = thread_entry[T].@cast(fnptr(SELF)(?ptr))
        #if OS == "win"
        t.thread = ext.CreateThread(null, 0, entry.@cast(ptr), t.@cast(ptr), 0, null)
        if t.thread == 0 {
            t.start_failed()
            throw .init
        }
        #else
        let thr: ext.pthread_t = .{}
        let err = ext.pthread_create(@ref(thr), null, entry.@cast(ptr), t.@cast(ptr))
        if err != 0 {
            t.start_failed()
            throw .init
        }
        if ext.pthread_detach(thr.data) != 0 : panic("Failed to detach thread")
        #end

        return t
    }

    fn start_failed() {
        lock threads as list : list.remove_value(this.@cast(atomic SELF))
        this.mutex_done.unlock()
    }

    static fn entry(thread: SELF, stack_top: ?ptr (null)) $entrance {
        // Init
        #if GROVE_MT
        gc.thread_init(false, stack_top)
        #else
        gc.thread_init()
        #end

        @allocas

        // Store globals & Set default value (local only)
        ir_comment("INIT GLOBALS")
        #loop globals G T
        #if !G.$is_shared_global
        #if G.$has_explicit_default_value
        G = G.$default_value
        #end
        #loop gc_roots G ROOT_OFFSET
        gc.gc.globals.add_ptr(@ref(G).$offset(ROOT_OFFSET))
        #end
        #loop gc_conditional_roots G ROOT_OFFSET TAG_OFFSET TAG MORE
        gc.gc.add_conditional_global(@ref(G).$offset(ROOT_OFFSET), @ref(G).$offset(TAG_OFFSET), TAG, MORE)
        #end
        #end
        #end
        ir_comment("END GLOBALS")

        current_thread = thread
        gc.gc.state = gc.GcState.idle

        // Run
        #if T.$is_void
        await co thread.handler()
        #else
        // Grove-MT (S3): the store into the shared Thread publishes the result
        thread.result = await co thread.handler()
        #end
        coro.Coro.drain_locks()

        #if GROVE_MT
        // RT9's order: no kernel operation and no park of the thread is left, the thread
        // leaves the registry and wakes its awaiters while the GC still knows it
        io.uring_drain()
        coro.parks_leave()
        coro.home_close()
        lock threads as list : list.remove_value(thread.@cast(atomic SELF))
        thread.handler = fn() T { panic("A thread's handler ran after the thread ended") }
        thread.mutex_done.unlock()
        gc.thread_stop()
        return
        #end

        // Stop
        lock threads as list : list.remove_value(thread.@cast(atomic SELF))
        coro.home_close()
        #if OS == "win"
        io.iocp_close()
        #elif OS == "macos"
        io.kqueue_close()
        #end

        // Remove the gc and transfer its shared items before waking waiters.
        // thread_stop keeps shared_lock held, which protects `thread` while
        // its shutting-down gc no longer contributes stack or global roots.
        gc.thread_stop()
        thread.mutex_done.unlock()
        gc.thread_free()
    }

    #if T.$is_void
    /// Waits until the handler has returned.
    ///
    /// Parks the current coroutine, or blocks the thread outside one. May be called more than
    /// once.
    + fn await() {
        this.mutex_done.await_unlock()
    }
    #else
    /// Waits until the handler has returned and returns its result.
    ///
    /// Parks the current coroutine, or blocks the thread outside one. May be called more than
    /// once.
    + fn await() T {
        this.mutex_done.await_unlock()
        #if GROVE_MT && T.$has_gc_refs && !T.$is_shared
        // S3: a plain result is thawed: each await gets its own copy in its own heap
        let shared_result = this.result
        #if T.$is_nullable
        return clone shared_result
        #else
        let found = shared_result ?! panic("Thread finished without a result")
        return clone found
        #end
        #end
        #if T.$is_nullable
        return this.result
        #else
        let result = this.result
        if !isset(result) : panic("Thread finished without a result")
        return result
        #end
    }
    #end

    fn gc_free() {
        #if OS == "win"
        let thr = this.thread
        if thr != 0 && ext.CloseHandle(thr) == 0 {
            core.cleanup_warning("Failed to close thread handle", __FILE__, __LINE__)
        }
        #end
    }
}

// Returns null: glibc keeps the start routine's result in the thread descriptor at the top of
// the stack the GC scans, and a void entry left a stale pointer there for the next thread
fn thread_entry[T](thread: Thread[T]) ?ptr $entrance {
    #if GROVE_MT
    // The top of the frames the collector scans: glibc keeps the thread's TLS (Grove's pools)
    // at the top of the stack block, above this frame
    let top: uint = 0
    Thread[T].entry(thread, @ref(top).@cast(ptr))
    #else
    Thread[T].entry(thread)
    #end
    return null
}

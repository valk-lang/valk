
@ignore_access

use ext
use gc
use core
use coro
use mem
use io

interface ThreadRef {}

global current_thread: ?ThreadRef (null)
shared threads: Array[ThreadRef] (.new())

+ fn start(func: shared fn()()) Thread[void] !InitError {
    return Thread[void].start(func) !>
}

+ class Thread[T] is ThreadRef {
    #if OS == "win"
    - thread: ext:HANDLE (0)
    #else
    - thread: ?ptr
    #end
    - handler: shared fn()(T)
    - mutex_done: shared core:Mutex
    #if !T.$is_void
    - result: ?T (null)
    #end

    + static fn start(func: shared fn()(T)) SELF !InitError {

        let handler_data = @ptrv(&func, ?gc:GcItem, 1)
        gc:share_null_check(handler_data)

        let t = SELF {
            handler: func
            mutex_done: .new() ! throw .init
        }

        t.mutex_done.lock()
        threads.lock()
        threads.append(t)
        threads.unlock()

        let entry = thread_entry[T].@cast(fnptr(SELF)())
        #if OS == "win"
        t.thread = ext:CreateThread(null, 0, entry.@cast(ptr), t.@cast(ptr), 0, null)
        if t.thread == 0 {
            t.start_failed()
            throw .init
        }
        #else
        let thr: *ext:pthread_t = .{}
        t.thread = thr
        let err = ext:pthread_create(thr, null, entry.@cast(ptr), t.@cast(ptr))
        if err != 0 {
            t.start_failed()
            throw .init
        }
        #end

        return t
    }

    fn start_failed() {
        threads.lock()
        threads.remove_value(this)
        threads.unlock()
        this.mutex_done.unlock()
        #if OS != "win"
        let thr = this.thread
        if isset(thr) : mem:free(thr)
        this.thread = null
        #end
    }

    static fn entry(thread: SELF) $entrance {

        // Init
        coro:gc_stack_sp = null
        gc:thread_init()

        @allocas

        // Store globals & Set default value (local only)
        ir_comment("INIT GLOBALS")
        #loop globals G T
        #if !G.$is_shared_global
        #if G.$has_explicit_default_value
        G = G.$default_value
        #end
        #loop gc_roots G ROOT_OFFSET
        gc:gc.globals.add_ptr(@ref(G).$offset(ROOT_OFFSET))
        #end
        #loop gc_conditional_roots G ROOT_OFFSET TAG_OFFSET TAG
        gc:gc.add_conditional_global(@ref(G).$offset(ROOT_OFFSET), @ref(G).$offset(TAG_OFFSET), TAG)
        #end
        #end
        #end
        ir_comment("END GLOBALS")

        current_thread = thread
        gc:gc.disable = false

        // Run
        #if T.$is_void
        await co thread.handler()
        #else
        thread.result = await co thread.handler()
        #end

        // Stop
        threads.lock()
        threads.remove_value(thread)
        threads.unlock()
        #if OS == "win"
        io:iocp_close()
        #end
        // Release the waiters last: after this point only the gc teardown is
        // left, and that is synchronized with collect_shared(). Otherwise
        // wait() could return while this thread still holds shared memory
        // that no other thread is able to collect yet.
        thread.mutex_done.unlock()
        gc:thread_stop()
    }

    + fn wait() {
        this.mutex_done.await_unlock()
    }

    #if !T.$is_void
    + fn await_result() T {
        this.wait()
        #if T.$is_nullable
        return this.result
        #else
        let result = this.result
        if !isset(result) : panic("Thread finished without a result")
        return result
        #end
    }
    #end

    fn gc_free() {
        let thr = this.thread
        #if OS == "win"
        if thr != 0 : ext:CloseHandle(thr)
        #else
        if isset(thr) : mem:free(thr)
        #end
    }
}

fn thread_entry[T](thread: Thread[T]) $entrance {
    Thread[T].entry(thread)
}

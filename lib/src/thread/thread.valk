
@ignore_access

use ext
use gc
use core
use coro
use mem

interface ThreadRef {}

global current_thread: ?ThreadRef (null)
shared threads: Array[ThreadRef] (.new())

+ fn start(func: shared fn()()) Thread[void] !InitError {
    return Thread[void].start(func) !>
}

+ class Thread[T] is ThreadRef {
    #if OS == "win"
    - thread: ext:HANDLE (0)
    #else
    - thread: ?ptr
    #end
    - handler: shared fn()(T)
    - mutex_done: shared core:Mutex
    #if !T.$is_void
    ~ result: T
    #end

    + static fn start(func: shared fn()(T)) SELF !InitError {
        let t = SELF {
            handler: func
            mutex_done: .new() ! throw .init
        }
        t.mutex_done.lock()
        threads.lock()
        threads.append(t)
        threads.unlock()
        t.init() !>
        return t
    }

    fn init() !InitError $undefined {
        #if OS == "win"
        this.thread = ext:CreateThread(null, 0, this.entry, this, 0, null)
        if this.thread == 0 : throw .init
        #else
        let thr = ext:pthread_t{}
        let err = ext:pthread_create(thr, null, this.entry, this)
        if err != 0 : throw .init
        this.thread = thr
        #end
    }

    fn entry() $entrance {

        // Init
        coro:gc_stack_sp = null
        gc:thread_init()

        @allocas

        // Store globals & Set default value (local only)
        ir_comment("INIT GLOBALS")
        #loop globals G T
        #if !G.$is_shared_global
        #if G.$has_explicit_default_value
        G = G.$default_value
        #end
        #loop gc_roots G ROOT_OFFSET
        gc:gc.globals.add_ptr(@ref(G).$offset(ROOT_OFFSET))
        #end
        #end
        #end
        ir_comment("END GLOBALS")

        current_thread = this
        gc:gc.disable = false

        // Run
        #if T.$is_void
        await co this.handler()
        #else
        this.result = await co this.handler()
        #end

        // Stop
        this.mutex_done.unlock()
        // Keep the Thread rooted until its handler has stopped using it.
        // This is especially important for anonymous task-runner threads,
        // whose caller does not retain the value returned by start().
        threads.lock()
        threads.remove_value(this)
        threads.unlock()
        gc:thread_stop()
    }

    + fn wait() {
        this.mutex_done.await_unlock()
    }

    fn gc_free() {
        let thr = this.thread
        #if OS == "win"
        ext:CloseHandle(thr)
        #else
        if isset(thr) : mem:free(thr)
        #end
    }
}

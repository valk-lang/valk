
use ext

value MAX_FINITE_SLEEP_MS (0xfffffffe)

+ fn suspend_ns(ns: uint) {
    #if OS == "win"
    let ms = ns / 1_000_000
    if ns % 1_000_000 > 0 : ms++
    suspend_ms(ms)
    #else
    let ts: ext.libc_timespec = @undefined
    let rem: ext.libc_timespec = @undefined
    ts.tv_sec = (ns / 1_000_000_000).to(int)
    ts.tv_nsec = (ns % 1_000_000_000).to(int)
    while ext.nanosleep(@ref(ts), @ref(rem)) != 0 {
        if ext.get_errno() != ext.EINTR : panic("Thread sleep failed")
        ts = rem
    }
    #end
}

+ fn suspend_ms(ms: uint) {
    #if OS == "win"
    while ms > MAX_FINITE_SLEEP_MS {
        ext.Sleep(MAX_FINITE_SLEEP_MS.to(u32))
        ms -= MAX_FINITE_SLEEP_MS
    }
    ext.Sleep(ms.to(u32))
    #else
    let ts: ext.libc_timespec = @undefined
    let rem: ext.libc_timespec = @undefined
    ts.tv_sec = (ms / 1000).to(int)
    ts.tv_nsec = ((ms % 1000) * 1_000_000).to(int)
    while ext.nanosleep(@ref(ts), @ref(rem)) != 0 {
        if ext.get_errno() != ext.EINTR : panic("Thread sleep failed")
        ts = rem
    }
    #end
}

use ext
use gc

value MAX_FINITE_SLEEP_MS (0xfffffffe)

/// Blocks the whole OS thread, with every coroutine on it, for `ns` nanoseconds.
///
/// Sleeps again for the rest after a signal interrupts it. Windows rounds up to whole
/// milliseconds. Panics when the system sleep fails. The thread releases its GC lock while
/// it sleeps, so other threads can collect for it.
+ fn suspend_ns(ns: uint) {
    #if OS == "win"
    let ms = ns / 1_000_000
    if ns % 1_000_000 > 0 : ms++
    suspend_ms(ms)
    #else
    let ts: ext.libc_timespec = @undefined
    let rem: ext.libc_timespec = @undefined
    ts.tv_sec = (ns / 1_000_000_000).to(int)
    ts.tv_nsec = (ns % 1_000_000_000).to(int)
    let failed = false
    gc.unlock()
    while ext.nanosleep(@ref(ts), @ref(rem)) != 0 {
        if ext.get_errno() != ext.EINTR {
            failed = true
            break
        }
        ts = rem
    }
    gc.lock()
    if failed : panic("Thread sleep failed")
    #end
}

/// Blocks the whole OS thread, with every coroutine on it, for `ms` milliseconds.
///
/// Sleeps again for the rest after a signal interrupts it. Panics when the system sleep
/// fails. The thread releases its GC lock while it sleeps, so other threads can collect
/// for it.
+ fn suspend_ms(ms: uint) {
    #if OS == "win"
    gc.unlock()
    while ms > MAX_FINITE_SLEEP_MS {
        ext.Sleep(MAX_FINITE_SLEEP_MS.to(u32))
        ms -= MAX_FINITE_SLEEP_MS
    }
    ext.Sleep(ms.to(u32))
    gc.lock()
    #else
    let ts: ext.libc_timespec = @undefined
    let rem: ext.libc_timespec = @undefined
    ts.tv_sec = (ms / 1000).to(int)
    ts.tv_nsec = ((ms % 1000) * 1_000_000).to(int)
    let failed = false
    gc.unlock()
    while ext.nanosleep(@ref(ts), @ref(rem)) != 0 {
        if ext.get_errno() != ext.EINTR {
            failed = true
            break
        }
        ts = rem
    }
    gc.lock()
    if failed : panic("Thread sleep failed")
    #end
}


use time
use core

shared task_gate: ThreadSuspendGate (.new())
shared tasks: Array[Task] (.{})
shared threads_waiting: uint (0)
shared taskrunners: uint (0)

value TASKRUNNER_LIMIT (8)

+ fn task(handler: fn()()) Task !InitError {
    let task = Task {
        handler: handler
        mutex: .new() ! throw .init
    }
    tasks.lock()
    tasks.append(task)
    tasks.unlock()
    start_taskrunner() ! throw .init
    return task
}

+ class Task {
    - handler: fn()()
    - mutex: shared core.Mutex
    ~ started: bool (false)
    ~ done: bool (false)

    + fn await() {
        if this.done : return
        while !this.started : time.sleep_ns(10)
        this.mutex.await_unlock()
    }
}

fn start_taskrunner() !InitError {
    tasks.lock()
    let should_start = threads_waiting == 0 && taskrunners < TASKRUNNER_LIMIT
    if should_start : taskrunners++
    tasks.unlock()

    if should_start {
        start(fn() {
            while true {
                tasks.lock()
                let task = tasks.pop_last() !? null
                if !isset(task) : threads_waiting++
                tasks.unlock()
                if !isset(task) {
                    let timed_out = task_gate.wait(fn() bool { return tasks.length == 0 }, 5000)
                    tasks.lock()
                    threads_waiting--
                    task = tasks.pop_last() !? null
                    if !isset(task) {
                        if timed_out {
                            taskrunners--
                            tasks.unlock()
                            break
                        }
                        tasks.unlock()
                        continue
                    }
                    tasks.unlock()
                }
                task.mutex.lock()
                task.started = true
                task.handler()
                task.done = true
                task.mutex.unlock()
            }
        }) ! {
            tasks.lock()
            taskrunners--
            tasks.unlock()
            throw .init
        }
    }
    task_gate.signal()
}

#if TEST
+ fn taskrunner_counts_for_test() (uint, uint) {
    tasks.lock()
    let active = taskrunners
    tasks.unlock()
    return (active, TASKRUNNER_LIMIT)
}
#end

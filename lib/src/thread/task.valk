@unsafe

use core
use gc

class TaskState {
    tasks: Deque[shared Task] (.{})
    threads_waiting: uint (0)
    taskrunners: uint (0)
    #if TEST
    fail_taskrunner_start: bool (false)
    #end
}

shared task_gate: ThreadSuspendGate (.new())
shared task_state: Lock[TaskState] (.new(.{}) !!)

value TASKRUNNER_LIMIT (8)

/// Runs `handler` on a pool of up to 8 reused task threads; await the returned `Task` for it.
///
/// A new runner thread is started when none is idle and fewer than 8 exist; otherwise the
/// task is queued. Queued tasks are started in the order they were queued. Idle runners
/// exit after 5 seconds. Throws `init` when a needed runner thread cannot be started.
+ fn task(handler: shared fn()()) Task !InitError {
    let mutex: shared core.Mutex = .new() ! throw .init
    mutex.lock()
    let task = Task {
        handler: handler
        mutex: mutex
    }
    let failed = false
    lock task_state as st {
        // Every field is shared-safe, so the cast is sound
        st.tasks.push_back(task.@cast(shared Task))
        // Queued before the runner exists, so a runner that fails to start
        // takes its task back out before anyone can consume it.
        start_taskrunner(st) ! {
            st.tasks.pop_back() _
            failed = true
        }
    }
    if failed {
        mutex.unlock()
        throw .init
    }
    task_gate.signal()
    return task
}

/// A handler queued with `task`.
+ class Task {
    - handler: shared fn()()
    - mutex: shared core.Mutex
    /// Waits until the task's handler has returned; returns at once when it already has.
    ///
    /// Parks the current coroutine, or blocks the thread outside one.
    + fn await() {
        this.mutex.await_unlock()
    }
}

fn start_taskrunner(st: locked TaskState) !InitError {
    let should_start = st.threads_waiting == 0 && st.taskrunners < TASKRUNNER_LIMIT
    if should_start : st.taskrunners++
    #if TEST
    let fail_start = should_start && st.fail_taskrunner_start
    if fail_start : st.fail_taskrunner_start = false
    #end

    if should_start {
        #if TEST
        if fail_start {
            st.taskrunners--
            throw .init
        }
        #end
        start(fn() {
            taskrunner_loop()
        }) ! {
            st.taskrunners--
            throw .init
        }
    }
}

fn taskrunner_loop() {
    while taskrunner_run_next() == 1 {}
}

// The task only ever lives in this frame, which is gone when the runner waits
// for the next one: a register or spill of an idle runner must not keep the
// last task alive for the native stack scan. The result is a full register on
// purpose: the wait pushes it for alignment, and a bool left the upper bytes
// of a stale pointer in it.
fn taskrunner_run_next() uint $noinline {
    let task = taskrunner_next()
    if !isset(task) : return 0
    task.handler()
    task.mutex.unlock()
    return 1
}

// The next queued task, waiting for one when the queue is empty. Null when
// nothing arrived within the timeout, which retires this runner.
fn taskrunner_next() ?shared Task {
    let task: ?shared Task = null
    lock task_state as st {
        task = st.tasks.pop_front() !? null
        if !isset(task) : st.threads_waiting++
    }
    if isset(task) : return task

    while true {
        gc.clear_stack()
        let ready = task_gate.wait(fn() bool {
            lock task_state as st : return st.tasks.length == 0
        }, 5000)
        let retire = false
        lock task_state as st {
            task = st.tasks.pop_front() !? null
            if isset(task) {
                st.threads_waiting--
            } else if !ready {
                st.threads_waiting--
                st.taskrunners--
                retire = true
            }
        }
        if isset(task) || retire : return task
    }
}

#if TEST
/// Test hook: returns the number of running task threads and the limit.
+ fn taskrunner_counts_for_test() (uint, uint) {
    lock task_state as st : return (st.taskrunners, TASKRUNNER_LIMIT)
}

/// Test hook: makes the next task-thread start fail.
+ fn fail_next_taskrunner_start_for_test() {
    lock task_state as st : st.fail_taskrunner_start = true
}

/// Test hook: returns the number of idle task threads and of queued tasks.
+ fn taskrunner_queue_state_for_test() (uint, uint) {
    lock task_state as st : return (st.threads_waiting, st.tasks.length)
}
#end

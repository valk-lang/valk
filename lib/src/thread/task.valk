
use core

shared task_gate: ThreadSuspendGate (.new())
shared tasks: Array[Task] (.{})
shared threads_waiting: uint (0)
shared taskrunners: uint (0)
#if TEST
shared fail_taskrunner_start: bool (false)
#end

value TASKRUNNER_LIMIT (8)

+ fn task(handler: fn()()) Task !InitError {
    let mutex: shared core.Mutex = .new() ! throw .init
    mutex.lock()
    let task = Task {
        handler: handler
        mutex: mutex
    }
    tasks.lock()
    tasks.append(task)
    start_taskrunner() ! {
        tasks.pop_last() _
        tasks.unlock()
        mutex.unlock()
        throw .init
    }
    tasks.unlock()
    task_gate.signal()
    return task
}

+ class Task {
    - handler: fn()()
    - mutex: shared core.Mutex
    + fn await() {
        this.mutex.await_unlock()
    }
}

// Called with tasks locked so a new runner cannot consume the published task
// before its thread has either started or been rolled back.
fn start_taskrunner() !InitError {
    let should_start = threads_waiting == 0 && taskrunners < TASKRUNNER_LIMIT
    if should_start : taskrunners++
    #if TEST
    let fail_start = should_start && fail_taskrunner_start
    if fail_start : fail_taskrunner_start = false
    #end

    if should_start {
        #if TEST
        if fail_start {
            taskrunners--
            throw .init
        }
        #end
        start(fn() {
            while true {
                tasks.lock()
                let task = tasks.pop_last() !? null
                if !isset(task) : threads_waiting++
                tasks.unlock()
                if !isset(task) {
                    let timed_out = task_gate.wait(fn() bool { return tasks.length == 0 }, 5000)
                    tasks.lock()
                    threads_waiting--
                    task = tasks.pop_last() !? null
                    if !isset(task) {
                        if timed_out {
                            taskrunners--
                            tasks.unlock()
                            break
                        }
                        tasks.unlock()
                        continue
                    }
                    tasks.unlock()
                }
                task.handler()
                task.mutex.unlock()
            }
        }) ! {
            taskrunners--
            throw .init
        }
    }
}

#if TEST
+ fn taskrunner_counts_for_test() (uint, uint) {
    tasks.lock()
    let active = taskrunners
    tasks.unlock()
    return (active, TASKRUNNER_LIMIT)
}

+ fn fail_next_taskrunner_start_for_test() {
    tasks.lock()
    fail_taskrunner_start = true
    tasks.unlock()
}

+ fn taskrunner_queue_state_for_test() (uint, uint) {
    tasks.lock()
    let waiting = threads_waiting
    let queued = tasks.length
    tasks.unlock()
    return (waiting, queued)
}
#end

use ext

/// Returns the wall-clock time in nanoseconds since the Unix epoch (UTC).
///
/// Follows system clock changes, so it can jump backwards; use `mono_ns` to measure
/// durations. On Windows the resolution is 100 ns.
+ fn unix_ns() uint {
    #if OS == "win"
    let ft: ext.libc_FILETIME = @undefined
    ext.GetSystemTimeAsFileTime(@ref(ft))
    let ticks = (ft.dwHighDateTime.to(uint) << 32) | ft.dwLowDateTime.to(uint)
    return (ticks - 116444736000000000) * 100
    #else
    return clock_ns(ext.CLOCK_REALTIME)
    #end
}

/// Returns the wall-clock time in microseconds since the Unix epoch (UTC).
+ fn unix_us() uint {
    return unix_ns() / 1000
}

/// Returns the wall-clock time in milliseconds since the Unix epoch (UTC).
+ fn unix_ms() uint {
    return unix_ns() / 1_000_000
}

/// Returns a monotonic clock reading in nanoseconds, for measuring durations.
///
/// The starting point is unspecified; only differences between readings are meaningful.
+ fn mono_ns() uint {
    #if OS == "win"
    let counter: i64 = 0
    let frequency: i64 = 0
    if ext.QueryPerformanceCounter(@ref(counter)) == 0 : panic("Failed to read monotonic time")
    if ext.QueryPerformanceFrequency(@ref(frequency)) == 0 : panic("Failed to read monotonic frequency")
    let value = counter.to(uint)
    let scale = 1_000_000_000
    return value / frequency.to(uint) * scale + value % frequency.to(uint) * scale / frequency.to(uint)
    #else
    return clock_ns(ext.CLOCK_MONOTONIC)
    #end
}

/// Returns a monotonic clock reading in microseconds, for measuring durations.
+ fn mono_us() uint {
    return mono_ns() / 1000
}

/// Returns a monotonic clock reading in milliseconds, for measuring durations.
+ fn mono_ms() uint {
    return mono_ns() / 1_000_000
}

/// Returns the monotonic millisecond at which a wait of `timeout_ms` from now runs out,
/// or 0 for a `timeout_ms` of 0, which means no limit.
///
/// A wait past what the clock can hold saturates at the largest value instead of wrapping
/// into the past, where every comparison against `mono_ms` would say it had run out.
fn deadline_ms(timeout_ms: uint) uint {
    if timeout_ms == 0 : return 0
    let now = mono_ms()
    if timeout_ms > uint.$max - now : return uint.$max
    return now + timeout_ms
}

#if OS == "linux" || OS == "macos"
fn clock_ns(clock_id: i32) uint {
    let value: ext.libc_timespec = @undefined
    if ext.clock_gettime(clock_id, @ref(value)) != 0 : panic("Failed to read system time")
    return value.tv_sec.to(uint) * 1_000_000_000 + value.tv_nsec.to(uint)
}
#end

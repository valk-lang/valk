use io
extend DateTime {
    //////////////////////////////
    // Formatting
    //////////////////////////////

    /// Returns the value as text laid out by `pattern`.
    ///
    /// Tokens, as in PHP's `date()`:
    ///
    /// - Year: `Y` four digits, `y` two digits.
    /// - Month: `m` two digits, `n` without a leading zero, `M` `Jan`, `F` `January`.
    /// - Day: `d` two digits, `j` without a leading zero, `D` `Mon`, `l` `Monday`, `N` the
    ///   ISO weekday (1 for Monday to 7 for Sunday).
    /// - Time: `H` hour (24-hour) and `h` hour (12-hour) in two digits, `G` and `g` the same
    ///   without a leading zero, `A` `AM` or `PM`, `a` `am` or `pm`, `i` minute, `s` second,
    ///   `v` milliseconds (3 digits), `u` microseconds (6 digits).
    /// - Zone: `O` offset `+0100`, `P` offset `+01:00`, `T` abbreviation such as `CET`.
    /// - `U` seconds since the Unix epoch.
    ///
    /// Names are English. A backslash inserts the next byte literally; every other byte is
    /// copied as is. Panics when the pattern ends with a backslash.
    ///
    /// ```valk
    /// dt.format("Y-m-d H:i:s")        // 2024-03-05 14:07:09
    /// dt.format("D, j M Y g:i A")     // Tue, 5 Mar 2024 2:07 PM
    /// ```
    + fn format(pattern: String) String {
        let result = ByteBuffer.new(pattern.bytes + 16)
        this.format_to(pattern, result)
        return result.into_string()
    }

    /// Writes `format(pattern)` to `out` and returns the bytes written.
    ///
    /// A `ByteBuffer` is written directly; any other writer receives the text in one write.
    /// Throws when `out` fails.
    + fn format_into(pattern: String, out: io.Writer) uint !io.IoError {
        match out {
            ByteBuffer as buf => {
                let before = buf.length
                this.format_to(pattern, buf)
                return buf.length - before
            }
            default => {
                let buf = ByteBuffer.new(pattern.bytes + 16)
                this.format_to(pattern, buf)
                return out.write(buf) !>
            }
        }
    }

    /// Writes `format(pattern)` into `buf` and returns the byte count.
    ///
    /// `buf` must hold at least `format_size(pattern)` bytes; a shorter buffer panics, as does a
    /// pattern ending with a backslash.
    + fn format_in(pattern: String, buf: local mut &[u8]) uint {
        let needed = DateTime.format_size(pattern)
        if buf.length < needed : panic("DateTime.format_in needs a buffer of at least " + needed + " bytes, got " + buf.length)
        let scratch = format_scratch
        scratch.clear()
        this.format_to(pattern, scratch)
        let length = scratch.length
        let i: uint = 0
        while i < length {
            buf[i] = scratch.get(i)
            i++
        }
        return length
    }

    /// Returns the most bytes `format(pattern)` can write for any date.
    ///
    /// Tokens such as names and numbers without leading zeros write fewer bytes for some dates.
    + static fn format_size(pattern: String) uint {
        let size: uint = 0
        let index: uint = 0
        while index < pattern.bytes {
            let token = pattern.get(index++)
            if token == '\\' {
                index++
                size++
            }
            else : size += format_token_size(token)
        }
        return size
    }

    fn format_to(pattern: String, result: ByteBuffer) {
        let index: uint = 0
        while index < pattern.bytes {
            let token = pattern.get(index++)
            if token == '\\' {
                if index >= pattern.bytes : panic("DateTime format ends with an escape")
                result.write_byte(pattern.get(index++))
            }
            else if token == 'Y' : write_datetime_padded(result, this.year().to(uint), 4)
            else if token == 'y' : write_datetime_padded(result, this.year().to(uint) % 100, 2)
            else if token == 'm' : write_datetime_padded(result, this.month(), 2)
            else if token == 'n' : result.write_uint_ascii(this.month())
            else if token == 'M' : result.write(month_name(this.month()).range(0, 3))
            else if token == 'F' : result.write(month_name(this.month()))
            else if token == 'd' : write_datetime_padded(result, this.day(), 2)
            else if token == 'j' : result.write_uint_ascii(this.day())
            else if token == 'D' : result.write(weekday_name(this.day_of_week()).range(0, 3))
            else if token == 'l' : result.write(weekday_name(this.day_of_week()))
            else if token == 'N' : result.write_uint_ascii(this.day_of_week())
            else if token == 'H' : write_datetime_padded(result, this.hour(), 2)
            else if token == 'G' : result.write_uint_ascii(this.hour())
            else if token == 'h' : write_datetime_padded(result, hour_12(this.hour()), 2)
            else if token == 'g' : result.write_uint_ascii(hour_12(this.hour()))
            else if token == 'A' : result.write(this.hour() < 12 ? "AM" : "PM")
            else if token == 'a' : result.write(this.hour() < 12 ? "am" : "pm")
            else if token == 'i' : write_datetime_padded(result, this.minute(), 2)
            else if token == 's' : write_datetime_padded(result, this.second(), 2)
            else if token == 'v' : write_datetime_padded(result, this.microsecond() / 1_000, 3)
            else if token == 'u' : write_datetime_padded(result, this.microsecond(), 6)
            else if token == 'O' : write_datetime_offset(result, this.utc_offset(), false)
            else if token == 'P' : write_datetime_offset(result, this.utc_offset(), true)
            else if token == 'T' {
                let name = this.zone_abbreviation()
                result.write(name.bytes > 16 ? name.range(0, 16) : name)
            }
            else if token == 'U' : result.write_int_ascii(this.unix_seconds())
            else : result.write_byte(token)
        }
    }

    //////////////////////////////
    // Parsing
    //////////////////////////////

    /// Parses `value` laid out by `pattern`, using the tokens of `format`.
    ///
    /// Numbers need exactly their digit count (`Y` four, `v` three, `u` six, `y`, `m`, `d`,
    /// `H`, `h`, `i` and `s` two); `n`, `j`, `G` and `g` take one or two digits. `y` reads
    /// 69 to 99 as 1969 to 1999 and 00 to 68 as 2000 to 2068. Names are read without regard
    /// to case; a weekday (`D`, `l`, `N`) is checked for its form but not against the date.
    /// `h` and `g` count with `A` or `a` when the pattern has one. `O` and `P` read an offset
    /// (or `Z`) and give a value in `time.fixed_zone` of it; `T` only reads `UTC`, `GMT` or
    /// `Z`. `U` reads a Unix timestamp and allows no other date or time token. Every other
    /// byte must match exactly. A year, month and day are required; missing time fields are 0.
    /// Throws `SyntaxError` on a mismatch, leftover input, a repeated field, or a date or time
    /// that does not exist.
    + static fn from_format(pattern: String, value: String) SELF !SyntaxError {
        return SELF.parse_format(null, pattern, value) !>
    }

    /// Parses `value` laid out by `pattern` as wall-clock time in `zone`; see `from_format`
    /// and, for times around a daylight saving change, `new_in`. An offset in the value wins
    /// over `zone`.
    + static fn from_format_in(zone: Zone, pattern: String, value: String) SELF !SyntaxError {
        return SELF.parse_format(zone, pattern, value) !>
    }

    static fn parse_format(zone: ?Zone, pattern: String, value: String) SELF !SyntaxError {
        let year: int = 0
        let month: uint = 0
        let day: uint = 0
        let hour: uint = 0
        let minute: uint = 0
        let second: uint = 0
        let microsecond: uint = 0
        let unix: int = 0
        let offset: int = 0

        let has_year = false
        let has_month = false
        let has_day = false
        let has_weekday = false
        let has_hour = false
        let hour_is_12 = false
        let has_meridiem = false
        let pm = false
        let has_minute = false
        let has_second = false
        let has_subsecond = false
        let has_offset = false
        let has_unix = false

        let pattern_index: uint = 0
        let value_index: uint = 0
        while pattern_index < pattern.bytes {
            let token = pattern.get(pattern_index++)
            if token == '\\' {
                if pattern_index >= pattern.bytes : throw .syntax
                let literal = pattern.get(pattern_index++)
                if value_index >= value.bytes || value.get(value_index++) != literal : throw .syntax
                continue
            }

            if token == 'Y' || token == 'y' {
                if has_year : throw .syntax
                if token == 'Y' {
                    year = read_format_digits(value, &value_index, 4) !>.to(int)
                } else {
                    let short = read_format_digits(value, &value_index, 2) !>.to(int)
                    year = short < 69 ? 2000 + short : 1900 + short
                }
                has_year = true
            }
            else if token == 'm' || token == 'n' || token == 'M' || token == 'F' {
                if has_month : throw .syntax
                if token == 'm' : month = read_format_digits(value, &value_index, 2) !>
                else if token == 'n' : month = read_format_number(value, &value_index) !>
                else : month = read_month_name(value, &value_index, token == 'F') !>
                has_month = true
            }
            else if token == 'd' || token == 'j' {
                if has_day : throw .syntax
                day = token == 'd' ? read_format_digits(value, &value_index, 2) !> : read_format_number(value, &value_index) !>
                has_day = true
            }
            else if token == 'D' || token == 'l' || token == 'N' {
                if has_weekday : throw .syntax
                if token == 'N' {
                    let weekday = read_format_digits(value, &value_index, 1) !>
                    if weekday < 1 || weekday > 7 : throw .syntax
                } else {
                    read_weekday_name(value, &value_index, token == 'l') !>
                }
                has_weekday = true
            }
            else if token == 'H' || token == 'G' || token == 'h' || token == 'g' {
                if has_hour : throw .syntax
                hour = (token == 'H' || token == 'h') ? read_format_digits(value, &value_index, 2) !> : read_format_number(value, &value_index) !>
                hour_is_12 = token == 'h' || token == 'g'
                if hour_is_12 && (hour < 1 || hour > 12) : throw .syntax
                has_hour = true
            }
            else if token == 'A' || token == 'a' {
                if has_meridiem : throw .syntax
                if value_index + 2 > value.bytes : throw .syntax
                let text = value.range(value_index, 2).lower()
                if text == "am" : pm = false
                else if text == "pm" : pm = true
                else : throw .syntax
                value_index += 2
                has_meridiem = true
            }
            else if token == 'i' {
                if has_minute : throw .syntax
                minute = read_format_digits(value, &value_index, 2) !>
                has_minute = true
            }
            else if token == 's' {
                if has_second : throw .syntax
                second = read_format_digits(value, &value_index, 2) !>
                has_second = true
            }
            else if token == 'v' {
                if has_subsecond : throw .syntax
                microsecond = read_format_digits(value, &value_index, 3) !> * 1_000
                has_subsecond = true
            }
            else if token == 'u' {
                if has_subsecond : throw .syntax
                microsecond = read_format_digits(value, &value_index, 6) !>
                has_subsecond = true
            }
            else if token == 'O' || token == 'P' || token == 'T' {
                if has_offset : throw .syntax
                offset = token == 'T' ? read_utc_name(value, &value_index) !> : read_format_offset(value, &value_index, token == 'P') !>
                has_offset = true
            }
            else if token == 'U' {
                if has_unix : throw .syntax
                unix = read_format_int(value, &value_index) !>
                has_unix = true
            }
            else {
                if value_index >= value.bytes || value.get(value_index++) != token : throw .syntax
            }
        }

        if value_index != value.bytes : throw .syntax
        if has_unix {
            if has_year || has_month || has_day || has_weekday || has_hour || has_meridiem || has_minute || has_second || has_subsecond || has_offset : throw .syntax
            return SELF.from_unix_seconds(unix) ! throw .syntax
        }
        if !has_year || !has_month || !has_day : throw .syntax
        if hour_is_12 && has_meridiem {
            if hour == 12 : hour = 0
            if pm : hour += 12
        } else if has_meridiem && !hour_is_12 {
            // `A` with a 24-hour clock must agree with it
            if pm != (hour >= 12) : throw .syntax
        }
        let in_zone = zone
        if has_offset : in_zone = fixed_zone(offset)
        return SELF.at_wall(.{
            year: year, month: month, day: day, hour: hour,
            minute: minute, second: second, microsecond: microsecond
        }, in_zone) ! throw .syntax
    }

    /// Parses ISO 8601 text as written by `to_iso8601`, such as `2024-03-05T14:07:09Z`,
    /// `2024-03-05 15:07:09.25+01:00` or `2024-03-05`.
    ///
    /// A date alone is midnight UTC. The date and time are separated by `T`, `t` or a space;
    /// seconds and a fraction of up to nine digits (kept to the microsecond) are optional. An
    /// offset such as `+01:00`, `+0100` or `+01` gives a value in `time.fixed_zone` of that
    /// offset; `Z` or `z`, or no offset at all, gives a UTC value. Throws `SyntaxError` on
    /// anything else, or a date or time that does not exist.
    + static fn from_iso8601(value: String) SELF !SyntaxError {
        let index: uint = 0
        let year = read_format_digits(value, &index, 4) !>
        expect_byte(value, &index, '-') !>
        let month = read_format_digits(value, &index, 2) !>
        expect_byte(value, &index, '-') !>
        let day = read_format_digits(value, &index, 2) !>
        let hour: uint = 0
        let minute: uint = 0
        let second: uint = 0
        let microsecond: uint = 0
        let zone: ?Zone = null
        if index < value.bytes {
            let separator = value.get(index)
            if separator != 'T' && separator != 't' && separator != ' ' : throw .syntax
            index++
            hour = read_format_digits(value, &index, 2) !>
            expect_byte(value, &index, ':') !>
            minute = read_format_digits(value, &index, 2) !>
            if index < value.bytes && value.get(index) == ':' {
                index++
                second = read_format_digits(value, &index, 2) !>
                if index < value.bytes && value.get(index) == '.' {
                    index++
                    let digits: uint = 0
                    while index < value.bytes && value.get(index) >= '0' && value.get(index) <= '9' {
                        if digits < 6 : microsecond = microsecond * 10 + (value.get(index) - '0').to(uint)
                        digits++
                        index++
                    }
                    if digits == 0 || digits > 9 : throw .syntax
                    while digits++ < 6 : microsecond *= 10
                }
            }

            if index < value.bytes && (value.get(index) == 'Z' || value.get(index) == 'z') {
                index++
            } else if index < value.bytes && (value.get(index) == '+' || value.get(index) == '-') {
                let negative = value.get(index++) == '-'
                let offset = read_format_digits(value, &index, 2) !> * 3600
                if index < value.bytes && value.get(index) == ':' : index++
                if index < value.bytes : offset += read_format_digits(value, &index, 2) !> * 60
                if offset >= 24 * 3600 : throw .syntax
                zone = fixed_zone(negative ? -offset.to(int) : offset.to(int))
            }
        }
        if index != value.bytes : throw .syntax
        return SELF.at_wall(.{
            year: year.to(int), month: month, day: day, hour: hour,
            minute: minute, second: second, microsecond: microsecond
        }, zone) ! throw .syntax
    }
}

////////////////////////////////
// Formatting helpers
////////////////////////////////

// Writes `value` zero-padded to `width` digits at `pos` and returns the position after it
fn write_padded_in(buf: local mut &[u8], pos: uint, value: uint, width: uint) uint {
    let digits = value.character_length(10)
    let padding = width - digits
    while padding-- > 0 : buf[pos++] = '0'
    let i = digits
    let rest = value
    while i-- > 0 {
        buf[pos + i] = (rest % 10).to(u8) + '0'
        rest /= 10
    }
    return pos + digits
}

-+ fn write_datetime_padded(buffer: ByteBuffer, value: uint, width: uint) {
    let digits = value.character_length(10)
    let padding = width - digits
    while padding-- > 0 : buffer.write_byte('0')
    buffer.write_uint_ascii(value)
}

////////////////////////////////
// Parsing helpers
////////////////////////////////

fn expect_byte(value: String, index: local mut &uint, byte: u8) !SyntaxError {
    if index[0] >= value.bytes || value.get(index[0]) != byte : throw .syntax
    index[0]++
}

fn read_format_digits(value: String, index: local mut &uint, width: uint) uint !SyntaxError {
    if index[0] + width > value.bytes : throw .syntax
    let result: uint = 0
    let end = index[0] + width
    while index[0] < end {
        let digit = value.get(index[0]++)
        if digit < '0' || digit > '9' : throw .syntax
        result = result * 10 + (digit - '0').to(uint)
    }
    return result
}

global format_scratch: ByteBuffer (.new(64))

fn month_name(month: uint) String {
    if month == 1 : return "January"
    if month == 2 : return "February"
    if month == 3 : return "March"
    if month == 4 : return "April"
    if month == 5 : return "May"
    if month == 6 : return "June"
    if month == 7 : return "July"
    if month == 8 : return "August"
    if month == 9 : return "September"
    if month == 10 : return "October"
    if month == 11 : return "November"
    return "December"
}

// ISO weekday: 1 is Monday
fn weekday_name(day: uint) String {
    if day == 1 : return "Monday"
    if day == 2 : return "Tuesday"
    if day == 3 : return "Wednesday"
    if day == 4 : return "Thursday"
    if day == 5 : return "Friday"
    if day == 6 : return "Saturday"
    return "Sunday"
}

fn hour_12(hour: uint) uint {
    let h = hour % 12
    return h == 0 ? 12 : h
}

// The most bytes a format token writes
fn format_token_size(token: u8) uint {
    if token == 'Y' : return 4
    if token == 'v' || token == 'M' || token == 'D' : return 3
    if token == 'u' || token == 'P' : return 6
    if token == 'F' || token == 'l' : return 9
    if token == 'O' : return 5
    if token == 'T' : return 16
    if token == 'U' : return 20
    if token == 'N' : return 1
    if token == 'y' || token == 'm' || token == 'n' || token == 'd' || token == 'j' || token == 'H' || token == 'G' || token == 'h' || token == 'g' || token == 'A' || token == 'a' || token == 'i' || token == 's' : return 2
    return 1
}

fn write_datetime_offset(buffer: ByteBuffer, offset: int, colon: bool) {
    buffer.write_byte(offset < 0 ? '-' : '+')
    let seconds = offset < 0 ? (0 - offset).to(uint) : offset.to(uint)
    write_datetime_padded(buffer, seconds / 3600, 2)
    if colon : buffer.write_byte(':')
    write_datetime_padded(buffer, seconds % 3600 / 60, 2)
}

// One or two digits
fn read_format_number(value: String, index: local mut &uint) uint !SyntaxError {
    let start = index[0]
    let result: uint = 0
    while index[0] < value.bytes && index[0] - start < 2 {
        let digit = value.get(index[0])
        if digit < '0' || digit > '9' : break
        result = result * 10 + (digit - '0').to(uint)
        index[0]++
    }
    if index[0] == start : throw .syntax
    return result
}

// An optional minus and digits
fn read_format_int(value: String, index: local mut &uint) int !SyntaxError {
    let negative = index[0] < value.bytes && value.get(index[0]) == '-'
    if negative : index[0]++
    let start = index[0]
    let result: int = 0
    while index[0] < value.bytes && index[0] - start < 18 {
        let digit = value.get(index[0])
        if digit < '0' || digit > '9' : break
        result = result * 10 + (digit - '0').to(int)
        index[0]++
    }
    if index[0] == start : throw .syntax
    return negative ? -result : result
}

// `+hhmm`, `+hh:mm` with `colon`, or `Z`; seconds east of UTC
fn read_format_offset(value: String, index: local mut &uint, colon: bool) int !SyntaxError {
    if index[0] >= value.bytes : throw .syntax
    let sign = value.get(index[0]++)
    if sign == 'Z' || sign == 'z' : return 0
    if sign != '+' && sign != '-' : throw .syntax
    let hours = read_format_digits(value, index, 2) !>
    if colon : expect_byte(value, index, ':') !>
    let minutes = read_format_digits(value, index, 2) !>
    if hours > 23 || minutes > 59 : throw .syntax
    let seconds = (hours * 3600 + minutes * 60).to(int)
    return sign == '-' ? -seconds : seconds
}

fn read_utc_name(value: String, index: local mut &uint) int !SyntaxError {
    if read_word(value, index, "UTC") || read_word(value, index, "GMT") || read_word(value, index, "Z") : return 0
    throw .syntax
}

fn read_month_name(value: String, index: local mut &uint, full: bool) uint !SyntaxError {
    let month: uint = 1
    while month <= 12 {
        let name = month_name(month)
        if read_word(value, index, full ? name : name.range(0, 3)) : return month
        month++
    }
    throw .syntax
}

fn read_weekday_name(value: String, index: local mut &uint, full: bool) !SyntaxError {
    let day: uint = 1
    while day <= 7 {
        let name = weekday_name(day)
        if read_word(value, index, full ? name : name.range(0, 3)) : return
        day++
    }
    throw .syntax
}

// Takes `word` at the index when the value has it there, ignoring ASCII case
fn read_word(value: String, index: local mut &uint, word: String) bool {
    let start = index[0]
    if start + word.bytes > value.bytes : return false
    if !value.range(start, word.bytes).equals_ignore_ascii_case(word) : return false
    index[0] = start + word.bytes
    return true
}

/// A length of time with microsecond precision, positive or negative.
///
/// Make one with `Duration.of_seconds(90)` and friends, or subtract two `DateTime` values:
/// `later - earlier`. Durations add, subtract and compare with the usual operators, and
/// print like `1h30m` or `-2.5s`. The getters give the whole number of each unit, rounded
/// toward zero: a duration of 90 minutes has `hours()` 1 and `minutes()` 90.
+ struct Duration {
    + microseconds: int

    /// A duration of `days` days of 24 hours.
    + static fn of_days(days: int) SELF {
        return SELF { microseconds: days * 86_400_000_000 }
    }
    /// A duration of `hours` hours.
    + static fn of_hours(hours: int) SELF {
        return SELF { microseconds: hours * 3_600_000_000 }
    }
    /// A duration of `minutes` minutes.
    + static fn of_minutes(minutes: int) SELF {
        return SELF { microseconds: minutes * 60_000_000 }
    }
    /// A duration of `seconds` seconds.
    + static fn of_seconds(seconds: int) SELF {
        return SELF { microseconds: seconds * 1_000_000 }
    }
    /// A duration of `ms` milliseconds.
    + static fn of_ms(ms: int) SELF {
        return SELF { microseconds: ms * 1_000 }
    }
    /// A duration of `us` microseconds.
    + static fn of_us(us: int) SELF {
        return SELF { microseconds: us }
    }

    /// The whole days.
    + fn days() int {
        return this.microseconds / 86_400_000_000
    }
    /// The whole hours.
    + fn hours() int {
        return this.microseconds / 3_600_000_000
    }
    /// The whole minutes.
    + fn minutes() int {
        return this.microseconds / 60_000_000
    }
    /// The whole seconds.
    + fn seconds() int {
        return this.microseconds / 1_000_000
    }
    /// The whole milliseconds.
    + fn ms() int {
        return this.microseconds / 1_000
    }
    /// The seconds with their fraction.
    + fn seconds_float() float {
        return this.microseconds.to(float) / 1_000_000.0
    }

    /// Returns true when the duration is below zero.
    + fn is_negative() bool {
        return this.microseconds < 0
    }
    /// Returns the duration without its sign.
    + fn abs() SELF {
        return SELF { microseconds: this.microseconds < 0 ? 0 - this.microseconds : this.microseconds }
    }
    /// Returns the duration `factor` times as long.
    + fn times(factor: int) SELF {
        return SELF { microseconds: this.microseconds * factor }
    }

    /// Returns the sum of both durations; backs `a + b`.
    + fn plus(other: SELF) SELF $add {
        return SELF { microseconds: this.microseconds + other.microseconds }
    }
    /// Returns this duration minus `other`; backs `a - b`.
    + fn minus(other: SELF) SELF $sub {
        return SELF { microseconds: this.microseconds - other.microseconds }
    }
    /// Backs `==`.
    + fn equals(other: SELF) bool $eq {
        return this.microseconds == other.microseconds
    }
    /// Backs `<`.
    + fn less_than(other: SELF) bool $lt {
        return this.microseconds < other.microseconds
    }
    /// Backs `>`.
    + fn greater_than(other: SELF) bool $gt {
        return this.microseconds > other.microseconds
    }
    /// Hashes the length, so durations can be map keys.
    + fn hash() uint $hash {
        return this.microseconds.to(uint)
    }

    /// Returns the duration as text such as `2d3h`, `1h30m`, `4.5s`, `250ms`, `15us` or `0s`.
    ///
    /// Units that are zero are left out; seconds carry their fraction.
    + fn to_string() String $auto {
        let us = this.microseconds
        if us == 0 : return "0s"
        let result = ByteBuffer.new(24)
        let rest = us < 0 ? (0 - us).to(uint) : us.to(uint)
        if us < 0 : result.write_byte('-')
        if rest < 1_000_000 {
            if rest % 1_000 == 0 {
                result.write_uint_ascii(rest / 1_000)
                result.write("ms")
            } else if rest < 1_000 {
                result.write_uint_ascii(rest)
                result.write("us")
            } else {
                write_fraction(result, rest, 1_000)
                result.write("ms")
            }
            return result.into_string()
        }
        let days = rest / 86_400_000_000
        rest = rest % 86_400_000_000
        let hours = rest / 3_600_000_000
        rest = rest % 3_600_000_000
        let minutes = rest / 60_000_000
        rest = rest % 60_000_000
        if days > 0 {
            result.write_uint_ascii(days)
            result.write_byte('d')
        }
        if hours > 0 {
            result.write_uint_ascii(hours)
            result.write_byte('h')
        }
        if minutes > 0 {
            result.write_uint_ascii(minutes)
            result.write_byte('m')
        }
        if rest > 0 {
            write_fraction(result, rest, 1_000_000)
            result.write_byte('s')
        }
        return result.into_string()
    }
}

// `value / unit` with the fraction's significant digits
fn write_fraction(out: ByteBuffer, value: uint, unit: uint) {
    out.write_uint_ascii(value / unit)
    let fraction = value % unit
    if fraction == 0 : return
    out.write_byte('.')
    let digits = unit.character_length(10) - 1
    let text = fraction.to_string()
    let zeros = digits - text.bytes
    while zeros-- > 0 : out.write_byte('0')
    out.write(text.rtrim("0"))
}

/// Pauses the caller for at least `duration`; nothing happens for a negative one. See `sleep_ns`.
+ fn sleep(duration: Duration) {
    if duration.microseconds <= 0 : return
    sleep_ms(duration.microseconds.to(uint) / 1_000)
    let rest = duration.microseconds.to(uint) % 1_000
    if rest > 0 : sleep_ns(rest * 1_000)
}

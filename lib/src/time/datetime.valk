use core

value MICROSECONDS_PER_SECOND (1_000_000)
value SECONDS_PER_MINUTE (60)
value SECONDS_PER_HOUR (3_600)
value SECONDS_PER_DAY (86_400)

struct DatetimeParts {
    year: int
    month: uint
    day: uint
    hour: uint
    minute: uint
    second: uint
    microsecond: uint
}

// A UTC calendar date and time. Calendar operations return a new value by
// default; methods ending in `_mut` (and the `set_*` methods) explicitly update
// this instance.
+ class Datetime {
    timestamp_microseconds: int
    cached_year: i16
    cached_month: u8
    cached_day: u8
    cached_hour: u8
    cached_minute: u8
    cached_second: u8
    cached_microsecond: u32

    + static fn new(
        year: int,
        month: uint,
        day: uint,
        hour: uint (0),
        minute: uint (0),
        second: uint (0),
        microsecond: uint (0)
    ) SELF {
        validate_parts(year, month, day, hour, minute, second, microsecond)
        return SELF {
            timestamp_microseconds: timestamp_from_parts(
                year, month, day, hour, minute, second, microsecond
            ),
            cached_year: year.to(i16),
            cached_month: month.to(u8),
            cached_day: day.to(u8),
            cached_hour: hour.to(u8),
            cached_minute: minute.to(u8),
            cached_second: second.to(u8),
            cached_microsecond: microsecond.to(u32),
        }
    }

    + static fn now() SELF {
        return SELF.from_unix_microseconds(microtime().to(int))
    }

    + static fn from_timestamp(timestamp: int) SELF {
        return SELF.from_unix_microseconds(timestamp * MICROSECONDS_PER_SECOND)
    }

    + static fn from_unix_microseconds(timestamp: int) SELF {
        let parts = parts_from_timestamp(timestamp)
        validate_parts(
            parts.year, parts.month, parts.day, parts.hour,
            parts.minute, parts.second, parts.microsecond
        )
        return SELF {
            timestamp_microseconds: timestamp,
            cached_year: parts.year.to(i16),
            cached_month: parts.month.to(u8),
            cached_day: parts.day.to(u8),
            cached_hour: parts.hour.to(u8),
            cached_minute: parts.minute.to(u8),
            cached_second: parts.second.to(u8),
            cached_microsecond: parts.microsecond.to(u32),
        }
    }

    + fn copy() SELF {
        return SELF {
            timestamp_microseconds: this.timestamp_microseconds,
            cached_year: this.cached_year,
            cached_month: this.cached_month,
            cached_day: this.cached_day,
            cached_hour: this.cached_hour,
            cached_minute: this.cached_minute,
            cached_second: this.cached_second,
            cached_microsecond: this.cached_microsecond,
        }
    }

    + fn timestamp() int {
        return floor_div(this.timestamp_microseconds, MICROSECONDS_PER_SECOND)
    }

    + fn unix_microseconds() int {
        return this.timestamp_microseconds
    }

    + fn year() int { return this.cached_year.to(int) }
    + fn month() uint { return this.cached_month.to(uint) }
    + fn day() uint { return this.cached_day.to(uint) }
    + fn hour() uint { return this.cached_hour.to(uint) }
    + fn minute() uint { return this.cached_minute.to(uint) }
    + fn second() uint { return this.cached_second.to(uint) }
    + fn microsecond() uint { return this.cached_microsecond.to(uint) }

    + fn is_leap_year() bool {
        return year_is_leap(this.year())
    }

    + fn day_of_year() uint {
        let parts = this.parts()
        let result = parts.day
        let month = 1
        while month < parts.month {
            result += days_in_month(parts.year, month)
            month++
        }
        return result
    }

    // ISO weekday: Monday is 1 and Sunday is 7.
    + fn day_of_week() uint {
        let days = floor_div(this.timestamp(), SECONDS_PER_DAY)
        return floor_mod(days + 3, 7).to(uint) + 1
    }

    + fn with_year(year: int) SELF {
        let parts = this.parts()
        let day = min(parts.day, days_in_month(year, parts.month))
        return SELF.new(
            year, parts.month, day, parts.hour, parts.minute,
            parts.second, parts.microsecond
        )
    }

    + fn with_month(month: uint) SELF {
        let parts = this.parts()
        let day = min(parts.day, days_in_month(parts.year, month))
        return SELF.new(
            parts.year, month, day, parts.hour, parts.minute,
            parts.second, parts.microsecond
        )
    }

    + fn with_day(day: uint) SELF {
        let parts = this.parts()
        return SELF.new(
            parts.year, parts.month, day, parts.hour, parts.minute,
            parts.second, parts.microsecond
        )
    }

    + fn with_hour(hour: uint) SELF {
        let parts = this.parts()
        return SELF.new(
            parts.year, parts.month, parts.day, hour, parts.minute,
            parts.second, parts.microsecond
        )
    }

    + fn with_minute(minute: uint) SELF {
        let parts = this.parts()
        return SELF.new(
            parts.year, parts.month, parts.day, parts.hour, minute,
            parts.second, parts.microsecond
        )
    }

    + fn with_second(second: uint) SELF {
        let parts = this.parts()
        return SELF.new(
            parts.year, parts.month, parts.day, parts.hour, parts.minute,
            second, parts.microsecond
        )
    }

    + fn with_microsecond(microsecond: uint) SELF {
        let parts = this.parts()
        return SELF.new(
            parts.year, parts.month, parts.day, parts.hour, parts.minute,
            parts.second, microsecond
        )
    }

    + fn set_year(year: int) SELF { return this.replace_mut(this.with_year(year)) }
    + fn set_month(month: uint) SELF { return this.replace_mut(this.with_month(month)) }
    + fn set_day(day: uint) SELF { return this.replace_mut(this.with_day(day)) }
    + fn set_hour(hour: uint) SELF { return this.replace_mut(this.with_hour(hour)) }
    + fn set_minute(minute: uint) SELF { return this.replace_mut(this.with_minute(minute)) }
    + fn set_second(second: uint) SELF { return this.replace_mut(this.with_second(second)) }
    + fn set_microsecond(microsecond: uint) SELF {
        return this.replace_mut(this.with_microsecond(microsecond))
    }

    + fn add_years(amount: int) SELF {
        return this.with_year(this.year() + amount)
    }

    + fn add_months(amount: int) SELF {
        let parts = this.parts()
        let month_index = parts.year * 12 + parts.month.to(int) - 1 + amount
        let year = floor_div(month_index, 12)
        let month = floor_mod(month_index, 12).to(uint) + 1
        let day = min(parts.day, days_in_month(year, month))
        return SELF.new(
            year, month, day, parts.hour, parts.minute,
            parts.second, parts.microsecond
        )
    }

    + fn add_days(amount: int) SELF {
        return this.add_microseconds(amount * SECONDS_PER_DAY * MICROSECONDS_PER_SECOND)
    }

    + fn add_hours(amount: int) SELF {
        return this.add_microseconds(amount * SECONDS_PER_HOUR * MICROSECONDS_PER_SECOND)
    }

    + fn add_minutes(amount: int) SELF {
        return this.add_microseconds(amount * SECONDS_PER_MINUTE * MICROSECONDS_PER_SECOND)
    }

    + fn add_seconds(amount: int) SELF {
        return this.add_microseconds(amount * MICROSECONDS_PER_SECOND)
    }

    + fn add_microseconds(amount: int) SELF {
        return SELF.from_unix_microseconds(this.timestamp_microseconds + amount)
    }

    + fn add_years_mut(amount: int) SELF { return this.replace_mut(this.add_years(amount)) }
    + fn add_months_mut(amount: int) SELF { return this.replace_mut(this.add_months(amount)) }
    + fn add_days_mut(amount: int) SELF { return this.replace_mut(this.add_days(amount)) }
    + fn add_hours_mut(amount: int) SELF { return this.replace_mut(this.add_hours(amount)) }
    + fn add_minutes_mut(amount: int) SELF { return this.replace_mut(this.add_minutes(amount)) }
    + fn add_seconds_mut(amount: int) SELF { return this.replace_mut(this.add_seconds(amount)) }
    + fn add_microseconds_mut(amount: int) SELF {
        return this.replace_mut(this.add_microseconds(amount))
    }

    + fn to_iso8601() String {
        let parts = this.parts()
        let result = ByteBuffer.new(28)
        write_datetime_padded(result, parts.year.to(uint), 4)
        result.write_byte('-')
        write_datetime_padded(result, parts.month, 2)
        result.write_byte('-')
        write_datetime_padded(result, parts.day, 2)
        result.write_byte('T')
        write_datetime_padded(result, parts.hour, 2)
        result.write_byte(':')
        write_datetime_padded(result, parts.minute, 2)
        result.write_byte(':')
        write_datetime_padded(result, parts.second, 2)
        if parts.microsecond != 0 {
            result.write_byte('.')
            write_datetime_padded(result, parts.microsecond, 6)
        }
        result.write_byte('Z')
        return result
    }

    + fn to_string() String $auto {
        return this.to_iso8601()
    }

    fn equal(other: SELF) bool $eq {
        return this.timestamp_microseconds == other.timestamp_microseconds
    }

    fn less_than(other: SELF) bool $lt {
        return this.timestamp_microseconds < other.timestamp_microseconds
    }

    fn greater_than(other: SELF) bool $gt {
        return this.timestamp_microseconds > other.timestamp_microseconds
    }

    fn parts() <DatetimeParts> {
        return {
            year: this.cached_year.to(int),
            month: this.cached_month.to(uint),
            day: this.cached_day.to(uint),
            hour: this.cached_hour.to(uint),
            minute: this.cached_minute.to(uint),
            second: this.cached_second.to(uint),
            microsecond: this.cached_microsecond.to(uint),
        }
    }

    fn replace_mut(value: SELF) SELF {
        this.timestamp_microseconds = value.timestamp_microseconds
        this.cached_year = value.cached_year
        this.cached_month = value.cached_month
        this.cached_day = value.cached_day
        this.cached_hour = value.cached_hour
        this.cached_minute = value.cached_minute
        this.cached_second = value.cached_second
        this.cached_microsecond = value.cached_microsecond
        return this
    }
}

fn validate_parts(
    year: int,
    month: uint,
    day: uint,
    hour: uint,
    minute: uint,
    second: uint,
    microsecond: uint
) {
    if parts_are_valid(year, month, day, hour, minute, second, microsecond) : return
    panic("Invalid Datetime value")
}

-+ fn parts_are_valid(
    year: int,
    month: uint,
    day: uint,
    hour: uint,
    minute: uint,
    second: uint,
    microsecond: uint
) bool {
    if year < 1 || year > 9_999 : return false
    if month < 1 || month > 12 : return false
    if day < 1 || day > days_in_month(year, month) : return false
    return hour <= 23 && minute <= 59 && second <= 59
        && microsecond < MICROSECONDS_PER_SECOND
}

fn year_is_leap(year: int) bool {
    return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

fn days_in_month(year: int, month: uint) uint {
    if month == 2 : return year_is_leap(year) ? 29 : 28
    if month == 4 || month == 6 || month == 9 || month == 11 : return 30
    return 31
}

fn min(a: uint, b: uint) uint {
    return a < b ? a : b
}

fn floor_div(value: int, divisor: int) int {
    let result = value / divisor
    if value % divisor < 0 : result--
    return result
}

fn floor_mod(value: int, divisor: int) int {
    return value - floor_div(value, divisor) * divisor
}

fn timestamp_from_parts(
    year: int,
    month: uint,
    day: uint,
    hour: uint,
    minute: uint,
    second: uint,
    microsecond: uint
) int {
    let adjusted_year = year - (month <= 2 ? 1 : 0)
    let era = floor_div(adjusted_year, 400)
    let year_of_era = adjusted_year - era * 400
    let adjusted_month = month.to(int) + (month > 2 ? -3 : 9)
    let day_of_year = (153 * adjusted_month + 2) / 5 + day.to(int) - 1
    let day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
    let days = era * 146_097 + day_of_era - 719_468
    let seconds = days * SECONDS_PER_DAY
        + hour.to(int) * SECONDS_PER_HOUR
        + minute.to(int) * SECONDS_PER_MINUTE
        + second.to(int)
    return seconds * MICROSECONDS_PER_SECOND + microsecond.to(int)
}

fn parts_from_timestamp(timestamp: int) <DatetimeParts> {
    let seconds = floor_div(timestamp, MICROSECONDS_PER_SECOND)
    let microsecond = (timestamp - seconds * MICROSECONDS_PER_SECOND).to(uint)
    let days = floor_div(seconds, SECONDS_PER_DAY)
    let seconds_of_day = seconds - days * SECONDS_PER_DAY

    let date = days + 719_468
    let era = floor_div(date, 146_097)
    let day_of_era = date - era * 146_097
    let year_of_era = (
        day_of_era - day_of_era / 1_460
        + day_of_era / 36_524 - day_of_era / 146_096
    ) / 365
    let year = year_of_era + era * 400
    let day_of_year = day_of_era - (
        365 * year_of_era + year_of_era / 4 - year_of_era / 100
    )
    let adjusted_month = (5 * day_of_year + 2) / 153
    let day = day_of_year - (153 * adjusted_month + 2) / 5 + 1
    let month = adjusted_month + (adjusted_month < 10 ? 3 : -9)
    year += month <= 2 ? 1 : 0

    return {
        year: year,
        month: month.to(uint),
        day: day.to(uint),
        hour: (seconds_of_day / SECONDS_PER_HOUR).to(uint),
        minute: ((seconds_of_day % SECONDS_PER_HOUR) / SECONDS_PER_MINUTE).to(uint),
        second: (seconds_of_day % SECONDS_PER_MINUTE).to(uint),
        microsecond: microsecond,
    }
}

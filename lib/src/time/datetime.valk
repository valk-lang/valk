value MICROSECONDS_PER_SECOND (1_000_000)
value SECONDS_PER_MINUTE (60)
value SECONDS_PER_HOUR (3_600)
value SECONDS_PER_DAY (86_400)

struct DatetimeParts {
    year: int
    month: uint
    day: uint
    hour: uint
    minute: uint
    second: uint
    microsecond: uint
}

/// A UTC date and time with microsecond precision, for the years 1 to 9999.
///
/// There are no time zones or leap seconds. The `with_*` and `add_*` methods return a new
/// value; the `modify_*` methods change this one in place and leave it unchanged when they
/// throw. Every operation that would leave the year range, or build an invalid date, throws
/// `LookupError`.
+ class DateTime {
    timestamp_microseconds: int
    cached_year: i16
    cached_month: u8
    cached_day: u8
    cached_hour: u8
    cached_minute: u8
    cached_second: u8
    cached_microsecond: u32

    //////////////////////////////
    // Construction and copying
    //////////////////////////////

    /// Creates a date and time from its components.
    ///
    /// Components left `null` before the first given one are taken from the current UTC time;
    /// those after it default to their minimum (month and day 1, the rest 0). So
    /// `DateTime.new(2024, 1, 1)` is midnight, `DateTime.new(null, null, null, 9)` is 09:00:00
    /// today and `DateTime.new()` is now. Throws `LookupError` when a component is out of range
    /// or the day does not exist in that month.
    + static fn new(
        year: ?int(null),
        month: ?uint(null),
        day: ?uint(null),
        hour: ?uint(null),
        minute: ?uint(null),
        second: ?uint(null),
        microsecond: ?uint(null)
    ) SELF !LookupError {
        let current = DatetimeParts {
            year: 0,
            month: 0,
            day: 0,
            hour: 0,
            minute: 0,
            second: 0,
            microsecond: 0
        }
        if !isset(year) || !isset(month) || !isset(day) || !isset(hour)
            || !isset(minute) || !isset(second) || !isset(microsecond) {
                current = parts_from_timestamp(unix_us().to(int))
            }

        year = year ?? current.year
        month = month ?? current.month
        day = day ?? current.day
        hour = hour ?? current.hour
        minute = minute ?? current.minute
        second = second ?? current.second
        microsecond = microsecond ?? current.microsecond

        validate_parts(year, month, day, hour, minute, second, microsecond) !>
        return SELF {
            timestamp_microseconds: timestamp_from_parts(
                year, month, day, hour, minute, second, microsecond
            ),
            cached_year: year.to(i16),
            cached_month: month.to(u8),
            cached_day: day.to(u8),
            cached_hour: hour.to(u8),
            cached_minute: minute.to(u8),
            cached_second: second.to(u8),
            cached_microsecond: microsecond.to(u32),
        }
    }

    /// Returns the current UTC date and time.
    ///
    /// Panics when the system clock is outside the supported range.
    + static fn now() SELF {
        return SELF.from_unix_us(unix_us().to(int)) ! panic("System time is outside the DateTime range")
    }

    /// Creates a date and time from whole seconds since the Unix epoch.
    ///
    /// Throws `LookupError` when the result falls outside the years 1 to 9999.
    + static fn from_unix_seconds(timestamp: int) SELF !LookupError {
        return SELF.from_unix_us(scale(timestamp, MICROSECONDS_PER_SECOND) !>) !>
    }

    /// Creates a date and time from microseconds since the Unix epoch.
    ///
    /// Throws `LookupError` when the result falls outside the years 1 to 9999.
    + static fn from_unix_us(timestamp: int) SELF !LookupError {
        let parts = parts_from_timestamp(timestamp)
        validate_parts(
            parts.year, parts.month, parts.day, parts.hour,
            parts.minute, parts.second, parts.microsecond
        ) !>
        return SELF {
            timestamp_microseconds: timestamp,
            cached_year: parts.year.to(i16),
            cached_month: parts.month.to(u8),
            cached_day: parts.day.to(u8),
            cached_hour: parts.hour.to(u8),
            cached_minute: parts.minute.to(u8),
            cached_second: parts.second.to(u8),
            cached_microsecond: parts.microsecond.to(u32),
        }
    }

    /// Returns an independent copy of this value.
    + fn copy() SELF {
        return SELF {
            timestamp_microseconds: this.timestamp_microseconds,
            cached_year: this.cached_year,
            cached_month: this.cached_month,
            cached_day: this.cached_day,
            cached_hour: this.cached_hour,
            cached_minute: this.cached_minute,
            cached_second: this.cached_second,
            cached_microsecond: this.cached_microsecond,
        }
    }

    //////////////////////////////
    // Unix timestamps
    //////////////////////////////

    /// Returns the whole seconds since the Unix epoch, rounded down (towards the past).
    + fn unix_seconds() int {
        return floor_div(this.timestamp_microseconds, MICROSECONDS_PER_SECOND)
    }

    /// Returns the microseconds since the Unix epoch.
    + fn unix_us() int {
        return this.timestamp_microseconds
    }

    //////////////////////////////
    // Date and time components
    //////////////////////////////

    /// Returns the year, 1 to 9999.
    + fn year() int { return this.cached_year.to(int) }
    /// Returns the month, 1 to 12.
    + fn month() uint { return this.cached_month.to(uint) }
    /// Returns the day of the month, starting at 1.
    + fn day() uint { return this.cached_day.to(uint) }
    /// Returns the hour, 0 to 23.
    + fn hour() uint { return this.cached_hour.to(uint) }
    /// Returns the minute, 0 to 59.
    + fn minute() uint { return this.cached_minute.to(uint) }
    /// Returns the second, 0 to 59.
    + fn second() uint { return this.cached_second.to(uint) }
    /// Returns the microseconds within the second, 0 to 999999.
    + fn microsecond() uint { return this.cached_microsecond.to(uint) }

    //////////////////////////////
    // Calendar information
    //////////////////////////////

    /// Returns whether the year is a leap year in the Gregorian calendar.
    + fn is_leap_year() bool {
        return year_is_leap(this.year())
    }

    /// Returns the day of the year, 1 to 366.
    + fn day_of_year() uint {
        let parts = this.parts()
        let result = parts.day
        let month = 1
        while month < parts.month {
            result += days_in_month(parts.year, month)
            month++
        }
        return result
    }

    // ISO weekday: Monday is 1 and Sunday is 7.
    /// Returns the ISO weekday: Monday is 1 and Sunday is 7.
    + fn day_of_week() uint {
        let days = floor_div(this.unix_seconds(), SECONDS_PER_DAY)
        return floor_mod(days + 3, 7).to(uint) + 1
    }

    //////////////////////////////
    // Immutable component changes
    //////////////////////////////

    /// Returns a copy with the year set to `year`.
    ///
    /// A February 29 becomes February 28 when `year` is not a leap year. Throws `LookupError`
    /// when `year` is outside 1 to 9999.
    + fn with_year(year: int) SELF !LookupError {
        let parts = this.parts()
        let day = min(parts.day, days_in_month(year, parts.month))
        return SELF.new(
            year, parts.month, day, parts.hour, parts.minute,
            parts.second, parts.microsecond
        ) !>
    }

    /// Returns a copy with the month set to `month`.
    ///
    /// The day is clamped to the last day of the new month (January 31 becomes February 28 or
    /// 29). Throws `LookupError` when `month` is outside 1 to 12.
    + fn with_month(month: uint) SELF !LookupError {
        let parts = this.parts()
        let day = min(parts.day, days_in_month(parts.year, month))
        return SELF.new(
            parts.year, month, day, parts.hour, parts.minute,
            parts.second, parts.microsecond
        ) !>
    }

    /// Returns a copy with the day of the month set to `day`.
    ///
    /// Throws `LookupError` when the month has no such day.
    + fn with_day(day: uint) SELF !LookupError {
        let parts = this.parts()
        return SELF.new(
            parts.year, parts.month, day, parts.hour, parts.minute,
            parts.second, parts.microsecond
        ) !>
    }

    /// Returns a copy with the hour set to `hour`; throws `LookupError` above 23.
    + fn with_hour(hour: uint) SELF !LookupError {
        let parts = this.parts()
        return SELF.new(
            parts.year, parts.month, parts.day, hour, parts.minute,
            parts.second, parts.microsecond
        ) !>
    }

    /// Returns a copy with the minute set to `minute`; throws `LookupError` above 59.
    + fn with_minute(minute: uint) SELF !LookupError {
        let parts = this.parts()
        return SELF.new(
            parts.year, parts.month, parts.day, parts.hour, minute,
            parts.second, parts.microsecond
        ) !>
    }

    /// Returns a copy with the second set to `second`; throws `LookupError` above 59.
    + fn with_second(second: uint) SELF !LookupError {
        let parts = this.parts()
        return SELF.new(
            parts.year, parts.month, parts.day, parts.hour, parts.minute,
            second, parts.microsecond
        ) !>
    }

    /// Returns a copy with the microseconds set to `microsecond`; throws `LookupError` above 999999.
    + fn with_microsecond(microsecond: uint) SELF !LookupError {
        let parts = this.parts()
        return SELF.new(
            parts.year, parts.month, parts.day, parts.hour, parts.minute,
            parts.second, microsecond
        ) !>
    }

    //////////////////////////////
    // Mutable component changes
    //////////////////////////////

    /// Sets the year to `year` in place, clamping February 29 to February 28 when needed.
    ///
    /// Throws `LookupError` when `year` is outside 1 to 9999.
    + fn modify_year(year: int) !LookupError {
        let parts = this.parts()
        parts.year = year
        parts.day = min(parts.day, days_in_month(parts.year, parts.month))
        this.replace_parts_mut(parts) !>
    }

    /// Sets the month to `month` in place, clamping the day to the last day of that month.
    ///
    /// Throws `LookupError` when `month` is outside 1 to 12.
    + fn modify_month(month: uint) !LookupError {
        let parts = this.parts()
        parts.month = month
        parts.day = min(parts.day, days_in_month(parts.year, parts.month))
        this.replace_parts_mut(parts) !>
    }

    /// Sets the day of the month to `day` in place.
    ///
    /// Throws `LookupError` when the month has no such day.
    + fn modify_day(day: uint) !LookupError {
        let parts = this.parts()
        parts.day = day
        this.replace_parts_mut(parts) !>
    }

    /// Sets the hour to `hour` in place; throws `LookupError` above 23.
    + fn modify_hour(hour: uint) !LookupError {
        let parts = this.parts()
        parts.hour = hour
        this.replace_parts_mut(parts) !>
    }

    /// Sets the minute to `minute` in place; throws `LookupError` above 59.
    + fn modify_minute(minute: uint) !LookupError {
        let parts = this.parts()
        parts.minute = minute
        this.replace_parts_mut(parts) !>
    }

    /// Sets the second to `second` in place; throws `LookupError` above 59.
    + fn modify_second(second: uint) !LookupError {
        let parts = this.parts()
        parts.second = second
        this.replace_parts_mut(parts) !>
    }

    /// Sets the microseconds to `microsecond` in place; throws `LookupError` above 999999.
    + fn modify_microsecond(microsecond: uint) !LookupError {
        let parts = this.parts()
        parts.microsecond = microsecond
        this.replace_parts_mut(parts) !>
    }

    //////////////////////////////
    // Immutable arithmetic
    //////////////////////////////

    /// Returns a copy moved by `amount` years, which may be negative.
    ///
    /// February 29 becomes February 28 in a year that is not a leap year.
    + fn add_years(amount: int) SELF !LookupError {
        return this.with_year(add(this.year(), amount) !>) !>
    }

    /// Returns a copy moved by `amount` calendar months, which may be negative.
    ///
    /// The day is clamped to the last day of the resulting month, so January 31 plus one month
    /// is February 28 or 29.
    + fn add_months(amount: int) SELF !LookupError {
        let parts = this.parts_after_months(amount) !>
        return SELF.new(
            parts.year, parts.month, parts.day, parts.hour, parts.minute,
            parts.second, parts.microsecond
        ) !>
    }

    /// Returns a copy moved by `amount` days of exactly 24 hours, which may be negative.
    + fn add_days(amount: int) SELF !LookupError {
        return this.add_microseconds(scale(amount, SECONDS_PER_DAY * MICROSECONDS_PER_SECOND) !>) !>
    }

    /// Returns a copy moved by `amount` hours, which may be negative.
    + fn add_hours(amount: int) SELF !LookupError {
        return this.add_microseconds(scale(amount, SECONDS_PER_HOUR * MICROSECONDS_PER_SECOND) !>) !>
    }

    /// Returns a copy moved by `amount` minutes, which may be negative.
    + fn add_minutes(amount: int) SELF !LookupError {
        return this.add_microseconds(scale(amount, SECONDS_PER_MINUTE * MICROSECONDS_PER_SECOND) !>) !>
    }

    /// Returns a copy moved by `amount` seconds, which may be negative.
    + fn add_seconds(amount: int) SELF !LookupError {
        return this.add_microseconds(scale(amount, MICROSECONDS_PER_SECOND) !>) !>
    }

    /// Returns a copy moved by `amount` microseconds, which may be negative.
    + fn add_microseconds(amount: int) SELF !LookupError {
        return SELF.from_unix_us(add(this.timestamp_microseconds, amount) !>) !>
    }

    //////////////////////////////
    // Mutable arithmetic
    //////////////////////////////

    /// Moves this value by `amount` years in place; see `add_years`.
    + fn modify_add_years(amount: int) !LookupError {
        this.modify_year(add(this.year(), amount) !>) !>
    }
    /// Moves this value by `amount` calendar months in place; see `add_months`.
    + fn modify_add_months(amount: int) !LookupError {
        this.replace_parts_mut(this.parts_after_months(amount) !>) !>
    }
    /// Moves this value by `amount` days of 24 hours in place.
    + fn modify_add_days(amount: int) !LookupError {
        this.modify_add_microseconds(scale(amount, SECONDS_PER_DAY * MICROSECONDS_PER_SECOND) !>) !>
    }
    /// Moves this value by `amount` hours in place.
    + fn modify_add_hours(amount: int) !LookupError {
        this.modify_add_microseconds(scale(amount, SECONDS_PER_HOUR * MICROSECONDS_PER_SECOND) !>) !>
    }
    /// Moves this value by `amount` minutes in place.
    + fn modify_add_minutes(amount: int) !LookupError {
        this.modify_add_microseconds(scale(amount, SECONDS_PER_MINUTE * MICROSECONDS_PER_SECOND) !>) !>
    }
    /// Moves this value by `amount` seconds in place.
    + fn modify_add_seconds(amount: int) !LookupError {
        this.modify_add_microseconds(scale(amount, MICROSECONDS_PER_SECOND) !>) !>
    }
    /// Moves this value by `amount` microseconds in place.
    + fn modify_add_microseconds(amount: int) !LookupError {
        this.replace_timestamp_mut(add(this.timestamp_microseconds, amount) !>) !>
    }

    //////////////////////////////
    // String conversion
    //////////////////////////////

    /// Returns the value as ISO 8601 text in UTC, such as `2024-03-05T14:07:09Z`.
    ///
    /// A non-zero microsecond part adds six fraction digits: `2024-03-05T14:07:09.250000Z`.
    + fn to_iso8601() String {
        let parts = this.parts()
        let result = ByteBuffer.new(28)
        write_datetime_padded(result, parts.year.to(uint), 4)
        result.write_byte('-')
        write_datetime_padded(result, parts.month, 2)
        result.write_byte('-')
        write_datetime_padded(result, parts.day, 2)
        result.write_byte('T')
        write_datetime_padded(result, parts.hour, 2)
        result.write_byte(':')
        write_datetime_padded(result, parts.minute, 2)
        result.write_byte(':')
        write_datetime_padded(result, parts.second, 2)
        if parts.microsecond != 0 {
            result.write_byte('.')
            write_datetime_padded(result, parts.microsecond, 6)
        }
        result.write_byte('Z')
        return result
    }

    /// Returns `to_iso8601()`; `$auto` lets a `DateTime` convert to `String` implicitly.
    + fn to_string() String $auto {
        return this.to_iso8601()
    }

    //////////////////////////////
    // Comparison operators
    //////////////////////////////

    /// Returns whether both values name the same instant; backs the `==` operator (`$eq`).
    + fn equal(other: SELF) bool $eq {
        return this.timestamp_microseconds == other.timestamp_microseconds
    }

    /// Returns a hash of the instant; `$hash` lets `DateTime` be a `HashMap` key.
    + fn hash() uint $hash {
        return this.timestamp_microseconds.to(uint)
    }

    /// Returns whether this value is earlier than `other`; backs the `<` operator (`$lt`).
    + fn less_than(other: SELF) bool $lt {
        return this.timestamp_microseconds < other.timestamp_microseconds
    }

    /// Returns whether this value is later than `other`; backs the `>` operator (`$gt`).
    + fn greater_than(other: SELF) bool $gt {
        return this.timestamp_microseconds > other.timestamp_microseconds
    }

    //////////////////////////////
    // Internal state helpers
    //////////////////////////////

    fn parts() DatetimeParts {
        return .{
            year: this.cached_year.to(int),
            month: this.cached_month.to(uint),
            day: this.cached_day.to(uint),
            hour: this.cached_hour.to(uint),
            minute: this.cached_minute.to(uint),
            second: this.cached_second.to(uint),
            microsecond: this.cached_microsecond.to(uint),
        }
    }

    fn parts_after_months(amount: int) DatetimeParts !LookupError {
        let parts = this.parts()
        let month_index = add(parts.year * 12 + parts.month.to(int) - 1, amount) !>
        parts.year = floor_div(month_index, 12)
        parts.month = floor_mod(month_index, 12).to(uint) + 1
        parts.day = min(parts.day, days_in_month(parts.year, parts.month))
        return parts
    }

    fn replace_parts_mut(parts: DatetimeParts) !LookupError {
        validate_parts(
            parts.year, parts.month, parts.day, parts.hour,
            parts.minute, parts.second, parts.microsecond
        ) !>
        let timestamp = timestamp_from_parts(
            parts.year, parts.month, parts.day, parts.hour,
            parts.minute, parts.second, parts.microsecond
        )
        this.update_mut(timestamp, parts)
    }

    fn replace_timestamp_mut(timestamp: int) !LookupError {
        let parts = parts_from_timestamp(timestamp)
        validate_parts(
            parts.year, parts.month, parts.day, parts.hour,
            parts.minute, parts.second, parts.microsecond
        ) !>
        this.update_mut(timestamp, parts)
    }

    fn update_mut(timestamp: int, parts: DatetimeParts) {
        this.timestamp_microseconds = timestamp
        this.cached_year = parts.year.to(i16)
        this.cached_month = parts.month.to(u8)
        this.cached_day = parts.day.to(u8)
        this.cached_hour = parts.hour.to(u8)
        this.cached_minute = parts.minute.to(u8)
        this.cached_second = parts.second.to(u8)
        this.cached_microsecond = parts.microsecond.to(u32)
    }
}

////////////////////////////////
// Validation
////////////////////////////////

fn validate_parts(
    year: int,
    month: uint,
    day: uint,
    hour: uint,
    minute: uint,
    second: uint,
    microsecond: uint
) !LookupError {
    if parts_are_valid(year, month, day, hour, minute, second, microsecond) : return
    throw .range
}

-+ fn parts_are_valid(
    year: int,
    month: uint,
    day: uint,
    hour: uint,
    minute: uint,
    second: uint,
    microsecond: uint
) bool {
    if year < 1 || year > 9_999 : return false
    if month < 1 || month > 12 : return false
    if day < 1 || day > days_in_month(year, month) : return false
    return hour <= 23 && minute <= 59 && second <= 59
        && microsecond < MICROSECONDS_PER_SECOND
}

fn year_is_leap(year: int) bool {
    return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

fn days_in_month(year: int, month: uint) uint {
    if month == 2 : return year_is_leap(year) ? 29 : 28
    if month == 4 || month == 6 || month == 9 || month == 11 : return 30
    return 31
}

////////////////////////////////
// Numeric helpers
////////////////////////////////

fn min(a: uint, b: uint) uint {
    return a < b ? a : b
}

// Overflow-checked int arithmetic
fn add(a: int, b: int) int !LookupError {
    if b > 0 && a > int.$max - b : throw .range
    if b < 0 && a < int.$min - b : throw .range
    return a + b
}

fn scale(a: int, factor: int) int !LookupError {
    if a > int.$max / factor || a < int.$min / factor : throw .range
    return a * factor
}

fn floor_div(value: int, divisor: int) int {
    let result = value / divisor
    if value % divisor < 0 : result--
    return result
}

fn floor_mod(value: int, divisor: int) int {
    return value - floor_div(value, divisor) * divisor
}

////////////////////////////////
// Timestamp conversion
////////////////////////////////

fn timestamp_from_parts(
    year: int,
    month: uint,
    day: uint,
    hour: uint,
    minute: uint,
    second: uint,
    microsecond: uint
) int {
    let adjusted_year = year - (month <= 2 ? 1 : 0)
    let era = floor_div(adjusted_year, 400)
    let year_of_era = adjusted_year - era * 400
    let adjusted_month = month.to(int) + (month > 2 ? -3 : 9)
    let day_of_year = (153 * adjusted_month + 2) / 5 + day.to(int) - 1
    let day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
    let days = era * 146_097 + day_of_era - 719_468
    let seconds = days * SECONDS_PER_DAY
    + hour.to(int) * SECONDS_PER_HOUR
    + minute.to(int) * SECONDS_PER_MINUTE
    + second.to(int)
    return seconds * MICROSECONDS_PER_SECOND + microsecond.to(int)
}

fn parts_from_timestamp(timestamp: int) DatetimeParts {
    let seconds = floor_div(timestamp, MICROSECONDS_PER_SECOND)
    let microsecond = (timestamp - seconds * MICROSECONDS_PER_SECOND).to(uint)
    let days = floor_div(seconds, SECONDS_PER_DAY)
    let seconds_of_day = seconds - days * SECONDS_PER_DAY

    let date = days + 719_468
    let era = floor_div(date, 146_097)
    let day_of_era = date - era * 146_097
    let year_of_era = (
        day_of_era - day_of_era / 1_460
        + day_of_era / 36_524 - day_of_era / 146_096
    ) / 365
    let year = year_of_era + era * 400
    let day_of_year = day_of_era - (
        365 * year_of_era + year_of_era / 4 - year_of_era / 100
    )
    let adjusted_month = (5 * day_of_year + 2) / 153
    let day = day_of_year - (153 * adjusted_month + 2) / 5 + 1
    let month = adjusted_month + (adjusted_month < 10 ? 3 : -9)
    year += month <= 2 ? 1 : 0

    return .{
        year: year,
        month: month.to(uint),
        day: day.to(uint),
        hour: (seconds_of_day / SECONDS_PER_HOUR).to(uint),
        minute: ((seconds_of_day % SECONDS_PER_HOUR) / SECONDS_PER_MINUTE).to(uint),
        second: (seconds_of_day % SECONDS_PER_MINUTE).to(uint),
        microsecond: microsecond,
    }
}

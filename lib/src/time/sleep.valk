
use coro
use thread

/// Pauses the caller for at least `ns` nanoseconds.
///
/// Inside a coroutine only that coroutine is suspended and the thread keeps running other
/// coroutines; elsewhere the whole thread sleeps. Windows, and a coroutine on macOS, round
/// the duration up to whole milliseconds.
+ fn sleep_ns(ns: uint) {
    let current = coro.current_coro
    if isset(current) : current.sleep(ns)
    else : thread.suspend_ns(ns)
}

/// Pauses the caller for at least `ms` milliseconds; see `sleep_ns`.
+ fn sleep_ms(ms: uint) {
    // A nanosecond count holds fewer milliseconds than a uint does, so a longer
    // request is slept in whole chunks of the largest representable one
    let limit: uint = uint.$max / 1_000_000
    while ms > limit {
        sleep_ns(limit * 1_000_000)
        ms -= limit
    }
    sleep_ns(ms * 1_000_000)
}

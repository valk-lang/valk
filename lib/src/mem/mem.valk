use ext
use coro

+ fn alloc_ob(size: uint) ptr {
    let result = ext.malloc(size)
    let address: uint = result
    if size > 0 && address == 0 : panic("Memory allocation failed")
    return result
}

+ fn alloc(size: uint) ptr {
    let result = ext.malloc(size)
    let address: uint = result
    if size > 0 && address == 0 : panic("Memory allocation failed")
    return result
}

+ fn new[T](initial: T (T.$default_value)) *T {
    @unsafe
    #if !T.$is_inline
    #error "mem.new[T] requires an inline value type"
    #end
    let value = alloc(size_of(T))
    @ptrv(value, T) = initial
    return value
}

+ fn free(adr: ptr) {
    ext.free(adr)
}

+ fn calloc(size: uint) ptr {
    @unsafe
    let adr = alloc(size)
    clear(adr, size)
    return adr
}

+ fn copy(from: ptr, to: ptr, length: uint) {
    @unsafe
    if length == 0 : return
    @memcpy(from, to, length)
}

+ fn move(from: ptr, to: ptr, length: uint) {
    @unsafe
    if length == 0 || from == to : return

    let from_addr: uint = from
    let to_addr: uint = to
    if to_addr < from_addr {
        if from_addr - to_addr >= length {
            copy(from, to, length)
            return
        }
        let i: uint = 0
        while i < length {
            @ptrv(to, u8, i) = @ptrv(from, u8, i)
            i++
        }
        return
    }

    if to_addr - from_addr >= length {
        copy(from, to, length)
        return
    }
    let i = length
    while i-- > 0 {
        @ptrv(to, u8, i) = @ptrv(from, u8, i)
    }
}

+ fn resize(adr: ptr, size: uint, new_size: uint) ptr {
    @unsafe
    if new_size == size : return adr
    if new_size < size : size = new_size
    let new = alloc(new_size)
    @memcpy(adr, new, size)
    free(adr)
    return new
}

+ fn clear(adr: ptr, length: uint) {
    @unsafe
    let i: uint = 0
    let chunks = length / size_of(uint)
    while i < chunks {
        @ptrv(adr, uint, i) = 0
        i++
    }
    i = i * size_of(uint)
    while i < length {
        @ptrv(adr, u8, i) = 0
        i++
    }
}

+ fn equal(a: ptr, b: ptr, length: uint) bool {
    @unsafe
    let chunks = length / size_of(ptr)
    let i: uint = chunks
    while i > 0 {
        i--
        let av = @ptrv(a, uint, i)
        let bv = @ptrv(b, uint, i)
        if av != bv : return false
    }
    i = length % size_of(ptr)
    let offset = chunks * size_of(ptr)
    let ao = a + offset
    let bo = b + offset
    while i > 0 {
        i--
        let av = @ptrv(ao, u8, i)
        let bv = @ptrv(bo, u8, i)
        if av != bv : return false
    }
    return true
}

+ fn ascii_bytes_to_lower(adr: ptr, len: uint) {
    @unsafe
    while len-- > 0 {
        let ch = @ptrv(adr, u8, len)
        if ch > 64 && ch < 91 : @ptrv(adr, u8, len) = ch + 32
    }
}

// ASCII-only, so it can compare a header value without folding the case of the
// stored bytes: field values are case sensitive, only their names are not.
+ fn ascii_bytes_equal_ignore_case(a: ptr, b: ptr, len: uint) bool {
    @unsafe
    while len-- > 0 {
        let av = @ptrv(a, u8, len)
        let bv = @ptrv(b, u8, len)
        if av > 64 && av < 91 : av += 32
        if bv > 64 && bv < 91 : bv += 32
        if av != bv : return false
    }
    return true
}

+ fn bytes_to_uint(adr: ptr, len: uint) uint !SyntaxError {
    @unsafe
    if len == 0 : throw .syntax
    let result: uint = 0
    let i: uint = 0
    while i < len {
        let ch = @ptrv(adr, u8, i)
        if ch < '0' || ch > '9' : throw .syntax
        let prev = result
        result = result * 10 + (ch.to(uint) - '0')
        // Integer arithmetic wraps, so a quotient that does not round-trip
        // means the accumulator overflowed. Leading zeros still pass.
        if result / 10 != prev : throw .syntax
        i++
    }
    return result
}

+ fn find_char(adr: ptr, ch: u8, length: uint) uint !LookupError {
    @unsafe
    let i: uint = 0
    let ones: u64 = 0x0101010101010101
    let high: u64 = 0x8080808080808080
    let repeated = ch.to(u64) * ones
    while length - i >= 8 {
        let word = @ptrv(adr.@offset(i), u64) ^ repeated
        if ((word - ones) & ~word & high) != 0 {
            let end = i + 8
            while i < end {
                if @ptrv(adr, u8, i) == ch : return i
                i++
            }
        } else {
            i += 8
        }
    }
    while i < length {
        if @ptrv(adr, u8, i) == ch : return i
        i++
    }
    throw .missing
}

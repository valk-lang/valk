use ext
use coro

/// Allocates `size` bytes of unmanaged, uninitialized memory with `malloc`.
///
/// Panics when the allocation fails; a `size` of 0 may return a null pointer. The memory is
/// not tracked by the GC; release it with `free`.
+ fn alloc(size: uint) ptr {
    let result = ext.malloc(size)
    let address: uint = result
    if size > 0 && address == 0 : panic("Memory allocation failed")
    return result
}

/// Allocates unmanaged memory for one `T` and stores `initial` in it.
///
/// `T` must be an inline value type (a struct or number) without GC references; anything else
/// is a compile error. Release the memory with `free`.
+ fn new[T](initial: T (T.$default_value)) *T {
    #if !T.$is_inline && !T.$is_integer && !T.$is_float && !T.$is_bool
    #error "mem.new[T] requires an inline value type"
    #end
    #if T.$has_gc_refs
    #error "mem.new[T] cannot allocate a type with GC references"
    #end
    let value = alloc(size_of(T))
    @ptrv(value, T) = initial
    return value
}

/// Releases memory obtained from `alloc`, `calloc`, `new` or `resize`.
///
/// Takes a raw pointer, so a call needs `@unsafe`: nothing checks that the memory came from
/// these functions or is still in use.
+ fn free(value: ptr) $inline {
    @unsafe
    ext.free(value)
}

/// Allocates `size` bytes of unmanaged memory set to zero; release it with `free`.
+ fn calloc(size: uint) ptr {
    @unsafe
    let adr = alloc(size)
    clear_bytes(adr, size)
    return adr
}

/// Copies `length` bytes from `from` to `to`; the two ranges must not overlap.
+ fn copy_bytes(from: ptr, to: ptr, length: uint) {
    if length == 0 : return
    @memcpy(from, to, length)
}

/// Copies `length` bytes from `from` to `to`; the two ranges may overlap.
+ fn move_bytes(from: ptr, to: ptr, length: uint) {
    @unsafe
    if length == 0 || from == to : return

    let from_addr: uint = from
    let to_addr: uint = to
    if to_addr < from_addr {
        if from_addr - to_addr >= length {
            copy_bytes(from, to, length)
            return
        }
        let i: uint = 0
        while i < length {
            @ptrv(to, u8, i) = @ptrv(from, u8, i)
            i++
        }
        return
    }

    if to_addr - from_addr >= length {
        copy_bytes(from, to, length)
        return
    }
    let i = length
    while i-- > 0 {
        @ptrv(to, u8, i) = @ptrv(from, u8, i)
    }
}

/// Moves the memory at `adr` into a new allocation of `new_size` bytes and frees the old one.
///
/// Copies the first `size` bytes (or fewer when shrinking); bytes past `size` are
/// uninitialized. Returns `adr` itself when the size does not change. The old pointer is
/// invalid afterwards.
+ fn resize(adr: ptr, size: uint, new_size: uint) ptr {
    @unsafe
    if new_size == size : return adr
    if new_size < size : size = new_size
    let new = alloc(new_size)
    @memcpy(adr, new, size)
    free(adr)
    return new
}

/// Sets the `T` at `value` to all zero bytes.
///
/// `T` must be an inline value type without GC references; anything else is a compile error.
+ fn clear_value[T](value: *T) $inline {
    @unsafe
    #if !T.$is_inline && !T.$is_integer && !T.$is_float && !T.$is_bool
    #error "mem.clear_value[T] requires an inline value type"
    #end
    #if T.$has_gc_refs
    #error "mem.clear_value[T] cannot clear a type with GC references"
    #end
    clear_bytes(value, size_of(T))
}

/// Copies the `T` at `from` to `to`; the two must not overlap.
///
/// `T` must be an inline value type without GC references; anything else is a compile error.
+ fn copy_value[T](from: *T, to: *T) $inline {
    @unsafe
    #if !T.$is_inline && !T.$is_integer && !T.$is_float && !T.$is_bool
    #error "mem.copy_value[T] requires an inline value type"
    #end
    #if T.$has_gc_refs
    #error "mem.copy_value[T] cannot copy a type with GC references"
    #end
    copy_bytes(from, to, size_of(T))
}

/// Copies the `T` at `from` to `to`; the two may overlap.
///
/// `T` must be an inline value type without GC references; anything else is a compile error.
+ fn move_value[T](from: *T, to: *T) $inline {
    @unsafe
    #if !T.$is_inline && !T.$is_integer && !T.$is_float && !T.$is_bool
    #error "mem.move_value[T] requires an inline value type"
    #end
    #if T.$has_gc_refs
    #error "mem.move_value[T] cannot move a type with GC references"
    #end
    move_bytes(from, to, size_of(T))
}

/// Sets `length` bytes at `adr` to zero.
+ fn clear_bytes(adr: ptr, length: uint) {
    let i: uint = 0
    let chunks = length / size_of(uint)
    while i < chunks {
        @ptrv(adr, uint, i) = 0
        i++
    }
    i = i * size_of(uint)
    while i < length {
        @ptrv(adr, u8, i) = 0
        i++
    }
}

/// Returns whether the `length` bytes at `a` and `b` are identical.
+ fn equals_bytes(a: ptr, b: ptr, length: uint) bool {
    let chunks = length / size_of(ptr)
    let i: uint = chunks
    while i > 0 {
        i--
        let av = @ptrv(a, uint, i)
        let bv = @ptrv(b, uint, i)
        if av != bv : return false
    }
    i = length % size_of(ptr)
    let offset = chunks * size_of(ptr)
    let ao = a + offset
    let bo = b + offset
    while i > 0 {
        i--
        let av = @ptrv(ao, u8, i)
        let bv = @ptrv(bo, u8, i)
        if av != bv : return false
    }
    return true
}
// Old name of `equals_bytes`; src/ still calls it against the installed stdlib.
// Drop it after 0.6.5 is installed and the compiler's callers are flipped.
+ fn equal_bytes(a: ptr, b: ptr, length: uint) bool {
    @unsafe
    return equals_bytes(a, b, length)
}

/// Converts the ASCII letters `A`-`Z` in the `len` bytes at `adr` to lower case, in place.
+ fn ascii_bytes_to_lower(adr: ptr, len: uint) {
    while len-- > 0 {
        let ch = @ptrv(adr, u8, len)
        if ch > 64 && ch < 91 : @ptrv(adr, u8, len) = ch + 32
    }
}

// ASCII-only, so it can compare a header value without folding the case of the
// stored bytes: field values are case sensitive, only their names are not.
/// Returns whether the `len` bytes at `a` and `b` match, ignoring ASCII letter case.
///
/// Only `A`-`Z` are folded; other bytes, including non-ASCII ones, must match exactly.
+ fn ascii_bytes_equal_ignore_case(a: ptr, b: ptr, len: uint) bool {
    while len-- > 0 {
        let av = @ptrv(a, u8, len)
        let bv = @ptrv(b, u8, len)
        if av > 64 && av < 91 : av += 32
        if bv > 64 && bv < 91 : bv += 32
        if av != bv : return false
    }
    return true
}

/// Parses the `len` bytes at `adr` as a decimal unsigned integer.
///
/// Only digits are accepted, plus one leading `+` when `allow_plus` is set; leading zeros are
/// fine. Throws `SyntaxError` for an empty input, any other byte or a value above the `uint`
/// maximum.
+ fn bytes_to_uint(adr: ptr, len: uint, allow_plus: bool (false)) uint !SyntaxError {
    if len == 0 : throw .syntax
    let result: uint = 0
    let i: uint = 0
    if allow_plus && @ptrv(adr, u8) == '+' {
        i++
        if i == len : throw .syntax
    }
    while i < len {
        let ch = @ptrv(adr, u8, i)
        if ch < '0' || ch > '9' : throw .syntax
        let prev = result
        result = result * 10 + (ch.to(uint) - '0')
        // Integer arithmetic wraps, so a quotient that does not round-trip
        // means the accumulator overflowed. Leading zeros still pass.
        if result / 10 != prev : throw .syntax
        i++
    }
    return result
}

/// Returns the byte index of the first `ch` in the `length` bytes at `adr`.
///
/// Throws `LookupError` when the byte does not occur.
+ fn find_char_bytes(adr: ptr, ch: u8, length: uint) uint !LookupError {
    let i: uint = 0
    let ones: u64 = 0x0101010101010101
    let high: u64 = 0x8080808080808080
    let repeated = ch.to(u64) * ones
    while length - i >= 8 {
        let word = @ptrv(adr.@offset(i), u64) ^ repeated
        if ((word - ones) & ~word & high) != 0 {
            let end = i + 8
            while i < end {
                if @ptrv(adr, u8, i) == ch : return i
                i++
            }
        } else {
            i += 8
        }
    }
    while i < length {
        if @ptrv(adr, u8, i) == ch : return i
        i++
    }
    throw .missing
}

/// Copies the bytes of `from` to the start of `to` and returns the number copied.
///
/// Copies at most `to.length` bytes. The two views must not overlap; use `move` when they may.
+ fn copy(from: local &[u8], to: local mut &[u8]) uint $inline {
    @unsafe
    let length = from.length
    let to_length = to.length
    if length > to_length : length = to_length
    copy_bytes(from.data, to.data, length)
    return length
}

/// Copies the bytes of `from` to the start of `to` and returns the number copied.
///
/// Copies at most `to.length` bytes. The two views may overlap.
+ fn move(from: local &[u8], to: local mut &[u8]) uint $inline {
    @unsafe
    let length = from.length
    let to_length = to.length
    if length > to_length : length = to_length
    move_bytes(from.data, to.data, length)
    return length
}

/// Sets every byte of `view` to zero.
+ fn clear(view: local mut &[u8]) $inline {
    @unsafe
    clear_bytes(view.data, view.length)
}

/// Returns whether `a` and `b` have the same length and bytes.
+ fn equals(a: local &[u8], b: local &[u8]) bool $inline {
    @unsafe
    let length = a.length
    if length != b.length : return false
    return equals_bytes(a.data, b.data, length)
}

/// Converts the ASCII letters `A`-`Z` in `view` to lower case, in place.
+ fn ascii_to_lower(view: local mut &[u8]) $inline {
    @unsafe
    ascii_bytes_to_lower(view.data, view.length)
}

/// Returns whether `a` and `b` have the same length and bytes, ignoring ASCII letter case.
///
/// Only `A`-`Z` are folded; other bytes, including non-ASCII ones, must match exactly.
+ fn ascii_equal_ignore_case(a: local &[u8], b: local &[u8]) bool $inline {
    @unsafe
    let length = a.length
    if length != b.length : return false
    return ascii_bytes_equal_ignore_case(a.data, b.data, length)
}

/// Parses `view` as a decimal unsigned integer.
///
/// Only digits are accepted, plus one leading `+` when `allow_plus` is set; leading zeros are
/// fine. Throws `SyntaxError` for an empty view, any other byte or a value above the `uint`
/// maximum.
+ fn to_uint(view: local &[u8], allow_plus: bool (false)) uint !SyntaxError $inline {
    @unsafe
    return bytes_to_uint(view.data, view.length, allow_plus) !>
}

/// Returns the byte index of the first `ch` in `view`.
///
/// Throws `LookupError` when the byte does not occur.
+ fn find_char(view: local &[u8], ch: u8) uint !LookupError $inline {
    @unsafe
    return find_char_bytes(view.data, ch, view.length) !>
}

use io
use json
use html

/// A set of templates and their filters.
///
/// An engine is an ordinary object: create one, register templates and filters, render.
/// Nothing in it is shared between threads. A server that renders on several worker
/// threads gives each thread its own engine through a `global`, whose initializer runs on
/// every thread:
///
/// ```valk
/// global views: template.Engine (load_views())
///
/// fn load_views() template.Engine {
///     let engine = template.Engine.new()
///     engine.set_many(#embed_dir("views"))
///     engine.set_filter("money", fn(v: json.Value, args: Array[json.Value]) json.Value {
///         return json.from("$" + v.float.to_string(2))
///     })
///     return engine
/// }
///
/// fn handler(req: http.Request) http.Response {
///     return http.Response.html(views.render("index.html", data) !? "render failed")
/// }
/// ```
///
/// A template is compiled the first time it renders and the compiled form is kept until
/// it is registered again. Output is context-aware HTML-escaped unless `escape` or
/// `auto_escape` says otherwise, so an engine can just as well produce plain text, SQL
/// or any other format.
+ class Engine {
    - sources: Map[String] (.{})
    - compiled: Map[Template] (.{})
    - filters: Map[Filter] (.{})
    /// Writes every `{{ }}` output escaped; HTML escaping by default. Set it to `null` for
    /// plain text, or to your own `Escape` for another format: templates are not tied to
    /// HTML. A `RenderOptions.escape` overrides it for one render.
    ///
    /// ```valk
    /// engine.escape = fn(input: local &[u8], out: io.Writer) uint !io.IoError {
    ///     return out.write(input.to_string().replace("'", "''")) !>
    /// }
    /// ```
    + escape: ?Escape (default_html_escape)
    /// Enables context-aware HTML auto-escaping (HTML text, quoted and unquoted
    /// attributes, URL attributes, `<script>` JS, and `<style>` / `style=` CSS) when
    /// `escape` is the default `html_escape`. Defaults to `true`.
    + auto_escape: bool (true)
    /// Optional fallback loader called when a template name is not registered via `set`
    /// or `set_many`. Loaded templates are compiled and cached until `remove` or
    /// `clear_cache` is called.
    + loader: ?Loader (null)

    /// Creates an empty engine.
    + static fn new() SELF $default {
        return SELF {}
    }

    /// Registers `content` as the template named `name`, replacing any earlier one.
    + fn set(name: String, content: String) {
        this.sources.set(name, content)
        this.compiled.remove(name)
    }

    /// Registers every entry of `content` as a template, keyed by name.
    ///
    /// Pairs with `#embed_dir`, which yields a map of relative paths to file contents.
    + fn set_many(content: Map[String]) {
        each content as text, name : this.set(name, text)
    }

    /// Removes the registered template `name` and any cached compiled form of it.
    + fn remove(name: String) {
        this.sources.remove(name)
        this.compiled.remove(name)
    }

    /// Clears all cached compiled templates so they recompile (or reload via `loader`) on
    /// next render.
    + fn clear_cache() {
        this.compiled = Map[Template]{}
    }

    /// Registers `filter` for `{{ value | name }}` and `{{ value | name(args) }}`.
    ///
    /// The filter receives the value and the evaluated arguments and returns the value the
    /// output continues with. A custom filter replaces a built-in one of the same name. The
    /// built-in filters are `upper`, `lower`, `capitalize`, `trim`, `length` (`len`),
    /// `default(x)`, `join(sep)`, `first`, `last`, `reverse`, `round(decimals)`,
    /// `fixed(decimals)`, `truncate(n, suffix)`, `replace(from, to)`, `json`, `escape`,
    /// `raw`, `urlencode` and `keys`.
    + fn set_filter(name: String, filter: Filter) {
        this.filters.set(name, filter)
    }

    /// Whether a template named `name` is registered.
    + fn has(name: String) bool {
        return this.sources.has(name)
    }

    /// Renders the registered template `name` with `data` and returns the output.
    ///
    /// `data` is read directly when it is a typed struct/class or converted via `json.from`,
    /// so template variables are its fields or map keys. `{{ }}` output goes through the
    /// engine's `escape` (context-aware HTML by default), or through `options.escape` when
    /// options are given, `{! !}` and `{{ expr | raw }}` write raw, and leading and trailing
    /// whitespace is trimmed from the result. `@include` and `@extend` look templates up in
    /// this engine (falling back to `loader`), may not form a cycle, and may nest at most
    /// `options.max_depth` templates deep (64 by default), not counting `name` itself.
    ///
    /// Throws `.template_not_found` when `name` is not registered, `.parse` on a syntax error,
    /// an unknown template in `@include`/`@extend`, a cycle, too deep nesting, an unknown
    /// filter or a variable or property that does not exist (`message` names the line,
    /// column and template).
    + fn render(name: String, data: $T, options: ?RenderOptions (null)) String !ParseError {
        let out = ByteBuffer.new(1024)
        this.render_into(name, data, out, options) !>
        return out.into_string()
    }

    /// Writes `render(name, data, options)` to `out` and returns the bytes written.
    ///
    /// Throws `ParseError` as `render` does, and `.write` when `out` fails.
    + fn render_into(name: String, data: $T, out: io.Writer, options: ?RenderOptions (null)) uint !ParseError {
        let compiled = this.compiled_template(name) ! {
            match E {
                .missing(_, _, _) => throw .template_not_found(name, "Template not found. Did you forget to register it with 'set'?")
                default => throw E
            }
        }
        let renderer = Renderer.create(this, options, datum_from(data))
        return renderer.render_to(compiled, name, out) !>
    }

    /// Renders the template text `content` with `data` and returns the output.
    ///
    /// Works like `render` without looking up a name first; `@include` and `@extend` still
    /// resolve against the registered templates (and `loader`). Throws `.parse` as `render`
    /// does.
    + fn render_content(content: String, data: $T, options: ?RenderOptions (null)) String !ParseError {
        let out = ByteBuffer.new(1024)
        this.render_content_into(content, data, out, options) !>
        return out.into_string()
    }

    /// Writes `render_content(content, data, options)` to `out` and returns the bytes written.
    ///
    /// Throws `ParseError` as `render_content` does, and `.write` when `out` fails.
    + fn render_content_into(content: String, data: $T, out: io.Writer, options: ?RenderOptions (null)) uint !ParseError {
        let compiled = Compiler { content: content }.compile() !>
        let renderer = Renderer.create(this, options, datum_from(data))
        return renderer.render_to(compiled, "", out) !>
    }

    // The compiled template `name`, compiled on first use since its registration
    fn compiled_template(name: String) Template !ParseError {
        this.compiled.get(name) -> ready : return ready
        let source = this.sources.get(name) !? null
        if !isset(source) {
            let loader = this.loader
            if isset(loader) : source = loader(name)
        }
        if !isset(source) : throw .missing(name, "Template not found", 0)
        let compiled = Compiler { name: name, content: source }.compile() !>
        this.compiled.set(name, compiled)
        return compiled
    }

    fn filter(name: String) ?Filter {
        return this.filters.get(name) !? null
    }
}

// ---- Rendering --------------------------------------------------------------------------

// Variables set by a loop or `@set`; the chain ends at the render's root data
class Frame {
    parent: ?Frame (null)
    vars: ?Map[Datum] (null)
    slot_name: String ("")
    slot_value: Datum (null)

    fn set_var(name: String, value: Datum) {
        let saved = datum_snapshot(value)
        if this.slot_name == name {
            this.slot_value = saved
            return
        }
        let m = this.vars
        if !isset(m) {
            let created = Map[Datum]{}
            this.vars = created
            created.set(name, saved)
            return
        }
        m.set(name, saved)
    }
}

class BlockEntry {
    template: Template
    nodes: Array[Node]
    frame: Frame
    root: Datum
}

// Ordered inheritance chain for each block name: index 0 is the most derived override,
// followed by parent definitions so `@super()` can walk up the hierarchy.
class BlockChain {
    blocks: Map[Array[BlockEntry]] (.{})

    fn add(name: String, entry: BlockEntry) {
        this.blocks.get(name) -> list {
            list.append(entry)
            return
        }
        this.blocks.set(name, Array[BlockEntry]{ entry })
    }

    fn pop(name: String) {
        this.blocks.get(name) -> list {
            list.pop_last() ! return
        }
    }

    fn get_list(name: String) ?Array[BlockEntry] {
        return this.blocks.get(name) !? null
    }
}

class Renderer {
    engine: Engine
    options: ?RenderOptions
    root: Datum
    escape: ?Escape (null)
    default_html: bool (false)
    auto_escape: bool (false)

    static fn create(engine: Engine, options: ?RenderOptions, root: Datum) Renderer {
        let escape = isset(options) ? options.escape : engine.escape
        let default_html = isset(escape) && (escape == default_html_escape || escape == html_escape)
        let auto_escape = false
        if default_html {
            auto_escape = engine.auto_escape
            if isset(options) {
                let opt_auto = options.auto_escape
                if isset(opt_auto) : auto_escape = opt_auto
            }
        }
        return Renderer {
            engine: engine
            options: options
            root: root
            escape: escape
            default_html: default_html
            auto_escape: auto_escape
        }
    }

    // Renders `template` into `out`: straight into a `ByteBuffer`, through a page buffer for
    // any other writer. Returns the bytes written.
    fn render_to(template: Template, name: String, out: io.Writer) uint !ParseError {
        match out {
            ByteBuffer as buf => {
                let start = buf.length
                this.render_template(template, Frame {}, null, 0, null, this.root, null, buf) !>
                return buf.length - start
            }
            default => {
                let page = ByteBuffer.new(1024)
                this.render_template(template, Frame {}, null, 0, null, this.root, null, page) !>
                return out.write(page) ! throw .write(name, "The writer refused the rendered page")
            }
        }
    }

    // Renders one template into `out` at its current end, trimmed of leading and trailing
    // whitespace like an include or the page itself. `templates` names the templates
    // being rendered, for cycle detection, and `depth` how many includes and extends are
    // above this one.
    fn render_template(template: Template, frame: Frame, templates: ?Array[String], depth: uint, chain: ?BlockChain, root: Datum, scanner: ?HtmlScanner, out: ByteBuffer) !ParseError {
        let start = out.length
        let state = RenderState { template: template, templates: templates, depth: depth, chain: chain, root: root, scanner: scanner }
        this.render_nodes(template.nodes, frame, state, out) !>

        let parent_name = template.extends
        if !isset(parent_name) {
            trim_region(out, start)
            return
        }
        // An extending template: the text before `@extend`, then the parent with this
        // template's blocks, then the text after
        let split = state.extend_offset
        let tail = ByteBuffer.new(out.length - split)
        tail.write(out.view(split, out.length - split))
        tail.trim(u8.is_whitespace)
        out.truncate(split)
        trim_region(out, start)
        let parent = this.load(parent_name, state, template.extends_line, template.extends_col, template.extends_offset) !>
        let stack = state.ensure_templates()
        this.enter(stack, parent_name, depth, state, template.extends_line, template.extends_col, template.extends_offset) !>
        let parent_frame = Frame { parent: frame }
        this.render_template(parent, parent_frame, stack, depth + 1, state.chain, root, scanner, out) !>
        stack.pop_last() !? ""
        out.write(tail)
    }

    fn render_block_layer(block_name: String, list: Array[BlockEntry], layer: uint, state: RenderState, scanner: ?HtmlScanner, out: ByteBuffer, line: uint, col: uint, offset: uint) !ParseError {
        let entry = list.get(layer) ! return
        let key = block_name + "#" + layer
        let active_blocks = state.active_blocks
        if !isset(active_blocks) {
            let created = Array[String]{}
            state.active_blocks = created
            active_blocks = created
        }
        each active_blocks as active {
            if active == key : this.fail("Block cycle: '" + block_name + "'", line, col, offset, state)
        }
        let max_depth = TEMPLATE_MAX_DEPTH
        let options = this.options
        if isset(options) : max_depth = options.max_depth
        if active_blocks.length >= max_depth : this.fail("Block nesting depth exceeds the maximum of " + max_depth, line, col, offset, state)
        active_blocks.append(key)
        let block_start = out.length
        let block_state = RenderState {
            template: entry.template
            templates: state.templates
            depth: state.depth
            chain: state.chain
            root: entry.root
            active_block: block_name
            active_block_index: layer
            active_blocks: active_blocks
            scanner: scanner
        }
        this.render_nodes(entry.nodes, entry.frame, block_state, out) ! {
            active_blocks.pop_last() !? ""
            throw E
        }
        active_blocks.pop_last() !? ""
        trim_region(out, block_start)
    }

    fn child_scanner(node: Node, state: RenderState) ?HtmlScanner {
        let cur = state.scanner
        if isset(cur) : return cur
        let entry = node.entry_scanner
        if isset(entry) : return entry.clone()
        return null
    }

    fn render_nodes(nodes: Array[Node], frame: Frame, state: RenderState, out: ByteBuffer) !ParseError {
        each nodes as node {
            if node.type == NODE_TEXT {
                out.write(node.text)
                let sc = state.scanner
                if isset(sc) : sc.feed(node.text)
            } else if node.type == NODE_OUTPUT {
                let expr = node.expr ?! continue
                let raw = node.raw
                if !raw && expr.type == EXPR_FILTER && expr.name == "raw" && !isset(this.engine.filter("raw")) {
                    raw = true
                    expr = expr.left ?! continue
                }
                let value = this.eval_datum(expr, frame, state) !>
                this.write_output_value(value, raw, node, state, out) !>
            } else if node.type == NODE_IF {
                each node.branches as arm {
                    let cond = arm.cond
                    if !isset(cond) || datum_truthy(this.eval_datum(cond, frame, state) !>) {
                        this.render_nodes(arm.nodes, frame, state, out) !>
                        break
                    }
                }
            } else if node.type == NODE_EACH {
                let expr = node.expr ?! continue
                let list_datum = this.eval_datum(expr, frame, state) !>
                match list_datum {
                    ListView as lv => {
                        let count = lv.list_len()
                        if count == 0 {
                            let empty = node.empty_body
                            if isset(empty) : this.render_nodes(empty, frame, state, out) !>
                            continue
                        }
                        let inner = Frame { parent: frame, slot_name: node.vname }
                        let kname = node.kname
                        let iname = node.iname
                        let cursor = lv.make_cursor()
                        if isset(cursor) {
                            inner.slot_value = cursor.as_datum()
                            each 0 .. count as index {
                                cursor.set_index(index)
                                if isset(kname) : inner.set_var(kname, index.to(int))
                                if isset(iname) : inner.set_var(iname, index.to(int))
                                this.render_nodes(node.body, inner, state, out) !>
                            }
                        } else {
                            each 0 .. count as index {
                                inner.slot_value = lv.list_get(index)
                                if isset(kname) : inner.set_var(kname, index.to(int))
                                if isset(iname) : inner.set_var(iname, index.to(int))
                                this.render_nodes(node.body, inner, state, out) !>
                            }
                        }
                        continue
                    }
                    default => {}
                }
                let list = datum_to_json(list_datum)
                let items: ?Array[json.Value] = null
                let keys: ?Array[String] = null
                match list {
                    Array[json.Value] as array => items = array
                    Map[json.Value] as object => {
                        items = object.values()
                        keys = object.keys()
                    }
                    default => {}
                }
                if !isset(items) : this.fail("@each value must be an array or object", node.line, node.col, node.offset, state)
                if items.length == 0 {
                    let empty = node.empty_body
                    if isset(empty) : this.render_nodes(empty, frame, state, out) !>
                    continue
                }
                let inner = Frame { parent: frame, slot_name: node.vname }
                each items as item, index {
                    inner.slot_value = datum_from_json(item)
                    let kname = node.kname
                    if isset(kname) {
                        if isset(keys) : inner.set_var(kname, keys.get(index) !? "")
                        else : inner.set_var(kname, index.to(int))
                    }
                    let iname = node.iname
                    if isset(iname) : inner.set_var(iname, index.to(int))
                    this.render_nodes(node.body, inner, state, out) !>
                }
            } else if node.type == NODE_INCLUDE {
                let included = this.load(node.name, state, node.line, node.col, node.offset) !>
                let include_frame = frame
                let include_root = state.root
                let expr = node.expr
                if isset(expr) {
                    // `@include("x", value)`: the partial sees only that value
                    include_root = datum_snapshot(this.eval_datum(expr, frame, state) !>)
                    include_frame = Frame {}
                }
                let stack = state.ensure_templates()
                this.enter(stack, node.name, state.depth, state, node.line, node.col, node.offset) !>
                let inc_scanner = this.child_scanner(node, state)
                this.render_template(included, include_frame, stack, state.depth + 1, null, include_root, inc_scanner, out) !>
                stack.pop_last() !? ""
            } else if node.type == NODE_EXTEND {
                state.extend_offset = out.length
            } else if node.type == NODE_BLOCK {
                let chain = state.ensure_chain()
                let entry = BlockEntry { template: state.template, nodes: node.body, frame: frame, root: state.root }
                if isset(state.template.extends) {
                    // Extending template: record override for the parent layout
                    chain.add(node.name, entry)
                } else {
                    // Root or standalone template: render the most derived override or
                    // this default body, popping the fallback entry afterwards so loops
                    // do not duplicate it
                    chain.add(node.name, entry)
                    let list = chain.get_list(node.name)
                    if isset(list) {
                        let block_scanner = this.child_scanner(node, state)
                        this.render_block_layer(node.name, list, 0, state, block_scanner, out, node.line, node.col, node.offset) ! {
                            chain.pop(node.name)
                            throw E
                        }
                    }
                    chain.pop(node.name)
                }
            } else if node.type == NODE_YIELD {
                let chain = state.chain
                let list = isset(chain) ? chain.get_list(node.name) : null
                if isset(list) && list.length > 0 {
                    let block_scanner = this.child_scanner(node, state)
                    this.render_block_layer(node.name, list, 0, state, block_scanner, out, node.line, node.col, node.offset) !>
                } else {
                    let fallback = node.expr
                    if isset(fallback) {
                        let val = this.eval_datum(fallback, frame, state) !>
                        this.write_output_value(val, false, node, state, out) !>
                    } else {
                        this.fail("No block found named: " + node.name, node.line, node.col, node.offset, state)
                    }
                }
            } else if node.type == NODE_SUPER {
                let block_name = state.active_block
                if !isset(block_name) : this.fail("@super() can only be used inside a @block", node.line, node.col, node.offset, state)
                let chain = state.chain
                let list = isset(chain) ? chain.get_list(block_name) : null
                let next_layer = state.active_block_index + 1
                if !isset(list) || next_layer >= list.length {
                    this.fail("No parent block named '" + block_name + "' for @super()", node.line, node.col, node.offset, state)
                }
                this.render_block_layer(block_name, list, next_layer, state, state.scanner, out, node.line, node.col, node.offset) !>
            } else if node.type == NODE_SET {
                let expr = node.expr ?! continue
                frame.set_var(node.name, this.eval_datum(expr, frame, state) !>)
            }
        }
    }

    fn write_output_value(value: Datum, raw: bool, node: Node, state: RenderState, out: ByteBuffer) !ParseError $inline {
        let default_html = !raw && this.default_html
        let escape: ?Escape = raw ? null : this.escape
        if default_html && this.auto_escape {
            let ctx = node.ctx
            let url_prefix = node.url_prefix
            let sc = state.scanner
            if isset(sc) {
                ctx = sc.output_ctx()
                if is_url_ctx(ctx) : url_prefix = sc.attr_val_prefix
                if sc.state == SCAN_BEFORE_ATTR_VAL : sc.state = SCAN_ATTR_VAL_UNQ
            }
            if ctx != CTX_TEXT && ctx != CTX_ATTR_DQ && ctx != CTX_ATTR_SQ {
                write_context_escaped(value, ctx, url_prefix, out) ! throw .write(state.template.name ?? "?", "The escape function failed")
                return
            }
        }
        // Strings and numbers fast-path straight to `out` without converting through `json.Value`
        match value {
            String as text => {
                if default_html {
                    html.escape_into(text, out) ! throw .write(state.template.name ?? "?", "The escape function failed")
                } else if isset(escape) {
                    escape(text, out) ! throw .write(state.template.name ?? "?", "The escape function failed")
                } else {
                    out.write(text)
                }
            }
            int as number => {
                if !isset(escape) || default_html {
                    out.write_int_ascii(number)
                } else {
                    let digits: [u8 x 65] = @undefined
                    let scratch: local mut &[u8] = &digits
                    let text = scratch.view(0, number.to_base_in(10, scratch))
                    escape(text, out) ! throw .write(state.template.name ?? "?", "The escape function failed")
                }
            }
            float as number => {
                let digits: [u8 x 65] = @undefined
                let scratch: local mut &[u8] = &digits
                let text = scratch.view(0, number.to_shortest_string_in(scratch))
                if !isset(escape) || default_html : out.write(text)
                else : escape(text, out) ! throw .write(state.template.name ?? "?", "The escape function failed")
            }
            default => {
                let text = value_text(datum_to_json(value))
                if default_html {
                    html.escape_into(text, out) ! throw .write(state.template.name ?? "?", "The escape function failed")
                } else if isset(escape) {
                    escape(text, out) ! throw .write(state.template.name ?? "?", "The escape function failed")
                } else {
                    out.write(text)
                }
            }
        }
    }

    // ---- Expressions ---------------------------------------------------------------

    fn eval_datum(expr: Expr, frame: Frame, state: RenderState) Datum !ParseError {
        if expr.type == EXPR_VAR || expr.type == EXPR_MEMBER || expr.type == EXPR_INDEX {
            return this.lookup(expr, frame, state, false) !>
        }
        return datum_from_json(this.eval(expr, frame, state) !>)
    }

    fn eval(expr: Expr, frame: Frame, state: RenderState) json.Value !ParseError {
        if expr.type == EXPR_LITERAL : return expr.value
        if expr.type == EXPR_VAR || expr.type == EXPR_MEMBER || expr.type == EXPR_INDEX {
            return datum_to_json(this.lookup(expr, frame, state, false) !>)
        }
        if expr.type == EXPR_NOT {
            let inner = expr.left ?! return null
            return json.from(!value_truthy(this.eval(inner, frame, state) !>))
        }
        if expr.type == EXPR_AND || expr.type == EXPR_OR {
            let left = expr.left ?! return null
            let right = expr.right ?! return null
            let first = value_truthy(this.eval(left, frame, state) !>)
            if expr.type == EXPR_AND && !first : return json.from(false)
            if expr.type == EXPR_OR && first : return json.from(true)
            return json.from(value_truthy(this.eval(right, frame, state) !>))
        }
        if expr.type == EXPR_COMPARE {
            let left = expr.left ?! return null
            let right = expr.right ?! return null
            let a = this.eval(left, frame, state) !>
            let b = this.eval(right, frame, state) !>
            let op = expr.op
            if a.is_number && b.is_number {
                let x = value_number(a)
                let y = value_number(b)
                if op == "==" : return json.from(x == y)
                if op == "!=" : return json.from(x != y)
                if op == "<" : return json.from(x < y)
                if op == "<=" : return json.from(x <= y)
                if op == ">" : return json.from(x > y)
                return json.from(x >= y)
            }
            // Anything else compares by its text form; only equality is defined
            let equal = value_text(a) == value_text(b)
            if op == "==" : return json.from(equal)
            if op == "!=" : return json.from(!equal)
            return json.from(false)
        }
        if expr.type == EXPR_ARITH {
            let left = expr.left ?! return null
            let right = expr.right ?! return null
            return this.arith(expr, this.eval(left, frame, state) !>, this.eval(right, frame, state) !>, state) !>
        }
        if expr.type == EXPR_NEGATE {
            let inner = expr.left ?! return null
            let value = this.eval(inner, frame, state) !>
            if value.is_int : return json.from(0 - value_int(value))
            if value.is_float : return json.from(0.0 - value_number(value))
            this.fail("'-' needs a number, not " + value_kind(value), expr.line, expr.col, expr.offset, state)
        }
        if expr.type == EXPR_ISSET {
            let inner = expr.left ?! return null
            let found = this.lookup(inner, frame, state, true) ! {
                match E {
                    .missing(_, _, _) => return json.from(false)
                    default => throw E
                }
            }
            return json.from(!datum_is_null(found))
        }
        if expr.type == EXPR_LEN {
            let inner = expr.left ?! return null
            let found = this.lookup(inner, frame, state, true) ! {
                match E {
                    .missing(_, _, _) => return json.from(0)
                    default => throw E
                }
            }
            return json.from(datum_size(found))
        }
        if expr.type == EXPR_FILTER {
            let inner = expr.left ?! return null
            let value = this.eval(inner, frame, state) !>
            let args = Array[json.Value]{}
            each expr.args as arg : args.append(this.eval(arg, frame, state) !>)
            let custom = this.engine.filter(expr.name)
            if isset(custom) : return custom(value, args)
            let builtin = builtin_filter(expr.name, value, args)
            if isset(builtin) : return builtin
            this.fail("Unknown filter '" + expr.name + "'", expr.line, expr.col, expr.offset, state)
        }
        this.fail("Invalid expression", expr.line, expr.col, expr.offset, state)
    }

    // `+ - * / %`: numbers compute, `+` with text joins the text forms. Two integers give an
    // integer, except a division that does not come out even
    fn arith(expr: Expr, a: json.Value, b: json.Value, state: RenderState) json.Value !ParseError {
        let op = expr.op
        if op == "+" && (a.is_string || b.is_string) : return json.from(value_text(a) + value_text(b))
        if !a.is_number || !b.is_number {
            this.fail("'" + op + "' needs numbers, not " + value_kind(a) + " and " + value_kind(b), expr.line, expr.col, expr.offset, state)
        }
        if a.is_int && b.is_int {
            let x = value_int(a)
            let y = value_int(b)
            if op == "+" : return json.from(x + y)
            if op == "-" : return json.from(x - y)
            if op == "*" : return json.from(x * y)
            if y == 0 : this.fail("Division by zero", expr.line, expr.col, expr.offset, state)
            // `int.$min / -1` overflows the division; it wraps like `+` and `*`
            if y == -1 : return json.from(op == "%" ? 0 : 0 - x)
            if op == "%" : return json.from(x % y)
            if x % y == 0 : return json.from(x / y)
            return json.from(x.to(float) / y.to(float))
        }
        let x = value_number(a)
        let y = value_number(b)
        if op == "+" : return json.from(x + y)
        if op == "-" : return json.from(x - y)
        if op == "*" : return json.from(x * y)
        if op == "%" : this.fail("'%' needs integers", expr.line, expr.col, expr.offset, state)
        if y == 0.0 : this.fail("Division by zero", expr.line, expr.col, expr.offset, state)
        return json.from(x / y)
    }

    // Resolves a variable path. With `probe` a missing step throws `.missing` instead of
    // failing the render, which `@isset` and `@len` turn into their answer.
    fn lookup(expr: Expr, frame: Frame, state: RenderState, probe: bool) Datum !ParseError {
        if expr.type == EXPR_VAR {
            let name = expr.name
            let f: ?Frame = frame
            while isset(f) {
                if f.slot_name.bytes > 0 && f.slot_name == name : return f.slot_value
                let vars = f.vars
                if isset(vars) {
                    vars.get(name) -> value : return value
                }
                f = f.parent
            }
            match state.root {
                ObjectView as o => {
                    let field = o.get_field(name)
                    if isset(field) : return field
                }
                Map[json.Value] as obj => {
                    obj.get(name) -> value : return datum_from_json(value)
                }
                default => {}
            }
            if probe : throw .missing(state.template.name ?? "?", "Data not found", expr.line)
            this.fail("Data not found: '" + name + "'", expr.line, expr.col, expr.offset, state)
        }
        if expr.type == EXPR_MEMBER {
            let left = expr.left ?! return null
            let owner = this.lookup_or_eval(left, frame, state, probe) !>
            match owner {
                ObjectView as o => {
                    let field = o.get_field(expr.name)
                    if isset(field) : return field
                }
                Map[json.Value] as obj => {
                    obj.get(expr.name) -> value : return datum_from_json(value)
                }
                default => {}
            }
            if probe : throw .missing(state.template.name ?? "?", "Data not found", expr.line)
            this.fail("Property not found: '" + expr.name + "'", expr.line, expr.col, expr.offset, state)
        }
        if expr.type == EXPR_INDEX {
            let left = expr.left ?! return null
            let key_expr = expr.right ?! return null
            let owner = this.lookup_or_eval(left, frame, state, probe) !>
            let key = this.eval(key_expr, frame, state) !>
            match key {
                int as index => {
                    if index >= 0 {
                        let idx = index.to(uint)
                        match owner {
                            ListView as lv => {
                                if idx < lv.list_len() : return lv.list_get(idx)
                            }
                            Array[json.Value] as arr => {
                                arr.get(idx) -> value : return datum_from_json(value)
                            }
                            default => {}
                        }
                    }
                }
                String as name => {
                    match owner {
                        ObjectView as o => {
                            let field = o.get_field(name)
                            if isset(field) : return field
                        }
                        Map[json.Value] as obj => {
                            obj.get(name) -> value : return datum_from_json(value)
                        }
                        default => {}
                    }
                }
                default => {}
            }
            if probe : throw .missing(state.template.name ?? "?", "Data not found", expr.line)
            this.fail("Indexed value not found", expr.line, expr.col, expr.offset, state)
        }
        return datum_from_json(this.eval(expr, frame, state) !>)
    }

    fn lookup_or_eval(expr: Expr, frame: Frame, state: RenderState, probe: bool) Datum !ParseError {
        if expr.type == EXPR_VAR || expr.type == EXPR_MEMBER || expr.type == EXPR_INDEX : return this.lookup(expr, frame, state, probe) !>
        return datum_from_json(this.eval(expr, frame, state) !>)
    }

    // ---- Engine -----------------------------------------------------------------

    fn load(name: String, state: RenderState, line: uint, col: uint, offset: uint) Template !ParseError {
        return this.engine.compiled_template(name) ! {
            match E {
                .missing(_, _, _) => this.fail("Template not found: " + name, line, col, offset, state)
                default => throw E
            }
        }
    }

    // Pushes `name` on the stack of templates being rendered; the caller pops it. `depth` is
    // the nesting of the template doing the include or extend.
    fn enter(templates: Array[String], name: String, depth: uint, state: RenderState, line: uint, col: uint, offset: uint) !ParseError {
        each templates as active {
            if active == name {
                let chain = templates.copy()
                chain.append(name)
                this.fail("Template cycle: " + chain.join(" -> "), line, col, offset, state)
            }
        }
        let max_depth = TEMPLATE_MAX_DEPTH
        let options = this.options
        if isset(options) : max_depth = options.max_depth
        if depth + 1 > max_depth : this.fail("Template depth exceeds the maximum of " + max_depth, line, col, offset, state)
        templates.append(name)
    }

    fn fail(msg: String, line: uint, col: uint, offset: uint, state: RenderState) !ParseError $throw {
        let name = state.template.name ?? "{content}"
        let loc = col > 0 ? "line " + line + ", column " + col : "line " + line
        throw .parse(
            state.template.name ?? "?",
            "[ Error at " + loc + " in " + name + " | Error: " + msg + " ]",
            offset,
            line
        )
    }
}

// What one template's render carries besides its frames
class RenderState {
    template: Template
    templates: ?Array[String] (null)
    depth: uint
    // Lazily allocated blocks of the inheritance chain being rendered (most derived at index 0)
    chain: ?BlockChain (null)
    root: Datum
    // Active block name and layer index when rendering inside a block (for `@super()`)
    active_block: ?String (null)
    active_block_index: uint (0)
    // Lazily allocated stack of active `name#layer` blocks to detect cyclic `@yield`
    active_blocks: ?Array[String] (null)
    // Live HTML scanner when rendering a sub-template or block embedded inside `<script>`,
    // `<style>`, or an HTML attribute; `null` on the normal HTML text hot path
    scanner: ?HtmlScanner (null)
    // Where `@extend` split this template's own output
    extend_offset: uint (0)

    fn ensure_templates() Array[String] {
        let t = this.templates
        if isset(t) : return t
        let created = Array[String]{}
        let n = this.template.name
        if isset(n) : created.append(n)
        this.templates = created
        return created
    }

    fn ensure_chain() BlockChain {
        let c = this.chain
        if isset(c) : return c
        let created = BlockChain {}
        this.chain = created
        return created
    }
}

// Trims whitespace at both ends of what was written from `start` on
fn trim_region(out: ByteBuffer, start: uint) {
    let end = out.length
    while end > start && out.get(end - 1).is_whitespace() : end--
    out.truncate(end)
    let lead = start
    while lead < end && out.get(lead).is_whitespace() : lead++
    if lead > start : out.clear_range(start, lead - start)
}

/// HTML escaping as an `Escape`: the default of `Engine.escape` and `RenderOptions.escape`.
+ fn html_escape(input: local &[u8], out: io.Writer) uint !io.IoError {
    return html.escape_into(input, out) !>
}

global default_html_escape: Escape (html_escape)

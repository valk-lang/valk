use json

// Internal lazy view over typed Valk values so template rendering reads struct/class fields
// and iterates typed arrays directly without converting every element into a JSON HashMap.

interface ObjectView {
    fn get_field(name: String) ?Datum;
    fn field_count() uint;
    fn to_json() json.Value;
    fn snapshot() ObjectView;
}

interface ListView {
    fn list_len() uint;
    fn list_get(index: uint) Datum;
    fn make_cursor() ?ListCursor;
    fn to_json() json.Value;
}

interface ListCursor {
    fn set_index(index: uint);
    fn as_datum() Datum;
}

union Datum : String | int | float | bool | Array[json.Value] | Map[json.Value] | ObjectView | ListView | null {}

class TypedObject[T] is ObjectView {
    data: T

    fn get_field(name: String) ?Datum {
        let obj = this.data
        #loop object obj as prop
        #if prop.$tag("json") != "-"
        #if prop.$has_tag("json")
        if name == prop.$tag("json", prop.name) : return datum_from(prop)
        #else
        if name == prop.name : return datum_from(prop)
        #end
        #end
        #end
        return null
    }

    fn field_count() uint {
        let count: uint = 0
        let obj = this.data
        #loop object obj as prop
        #if prop.$tag("json") != "-"
        count++
        #end
        #end
        return count
    }

    fn to_json() json.Value {
        return json.from(this.data)
    }

    fn snapshot() ObjectView {
        return this
    }
}

class TypedListCursor[T] is ListCursor, ObjectView {
    items: Array[T]
    index: uint (0)

    fn set_index(index: uint) {
        this.index = index
    }

    fn as_datum() Datum {
        return this.to(ObjectView)
    }

    fn get_field(name: String) ?Datum {
        let item = this.items.get(this.index) ! return null
        #loop object item as prop
        #if prop.$tag("json") != "-"
        #if prop.$has_tag("json")
        if name == prop.$tag("json", prop.name) : return datum_from(prop)
        #else
        if name == prop.name : return datum_from(prop)
        #end
        #end
        #end
        return null
    }

    fn field_count() uint {
        let count: uint = 0
        let item = this.items.get(this.index) ! return 0
        #loop object item as prop
        #if prop.$tag("json") != "-"
        count++
        #end
        #end
        return count
    }

    fn to_json() json.Value {
        let item = this.items.get(this.index) ! return null
        return json.from(item)
    }

    fn snapshot() ObjectView {
        let item = this.items.get(this.index) ! return this
        return TypedObject[T] { data: item }
    }
}

class TypedList[T] is ListView {
    items: Array[T]

    fn list_len() uint {
        return this.items.length
    }

    fn list_get(index: uint) Datum {
        let item = this.items.get(index) ! return null
        return datum_from(item)
    }

    fn make_cursor() ?ListCursor {
        #if T.$nonnull.$is_structural && !T.$is_nullable && !T.$nonnull.$is_type_of(json.Value) && !T.$nonnull.$is_type_of(String) && !T.$has_method(to_json_string) && !T.$has_method(to_json_value) && !T.$has_method(to_json_value_with_stack) && !T.$has_method(template_datum)
        let first = this.items.get(0) ! return null
        let has_omit = false
        #loop object first as prop
        #if prop.$has_tag("omitempty")
        has_omit = true
        #end
        #end
        if !has_omit : return TypedListCursor[T] { items: this.items }
        #end
        return null
    }

    fn to_json() json.Value {
        return json.from(this.items)
    }
}

extend Array[TPL_ITEM] {
    - fn template_datum() Datum {
        #if TPL_ITEM.$is_type_of(json.Value)
        return this
        #else
        return TypedList[TPL_ITEM] { items: this }.to(ListView)
        #end
    }
}

fn datum_from_json(v: json.Value) Datum {
    return match v : Datum {
        null => null
        String as s => s
        int as n => n
        float as n => n
        bool as b => b
        Array[json.Value] as a => a
        Map[json.Value] as m => m
    }
}

fn datum_from(data: $T) Datum {
    if !isset(data) : return null
    #if T.$nonnull.$is_type_of(Datum)
    return data
    #elif T.$nonnull.$is_type_of(json.Value)
    return datum_from_json(data)
    #elif T.$nonnull.$is_type_of(String) || T.$nonnull.$is_type_of(Array[json.Value]) || T.$nonnull.$is_type_of(Map[json.Value]) || T.$is_bool
    return data
    #elif T.$is_integer
    return data.to(int)
    #elif T.$is_float
    return data.to(float)
    #elif T.$has_method(template_datum)
    return data.template_datum()
    #elif T.$has_method(to_json_string) || T.$has_method(to_json_value) || T.$has_method(to_json_value_with_stack) || !T.$nonnull.$is_structural
    return datum_from_json(json.from(data))
    #else
    let has_omit = false
    #loop object data as prop
    #if prop.$has_tag("omitempty")
    has_omit = true
    #end
    #end
    if has_omit : return datum_from_json(json.from(data))
    return TypedObject[T.$nonnull] { data: data }.to(ObjectView)
    #end
}

fn datum_to_json(d: Datum) json.Value {
    return match d : json.Value {
        null => null
        String as s => s
        int as n => n
        float as n => n
        bool as b => b
        Array[json.Value] as a => a
        Map[json.Value] as m => m
        ObjectView as o => o.to_json()
        ListView as l => l.to_json()
    }
}

fn datum_snapshot(d: Datum) Datum {
    return match d : Datum {
        ObjectView as o => o.snapshot()
        default => d
    }
}

fn datum_is_null(d: Datum) bool {
    return match d : bool {
        null => true
        default => false
    }
}

fn datum_truthy(d: Datum) bool {
    return match d : bool {
        null => false
        String as s => s.bytes > 0
        int as n => n != 0
        float as n => n != 0.0
        bool as b => b
        Array[json.Value] as a => a.length > 0
        Map[json.Value] as m => m.length > 0
        ObjectView as o => o.field_count() > 0
        ListView as l => l.list_len() > 0
    }
}

fn datum_size(d: Datum) int {
    return match d : int {
        String as s => s.bytes.to(int)
        Array[json.Value] as a => a.length.to(int)
        Map[json.Value] as m => m.length.to(int)
        ObjectView as o => o.field_count().to(int)
        ListView as l => l.list_len().to(int)
        default => 0
    }
}

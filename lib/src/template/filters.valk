use json
use html
use url

/// A filter applied with `{{ value | name(args) }}`: gets the value and the arguments
/// and returns the value to continue with.
+ type Filter (fn(json.Value, Array[json.Value])(json.Value))

// The filters every engine has. A custom filter of the same name takes precedence.
fn builtin_filter(name: String, value: json.Value, args: Array[json.Value]) ?json.Value {
    let arg0 = args.get(0) !? null
    let arg1 = args.get(1) !? null
    if name == "upper" : return json.from(value_text(value).upper())
    if name == "lower" : return json.from(value_text(value).lower())
    if name == "capitalize" {
        let text = value_text(value)
        if text.bytes == 0 : return json.from(text)
        return json.from(text.range(0, 1).upper() + text.range(1, text.bytes - 1))
    }
    if name == "trim" : return json.from(value_text(value).trim())
    if name == "length" || name == "len" : return json.from(value_size(value))
    if name == "default" {
        if isset(arg0) && (value.is_null || value_text(value).bytes == 0) : return arg0
        return value
    }
    if name == "join" {
        let sep = isset(arg0) ? value_text(arg0) : ", "
        let parts = Array[String]{}
        match value {
            json.ArrayValue as array => each array.values as item : parts.append(value_text(item))
            json.ObjectValue as object => each object.values as item : parts.append(value_text(item))
            default => parts.append(value_text(value))
        }
        return json.from(parts.join(sep))
    }
    if name == "first" || name == "last" {
        match value {
            json.ArrayValue as array => {
                let count = array.values.length
                if count == 0 : return null
                return array.values.get(name == "first" ? 0 : count - 1) !? null
            }
            String as text => {
                if text.bytes == 0 : return json.from("")
                return json.from(name == "first" ? text.range(0, 1) : text.range(text.bytes - 1, 1))
            }
            default => return null
        }
    }
    if name == "reverse" {
        match value {
            json.ArrayValue as array => return json.new_array(array.values.reversed())
            String as text => {
                let chars = Array[String]{}
                each text.utf8.chars() as ch : chars.append(ch)
                return json.from(chars.reversed().join(""))
            }
            default => return value
        }
    }
    if name == "round" {
        let decimals: uint = isset(arg0) ? arg0.int.to(uint) : 0
        return json.from(value.float.to_string(decimals))
    }
    if name == "truncate" {
        let text = value_text(value)
        let limit: uint = isset(arg0) ? arg0.int.to(uint) : 100
        let suffix = isset(arg1) ? value_text(arg1) : "…"
        if text.utf8.length <= limit : return json.from(text)
        return json.from(text.utf8.range(0, limit) + suffix)
    }
    if name == "replace" {
        if !isset(arg0) : return value
        return json.from(value_text(value).replace(value_text(arg0), isset(arg1) ? value_text(arg1) : ""))
    }
    if name == "json" : return json.from(json.encode(value))
    if name == "escape" : return json.from(html.escape(value_text(value)))
    if name == "urlencode" : return json.from(url.encode(value_text(value)))
    if name == "keys" {
        match value {
            json.ObjectValue as object => {
                let keys = Array[json.Value]{}
                each object.values.keys() as key : keys.append(json.from(key))
                return json.new_array(keys)
            }
            default => return json.new_array(Array[json.Value]{})
        }
    }
    return null
}

// The text of a value in output and comparisons: `null`, arrays and objects are empty
fn value_text(value: json.Value) String {
    return match value : String {
        null => ""
        String as text => text
        int as number => number.to(String)
        float as number => number.to(String)
        bool as enabled => enabled ? "true" : "false"
        json.ArrayValue as _ => ""
        json.ObjectValue as _ => ""
    }
}

fn value_size(value: json.Value) uint {
    return match value : uint {
        null => 0
        String as text => text.utf8.length
        json.ArrayValue as array => array.values.length
        json.ObjectValue as object => object.values.length
        default => 0
    }
}

fn value_truthy(value: json.Value) bool {
    return match value : bool {
        null => false
        bool as enabled => enabled
        int as number => number > 0
        float as number => number > 0
        String as text => text.length > 0
        json.ArrayValue as array => array.values.length > 0
        json.ObjectValue as object => object.values.length > 0
    }
}

fn value_int(value: json.Value) int {
    return match value : int {
        int as number => number
        default => 0
    }
}

// The kind of a value, for error messages
fn value_kind(value: json.Value) String {
    return match value : String {
        null => "null"
        String as _ => "text"
        int as _ => "a number"
        float as _ => "a number"
        bool as _ => "a bool"
        json.ArrayValue as _ => "a list"
        json.ObjectValue as _ => "an object"
    }
}

fn value_number(value: json.Value) float {
    return match value : float {
        int as number => number.to(float)
        float as number => number
        default => 0.0
    }
}


value TEMPLATE_MAX_DEPTH (64)

/// Options for `render` and `render_content`.
+ class RenderOptions {
    /// Function applied to every `{{ }}` output; `null` uses HTML escaping.
    ///
    /// Escaping cannot be switched off with `null`; pass a function that returns its argument
    /// unchanged, or use `{! !}` in the template.
    + escape: ?fn(String)(String) (null)
    /// Maximum nesting of `@include`/`@extend` templates.
    ///
    /// For `render` the named template counts as the first level, so `1` allows no
    /// includes and `0` fails at once; `render_content` does not count its own text.
    + max_depth: uint (TEMPLATE_MAX_DEPTH)
}

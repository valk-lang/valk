use io

value TEMPLATE_MAX_DEPTH (64)

/// A function that writes `input` escaped for the output format to `out` and returns the
/// bytes written; `Engine.escape` holds one. Writing straight into the page avoids a
/// string per value.
+ type Escape (fn(local &[u8], io.Writer)(uint !io.IoError))

/// A fallback loader that resolves a template name to its source text, or `null` when
/// unknown; `Engine.loader` holds one.
+ type Loader (fn(String)(?String))

/// Options for one `render` or `render_content` call.
+ class RenderOptions {
    /// The `Escape` applied to every `{{ }}` output of this render; HTML escaping by
    /// default, `null` for none. Options replace the engine's `escape` for the render, so
    /// an engine with an escape of its own passes it along: `RenderOptions { escape:
    /// engine.escape, max_depth: 2 }`.
    + escape: ?Escape (default_html_escape)
    /// Maximum nesting of `@include`/`@extend` templates.
    ///
    /// The rendered template itself is not counted, for `render` and `render_content`
    /// alike: `0` allows no includes, `1` allows includes that include nothing further.
    + max_depth: uint (TEMPLATE_MAX_DEPTH)
    /// Overrides `Engine.auto_escape` for this render when set (`null` inherits the
    /// engine's setting). Only applies when `escape` is the default `html_escape`.
    + auto_escape: ?bool (null)
}

use json

// The compiled form of a template: a tree that `Renderer` walks. A tree is built once per
// source and never changed afterwards, so every thread can keep its own copy.

value NODE_TEXT (0)
value NODE_OUTPUT (1)
value NODE_IF (2)
value NODE_EACH (3)
value NODE_INCLUDE (4)
value NODE_EXTEND (5)
value NODE_BLOCK (6)
value NODE_YIELD (7)
value NODE_SET (8)

class Template {
    name: ?String (null)
    nodes: Array[Node] (.{})
    // Set when the template has an `@extend`, with the line it is on
    extends: ?String (null)
    extends_line: uint (0)
}

class Node {
    type: int
    line: uint (1)
    // NODE_TEXT
    text: String ("")
    // NODE_OUTPUT: the expression; NODE_IF: unused (see branches); NODE_EACH: the list;
    // NODE_INCLUDE: the optional data; NODE_SET: the value
    expr: ?Expr (null)
    // NODE_OUTPUT: `{! !}` writes without escaping
    raw: bool (false)
    // NODE_IF: the `@if`/`@elif` arms, then an `@else` arm without a condition
    branches: Array[Branch] (.{})
    // NODE_EACH, NODE_BLOCK: the body
    body: Array[Node] (.{})
    // NODE_EACH: the `@empty` arm
    empty_body: ?Array[Node] (null)
    // NODE_EACH: the loop variable names
    vname: String ("")
    kname: ?String (null)
    iname: ?String (null)
    // NODE_INCLUDE / NODE_EXTEND / NODE_BLOCK / NODE_YIELD: the template or block name;
    // NODE_SET: the variable name
    name: String ("")
}

class Branch {
    cond: ?Expr (null)
    nodes: Array[Node] (.{})
}

value EXPR_LITERAL (0)
value EXPR_VAR (1)
value EXPR_MEMBER (2)
value EXPR_INDEX (3)
value EXPR_NOT (4)
value EXPR_AND (5)
value EXPR_OR (6)
value EXPR_COMPARE (7)
value EXPR_ISSET (8)
value EXPR_LEN (9)
value EXPR_FILTER (10)
value EXPR_ARITH (11)
value EXPR_NEGATE (12)

class Expr {
    type: int
    line: uint (1)
    // EXPR_LITERAL
    value: json.Value (null)
    // EXPR_VAR: the variable; EXPR_MEMBER: the property; EXPR_FILTER: the filter
    name: String ("")
    // EXPR_MEMBER / EXPR_INDEX / EXPR_NOT / EXPR_AND / EXPR_OR / EXPR_COMPARE / EXPR_ISSET /
    // EXPR_LEN / EXPR_FILTER: the operand(s)
    left: ?Expr (null)
    right: ?Expr (null)
    // EXPR_COMPARE: `==`, `!=`, `<`, `<=`, `>`, `>=`; EXPR_ARITH: `+`, `-`, `*`, `/`, `%`
    op: String ("")
    // EXPR_FILTER: the arguments after the filter name
    args: Array[Expr] (.{})
}

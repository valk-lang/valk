
/// Thrown by `render` and `render_content` when a template cannot be rendered.
///
/// - `template_not_found(template_name, message)`: `render` was given a name that no
///   template was registered under.
/// - `parse(template_name, message, index, line)`: a syntax error, an unknown variable or
///   property, an unknown template in `@include`/`@extend`, a cycle or too deep nesting.
/// - `missing(template_name, message, line)`: used inside `@isset`/`@len`; it never leaves
///   `render`.
/// - `write(template_name, message)`: `render_into` / `render_content_into` could not write
///   to the writer.
+ union ParseError {
    template_not_found(String, String)
    parse(String, String, uint, uint)
    missing(String, String, uint)
    write(String, String)

    + get template_name: String {
        return match this : String {
            .template_not_found(name, _) => name
            .parse(name, _, _, _) => name
            .missing(name, _, _) => name
            .write(name, _) => name
        }
    }

    + get message: String {
        return match this : String {
            .template_not_found(_, msg) => msg
            .parse(_, msg, _, _) => msg
            .missing(_, msg, _) => msg
            .write(_, msg) => msg
        }
    }

    + get index: uint {
        return match this : uint {
            .parse(_, _, idx, _) => idx
            default => 0
        }
    }

    + get line: uint {
        return match this : uint {
            .parse(_, _, _, ln) => ln
            .missing(_, _, ln) => ln
            default => 0
        }
    }

    /// 1-based column number where the error occurred, or `0` when not available.
    + get column: uint {
        return match this : uint {
            .parse(_, msg, _, _) => parse_error_column(msg)
            default => 0
        }
    }

    + fn to_string() String $auto {
        return this.message
    }
}

fn parse_error_column(msg: String) uint {
    if !msg.starts_with("[ Error at line ") : return 0
    let marker = ", column "
    let pos = msg.index_of(marker) ! return 0
    let i = pos + marker.bytes
    let col: uint = 0
    let digits: uint = 0
    while i < msg.bytes {
        let ch = msg.get(i)
        if ch < '0' || ch > '9' : break
        col = col * 10 + (ch - '0').to(uint)
        digits++
        i++
    }
    return digits > 0 ? col : 0
}

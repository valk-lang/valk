use ext
use io
use core

value default_read_size (32 * 1024)

#if OS == "win"
value append_access (ext.FILE_APPEND_DATA | ext.FILE_WRITE_ATTRIBUTES | ext.FILE_WRITE_EA | ext.READ_CONTROL | ext.SYNCHRONIZE)
value FSCTL_GET_REPARSE_POINT (0x000900A8)
value REPARSE_TAG_SYMLINK (0xA000000C)
value REPARSE_TAG_MOUNT_POINT (0xA0000003)
#end

/// How `open` treats the contents of a file it opens for writing.
+ enum WriteMode {
    /// Keeps the existing contents.
    preserve
    /// Empties the file when it is opened.
    truncate
    /// Keeps the existing contents and writes at the end of the file.
    append
}

/// Options for `open` and `stream`; the defaults open an existing file read-only.
+ struct OpenOptions {
    /// Opens the file for reading.
    + read: bool (true)
    /// Opens the file for writing in the given mode; `null` opens it without write access.
    + write: ?WriteMode (null)
    /// Creates the file when it does not exist; requires `write`.
    + create: bool (false)
    /// Fails when the file already exists; requires `create`.
    + exclusive: bool (false)
    /// Permission bits of a newly created file, before the umask; ignored on Windows.
    + permissions: u32 (0c644)
}

/// Opens the file at `path` and returns its raw descriptor.
///
/// Close the descriptor with `io.close`; `stream` wraps it in a `FileStream` that tracks the
/// position instead. Throws `.open` when the options conflict (neither `read` nor `write`,
/// `create` without `write`, `exclusive` without `create`) or the OS refuses. On Windows the
/// handle is opened for overlapped I/O, and other handles may only read the file while it is
/// open. In `WriteMode.append` every write goes to the end of the file on every OS.
+ fn open(path: String, options: ?OpenOptions (null)) Fd !io.IoError {
    #if OS == "win"
    @unsafe
    #end
    let opts = options ?? OpenOptions {}
    let writable = isset(opts.write)
    let truncate = opts.write == WriteMode.truncate
    if !opts.read && !writable : throw .open
    if opts.create && !writable : throw .open
    if opts.exclusive && !opts.create : throw .open

    // let flags : i32 = (ext.O_RDONLY | ext.O_NONBLOCK).to(i32)
    #if OS == "win"
    let access: u32 = 0
    if opts.read : access = access | ext.GENERIC_READ
    // Append-only access (no FILE_WRITE_DATA) makes every write go to the end, like O_APPEND
    if writable : access = access | (opts.write == WriteMode.append ? append_access : ext.GENERIC_WRITE)
    // Shade mode
    let share_mode: u32 = ext.FILE_SHARE_READ
    // dwCreationDisposition
    let despo: u32 = ext.OPEN_EXISTING
    if writable {
        despo = truncate ? ext.TRUNCATE_EXISTING : ext.OPEN_EXISTING
        if opts.create : despo = truncate ? ext.CREATE_ALWAYS : ext.OPEN_ALWAYS
    }
    if opts.exclusive : despo = ext.CREATE_NEW
    // Flags
    let flags: u32 = ext.FILE_FLAG_OVERLAPPED | ext.FILE_FLAG_SEQUENTIAL_SCAN
    //
    let wide_path = windows_path(path) ! throw .open
    let fd = ext.CreateFileW(wide_path.items().@cast(ptr), access, share_mode, null, despo, flags, 0)
    if fd == ext.INVALID_HANDLE_VALUE : throw .open

    if !io.associate(fd) {
        io.close_cleanup(fd, __FILE__, __LINE__)
        throw .open
    }

    #else
    #if OS == "linux"
    @unsafe
    #end
    let flags: i32 = opts.read ? (writable ? ext.O_RDWR : ext.O_RDONLY) : ext.O_WRONLY

    if opts.create : flags = flags | ext.O_CREAT
    if opts.exclusive : flags = flags | ext.O_EXCL
    if truncate : flags = flags | ext.O_TRUNC
    if opts.write == WriteMode.append : flags = flags | ext.O_APPEND

    let fd = ext.open(path.data_cstring, flags, opts.permissions.to(i32))
    if fd < 0 {
        throw .open
    }

    #end

    return fd
}

/// Asks the OS to flush all file system buffers to disk (`sync(2)`).
///
/// On Windows it calls `FlushFileBuffers` on each fixed and removable volume, which needs
/// administrator rights; volumes that cannot be opened are skipped.
+ fn sync_all() {
    #if OS == "win"
    @unsafe
    let drives = ext.GetLogicalDrives()
    let letter: uint = 0
    while letter < 26 {
        let index = letter++
        if (drives & (1.to(u32) << index.to(u32))) == 0 : continue
        let name = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".range(index, 1)
        let root = windows_path(name + ":\\") ! continue
        let kind = ext.GetDriveTypeW(root.items().@cast(ptr))
        if kind != ext.DRIVE_FIXED && kind != ext.DRIVE_REMOVABLE : continue
        let volume = windows_path("\\\\.\\" + name + ":") ! continue
        let handle = ext.CreateFileW(volume.items().@cast(ptr), ext.GENERIC_READ | ext.GENERIC_WRITE,
            ext.FILE_SHARE_READ | ext.FILE_SHARE_WRITE, null, ext.OPEN_EXISTING, 0, 0)
        if handle == ext.INVALID_HANDLE_VALUE : continue
        ext.FlushFileBuffers(handle)
        ext.CloseHandle(handle)
    }
    #else
    ext.sync()
    #end
}

/// Sets the permission bits of the file at `path`, such as `0c644`.
///
/// Throws `.access` on failure. On Windows only the owner-write bit (`0c200`) is honored:
/// without it the file becomes read-only.
+ fn chmod(path: String, permissions: u32) !io.IoError {
    #if OS == "win"
    let wide_path = windows_path(path) ! throw .access
    if ext._wchmod(wide_path.items().@cast(*u16), permissions.to(i32)) == -1 : throw .access
    #else
    if ext.chmod(path.data_cstring, permissions) == -1 : throw .access
    #end
}

/// Resizes the file at `path` to `length` bytes, cutting it off or padding it with zeros.
///
/// Throws `.write` when `length` does not fit an `i64` or resizing fails. On Windows `.open`
/// means the file could not be opened.
+ fn truncate(path: String, length: uint) !io.IoError {
    if length > 9223372036854775807.to(uint) : throw .write
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! throw .open
    let fd = ext.CreateFileW(wide_path.items().@cast(ptr), ext.GENERIC_WRITE,
        ext.FILE_SHARE_READ | ext.FILE_SHARE_WRITE, null, ext.OPEN_EXISTING,
        ext.FILE_ATTRIBUTE_NORMAL, 0)
    if fd == ext.INVALID_HANDLE_VALUE : throw .open
    let failed = ext.SetFilePointerEx(fd, length.to(i64), null, 0) == 0
    if !failed : failed = ext.SetEndOfFile(fd) == 0
    if ext.CloseHandle(fd) == 0 : throw .os
    if failed : throw .write
    #else
    if ext.truncate(path.data_cstring, length.to(int)) == -1 : throw .write
    #end
}

/// Reads the whole file at `path` into a string.
///
/// Reads until the end of the file, so files that report size 0 (such as those in `/proc`)
/// and files that grow meanwhile are read completely. Throws `.open` or `.read`.
+ fn read(path: String) String !io.IoError {
    let fd = open(path) ! throw .open
    // Only a capacity hint: the file can grow meanwhile, and /proc files report 0
    let size: uint = size(path) !? 0
    let offset: uint = 0
    let buffer = ByteBuffer.new(size + 1)

    while true {
        buffer.reserve(1)
        let readcount = io.read(fd, buffer.view_spare(1024 * 1024 * 1024), offset) ! {
            io.close_cleanup(fd, __FILE__, __LINE__)
            throw .read
        }
        if readcount == 0 : break
        buffer.skip(readcount)
        offset += readcount
    }

    io.close(fd) !>
    return buffer.into_string()
}

/// Writes the whole file at `path` to `out` in chunks of `chunk_size` bytes and returns the
/// bytes written; the file is never held in memory as a whole.
///
/// Throws `.open` when the file cannot be opened, `.read` when reading fails and the
/// writer's error when `out` fails; bytes written before a failure stay written.
+ fn read_into(path: String, out: io.Writer, chunk_size: uint (65536)) uint !io.IoError {
    let source = stream(path) !>
    let count = io.copy(source, out, chunk_size) ! {
        source.close() ! {}
        throw E
    }
    source.close() !>
    return count
}

/// Writes everything `source` yields to the file at `path`, in chunks of `chunk_size`
/// bytes, and returns the bytes written; the file is created when it is missing and
/// replaced unless `append` is set.
///
/// Throws `.open` when the file cannot be opened, `.write` when writing fails and the
/// reader's error when `source` fails; a partly written file is left in place.
+ fn write_from(path: String, source: io.Reader, append: bool (false), chunk_size: uint (65536)) uint !io.IoError {
    let target = stream(path, OpenOptions { write: append ? WriteMode.append : WriteMode.truncate, create: true }) !>
    let count = io.copy(source, target, chunk_size) ! {
        target.close() ! {}
        throw E
    }
    target.close() !>
    return count
}

- fn write_all(fd: Fd, data: ptr, size: uint) !io.IoError {
    @unsafe
    let written: uint = 0
    while written < size {
        let count = io.write_bytes(fd, data + written, size - written) ! throw .write
        if count == 0 : throw .write
        written += count
    }
}

/// Writes `content` to the file at `path`, creating the file when it is missing.
///
/// Replaces the existing contents, or adds to the end when `append` is set. A new file gets
/// permissions `0c644`. Throws `.open` or `.write`.
+ fn write(path: String, content: local &[u8], append: bool (false)) !io.IoError {
    @unsafe
    let fd = open(path, OpenOptions { write: append ? WriteMode.append : WriteMode.truncate, create: true }) ! throw .open
    write_all(fd, content.data, content.length) ! {
        io.close_cleanup(fd, __FILE__, __LINE__)
        throw .write
    }
    io.close(fd) !>
}

/// Returns whether anything exists at `path`.
///
/// On Linux and macOS symlinks are followed, so a dangling link reports `false`; on Windows it
/// reports `true`.
+ fn exists(path: String) bool {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! return false
    let dwAttrib = ext.GetFileAttributesW(wide_path.items().@cast(ptr))
    return dwAttrib != ext.INVALID_FILE_ATTRIBUTES_fix
    #else
    return ext.access(path.data_cstring, ext.F_OK) == 0
    #end
}
/// Deletes the file at `path`; directories need `delete_dir` or `delete_all`.
///
/// Throws `.access` on failure, including when nothing exists at `path`.
+ fn delete_file(path: String) !io.IoError {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! throw .access
    if ext.DeleteFileW(wide_path.items().@cast(ptr)) == 0 : throw .access
    #else
    let res = ext.unlink(path.data_cstring)
    if res == -1 : throw .access
    #end
}
/// Returns whether `path` is a symbolic link, without following it.
+ fn is_symlink(path: String) bool {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! return false
    let data: ext.libc_WIN32_FIND_DATAW = @undefined
    let hFind = ext.FindFirstFileW(wide_path.items().@cast(ptr), @ref(data))
    if hFind == ext.INVALID_HANDLE_VALUE : return false
    let result = (data.dwFileAttributes & ext.FILE_ATTRIBUTE_REPARSE_POINT) != 0 && data.dwReserved0 == REPARSE_TAG_SYMLINK
    ext.FindClose(hFind)
    return result
    #else
    let buf: ext.libc_stat = @undefined
    if ext.lstat(path.data_cstring, buf.@cast(*ext.libc_stat)) == -1 : return false
    return (buf.st_mode & ext.S_IFMT) == ext.S_IFLNK
    #end
}
- fn is_traversal_link(path: String) bool {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! return false
    let attributes = ext.GetFileAttributesW(wide_path.items().@cast(ptr))
    return attributes != ext.INVALID_FILE_ATTRIBUTES_fix && (attributes & ext.FILE_ATTRIBUTE_REPARSE_POINT) != 0
    #else
    return is_symlink(path)
    #end
}
- fn delete_traversal_link(path: String) !io.IoError {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! throw .access
    let attributes = ext.GetFileAttributesW(wide_path.items().@cast(ptr))
    if attributes == ext.INVALID_FILE_ATTRIBUTES_fix : throw .access
    if (attributes & ext.FILE_ATTRIBUTE_DIRECTORY) != 0 {
        delete_dir(path) ! throw .access
    } else {
        delete_file(path) ! throw .access
    }
    #else
    delete_file(path) ! throw .access
    #end
}
/// Deletes `path` and, when it is a directory, everything inside it.
///
/// Symlinks (and junctions on Windows) are removed themselves; their targets are left alone.
/// Stops at the first failure and leaves the rest in place. Throws `.access` when an entry
/// cannot be deleted, including when `path` does not exist, and `.open` or `.read` when a
/// directory cannot be listed.
+ fn delete_all(path: String) !io.IoError {
    if is_traversal_link(path) {
        delete_traversal_link(path) !>
        return
    }
    let isdir = is_dir(path)
    if isdir {
        let list = files_in(path, false, true, true) !>
        each list as entry {
            delete_all(entry) !>
        }
        delete_dir(path) !>
    } else {
        delete_file(path) !>
    }
}
/// Moves or renames `from_path` to `to_path`.
///
/// Throws `.access` on failure. On Linux and macOS an existing file at `to_path` is replaced and
/// moving to another file system fails; on Windows the move fails when `to_path` exists.
+ fn move(from_path: String, to_path: String) !io.IoError {
    #if OS == "win"
    @unsafe
    let wide_from = windows_path(from_path) ! throw .access
    let wide_to = windows_path(to_path) ! throw .access
    if ext.MoveFileW(wide_from.items().@cast(ptr), wide_to.items().@cast(ptr)) == 0 : throw .access
    #else
    let res = ext.rename(from_path.data_cstring, to_path.data_cstring)
    if res != 0 : throw .access
    #end
}

/// Copies the file or directory at `from_path` to `to_path`.
///
/// A file copy overwrites `to_path`; a new file gets `0c644`, permissions are not copied.
/// For a directory, `to_path` is created when missing (`.open` when it exists and is not a
/// directory) and the files directly inside are copied; subdirectories are copied only when
/// `recursive` is set. Symlinks inside a directory are recreated as symlinks with the same
/// target, replacing a symlink already at the destination (a Windows junction becomes a
/// directory symlink); copying a symlink itself as `from_path` throws `.access`. Copying a
/// path onto itself does nothing.
+ fn copy(from_path: String, to_path: String, recursive: bool (false)) !io.IoError {
    @unsafe
    if from_path == to_path : return
    if is_traversal_link(from_path) : throw .access
    let isdir = is_dir(from_path)
    if isdir {
        if !exists(to_path) : create_dir(to_path) ! throw .access
        else if !is_dir(to_path) : throw .open
        // Copy files, links and (when recursive) subdirectories
        let files = files_in(from_path, false, true, true, true) !>
        each files as fn {
            let from = add(from_path, fn)
            let to = add(to_path, fn)
            if is_traversal_link(from) {
                copy_link(from, to) ! throw .write
                continue
            }
            if !recursive && is_dir(from) : continue
            copy(from, to, recursive) ! throw .write
        }
    } else {
        let in = open(from_path) ! throw .open
        #if OS == "win"
        // The source handle denies writes to the same file, including aliases.
        let out = open(to_path, OpenOptions { write: WriteMode.truncate, create: true }) ! {
            io.close_cleanup(in, __FILE__, __LINE__)
            throw .open
        }
        #else
        let out = ext.open(to_path.data_cstring, ext.O_WRONLY | ext.O_CREAT, 0c644)
        if out < 0 {
            io.close_cleanup(in, __FILE__, __LINE__)
            throw .open
        }
        let source: ext.libc_stat = @undefined
        let destination: ext.libc_stat = @undefined
        if ext.fstat(in, @ref(source)) != 0 || ext.fstat(out, @ref(destination)) != 0 {
            io.close_cleanup(in, __FILE__, __LINE__)
            io.close_cleanup(out, __FILE__, __LINE__)
            throw .open
        }
        if source.st_dev == destination.st_dev && source.st_ino == destination.st_ino {
            close_pair(in, out) !>
            return
        }
        if ext.ftruncate(out, 0) != 0 {
            io.close_cleanup(in, __FILE__, __LINE__)
            io.close_cleanup(out, __FILE__, __LINE__)
            throw .write
        }
        #end
        let buf = [u8]{ 0 x 32000 }

        let offset: uint = 0

        while true {
            let rcount = io.read(in, buf, offset) ! {
                io.close_cleanup(in, __FILE__, __LINE__)
                io.close_cleanup(out, __FILE__, __LINE__)
                throw .read
            }
            if rcount == 0 {
                close_pair(in, out) !>
                break
            }
            write_all(out, buf.data, rcount) ! {
                io.close_cleanup(in, __FILE__, __LINE__)
                io.close_cleanup(out, __FILE__, __LINE__)
                throw .write
            }
            offset += rcount
        }
    }
}

// Recreates the symlink `from` at `to` with the same target
fn copy_link(from: String, to: String) !io.IoError {
    let target = read_link(from) !>
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(from) ! throw .read
    let attributes = ext.GetFileAttributesW(wide_path.items().@cast(ptr))
    let directory = attributes != ext.INVALID_FILE_ATTRIBUTES_fix && (attributes & ext.FILE_ATTRIBUTE_DIRECTORY) != 0
    #else
    let directory = false
    #end
    if is_traversal_link(to) : delete_traversal_link(to) !>
    symlink(to, target, directory) !>
}

// Returns the target a symlink (or on Windows a junction) points to, as stored
fn read_link(path: String) String !io.IoError {
    @unsafe
    #if OS == "win"
    let wide_path = windows_path(path) ! throw .read
    let handle = ext.CreateFileW(wide_path.items().@cast(ptr), 0,
        ext.FILE_SHARE_READ | ext.FILE_SHARE_WRITE | ext.FILE_SHARE_DELETE, null,
        ext.OPEN_EXISTING, ext.FILE_FLAG_OPEN_REPARSE_POINT | ext.FILE_FLAG_BACKUP_SEMANTICS, 0)
    if handle == ext.INVALID_HANDLE_VALUE : throw .read
    let buf: [u8 x 16384] = @undefined
    let data: ptr = @ref(buf)
    let returned: u32 = 0
    let ok = ext.DeviceIoControl(handle, FSCTL_GET_REPARSE_POINT, null, 0, data, 16384, @ref(returned), null)
    ext.CloseHandle(handle)
    if ok == 0 || returned < 16 : throw .read
    // REPARSE_DATA_BUFFER: tag, data length, reserved, then the name offsets and lengths
    let tag = @ptrv(data, u32, 0)
    let path_buffer: uint = 16
    if tag == REPARSE_TAG_SYMLINK : path_buffer = 20
    else if tag != REPARSE_TAG_MOUNT_POINT : throw .read
    let name_offset = @ptrv(data, u16, 6).to(uint)
    let name_length = @ptrv(data, u16, 7).to(uint)
    if name_length == 0 {
        name_offset = @ptrv(data, u16, 4).to(uint)
        name_length = @ptrv(data, u16, 5).to(uint)
    }
    let start = path_buffer + name_offset
    if start + name_length > returned.to(uint) : throw .read
    let target = windows_string(data + start, name_length / 2) ! throw .read
    if target.starts_with("\\??\\") : target = target.range(4, target.bytes - 4)
    return target
    #else
    let buf: [u8 x 4096] = @undefined
    let length = ext.readlink(path.data_cstring, @ref(buf), PATH_MAX)
    if length < 0 || length.to(uint) >= PATH_MAX : throw .read
    return String.copy_from_ptr(&buf, length.to(u64))
    #end
}

- fn close_pair(first: Fd, second: Fd) !io.IoError {
    let failed = false
    io.close(first) ! failed = true
    io.close(second) ! failed = true
    if failed : throw .os
}

/// Creates the directory `path`; its parent must already exist.
///
/// `permissions` applies before the umask and is ignored on Windows. Throws `.exists` when
/// something already exists at `path` and `.access` on any other failure.
+ fn create_dir(path: String, permissions: u32 (0c755)) !io.IoError {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! throw .access
    if ext.CreateDirectoryW(wide_path.items().@cast(ptr), null) == 0 {
        if ext.GetLastError() == ext.ERROR_ALREADY_EXISTS : throw .exists
        throw .access
    }
    #else
    if ext.mkdir(path.data_cstring, permissions) == -1 {
        if ext.get_errno() == ext.EEXIST : throw .exists
        throw .access
    }
    #end
}
/// Deletes the empty directory `path`; `delete_all` also removes a non-empty one.
///
/// Throws `.access` on failure.
+ fn delete_dir(path: String) !io.IoError {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! throw .access
    if ext.RemoveDirectoryW(wide_path.items().@cast(ptr)) == 0 : throw .access
    #else
    if ext.rmdir(path.data_cstring) == -1 : throw .access
    #end
}

/// Returns whether `path` is a regular file; a symlink to one counts.
///
/// On Windows anything that exists and is not a directory counts as a file.
+ fn is_file(path: String) bool {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! return false
    let attributes = ext.GetFileAttributesW(wide_path.items().@cast(ptr))
    return attributes != ext.INVALID_FILE_ATTRIBUTES_fix && (attributes & ext.FILE_ATTRIBUTE_DIRECTORY) == 0
    #else
    let buf: ext.libc_stat = @undefined
    if ext.stat(path.data_cstring, buf.@cast(*ext.libc_stat)) == -1 : return false
    return (buf.st_mode & ext.S_IFMT) == ext.S_IFREG
    #end
}
/// Returns whether `path` is a directory; a symlink to one counts.
+ fn is_dir(path: String) bool {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! return false
    let attributes = ext.GetFileAttributesW(wide_path.items().@cast(ptr))
    return attributes != ext.INVALID_FILE_ATTRIBUTES_fix && (attributes & ext.FILE_ATTRIBUTE_DIRECTORY) != 0
    #else
    let buf: ext.libc_stat = @undefined
    if ext.stat(path.data_cstring, buf.@cast(*ext.libc_stat)) == -1 : return false
    return (buf.st_mode & ext.S_IFDIR) == ext.S_IFDIR
    #end
}
/// Lists the entries of `dir` as full paths, or as names relative to `dir` when `relative` is set.
///
/// `files` and `dirs` select which kinds are included. `recursive` also lists the contents of
/// each subdirectory, after the subdirectory itself, but does not descend into symlinked
/// directories. Full paths start with `resolve(dir)`. The order is the file system's, not
/// sorted. Throws `.open` or `.read` when a directory cannot be read.
+ fn files_in(dir: String, recursive: bool (false), files: bool (true), dirs: bool (true), relative: bool (false)) Array[String] !io.IoError {
    dir = resolve(dir)
    let result = Array[String]{}
    list_dir(dir, relative ? "" : dir, recursive, files, dirs, result) !>
    return result
}

fn list_dir(dir: String, prefix: String, recursive: bool, files: bool, dirs: bool, result: Array[String]) !io.IoError {
    let entries = read_dir(dir) !>
    defer entries.close() ! core.cleanup_warning("Failed to close directory", __FILE__, __LINE__)
    while true {
        let name = entries.next() !>
        if !isset(name) : break
        let full = add(dir, name)
        let relative = prefix.length > 0 ? add(prefix, name) : name
        let directory = is_dir(full)
        if (dirs && directory) || (files && !directory) : result.append(relative)
        if recursive && directory && !is_traversal_link(full) {
            list_dir(full, relative, recursive, files, dirs, result) !>
        }
    }
}

/// Creates a symbolic link at `link` that points to `target`.
///
/// `target` is stored as given, so a relative target resolves against the link's directory.
/// `is_directory` only matters on Windows, where directory links are marked as such. Throws
/// `.access` when not permitted, `.exists` when `link` already exists and `.write` otherwise.
+ fn symlink(link: String, target: String, is_directory: bool (false)) !io.IoError {
    #if OS == "win"
    @unsafe
    let flag: u32 = ext.SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE
    if is_directory : flag = flag | ext.SYMBOLIC_LINK_FLAG_DIRECTORY
    let wide_link = windows_path(link) ! throw .write
    let wide_target = windows_path(target) ! throw .write
    if ext.CreateSymbolicLinkW(wide_link.items().@cast(ptr), wide_target.items().@cast(ptr), flag) == 1 : return
    let error = ext.GetLastError()
    if error == ext.ERROR_PRIVILEGE_NOT_HELD : throw .access
    if error == ext.ERROR_ALREADY_EXISTS : throw .exists
    #else
    if ext.symlink(target.data_cstring, link.data_cstring) == 0 : return
    let error = ext.get_errno()
    if error == ext.EACCES : throw .access
    if error == ext.EEXIST : throw .exists
    #end

    throw .write
}

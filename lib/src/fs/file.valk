use ext
use io
use core

value default_read_size (32 * 1024)

+ struct OpenOptions {
    + read: bool (true)
    + write: bool (false)
    + append: bool (false)
    + create: bool (false)
    + exclusive: bool (false)
    + permissions: u32 (0c644)
}

+ fn open(path: String, options: ?OpenOptions (null)) Fd !io.IoError {
    #if OS == "win"
    @unsafe
    #end
    let opts = options ?? OpenOptions {}
    if !opts.read && !opts.write : throw .open
    if (opts.append || opts.create) && !opts.write : throw .open
    if opts.exclusive && !opts.create : throw .open

    // let flags : i32 = (ext.O_RDONLY | ext.O_NONBLOCK).to(i32)
    #if OS == "win"
    let access: u32 = 0
    if opts.read : access = access | ext.GENERIC_READ
    if opts.write : access = access | ext.GENERIC_WRITE
    // Shade mode
    let share_mode: u32 = ext.FILE_SHARE_READ
    // dwCreationDisposition
    let despo: u32 = ext.OPEN_EXISTING
    if opts.write {
        despo = opts.append ? ext.OPEN_EXISTING : ext.TRUNCATE_EXISTING
        if opts.create : despo = opts.append ? ext.OPEN_ALWAYS : ext.CREATE_ALWAYS
    }
    if opts.exclusive : despo = ext.CREATE_NEW
    // Flags
    let flags: u32 = ext.FILE_FLAG_OVERLAPPED | ext.FILE_FLAG_SEQUENTIAL_SCAN
    //
    let wide_path = windows_path(path) ! throw .open
    let fd = ext.CreateFileW(wide_path.items().@cast(ptr), access, share_mode, null, despo, flags, 0)
    if fd == ext.INVALID_HANDLE_VALUE : throw .open

    if !io.associate(fd) {
        io.close_cleanup(fd, __FILE__, __LINE__)
        throw .open
    }

    #else
    #if OS == "linux"
    @unsafe
    #end
    let flags: i32 = opts.read ? (opts.write ? ext.O_RDWR : ext.O_RDONLY) : ext.O_WRONLY

    if opts.create : flags = flags | ext.O_CREAT
    if opts.exclusive : flags = flags | ext.O_EXCL
    if opts.write {
        flags = flags | (opts.append ? ext.O_APPEND : ext.O_TRUNC)
    }

    let fd = ext.open(path.data_cstring, flags, opts.permissions.to(i32))
    if fd < 0 {
        throw .open
    }

    #end

    return fd
}

#if OS != "win"
- fn stat(path: String, buf: stack ext.libc_stat) !io.IoError {
    let res = ext.stat(path.data_cstring, buf.@cast(*ext.libc_stat))
    if res == -1 : throw .open
}
#end
+ fn size(path: String) uint !io.IoError {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! throw .open
    let data: ext.libc_WIN32_FILE_ATTRIBUTE_DATA = @undefined
    if ext.GetFileAttributesExW(wide_path.items().@cast(ptr), 0, @ref(data)) == 0 : throw .open
    return (data.nFileSizeHigh.to(uint) << 32) | data.nFileSizeLow
    #else
    let buf: ext.libc_stat = @undefined
    stat(path, buf) ! throw .open
    return buf.st_size.to(uint)
    #end
}

+ fn sync_all() {
    ext.sync()
}

+ fn chmod(path: String, permissions: u32) !io.IoError {
    #if OS == "win"
    let wide_path = windows_path(path) ! throw .access
    if ext._wchmod(wide_path.items().@cast(*u16), permissions.to(i32)) == -1 : throw .access
    #else
    if ext.chmod(path.data_cstring, permissions) == -1 : throw .access
    #end
}

+ fn truncate(path: String, length: uint) !io.IoError {
    if length > 9223372036854775807.to(uint) : throw .write
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! throw .open
    let fd = ext.CreateFileW(wide_path.items().@cast(ptr), ext.GENERIC_WRITE,
        ext.FILE_SHARE_READ | ext.FILE_SHARE_WRITE, null, ext.OPEN_EXISTING,
        ext.FILE_ATTRIBUTE_NORMAL, 0)
    if fd == ext.INVALID_HANDLE_VALUE : throw .open
    let failed = ext.SetFilePointerEx(fd, length.to(i64), null, 0) == 0
    if !failed : failed = ext.SetEndOfFile(fd) == 0
    if ext.CloseHandle(fd) == 0 : throw .os
    if failed : throw .write
    #else
    if ext.truncate(path.data_cstring, length.to(int)) == -1 : throw .write
    #end
}

+ fn read(path: String) String !io.IoError {
    let fd = open(path) ! throw .open
    let size: uint = size(path) ! {
        io.close_cleanup(fd, __FILE__, __LINE__)
        throw .read
    }
    let offset: uint = 0
    let buffer = String.alloc(size)

    while offset < size {
        let readcount = io.read(fd, buffer.view(offset, size - offset), offset) ! {
            io.close_cleanup(fd, __FILE__, __LINE__)
            throw .read
        }
        if readcount == 0 : break
        offset += readcount
    }

    io.close(fd) !>
    return buffer.take_length(offset)
}

- fn write_all(fd: Fd, data: ptr, size: uint) !io.IoError {
    @unsafe
    let written: uint = 0
    while written < size {
        let count = io.write_bytes(fd, data + written, size - written) ! throw .write
        if count == 0 : throw .write
        written += count
    }
}

+ fn write(path: String, content: Slice[u8], append: bool (false)) !io.IoError {
    @unsafe
    let fd = open(path, OpenOptions { write: true, append: append, create: true }) ! throw .open
    write_all(fd, content.data, content.length) ! {
        io.close_cleanup(fd, __FILE__, __LINE__)
        throw .write
    }
    io.close(fd) !>
}

+ fn exists(path: String) bool {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! return false
    let dwAttrib = ext.GetFileAttributesW(wide_path.items().@cast(ptr))
    return dwAttrib != ext.INVALID_FILE_ATTRIBUTES_fix
    #else
    return ext.access(path.data_cstring, ext.F_OK) == 0
    #end
}
+ fn delete(path: String) !io.IoError {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! throw .access
    if ext.DeleteFileW(wide_path.items().@cast(ptr)) == 0 : throw .access
    #else
    let res = ext.unlink(path.data_cstring)
    if res == -1 : throw .access
    #end
}
+ fn is_symlink(path: String) bool {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! return false
    let data: ext.libc_WIN32_FIND_DATAW = @undefined
    let hFind = ext.FindFirstFileW(wide_path.items().@cast(ptr), @ref(data))
    if hFind == ext.INVALID_HANDLE_VALUE : return false
    let result = (data.dwFileAttributes & ext.FILE_ATTRIBUTE_REPARSE_POINT) != 0 && data.dwReserved0 == ext.IO_REPARSE_TAG_SYMLINK.to(u32)
    ext.FindClose(hFind)
    return result
    #else
    let buf: ext.libc_stat = @undefined
    if ext.lstat(path.data_cstring, buf.@cast(*ext.libc_stat)) == -1 : return false
    return (buf.st_mode & ext.S_IFMT) == ext.S_IFLNK
    #end
}
- fn is_traversal_link(path: String) bool {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! return false
    let attributes = ext.GetFileAttributesW(wide_path.items().@cast(ptr))
    return attributes != ext.INVALID_FILE_ATTRIBUTES_fix && (attributes & ext.FILE_ATTRIBUTE_REPARSE_POINT) != 0
    #else
    return is_symlink(path)
    #end
}
- fn delete_traversal_link(path: String) !io.IoError {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! throw .access
    let attributes = ext.GetFileAttributesW(wide_path.items().@cast(ptr))
    if attributes == ext.INVALID_FILE_ATTRIBUTES_fix : throw .access
    if (attributes & ext.FILE_ATTRIBUTE_DIRECTORY) != 0 {
        rmdir(path) ! throw .access
    } else {
        delete(path) ! throw .access
    }
    #else
    delete(path) ! throw .access
    #end
}
+ fn delete_recursive(path: String) !io.IoError {
    if is_traversal_link(path) {
        delete_traversal_link(path) !>
        return
    }
    let isdir = is_dir(path)
    if isdir {
        let list = files_in(path, false, true, true) !>
        each list as entry {
            delete_recursive(entry) !>
        }
        rmdir(path) !>
    } else {
        delete(path) !>
    }
}
+ fn move(from_path: String, to_path: String) !io.IoError {
    #if OS == "win"
    @unsafe
    let wide_from = windows_path(from_path) ! throw .access
    let wide_to = windows_path(to_path) ! throw .access
    if ext.MoveFileW(wide_from.items().@cast(ptr), wide_to.items().@cast(ptr)) == 0 : throw .access
    #else
    let res = ext.rename(from_path.data_cstring, to_path.data_cstring)
    if res != 0 : throw .access
    #end
}

+ fn copy(from_path: String, to_path: String, recursive: bool (false)) !io.IoError {
    @unsafe
    if from_path == to_path : return
    if is_traversal_link(from_path) : throw .access
    let isdir = is_dir(from_path)
    if isdir {
        if !exists(to_path) : mkdir(to_path) ! throw .access
        else if !is_dir(to_path) : throw .open
        // Copy files
        let files = files_in(from_path, false, true, recursive, true) !>
        each files as fn {
            let from = add(from_path, fn)
            let to = add(to_path, fn)
            copy(from, to, recursive) ! throw .write
        }
    } else {
        let buf = String.alloc(32000).to_slice()
        let in = open(from_path) ! throw .open
        let out = open(to_path, OpenOptions { write: true, create: true }) ! {
            io.close_cleanup(in, __FILE__, __LINE__)
            throw .open
        }

        let offset: uint = 0

        while true {
            let rcount = io.read(in, buf, offset) ! {
                io.close_cleanup(in, __FILE__, __LINE__)
                io.close_cleanup(out, __FILE__, __LINE__)
                throw .read
            }
            if rcount == 0 {
                close_pair(in, out) !>
                break
            }
            write_all(out, buf.data, rcount) ! {
                io.close_cleanup(in, __FILE__, __LINE__)
                io.close_cleanup(out, __FILE__, __LINE__)
                throw .write
            }
            offset += rcount
            if rcount < 32000 {
                close_pair(in, out) !>
                break
            }
        }
    }
}

- fn close_pair(first: Fd, second: Fd) !io.IoError {
    let failed = false
    io.close(first) ! failed = true
    io.close(second) ! failed = true
    if failed : throw .os
}

+ fn mkdir(path: String, permissions: u32 (0c755)) !io.IoError {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! throw .access
    if ext.CreateDirectoryW(wide_path.items().@cast(ptr), null) == 0 : throw .access
    #else
    if ext.mkdir(path.data_cstring, permissions) == -1 {
        throw .access
    }
    #end
}
+ fn rmdir(path: String) !io.IoError {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! throw .access
    if ext.RemoveDirectoryW(wide_path.items().@cast(ptr)) == 0 : throw .access
    #else
    if ext.rmdir(path.data_cstring) == -1 : throw .access
    #end
}

+ fn is_file(path: String) bool {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! return false
    let attributes = ext.GetFileAttributesW(wide_path.items().@cast(ptr))
    return attributes != ext.INVALID_FILE_ATTRIBUTES_fix && (attributes & ext.FILE_ATTRIBUTE_DIRECTORY) == 0
    #else
    let buf: ext.libc_stat = @undefined
    stat(path, buf) ! return false
    return (buf.st_mode & ext.S_IFMT) == ext.S_IFREG
    #end
}
+ fn is_dir(path: String) bool {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) ! return false
    let attributes = ext.GetFileAttributesW(wide_path.items().@cast(ptr))
    return attributes != ext.INVALID_FILE_ATTRIBUTES_fix && (attributes & ext.FILE_ATTRIBUTE_DIRECTORY) != 0
    #else
    let buf: ext.libc_stat = @undefined
    stat(path, buf) ! return false
    return (buf.st_mode & ext.S_IFDIR) == ext.S_IFDIR
    #end
}
+ fn modified_time(path: String) uint !io.IoError {
    #if OS == "win"
    @unsafe
    let ftMod: ext.libc_FILETIME = @undefined
    let wide_path = windows_path(path) ! throw .open
    let hndl = ext.CreateFileW(wide_path.items().@cast(ptr), ext.FILE_READ_ATTRIBUTES, ext.FILE_SHARE_READ | ext.FILE_SHARE_WRITE, null, ext.OPEN_EXISTING, ext.FILE_FLAG_BACKUP_SEMANTICS, 0)
    if hndl == ext.INVALID_HANDLE_VALUE : throw .open
    let ok = ext.GetFileTime(hndl, null, null, @ref(ftMod))
    if ext.CloseHandle(hndl) == 0 : throw .os
    if ok == 0 : throw .open
    // FILETIME = 100-ns ticks since 1601-01-01 UTC
    let ticks: u64 = (ftMod.dwHighDateTime.to(u64) << 32) | ftMod.dwLowDateTime
    // Subtract difference between 1601-01-01 and 1970-01-01
    let ns100 = ticks - 116444736000000000
    return ns100 * 100 // to nanoseconds
    #else
    let buf: ext.libc_stat = @undefined
    stat(path, buf) ! throw .open
    #if OS == "linux"
    let ns = buf.st_mtim.tv_sec.to(u64) * 1_000_000_000 + buf.st_mtim.tv_nsec
    #elif OS == "macos"
    let ns = buf.st_mtimespec.tv_sec.to(u64) * 1_000_000_000 + buf.st_mtimespec.tv_nsec
    #end
    return ns
    #end
}

// Lists the entries of `dir`; `relative` returns names relative to `dir` instead of full paths
+ fn files_in(dir: String, recursive: bool (false), files: bool (true), dirs: bool (true), relative: bool (false)) Array[String] !io.IoError {
    dir = resolve(dir)
    let result = Array[String]{}
    list_dir(dir, relative ? "" : dir, recursive, files, dirs, result) !>
    return result
}

fn list_dir(dir: String, prefix: String, recursive: bool, files: bool, dirs: bool, result: Array[String]) !io.IoError {
    @unsafe

    #if OS == "win"

    let glob: String = add(dir, "*")
    let pattern = windows_path(glob) ! throw .open
    let data: ext.libc_WIN32_FIND_DATAW = @undefined
    let hFind = ext.FindFirstFileW(pattern.items().@cast(ptr), @ref(data))
    if hFind != ext.INVALID_HANDLE_VALUE {
        let loop: ext.BOOL = 1
        while loop != 0 {
            let fn = windows_cstring(@ref(data.cFileName).@cast(*u16), 260) ! {
                ext.FindClose(hFind)
                throw E
            }

            if fn.bytes < 3 && (fn == "." || fn == "..") {
                loop = ext.FindNextFileW(hFind, @ref(data))
                continue
            }

            let is_dir = (data.dwFileAttributes & ext.FILE_ATTRIBUTE_DIRECTORY) != 0
            let is_link = (data.dwFileAttributes & ext.FILE_ATTRIBUTE_REPARSE_POINT) != 0
            let is_file = !is_dir
            let full = add(dir, fn)
            fn = prefix.length > 0 ? add(prefix, fn) : fn

            if (dirs && is_dir) || (files && is_file) {
                result.append(fn)
            }
            if is_dir && !is_link && recursive {
                list_dir(full, fn, recursive, files, dirs, result) ! {
                    if ext.FindClose(hFind) == 0 {
                        core.cleanup_warning("Failed to close directory search handle", __FILE__, __LINE__)
                    }
                    throw E
                }
            }

            loop = ext.FindNextFileW(hFind, @ref(data))
        }
        let find_error = ext.GetLastError()
        let close_error = ext.FindClose(hFind) == 0
        if find_error != ext.ERROR_NO_MORE_FILES : throw .read
        if close_error : throw .os
    } else if ext.GetLastError() != ext.ERROR_FILE_NOT_FOUND {
        throw .open
    }

    #else

    let d = ext.opendir(dir.data_cstring)

    if isset(d) {
        while true {
            ext.set_errno(0)
            let ent = ext.readdir(d)
            if isset(ent) {
                let fn = @ref(ent.d_name).@cast(cstring).to_string()

                if fn.bytes < 3 && (fn == "." || fn == ".." || fn == "") {
                    continue
                }

                let full = add(dir, fn)
                fn = prefix.length > 0 ? add(prefix, fn) : fn
                let _is_dir = is_dir(full)
                let _is_link = is_traversal_link(full)
                let _is_file = !_is_dir

                if (dirs && _is_dir) || (files && _is_file) {
                    result.append(fn)
                }

                if _is_dir && !_is_link && recursive {
                    list_dir(full, fn, recursive, files, dirs, result) ! {
                        if ext.closedir(d) != 0 {
                            core.cleanup_warning("Failed to close directory", __FILE__, __LINE__)
                        }
                        throw E
                    }
                }

                continue
            }
            let read_error = ext.get_errno()
            let close_error = ext.closedir(d) != 0
            if read_error != 0 : throw .read
            if close_error : throw .os
            break
        }
    } else : throw .open

    #end
}

+ fn symlink(link: String, target: String, is_directory: bool) !io.IoError {
    #if OS == "win"
    @unsafe
    let flag: u32 = ext.SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE
    if is_directory : flag = flag | ext.SYMBOLIC_LINK_FLAG_DIRECTORY
    let wide_link = windows_path(link) ! throw .write
    let wide_target = windows_path(target) ! throw .write
    if ext.CreateSymbolicLinkW(wide_link.items().@cast(ptr), wide_target.items().@cast(ptr), flag) == 1 : return
    let error = ext.GetLastError()
    if error == ext.ERROR_PRIVILEGE_NOT_HELD : throw .access
    if error == ext.ERROR_ALREADY_EXISTS : throw .exists
    #else
    if ext.symlink(target.data_cstring, link.data_cstring) == 0 : return
    let error = ext.get_errno()
    if error == ext.EACCES : throw .access
    if error == ext.EEXIST : throw .exists
    #end

    throw .write
}

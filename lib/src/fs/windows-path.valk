use ext
use io

#if OS == "win"
fn windows_path(value: String) Array[u16] !io.IoError {
    @unsafe
    if value.contains_byte(0) || value.bytes > 2147483647 : throw .os
    let input_length = value.bytes.to(i32)
    let wide_length = ext.MultiByteToWideChar(65001, ext.MB_ERR_INVALID_CHARS,
        value.data, input_length, null, 0)
    if wide_length <= 0 && value.bytes > 0 : throw .os

    let result = Array[u16].new(wide_length.to(uint).checked_add(1) ! throw .os)
    result.set_expand(wide_length.to(uint), 0, 0)
    if wide_length > 0 && ext.MultiByteToWideChar(65001, ext.MB_ERR_INVALID_CHARS,
        value.data, input_length, result.data.@cast(ptr), wide_length) != wide_length : throw .os
    return result
}

fn windows_string(data: ptr, length: uint) String !io.IoError {
    @unsafe
    if length > 2147483647 : throw .os
    let input_length = length.to(i32)
    let bytes = ext.WideCharToMultiByte(65001, ext.WC_ERR_INVALID_CHARS,
        data, input_length, null, 0, null, null)
    if bytes <= 0 && length > 0 : throw .os
    let result = String.alloc(bytes.to(uint))
    if bytes > 0 && ext.WideCharToMultiByte(65001, ext.WC_ERR_INVALID_CHARS,
        data, input_length, result.data, bytes, null, null) != bytes : throw .os
    return result
}

fn windows_cstring(data: *u16, capacity: uint) String !io.IoError {
    @unsafe
    let length: uint = 0
    while length < capacity && @ptrv(data, u16, length) != 0 : length++
    if length == capacity : throw .os
    return windows_string(data.@cast(ptr), length) !>
}
#end

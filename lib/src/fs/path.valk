use ext
use core
use valk.io

- global EXE_PATH: ?String (null)
- global EXE_DIR: ?String (null)

+ value PATH_MAX (4096)

#if OS == "win"
+ value PATH_DIV ("\\")
+ value PATH_DIV_TWICE ("\\\\")
+ value PATH_DIV_REPLACE ("/")
+ value PATH_DOT_DIV (".\\")
+ value PATH_DIV_DOT ("\\.")
#else
+ value PATH_DIV ("/")
+ value PATH_DIV_TWICE ("//")
+ value PATH_DIV_REPLACE ("\\")
+ value PATH_DOT_DIV ("./")
+ value PATH_DIV_DOT ("/.")
#end

+ mode Path for String {
    + static fn new(path: String) Path {
        return path
    }
    + fn add(part: String) Path {
        return add(this, part)
    }
    + fn pop() Path {
        return dir_of(this)
    }
    + fn dir_of() Path {
        return dir_of(this)
    }
    + fn resolve() Path {
        return resolve(this)
    }
}

+ fn path(path: String) Path { return path }

// Makes `path` absolute and folds `.`, `..` and repeated separators without
// touching the file system; use `realpath` to also follow symlinks
+ fn resolve(path: String) String {
    path = path.replace(PATH_DIV_REPLACE, PATH_DIV)
    let is_absolute = path.starts_with(PATH_DIV) || path.get(1) == ':'
    if !is_absolute {
        let dir = cwd() ! panic("Cannot determine the current directory")
        path = add(dir, path)
    }

    let prefix = PATH_DIV
    if path.starts_with(PATH_DIV_TWICE) : prefix = PATH_DIV_TWICE
    else if path.get(1) == ':' : prefix = path.part(0, 2) + PATH_DIV
    let rest = path.part(prefix.length, path.length - prefix.length)

    let parts = Array[String].new(8)
    each rest.split(PATH_DIV) as part {
        if part == "" || part == "." : continue
        if part == ".." {
            if parts.length > 0 : parts.pop_last() _
            continue
        }
        parts.append(part)
    }

    if parts.length == 0 : return prefix.length > 1 && prefix.get(1) == ':' ? prefix.part(0, 2) : prefix
    return prefix + parts.join(PATH_DIV)
}

+ fn add(dir: String, fn: String) String {
    let s1 = dir.ends_with(PATH_DIV) || dir.ends_with(PATH_DIV_REPLACE)
    let s2 = fn.starts_with(PATH_DIV) || fn.starts_with(PATH_DIV_REPLACE)
    if !s1 && !s2 : return dir + PATH_DIV + fn
    if s1 && s2 : return (dir + fn.ltrim(PATH_DIV).ltrim(PATH_DIV_REPLACE))
    return dir + fn
}

+ fn cwd() String !io.IoError {
    #if OS == "win"
    @unsafe
    let buf: [u16 x 4096] = @undefined
    let length = ext.GetCurrentDirectoryW(PATH_MAX.to(u32), @ref(buf))
    if length == 0 || length >= PATH_MAX : throw .os
    return windows_string(@ref(buf).@cast(ptr), length) !>
    #else
    let buf: [u8 x 4096] = @undefined
    let dir = ext.getcwd(@ref(buf), 4096)
    if !isset(dir) : throw .os
    return dir
    #end
}

+ fn chdir(path: String) !io.IoError {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) !>
    if ext.SetCurrentDirectoryW(wide_path.items().@cast(ptr)) == 0 : throw .os
    #else
    if ext.chdir(path.data_cstring) != 0 : throw .os
    #end
}

+ fn exe_dir() String !io.IoError {
    let dir = EXE_DIR
    if isset(dir) : return dir
    let d = dir_of(exe_path() !>)
    EXE_DIR = d
    return d
}

+ fn exe_path() String !io.IoError {
    let p = EXE_PATH
    if isset(p) {
        return p
    }
    // TODO: USE PATH_MAX
    #if OS == "win"
    @unsafe
    let buf: [u16 x 4096] = @undefined
    let len = ext.GetModuleFileNameW(null, @ref(buf), PATH_MAX.to(u32))
    if len == 0 || len >= PATH_MAX : throw .os
    let str = windows_string(@ref(buf).@cast(ptr), len) !>
    str = resolve(str)
    EXE_PATH = str
    return str
    #elif OS == "macos"

    let buf: [u8 x 4096] = @undefined
    let size: u32 = PATH_MAX;
    if ext._NSGetExecutablePath(@ref(buf), @ref(size)) < 0 : throw .os
    let cbuf: cstring = &buf
    let path: String = cbuf
    return realpath(path) !>

    #else
    @unsafe
    let buf: [u8 x 4096] = @undefined
    let link = "/proc/self/exe".data_cstring
    let len = ext.readlink(link, @ref(buf), PATH_MAX)
    if len < 0 || len.to(uint) >= PATH_MAX : throw .os
    let str = String.copy_from_ptr(&buf, len.to(u64))
    str = resolve(str)
    EXE_PATH = str
    return str
    #end
}

+ fn realpath(path: String) String !io.IoError {
    @unsafe
    #if OS == "win"
    let wide_path = windows_path(path) !>
    let buf: [u16 x 4096] = @undefined
    let length = ext.GetFullPathNameW(wide_path.items().@cast(ptr), PATH_MAX.to(u32), @ref(buf), null)
    if length == 0 || length >= PATH_MAX : throw .os
    return windows_string(@ref(buf).@cast(ptr), length) !>
    #elif OS == "macos"
    let buf: [u8 x 4096] = @undefined
    path = path.replace(PATH_DIV_REPLACE, PATH_DIV)
    if path.starts_with(".") {
        path = (cwd() !>) + PATH_DIV + path
    }
    if exists(path) {
        let result = ext.realpath(path.data, @ref(buf))
        if !isset(result) : throw .os
        return result
    }
    return path
    #else
    let buf: [u8 x 4096] = @undefined
    path = path.replace(PATH_DIV_REPLACE, PATH_DIV)
    if exists(path) {
        let result = ext.realpath(path.data, @ref(buf))
        if !isset(result) : throw .os
        return result
    }
    return path
    #end
}

+ fn extension(path: String, with_dot: bool (false)) String {
    let len = path.bytes
    let start = len
    let found = false
    while start > 0 {
        start--
        let ch = path.get(start)
        if ch == '.' {
            if with_dot == false : start++
            found = true
            break
        }
        if ch == '/' || ch == '\\' : break
    }
    if found == false : return ""
    return path.part(start, len - start)
}

+ fn dir_of(path: String) String {
    let bytes = path.bytes
    if bytes == 0 : return ""
    let end = bytes - 1
    while end-- > 0 {
        let ch = path.get(end)
        if ch == '/' || ch == '\\' {
            if end == 0 : end++
            return path.part(0, end)
        }
    }
    return path
}

+ fn basename(path: String) String {
    let len = path.bytes
    let start = len
    let rtrim: uint = 0
    while start > 0 {
        let ch = path.get(start - 1)
        if ch == '/' || ch == '\\' {
            start--
            rtrim++
            continue
        }
        break
    }
    while start-- > 0 {
        let ch = path.get(start)
        if (ch == '/' || ch == '\\') {
            start++
            break
        }
    }
    return path.part(start, len - start - rtrim)
}

+ fn home_dir() String !LookupError {
    #if OS == "win"
    @unsafe
    let name = windows_path("USERPROFILE") ! throw .missing
    let buf: [u16 x 4096] = @undefined
    let length = ext.GetEnvironmentVariableW(name.items().@cast(ptr), @ref(buf), PATH_MAX.to(u32))
    if length == 0 || length >= PATH_MAX : throw .missing
    return windows_string(@ref(buf).@cast(ptr), length) ! throw .missing
    #else
    return core.getenv("HOME") !>
    #end
}

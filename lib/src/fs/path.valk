use ext
use core
use valk.io

- global EXE_PATH: ?String (null)
- global EXE_DIR: ?String (null)

/// Buffer length used when asking the OS for a path; longer paths fail with `.os`.
///
/// Counted in bytes, or in UTF-16 units on Windows.
+ value PATH_MAX (4096)

#if OS == "win"
/// The path separator of the target OS: `\` on Windows, `/` elsewhere.
+ value PATH_DIV ("\\")
/// Two path separators, as at the start of a UNC path.
+ value PATH_DIV_TWICE ("\\\\")
/// The other platform's separator: `/` on Windows, where `resolve` converts it to `PATH_DIV`.
+ value PATH_DIV_REPLACE ("/")
/// `.` followed by `PATH_DIV`: the relative prefix for the current directory.
+ value PATH_DOT_DIV (".\\")
/// `PATH_DIV` followed by `.`.
+ value PATH_DIV_DOT ("\\.")
#else
/// The path separator of the target OS: `\` on Windows, `/` elsewhere.
+ value PATH_DIV ("/")
/// Two path separators, as at the start of a UNC path.
+ value PATH_DIV_TWICE ("//")
/// The other platform's separator: `\` outside Windows, where it is an ordinary name byte.
+ value PATH_DIV_REPLACE ("\\")
/// `.` followed by `PATH_DIV`: the relative prefix for the current directory.
+ value PATH_DOT_DIV ("./")
/// `PATH_DIV` followed by `.`.
+ value PATH_DIV_DOT ("/.")
#end

/// A `String` that holds a file system path and offers the path functions as methods.
///
/// Converts to and from `String` implicitly.
+ mode Path for String {
    /// Returns `path` as a `Path`.
    + static fn new(path: String) Path {
        return path
    }
    /// Returns this path joined with `part`; see `fs.add`.
    + fn add(part: String) Path {
        return add(this, part)
    }
    /// Returns the parent directory; same as `dir_of`.
    + fn pop() Path {
        return dir_of(this)
    }
    /// Returns the parent directory; see `fs.dir_of`.
    + fn dir_of() Path {
        return dir_of(this)
    }
    /// Returns the absolute, normalized form of this path; see `fs.resolve`.
    + fn resolve() Path {
        return resolve(this)
    }
}

/// Returns `path` as a `Path`, for chaining path methods.
+ fn path(path: String) Path { return path }

/// Makes `path` absolute and folds `.`, `..` and repeated separators.
///
/// The file system is not consulted, so symlinks are not followed; `realpath` follows them. A
/// relative path is taken against `cwd()`, and it panics when that fails. On Windows either
/// separator is accepted and becomes `\`, and a path whose second byte is `:` is absolute (a
/// drive); on Linux and macOS only `/` separates and `\` and `:` are ordinary name bytes.
/// Trailing separators are dropped, except at the root: `..` at the root stays at the root,
/// and a Windows drive root resolves to `C:\`.
+ fn resolve(path: String) String {
    #if OS == "win"
    path = path.replace(PATH_DIV_REPLACE, PATH_DIV)
    let is_absolute = path.starts_with(PATH_DIV) || path.get(1) == ':'
    #else
    let is_absolute = path.starts_with(PATH_DIV)
    #end
    if !is_absolute {
        let dir = cwd() ! panic("Cannot determine the current directory")
        path = add(dir, path)
    }

    let prefix = PATH_DIV
    let skip: uint = 1
    if path.starts_with(PATH_DIV_TWICE) {
        prefix = PATH_DIV_TWICE
        skip = 2
    }
    #if OS == "win"
    if path.get(1) == ':' {
        prefix = path.range(0, 2) + PATH_DIV
        skip = 2
    }
    #end
    let rest = path.range(skip, path.length - skip)

    let parts = Array[String].new(8)
    each rest.split(PATH_DIV) as part {
        if part == "" || part == "." : continue
        if part == ".." {
            if parts.length > 0 : parts.pop_last() _
            continue
        }
        parts.append(part)
    }

    if parts.length == 0 : return prefix
    return prefix + parts.join(PATH_DIV)
}

/// Joins `dir` and `fn` with exactly one separator between them.
///
/// Either platform's separator is recognized at the joint; a missing one is added as
/// `PATH_DIV`. An empty `dir` gives `fn` unchanged.
+ fn add(dir: String, fn: String) String {
    if dir.bytes == 0 : return fn
    let s1 = dir.ends_with(PATH_DIV) || dir.ends_with(PATH_DIV_REPLACE)
    let s2 = fn.starts_with(PATH_DIV) || fn.starts_with(PATH_DIV_REPLACE)
    if !s1 && !s2 : return dir + PATH_DIV + fn
    if s1 && s2 : return (dir + fn.ltrim(PATH_DIV).ltrim(PATH_DIV_REPLACE))
    return dir + fn
}

/// Returns the current working directory.
///
/// Throws `.os` on failure.
+ fn cwd() String !io.IoError {
    #if OS == "win"
    @unsafe
    let buf: [u16 x 4096] = @undefined
    let length = ext.GetCurrentDirectoryW(PATH_MAX.to(u32), @ref(buf))
    if length == 0 || length >= PATH_MAX : throw .os
    return windows_string(@ref(buf).@cast(ptr), length) !>
    #else
    let buf: [u8 x 4096] = @undefined
    let dir = ext.getcwd(@ref(buf), 4096)
    if !isset(dir) : throw .os
    return dir
    #end
}

/// Changes the current working directory of the process to `path`.
///
/// Throws `.os` on failure.
+ fn chdir(path: String) !io.IoError {
    #if OS == "win"
    @unsafe
    let wide_path = windows_path(path) !>
    if ext.SetCurrentDirectoryW(wide_path.items().@cast(ptr)) == 0 : throw .os
    #else
    if ext.chdir(path.data_cstring) != 0 : throw .os
    #end
}

/// Returns the directory that contains the running executable; cached after the first call.
///
/// Throws `.os` when the executable's path cannot be determined.
+ fn exe_dir() String !io.IoError {
    let dir = EXE_DIR
    if isset(dir) : return dir
    let d = dir_of(exe_path() !>)
    EXE_DIR = d
    return d
}

/// Returns the absolute path of the running executable.
///
/// Symlinks are resolved on Linux and macOS. Throws `.os` when the OS cannot report the path.
+ fn exe_path() String !io.IoError {
    let p = EXE_PATH
    if isset(p) {
        return p
    }
    // TODO: USE PATH_MAX
    #if OS == "win"
    @unsafe
    let buf: [u16 x 4096] = @undefined
    let len = ext.GetModuleFileNameW(null, @ref(buf), PATH_MAX.to(u32))
    if len == 0 || len >= PATH_MAX : throw .os
    let str = windows_string(@ref(buf).@cast(ptr), len) !>
    str = resolve(str)
    EXE_PATH = str
    return str
    #elif OS == "macos"

    let buf: [u8 x 4096] = @undefined
    let size: u32 = PATH_MAX;
    if ext._NSGetExecutablePath(@ref(buf), @ref(size)) < 0 : throw .os
    let cbuf: cstring = &buf
    let path: String = cbuf
    return realpath(path) !>

    #else
    @unsafe
    let buf: [u8 x 4096] = @undefined
    let link = "/proc/self/exe".data_cstring
    let len = ext.readlink(link, @ref(buf), PATH_MAX)
    if len < 0 || len.to(uint) >= PATH_MAX : throw .os
    let str = String.copy_from_ptr(&buf, len.to(u64))
    str = resolve(str)
    EXE_PATH = str
    return str
    #end
}

/// Returns the absolute path of `path` with symlinks resolved.
///
/// On Linux and macOS a `path` that does not exist comes back unchanged, so the result may be
/// relative, and a `\` is part of a name there, not a separator. On Windows the path is made
/// absolute and normalized, but symlinks are not resolved. Throws `.os` on failure.
+ fn realpath(path: String) String !io.IoError {
    @unsafe
    #if OS == "win"
    let wide_path = windows_path(path) !>
    let buf: [u16 x 4096] = @undefined
    let length = ext.GetFullPathNameW(wide_path.items().@cast(ptr), PATH_MAX.to(u32), @ref(buf), null)
    if length == 0 || length >= PATH_MAX : throw .os
    return windows_string(@ref(buf).@cast(ptr), length) !>
    #elif OS == "macos"
    let buf: [u8 x 4096] = @undefined
    if path.starts_with(".") {
        path = (cwd() !>) + PATH_DIV + path
    }
    if exists(path) {
        let result = ext.realpath(path.data, @ref(buf))
        if !isset(result) : throw .os
        return result
    }
    return path
    #else
    let buf: [u8 x 4096] = @undefined
    if exists(path) {
        let result = ext.realpath(path.data, @ref(buf))
        if !isset(result) : throw .os
        return result
    }
    return path
    #end
}

/// Returns the extension of the last path component, without the dot unless `with_dot` is set.
///
/// Returns `""` when there is none. Only the part after the last `.` counts (`a.tar.gz` gives
/// `gz`), and a leading dot counts too (`.bashrc` gives `bashrc`).
+ fn extension(path: String, with_dot: bool (false)) String {
    let len = path.bytes
    let start = len
    let found = false
    while start > 0 {
        start--
        let ch = path.get(start)
        if ch == '.' {
            if with_dot == false : start++
            found = true
            break
        }
        if ch == '/' || ch == '\\' : break
    }
    if found == false : return ""
    return path.range(start, len - start)
}

/// Returns `path` without its last component.
///
/// A trailing separator is ignored (`/etc/nginx/` gives `/etc`) and `/etc` gives `/`. A path
/// without a separator gives `.` (`etc` gives `.`), a root stays itself (`/` gives `/`, and
/// on Windows `C:\etc`, `C:\` and `C:` give `C:\`, `C:\` and `C:`), and `""` gives `""`.
/// Both `/` and `\` count as separators on every OS.
+ fn dir_of(path: String) String {
    let bytes = path.bytes
    if bytes == 0 : return ""
    let end = bytes - 1
    while end-- > 0 {
        let ch = path.get(end)
        if ch == '/' || ch == '\\' {
            if end == 0 : end++
            #if OS == "win"
            if end == 2 && path.get(1) == ':' : end++
            #end
            return path.range(0, end)
        }
    }
    #if OS == "win"
    if bytes <= 3 && path.get(1) == ':' : return path
    #end
    let last = path.get(bytes - 1)
    if bytes == 1 && (last == '/' || last == '\\') : return path
    return "."
}

/// Returns the last component of `path`, ignoring trailing separators.
///
/// `/etc/nginx/` gives `nginx`, `/` gives `""` and a path without any separator comes back
/// whole (`nginx.conf` gives `nginx.conf`). Both `/` and `\` count as separators on every OS.
+ fn basename(path: String) String {
    let len = path.bytes
    let start = len
    let rtrim: uint = 0
    while start > 0 {
        let ch = path.get(start - 1)
        if ch == '/' || ch == '\\' {
            start--
            rtrim++
            continue
        }
        break
    }
    let end = start
    while start > 0 {
        let ch = path.get(start - 1)
        if ch == '/' || ch == '\\' : break
        start--
    }
    return path.range(start, end - start)
}

/// Returns the home directory of the current user: `$HOME`, or `%USERPROFILE%` on Windows.
///
/// Throws `.missing` when the variable is not set.
+ fn home_dir() String !LookupError {
    #if OS == "win"
    @unsafe
    let name = windows_path("USERPROFILE") ! throw .missing
    let buf: [u16 x 4096] = @undefined
    let length = ext.GetEnvironmentVariableW(name.items().@cast(ptr), @ref(buf), PATH_MAX.to(u32))
    if length == 0 || length >= PATH_MAX : throw .missing
    return windows_string(@ref(buf).@cast(ptr), length) ! throw .missing
    #else
    return core.getenv("HOME") !>
    #end
}

use mem
use io

+ class InMemoryFile {
    ~ data: ptr
    ~ size: uint
    ~ filename: String ("")
    ~ mime_type: String ("application/octet-stream")

    fn set_metadata(filename: String, mime_type: String) {
        this.filename = filename
        this.mime_type = mime_type
    }

    + static fn copy_from_ptr(data: ptr, size: uint) SELF  {
        @unsafe
        let d = data
        if size > 0 {
            d = mem.alloc(size)
            mem.copy_bytes(data, d, size)
        }
        return SELF {
            data: d
            size: size
        }
    }
    + static fn create_from_buffer(buffer: ByteBuffer) SELF {
        @unsafe
        return SELF.copy_from_ptr(buffer.data, buffer.length)
    }
    + static fn create_from_view(view: Slice[u8]) SELF {
        @unsafe
        return SELF.copy_from_ptr(view.data, view.length)
    }
    + static fn create_from_file(path: String) SELF !io.IoError {
        let buffer = ByteBuffer.new(128)
        let input = Slice[u8].new(32000, 0)
        let stream = stream(path) !>
        while true {
            let read = stream.read(input) !>
            if read == 0 : break
            buffer.write(input.view(0, read))
        }
        return SELF.create_from_buffer(buffer)
    }

    + fn save(path: String) !io.IoError {
        @unsafe
        write_bytes(path, this.data, this.size, false) !>
    }

    + fn read_all() String {
        @unsafe
        if this.size == 0 : return ""
        return String.copy_from_ptr(this.data, this.size)
    }

    fn gc_free() {
        @unsafe
        if this.size > 0 : mem.free(this.data)
    }
}

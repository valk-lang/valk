use mem
use io

// A file held in memory, such as an upload; `data` is a private copy of the bytes
+ class InMemoryFile {
    ~ data: Slice[u8]
    ~ filename: String ("")
    ~ mime_type: String ("application/octet-stream")

    fn set_metadata(filename: String, mime_type: String) {
        this.filename = filename
        this.mime_type = mime_type
    }

    // Copies `data` (`String` and `ByteBuffer` convert to Slice[u8])
    + static fn new(data: Slice[u8]) SELF {
        let copy = Slice[u8].new(data.length, 0)
        mem.copy(data, copy)
        return SELF { data: copy }
    }
    + static fn from_file(path: String) SELF !io.IoError {
        let stream = stream(path) !>
        let buffer = io.read_all(stream, 32000) !>
        return SELF { data: buffer }
    }

    + fn save(path: String) !io.IoError {
        write(path, this.data) !>
    }
    + fn reader() ByteReader {
        return this.data.reader()
    }
    + fn to_string() String {
        return this.data.to_string()
    }
}

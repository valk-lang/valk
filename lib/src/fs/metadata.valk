use ext
use io

/// The kind of file system entry reported by `stat`.
+ enum FileKind {
    /// A regular file.
    file
    /// A directory.
    directory
    /// Anything else, such as a socket, pipe or device; never reported on Windows.
    other
}

/// Metadata of a file system entry, as returned by `stat`.
+ struct FileInfo {
    /// Size in bytes.
    + size: uint
    /// Whether the entry is a file, a directory or something else.
    + kind: FileKind
    /// Permission bits such as `0c644`.
    ///
    /// On Windows they are derived from the attributes: `0c444` for read-only files, `0c666`
    /// otherwise, plus `0c111` for directories.
    + permissions: u32
    /// Last modification time in nanoseconds since the Unix epoch.
    + modified_time: uint
}

/// Returns the metadata of the entry at `path`, following symlinks.
///
/// Throws `.open` when `path` cannot be inspected.
+ fn stat(path: String) FileInfo !io.IoError {
    @unsafe
    #if OS == "win"
    let wide_path = windows_path(path) ! throw .open
    let handle = ext.CreateFileW(wide_path.items().@cast(ptr), ext.FILE_READ_ATTRIBUTES,
        ext.FILE_SHARE_READ | ext.FILE_SHARE_WRITE | ext.FILE_SHARE_DELETE, null,
        ext.OPEN_EXISTING, ext.FILE_FLAG_BACKUP_SEMANTICS, 0)
    if handle == ext.INVALID_HANDLE_VALUE : throw .open
    let data: ext.BY_HANDLE_FILE_INFORMATION = @undefined
    let ok = ext.GetFileInformationByHandle(handle, @ref(data))
    let closed = ext.CloseHandle(handle)
    if ok == 0 : throw .open
    if closed == 0 : throw .os
    let directory = (data.dwFileAttributes & ext.FILE_ATTRIBUTE_DIRECTORY) != 0
    let permissions: u32 = (data.dwFileAttributes & ext.FILE_ATTRIBUTE_READONLY) != 0 ? 0c444 : 0c666
    if directory : permissions = permissions | 0c111
    let ticks = (data.ftLastWriteTime.dwHighDateTime.to(uint) << 32) | data.ftLastWriteTime.dwLowDateTime
    return FileInfo {
        size: (data.nFileSizeHigh.to(uint) << 32) | data.nFileSizeLow
        kind: directory ? FileKind.directory : FileKind.file
        permissions: permissions
        modified_time: (ticks - 116444736000000000) * 100
    }
    #else
    let data: ext.libc_stat = @undefined
    if ext.stat(path.data_cstring, @ref(data)) == -1 : throw .open
    let kind = FileKind.other
    let mode = data.st_mode & ext.S_IFMT
    if mode == ext.S_IFREG : kind = FileKind.file
    else if mode == ext.S_IFDIR : kind = FileKind.directory
    #if OS == "linux"
    let modified = data.st_mtim.tv_sec.to(uint) * 1_000_000_000 + data.st_mtim.tv_nsec
    #elif OS == "macos"
    let modified = data.st_mtimespec.tv_sec.to(uint) * 1_000_000_000 + data.st_mtimespec.tv_nsec
    #end
    return FileInfo {
        size: data.st_size.to(uint)
        kind: kind
        permissions: (data.st_mode & 0c7777).to(u32)
        modified_time: modified
    }
    #end
}

/// Returns the size in bytes of the entry at `path`, following symlinks.
///
/// Throws `.open` when `path` cannot be inspected.
+ fn size(path: String) uint !io.IoError {
    let info = stat(path) !>
    return info.size
}

/// Returns the last modification time of `path` in nanoseconds since the Unix epoch.
///
/// Follows symlinks. Throws `.open` when `path` cannot be inspected.
+ fn modified_time(path: String) uint !io.IoError {
    let info = stat(path) !>
    return info.modified_time
}

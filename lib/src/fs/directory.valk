use ext
use io
use core

+ fn read_dir(path: String) DirIterator !io.IoError {
    @unsafe
    #if OS == "win"
    let pattern = windows_path(add(path, "*")) ! throw .open
    let data: ext.libc_WIN32_FIND_DATAW = @undefined
    let handle = ext.FindFirstFileW(pattern.items().@cast(ptr), @ref(data))
    if handle == ext.INVALID_HANDLE_VALUE {
        let error = ext.GetLastError()
        if error == ext.ERROR_FILE_NOT_FOUND && is_dir(path) {
            return DirIterator { closed: true, at_end: true }
        }
        throw .open
    }
    return DirIterator { handle: handle, first: true, data: data }
    #else
    let handle = ext.opendir(path.data_cstring)
    if !isset(handle) : throw .open
    return DirIterator { handle: handle }
    #end
}

+ class DirIterator is io.Closer {
    ~ closed: bool (false)
    - at_end: bool (false)
    #if OS == "win"
    - handle: ext.HANDLE (ext.INVALID_HANDLE_VALUE)
    - first: bool (false)
    - data: ext.libc_WIN32_FIND_DATAW
    #else
    - handle: ?ext.DIR (null)
    #end

    // Returns a bare entry name, or null at the end; skips '.' and '..'.
    + fn next() ?String !io.IoError {
        @unsafe
        if this.closed {
            if this.at_end : return null
            throw .closed
        }
        while true {
            #if OS == "win"
            if this.first {
                this.first = false
            } else if ext.FindNextFileW(this.handle, @ref(this.data)) == 0 {
                let error = ext.GetLastError()
                if error != ext.ERROR_NO_MORE_FILES {
                    this.close() ! core.cleanup_warning("Failed to close directory", __FILE__, __LINE__)
                    throw .read
                }
                this.close() !>
                this.at_end = true
                return null
            }
            let name = windows_cstring(@ref(this.data.cFileName).@cast(*u16), 260) ! {
                this.close() ! core.cleanup_warning("Failed to close directory", __FILE__, __LINE__)
                throw E
            }
            #else
            let handle = this.handle
            if !isset(handle) : throw .closed
            ext.set_errno(0)
            let entry = ext.readdir(handle)
            if !isset(entry) {
                let error = ext.get_errno()
                if error != 0 {
                    this.close() ! core.cleanup_warning("Failed to close directory", __FILE__, __LINE__)
                    throw .read
                }
                this.close() !>
                this.at_end = true
                return null
            }
            let name = @ref(entry.d_name).@cast(cstring).to_string()
            #end
            if name == "." || name == ".." : continue
            return name
        }
    }

    + fn close() !io.IoError {
        @unsafe
        if this.closed : return
        this.closed = true
        #if OS == "win"
        if ext.FindClose(this.handle) == 0 : throw .os
        #else
        let handle = this.handle
        if !isset(handle) : return
        this.handle = null
        if ext.closedir(handle) != 0 : throw .os
        #end
    }

    fn gc_free() {
        this.close() ! core.cleanup_warning("Failed to close directory", __FILE__, __LINE__)
    }
}

use ext
use io
use core
use mem

/// Opens the directory `path` for iterating over its entries.
///
/// Throws `.open` when it cannot be opened. The iterator closes itself at the end or when it
/// is garbage-collected; call `close` to release it earlier.
+ fn read_dir(path: String) DirIterator !io.IoError {
    @unsafe
    #if OS == "win"
    let pattern = windows_path(add(path, "*")) ! throw .open
    let data: ext.libc_WIN32_FIND_DATAW = @undefined
    let handle = ext.FindFirstFileW(pattern.items().@cast(ptr), @ref(data))
    if handle == ext.INVALID_HANDLE_VALUE {
        let error = ext.GetLastError()
        if error == ext.ERROR_FILE_NOT_FOUND && is_dir(path) {
            return DirIterator { closed: true, at_end: true }
        }
        throw .open
    }
    return DirIterator { handle: handle, first: true, data: data }
    #else
    let handle = ext.opendir(path.data_cstring)
    if !isset(handle) : throw .open
    return DirIterator { handle: handle }
    #end
}

/// An open directory that yields its entry names one by one; see `read_dir`.
+ class DirIterator is io.Closer {
    /// Whether the handle is closed, by `close` or by reaching the end.
    ~ closed: bool (false)
    - at_end: bool (false)
    #if OS == "win"
    - handle: ext.HANDLE (ext.INVALID_HANDLE_VALUE)
    - first: bool (false)
    - data: ext.libc_WIN32_FIND_DATAW
    #else
    - handle: ?ext.DIR (null)
    #end

    /// Returns the next entry name, or `null` once all entries are read.
    ///
    /// Names are bare, not paths, in file system order; `.` and `..` are skipped. Reaching the end
    /// closes the iterator, and later calls keep returning `null`. Throws `.closed` after an
    /// explicit `close` and `.read` when reading fails.
    + fn next() ?String !io.IoError {
        #if OS == "win"
        return this.next_windows() !>
        #else
        @unsafe
        let entry = this.next_entry() !>
        if !isset(entry) : return null
        return @ref(entry.d_name).@cast(cstring).to_string()
        #end
    }

    /// Writes the next entry name to `out` and returns the bytes written, or `null` once all
    /// entries are read; the names are the ones `next` returns.
    ///
    /// On Linux and macOS the name is copied from the OS entry straight to `out` through a
    /// stack buffer; on Windows it is converted from UTF-16 first. Throws as `next` does,
    /// and the writer's error when `out` fails.
    + fn next_into(out: io.Writer) ?uint !io.IoError {
        #if OS == "win"
        let name = this.next_windows() !>
        if !isset(name) : return null
        return out.write(name) !>
        #else
        @unsafe
        let entry = this.next_entry() !>
        if !isset(entry) : return null
        let name = @ref(entry.d_name).@cast(ptr)
        let remaining = name.@cast(cstring).length()
        let buf: [u8 x 256] = { 0... }
        let text: local &[u8] = &buf
        let written: uint = 0
        let offset: uint = 0
        while remaining > 0 {
            let take = remaining > 256 ? 256 : remaining
            mem.copy_bytes(name.@offset(offset), &buf, take)
            written += out.write(text.view(0, take)) !>
            offset += take
            remaining -= take
        }
        return written
        #end
    }

    #if OS == "win"
    fn next_windows() ?String !io.IoError {
        @unsafe
        if this.closed {
            if this.at_end : return null
            throw .closed
        }
        while true {
            if this.first {
                this.first = false
            } else if ext.FindNextFileW(this.handle, @ref(this.data)) == 0 {
                let error = ext.GetLastError()
                if error != ext.ERROR_NO_MORE_FILES {
                    this.close() ! core.cleanup_warning("Failed to close directory", __FILE__, __LINE__)
                    throw .read
                }
                this.close() !>
                this.at_end = true
                return null
            }
            let name = windows_cstring(@ref(this.data.cFileName).@cast(*u16), 260) ! {
                this.close() ! core.cleanup_warning("Failed to close directory", __FILE__, __LINE__)
                throw E
            }
            if name == "." || name == ".." : continue
            return name
        }
    }
    #else
    // The next entry that is not `.` or `..`, or null at the end, which closes the iterator
    fn next_entry() ?*ext.libc_dirent !io.IoError {
        @unsafe
        if this.closed {
            if this.at_end : return null
            throw .closed
        }
        let handle = this.handle
        if !isset(handle) : throw .closed
        while true {
            ext.set_errno(0)
            let entry = ext.readdir(handle)
            if !isset(entry) {
                let error = ext.get_errno()
                if error != 0 {
                    this.close() ! core.cleanup_warning("Failed to close directory", __FILE__, __LINE__)
                    throw .read
                }
                this.close() !>
                this.at_end = true
                return null
            }
            let name = @ref(entry.d_name).@cast(cstring)
            let len = name.length()
            if len == 1 && name.get(0) == '.' : continue
            if len == 2 && name.get(0) == '.' && name.get(1) == '.' : continue
            return entry
        }
    }
    #end

    /// Closes the directory handle; calling it again does nothing.
    ///
    /// Throws `.os` when the OS reports a failure.
    + fn close() !io.IoError {
        @unsafe
        if this.closed : return
        this.closed = true
        #if OS == "win"
        if ext.FindClose(this.handle) == 0 : throw .os
        #else
        let handle = this.handle
        if !isset(handle) : return
        this.handle = null
        if ext.closedir(handle) != 0 : throw .os
        #end
    }

    fn gc_free() {
        this.close() ! core.cleanup_warning("Failed to close directory", __FILE__, __LINE__)
    }
}

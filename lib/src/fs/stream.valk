use io
use ext
use core

+ fn stream(path: String, options: ?OpenOptions (null)) FileStream !io.IoError {
    let opts = options ?? OpenOptions {}
    let fd = open(path, opts) ! throw .open
    return FileStream { path: path, fd: fd, can_read: opts.read, can_write: opts.write }
}

+ class FileStream {
    ~ path: String
    - fd: Fd
    - can_read: bool
    - can_write: bool
    ~ reading: bool (true)
    + read_offset: uint (0)

    + fn read(bytes: uint (10240), buffer: ByteBuffer) uint !io.IoError {
        if !this.can_read || !this.reading : return 0

        let rcount = io.read(this.fd, buffer, bytes, this.read_offset) ! throw .read
        if rcount == 0 : this.close() !>
        this.read_offset += rcount
        return rcount
    }

    + fn write[T](data: ByteView[T]) !io.IoError $inline {
        @unsafe
        this.write_bytes(data.data, data.bytes) !>
    }
    + fn write_string(str: String) !io.IoError $inline {
        this.write[String](str.view(0, str.bytes)) !>
    }
    + fn write_buffer(buffer: ByteBuffer) !io.IoError $inline {
        this.write[ByteBuffer](buffer.view(0, buffer.length)) !>
    }
    + fn write_buffer_part(buffer: ByteBuffer, length: uint, offset: uint (0)) !io.IoError $inline {
        if offset > buffer.length || length > buffer.length - offset : throw .write
        this.write[ByteBuffer](buffer.view(offset, length)) !>
    }

    + fn write_bytes(from: ptr, len: uint) !io.IoError {
        @unsafe
        if !this.can_write || !this.reading : throw .write
        let rcount: uint = 0
        while len - rcount > 0 {
            let written = io.write_bytes(this.fd, from + rcount, len - rcount) ! throw .write
            if written == 0 : throw .write
            rcount += written
        }
    }

    + fn close() !io.IoError {
        if this.reading {
            this.reading = false
            io.close(this.fd) !>
        }
    }

    fn gc_free() {
        if this.reading {
            this.reading = false
            io.close_cleanup(this.fd, __FILE__, __LINE__)
        }
    }
}

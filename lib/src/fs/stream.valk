use io

/// Opens the file at `path` as a `FileStream`, read-only by default.
///
/// `options` work as for `open`. Throws `.open` when the file cannot be opened.
+ fn stream(path: String, options: ?OpenOptions (null)) FileStream !io.IoError {
    let opts = options ?? OpenOptions {}
    let fd = open(path, opts) ! throw .open
    return FileStream { path: path, fd: fd, can_read: opts.read, can_write: isset(opts.write), append: opts.write == WriteMode.append }
}

/// An open file that reads and writes at a tracked position.
///
/// The descriptor is closed when the stream is garbage-collected if `close` was not called.
+ class FileStream is io.Reader, io.Writer, io.Seeker, io.Closer {
    /// The path the stream was opened with.
    ~ path: String
    - fd: Fd
    - can_read: bool
    - can_write: bool
    - append: bool (false)
    /// Whether the stream is closed, by `close` or by reading to the end.
    ~ closed: bool (false)
    - at_end: bool (false)
    /// Byte offset of the next read or write.
    ~ position: uint (0)

    /// Reads up to `buf.length` bytes at `position` and advances past them.
    ///
    /// Returns 0 at the end of the file. Reaching the end closes the stream: later reads return
    /// 0, but writes and seeks throw `.closed`. Throws `.read` when the stream was not opened for
    /// reading and `.closed` after `close`.
    + fn read(buf: mut &[u8]) uint !io.IoError {
        if this.closed {
            if this.at_end : return 0
            throw .closed
        }
        if !this.can_read : throw .read
        if buf.length == 0 : return 0

        let rcount = io.read(this.fd, buf, this.position) ! throw .read
        if rcount == 0 {
            this.at_end = true
            this.close() !>
        }
        this.position += rcount
        return rcount
    }

    /// Writes all of `data` at `position`, advances past it and returns `data.length`.
    ///
    /// In `WriteMode.append` every write goes to the end of the file. Throws `.write` when the
    /// stream was not opened for writing or the OS fails, and `.closed` when it is closed.
    + fn write(data: &[u8]) uint !io.IoError {
        if this.closed : throw .closed
        if !this.can_write : throw .write
        let remaining = data
        while remaining.length > 0 {
            let written = io.write(this.fd, remaining, this.append ? uint.$max : this.position) ! throw .write
            if written == 0 || written > remaining.length : throw .write
            if this.append {
                this.position = io.seek(this.fd, 0, io.SeekFrom.end) ! throw .write
            } else {
                this.position += written
            }
            remaining = remaining.view(written, remaining.length - written)
        }
        return data.length
    }

    /// Flushes the written data to disk.
    ///
    /// `data_only` skips metadata that is not needed to read the data back; only Linux supports
    /// it. Throws `.write` when the stream is not writable or flushing fails.
    + fn sync(data_only: bool (false)) !io.IoError {
        if this.closed : throw .closed
        if !this.can_write : throw .write
        io.sync(this.fd, data_only) ! throw .write
    }

    /// Moves `position` to `offset` bytes from `from` and returns the new position.
    ///
    /// Seeking past the end is allowed. `SeekFrom.end` takes the current size of the file at
    /// `path`, not of the open descriptor. Throws `.range` when the target is before the start or
    /// too large, and `.closed` when the stream is closed.
    + fn seek(offset: int, from: io.SeekFrom (io.SeekFrom.start)) uint !io.IoError {
        if this.closed : throw .closed
        let base: uint = 0
        if from == io.SeekFrom.current {
            base = this.position
        } else if from == io.SeekFrom.end {
            base = size(this.path) !>
        }

        let target: uint = 0
        if offset < 0 {
            let distance = (-(offset + 1)).to(uint) + 1
            if distance > base : throw .range
            target = base - distance
        } else {
            target = base.checked_add(offset.to(uint)) ! throw .range
        }
        if target > 9223372036854775807.to(uint) : throw .range

        io.seek(this.fd, target.to(int)) !>
        this.position = target
        return target
    }

    /// Closes the stream; calling it again does nothing.
    ///
    /// Throws `.os` when the OS reports a failure.
    + fn close() !io.IoError {
        if this.closed : return
        this.closed = true
        io.close(this.fd) !>
    }

    fn gc_free() {
        if !this.closed {
            this.closed = true
            io.close_cleanup(this.fd, __FILE__, __LINE__)
        }
    }
}

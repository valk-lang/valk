use io

+ fn stream(path: String, options: ?OpenOptions (null)) FileStream !io.IoError {
    let opts = options ?? OpenOptions {}
    let fd = open(path, opts) ! throw .open
    return FileStream { path: path, fd: fd, can_read: opts.read, can_write: opts.write }
}

+ class FileStream is io.Reader, io.Writer, io.Seeker, io.Closer {
    ~ path: String
    - fd: Fd
    - can_read: bool
    - can_write: bool
    ~ closed: bool (false)
    ~ position: uint (0)

    + fn read(buf: Slice[u8]) uint !io.IoError {
        if !this.can_read || this.closed : return 0

        let rcount = io.read(this.fd, buf, this.position) ! throw .read
        if rcount == 0 : this.close() !>
        this.position += rcount
        return rcount
    }

    // Writes all of `data`; returns the number of bytes written
    + fn write(data: Slice[u8]) uint !io.IoError {
        if !this.can_write || this.closed : throw .write
        let remaining = data
        while remaining.length > 0 {
            let written = io.write(this.fd, remaining) ! throw .write
            if written == 0 || written > remaining.length : throw .write
            remaining = remaining.view(written, remaining.length - written)
        }
        return data.length
    }

    + fn sync(data_only: bool (false)) !io.IoError {
        if !this.can_write || this.closed : throw .write
        io.sync(this.fd, data_only) ! throw .write
    }

    + fn seek(offset: int, from: io.SeekFrom (io.SeekFrom.start)) uint !io.IoError {
        if this.closed : throw .read
        let base: uint = 0
        if from == io.SeekFrom.current {
            base = this.position
        } else if from == io.SeekFrom.end {
            base = size(this.path) ! throw .read
        }

        let target: uint = 0
        if offset < 0 {
            let distance = (-(offset + 1)).to(uint) + 1
            if distance > base : throw .read
            target = base - distance
        } else {
            target = base.checked_add(offset.to(uint)) ! throw .read
        }
        if target > 9223372036854775807.to(uint) : throw .read

        io.seek(this.fd, target.to(int)) ! throw .read
        this.position = target
        return target
    }

    + fn close() !io.IoError {
        if this.closed : return
        this.closed = true
        io.close(this.fd) !>
    }

    fn gc_free() {
        if !this.closed {
            this.closed = true
            io.close_cleanup(this.fd, __FILE__, __LINE__)
        }
    }
}

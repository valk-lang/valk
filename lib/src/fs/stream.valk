use io

+ fn stream(path: String, options: ?OpenOptions (null)) FileStream !io.IoError {
    let opts = options ?? OpenOptions {}
    let fd = open(path, opts) ! throw .open
    return FileStream { path: path, fd: fd, can_read: opts.read, can_write: opts.write }
}

+ class FileStream {
    ~ path: String
    - fd: Fd
    - can_read: bool
    - can_write: bool
    ~ reading: bool (true)
    + read_offset: uint (0)

    + fn read(buf: Slice[u8]) uint !io.IoError {
        if !this.can_read || !this.reading : return 0

        let rcount = io.read(this.fd, buf, this.read_offset) ! throw .read
        if rcount == 0 : this.close() !>
        this.read_offset += rcount
        return rcount
    }

    + fn write(data: Slice[u8]) !io.IoError $inline {
        @unsafe
        this.write_bytes(data.data, data.length) !>
    }

    + fn write_bytes(from: ptr, len: uint) !io.IoError {
        @unsafe
        if !this.can_write || !this.reading : throw .write
        let rcount: uint = 0
        while len - rcount > 0 {
            let written = io.write_bytes(this.fd, from + rcount, len - rcount) ! throw .write
            if written == 0 : throw .write
            rcount += written
        }
    }

    + fn sync(data_only: bool (false)) !io.IoError {
        if !this.can_write || !this.reading : throw .write
        io.sync(this.fd, data_only) ! throw .write
    }

    + fn seek(offset: int, from: io.SeekFrom (io.SeekFrom.start)) uint !io.IoError {
        if !this.reading : throw .read
        let base: uint = 0
        if from == io.SeekFrom.current {
            base = this.read_offset
        } else if from == io.SeekFrom.end {
            base = size(this.path) ! throw .read
        }

        let position: uint = 0
        if offset < 0 {
            let distance = (-(offset + 1)).to(uint) + 1
            if distance > base : throw .read
            position = base - distance
        } else {
            position = base.checked_add(offset.to(uint)) ! throw .read
        }
        if position > 9223372036854775807.to(uint) : throw .read

        io.seek(this.fd, position.to(int)) ! throw .read
        this.read_offset = position
        return position
    }

    + fn close() !io.IoError {
        if this.reading {
            this.reading = false
            io.close(this.fd) !>
        }
    }

    fn gc_free() {
        if this.reading {
            this.reading = false
            io.close_cleanup(this.fd, __FILE__, __LINE__)
        }
    }
}

use core

/// Returns the paths that match `pattern`, sorted.
///
/// In a pattern `*` matches any run of characters within one name, `?` one character,
/// `[abc]`, `[a-z]` and `[!a]` one character of a set, and a `**` segment any number of
/// directories, also none: `src/**/*.valk`. A wildcard does not match the leading `.` of a
/// hidden name unless the pattern writes the `.`, and `**` does not enter hidden or
/// symlinked directories. A relative pattern is taken against `cwd()` and gives relative
/// paths. Directories that cannot be read are skipped, so there is no error; a pattern that
/// matches nothing gives an empty array. On Windows names match without regard to case and
/// either separator may be used.
+ fn glob(pattern: String) Array[String] {
    let root = ""
    let rest = pattern
    #if OS == "win"
    rest = rest.replace(PATH_DIV_REPLACE, PATH_DIV)
    if rest.bytes >= 2 && rest.get(1) == ':' {
        root = rest.range(0, 2) + PATH_DIV
        rest = rest.range(2, rest.bytes - 2)
    } else if rest.starts_with(PATH_DIV) {
        root = PATH_DIV
    }
    #else
    if rest.starts_with(PATH_DIV) : root = PATH_DIV
    #end
    let segments = Array[String]{}
    each rest.split(PATH_DIV) as part {
        if part.bytes == 0 || part == "." : continue
        // Several `**` in a row match the same as one
        if part == "**" && (segments.get(segments.length - 1) !? "") == "**" : continue
        segments.append(part)
    }
    let found = HashSet[String]{}
    if segments.length > 0 : glob_walk(root, segments, 0, found)
    let result = found.items()
    result.sort()
    return result
}

fn glob_walk(prefix: String, segments: Array[String], index: uint, found: HashSet[String]) {
    if index == segments.length {
        if prefix.bytes > 0 : found.add(prefix)
        return
    }
    let segment = segments.get(index) ! return
    let last = index + 1 == segments.length
    if segment == "**" {
        glob_walk(prefix, segments, index + 1, found)
        each glob_entries(prefix) as name {
            if name.starts_with(".") : continue
            let path = glob_join(prefix, name)
            if is_dir(path) && !is_symlink(path) : glob_walk(path, segments, index, found)
        }
        return
    }
    if !glob_has_wildcard(segment) {
        let path = glob_join(prefix, segment)
        if last {
            if exists(path) : found.add(path)
        } else if is_dir(path) {
            glob_walk(path, segments, index + 1, found)
        }
        return
    }
    each glob_entries(prefix) as name {
        if !glob_match(segment, name) : continue
        let path = glob_join(prefix, name)
        if last : found.add(path)
        else if is_dir(path) : glob_walk(path, segments, index + 1, found)
    }
}

// The names in a directory; none when it cannot be read
fn glob_entries(prefix: String) Array[String] {
    let names = Array[String]{}
    let dir = read_dir(prefix.bytes == 0 ? "." : prefix) ! return names
    while true {
        let name = dir.next() ! break
        if !isset(name) : break
        names.append(name)
    }
    dir.close() _
    return names
}

fn glob_join(prefix: String, name: String) String {
    if prefix.bytes == 0 : return name
    return add(prefix, name)
}

fn glob_has_wildcard(segment: String) bool {
    return segment.contains("*") || segment.contains("?") || segment.contains("[")
}

// Whether `name` matches one pattern segment
fn glob_match(pattern: String, name: String) bool {
    if name.starts_with(".") && !pattern.starts_with(".") : return false
    let p: uint = 0
    let n: uint = 0
    // Where to retry after the last `*`
    let star_p = uint.$max
    let star_n: uint = 0
    while n < name.bytes {
        if p < pattern.bytes {
            let ch = pattern.get(p)
            if ch == '*' {
                star_p = p
                star_n = n
                p++
                continue
            }
            if ch == '?' {
                p++
                n = glob_next_char(name, n)
                continue
            }
            if ch == '[' {
                let end = glob_set_end(pattern, p)
                if end > 0 {
                    if glob_set_has(pattern, p + 1, end, name.get(n)) {
                        p = end + 1
                        n = glob_next_char(name, n)
                        continue
                    }
                } else if glob_same(ch, name.get(n)) {
                    p++
                    n++
                    continue
                }
            } else if glob_same(ch, name.get(n)) {
                p++
                n++
                continue
            }
        }
        // Mismatch: let the last `*` take one more character
        if star_p == uint.$max : return false
        p = star_p + 1
        star_n = glob_next_char(name, star_n)
        n = star_n
    }
    while p < pattern.bytes && pattern.get(p) == '*' : p++
    return p == pattern.bytes
}

// The index after the UTF-8 character at `index`
fn glob_next_char(text: String, index: uint) uint {
    let i = index + 1
    while i < text.bytes && (text.get(i) & 0xC0) == 0x80 : i++
    return i
}

// The index of the `]` closing the set that starts at `start`, 0 when it is not closed
fn glob_set_end(pattern: String, start: uint) uint {
    let i = start + 1
    if i < pattern.bytes && pattern.get(i) == '!' : i++
    // A `]` right at the start is part of the set
    if i < pattern.bytes && pattern.get(i) == ']' : i++
    while i < pattern.bytes {
        if pattern.get(i) == ']' : return i
        i++
    }
    return 0
}

fn glob_set_has(pattern: String, from: uint, end: uint, ch: u8) bool {
    let negate = pattern.get(from) == '!'
    let i = negate ? from + 1 : from
    let hit = false
    while i < end {
        let low = pattern.get(i)
        if i + 2 < end && pattern.get(i + 1) == '-' {
            let high = pattern.get(i + 2)
            if glob_in_range(ch, low, high) : hit = true
            i += 3
            continue
        }
        if glob_same(low, ch) : hit = true
        i++
    }
    return hit != negate
}

fn glob_in_range(ch: u8, low: u8, high: u8) bool {
    if ch >= low && ch <= high : return true
    #if OS == "win"
    let lower = glob_lower(ch)
    return lower >= glob_lower(low) && lower <= glob_lower(high)
    #else
    return false
    #end
}

fn glob_same(a: u8, b: u8) bool {
    #if OS == "win"
    return glob_lower(a) == glob_lower(b)
    #else
    return a == b
    #end
}

#if OS == "win"
fn glob_lower(ch: u8) u8 {
    if ch >= 'A' && ch <= 'Z' : return ch + 32
    return ch
}
#end

use ext
use io
use core

// Socket options and local binding, shared by the TCP and UDP classes. Every
// function takes the descriptor; the classes add the `closed` checks.

fn set_option_int(fd: Fd, level: i32, name: i32, value: i32) !NetError {
    @unsafe
    if ext.setsockopt(fd, level, name, @ref(value), size_of(i32)) != 0 : throw .os
}

fn set_option_bytes(fd: Fd, level: i32, name: i32, value: ptr, length: u32) !NetError {
    @unsafe
    if ext.setsockopt(fd, level, name, value, length) != 0 : throw .os
}

// SO_BROADCAST: may send to a broadcast address
fn set_broadcast_fd(fd: Fd, enabled: bool) !NetError {
    set_option_int(fd, ext.SOL_SOCKET, ext.SO_BROADCAST, enabled ? 1 : 0) !>
}

// SO_RCVBUF / SO_SNDBUF; the system may round or cap the value
fn set_receive_buffer_fd(fd: Fd, bytes: uint) !NetError {
    set_option_int(fd, ext.SOL_SOCKET, ext.SO_RCVBUF, bytes.to(i32)) !>
}
fn set_send_buffer_fd(fd: Fd, bytes: uint) !NetError {
    set_option_int(fd, ext.SOL_SOCKET, ext.SO_SNDBUF, bytes.to(i32)) !>
}

// Hop limit of outgoing packets to one address
fn set_ttl_fd(fd: Fd, ipv6: bool, hops: u8) !NetError {
    if ipv6 : set_option_int(fd, ext.IPPROTO_IPV6, ext.IPV6_UNICAST_HOPS, hops.to(i32)) !>
    else : set_option_int(fd, ext.IPPROTO_IP, ext.IP_TTL, hops.to(i32)) !>
}

// Hop limit of outgoing packets to a multicast group
fn set_multicast_ttl_fd(fd: Fd, ipv6: bool, hops: u8) !NetError {
    if ipv6 : set_option_int(fd, ext.IPPROTO_IPV6, ext.IPV6_MULTICAST_HOPS, hops.to(i32)) !>
    else : set_option_int(fd, ext.IPPROTO_IP, ext.IP_MULTICAST_TTL, hops.to(i32)) !>
}

// Whether this machine receives the multicast packets it sends
fn set_multicast_loopback_fd(fd: Fd, ipv6: bool, enabled: bool) !NetError {
    if ipv6 : set_option_int(fd, ext.IPPROTO_IPV6, ext.IPV6_MULTICAST_LOOP, enabled ? 1 : 0) !>
    else : set_option_int(fd, ext.IPPROTO_IP, ext.IP_MULTICAST_LOOP, enabled ? 1 : 0) !>
}

// The interface multicast packets leave through: an IPv4 address, or an
// interface index for IPv6
fn set_multicast_interface_v4_fd(fd: Fd, interface_ip: String) !NetError {
    @unsafe
    let address = SocketAddress.parse(interface_ip, 0) !>
    if address.ipv6 : throw .invalid_host
    let buffer = [u8 x 4]{ 0... }
    address.write_ip(@ref(buffer).@cast(ptr))
    set_option_bytes(fd, ext.IPPROTO_IP, ext.IP_MULTICAST_IF, @ref(buffer).@cast(ptr), 4) !>
}
fn set_multicast_interface_v6_fd(fd: Fd, interface_index: u32) !NetError {
    set_option_int(fd, ext.IPPROTO_IPV6, ext.IPV6_MULTICAST_IF, interface_index.to(i32)) !>
}

// IP_ADD_MEMBERSHIP / IP_DROP_MEMBERSHIP with `struct ip_mreq { group, interface }`
fn multicast_membership_v4(fd: Fd, group: String, interface_ip: String, join: bool) !NetError {
    @unsafe
    let address = SocketAddress.parse(group, 0) !>
    let via = SocketAddress.parse(interface_ip, 0) !>
    if address.ipv6 || via.ipv6 : throw .invalid_host
    let buffer = [u8 x 8]{ 0... }
    let base = @ref(buffer).@cast(ptr)
    address.write_ip(base)
    via.write_ip(base + 4)
    set_option_bytes(fd, ext.IPPROTO_IP, join ? ext.IP_ADD_MEMBERSHIP : ext.IP_DROP_MEMBERSHIP, base, 8) !>
}

// IPV6_ADD_MEMBERSHIP / IPV6_DROP_MEMBERSHIP with `struct ipv6_mreq { group, interface }`
fn multicast_membership_v6(fd: Fd, group: String, interface_index: u32, join: bool) !NetError {
    @unsafe
    let address = SocketAddress.parse(group, 0) !>
    if !address.ipv6 : throw .invalid_host
    let buffer = [u8 x 20]{ 0... }
    let base = @ref(buffer).@cast(ptr)
    address.write_ip(base)
    @ptrv(base, u32, 4) = interface_index
    set_option_bytes(fd, ext.IPPROTO_IPV6, join ? ext.IPV6_ADD_MEMBERSHIP : ext.IPV6_DROP_MEMBERSHIP, base, 20) !>
}

// Binds a client socket to a chosen local address before it connects. An empty
// `host` means any interface; port 0 means any port. Throws `invalid_host` when
// `host` is not numeric or of the other family, and the bind errors otherwise.
fn bind_local(fd: Fd, ipv6: bool, host: String, port: u16) !NetError {
    @unsafe
    if host.length == 0 {
        if !bind_any(fd, ipv6, port) : bind_failed() !>
        return
    }
    let address = SocketAddress.parse(host, port) !>
    if address.ipv6 != ipv6 : throw .invalid_host
    let buffer = [u8 x 28]{ 0... }
    let length = address.write_sockaddr(@ref(buffer).@cast(ptr))
    if ext.bind(fd, @ref(buffer).@cast(*ext.libc_sockaddr), length) != 0 : bind_failed() !>
}

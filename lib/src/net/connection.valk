use io
use core

#if TEST && OS == "linux"
use ext
#end

+ class Connection {
    ~ fd: Fd
    ~+ host: String ("")
    ~ ssl: ?Ssl (null)
    ~ ssl_enabled: bool (false)
    + read_timeout_ms: uint (5000)
    + write_timeout_ms: uint (5000)
    - closed: bool (false)

    + static fn new(fd: Fd) Connection !NetError {
        #if OS == "linux" || OS == "macos"
        io.set_nonblocking(fd, true) ! {
            Socket.close_fd_cleanup(fd, __FILE__, __LINE__)
            throw .os
        }
        #end
        return Connection {
            fd: fd
        }
    }

    #if TEST && OS == "linux"
    + fn is_non_block_for_test() bool {
        let flags = ext.fcntl(this.fd, ext.F_GETFL, 0)
        return flags >= 0 && (flags & ext.O_NONBLOCK) != 0
    }
    #end

    + fn close() !NetError {
        if this.closed : return
        this.closed = true
        let ssl = this.ssl
        if isset(ssl) {
            ssl.close(this.write_timeout_ms) ! {}
        }
        Socket.close_fd(this.fd) !>
    }

    fn gc_free() {
        if !this.closed {
            this.closed = true
            Socket.close_fd_cleanup(this.fd, __FILE__, __LINE__)
        }
    }

    + fn ssl_connect(ssl: Ssl, timeout_ms: uint (5000)) !NetError {
        if this.ssl_enabled : return

        ssl.set_host(this.host) !>
        ssl.connect(this.fd, timeout_ms) !>

        this.ssl = ssl
        this.ssl_enabled = true
    }

    + fn ssl_accept(context: shared SslServerContext, timeout_ms: uint (5000)) !NetError {
        if this.ssl_enabled : return

        let ssl = SslServerContext.connection(context)
        ssl.accept(this.fd, timeout_ms) !>

        this.ssl = ssl
        this.ssl_enabled = true
    }

    + fn send(data: Slice[u8], send_all: bool (true)) uint !NetError $inline {
        @unsafe
        return this.send_bytes(data.data, data.length, send_all) !>
    }

    + fn send_bytes(data: ptr, bytes: uint, send_all: bool) uint !NetError {
        @unsafe
        if this.closed : throw .closed

        if bytes == 0 : return 0
        let ssl = this.ssl
        let bytes_sent: uint = 0
        let bytes_to_send: uint = bytes

        while true {
            let new_bytes: uint = 0
            if isset(ssl) {
                new_bytes = ssl.write(data, bytes_to_send, this.write_timeout_ms)
            } else {
                new_bytes = send_bytes(this.fd, data, bytes_to_send, this.write_timeout_ms) !>
            }

            if new_bytes > bytes_to_send : throw .write
            bytes_sent += new_bytes
            if bytes_sent == bytes : break
            if bytes_sent < bytes {
                data += new_bytes
                bytes_to_send -= new_bytes
                if send_all : continue
                break
            }

            throw .write
        }

        return bytes_sent
    }

    + fn recv(buffer: ByteBuffer, bytes: uint) uint !NetError {
        if this.closed : throw .closed
        let ssl = this.ssl;

        if isset(ssl) {
            return ssl.recv(buffer, bytes, this.read_timeout_ms) !>
        }

        return recv(this.fd, buffer, bytes, this.read_timeout_ms) !>
    }

    + fn set_timeouts(read_timeout_ms: uint, write_timeout_ms: uint) SELF {
        this.read_timeout_ms = read_timeout_ms
        this.write_timeout_ms = write_timeout_ms
        return this
    }
}

use io
use core
use ext
use sync

/// A connected TCP stream, optionally with TLS, read and written from a coroutine.
///
/// The descriptor belongs to the connection: it is closed by `close` or when the object is
/// collected.
+ class Connection is io.Reader, io.Writer, io.Closer {
    /// The OS socket descriptor.
    ~ fd: Fd
    /// The host the connection was made to; empty for accepted connections and `new`.
    ~+ host: String ("")
    /// The TLS session, once `ssl_connect` or `ssl_accept` succeeded.
    ~ ssl: ?Ssl (null)
    /// True once a TLS handshake succeeded; reads and writes then go through TLS.
    ~ ssl_enabled: bool (false)
    /// Milliseconds a single `read` may wait for data; 0 waits forever.
    + read_timeout_ms: uint (5000)
    /// Milliseconds each send inside `write` may wait; 0 waits forever.
    + write_timeout_ms: uint (5000)
    - closed: bool (false)
    - socket_closed: bool (false)
    - interrupted: bool (false)
    - cancel: ?shared sync.CancelToken (null)

    /// Wraps an already connected socket descriptor and takes ownership of it.
    ///
    /// On Linux and macOS the descriptor is made non-blocking; when that fails it is closed
    /// and `os` is thrown.
    + static fn new(fd: Fd) Connection !NetError {
        #if OS == "linux" || OS == "macos"
        io.set_nonblocking(fd, true) ! {
            Socket.close_fd_cleanup(fd, __FILE__, __LINE__)
            throw .os
        }
        #end
        return Connection {
            fd: fd
        }
    }

    #if TEST && OS == "linux"
    /// Test hook: returns true when the descriptor has `O_NONBLOCK` set.
    + fn is_non_block_for_test() bool {
        let flags = ext.fcntl(this.fd, ext.F_GETFL, 0)
        return flags >= 0 && (flags & ext.O_NONBLOCK) != 0
    }
    #end

    /// Closes the connection; does nothing when already closed.
    ///
    /// With TLS a close notify is sent first (bounded by `write_timeout_ms`, failures
    /// ignored). Throws `os` when closing the descriptor fails.
    + fn close() !io.IoError {
        if this.closed : return
        this.closed = true
        let ssl = this.ssl
        if isset(ssl) {
            ssl.close(this.write_timeout_ms) ! {}
        }
        this.socket_closed = true
        this.unwatch()
        Socket.close_fd(this.fd) ! throw .os
    }

    /// Makes pending and later reads and writes throw `cancelled` once `token` is cancelled.
    ///
    /// The registration replaces any earlier token and lasts until `close`. When `token` is
    /// already cancelled the connection is interrupted right away.
    + fn set_cancel(token: shared sync.CancelToken) {
        this.unwatch()
        this.cancel = token
        if token.watch_fd(this.fd) : this.interrupt()
    }

    fn unwatch() {
        let cancel = this.cancel
        if isset(cancel) {
            cancel.unwatch_fd(this.fd)
            this.cancel = null
        }
    }

    fn is_cancelled() bool {
        let cancel = this.cancel
        return isset(cancel) && cancel.is_cancelled()
    }

    // Wake pending I/O and make later I/O fail, without releasing the
    // descriptor or touching TLS state. Idempotent.
    fn interrupt() {
        if this.socket_closed || this.interrupted : return
        this.interrupted = true
        io.interrupt_fd(this.fd)
    }

    fn gc_free() {
        if !this.closed {
            this.closed = true
            Socket.close_fd_cleanup(this.fd, __FILE__, __LINE__)
        }
    }

    /// Runs the TLS client handshake over this connection with `ssl`.
    ///
    /// A non-empty `host` is passed to `Ssl.set_host`: a name is sent as the server name
    /// (SNI) and the certificate must match it; an IP address is not sent, the certificate
    /// must match it as an address. With an empty `host` (connections from `new` and
    /// `accept`) no server name is sent and no name is checked, unless `ssl.set_host` was
    /// called. Does nothing when TLS is already enabled. Throws `ssl`, `timeout`, `closed`
    /// or `os`.
    + fn ssl_connect(ssl: Ssl, timeout_ms: uint (5000)) !NetError {
        if this.ssl_enabled : return

        if this.host.bytes > 0 : ssl.set_host(this.host) !>
        ssl.connect(this.fd, timeout_ms) !>

        this.ssl = ssl
        this.ssl_enabled = true
    }

    /// Runs the TLS server handshake over this connection with a session from `context`.
    ///
    /// Does nothing when TLS is already enabled. Throws `ssl`, `timeout`, `closed` or `os`.
    + fn ssl_accept(context: shared SslServerContext, timeout_ms: uint (5000)) !NetError {
        if this.ssl_enabled : return

        let ssl = SslServerContext.connection(context)
        ssl.accept(this.fd, timeout_ms) !>

        this.ssl = ssl
        this.ssl_enabled = true
    }

    /// Sends all of `data` and returns its length.
    ///
    /// `write_timeout_ms` bounds each partial send, not the whole call. Throws `closed`,
    /// `cancelled`, `timeout` or `write`.
    + fn write(data: local &[u8]) uint !io.IoError {
        if this.closed : throw .closed
        if this.is_cancelled() : throw .cancelled

        let ssl = this.ssl
        let remaining = data
        while remaining.length > 0 {
            let sent: uint = 0
            if isset(ssl) {
                sent = ssl.write(remaining, this.write_timeout_ms) ! {
                    if this.is_cancelled() : throw .cancelled
                    if error_is(E.code, timeout) : throw .timeout
                    if error_is(E.code, closed) : throw .closed
                    throw .write
                }
            } else {
                sent = write(this.fd, remaining, this.write_timeout_ms) ! {
                    if this.is_cancelled() : throw .cancelled
                    throw E
                }
            }
            if sent == 0 || sent > remaining.length {
                if this.is_cancelled() : throw .cancelled
                throw .write
            }
            remaining = remaining.view(sent, remaining.length - sent)
        }
        return data.length
    }

    /// Reads up to `buf.length` bytes into `buf` and returns the count.
    ///
    /// Never returns 0 for a non-empty `buf`: when the peer closed its end, `closed` is thrown.
    /// Also throws `timeout` after `read_timeout_ms`, `cancelled` and `read`.
    + fn read(buf: local mut &[u8]) uint !io.IoError {
        if this.closed : throw .closed
        if this.is_cancelled() : throw .cancelled
        let ssl = this.ssl
        let bytes: uint = 0
        if isset(ssl) {
            bytes = ssl.recv(buf, this.read_timeout_ms) ! {
                if this.is_cancelled() : throw .cancelled
                if error_is(E.code, timeout) : throw .timeout
                if error_is(E.code, closed) : throw .closed
                throw .read
            }
        } else {
            bytes = recv(this.fd, buf, this.read_timeout_ms) ! {
                if this.is_cancelled() : throw .cancelled
                throw E
            }
        }
        if bytes == 0 && buf.length > 0 {
            if this.is_cancelled() : throw .cancelled
            throw .closed
        }
        return bytes
    }


    /// Sets `read_timeout_ms` and `write_timeout_ms`; 0 waits forever.
    + fn set_timeouts(read_timeout_ms: uint, write_timeout_ms: uint) {
        this.read_timeout_ms = read_timeout_ms
        this.write_timeout_ms = write_timeout_ms
    }
}

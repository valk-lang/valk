use fs
use io
use core
use time

global ca_paths: ?Array[String]

/// A TLS protocol version, for the minimum and maximum version settings.
+ enum TlsVersion: i32 {
    /// TLS 1.2.
    tls_1_2 (TLS1_2_VERSION)
    /// TLS 1.3.
    tls_1_3 (TLS1_3_VERSION)
}

/// Server-side TLS settings (certificate, key, versions, ciphers) shared by all connections.
///
/// Share one context and call `Connection.ssl_accept` with it for each accepted connection.
/// The OpenSSL context is freed when the object is collected.
+ class SslServerContext {
    /// The OpenSSL `SSL_CTX` handle.
    ~ ctx: SSL_CTX

    /// Loads the PEM `certificate_file` and `private_key_file` and checks that they match.
    ///
    /// `cipher_list` (OpenSSL cipher string) applies to TLS 1.2, `cipher_suites` (colon-separated
    /// names) to TLS 1.3; `null` keeps OpenSSL's defaults. Throws `ssl` when a file cannot be
    /// loaded, the key does not match, or a setting is rejected.
    + static fn new(
        certificate_file: String,
        private_key_file: String,
        min_version: TlsVersion (TlsVersion.tls_1_2),
        cipher_list: ?String (null),
        cipher_suites: ?String (null)
    ) SELF !NetError {
        @unsafe
        let ctx = SSL_CTX_new(TLS_server_method())
        if SSL_CTX_ctrl(ctx, SSL_CTRL_SET_MIN_PROTO_VERSION, min_version.to(int), null) != 1 {
            SSL_CTX_free(ctx)
            throw .ssl
        }
        if SSL_CTX_use_certificate_file(ctx, certificate_file.data, SSL_FILETYPE_PEM) != 1
            || SSL_CTX_use_PrivateKey_file(ctx, private_key_file.data, SSL_FILETYPE_PEM) != 1
            || SSL_CTX_check_private_key(ctx) != 1 {
            SSL_CTX_free(ctx)
            throw .ssl
        }
        if isset(cipher_list) && SSL_CTX_set_cipher_list(ctx, cipher_list.data) != 1 {
            SSL_CTX_free(ctx)
            throw .ssl
        }
        if isset(cipher_suites) && SSL_CTX_set_ciphersuites(ctx, cipher_suites.data) != 1 {
            SSL_CTX_free(ctx)
            throw .ssl
        }
        ERR_clear_error()
        return SELF { ctx: ctx }
    }

    /// Returns a new server session using `context`, for one connection.
    ///
    /// The session keeps `context` alive. `Connection.ssl_accept` calls this for you.
    + static fn connection(context: shared SslServerContext) Ssl {
        @unsafe
        return Ssl {
            ctx: context.ctx
            ssl: SSL_new(context.ctx)
            server_context: context
            owns_context: false
        }
    }

    fn gc_free() {
        @unsafe
        SSL_CTX_free(this.ctx)
    }
}

/// One TLS session over one socket, either client or server side.
///
/// Client sessions come from `new`, server sessions from `SslServerContext.connection`.
/// Usually driven through `Connection.ssl_connect` / `ssl_accept` and then `Connection`'s
/// `read` and `write`. OpenSSL resources are freed when the object is collected.
+ class Ssl {
    /// The OpenSSL `SSL_CTX` handle.
    ~ ctx: SSL_CTX
    /// The OpenSSL `SSL` handle.
    ~ ssl: OSSL
    /// The CA directory last given to `set_ca_cert_dir`; `null` when none is set.
    ~ cert_dir: ?String (null)
    /// The CA file last given to `set_ca_cert`; `null` when none is set.
    ~ cert_file: ?String (null)
    /// The OpenSSL error code recorded when a handshake failed; 0 when none was.
    ~ error_code: uint (0)
    - error_message: String ("")
    /// The socket descriptor the handshake ran on.
    ~ fd: Fd (0)
    - error_changed: bool (false)
    /// True from a successful handshake until `close`.
    ~ connected: bool (false)
    - server_context: ?shared SslServerContext
    - owns_context: bool (true)
    - closed: bool (false)
    - write_blocked: bool (false)

    /// Returns the CA bundle files `new` tries, in order.
    ///
    /// OpenSSL's default certificate file first, then the usual system locations of the
    /// platform, then `cacert.pem` in the working directory and next to the executable. The
    /// list is built once per thread; each call returns a new copy of it.
    + static fn default_ca_cert_paths() Array[String] {
        let cached = ca_paths
        if isset(cached) : return cached.copy()
        // List
        let paths = Array[String]{}
        // Default
        let x509_default: String = X509_get_default_cert_file()
        paths.append(x509_default)
        // Macos
        #if OS == "macos"
        paths.append("/usr/local/etc/ca-certificates/cert.pem")
        paths.append("/etc/ssl/cert.pem")
        #end
        // Linux
        #if OS == "linux"
        paths.append("/etc/ssl/certs/ca-certificates.crt")
        paths.append("/etc/pki/tls/certs/ca-bundle.crt")
        paths.append("/etc/ssl/ca-bundle.pem")
        paths.append("/etc/pki/tls/cacert.pem")
        paths.append("/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem")
        paths.append("/etc/ssl/cert.pem")
        #end
        fs.cwd() -> dir: paths.append(fs.add(dir, "cacert.pem"))
        // Exe
        fs.exe_dir() -> dir: paths.append(fs.add(dir, "cacert.pem"))

        ca_paths = paths
        return paths.copy()
    }

    /// Returns a client session that verifies the server certificate.
    ///
    /// Loads the first CA bundle from `default_ca_cert_paths` that OpenSSL accepts, or
    /// OpenSSL's default verify paths when none does. Each session owns its own OpenSSL
    /// context. Tagged `$default`, so it also supplies `Ssl`'s default value.
    + static fn new() Ssl $default {
        @unsafe
        let method = TLS_client_method()
        let ctx = SSL_CTX_new(method)
        SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, null)

        let found = false
        let ca_paths = SELF.default_ca_cert_paths()
        each ca_paths as path {
            if SSL_CTX_load_verify_locations(ctx, path.data, null) != 1 : continue
            found = true
            break
        }

        if !found {
            SSL_CTX_set_default_verify_paths(ctx)
        }
        ERR_clear_error()

        return Ssl {
            ctx: ctx
            ssl: SSL_new(ctx)
        }
    }

    /// Trusts the CA certificates in the PEM file `path` and stores it as `cert_file`.
    ///
    /// Certificates are added to those already trusted, and the `cert_dir` set with
    /// `set_ca_cert_dir` is loaded along with the file. `null` clears `cert_file`;
    /// certificates loaded before stay trusted. On Windows a UNC path (`\\server\share`) is
    /// refused. Throws `ssl` when OpenSSL rejects the file or the directory.
    + fn set_ca_cert(path: ?String) !NetError {
        #if OS == "win"
        if isset(path) && path.starts_with("\\\\") : throw .ssl
        #end
        this.cert_file = path
        this.load_ca_locations() !>
    }
    /// Trusts the CA directory `dir` (OpenSSL `c_rehash` layout) and stores it as `cert_dir`.
    ///
    /// The directory is added to what is already trusted, and the `cert_file` set with
    /// `set_ca_cert` is loaded along with it. `null` clears `cert_dir`; what was loaded before
    /// stays trusted. On Windows a UNC path is refused. Throws `ssl` when OpenSSL rejects the
    /// directory or the file.
    + fn set_ca_cert_dir(dir: ?String) !NetError {
        #if OS == "win"
        if isset(dir) && dir.starts_with("\\\\") : throw .ssl
        #end
        this.cert_dir = dir
        this.load_ca_locations() !>
    }
    // Loads the stored CA file and directory together
    fn load_ca_locations() !NetError {
        @unsafe
        let file = this.cert_file
        let dir = this.cert_dir
        if !isset(file) && !isset(dir) : return
        let file_arg = isset(file) ? file.data : null
        let dir_arg = isset(dir) ? dir.data : null
        if SSL_CTX_load_verify_locations(this.ctx, file_arg, dir_arg) != 1 : throw .ssl
    }
    /// Sets `host` as the server name (SNI) and as the name the peer certificate must match.
    ///
    /// A numeric IPv4 or IPv6 address (`"[::1]"` too) is not sent as a server name; the peer
    /// certificate must match it as an IP address instead. Throws `ssl` when OpenSSL rejects
    /// the name or address.
    + fn set_host(host: String) !NetError {
        @unsafe
        SocketAddress.parse(host) -> address {
            let param = SSL_get0_param(this.ssl)
            if X509_VERIFY_PARAM_set1_ip_asc(param, address.ip().data) != 1 : throw .ssl
            return
        }
        if SSL_ctrl(this.ssl, SSL_CTRL_SET_TLSEXT_HOSTNAME, TLSEXT_NAMETYPE_host_name, host.data) <= 0 : throw .ssl
        if SSL_set1_host(this.ssl, host.data) != 1 : throw .ssl
    }
    /// Turns verification of the peer certificate on or off for this session.
    + fn set_verify(enable: bool) {
        @unsafe
        SSL_set_verify(this.ssl, enable ? SSL_VERIFY_PEER : SSL_VERIFY_NONE, null)
    }

    /// Sets the lowest TLS version this session accepts; throws `ssl` when OpenSSL rejects it.
    + fn set_min_version(version: TlsVersion) !NetError {
        @unsafe
        if SSL_ctrl(this.ssl, SSL_CTRL_SET_MIN_PROTO_VERSION, version.to(int), null) != 1 : throw .ssl
    }

    /// Sets the highest TLS version this session accepts; throws `ssl` when OpenSSL rejects it.
    + fn set_max_version(version: TlsVersion) !NetError {
        @unsafe
        if SSL_ctrl(this.ssl, SSL_CTRL_SET_MAX_PROTO_VERSION, version.to(int), null) != 1 : throw .ssl
    }

    /// Sets the TLS 1.2 and older ciphers as an OpenSSL cipher string.
    ///
    /// Throws `ssl` when no cipher in it is usable.
    + fn set_cipher_list(ciphers: String) !NetError {
        @unsafe
        if SSL_set_cipher_list(this.ssl, ciphers.data) != 1 : throw .ssl
    }

    /// Sets the TLS 1.3 cipher suites as colon-separated names.
    ///
    /// Throws `ssl` when OpenSSL rejects them.
    + fn set_cipher_suites(ciphers: String) !NetError {
        @unsafe
        if SSL_set_ciphersuites(this.ssl, ciphers.data) != 1 : throw .ssl
    }

    /// Sets the ALPN protocols to offer (such as `"h2"`, `"http/1.1"`), most preferred first.
    ///
    /// Throws `ssl` when the list is empty, a name is empty or longer than 255 bytes, or
    /// OpenSSL rejects it.
    + fn set_alpn(protocols: Array[String]) !NetError {
        @unsafe
        let encoded = ByteBuffer.new()
        each protocols as protocol {
            if protocol.bytes == 0 || protocol.bytes > 255 : throw .ssl
            encoded.write_byte(protocol.bytes.to(u8))
            encoded.write(protocol)
        }
        if encoded.length == 0 || SSL_set_alpn_protos(this.ssl, encoded.data, encoded.length.to(u32)) != 0 : throw .ssl
    }

    /// Returns the ALPN protocol agreed in the handshake, or `""` when none was.
    + fn selected_alpn() String {
        @unsafe
        let protocol: ptr = @undefined
        let length: u32 = 0
        SSL_get0_alpn_selected(this.ssl, @ref(protocol), @ref(length))
        if length == 0 : return ""
        return String.copy_from_ptr(protocol, length)
    }

    /// Returns the SHA-256 fingerprint of the peer certificate as 64 lowercase hex characters.
    ///
    /// Hashes the peer's own certificate: the server's on a client, the client's on a server.
    /// Throws `ssl` when the peer sent no certificate.
    + fn peer_certificate_sha256() String !NetError {
        @unsafe
        let session = SSL_get_session(this.ssl)
        if !isset(session) : throw .ssl
        let certificate = SSL_SESSION_get0_peer(session)
        if !isset(certificate) : throw .ssl

        let digest: [u8 x 32] = { 0... }
        let digest_length: u32 = 0
        if X509_digest(certificate, EVP_sha256(), @ref(digest).@cast(*u8), @ref(digest_length)) != 1
            || digest_length != 32 : throw .ssl

        let output: [u8 x 64] = { 0... }
        let i: uint = 0
        while i < 32 {
            let offset = i * 2
            let length = digest[i].to_base_to_ptr(16, &output[offset], true)
            if length == 1 {
                output[offset + 1] = output[offset]
                output[offset] = '0'
            }
            i++
        }
        return String.copy_from_ptr(&output, 64)
    }

    #if TEST
    /// Test hook: returns true when peer verification is on for this session.
    + fn verification_enabled_for_test() bool {
        @unsafe
        return (SSL_get_verify_mode(this.ssl) & SSL_VERIFY_PEER) != 0
    }
    #end

    /// Runs the client handshake on the socket `fd`.
    ///
    /// Makes `fd` non-blocking and, on Linux, makes the process ignore `SIGPIPE`. Throws
    /// `timeout` after `timeout_ms` (0 waits forever) of waiting, `closed` when the peer goes
    /// away, `os`, and `ssl` for a failed handshake (see `get_error_message`).
    + fn connect(fd: Fd, timeout_ms: uint (5000)) !NetError {
        this.handshake(fd, timeout_ms, false) !>
    }

    /// Runs the server handshake on the socket `fd`.
    ///
    /// Makes `fd` non-blocking and, on Linux, makes the process ignore `SIGPIPE`. Throws
    /// `timeout` after `timeout_ms` (0 waits forever) of waiting, `closed` when the peer goes
    /// away, `os`, and `ssl` for a failed handshake (see `get_error_message`).
    + fn accept(fd: Fd, timeout_ms: uint (5000)) !NetError {
        this.handshake(fd, timeout_ms, true) !>
    }

    fn handshake(fd: Fd, timeout_ms: uint, server: bool) !NetError {
        @unsafe
        #if OS == "linux"
        core.signal_ignore(13)
        #end
        this.fd = fd
        io.set_nonblocking(fd, true) ! throw .os
        if fd == -1 || SSL_set_fd(this.ssl, fd.to(i32)) != 1 : throw .ssl

        while true {
            ERR_clear_error()
            let res = server ? SSL_accept(this.ssl) : SSL_connect(this.ssl)
            if res != 1 {
                let err = SSL_get_error(this.ssl, res)
                if err == ERROR.WANT_READ {
                    let ev = io.await_socket_fd(fd, true, false, timeout_ms)
                    if ev.is_timeout() : throw .timeout
                    if !ev.is_readable() : throw .closed
                    continue
                }
                if err == ERROR.WANT_WRITE {
                    if fd == -1 : throw .ssl
                    let ev = io.await_socket_fd(fd, false, true, timeout_ms)
                    if ev.is_timeout() : throw .timeout
                    if ev.is_closed() || !ev.is_writable() : throw .closed
                    continue
                }
                this.update_error()
                throw .ssl
            }
            break
        }
        this.connected = true
    }

    /// Sends the TLS close notify; does nothing on a second call or before a handshake.
    ///
    /// Does not wait for the peer's reply and does not close the socket. Throws `timeout`,
    /// `closed` or `ssl`.
    + fn close(timeout_ms: uint (5000)) !NetError {
        @unsafe
        if this.closed : return
        this.closed = true
        if !this.connected : return

        while true {
            ERR_clear_error()
            let result = SSL_shutdown(this.ssl)
            if result >= 0 : break
            let err = SSL_get_error(this.ssl, result)
            if err != ERROR.WANT_READ && err != ERROR.WANT_WRITE : throw .ssl
            let ev = io.await_socket_fd(this.fd, err == ERROR.WANT_READ, err == ERROR.WANT_WRITE, timeout_ms)
            if ev.is_timeout() : throw .timeout
            if err == ERROR.WANT_READ {
                if !ev.is_readable() : throw .closed
            } else if ev.is_closed() || !ev.is_writable() : throw .closed
        }
        this.connected = false
    }

    /// Encrypts and sends all of `data`; returns the number of bytes written.
    ///
    /// `timeout_ms` 0 waits forever. Throws `ssl` before a handshake, `timeout`, `closed`
    /// and `write`.
    + fn write(data: local &[u8], timeout_ms: uint (5000)) uint !NetError {
        @unsafe
        if !this.connected : this.custom_error("SSL is not connected to a socket. Use 'connect' to establish a connection.")

        let wbytes: i32 = 0
        defer this.clear_write_blocked()
        while true {
            ERR_clear_error()
            wbytes = SSL_write(this.ssl, data.data, data.length);
            if wbytes <= 0 {
                let err = SSL_get_error(this.ssl, wbytes);
                if err == ERROR.WANT_READ || err == ERROR.WANT_WRITE {
                    this.write_blocked = err == ERROR.WANT_WRITE
                    let ev = io.await_socket_fd(this.fd, err == ERROR.WANT_READ, err == ERROR.WANT_WRITE, timeout_ms)
                    if ev.is_timeout() : throw .timeout
                    if err == ERROR.WANT_READ {
                        if !ev.is_readable() : throw .closed
                    } else if ev.is_closed() || !ev.is_writable() : throw .closed
                    continue
                }
                throw .write
            }
            break
        }
        return wbytes
    }

    fn clear_write_blocked() {
        this.write_blocked = false
    }

    /// Reads up to `buf.length` decrypted bytes into `buf` and returns the count.
    ///
    /// Returns 0 when the peer closed the TLS session. While a `write` on this session is
    /// blocked, waits for it first (OpenSSL requires that order), polling every millisecond.
    /// `timeout_ms` 0 waits forever. Throws `ssl` before a handshake or on a protocol error,
    /// `timeout` and `closed`.
    + fn recv(buf: local mut &[u8], timeout_ms: uint (5000)) uint !NetError {
        @unsafe
        if !this.connected : this.custom_error("SSL is not connected to a socket. Use 'connect' to establish a connection.")

        let rcvd: i32 = 0
        while true {
            // OpenSSL requires retrying a blocked write before any other I/O.
            let waiting = time.mono_ms()
            while this.write_blocked {
                if timeout_ms > 0 && time.mono_ms() - waiting >= timeout_ms : throw .timeout
                time.sleep_ms(1)
            }
            ERR_clear_error()
            rcvd = SSL_read(this.ssl, buf.data, buf.length);
            if rcvd <= 0 {
                let err = SSL_get_error(this.ssl, rcvd);
                if err == ERROR.ZERO_RETURN : return 0
                if err == ERROR.WANT_READ || err == ERROR.WANT_WRITE {
                    let ev = io.await_socket_fd(this.fd, err == ERROR.WANT_READ, err == ERROR.WANT_WRITE, timeout_ms)
                    if ev.is_timeout() : throw .timeout
                    if err == ERROR.WANT_READ {
                        if !ev.is_readable() : throw .closed
                    } else if ev.is_closed() || !ev.is_writable() : throw .closed
                    continue
                }
                throw .ssl
            }
            break
        }
        return rcvd
    }

    /// Records `msg` as the error message and throws `ssl`.
    ///
    /// Tagged `$throw`, so it can be called where a `throw` statement is expected.
    + fn custom_error(msg: String) !NetError $throw {
        this.error_message = msg
        throw .ssl
    }
    /// Returns the OpenSSL error code of the last failed handshake; 0 when there was none.
    + fn get_error() uint {
        return this.error_code
    }
    /// Returns the text of the last recorded error.
    ///
    /// That is OpenSSL's message for `get_error`, or the message given to `custom_error`.
    + fn get_error_message() String {
        @unsafe
        if !this.error_changed : return this.error_message
        let msg = ERR_error_string(this.error_code, null)
        this.error_message = msg
        this.error_changed = false
        return this.error_message
    }
    fn update_error() {
        this.error_code = ERR_get_error()
        this.error_changed = true
    }

    fn gc_free() {
        @unsafe
        SSL_free(this.ssl)
        if this.owns_context : SSL_CTX_free(this.ctx)
    }
}

use io
use core
use ext

/// A listening TCP socket, made by `new` or `net.tcp_server`; `accept` hands out connections.
///
/// The descriptor is closed by `close` or when the object is collected.
+ class TcpServer is io.Closer {
    /// The host name or address the server was created for.
    ~ host: String
    /// The port the server was created for.
    ~ port: u16
    /// The OS socket descriptor.
    ~ fd: Fd
    // The family AcceptEx needs to open the accepted socket with on Windows
    - ipv6: bool (false)
    - closed: u8 (0)
    // Accepts in flight, and whether the descriptor went back to the system. A close while a
    // thread is in `accept` only shuts the socket down, which wakes that thread: the descriptor
    // is released when the last accept is out. Released at once, its number can name another
    // socket by the time that thread calls the system again, and it would take connections
    // of that one
    - accepting: uint (0)
    - released: u8 (0)

    /// Resolves `host`, binds to it and `port`, and starts listening; also `net.tcp_server`.
    ///
    /// Sets `SO_REUSEADDR`, and `SO_REUSEPORT` when `reuse_port` is set so that several
    /// processes may listen on the same port at once (not on Windows; used for zero-downtime
    /// restarts). An IPv6 host such as `"::"` also accepts IPv4 clients where the
    /// system allows it. Throws `invalid_host` or `timeout` when resolving fails, `init` when
    /// the socket cannot be made, `port_in_use` when the address is already in use, `access`
    /// when the system refuses it (such as a privileged port), and `os` when binding or
    /// listening fails for another reason.
    + static fn new(host: String, port: u16, timeout_ms: uint (5000), reuse_port: bool (false)) atomic TcpServer !NetError {
        let addrinfo = resolve_host(host, port, timeout_ms, false) !>
        let fd = create_socket(false, false, addrinfo.is_ipv6()) !>
        bind_fd(fd, addrinfo, true, true, reuse_port) ! {
            close_fd_cleanup(fd, __FILE__, __LINE__)
            throw E
        }
        // Accepted sockets inherit it; direct descriptors cannot be set afterwards
        set_no_delay_fd(fd, true) ! {}
        return TcpServer {
            host: host
            port: port
            fd: fd
            ipv6: addrinfo.is_ipv6()
        }
    }

    /// Waits for the next incoming connection and returns it.
    ///
    /// `timeout_ms` 0 waits forever; otherwise `timeout` is thrown when it runs out. Throws
    /// `closed` after `close`, and `max_connections` when the process is out of file
    /// descriptors (Linux and macOS).
    + fn accept(timeout_ms: uint (0)) TcpConnection !NetError @threadsafe {
        atomic(this.accepting + 1)
        if this.closed != 0 {
            this.accept_done()
            throw .closed
        }
        let fd = accept(this.fd, this.ipv6, timeout_ms) ! {
            let closed = this.closed != 0
            this.accept_done()
            if closed : throw .closed
            throw E
        }
        this.accept_done()
        #if OS == "win"
        if !io.associate(fd) {
            close_fd_cleanup(fd, __FILE__, __LINE__)
            throw .os
        }
        #end
        let connection = TcpConnection.wrap(fd) !>
        connection.stream = true
        return connection
    }

    // Accepts like `accept`, into this thread's table of io_uring direct descriptors (see
    // `io.uring_files`), which do not count against the process's descriptor limit; null when
    // the thread has no such table
    fn accept_direct(timeout_ms: uint (0), ring: uint (0)) ?TcpConnection !NetError {
        #if URING
        if io.uring_files() == 0 : return null
        atomic(this.accepting + 1)
        if this.closed != 0 {
            this.accept_done()
            throw .closed
        }
        @unsafe
        let buffer = [u8 x 128]{ 0... }
        let length: u32 = 128
        let slot = accept_direct(this.fd, timeout_ms, @ref(buffer).@cast(ptr), @ref(length), ring) ! {
            let closed = this.closed != 0
            this.accept_done()
            if closed : throw .closed
            throw E
        }
        this.accept_done()
        let peer = SocketAddress.from_sockaddr(@ref(buffer).@cast(ptr), length.to(uint)) !? SocketAddress {}
        return TcpConnection.wrap_direct(slot, ring, peer)
        #else
        return null
        #end
    }

    #if TEST
    /// Test hook: accepts into this thread's io_uring table of direct descriptors; null when it has none.
    + fn accept_direct_for_test(timeout_ms: uint, ring: uint (0)) ?TcpConnection !NetError {
        return this.accept_direct(timeout_ms, ring) !>
    }
    /// Test hook: adds an io_uring ring with its own table of direct descriptors to this thread; returns its index, 0 when none can be made.
    + fn add_direct_ring_for_test() uint {
        #if URING
        return io.add_direct_ring()
        #else
        return 0
        #end
    }
    #end

    /// Returns the address the server listens on.
    ///
    /// Throws `closed` after `close` and `os` when the system cannot report it.
    + fn local_address() SocketAddress !NetError {
        if this.closed != 0 : throw .closed
        return local_address_of(this.fd) !>
    }

    /// Closes the listening socket; connections already accepted stay open. Does nothing
    /// when already closed. Throws `os` when closing fails.
    + fn close() !io.IoError @threadsafe {
        // Only the first close releases the socket, also when threads race to close it
        if atomic(this.closed + 1) != 0 : return
        #if OS == "win"
        // Closing the socket is what ends a pending AcceptEx
        if !this.release() : throw .os
        #else
        if this.accepting == 0 {
            if !this.release() : throw .os
            return
        }
        // Accepts are in flight. A shutdown ends them on Linux. On macOS they wait for the
        // descriptor to go, so the listener is closed by putting a socket that does nothing
        // in its place: the number stays taken until the last accept is out
        ext.shutdown(this.fd, ext.O_RDWR)
        #if EPOLL
        // The accepts wake on the shutdown, which also ends the listening. Another socket in
        // its place would take the event out of their epoll sets before they saw it
        if this.accepting == 0 : this.release()
        #else
        let idle = ext.socket(ext.AF_INET, ext.SOCK_STREAM, 0)
        if idle == io.INVALID_FD {
            // Out of descriptors: nothing can hold the number
            if !this.release() : throw .os
            return
        }
        ext.dup2(idle, this.fd)
        ext.close(idle)
        // The accepts may all have left in the meantime
        if this.accepting == 0 : this.release()
        #end
        #end
    }

    // An accept is out: the last one after a close releases the descriptor
    fn accept_done() @threadsafe {
        if atomic(this.accepting - 1) == 1 && this.closed != 0 && !this.release() {
            core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        }
    }

    // Gives the descriptor back once; false when the system refused
    fn release() bool @threadsafe {
        if atomic(this.released + 1) != 0 : return true
        #if OS == "win"
        return ext.closesocket(this.fd) == 0
        #else
        return ext.close(this.fd) == 0
        #end
    }

    fn gc_free() {
        if this.released != 0 : return
        this.closed = 1
        this.released = 1
        close_fd_cleanup(this.fd, __FILE__, __LINE__)
    }
}

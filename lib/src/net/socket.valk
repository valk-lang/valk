use ext
use io
use time
use core

/// The kind of socket `Socket.server` and `Socket.client` open.
+ enum SocketType {
    /// A TCP stream socket.
    tcp
}

/// A stream socket before it is connected or listening; see `server` and `client`.
+ class Socket is io.Closer {
    /// The host name or address the socket was created for.
    ~ host: String
    /// The OS socket descriptor.
    ~ fd: Fd
    /// The port the socket was created for.
    ~ port: u16
    -+ addrinfo: AddrInfo
    -+ closed: u8 (0)
    /// True when the host resolved to an IPv6 address.
    ~+ ipv6: bool (false)

    /// Resolves `host`, binds to it and `port`, and starts listening.
    ///
    /// Sets `SO_REUSEADDR`; an IPv6 host such as `"::"` also accepts IPv4 clients where the
    /// system allows it. Throws `invalid_host` or `timeout` when resolving fails, `init` when
    /// the socket cannot be made, `port_in_use` when the address is already in use, `access`
    /// when the system refuses it (such as a privileged port), and `os` when binding or
    /// listening fails for another reason.
    + static fn server(type: SocketType, host: String, port: u16, timeout_ms: uint (5000)) shared SocketServer !NetError {
        let socket = SELF.create(type, host, port, timeout_ms, false) !>
        socket.bind() ! {
            socket.close() ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            throw E
        }

        return SocketServer {
            socket: socket
        }
    }

    /// Resolves `host`, connects to it and `port`, and returns the connection.
    ///
    /// `timeout_ms` covers the lookup and the connect together; 0 waits without limit. The
    /// connection's `host` is set to `host`, which `Connection.ssl_connect` uses as the TLS
    /// server name. Throws `invalid_host`, `timeout`, `init` or `connect`.
    + static fn client(type: SocketType, host: String, port: u16, timeout_ms: uint (5000)) Connection !NetError {
        let started = time.mono_ms()
        let socket = SELF.create(type, host, port, timeout_ms) !>
        let remaining = timeout_ms
        if timeout_ms > 0 {
            let elapsed = time.mono_ms() - started
            if elapsed >= timeout_ms {
                socket.close() ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
                throw .timeout
            }
            remaining -= elapsed
        }
        let con = socket.connect(remaining) !>
        con.host = host
        return con
    }

    static fn create(type: SocketType, host: String, port: u16, timeout_ms: uint, associate: bool (true)) Socket !NetError {
        let addrinfo = AddrInfo.new(host, port, timeout_ms) ! {
            if error_is(E.code, timeout) : throw .timeout
            // A resolver that could not start is a transient resource failure, not a
            // bad name; callers retry `init` and give up on `invalid_host`
            if error_is(E.code, init) : throw .init
            throw .invalid_host
        }
        let fd = SELF.create_fd(type, associate, addrinfo.is_ipv6()) !>

        return SELF {
            host: host
            port: port
            fd: fd
            addrinfo: addrinfo
            ipv6: addrinfo.is_ipv6()
        }
    }

    static fn create_fd(type: SocketType, associate: bool (true), ipv6: bool (false)) Fd !NetError {
        let family: i32 = ipv6 ? ext.AF_INET6 : ext.AF_INET
        #if OS == "win"
        @unsafe
        WSA.init()
        let fd = ext.WSASocketA(family, ext.SOCK_STREAM, ext.IPPROTO_TCP, null, 0, ext.WSA_FLAG_OVERLAPPED)
        if fd == ext.INVALID_SOCKET : throw .init
        if associate && !io.associate(fd) {
            if ext.closesocket(fd) != 0 {
                core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            }
            throw .init
        }
        #else
        let fd = ext.socket(family, ext.SOCK_STREAM, 0)
        #end

        if fd == -1 : throw .init
        #if OS == "linux" || OS == "macos"
        io.set_nonblocking(fd, true) ! {
            SELF.close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            throw .os
        }
        #end

        #if OS == "macos"
        @unsafe
        let nosigv: i32 = 1
        if ext.setsockopt(fd, ext.SOL_SOCKET, ext.SO_NOSIGPIPE, @ref(nosigv), size_of(i32)) != 0 {
            SELF.close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            throw .init
        }
        #end
        return fd
    }

    fn bind() !NetError {
        @unsafe
        if this.closed != 0 : throw .closed

        let yes: i32 = 1
        let err: i32 = 0

        if ext.setsockopt(this.fd, ext.SOL_SOCKET, ext.SO_REUSEADDR, @ref(yes), size_of(i32)) != 0 : throw .init
        if this.ipv6 {
            // Accept IPv4 clients on "::" as well, where the system allows it
            let no: i32 = 0
            ext.setsockopt(this.fd, ext.IPPROTO_IPV6, ext.IPV6_V6ONLY, @ref(no), size_of(i32))
        }

        err = ext.bind(this.fd, this.addrinfo.sock_addr(), this.addrinfo.addr_len())
        if err != 0 : bind_failed()

        err = ext.listen(this.fd, 2000000)
        if err != 0 : bind_failed()
    }

    fn connect(timeout_ms: uint (5000)) Connection !NetError {
        if this.closed != 0 : throw .closed

        let fd = this.fd
        connect(fd, this.addrinfo, timeout_ms) ! {
            this.close() ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            if error_is(E.code, timeout) : throw .timeout
            throw .connect
        }

        this.closed = 1 // The connection will close the descriptor
        return Connection.new(fd) !>
    }

    /// Closes the descriptor; does nothing when already closed.
    ///
    /// A socket that connected has handed its descriptor to the `Connection` and counts as
    /// closed. Throws `os` when closing fails.
    + fn close() !io.IoError {
        if this.closed != 0 : return
        this.closed = 1
        SELF.close_fd(this.fd) ! throw .os
    }

    fn gc_free() {
        if this.closed == 0 {
            this.closed = 1
            SELF.close_fd_cleanup(this.fd, __FILE__, __LINE__)
        }
    }

    static fn close_fd(fd: Fd) !NetError {
        #if OS == "win"
        if ext.closesocket(fd) != 0 : throw .os
        #else
        let failed = false
        if ext.shutdown(fd, ext.O_RDWR) != 0 && ext.get_errno() != ext.ENOTCONN {
            failed = true
        }
        if ext.close(fd) != 0 : failed = true
        if failed : throw .os
        #end
    }

    static fn close_fd_cleanup(fd: Fd, file: String, line: uint) void {
        #if OS == "win"
        if ext.closesocket(fd) != 0 {
            core.cleanup_warning("Failed to close socket", file, line)
        }
        #else
        if ext.shutdown(fd, ext.O_RDWR) != 0 && ext.get_errno() != ext.ENOTCONN {
            core.cleanup_warning("Failed to shut down socket", file, line)
        }
        if ext.close(fd) != 0 {
            core.cleanup_warning("Failed to close socket", file, line)
        }
        #end
    }
}

// Throws the NetError for the bind or listen call that just failed
fn bind_failed() !NetError $throw {
    #if OS == "win"
    let error = ext.WSAGetLastError()
    if error == ext.WSAEADDRINUSE : throw .port_in_use
    if error == ext.WSAEACCES : throw .access
    #else
    let error = ext.get_errno()
    if error == ext.EADDRINUSE : throw .port_in_use
    if error == ext.EACCES : throw .access
    #end
    throw .os
}

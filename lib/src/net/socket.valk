use ext
use io
use core

// Opening sockets: `TcpServer.new`, `TcpConnection.new`, `UdpServer.new` and
// `UdpClient.new` do the work; the functions below are the same by another name. The helpers
// below make and release the descriptors.

/// Opens a listening TCP socket; the same as `TcpServer.new`.
+ fn tcp_server(host: String, port: u16, timeout_ms: uint (5000)) shared TcpServer !NetError {
    return TcpServer.new(host, port, timeout_ms) !>
}

/// Connects to a TCP server; the same as `TcpConnection.new`.
+ fn tcp_client(host: String, port: u16, timeout_ms: uint (5000), local_port: u16 (0), local_host: String ("")) TcpConnection !NetError {
    return TcpConnection.new(host, port, timeout_ms, local_port, local_host) !>
}

/// Binds a UDP socket to your own address; the same as `UdpServer.new`.
+ fn udp_server(host: String, port: u16, timeout_ms: uint (5000), reuse_address: bool (false)) UdpServer !NetError {
    return UdpServer.new(host, port, timeout_ms, reuse_address) !>
}

/// Opens a UDP socket that talks to one server; the same as `UdpClient.new`.
+ fn udp_client(host: String, port: u16, timeout_ms: uint (5000), local_port: u16 (0), local_host: String ("")) UdpClient !NetError {
    return UdpClient.new(host, port, timeout_ms, local_port, local_host) !>
}

fn resolve_host(host: String, port: u16, timeout_ms: uint, datagram: bool) AddrInfo !NetError {
    return AddrInfo.new(host, port, timeout_ms, datagram) ! {
        if error_is(E.code, timeout) : throw .timeout
        // A resolver that could not start is a transient resource failure, not a
        // bad name; callers retry `init` and give up on `invalid_host`
        if error_is(E.code, init) : throw .init
        throw .invalid_host
    }
}

// `datagram`: a UDP socket instead of a TCP one. `associate` registers the descriptor
// with the completion port on Windows; a listener's accepted sockets do that themselves.
fn create_socket(datagram: bool, associate: bool (true), ipv6: bool (false)) Fd !NetError {
    let family: i32 = ipv6 ? ext.AF_INET6 : ext.AF_INET
    #if OS == "win"
    @unsafe
    WSA.init()
    let fd = ext.WSASocketA(family, datagram ? ext.SOCK_DGRAM : ext.SOCK_STREAM, datagram ? ext.IPPROTO_UDP : ext.IPPROTO_TCP, null, 0, ext.WSA_FLAG_OVERLAPPED)
    if fd == ext.INVALID_SOCKET : throw .init
    if associate && !io.associate(fd) {
        if ext.closesocket(fd) != 0 {
            core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        }
        throw .init
    }
    #else
    let fd = ext.socket(family, datagram ? ext.SOCK_DGRAM : ext.SOCK_STREAM, 0)
    #end

    if fd == -1 : throw .init
    #if OS == "linux" || OS == "macos"
    io.set_nonblocking(fd, true) ! {
        close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        throw .os
    }
    #end

    #if OS == "macos"
    @unsafe
    let nosigv: i32 = 1
    if ext.setsockopt(fd, ext.SOL_SOCKET, ext.SO_NOSIGPIPE, @ref(nosigv), size_of(i32)) != 0 {
        close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        throw .init
    }
    #end
    return fd
}

// `reuse` sets SO_REUSEADDR (and SO_REUSEPORT where it exists, so several
// sockets may share a datagram port); `listen` makes a stream socket accept
// connections
fn bind_fd(fd: Fd, addrinfo: AddrInfo, reuse: bool, listen: bool, reuse_port: bool (false)) !NetError {
    @unsafe
    if reuse {
        let yes: i32 = 1
        if ext.setsockopt(fd, ext.SOL_SOCKET, ext.SO_REUSEADDR, @ref(yes), size_of(i32)) != 0 : throw .init
        #if OS != "win"
        if reuse_port && ext.setsockopt(fd, ext.SOL_SOCKET, ext.SO_REUSEPORT, @ref(yes), size_of(i32)) != 0 : throw .init
        #end
    }
    if addrinfo.is_ipv6() {
        // Accept IPv4 peers on "::" as well, where the system allows it
        let no: i32 = 0
        ext.setsockopt(fd, ext.IPPROTO_IPV6, ext.IPV6_V6ONLY, @ref(no), size_of(i32))
    }

    if ext.bind(fd, addrinfo.sock_addr(), addrinfo.addr_len()) != 0 : bind_failed()

    if listen {
        if ext.listen(fd, 2000000) != 0 : bind_failed()
    }
}

fn close_fd(fd: Fd) !NetError {
    #if OS == "win"
    if ext.closesocket(fd) != 0 : throw .os
    #else
    // The shutdown only tells the peer the socket is going away; the close that
    // follows releases the descriptor even when the shutdown failed, so the close
    // alone decides whether the descriptor could not be released
    ext.shutdown(fd, ext.O_RDWR)
    if ext.close(fd) != 0 : throw .os
    #end
}

fn close_fd_cleanup(fd: Fd, file: String, line: uint) void {
    #if OS == "win"
    if ext.closesocket(fd) != 0 {
        core.cleanup_warning("Failed to close socket", file, line)
    }
    #else
    ext.shutdown(fd, ext.O_RDWR)
    if ext.close(fd) != 0 {
        core.cleanup_warning("Failed to close socket", file, line)
    }
    #end
}

// Throws the NetError for the bind or listen call that just failed
fn bind_failed() !NetError $throw {
    #if OS == "win"
    let error = ext.WSAGetLastError()
    if error == ext.WSAEADDRINUSE : throw .port_in_use
    if error == ext.WSAEACCES : throw .access
    #else
    let error = ext.get_errno()
    if error == ext.EADDRINUSE : throw .port_in_use
    if error == ext.EACCES : throw .access
    #end
    throw .os
}

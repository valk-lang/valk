use ext
use io
use time
use core

+ enum SocketType {
    tcp
}

+ class Socket {
    ~ host: String
    ~ fd: Fd
    ~ port: u16
    -+ addrinfo: AddrInfo
    -+ closed: u8 (0)

    + static fn server(type: SocketType, host: String, port: u16, timeout_ms: uint (5000)) shared SocketServer !NetError {
        let socket = SELF.create(type, host, port, timeout_ms) !>
        socket.bind() ! {
            socket.close() ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            throw E
        }

        return SocketServer {
            socket: socket
        }
    }

    + static fn client(type: SocketType, host: String, port: u16, timeout_ms: uint (5000)) Connection !NetError {
        let started = time.mono_ms()
        let socket = SELF.create(type, host, port, timeout_ms) !>
        let remaining = timeout_ms
        if timeout_ms > 0 {
            let elapsed = time.mono_ms() - started
            if elapsed >= timeout_ms {
                socket.close() ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
                throw .timeout
            }
            remaining -= elapsed
        }
        let con = socket.connect(remaining) !>
        con.host = host
        return con
    }

    static fn create(type: SocketType, host: String, port: u16, timeout_ms: uint) Socket !NetError {
        let addrinfo = AddrInfo.new(host, port, timeout_ms) ! {
            if error_is(E.code, timeout) : throw .timeout
            throw .invalid_host
        }
        let fd = SELF.create_fd(type) !>

        return SELF {
            host: host
            port: port
            fd: fd
            addrinfo: addrinfo
        }
    }

    static fn create_fd(type: SocketType) Fd !NetError {
        #if OS == "win"
        @unsafe
        WSA.init()
        let fd = ext.WSASocketA(ext.AF_INET, ext.SOCK_STREAM, ext.IPPROTO_TCP, null, 0, ext.WSA_FLAG_OVERLAPPED)
        if fd == ext.INVALID_SOCKET : throw .init
        if !io.associate(fd) {
            if ext.closesocket(fd) != 0 {
                core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            }
            throw .init
        }
        #else
        let fd = ext.socket(ext.AF_INET, ext.SOCK_STREAM, 0)
        #end

        if fd == -1 : throw .init
        #if OS == "linux" || OS == "macos"
        io.set_nonblocking(fd, true) ! {
            SELF.close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            throw .os
        }
        #end

        #if OS == "macos"
        @unsafe
        let nosigv: i32 = 1
        if ext.setsockopt(fd, ext.SOL_SOCKET, ext.SO_NOSIGPIPE, @ref(nosigv), size_of(i32)) != 0 {
            SELF.close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            throw .init
        }
        #end
        return fd
    }

    fn bind() !NetError {
        @unsafe
        if this.closed != 0 : throw .closed

        let yes: i32 = 1
        let err: i32 = 0

        if ext.setsockopt(this.fd, ext.SOL_SOCKET, ext.SO_REUSEADDR, @ref(yes), size_of(i32)) != 0 : throw .init

        err = ext.bind(this.fd, this.addrinfo.sock_addr(), this.addrinfo.addr_len())
        if err != 0 {
            // TODO: return correct error based on error
            throw .port_in_use
        }

        err = ext.listen(this.fd, 2000000)
        if err != 0 {
            // TODO: return correct error based on error
            throw .port_in_use
        }
    }

    fn connect(timeout_ms: uint (5000)) Connection !NetError {
        if this.closed != 0 : throw .closed

        let fd = this.fd
        connect(fd, this.addrinfo, timeout_ms) ! {
            this.close() ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            if error_is(E.code, timeout) : throw .timeout
            throw .connect
        }

        this.closed = 1 // The connection will close the descriptor
        return Connection.new(fd) !>
    }

    + fn close() !NetError {
        if this.closed != 0 : return
        this.closed = 1
        SELF.close_fd(this.fd) !>
    }

    fn gc_free() {
        if this.closed == 0 {
            this.closed = 1
            SELF.close_fd_cleanup(this.fd, __FILE__, __LINE__)
        }
    }

    + static fn close_fd(fd: Fd) !NetError {
        #if OS == "win"
        if ext.closesocket(fd) != 0 : throw .os
        #else
        let failed = false
        if ext.shutdown(fd, ext.O_RDWR) != 0 && ext.get_errno() != ext.ENOTCONN {
            failed = true
        }
        if ext.close(fd) != 0 : failed = true
        if failed : throw .os
        #end
    }

    + static fn close_fd_cleanup(fd: Fd, file: String, line: uint) void {
        #if OS == "win"
        if ext.closesocket(fd) != 0 {
            core.cleanup_warning("Failed to close socket", file, line)
        }
        #else
        if ext.shutdown(fd, ext.O_RDWR) != 0 && ext.get_errno() != ext.ENOTCONN {
            core.cleanup_warning("Failed to shut down socket", file, line)
        }
        if ext.close(fd) != 0 {
            core.cleanup_warning("Failed to close socket", file, line)
        }
        #end
    }
}

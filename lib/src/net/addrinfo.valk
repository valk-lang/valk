use ext
use mem
use thread
use time
use gc

struct AddrInfoResolveState {
    host: ptr
    port: ptr
    result: ?*ext.libc_addrinfo_fix
    error: i32
    datagram: bool
    done: uint (0)
    abandoned: uint (0)
    consumed: uint (0)
}

// A resolved host: the list getaddrinfo returned, with one entry chosen.
// IPv4 and IPv6 are both accepted; when a name resolves to both, the IPv4
// entry is used
+ class AddrInfo {
    ~ data: *ext.libc_addrinfo_fix
    // The chosen entry of the list
    - entry: ptr
    ~+ family: i32

    // `numeric_only` refuses names: no lookup can happen, so the call never blocks
    + static fn new(host: String, port: u16, timeout_ms: uint (5000), datagram: bool (false), numeric_only: bool (false)) AddrInfo !NetError {
        @unsafe
        // WSA init
        #if OS == "win"
        WSA.init()
        #end

        // An IPv6 literal may be written in brackets, as in a URL
        if host.bytes >= 2 && host[0] == '[' && host[host.bytes - 1] == ']' {
            host = host.part(1, host.bytes - 2)
        }

        let numeric = host_is_numeric(host)
        if numeric_only && !numeric : throw .invalid_host
        let state = resolve_state(host, port, datagram)
        let background = timeout_ms > 0 && !numeric
        if timeout_ms == 0 || numeric {
            resolve_addrinfo(state, numeric, false)
        } else {
            thread.task(fn() {
                resolve_addrinfo(state, false, true)
            }) ! {
                atomic_store(state.abandoned, 1)
                resolve_state_free(state)
                throw .init
            }

            let started = time.mono_ms()
            while atomic_load(state.done) == 0 {
                if time.mono_ms() - started >= timeout_ms {
                    atomic_store(state.abandoned, 1)
                    throw .timeout
                }
                time.sleep_ms(1)
            }
        }

        let addrinfo = state.result
        let err = state.error
        if background : atomic_store(state.consumed, 1)
        else : resolve_state_free(state)
        if err != 0 : throw .invalid_host
        if !isset(addrinfo) : throw .invalid_host

        let entry = choose_entry(addrinfo)
        return SELF {
            data: addrinfo
            entry: entry
            family: addrinfo_family(entry)
        }
    }

    fn gc_free() {
        ext.freeaddrinfo(this.data)
    }

    + fn is_ipv6() bool {
        return this.family == ext.AF_INET6
    }

    + fn sock_addr() *ext.libc_sockaddr {
        @unsafe
        return this.entry.@cast(*ext.libc_addrinfo_fix).ai_addr.@cast(*ext.libc_sockaddr)
    }
    + fn addr_len() u32 {
        @unsafe
        return this.entry.@cast(*ext.libc_addrinfo_fix).ai_addrlen.to(u32)
    }
    + fn address() SocketAddress !NetError {
        @unsafe
        return SocketAddress.from_sockaddr(this.sock_addr().@cast(ptr), this.addr_len().to(uint)) !>
    }
}

fn addrinfo_family(entry: ptr) i32 {
    @unsafe
    return entry.@cast(*ext.libc_addrinfo_fix).ai_family
}

// The first IPv4 entry, or the first entry when there is none
fn choose_entry(list: *ext.libc_addrinfo_fix) ptr {
    @unsafe
    let first = list.@cast(ptr)
    let entry: ?ptr = first
    while isset(entry) {
        if addrinfo_family(entry) == ext.AF_INET : return entry
        entry = entry.@cast(*ext.libc_addrinfo_fix).ai_next.@cast(?ptr)
    }
    return first
}

fn resolve_state(host: String, port: u16, datagram: bool) *AddrInfoResolveState {
    @unsafe
    let host_data = mem.alloc(host.bytes + 1)
    mem.copy_bytes(host.data, host_data, host.bytes)
    @ptrv(host_data, u8, host.bytes) = 0

    let port_string = port.to_string()
    let port_data = mem.alloc(port_string.bytes + 1)
    mem.copy_bytes(port_string.data, port_data, port_string.bytes)
    @ptrv(port_data, u8, port_string.bytes) = 0

    return mem.new[AddrInfoResolveState](.{
        host: host_data
        port: port_data
        datagram: datagram
    })
}

fn resolve_addrinfo(state: *AddrInfoResolveState, numeric: bool, wait_for_consumer: bool) {
    @unsafe
    let hints: ext.libc_addrinfo_fix = @undefined
    mem.clear_bytes(&hints, size_of(ext.libc_addrinfo_fix))
    hints.ai_family = ext.AF_UNSPEC
    hints.ai_socktype = state.datagram ? ext.SOCK_DGRAM : ext.SOCK_STREAM
    hints.ai_flags = ext.AI_PASSIVE
    if numeric : hints.ai_flags = hints.ai_flags | ext.AI_NUMERICHOST

    gc.unlock()
    state.error = ext.getaddrinfo(state.host.to(cstring), state.port.to(cstring), @ref(hints), @ref(state.result))
    gc.lock()
    atomic_store(state.done, 1)

    if wait_for_consumer {
        while atomic_load(state.consumed) == 0 && atomic_load(state.abandoned) == 0 {
            time.sleep_ms(1)
        }
        resolve_state_free(state)
    }
}

fn resolve_state_free(state: *AddrInfoResolveState) {
    @unsafe
    if atomic_load(state.abandoned) != 0 {
        let result = state.result
        if isset(result) : ext.freeaddrinfo(result)
    }
    mem.free(state.host)
    mem.free(state.port)
    mem.free(state)
}

// A dotted IPv4 address or an IPv6 literal: no lookup needed
fn host_is_numeric(host: String) bool {
    if host.is_empty() : return false
    let colons: uint = 0
    each host as byte {
        if byte == ':' {
            colons++
            continue
        }
        if byte == '.' || byte == '%' : continue
        if byte >= '0' && byte <= '9' : continue
        if byte >= 'a' && byte <= 'f' : continue
        if byte >= 'A' && byte <= 'F' : continue
        return false
    }
    if colons >= 2 : return true
    if colons > 0 : return false
    each host as byte {
        if byte != '.' && (byte < '0' || byte > '9') : return false
    }
    return true
}

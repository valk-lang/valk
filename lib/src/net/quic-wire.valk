// QUIC v1 wire primitives: varints, packet number coding, frame constants, transport parameters (RFC 9000).

use mem

value QUIC_VERSION_1 (0x00000001)
value QUIC_SCID_LEN (8)
value QUIC_AEAD_TAG_LEN (16)

// Encryption levels / packet number spaces
value QUIC_LVL_INITIAL (0)
value QUIC_LVL_HANDSHAKE (1)
value QUIC_LVL_APP (2)

// Long header packet types (bits 4..5 of first byte)
value QUIC_PKT_INITIAL (0)
value QUIC_PKT_ZERO_RTT (1)
value QUIC_PKT_HANDSHAKE (2)
value QUIC_PKT_RETRY (3)

// QUIC frame types (RFC 9000 §19)
value QUIC_FRAME_PADDING (0x00)
value QUIC_FRAME_PING (0x01)
value QUIC_FRAME_ACK (0x02)
value QUIC_FRAME_ACK_ECN (0x03)
value QUIC_FRAME_RESET_STREAM (0x04)
value QUIC_FRAME_STOP_SENDING (0x05)
value QUIC_FRAME_CRYPTO (0x06)
value QUIC_FRAME_NEW_TOKEN (0x07)
value QUIC_FRAME_STREAM_BASE (0x08)
value QUIC_FRAME_MAX_DATA (0x10)
value QUIC_FRAME_MAX_STREAM_DATA (0x11)
value QUIC_FRAME_MAX_STREAMS_BIDI (0x12)
value QUIC_FRAME_MAX_STREAMS_UNI (0x13)
value QUIC_FRAME_DATA_BLOCKED (0x14)
value QUIC_FRAME_STREAM_DATA_BLOCKED (0x15)
value QUIC_FRAME_STREAMS_BLOCKED_BIDI (0x16)
value QUIC_FRAME_STREAMS_BLOCKED_UNI (0x17)
value QUIC_FRAME_NEW_CONNECTION_ID (0x18)
value QUIC_FRAME_RETIRE_CONNECTION_ID (0x19)
value QUIC_FRAME_PATH_CHALLENGE (0x1a)
value QUIC_FRAME_PATH_RESPONSE (0x1b)
value QUIC_FRAME_CONNECTION_CLOSE (0x1c)
value QUIC_FRAME_CONNECTION_CLOSE_APP (0x1d)
value QUIC_FRAME_HANDSHAKE_DONE (0x1e)

// QUIC transport error codes (RFC 9000 §20.1)
value QUIC_ERR_NO_ERROR (0x00)
value QUIC_ERR_INTERNAL_ERROR (0x01)
value QUIC_ERR_CONNECTION_REFUSED (0x02)
value QUIC_ERR_FLOW_CONTROL_ERROR (0x03)
value QUIC_ERR_STREAM_LIMIT_ERROR (0x04)
value QUIC_ERR_STREAM_STATE_ERROR (0x05)
value QUIC_ERR_FINAL_SIZE_ERROR (0x06)
value QUIC_ERR_FRAME_ENCODING_ERROR (0x07)
value QUIC_ERR_TRANSPORT_PARAMETER_ERROR (0x08)
value QUIC_ERR_PROTOCOL_VIOLATION (0x0a)
value QUIC_ERR_CRYPTO_BUFFER_EXCEEDED (0x0d)
value QUIC_ERR_CRYPTO_BASE (0x100)

// Transport parameter IDs (RFC 9000 §18.2)
value QUIC_TP_ORIG_DCID (0x00)
value QUIC_TP_MAX_IDLE_TIMEOUT (0x01)
value QUIC_TP_STATELESS_RESET_TOKEN (0x02)
value QUIC_TP_MAX_UDP_PAYLOAD_SIZE (0x03)
value QUIC_TP_INITIAL_MAX_DATA (0x04)
value QUIC_TP_INITIAL_MAX_STREAM_DATA_BIDI_LOCAL (0x05)
value QUIC_TP_INITIAL_MAX_STREAM_DATA_BIDI_REMOTE (0x06)
value QUIC_TP_INITIAL_MAX_STREAM_DATA_UNI (0x07)
value QUIC_TP_INITIAL_MAX_STREAMS_BIDI (0x08)
value QUIC_TP_INITIAL_MAX_STREAMS_UNI (0x09)
value QUIC_TP_ACK_DELAY_EXPONENT (0x0a)
value QUIC_TP_MAX_ACK_DELAY (0x0b)
value QUIC_TP_DISABLE_ACTIVE_MIGRATION (0x0c)
value QUIC_TP_ACTIVE_CONNECTION_ID_LIMIT (0x0e)
value QUIC_TP_INITIAL_SCID (0x0f)

// Local transport parameter defaults tuned for high-throughput HTTP/3
value QUIC_LOCAL_MAX_UDP_PAYLOAD (1472)
value QUIC_LOCAL_INIT_MAX_DATA (16 * 1024 * 1024)
value QUIC_LOCAL_INIT_MAX_STREAM_DATA_BIDI (4 * 1024 * 1024)
value QUIC_LOCAL_INIT_MAX_STREAM_DATA_UNI (1 * 1024 * 1024)
value QUIC_LOCAL_INIT_MAX_STREAMS_BIDI (256)
value QUIC_LOCAL_INIT_MAX_STREAMS_UNI (16)
value QUIC_LOCAL_ACK_DELAY_EXP (3)
value QUIC_LOCAL_MAX_ACK_DELAY_MS (25)

fn quic_varint_len(v: u64) uint $inline {
    if v < 64 : return 1
    if v < 16_384 : return 2
    if v < 1_073_741_824 : return 4
    return 8
}

// Writes a QUIC varint directly to raw memory at `dst + off`, returning the new offset.
fn quic_put_varint(dst: ptr, off: uint, v: u64) uint $inline {
    if v < 64 {
        @ptrv(dst, u8, off) = v.to(u8)
        return off + 1
    }
    if v < 16_384 {
        @ptrv(dst, u8, off) = ((v >> 8).to(u8) & 0x3f) | 0x40
        @ptrv(dst, u8, off + 1) = (v & 0xff).to(u8)
        return off + 2
    }
    if v < 1_073_741_824 {
        @ptrv(dst, u8, off) = ((v >> 24).to(u8) & 0x3f) | 0x80
        @ptrv(dst, u8, off + 1) = ((v >> 16) & 0xff).to(u8)
        @ptrv(dst, u8, off + 2) = ((v >> 8) & 0xff).to(u8)
        @ptrv(dst, u8, off + 3) = (v & 0xff).to(u8)
        return off + 4
    }
    @ptrv(dst, u8, off) = ((v >> 56).to(u8) & 0x3f) | 0xc0
    @ptrv(dst, u8, off + 1) = ((v >> 48) & 0xff).to(u8)
    @ptrv(dst, u8, off + 2) = ((v >> 40) & 0xff).to(u8)
    @ptrv(dst, u8, off + 3) = ((v >> 32) & 0xff).to(u8)
    @ptrv(dst, u8, off + 4) = ((v >> 24) & 0xff).to(u8)
    @ptrv(dst, u8, off + 5) = ((v >> 16) & 0xff).to(u8)
    @ptrv(dst, u8, off + 6) = ((v >> 8) & 0xff).to(u8)
    @ptrv(dst, u8, off + 7) = (v & 0xff).to(u8)
    return off + 8
}

// Reads a QUIC varint from raw memory `src[off..end]`. Returns `(ok, value, next_off)`.
fn quic_get_varint(src: ptr, off: uint, end: uint) (bool, u64, uint) $inline {
    if off >= end : return (false, 0, off)
    let b0 = @ptrv(src, u8, off)
    let prefix = b0 >> 6
    if prefix == 0 {
        return (true, b0.to(u64), off + 1)
    }
    if prefix == 1 {
        if end - off < 2 : return (false, 0, off)
        let v = ((b0 & 0x3f).to(u64) << 8) | @ptrv(src, u8, off + 1).to(u64)
        return (true, v, off + 2)
    }
    if prefix == 2 {
        if end - off < 4 : return (false, 0, off)
        let v = ((b0 & 0x3f).to(u64) << 24)
            | (@ptrv(src, u8, off + 1).to(u64) << 16)
            | (@ptrv(src, u8, off + 2).to(u64) << 8)
            | @ptrv(src, u8, off + 3).to(u64)
        return (true, v, off + 4)
    }
    if end - off < 8 : return (false, 0, off)
    let v = ((b0 & 0x3f).to(u64) << 56)
        | (@ptrv(src, u8, off + 1).to(u64) << 48)
        | (@ptrv(src, u8, off + 2).to(u64) << 40)
        | (@ptrv(src, u8, off + 3).to(u64) << 32)
        | (@ptrv(src, u8, off + 4).to(u64) << 24)
        | (@ptrv(src, u8, off + 5).to(u64) << 16)
        | (@ptrv(src, u8, off + 6).to(u64) << 8)
        | @ptrv(src, u8, off + 7).to(u64)
    return (true, v, off + 8)
}

fn quic_buf_put_varint(buf: ByteBuffer, v: u64) {
    let tmp: [u8 x 8] = @undefined
    @unsafe
    let len = quic_put_varint(@ref(tmp).@cast(ptr), 0, v)
    buf.write_bytes(@ref(tmp).@cast(ptr), len)
}

fn quic_put_u32_be(dst: ptr, off: uint, v: u32) uint $inline {
    @ptrv(dst, u8, off) = ((v >> 24) & 0xff).to(u8)
    @ptrv(dst, u8, off + 1) = ((v >> 16) & 0xff).to(u8)
    @ptrv(dst, u8, off + 2) = ((v >> 8) & 0xff).to(u8)
    @ptrv(dst, u8, off + 3) = (v & 0xff).to(u8)
    return off + 4
}

fn quic_get_u32_be(src: ptr, off: uint) u32 $inline {
    return (@ptrv(src, u8, off).to(u32) << 24)
        | (@ptrv(src, u8, off + 1).to(u32) << 16)
        | (@ptrv(src, u8, off + 2).to(u32) << 8)
        | @ptrv(src, u8, off + 3).to(u32)
}

fn quic_get_u64_be(src: ptr, off: uint) u64 $inline {
    return (@ptrv(src, u8, off).to(u64) << 56)
        | (@ptrv(src, u8, off + 1).to(u64) << 48)
        | (@ptrv(src, u8, off + 2).to(u64) << 40)
        | (@ptrv(src, u8, off + 3).to(u64) << 32)
        | (@ptrv(src, u8, off + 4).to(u64) << 24)
        | (@ptrv(src, u8, off + 5).to(u64) << 16)
        | (@ptrv(src, u8, off + 6).to(u64) << 8)
        | @ptrv(src, u8, off + 7).to(u64)
}

fn quic_put_u64_be(dst: ptr, off: uint, v: u64) uint $inline {
    @ptrv(dst, u8, off) = ((v >> 56) & 0xff).to(u8)
    @ptrv(dst, u8, off + 1) = ((v >> 48) & 0xff).to(u8)
    @ptrv(dst, u8, off + 2) = ((v >> 40) & 0xff).to(u8)
    @ptrv(dst, u8, off + 3) = ((v >> 32) & 0xff).to(u8)
    @ptrv(dst, u8, off + 4) = ((v >> 24) & 0xff).to(u8)
    @ptrv(dst, u8, off + 5) = ((v >> 16) & 0xff).to(u8)
    @ptrv(dst, u8, off + 6) = ((v >> 8) & 0xff).to(u8)
    @ptrv(dst, u8, off + 7) = (v & 0xff).to(u8)
    return off + 8
}

// Encodes packet number length (1..4 bytes) per RFC 9000 §17.1.
fn quic_pn_encode_len(pn: u64, largest_acked: u64, has_acked: bool) uint $inline {
    let unacked: u64 = has_acked && pn > largest_acked ? pn - largest_acked : pn + 1
    if unacked < 128 : return 1
    if unacked < 32_768 : return 2
    if unacked < 8_388_608 : return 3
    return 4
}

fn quic_put_pn(dst: ptr, off: uint, pn: u64, pn_len: uint) uint $inline {
    if pn_len == 1 {
        @ptrv(dst, u8, off) = (pn & 0xff).to(u8)
        return off + 1
    }
    if pn_len == 2 {
        @ptrv(dst, u8, off) = ((pn >> 8) & 0xff).to(u8)
        @ptrv(dst, u8, off + 1) = (pn & 0xff).to(u8)
        return off + 2
    }
    if pn_len == 3 {
        @ptrv(dst, u8, off) = ((pn >> 16) & 0xff).to(u8)
        @ptrv(dst, u8, off + 1) = ((pn >> 8) & 0xff).to(u8)
        @ptrv(dst, u8, off + 2) = (pn & 0xff).to(u8)
        return off + 3
    }
    @ptrv(dst, u8, off) = ((pn >> 24) & 0xff).to(u8)
    @ptrv(dst, u8, off + 1) = ((pn >> 16) & 0xff).to(u8)
    @ptrv(dst, u8, off + 2) = ((pn >> 8) & 0xff).to(u8)
    @ptrv(dst, u8, off + 3) = (pn & 0xff).to(u8)
    return off + 4
}

// Reconstructs a full packet number per RFC 9000 Appendix A.3.
fn quic_decode_pn(largest_pn: u64, has_largest: bool, truncated: u64, pn_len: uint) u64 $inline {
    let expected: u64 = has_largest ? largest_pn + 1 : 0
    let pn_nbits: u64 = (pn_len * 8).to(u64)
    let win: u64 = 1.to(u64) << pn_nbits
    let half: u64 = win >> 1
    let mask: u64 = win - 1
    let cand = (expected & ~mask) | truncated
    if cand + half <= expected && cand < (1.to(u64) << 62) - win {
        return cand + win
    }
    if cand > expected + half && cand >= win {
        return cand - win
    }
    return cand
}

struct QuicPeerParams {
    max_idle_timeout_ms: u64 (0)
    max_udp_payload_size: u64 (65527)
    initial_max_data: u64 (0)
    initial_max_stream_data_bidi_local: u64 (0)
    initial_max_stream_data_bidi_remote: u64 (0)
    initial_max_stream_data_uni: u64 (0)
    initial_max_streams_bidi: u64 (0)
    initial_max_streams_uni: u64 (0)
    ack_delay_exponent: u64 (3)
    max_ack_delay_ms: u64 (25)
    active_connection_id_limit: u64 (2)
    has_initial_scid: bool (false)
    initial_scid: [u8 x 20] ({ 0... })
    initial_scid_len: uint (0)
}

fn quic_tp_write_int(out: ByteBuffer, id: u64, val: u64) {
    quic_buf_put_varint(out, id)
    quic_buf_put_varint(out, quic_varint_len(val).to(u64))
    quic_buf_put_varint(out, val)
}

fn quic_tp_write_bytes(out: ByteBuffer, id: u64, data: ptr, len: uint) {
    quic_buf_put_varint(out, id)
    quic_buf_put_varint(out, len.to(u64))
    if len > 0 {
        @unsafe
        out.write_bytes(data, len)
    }
}

fn quic_encode_server_transport_params(
    out: ByteBuffer,
    odcid: ptr,
    odcid_len: uint,
    scid: ptr,
    scid_len: uint,
    idle_timeout_ms: u64
) {
    @unsafe
    out.clear()
    quic_tp_write_bytes(out, QUIC_TP_ORIG_DCID, odcid, odcid_len)
    if idle_timeout_ms > 0 : quic_tp_write_int(out, QUIC_TP_MAX_IDLE_TIMEOUT, idle_timeout_ms)
    quic_tp_write_int(out, QUIC_TP_MAX_UDP_PAYLOAD_SIZE, QUIC_LOCAL_MAX_UDP_PAYLOAD)
    quic_tp_write_int(out, QUIC_TP_INITIAL_MAX_DATA, QUIC_LOCAL_INIT_MAX_DATA)
    quic_tp_write_int(out, QUIC_TP_INITIAL_MAX_STREAM_DATA_BIDI_LOCAL, QUIC_LOCAL_INIT_MAX_STREAM_DATA_BIDI)
    quic_tp_write_int(out, QUIC_TP_INITIAL_MAX_STREAM_DATA_BIDI_REMOTE, QUIC_LOCAL_INIT_MAX_STREAM_DATA_BIDI)
    quic_tp_write_int(out, QUIC_TP_INITIAL_MAX_STREAM_DATA_UNI, QUIC_LOCAL_INIT_MAX_STREAM_DATA_UNI)
    quic_tp_write_int(out, QUIC_TP_INITIAL_MAX_STREAMS_BIDI, QUIC_LOCAL_INIT_MAX_STREAMS_BIDI)
    quic_tp_write_int(out, QUIC_TP_INITIAL_MAX_STREAMS_UNI, QUIC_LOCAL_INIT_MAX_STREAMS_UNI)
    quic_tp_write_int(out, QUIC_TP_ACK_DELAY_EXPONENT, QUIC_LOCAL_ACK_DELAY_EXP)
    quic_tp_write_int(out, QUIC_TP_MAX_ACK_DELAY, QUIC_LOCAL_MAX_ACK_DELAY_MS)
    quic_tp_write_int(out, QUIC_TP_ACTIVE_CONNECTION_ID_LIMIT, 4)
    quic_tp_write_bytes(out, QUIC_TP_INITIAL_SCID, scid, scid_len)
}

fn quic_decode_peer_transport_params(src: ptr, len: uint) (bool, QuicPeerParams) {
    @unsafe
    let p = QuicPeerParams {}
    let off: uint = 0
    while off < len {
        let ok1, id, p1 = quic_get_varint(src, off, len)
        if !ok1 : return (false, p)
        let ok2, vlen_u64, p2 = quic_get_varint(src, p1, len)
        if !ok2 || vlen_u64 > (len - p2).to(u64) : return (false, p)
        let vlen = vlen_u64.to(uint)
        let vend = p2 + vlen
        if id == QUIC_TP_ORIG_DCID || id == QUIC_TP_STATELESS_RESET_TOKEN {
            // Clients must not send server-only transport parameters (RFC 9000 §18.2)
            return (false, p)
        } else if id == QUIC_TP_MAX_IDLE_TIMEOUT {
            let ok, v, e = quic_get_varint(src, p2, vend)
            if !ok || e != vend : return (false, p)
            p.max_idle_timeout_ms = v
        } else if id == QUIC_TP_MAX_UDP_PAYLOAD_SIZE {
            let ok, v, e = quic_get_varint(src, p2, vend)
            if !ok || e != vend || v < 1200 : return (false, p)
            p.max_udp_payload_size = v
        } else if id == QUIC_TP_INITIAL_MAX_DATA {
            let ok, v, e = quic_get_varint(src, p2, vend)
            if !ok || e != vend : return (false, p)
            p.initial_max_data = v
        } else if id == QUIC_TP_INITIAL_MAX_STREAM_DATA_BIDI_LOCAL {
            let ok, v, e = quic_get_varint(src, p2, vend)
            if !ok || e != vend : return (false, p)
            p.initial_max_stream_data_bidi_local = v
        } else if id == QUIC_TP_INITIAL_MAX_STREAM_DATA_BIDI_REMOTE {
            let ok, v, e = quic_get_varint(src, p2, vend)
            if !ok || e != vend : return (false, p)
            p.initial_max_stream_data_bidi_remote = v
        } else if id == QUIC_TP_INITIAL_MAX_STREAM_DATA_UNI {
            let ok, v, e = quic_get_varint(src, p2, vend)
            if !ok || e != vend : return (false, p)
            p.initial_max_stream_data_uni = v
        } else if id == QUIC_TP_INITIAL_MAX_STREAMS_BIDI {
            let ok, v, e = quic_get_varint(src, p2, vend)
            if !ok || e != vend || v > (1.to(u64) << 60) : return (false, p)
            p.initial_max_streams_bidi = v
        } else if id == QUIC_TP_INITIAL_MAX_STREAMS_UNI {
            let ok, v, e = quic_get_varint(src, p2, vend)
            if !ok || e != vend || v > (1.to(u64) << 60) : return (false, p)
            p.initial_max_streams_uni = v
        } else if id == QUIC_TP_ACK_DELAY_EXPONENT {
            let ok, v, e = quic_get_varint(src, p2, vend)
            if !ok || e != vend || v > 20 : return (false, p)
            p.ack_delay_exponent = v
        } else if id == QUIC_TP_MAX_ACK_DELAY {
            let ok, v, e = quic_get_varint(src, p2, vend)
            if !ok || e != vend || v >= 16_384 : return (false, p)
            p.max_ack_delay_ms = v
        } else if id == QUIC_TP_ACTIVE_CONNECTION_ID_LIMIT {
            let ok, v, e = quic_get_varint(src, p2, vend)
            if !ok || e != vend || v < 2 : return (false, p)
            p.active_connection_id_limit = v
        } else if id == QUIC_TP_INITIAL_SCID {
            if vlen > 20 : return (false, p)
            p.has_initial_scid = true
            p.initial_scid_len = vlen
            if vlen > 0 {
                @unsafe
                mem.copy_bytes(src.@offset(p2), @ref(p.initial_scid).@cast(ptr), vlen)
            }
        }
        off = vend
    }
    return (true, p)
}

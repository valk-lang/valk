use ext
use io
use coro
use core
use time

/// A UDP datagram socket, bound with `bind` or opened unbound with `open`.
///
/// The descriptor is closed by `close` or when the object is collected.
+ class UdpSocket is io.Closer {
    /// The OS socket descriptor.
    ~ fd: Fd
    /// True for an IPv6 socket; it can only send to addresses of the same family.
    ~+ ipv6: bool
    /// Milliseconds `recv_from` may wait for a datagram; 0 waits forever.
    + read_timeout_ms: uint (5000)
    /// Milliseconds `send_to` may wait; 0 waits forever.
    + write_timeout_ms: uint (5000)
    - closed: bool (false)

    /// Binds a socket to `host` (a name or a numeric IPv4 / IPv6 address) and `port`.
    ///
    /// Port 0 lets the system pick one (see `local_address`). An IPv6 host such as `"::"` also
    /// receives from IPv4 peers where the system allows it. Throws `invalid_host` or
    /// `timeout` when resolving fails, `init` when the socket cannot be made, `port_in_use`
    /// when the address is already in use, `access` when the system refuses it (such as a
    /// privileged port), and `os` when binding fails for another reason.
    + static fn bind(host: String, port: u16, timeout_ms: uint (5000)) UdpSocket !NetError {
        let info = AddrInfo.new(host, port, timeout_ms, true) ! {
            if error_is(E.code, timeout) : throw .timeout
            throw .invalid_host
        }
        let socket = SELF.create(info.is_ipv6()) !>
        @unsafe
        if socket.ipv6 {
            // Accept IPv4 peers on "::" as well, where the system allows it
            let no: i32 = 0
            ext.setsockopt(socket.fd, ext.IPPROTO_IPV6, ext.IPV6_V6ONLY, @ref(no), size_of(i32))
        }
        if ext.bind(socket.fd, info.sock_addr(), info.addr_len()) != 0 {
            socket.close() ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            throw .port_in_use
        }
        return socket
    }

    /// Opens an unbound IPv4 socket (IPv6 when `ipv6` is set), for a client.
    ///
    /// The system binds it to a free port on the first send (on Windows right away, to any
    /// address). Throws `init` or `os` when the socket cannot be made.
    + static fn open(ipv6: bool (false)) UdpSocket !NetError {
        let socket = SELF.create(ipv6) !>
        #if OS == "win"
        // Overlapped operations need a bound socket
        if !bind_any(socket.fd, ipv6) {
            socket.close() ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            throw .init
        }
        #end
        return socket
    }

    static fn create(ipv6: bool) UdpSocket !NetError {
        let family: i32 = ipv6 ? ext.AF_INET6 : ext.AF_INET
        #if OS == "win"
        @unsafe
        WSA.init()
        let fd = ext.WSASocketA(family, ext.SOCK_DGRAM, ext.IPPROTO_UDP, null, 0, ext.WSA_FLAG_OVERLAPPED)
        if fd == ext.INVALID_SOCKET : throw .init
        if !io.associate(fd) {
            if ext.closesocket(fd) != 0 : core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            throw .init
        }
        #else
        let fd = ext.socket(family, ext.SOCK_DGRAM, 0)
        if fd == -1 : throw .init
        io.set_nonblocking(fd, true) ! {
            if ext.close(fd) != 0 : core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            throw .os
        }
        #end
        #if OS == "macos"
        @unsafe
        let nosigv: i32 = 1
        ext.setsockopt(fd, ext.SOL_SOCKET, ext.SO_NOSIGPIPE, @ref(nosigv), size_of(i32))
        #end
        return UdpSocket {
            fd: fd
            ipv6: ipv6
        }
    }

    /// Returns the address this socket is bound to.
    ///
    /// Throws `closed` after `close` and `os` when the system cannot report it.
    + fn local_address() SocketAddress !NetError {
        if this.closed : throw .closed
        return local_address_of(this.fd) !>
    }

    /// Sends `data` as one datagram to `to` and returns the number of bytes sent.
    ///
    /// Throws `write` when `to` is of the other address family or the send fails, `timeout`
    /// after `write_timeout_ms`, and `closed`.
    + fn send_to(data: &[u8], to: SocketAddress) uint !io.IoError {
        @unsafe
        if this.closed : throw .closed
        if to.ipv6 != this.ipv6 : throw .write
        let current = coro.current_coro.@cast(coro.Coro)

        #if OS == "win"
        let ov = io.overlap()
        ov.buflen = data.length
        ov.buf = data.data
        let address = @ref(ov.addressBuffer).@cast(ptr)
        let length = to.write_sockaddr(address)
        let res = ext.WSASendTo(this.fd, @ref(ov.buflen), 1, null, 0, address, length.to(i32), ov.@cast(ptr), null)
        if res == ext.SOCKET_ERROR && io.socket_io_failed() : throw .write
        if io.await_overlap(this.fd, ov.@cast(ptr), current, this.write_timeout_ms) : throw .timeout
        let flags: u32 = 0
        let ok = ext.WSAGetOverlappedResult(this.fd, ov.@cast(ptr), @ref(ov.transferred), 1, @ref(flags))
        if ok == 0 || ov.base.sys.Internal != 0 : throw .write
        return ov.transferred.to(uint)
        #else
        let buffer = [u8 x 28]{ 0... }
        let address = @ref(buffer).@cast(ptr)
        let length = to.write_sockaddr(address)
        let deadline = time_deadline(this.write_timeout_ms)
        while true {
            let sent = ext.sendto(this.fd, data.data, data.length, 0, address.@cast(*ext.libc_sockaddr), length)
            if sent >= 0 : return sent.to(uint)
            let error = ext.get_errno()
            if error == ext.EINTR : continue
            if error != ext.EAGAIN && error != ext.EWOULDBLOCK : throw .write
            let ev = io.await_fd(this.fd, false, true, time_remaining(deadline) !>)
            if ev.is_timeout() : throw .timeout
            if ev.is_closed() : throw .closed
        }
        throw .write
        #end
    }

    /// Receives one datagram into `buf` and returns its byte count and its sender.
    ///
    /// A datagram larger than `buf` is cut to `buf.length` and the rest is lost. Throws
    /// `timeout` after `read_timeout_ms`, `closed`, and `read` when the receive fails.
    + fn recv_from(buf: mut &[u8]) (uint, SocketAddress) !io.IoError {
        @unsafe
        if this.closed : throw .closed
        let current = coro.current_coro.@cast(coro.Coro)

        #if OS == "win"
        let ov = io.overlap()
        ov.buflen = buf.length
        ov.buf = buf.data
        ov.flags = 0
        let address = @ref(ov.addressBuffer).@cast(ptr)
        // The address length lives behind the address, inside the overlap
        let length_slot = (address + 64).@cast(*i32)
        @ptrv(length_slot, i32) = 64
        let res = ext.WSARecvFrom(this.fd, @ref(ov.buflen), 1, null, @ref(ov.flags), address, length_slot, ov.@cast(ptr), null)
        if res == ext.SOCKET_ERROR && io.socket_io_failed() : throw .read
        if io.await_overlap(this.fd, ov.@cast(ptr), current, this.read_timeout_ms) : throw .timeout
        let ok = ext.WSAGetOverlappedResult(this.fd, ov.@cast(ptr), @ref(ov.transferred), 1, @ref(ov.flags))
        if ok == 0 || ov.base.sys.Internal != 0 : throw .read
        let from = SocketAddress.from_sockaddr(address, @ptrv(length_slot, i32).to(uint)) ! throw .read
        return (ov.transferred.to(uint), from)
        #else
        let buffer = [u8 x 128]{ 0... }
        let address = @ref(buffer).@cast(ptr)
        let deadline = time_deadline(this.read_timeout_ms)
        while true {
            let length: u32 = 128
            let received = ext.recvfrom(this.fd, buf.data, buf.length, 0, address.@cast(*ext.libc_sockaddr), @ref(length))
            if received >= 0 {
                let from = SocketAddress.from_sockaddr(address, length.to(uint)) ! throw .read
                return (received.to(uint), from)
            }
            let error = ext.get_errno()
            if error == ext.EINTR : continue
            if error != ext.EAGAIN && error != ext.EWOULDBLOCK : throw .read
            let ev = io.await_fd(this.fd, true, false, time_remaining(deadline) !>)
            if ev.is_timeout() : throw .timeout
            if ev.is_closed() : throw .closed
        }
        throw .read
        #end
    }

    /// Closes the socket; does nothing when already closed. Throws `os` when closing fails.
    + fn close() !io.IoError {
        if this.closed : return
        this.closed = true
        #if OS == "win"
        if ext.closesocket(this.fd) != 0 : throw .os
        #else
        if ext.close(this.fd) != 0 : throw .os
        #end
    }

    fn gc_free() {
        if this.closed : return
        this.closed = true
        #if OS == "win"
        if ext.closesocket(this.fd) != 0 : core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        #else
        if ext.close(this.fd) != 0 : core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        #end
    }
}

#if OS != "win"
// Absolute deadline in ms; 0 means no deadline
fn time_deadline(timeout_ms: uint) uint {
    if timeout_ms == 0 : return 0
    return time.mono_ms() + timeout_ms
}

// The wait budget left before `deadline`; 0 waits forever
fn time_remaining(deadline: uint) uint !io.IoError {
    if deadline == 0 : return 0
    let now = time.mono_ms()
    if now >= deadline : throw .timeout
    return deadline - now
}
#end

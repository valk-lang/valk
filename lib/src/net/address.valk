use ext
use mem

// Byte layout of the C socket address structures (sockaddr_in / sockaddr_in6)
value sockaddr_v4_size (16)
value sockaddr_v6_size (28)

/// An IPv4 or IPv6 address with a port: the peer of a datagram, or a bound endpoint.
+ struct SocketAddress {
    /// The port number, in host byte order.
    + port: u16 (0)
    /// True for an IPv6 address, false for IPv4.
    + ipv6: bool (false)
    /// The IPv6 zone index (`fe80::1%2`); 0 for IPv4 and global addresses.
    + scope_id: u32 (0)
    // IPv4 uses the first 4 bytes
    - bytes: [u8 x 16] ({ 0 ... })

    /// Returns the IPv4 address `a.b.c.d` with `port`.
    + static fn ipv4(a: u8, b: u8, c: u8, d: u8, port: u16 (0)) SocketAddress {
        let address = SocketAddress { port: port }
        address.bytes[0] = a
        address.bytes[1] = b
        address.bytes[2] = c
        address.bytes[3] = d
        return address
    }

    /// Parses a numeric host such as `"127.0.0.1"`, `"::1"` or `"[::1]"`; never does a DNS lookup.
    ///
    /// Throws `invalid_host` when `host` is a name or not a valid address.
    + static fn parse(host: String, port: u16 (0)) SocketAddress !NetError {
        @unsafe
        let info = AddrInfo.new(host, port, 0, true, true) !>
        return SELF.from_sockaddr(info.sock_addr().@cast(ptr), info.addr_len().to(uint)) !>
    }

    /// Resolves a host name or numeric host to one address, preferring IPv4 when both exist.
    ///
    /// Throws `invalid_host` when the lookup fails and `timeout` when it takes longer than
    /// `timeout_ms` (0 waits as long as the lookup takes, on the calling thread). A lookup
    /// that timed out keeps running on a background thread until the system returns.
    + static fn resolve(host: String, port: u16, timeout_ms: uint (5000)) SocketAddress !NetError {
        @unsafe
        let info = AddrInfo.new(host, port, timeout_ms, true) !>
        return SELF.from_sockaddr(info.sock_addr().@cast(ptr), info.addr_len().to(uint)) !>
    }

    /// Returns true when both addresses have the same family, bytes, port and scope id.
    + fn equals(other: SocketAddress) bool {
        if this.port != other.port || this.ipv6 != other.ipv6 || this.scope_id != other.scope_id : return false
        let count: uint = this.ipv6 ? 16 : 4
        let i: uint = 0
        while i < count {
            if this.bytes[i] != other.bytes[i] : return false
            i++
        }
        return true
    }

    /// Returns the address without the port, as `"127.0.0.1"` or `"::1"`.
    ///
    /// IPv6 is written in the RFC 5952 short form (lowercase hex, the longest run of two or
    /// more zero groups as `::`), followed by `%scope_id` when the scope id is not 0.
    + fn ip() String {
        if !this.ipv6 {
            return this.bytes[0].to_string() + "." + this.bytes[1] + "." + this.bytes[2] + "." + this.bytes[3]
        }
        // RFC 5952: the longest run of zero groups (at least two) becomes "::"
        let groups = [u16 x 8]{ 0... }
        let i: uint = 0
        while i < 8 {
            groups[i] = (this.bytes[i * 2].to(u16) << 8) | this.bytes[i * 2 + 1].to(u16)
            i++
        }
        // RFC 5952 §5: an IPv4-mapped address keeps the dotted quad of its low 32 bits
        if groups[0] == 0 && groups[1] == 0 && groups[2] == 0 && groups[3] == 0 && groups[4] == 0 && groups[5] == 0xffff {
            return "::ffff:" + this.bytes[12].to_string() + "." + this.bytes[13] + "." + this.bytes[14] + "." + this.bytes[15]
        }
        let best_start: uint = 8
        let best_length: uint = 0
        i = 0
        while i < 8 {
            if groups[i] != 0 {
                i++
                continue
            }
            let start = i
            while i < 8 && groups[i] == 0 : i++
            if i - start > best_length {
                best_start = start
                best_length = i - start
            }
        }
        if best_length < 2 : best_start = 8
        let text = ""
        i = 0
        while i < 8 {
            if i == best_start {
                text += "::"
                i += best_length
                continue
            }
            if i > 0 && i != best_start + best_length : text += ":"
            text += hex_group(groups[i])
            i++
        }
        if this.scope_id != 0 : text += "%" + this.scope_id
        return text
    }

    /// Returns the address with its port, as `"127.0.0.1:80"` or `"[::1]:80"`.
    + fn to_string() String {
        if this.ipv6 : return "[" + this.ip() + "]:" + this.port
        return this.ip() + ":" + this.port
    }

    // Writes the C structure into `buffer` (at least sockaddr_v6_size bytes)
    // and returns its length
    fn write_sockaddr(buffer: ptr) u32 {
        @unsafe
        let size: uint = this.ipv6 ? sockaddr_v6_size : sockaddr_v4_size
        mem.clear_bytes(buffer, size)
        let family: u16 = this.ipv6 ? ext.AF_INET6 : ext.AF_INET
        #if OS == "macos"
        @ptrv(buffer, u8, 0) = size.to(u8)
        @ptrv(buffer, u8, 1) = family.to(u8)
        #else
        @ptrv(buffer, u16, 0) = family
        #end
        @ptrv(buffer, u8, 2) = (this.port >> 8).to(u8)
        @ptrv(buffer, u8, 3) = (this.port & 0xff).to(u8)
        if this.ipv6 {
            let i: uint = 0
            while i < 16 {
                @ptrv(buffer, u8, 8 + i) = this.bytes[i]
                i++
            }
            @ptrv(buffer, u32, 6) = this.scope_id
        } else {
            let i: uint = 0
            while i < 4 {
                @ptrv(buffer, u8, 4 + i) = this.bytes[i]
                i++
            }
        }
        return size.to(u32)
    }

    static fn from_sockaddr(buffer: ptr, length: uint) SocketAddress !NetError {
        @unsafe
        #if OS == "macos"
        let family = @ptrv(buffer, u8, 1).to(u16)
        #else
        let family = @ptrv(buffer, u16, 0)
        #end
        let address = SocketAddress {}
        address.port = (@ptrv(buffer, u8, 2).to(u16) << 8) | @ptrv(buffer, u8, 3).to(u16)
        if family == ext.AF_INET6 {
            if length < sockaddr_v6_size : throw .invalid_host
            address.ipv6 = true
            let i: uint = 0
            while i < 16 {
                address.bytes[i] = @ptrv(buffer, u8, 8 + i)
                i++
            }
            address.scope_id = @ptrv(buffer, u32, 6)
            return address
        }
        if family != ext.AF_INET || length < sockaddr_v4_size : throw .invalid_host
        let i: uint = 0
        while i < 4 {
            address.bytes[i] = @ptrv(buffer, u8, 4 + i)
            i++
        }
        return address
    }
}

fn hex_group(value: u16) String {
    let digits = "0123456789abcdef"
    let text = ""
    let shift: uint = 16
    let started = false
    while shift > 0 {
        shift -= 4
        let digit = ((value >> shift) & 0xf).to(uint)
        if digit == 0 && !started && shift > 0 : continue
        started = true
        text += digits.range(digit, 1)
    }
    return text
}

// Binds `fd` to the unspecified address of its family (any interface,
// any port): what ConnectEx and a client datagram socket need before use
fn bind_any(fd: Fd, ipv6: bool) bool {
    @unsafe
    let buffer = [u8 x 28]{ 0... }
    let address = SocketAddress { ipv6: ipv6 }
    let length = address.write_sockaddr(@ref(buffer).@cast(ptr))
    return ext.bind(fd, @ref(buffer).@cast(*ext.libc_sockaddr), length) == 0
}

// The address `fd` is bound to
fn local_address_of(fd: Fd) SocketAddress !NetError {
    @unsafe
    let buffer = [u8 x 128]{ 0... }
    #if OS == "win"
    let length: i32 = 128
    #else
    let length: u32 = 128
    #end
    if ext.getsockname(fd, @ref(buffer).@cast(*ext.libc_sockaddr), @ref(length)) != 0 : throw .os
    return SocketAddress.from_sockaddr(@ref(buffer).@cast(ptr), length.to(uint)) !>
}

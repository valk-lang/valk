
use ext

#if OS == "win"
link "libssl"
link "libcrypto"
link "advapi32"
link "user32"
link "bcrypt"
link "crypt32"
#else
link static "ssl"
link static "crypto"
#end

#if OS == "linux"
link dynamic "dl"
link ":libc_nonshared.a"
#end

pointer OSSL {}
pointer SSL_CTX {}
pointer X509 {}
pointer X509_VERIFY_PARAM {}
pointer SSL_SESSION {}
pointer EVP_MD {}
pointer OPENSSL_STACK {}
pointer BIO {}
pointer BIO_ADDR {}
pointer X509_NAME {}

// C `long` is 32 bits on Windows
#if OS == "win"
type c_long (i32)
#else
type c_long (int)
#end

enum ERROR: i32 {
    NONE (0)
    SSL (1)
    WANT_READ (2)
    WANT_WRITE (3)
    WANT_X509_LOOKUP (4)
    SYSCALL (5) // look at error stack/return value/errno
    ZERO_RETURN (6)
    WANT_CONNECT (7)
    WANT_ACCEPT (8)
    WANT_ASYNC (9)
    WANT_ASYNC_JOB (10)
    WANT_CLIENT_HELLO_CB (11)
    WANT_RETRY_VERIFY (12)
}

value SSL_VERIFY_NONE (0x0)
value SSL_VERIFY_PEER (0x1)
value SSL_VERIFY_FAIL_IF_NO_PEER_CERT (0x2)
// X509_NAME_print_ex: the RFC 2253 form, `CN=alice,O=Example`
value XN_FLAG_RFC2253 (0x1110317)
value BIO_CTRL_INFO (3)

value SSL3_VERSION (0x0300)
value TLS1_VERSION (0x0301)
value TLS1_1_VERSION (0x0302)
value TLS1_2_VERSION (0x0303)
value TLS1_3_VERSION (0x0304)
value DTLS1_VERSION (0xFEFF)
value DTLS1_2_VERSION (0xFEFD)
value DTLS1_BAD_VER (0x0100)

value SSL_OP_ENABLE_KTLS (1 << 3)
value SSL_OP_NO_COMPRESSION (1 << 17)
value SSL_OP_NO_ANTI_REPLAY (1 << 24)
value SSL_OP_NO_SSLv3 (1 << 25)
value SSL_OP_NO_TLSv1 (1 << 26)
value SSL_OP_NO_TLSv1_2 (1 << 27)
value SSL_OP_NO_TLSv1_1 (1 << 28)
value SSL_OP_NO_TLSv1_3 (1 << 29)
value SSL_OP_NO_RENEGOTIATION (1 << 30)
value SSL_OP_NO_DTLSv1 (1 << 26)
value SSL_OP_NO_DTLSv1_2 (1 << 27)

value SSL_CTRL_MODE (33)
value SSL_MODE_RELEASE_BUFFERS (0x00000010)
value SSL_CTRL_SET_MIN_PROTO_VERSION (123)
value SSL_CTRL_SET_MAX_PROTO_VERSION (124)

value SSL_CTRL_SET_TLSEXT_HOSTNAME (55)
value TLSEXT_NAMETYPE_host_name (0)
value SSL_FILETYPE_PEM (1)
value BIO_NOCLOSE (0)
value BIO_CLOSE (1)

// OpenSSL 3.5 QUIC constants
value BIO_POLL_DESCRIPTOR_TYPE_NONE (0)
value BIO_POLL_DESCRIPTOR_TYPE_SOCK_FD (1)
value BIO_POLL_DESCRIPTOR_TYPE_SSL (2)

value SSL_ACCEPT_CONNECTION_NO_BLOCK (1 << 0)
value SSL_STREAM_TYPE_READ (1 << 0)
value SSL_STREAM_TYPE_WRITE (1 << 1)
value SSL_STREAM_TYPE_BIDI (3)
value SSL_WRITE_FLAG_CONCLUDE (1 << 0)
value SSL_DEFAULT_STREAM_MODE_NONE (0)
value SSL_DEFAULT_STREAM_MODE_AUTO_BIDI (1)
value SSL_DEFAULT_STREAM_MODE_AUTO_UNI (2)
value SSL_STREAM_FLAG_UNI (1 << 0)
value SSL_STREAM_FLAG_NO_BLOCK (1 << 1)
value SSL_STREAM_FLAG_ADVANCE (1 << 2)
value SSL_INCOMING_STREAM_POLICY_AUTO (0)
value SSL_INCOMING_STREAM_POLICY_ACCEPT (1)
value SSL_INCOMING_STREAM_POLICY_REJECT (2)
value SSL_ACCEPT_STREAM_NO_BLOCK (1 << 0)
value SSL_ACCEPT_STREAM_UNI (1 << 1)
value SSL_ACCEPT_STREAM_BIDI (1 << 2)
value SSL_SHUTDOWN_FLAG_RAPID (1 << 0)
value SSL_SHUTDOWN_FLAG_NO_STREAM_FLUSH (1 << 1)
value SSL_SHUTDOWN_FLAG_NO_BLOCK (1 << 2)
value SSL_SHUTDOWN_FLAG_WAIT_PEER (1 << 3)
value SSL_STREAM_STATE_NONE (0)
value SSL_STREAM_STATE_OK (1)
value SSL_STREAM_STATE_WRONG_DIR (2)
value SSL_STREAM_STATE_FINISHED (3)
value SSL_STREAM_STATE_RESET_LOCAL (4)
value SSL_STREAM_STATE_RESET_REMOTE (5)
value SSL_STREAM_STATE_CONN_CLOSED (6)

value SSL_POLL_EVENT_NONE (0)
value SSL_POLL_EVENT_F (1 << 0)
value SSL_POLL_EVENT_EL (1 << 1)
value SSL_POLL_EVENT_EC (1 << 2)
value SSL_POLL_EVENT_ECD (1 << 3)
value SSL_POLL_EVENT_ER (1 << 4)
value SSL_POLL_EVENT_EW (1 << 5)
value SSL_POLL_EVENT_R (1 << 6)
value SSL_POLL_EVENT_W (1 << 7)
value SSL_POLL_EVENT_IC (1 << 8)
value SSL_POLL_EVENT_ISB (1 << 9)
value SSL_POLL_EVENT_ISU (1 << 10)
value SSL_POLL_EVENT_OSB (1 << 11)
value SSL_POLL_EVENT_OSU (1 << 12)
value SSL_POLL_FLAG_NO_HANDLE_EVENTS (1 << 0)

struct BioPollDescriptor {
    kind: u32 (0)
    pad: u32 (0)
    value: ?ptr (null)
}

struct SslPollItem {
    desc: BioPollDescriptor (.{})
    events: u64 (0)
    revents: u64 (0)
}

struct SslStreamResetArgs {
    quic_error_code: u64 (0)
}

struct SslShutdownExArgs {
    quic_error_code: u64 (0)
    quic_reason: ?cstring (null)
}

extern fn SSL_CTX_new(method: ptr) SSL_CTX;
extern fn SSL_CTX_free(ctx: SSL_CTX) void;

extern fn SSL_new(ctx: SSL_CTX) OSSL;
extern fn SSL_set_fd(ssl: OSSL, fd: i32) i32;
extern fn SSL_free(ssl: OSSL) void;
extern fn SSL_connect(ssl: OSSL) i32;
extern fn SSL_accept(ssl: OSSL) i32;
extern fn SSL_shutdown(ssl: OSSL) i32;

extern fn SSL_get_fd(ctx: OSSL) i32;
extern fn SSL_get_version(ssl: OSSL) cstring;
extern fn SSL_get_current_cipher(ssl: OSSL) ptr;
extern fn SSL_CIPHER_get_name(cipher: ptr) cstring;
extern fn SSL_set_options(ssl: OSSL, options: u64) u64;
extern fn SSL_get_verify_mode(ssl: OSSL) i32;
extern fn SSL_write(ssl: OSSL, data: ptr, bytes: uint) i32;
extern fn SSL_read(ssl: OSSL, data: ptr, bytes: uint) i32;
extern fn SSL_write_ex(ssl: OSSL, data: ptr, bytes: uint, bytes_written_uint_ptr: ptr) i32;
extern fn SSL_write_ex2(ssl: OSSL, data: ptr, bytes: uint, flags: u64, bytes_written_uint_ptr: ptr) i32;
extern fn SSL_read_ex(ssl: OSSL, data: ptr, bytes: uint, bytes_read_uint_ptr: ptr) i32;
extern fn SSL_has_pending(ssl: OSSL) i32;
extern fn SSL_free_buffers(ssl: OSSL) i32;
extern fn SSL_set1_host(ssl: OSSL, host: cstring) i32;
extern fn SSL_set_verify(ssl: OSSL, mode: i32, cb: ?fnptr(i32, ptr)(i32)) void;
extern fn SSL_set_cipher_list(ssl: OSSL, ciphers: cstring) i32;
extern fn SSL_set_ciphersuites(ssl: OSSL, ciphers: cstring) i32;
extern fn SSL_set_alpn_protos(ssl: OSSL, protocols: ptr, protocols_length: u32) i32;
extern fn SSL_get0_alpn_selected(ssl: OSSL, protocol: *ptr, protocol_length: *u32) void;
extern fn SSL_CTX_set_alpn_select_cb(ctx: SSL_CTX, callback: fnptr(OSSL, *ptr, *u8, ptr, u32, ?ptr)(i32), arg: ?ptr) void;
extern fn SSL_get_peer_cert_chain(ssl: OSSL) ?OPENSSL_STACK;
extern fn SSL_get_session(ssl: OSSL) ?SSL_SESSION;
// The peer's own certificate (the chain leaves it out on a server); not a new reference
extern fn SSL_SESSION_get0_peer(session: SSL_SESSION) ?X509;
extern fn SSL_get0_peer_certificate(ssl: OSSL) ?X509;
extern fn SSL_get0_param(ssl: OSSL) X509_VERIFY_PARAM;
extern fn SSL_ctrl(ssl: OSSL, cmd: i32, larg: int, parg: ?ptr) int;

extern fn SSL_CTX_set_client_CA_list(ctx: SSL_CTX, names: OPENSSL_STACK) void;
extern fn SSL_load_client_CA_file(path: cstring) ?OPENSSL_STACK;
extern fn X509_get_subject_name(cert: X509) X509_NAME;
extern fn X509_NAME_print_ex(bio: BIO, name: X509_NAME, indent: i32, flags: c_long) i32;
extern fn BIO_new(method: ptr) ?BIO;
extern fn BIO_s_mem() ptr;
extern fn BIO_free(bio: BIO) i32;
extern fn BIO_ctrl(bio: BIO, command: i32, larg: c_long, parg: ?ptr) c_long;

extern fn SSL_use_certificate_chain_file(ssl: OSSL, path: cstring) i32;
extern fn SSL_use_PrivateKey_file(ssl: OSSL, path: cstring, file_type: i32) i32;
extern fn SSL_check_private_key(ssl: OSSL) i32;
extern fn SSL_set_default_passwd_cb_userdata(ssl: OSSL, data: ?ptr) void;

extern fn SSL_get_error(ssl: OSSL, ret: i32) ERROR;
extern fn ERR_clear_error();
extern fn ERR_get_error() uint;
extern fn ERR_error_string(error: uint, buffer: ?ptr) cstring;

extern fn TLS_client_method() ptr;
extern fn TLS_server_method() ptr;
extern fn SSLv23_client_method() ptr;
extern fn OSSL_QUIC_client_method() ptr;
extern fn OSSL_QUIC_server_method() ptr;

extern fn BIO_new_dgram(fd: i32, close_flag: i32) ?BIO;
extern fn BIO_ADDR_new() ?BIO_ADDR;
extern fn BIO_ADDR_free(addr: BIO_ADDR) void;
extern fn BIO_ADDR_rawmake(addr: BIO_ADDR, family: i32, where: ptr, wherelen: uint, port_be: u16) i32;
extern fn SSL_set_bio(ssl: OSSL, rbio: BIO, wbio: BIO) void;
extern fn SSL_set1_initial_peer_addr(ssl: OSSL, addr: BIO_ADDR) i32;
extern fn SSL_set_blocking_mode(ssl: OSSL, blocking: i32) i32;
extern fn SSL_handle_events(ssl: OSSL) i32;
extern fn SSL_get_event_timeout(ssl: OSSL, tv: *ext.libc_timeval, is_infinite: *i32) i32;
extern fn SSL_net_read_desired(ssl: OSSL) i32;
extern fn SSL_net_write_desired(ssl: OSSL) i32;
extern fn SSL_new_listener(ctx: SSL_CTX, flags: u64) ?OSSL;
extern fn SSL_listen(ssl: OSSL) i32;
extern fn SSL_accept_connection(ssl: OSSL, flags: u64) ?OSSL;
extern fn SSL_set_default_stream_mode(ssl: OSSL, mode: u32) i32;
extern fn SSL_set_incoming_stream_policy(ssl: OSSL, policy: i32, aec: u64) i32;
extern fn SSL_new_stream(ssl: OSSL, flags: u64) ?OSSL;
extern fn SSL_accept_stream(ssl: OSSL, flags: u64) ?OSSL;
extern fn SSL_get_stream_type(ssl: OSSL) i32;
extern fn SSL_get_stream_id(ssl: OSSL) u64;
extern fn SSL_get_stream_read_state(ssl: OSSL) i32;
extern fn SSL_get_stream_write_state(ssl: OSSL) i32;
extern fn SSL_stream_conclude(ssl: OSSL, flags: u64) i32;
extern fn SSL_stream_reset(ssl: OSSL, args: *SslStreamResetArgs, args_len: uint) i32;
extern fn SSL_shutdown_ex(ssl: OSSL, flags: u64, args: ?*SslShutdownExArgs, args_len: uint) i32;
extern fn SSL_poll(items: *SslPollItem, num_items: uint, stride: uint, timeout: ?*ext.libc_timeval, flags: u64, result_count: ?*uint) i32;

extern fn SSL_CTX_set_verify(ctx: SSL_CTX, mode: i32, cb: ?fnptr(i32, ptr)(i32)) void;
extern fn SSL_CTX_set_options(ctx: SSL_CTX, flags: int);
extern fn SSL_CTX_ctrl(ctx: SSL_CTX, cmd: i32, larg: int, parg: ?ptr) int;
extern fn SSL_CTX_load_verify_locations(ctx: SSL_CTX, ca_file: ?cstring, ca_path: ?cstring) i32;
extern fn SSL_CTX_set_default_verify_paths(ctx: SSL_CTX) i32;
extern fn SSL_CTX_set_cipher_list(ctx: SSL_CTX, ciphers: cstring) i32;
extern fn SSL_CTX_set_ciphersuites(ctx: SSL_CTX, ciphers: cstring) i32;
extern fn SSL_CTX_use_certificate_file(ctx: SSL_CTX, path: cstring, file_type: i32) i32;
extern fn SSL_CTX_use_PrivateKey_file(ctx: SSL_CTX, path: cstring, file_type: i32) i32;
extern fn SSL_CTX_check_private_key(ctx: SSL_CTX) i32;

extern fn X509_get_default_cert_file() cstring;
extern fn X509_VERIFY_PARAM_set1_ip_asc(param: X509_VERIFY_PARAM, ip: cstring) i32;
extern fn X509_digest(cert: X509, digest_type: EVP_MD, digest: *u8, digest_length: *u32) i32;
extern fn EVP_sha256() EVP_MD;
extern fn OPENSSL_sk_value(stack: OPENSSL_STACK, index: i32) ?X509;

extern fn SSL_CTX_get_cert_store(ctx: SSL_CTX) ptr;

#if OS == "win"
// CERT_CONTEXT: one certificate of a Windows certificate store
struct WinCertContext {
    encoding: u32
    encoded: ptr
    encoded_length: u32
    info: ptr
    store: ptr
}
extern fn CertOpenSystemStoreA(provider: ?ptr, protocol: cstring) ?ptr;
extern fn CertEnumCertificatesInStore(store: ptr, previous: ?*WinCertContext) ?*WinCertContext;
extern fn CertCloseStore(store: ptr, flags: u32) i32;
#end

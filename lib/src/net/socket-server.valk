use io

+ class SocketServer is io.Closer {
    ~+ socket: Socket

    + fn accept() Connection !NetError {
        let sock = this.socket
        if sock.closed != 0 : throw .closed

        let sock_fd = sock.fd
        let fd = accept(sock_fd) !>

        return Connection.new(fd) !>
    }

    + fn close() !io.IoError {
        this.socket.close() !>
    }
}

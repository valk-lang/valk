use io
use core
use ext

+ class SocketServer is io.Closer {
    ~+ socket: Socket
    #if OS == "win"
    iocp_port: ext.HANDLE (0)
    #end

    + fn accept(timeout_ms: uint (0)) Connection !NetError {
        let fd = this.accept_fd(timeout_ms) !>
        #if OS == "win"
        if !io.associate(fd) {
            Socket.close_fd_cleanup(fd, __FILE__, __LINE__)
            throw .os
        }
        #end
        return Connection.new(fd) !>
    }

    // The accepted descriptor is unassociated so its destination can own it.
    fn accept_fd(timeout_ms: uint) Fd !NetError {
        let sock = this.socket
        if sock.closed != 0 : throw .closed

        let sock_fd = sock.fd
        #if OS == "win"
        let port = io.iocp()
        if this.iocp_port != port {
            core.race_lock()
            if this.iocp_port == 0 && io.associate(sock_fd) : this.iocp_port = port
            core.race_unlock()
            if this.iocp_port != port : throw .os
        }
        #end
        return accept(sock_fd, timeout_ms) !>
    }

    + fn close() !io.IoError {
        this.socket.close() !>
    }
}

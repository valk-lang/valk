use io

/// A listening TCP socket, made by `Socket.server`; `accept` hands out connections.
+ class SocketServer is io.Closer {
    /// The underlying listening socket.
    ~+ socket: Socket

    /// Waits for the next incoming connection and returns it.
    ///
    /// `timeout_ms` 0 waits forever; otherwise `timeout` is thrown when it runs out. Throws
    /// `closed` after `close`, and `max_connections` when the process is out of file
    /// descriptors (Linux and macOS).
    + fn accept(timeout_ms: uint (0)) Connection !NetError {
        let sock = this.socket
        if sock.closed != 0 : throw .closed
        let fd = accept(sock.fd, sock.ipv6, timeout_ms) !>
        #if OS == "win"
        if !io.associate(fd) {
            Socket.close_fd_cleanup(fd, __FILE__, __LINE__)
            throw .os
        }
        #end
        return Connection.new(fd) !>
    }

    /// Closes the listening socket; connections already accepted stay open.
    + fn close() !io.IoError {
        this.socket.close() !>
    }
}

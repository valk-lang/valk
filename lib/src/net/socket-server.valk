use io
use ext

+ class SocketServer is io.Closer {
    ~+ socket: Socket

    + fn accept(timeout_ms: uint (0)) Connection !NetError {
        @unsafe
        let sock = this.socket
        if sock.closed != 0 : throw .closed
        // The listener must outlive the wait that only receives its fd
        let fd = accept(sock.fd, timeout_ms) ! {
            ext.valk_gc_keep_alive(sock.@cast(ptr))
            throw E
        }
        ext.valk_gc_keep_alive(sock.@cast(ptr))
        #if OS == "win"
        if !io.associate(fd) {
            Socket.close_fd_cleanup(fd, __FILE__, __LINE__)
            throw .os
        }
        #end
        return Connection.new(fd) !>
    }

    + fn close() !io.IoError {
        this.socket.close() !>
    }
}


use ext
use coro
use io
use mem
use core

#if OS == "win"
type ConnectExFn (fnptr(ext.SOCKET, *ext.libc_sockaddr, i32, ?ptr, u32, ?ptr, ?ptr)(ext.BOOL))
type AcceptExFn (fnptr(ext.SOCKET, ext.SOCKET, ?ptr, u32, u32, u32, &u32, ?ptr)(ext.BOOL))

global pConnectEx: ?ConnectExFn
global pAcceptEx: ?AcceptExFn

fn LoadConnectEx(s: ext.SOCKET) ConnectExFn !NetError {
    let p = pConnectEx
    if isset(p) : return p
    // {0x25a207b9,0xddf3,0x4660,{0x8e,0xe9,0x76,0xe5,0x8c,0x74,0x06,0x3e}}
    let guid: ext.GUID = @undefined
    guid.Data1 = 0x25a207b9
    guid.Data2 = 0xddf3
    guid.Data3 = 0x4660
    guid.Data4 = { 0x8e, 0xe9, 0x76, 0xe5, 0x8c, 0x74, 0x06, 0x3e }
    let bytes: u32 = 0
    let res = ext.WSAIoctl(s, ext.SIO_GET_EXTENSION_FUNCTION_POINTER, @ref(guid), size_of(ext.GUID), @ref(pConnectEx), size_of(ptr), @ref(bytes), null, null)
    if res != 0 {
        throw .os
    }
    return pConnectEx.@cast(ConnectExFn)
}

fn LoadAcceptEx(s: ext.SOCKET) AcceptExFn !NetError {
    let p = pAcceptEx
    if isset(p) : return p
    // {0x25a207b9,0xddf3,0x4660,{0x8e,0xe9,0x76,0xe5,0x8c,0x74,0x06,0x3e}}
    let guid: ext.GUID = @undefined
    guid.Data1 = 0xb5367df1
    guid.Data2 = 0xcbac
    guid.Data3 = 0x11cf
    guid.Data4 = { 0x95, 0xca, 0x00, 0x80, 0x5f, 0x48, 0xa1, 0x92 }
    let bytes: u32 = 0
    let res = ext.WSAIoctl(s, ext.SIO_GET_EXTENSION_FUNCTION_POINTER, @ref(guid), size_of(ext.GUID), @ref(pAcceptEx), size_of(ptr), @ref(bytes), null, null)
    if res != 0 {
        throw .os
    }
    return pAcceptEx.@cast(AcceptExFn)
}
#end

fn accept(sock_fd: FD, timeout_ms: uint (0)) FD !NetError {
    #if OS == "win"
    let fd = ext.WSASocketA(ext.AF_INET, ext.SOCK_STREAM, ext.IPPROTO_TCP, null, 0, ext.WSA_FLAG_OVERLAPPED)
    if fd == ext.INVALID_SOCKET : throw .init

    if !io.associate(fd) {
        Socket.close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        throw .init
    }

    let acfn = LoadAcceptEx(sock_fd) ! {
        Socket.close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        throw .os
    }

    let ov = io.overlap()
    let addrLen: u32 = size_of(ext.sockaddr_in) + 16;
    let ok = acfn(sock_fd, fd, @ref(ov.addressBuffer), 0, addrLen, addrLen, @ref(ov.transferred), ov)
    if ok == 0 && io.socket_io_failed() {
        Socket.close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        throw .init
    }
    let current = coro.current_coro.@cast(coro.Coro)
    if io.await_overlap(sock_fd, ov.@cast(ptr), current, timeout_ms) {
        Socket.close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        throw .timeout
    }

    if ov.base.sys.Internal != 0 {
        Socket.close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        throw .init
    }

    if ext.setsockopt(fd, ext.SOL_SOCKET, ext.SO_UPDATE_ACCEPT_CONTEXT, @ref(sock_fd), size_of(FD)) != 0 {
        Socket.close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        throw .init
    }

    return fd

    #elif OS == "linux"

    let coro = coro.current_coro.@cast(coro.Coro)
    let sqe = io.sqe(coro) ! throw .os
    io.io_uring_prep_accept(sqe, sock_fd, null, 0, 0)
    io.link_timeout(coro, sqe, timeout_ms) ! throw .os
    coro.yield()
    return accept_completion_result(coro.completion_res) !>
    #elif OS == "macos"
    while true {
        let fd = ext.accept(sock_fd, null, null)
        if fd == -1 {
            let err = ext.get_errno()
            if err == ext.EAGAIN {
                let ev = io.await_fd(sock_fd, true, false, timeout_ms)
                if ev.is_timeout() : throw .timeout
                continue
            }
            if err == ext.EMFILE || err == ext.ENFILE {
                // Too many connections
                throw .max_connections
            }
            throw .init
        }
        return fd
    }
    throw .init
    #else
    #error "Socket accept: Unsupported OS"
    #end
}

#if OS == "linux"
fn accept_completion_result(result: int) FD !NetError {
    if result == 0 - ext.ETIMEDOUT : throw .timeout
    if result == 0 - ext.EMFILE || result == 0 - ext.ENFILE : throw .max_connections
    let fd = result.to(FD)
    if fd < 0 : throw .init
    return fd
}

#if TEST
+ fn accept_completion_result_for_test(result: int) FD !NetError {
    return accept_completion_result(result) !>
}
#end
#end

fn connect(fd: FD, addr: AddrInfo, timeout_ms: uint (5000)) !NetError {
    #if OS == "win"
    let empty_addr: ext.libc_gen_sockaddr = @undefined
    mem.clear(&empty_addr, size_of(ext.libc_gen_sockaddr))
    empty_addr.sa_family = ext.AF_INET

    let err = ext.bind(fd, (&empty_addr).@cast(*ext.libc_sockaddr), size_of(ext.libc_gen_sockaddr))
    if err != 0 : throw .connect

    let confn = LoadConnectEx(fd) !>

    let ov = io.overlap()
    let ok = confn(fd, addr.sock_addr(), addr.addr_len(), null, 0, @ref(ov.transferred), ov)
    if ok == 0 && io.socket_io_failed() : throw .connect
    let current = coro.current_coro.@cast(coro.Coro)
    if io.await_overlap(fd, ov.@cast(ptr), current, timeout_ms) : throw .timeout

    if ov.base.sys.Internal != 0 {
        throw .connect
    }

    if ext.setsockopt(fd, ext.SOL_SOCKET, ext.SO_UPDATE_CONNECT_CONTEXT, null, 0) != 0 {
        throw .connect
    }

    #elif OS == "linux"
    let coro = coro.current_coro.@cast(coro.Coro)
    let sqe = io.sqe(coro) !>
    io.io_uring_prep_connect(sqe, fd, addr.sock_addr(), addr.addr_len())
    io.link_timeout(coro, sqe, timeout_ms) ! throw .os
    coro.yield()
    let res = coro.completion_res
    if res == 0 - ext.ETIMEDOUT : throw .timeout
    if res < 0 : throw .connect

    #elif OS == "macos"
    while true {
        let err = ext.connect(fd, addr.sock_addr(), addr.addr_len())
        if err == 0 : break
        // Error
        let error = ext.get_errno()
        if error == ext.EISCONN : break
        if error == ext.EINPROGRESS {
            let ev = io.await_fd(fd, false, true, timeout_ms)
            if ev.is_timeout() : throw .timeout
            continue
        }
        throw .connect
    }
    #else
    #error "Socket connect: Unsupported OS"
    #end
}

// Receive
+ fn recv(fd: FD, buf: ByteBuffer, amount: uint, timeout_ms: uint (5000)) uint !NetError {
    buf.reserve_space(amount)
    let res = recv_to_ptr(fd, buf.data.@offset(buf.length), amount, timeout_ms) !>
    buf.advance(res)
    return res
}
+ fn recv_to_ptr(fd: FD, buf: ptr, amount: uint, timeout_ms: uint (5000)) uint !NetError {
    let coro = coro.current_coro.@cast(coro.Coro)

    #if OS == "macos"
    while true {
        let res = ext.read(fd, buf, amount.to(u32))
        if res == 0 : return 0
        if res < 0 {
            let error = ext.get_errno()
            if error == ext.EAGAIN {
                let ev = io.await_fd(fd, true, false, timeout_ms)
                if ev.is_timeout() : throw .timeout
                if !ev.is_readable() : throw .closed
                continue
            }
            if error == ext.EINTR : continue
            break
        }
        return res.to(uint)
    }
    throw .read

    #elif OS == "linux"
    let sqe = io.sqe(coro) ! throw .os
    io.io_uring_prep_recv(sqe, fd, buf, amount.to(u32), 0)
    io.link_timeout(coro, sqe, timeout_ms) ! throw .os

    coro.yield()
    let rcvd = coro.completion_res
    if rcvd == 0 - ext.ETIMEDOUT : throw .timeout
    if rcvd < 0 : throw .read
    return rcvd.to(uint)

    #elif OS == "win"
    let ov = io.overlap()
    ov.buflen = amount
    ov.buf = buf

    let res = ext.WSARecv(fd, @ref(ov.buflen), 1, null, @ref(ov.flags), ov.@cast(ptr), null)
    if res == ext.SOCKET_ERROR && io.socket_io_failed() : throw .read
    if io.await_overlap(fd, ov.@cast(ptr), coro, timeout_ms) : throw .timeout

    let ok = ext.WSAGetOverlappedResult(fd, ov.@cast(ptr), @ref(ov.transferred), 1, @ref(ov.flags))
    if ok == 0 || ov.base.sys.Internal != 0 {
        throw .read
    }

    let rcvd = ov.transferred
    return rcvd
    #else
    #error "Socket recv: Unsupported OS"
    #end
}

// Receive
+ fn send(fd: FD, buf: ByteBuffer, amount: uint, timeout_ms: uint (5000)) uint !NetError {
    if amount > buf.length : amount = buf.length
    return send_from_ptr(fd, buf.data, amount, timeout_ms) !>
}
+ fn send_string(fd: FD, str: String, timeout_ms: uint (5000)) uint !NetError {
    return send_from_ptr(fd, str.data, str.length, timeout_ms) !>
}
+ fn send_from_ptr(fd: FD, buf: ptr, amount: uint, timeout_ms: uint (5000)) uint !NetError {
    let coro = coro.current_coro.@cast(coro.Coro)

    #if OS == "macos"
    while true {
        let res = ext.write(fd, buf, amount.to(u32))
        if res == 0 : throw .write
        if res < 0 {
            let error = ext.get_errno()
            if error == ext.EAGAIN {
                let ev = io.await_fd(fd, false, true, timeout_ms)
                if ev.is_timeout() : throw .timeout
                if ev.is_closed() || !ev.is_writable() : throw .closed
                continue
            }
            if error == ext.EINTR : continue
            break
        }
        return res.to(uint)
    }
    throw .write

    #elif OS == "linux"
    let sqe = io.sqe(coro) ! throw .os
    io.io_uring_prep_send(sqe, fd, buf, amount.to(u32), 0)
    io.link_timeout(coro, sqe, timeout_ms) ! throw .os

    coro.yield()
    let sent = coro.completion_res
    if sent == 0 - ext.ETIMEDOUT : throw .timeout
    if sent <= 0 : throw .write
    return sent.to(uint)

    #elif OS == "win"
    let ov = io.overlap()
    ov.buflen = amount
    ov.buf = buf

    let res = ext.WSASend(fd, @ref(ov.buflen), 1, null, 0, ov.@cast(ptr), null)
    if res == ext.SOCKET_ERROR && io.socket_io_failed() : throw .write
    if io.await_overlap(fd, ov.@cast(ptr), coro, timeout_ms) : throw .timeout

    let flags: u32 = 0
    let ok = ext.WSAGetOverlappedResult(fd, ov.@cast(ptr), @ref(ov.transferred), 1, @ref(flags))
    if ok == 0 || ov.base.sys.Internal != 0 {
        throw .write
    }

    let sent = ov.transferred
    return sent

    #else
    #error "Socket send: Unsupported OS"
    #end
}

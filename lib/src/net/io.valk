use ext
use coro
use io
use mem
use core
use time

#if OS == "win"
/// The Winsock `ConnectEx` extension function, loaded at runtime through `WSAIoctl`.
type ConnectExFn (fnptr(ext.SOCKET, ptr, i32, ?ptr, u32, ?ptr, ?ptr)(ext.BOOL))

/// The Winsock `AcceptEx` extension function, loaded at runtime through `WSAIoctl`.
type AcceptExFn (fnptr(ext.SOCKET, ext.SOCKET, ?ptr, u32, u32, u32, *u32, ?ptr)(ext.BOOL))

global pConnectEx: ?ConnectExFn
global pAcceptEx: ?AcceptExFn

fn LoadConnectEx(s: ext.SOCKET) ConnectExFn !NetError {
    @unsafe
    let p = pConnectEx
    if isset(p) : return p
    // {0x25a207b9,0xddf3,0x4660,{0x8e,0xe9,0x76,0xe5,0x8c,0x74,0x06,0x3e}}
    let guid: ext.GUID = @undefined
    guid.Data1 = 0x25a207b9
    guid.Data2 = 0xddf3
    guid.Data3 = 0x4660
    guid.Data4 = { 0x8e, 0xe9, 0x76, 0xe5, 0x8c, 0x74, 0x06, 0x3e }
    let bytes: u32 = 0
    let res = ext.WSAIoctl(s, ext.SIO_GET_EXTENSION_FUNCTION_POINTER, @ref(guid), size_of(ext.GUID), @ref(pConnectEx), size_of(ptr), @ref(bytes), null, null)
    if res != 0 {
        throw .os
    }
    return pConnectEx.@cast(ConnectExFn)
}

fn LoadAcceptEx(s: ext.SOCKET) AcceptExFn !NetError {
    @unsafe
    let p = pAcceptEx
    if isset(p) : return p
    // {0x25a207b9,0xddf3,0x4660,{0x8e,0xe9,0x76,0xe5,0x8c,0x74,0x06,0x3e}}
    let guid: ext.GUID = @undefined
    guid.Data1 = 0xb5367df1
    guid.Data2 = 0xcbac
    guid.Data3 = 0x11cf
    guid.Data4 = { 0x95, 0xca, 0x00, 0x80, 0x5f, 0x48, 0xa1, 0x92 }
    let bytes: u32 = 0
    let res = ext.WSAIoctl(s, ext.SIO_GET_EXTENSION_FUNCTION_POINTER, @ref(guid), size_of(ext.GUID), @ref(pAcceptEx), size_of(ptr), @ref(bytes), null, null)
    if res != 0 {
        throw .os
    }
    return pAcceptEx.@cast(AcceptExFn)
}
#end

// `ipv6` is the listener's family; the accepted socket must match it on Windows
fn accept(sock_fd: Fd, ipv6: bool, timeout_ms: uint (0), owner: uint (0)) Fd !NetError {
    @unsafe
    return accept_addr(sock_fd, ipv6, timeout_ms, owner, null, null) !>
}

fn accept_addr(sock_fd: Fd, ipv6: bool, timeout_ms: uint, owner: uint, addr: ?ptr, addr_length: ?*u32) Fd !NetError {
    #if OS == "win"
    @unsafe
    let family: i32 = ipv6 ? ext.AF_INET6 : ext.AF_INET
    let fd = ext.WSASocketA(family, ext.SOCK_STREAM, ext.IPPROTO_TCP, null, 0, ext.WSA_FLAG_OVERLAPPED)
    if fd == ext.INVALID_SOCKET : throw .init

    let acfn = LoadAcceptEx(sock_fd) ! {
        close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        throw .os
    }

    let ov = io.overlap()
    let wait = io.overlap_event_start(ov) ! {
        close_fd_cleanup(fd, __FILE__, __LINE__)
        throw .os
    }
    // Room for either address family
    let addrLen: u32 = sockaddr_v6_size + 16;
    let ok = acfn(sock_fd, fd, @ref(ov.addressBuffer), 0, addrLen, addrLen, @ref(ov.transferred), ov.@cast(ptr))
    if ok == 0 && io.socket_io_failed() {
        io.overlap_event_stop(ov, wait)
        close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        throw .init
    }
    let current = coro.current_coro.@cast(coro.Coro)
    let timed_out = io.await_overlap(sock_fd, ov.@cast(ptr), current, timeout_ms)
    io.overlap_event_stop(ov, wait)
    if timed_out {
        close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        throw .timeout
    }

    if ov.base.sys.Internal != 0 {
        close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        throw .init
    }

    if ext.setsockopt(fd, ext.SOL_SOCKET, ext.SO_UPDATE_ACCEPT_CONTEXT, @ref(sock_fd), size_of(Fd)) != 0 {
        close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
        throw .init
    }

    return fd

    #elif OS == "linux"
    @unsafe
    while true {
        if isset(addr_length) : addr_length[0] = 128
        let fd = ext.accept4(sock_fd, addr.@cast(?*ext.libc_sockaddr), addr_length, ext.SOCK_CLOEXEC | ext.SOCK_NONBLOCK)
        if fd >= 0 : return fd
        let err = ext.get_errno()
        // A connection that ended while it waited in the queue: on to the next
        if err == ext.EINTR || err == ext.ECONNABORTED : continue
        if err == ext.EMFILE || err == ext.ENFILE : throw .max_connections
        if err != ext.EAGAIN : throw .init
        if io.use_epoll_backend() {
            let ev = io.await_owned_fd(sock_fd, true, false, timeout_ms, owner)
            if ev.is_timeout() : throw .timeout
            if io.is_gone(ev) : throw .closed
            continue
        }
        break
    }
    #if URING
    if isset(addr_length) : addr_length[0] = 128
    let coro = coro.current_coro.@cast(coro.Coro)
    let sqe = io.sqe(coro) ! throw .os
    io.io_uring_prep_accept(sqe, sock_fd, addr, addr_length.@cast(uint), ext.SOCK_CLOEXEC | ext.SOCK_NONBLOCK)
    io.link_timeout(coro, sqe, timeout_ms) ! throw .os
    coro.yield()
    return accept_completion_result(coro.completion_res) !>
    #else
    throw .init
    #end
    #elif OS == "macos"
    while true {
        let fd = ext.accept(sock_fd, null, null)
        if fd == -1 {
            let err = ext.get_errno()
            if err == ext.EAGAIN {
                let ev = io.await_fd(sock_fd, true, false, timeout_ms)
                if ev.is_timeout() : throw .timeout
                if ev.is_closed() : throw .closed
                continue
            }
            if err == ext.EMFILE || err == ext.ENFILE {
                // Too many connections
                throw .max_connections
            }
            throw .init
        }
        io.set_close_on_exec(fd) ! {
            close_fd(fd) ! core.cleanup_warning("Failed to close socket", __FILE__, __LINE__)
            throw .init
        }
        return fd
    }
    throw .init
    #else
    #error "Socket accept: Unsupported OS"
    #end
}

#if URING
fn accept_completion_result(result: int) Fd !NetError {
    if result == 0 - ext.ETIMEDOUT : throw .timeout
    if result == 0 - ext.EMFILE || result == 0 - ext.ENFILE : throw .max_connections
    let fd = result.to(Fd)
    if fd < 0 : throw .init
    return fd
}

// Accepts the next connection on `sock_fd` into this thread's table of direct descriptors
// (see `io.uring_files`) and returns its slot; the peer's address goes into `addr`
fn accept_direct(sock_fd: Fd, timeout_ms: uint, addr: ptr, addr_length: *u32, ring: uint) Fd !NetError {
    @unsafe
    let coro = coro.current_coro.@cast(coro.Coro)
    let sqe = io.sqe_on(coro, ring) ! throw .os
    io.io_uring_prep_rw(ext.IORING_OP.ACCEPT, sqe, sock_fd, addr, 0, addr_length.@cast(u64))
    sqe.file_index = io.IORING_FILE_INDEX_ALLOC
    io.link_timeout(coro, sqe, timeout_ms, ring) ! throw .os
    coro.yield()
    return accept_completion_result(coro.completion_res) !>
}

// Like `discard_pending_input`, for a direct descriptor
fn discard_pending_direct(fd: Fd, ring: uint) {
    @unsafe
    let buffer: [u8 x 4096] = @undefined
    let budget: uint = 256 * 1024
    while budget > 0 {
        let got = direct_op(ext.IORING_OP.RECV, ring, fd, @ref(buffer).@cast(ptr), 4096, ext.MSG_DONTWAIT, 0)
        if got <= 0 : return
        if got.to(uint) >= budget : return
        budget -= got.to(uint)
    }
}

// One operation on the direct descriptor `fd`, waited for by the current coroutine; returns
// its result: a byte count or a negative errno
fn direct_op(op: i32, ring: uint, fd: Fd, buf: ?ptr, amount: uint, flags: i32, timeout_ms: uint) i32 {
    @unsafe
    let coro = coro.current_coro.@cast(coro.Coro)
    let sqe = io.sqe_on(coro, ring) ! return 0 - ext.ENOMEM
    io.io_uring_prep_rw(op, sqe, fd, buf, amount.to(u32), 0)
    sqe.rw_flags = flags.to(u32)
    sqe.flags = io.IOSQE_FIXED_FILE.to(u8)
    io.link_timeout(coro, sqe, timeout_ms, ring) ! return 0 - ext.ENOMEM
    coro.yield()
    return coro.completion_res.to(i32)
}

// A send on a direct descriptor, like `direct_op`. It first tries without waiting, so the
// timeout is only armed when the socket buffer is full
fn direct_send(op: i32, ring: uint, fd: Fd, buf: ptr, amount: uint, flags: i32, timeout_ms: uint) i32 {
    @unsafe
    if (flags & ext.MSG_DONTWAIT) != 0 : return direct_op(op, ring, fd, buf, amount, flags, 0)
    if timeout_ms > 0 {
        let res = direct_op(op, ring, fd, buf, amount, flags | ext.MSG_DONTWAIT, 0)
        if res != 0 - ext.EAGAIN : return res
    }
    return direct_op(op, ring, fd, buf, amount, flags, timeout_ms)
}

#if TEST
/// Test hook: maps an io_uring accept result to a descriptor or a `NetError`.
+ fn accept_completion_result_for_test(result: int) Fd !NetError {
    return accept_completion_result(result) !>
}
#end
#end

// On Windows the socket must already be bound: ConnectEx requires it
fn connect(fd: Fd, addr: AddrInfo, timeout_ms: uint (5000)) !NetError {
    #if OS == "win"
    @unsafe
    let confn = LoadConnectEx(fd) !>

    let ov = io.overlap()
    let ok = confn(fd, addr.sock_addr(), addr.addr_len(), null, 0, @ref(ov.transferred), ov.@cast(ptr))
    if ok == 0 && io.socket_io_failed() : throw .connect
    let current = coro.current_coro.@cast(coro.Coro)
    if io.await_overlap(fd, ov.@cast(ptr), current, timeout_ms) : throw .timeout

    if ov.base.sys.Internal != 0 {
        throw .connect
    }

    if ext.setsockopt(fd, ext.SOL_SOCKET, ext.SO_UPDATE_CONNECT_CONTEXT, null, 0) != 0 {
        throw .connect
    }

    #elif OS == "linux"
    @unsafe
    if io.use_epoll_backend() {
        if ext.connect(fd, addr.sock_addr(), addr.addr_len()) != 0 {
            let error = ext.get_errno()
            if error != ext.EINPROGRESS && error != ext.EINTR : throw .connect
            // The attempt goes on without us: the socket is writable once it ended, either way
            let ev = io.await_fd(fd, false, true, timeout_ms)
            if ev.is_timeout() : throw .timeout
            if io.is_gone(ev) : throw .connect
            let failed: i32 = 0
            let size: u32 = size_of(i32)
            if ext.getsockopt(fd, ext.SOL_SOCKET, ext.SO_ERROR, @ref(failed).@cast(ptr), @ref(size)) != 0 || failed != 0 : throw .connect
        }
        return
    }
    #if URING
    let coro = coro.current_coro.@cast(coro.Coro)
    let sqe = io.sqe(coro) !>
    io.io_uring_prep_connect(sqe, fd, addr.sock_addr(), addr.addr_len())
    io.link_timeout(coro, sqe, timeout_ms) ! throw .os
    coro.yield()
    let res = coro.completion_res
    if res == 0 - ext.ETIMEDOUT : throw .timeout
    if res < 0 : throw .connect
    #end

    #elif OS == "macos"
    @unsafe
    if ext.connect(fd, addr.sock_addr(), addr.addr_len()) != 0 {
        let error = ext.get_errno()
        if error != ext.EISCONN {
            if error != ext.EINPROGRESS && error != ext.EINTR : throw .connect
            // The attempt goes on without us. How it ended is asked of the socket: a second
            // connect call reports a refused attempt as an established connection on some systems
            let deadline = time.deadline_ms(timeout_ms)
            while true {
                let left: uint = 0
                if deadline != 0 {
                    let now = time.mono_ms()
                    if now >= deadline : throw .timeout
                    left = deadline - now
                }
                let ev = io.await_fd(fd, false, true, left)
                if ev.is_timeout() : throw .timeout
                let failed: i32 = 0
                let size: u32 = size_of(i32)
                if ext.getsockopt(fd, ext.SOL_SOCKET, ext.SO_ERROR, @ref(failed).@cast(ptr), @ref(size)) != 0 || failed != 0 : throw .connect
                // Connected once it has a peer; woken for another reason, it waits on
                let peer = [u8 x 128]{ 0... }
                let length: u32 = 128
                if ext.getpeername(fd, @ref(peer).@cast(*ext.libc_sockaddr), @ref(length)) == 0 : break
                if ext.get_errno() != ext.ENOTCONN : throw .connect
            }
        }
    }
    #else
    #error "Socket connect: Unsupported OS"
    #end
}

/// Receives once from the socket `fd` into `buf` and returns the number of bytes read.
///
/// Returns 0 when the peer closed its end. `timeout_ms` 0 waits forever. Throws
/// `timeout`, `read`, or `closed` on macOS when the descriptor reports hang-up.
+ fn recv(fd: Fd, buf: local mut &[u8], timeout_ms: uint (5000)) uint !io.IoError {
    @unsafe
    return recv_bytes(fd, buf.data, buf.length, timeout_ms) !>
}
// `recv` and `write` for the object that holds the socket, which `owner` stands for; only the
// epoll backend uses it. `stream` says a receive that gets less than it asked for emptied the
// socket, as with TCP
fn recv_owned(fd: Fd, buf: local mut &[u8], timeout_ms: uint, owner: uint, stream: bool) uint !io.IoError {
    @unsafe
    return recv_bytes(fd, buf.data, buf.length, timeout_ms, owner, stream) !>
}
fn write_owned(fd: Fd, data: local &[u8], timeout_ms: uint, owner: uint) uint !io.IoError {
    @unsafe
    return send_bytes(fd, data.data, data.length, timeout_ms, owner) !>
}
fn recv_bytes(fd: Fd, buf: ptr, amount: uint, timeout_ms: uint (5000), owner: uint (0), stream: bool (false)) uint !io.IoError {
    let coro = coro.current_coro.@cast(coro.Coro)

    #if OS == "macos"
    while true {
        @unsafe
        let res = ext.read(fd, buf, amount.to(u32))
        if res == 0 : return 0
        if res < 0 {
            let error = ext.get_errno()
            if error == ext.EAGAIN {
                let ev = io.await_fd(fd, true, false, timeout_ms)
                if ev.is_timeout() : throw .timeout
                if !ev.is_readable() : throw .closed
                continue
            }
            if error == ext.EINTR : continue
            break
        }
        return res.to(uint)
    }
    throw .read

    #elif OS == "linux"
    @unsafe
    if io.use_epoll_backend() {
        while true {
            // A socket known to be empty is not asked: the wait comes first
            if !stream || !io.owned_input_empty(fd, owner) {
                let rcvd = ext.recv(fd, buf, amount, ext.MSG_DONTWAIT)
                if rcvd >= 0 {
                    if stream && rcvd > 0 && rcvd.to(uint) < amount : io.owned_input_drained(fd, owner)
                    return rcvd.to(uint)
                }
                let error = ext.get_errno()
                if error == ext.EINTR : continue
                if error != ext.EAGAIN : throw .read
                if stream : io.owned_input_drained(fd, owner)
            }
            if stream && io.owned_input_empty(fd, owner) {
                // The event loop receives when input comes, together with the round's other receives
                let ev, got = io.await_owned_recv(fd, buf, amount, timeout_ms, owner)
                if ev.is_timeout() : throw .timeout
                if io.is_gone(ev) : throw .closed
                if got >= 0 : return got.to(uint)
                if got != io.NOT_RECEIVED : throw .read
                continue
            }
            // Woken for an error or a hang-up too: the next receive reports it
            let ev = io.await_owned_fd(fd, true, false, timeout_ms, owner)
            if ev.is_timeout() : throw .timeout
            if io.is_gone(ev) : throw .closed
        }
        throw .read
    }
    #if URING
    let sqe = io.sqe(coro) ! throw .os
    io.io_uring_prep_recv(sqe, fd, buf, amount.to(u32), 0)
    io.link_timeout(coro, sqe, timeout_ms) ! throw .os

    coro.yield()
    let rcvd = coro.completion_res
    if rcvd == 0 - ext.ETIMEDOUT : throw .timeout
    if rcvd < 0 : throw .read
    return rcvd.to(uint)
    #else
    throw .read
    #end

    #elif OS == "win"
    @unsafe
    let ov = io.overlap()
    ov.buflen = amount
    ov.buf = buf

    let res = ext.WSARecv(fd, @ref(ov.buflen), 1, null, @ref(ov.flags), ov.@cast(ptr), null)
    if res == ext.SOCKET_ERROR && io.socket_io_failed() : throw .read
    if io.await_overlap(fd, ov.@cast(ptr), coro, timeout_ms) : throw .timeout

    let ok = ext.WSAGetOverlappedResult(fd, ov.@cast(ptr), @ref(ov.transferred), 1, @ref(ov.flags))
    if ok == 0 || ov.base.sys.Internal != 0 {
        throw .read
    }

    let rcvd = ov.transferred
    return rcvd
    #else
    #error "Socket recv: Unsupported OS"
    #end
}

#if URING
// Sends all of `data` and then receives into `buf`, as two linked io_uring operations
// that reach the kernel with other coroutines' at the scheduler's next wait. Returns the
// bytes received. Needs `io.uring_links_full_sends()`; no timeout.
fn send_then_recv(fd: Fd, data: local &[u8], buf: local mut &[u8], direct: bool (false), ring: uint (0)) uint !io.IoError {
    @unsafe
    let coro = coro.current_coro.@cast(coro.Coro)
    let send = io.sqe_on(coro, ring) ! throw .os
    io.io_uring_prep_send(send, fd, data.data, data.length.to(u32), ext.MSG_NOSIGNAL | ext.MSG_WAITALL)
    send.flags = send.flags | (1 << ext.IORING_SQE_FLAGS.IO_LINK_BIT)
    send.user_data = send.user_data | 3
    // `sqe` left room for this one, so the pair is never split
    let recv = io.linked_sqe_on(coro, ring) ! throw .os
    io.io_uring_prep_recv(recv, fd, buf.data, buf.length.to(u32), 0)
    if direct {
        send.flags = send.flags | io.IOSQE_FIXED_FILE.to(u8)
        recv.flags = recv.flags | io.IOSQE_FIXED_FILE.to(u8)
    }

    coro.yield()
    let rcvd = coro.completion_res
    // The send failed and the kernel cancelled the read
    if rcvd == 0 - ext.ECANCELED : throw .write
    if rcvd < 0 : throw .read
    return rcvd.to(uint)
}
#end

/// Sends once from `data` on the socket `fd` and returns the number of bytes sent.
///
/// May send fewer bytes than `data.length`; call again for the rest (`TcpConnection.write`
/// does). `timeout_ms` 0 waits forever. Throws `timeout`, `write`, or `closed` on macOS.
+ fn write(fd: Fd, data: local &[u8], timeout_ms: uint (5000)) uint !io.IoError {
    @unsafe
    return send_bytes(fd, data.data, data.length, timeout_ms) !>
}
fn send_bytes(fd: Fd, buf: ptr, amount: uint, timeout_ms: uint (5000), owner: uint (0)) uint !io.IoError {
    let coro = coro.current_coro.@cast(coro.Coro)

    #if OS == "macos"
    while true {
        @unsafe
        let res = ext.write(fd, buf, amount.to(u32))
        if res == 0 : throw .write
        if res < 0 {
            let error = ext.get_errno()
            if error == ext.EAGAIN {
                let ev = io.await_fd(fd, false, true, timeout_ms)
                if ev.is_timeout() : throw .timeout
                if ev.is_closed() || !ev.is_writable() : throw .closed
                continue
            }
            if error == ext.EINTR : continue
            break
        }
        return res.to(uint)
    }
    throw .write

    #elif OS == "linux"
    @unsafe
    // Send right away while the socket buffer has room; the event loop only for a send that
    // has to wait
    while true {
        let res = ext.send(fd, buf, amount, ext.MSG_DONTWAIT | ext.MSG_NOSIGNAL)
        if res > 0 : return res.to(uint)
        if res == 0 : throw .write
        let error = ext.get_errno()
        if error == ext.EINTR : continue
        if error != ext.EAGAIN : throw .write
        if io.use_epoll_backend() {
            // Woken for an error or a hang-up too: the next send reports it
            let ev = io.await_owned_fd(fd, false, true, timeout_ms, owner)
            if ev.is_timeout() : throw .timeout
            if io.is_gone(ev) : throw .closed
            continue
        }
        break
    }
    #if URING
    let sqe = io.sqe(coro) ! throw .os
    io.io_uring_prep_send(sqe, fd, buf, amount.to(u32), ext.MSG_NOSIGNAL)
    io.link_timeout(coro, sqe, timeout_ms) ! throw .os

    coro.yield()
    let sent = coro.completion_res
    if sent == 0 - ext.ETIMEDOUT : throw .timeout
    if sent <= 0 : throw .write
    return sent.to(uint)
    #else
    throw .write
    #end

    #elif OS == "win"
    @unsafe
    let ov = io.overlap()
    ov.buflen = amount
    ov.buf = buf

    let res = ext.WSASend(fd, @ref(ov.buflen), 1, null, 0, ov.@cast(ptr), null)
    if res == ext.SOCKET_ERROR && io.socket_io_failed() : throw .write
    if io.await_overlap(fd, ov.@cast(ptr), coro, timeout_ms) : throw .timeout

    let flags: u32 = 0
    let ok = ext.WSAGetOverlappedResult(fd, ov.@cast(ptr), @ref(ov.transferred), 1, @ref(flags))
    if ok == 0 || ov.base.sys.Internal != 0 {
        throw .write
    }

    let sent = ov.transferred
    return sent

    #else
    #error "Socket send: Unsupported OS"
    #end
}

#if OS == "linux" || OS == "macos"
// `struct iovec`
struct IoVec {
    base: ptr
    length: uint
}

// Sends `parts` after their first `skip` bytes with one system call that never waits and
// returns the bytes sent: 0 when the socket buffer is full. Takes at most 64 parts per call.
fn send_parts_now(fd: Fd, parts: local &[local &[u8]], skip: uint, direct: bool (false), wait: bool (false), timeout_ms: uint (0), ring: uint (0)) uint !io.IoError {
    @unsafe
    let iov: [IoVec x 64] = @undefined
    let count: uint = 0
    let offset = skip
    each parts as part {
        if offset >= part.length {
            offset -= part.length
            continue
        }
        if count == 64 : break
        iov[count] = IoVec { base: part.data.@offset(offset), length: part.length - offset }
        offset = 0
        count++
    }
    if count == 0 : return 0
    #if URING
    if direct {
        // Through the ring: a direct descriptor has no number for a system call. Without
        // `wait` only what fits in the socket buffer goes out
        let flags: i32 = ext.MSG_NOSIGNAL
        if !wait : flags |= ext.MSG_DONTWAIT
        let res: i32 = 0
        if count == 1 {
            res = direct_send(ext.IORING_OP.SEND, ring, fd, iov[0].base, iov[0].length, flags, timeout_ms)
        } else {
            let msg = MsgHdr { iov: @ref(iov), iov_count: count }
            res = direct_send(ext.IORING_OP.SENDMSG, ring, fd, @ref(msg).@cast(ptr), 1, flags, timeout_ms)
        }
        if res >= 0 : return res.to(uint)
        if res == 0 - ext.EAGAIN : return 0
        if res == 0 - ext.ETIMEDOUT : throw .timeout
        throw .write
    }
    #end
    #if OS == "linux"
    if count == 1 {
        while true {
            let res = ext.send(fd, iov[0].base, iov[0].length, ext.MSG_DONTWAIT | ext.MSG_NOSIGNAL)
            if res >= 0 : return res.to(uint)
            let error = ext.get_errno()
            if error == ext.EINTR : continue
            if error == ext.EAGAIN : return 0
            throw .write
        }
        return 0
    }
    let msg = MsgHdr { iov: @ref(iov), iov_count: count }
    #end
    while true {
        #if OS == "linux"
        let res = ext.sendmsg(fd, @ref(msg), ext.MSG_DONTWAIT | ext.MSG_NOSIGNAL)
        #else
        let res = ext.writev(fd, @ref(iov), count.to(i32))
        #end
        if res >= 0 : return res.to(uint)
        let error = ext.get_errno()
        if error == ext.EINTR : continue
        if error == ext.EAGAIN : return 0
        throw .write
    }
    return 0
}
#end

#if OS == "linux"
// `struct msghdr`
struct MsgHdr {
    name: ?ptr (null)
    name_length: u32 (0)
    iov: ptr
    iov_count: uint
    control: ?ptr (null)
    control_length: uint (0)
    flags: i32 (0)
}
#end

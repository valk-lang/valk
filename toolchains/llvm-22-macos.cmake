if(NOT DEFINED VALK_MACOS_ARCH)
  set(VALK_MACOS_ARCH x86_64)
endif()

if(VALK_MACOS_ARCH STREQUAL arm64)
  set(VALK_MACOS_TARGET arm64-apple-macos11)
elseif(VALK_MACOS_ARCH STREQUAL x86_64)
  set(VALK_MACOS_TARGET x86_64-apple-macos11)
else()
  message(FATAL_ERROR "Unsupported macOS architecture: ${VALK_MACOS_ARCH}")
endif()

set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR "${VALK_MACOS_ARCH}")

get_filename_component(VALK_TOOLCHAINS "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
set(CMAKE_OSX_SYSROOT "${VALK_TOOLCHAINS}/toolchains/macos-11-3")
set(CMAKE_OSX_ARCHITECTURES "${VALK_MACOS_ARCH}")
set(CMAKE_OSX_DEPLOYMENT_TARGET 11.0)

set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET "${VALK_MACOS_TARGET}")
set(CMAKE_CXX_COMPILER_TARGET "${VALK_MACOS_TARGET}")
set(CMAKE_ASM_COMPILER_TARGET "${VALK_MACOS_TARGET}")
set(CMAKE_AR llvm-ar)
set(CMAKE_RANLIB llvm-ranlib)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=lld")

set(CMAKE_FIND_ROOT_PATH "${CMAKE_OSX_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

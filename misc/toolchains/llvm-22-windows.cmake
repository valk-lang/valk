# Cross-compiles LLVM for win-x64 with clang-cl against the Windows SDK (setup-win-x64.sh):
# cmake -G Ninja <llvm-project>/llvm -DCMAKE_TOOLCHAIN_FILE=misc/toolchains/llvm-22-windows.cmake \
#   -DCMAKE_BUILD_TYPE=Release -DLLVM_TARGETS_TO_BUILD="X86;AArch64" -DLLVM_HOST_TRIPLE=x86_64-pc-windows-msvc \
#   -DLLVM_ENABLE_PROJECTS=lld -DLLVM_BUILD_TOOLS=OFF -DLLVM_INCLUDE_TESTS=OFF \
#   -DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF -DLLVM_ENABLE_LIBXML2=OFF \
#   -DLLVM_ENABLE_ZLIB=OFF -DLLVM_ENABLE_ZSTD=OFF -DLLVM_ENABLE_DIA_SDK=OFF
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)

get_filename_component(VALK_PROJECT_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(VALK_TOOLCHAINS "${VALK_PROJECT_ROOT}/toolchains")
set(VALK_WINDOWS_SDK "${VALK_TOOLCHAINS}/toolchains/win-sdk-x64")

set(CMAKE_C_COMPILER clang-cl)
set(CMAKE_CXX_COMPILER clang-cl)
set(CMAKE_RC_COMPILER llvm-rc)
set(CMAKE_ASM_MASM_COMPILER llvm-ml)
set(CMAKE_ASM_MASM_FLAGS_INIT "-m64")
set(CMAKE_AR llvm-lib)
set(CMAKE_LINKER lld-link)
set(VALK_MSVC "${VALK_WINDOWS_SDK}/MSVC/14.36.32532")
set(VALK_WINSDK "${VALK_WINDOWS_SDK}/Include/10.0.22621.0")
set(VALK_WIN_INCLUDES "-imsvc${CMAKE_CURRENT_LIST_DIR}/include/windows -imsvc${VALK_MSVC}/include -imsvc${VALK_WINSDK}/ucrt -imsvc${VALK_WINSDK}/shared -imsvc${VALK_WINSDK}/um -imsvc${VALK_WINSDK}/winrt")
set(CMAKE_C_FLAGS_INIT "${VALK_WIN_INCLUDES}")
set(CMAKE_CXX_FLAGS_INIT "${VALK_WIN_INCLUDES}")
set(VALK_WIN_LIBS "/libpath:${VALK_MSVC}/lib/x64 /libpath:${VALK_WINDOWS_SDK}/Lib/10.0.22621.0/ucrt/x64 /libpath:${VALK_WINDOWS_SDK}/Lib/10.0.22621.0/um/x64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${VALK_WIN_LIBS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${VALK_WIN_LIBS}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${VALK_WIN_LIBS}")
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)

set(CMAKE_FIND_ROOT_PATH "${VALK_WINDOWS_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
